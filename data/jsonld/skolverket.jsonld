ge":"sv","@value":"specialskola"}],"dcat:landingPage":{"@id":"https://www.skolverket.se/om-oss/oppna-data/api-for-skolenhetsregistret"},"dcat:servesDataset":{"@id":"https://editera.dataportal.se/store/162/resource/26"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The school unit register contains contact information for school units and school principals throughout the country with the school forms preschool class, after-school care, primary school, Sami school, special school, special needs school, upper secondary school, special needs school and municipal adult education. \nThe register is based on the principals' own data.\nThe school unit register is adapted to the definition of school unit that follows from the Education Act (2010:800). The responsible authority is the National Agency for Education."},{"@language":"sv","@value":"Skolenhetsregistret innehåller kontaktuppgifter till skolenheter och skolhuvudmän i hela landet med skolformerna förskoleklass, fritidshem, grundskola, sameskola, specialskola, anpassad grundskola, gymnasieskola, anpassad gymnasieskola samt kommunal vuxenutbildning. \nRegistret baseras på huvudmännens egna uppgifter.\nSkolenhetsregistret är anpassat till definitionen av skolenhet som följer av skollagen (2010:800). Ansvarig myndighet är Skolverket."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004185"},"dct:title":[{"@language":"en","@value":"School unit registry"},{"@language":"sv","@value":"Skolenhetsregistret"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.skolverket.se/skolenhetsregistret/swagger-ui/index.html#/"}},{"@id":"https://editera.dataportal.se/store/162/resource/26","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/162/resource/11"},"dcat:distribution":{"@id":"https://editera.dataportal.se/store/162/resource/28"},"dcat:keyword":[{"@language":"en","@value":"Swedish National Agency for Education"},{"@language":"en","@value":"addresses"},{"@language":"en","@value":"compulsory school for pupils with intellectual disabilities"},{"@language":"en","@value":"compulsory school"},{"@language":"en","@value":"compulsory special needs schools"},{"@language":"en","@value":"education for adults"},{"@language":"en","@value":"leisure-time centre"},{"@language":"en","@value":"preschool class"},{"@language":"en","@value":"register of schools"},{"@language":"en","@value":"sami school"},{"@language":"en","@value":"school forms"},{"@language":"en","@value":"school units"},{"@language":"en","@value":"schools"},{"@language":"en","@value":"upper secondary school for pupils with intellectual disabilities"},{"@language":"en","@value":"upper secondary school"},{"@language":"sv","@value":"Skolverket"},{"@language":"sv","@value":"adresser"},{"@language":"sv","@value":"anpassad grundskola"},{"@language":"sv","@value":"anpassad gymnasieskola"},{"@language":"sv","@value":"fritidshem"},{"@language":"sv","@value":"förskoleklass"},{"@language":"sv","@value":"grundskola"},{"@language":"sv","@value":"gymnasieskola"},{"@language":"sv","@value":"kommunal vuxenutbildning"},{"@language":"sv","@value":"sameskola"},{"@language":"sv","@value":"skolenheter"},{"@language":"sv","@value":"skolenhetsregistret"},{"@language":"sv","@value":"skolformer"},{"@language":"sv","@value":"skolor"},{"@language":"sv","@value":"specialskola"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The school unit register contains contact information for school units and school principals throughout the country with the school forms preschool class, after-school care, primary school, Sami school, special school, special needs school, upper secondary school, special needs school and municipal adult education. \nThe register is based on the principals' own data.\nThe school unit register is adapted to the definition of school unit that follows from the Education Act (2010:800). The responsible authority is the National Agency for Education."},{"@language":"sv","@value":"Skolenhetsregistret innehåller kontaktuppgifter till skolenheter och skolhuvudmän i hela landet med skolformerna förskoleklass, fritidshem, grundskola, sameskola, specialskola, anpassad grundskola, gymnasieskola, anpassad gymnasieskola samt kommunal vuxenutbildning. \nRegistret baseras på huvudmännens egna uppgifter.\nSkolenhetsregistret är anpassat till definitionen av skolenhet som följer av skollagen (2010:800). Ansvarig myndighet är Skolverket."}],"dct:issued":{"@type":"xsd:gYear","@value":"2024"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004185"},"dct:spatial":[{"@id":"_:eabfebe9405d7203b45acb872bc3500e29df05ae1207ef4ae6db67502672197c_b2n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:temporal":{"@id":"_:eabfebe9405d7203b45acb872bc3500e29df05ae1207ef4ae6db67502672197c_b3n0"},"dct:title":[{"@language":"en","@value":"School unit registry"},{"@language":"sv","@value":"Skolenhetsregistret"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://editera.dataportal.se/store/162/resource/13"}},{"@id":"https://editera.dataportal.se/store/162/resource/28","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://editera.dataportal.se/store/162/resource/13"},"dcat:accessURL":{"@id":"https://api.skolverket.se/skolenhetsregistret/swagger-ui/index.html"},"dct:description":[{"@language":"sv","@value":"Api:et är ett REST-api som returnerar data som JSON eller XML baserat 