":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Västerås","http://www.w3.org/2006/vcard/ns#postal-code":"72212","http://www.w3.org/2006/vcard/ns#street-address":"Ingenjör Bååths gata 19"},{"@id":"http://dataportal.se/organisation/SE2021006230","@type":"foaf:Agent","dct:identifier":"2021006230","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:itsupport@myh.se"},"foaf:name":{"@language":"sv","@value":"Myndigheten för yrkeshögskolan"},"foaf:page":{"@id":"https://www.myh.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://dataportal.se/organisation/SE202100-6230"}},{"@id":"https://editera.dataportal.se/store/166/resource/4","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/166/resource/5"},"dcat:distribution":{"@id":"https://editera.dataportal.se/store/166/resource/6"},"dcat:keyword":[{"@language":"en","@value":"EQF"},{"@language":"en","@value":"SeQF"},{"@language":"en","@value":"qualification"},{"@language":"sv","@value":"EQF"},{"@language":"sv","@value":"SeQF"},{"@language":"sv","@value":"kompetensförsörjning"},{"@language":"sv","@value":"kvalifikation"},{"@language":"sv","@value":"livslångt lärande"},{"@language":"sv","@value":"nivå"},{"@language":"sv","@value":"referensram"}],"dcat:landingPage":{"@id":"https://www.myh.se/kvalifikationer"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"The dataset contains Swedish qualifications including SeQF and EQF level, learning outcome and classification of the qualifications (SSYK, SUN and ISCED)."},{"@language":"sv","@value":"En kvalifikation är en kravspecifikation för en yrkesroll, funktion eller ett kompetensområde inom arbetslivet. Det kan också vara en specifikation för vilka olika lärandemål en individ ska ha uppnått efter en utbildning. Datamängden innehåller initialt de kvalifikationer som nivåbeslutats av MYH men kommer löpande att utökas med kvalifikationer från det formella utbildningssystemet. Varje enskild kvalifikation innehåller information om bl.a. SeQF och EQF nivåer, utfärdande organisation, kvalifikationens krav på kompetens uttryckt som läranderesultat - även för delkvalifikationer där sådana finns beskrivna, inom vilket yrkes-/kompetens-/utbildningsområde kvalifikationen hör hemma (SSYK/SUN) samt unika identitetsnummer."}],"dct:issued":{"@type":"xsd:date","@value":"2022-10-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-05-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006230"},"dct:spatial":[{"@id":"_:9d3eb3b4156a60ccc07f7f060fa0fbe06211d5e5b34d86970dff75c4a1bd13d4_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:temporal":{"@id":"_:9d3eb3b4156a60ccc07f7f060fa0fbe06211d5e5b34d86970dff75c4a1bd13d4_b1n0"},"dct:title":[{"@language":"en","@value":"Qualifications Sweden"},{"@language":"sv","@value":"Kvalifikationer Sverige"}],"foaf:page":{"@id":"https://qdb-external-api.myh.se/api/v1/api-docs/index.html#"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://editera.dataportal.se/store/166/resource/8"}},{"@id":"https://editera.dataportal.se/store/166/resource/5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Myndigheten för Yrkeshögskolan","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9d3eb3b4156a60ccc07f7f060fa0fbe06211d5e5b34d86970dff75c4a1bd13d4_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@myh.se"}},{"@id":"https://editera.dataportal.se/store/166/resource/6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://editera.dataportal.se/store/166/resource/8"},"dcat:accessURL":{"@id":"https://qdb-external-api.myh.se/api/v1/Kvalifikationer"},"dct:conformsTo":{"@id":"https://qdb-external-api.myh.se/swagger/v1/swagger.json"},"dct:description":{"@language":"sv","@value":"Funktionen levererar paginerat data i JSON-format. Svaret kommer ge en delmängd av tillgänglig data uppdelat på flera sidor. \nSamtliga sidor går att hämta, mer information finns att läsa i dokumentation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"REST API (paginerat)"},"foaf:page":{"@id":"https://qdb-external-api.myh.se/api/v1/api-docs/index.html#"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://editera.dataportal.se/store/166/resource/8","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/166/resource/5"},"dcat:endpointDescription":{"@id":"https://qdb-external-api.myh.se/swagger/v1/swagger.json"},"dcat:endpointURL":{"@id":"https://qdb-external-api.myh.se/api/v1/"},"dcat:keyword":[{"@language":"en","@value":"qualification"},{"@language":"sv","@value":"kvalifikation"}],"dcat:landingPage":{"@id":"https://www.myh.se/kvalifikationer"},"dcat:servesDataset":{"@id":"https://editera.dataportal.se/store/166/resource/4"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"REST API med Swaggersida, pagin