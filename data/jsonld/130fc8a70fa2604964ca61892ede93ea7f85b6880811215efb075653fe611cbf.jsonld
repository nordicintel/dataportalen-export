{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:03b2075fc7a4eb5d73e0072038a0123316831bd3a5cc52822f17c52c0f1e4db8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.014472549236324 57.65766337270526)"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-01-23 08:32:02"}},{"@id":"_:03b2075fc7a4eb5d73e0072038a0123316831bd3a5cc52822f17c52c0f1e4db8_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2025-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2025-01-01"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-07-09 12:02:02"}},{"@id":"http://dataportal.se/organisation/SE2120001363","@type":"foaf:Agent","dct:identifier":"2120001363","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis@molndal.se"},"foaf:name":{"@language":"sv","@value":"Mölndals stad"},"foaf:page":{"@id":"https://www.molndal.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.molndal.se/store/1/resource/1"}},{"@id":"https://catalog.molndal.se/store/1/resource/116","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.molndal.se/store/1/resource/51"},"dcat:distribution":[{"@id":"https://catalog.molndal.se/store/1/resource/118"},{"@id":"https://catalog.molndal.se/store/1/resource/120"}],"dcat:keyword":"inköp, faktura, leverantörsreskontra, ekonomi, upphandling, utgift","dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://lankadedata.se/spec/levreskontra/"},"dct:description":"I datamängden leverantörsreskontra hittar du bland annat information om: \n• gjorda inköp, \n• leverantörsnamn, \n• inköpande organisation \n• och verifikationsnummer, en unik identifierare som kan användas om du önskar ta del av den faktura som inköpet avser.\n\n I vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Innehåller personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare. \n\nFör att ta del av underliggande fakturor använder du vår E-tjänst och anger verifikationsnummer för den eller de fakturor som du är intresserad av. E-tjänsten kommer du till via länken: https://etjanst.molndal.se/bestallfakturor\n\nEn beskrivning av den specifikation som datamängden utgår från finns att tillgå via dataportal.se https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest","dct:issued":{"@type":"xsd:date","@value":"2025-02-15"},"dct:modified":{"@type":"xsd:dateTime","@value":"2023-12-07 15:36:27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001363"},"dct:spatial":[{"@id":"_:03b2075fc7a4eb5d73e0072038a0123316831bd3a5cc52822f17c52c0f1e4db8_b0n0"},{"@id":"https://sws.geonames.org/2691457"}],"dct:temporal":{"@id":"_:03b2075fc7a4eb5d73e0072038a0123316831bd3a5cc52822f17c52c0f1e4db8_b1n0"},"dct:title":"Leverantörsfakturor 2025"},{"@id":"https://catalog.molndal.se/store/1/resource/118","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.molndal.se/store/1/resource/125"},{"@id":"https://catalog.molndal.se/store/1/resource/126"},{"@id":"https://catalog.molndal.se/store/1/resource/127"},{"@id":"https://catalog.molndal.se/store/1/resource/128"},{"@id":"https://catalog.molndal.se/store/1/resource/129"},{"@id":"https://catalog.molndal.se/store/1/resource/130"},{"@id":"https://catalo