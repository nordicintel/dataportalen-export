ct:title":"molndalsstad-badplatser.json"},{"@id":"https://catalog.molndal.se/store/1/resource/42","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.molndal.se/store/1/resource/41"},"dcat:downloadURL":{"@id":"https://catalog.molndal.se/store/1/resource/41"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"}}],"@id":"urn:source:ccfae6c49280fa6bea64cb38b52a7a8444ecb420f894ee083239d81ee9b674ae"},{"@graph":[{"@id":"_:d209d80127efec2ef34756733a6e65f330cfe26c8f673f262dafbc2b9c38b035_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.94342659648963 57.68153555913676,12.164971983448133 57.68153555913676,12.164971983448133 57.542942280134014,11.94342659648963 57.542942280134014,11.94342659648963 57.68153555913676))"}},{"@id":"https://catalog.molndal.se/store/1/resource/160","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Samordning för hållbarhet, Ekonomi och hållbarhetsstyrning"}},{"@id":"https://catalog.molndal.se/store/1/resource/161","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.molndal.se/store/1/resource/163"},"dcat:distribution":{"@id":"https://catalog.molndal.se/store/1/resource/162"},"dcat:keyword":["Samordning för hållbarhet, Ekonomi och hållbarhetsstyrning",{"@language":"sv","@value":"Skyfall"},{"@language":"sv","@value":"Skyfallskartering"},{"@language":"sv","@value":"Översvämning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Skyfallskartering för Mölndals tätorter framtagen av stadsledningsförvaltningen, Mölndals stad. Skyfallskarteringen visar vilka ytor som riskeras att översvämmas vid ett kraftigt regn (100-årsregn med klimatfaktor 1,25). Karteringen utförs med hjälp av en hydraulisk modellering där översvämningsutbredning och vattendjup beräknas för dimensionerande regn över ett studerat område. Metoden finns beskriven i rapport ”PM Modellteknisk dokumentation Mölndal Skyfallskartering 20230223”."},"dct:publisher":{"@id":"https://catalog.molndal.se/store/1/resource/160"},"dct:spatial":[{"@id":"_:d209d80127efec2ef34756733a6e65f330cfe26c8f673f262dafbc2b9c38b035_b0n0"},{"@id":"https://sws.geonames.org/2691457"}],"dct:title":{"@language":"sv","@value":"Skyfallskartering 2023, 100-årsregn, maxdjup(m)"}},{"@id":"https://catalog.molndal.se/store/1/resource/162","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://wms.molndal.se/isms/oppnadata_skyfallskartering2023?request=GetCapabilities&service=WMS"},"dct:description":{"@language":"sv","@value":"Skyfallskartering för Mölndals tätorter framtagen av stadsledningsförvaltningen, Mölndals stad. Skyfallskarteringen visar vilka ytor som riskeras att översvämmas vid ett kraftigt regn (100-årsregn med klimatfaktor 1,25). Karteringen utförs med hjälp av en hydraulisk modellering där översvämningsutbredning och vattendjup beräknas för dimensionerande regn över ett studerat område. Metoden finns beskriven i rapport ”PM Modellteknisk dokumentation Mölndal Skyfallskartering 20230223”."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"Skyfallskartering Mölndal 2023"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.molndal.se/store/1/resource/163","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Utvecklingsledare Klimatanpassning,  Ekonomi och hållbarhetsstyrning, Stadsledningsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:yuka.ohshima-hasslekvist@molndal.se"}}],"@id":"urn:source:d209d80127efec2ef34756733a6e65f330cfe26c8f673f262dafbc2b9c38b035"}