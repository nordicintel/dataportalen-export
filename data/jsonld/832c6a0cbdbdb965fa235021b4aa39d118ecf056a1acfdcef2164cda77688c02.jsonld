.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://skovde.entryscape.net/store/1/resource/1"}},{"@id":"https://skovde.entryscape.net/store/1/resource/55","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://skovde.entryscape.net/store/1/resource/70"},"dcat:distribution":{"@id":"https://skovde.entryscape.net/store/1/resource/71"},"dcat:keyword":[{"@language":"en","@value":"Basemap"},{"@language":"sv","@value":"Baskarta"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/serviceType/ogc/wms"},"dct:created":{"@type":"xsd:date","@value":"2019-10-23"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001710"},"dct:description":[{"@language":"en","@value":"Skövde Municipality base map available as OGC WMS 1.3.0 (Web Map Service).\nThe service provides standard layers such as addresses, buildings, cadastral parcels, street names, road lines, surface details, business plots, detailed development plan areas, parks and municipally owned land. Includes 2019 orthophoto for Stöpen, Skövde and Skultorp.\nIntended for use in GIS and map clients."},{"@language":"sv","@value":"Skövde kommuns baskarta tillgänglig som OGC WMS 1.3.0 (Web Map Service).\nTjänsten innehåller standardlager som adresser, byggnader, fastigheter, gatunamn, väglinjer, markdetaljer, verksamhetstomter, detaljplanelagda områden, parkytor och kommunalägd mark. Innehåller även ortofoto 2019 över Stöpen, Skövde och Skultorp.\nAvsedd för användning i GIS‑ och kartklienter."}],"dct:issued":{"@type":"xsd:date","@value":"2019-10-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-10"},"dct:publisher":{"@id":"http://dat