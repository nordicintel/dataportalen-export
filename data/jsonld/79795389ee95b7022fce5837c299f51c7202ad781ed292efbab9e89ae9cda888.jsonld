x":{"@id":"mailto:info@falun.se"},"foaf:name":{"@language":"sv","@value":"Falu kommun"},"foaf:page":{"@id":"https://www.falun.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://falun.entryscape.net/store/2/resource/1"}},{"@id":"https://falun.entryscape.net/store/2/resource/5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Mät och karta","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matochkarta@falun.se"}},{"@id":"https://falun.entryscape.net/store/2/resource/52","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://falun.entryscape.net/store/2/resource/5"},"dcat:distribution":[{"@id":"https://falun.entryscape.net/store/2/resource/53"},{"@id":"https://falun.entryscape.net/store/2/resource/54"}],"dcat:keyword":[{"@language":"sv","@value":"Falun"},{"@language":"sv","@value":"Kolada"},{"@language":"sv","@value":"Kommunstatistik"},{"@language":"sv","@value":"Statistik"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kolada är en databas för jämförelser och analys av statistik avseende Sveriges\nkommuner och regioner. I denna datamängd kan användaren göra API-anrop\nmot Koladas databas och hämta olika nyckeltal för i första hand Falu\nkommun men även för andra kommuner och regioner.\n\nFalu kommun kommer avveckla denna datamängd den 31 maj 2025. För ytterligare information kontakta: matochkarta@falun.se"},"dct:issued":{"@type":"xsd:date","@value":"2022-02-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002221"},"dct:spatial":{"@id":"http://sws.geonames.org/2715458"},"dct:title":{"@language":"sv","@value":"Kommunstatistik Kolada"},"foaf:page":{"@id":"https://www.kolada.se/om-oss/api/"}},{"@id":"https://falun.entryscape.net/store/2/resource/53","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v2/data/municipality/2080/year/2021"},"dct:description":{"@language":"sv","@value":"Kommunstatistik för Falu kommun från Kolada. Det är enkelt att byta år genom att byta årtal i slutet på länken. För övrig information kring anrop se dokumentation."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Kommunstatistik från Kolada 2021"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://falun.entryscape.net/store/2/resource/54","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://api.kolada.se/v2/data/municipality/2080/year/2020"},"dct:description":{"@language":"sv","@value":"Kolada är en databas för jämförelser och analys av statistik avseende Sveriges\nkommuner och regioner. I denna datamängd kan användaren göra API-anrop\nmot Koladas databas och hämta olika nyckeltal för i första hand Falu\nkommun men även för andra kommuner och regioner."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Kommunstatistik från Kolada 2020"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:ea10eeae0f4ed267ac8fc0a3264006652828fcc5130a8737f6d5341c2716e73c"}]}
