{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"https://editera.dataportal.se/store/235/resource/1","@type":"dcat:Catalog","dcat:dataset":{"@id":"https://editera.dataportal.se/store/235/resource/4"},"dct:description":{"@language":"sv","@value":"Datakatalog för Landskrona stad"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001140"},"dct:title":{"@language":"sv","@value":"Landskrona stad"}}],"@id":"urn:source:49f96998fe1578fa2b7fe9f2170579306503ae96c1b41ac56c74cd8cad864109"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001140","@type":"foaf:Agent","dct:identifier":"2120001140","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://www.landskrona.se"},"foaf:mbox":{"@id":"mailto:digitala@landskrona.se"},"foaf:name":{"@language":"sv","@value":"Landskrona stad"},"foaf:page":{"@id":"https://www.landskrona.se"}},{"@id":"https://editera.dataportal.se/store/235/resource/4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/235/resource/9"},"dcat:distribution":[{"@id":"https://editera.dataportal.se/store/235/resource/5"},{"@id":"https://editera.dataportal.se/store/235/resource/7"},{"@id":"https://editera.dataportal.se/store/235/resource/8"}],"dcat:keyword":[{"@language":"sv","@value":"Landkrona stad"},{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"faktura"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Leverantörsreskontra – öppna data om leverantörsfakturor\nI datamängden leverantörsreskontra finns information om inköp som Landskrona stad har gjort.\n\nLeverantörsreskontra innehåller information om leverantörsfakturor som har kommit till Landskrona stad under respektive år/månad. Observera att Landskrona stad även kan ha utgifter som betalas ut utan koppling till en faktura.\n\nI leverantörsreskontra framgår hur varje faktura är bokförd, fakturabilden publiceras inte då den kan innehålla sekretess- eller personuppgifter. Personuppgifter är markerade som [innehåller personuppgifter].\n\nInformationen publiceras i tabellform och innehåller:\n\n- verifikationsnummer (Landskrona stads egen numrering)\n- leverantörens namn\n- leverantörens organisationsnummer\n- konto\n- kontotext (anger i klartext vilken slags kostnad det gäller)\n- konterat belopp exklusive moms\n- bokföringsdatum\n- förvaltning\n- fakturanummer"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001140"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor"}},{"@id":"https://editera.dataportal.se/store/235/resource/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.landskrona.se/leverantorsfakturor"},"dct:description":{"@language":"sv","@value":"Distribution av leverantörsfakturor för 2024 i CSV-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2024"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://editera.dataportal.se/store/235/resource/7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cms.landskrona.se/wp-content/uploads/2024/09/forteckning-leverantorsfakturor-2023.csv"},"dct:description":{"@language":"sv","@value":"Distribution av leverantörsfakturor för 2024 i CSV-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2023"}},{"@id":"https://editera.dataportal.se/store/235/resource/8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cms.landskrona.se/wp-content/uploads/2024/09/forteckning-leverantorsfakturor-2022.csv"},"dct:description":{"@language":"sv","@value":"Distribution av leverantörsfakturor för 2024 i CSV-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2022"}},{"@id":"https://editera.dataportal.se/store/235/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Redovisning - Landskrona stad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:redovisning@landskrona.se"}}],"@id":"urn:source:7f5229fdd96bd0f0218153723bb00d65abf2e03caa62e6bc3afedc188f8c3047"}]}
