kola i Uppsala. Mätningen sker på inkommande ledningar i skolans ställverk. Skolan har ca 1200 elever och ett centralkök viket producerar ca 2500 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat. Servisen in till skolan är på 1250 A (ampere)."}],"dct:issued":{"@type":"xsd:date","@value":"2021-01-26"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:a4daaaf49c2b148630006cf724f566e5f4e42c443480eaf2437097f0a9ea3da0_b0n0"},"dct:temporal":{"@id":"_:a4daaaf49c2b148630006cf724f566e5f4e42c443480eaf2437097f0a9ea3da0_b1n0"},"dct:title":[{"@language":"en","@value":"Measurments of 15 min energy consumption at Tiunda shool"},{"@language":"sv","@value":"Tiunda skola Uppsala - energimätning - 15 minuters data"}],"http://www.w3.org/2002/07/owl#versionInfo":"2020 version","http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"2020 version of electricity and energy data from Tiunda school"},{"@language":"sv","@value":"2020 års version av eleffekt och energidata från Tiunda skola"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/98","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Tiunda_skola_15min_avg_energy_kWh.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/98"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/98"},"dct:description":[{"@language":"en","@value":"Tiunda skola Uppsala. Measurements of energy use unit kilowatt hours (kWh) and 15 minutes resolution of collected published data. The measurements began in March."},{"@language":"sv","@value":"Tiunda skola Uppsala. Mätningar av energianvändning enheten kilowattimmar (kWh) och 15 minuters upplösning på insamlat publicerat data. Mätningarna inleddes i mars."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2021-01-26"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc-sa/4.0/"},"dct:title":[{"@language":"en","@value":"Measurments of 15 min energy consumption at Tiunda shool"},{"@language":"sv","@value":"Mätningar av 15 min energianvändning vid Tiunda skola Uppsala"}],"http://www.w3.org/ns/adms#status":{"@id":"http://purl.org/adms/status/Completed"}}],"@id":"urn:source:a4daaaf49c2b148630006cf724f566e5f4e42c443480eaf2437097f0a9ea3da0"},{"@graph":[{"@id":"_:ab2bf78caefa5e530eda9dfb8bf03e8c2fbe1a609e322cf610ee8dec3f27c21b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.610507986527466 59.86080530693619)"}},{"@id":"_:ab2bf78caefa5e530eda9dfb8bf03e8c2fbe1a609e322cf610ee8dec3f27c21b_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2021-06-22"}},{"@id":"https://stuns.entryscape.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/389","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/391"},{"@id":"https://stuns.entryscape.net/store/1/resource/393"},{"@id":"https://stuns.entryscape.net/store/1/resource/397"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"electicity"},{"@language":"en","@value":"energy"},{"@language":"en","@value":"peak power"},{"@language":"en","@value":"peak"},{"@language":"en","@value":"power"},{"@language":"sv","@value":"Effekt"},{"@language":"sv","@value":"Eleffekt"},{"@language":"sv","@value":"effekttopp"},{"@language":"sv","@value":"elektricitet"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"kraft"},{"@language":"sv","@value":"kök"},{"@language":"sv","@value":"matlagning"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H1M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Measurement data for instantaneous effect and energy use at Östra stenhagen school in Uppsala. The measurement takes place on incoming lines to the school's kitchen switchgear. The school has about 600 students and a central kitchen which produces about 1200 portions of food a day and also provides other schools and preschools and nursing homes with food. The service to the school kitchen is of 250 A (amperes)."},{"@language":"sv","@value":"Mätdata för momentan effekt och energianvändning vid Östra stenhagen skola i Uppsala. Mätningen sker på inkommande ledningar till skolans kök. Skolan har ca 600 elever och ett centralkök vilket producerar ca 1200 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat. Servisen in till skolans kök är på 250 A (ampere)."}],"dct:issued":{"@type":"xsd:date","@value":"2022-01-28"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2022-08-18"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:ab2bf78caefa5e530eda9dfb8bf03e8c2fbe1a609e322cf610ee8dec3f27c21b_b0n0"},"dct:temporal":{"@id":"_:ab2bf78caefa5e530eda9dfb8bf03e8c2fbe1a609e322cf610ee8dec3f27c21b_b1n0"},"dct:title"