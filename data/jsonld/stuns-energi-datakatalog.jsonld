n STUNS"}]},{"@id":"_:94b873b05918d477c0e6cbd1b03130edd33c701789edcecfb55233d00904b4c0_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":[{"@language":"sv","@value":"Skolfastigheter AB i Uppsala delar denna information i samarbete med stiftelsen STUNS"},{"@language":"sv","@value":"Skolfastigheter AB the school real estate owner in Uppsala shares this data in collaboration with the foundation STUNS"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/280","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/282"},{"@id":"https://stuns.entryscape.net/store/1/resource/284"},{"@id":"https://stuns.entryscape.net/store/1/resource/318"},{"@id":"https://stuns.entryscape.net/store/1/resource/320"},{"@id":"https://stuns.entryscape.net/store/1/resource/322"},{"@id":"https://stuns.entryscape.net/store/1/resource/339"},{"@id":"https://stuns.entryscape.net/store/1/resource/374"},{"@id":"https://stuns.entryscape.net/store/1/resource/376"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"electicity"},{"@language":"en","@value":"energy"},{"@language":"en","@value":"peak power"},{"@language":"en","@value":"peak"},{"@language":"en","@value":"power"},{"@language":"sv","@value":"Effekt"},{"@language":"sv","@value":"Eleffekt"},{"@language":"sv","@value":"effekttopp"},{"@language":"sv","@value":"elektricitet"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"kraft"},{"@language":"sv","@value":"kök"},{"@language":"sv","@value":"matlagning"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H1M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Measurement data for instantaneous effect and energy use at Östra stenhagen school in Uppsala. The measurement takes place on incoming lines to the school's kitchen switchgear. The school has about 600 students and a central kitchen which produces about 1200 portions of food a day and also provides other schools and preschools and nursing homes with food. The service to the school kitchen is of 250 A (amperes)."},{"@language":"sv","@value":"Mätdata för momentan effekt och energianvändning vid Östra stenhagen skola i Uppsala. Mätningen sker på inkommande ledningar till skolans kök. Skolan har ca 600 elever och ett centralkök vilket producerar ca 1200 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat. Servisen in till skolans kök är på 250 A (ampere)."}],"dct:issued":{"@type":"xsd:date","@value":"2022-01-28"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2022-08-18"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:94b873b05918d477c0e6cbd1b03130edd33c701789edcecfb55233d00904b4c0_b0n0"},"dct:temporal":{"@id":"_:94b873b05918d477c0e6cbd1b03130edd33c701789edcecfb55233d00904b4c0_b1n0"},"dct:title":[{"@language":"en","@value":"Östra stenhagen school kitchen Uppsala - power and energy readings 2021-06-22 to 2022-12-31"},{"@language":"sv","@value":"Östra stenhagen skola eleffektmätningar 2021-06-22 till 2022-12-31"}],"http://www.w3.org/ns/adms