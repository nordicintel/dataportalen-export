value":"högupplöst"},{"@language":"sv","@value":"kW"},{"@language":"sv","@value":"kWh"},{"@language":"sv","@value":"kilowatt"},{"@language":"sv","@value":"solel"},{"@language":"sv","@value":"solelanläggningar"},{"@language":"sv","@value":"solinstrålning"},{"@language":"sv","@value":"solpanel"},{"@language":"sv","@value":"väderdata"},{"@language":"sv","@value":"väderstationer"}],"dcat:landingPage":{"@id":"http://www.energiportalregionuppsala.se"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:creator":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:description":[{"@language":"en","@value":"Open API for production data Region Uppsala solar plants, 5 minutes resolution. Production data is collected at a higher resolution. Contact STUNS if you need a higher resolution, see contact person. See documentation in PDF."},{"@language":"sv","@value":"Öppet API till produktionsdata Region Uppsala solelanläggningar, 5 minuters upplösning. Insamlingen av produktionsdata sker på högre upplösning. Kontakta STUNS vid behov av högre upplösning, se kontaktperson.  Se dokumentation i PDF."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/9"},"dct:relation":{"@id":"http://www.energiportalregionuppsala.se"},"dct:spatial":{"@id":"_:1257fc09a14f057acbcbf617f162e27256d8c3a94240248381db1ce83d477871_b0n0"},"dct:title":[{"@language":"en","@value":"Open API for Solar Production Region Uppsala solar plants, 5 minutes resolution"},{"@language":"sv","@value":"Öppet API till Solelproduktion Region Uppsala solelanläggningar, 5 minuters upplösning"}],"foaf:page":[{"@id":"https://stuns.entryscape.net/store/1/resource/139"},{"@id":"https://stuns.entryscape.net/store/1/resource/351"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://stuns.entryscape.net/store/1/resource/140"}},{"@id":"https://stuns.entryscape.net/store/1/resource/137","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://stuns.entryscape.net/store/1/resource/140"},"dcat:accessURL":{"@id":"https://view.stuns.i0t.se/grafana/api/datasources/proxy/2/query"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H5M"},"dct:description":[{"@language":"en","@value":"API via Grafana. See attached documentation for instructions about use via calls with the program curl."},{"@language":"sv","@value":"API via Grafana. Se bifogad dokumentation för instruktioner om användning genom anrop med programmet curl."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"_:1257fc09a14f057acbcbf617f162e27256d8c3a94240248381db1ce83d477871_b1n0"},"dct:title":[{"@language":"en","@value":"RPC API"},{"@language":"sv","@value":"RPC API"}],"foaf:page":{"@id":"https://stuns.entryscape.net/store/1/resource/139"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"},"http://www.w3.org/ns/adms#status":{"@id":"http://purl.org/adms/status/UnderDevelopment"}},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}},{"@id":"https://stuns.entryscape.net/store/1/resource/9","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Region Uppsala"}}],"@id":"urn:source:1257fc09a14f057acbcbf617f162e27256d8c3a94240248381db1ce83d477871"},{"@graph":[{"@id":"_:172ec4c703f62f67701844463c16602b2ab7787f811b2ccc26fb6e46ed9e5ffe_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.63942120503267 59.83894419704649)"}},{"@id":"https://stuns.entryscape.net/store/1/resource/399","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":[{"@id":"https://uppsalaparkering.se/"},{"@id":"https://uppsalaparkering.se/om-oss-2/projekt/"}],"foaf:mbox":{"@id":"mailto:oppnadata@stuns.se"},"foaf:name":{"@language":"sv","@value":"Uppsala Parkering"}},{"@id":"https://stuns.entryscape.net/store/1/resource/400","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/403"},{"@id":"https://stuns.entryscape.net/store/1/resource/404"}],"dcat:keyword":["Uppsala Parkering",{"@language":"en","@value":"EV"},{"@language":"en","@value":"charging"},{"@language":"en","@value":"mobility"},{"@language":"sv","@value":"Elbil"},{"@language":"sv","@value":"laddning"},{"@language":"sv","@value":"mobilitet"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Eleffekt och energimätningar av parkeringshuset Dansmästaren i Uppsala. \n\n60 laddpunkter - 400+ parkeringsplatser.\n\nBatterilagring och solel med Energy Management System under utveckling i samskapandeprojekt med Uppsala Universitet\n\nSTUNS och Uppsala Parkering tillsammans med Uppsala Universitet skapar här en plats där test och utveckling kan ske i verklig miljö."},{"@language":"sv","@value":"Power and energy data from Parkeringshuset Dansmästaren i Uppsala.\n\n60 charging points - 400+ parking spots.\n\nEnergy storage and solar power with an Energy Management System under implementation in a co-creation with Uppsala Universitet\n\nSTUNS and Uppsala Parkering together with Uppsala Universitet skapar här en plats da test och utveckling kan ske i verklig miljö."}],"dct:issued":{"@type":"xsd:gYear","@value":"2023"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/399"},"dct:spatial":{"@id":"_:172ec4c703f62f67701844463c16602b2ab7787f811b2ccc26fb6e46ed9e5ffe_b0n0"},"dct:title":[{"@language":"en","@value":"Dansmästaren Uppsala - open innovation environment for EV charging and infrastructure"},{"@language":"sv","@value":"Dansmästaren Uppsala - öppen innovationsmiljö för elbilsladdning och infrastruktur"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/402","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"All Params Dansmästaren-data-as-seriestocolumns-2023-04-06 15 06 19.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/403","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/401"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/401"},"dct:description":[{"@language":"en","@value":"High-resolution Energy and effect data from measurements made at Dansmästaren - a mobility house built by Uppsala Parkering in Uppsala municipality. The building has approx. 400 parking spaces in the parking area, of which approx. 60 are charging stations for electric car charging. In the building there is a 120 kWh, 60 kW output energy storage and solar cells on the roof comprising approx. 50 kW. An energy management system takes care of the energy flows and the need for power in the parking part of the building, which also has student housing and a grocery store.\nData is presented in csv format and via API in associated distribution."},{"@language":"sv","@value":"Högupplöst Energi och effektdata från mätningar gjorda vid Dansmästaren - ett mobilitetshus uppfört av Uppsala Parkering i uppsala kommun. Byggnaden har ca 400 parkeringsplaster i parkeringsdelen varav ca 60 är laddstationer för elbilsladdning. I byggnaden finns ett 120 kWh, 60 kW uteffekt energilager och solceller på taket omfattande ca 50 kW. Ett energihanteringssystem tar hand om energiflödena och behovet av effekt inom parkeringsdelen av byggnaden i vilket även studentbostäder samt en livsmedelsbutik finns.\nData presenteras i csv format samt via API i tillhörande distribution."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLS"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc/4.0/"},"dct:title":[{"@language":"en","@value":"High resolution energy and power consumption data from Dansmästaren a mobility house built by Uppsala Parkering"},{"@language":"sv","@value":"Energi och effektmätningar högupplöst data Dansmästaren mobilitetshus Uppsala Parkering"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://stuns.entryscape.net/store/1/resource/404","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/402"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/402"},"dct:description":[{"@language":"en","@value":"High-resolution Energy and effect data from measurements made at Dansmästaren - a mobility house built by Uppsala Parkering in Uppsala municipality. The building has approx. 400 parking spaces in the parking area, of which approx. 60 are charging stations for electric car charging. In the building there is a 120 kWh, 60 kW output energy storage and solar cells on the roof comprising approx. 50 kW. An energy management system takes care of the energy flows and the need for power in the parking part of the building, which also has student housing and a grocery store.\nData is presented in csv format and via API in associated distribution."},{"@language":"sv","@value":"Högupplöst Energi och effektdata från mätningar gjorda vid Dansmästaren - ett mobilitetshus uppfört av Uppsala Parkering i uppsala kommun. Byggnaden har ca 400 parkeringsplaster i parkeringsdelen varav ca 60 är laddstationer för elbilsladdning. I byggnaden finns ett 120 kWh, 60 kW uteffekt energilager och solceller på taket omfattande ca 50 kW. Ett energihanteringssystem tar hand om energiflödena och behovet av effekt inom parkeringsdelen av byggnaden i vilket även studentbostäder samt en livsmedelsbutik finns.\nData presenteras i csv format samt via API i tillhörande distribution."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLS"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2023-04-08T14:13:52.157Z"},"dct:title":[{"@language":"en","@value":"High resolution energy and power consumption data from Dansmästaren a mobility house built by Uppsala Parkering"},{"@language":"sv","@value":"Energi och effektmätningar högupplöst data Dansmästaren mobilitetshus Uppsala Parkering"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}}],"@id":"urn:source:172ec4c703f62f67701844463c16602b2ab7787f811b2ccc26fb6e46ed9e5ffe"},{"@graph":[{"@id":"_:1c11e25caa669b31b73abf7d7ab1a8e6d702079a25cbc754b52c2192d362b4dd_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.065 60.25,18.36 60.25,18.36 59.63,17.065 59.63,17.065 60.25))"}},{"@id":"_:1c11e25caa669b31b73abf7d7ab1a8e6d702079a25cbc754b52c2192d362b4dd_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2020-10-14"}},{"@id":"_:1c11e25caa669b31b73abf7d7ab1a8e6d702079a25cbc754b52c2192d362b4dd_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":[{"@language":"en","@value":"Region Uppsala Real estates is the organisation responsible for carrying out these installations on their real estates during the period 2015-2018 in collaboration with STUNS.\n\nMore installations are underway int he time period 2019-2021 and the list will succesivly be updated."},{"@language":"sv","@value":"Region Uppsala Fastigheter och service organisationen som genomfört, bekostat och installerat denna flora av solcellsteknik i samverkan med STUNS.  \n\nFler solcellsinstallationer är under upphandling och kommer installeras under åren 2019-2021. Listan kommer uppdateras löpande då dessa färdigställs."}]},{"@id":"https://stuns.entryscape.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/14","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/16"},{"@id":"https://stuns.entryscape.net/store/1/resource/18"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"Bifacial solar cells"},{"@language":"en","@value":"Inverter"},{"@language":"en","@value":"Solar cells"},{"@language":"en","@value":"busbar"},{"@language":"en","@value":"half-cut cells"},{"@language":"en","@value":"monocrystaline"},{"@language":"en","@value":"polycrystaline"},{"@language":"sv","@value":"BiFacial"},{"@language":"sv","@value":"Solcell"},{"@language":"sv","@value":"Solel"},{"@language":"sv","@value":"Växelriktare"},{"@language":"sv","@value":"solcellsmodul"}],"dcat:landingPage":{"@id":"https://energiportalregionuppsala.se/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"The list comprises of the overall in information location, installed power etc. of respective solar power plant installed at the real estates within Region Uppsala. detailed in depth info on panel types, inverters, mounting and much more is foudn in the related resourse data set."},{"@language":"sv","@value":"Förteckningen består av övergripande information om de installerade solcellsanläggningarna vid Region Uppsalas fastigheter som plats, adress, installerad effekt, investeringskostnad osv. för respektive solcellsanläggning. Detaljerad information om tex solcellstyper, monteringssätt, växelritare och mycket mer återfinns i separat datamäng, se Relaterad resurs."}],"dct:issued":{"@type":"xsd:date","@value":"2019-08-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2020-10-14"},"dct:provenance":{"@language":"sv","@value":"STUNS i samverkan med Region Uppsala"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":[{"@id":"_:1c11e25caa669b31b73abf7d7ab1a8e6d702079a25cbc754b52c2192d362b4dd_b0n0"},{"@id":"http://sws.geonames.org/2666219"}],"dct:temporal":{"@id":"_:1c11e25caa669b31b73abf7d7ab1a8e6d702079a25cbc754b52c2192d362b4dd_b1n0"},"dct:title":[{"@language":"en","@value":"List of solar power plants at Region Uppsala real estates"},{"@language":"sv","@value":"Förteckning över solcellsanläggningar vid Region Uppsalas fastigheter"}],"http://www.w3.org/2002/07/owl#versionInfo":"New version october 2020","http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"Third version, now ony containing the overall info of the solar power plants. The in depth, detailed info is published in a separate data source, see Related resource. New versions released when new solar plants have been installed - here three (3) new sites are presented."},{"@language":"sv","@value":"Tredje utgåvan med enbart övergripande information, ny version kommer när nya anläggningar installerats. Den detaljerade informationen på växelriktarnivå samt solpanelsnivå har flyttats till en ny datamängd, se Relaterad resurs. I denna version finns tre (3) nya solelanläggningar presenterade."}]},{"@id":"https://stuns.entryscape.net/store/1/resource/15","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Fo rteckning o ver solcellsanla ggningar vid Region Uppsalas fastigheter-csv-1.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/15"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/15"},"dct:description":{"@language":"en","@value":"List comprising of the various:\n- Types of solar cells installed e.g. mono, poly, half-cut, BiFacial, number of bus bars.\n- The different module types e.g. with frame, frame less, PERC.\n- Installation location, tilt angle, azimuth.\n- Installer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2019-08-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-08T16:32:22+01:00"},"dct:rights