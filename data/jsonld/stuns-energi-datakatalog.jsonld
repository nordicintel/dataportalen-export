pe.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/102","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/104"},{"@id":"https://stuns.entryscape.net/store/1/resource/106"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"cooking"},{"@language":"en","@value":"electricity"},{"@language":"en","@value":"energy"},{"@language":"en","@value":"kitchen"},{"@language":"en","@value":"peak energy"},{"@language":"en","@value":"peak"},{"@language":"en","@value":"power"},{"@language":"sv","@value":"elektricitet"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"energitopp"},{"@language":"sv","@value":"kraft"},{"@language":"sv","@value":"kök"},{"@language":"sv","@value":"matlagning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Measurement data for energy use at Tiunda school in Uppsala, 60 minutes average. The measurement takes place on incoming lines in the school's switchgear. The school has about 1200 students and a central kitchen which produces about 2500 portions of food a day and also provides other schools and preschools and nursing homes with food. The service to the school is at 1250 A (amperes)."},{"@language":"sv","@value":"Mätdata för energianvändning vid Tiunda skola i Uppsala, 60 minuters medelvärde. Mätningen sker på inkommande ledni