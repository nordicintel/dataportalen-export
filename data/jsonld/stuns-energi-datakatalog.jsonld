age":"sv","@value":"högupplöst"},{"@language":"sv","@value":"solelanläggningar"}],"dcat:landingPage":{"@id":"https://energiportalregionuppsala.se"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H5M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Solar power production data from appointed solar power plant at Region Uppsala. The production data is presented in 5 minute resolution. The data collection has a higher resolution. Contact STUNS if higher resolution is required, see contact.\n\nParameters: Active power [kW], active energy [Wh], frequency [Hz], Inverter Power [W], Inverter total current [A]\n\nFor detailed information regarding the solar power plant at hand, see related resource and plant id as well as the referenced home page, see related resoursce section."},{"@language":"sv","@value":"Solelproduktionsdata för aktuell solelanläggning hos Region Uppsala  under 2019 till 2021. Produktionsdata är här presenterad i 5 minuters upplösning, insamlingen sker på högre upplösning. Kontakta STUNS vid behov av högre upplösning, se kontaktperson.\n\nParametrar: Aktiv effekt [kW], producerad energi [Wh], frekvens [Hz], Växelriktareffekt [W], Total ström Växelriktare [A]\n\nFör detaljer om anläggningen se relaterad resurs och anläggnings id samt hemsidan."}],"dct:identifier":"https://energiportalregionuppsala.se/about?device=A1157_AS3","dct:issued":{"@type":"xsd:date","@value":"2021-08-18"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:relation":[{"@id":"https://energiportalregionuppsala.se/"},{"@id":"https://www.dataportal.se/sv/datasets/763_1482/detaljerad-forteckning-over-solcellsanlaggningar-vid-region-uppsalas-fastigheter#ref=?p=1&q=f%C3%B6rteckning%20solel&s=2&t=20&f=&rt=dataset%2524esterms_IndependentDataService%2524esterms_ServedByDataService&c=false"}],"dct:spatial":{"@id":"_:d2133ece11b5fa059ea3d7507c56974011723e9ac34654c6f5c7ce83f8affd93_b0n0"},"dct:temporal":{"@id":"_:d2133ece11b5fa059ea3d7507c56974011723e9ac34654c6f5c7ce83f8affd93_b1n0"},"dct:title":[{"@language":"en","@value":"Solar production data F15 REgion Uppsala 2019-2021, 5 min resolution"},{"@language":"sv","@value":"Solelproduktionsdata hus F15 Region Uppsala solelanläggning 2019-2021, 5 min upplösning"}],"http://www.w3.org/2002/07/owl#versionInfo":"första version","http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"första utgivning"}},{"@id":"https://stuns.entryscape.net/store/1/resource/203","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"F15 (A1157_AS3) Production data 5min 2019 to 2021.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/204","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/203"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/203"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dct:description":[{"@language":"en","@value":"Solar production data for the period 2019 to 2021, some loss of data which gives empty points (no) values."},{"@language":"sv","@value":"Solelproduktionsdata för period 2019 till 2021, visst bortfall av data vilket ger tomma punkter (inga) värden."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2021-10-29"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc/4.0/"},"dct:title":[{"@language":"en","@value":"F15 2019_2021 Solar production data 5min_res"},{"@language":"sv","@value":"F15 2019_2021 Solar production data 5min_res"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://purl.org/adms/status/Completed"}},{"@id":"https://stuns.entryscape.net/store/1/resource/206","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://stuns.entryscape.net/rowstore/dataset/3e9fd4af-dcdd-4532-92c6-fb122a9a0440"},"dct:conformsTo":{"@id":"https://stuns.entryscape.net/rowstore/dataset/3e9fd4af-dcdd-4532-92c6-fb122a9a0440/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://stuns.entryscape.net/store/1/resource/204"}},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}}],"@id":"urn:source:d2133ece11b5fa059ea3d7507c56974011723e9ac34654c6f5c7ce83f8affd93"},{"@graph":[{"@id":"_:d6bae411caf22ac8ea62ee9631fcaac32012170df4f5bbb3a114d74c9df46c43_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.64029997407424 59.846249710408564,17.641953492662488 59.846249710408564,17.641953492662488 59.845268837568476,17.64029997407424 59.845268837568476,17.64029997407424 59.846249710408564))"}},{"@id":"_:d6bae411caf22ac8ea62ee9631fcaac32012170df4f5bbb3a114d74c9df46c43_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2021-11-18"},"dcat:startDate":{"@type":"xsd:date","@value":"2019-01-01"}},{"@id":"https://stuns.entryscape.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/261","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":{"@id":"https://stuns.entryscape.net/store/1/resource/263"},"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"Region Uppsala"},{"@language":"en","@value":"Solar irradiance"},{"@language":"en","@value":"Solar production"},{"@language":"en","@value":"high resolution"},{"@language":"en","@value":"solar power plants"},{"@language":"sv","@value":"Bifacial"},{"@language":"sv","@value":"Region Uppsala"},{"@language":"sv","@value":"Solinstrålning"},{"@language":"sv","@value":"högupplöst"},{"@language":"sv","@value":"solelanläggningar"}],"dcat:landingPage":{"@id":"https://energiportalregionuppsala.se"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H5M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Solar Irradiance data from appointed solar power plant at Region Uppsala. The Irradiance data is presented in 5 minute resolution. The data collection has a higher resolution. Contact STUNS if higher resolution is required, see contact.\n\nParameters: Irradiance [W per m2]\n\nFor detailed information regarding the solar power plant at hand, see related resource and plant id as well as the referenced home page, see related resoursce section."},{"@language":"sv","@value":"Solinstrålningsdata för aktuell solelanläggning hos Region Uppsala  under 2019 till 2021. Data är här presenterad i 5 minuters upplösning, insamlingen sker på högre upplösning. Kontakta STUNS vid behov av högre upplösning, se kontaktperson.\n\nParametrar: Solinstrålning [W per m2]\n\nFör detaljer om anläggningen se relaterad resurs och anläggnings id samt hemsidan."}],"dct:identifier":"https://energiportalregionuppsala.se/about?device=A1221_C11","dct:issued":{"@type":"xsd:date","@value":"2021-11-18"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:relation":[{"@id":"https://energiportalregionuppsala.se/"},{"@id":"https://www.dataportal.se/sv/datasets/763_1482/detaljerad-forteckning-over-solcellsanlaggningar-vid-region-uppsalas-fastigheter#ref=?p=1&q=f%C3%B6rteckning%20solel&s=2&t=20&f=&rt=dataset%2524esterms_IndependentDataService%2524esterms_ServedByDataService&c=false"}],"dct:spatial":{"@id":"_:d6bae411caf22ac8ea62ee9631fcaac32012170df4f5bbb3a114d74c9df46c43_b0n0"},"dct:temporal":{"@id":"_:d6bae411caf22ac8ea62ee9631fcaac32012170df4f5bbb3a114d74c9df46c43_b1n0"},"dct:title":["Solinstålningsdata C11, C2C3 Region Uppsala solelanläggningar 2019-2021, 5 min upplösning",{"@language":"sv","@value":"Solar Irradiance C11, C2C3 Region Uppsala solar power plants 2019-2021, 5 min res"}],"http://www.w3.org/2002/07/owl#versionInfo":"andra version","http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"2019 och 2021 tilllagt i datamängden"}},{"@id":"https://stuns.entryscape.net/store/1/resource/262","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Solar Irradiance Uppsala C2C3, C11 (Watt_m2) 2019-2021.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/263","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/262"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/262"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"}},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}}],"@id":"urn:source:d6bae411caf22ac8ea62ee9631fcaac32012170df4f5bbb3a114d74c9df46c43"},{"@graph":[{"@id":"_:e8fc1c1a53c1a39bd8f26996e32dae46baef3e7a9551df22b5aab19df70e3ea9_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.61046 59.86093)"}},{"@id":"_:e8fc1c1a53c1a39bd8f26996e32dae46baef3e7a9551df22b5aab19df70e3ea9_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2022-09-13"},"dcat:startDate":{"@type":"xsd:date","@value":"2021-05-25"}},{"@id":"https://stuns.entryscape.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/352","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/354"},{"@id":"https://stuns.entryscape.net/store/1/resource/356"},{"@id":"https://stuns.entryscape.net/store/1/resource/359"},{"@id":"https://stuns.entryscape.net/store/1/resource/362"},{"@id":"https://stuns.entryscape.net/store/1/resource/364"},{"@id":"https://stuns.entryscape.net/store/1/resource/366"},{"@id":"https://stuns.entryscape.net/store/1/resource/370"},{"@id":"https://stuns.entryscape.net/store/1/resource/387"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"Electricity"},{"@language":"en","@value":"Energy"},{"@language":"en","@value":"Peak power"},{"@language":"en","@value":"Power"},{"@language":"sv","@value":"Effekt"},{"@language":"sv","@value":"Effekttoppar"},{"@language":"sv","@value":"El"},{"@language":"sv","@value":"Energi"},{"@language":"sv","@value":"Skolkök"},{"@language":"sv","@value":"Solproduktion"},{"@language":"sv","@value":"Undermätare"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"This measurements were part of a project and thus will not be updated further. Hopefully the data can still be usefull. \n\nMeasurements are divided into different parts of the school. For every section energy, power and voltage are measured.\n\nMeasurements are from the main electrical central of the school where power is distributed to:  \nA1A_Verk_Skolan (School)\nA1B_Verk_Skolan (School)\nA1C_Verk_Skolan (School)\nA1D_Fast_Fläktrum (Ventilation, Fans)\nA1E_Verk_Förskolan (kindergarden)\nA1F_Verk_Storkök (Kitchen)\nA1G_Fast_källaren (Basement)\nA1I_Producerad_Solel (Produced Solar panels)\nA1M_Fast_Ventilation (Other ventilation)\nB1_fast_verk_idrottshall (Gym hall)"},{"@language":"sv","@value":"Dessa mätresultat kommer från ett projekt och därför kommer den inte uppdateras vidare. Förhoppningsvis finns tillräckligt med data för att se trender. \n\nMätning från olika delar av skolan, bland mätvärdena finns Energi, Effekt och spänning. \n\nMätningen sker i skolans elcentral som delar in skolan i följande sektioner: \n\nA1A_Verk_Skolan \nA1B_Verk_Skolan\nA1C_Verk_Skolan\nA1D_Fast_Fläktrum\nA1E_Verk_Förskolan\nA1F_Verk_Storkök\nA1G_Fast_källaren\nA1I_Producerad_Solel\nA1M_Fast_Ventilation\nB1_fast_verk_idrottshall\n\n\nSkolan har ca 1200 elever och ett centralkök viket producerar ca 2500 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat."}],"dct:issued":{"@type":"xsd:date","@value":"2022-11-25"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:e8fc1c1a53c1a39bd8f26996e32dae46baef3e7a9551df22b5aab19df70e3ea9_b0n0"},"dct:temporal":{"@id":"_:e8fc1c1a53c1a39bd8f26996e32dae46baef3e7a9551df22b5aab19df70e3ea9_b1n0"},"dct:title":[{"@language":"en","@value":"Energymeter, Tiundaskolan, 5 min resolution"},{"@language":"sv","@value":"Energimätning, undermätare Tiundaskolan Uppsala, 5 min upplösning"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/353","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Undermatare_Tiunda_Energy.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/354","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/353"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/353"},"dct:description":[{"@language":"sv","@value":"Data formaterad som komma separerad CSV, datum på formatet \"ÅÅÅÅ-MM-DD HH:mm:ss\" Data angivet i kWh för respektive undermätare. Totalt 10 olika mätare"},{"@language":"sv","@value":"Data formatted as comma seperated CSV file. Date is given as \"yyyy-MM-dd hh:mm:ss\" Data presented in kWh for the different sections of the school. In total 10 section make up the entire school."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc-sa/4.0/"},"dct:title":[{"@language":"en","@value":"Energy data [kWh] Tiundaskolan 2021-05-25 to 2022-09-19"},{"@language":"sv","@value":"Energidata [kWh] Undermätare Tiundaskolan 2021-05-25 till 2022-09-19"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://stuns.entryscape.net/store/1/resource/355","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Undermatare_Tiunda_Power.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/356","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/355"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/355"},"dct:description":[{"@language":"en","@value":"Data formatted as comma seperated CSV file. Date is given as \"yyyy-MM-dd hh:mm:ss\" Data presented in W for the different sections of the school. In total 10 section make up the entire school."},{"@language":"sv","@value":"Data formaterad som komma separerad CSV, datum på formatet \"ÅÅÅÅ-MM-DD HH:mm:ss\"Data angivet i W för respektive undermätare. Totalt 10 olika mätare"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{