e.net/store/1/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/118","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/120"},{"@id":"https://stuns.entryscape.net/store/1/resource/122"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"Bifacial solar cells"},{"@language":"en","@value":"Inverter"},{"@language":"en","@value":"Solar cells"},{"@language":"en","@value":"busbar"},{"@language":"en","@value":"efficiency"},{"@language":"en","@value":"half-cut cells"},{"@language":"en","@value":"monocrystaline"},{"@language":"en","@value":"polycrystaline"},{"@language":"sv","@value":"BiFacial"},{"@language":"sv","@value":"Solcell"},{"@language":"sv","@value":"Solel"},{"@language":"sv","@value":"Växelriktare"},{"@language":"sv","@value":"effektivitet"},{"@language":"sv","@value":"solcellsmodul"}],"dcat:landingPage":{"@id":"https://energiportalregionuppsala.se/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"The list comprises of the in depth detalis of the respective solar power plant installed at the real estates within Region Uppsala. Spcific information on parameters such as the type of solar power modules and their techniques, types, construction, efficiency etc. Also information of inverter types and efficiency. Also included location type mounting system installed power etc. Also see the Overall data source as linked."},{"@language":"sv","@value":"Förteckningen består av detaljerad information om de installerade solcellsanläggningarna vid Region Uppsalas fastigheter som plats, adress, solcellsteknik, installerad effekt, monteringsanvisning osv. för respektive solcellsanläggning."}],"dct:issued":{"@type":"xsd:date","@value":"2019-08-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2020-10-14"},"dct:provenance":{"@language":"sv","@value":"STUNS i samverkan med Region Uppsala"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":[{"@id":"_:758a47fdc3f86ed37958ef9e26a3e00de84284071247a65d972d9e61a816591e_b0n0"},{"@id":"http://sws.geonames.org/2666219"}],"dct:temporal":{"@id":"_:758a47fdc3f86ed37958ef9e26a3e00de84284071247a65d972d9e61a816591e_b1n0"},"dct:title":[{"@language":"en","@value":"Detailed information of the solar power plants at Region Uppsala real estates"},{"@language":"sv","@value":"Detaljerad förteckning över solcellsanläggningar vid Region Uppsalas fastigheter"}],"http://www.w3.org/2002/07/owl#versionInfo":"First version of the detailed list (feb -21)","http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"The third edition, which now only contains detailed information about each plant at the level of specific inverters and solar panels, new version when new solar plants have been installed."},{"@language":"sv","@value":"Tredje utgåvan som nu enbart innehåller detaljerad information om respektive anläggning på nivån specifik växelriktare samt solpanel, ny version kommer när nya anläggningar installerats. Se separat datamängd för övergripande information."}]},{"@id":"https://stuns.entryscape.net/store/1/resource/119","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Detaljerad Förteckn