 ID 15-17."},{"@language":"sv","@value":"Här finns solelproduktionsdata från det tre hus vid Enköpings lasarett vilka försetts med solelanläggningar.\nHus A, Hus B samt Hus C\n\nSe relaterad resurs för information om adress, storlekar, tekniker mm. ID 15-17."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:relation":{"@id":"https://www.dataportal.se/sv/datasets/763_333/forteckning-over-solcellsanlaggningar-vid-region-uppsalas-fastigheter"},"dct:spatial":{"@id":"_:d187794b8f49e0ea5bf3abe480e5da09ab006195d8ed883f91e1a747e44d82af_b0n0"},"dct:title":[{"@language":"en","@value":"Solar production at Enköping Care Center"},{"@language":"sv","@value":"Solelproduktion Enköpings Lasarett"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}},{"@id":"https://stuns.entryscape.net/store/1/resource/73","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Enkoping_husB 2019 Wh Energymeter and Inverters 5 min res.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/73"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/73"},"dct:description":{"@language":"en","@value":"Enkoping_husB 2019 Wh Energymeter and Inverters 5 min res"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc-sa/4.0/"}},{"@id":"https://stuns.entryscape.net/store/1/resource/76","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://stuns.entryscape.net/rowstore/dataset/852b153