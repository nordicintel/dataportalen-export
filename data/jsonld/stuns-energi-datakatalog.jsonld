},"foaf:homepage":{"@id":"https://stunsenergi.se"},"foaf:mbox":{"@id":"mailto:info@stuns.se"},"foaf:name":"STUNS Energi"},{"@id":"https://stuns.entryscape.net/store/1/resource/66","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"STUNS Energi Öppna Data-kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@stuns.se"}},{"@id":"https://stuns.entryscape.net/store/1/resource/92","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":{"@id":"https://stuns.entryscape.net/store/1/resource/94"},"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"electicity"},{"@language":"en","@value":"energy"},{"@language":"en","@value":"peak power"},{"@language":"en","@value":"peak"},{"@language":"en","@value":"power"},{"@language":"sv","@value":"Effekt"},{"@language":"sv","@value":"Eleffekt"},{"@language":"sv","@value":"effekttopp"},{"@language":"sv","@value":"elektricitet"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"kraft"},{"@language":"sv","@value":"kök"},{"@language":"sv","@value":"matlagning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Measurement data for instantaneous effect and energy use at Tiunda school in Uppsala. The measurement takes place on incoming lines in the school's switchgear. The school has about 1200 students and a central kitchen which produces about 2500 portions of food a day and also provides other schools and preschools and nursing homes with food. The service to the school is at 1250 A (amperes)."},{"@language":"sv","@value":"Mätdata för momentan effekt och energianvändning vid Tiunda skola i Uppsala. Mätningen sker på inkommande ledningar i skolans ställverk. Skolan har ca 1200 elever och ett centralkök viket producerar ca 2500 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat. Servisen in till skolan är på 1250 A (ampere)."}],"dct:issued":{"@type":"xsd:date","@value":"2021-01-26"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:2a3790001efde91282a274d40dae66788a02af3223db5b85b5e9529ed3b6d760_b0n0"},"dct:temporal":{"@id":"_:2a3790001efde91282a274d40dae66788a02af3223db5b85b5e9529ed3b6d760_b1n0"},"dct:title":[{"@language":"en","@value":"Tiunda School Uppsala - power measurments 2020 - ! min resolution"},{"@language":"sv","@value":"Tiunda skola Uppsala - eleffektmätningar 2020 - 1 min upplösning"}],"http://www.w3.org/2002/07/owl#versionInfo":"2020 version","http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"2020 version of electricity and energy data from Tiunda school"},{"@language":"sv","@value":"2020 års version av eleffekt och energidata från Tiunda skola"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/93","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Tiunda Power kW 2020 1 min res.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/93"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/93"},"dct:description":[{"@language":"en","@value":"Tiunda school Uppsala. Measurements of electric power consumption in the unit kilowatt (kW) and 1 minute resolution of collected published data. The measurements began in March."},{"@language":"sv","@value":"Tiunda skola Uppsala. Mätningar av eleffektförbrukning i enheten kilowatt (kW) och 1 minuts