om/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://stuns.entryscape.net/store/1/resource/66"},"dcat:distribution":[{"@id":"https://stuns.entryscape.net/store/1/resource/276"},{"@id":"https://stuns.entryscape.net/store/1/resource/279"},{"@id":"https://stuns.entryscape.net/store/1/resource/310"},{"@id":"https://stuns.entryscape.net/store/1/resource/312"},{"@id":"https://stuns.entryscape.net/store/1/resource/314"},{"@id":"https://stuns.entryscape.net/store/1/resource/316"},{"@id":"https://stuns.entryscape.net/store/1/resource/378"},{"@id":"https://stuns.entryscape.net/store/1/resource/381"},{"@id":"https://stuns.entryscape.net/store/1/resource/382"}],"dcat:keyword":["STUNS Energi",{"@language":"en","@value":"electicity"},{"@language":"en","@value":"energy"},{"@language":"en","@value":"peak power"},{"@language":"en","@value":"peak"},{"@language":"en","@value":"power"},{"@language":"sv","@value":"Effekt"},{"@language":"sv","@value":"Eleffekt"},{"@language":"sv","@value":"effekttopp"},{"@language":"sv","@value":"elektricitet"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"kraft"},{"@language":"sv","@value":"kök"},{"@language":"sv","@value":"matlagning"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H1M"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Measurement data for instantaneous effect and energy use at Ärentuna school in Uppsala. The measurement takes place on incoming lines to the school's kitchen switchgear. The school has about 600 students and a central kitchen which produces about 1200 portions of food a day and also provides other schools and preschools and nursing homes with food. The service to the school kitchen is at ??? A (amperes)."},{"@language":"sv","@value":"Mätdata för momentan effekt och energianvändning vid Ärentuna skola i Uppsala. Mätningen sker på inkommande ledningar till skolans kök. Skolan har ca 600 elever och ett centralkök vilket producerar ca 1200 portioner mat om dagen och förser även andra skolor och förskolor samt äldreboenden med mat. Servisen in till skolans kök är på ??? A (ampere)."}],"dct:issued":{"@type":"xsd:date","@value":"2022-01-28"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2022-08-17"},"dct:publisher":{"@id":"https://stuns.entryscape.net/store/1/resource/1"},"dct:spatial":{"@id":"_:52fc4cb075155d350af1515baebcef5f769d41829e25e2f25c8dff218ab90d3f_b0n0"},"dct:temporal":{"@id":"_:52fc4cb075155d350af1515baebcef5f769d41829e25e2f25c8dff218ab90d3f_b1n0"},"dct:title":[{"@language":"en","@value":"Ärentuna school kitchen Uppsala - power and energy readings 2021-2022"},{"@language":"sv","@value":"Ärentuna skolkök Uppsala - eleffekt och energitmätningar 2021-2022"}],"http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"2021 version of electricity and energy data from Domarringen school Uppsala"},{"@language":"sv","@value":"2021 års version av eleffekt och energidata från Domarringens skola Uppsala"}]},{"@id":"https://stuns.entryscape.net/store/1/resource/275","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Ärentuna School measurment data 1min res 2021-05-26 to 2022-01-28.csv"},{"@id":"https://stuns.entryscape.net/store/1/resource/276","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stuns.entryscape.net/store/1/resource/275"},"dcat:downloadURL":{"@id":"https://stuns.entryscape.net/store/1/resource/275"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P0Y0M0DT0H5M"},"dct:description":[{"@language":"en","@value":"Ärentuna Scho