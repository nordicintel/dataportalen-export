ontactPoint":{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4"},"dcat:distribution":[{"@id":"urn:uuid:41f8794a-71cd-d412-f606-18a7019bb5ac"},{"@id":"urn:uuid:9475c167-020e-3f44-0844-05e7750e4689"},{"@id":"urn:uuid:a9b22867-7529-a0b5-449d-4e5277787157"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Värdefulla dellandskap i Östra Vätterbrantsområdet, från skogsstrategin"},"dct:identifier":"2020dd73-7416-4238-8273-a3591812ba2d","dct:issued":{"@type":"xsd:date","@value":"2007-06-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-03-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:416fe0e0f34cd8b20e60c0a8d1c2b8e03e38a7ad8463fa5ecda6a84b6c0e0738_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Värdefulla dellandskap i Östra Vätterbrantsområdet"}},{"@id":"urn:uuid:41f8794a-71cd-d412-f606-18a7019bb5ac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_3/MapServer/14"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Enheten för naturskydd och tillsyn","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:416fe0e0f34cd8b20e60c0a8d1c2b8e03e38a7ad8463fa5ecda6a84b6c0e0738_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Enheten för naturskydd och tillsyn"},{"@id":"urn:uuid:9475c167-020e-3f44-0844-05e7750e4689","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_3/MapServer/WMSServer?layers=lstf_vardefulla_dellandskap_i_ostra_vatterbrantsomradet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Vardefulla_dellandskap_i_Ostra_Vatterbrantsomradet (WMS)"}},{"@id":"urn:uuid:a9b22867-7529-a0b5-449d-4e5277787157","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_naturvard_EXT/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:416fe0e0f34cd8b20e60c0a8d1c2b8e03e38a7ad8463fa5ecda6a84b6c0e0738"},{"@graph":[{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Distriktsindelningen är en justerad version av den församlingsindelning som gällde 1999-12-31. Justeringar sker genom att enklaver som uppfyller följande kriterier ex-kluderas:\n•\tEnklaven utgör max fem procent av församlingens totala areal.\n•\tEnklaven innehåller inte en kyrka.\n•\tEnklaven har fem eller färre folkbokförda inom ytan år 2014.\nIngen justering mot dagens kommun- och/eller fastighetsgräns har gjorts.\nFörslagen till namnsättning av distrikten har tagits fram genom ett samrådsförfa-rande med Lantmäteriet, Institutet för språk och folkminnen, Riksantikvarieämbetet, Riksarkivet, Statistiska centralbyrån, Skatteverket, Svenska kyrkan, Sveriges hem-bygdsförbund samt Sveriges kommuner och Landsting."}},{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1999-12-31"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a1bff81d-5b69-483d-bd10-497ddb934b53","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:749f3b5f-11c0-bea0-4ab9-baaa2746fca7"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Distriktsindelning Nedladdning, vektor visar Sveriges indelning i distrikt, som ytor med distriktskod och distriktsnamn som attribut. Denna geografiska indelning av vårt land utgörs av 2523 områden."},"dct:identifier":"a1bff81d-5b69-483d-bd10-497ddb934b53","dct:issued":{"@type":"xsd:date","@value":"2015-12-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-02"},"dct:provenance":{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b1n0"},"dct:temporal":{"@id":"_:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63_b2n0"},"dct:title":{"@language":"sv","@value":"Distriktsindelning Nedladdning, vektor"}},{"@id":"urn:uuid:749f3b5f-11c0-bea0-4ab9-baaa2746fca7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/distriktsindelning-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktsida för Distriktsindelning Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktsida för Distriktsindelning Nedladdning"}}],"@id":"urn:source:418d87421713acbe3ce236b895894a5682c4ef6224326291a6f3accb9b7e8d63"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004573","@type":"foaf:Agent","dct:identifier":"2021004573","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:kansli@sametinget.se"},"foaf:name":{"@language":"sv","@value":"Sametinget"},"foaf:page":{"@id":"https://www.sametinget.se"}},{"@id":"https://www.geodata.se/resources/1c347d76-ee66-4f9a-9be8-bfe2cd713290","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.sametinget.se/INSPIRE/atom/atom-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdnings- tjänsten levererar en GML- fil som redovisar renskötselns ungefärliga utbredning i Sverige vilket är Sametingets sätt att ge en konceptuell bild av var renskötselrätt i dagsläget utövas och kan anses föreligga med stöd av bl.a. urminnes hävd. För vissa områden råder det oenighet om renskötselrättens utbredning. Till stöd för underlaget har Gränsdragningskommissionens utredning (SOU2006:14) använts. Den avsåg att ge vägledning när det gäller var renskötselrätt i större eller mindre grad kan föreligga. Den sammanställning av kunskapsunderlag som utredningen gjorde är omfattande och kan användas för att ge fingervisningar om renskötselrätten utbredning, även om utredningens slutsatser och ställningstaganden kan ifrågasättas. \nFör vidare rättslig information av relevans för tolkning av datamängden hänvisas till rennäringslagen och avgöranden i allmän domstol."},"dct:identifier":"1c347d76-ee66-4f9a-9be8-bfe2cd713290","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004573"},"dct:title":{"@language":"sv","@value":"Renskötselområdets ungefärliga utbredning i Sverige Inspire nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:41b2f392e9948b874369da8589897b519e8585d480d74107f5bba9d80a7b537a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/4507442d-e0ee-4504-93de-1b214de1c591","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/modaldata-varmeledningstal?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänst för datamängden Modaldata och värmeledningstal (öppna data).\n\nVisningstjänsten Modaldata och värmeledningstal visar observerad mineralsammansättning från prover och beräknat för olika bergarter. Värmeledningstalet har för varje prov beräknats som ett viktat geometriskt medelvärde utifrån uppgifter om de enskilda mineralens volymandelar och deras värmeledningstal.\n\nInformationen kan användas för översiktlig planering av geoenergianläggningar."},"dct:identifier":"4507442d-e0ee-4504-93de-1b214de1c591","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Modaldata och värmeledningstal (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:41c8a4dd84edeb54e5ee770391d494ad0395e4866f31ebcb5255576441976833"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/0614e9c5-7648-4280-a77d-ec34c0fa2e03","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"hhttps://geotorget.lantmateriet.se/geodataprodukter/fastighetsindelning-visning-vector-tiles-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Fastighet Visning, vector tiles är en visningstjänst bestående av ytor, gränser, punkter och text för fastigheter och andra administrativa enheter, till exempel läns- och, kommunytor, fastighetsgränser och fastighetsgränspunkt.\nFormatet, vector tiles, ger andra möjligheter för användning än visningstjänster i rasterformat. Produkten ger möjlighet att koppla ihop information från kartan med våra direktåtkomsttjänster. Dessutom kan egna stilfiler definieras för ett eget utseende på kartan. Informationen visas upp till skala 1: 10 000."},"dct:identifier":"0614e9c5-7648-4280-a77d-ec34c0fa2e03","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighetsindelning Visning, vector tiles"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:420026c83afffbc8e9a97849f580b4cde9a573108bae43e20fc0d93db6b4ceba"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/eb9a187c-955b-4f40-9aa2-98dbeb9a7801","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-skenbar-resistivitet"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten visar den skenbara resistiviteten i ett förenklat raster med 200 gånger 200 meters upplösning. Den underliggande informationen kan beställas i datamängden Geofysiska flygmätningar, elektromagnetiska fält, VLF (detaljerad), då med en högre upplösning. \n\nDen skenbara resistiviteten representerar inte absoluta värden av markens resistivitet utan visar enbart relativa förändringar från ett förmodat normalvärde. Normalvärdet är satt till 5000 Ωm.\n\nKartan över den skenbara resistiviteten avspeglar både berggrundens och jordlagrens sammansättning. Djupkänningen är beroende av markens ledningsförmåga. Inom hällområden och områden med tunt jordtäcke visar kartan huvudsakligen berggrundens resistivitet. I områden med stora lermäktigheter begränsas djupkänningen på grund av den låga resistiviteten, och kartan visar därför främst jordlagrens resistivitet.\n\nKartan är framtagen från data insamlade med flygmätningar där den så kallade VLF-metoden (Very Low Frequency) har använts. SGU:s mätsystem för VLF registrerar både amplituden och fasen av det magnetiska fältet i tre ortogonala riktningar. Genom att registrera signal från två olika sändare samtidigt kan markens skenbara elektriska resistivitet beräknas med en metod framtagen av Becken och Pedersen (2003)."},"dct:identifier":"eb9a187c-955b-4f40-9aa2-98dbeb9a7801","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätninger, skenbar resistivitet (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:422e5bba2759dade45d08a96563a57f1d2bfa3ad18dc5f3f0c189976fd06bc83"},{"@graph":[{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kompletteras"}},{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.1378 62.2673,16.7036 62.2673,16.7036 59.8548,12.1378 59.8548,12.1378 62.2673))"}},{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.19546 62.13362,16.54677 62.13362,16.54677 59.94005,12.19546 59.94005,12.19546 62.13362))"}},{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/9148f99b-b998-45e5-baa7-d3a21e399660","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:97bbf95c-2fe8-d204-e050-8154035f1453"},"dcat:distribution":{"@id":"urn:uuid:06371299-dad4-b3d1-877c-992fbdec790e"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Syftet med detta lager är främst att geografiskt bestämma de platser som historiskt nyttjats för fäbodbruk i Dalarna. \nPunktskiktet innehåller även en del angivelser om finnbosättningar, fjällägenheter, nybyggen, kronotorp m.m. \n\nPunkten har i allmänhet placerats där tyngdpunkten i byggnadsbeståndet finns. \nPunkten ska ses som indikation på att agrara lämningar och bebyggelselämningar kan finnas i anslutning till denna. \nDenna databas är inte komplett och innefattar inte alla fäbodar, finnbosättningar m.m utan ska betraktas som ett arbetsdokument.\nArbetet med fäboddatabasen ägde huvudsakligen rum år 2005-2006. \nKompletterande bearbetning och uppdatering har ägt rum från år 2009 och senare år, fastän i mindre omfattning och detaljrikedom. \nSenare års kompletteringar baserar sig främst på uppgifter från historiska kartor påträffade i samband med ärendehandläggning och olika projekt. \n\nListan av fäbodvallar i fäbodpunkttemat har sitt ursprung och bygger på en maskinskriven förteckning som använts på Lantmäteriet i Falun. Listans ålder är okänd men kan antas ha tillkommit på 1940-60 talet. Listan kallas allmänt för ”fäbodlistan”, men torde ha tjänat som korslista för att snabbt hitta fram till de akter som finns på fäbodarna i länet och som enligt logiken i Lantmäteriets system enligt jordregistret naturligt fördes på stamfastigheten, dvs den by i vilken modergården ligger och vars by/traktnamn därför även medföljer själva fäbodinnehavet. Man kan misstänka att listan kompletterats med andra särskilt ägosplittrade och svårtolkade områden. Man kan även anta att listan har en äldre kanske handskriven förlaga, eftersom uppgifter med äldre namnbruk förekommer liksom särskilda noteringar om nedlagda fäbodbruk och noteringar för områden som verkar ha sedan länge ut klarade fastighetsförhållanden. Lantmäteriets ”fäbodlista” är uppställd efter det system för redovisning och arkivhållning genom jordregistersocknar som var grunden för Lantmäteriets fastighetsbildning och kartografi från 1900-talets början. Detta efterträddes med nuvarande fastighetsdataregistret i mitten av 1990-talet.\nI ”fäbodlistan” finns således sockenvis upptaget namn på platser (ortnamn) samt angivna aktnummer till Lantmäteriets kartarkiv. Aktnumren är fördelade på inäga, skog och övriga. I Lantmäteriets förteckning förekommer handskrivna markeringar av vissa aktnummer. Dessa leder erfarenhetsmässigt till de bästa översikterna. Sådana utgör framför allt de skifteskartor som upprättades i samband med storskifte, laga skifte, samt skifte för skogsmarken. Även andra större förrättningar förekommer. Därefter följer i listan en uppräkning av de byar som har ägoinnehav i fäboden. Även här förekommer vissa namn understrukna eller inringade. Aktnumren utgör även idag viktiga ingångar till \nLantmäteriets skannade kartarkiv. För ett antal ortsnamn saknas i varierande grad aktnummer och by tillhörighet. I kulturmiljöenhetens fäboddatabas har\ndessa markerats med tecknet ¤."},"dct:identifier":"9148f99b-b998-45e5-baa7-d3a21e399660","dct:issued":{"@type":"xsd:date","@value":"2021-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-12-15"},"dct:provenance":{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b1n0"},{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b2n0"}],"dct:title":{"@language":"sv","@value":"LstW Fäbodpunkter"}},{"@id":"urn:uuid:06371299-dad4-b3d1-877c-992fbdec790e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstw.pg205_Fabodpunkter.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:97bbf95c-2fe8-d204-e050-8154035f1453","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstW Enheten för kulturmiljö och samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dalarna@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstW Enheten för kulturmiljö och samhällsplanering"}],"@id":"urn:source:4245d3eab6b18a4a3086750235384a3bb84efb532bb9f88be7ee135561b36a8d"},{"@graph":[{"@id":"_:428f16d186b6ea65343bc550922041e5910c2cbb90febc003b564f75c70e7f85_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Information om isräfflor har samlats in i huvudsak i samband med SGUs jordartskartläggning.\n\nPositioneringsnoggrannheten kan variera beroende på vilket kartunderlag som använts i insamlingen. Noggrannheten i riktningsangivelserna kan uppskattas till +\\- 5 grader. Räfflornas hållbestämning (dvs. tolkningen av om isen rört sig från ena eller andra hållet) liksom åldersrelationer kan i en del fall vara osäkra."}},{"@id":"_:428f16d186b6ea65343bc550922041e5910c2cbb90febc003b564f75c70e7f85_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/0216ef81-3128-431b-879b-c685a6b989ee","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:08afc5f9-22ff-614a-6476-dcb0ed4319ab"},{"@id":"urn:uuid:8b3adb70-d8d3-9162-10c5-45cb80b4b42c"},{"@id":"urn:uuid:be3dd654-fa70-17e2-a342-afbcd01ef3d5"},{"@id":"urn:uuid:e20f9c36-a524-bde7-883a-866292919701"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Informationen utgör ett underlag för bedömning av landisars/glaciärisars rörelsemönster, t ex för användning inom malmprospektering."},{"@language":"sv","@value":"Produkten visar läge och riktning av isräfflor. Isräfflor har uppkommit då block, stenar och gruskorn som suttit fastfrusna i inlandsisens bottendelar repat och slipat berggrundsytan. Räfflorna visar isens rörelseriktning i ett visst skede. Riktningsangivelserna (360 grader system) avser den riktning varifrån isen rört sig mot observationsplatsen. Produkten innehåller i en del fall information om olika isräffelsystems relativa ålder på samma observationsplats. Positioneringsnoggrannheten kan variera beroende på vilket kartunderlag som använts i insamlingen. Noggrannheten i riktningsangivelserna kan uppskattas till +\\- 5 grader."}],"dct:identifier":"0216ef81-3128-431b-879b-c685a6b989ee","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:428f16d186b6ea65343bc550922041e5910c2cbb90febc003b564f75c70e7f85_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:428f16d186b6ea65343bc550922041e5910c2cbb90febc003b564f75c70e7f85_b1n0"},"dct:title":{"@language":"sv","@value":"Isräfflor"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:08afc5f9-22ff-614a-6476-dcb0ed4319ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-israfflor.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:8b3adb70-d8d3-9162-10c5-45cb80b4b42c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/israfflor/israfflor.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:be3dd654-fa70-17e2-a342-afbcd01ef3d5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/israfflor/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:e20f9c36-a524-bde7-883a-866292919701","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/israfflor-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}}],"@id":"urn:source:428f16d186b6ea65343bc550922041e5910c2cbb90febc003b564f75c70e7f85"},{"@graph":[{"@id":"_:42e7f7e3c1a48049634118fc36bf0de06953847726b08b8926c4c3a3e721d7ca_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Höjdfixar från 3:e precisionsavvägning (1979-2003). Planpunkter från 3:e rikstrianguleringen (1967-1982), samt RIX95 (1995-2006)."}},{"@id":"_:42e7f7e3c1a48049634118fc36bf0de06953847726b08b8926c4c3a3e721d7ca_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/bd5d428f-301b-431b-8a3c-f0edcdecd227","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:ad43c300-99cb-b5ed-28cf-16f7ff9e71e4"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Geodetiska punkter i de nationella riksnäten, vilka är bärare av de nationella referenssystemen."},"dct:identifier":"bd5d428f-301b