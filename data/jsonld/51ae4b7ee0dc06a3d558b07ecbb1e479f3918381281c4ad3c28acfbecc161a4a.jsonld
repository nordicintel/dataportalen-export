/PUBLIC"},"dct:description":{"@language":"sv","@value":"Ytor för Sveriges samtliga världsarv. Innehåller endast världsarvsområdet, inte buffertzon. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"dd04b533-48f4-433b-9a1c-8d5ae88f1a79","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:88fd65bf127a8f7d011b808daeb7c903c3769b670031cd3964f3fa96b7e4b211_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:88fd65bf127a8f7d011b808daeb7c903c3769b670031cd3964f3fa96b7e4b211_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:88fd65bf127a8f7d011b808daeb7c903c3769b670031cd3964f3fa96b7e4b211"},{"@graph":[{"@id":"_:8929845d582a8e377fe965f0c50bbc1ee786a495f6a424d3b8ed290fb095f4c7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen uppdateras löpande av statliga lantmäteriet och kommunala Rättigheter och gemensamhetsanläggningar är hämtade från en rad olika ursprungsmaterial. De kan t.ex. vara digitaliserade från gamla kartor eller inmätta med hög noggrannhet, därför är innehållet av varierande kvalitet. Idag används mätmetoden GPS, vilket innebär att kvalitén blir hög."}},{"@id":"_:8929845d582a8e377fe965f0c50bbc1ee786a495f6a424d3b8ed290fb095f4c7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/04d0a074-4294-4458-b6e4-815949199ad6","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:6e6b9a4c-d4a3-31c8-71e6-8210b0425938"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Vektorprodukten innehåller rättigheter och gemensamhetsanläggningar samt upplysningstext från Registerkartan och är ett komplement till fastighetsindelningen."},"dct:identifier":"04d0a074-4294-4458-b6e4-815949199ad6","dct:issued":{"@type":"xsd:date","@value":"2021-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-29"},"dct:provenance":{"@id":"_:8929845d582a8e377fe965f0c50bbc1ee786a495f6a424d3b8ed290fb095f4c7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:8929845d582a8e377fe965f0c50bbc1ee786a495f6a424d3b8ed290fb095f4c7_b1n0"},"dct:title":{"@language":"sv","@value":"Rättighet Nedladdning, vektor"}},{"@id":"urn:uuid:6e6b9a4c-d4a3-31c8-71e6-8210b0425938","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/rattighet-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktsida för Rättighet Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Rättighet Nedladdning, vektor"}}],"@id":"urn:source:8929845d582a8e377fe965f0c50bbc1ee786a495f6a424d3b8ed290fb095f4c7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/234a2205-bdab-4cb9-b60a-6c04a205450a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/markgeofysik-tyngdkraft"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Tyngdkraftsinformation används bl.a. för att kartlägga malmstyrande strukturer, bergarters utbredning och grundvattenmagasin men också för att lokalisera lämpliga områden för geotermisk energiutvinning."},{"@language":"sv","@value":"Visningstjänsten Geofysiska markmätningar, tyngdkraft interpolerad visar de variationer som finns i Sveriges tyngdkraftsfält, uttryckt som Bougueranomali. Från punktvisa mätningar av tyngdkraften i hela Sverige har Bougueranomalier (mGal) beräknats i referensfältet RG82. Dessa har sedan griddats med cellstorleken 500m x 500m.\n\nGenom mätningar av tyngdkraften kan man kartlägga variationer i massfördelningen i jordskorpan. Dessa variationer beror på skillnader i berggrundens sammansättning."}],"dct:identifier":"234a2205-bdab-4cb9-b60a-6c04a205450a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, tyngdkraft (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:89c641358681b9bc1108deaf056f61b634d3fbb9daf0b8749030723bfa45a57a"},{"@graph":[{"@id":"_:8a482204444387cfbd54475f014291c64108a9495a385b4f84b61e4264536668_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:8a482204444387cfbd54475f014291c64108a9495a385b4f84b61e4264536668_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/855c08fb-95e2-4eb8-b1cc-969de66655b8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://g