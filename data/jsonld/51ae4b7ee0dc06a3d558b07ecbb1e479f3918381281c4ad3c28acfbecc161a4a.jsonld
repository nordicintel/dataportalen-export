age":"sv","@value":"Gränsbestämda fornlämningar enligt 2:2 KML, dvs de fornlämningar i Jönköpings län där Länsstyrelsen i beslut har fastställt gränsen för fornlämningsområdet. \nSyftet är att underlätta inför samhällsplanering och byggnation vid de aktuella fornlämningarna."},"dct:identifier":"b55022c5-51cd-415b-ab22-f21946510a40","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-08-20"},"dct:provenance":{"@id":"_:a7fd8f2a99bd6ac252649e6321768981de9978d6e86613bbc66930d67218aacf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:a7fd8f2a99bd6ac252649e6321768981de9978d6e86613bbc66930d67218aacf_b1n0"},"dct:title":{"@language":"sv","@value":"LstF Fornlämningar - gränsbestämda"}},{"@id":"urn:uuid:0a0baca2-7e3e-7ad6-a3c7-e55894c92f36","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.kultur_gransbest_forn.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Kulturmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a7fd8f2a99bd6ac252649e6321768981de9978d6e86613bbc66930d67218aacf_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Kulturmiljöenheten"},{"@id":"urn:uuid:d752fcc2-24f8-cb3b-34fa-b9cf06b11391","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_2/MapServer/8"},"dct:format":{"@id":"http://publications.eur