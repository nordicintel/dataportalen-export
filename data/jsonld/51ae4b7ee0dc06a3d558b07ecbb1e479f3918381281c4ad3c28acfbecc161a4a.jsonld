e":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för medelhavsvattenstånd."},"dct:identifier":"8ca84420-f755-11ea-ac97-ab810184d520","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Medelvattenstånd: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:8f5fdb4f07eb49a75a9f4a0f732100c5891b8a304d21f53855c9741435929977"},{"@graph":[{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"År 1805 skapades en militär organisation för produktion av topografiska kartor, först kallad Fältmätningskåren, senare Fältmätningsbrigaden och till sist Topografiska kåren. Mellan år 1860 och 1874 gavs kartorna ut under namnet \"Topografiska kårens karta över Sverige\".\n\nDe kartor som nu finns i Lantmäteriets arkiv (Rikets allmänna kartverks kartarkiv) är främst från tiden efter år 1860. År 1874 började man ge ut Generalstabskartan under beteckningen \"Generalstabens karta över Sverige\". Den fick stor användning och spridning hos allmänheten. Den karta som gjorde serien rikstäckande gavs ut år 1923. Nyutgivningen fortsatte sedan med både nya och uppdaterade kartblad.\n\nDet sista nyproducerade kartbladet gavs ut år 1946 och de sist reviderade bladen gavs ut år 1971. Förlagshållningen av kartorna fortsatte dock långt in på 1970-talet."}},{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1971"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1827"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/7a8b11d1-8cb2-41fc-9c65-bdd1956d9e78","@type":"dcat:Dataset","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Generalstabskartan (1827–1971) beskriver naturlandskapet inklusive höjdförhållanden, kommunikationer, bebyggelse och översiktlig markanvändning. Skalan är 1:100 000 i Södra verket och 1:200 000 i Norra verket."},"dct:identifier":"7a8b11d1-8cb2-41fc-9c65-bdd1956d9e78","dct:issued":{"@type":"xsd:date","@value":"1827-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1827-01-01"},"dct:provenance":{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b1n0"},"dct:temporal":{"@id":"_:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43_b2n0"},"dct:title":{"@language":"sv","@value":"Generalstabskartan"}}],"@id":"urn:source:8f7c32d1cfafd6a8f52f6341fc03da587ad9df6cd4c6dc9e36db81202e904b43"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/937824e2-f2c6-418d-b673-8cdd8b3e527e","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/borrkarnor"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Borrkärnor visar koordinatsatt information om borrhål från vilka SGU förvaltar borrkärnor, kax mm. Materialet kommer från borrningar gjorda i dokumentationssyfte och/eller i samband med prospekterings- och anläggningsarbeten över hela Sverige.\n\nFör Borrkärnor samlingar finns inte alltid en borrkärna. Om BORRID inte har ett SGUB-nummer finns ingen kärna."},"dct:identifier":"937824e2-f2c6-418d-b673-8cdd8b3e527e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Borrkärnor (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:8f8fe47d2b5e2abcd4ae02fe4014c7d05f1685b639fe90335ec2b49df0bf4dc6"},{"@graph":[{"@id":"_:900df07806912af31f272e533192f98b1c234a77e67e67aa1dd29f13ecedae1b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"I andra kapitlet i Kulturmiljölagen finns en uppräkning som inleds med tre kriterier: Fasta fornlämningar ska vara lämningar efter människors verksamhet under forna tider, de ska ha tillkommit genom äldre tiders bruk och vara varaktigt övergivna.\n\nDetta gäller dock inte en lämning som tillkommit 1850 eller senare, om inte länsstyrelsen gjort en särskild fornlämningsförklaring. Samma regler gäller för fartygslämningar. Så räknas till exempel ett ålderdomligt järnbruk som ännu är i drift inte som fornlämning i lagens mening, medan en hyttruin från samma tid gör det."}},{"@id":"_:900df07806912af31f272e533192f98b1c234a77e67e67aa1dd29f13ecedae1b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/19cd9706-1e94-4b17-9a99-2bdd05cf2760","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:10b49dc3-61d8-fd55-f959-f1e703a07e92"},{"@id":"urn:uuid:62c5c533-9989-59bf-a03c-0f3c9120d528"},{"@id":"urn:uuid:b8178b2d-251c-735c-e246-1377f747e1af"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Skyddade områden"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ps"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Kända och registrerade fornlämningar i kulturmiljöregistret. Fornlämningar kan finnas både på land och i vatten. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"19cd9706-1e94-4b17-9a99-2bdd05cf2760","dct:issued":{"@type":"xsd:date","@value":"2008-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-15"},"dct:provenance":{"@id":"_:900df07806912af31f272e533192f98b1c234a77e67e67aa1dd29f13ecedae1b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:900df07806912af31f272e533192f98b1c234a77e67e67aa1dd29f13ecedae1b_b1n0"},"dct:title":{"@language":"sv","@value":"INSPIRE Skyddade områden - fornlämningar"}},{"@id":"urn:uuid:10b49dc3-61d8-fd55-f959-f1e703a07e92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/PS.NationalMonuments-topfeed.xml"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Nedladdningstjänst ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Nedladdningstjänst ATOM"}},{"@id":"urn:uuid:62c5c533-9989-59bf-a03c-0f3c9120d528","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/files/gml/nationalMonumentsGML.zip"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Nedladdningstjänst direkt nedladdning GML"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Nedladdningstjänst direkt nedladdning GML"}},{"@id":"urn:uuid:b8178b2d-251c-735c-e246-1377f747e1af","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/geoserver/Fornlamningar/ows?request=getcapabilities&service=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Visningstjänst"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE Visningstjänst"}}],"@id":"urn:source:900df07806912af31f272e533192f98b1c234a77e67e67aa1dd29f13ecedae1b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3dbfadcb-31d1-49ff-8bec-92cfa7330e51","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://api.lantmateriet.se/fastighetsomrade/atom/v1/inspire/cp"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Fastighetsområde enligt Inspires dataspecifikation. Registerenhet, fastighetsområde samt fastighetsgränser."},"dct:identifier":"3dbfadcb-31d1-49ff-8bec-92cfa7330e51","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighetsområde Nedladdning, Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:901d533a53523dbae1a93d91c2205f8ac8c8f23903909bc40c46360e4db50b0b"},{"@graph":[{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"GE.Jordarter 1:250 000, Nordligaste Sveriga är en transformerad version av SGUs produkt Jordarter 1:250 000, Nordligaste Sverige i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nInfomration är förenklad dels när det gäller jordarternas indelning i litologiska enheter, dels när det gäller ingående polygonskikt med litologiska enheter. I denna version redovisas endast JG2 Grundlager, vilket innebär att evenuella underliggande lager eller överliggande tunna eller osammanhängande ytlager inte redovisas.\n\nKartbilden grundas på sammanställning och digitalisering av äldre undersökningsmaterial (exempelvis fältkartor från tidigare undersökningar, tidigare flygbildstolkningar och NSG (Nämnden för statens gruvegendomar) kompletterat med flygbildstolkning med stöd av fältobservationer längs det glesa vägnätet. Inom fjällområdet har fältkontroller gjorts utifrån flyg och helikopterrekognosering. Sammanställningen av kartan avslutades 2011, efter att ha pågått i ca 10 år. Projektledare har varit Robert Lagerbäck."}},{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.530336776604 68.847369584498,25.144426088304 68.847369584498,25.144426088304 65.371001773593,14.530336776604 65.371001773593,14.530336776604 68.847369584498))"}},{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2009"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1999"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8f81b4b3-b130-4885-a618-f284fee97208","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:5900ed9b-aaf9-384f-9ec9-ec70d91214c8"},{"@id":"urn:uuid:d3bd2def-fe8e-a529-29fc-61ef62d573df"},{"@id":"urn:uuid:f3b287ff-5045-d10d-a6ee-f225c5c6c538"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"GE.Jordarter 1:250 000, Nordligaste Sverige är en transformerad version av SGUs produkt Jordarter 1:250 000, Nordligaste Sverige i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nInfomration är förenklad dels när det gäller jordarternas indelning i litologiska enheter, dels när det gäller ingående polygonskikt med litologiska enheter. I denna version redovisas endast JG2 Grundlager, vilket innebär att evenuella underliggande lager eller överliggande tunna eller osammanhängande ytlager inte redovisas.\n\nKartan Jordarter 1:250 000 nordligaste Sverige täcker nordligaste delen av Sverige och ger en mycket översiktlig bild av jordarternas fördelning och landformer. Kartan kan användas som ett mycket översiktligt planerings- och resurshushållningsunderlag för prospekteringsföretag, länsstyrelse, kommuner m.fl. intressenter. Kartbilden är generaliserad för presentation i skala 1:250 000 och minsta redovisade yta är ca 0,1 km2."},"dct:identifier":"8f81b4b3-b130-4885-a618-f284fee97208","dct:issued":{"@type":"xsd:date","@value":"2019-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-01-21"},"dct:provenance":{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b1n0"},"dct:temporal":{"@id":"_:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:250 000, Nordligaste Sverige"}},{"@id":"urn:uuid:5900ed9b-aaf9-384f-9ec9-ec70d91214c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Surficial-250k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:d3bd2def-fe8e-a529-29fc-61ef62d573df","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Surficial_250K.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:f3b287ff-5045-d10d-a6ee-f225c5c6c538","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_250k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:9025c60023ac916786de4c1da3dd5ec87a5c6b70b6f5fb862d80c94873cdc619"},{"@graph":[{"@id":"_:90868f0cdad85dabe5198da54b0346949abfb2bf09073278cec3d9c606e3b69f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är framställd genom en harmonisering och sammanslagning från ett antal databaser vid SGU där uppgifter om borrhål och lagerföljder är samlade. För närvarande innehäller GE.Borrhål observationer från Brunnar, Jordlagerföljder, Borrhålsdatabasen, Marina sedimentprov, Torvlagerföljder samt Grundvattennätet (grundvattennivåer och Miljöövervakning,  grundvattenkemi).\n\nJordlager har slagits samman till ett enda jordlager, liksom berglager har slagits samman till ett enda berglager. Ingen differntiering har alltså gjorts avolika jord- eller berglager."}},{"@id":"_:90868f0cdad85dabe5198da54b0346949abfb2bf09073278cec3d9c606e3b69f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/f6fabe7a-0e5c-4748-9fc4-1eaae0e99e75","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:4255340e-c564-6219-e7fd-1ef75925893a"},{"@id":"urn:uuid:a3363e7c-f38a-365f-1e70-fc82cff91791"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"GE.Borrhål är framtagen i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nGE.Borrhål är en sammanställning från ett antal datamängder vid SGU där uppgifter om borrhål och lagerföljder är samlade.\n\nRedovisning av lagerföljder är starkt förenklad. Endast ett jordlager och ett berglager särskiljs där det varit möjligt, olika jordarter eller bergarter i en lagerföljd  redovisas alltså inte i denna datamängd."},"dct:identifier":"f6fabe7a-0e5c-4748-9fc4-1eaae0e99e75","dct:issued":{"@type":"xsd:date","@value":"2019-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-04"},"dct:provenance":{"@id":"_:90868f0cdad85dabe5198da54b0346949abfb2bf09073278cec3d9c606e3b69f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:90868f0cdad85dabe5198da54b0346949abfb2bf09073278cec3d9c606e3b69f_b1n0"},"dct:title":{"@language":"sv","@value":"GE.Borrhål"}},{"@id":"urn:uuid:4255340e-c564-6219-e7fd-1ef75925893a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Borrhal"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}},{"@id":"urn:uuid:a3363e7c-f38a-365f-1e70-fc82cff91791","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Borehole.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}}],"@id":"urn:source:90868f0cdad85dabe5198da54b0346949abfb2bf09073278cec3d9c606e3b69f"},{"@graph":[{"@id":"_:90c515f93911782d9232c2f96c0463c4aa90267edb65a4723942fccb6f8754f3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"De olika bergarterna som representeras i respektive yta är uppdelade i fyra klasser enligt symboliseringen nedan där varje bergart har tilldelats en klass utifrån den spridning i värmeledningstal bergarterna normalt har visat i samband med mätningar av olika slag (se SGU-rapport 2016:16). I huvudsak är värmeledningsförmågan kopplad till halten kvarts i en bergart då en hög kvartshalt ger ett högt värmeledningstal. Vissa ultrabasiska bergarter som peridotit, dunit (med avsaknad av kvarts) som innehåller stor del pyroxen eller olivin kan ge något högre värden men eftersom dessa inte går att separera i denna generalisering så är de kvar i intervallet 2–3 W/K m.\n\nDe intervall som anges överlappar till en viss del men de visar också den variation av värden som finns inom varje bergartstyp. De bergarter som representeras av ytor med en varierande värmeledningsförmåga är generellt inhomogena i sin natur. En gnejs kan till exempel vara bandad, då vissa band är kvartsrika medan andra helt saknar kvarts. Detta gör att bergarten blir svår att bedöma över större områden eftersom proportionerna av respektive typ av band är svår att uppskatta.\n\nI kartan kan vissa diskrepanser finnas, dvs. att en till synes sammanhängande yta är uppdelad i två delar med olika klass. Detta beror på att ytor på respektive sida om en sådan gräns ofta har karterings- och sammanställningsmässigt olika historiska bakgrund och tolkningen kan därför skilja sig åt.\n\nFör att bedöma homogenitet på djupet, dvs. kring 300 meter ner i berggrunden, kan man i de flesta fall säga att homogeniteten för kristallin berggrund (till exempel granit och gnejs) är den samma på ytan som på djupet. För odeformerade sedimentära bergarter, som oftast ligger med en horisontell utbredning i olika lager (till exempel i Skåne), är det däremot svårare om man inte har information om lagrens tjocklek och vilken bergart de underliggande lagren består av.\n\nMed hjälp av punktinformation för de platser där bergartsprov är tagna och sedan analyserade (se produkt Modaldata och värmeledningsförmåga) kan en yta bedömas både hur homogen berggrunden är och vilket värmeledningstal den provtagna bergarten har. Ifall det finns provpunkter av flera olika bergartstyper med olika värmeledningstal inom samma yta, ger det en indikation på att det är heterogent och mer noggranna fältstudier krävs för en bedömning."}},{"@id":"_:90c515f93911782d9232c2f96c0463c4aa90267edb65a4723942fccb6f8754f3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/fa00a612-8bb9-4847-a2ed-c50678ff42f0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0d6ea983-09f8-af2a-18ed-af36a9ffa4d1"},{"@id":"urn:uuid:1a546e22-88d1-d022-8eed-94887d0c46d4"},{"@id":"urn:uuid:2eca403a-ced5-4236-0e0c-6c518d3c2d7f"},{"@id":"urn:uuid:a3204221-2a0d-0aad-d33a-e2d2b8ecdac6"},{"@id":"urn:uuid:e668ab8c-cfef-71e5-7647-a482beda7c69"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten visar översiktligt den variation i värmeledningsförmåga som finns i Sveriges berggrund. Kartans ytor är baserade på berggrundskartan i SGU:s kartdatabas Berggrund 1:50 000 – 1:250 000.\n\nI kombination med punktinformation av beräknad värmeledningsförmåga i bergartsprov, se produkt Modaldata och värmeledningstal (öppna data), så går det att i vissa områden få bättre information om bergarternas mineralsammansättning och beräknad värmeledningsförmåga. Informationen kan användas för översiktlig planering av geoenergianläggningar."},"dct:identifier":"fa00a612-8bb9-4847-a2ed-c50678ff42f0","dct:issued":{"@type":"xsd:date","@value":"2022-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-10"},"dct:provenance":{"@id":"_:90c515f93911782d9232c2f96c0463c4aa90267edb65a4723942fccb6f8754f3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:90c515f93911782d9232c2f96c0463c4aa90267edb65a4723942fccb6f8754f3_b1n0"},"dct:title":{"@language":"sv","@value":"Värmeledningsförmåga i berggrunden"}},{"@id":"urn:uuid:0d6ea983-09f8-af2a-18ed-af36a9ffa4d1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/varmeledningsformaga-berggrund/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features )"}},{"@id":"urn:uuid:1a546e22-88d1-d022-8eed-94887d0c46d4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-geoenergi.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:2eca403a-ced5-4236-0e0c-6c518d3c2d7f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/varmeledningsformaga-berggrund-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:a3204221-2a0d-0aad-d33a-e2d2b8ecdac6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/varmeledningsformaga-berggrund/varmeledningsformaga-berggrund.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:e668ab8c-cfef-71e5-7647-a482beda7c69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/varmeledningsformaga-berggrund?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Värmeledningsförmåga i berggrunden (visningstjänst)"},"dct:title":{"@language":"sv","@value":"Visningstjänst"}}],"@id":"urn:source:90c515f93911782d9232c2f96c0463c4aa90267edb65a4723942fccb6f8754f3"},{"@graph":[{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SCB har sedan 1970 producerat statistik som beskriver markanvändningens utveckling inom tätorter, med i princip femårsintervall. De tidiga studierna byggde på ett stickprov av tätorter, vilket räknades upp till riksnivå. Arbetet utfördes genom manuell tolkning av analoga flygbilder och krävde en stor arbetsinsats.\n\nUnder 2000-talet har alternativet att använda satellitdata i stället för flygbilder kommit att bli ett bättre och effektivare underlag för statistikproduktionen. Utvecklingen av en satellitbildsbaserad metod för kartläggning av grönytor har gjorts i flera steg. I samband med produktionsomgången 2005 togs en metod fram som baserades på de datakällor som då fanns tillgängliga.\n\nGenom den nationella geodatasamverkan som etablerades 2011 ökade markant tillgången på detaljerade geografiska data från andra myndigheter. Under 2012-2014 genomfördes därför flera nya metodutvecklingsprojekt för att ytterligare förfina den satellitbildsbaserade metoden utifrån en förbättrad datatillgång. \n\nDen förfinade satellitbildsbaserade metoden användes i produktion första gången för att ta fram statistik om grönytor och grönområden i tätorter 2010. Av resursskäl begränsades dock studien till de 37 största tätorterna i landet.\n\nFör 2015-års studie kunde satellitbildstolkningen integreras i produktionen av Nationella Marktäckedata och på så sätt kunde täckningsgraden skalas upp till att omfatta samtliga tätorter i landet."}},{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2015"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2010"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/9cc56c85-6f36-47c5-b6c9-765ec603ae35","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:171711a1-845a-15e8-40ac-b8dfded72654"},{"@id":"urn:uuid:2ff3226c-98fa-0116-eb4c-2dfd33529184"},{"@id":"urn:uuid:9d2d1ffb-9395-a0a9-afe1-c580f3000304"},{"@id":"urn:uuid:e273c8ee-01d1-5026-0fc9-4f2324fd64e4"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Grönområden i tätorter avgränsas geografiskt av SCB som ett led i produktionen av officiell statistik om grönytor och grönområden i tätorter. Datat som tillgängliggörs här är alltså primärt avsett för statistikproduktion.\n\nEtt grönområde definieras av SCB som ett område av sammanhängande grönytor som uppgår till minst 0,5 hektar och som är allmänt tillgängligt. Betesmark räknas till grönområden, men inte åkermark. Grönområden avgränsas geografiskt till inom tätort. Minsta redovisningsenhet är 0,5 hektar. Definitionen tar därmed inte hänsyn till huruvida områdena är utpekade som grönområden i kommunernas översikts- eller detaljplaner.\n\nAvgränsningen av grönområden baseras på satellitdata som sambearbetas med geografisk information och registerdata från Lantmäteriet. \n\nData finns för två olika referenstidpunkter, 2010 och 2015. 2010-års data omfattar endast grönområden i de 37 största tätorterna enligt 2010-års tätortsavgränsning. 2015-års data omfattar grönområden i samtliga tätorter enligt 2015-års tätortsavgränsning."},"dct:identifier":"9cc56c85-6f36-47c5-b6c9-765ec603ae35","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-12-01"},"dct:provenance":{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b1n0"},"dct:temporal":{"@id":"_:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd_b2n0"},"dct:title":{"@language":"sv","@value":"Grönområden i tätorter"}},{"@id":"urn:uuid:171711a1-845a-15e8-40ac-b8dfded72654","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för grönområden i tätorter"}},{"@id":"urn:uuid:2ff3226c-98fa-0116-eb4c-2dfd33529184","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.scb.se/mi0805"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktspecifikation"}},{"@id":"urn:uuid:9d2d1ffb-9395-a0a9-afe1-c580f3000304","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Grönområden i tätorter WMS"}},{"@id":"urn:uuid:e273c8ee-01d1-5026-0fc9-4f2324fd64e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Grönområden i tätorter WFS"}}],"@id":"urn:source:90ca421df2931787c830131af219ac9db1bc9cadf9d9fa397abe45b4531357cd"},{"@graph":[{"@id":"_:9134ea074257ac100348ab22bec367865d61d6b6810ef28e833e4b337dc263a0_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:9134ea074257ac100348ab22bec367865d61d6b6810ef28e833e4b337dc263a0_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/da77d39b-0ffe-77ce-fb99-988202f1e37d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":[{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e"}],"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-forvaltningsomraden/ows?"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Jordobservation och miljö"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visninsgtjänst (WMS) för datamängden Havsmiljöområdesindelning enligt havsmiljöförordningen Förvaltningsområden"},"dct:identifier":"da77d39b-0ffe-77ce-fb99-988202f1e37d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Förvaltningsområden.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9134ea074257ac100348ab22bec367865d61d6b6810ef28e833e4b337dc263a0_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9134ea074257ac100348ab22bec367865d61d6b6810ef28e833e4b337dc263a0_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsmiljöenheten"}],"@id":"urn:source:9134ea074257ac100348ab22bec367865d61d6b6810ef28e833e4b337dc263a0"},{"@graph":[{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är en sammanslagning av de tidigare produkterna Berggrund 1:50 000 och Berggrund 1:250 000. Informationen bygger på kartläggningar som påbörjades på 1960-talet och pågår än idag. Kartläggningen har under åren utförts med olika metoder, med olika observationstäthet på skiftande geografiskt underlag samt för presentationsskalor från 1:50 000 till 1:250 000. Den tidiga informationen har digitaliserats från tryckt kartunderlag. Från slutet av 1990-talet produceras data i digital miljö. Många kartlagda områden har publicerats som tryckta kartor inom SGUs serier Af, Ai, Ba, Ca och K och till dessa finns ofta utgivna beskrivningar som innehåller kompletterande information om arbetsmetoder och geologiska förhållanden. Information om dessa beskrivningar finns på www.sgu.se. \nEftersom olika karteringsmetoder har tillämpats i olika områden och under olika perioder, så är produktens kvalitet inte enhetlig utan skiljer sig från område till område. Den mest detaljerad kartläggningen, som bygger på omfattande fältarbete har utförts främst i tätbefolkade och prospekteringsintressanta områden i delar av södra och norra Sverige.\n\nGemensamt för alla metoder är att de bygger på observationer i fält av berghällar. Den insamlade informationen grundas i huvudsak på okulär bedömning. Prover för mikroskopundersökning, kemiska bergartsanalyser, petrofysiska analyser, åldersbestämningar m.m. tas i varierande omfattning. Information från externa källor, i första hand prospekteringsrapporter och forskningarbeten ställs samman och används i förekommande fall."}},{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1960"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e6ceaee0-db46-4c79-90d3-3858e3db1a3c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0c02c09b-46b2-8e9f-fb5d-2f8f3bdf8430"},{"@id":"urn:uuid:1e670c8e-98f2-2f9f-d6ec-aedfe975762e"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"sv","@value":"GE.Berggrund 1:50 000 - 1:250 000 är en förenklad och transformerad version av SGUs berggrundsinformation i skala 1:50 000 - 1:250 000 och överensstämmer med Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 3.2.\n\nData representeras i en tvådimensionell modell av berggrundens överyta, som beskriver identifierade geologiska enheters  geometri, det material som bygger upp enheterna och geologiska händelser som de genomgått. I modellen ingår även strukturer som förkastningar och veck i berggrundens överyta. Modellen bygger på geologiska fältobservationer i kombination med tolkning av analysresultat och geofysiska data.\n\nKartläggningen har skett från början av 1960-talet med olika metoder, olika observationstäthet och för olika presentationsskalor. Detta gör att det finns stora skillnader i kvalitet inom produkten, både vad gäller lägesnoggrannhet och informationsinnehåll. De skillnader i karteringsmetod som tillämpats vid kartläggningen redovisas genom att informationen har märkts med avsedd presentationsskala."},{"@language":"sv","@value":"Syftet med berggrundskartan är att ge underlag för analyser i samband med t ex prospektering och översiktsplanerin. Informationen i kartan kan användas för framställning av olika tematiska produkter, t ex kartor över näringsinnehåll, värmeledningsförmåga och lämplighet för anläggningar. Informationen ligger till grund för SGUs tryckta berggrundskartor och olika karttjänster."}],"dct:identifier":"e6ceaee0-db46-4c79-90d3-3858e3db1a3c","dct:issued":{"@type":"xsd:date","@value":"2015-10-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-02-05"},"dct:provenance":{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b1n0"},"dct:temporal":{"@id":"_:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Berggrund 1:50 000 - 1:250 000"}},{"@id":"urn:uuid:0c02c09b-46b2-8e9f-fb5d-2f8f3bdf8430","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Berggrund_50k-250k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"GE.Berggrund 1:50000 - 1:250000,GE.GeologicUnit,GE.GeologicFault,GE.GeologicFold"},"dct:title":{"@language":"sv","@value":"GE.SGU.Bedrock_50K-250K,GE.GeologicUnit,GE.GeologicFault,GE.GeologicFold"}},{"@id":"urn:uuid:1e670c8e-98f2-2f9f-d6ec-aedfe975762e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Bedrock_50K-250K.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}}],"@id":"urn:source:919f2461a8d1d900a31732d85c7f12b1fc66951a7145f786d0151e19c61a3fc7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ddee1adf-1050-4001-9f47-0b6a9b1db611","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/genomslapplighet-berg?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Hydraulisk konduktivitet i berg inkluderar beräknad hydraulisk konduktivitet (K) i bergborrade brunnar från Brunnsarkivet samt en interpolation av dessa värden. Förutom osäkerhet i indata ingår dessutom ett antal antaganden i beräkningarna vilket medför en viss osäkerhet i slutresultatet. Osäkerheten bedöms kunna vara betydande för en enskild brunn vilket medför att interpolerad hydraulisk konduktivitet i områden med mycket få brunnar bör vara betydande.\n \nProdukten bör kunna utgöra en viktig del för hydrogeologiska utredningar där hydraulisk konduktivitet i berg är en faktor. På grund av de osäkerheter och begränsningar som finns samt syfte och krav på utredningen kan det dock krävas kompletterande undersökningar, speciellt i områden med få brunnar. Men även i dessa fall kan resultaten från denna rapport vara värdefulla vid inledande utredningar.\n\nInterpolationen omfattar en rikstäckande beräkning och resultatet presenteras i enheten m/s i ett raster med cellstorlek på 100x100 m. Beräknad hydraulisk konduktivitet i bergborrade brunnar omfattar den delmängd av Brunnsarkivet som SGU bedömer det är rimligt att använda för detta syfte."},"dct:identifier":"ddee1adf-1050-4001-9f47-0b6a9b1db611","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Hydraulisk konduktivitet i berg (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:92888d2a13fba278a27d8d72dd10c831a37289bbd9d079b1b3e1fcc071659997"},{"@graph":[{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sveriges geologiska undersökning (SGU) bedriver en marin¬geologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. \nMaringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (hydroakustisk profi¬lering) samt bottenyteavbildande mätningar (hydroakustisk yttäckning). \nBottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. \nBottenyteavbildande mätningar görs med multistråleekolod, interferometrisk sonar och sidoavsökande sonar vilka alla ger upphov till grafiska bilder över havsbottenytans areella fördelning av sediment och berg. Mätningar med multistråleekolod och interferometrisk sonar ger dessutom information om vattendjupet inom ett avsökt område.\nDe hydroakustiska data som samlats in tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där såväl mätningar som direkta sedimentprovtagningar och visuella observationer av de geologiska förhållandena gjorts. \nDe sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagningarna föregås av en besiktning av bottenytan med hjälp av undervattenskamera.\nEfter insamling och bearbetning görs en geologisk tolkning av materialet, för presentation i skala 1:100 000."}},{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.03 65.90,24.23 65.90,24.23 54.95,10.03 54.95,10.03 65.90))"}},{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1969"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2b59a793-19c6-4d2c-82cc-809ebdaa5603","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1c1e3634-2a0e-43d2-fdcc-c796343eadca"},{"@id":"urn:uuid:37162561-847c-3af6-a5a7-1dde6ed86dc9"},{"@id":"urn:uuid:99695127-3bda-9658-dba7-cf9b6af869c5"},{"@id":"urn:uuid:a3c65aba-d821-9b70-cb07-2ab85c10a68a"},{"@id":"urn:uuid:b6c318e0-0171-91b6-1c77-fe85eb5240e4"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag vid biologiska inventeringar samt för Försvarsmakten."},{"@language":"sv","@value":"Maringeologi 1:100 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Produkten ger bland annat information om bottenmaterial, olika sediments mäktighet och bildningssätt. \nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och ekonomisk zon (EEZ). Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag för Försvarsmakten samt vid biologiska inventeringar."}],"dct:identifier":"2b59a793-19c6-4d2c-82cc-809ebdaa5603","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b1n0"},"dct:temporal":{"@id":"_:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47_b2n0"},"dct:title":{"@language":"sv","@value":"Maringeologi 1:100 000"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1c1e3634-2a0e-43d2-fdcc-c796343eadca","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/maringeologi100k/maringeologi100k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:37162561-847c-3af6-a5a7-1dde6ed86dc9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-maringeologi.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst.Innehåller marina sedimentprov och maringeologisk kartinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:99695127-3bda-9658-dba7-cf9b6af869c5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/maringeologi-100000-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:a3c65aba-d821-9b70-cb07-2ab85c10a68a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/maringeologi-100-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:b6c318e0-0171-91b6-1c77-fe85eb5240e4","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/maringeologi100k/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:9312b1936c0df6b30108d7fb4ac3ba7bec12758b456195f45b2aa38c99d09c47"},{"@graph":[{"@id":"_:93259cfb619bdd0e56e2cb393fdc745a77e51c09550b8121ce912e7384100938_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((15.46094910149 57.252017553023,15.46094910149 57.252017553023,15.46094910149 57.252017553023,15.46094910149 57.252017553023,15.46094910149 57.252017553023))"}},{"@id":"_:93259cfb619bdd0e56e2cb393fdc745a77e51c09550b8121ce912e7384100938_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/9e9ea95a-6b5b-4076-bea1-c2667589c999","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":{"@id":"urn:uuid:8a8b4337-d461-86ed-05fc-587d9daeece0"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Provplatser där bottenfauna undersöks. Kartskiktet hämtar uppgifter från Nationella kalkdatabasen. Varje län ansvarar för att de provplatser som finns med i skiktet är aktuella. Nationella kalkdatabasen är ännu inte komplett vad gäller provplatser av bottenfauna i kalkade områden."},"dct:identifier":"9e9ea95a-6b5b-4076-bea1-c2667589c999","dct:issued":{"@type":"xsd:date","@value":"2019-08-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-08-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:93259cfb619bdd0e56e2cb393fdc745a77e51c09550b8121ce912e7384100938_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - provplatser bottenfauna"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:93259cfb619bdd0e56e2cb393fdc745a77e51c09550b8121ce912e7384100938_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:8a8b4337-d461-86ed-05fc-587d9daeece0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:93259cfb619bdd0e56e2cb393fdc745a77e51c09550b8121ce912e7384100938"},{"@graph":[{"@id":"_:939b648c8df827d0b6d4eec751d800ddcc5e500d39d5c6d2fc917235b2ce022c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Adressdelen i fastighetsregistret uppdateras av respektive kommun så snart kommunen tar beslut om ny eller ändrad adress. Adressuppgifter finns för samtliga kommuner i Sverige. På vissa håll kan adressuppgifter saknas, till exempel i glesbygd och fjällområden."}},{"@id":"_:939b648c8df827d0b6d4eec751d800ddcc5e500d39d5c6d2fc917235b2ce022c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/c3e87f28-42e0-486c-9ccf-b3137db38965","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:6e27849c-e386-cc72-6e51-c6e002b87c64"},{"@id":"urn:uuid:cf96b904-1294-4b89-4be8-7e8143b5821d"},{"@id":"urn:uuid:d57bc3c9-ddfb-6c91-ab1b-9cf14d1032fc"},{"@id":"urn:uuid:f6b82a6d-2af9-1ed1-b7c2-cb89886252f6"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller information om adresser från fastighetsregistrets adressdel."},"dct:identifier":"c3e87f28-42e0-486c-9ccf-b3137db38965","dct:issued":{"@type":"xsd:date","@value":"2025-02-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-24"},"dct:provenance":{"@id":"_:939b648c8df827d0b6d4eec751d800ddcc5e500d39d5c6d2fc917235b2ce022c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:939b648c8df827d0b6d4eec751d800ddcc5e500d39d5c6d2fc917235b2ce022c_b1n0"},"dct:title":{"@language":"sv","@value":"Belägenhetsadress"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"}},{"@id":"urn:uuid:6e27849c-e386-cc72-6e51-c6e002b87c64","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/belagenhetsadress-nedladdning-vektor-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Nedladdning, vektor"}},{"@id":"urn:uuid:cf96b904-1294-4b89-4be8-7e8143b5821d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/belagenhetsadress-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Direkt"}},{"@id":"urn:uuid:d57bc3c9-ddfb-6c91-ab1b-9cf14d1032fc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/stac-vektor/v1/collections/belagenhetsadresser"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Belägenhetsadress Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till STAC nedladdningstjänst"}},{"@id":"urn:uuid:f6b82a6d-2af9-1ed1-b7c2-cb89886252f6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.lantmateriet.se/distribution/produkter/belagenhetsadress/v4.2"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Belägenhetsadress Direkt"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till API för Belägenhetsadress Direkt"}}],"@id":"urn:source:939b648c8df827d0b6d4eec751d800ddcc5e500d39d5c6d2fc917235b2ce022c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/386ba20a-a0f8-4930-8a7a-05de2da9e12f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/stranderosion-kust-v2"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Informationen utgör ett underlag för att belysa strandlinjens ändringar pga. erosion och deposition av sediment längs stränderna."},{"@language":"sv","@value":"Visningstjänsten Stranderosion, kust innehåller information om erosionsförhållanden längs Sydsveriges havsstränder. Baserat på detaljerad kartläggning av stränder och havsbotten runt kusten har erosionsförhållanden och erosionskänslighet bedömts och beräknats med två olika metoder.\n\nEn indelning har gjorts i olika strandtyper efter strändernas geologi, topografi och sedimentdynamik. De olika strandtyperna karaktäriseras av olika erosionsförhållanden beroende på om stränderna främst präglas av pålagring, erosion eller huvudsakligen är i balans samt hur snabbt erosionen sker. Dessutom visas en prognos för vilka erosionsförhållanden man kan förvänta sig i framtiden vid en havsnivåhöjning på ca 1 m.\n\nSträndernas känslighet för erosion visas med ett beräknat erosionsindex, baserat på en analys av jordarter på stränder och havsbotten, marklutning, erosionsprocesser och sedimentbudget på stränder och havsbotten samt vind- och vågexponering. \n\nI samband med fältinsamlingen har hårda erosionsskydd inventerats och sträckor med aktiv erosion kartlagts."}],"dct:identifier":"386ba20a-a0f8-4930-8a7a-05de2da9e12f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Stranderosion, kust (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9402062c9a3fb830d6f0950c97aa15697828ea9e877a33d818c12948b5d45ec7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/32b1f33a-3be4-4e94-ad62-c460a22ea639","@type":["dcat:DataService