pe/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}},{"@id":"urn:uuid:b0e15e95-0df5-39fa-c22a-f710b20cf0fd","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/grundvattennivaer-observerade/ogc/features/v1"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:eb9f18a0-3d9e-e84d-f015-e793b9f525b1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattennivaer-observerade-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:96ec62d0eaae3114cf58804c254414b2066b80eb87405909e91d8cf869f0a441"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/350aff6f-a9d6-4113-8527-3e7f23ff54e7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-mittnorden-750-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Kartan återger huvuddragen i regionens jordartsgeologi. Kartan är avsedd för presentation i skalområdet 1:750 000 – 1:1 miljon. Kartbilden är mycket generaliserad och jordartsindelningen förenklad. Minsta redovisade yta är knappt 1 km2."},"dct:identifier":"350aff6f-a9d6-4113-8527-3e7f23ff54e7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jordarter 1:750 000, Mittnorden (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:97a4438ed4397d7eebf3fa3663b3ea6797cb005bf9250f40fb88c36b4101b64e"},{"@graph":[{"@id":"_:97df9c4610ef1947125d2c305b97e443e54be7251583d1e9c41e6677de23b98c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Hämtat och sammanställt från Naturvårdsverket"}},{"@id":"_:97df9c4610ef1947125d2c305b97e443e54be7251583d1e9c41e6677de23b98c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((4.75968710766561 70.86316607518009,28.308777851896686 70.86316607518009,28.308777851896686 54.591506426569566,4.75968710766561 54.591506426569566,4.75968710766561 70.86316607518009))"}},{"@id":"_:97df9c4610ef1947125d2c305b97e443e54be7251583d1e9c41e6677de23b98c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/22b4a4ae-a178-d245-2c8f-1660ad272d55","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:99b93282-af50-6c75-9276-a68df68caeae"},"dcat:distribution":[{"@id":"urn:uuid:302d893a-d76c-c66f-859d-480ddf14416a"},{"@id":"urn:uuid:30944295-f8e1-65f4-9db5-95d6a09310f3"},{"@id":"urn:uuid:4dafd22f-c222-dcf8-7716-8b512bbea79c"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Beskrivning: GIS lagret med MPAs enligt gällande masterlista april 2025\n\nNär vi beräknar havsarealen i marina skyddade områden i svenska vatten inkluderas följande skyddsformer, vilka ofta är överlappande:\n•Nationalparker, naturvårdsområden, biotopskyddsområden och djur- och växtskyddsområden med syften och föreskrifter kopplade till den marina miljön samt marint inriktade naturreservat,\n•Natura 2000-områden med utpekade marina naturtyper 1110–1180,\n1610–1620, 1650 och 8330 (SCI) samt de marina arterna) 1351, 1364, 1365 och 1938 (sälar och tumlare),\n•Natura 2000-områden för fåglar i marin miljö (SPA)."},"dct:identifier":"22b4a4ae-a178-d245-2c8f-1660ad272d55","dct:issued":{"@type":"xsd:date","@value":"2025-06-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-17"},"dct:provenance":{"@id":"_:97df9c4610ef1947125d2c305b97e443e54be7251583d1e9c41e6677de23b98c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:97df9c4610ef1947125d2c305b97e443e54be7251583d1e9c41e6677de23b98c_b1n0"},"dct:title":{"@language":"sv","@value":"MPA Sverige"}},{"@id":"urn:uuid:302d893a-d76c-c66f-859d-480ddf14416a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/mpa-sverige/wms?layers=mpa-sverige&version=1.1.1"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"MPA Sverige WMS"}},{"@id":"urn:uuid:30944295-f8e1-65f4-9db5-95d6a09310f3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://