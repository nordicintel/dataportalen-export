/publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"}],"@id":"urn:source:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/5a434180-4f42-4361-b1ee-def2b47eeafc","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://gis.sgi.se/inspire_nedladdning/SGI_TopAtomFeed_GotaAlv.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Göta älvdalen är ett av Sveriges mest skredutsatta områden. Flera stora skred har skett i modern tid och vår kartläggning av skredrisker visar att många områden längs Göta älv har fortsatt hög risk för skred. \n\nPå uppdrag av regeringen kartlades skredriskerna längs hela Göta älv inklusive Nordre älv 2009-2011 mot bakgrund av behoven att i framtiden hantera ökade flöden i älven. I uppdraget kartlades både dagens situation och den förändring som sker till följd av klimatförändringen. I uppdrag ingick också att förbättra och utveckla metoderna för kartering och värdering av riskerna. Uppdraget har inneburit en samlad riskanalys med beräkningar av sannolikheten för skred och värdering av de konsekvenser som skred kan ge upphov till. Genom att identifiera olika riskområden har en bedömning gjorts av var geotekniska förstärkningsåtgärder bör utföras. En översiktlig kostnadsbedömning av de geotekniska delarna av förstärkningsåtgärderna har utförts för områden med höga skredrisker. Vidare presenteras en samlad bedömning av de geotekniska förutsättningarna för ökade flöden i Göta älv.\n\nI april 2012 redovisades det s k Göta älvuppdraget (GÄU) i form av tre huvudrapporter - 1.Samhällskonsekvenser; 2.Kartläggning; 3.Kartor (33 st A3-blad 1:10.000) - samt 34 tekniska delrapporter. Se vidare www.sgi.se samt https://www.sgi.se/globalassets/publikationer/gota-alvutredningen/gau_slutrapport_del3.pdf (Del 3 kartor). Risk är en kombination av sannolikheten för skred (kvalificerat geotekniskt bedömningsarbete baserat på en stor mängd digitala data, bla en detaljerad terrängmodell för land och älv) och konsekvensen av ett skred (där hänsyn har tagits till liv/befolkning, fastighetsvärden, transportinfrastruktur, energi- och teledistribution, miljöfarlig \nverksamhet mm). Redovisning sker enligt direktiven i regeringsuppdraget och enligt rådande fackmässiga och geotekniska analysmodeller. \n\n[Geoteknik]"},"dct:identifier":"5a434180-4f42-4361-b1ee-def2b47eeafc","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Skredriskkartering Göta Älv.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a77870b507dd6aaece8d34c5f706f1a822016ea8fb23970db976eaec7dd9682f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/9a85ef52-cf4a-4408-8ee5-40ed9f9c3345","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/maringeologi-25-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Maringeologi 1:25 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Produkten ger bland annat information om bottenmaterial, olika sediments mäktighet och bildningssätt samt innehåll av organiskt material.\n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag vid biologiska inventeringar samt för Försvarsmakten."},"dct:identifier":"9a85ef52-cf4a-4408-8ee5-40ed9f9c3345","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Maringeologi 1:25 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a7c7e8d4ad73a43dbca08cc1acad84cefbeeb4abfd38df5cb12a8427ff83590d"},{"@graph":[{"@id":"_:a7d69c182723020a781016d73892d709dcb98e66d59a23836540ea2f4bf9b7d0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:a7d69c182723020a781016d73892d709dcb98e66d59a23836540ea2f4bf9b7d0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:a7d69c182723020a781016d73892d709dcb98e66d59a23836540ea2f4bf9b7d0_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002817","@type":"foaf:Agent","dct:identifier":"2021002817","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:dcu@slu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges lantbruksuniversitet"},"foaf:page":{"@id":"https://www.slu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18"}},{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":[{"@language":"en","@value":"Swedish University of Agricultural Sciences"},{"@language":"sv","@value":"Sveriges lantbruksuniversitet"}]},{"@id":"https://www.geodata.se/resources/fa2e73d9-e3b3-d981-ac1d-881af612f8ce","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:32ffbae1-dacf-4b21-3ed1-70fcaae3fd65"},{"@id":"urn:uuid:b05f70c5-4dde-d974-6094-ce0d2b1630df"}],"dcat:distribution":[{"@id":"urn:uuid:6ca60906-c4bd-9317-d915-fbd3e89fc5a0"},{"@id":"urn:uuid:cd951dc3-44fb-d299-b963-e12f891de1df"},{"@id":"urn:uuid:d66cd0c9-0d2f-1b03-562b-78119f5d5d8a"}],"dcat:keyword":[{"@language":"sv","@value":"Anläggningar för miljöövervakning"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Platser där det utförts mätningar av vattenkemi, växt- och djurplankton, bottenfauna, påväxtalger samt makrofyter i sjöar och vattendrag."},"dct:identifier":"fa2e73d9-e3b3-d981-ac1d-881af612f8ce","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-16"},"dct:provenance":{"@id":"_:a7d69c182723020a781016d73892d709dcb98e66d59a23836540ea2f4bf9b7d0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002817"},"dct:spatial":{"@id":"_:a7d69c182723020a781016d73892d709dcb98e66d59a23836540ea2f4bf9b7d0_b1n0"},"dct:title":{"@language":"sv","@value":"Stationsregistret: Platser för miljöövervakning: Datavärdskap Sjöar och vattendrag"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:32ffbae1-dacf-4b21-3ed1-70fcaae3fd65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sveriges Lantbruksuniversitet (SLU)","http://www.w3.org/2006/vcard/ns#organization-name":"Sveriges Lantbruksuniversitet (SLU)"},{"@id":"urn:uuid:6ca60906-c4bd-9317-d915-fbd3e89fc5a0","@type":"dcat:Distribution","dcat