värden."},"dct:identifier":"77bfe96a-0530-4050-80f7-c76865d1329f","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-14"},"dct:provenance":{"@id":"_:4edfb8e83cde8b6415c9636799ca094ec0b6ef370239c04026e358cb28e4aad7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:4edfb8e83cde8b6415c9636799ca094ec0b6ef370239c04026e358cb28e4aad7_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Vattenanknutna kulturmiljöer område"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4edfb8e83cde8b6415c9636799ca094ec0b6ef370239c04026e358cb28e4aad7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:6735fb8e-1229-b96b-287d-1cc027bb8a74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_Vattenanknutna_kulturmiljoer_omrade.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:4edfb8e83cde8b6415c9636799ca094ec0b6ef370239c04026e358cb28e4aad7"},{"@graph":[{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Regeringsuppdrag från 2005 att skapa en databas med den samlade bilden av naturolyckor i Sverige. Data har samlats in från drabbade kommuner och länsstyrelser, liksom centrala myndigheter som varit aktörer. MSB har skapat digital geografisk data från underlag som samlats in, ex. genom skärmdigitalisering."}},{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1950"}},{"@id":"https://www.geodata.se/resources/c75452c9-f2de-4198-a000-7ea601367ca0","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:43540261-55cd-37e1-6532-30a93f44f596"},{"@id":"urn:uuid:441eef20-032e-7d58-c47b-1cec0e86a8a3"},{"@id":"urn:uuid:4bb17bec-68a1-5f6c-5971-324a04df67ad"},{"@id":"urn:uuid:58daad73-6c9c-f954-4325-e7dc98f6f6a9"},{"@id":"urn:uuid:5c7bae6e-c97d-0678-8cb2-b21fbc37a041"},{"@id":"urn:uuid:e0d0cf13-ae3f-083f-e109-af59342a8ded"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"OBS! Gammal datamängd som inte uppdateras längre.\n\nData om naturolyckor. Dokumentation om bakomliggande orsaker, händelseförlopp, hantering och lärdomar från naturolyckor finns samlat i en nationell naturolycksdatabas.  \nDatabasen fungerar som ett stöd och en kunskapskälla för myndigheter i deras förberedande och förebyggande säkerhetsarbete eller i utbildningssammanhang. \nInformationen är tillgänglig för alla som vill läsa om händelser som inträffat i deras närhet eller i övriga Sverige. För några av händelserna har shp-filer skapats över utbredningen av enskilda händelser, ex. skyfall, stormar.\nData om inträffade naturolyckor inom Sveriges gränser finns som punkt eller ytobjekt."},"dct:identifier":"c75452c9-f2de-4198-a000-7ea601367ca0","dct:issued":{"@type":"xsd:date","@value":"2007-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-01"},"dct:provenance":{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b1n0"},"dct:temporal":{"@id":"_:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02_b2n0"},"dct:title":{"@language":"sv","@value":"Naturolyckor"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:43540261-55cd-37e1-6532-30a93f44f596","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/naturolyckor/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst naturolyckor OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:441eef20-032e-7d58-c47b-1cec0e86a8a3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_naturolyckor.xml"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av naturolyckor i GML-format."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:4bb17bec-68a1-5f6c-5971-324a04df67ad","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/naturolyckor/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"MSB:s sida för visning av naturolyckor."}},{"@id":"urn:uuid:58daad73-6c9c-f954-4325-e7dc98f6f6a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://undefined"},"dct:description":{"@language":"sv","@value":"undefined"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:5c7bae6e-c97d-0678-8cb2-b21fbc37a041","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/arcgis/rest/services/msb/InspireMSB_Naturolyckor/MapServer/exts/InspireView/service"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:e0d0cf13-ae3f-083f-e109-af59342a8ded","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/naturolyckor.zip"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av naturolyckor i Shape-format."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:4f5f1efe6d6e3b00621f5b89368a785e793377288083c40b5d64140b478f0d02"},{"@graph":[{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Insamling av data har gjorts av företaget SkyTEM Aps på uppdrag av SGU. Databasen innehåller data insamlad mellan 2013 och 2019. Mätningarna är i allmänhet gjorda längs parallella flyglinjer med cirka 200 meters avstånd. Riktningen för flyglinjerna varierar inom olika områden. SGU har utfört databearbetning och inversion av rådata för att ta fram resistivitetsdata. Resistivitetsdata förekommer med cirka 30 till 40 meters punktavstånd längs med flyglinjerna.\n\nDatakvalitet:\nDatakvaliteten är mycket beroende på de geologiska förutsättningarna i olika områden. Förutsättningarna kan skilja sig mycket också inom ett och samma mätområde. Inversionsmetodiken har också sina antagande och generaliseringar varvid data alltid ska betraktas både med kunskap om geologi, mätmetoden, inversion och genom beaktande av olika kvalitetsparametrar. Goda geometriska återgivelser fås vid plan, homogen och horisontell geologi. Snabba vertikala skiftningar återges inte geometriskt korrekt."}},{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2019-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2013-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a2e4dc6c-d782-4eeb-977f-2d81a609d729","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:a825c968-4c5c-d341-5e6d-b93bd04fbcd6"},{"@id":"urn:uuid:b5a76513-4ecc-4526-daf5-586434409bd3"},{"@id":"urn:uuid:c196a8bc-813e-9be6-582b-81873337352c"},{"@id":"urn:uuid:d1869007-e69c-09fa-7d26-18943f8bd7b1"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Insamling av data har gjorts av företaget SkyTEM Aps på uppdrag av SGU. Databasen innehåller data insamlad mellan 2013 och 2019. Mätningarna är i allmänhet gjorda längs parallella flyglinjer med cirka 200 meters avstånd. Riktningen för flyglinjerna varierar inom olika områden.\n\nSGU har utfört databearbetning och inversion av rådata för att ta fram resistivitetsdata. Resistivitetsdata förekommer med cirka 30 till 40 meters punktavstånd längs med flyglinjerna."},"dct:identifier":"a2e4dc6c-d782-4eeb-977f-2d81a609d729","dct:issued":{"@type":"xsd:date","@value":"2024-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b1n0"},"dct:temporal":{"@id":"_:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, elektromagnetiska fält, TEM, resistivitet"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:a825c968-4c5c-d341-5e6d-b93bd04fbcd6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-flyg-em-tem-resistivitet/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:b5a76513-4ecc-4526-daf5-586434409bd3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-tem-resistivitet/HBCA_Gotland_A1_2.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: Exempel XYZ-fil för flygområde HBCA_Gotland_A1_2"}},{"@id":"urn:uuid:c196a8bc-813e-9be6-582b-81873337352c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysik-flyg-em-tem-resistivitet-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:d1869007-e69c-09fa-7d26-18943f8bd7b1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-tem-resistivitet/geofysik-flyg-em-tem-resistivitet.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: GeoPackage med flygområden"}}],"@id":"urn:source:5020799dad92b99a7b5e51ee075c7afb9b478ddcb70243a55f5c38c83177d0c7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/30b8cca7-02bd-4793-a696-d5a2e75fd03f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://share.scb.se/OV0105/Xml/PD/pd_befolkningsfordelning_totalbefolkning_atom_nt.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik redovisas för Rutor (1x1 km). Statistiken avser 2024-12-31."},"dct:identifier":"30b8cca7-02bd-4793-a696-d5a2e75fd03f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"PD.Befolkningsfördelning.Totalbefolkning.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:5080303800ce6358d3ec3a59cdea6852ba6b5d0efcbb6c20a5f5bea4a2886f86"},{"@graph":[{"@id":"_:5083341f6b987ac9917d209a084b7faaed66b24b62bec5269982679f60637d31_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Nattlig SAMMANSLAGNING samt STÄDNING enligt IVL för Miljöatlas-applikationen."}},{"@