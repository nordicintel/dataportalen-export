se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:9032edca-ee91-2a71-1bff-ef108ac88bf3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.5a0c1a2c18fa6d6097b799e6/1717149375852/dataunderlag-till-diagram-tillstandsklasser-alkalinitet-1996-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Tillståndsklasser i grundvatten  - Alkalinitet"}}],"@id":"urn:source:4b924f51af278912d6b3f05efbf8fa4eb123f131e9051ce26025232c8a8ab56a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/83f3e018-fc62-4d46-bb0f-fbaf7dbd7fdb","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/byggnad-visning-vector-tiles-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Byggnad Visning, vector tiles är en visningstjänst bestående av Lantmäteriets mest detaljerade topografiska data för byggnader och anläggningsområden.  Formatet, vector tiles, ger andra möjligheter för användning än visningstjänster i rasterformat.  Produkten ger möjlighet att koppla ihop information från kartan med våra direktåtkomsttjänster. Dessutom kan egna stilfiler definieras för ett eget utseende på kartan. Informationen visas upp till skala 1: 10 000."},"dct:identifier":"83f3e018-fc62-4d46-bb0f-fbaf7dbd7fdb","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Byggnad Visning, vector tiles"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4bfc818d606df8fed545cbf230e44d72242d8c885ca5307fbb634edcb3de95e4"},{"@graph":[{"@id":"_:4c2070e4ba201f3cb59cc968e770fdc0ac7cef59559f90d7db4f51d722e4ac2f_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/oc-obs-waveperiodmean/OF.PointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveperiodmean/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveperiodmean/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4c2070e4ba201f3cb59cc968e770fdc0ac7cef59559f90d7db4f51d722e4ac2f_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/642f8e00-2399-11ed-832f-911b23582b4f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveperiodmean/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter vågperiod. Tjänsten visar alla stationer som någonsin levererat data för denna parametrar. Insamlade från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"642f8e00-2399-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Vågperiod, medelvärde: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4c2070e4ba201f3cb59cc968e770fdc0ac7cef59559f90d7db4f51d722e4ac2f"},{"@graph":[{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Produkten bygger på en omklassning längs stränder av grundlagret (JG2) i datamängden Jordarter 1:25 000 – 1:100 000 till sju förenklade jordartsklasser och fyra eroderbarhetsklasser. Omklassningen redovisas i produktbeskrivning.\n\nStrandlinjen utgörs av jordartskartans strandlinjer och kan avvika geometriskt från aktuella data från Lantmäteriet.\n\nBegreppet eroderbarhet avser endast jordens materialegenskap såsom jordpartiklarnas tyngd och sammanhållande krafter. Faktorer som vattnets strömhastighet, vågpåverkan och morfologi, vilka är avgörande för erosionsprocessen, beaktas inte.\n\nNoggrannheten i områdesavgränsningarna är de samma som i datamängden Jordarter 1:25 000-1:100 000 över respektive områden: ca 25 – 50 m i områden kartlagda med detaljerad metod (karttyp 2 och 3) och ca 50 -100 m i övriga områden (karttyp 4 och 5). Karttyperna beskrivs översiktligt i lagret Täckningsområde med information om karttyp.\n\nProdukten redovisar förhållandena vi karteringstillfället. Byggnation och markarbeten kan ha ändrat strandens egenskaper. Kartan bör därför tolkas med stor försiktighet inom tätorter.\nVid en högvattensituation kan vattenytan nå jordarter med annan eroderbarhet än vad som framgår av denna produkt."}},{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.81 67.53,24.18 67.53,24.18 55.15,10.81 55.15,10.81 67.53))"}},{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1962"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/f4b69a53-b7a9-487b-a954-7ffe196356f6","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1a8fb491-3b90-8e10-322e-3de6ae952f07"},{"@id":"urn:uuid:a2ce7956-a759-fa64-0c8d-d87fb123713f"},{"@id":"urn:uuid:b50d1691-a109-d942-ac81-b25a207a3696"},{"@id":"urn:uuid:edc838c1-bd99-f108-0295-3df9ab24631e"},{"@id":"urn:uuid:f0993c49-a112-4b34-aa5e-8dfa240d3b21"},{"@id":"urn:uuid:f5624a12-28e4-39ef-d8e9-6baf2bb596df"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Datamängden ger information om jordartstyp samt jordartens eroderbarhet längs stränder. \nProdukten bygger på en omklassning längs stränder av grundlagret datamängden Jordarter 1:25 000 – 1:100 000 till sju förenklade jordartsklasser och fyra eroderbarhetsklasser.\nProdukten redovisar förhållandena vi karteringstillfället. Byggnation och markarbeten kan ha ändrat strandens egenskaper. Kartan bör därför tolkas med stor försiktighet inom tätorter."},{"@language":"sv","@value":"Underlag för översiktliga analyser av strandförhållanden, ti ll exempel strandmaterialets\nbenägenhet för erosion, strandens lämplighet för olika markanvändning, friluftsliv."}],"dct:identifier":"f4b69a53-b7a9-487b-a954-7ffe196356f6","dct:issued":{"@type":"xsd:date","@value":"2016-04-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-31"},"dct:provenance":{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b1n0"},"dct:temporal":{"@id":"_:4cb9d732f08f89971539dab3928efc77d172fd7101e29d5cafb612ff1632baf5_b2n0"},"dct:title":{"@language":"sv","@value":"Stränders jordart och eroderbarhet"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1a8fb491-3b90-8e10-322e-3de6ae952f07","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/stranders-jordart-eroderbarhet-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:a2ce7956-a759-fa64-0c8d-d87fb123713f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-stranders-jordart-eroderbarhet.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europ