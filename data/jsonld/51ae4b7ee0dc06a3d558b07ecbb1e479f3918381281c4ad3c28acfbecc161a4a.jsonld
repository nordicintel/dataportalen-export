ar@socialstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Socialstyrelsen"},"foaf:page":{"@id":"https://www.socialstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ngs.ehalsomyndigheten.se/organisation/SE2021000555"}},{"@id":"https://www.geodata.se/resources/c193c5c0-7837-4857-8ee5-35709d0ee4b9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-ska-wms.map&service=wms&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens statistikdatabas skador och förgiftningar, antal vårdade patienter i sluten eller öppen specialiserad vård med vissa miljörelaterade skador som X40-X49 Förgiftningsolyckor under åren 2020-2022 per 100 000 invånare"},"dct:identifier":"c193c5c0-7837-4857-8ee5-35709d0ee4b9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:title":{"@language":"sv","@value":"Skador och förgiftningar visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:bdbee584369a8b99291975a92759a7e93517ab1dab054ab5f375fafa232952b2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/5c203290-f5ce-4e5a-b29b-4f932972d488","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www.sjofartsverket.se"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Detta är visningstjänsten för djupförhållanden inom temat Höjd."},"dct:identifier":"5c203290-f5ce-4e5a-b29b-4f932972d488","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"EL.Bathymetry"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:be0a75496b3407367872cd2751e5a75fa31de1ceea95e9d5921b0c6fa353619b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8793c415-4eb2-4d33-9a64-a6ea2444c31d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/samfallighetsforening-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten visar information från Samfällighetsföreningsregistret.\nSamfällighetsföreningsregistret innehåller information om bl.a:\n•\tTyp av förening: samfällighetsförening, vägförening, vägsamfällighet eller förening enligt lagen om vissa gemensamhetsanläggningar\n•\tNamn på förening, organisationsnummer eller länskod\n•\tNamn och adressuppgifter för styrelsemedlemmar\n•\tUppgifter om vad föreningen förvaltar t.ex. vägar, vattenförsörjning, avloppsanläggning, grönområden, bad- och/eller båtanläggning."},"dct:identifier":"8793c415-4eb2-4d33-9a64-a6ea2444c31d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Samfällighetsförening Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:be77ad4e9db43b62415a81c20365be32ca6f17e81570766a710d928df630a193"},{"@graph":[{"@id":"_:be92aa3526f2c2364487b75aca75e3f42bd58b20f68926b746bc27c61b29c03e_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.13068 65.30919,21.31105 65.30919,21.31105 56.07223,11.13068 56.07223,11.13068 65.30919))"}},{"@id":"_:be92aa3526f2c2364487b75aca75e3f42bd58b20f68926b746bc27c61b29c03e_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/69400d4a-0339-4fb4-a186-70aae3ae7591","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:8f32989b-2d36-1fb0-4b8d-0534b16f2506"},{"@id":"urn:uuid:fdd41076-18d7-3bfc-1878-c0f3dc3321b0"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Utförd kalkning innehåller kalkmängder, medel, metod  med mera för den kalk som spridits i respektive kalkningsobjekt. Kalkningsuppgifter finns för samtliga år som objekten kalkats. Kartskiktet hämtar uppgifter från Nationella kalkdatabasen. Varje län ansvarar för att årligen importera utförd kalkning i kalkdatabasen."},"dct:identifier":"69400d4a-0339-4fb4-a186-70aae3ae7591","dct:issued":{"@type":"xsd:date","@value":"2019-08-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-08-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:be92aa3526f2c2364487b75aca75e3f42bd58b20f68926b746bc27c61b29c03e_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - kalkning utförda"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:be92aa3526f2c2364487b75aca75e3f42bd58b20f68926b746bc27c61b29c03e_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:8f32989b-2d36-1fb0-4b8d-0534b16f2506","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_kalkningutforda.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:fdd41076-18d7-3bfc-1878-c0f3dc3321b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:be92aa3526f2c2364487b75aca75e3f42bd58b20f68926b746bc27c61b29c03e"},{"@graph":[{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"koordinaterna för anläggningarna avser provtagningsområdets generella geografiska läge. Enskilda prover kan ha specifika koordinater angivna."}},{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1986"}},{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/44fcab43-b9a6-4ea9-95dc-f1bf44d2134a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:1e3d10ae-07bb-3869-d2ba-964a3632fdd8"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har provtagit älgkött för mätning av cesium-137 i muskelvävnad i två områden sedan Tjernobylolyckan 1986. I nuvarande program mäts halter endast i ett område. Data från dessa mätningar finns tillgängliga via Strålsäkerhetsmyndighetens webbplats. Kartan visar provtagningsområdets generella geografiska läge. För enskilda prover kan det finnas specifika koordinater."},"dct:identifier":"44fcab43-b9a6-4ea9-95dc-f1bf44d2134a","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b1n0"},"dct:temporal":{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: cesium-137 i älgkkött"}},{"@id":"urn:uuid:1e3d10ae-07bb-3869-d2ba-964a3632fdd8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"}],"@id":"urn:source:bf1ea4c08f90e95ac3db8fa8fd10c52bba6d99d635fbe92db1e697ea17d7bf7e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004185","@type":"foaf:Agent","dct:identifier":"2021004185","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.skolverket.se/"},"foaf:mbox":{"@id":"mailto:support.oppnadata@skolverket.se"},"foaf:name":{"@language":"sv","@value":"Skolverket"},"foaf:page":{"@id":"https://www.skolverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://dataportal.se/organisation/SE202100-4185"}},{"@id":"https://www.geodata.se/resources/d7057c73-8844-4df1-868f-c34f1793edc2","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://inspire-skolverket.metria.se/geoserver/skolverket/ows?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Skolenheter i Sverige för förskoleklass, grundskolan, anpassade grundskolan, specialskolan, sameskolan, \ngymnasieskolan samt anpassade gymnasieskolan. Uppgifterna avser läsåret 2024/25 och är fria för både privat och juridisk person att använda utan kostnad."},"dct:identifier":"d7057c73-8844-4df1-868f-c34f1793edc2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004185"},"dct:title":{"@language":"sv","@value":"US.Skolenheter.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:bfa586f186d029b125b98050605d39ed74dc40fbe151661cf853f2836aaf32f2"},{"@graph":[{"@id":"_:c009cc878c7f9377dab6c1a230ebb7fd928e5dd98b97198413bb035d8f560355_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Socken och stad är en rikstäckande geografiskindelning som bygger på de jordregistersocknar som var aktuella i samband med övergången till nytt fastighetsregister 1976–1995 samt de stadsregisterområden som var stad med stadsprivilegier i samband med kommunreformen 1971."}},{"@id":"_:c009cc878c7f9377dab6c1a230ebb7fd928e5dd98b97198413bb035d8f560355_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/698de0f2-c1f0-4100-81c3-35b3b1e02ae2","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:256aedcf-bc19-9c67-8640-df99b0befa3c"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Socken och stad Nedladdning, vektor bygger på de jordregistersocknar som var aktuella i samband med övergången till nytt fastighetsregister 1976–1995 samt de stadsregisterområden som var stad med stadsprivilegier i samband med kommunreformen 1971."},"dct:identifier":"698de0f2-c1f0-4100-81c3-35b3b1e02ae2","dct:issued":{"@type":"xsd:date","@value":"2020-01-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-10-13"},"dct:provenance":{"@id":"_:c009cc878c7f9377dab6c1a230ebb7fd928e5dd98b97198413bb035d8f560355_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:c009cc878c7f9377dab6c1a230ebb7fd928e5dd98b97198413bb035d8f560355_b1n0"},"dct:title":{"@language":"sv","@value":"Socken och stad Nedladdning, vektor"}},{"@id":"urn:uuid:256aedcf-bc19-9c67-8640-df99b0befa3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/socken-stad-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktsida för Socken och stad Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktsida för Socken och stad"}}],"@id":"urn:source:c009cc878c7f9377dab6c1a230ebb7fd928e5dd98b97198413bb035d8f560355"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7273cd98-5af0-45e5-b31a-8b8ac3a5875d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SGU_Bedrock_Geology?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"en","@value":"The dataset GE.Bedrock 1:1 million covering the whole of Sweden is available in this OGC WMS service. It is being served as a contribution to the OneGeology initiative (www.onegeology.org). Bedrock geology layers are available in this service. Layers available for bedrock are age, lithology and faults. In this service these are attributed and coloured according to INSPIRE standards for age, lithology and faults."},"dct:identifier":"7273cd98-5af0-45e5-b31a-8b8ac3a5875d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"en","@value":"GE.Bedrock 1:1 million OneGeology (view service)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c087d6f8827fde0c6f0d7d52d83f1df5a8ea89e5fcc6aefcbae0c1268645b5e5"},{"@graph":[{"@id":"_:c0c045a914fc4aa04cabb2132c35e5d7f36df5db632029754c6448b1b4c0d2bd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är ett bearbetat urval ur Sjöfartsverkets farledsregister. I detta urval ingår enbart SSA som är mer eller mindre aktiva (dvs. har Status: Permanent, Occas, Tillfälligt utsatt eller Tillfälligt indragen). I nuläget innehåller denna datamängd enbart de SSA som ägs av Sjöfartsverket; dvs. SSA som ägs av t.ex. hamnar, kommuner eller andra ägare ingår inte i nuvarande urval. Se 3. kap. i Sjötrafikförordningen (SFS 1986:300).\n\nLägesriktigheten hos objekten varierar med anledning av att krav och teknik har förändrats sedan registret skapades på 1980-talet. Generell kvalitet för respektive företeelses positionsangivelse beskrivs i attributet Fastställandestatus."}},{"@id":"_:c0c045a914fc4aa04cabb2132c35e5d7f36df5db632029754c6448b1b4c0d2bd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.85,23.51 65.85,23.51 54.80,10.30 54.80,10.30 65.85))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/140be0c2-cd89-4010-9c51-94f9741dbf2a","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:56045117-8150-7fe9-aac9-a58ee97e746e"},{"@id":"urn:uuid:6a6e76b8-a938-0e63-ac48-0209a716948c"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Sjösäkerhetsanordningar (SSA) är nautiska objekt (fyr, prick, boj med flera) som inrättas i syfte att underlätta navigering. Denna datamängd är hämtad ur Sjöfartsverkets farledsregister och omfattar i nuläget enbart sjösäkerhetsanordningar som ägs av Sjöfartsverket (SjöV). Förutom postion för SSA ingår även information om bl.a. typ av SSA, namn och status. För beskrivning av attribut, se Exempelbilder."},"dct:identifier":"140be0c2-cd89-4010-9c51-94f9741dbf2a","dct:issued":{"@type":"xsd:date","@value":"2014-09-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-09-24"},"dct:provenance":{"@id":"_:c0c045a914fc4aa04cabb2132c35e5d7f36df5db632029754c6448b1b4c0d2bd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:c0c045a914fc4aa04cabb2132c35e5d7f36df5db632029754c6448b1b4c0d2bd_b1n0"},"dct:title":{"@language":"sv","@value":"Sjösäkerhetsanordning"}},{"@id":"urn:uuid:56045117-8150-7fe9-aac9-a58ee97e746e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/"},"dct:description":{"@language":"sv","@value":"Sjöfartsverkets officiella hemsida"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets officiella hemsida"}},{"@id":"urn:uuid:6a6e76b8-a938-0e63-ac48-0209a716948c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Sjofart/Farleder-och-underhall/Farledsordlista/"},"dct:description":{"@language":"sv","@value":"Ordlistan speglar det språkbruk som Sjöfartsverket, Transportstyrelsen och många andra av sjöfartens intressenter använder i sin interna kommunikation och i kommunikation med näringen, hamnar, myndigheter m.fl. Ordlistan behandlar farleder – deras kapacitet, begränsningar och andra egenskaper, vilka typer det finns, samt utmärkning av farleder."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets Ordlista och begreppsdiagram - Farleder och hamnar"}}],"@id":"urn:source:c0c045a914fc4aa04cabb2132c35e5d7f36df5db632029754c6448b1b4c0d2bd"},{"@graph":[{"@id":"_:c115d0aa723fab2ee