fiskevårdsområden som registreras och hanteras från Svenska Fiskekartan.\nSkiktet över övriga upplåtare gör inte anspråk på att vara heltäckande på samma sätt som skiktet som visar fiskevårdsområden. Länsstyrelserna har inget utpekat ansvar att hålla register över dessa områden, utan vad som finns digitaliserat beror på respektive läns ambitionsnivå."},"dct:identifier":"38a09f18-f205-478c-99ad-655a5bc4575d","dct:issued":{"@type":"xsd:date","@value":"2020-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-03-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:48f358ae5595b4802779d5b077db57fb9f330fd856eaad66f2eb7c6676616181_b0n0"},"dct:title":{"@language":"sv","@value":"LST Övriga upplåtelser - Fiskekartan.se"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:48f358ae5595b4802779d5b077db57fb9f330fd856eaad66f2eb7c6676616181_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:5a47f9a3-82b9-e549-e1e6-dbd4fd358511","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/services/SvenskaFiskekartan/lst_svenskafiskekartan_webbgis/MapServer/WMSServer?layers=ovriga_upplatare"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Övriga upplåtelser - WMS-tjänst"}},{"@id":"urn:uuid:6d7a5aad-8695-6b38-1646-e65344d9c909","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/rest/services/SvenskaFiskekartan/lst_svenskafiskekartan_webbgis/MapSe