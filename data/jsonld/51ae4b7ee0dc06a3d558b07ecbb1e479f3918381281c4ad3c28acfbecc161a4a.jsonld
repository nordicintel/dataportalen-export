urce/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"ATOM-fil"}},{"@id":"urn:uuid:31c33202-b024-9bca-4b9a-09e59c5b9010","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_naturskydd_ext/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Naturskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:412a48039b21a5ff18aeb562b75705bbb143233dd6ab60e0eea6bcf05859f215_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Naturskydd"}],"@id":"urn:source:412a48039b21a5ff18aeb562b75705bbb143233dd6ab60e0eea6bcf05859f215"},{"@graph":[{"@id":"_:41434990bee241412f67de94aeafe311fb6d0dddd19444dd37b027945f028028_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 69.05997,24.17767 69.05997,24.17767 55.13721,10.59208 55.13721,10.59208 69.05997))"}},{"@id":"_:41434990bee241412f67de94aeafe311fb6d0dddd19444dd37b027945f028028_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/be2c7127-16ba-4fe9-a8df-5fc1b361e102","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:18055010-4966-fffc-2002-27fe11019a34"},{"@id":"urn:uuid:3f2f56e2-d2b5-b7fd-108a-a915b85516bb"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Vattendrag inlagda i Nationella Biotopkarteringsdatabasen. \nVattendragen ligger inlagda som punktobjekt. Punkterna markerar vattendragets mynning.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till objektets protokoll i databasen.\n\nSkiktet innehåller bara vattendrag där det har genomförts eller planeras att genomföra någon typ av biotopkartering, och innehåller alltså inte data för alla landets vattendrag.\n\nKoordinater är Sweref 99 TM."},"dct:identifier":"be2c7127-16ba-4fe9-a8df-5fc1b361e102","dct:issued":{"@type":"xsd:date","@value":"2021-04-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:41434990bee241412f67de94aeafe311fb6d0dddd19444dd37b027945f028028_b0n0"},"dct:title":{"@language":"sv","@value":"LST Vattendrag - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:41434990bee241412f67de94aeafe311fb6d0dddd19444dd37b027945f028028_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatte