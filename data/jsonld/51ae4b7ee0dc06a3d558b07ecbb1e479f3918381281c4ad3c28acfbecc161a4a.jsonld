atten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/e6d17e96-5828-4f9d-8214-517c46433a48","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7"},"dcat:distribution":{"@id":"urn:uuid:f4dffe30-fb2a-2925-01e7-8bedf7a23dd1"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nationell sammanställning av beslutsgrundande geometrier gällande strandskydd. Datamängden är nedladdad från Nationella Geodataplattformen (NGP) och är öppna data. Denna datamängd ska användas ihop med tabellen Länsstyrelsens strandskyddsbeslut och ger information om upphävt eller utvidgat strandskydd.\n\nDenna datamängd visualiserar inte det generella strandskyddet. Det som visas är information om strandskydd i nedan kategorier:\n•\tAvvisat\n•\tUpphävt i enskilt fall\n•\tUpphävt i plan\n•\tUndantag äldre plan\n•\tFörordnande om undantag\n•\tInfört\n•\tGenerellt inritat\n\nVarje län ansvarar för sina egna data och därför kan utbredningen av digitaliseringen skilja sig åt mellan länen. Vid frågor om strandskydd kontakta respektive beslutsfattare. Beslutsfattande organisation framgår i attributtabellen. \n\nOm du vill ladda ner data gör du det via NGP: https://www.lantmateriet.se/sv/nationella-geodataplattformen/datamangder/strandskydd/\nVid teknisk support för nedladdning från NGP kontakta geodatasupport@lm.se. \n\nInformationen i kartbilden är en tolkning av fattade beslut. Kartbilden är inte juridiskt bindande och det kan förekomma strandskyddsinformation i kartbilden som inte stämmer överens med verkligheten. För att ta del av beslutsunderlag kontakta respektive beslutsfattare.\n\nLänsstyrelsens strandskyddsytor ska tolkas i skala 1:10 000"},"dct:identifier":"e6d17e96-5828-4f9d-8214-517c46433a48","dct:issued":{"@type":"xsd:date","@value":"2024-11-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:19a4f76d0b21bda38a3560a3f82ad759c8c70b3ab055846728766f6c85a46716_b0n0"},"dct:title":{"@language":"sv","@value":"Länsstyrelsens strandskyddsytor (Intern)"}},{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Natur","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:19a4f76d0b21bda38a3560a3f82ad759c8c70b3ab055846728766f6c85a46716_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-natur@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Natur"},{"@id":"urn:uuid:f4dffe30-fb2a-2925-01e7-8bedf7a23dd1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/nationella-geodataplattformen/datamangder/strandskydd/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nationella geodataplattformen"}}],"@id":"urn:source:19a4f76d0b21bda38a3560a3f82ad759c8c70b3ab055846728766f6c85a46716"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/b722eefd-663d-4a7d-bc53-caa7ed81a8ee","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/ins