3.org/2006/vcard/ns#street-address":"Geodatasupport, Lantmäteriet"},{"@id":"_:e0a591559ba68f41a82ef456400b428b1cdd58c70dc602be624c15c39603d4a0_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:026-633600"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/58acbe9b-ab4b-41f7-a5d2-31980b6a05fe","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109"},"dcat:distribution":{"@id":"urn:uuid:cd347f8d-9872-433b-4557-93f1b7532a1d"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten innehåller kustlinje, sjöar/öar, vattendrag, riksgräns, länsgräns, kommungräns, landskapsgräns, polcirkeln och gradnät/rutnät."},"dct:identifier":"58acbe9b-ab4b-41f7-a5d2-31980b6a05fe","dct:language":{"@id":"http://publications.europa.eu/resource/auth