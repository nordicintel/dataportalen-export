/www.geodata.se/resources/a1bd1b76-b48d-41cc-a508-ae80bffe9921","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:5c3e8261-db03-7ca6-a52b-229eecc44d9c"},{"@id":"urn:uuid:740bc946-ec07-7efb-0725-ec8532086b5f"},{"@id":"urn:uuid:76af5f0f-1179-6a66-ab6a-01d901e0757f"},{"@id":"urn:uuid:ab5a1464-cd9e-e738-ab4b-616023945469"},{"@id":"urn:uuid:f3842310-fea0-761d-525a-9e5944a2d850"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Målområde sjöar visar de sjöar där det finns vattenkemiska mål och/eller biologiska mål inom kalkningsverksamheten i Sverige. Skiktet bygger på geodata från respektive länsstyrelse som kompletterats med data från Nationella kalkdatabasen. Varje län ansvarar för att de områden som finns med i skiktet är aktuella och kommer in med uppdateringar när ändringar sker.  Skiktet Målområde sjöar uppdateras en gång per år av länsstyrelsens förvaltningsobjekt Vatten och miljömål."},"dct:identifier":"a1bd1b76-b48d-41cc-a508-ae80bffe9921","dct:issued":{"@type":"xsd:date","@value":"2019-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:3fdde78196764ebcbc0e017fa77fe9af3c19973e1eb72413e80364e68e8f7b42_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - målområden sjöar"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3fdde78196764ebcbc0e017fa77fe9af3c19973e1eb72413e80364e68e8f7b42_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:5c3e8261-db03-7ca6-a52b-229eecc44d9c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/7"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Alla sjöar oavsett status"}},{"@id":"urn:uuid:740bc946-ec07-7efb-0725-ec8532086b5f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/11"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Målområde sjöar - vilande"}},{"@id":"urn:uuid:76af5f0f-1179-6a66-ab6a-01d901e0757f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/9"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Målområden sjöar - avslutade"}},{"@id":"urn:uuid:ab5a1464-cd9e-e738-ab4b-616023945469","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_malomraden_sjoar.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:f3842310-fea0-761d-525a-9e5944a2d850","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/10"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Målområde sjöar - pågående"}}],"@id":"urn:source:3fdde78196764ebcbc0e017fa77fe9af3c19973e1eb72413e80364e68e8f7b42"},{"@graph":[{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data kommer ursprungligen från beräkningar med beräkningsmodellen SGU-HYPE (en utveckling av SMHI:s vattenbalansmodell HYPE). SGU-HYPE är modifierad för att bättre beskriva grundvattnets nivåvariationer och kalibrerad mot SGU:s nätverk av observationsplatser för grundvattennivå. Modellen drivs av SMHI:s meteorologiska data (PTHBV). \n\nSGU använder begreppen fyllnadsgrad och grundvattensituation för att beskriva grundvattennivån för en plats i förhållande till andra nivåer för samma plats. Skillnaden mellan fyllnadsgrad och grundvattensituation är att för fyllnadsgrad görs en jämförelse med samtliga nivåer för platsen oavsett årstid, medan det för grundvattensituation endast görs en jämförelse med nivåer under motsvarande vecka. I denna produkt görs jämförelsen för perioden 1961 till och med föregående år.\n\nFyllnadsgrad och grundvattensituation är enhetslösa och noll indikerar att grundvattennivån är lika låg som den lägsta nivån och 100 att den är lika med den högsta nivån för den aktuella platsen och perioden. För att beräkna fyllnadsgrad och grundvattensituation används kumulativ relativ frekvens vilket innebär att grundvattennivåerna normeras för den specifika platsen och den period som analyseras. Normeringen görs så att det blir en likformig sannolikhetsfördelning, även kallad rektangulär fördelning, från 0 till 100. I praktiken visar detta hur många procent av observationerna som ligger under värdet i fråga. Till exempel innebär det att 10 procent av observationerna är lägre än fyllnadsgrad 10. Följaktligen är 90 procent av observationerna högre än fyllnadsgrad 10.\n\nAtt använda fyllnadsgrad och grundvattensituation är ofta ett praktiskt sätt att beskriva hur nivåobservationer förhåller sig varandra, speciellt om observationerna inte är jämnt fördelade vilket ofta är fallet med grundvattennivåer om de uttrycks i meter så som visas i exemplen nedan. Det möjliggör också en mer direkt jämförelse mellan olika platser utan att behöva ta hänsyn till att grundvattennivån kan skilja stort mellan olika platser."}},{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.004342417515 68.815219040895,25.47930022724 68.815219040895,25.47930022724 55.101108174396,11.004342417515 55.101108174396,11.004342417515 68.815219040895))"}},{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1963-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c5e7c33f-e204-4e27-a814-1e243a6d49d2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:2ea5d956-a7b2-cfbd-7cf4-05a34ab5e87d"},{"@id":"urn:uuid:51576144-8263-8912-f46b-683be4007bea"},{"@id":"urn:uuid:5793eccd-54d7-31fe-9acd-d71295ed9c1d"},{"@id":"urn:uuid:cd753f3f-0b1e-8980-27fd-9d13a71a961c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Produkten innehåller områdesindelning för beräknad fyllnadsgrad och grundvattensituation från 1961 till och med föregående söndag. Beräkningarna görs för områden som motsvarar 4x4 km rutor baserad på SMHI:s grid för PTHBV inom rikets gränser. Fyllnadsgrad och grundvattensituation är olika sätt att beskriva grundvattennivån i förhållandena till nivåer vid andra tidpunkter för samma plats.\n\nVarje område har ett ID, som konstrueras från områdets rad+kolumn i ett rutnät som täcker hela beräkningsytan. I detta API kan motsvarande beräknade nivåer, hela tidserien från 1961 och framåt, erhållas per område. API:et kan också anropas med ett koordinatpar (n, e), dock erhålls beräknade nivåer för det område som omfattar koordinaten i fråga. Produkten visualiseras även i kartvisaren för beräknade nivåer."},"dct:identifier":"c5e7c33f-e204-4e27-a814-1e243a6d49d2","dct:issued":{"@type":"xsd:date","@value":"2022-11-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b1n0"},"dct:temporal":{"@id":"_:406edd6a770b1d68eee9ce8c4c4b119979e677dece93af902468cb16c545cc48_b2n0"},"dct:title":{"@language":"sv","@value":"Grundvattennivåer, beräknade, SGU-HYPE, områden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:2ea5d956-a7b2-cfbd-7cf4-05a34ab5e87d","@type":["dcat:Distribution","http://entryscape.com/