"dct:identifier":"ce72762c-afc0-47c7-afa7-efac6881042a","dct:issued":{"@type":"xsd:date","@value":"2024-08-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-14"},"dct:provenance":{"@id":"_:43dd056f411130fe8a0c2f1bc70f25a453caf09976435186fc970bebaca4f394_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:43dd056f411130fe8a0c2f1bc70f25a453caf09976435186fc970bebaca4f394_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Kända och potentiella rikkärr"}},{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:43dd056f411130fe8a0c2f1bc70f25a453caf09976435186fc970bebaca4f394_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Naturvårdsenheten"},{"@id":"urn:uuid:20f6306f-8533-8a6f-2ff9-d54b9c58f69b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTI/LstI_rikkarr_ext/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:cf5f7e74-5fab-ff66-caa2-4e916e1f4393","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lansstyrelsen.se/store/30/resource/248"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartering av potentiella rikkärr"}},{"@id":"urn:uuid:d7cf6843-3e8b-815e-8940-f1a35ae89857","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.LstI_kanda_och_potentiella_rikkarr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:43dd056f411130fe8a0c2f1bc70f25a453caf09976435186fc970bebaca4f394"},{"@graph":[{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU:s information om malmer och anrikningsverk har byggts upp under många år genom digitalisering av uppgifter om gruvor, prospekteringsobjekt och anrikningsverk. Huvuddelen av informationen är hämtad från de årliga rapporterna Bergshanteringen (för åren 1833–1977) och Bergverksstatistik. Utöver dessa har en mindre mängd data hämtats från Bergmästarens relationer för olika år och olika Bergmästardistrikt och från publikationer.\n\nFör information om indelning i en gruvas/gruvfälts storlek i ekonomiska termat, se avsnittet Innehåll och struktur för Malmer.\n\nUppgifter om reserver och tillgångar kommer huvudsakligen från gruv- och prospekteringsbolags information samt från prospekteringsrapporter från SGU, SGAB och LKAB.\n\nFör gruvornas, gruvdistriktens och anrikningsverkens läge har information om församlingstillhörighet (socken) från de tryckta källorna kombinerats med SGU:s mineralresursdatabas och, mera sällan, digitala kartor.\n\nEftersom nationella sammanställningar började publiceras år 1833 så är informationen före 1833 sparsam, fragmentarisk och finns bara för ett fåtal gruvor och gruvområden. Vidare saknas uppgifter om gråbergsproduktion för tiden före 1892 och systematisk rapportering av metallhalter inleds 1909. Systematisk rapportering av anrikningsverk startar först 1906. Vidare saknas rapportering om anrikningsverk för icke-järnmalm i Bergshanteringen och Bergverksstatistik åren 1924 till 1933. \n\nPositionsangivelserna är i de flesta fall av god kvalitet men för ett antal gruvor och gruvområden och för några få anrikningsverk saknas exakt position mer än i vilken församling de ligger"}},{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1833"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c9bd1bf1-e995-4330-b125-b5512a5d43ce","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3ea16900-d675-c915-5a69-85df872ac919"},{"@id":"urn:uuid:6120b11e-dc9e-8a20-0b9b-d0c8f45e5be6"},{"@id":"urn:uuid:816a60cd-672b-6a1d-6ceb-b9f88d461b58"},{"@id":"urn:uuid:c40d49f2-1752-2789-30e0-2405925e43e1"},{"@id":"urn:uuid:de922db5-fe3e-a236-a03e-763d140aad6c"},{"@id":"urn:uuid:e030b011-0f88-c361-a158-533e9bb338c2"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Malmer innehåller uppgifter om produktion vid gruvor och gruvområden med uppgifter om namn på gruvan eller gruvområdet, malmtyp, produktionsår, producerad mängd malm och metallhalter, producerad mängd gråberg och andra uppgifter. Malmer innehåller även uppgifter om rapporterade reserver och tillgångar vid svenska fyndigheter med information om typ av malm, mängd malm och metallhalt.\n\nAnrikningsverk innehåller uppgifter om mängd malm som processats vid anrikningsverket och mängd producerat mineralkoncentrat, allt med metallhalter. Mängden producerad anrikningssand har beräknats som mellanskillnaden mellan ingående malm och utgående mineralkoncentrat.\n\nStatistik om malm i Sverige är användbart för beslutsfattare inom kommuner, län och statsmakter, för gruv- och prospekteringsbolag och för allmänheten. Här kan man se var de senaste hundra årens gruvor och anrikningsverk har funnits och vad de har producerat. Information om möjliga framtida malmer finns också med."},"dct:identifier":"c9bd1bf1-e995-4330-b125-b5512a5d43ce","dct:issued":{"@type":"xsd:date","@value":"2021-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-09"},"dct:provenance":{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b1n0"},"dct:temporal":{"@id":"_:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81_b2n0"},"dct:title":{"@language":"sv","@value":"Malmer och anrikningsverk"}},{"@id":"urn:uuid:3ea16900-d675-c915-5a69-85df872ac919","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/ores-concentrators-description.pdf"},"dct:description":{"@language":"sv","@value":"Product description"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Product description"}},{"@id":"urn:uuid:6120b11e-dc9e-8a20-0b9b-d0c8f45e5be6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/malmer-anrikningsverk/malmer-anrikningsverk.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:816a60cd-672b-6a1d-6ceb-b9f88d461b58","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/malmer-anrikningsverk/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:c40d49f2-1752-2789-30e0-2405925e43e1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/malmer-anrikningsverk"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Services"}},{"@id":"urn:uuid:de922db5-fe3e-a236-a03e-763d140aad6c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-malm-mineral.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:e030b011-0f88-c361-a158-533e9bb338c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/malmer-anrikningsverk-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:44444fe35f754c503e4801e7faba01e1d57edea3f09362632d521583e70c8e81"},{"@graph":[{"@id":"_:44cf3257fb48cc845a1c97eb893b8c4547c621cf694fdd1f1d5ab915fba0b6da_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Projektet \"Inventering av flottningslämningar och kulturhistorisk bedömning av vandringshinder i Kronobergs län 2012\" startade 17/9 2012 och slutade 14/12 2012. Syftet var att inventera flottningslämningar i länet och plocka fram en metod som ska kunna användas i Södra Sverige för samma typ av inventering."}},{"@id":"_:44cf3257fb48cc845a1c97eb893b8c4547c621cf694fdd1f1d5ab915fba0b6da_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.27685 57.19068,15.36876 57.19068,15.36876 56.14996,13.27685 56.14996,13.27685 57.19068))"}},{"@id":"_:44cf3257fb48cc845a1c97eb893b8c4547c621cf694fdd1f1d5ab915fba0b6da_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:44cf3257fb48cc845a1c97eb893b8c4547c621cf694fdd1f1d5ab915fba0b6da_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/c1e5537a-baf5-4e76-a497-c63b04ef6c51","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:13e7f61e-0f9c-f5d3-e3e1-93c69ebbc9f0"},{"@id":"urn:uuid:d282e31d-2afa-29e5-7d0f-911940937573"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:descript