rchive-nemonordic-nsbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst, täckningsområde (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:e1caa626daa853b91ca4b44f5ad77e9e59da7c460e5e9f375d3b6a5a3389d0b3_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, täckningsområde"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/fed32700-8269-11eb-b179-d785eca52194","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/grid-archive-nemonordic-nsbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar det geografiska området som NEMO-nordic producerar data för.\n\nFör NEMO täcker området hela Östersjön och Sveriges västkust inklusive Nordsjön och Engelska kanalen.\nKoordinater för området ges av hörnen:\nSydvästra  \tlat: 48.5N \tlon: 4.1W\nNordvästra\tlat: 65.9N \tlon: 4.1W\nNordöstra \tlat: 65.9N \tlon: 30.2E\nSydöstra\tlat: 48.5N \tlon: 30.2E"},"dct:identifier":"fed32700-8269-11eb-b179-d785eca52194","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografisk prognosmodell, NEMO-Nordic-NSBS01 - Historiska analysdata: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:e1caa626daa853b91ca4b44f5ad77e9e59da7c460e5e9f375d3b6a5a3389d0b3"},{"@graph":[{"@id":"_:e1dde39b0e108050e446f70aae12baaeab61158624be276af5126db6865f6b05_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Vid ajourhållning hämtas underlagsmaterial från mer aktuella baser med högre detaljeringsgrad. Redaktionellt material används också. När data läggs in görs en kartografisk redigering."}},{"@id":"_:e1dde39b0e108050e446f70aae12baaeab61158624be276af5126db6865f6b05_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8dc153f5-a26f-40c7-b735-fbe4f1278815","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:05ea4010-bc2d-16cc-4a99-4085ba9550e4"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Produkten passar utmärkt som bakgrundskarta och som indata till GIS-tillämpningar. Den är lämplig att använda i skalområdena 1:100 000 - 1:500 000. Innehållet består bland annat av administrativa gränser, vägar och järnvägar, markklassning och höjdkurvor med 25 m ekvidistans."},"dct:identifier":"8dc153f5-a26f-40c7-b735-fbe4f1278815","dct:issued":{"@type":"xsd:date","@value":"2022-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:e1dde39b0e108050e446f70aae12baaeab61158624be276af5126db6865f6b05_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:e1dde39b0e108050e446f70aae12baaeab61158624be276af5126db6865f6b05_b1n0"},"dct:title":{"@language":"sv","@value":"Topografi 250 Nedladdning, vektor"}},{"@id":"urn:uuid:05ea4010-bc2d-16cc-4a99-4085ba9550e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-250-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Topografi 250 Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografi 250 Nedladdning, vektor"}}],"@id":"urn:source:e1dde39b0e108050e446f70aae12baaeab61158624be276af5126db6865f6b05"},{"@graph":[{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Grid 50+ från nationella höjdmodellen (nh) baseras på laserskanning. Grid 50+ från den gamla höjddatabanken (hdb) som är framställd genom profilmätning i flygbilder och digitalisering av höjdkurvor från Ekonomiska kartan. Punkterna är skapade i ett regelbundet rutnät enligt indexrutor i RT 90. Punkterna har sedan transformerats till SWEREF 99 TM . Versionen från nh är skapad i SWEREF 99 TM och RH 2000 från början. Versionen från hdb skapades i RH 70 men har sedan transformerats till RH 2000."}},{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1970"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d5c6638b-7289-40d8-ae99-927d8f2f1c4e","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:69ba37d5-a766-fa22-1520-32bff72e125d"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Markhöjdmodell Nedladdning, grid 50+ innehåller höjdvärden på marken i ett grid (rutnät) med 50 meters mellanrum. Observera att produkten senast uppdaterades 2004 och har hög lägesosäkerhet."},"dct:identifier":"d5c6638b-7289-40d8-ae99-927d8f2f1c4e","dct:issued":{"@type":"xsd:date","@value":"1993-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1993-01-01"},"dct:provenance":{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b1n0"},"dct:temporal":{"@id":"_:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561_b2n0"},"dct:title":{"@language":"sv","@value":"Markhöjdmodell Nedladdning, grid 50+"}},{"@id":"urn:uuid:69ba37d5-a766-fa22-1520-32bff72e125d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojdmodell-nedladdning-grid-50"},"dct:description":{"@language":"sv","@value":"Mer information om produkten finns att tillgå på Lantmäteriets webbplats."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets webbplats"}}],"@id":"urn:source:e2087317542655a6034c5b4c94519fc7fa8c615dc47235a72bc6422a4b361561"},{"@graph":[{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"2018-2020"}},{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2020"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2018"}},{"@id":"http://dataportal.se/organisation/SE2021000555","@type":"foaf:Agent","dct:identifier":"2021000555","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sherko.alemdar@socialstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Socialstyrelsen"},"foaf:page":{"@id":"https://www.socialstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ngs.ehalsomyndigheten.se/organisation/SE2021000555"}},{"@id":"https://www.geodata.se/resources/39d565ed-4a67-4ae7-932a-23ee81bcc6eb","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:794b8b7d-ba5a-716a-738d-900ca3bc8187"},{"@id":"urn:uuid:c80bcbbc-916e-56fe-f0d0-cbfc1ef1f4c3"},{"@id":"urn:uuid:f3f5b0ca-7b32-8f55-6cf7-8ec10c2a2c8f"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Människors hälsa och säkerhet"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/hh"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens statistikdatabas, antal döda i vissa miljörelaterade sjukdomar som \nJ44 KOL, \nJ45-J46 Astma \nJ60-J70 Lungsjukdomar av yttre orsaker \nunder åren 2020-2022 per 100 000 invånare"},"dct:identifier":"39d565ed-4a67-4ae7-932a-23ee81bcc6eb","dct:issued":{"@type":"xsd:date","@value":"2013-12-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-04-21"},"dct:provenance":{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:spatial":{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b1n0"},"dct:temporal":{"@id":"_:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf_b2n0"},"dct:title":{"@language":"sv","@value":"Dödsorsaker"}},{"@id":"urn:uuid:794b8b7d-ba5a-716a-738d-900ca3bc8187","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-dod-wms.map&service=wms&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Socialstyrelsen Geodata visningstjänst"},"dct:title":{"@language":"sv","@value":"Socialstyrelsen Geodata visningstjänst"}},{"@id":"urn:uuid:c80bcbbc-916e-56fe-f0d0-cbfc1ef1f4c3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-dod-wfs.map&service=wfs&request=GetCapabilities"},"dct:description":{"@language":"sv","@value":"Socialstyrelsen Geodata nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Socialstyrelsen Geodata nedladdningstjänst"}},{"@id":"urn:uuid:f3f5b0ca-7b32-8f55-6cf7-8ec10c2a2c8f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/kartvisning/index.html"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens karttjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Socialstyrelsens karttjänst"}}],"@id":"urn:source:e20ad22da60316016cc64f60e84dcbbdf1bb80789abc128df1803bc616277ddf"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/693c8f48-63c6-44ca-a5f4-838af293e51d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://api.lantmateriet.se/belagenhetsadress/atom/v1.2/inspire/ad"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst enligt EG-direktivet Inspire för temat adresser (Addresses).\nOmråde: Kommun\nDen tekniska lösningen på nedladdningsplatsen är ett så kallat Atomflöde."},"dct:identifier":"693c8f48-63c6-44ca-a5f4-838af293e51d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Belägenhetsadress Nedladdning, Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:e309e293d40adbec7c44beb0959a698002654b50e3b13fad34ec3d022b61e385"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8a976511-4043-4eed-8716-8bfa943f2ae0","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/alder"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Bergets ålder, isotopanalyser innehåller radiometriska åldersbestämningar av svensk berggrund, sammanlagt ca 2300 poster. Förutom provets ålder med felmarginal, finns information om provets läge, bergartstyp, daterat material, analysmetod samt hur åldern tolkas etc. Till varje post finns en litteraturhänvisning till källan för informationen. I källreferensen finns generellt detaljerad information om bakgrund, syfte, metoder, data, diskussion och slutsatser. Engelska används som språk i data."},"dct:identifier":"8a976511-4043-4eed-8716-8bfa943f2ae0","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Bergets ålder, isotopanalyser (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:e3166338c67269ac20adbeda6bd4937d890b67a5274062f3702dc97ebc54226e"},{"@graph":[{"@id":"_:e33965f27aede497fc2e337b5c7b807d03a5b6982ed80472e26b765a4f132129_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/41b115ee-6e26-5fdc-dfb0-52296feac50e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218"},"dcat:distribution":[{"@id":"urn:uuid:10f798b8-fa1a-ce4f-1add-834ec2fd82a5"},{"@id":"urn:uuid:613c4b79-843a-46c1-c5c6-c56746d29f5a"},{"@id":"urn:uuid:c97f37d8-6b15-5721-b690-d02e30155a67"},{"@id":"urn:uuid:f8961259-2ac4-0f73-4554-d9b4c3a1e4b6"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En havsplan ger vägledning om användning för de områden som omfattas av havsplanen. Sverige har tre havsplaner för Bottniska viken, Östersjön och Västerhavet. Detta är förslag till ändrade havsplaner som lämnas till regeringen 2025. Plankartan ska tolkas i den ungefärliga skalan mellan 1:700 000 och 1:1 000 000."},"dct:identifier":"41b115ee-6e26-5fdc-dfb0-52296feac50e","dct:issued":{"@type":"xsd:date","@value":"2025-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Förslag till ändrade havsplaner 2025"}},{"@id":"urn:uuid:10f798b8-fa1a-ce4f-1add-834ec2fd82a5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.793b6b871952474b835cb813/1741166454050/2025-01-20%20Konsekvensbeskrivning%20av%20f%C3%B6rslag%20till%20%C3%A4ndrade%20havsplaner%20r%C3%A4tt%20bokm%C3%A4rken-JJ.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Konsekvensbeskrivning av förslag till ändrade havsplaner"}},{"@id":"urn:uuid:613c4b79-843a-46c1-c5c6-c56746d29f5a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/forslag-till-andrade-havsplaner-2025/wms"},"dct:description":{"@language":"sv","@value":"Karttjänst för förslag till ändrade havsplaner 2025"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta: Förslag till ändrade havsplaner 2025"}},{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsplaneringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e33965f27aede497fc2e337b5c7b807d03a5b6982ed80472e26b765a4f132129_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsplaneringsenheten"},{"@id":"urn:uuid:c97f37d8-6b15-5721-b690-d02e30155a67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/forslag-till-andrade-havsplaner-2025/2025-01-21/forslag-till-andrade-havsplaner-2025-2025-01-21.zip"},"dct:description":{"@language":"sv","@value":"Nedladdningsbar zip för Förslag till ändrade havsplaner 2025"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta: Förslag till ändrade havsplaner 2025"}},{"@id":"urn:uuid:f8961259-2ac4-0f73-4554-d9b4c3a1e4b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.6ab16f9919457c0899599893/1737447246940/Bilaga_Planeringsf%C3%B6ruts%C3%A4ttningar%202025-01-20.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Bilaga planeringsförutsättningar"}}],"@id":"urn:source:e33965f27aede497fc2e337b5c7b807d03a5b6982ed80472e26b765a4f132129"},{"@graph":[{"@id":"_:e35c9634c0d17b8959cb2134d510e23852e0b5862912eec2b4c7fc5991e7a34c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:e35c9634c0d17b8959cb2134d510e23852e0b5862912eec2b4c7fc5991e7a34c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30000 65.87000,23.51000 65.87000,23.51000 54.80000,10.30000 54.80000,10.30000 65.87000))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/ecaa09a1-bf8f-4eb2-ab00-df8d1eff7a7f","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:86aba9eb-d317-2fc7-5db4-071092c54e0c"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Minsta djup (grundast) i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 20 m upplösning. Djupets faktiska position bibehålls. Djup genereras endast i rutor med minst ett mätt värde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"ecaa09a1-bf8f-4eb2-ab00-df8d1eff7a7f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-02"},"dct:provenance":{"@id":"_:e35c9634c0d17b8959cb2134d510e23852e0b5862912eec2b4c7fc5991e7a34c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:e35c9634c0d17b8959cb2134d510e23852e0b5862912eec2b4c7fc5991e7a34c_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 20 m upplösning - minsta djup"}},{"@id":"urn:uuid:86aba9eb-d317-2fc7-5db4-071092c54e0c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:e35c9634c0d17b8959cb2134d510e23852e0b5862912eec2b4c7fc5991e7a34c"},{"@graph":[{"@id":"_:e3ab546c3fce8df7ed26919a1c1272684f5e7ab7078c7a1a59a7a73757f3f940_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kulturhistoriskt värdefulla byggnader, miljöer och anläggningar kan skyddas som byggnadsminnen. Byggnadsminnena har stor spännvidd i tid och rum från medeltida borgar till modern bebyggelse från 1900-talet.\n\nSyftet med byggnadsminnen är att bevara spår av historien som har stor betydelse för förståelsen av dagens och morgondagens samhälle och att garantera människors rätt till en viktig del av kulturarvet. För att reglera hur det kulturhistoriska värdet ska tas tillvara fastställs skyddsbestämmelser för varje byggnadsminne.\n\nDet finns två typer av byggnadsminnen – byggnadsminnen enligt kulturmiljölagen (enskilda) och statliga byggnadsminnen."}},{"@id":"_:e3ab546c3fce8df7ed26919a1c1272684f5e7ab7078c7a1a59a7a73757f3f940_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/b338e893-1a47-4ba3-8b27-ed610fe6eb39","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:8fdbf738-d341-9914-92e4-19b398c1892c"},{"@id":"urn:uuid:9f26e304-b995-ed86-7e1f-0adec4908153"},{"@id":"urn:uuid:b6f20199-7365-5028-8a12-401e51db0f4a"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Utbredningsområde för enskilda och statliga byggnadsminnen och kyrkliga kulturminnen som är registrerade i Bebyggelseregistret. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"b338e893-1a47-4ba3-8b27-ed610fe6eb39","dct:issued":{"@type":"xsd:date","@value":"2020-01-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-15"},"dct:provenance":{"@id":"_:e3ab546c3fce8df7ed26919a1c1272684f5e7ab7078c7a1a59a7a73757f3f940_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:e3ab546c3fce8df7ed26919a1c1272684f5e7ab7078c7a1a59a7a73757f3f940_b1n0"},"dct:title":{"@language":"sv","@value":"INSPIRE Skyddade områden - byggnadsminnen och kyrkliga kulturminnen"}},{"@id":"urn:uuid:8fdbf738-d341-9914-92e4-19b398c1892c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/PS.Buildings-topfeed.xml"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen Nedladdningstjänst ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen Nedladdningstjänst ATOM"}},{"@id":"urn:uuid:9f26e304-b995-ed86-7e1f-0adec4908153","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/geoserver/Kulturarv/ows?request=getcapabilities&service=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen Visningstjänst"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen Visningstjänst"}},{"@id":"urn:uuid:b6f20199-7365-5028-8a12-401e51db0f4a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/files/gml/PS.monuments.gml"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen direkt nedladdning GML"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen direkt nedladdning GML"}}],"@id":"urn:source:e3ab546c3fce8df7ed26919a1c1272684f5e7ab7078c7a1a59a7a73757f3f940"},{"@graph":[{"@id":"_:e3ba79e4fdc5130b78faac5da28f8f3c7f014883f5ec9329d8cd410cee91a8c1_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.12267 65.30446,21.40797 65.30446,21.40797 56.07421,11.12267 56.07421,11.12267 65.30446))"}},{"@id":"_:e3ba79e4fdc5130b78faac5da28f8f3c7f014883f5ec9329d8cd410cee91a8c1_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/cb4f188b-b483-42c9-9d6d-f4d361a7c5ea","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:90a2ba49-339f-1284-d45f-5b22e2b56550"},{"@id":"urn:uuid:e017200a-d1ed-4035-4616-ec654d290f69"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Kalkningsobjekt är sjöar, vattendrag, våtmarker och kalkdoserare som används vid kalkning eller påverkas av den kalkning som utförs uppströms objektet. Kartskiktet hämtar uppgifter från Nationella kalkdatabasen. Varje län ansvarar för att de objekt som finns med i kalkdatabasen är aktuella."},"dct:identifier":"cb4f188b-b483-42c9-9d6d-f4d361a7c5ea","dct:issued":{"@type":"xsd:date","@value":"2019-08-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-06-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:e3ba79e4fdc5130b78faac5da28f8f3c7f014883f5ec9329d8cd410cee91a8c1_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - kalkningsobjekt"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e3ba79e4fdc5130b78faac5da28f8f3c7f014883f5ec9329d8cd410cee91a8c1_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:90a2ba49-339f-1284-d45f-5b22e2b56550","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:e017200a-d1ed-4035-4616-ec654d290f69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_kalkningsobjekt.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:e3ba79e4fdc5130b78faac5da28f8f3c7f014883f5ec9329d8cd410cee91a8c1"},{"@graph":[{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b1n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"S-HYPE2016 är en hydrologisk modell som beskriver vattenföringens och andra hydrologiska parametrars utveckling i tid och rum. Den realtidsuppdaterade analysen drivs med nederbörd och temperatur från PTHBV-databasen fram till sista dagen två månader tillbaka. Därefter används realtids-PTHBV, vilket är ett griddat och interpolerat nederbörds- och temperaturfält med realtidsrapporterande nederbörds- och temperaturstationer som grund.  I båda fallen får varje modelldelområde en viktad nederbörd och temperatur baserat på de gridrutor som finns inom modelldelområdet. För prognosperioden används SMHIs PMP-prognos där varje modelldelområde får nederbörd och temperatur från den gridpunkt som är närmast modelldelområdets centerkoordinat. Modellen körs ungefär en gång per dag på förmiddagen. Uppdateringar och justeringar av modellerna kan göras med kort varsel."}},{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.50 68.90,25.40 68.90,25.40 55.30,11.50 55.30,11.50 68.90))"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dcat:downloadURL":{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b0n0"},"dct:title":{"@language":"sv","@value":"CF-Conventions"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/f5f79681-8beb-4367-aa6a-4bfea852f6d3","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:c985f683-1d15-44cf-3bfa-8f26c7e7cc98"},{"@id":"urn:uuid:f9ed3ef5-0ac9-db29-a15b-849f7bddf900"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nProdukten innehåller två datamängder från den hydrologiska modellen S-HYPE:\n\n- Prognos: Data för 10 dygn framåt, gällande perioden 00-00.\nFör drivning av modellen fram till igår har nederbörd och temperatur från SMHIs PTHBV-databas använts.\nFör drivning av modellens prognosdygn har nederbörd och temperatur från SMHIs meteorologiska prognosmodell PMP använts.\nParametrar som ingår i filen för 6 st delområden är:\n  - wcom: Modellberäknat vattenstånd i utloppssjö (m).\n\n- Analys och observation: Analysdata för de senaste 30 dagarna gällande perioden 00-00. Datamängden innehåller också observationsdata för de 6 stora Svenska sjöarna från SMHIs hydrologiska observationsdatabas.\nFör drivning av modellen har nederbörd och temperatur från SMHIs PTHBV-databas använts.\nParametrar som ingår för 6 st delområden är: \n  - wcom: Modellberäknat vattenstånd i utloppssjö (m). Värdet avser vattenståndet i slutet av tidssteget. \n  - wstr: Observerat vattenstånd i utloppssjö (m). Värdet är sista tillgängliga observerade vattenståndet inom tidsperioden.\nDelområdena som ingår är:\n  14341 - Storsjön\n  10132 - Siljan\n  6329 - Hjälmaren\n  6391 - Mälaren\n  4283 - Vättern\n  5021 - Vänern\n\nS-HYPE är en hydrologisk modell som beskriver vattenföringens och andra hydrologiska parametrars utveckling i tid och rum.\n\nHYPE är en hydrologisk modell för integrerad simulering av flöden samt omsättning av vatten och näringsämnen. Den ger möjlighet att beräkna faktorer knutna till vattenresurser och vattenkvalitet, men också annan hydrologisk information med hög geografisk detaljeringsgrad. \n\nS-HYPE2016 är en uppsättning av HYPE-modellen för Sverige med en delområdesindelning som bygger på SVAR.\n\nMer information om S-HYPE och hypemodellen finns på SMHI Vattenwebb; https://www.smhi.se/data/sjoar-och-vattendrag/vattenwebb.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nGEOGRAFISK INFORMATION\nGeografisk identitet som används är subid, vilket är det interna delområdesnamnet för S-HYPE. Kopplingstabell (csv) och kartfil (shape) för kopplingen mellan subid och delområde, nås via nedladdningstjänsten. Där finns även en readme-fil som beskriver hur filerna ska användas.\n\nANVÄNDNING\nPå SMHI används S-HYPE som underlag för hydrologiska prognoser för den hydrologiska varningstjänsten. Modellen används också för att simulera vattenföring och vattenkvalitet åt den Svenska vattenförvaltningen, samt som hydrologisk modell för klimatscenarier och inom fler forskningsprojekt.\n\nFORMAT\nData levereras i NetCDF4-format som delvis följer CF conventions CF-1.6 för punktdata. Beskrivning av konventionen finns på \nhttps://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dct:identifier":"f5f79681-8beb-4367-aa6a-4bfea852f6d3","dct:issued":{"@type":"xsd:date","@value":"2014-01-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-07"},"dct:provenance":{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b1n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":{"@id":"_:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8_b2n0"},"dct:title":{"@language":"sv","@value":"Hydrologisk modell, S-HYPE - Vattenstånd: Prognos, analys och observationer för de stora sjöarna"}},{"@id":"urn:uuid:c985f683-1d15-44cf-3bfa-8f26c7e7cc98","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"CF-Conventions"}},{"@id":"urn:uuid:f9ed3ef5-0ac9-db29-a15b-849f7bddf900","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/hydrology/s-hype/"},"dct:description":{"@language":"sv","@value":"Filerna s-hype2022_analysis_biglakes_[date].nc för analys och s-hype2022_forecast_biglakes_[date].nc för prognos."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"S-HYPE - Vattenstånd: Prognos, analys och observationer för de stora sjöarna"}}],"@id":"urn:source:e3d84c483c2e78251d45c8606c99a643c3c08eaadf174a22225bf5d2d6c0dad8"},{"@graph":[{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Åtgärdsprogram för hotade arter och naturtyper. Åtgärdsprogram för rikkärr."}},{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((18.10477 57.89369,19.01082 57.89369,19.01082 57.16444,18.10477 57.16444,18.10477 57.89369))"}},{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/e9ab3136-f644-46dd-a249-033fe687df5f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4"},"dcat:distribution":[{"@id":"urn:uuid:5428f950-ebcd-0201-683b-c5be8e1033b8"},{"@id":"urn:uuid:d8e590c8-9309-6a94-8be8-fa58a827e3b3"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Källor dokumenterade vid rikkärrsinventering 2022-2023, med kommentar och strukturnamn."},"dct:identifier":"e9ab3136-f644-46dd-a249-033fe687df5f","dct:issued":{"@type":"xsd:date","@value":"2024-06-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-14"},"dct:provenance":{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Inv Rikkärrskälla"}},{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Naturvårdsenheten"},{"@id":"urn:uuid:5428f950-ebcd-0201-683b-c5be8e1033b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTI/LstI_rikkarr_ext/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:d8e590c8-9309-6a94-8be8-fa58a827e3b3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.LstI_inv_rikkarrskalla_INT.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:e4140f42adec0bd49e54dd4cfb78260052703614255d8aa532e02304c80ce98d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7abb4a4d-fd47-472f-9e7a-89f6a9b375dc","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_25-100k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden GE.Jordarter 1:25 000-1:100 000 visas i denna OGC WMS-tjänst. Lager som ingår är geologiska enheters litologi och ålder. I denna tjänst visas attribut enligt GeoSciML Lite 4.1 och med symbolisering enligt INSPIRE dataspecifikation för geologi."},"dct:identifier":"7abb4a4d-fd47-472f-9e7a-89f6a9b375dc","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:25 000 - 1:100 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:e44706838bb3916c82625a300d1d7a372c8e337e17f91657192e074469664cce"},{"@graph":[{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.9745 69.0599,24.1776 69.0599,24.1776 59.8547,11.9745 59.8547,11.9745 69.0599))"}},{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.97458 69.05997,24.17767 69.05997,24.17767 61.51153,11.97458 61.51153,11.97458 69.05997))"}},{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/103cf137-9d56-452b-97d6-9b12cba6c864","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:6474bd1a-7a8e-18d9-78ec-03379fd809de"},{"@id":"urn:uuid:c9790019-208c-d6bd-2811-a12b28dc3ad2"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Skiktet är en ytbildning och sammanslagning av objekt av riksintresse från följande skikt:\"Led\" (buffrat till 600m bredd), \"pass\", \"rast\" och \"omr_riks\". Detta skikt redovisar myndighetens syn på vilka markområden som bör betraktas som varande av riksintresse och har därför avgörande betydelse för att förstå och tolka miljöbalken i enlighet med dess 3Kap 5§.\n\nGränserna för riksintresseområden är inte absoluta, utan indikerar att värden eller egenskaper av högt allmänt intresse enligt Hushållningsbestämmelserna i 3 eller 4 kap. miljöbalken finns att ta hänsyn till."},"dct:identifier":"103cf137-9d56-452b-97d6-9b12cba6c864","dct:issued":{"@type":"xsd:date","@value":"2015-02-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b0n0"},{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b1n0"}],"dct:title":{"@language":"sv","@value":"ST Riksintresse Rennäringen"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:6474bd1a-7a8e-18d9-78ec-03379fd809de","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_ren.riks_ren.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c9790019-208c-d6bd-2811-a12b28dc3ad2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/ST/ST_Riksintresse_Rennaring_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS Riksintresse rennäring"}}],"@id":"urn:source:e4486adec429e74f29ff400730a848ad9f8714be28cd9fc8beb879917871e7de"},{"@graph":[{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bedömningsområden har tagits fram på olika nivåer; kustvattentyper, utsjövatten, bassänger, grupper av bassänger och förvaltningsområde för att kunna rapportera olika delar på olika geografisk skala. Grunden för indelningen är de 12 bassängerna (tre i delregion Nordsjön och 9 i region Östersjön). Indelningen i havsbassänger bygger på den indelning som gjorts i Svenskt havsområdesregister som är en del av Svenskt Vattenarkiv (SVAR). Dessa bassänger är vid behov indelade i kustvatten respektive utsjövatten. Utsjövattnen följer alltid indelningen i bassänger och definieras av kustvattnets avgränsningslinjer och den yttre avgränsningslinjen för svensk ekonomisk zon och följer indelning i havsbassänger. Kustvattnen är indelade i kustvattentyper och följer indelningen av kustvatten enligt Havs- och vattenmyndighetens föreskrifter om kartläggning och analys av ytvatten HVMFS 2017:20 enligt förordningen 2004:660 \nom förvaltningen av kvaliteten på vattenmiljön. I vissa fall används grupper av bassänger som bedömningsområde. Bassänggrupper har definierats som flera bassänger inom ett större havsområde. Inom svenskt havsområde finns tre bassänggrupper, en i Nordsjön och två i Östersjön. Alla dessa bedömningsområden, utom grupper av bassänger, finns på kartor i bilaga 1 i Havs- och vattenmyndighetens föreskrifter om vad som kännetecknar god miljöstatus samt miljökvalitetsnormer med indikatorer för Nordsjön och Östersjön"}},{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.00 66.18,24.29 66.18,24.29 54.61,7.00 54.61,7.00 66.18))"}},{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/2cbd8021-5121-3ffc-c49e-29666fac792c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e"},"dcat:distribution":[{"@id":"urn:uuid:1cd7c5cd-e8c1-5211-8248-c445c199e6dc"},{"@id":"urn:uuid:2eb76f64-4793-c799-5026-cc0eea68c81d"},{"@id":"urn:uuid:43bd12e2-42ca-0b11-e92d-ac87cbe1daa9"},{"@id":"urn:uuid:4989a1a1-8bbf-4d04-0fc4-aaf50482a82d"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Havsområden"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/sr"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen (2010:1341), uppdaterad 2018"},"dct:identifier":"2cbd8021-5121-3ffc-c49e-29666fac792c","dct:issued":{"@type":"xsd:date","@value":"2018-11-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-26"},"dct:provenance":{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b1n0"},"dct:title":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen - Förvaltningsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1cd7c5cd-e8c1-5211-8248-c445c199e6dc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsmiljoforordningen-forvaltningsomraden/2018-11-27/havsmiljoforordningen-forvaltningsomraden-2018-11-27.zip"},"dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen 2018 - Förvaltningsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Förvaltningsområden Nedladdning"}},{"@id":"urn:uuid:2eb76f64-4793-c799-5026-cc0eea68c81d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsmiljoforordningen-forvaltningsomraden/atom-havsmiljoforordningen-forvaltningsomraden-datafeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Havsområdesindelning enligt havsmiljöförordningen -Bedömningsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Förvaltningsområden.ATOM"}},{"@id":"urn:uuid:43bd12e2-42ca-0b11-e92d-ac87cbe1daa9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-forvaltningsomraden/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visninsgtjänst (WMS) för datamängden Havsmiljöområdesindelning enligt havsmiljöförordningen Förvaltningsområden"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Förvaltningsområden.WMS"}},{"@id":"urn:uuid:4989a1a1-8bbf-4d04-0fc4-aaf50482a82d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-forvaltningsomraden/wms"},"dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen 2018 - Föevaltningsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Förvaltningsområden Karttjänst"}},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsmiljöenheten"}],"@id":"urn:source:e47aaa473d07a09178a824b5d51b86c16c45ae9d3c745fc35b6cb4a0de31d88b"},{"@graph":[{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kartan är ett resultat av Mittnordenprojektet, ett gemensamt nordiskt projekt (1989-1996) med deltagande av de geologiska undersökningarna i Finland, Norge och Sverige och med stöd från Nordiska Ministerrådet. \n\nUrsprunglig kodning och struktur har anpassats till den kodning som används i SGUs övriga produkter.\n\nKartan bygger på sammanställning och bearbetning av jordartskartor och arbetsmaterial i olika skalor, samt på kompletterande fältkartering och flygbildstolkning.\n\nLägesnoggrannheten bedöms motsvara ett medelfel på ca 1 km. Kartan är starkt generaliserad för god läsbarhet i skalområdet 1:750 000 - 1:1 miljon. Vissa jordartstyper, t ex isälvssediment, är överdrivet återgivna för att de ska framträda tydligt. Minsta redovisade yta är knappt 1km2."}},{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.03 66.00,24.18 66.00,24.18 62.74,12.03 62.74,12.03 66.00))"}},{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1996"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1984"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8cf845ce-fa8e-4b7f-b38b-14b0e5dc9724","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1b1d04f4-a938-d1d3-01d2-a36a28d165c8"},{"@id":"urn:uuid:1effc08b-095d-bf22-54d9-07629559ab88"},{"@id":"urn:uuid:3474c7b7-514a-0a55-0f96-a1d170e7c02e"},{"@id":"urn:uuid:a27c1250-95e6-2775-4098-5468c8a0f7db"},{"@id":"urn:uuid:de09a03a-967f-e722-e42c-88a347eadecf"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kartan återger huvuddragen i regionens jordartsgeologi. Kartan är avsedd för presentation i skalområdet 1:750 000 – 1:1 miljon. Kartbilden är mycket generaliserad och jordartsindelningen förenklad. Minsta redovisade yta är knappt 1 km2.\n\nInformationen är endast avsedd att användas för översikter på storregional nivå, och bör utnyttjas med försiktighet i analyssammanhang."},"dct:identifier":"8cf845ce-fa8e-4b7f-b38b-14b0e5dc9724","dct:issued":{"@type":"xsd:date","@value":"2001-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2001-01-01"},"dct:provenance":{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b1n0"},"dct:temporal":{"@id":"_:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48_b2n0"},"dct:title":{"@language":"sv","@value":"Jordarter 1:750 000, Mittnorden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1b1d04f4-a938-d1d3-01d2-a36a28d165c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordarter750k/jordarter750k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:1effc08b-095d-bf22-54d9-07629559ab88","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordarter750k/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:3474c7b7-514a-0a55-0f96-a1d170e7c02e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-jordarter-mittnorden-750-tusen.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:a27c1250-95e6-2775-4098-5468c8a0f7db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordarter-750000-mittnorden-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:de09a03a-967f-e722-e42c-88a347eadecf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-mittnorden-750-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}}],"@id":"urn:source:e4ebed8c2c65ceb813378d5b9005c4d262aef4e817c704bb37e2a23a8619ef48"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/765fabca-75af-4e64-ab35-6d9837d7e455","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetspris?view=oversikt"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Genom att abonnera på Fastighetsprisavisering aviseras de lagfartsförändringar som skett i landet för vidare hantering i ditt datorsystem. Informationen kan bl.a. kopplas till karta och användas vid fastighetsvärderingar eller marknadsanalyser. Abonnemanget kan anpassas efter ditt behov vad gäller geografiskt område och typ av information."},"dct:identifier":"765fabca-75af-4e64-ab35-6d9837d7e455","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@langua