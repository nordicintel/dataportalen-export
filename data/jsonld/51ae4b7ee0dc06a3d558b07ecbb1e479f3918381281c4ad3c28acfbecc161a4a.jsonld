slu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18"}},{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":[{"@language":"en","@value":"Swedish University of Agricultural Sciences"},{"@language":"sv","@value":"Sveriges lantbruksuniversitet"}]},{"@id":"https://www.geodata.se/resources/1c640871-3831-4de9-9bd2-5071b1f9dbb5","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:500e02c1-1d0d-8028-ad10-54039073193d"},{"@id":"urn:uuid:b28b66bc-6815-edbe-ace7-f58967ab6989"}],"dcat:distribution":{"@id":"urn:uuid:f7630295-a326-95ca-4990-5d8392662b94"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Datamängden består av punkter som var och en utgör centrum för en 10 x 10 km ruta i ett rutnät som täcker Sverige. För varje ruta är antalet observationer per art beräknad och presenteras som data kopplad till mittpunkten."},"dct:identifier":"1c640871-3831-4de9-9bd2-5071b1f9dbb5","dct:issued":{"@type":"xsd:date","@value":"2015-11-16"},"dct:modified":{"@type":"xsd:date","@value":"2015-11-16"},"dct:provenance":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002817"},"dct:spatial":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b1n0"},"dct:title":{"@language":"sv","@value":"OccurrencesCountPer10KmGridCellAndTaxa"}},{"@id":"urn:uuid:500e02c1-1d0d-8028-ad10-54039073193d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Maria Barret-Ripa","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:Maria.Ripa@slu.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Sveriges lantbruksuniversitet"},{"@id":"urn:uuid:b28b66bc-6815-edbe-ace7-f58967ab6989","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Ulf Gärdenfors","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:Ulf.Gardenfors@slu.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122_b5n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Sveriges lantbruksuniversitet"},{"@id":"urn:uuid:f7630295-a326-95ca-4990-5d8392662b94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://slwgeo.artdata.slu.se:8080/geoserver/SLW"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Svenska Lifewatch"}}],"@id":"urn:source:c15cde5cac5b48b4c07fd4f97a951897407b68fe70922ca424406f5d1ac1c122"},{"@graph":[{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Genom inventering ute i fält."}},{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/88a62fc9-84fd-4859-ab22-c4ad671f0644","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:4e029e45-71f8-9ba6-4fab-d320bf182812"},{"@id":"urn:uuid:7a676159-0484-14a0-a1e3-59d3095816ec"},{"@id":"urn:uuid:7d7952eb-a6a1-9ef5-def8-bce4b28ae2bf"},{"@id":"urn:uuid:cc691d24-407a-9c11-c1dd-f28759a1ab0f"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"I kartskiktet Ängs- och betesmarksinventeringen naturtyper är bara de fullständigt inventerade markerna med. I detta skikt är de inventerade markerna nedbrutna så att varje naturtyp, enligt Natura 2000 definitioner, har en egen yta.\nSveriges ängs- och betesmarker har inventerats. Det innebär att 300 000 hektar mark undersöktes under åren 2002 till 2004. Detta för att se var markerna finns och vilka speciella naturvärden och kulturlämningar som finns där, till exempel speciella växter eller gamla byggnader.\nInventeringen visade att det finns 270 000 hektar värdefulla marker i Sverige. 7 000 hektar av dem är ängar och 229 000 är betesmarker. Resten behöver restaureras för att kvaliteten på dem ska bevaras.\nFortsatt inventering sker inom landsbygdsprogrammet (2007-2013). \nInventeringen används för att kunna göra utvärderingar och uppföljningar av miljöersättningar och andra åtgärder för naturmiljö och kulturmiljö. Uppgifterna kan användas som underlag vid rådgivning, samhällsplanering och forskning.\nResultatet av inventeringen finns i databasen TUVA. Den är även tillgänglig på Jordbruksverkets webbplats. Från inventeringen finns två kartskikt. Det ena innehåller alla marker som besökts vid inventeringen (ängs- och betesmarksobjekt). Det andra skiktet (naturtypsytor) innehåller de marker som inventerats fullständigt. I detta skikt är de inventerade markerna nedbrutna så att varje naturtyp har en egen yta, enligt Natura 2000 definitionen."},"dct:identifier":"88a62fc9-84fd-4859-ab22-c4ad671f0644","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b1n0"},"dct:title":{"@language":"sv","@value":"Ängs- och betesmarksinventeringen naturtyper"}},{"@id":"urn:uuid:4e029e45-71f8-9ba6-4fab-d320bf182812","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&layers=HB.Angs-och_betesmarksinventeringen_naturtyper"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"},{"@id":"urn:uuid:7a676159-0484-14a0-a1e3-59d3095816ec","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/naturtyper/20240417/naturtyper.zip"},"dct:description":{"@language":"sv","@value":"Rikstäckande GML-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}},{"@id":"urn:uuid:7d7952eb-a6a1-9ef5-def8-bce4b28ae2bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/naturtyper/atom-datasetfeed-naturtyper.xml"},"dct:description":{"@language":"sv","@value":"Atom dataset feed för datamängden Naturtyper"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom dataset feed för datamängden Naturtyper"}},{"@id":"urn:uuid:cc691d24-407a-9c11-c1dd-f28759a1ab0f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layers=HB.Angs-och_betesmarksinventeringen_naturtyper"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"}}],"@id":"urn:source:c15fcab836e38752696100819f7a09cca1254283dcf8cf671143464f4eee7fa0"},{"@graph":[{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen baseras på SGUs produkt Jordarter 1:750 000, Mittnorden, och har transformerats för att överensstämma med Inspire dataspecifikation för tema Geologi, genom kodning enligt GeoSciML 4.1. \n\nKartan är ett resultat av Mittnordenprojektet, ett gemensamt nordiskt projekt (1989-1996) med deltagande av de geologiska undersökningarna i Finland, Norge och Sverige och med stöd från Nordiska Ministerrådet.\n\nKartan bygger på sammanställning och bearbetning av jordartskartor och arbetsmaterial i olika skalor, samt på kompletterande fältkartering och flygbildstolkning."}},{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.092108735503 65.874397720529,24.266589798047 65.874397720529,24.266589798047 62.742752161861,12.092108735503 62.742752161861,12.092108735503 65.874397720529))"}},{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1996"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1984"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/67352340-436d-4a9e-b430-345cd68bc5f9","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:51330753-98d0-d825-b6a8-67abcea973d8"},{"@id":"urn:uuid:6c6dc467-bb12-0e8c-dd31-a18e53eb0c2f"},{"@id":"urn:uuid:d5c357aa-9dd9-84f2-7a00-c249b085920d"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"GE.Jordarter 1:750 000, Mittnorden är en transformerad version av SGUs produkt Jordarter 1:750 000, Mittnordeni syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nProdukten återger huvuddragen i regionens jordartsgeologi. Kartan är avsedd för presentation i skalområdet 1:750 000 – 1:1 miljon. Kartbilden är mycket generaliserad och jordartsindelningen förenklad. Minsta redovisade yta är knappt 1 km2. Informationen är endast avsedd att användas för översikter på storregional nivå, och bör utnyttjas med försiktighet i analyssammanhang."},"dct:identifier":"67352340-436d-4a9e-b430-345cd68bc5f9","dct:issued":{"@type":"xsd:date","@value":"2018-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-01-21"},"dct:provenance":{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b1n0"},"dct:temporal":{"@id":"_:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:750 000, Mittnorden"}},{"@id":"urn:uuid:51330753-98d0-d825-b6a8-67abcea973d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_750k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}},{"@id":"urn:uuid:6c6dc467-bb12-0e8c-dd31-a18e53eb0c2f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Surficial_750K.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:d5c357aa-9dd9-84f2-7a00-c249b085920d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_750k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"GE.Jordarter 1:750 000, Mittnorden,Geologic Units"},"dct:title":{"@language":"sv","@value":"GE.Surficial_750k,GE.GeologicUnit"}}],"@id":"urn:source:c1d34676f200420b110e439bf55ab46c3a57cfdf529f6e064ed71f259ec24ae8"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/21d1ac4c-26bf-4dee-99e6-b87aa8652005","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/tyngdkraft-visning-api"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datasetet inkluderar detaljmätta tyngdkraftspunkter i Sverige. Totalt finns fler än 20 000 punkter. Tyngdkraft är i nuläget angivet i RG82, men kommer att anges i RG2000 när detta färdigställts. Tjänsten uppfyller kraven för Inspire."},"dct:identifier":"21d1ac4c-26bf-4dee-99e6-b87aa8652005","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Tyngdkraft Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c1de6cc26a8f413bb0846dc5f073c9a147b65b10a1e82a01f5b2cb023116e6ad"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8eab457a-a0e9-42cb-973e-883816a4bac9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Tätorter är koncentrerad bebyggelse med minst 200 invånare. SCB tar fram gränser för tätorter med hjälp av registerdata, till exempel SCB:s register över totalbefolkningen (RTB), SCB:s företagsregister samt Lantmäteriets fastighetskarta och koordinatsatta byggnadsregister. Öppna geodata visas som polygoner och fram till 2015 har tätorter uppdaterats vart femte år. Sedan 2016 uppdateras de vart tredje eller vart annat år."},"dct:identifier":"8eab457a-a0e9-42cb-973e-883816a4bac9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Tätorter WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c29fdfddd53d5aa233b7fff0023e9a5c0d9b3c0b2e654f6f64c14bd1a03a4648"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/525b9719-1639-4f4a-99f3-9e5d39e813d7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://share.scb.se/OV0105/Xml/PD/pd_befolkningsfordelning_5arsklasser_atom_nt.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik redovisas för Rutor (1x1 km). Statistiken avser 2024-12-31."},"dct:identifier":"525b9719-1639-4f4a-99f3-9e5d39e813d7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"PD.Befolkningsfördelning.5årsklasser.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c2aabc02cb79e1b7cef3d800eea08ff62d9042cc032afd86205981766205d568"},{"@graph":[{"@id":"_:c2c0e4e07bc1b55196d536bd8d2c91bbe72e25b418cd7fd88896b002c2f3036e_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.0774 58.1872,15.6657 58.1872,15.6657 56.8789,13.0774 56.8789,13.0774 58.1872))"}},{"@id":"_:c2c0e4e07bc1b55196d536bd8d2c91bbe72e25b418cd7fd88896b002c2f3036e_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/251f9f84-e8b4-4e76-af39-1ccb19445a8f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":{"@id":"urn:uuid:00884019-d600-69e2-efcb-cc18667e6d79"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Skyddsvärda träd i Jönköpings län - alla inventerade. En ihopslagning av databaserna \"Skyddsvärda träd i Jönköpings län inventerade från och med 2009\" och \"Skyddsvärda träd i Jönköpings län inventerade till och med 2008\". Med skyddsvärda träd avses: \nJätteträd: > 1 m i diameter\nÖvrigt grova träd: > 80 cm i diameter\nHålträd: >40 cm i diameter\nDöda träd: >40 cm i diameter\nHamlade träd: alla\nAlléträd: minst 5 träd i dubbel eller enkel rad, majoriteten av träden > 20 cm i diameter\nMycket gamla träd: ek, bok, gran, tall > 200 år, övriga > 140 år"},"dct:identifier":"251f9f84-e8b4-4e76-af39-1ccb19445a8f","dct:issued":{"@type":"xsd:date","@value":"2004-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:c2c0e4e07bc1b55196d536bd8d2c91bbe72e25b418cd7fd88896b002c2f3036e_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Inventerade skyddsvärda träd i Jönköpings län"}},{"@id":"urn:uuid:00884019-d600-69e2-efcb-cc18667e6d79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.miljoovervakning_skyddstrad_flan_alla.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Landenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c2c0e4e07bc1b55196d536bd8d2c91bbe72e25b418cd7fd88896b002c2f3036e_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Landenheten"}],"@id":"urn:source:c2c0e4e07bc1b55196d536bd8d2c91bbe72e25b418cd7fd88896b002c2f3036e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/cefe2a33-eee3-4227-a591-e9ae3a99d10b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://share.scb.se/OV0105/Xml/US/us_administrativaochsocialaoffentligatjanster_myndighetsochkommunkontor_atom_nt.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Myndighets- och kommunkontorens geografiska punkt tas fram med hjälp av det Allmänna företagsregistret samt Geografidatabasen. De juridiska formerna som används är 81 (Statliga enheter), 82 (Kommuner), 83 (Kommunalförbund), 84 (Regioner), 85 (Allmänna försäkringskassor) och 89 (Regionala statliga myndigheter). Geografisk information är belägenhetsadress på arbetsställe.\n\nGeokodade myndighets- och kommunkontor uppdateras en gång om året och källan är frysning av årsstatistik som är baserad på SAMU ramar (avser november). Årsregistret skapas i december."},"dct:identifier":"cefe2a33-eee3-4227-a591-e9ae3a99d10b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"US.AdministrativaOchSocialaOffentligaTjänster.MyndighetsOchKommunkontor. Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c3034213247d6132a016948710824bc2f07af882381836cc734eb47c6e8c792d"},{"@graph":[{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Dropvideopunker på 1m2 som visar högre marina gruppers täckningsgrad på denna yta. \nKonsoliderad data från 2015-2021."}},{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.95232 58.59666,19.44639 58.59666,19.44639 56.82802,17.95232 56.82802,17.95232 58.59666))"}},{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/0cb3ff4f-47b9-4ca2-99ab-5fd6e70ac0c8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5"},"dcat:distribution":{"@id":"urn:uuid:8d031dc2-368d-2255-6f09-a7e4e138056b"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Lst I dropvideoinventeringar mellan 2017-2021. Visar högre grupper som brunalger, rödalger, kärlväxter. Varje grupps täckningsgrad vid en specifik punkt längs transekten som filmades med dropvideo. Resultatet utgör arter på en ytan på 1m2."},"dct:identifier":"0cb3ff4f-47b9-4ca2-99ab-5fd6e70ac0c8","dct:issued":{"@type":"xsd:date","@value":"2015-09-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-09-30"},"dct:provenance":{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Hav Högre grupper täckningsgrad"}},{"@id":"urn:uuid:8d031dc2-368d-2255-6f09-a7e4e138056b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.Hav_TG_GIS_Grupper.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Miljö- och vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Miljö- och vattenenheten"}],"@id":"urn:source:c3638efec5c16f4aee69cd32567c105f732b33e74b43c3194159d37e60f5d44e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e5334846-d2f9-4f1c-99a8-28da6e4a9177","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/markgeofysik"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"This service contains information about survey areas explored for prospecting purposes with different types of geophysical instruments. The database contains information about both analogue and digital data at SGU. Beside the geographical definitions, the metabase contains the following information: The name of the exploration area, the total amount of measuring points in the area, exploration method, year of the survey, name of the datafile, report number (if available) and comments. The measurements have been made with following methods: * magnetometer * electrical depth sounding * gravimeter * slingram 18 kHz, slingram 3.6 kHz * induced polarization sounding using a modified Schlumberge configuration (2-electrode RP, IP, SP) * induced polarization sounding with Wenner configuration (4-electrode RP, IP, SP) * VLF measurements with GRB in England as transmitter and VLF measurements with JXZ in Norway as transmitter."},"dct:identifier":"e5334846-d2f9-4f1c-99a8-28da6e4a9177","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, prospekteringsområden (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c3d2d8b1c659f3ea81b0f16104b5ec31a73dd978c68e98d39d41477377776cf7"},{"@graph":[{"@id":"_:c40764a42428f1450b15e2f6ee6c8bdb5be15eb1b0b39819ce0939f4ac77d6c3_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.87745 69.05997,24.17767 69.05997,24.17767 55.28537,10.87745 55.28537,10.87745 69.05997))"}},{"@id":"_:c40764a42428f1450b15e2f6ee6c8bdb5be15eb1b0b39819ce0939f4ac77d6c3_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/96c9b665-f9de-4ab8-8d6c-41411859953e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7"},"dcat:distribution":[{"@id":"urn:uuid:1515520a-9711-095e-dfad-af2f9b211d95"},{"@id":"urn:uuid:19c5fbaf-6d24-ff8a-bb42-285894a052fe"},{"@id":"urn:uuid:3e2c7b12-6b27-9913-3aed-bf591c51c87b"},{"@id":"urn:uuid:9ea20435-4c2a-8307-8cd7-f875202c65ca"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Nationellt rutnät (6x8 km) för spillningsinventering. Varje ruta innehåller en länk till en gpx-fil för waypoints man kan ladda ned till sin GPS för att underlätta inventeringsarbetet."},"dct:identifier":"96c9b665-f9de-4ab8-8d6c-41411859953e","dct:issued":{"@type":"xsd:date","@value":"2016-04-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-04-12"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:c40764a42428f1450b15e2f6ee6c8bdb5be15eb1b0b39819ce0939f4ac77d6c3_b0n0"},"dct:title":{"@language":"sv","@value":"LST Älgdata rutor spillningsinventering"}},{"@id":"urn:uuid:1515520a-9711-095e-dfad-af2f9b211d95","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.Algdata_rutor_spillningsinventering.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:19c5fbaf-6d24-ff8a-bb42-285894a052fe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geoportal.lansstyrelsen.se/arcgis/apps/webappviewer/index.html?id=f96297914e5941159efbbb82eddc2657"},"dct:description":{"@language":"sv","@value":"Kartskåp för nedladdning av inventeringspunkter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Inventeringsrutor - älgspillning"}},{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Natur","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c40764a42428f1450b15e2f6ee6c8bdb5be15eb1b0b39819ce0939f4ac77d6c3_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-natur@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Natur"},{"@id":"urn:uuid:3e2c7b12-6b27-9913-3aed-bf591c51c87b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_3/MapServer/WMSServer?layers=lst_algdata_rutor_spillningsinventering"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LST_Algdata_rutor_spillningsinventering (WMS)"}},{"@id":"urn:uuid:9ea20435-4c2a-8307-8cd7-f875202c65ca","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_3/MapServer/21"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}}],"@id":"urn:source:c40764a42428f1450b15e2f6ee6c8bdb5be15eb1b0b39819ce0939f4ac77d6c3"},{"@graph":[{"@id":"_:c44c7cb84c87f08a7890d23da354be33cc3e81db87312ebee80382f072717720_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Morän från sparade provrester från tidigare karteringsaktiviteter vid SGU, tillsammans med nya moränprov från tidigare inte undersökta områden, har använts för detta dataset (geokemisk atlas). Ett provtagningsnät för hela landet definierades med 12,5 km mellan provlokalerna vilket gett en provtäthet av 1 prov per 150 km2. Proven är tagna (grävda med spade) från C-horisonten på ett djup av ungefär 0,8 m där moränen vanligen inte har störts av vittring. Sandig morän dominerar, speciellt i områden ovanför högsta kustlinjen, men kan variera från lerig till grusig. Ungefär 0,8 kg prov frys- eller vakuumtorkades och siktades till finfraktionen <63 μm med nylonsikt. Provuppsättningen utgjordes av 2 578 moränprov och ytterligare 153 standardprov för analys och kvalitetskontroll.\n\nAlla analyser genomgår en kvalitetskontroll. Dessutom analyseras kontrollprov (dolda) parallellt med de ordinarie analyserna samt att analysordningen av proverna randomiseras.\n\nMoränproven analyserades på ALS Scandinavia AB i Luleå. Två gram prov blandades med 20 ml\nkungsvattenlösning och analyserades med induktivt kopplad plasmasektorfältsmasspektrometer (ICP-SFMS). Metoden hos ALS är optimerad för att ge data för grundämnen med ett brett koncentrationsintervall. För att klara av detta är detektionsgränserna i regel höga. För ett antal grundämnen som vanligtvis förekommer i låga halter i morän (Ag, Au, Pd, Rh och Te) hamnar merparten av resultaten under detektionsgränsen. Därför har en separat analys av Ag, Au, Rh och Te gjorts på det geokemiska laboratoriet vid SGU med en metod som är optimerad för grundämnen med låga koncentrationer. SGU-metoden liknar ALS-metoden men använder 5 g prov i 20 ml kungsvatten. Lösningen innehåller därför högre nivåer av element som förekommer i låga halter vilket ger en noggrann bestämning av grundämnen ned till miljarddelar (ppb) i provet.\n\nProver analyserades även med avseende på pH. Fyra gram torkat moränprov av fraktionen <63 μm blandades med 20 ml avjoniserat vatten (MilliQ®), och efter 48 timmar mättes pH med en elektrod av märket Radiometer CDM83 i ett system av typen MeterLab® pHM240 på SGU. pH har mätts sedan 1983 men inte för varje moränprov under de första tio åren. Ett provtagningsnät för datasetet (geokemisk atlas) kunde ändå konstrueras med ungefär samma avstånd mellan lokalerna som i datasetet för de kemiska analyserna. 2 614 prov analyserades med avseende på pH."}},{"@id":"_:c44c7cb84c87f08a7890d23da354be33cc3e81db87312ebee80382f072717720_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8ebab619-0d7f-4320-adcc-8aac616d9ef8","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:41eece56-008a-2f81-594a-f938d3d244e2"},{"@id":"urn:uuid:479542ee-3a7d-60e9-f777-a7cf9acf942a"},{"@id":"urn:uuid:b0e6f97d-6217-8af6-0757-025fd00ec483"},{"@id":"urn:uuid:bac56079-9f92-afcf-81c9-1c8c03e5d7bf"},{"@id":"urn:uuid:edb9c456-f78a-9fc4-f4d0-326a35578946"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"SO.Markgeokemi, Geokemisk atlas över Sverige innehåller information om olika grundämnen i morän i Sverige och motsvarar innehållet i SGUs öppna data produkt Markgeokemi, analysdata från geokemisk atlas. Informationen är dock transformerad för att harmonisera med Inspire dataspecifikationen för tema Markens jordmåner och jordarter och tillhandhålls i GML-format.\n\nProvtagning har skett i första hand i anslutning till befintligt vägnät. Partiell lakning har gjorts med kungsvatten, den lösta delen av provet har analyserats med masspektrometer, ICP-MS."},"dct:identifier":"8ebab619-0d7f-4320-adcc-8aac616d9ef8","dct:issued":{"@type":"xsd:date","@value":"2020-05-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2020-05-12"},"dct:provenance":{"@id":"_:c44c7cb84c87f08a7890d23da354be33cc3e81db87312ebee80382f072717720_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:c44c7cb84c87f08a7890d23da354be33cc3e81db87312ebee80382f072717720_b1n0"},"dct:title":{"@language":"sv","@value":"SO.Markgeokemi, Geokemisk atlas över Sverige"}},{"@id":"urn:uuid:41eece56-008a-2f81-594a-f938d3d244e2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/SO_SGU_SoilDerivedObject_Atlas.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}},{"@id":"urn:uuid:479542ee-3a7d-60e9-f777-a7cf9acf942a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/publikation/bocker/bocker97rapport/geokemisk-atlas-over-sverige.pdf"},"dct:description":{"@language":"sv","@value":"Geokemisk atlas över Sverige nedladdningsbar som PDF"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Publikationer vid Sveriges geologiska undersökning"}},{"@id":"urn:uuid:b0e6f97d-6217-8af6-0757-025fd00ec483","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/geokemi-oppna-data/markgeokemi-analysdata/"},"dct:description":{"@language":"sv","@value":"Information finns även tillgänglig via API i CSV eller JSON-format. Denna information är inte harmoniserad enlig Inspire dataspecifikation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid Sveriges geologiska undersökning"}},{"@id":"urn:uuid:bac56079-9f92-afcf-81c9-1c8c03e5d7bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-markgeokemi-atlas.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:edb9c456-f78a-9fc4-f4d0-326a35578946","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SO-Markgeokemi-atlas"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:c44c7cb84c87f08a7890d23da354be33cc3e81db87312ebee80382f072717720"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/25080190-38ba-4279-a65d-d9ef8d0bf949","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs.atom"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänsten tillhandahåller meteorologiska observationer som inte är inspireklassade.\nDessa kan laddas ned stationsvis på fyra olika sätt:\n1. Alla granskade arkivdata fram till den förste föregående månad.\n2. Alla ogranskade data de senaste två månaderna.\n3. Alla data för det senaste dygnet.\n4. Alla data för den senaste timmen."},"dct:identifier":"25080190-38ba-4279-a65d-d9ef8d0bf949","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c46d2b5d586822bd53b98ab3b1d2cbec263272952ea9274b13d52ee9a3ca8057"},{"@graph":[{"@id":"_:c4708c6eb1b674876892ed2540c173a68b4d7cea17f6f0e43a4527110e554e72_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/7a267d58-c9fd-cd32-d2f6-5351e033b971","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/download/limniska-vattentypsregioner/atom-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Limniska vattentypsregioner."},"dct:identifier":"7a267d58-c9fd-cd32-d2f6-5351e033b971","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"BR.Limniska vatt