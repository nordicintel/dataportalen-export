da808c92d03431bcf32e79cd5ea7e44f3f4aeef79c8b0cb1c74076d7ecfbcf1b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:da808c92d03431bcf32e79cd5ea7e44f3f4aeef79c8b0cb1c74076d7ecfbcf1b_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:da808c92d03431bcf32e79cd5ea7e44f3f4aeef79c8b0cb1c74076d7ecfbcf1b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/09cb35e4-78f9-4b43-a3cb-fadd625ada56","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/inskrivning-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten ger möjlighet att hämta information om inskrivningar från fastighetsregistrets inskrivningsdel. Tjänsten består av ett antal fördefinierade delar som kan hämtas tillsammans eller var och en för sig.\nFastighetsregistrets inskrivningsdel innehåller bl.a. information om\n•lagfarter\n•tomträtter\n•inteckningar\n•anteckning\n•avtalsservitut\n•nyttjanderätter\n•ägarhistorik\n•köpeskilling."},"dct:identifier":"09cb35e4-78f9-4b43-a3cb-fadd625ada56","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Inskrivning Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:da81e75164b10924e978c313753903897ca295f4d5c55024152318666ae5c228"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/185d0dbf-4bc6-43a9-9be4-a37003f6ca85","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-vasternorrland-200-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Kartan ger en mycket översiktlig bild av jordartsförhållandena inom de delar av Västernorrlands län där SGU saknar mer detaljerad jordartsinformation. Den kommer successivt att ersättas med jordartskartor i skalområdet 1:25 000 till 1:100 000. Kartan bör användas med stor försiktighet vid analyser och bedömningar av markförhållanden."},"dct:identifier":"185d0dbf-4bc6-43a9-9be4-a37003f6ca85","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jordarter 1:200 000, Västernorrland (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:db8be193b1fabae25b6ca52bee920768a805c48fd2af7b63c497770a8c437219"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/f4d1919c-33ef-454e-b88d-5eb3657fe399","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Verksamhetsområden är geografiska områdesavgränsningar som redovisas med uppgifter om antal anställda, antal arbetsställen, största bransch (på avdelningsnivå enligt SNI 2007) och areal. \n\nEtt verksamhetsområde kan bestå antingen av en koncentration av flera arbetsställen, som tillsammans bildar ett geografiskt avgränsat område, eller ett område som karaktäriseras av storskalig och industriellt präglad markanvändning och har minst ett arbetsställe. Ett verksamhetsområde är minst 3 hektar stort. \n\nExempel på verksamhetsområden är flygplatser, gruvor och täkter, områden med industri, handel, företagsparker, tekniska anläggningar och logistik eller områden med högskolor, universitet och vårdinrättningar. Verksamhetsområden utgör ett komplement till datamängden handelsområden. Dessa två områdestyper kan överlappa varandra geografiskt.\n\nVerksamhetsområden kan överlappa andra typer av områdesavgränsningar från SCB, som tätorter och småorter. Verksamhetsområden publiceras från och med 2015 vart femte år. Verksamhetsområden ersätter den tidigare datamängden arbetsplatsområden utanför tätort, som togs fram för åren 2005 och 2010."},"dct:identifier":"f4d1919c-33ef-454e-b88d-5eb3657fe399","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Verksamhetsområden WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:dcfc1098a89b3acb81b3b677c75f16e8333f0f6cc60c0fad37cb71f57cfb6fa6"},{"@graph":[{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se även datadokumentation. Kartan bygger på information om siktdjup, landskapsformer (framtagna från öppen djupdata), samt maringeologisk information. De huvudsakliga källorna för datamängden är: SGU, BSHC, SjöV, EMODNET, SMHI, HELCOM, ICES.\nDataanalys och kartframställning av SGU. Siktdjup är framtaget av Metria och SGU för Symphony-projektet på uppdrag av Havs- och vattenmyndigheten, HaV. Mjukbotten framtaget för Symphony-projektet av SGU."}},{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.847491067481042 66.34280407043912,26.399501536650945 66.34280407043912,26.399501536650945 53.07556013450093,7.847491067481042 53.07556013450093,7.847491067481042 66.34280407043912))"}},{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/a0ef7681-2f1a-7fa5-73d2-3d3593a417cd","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218"},"dcat:distribution":[{"@id":"urn:uuid:6e9afb95-55e6-2f58-4922-a58380e7a58f"},{"@id":"urn:uuid:cd6a153f-1d6f-ba31-87e5-2accdf27f4ae"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Karta som visar havslandskap i Bottniska viken, Östersjön och Västerhavet. Kartans syfte är att på ett intuitivt sätt visualisera olika typer av havsområden och väcka tankar runt miljöskydd och havsplanering."},"dct:identifier":"a0ef7681-2f1a-7fa5-73d2-3d3593a417cd","dct:issued":{"@type":"xsd:date","@value":"2017-12-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-12-06"},"dct:provenance":{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b1n0"},"dct:title":{"@language":"sv","@value":"Omvända kartan"}},{"@id":"urn:uuid:6e9afb95-55e6-2f58-4922-a58380e7a58f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/omvanda-kartan/2017-06-08/omvanda-kartan-2017-06-08.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Omvända kartan filpaket"}},{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsplaneringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsplaneringsenheten"},{"@id":"urn:uuid:cd6a153f-1d6f-ba31-87e5-2accdf27f4ae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/omvanda-kartan/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Omvända kartan WMS"}}],"@id":"urn:source:dd3c8d2c1c26a165c10887d7c7d0d8c93d017c85e081f73e0d74364731fdaf77"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/52d9f759-fc00-42a8-bb0a-44797cab7a29","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Handelsområden är koncentrationer av arbetsställen i SCB:s företagsdatabas med SNI 47 Detaljhandel, vilka tillsammans bildar ett geografiskt avgränsat område, bestående av: \n1. minst fem detaljhandelsföretag, eller\n2. fyra detaljhandelsföretag, vilka tillsammans har minst 100 anställda.\n\nSyftet med handelsområdena är att ge en både översiktlig och heltäckande bild av detaljhandeln i Sverige, avseende geografisk lokalisering, antal handelsområden, antal anställda inom handelsområdena och hur mycket mark de tar i anspråk.\n\nHandelsområden redovisas som ytor.\n\nHandelsområden kan överlappa andra typer av områdesavgränsningar från SCB, som tätorter och småorter. Handelsområden utgör ett komplement till datamängden verksamhetsområden. Dessa två områdestyper kan överlappa varandra geografiskt. Handelsområden publiceras från och med 2015 vart femte år."},"dct:identifier":"52d9f759-fc00-42a8-bb0a-44797cab7a29","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Handelsområden WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:dd5e44cd2c5d278099899f572ce6cabc6873b3125224c5ac381efaa4386b1873"},{"@graph":[{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data avseende djupinformation har sitt ursprung i sjömätningar från 1820 och framåt. Nautisk information uppdateras dagligen. Övrig data kommer från externa källor."}},{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-12"},"dcat:startDate":{"@type":"xsd:date","@value":"1822-01-01"}},{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"601 78","http://www.w3.org/2006/vcard/ns#street-address":"Östra Promenaden 7"},{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:011-19-10-54"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/92FE7BC2-EDF1-468E-892F-16C3D455847D","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:c276fe38-d747-b003-a98e-2dd066ef8201"},"dcat:distribution":{"@id":"urn:uuid:f0b229e5-6900-c023-4522-b9055fda4881"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Rasterdata speglat från Sjöfartsverkets sjökortsdatabas för skalområdet  > 1:15 000. \nSjökortsdata symboliseras med sjökortsutseende (Kort1, IHO S-4)"},"dct:identifier":"92FE7BC2-EDF1-468E-892F-16C3D455847D","dct:issued":{"@type":"xsd:date","@value":"2010-12-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2010-12-21"},"dct:provenance":{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b1n0"},"dct:temporal":{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b2n0"},"dct:title":{"@language":"sv","@value":"Sjökortsdata skala 1:10 000 (tiff)"}},{"@id":"urn:uuid:c276fe38-d747-b003-a98e-2dd066ef8201","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Produkt och leverans Sjökarteenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sma@sjofartsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Sjöfartsverket"},{"@id":"urn:uuid:f0b229e5-6900-c023-4522-b9055fda4881","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/geopub"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverket GeoPub"}}],"@id":"urn:source:ddc1279481036e47116ba316d776e478c9288230a9981b3065d2ae8c43841be0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/6cfd51fa-3b38-4c96-9849-3764ee7a703f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://api.lantmateriet.se/administrativindelning/atom/v1.1/inspire/au"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten innehåller administrativ indelning och är utformad enligt EU-direktivet Inspire."},"dct:identifier":"6cfd51fa-3b38-4c96-9849-3764ee7a703f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Administrativ indelning Nedladdning Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ded1a2072d9c401872fe046117514b3007aa6f58e9aa59a3ba9b5ab3d9e8a151"},{"@gr