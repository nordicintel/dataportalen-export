04551c1befe134f01a09a847a0a90e1928859a0a1fc8f6e1_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Djurskydd och Vilt"},{"@id":"urn:uuid:fd878625-e3db-c5c5-6e81-c0627be29c0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.algforvaltningsomr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:c49f60a07506168904551c1befe134f01a09a847a0a90e1928859a0a1fc8f6e1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/4b1ce5a5-a403-4a22-b0b3-11c9e53d9c43","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jorddjupsmodell"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten visar datamängden Jorddjupsmodell och ger en mycket översiktlig bild av jordtäckets mäktighet. Jorddjupet har beräknats genom interpolering av kända jorddjupsdata, inhämtade genom exempelvis borrningar. Som stöd i interpoleringen mellan observationspunkter har bl.a. yttäckande jordartsinformation använts.\n\nJorddjupet har stor betydelse inom en rad olika\tområden. Några exempel är planering av olika typer av byggande, infrastruktur och grundvattenskydd. I en sådan planering ingår bl.a. att finna lämpliga tekniska lösningar och kostnadsberäkningar beroende av jorddjupet. I många fall vill man undvika stora jorddjup, till exempel för att undvika höga kostnader i samband med borrning. I andra fall är stora jorddjup en fördel, exempelvis för att jordlagren har en stor magasinerande förmåga för grundvatten. Vidare är jorddjupsdata tillsammans med uppgift om jordart viktiga vid hydrologiskmodellering."},"dct:identifier":"4b1ce5a5-a403-4a22-b0b3-11c9e53d9c43","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jorddjupsmodell (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c4a959aa57bf7161f95f25c855ed97cb1b009f23b88ffb15a32e9789f7d2b1b8"},{"@graph":[{"@id":"_:c4b90d65e4fa6f434f6fb4d846dea365058ae4d1847b56e360b96f4a18cc5afd_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.877232704637 59.229518262206,17.404584966203 59.229518262206,17.404584966203 56.758896441069,12.877232704637 56.758896441069,12.877232704637 59.229518262206))"}},{"@id":"_:c4b90d65e4fa6f434f6fb4d846dea365058ae4d1847b56e360b96f4a18cc5afd_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://w