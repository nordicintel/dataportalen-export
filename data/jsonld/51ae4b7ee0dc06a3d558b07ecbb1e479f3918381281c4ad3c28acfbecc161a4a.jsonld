org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/e0c2ea92-451a-5c14-1b2d-5c974b2f3b69","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:c253b80a-da52-f8c4-b0b9-31587deb5ff7"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Övervakningsdata för makroskräp längs svenska havsstränder. Rådata kan fås efter förfrågan (info@hsr.se) och utvalda resultat presenteras på Håll Sverige Rent:s webb."},"dct:identifier":"e0c2ea92-451a-5c14-1b2d-5c974b2f3b69","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Makroskräp på stränder"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2ec646c6db44829254157157aef62585c77199771f3ba584d6c890d9ca6367fb_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:c253b80a-da52-f8c4-b0b9-31587deb5ff7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://studios.statisticon.se/skrapstatistik/Home/Miljo"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Utvald statistik presenteras via databas som tillhandahålls av Håll Sverige Rent"}}],"@id":"urn:source:2ec646c6db44829254157157aef62585c77199771f3ba584d6c890d9ca6367fb"},{"@graph":[{"@id":"_:2f1f556b64eb1a58b3d45a5dd926ca664932ad43a85bd1352778c909d4f1ac90_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ett världsarv är en unik kultur- eller naturhistorisk miljö som vittnar om människans eller jordens historia.\n\nFör att skydda de mest värdefulla kulturhistoriska- och naturmiljöerna mot förfall och förstörelse tillkom Unescokonventionen om skydd för världens kultur- och naturarv vid FN-organets generalkonferens 1972.\n\nSedan dess har denna viktiga internationella överenskommelse undertecknats av 193 stater som alla därmed förbinder sig att uppfylla konventionens krav och förpliktelser. Genom att underteckna Unescokonventionen åtar sig länderna att vårda och bevara viktiga kultur- och naturarv inom det egna territoriet och att stödja andra länder i deras ansträngningar att bevara vårt gemensamma världsarv. \n\nUnescos världsarvskommitté som består av 21 delegationer från 21 olika länder. Kommittémedlemmarna sitter på en mandatperiod av sex år, men för att skapa större cirkulation har mandatperioden enligt överenskommelse minskats till fyra år."}},{"@id":"_:2f1f556b64eb1a58b3d45a5dd926ca664932ad43a85bd1352778c909d4f1ac90_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/e682b368-977d-495a-b183-f4c8f21d82f5","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:10f6f808-d194-3b03-d675-f2fd8a6f41b4"},{"@id":"urn:uuid:3c2c5ac4-00fd-e3ac-a49e-8bbb66450226"},{"@id":"urn:uuid:ca40cfe8-0c3b-5006-e0c0-9399ecd2a408"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Skyddade områden"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ps"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Ytor för Sveriges samtliga världsarv. Innehåller endast världsarvsområdet, inte buffertzon. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"e682b368-977d-495a-b183-f4c8f21d82f5","dct:issued":{"@type":"xsd:date","@value":"2020-01-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-16"},"dct:provenance":{"@id":"_:2f1f556b64eb1a58b3d45a5dd926ca664932ad43a85bd1352778c909d4f1ac90_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:2f1f556b64eb1a58b3d45a5dd926ca664932ad43a85bd1352778c909d4f1ac90_b1n0"},"dct:title":{"@language":"sv","@value":"INSPIRE Skyddade områden - världsarv"}},{"@id":"urn:uuid:10f6f808-d194-3b03-d675-f2fd8a6f41b4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/geoserver/Varldsarv/ows?request=getcapabilities&service=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Visningstjänst"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Visningstjänst"}},{"@id":"urn:uuid:3c2c5ac4-00fd-e3ac-a49e-8bbb66450226","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/files/gml/PS.UNESCOWorldHeritageSites.gml"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Nedladdningstjänst direkt nedladdning GML"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Nedladdningstjänst direkt nedladdning GML"}},{"@id":"urn:uuid:ca40cfe8-0c3b-5006-e0c0-9399ecd2a408","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/PS.UNESCOWorldHeritage-topfeed.xml"},"dct:description":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Nedladdningstjänst ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Världsarv INSPIRE Nedladdningstjänst ATOM"}}],"@id":"urn:source:2f1f556b64eb1a58b3d45a5dd926ca664932ad43a85bd1352778c909d4f1ac90"},{"@graph":[{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Första sammanhållna digitaliserade underlag tillkom 1998- efter Intervjuer med samebyar, bearbetning av befintliga digitala data, samt digitalisering av äldre analoga markanvändningskartor. Arbetet utfördes av lantmäteriet och utfördes på uppdrag av renbeteskommissionen med syfte att utgöra ett beslutsunderlag inför Sveriges förhandlingar om gränsöverskridande renbete med Norge. Senare har Sametinget genomfört en sammanjämkning med uppgifter från Gränsdragningskommissionens arbete."}},{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1883"}},{"@id":"http://dataportal.se/organisation/SE2021004573","@type":"foaf:Agent","dct:identifier":"2021004573","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:kansli@sametinget.se"},"foaf:name":{"@language":"sv","@value":"Sametinget"},"foaf:page":{"@id":"https://www.sametinget.se"}},{"@id":"https://www.geodata.se/resources/3c8d3196-a29b-492d-a620-4ed1efad68dc","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:7eb9ee1b-4042-da87-2002-aabaf49a978a"},{"@id":"urn:uuid:edb34f90-3dfe-742c-779c-7d12c84e9f0e"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Markanvändning"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/lu"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden ”Renskötselområdet” visar renskötselns ungefärliga utbredning i Sverige och är Sametingets sätt att ge en konceptuell bild av var renskötselrätt i dagsläget utövas och kan anses föreligga med stöd av bl.a. urminnes hävd. För vissa områden råder det oenighet om renskötselrättens utbredning. Till stöd för underlaget har Gränsdragningskommissionens utredning (SOU2006:14) använts. Den avsåg att ge vägledning när det gäller var renskötselrätt i större eller mindre grad kan föreligga. Den sammanställning av kunskapsunderlag som utredningen gjorde är omfattande och kan användas för att ge fingervisningar om renskötselrätten utbredning, även om utredningens slutsatser och ställningstaganden kan ifrågasättas. \nFör vidare rättslig information av relevans för tolkning av datamängden hänvisas till rennäringslagen och avgöranden i allmän domstol."},"dct:identifier":"3c8d3196-a29b-492d-a620-4ed1efad68dc","dct:issued":{"@type":"xsd:date","@value":"2017-09-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-18"},"dct:provenance":{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004573"},"dct:spatial":{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b1n0"},"dct:temporal":{"@id":"_:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b_b2n0"},"dct:title":{"@language":"sv","@value":"Renskötselområdets ungefärliga utbredning i Sverige Inspire"}},{"@id":"urn:uuid:7eb9ee1b-4042-da87-2002-aabaf49a978a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gisportal.sametinget.se:443/server/services/INSPIRE/Renskotselomr/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml"},{"@id":"urn:uuid:edb34f90-3dfe-742c-779c-7d12c84e9f0e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.sametinget.se/INSPIRE/atom/atom-datafeed.xml"},"dct:description":{"@language":"sv","@value":"Sametingets nedladdning av INSPIRE geodata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Sametinget INSPIRE Nedladdningstjänst"}}],"@id":"urn:source:2f3ae89256f94e539ad3b43005cfad3ae6a815f09d6e44d33776b0540106535b"},{"@graph":[{"@id":"_:2fe9ffcf53448a515d63a92e8cf4efea495eb1f364d76e13c7bca30189202f0b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Modellen som är grund till kartvisaren har framställts genom att sammanlänka så kallade strandförskjutningskurvor och digitala höjddata (50x50m) i en matematisk strandförskjutningsmodell. Modellen är baserad på flertalet tidigare liknande produkter (Påsse 1996, 1997, 2001). I kartorna visas också en förenklad modell av förloppet för inlandsisens avsmältning. För mer detaljerad och uppdaterad information om inlandsisens avsmältning finns mer fokuserade studier (Stroeven et al. 2016, Hughes et al. 2016).\n\nFör att skapa SGU:s strandförskjutningsmodell behövs information om den relativa strandnivåns höjdläge samt tidpunkt. Denna information är insamlad från vetenskaplig litteratur (Påsse och Daniels 2015 och referenser däri). Information om strandförskjutning tas fram genom att datera när olika sjöar, på olika nivåer, isolerades från havet. Dessa resultat används för att producera strandförskjutningskurvor. \n\nI en sjö eller torvmark avsätts sediment i kronologisk följd. I lagerföljden går det att återfinna de lager som påvisar när vattnet utvecklades från havs- till sötvatten eller brack- till sötvatten. Genom att datera olika växtdelar i sedimenten, med kol-14 metoden går det att sätta en ålder på när havsviken avsnördes och blev en sjö (Figur 1). Utöver åldern, behövs också havsnivån vid avsnörningen och genom att mäta höjden på den lägsta tröskelnivån, alltså den lägsta punkten som leder ut mot den forna havsviken, fås den relativa havsnivån (Figur 1).  \n\nNär detta arbete utförts på flera platser inom ett avgränsat område är det möjligt att passa en kurva mellan datapunkterna (tröskelnivå, ålder). Ofta presenteras dessa kurvor med år före nutid på x-axeln och höjd över havet på y-axeln. \n\nDessa strandförskjutningskurvor kan beskrivas enligt en funktion med fyra olika variabler (Påsse och Andersson 2007, Påsse 1990a, 1990b). Dessa variabler interpoleras över produktens utbredningsområde och kan sedan användas för att generera interpolerade strandförskjutningskurvor för varje punkt. De olika variablerna används också för att förändra en höjdmodell av dagens topografi och på så vis kan paleogeografiska kartor skapas för olika tidsintervall. Mindre sjöar modelleras genom att ’fylla upp’ fördjupningar i de genererade höjdmodellerna för varje tidsintervall."}},{"@id":"_:2fe9ffcf53448a515d63a92e8cf4efea495eb1f364d76e13c7bca30189202f0b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.00 71.00,25.00 71.00,25.00 53.00,7.00 53.00,7.00 71.00))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/71d64ad0-eb2d-4980-9d06-6a36b29de7f2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1ab94d16-8aff-e2d8-f29f-cee44a694938"},{"@id":"urn:uuid:6454470d-9a7f-a1d4-7cbe-a2a345e9e491"},{"@id":"urn:uuid:e6be61e1-67ee-8d7f-15c6-489c7849c253"},{"@id":"urn:uuid:fe5d8d8d-6978-886c-debf-dda86b5a0fbc"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Produkten är en modell av strandförskjutningen och landhöjningen efter den senaste istiden. Den bygger på ett stort antal strandförskjutningskurvor som har upprättats över olika delar av landet kombinerat med en modell för landhöjningen och en digital höjdmodell med 50 m upplösning (Påsse & Daniels 2015).\n\nInlandsisarna som täckte norra Europa och Nordamerika under istiden påverkade den underliggande jordskorpan. Resultatet blev ett dynamiskt samspel mellan landhöjning, vattennivå och inlandsisen (se Peterson Becher 2022 och referenser däri).\n\nUnder den senaste istiden pressades alltså jordskorpan ned av tyngden från inlandsisen. När isen smälte lättade trycket och jordskorpan började röra sig uppåt för att återta tidigare nivåer, en process som fortfarande är aktiv och kallas i Sverige för landhöjning. Samtidigt varierade den globala havsnivån, till stor del på grund av mängden vatten bundet i inlandsisarna. Detta medförde variationer i förhållandet mellan vatten och land (så kallad strandförskjutning). Det är detta förlopp som SGU:s strandförskjutningsmodell visar.\n\nI och med att olika delar av landskapet pressats ned olika mycket, beroende på bland annat inlandsisens mäktighet, så höjs inte jordskorpan enhetligt. Den var mest nedpressad i de centrala delarna där inlandsisen var mäktigast. Därmed tippas också landskapet, vilket innebär att vattendragens lopp och sjöars utbredning delvis ändras med tiden. Till exempel så medför skillnader i landhöjningen att Vätterns nivå stiger i södra delen medan den sjunker i norra delen.\n\nSGU:s strandförskjutningsmodell visar en övergripande bild av den forntida fördelningen mellan hav och land samt även förändringar i sjöarnas utbredningar. Strandförskjutningsmodellen är inte avsedd för detaljerade studier utan för att visa ett generellt förlopp. Mer detaljerade studier kräver försiktighet och ingående förståelse för de osäkerhet som finns i de olika metoder som ligger till grund för modellen. Kartvisaren tillhandahåller strandförskjutning i 100-årsintervall. Detta betyder inte att modellen har en så hög noggrannhet utan de korta intervallen ger endast en möjlighet att se regionala förändringar, alltså ej för noggrann åldersbestämning."},"dct:identifier":"71d64ad0-eb2d-4980-9d06-6a36b29de7f2","dct:issued":{"@type":"xsd:date","@value":"2022-06-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:2fe9ffcf53448a515d63a92e8cf4efea495eb1f364d76e13c7bca30189202f0b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:2fe9ffcf53448a515d63a92e8cf4efea495eb1f364d76e13c7bca30189202f0b_b1n0"},"dct:title":{"@language":"sv","@value":"Strandförskjutningsmodell"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1ab94d16-8aff-e2d8-f29f-cee44a694938","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/strandforskjutningsmodell/strandforskjutningsmodell.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:6454470d-9a7f-a1d4-7cbe-a2a345e9e491","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/strandforskjutningsmodell/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:e6be61e1-67ee-8d7f-15c6-489c7849c253","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-strandforskjutningsmodell.html"},"dct:description":{"@language":"sv","@value":"Copy of template SGU - Mall för tjänster created at 2022-02-24T14:28:58.764Z[GMT]"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGUs kartvisare"}},{"@id":"urn:uuid:fe5d8d8d-6978-886c-debf-dda86b5a0fbc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/strandforskjutningsmodell-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:2fe9ffcf53448a515d63a92e8cf4efea495eb1f364d76e13c7bca30189202f0b"},{"@graph":[{"@id":"_:3028374367f68b081ceea066a223e576384ac65861bd8a12900d33d1f1089523_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:3028374367f68b081ceea066a223e576384ac65861bd8a12900d33d1f1089523_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/56bdb0ab-864a-4321-b6ba-ee555df7c6f5","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:d1bb10c4-73be-dd95-155f-b3c366bd264f"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Maxdjup (djupaste)i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 500 m upplösning. Djupets faktiska position bibehålls. Djup genereras endast i rutor med minst ett mätt värde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"56bdb0ab-864a-4321-b6ba-ee555df7c6f5","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-01"},"dct:provenance":{"@id":"_:3028374367f68b081ceea066a223e576384ac65861bd8a12900d33d1f1089523_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:3028374367f68b081ceea066a223e576384ac65861bd8a12900d33d1f1089523_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 500 m upplösning - maxdjup"}},{"@id":"urn:uuid:d1bb10c4-73be-dd95-155f-b3c366bd264f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:3028374367f68b081ceea066a223e576384ac65861bd8a12900d33d1f1089523"},{"@graph":[{"@id":"_:304dd81829d20ddafa41bd99e9cd01303f8ec59fcc550cbec356932b1d3b6913_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Adminstrativa enheter består av län och kommuner. Gränser visar läns och kommuners utbredning. Län består av ett antal kommuner. Utbredningen och därmed gränserna beslutas av Regeringen. Kommuner och därmed läns utbredning bestämdes vid kommunreformen 1971. Länens indelningar har en lång historia. Västra Götalands län och Skåne län har bildats vid två större sammanslagningar av län. Mindre justeringar av kommungränser, nybildande eller sammanslagningar av kommuner sker då och då efter regeringsbeslut.\n\nAdministrative units consist of counties and municipalities. Boundary shows the county and municipalities outer limitation. Counties consists of a number of municipalities. The boundaries are decided by the Government. Municipalities and thereby the area of the counties were decided at the municipal reform in 1971. Counties divisions has a long history. Minor adjustments to the municipal boundaries, the establishment or a merger of municipalities occurs occasionally after a government decision."}},{"@id":"_:304dd81829d20ddafa41bd99e9cd01303f8ec59fcc550cbec356932b1d3b6913_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1f185d81-c699-48e3-9ada-c9e1ae297557","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:04249c5f-8722-06ca-3140-9e3270725738"},{"@id":"urn:uuid:5db4d8df-0fa5-02f5-2c30-78078a46762e"},{"@id":"urn:uuid:9b18224b-e38d-94c0-7a7d-57c90a47b3a2"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Datamängd innehållande administrativa områden för kommuner, län och rike från grunddata anpassat för skalområde 1:10 000.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Administrativ indelning Nedladdning Inspire och Basemap Visning, Inspire.\n\nDataset containing administrative units of municipalities, counties and the kingdom from basic data adjusted for scale range 1:10 000.\nThe dataset can´t be ordered separately. It is only included in existing service:  Administrative unit Download INSPIRE and Base map View Service INSPIRE."},"dct:identifier":"1f185d81-c699-48e3-9ada-c9e1ae297557","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:304dd81829d20ddafa41bd99e9cd01303f8ec59fcc550cbec356932b1d3b6913_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:304dd81829d20ddafa41bd99e9cd01303f8ec59fcc550cbec356932b1d3b6913_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för administrativ indelning INSPIRE"}},{"@id":"urn:uuid:04249c5f-8722-06ca-3140-9e3270725738","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/administrativindelning/atom/v1.1/inspire/au"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt atomflöde för Administrativ indelning Nedladdning, Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Administrativ indelning Nedladdning, Inspire"}},{"@id":"urn:uuid:5db4d8df-0fa5-02f5-2c30-78078a46762e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/basemap/wms/v1?service=WMS&request=GetCapabilities&version=1.3.0"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för tjänsten Basemap Visning, Inspire (öppen capabilityfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Basemap Visning, Inspire"}},{"@id":"urn:uuid:9b18224b-e38d-94c0-7a7d-57c90a47b3a2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/geodata/vara-produkter/produktlista/basemap-visning-inspire/"},"dct:description":{"@language":"sv","@value":"Produktsida för Basemap Visning, Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets website/webbplats"}}],"@id":"urn:source:304dd81829d20ddafa41bd99e9cd01303f8ec59fcc550cbec356932b1d3b6913"},{"@graph":[{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geodatat är ett uttag från Postal Code Client (PCC) och är framställt av PostNord AB"}},{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.55715558952 69.151311265574,25.126854654096 69.151311265574,25.126854654096 54.703130676814,10.55715558952 54.703130676814,10.55715558952 69.151311265574))"}},{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2012"}},{"@id":"https://www.geodata.se/resources/ae775b8b-1e9c-4992-ae37-067cda2f78ec","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:1e9b69de-259a-b96b-d3ee-c29f1055fb67"},"dcat:keyword":"Postnummerservice Norden AB","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Postala gränsdragningar i vektorform\n- Svenska postnummer på 1-, 2-, 3 samt 5-siffrig nivå\n- Svenska postorter"},"dct:identifier":"ae775b8b-1e9c-4992-ae37-067cda2f78ec","dct:issued":{"@type":"xsd:date","@value":"2012-10-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-10-19"},"dct:provenance":{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b0n0"},"dct:publisher":{"@id":"urn:uuid:744d45fb-cb32-5ed5-14f3-104221f41d67"},"dct:spatial":{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b1n0"},"dct:temporal":{"@id":"_:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f_b2n0"},"dct:title":{"@language":"sv","@value":"Svenska postnummer och postorter"}},{"@id":"urn:uuid:1e9b69de-259a-b96b-d3ee-c29f1055fb67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.postnummerservice.se"},"dct:description":{"@language":"sv","@value":"Mer information om vår geodata hittar ni på vår webb"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Postnummerservice Norden AB webbplats"}},{"@id":"urn:uuid:744d45fb-cb32-5ed5-14f3-104221f41d67","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:info@postnummerservice.se"},"foaf:name":"Postnummerservice Norden AB"}],"@id":"urn:source:305265ce09431420fce7762e105fa0b7f0e2d0978838d236c2983e216fa8213f"},{"@graph":[{"@id":"_:306b872ab96f6ee59eb97c3f4dd056fb45400be3ab9997e2fc3fb47c8cf0c56b_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/3518c6f0-3905-4f7a-b35c-5cf27239f107","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0"},"dcat:endpointURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_HaV_Sma_avlopp_EXT/MapServer"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Syftet med GIS-stödet är att skapa förutsättningar på en nationell nivå för en skälig, rättssäker och mer likriktad bedömning av skyddsnivå enligt 2 kap 3§ miljöbalken vid prövning av små avlopp. GIS-stödet utgörs av kartor som visar risk för påverkan på recipient/exponeringspunkt till följd av belastning från ett avlopp. \n\nKartorna har tagits fram genom riskbedömningar utifrån lagstiftarens anvisningar om kriterier för bedömning av hög/förhöjd skyddsnivå för hela Sveriges yta.\n\nDenna tjänst är en samlad karttjänst med alla skikt strukturerade tematiskt och innehåller nya uppdaterade versioner (2024) av skikten."},"dct:identifier":"3518c6f0-3905-4f7a-b35c-5cf27239f107","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"LST GIS-stöd för planering och tillsyn av små avlopp - alla skikt (tjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:306b872ab96f6ee59eb97c3f4dd056fb45400be3ab9997e2fc3fb47c8cf0c56b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Vatten och miljömål"}],"@id":"urn:source:306b872ab96f6ee59eb97c3f4dd056fb45400be3ab9997e2fc3fb47c8cf0c56b"},{"@graph":[{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar/gota-alv/"}},{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.841119005121 58.385510233662,12.470064355 58.385510233662,12.470064355 57.676650701635,11.841119005121 57.676650701635,11.841119005121 58.385510233662))"}},{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2011"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2009"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/323f5b12-6dc7-41d7-859b-81f5d49c5fa8","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:bb8d9d15-2583-9d4f-f443-64a3ce41a80d"},{"@id":"urn:uuid:f2ee0ab4-c6ea-00e7-aa3e-e096fc4a3c18"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Göta älvdalen är ett av Sveriges mest skredutsatta områden. Flera stora skred har skett i modern tid och vår kartläggning av skredrisker visar att många områden längs Göta älv har fortsatt hög risk för skred. \n\nPå uppdrag av regeringen kartlades skredriskerna längs hela Göta älv inklusive Nordre älv 2009-2011 mot bakgrund av behoven att i framtiden hantera ökade flöden i älven. I uppdraget kartlades både dagens situation och den förändring som sker till följd av klimatförändringen. I uppdrag ingick också att förbättra och utveckla metoderna för kartering och värdering av riskerna. Uppdraget har inneburit en samlad riskanalys med beräkningar av sannolikheten för skred och värdering av de konsekvenser som skred kan ge upphov till. Genom att identifiera olika riskområden har en bedömning gjorts av var geotekniska förstärkningsåtgärder bör utföras. En översiktlig kostnadsbedömning av de geotekniska delarna av förstärkningsåtgärderna har utförts för områden med höga skredrisker. Vidare presenteras en samlad bedömning av de geotekniska förutsättningarna för ökade flöden i Göta älv.\n\nI april 2012 redovisades det s k Göta älvuppdraget (GÄU) i form av tre huvudrapporter - 1.Samhällskonsekvenser; 2.Kartläggning; 3.Kartor (33 st A3-blad 1:10.000) - samt 34 tekniska delrapporter. Se vidare www.sgi.se samt https://www.sgi.se/globalassets/publikationer/gota-alvutredningen/gau_slutrapport_del3.pdf (Del 3 kartor). Risk är en kombination av sannolikheten för skred (kvalificerat geotekniskt bedömningsarbete baserat på en stor mängd digitala data, bla en detaljerad terrängmodell för land och älv) och konsekvensen av ett skred (där hänsyn har tagits till liv/befolkning, fastighetsvärden, transportinfrastruktur, energi- och teledistribution, miljöfarlig \nverksamhet mm). Redovisning sker enligt direktiven i regeringsuppdraget och enligt rådande fackmässiga och geotekniska analysmodeller. \n\n[Geoteknik]"},"dct:identifier":"323f5b12-6dc7-41d7-859b-81f5d49c5fa8","dct:issued":{"@type":"xsd:date","@value":"2015-12-21"},"dct:provenance":{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b1n0"},"dct:temporal":{"@id":"_:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332_b2n0"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Skredriskkartering Göta Älv"}},{"@id":"urn:uuid:bb8d9d15-2583-9d4f-f443-64a3ce41a80d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mapsext.sgi.se/geoserver/inspire_gotaalv/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"SGI Inspire WMS, Naturliga Riskområden, Göta Älv"},"dct:title":{"@language":"sv","@value":"SGI Inspire View Service"}},{"@id":"urn:uuid:f2ee0ab4-c6ea-00e7-aa3e-e096fc4a3c18","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/inspire_nedladdning/SGI_TopAtomFeed_GotaAlv.xml"},"dct:description":{"@language":"sv","@value":"SGI Inspire Feature Download service, ATOM, Göta älv"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGI Inspire Feature Download service, ATOM"}}],"@id":"urn:source:30ac3388a76ecb7899fa8625ba50e98f91956b3da5edb528f04ee2bf279d1332"},{"@graph":[{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Digitalisering på Ekonomiska kartan"}},{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.30095 57.20876,15.75919 57.20876,15.75919 56.40031,13.30095 56.40031,13.30095 57.20876))"}},{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/f82f602b-d33b-40ed-b0c5-68a8fc1aae3a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:6f16b96d-d407-32cf-b380-4f523a5277d3"},{"@id":"urn:uuid:9f5318d2-88d2-48d9-00d9-e2e61287da7f"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Samtliga järnvägsstationer och hållplatser som har funnits i länet fram till 1985, då denna inventering genomfördes."},"dct:identifier":"f82f602b-d33b-40ed-b0c5-68a8fc1aae3a","dct:issued":{"@type":"xsd:date","@value":"2015-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-15"},"dct:provenance":{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Järnvägsstationer 39"}},{"@id":"urn:uuid:6f16b96d-d407-32cf-b380-4f523a5277d3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg205_jvgstn39.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:9f5318d2-88d2-48d9-00d9-e2e61287da7f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/8"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:30bbb374583755209d99486ec41c83aaea56e2bb923d5cddde26e87a9b0aa78f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3bf9e5df-b28f-4ba3-8cc7-164eebedcdb5","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/AM-ProspectingAndMiningPermitArea"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Uppdateras normalt den 10:e varje månad med information som är aktuell den sista månaden innan. Pga av driftproblem uppdateras Inspire-version endast var 6:e månad.\n\nInspire visningstjänst för datamängden AM.Tillstånd för prospektering och gruvbrytning."},"dct:identifier":"3bf9e5df-b28f-4ba3-8cc7-164eebedcdb5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"AM.Tillstånd för prospektering och gruvbrytning (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:311188f3bdd4596b29e2a91c424b95068dc0517cc7b3ad9db77a03b84b0c5a49"},{"@graph":[{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geografisk information är belägenhetsadress på arbetsställe. Utifrån arbetsställenas adresser har koordinater från Lantmäteriet kopplats på. Detta har gjorts genom att geokoda adresserna i flera steg och med olika metoder. Ett visst bortfall finns när koordinater inte kunnat kopplas till belägenhetsadressen. Informationen som finns i det Allmänna företagsregistret är senast kända uppgift (det vill säga kan informationen vara tio år gammal)."}},{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2025"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/daee8f75-0c83-45bc-9107-ee03447467c8","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:494ff7aa-b6d1-d3ff-ae1d-70148a9343c2"},{"@id":"urn:uuid:ba3ad1d0-3c83-6d1f-1c22-f1fa78bd0d4d"},{"@id":"urn:uuid:f589081b-63e2-472e-a559-7404359384c2"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Förskolornas geografiska punkt tas fram med hjälp av det Allmänna företagsregistret samt Geografidatabasen. Branschkoden som används är SNI 85100 (Förskola).Geografisk information är belägenhetsadress på arbetsställe. \n\nGeokodade förskolor uppdateras en gång om året och källan är frysning av årsstatistik som är baserad på SAMU ramar (avser november). Årsregistret skapas i december."},"dct:identifier":"daee8f75-0c83-45bc-9107-ee03447467c8","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-13"},"dct:provenance":{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b1n0"},"dct:temporal":{"@id":"_:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2_b2n0"},"dct:title":{"@language":"sv","@value":"US.AdministrativaOchSocialaOffentligaTjänster.Förskolor"}},{"@id":"urn:uuid:494ff7aa-b6d1-d3ff-ae1d-70148a9343c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SCB:s öppna geodata"}},{"@id":"urn:uuid:ba3ad1d0-3c83-6d1f-1c22-f1fa78bd0d4d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://share.scb.se/OV0105/Xml/US/us_administrativaochsocialaoffentligatjanster_forskolor_atom_nt.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning i GML format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atomflöde Förskolor"}},{"@id":"urn:uuid:f589081b-63e2-472e-a559-7404359384c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/inspire/US.UtilityAndGovernmentServices.PrePrimaryEducation/ows?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Administrativa och Sociala Offentliga Tjänster Förskolor WMS"}}],"@id":"urn:source:317d13e3bd946a851a25362621d65e0ee6c7d1a2a1f460b582a8389f797d8fd2"},{"@graph":[{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Arbetsplatsområden utanför tätorter avgränsas utgående från arbetsställen i SCB:s Företagsdatabas (version från RAMS). Kartor, flygfoton och adresser från eniro.se och hitta.se har använts. Vid avgränsningen utgick SCB från tidigare avgränsade områden. För att fånga nya områden skapades buffertar runtom arbetsställen utanför tätorter. Manuell kontroll har skett av varje område och av alla arbetsställen utanför tätorter med minst 40 sysselsatta."}},{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2010"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2000"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/01ec2efc-6a64-41a8-b23d-acc6e3e7b275","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:3ffdf9eb-f213-b981-4397-6eb6b850fa3b"},{"@id":"urn:uuid:60df52f1-dbc7-9c87-a7c0-9de182ecd044"},{"@id":"urn:uuid:7a37c283-75c9-0919-a990-437ff149c0b5"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Arbetsplatsområden utanför tätorter är koncentrationer av arbetsställen med minst 50 sysselsatta och högst 300 meter mellan byggnaderna. SCB avgränsar polygoner för dessa och beräknar sedan statistik per område utifrån registerdata. Arbetsplatsområden är en äldre inledning som efter referensår 2010 har utgått och ersatts av statistikprodukten verksamhetsområden."},"dct:identifier":"01ec2efc-6a64-41a8-b23d-acc6e3e7b275","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2013-03-01"},"dct:provenance":{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b1n0"},"dct:temporal":{"@id":"_:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4_b2n0"},"dct:title":{"@language":"sv","@value":"Arbetsplatsområden utanför tätorter"}},{"@id":"urn:uuid:3ffdf9eb-f213-b981-4397-6eb6b850fa3b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Arbetsplatsområden WFS"}},{"@id":"urn:uuid:60df52f1-dbc7-9c87-a7c0-9de182ecd044","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/statistiska-verksamhetsomraden/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för verksamhetsområden"}},{"@id":"urn:uuid:7a37c283-75c9-0919-a990-437ff149c0b5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Arbetsplatsområden WMS"}}],"@id":"urn:source:3268a0c0e66a9aa78025d2bf939d9303d89b3320fee819afd73db863a0f4ead4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/622b7588-2462-45a4-935f-7694d242cea5","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SR-Havsbottenyttacke_100k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden SR.Havsbottenyttäcke 1:25 000 visas i denna OGC WMS-tjänst."},"dct:identifier":"622b7588-2462-45a4-935f-7694d242cea5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:100 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:3353cea726e6b41c23de3ae4623b8510d16f072c7778e51b93d25740dfb50433"},{"@graph":[{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.73365 68.15543,23.89014 68.15543,23.89014 55.89555,11.73365 55.89555,11.73365 68.15543))"}},{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/f17cf1dd-ad0d-4c1b-8e9f-605319212edc","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:4ff758d8-da69-cab4-def8-3f3659c72561"},{"@id":"urn:uuid:65a19dab-4a20-1345-3500-c05e6f37d575"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samtliga Protokoll A för alla metoder som finns inlagda i Nationella Biotopkarteringsdatabasen. \nVarje Protokoll A representerar en biotopkarterad sträcka i ett vattendrag.\n\nSträckorna ligger inlagda som linjer. \nVarje protokoll A har en startpunkt och en slutpunkt. Ändarna på varje linje är den sträckans startpunkt och stoppunkt. Startpunkten är den ände av linjerna som ligger uppströms i vattendraget.\nMängden data för objekten är begränsat i skiktet, men varje linje har en länk till objektets protokoll i databasen.\nAlla sträckor har inte linjer inlagda i databasen. För att se dessa behöver du även ladda ner punktskiktet.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"f17cf1dd-ad0d-4c1b-8e9f-605319212edc","dct:issued":{"@type":"xsd:date","@value":"2021-04-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b0n0"},{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Protokoll A, samtliga inventerade sträckor, linjer - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:4ff758d8-da69-cab4-def8-3f3659c72561","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:65a19dab-4a20-1345-3500-c05e6f37d575","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.Biotop_ProtA_Linjer_samtl_inv_strackor.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:338109c14ae808ca5ee2e83c3d8f22641b3edd9c5ea294612f073db96c5770e8"},{"@graph":[{"@id":"_:3392b2b290ab37cac35dc78a3502be0be317239d7d279ddcf7fd3cbb8cfd2f52_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtagen enligt förordning (2009:956) om översvämningsrisker 2018"}},{"@id":"_:3392b2b290ab37cac35dc78a3502be0be317239d7d279ddcf7fd3cbb8cfd2f52_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"https://www.geodata.se/resources/5a84c884-f1f8-4e38-a67c-81232bdfe079","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:68f29ade-7d58-a243-4438-8321fd4954e4"},{"@id":"urn:uuid:7f1f31f8-a9dd-1535-ee3f-816eb2d2289d"},{"@id":"urn:uuid:a71ab952-b571-0ba2-c9c3-7a9057c4bb25"},{"@id":"urn:uuid:c3703412-ea17-7834-b354-c8086bd157db"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Utbredningsskikt för 50-års flödet/nivån i dagens klimat motsvarande hotkartor/riskkartor för de områden med betydande översvämningsrisk enligt förordningen om översvämningsrisker (SFS 2009:956) 2018. För vattendrag finns endast utbredningsskikt för ett avgränsat område och inte hela vattendraget. Om ett område identifierats utifrån vattendrag och det i området också finns en sjö så finns även hotkartor/riskkartor framtagna för dessa. Datamängden är ett resultat av revideringen av steg 2 för cykel 2 (2019) inom översvämningsdirektivet men även för steg 2 i cykel 1 (2013) finns även med i datamängden.\n\nFör vattendrag har en 2 dimensionell hydraulisk modell använts för att ta fram utbredningen. För Vänern, Vättern och Mälaren har en analys av höjd använts. Vilken cykel respektive hotkarta/riskkarta är i från framgår i attributtabellen.\n\nMer information om förordningen om översvämningsrisker finns på: https://www.msb.se/sv/amnesomraden/skydd-mot-olyckor-och-farliga-amnen/naturolyckor-och-klimat/oversvamning/oversvamningsforordningens-tre-steg/"},"dct:identifier":"5a84c884-f1f8-4e38-a67c-81232bdfe079","dct:issued":{"@type":"xsd:date","@value":"2019-09-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-11"},"dct:provenance":{"@id":"_:3392b2b290ab37cac35dc78a3502be0be317239d7d279ddcf7fd3cbb8cfd2f52_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:3392b2b290ab37cac35dc78a3502be0be317239d7d279ddcf7fd3cbb8cfd2f52_b1n0"},"dct:title":{"@language":"sv","@value":"Hot- och riskkartor, utbredning 50-års flöde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:68f29ade-7d58-a243-4438-8321fd4954e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/HotRisk50.zip"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, 50-års flöde i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:7f1f31f8-a9dd-1535-ee3f-816eb2d2289d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/hotochrisk50/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst hot och risk 50 årsflöde OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:a71ab952-b571-0ba2-c9c3-7a9057c4bb25","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/hotochrisk50/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Sida för visningstjänst av hot- och riskkartor."}},{"@id":"urn:uuid:c3703412-ea17-7834-b354-c8086bd157db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_HotRisk50.xml"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, 50-års flöde i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:3392b2b290ab37cac35dc78a3502be0be317239d7d279ddcf7fd3cbb8cfd2f52"},{"@graph":[{"@id":"_:339ade4b1e0e58dafb0624e9f68b5f34ba5812e7ee9b50b5ad0a0a0241fe3ac7_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.760513042868 59.498352148358,18.38815046243 59.498352148358,18.38815046243 59.227284056292,17.760513042868 59.227284056292,17.760513042868 59.498352148358))"}},{"@id":"_:339ade4b1e0e58dafb0624e9f68b5f34ba5812e7ee9b50b5ad0a0a0241fe3ac7_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/f9d7ab76-424a-48ff-9951-d03b9789d3c3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:068380e6-98ff-0cca-60f8-8c396a2c37cd"},{"@id":"urn:uuid:4c8afdc8-8b83-b343-f97f-ae580d4b16f5"},{"@id":"urn:uuid:681715c9-ce01-92c7-82b4-be029757fb94"},{"@id":"urn:uuid:cf3f7ac0-2bde-7f8d-5486-c07e1052c3b0"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Områdena är utpekade av riksdagen som riksintresse för nationalstadspark enligt 4 kap. 7 § miljöbalken.\nGränserna för riksintresseområden är inte absoluta, utan indikerar att värden eller egenskaper av högt allmänt intresse enligt Hushållningsbestämmelserna i 4 kap. miljöbalken finns att ta hänsyn till.\n__\nUr miljöbalkens 4 kapitel:\n7 § Området Ulriksdal-Haga-Brunnsviken-Djurgården är en nationalstadspark.\n\nInom en nationalstadspark får ny bebyggelse och nya anläggningar komma till stånd och andra åtgärder vidtas endast om det kan ske utan intrång i parklandskap eller naturmiljö och utan att det historiska landskapets natur- och kulturvärden i övrigt skadas.\n\nTrots bestämmelsen i andra stycket får en åtgärd som innebär ett tillfälligt intrång eller en tillfällig skada i en nationalstadspark vidtas, om\n1. åtgärden höjer parkens natur- och kulturvärden eller tillgodoser ett annat angeläget allmänt intresse, och\n2. parken återställs så att det inte kvarstår mer än ett obetydligt intrång eller en obetydlig skada. Lag (2009:293)."},"dct:identifier":"f9d7ab76-424a-48ff-9951-d03b9789d3c3","dct:issued":{"@type":"xsd:date","@value":"2019-11-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-03-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:339ade4b1e0e58dafb0624e9f68b5f34ba5812e7ee9b50b5ad0a0a0241fe3ac7_b0n0"},"dct:title":{"@language":"sv","@value":"LST Riksintresse Nationalstadspark MB4kap1,7"}},{"@id":"urn:uuid:068380e6-98ff-0cca-60f8-8c396a2c37cd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Riksintressen_EXT/MapServer/5"},"dct:description":{"@language":"sv","@value":"Restgränssnitt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Riksintresse nationalstadspark MB4kap7"}},{"@id":"urn:uuid:4c8afdc8-8b83-b343-f97f-ae580d4b16f5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_RI_Nationalstadspark_MB4kap7.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:339ade4b1e0e58dafb0624e9f68b5f34ba5812e7ee9b50b5ad0a0a0241fe3ac7_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:681715c9-ce01-92c7-82b4-be029757fb94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"0"}},{"@id":"urn:uuid:cf3f7ac0-2bde-7f8d-5486-c07e1052c3b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Geodata/Datadistribution/ZIP/LST_RI_Nationalstadspark_MB4KAP7.zip"},"dct:description":{"@language":"sv","@value":"LST_RI_Nationalstadspark_MB4KAP7.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"LST_RI_Nationalstadspark_MB4KAP7.zip"}}],"@id":"urn:source:339ade4b1e0e58dafb0624e9f68b5f34ba5812e7ee9b50b5ad0a0a0241fe3ac7"},{"@graph":[{"@id":"_:33e7b2950ba9a17bbb851e634a345f3fbd4859ec1891b1f961f24f29e5488c70_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen I Topografisk webbkarta, raster kommer från Topografi Nedladdning, vektor, GSD-Terrängkartan, GSD-Vägkartan, GSD-Fjällinformation, GSD-Översiktskartan, GSD-Sverigekartan 1:1 miljon och GSD-Sverigekartan 1:5 miljoner."}},{"@id":"_:33e7b2950ba9a17bbb851e634a345f3fbd4859ec1891b1f961f24f29e5488c70_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1b24c965-637b-4db7-b3c9-d87039cdd98c","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:d8ab1147-dfc1-0d90-e321-1d1ffad214c9"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Topografisk webbkarta, raster är lämplig att använda när du har behov av en zoombar karta men inte har möjlighet att vara uppkopplad mot Lantmäteriets visningstjänster. \nProdukten ger tillgång till en topografisk webbkarta som är anpassad för skärmvisning. Kartan har samma innehåll och utseende som Topografisk webbkarta Visning, cache och har en harmoniserad kartografi mellan skalorna. Den tillhandahålls i färg eller som nedtonad kartbild."},"dct:identifier":"1b24c965-637b-4db7-b3c9-d87039cdd98c","dct:issued":{"@type":"xsd:date","@value":"2018-10-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:33e7b2950ba9a17bbb851e634a345f3fbd4859ec1891b1f961f24f29e5488c70_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:33e7b2950ba9a17bbb851e634a345f3fbd4859ec1891b1f961f24f29e5488c70_b1n0"},"dct:title":{"@language":"sv","@value":"Topografisk webbkarta Nedladdning, raster"}},{"@id":"urn:uuid:d8ab1147-dfc1-0d90-e321-1d1ffad214c9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografisk-webbkarta-nedladdning-raster-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Topografisk webbkarta Nedladdning, raster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografisk webbkarta Nedladdning, raster"}}],"@id":"urn:source:33e7b2950ba9a17bbb851e634a345f3fbd4859ec1891b1f961f24f29e5488c70"},{"@graph":[{"@id":"_:34476fea1407f63cf8065a81a15aed827f71857739cf884ae371917be262fbaa_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen sammanställdes ursprungligen under 1980-talet av SGU:s hydrogeologiska enhet med syfte att visa olika bergarters värmeledande egenskaper. En stor mängd modalanalyser (se metodik nedan) samlades in från publicerade rapporter från berggrundsundersökningar, i huvudsak från SGU:s kartserie Af (se Sundberg med flera 1985). Dryga 4000 analyser har hämtats från den sammanställningen. En omfattande komplettering av analyserna har gjorts i efterhand på grund av att det saknades halter på i huvudsak opaka faser (sulfider, oxider, m.m.), aluminiumsilikater, titanit, zirkon, granat och apatit. Ett beslut fattades att komplettera analyserna med icke registrerade mineral. Arbetet begränsades dock till de analyser som understeg en totalhalt på 97 % vilket motsvarade cirka 1500 analyser.\n\nYtterligare modaldata har på senare tid tillförts från SGU:s bergkvalitetsprojekt och från några forskningsprojekt samt från några opublicerade analyser. Totalt finns för närvarande cirka 6500 analyser.\n\nBergarternas mineralfördelning tas fram genom så kallade modalanalyser. Analyserna utförs på 30 mikrometer tunna bergartspreparat (tunnslip) som undersöks med hjälp av punkträkningsutrustning och ett polarisationsmikroskop. Varje mineralkorn som hamnar i mikroskopets hårkors registreras. Preparatet förflyttas med ett förbestämt avstånd och en ny registrering görs. Antalet räknade punkter brukar vara runt 500. Punkträkningen syftar till att ge ett statistiskt underlag för beräkning av den procentuella mineralfördelningen i ett bergartsprov. Resultatet anges i volymprocent.\n\nVärmeledningstal (lambdavärde) i bergartsprovet är beräknat som ett geometriskt medelvärde och baseras på den procentuella fördelningen av de olika mineral som finns i bergarten samt de värmeledningstal respektive mineral har enligt tabellen i produktbeskrivningen. En alternativ metod för beräkning av värmeledningsförmåga finns redovisad i Sundberg med flera (1985), sid 17."}},{"@id":"_:34476fea1407f63cf8065a81a15aed827f71857739cf884ae371917be262fbaa_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.004342417515 68.815219040895,25.47930022724 68.815219040895,25.47930022724 55.101108174396,11.004342417515 55.101108174396,11.004342417515 68.815219040895))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/de990771-cd62-4ba9-bfae-0507d5c53dac","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:32521e7c-2d8b-d312-976d-9a1b9d2c14e5"},{"@id":"urn:uuid:49e71bec-e241-7442-9187-22d0c334daf3"},{"@id":"urn:uuid:526c45bb-9e34-a8e7-1a23-b3f1e92e6d12"},{"@id":"urn:uuid:72cba35d-4380-861d-0f73-dc87626009b7"},{"@id":"urn:uuid:7ea5b6a1-8ae6-775d-acb4-9148332843b4"},{"@id":"urn:uuid:b8b304c1-a776-a86f-9af0-864c2f7ce0d0"},{"@id":"urn:uuid:df5bd012-6b15-2702-553c-31813c7a3d0a"},{"@id":"urn:uuid:e02dba26-f575-f98d-0806-98db0ed01ade"},{"@id":"urn:uuid:f88dc374-3a8d-25fc-de72-c001ad8cc65f"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Modaldata och värmeledningstal visar observerad mineralsammansättning från prover och beräknat för olika bergarter. Värmeledningstalet har för varje prov beräknats som ett viktat geometriskt medelvärde utifrån uppgifter om de enskilda mineralens volymandelar och deras värmeledningstal. Dessa data har använts som underlag för att ta fram produkten Värmeledningsförmåga i berggrunden (öppna data) där bergarters värmeledningsförmåga har klassats utifrån Modaldata och värmeledningstal. Informationen kan användas för översiktlig planering av geoenergianläggningar."},"dct:identifier":"de990771-cd62-4ba9-bfae-0507d5c53dac","dct:issued":{"@type":"xsd:date","@value":"2018-05-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-09"},"dct:provenance":{"@id":"_:34476fea1407f63cf8065a81a15aed827f71857739cf884ae371917be262fbaa_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:34476fea1407f63cf8065a81a15aed827f71857739cf884ae371917be262fbaa_b1n0"},"dct:title":{"@language":"sv","@value":"Modaldata och värmeledningstal"}},{"@id":"urn:uuid:32521e7c-2d8b-d312-976d-9a1b9d2c14e5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/berggrund/modaldata-varmeledningstal-nedladdning.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:49e71bec-e241-7442-9187-22d0c334daf3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/modaldata-varmeledningstal-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:526c45bb-9e34-a8e7-1a23-b3f1e92e6d12","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/modaldata-varmeledningstal/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features )"}},{"@id":"urn:uuid:72cba35d-4380-861d-0f73-dc87626009b7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/modaldata-varmeledningstal/modaldata-varmeledningstal.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:7ea5b6a1-8ae6-775d-acb4-9148332843b4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/modaldata-varmeledningstal?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst"}},{"@id":"urn:uuid:b8b304c1-a776-a86f-9af0-864c2f7ce0d0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare Ballast"}},{"@id":"urn:uuid:df5bd012-6b15-2702-553c-31813c7a3d0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-geoenergi.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare Geoenergi"}},{"@id":"urn:uuid:e02dba26-f575-f98d-0806-98db0ed01ade","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/modaldata-varmeledningstal-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:f88dc374-3a8d-25fc-de72-c001ad8cc65f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}}],"@id":"urn:source:34476fea1407f63cf8065a81a15aed827f71857739cf884ae371917be262fbaa"},{"@graph":[{"@id":"_:3497578e6d942936a1730c1227e6d96941c95b4e14cf447df30330ad122d088b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Fastställs i föreskrift SJVFS 2004:62 på församlingsnivå. Shapen är gjord utifrån församlingarna."}},{"@id":"_:3497578e6d942936a1730c1227e6d96941c95b4e14cf447df30330ad122d088b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/de157460-f149-4264-a5f9-e451576f4352","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:00b89ade-3af0-d251-52aa-c83cbfcec412"},{"@id":"urn:uuid:1af2f648-3466-b9f5-d2ea-977c47d590af"},{"@id":"urn:uuid:486d3640-138e-fd82-d627-8a98558c7d29"},{"@id":"urn:uuid:822846e2-1279-03c2-4cfc-ff92e7f4688b"},{"@id":"urn:uuid:dcf01cc4-3946-abbd-b8c8-6c8b61e215a6"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Områden med särskild förvaltning/begränsningar/reglering samt enheter för rapportering"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/am"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Enligt nitratdirektivet (rådets direktiv 91/676/EEG om skydd mot att vatten förorenas av nitrater från jordbruket) ska känsliga områden för kväveföroreningar identifieras i varje medlemsland och för dessa områden ska särskilda åtgärdsprogram upprättas.\n\nTill de nitratkänsliga områdena i Sverige hör:\n• Gotlands, Stockholms och Södermanlands län\n• Delar av Skåne, Blekinge, Hallands, Västra Götalands, Kalmar, Östergötlands, Värmlands, Örebro, Västmanlands, Dalarna och Uppsala län.\nFör dessa områden finns längre gående bestämmelser för att minska växtnäringsförlusterna från jordbruket än i övriga landet.\n\nVilka kommuner och församlingar som tillhör det känsliga området anges närmare i Jordbruksverkets föreskrifter (SJVFS 2004:62) om miljöhänsyn i jordbruket vad avser växtnäring."},"dct:identifier":"de157460-f149-4264-a5f9-e451576f4352","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:3497578e6d942936a1730c1227e6d96941c95b4e14cf447df30330ad122d088b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:3497578e6d942936a1730c1227e6d96941c95b4e14cf447df30330ad122d088b_b1n0"},"dct:title":{"@language":"sv","@value":"Nitratkänsliga områden"}},{"@id":"urn:uuid:00b89ade-3af0-d251-52aa-c83cbfcec412","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://jordbruksverket.se/vaxter/odling/vaxtnaring/sprida-godsel#h-Nitratkansligaomraden"},"dct:description":{"@language":"sv","@value":"Läs mer om nitratkänsliga områden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Jordbruksverket"}},{"@id":"urn:uuid:1af2f648-3466-b9f5-d2ea-977c47d590af","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/nitratkansligaomraden/atom-datasetfeed-nitratkansligaomraden.xml"},"dct:description":{"@language":"sv","@value":"Atom dataset feed för datamängden Nitratkänsliga områden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom dataset feed för datamängden Nitratkänsliga områden"}},{"@id":"urn:uuid:486d3640-138e-fd82-d627-8a98558c7d29","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&layers=nitratkansligtomrade"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"}},{"@id":"urn:uuid:822846e2-1279-03c2-4cfc-ff92e7f4688b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layers=nitratkansligtomrade"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"}},{"@id":"urn:uuid:dcf01cc4-3946-abbd-b8c8-6c8b61e215a6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/nitratkansligaomraden/20221207/nitratkansligaomraden.zip"},"dct:description":{"@language":"sv","@value":"Rikstäckande GML-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}}],"@id":"urn:source:3497578e6d942936a1730c1227e6d96941c95b4e14cf447df30330ad122d088b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e33c04ee-4f0a-464d-9d59-7a90fbe13896","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SO-Markgeokemi-atlas"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Inspire visningstjänst för datamängden SO.Markgeokemi, Geokemisk atlas över Sverige.  Informationen är transformerad för att överensstämma med Inspire dataspecifikation för tema Markens jordmåner och jordarter. Analyserna motsvarar informationen i SGUs öppna data produkt Markgeokemi, analysdata från geokemisk atlas.\n\nTjänsten innehåller pH-mätningar och elementhalter för ett urval av 31 element av datamängdens totalt 58 element (grundämnen)."},"dct:identifier":"e33c04ee-4f0a-464d-9d59-7a90fbe13896","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"SO.Markgeokemi, Geokemisk atlas över Sverige (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:34ba63b8f0ff5508480192b8c39e5dc8ba05c6fd4351c9425961fbe25de1e816"},{"@graph":[{"@id":"_:34e89e814060c5ab29b45af781fee995fd9383ccfe11b0baac383e13dc329a7c_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:34e89e814060c5ab29b45af781fee995fd9383ccfe11b0baac383e13dc329a7c_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a2bf1106-f3be-41e0-b77a-a150f71d8379","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6c156db3-e7e8-5eb9-6f3c-0c39e25e9fc2"},"dcat:distribution":[{"@id":"urn:uuid:49dc7107-5308-76e2-d2e4-f684634d93a5"},{"@id":"urn:uuid:fb8f0493-e7bc-b024-0d84-cb5102c27c46"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Datamängd med områden för älgskötsel, Älgskötselområden"},"dct:identifier":"a2bf1106-f3be-41e0-b77a-a150f71d8379","dct:issued":{"@type":"xsd:date","@value":"2003-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:34e89e814060c5ab29b45af781fee995fd9383ccfe11b0baac383e13dc329a7c_b0n0"},"dct:title":{"@language":"sv","@value":"LstS Älgskötselområden"}},{"@id":"urn:uuid:49dc7107-5308-76e2-d2e4-f684634d93a5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Jaktomraden_ext/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:6c156db3-e7e8-5eb9-6f3c-0c39e25e9fc2","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Djurskydd och Vilt","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:34e89e814060c5ab29b45af781fee995fd9383ccfe11b0baac383e13dc329a7c_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Djurskydd och Vilt"},{"@id":"urn:uuid:fb8f0493-e7bc-b024-0d84-cb5102c27c46","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.algskotselomrade_2018.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:34e89e814060c5ab29b45af781fee995fd9383ccfe11b0baac383e13dc329a7c"},{"@graph":[{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Statistiken avser folkbokförd befolkning beräknad från adresser  eller fastigheter i Registret över Totalbefolkningen (RTB). Koordinater hämtas från Lantmäteriets Fastighetsdatabas och Adressdatabas.\n\nFram till 2017–01 (2016-12-31) togs rutorna fram på fastighetskoordinater och inte adresskoordinater. Det kan göra att antalet rutor mellan åren 2016–2017 antingen ökar mycket eller minskar mycket i vissa områden. Det beror till exempel på att en fastighet kan innehålla flera adresspunkter vilket i sin tur påverkar hur rutorna skapas upp.\n\nData avser befolkade rutor. En statistisk metod används för att skydda enskildas uppgifter i den redovisade statistiken. På grund av detta är inte alltid de redovisade totalerna lika med summan av deras redovisade delar. Rutor utan befolkning är inte del av data. En 0 innebär att rutan är befolkad men röjandegranskad. \n\nRutID avser Nord- respektive Ostkoordinat för rutans nedre vänstra hörn. ID är 13 ställigt."}},{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2025-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2015-12-31"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1c1d36c5-58b5-4447-94ab-36b57e818931","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0c5bcecf-6881-e985-d820-585d4e39bd3c"},{"@id":"urn:uuid:1aa87d04-c4f3-d6b3-46fb-3083f7a82994"},{"@id":"urn:uuid:e0a998bc-fe03-39db-76d2-92f5ea75ce37"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik per km ruta( 1x1 km). Data innehåller totalbefolkning, könsindelat samt 5-årsklasser. Statistiken finns från 2015-12-31 till 2025-12-31. Nationella data ej INSPIRE.\n\nStatistik för flera år och med andra grupperingar kan beställas från SCB på uppdragsbasis."},"dct:identifier":"1c1d36c5-58b5-4447-94ab-36b57e818931","dct:issued":{"@type":"xsd:date","@value":"2025-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-01"},"dct:provenance":{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b1n0"},"dct:temporal":{"@id":"_:34f94edeaf2f897b925ea8ecb5d0b1fcc3b80505cf9a6f3f08ab1d95b95739d7_b2n0"},"dct:title":{"@language":"sv","@value":"Befolkningsstatistik på km-ruta"}},{"@id":"urn:uuid:0c5bcecf-6881-e985-d820-585d4e39bd3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http