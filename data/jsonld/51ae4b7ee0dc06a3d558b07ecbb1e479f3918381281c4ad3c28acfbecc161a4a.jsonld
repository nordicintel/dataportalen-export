61-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/02affe86-b41c-4b7c-ac8f-4c09ee853f1e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7"},"dcat:distribution":[{"@id":"urn:uuid:57801364-6304-43d9-94aa-05c4f3a78612"},{"@id":"urn:uuid:86afce35-079b-22d5-21e0-83ace6065f10"},{"@id":"urn:uuid:cfda74e0-cff6-afa8-d71f-9fb2f190ad27"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Mosaikmarker på jordbruksmark för södra Sverige är ett av indexen som kombinerar information om storlek och form på åker- och betesmarker, areal potentiella lövbryn samt täthet och antal av träd i jordbrukslandskapet för att ta fram ett mått på hur mosaikartat jordbrukslandskapet är. Metoden kommerr från Jordbruksverkets rapport 2008:9. Där redovisas möjligheter att indikera jordbruksmark med höga naturvärden i Sverige genom tre typer av index. varav mosaikmarker på jordbruksmark är ett."},"dct:identifier":"02affe86-b41c-4b7c-ac8f-4c09ee853f1e","dct:issued":{"@type":"xsd:date","@value":"2017-02-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-02-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:6039018b740184400c717cfb60a040c1cb87717519a1047d77e80b22a82cd025_b0n0"},{"@id":"_:6039018b740184400c717cfb60a040c1cb87717519a1047d77e80b22a82cd025_b1n0"}],"dct:title":{"@language":"sv","@value":"LST (GI) Mosaikmarker på jordbruksmark södra Sverige 1X1 km"}},{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Natur","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6039018b740184400c717cfb60a040c1cb87717519a1047d77e80b22a82cd025_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-natur@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Natur"},{"@id":"urn:uuid:57801364-6304-43d9-94aa-05c4f3a78612","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://ext-dokument.lansstyrelsen.se/Ostergotland/Geodata/Mosaikmarker_S_Sverige.zip"},"dct:description":{"@language":"sv","@value":"Mosaikmarksanalys Södra Sverige. Version 1.0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Mosaikmarksnalys V1.0"}},{"@id":"urn:uuid:86afce35-079b-22d5-21e0-83ace6065f10","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www2.jordbruksverket.se/webdav/files/SJV/trycksaker/Pdf_rapporter/ra08_9.pdf"},"dct:description":{"@language":"sv","@value":"Rapport från Jordbruksverk 2008:9 Kartering av jordbruksmark med höga naturvärden (HNV) i Sverige"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartering av jordbruksmark med höga naturvärden (HNV) i Sverige"}},{"@id":"urn:uuid:cfda74e0-cff6-afa8-d71f-9fb2f190ad27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_LSTGI_PROJEKT.Mosaikindex_1k_S_Sverige.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:6039018b740184400c717cfb60a040c1cb87717519a1047d77e80b22a82cd025"},{"@graph":[{"@id":"_:6092d5c144966ca18f00c8afa5d6008974eccc39f1a762d9d85979ad6ed0e3dc_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.12382 65.1906,21.38993 65.1906,21.38993 56.14343,11.12382 56.14343,11.12382 65.1906))"}},{"@id":"_:6092d5c144966ca18f00c8afa5d6008974eccc39f1a762d9d85979ad6ed0e3dc_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/7140fac4-4e81-4cbc-989d-cdd3c8ac8296","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:21beb884-1dce-4a02-add8-da205bcdde08"},{"@id":"urn:uuid:30ae5555-4f68-99dd-77db-48818191732d"},{"@id":"urn:uuid:c2f09a3b-d379-ffa3-fec0-3ae1a239be67"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Målområde vattendrag visar de vattendrag där det finns vattenkemiska mål och/eller biologiska mål inom kalkningsverksamheten i Sverige. Skiktet bygger på geodata från respektive länsstyrelse som kompletterats med data från Nationella kalkdatabasen. Varje län ansvarar för att de vattendragssträckor som finns med i skiktet är aktuella och kommer in med uppdateringar till länsstyrelsen i Jönköpings län när ändringar sker.  Skiktet Målområde vattendrag uppdateras en gång per år av länsstyrelsen i Jönköpings län."},"dct:identifier":"7140fac4-4e81-4cbc-989d-cdd3c8ac8296","dct:issued":{"@type":"xsd:date","@value":"2019-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:6092d5c144966ca18f00c8afa5d6008974eccc39f1a762d9d85979ad6ed0e3dc_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - målområden vattendrag"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6092d5c144966ca18f00c8afa5d6008974eccc39f1a762d9d85979ad6ed0e3dc_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:21beb884-1dce-4a02-add8-da205bcdde08","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_malomraden_vattendrag.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:30ae5555-4f68-99dd-77db-48818191732d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_malomraden_vattendrag.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:ti