portal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b1n0"},"dct:temporal":{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b2n0"},"dct:title":{"@language":"sv","@value":"Utförda avverkningar - upprättad av Skogsstyrelsen"}},{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Skogsstyrelsen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:c6da1fe2-a66f-fb02-0826-f3b311aedd9a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/UtfordAvverk.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för utförda avverkningar"}},{"@id":"urn:uuid:caadf332-06ba-b92c-d147-ff8d0a791b3d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaUtfordavverkning/MapServer/WmsServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst för utförda avverkningar"}},{"@id":"urn:uuid:e1896bf8-cbc2-c436-ab30-9c80375e2850","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skogsstyrelsen.se/sjalvservice/karttjanster/skogsstyrelsens-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om Skogsstyrelsens geodata"}}],"@id":"urn:source:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef"},{"@graph":[{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är insamlad av SGU i den geologiska karteringen. Insamlingen har skett främst inom den hydrogeologiska och jordartsgeologiska karteringen. Informationen används för att få en tredimensionell bild av geologi och grundvattenmagasin. Den största delen data är insamlad från mitten av 1990-talet och framåt.\n\nDatakvalitet:\nPositionen av profilen är bestämd med karta, (topografisk eller ekonomisk) med eller utan GPS som stöd. Avståndet mellan geofonerna är oftast tio meter. Fem meters geofonavstånd förekommer. Geofonerna är utsatta med måttband med centimeterskala.\n\nProfilerna är ofta avvägda med avvägningsinstrument. Den absoluta höjden kommer från avvägningar till känd höjd eller från nationella höjdbasen."}},{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1990"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c4451697-5616-43c6-b14d-38ea6ab6e4ff","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:20b89b6d-2ab8-7145-12f0-9599194d8283"},{"@id":"urn:uuid:714abdb1-e0e4-74d0-aa5e-7b117c9a9cb2"},{"@id":"urn:uuid:9f9002d7-ee38-46ab-cdd9-ef932a9d6dad"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Geofysiska markmätningar, seismik innehåller information om seismiska mätningar. Informationen består av profillinjer med uppgifter om mätningarna och en URL till en tolkning i pdf-format för seismikprofilen. Tolkningen innehåller information om till exempel djup till berg, jordart, torr eller vattenmättad jordart, djup till grundvattenyta och sprickzoner i berg. Information om den seismiska hastigheten i de olika materialen/objekten kan också ingå."},"dct:identifier":"c4451697-5616-43c6-b14d-38ea6ab6e4ff","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b1n0"},"dct:temporal":{"@id":"_:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, seismik"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:20b89b6d-2ab8-7145-12f0-9599194d8283","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-markmatningar-seismik-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:714abdb1-e0e4-74d0-aa5e-7b117c9a9cb2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-mark-seismik/geofysik-mark-seismik.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:9f9002d7-ee38-46ab-cdd9-ef932a9d6dad","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-mark-seismik/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features )"}}],"@id":"urn:source:f4dc9584dfab65aa6d2b4ffd954aa8cc9d93c529b9fdcd23b36c495170956e5a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/f040f8c7-990d-4951-b2c0-3fafe0df72c2","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/brunnar"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"I visningstjänsten för brunnar finns uppgifter om enskilda brunnars läge och tekniska data såsom djup, jorddjup, foderrörslängd, dimensioner, vattenkapacitet och vad brunnen används till. Uppgifterna gäller främst bergborrade brunnar och utgörs av de uppgifter som brunnsborrare sedan 1976 enligt lag skickar in till SGU."},{"@language":"sv","@value":"Informationen används flitigt, både som praktisk upplysning till allmänhet och brunnsborrare, och för forskningsändamål, t.ex. statistiska bearbetningar."}],"dct:identifier":"f040f8c7-990d-4951-b2c0-3fafe0df72c2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Brunnar (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f5245ebf7c18015621e84121e401f6e30fe137ab2f9805c85945f1ec6fb29eca"},{"@graph":[{"@id":"_:f5769bd053e726a805d089baf0e340b2e9776a39eb5625c34175375dfd35c002_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/6aa8bd96-6039-6f69-da43-118a59534491","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/geoservices/limniska-vattentypsregioner/ows?"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Jordobservation och miljö"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för datamängden Limniska vattentypsregioner"},"dct:identifier":"6aa8bd96-6039-6f69-da43-118a59534491","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"BR.Limniska vattentypsregioner.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f5769bd053e726a805d089baf0e340b2e9776a39eb5625c34175375dfd35c002_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"}],"@id":"urn:source:f5769bd053e726a805d089baf0e340b2e9776a39eb5625c34175375dfd35c002"},{"@graph":[{"@id":"_:f5a7a0bbac77212809d4da09e933572c999204ae15192a381ef96a15e4550c16_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med reducerad djupdata. Min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor och detta görs automatiskt vid varje uppdatering av djupdatabasen. Rastret i denna datamängd är skapad från dessa reducerade djupdata med 500 m upplösning."}},{"@id":"_:f5a7a0bbac77212809d4da09e933572c999204ae15192a381ef96a15e4550c16_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((8.55 66.18,24.28 66.18,24.28 54.79,8.55 54.79,8.55 66.18))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/b3c4d149-26ba-45f0-a705-2e24fd6753f0","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:1729867f-203c-c5e1-cd03-3695dc04a440"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Cellvärdena i rastret representerar minsta (grundaste) djup i Sjöfartsverkets djupdatabas inom varje ruta i ett rutnät med 500 x 500 m stora rutor."},"dct:identifier":"b3c4d149-26ba-45f0-a705-2e24fd6753f0","dct:issued":{"@type":"xsd:date","@value":"2012-09-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-09-27"},"dct:provenance":{"@id":"_:f5a7a0bbac77212809d4da09e933572c999204ae15192a381ef96a15e4550c16_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:f5a7a0bbac77212809d4da09e933572c999204ae15192a381ef96a15e4550c16_b1n0"},"dct:title":{"@language":"sv","@value":"Reducerad djupdata raster - min. 500 m"}},{"@id":"urn:uuid:1729867f-203c-c5e1-cd03-3695dc04a440","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Information om detaljerad djupinformation på Sjöfartsverkets officiella hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - Detaljerad djupinformation"}}],"@id":"urn:source:f5a7a0bbac77212809d4da09e933572c999204ae15192a381ef96a15e4550c16"},{"@graph":[{"@id":"_:f6190975db7e38483a294a5dca5e1f51d9644a521d38b13132abfedbf978b610_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandn