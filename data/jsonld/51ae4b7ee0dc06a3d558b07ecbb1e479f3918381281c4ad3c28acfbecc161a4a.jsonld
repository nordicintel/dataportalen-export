w.w3.org/2006/vcard/ns#organization-name":"LstS Lantbruksenheten"},{"@id":"urn:uuid:67550d58-20ad-42fa-d760-c74a40fec0a8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Historiska_inventeringar_Lantbruk_ext/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:e622b2bf-047b-7ca0-afd6-cbb09e02d967","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.angohag.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:60a6234429b042ee1c9ca46a0fa1e016aeafc06113a449c88b85c16045b5b5ce"},{"@graph":[{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillsynsdatabasen Sevesolagen ska utgöra ett stöd för uppföljning och utvärdering samt rapportering till EU-kommissionen av den operativa tillsyn som sker enligt lagen (1999:381) om åtgärder för att förebygga och begränsa följderna av allvarliga kemikalieolyckor (Sevesolagen)."}},{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.51 69.11,24.51 69.11,24.51 55.11,10.51 55.11,10.51 69.11))"}},{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2002"}},{"@id":"https://www.geodata.se/resources/47b8a0c3-942d-4838-bd4e-f2ca74d1684a","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:a5e339cd-10c0-96a4-bc6f-188fe1107fc4"},{"@id":"urn:uuid:aff5d2d5-aae3-c35b-96a7-dea0452eec27"},{"@id":"urn:uuid:e46fa0d3-6781-0280-d2fe-c5ef28a58e35"},{"@id":"urn:uuid:f023c73c-ee7b-2704-d8a1-3ce6d1eb2a27"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Sefari-systemet har utvecklats för att motsvara de krav som finns för återrapportering av tillsyn enligt rådets direktiv 2012/18/EU om åtgärder för att förebygga och begränsa följderna av allvarliga olyckshändelser där farliga ämnen ingår, det så kallade Seveso III-direktivet, till EU-kommissionen. I Sverige har direktivet implementerats genom bland annat lagen (SFS 1999:381) om åtgärder för att förebygga och begränsa följderna av allvarliga kemikalieolyckor. Det nya Sefari-systemet omfattar verksamheter enligt Sevesolagstiftningen, verksamheter enlig lagen om skydd mot olyckor och förordningen om utvinningsavfall samt Inspiredirektivet. Sefari-systemet innefattar verksamheter som hanterar farliga ämnen i stor omfattning (bland annat Sevesoverksamheter), dammanläggningar, kärntekniska anläggningar, flygplatser och gruvor med flera. Allt i enlighet med de olika lagstiftningarna. Informationen i systemet används till exempel som underlag för MSB:s rapportering till EU-kommissionen om hur Sverige efterlever Sevesodirektivet, vid tillsynsvägledning samt i olika sammansställningar. Sefari-systemet ger möjlighet för länsstyrelserna att uppdatera informationen i systemet via Internet."},"dct:identifier":"47b8a0c3-942d-4838-bd4e-f2ca74d1684a","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-13"},"dct:provenance":{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b1n0"},"dct:temporal":{"@id":"_:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af_b2n0"},"dct:title":{"@language":"sv","@value":"Sevesoanläggningar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:a5e339cd-10c0-96a4-bc6f-188fe1107fc4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/filer/shape/seveso.zip"},"dct:description":{"@language":"sv","@value":"MCF:s sida för nedladdning av sevesoanläggningar i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:aff5d2d5-aae3-c35b-96a7-dea0452eec27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/seveso/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"MCF:s sida för visning av sevsoanläggningar."}},{"@id":"urn:uuid:e46fa0d3-6781-0280-d2fe-c5ef28a58e35","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/seveso/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst seveso OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"},{"@id":"urn:uuid:f023c73c-ee7b-2704-d8a1-3ce6d1eb2a27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/MSB_TopAtomFeed_Seveso.xml"},"dct:description":{"@language":"sv","@value":"MCF:s sida för nedladdning av sevesoanläggningar i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}}],"@id":"urn:source:610e5a34780b5839954e90986ad1f2dcbb8087e4b6b0a4de4fbb0f39cd9b79af"},{"@graph":[{"@id":"_:6153e49993e96a9347c2997809ed94eef62901ba23cace01beb79dc17229169c_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:6153e49993e96a9347c2997809ed94eef62901ba23cace01beb79dc17229169c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.07743 69.05997,24.17767 69.05997,24.17767 56.6011,13.07743 56.6011,13.07743 69.05997))"}},{"@id":"_:6153e49993e96a9347c2997809ed94eef62901ba23cace01beb79dc17229169c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/857480c1-7017-42b6-a39a-6c5b0377b76c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:aac77fb1-d1aa-4214-83d0-dc5bacbf17b8"},{"@id":"urn:uuid:b337db79-3e5e-ef9f-b832-8d5130f673c3"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right