t:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/5d679f8a-c4db-4099-b363-e70ccb9c0192","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:01dfea04-835b-eeba-ca0b-e2fe01d1bd78"},{"@id":"urn:uuid:d507c30a-9d2f-dc73-ae06-49959a074371"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Planerad kalkmängd och metod för respektive kalkningsobjekt och år. Kartskiktet hämtar uppgifter från Nationella kalkdatabasen. Varje län ansvarar för att planeringen i kalkdatabasen är aktuell."},"dct:identifier":"5d679f8a-c4db-4099-b363-e70ccb9c0192","dct:issued":{"@type":"xsd:date","@value":"2019-08-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-08-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:b30e9f92c1286d174c41918f73676a5570a2bb324f44bc598c25a98063acbdeb_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - kalkning planerade"}},{"@id":"urn:uuid:01dfea04-835b-eeba-ca0b-e2fe01d1bd78","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b30e9f92c1286d174c41918f73676a5570a2bb324f44bc598c25a98063acbdeb_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:d507c30a-9d2f-dc73-ae06-49959a074371","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_kalkningsplanerade.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:b30e9f92c1286d174c41918f73676a5570a2bb324f44bc598c25a98063acbdeb"},{"@graph":[{"@id":"_:b365f0c6ef963edb7813efb2c5b069d80ab5ed3cc8fcf62a0a9775a6168ea265_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.18452 57.98354,15.2856 57.98354,15.2856 57.08416,13.18452 57.08416,13.18452 57.98354))"}},{"@id":"_:b365f0c6ef963edb7813efb2c5b069d80ab5ed3cc8fcf62a0a9775a6168ea265_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/13a21a15-599e-4e9f-88d0-190151c239b9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4"},"dcat:distribution":[{"@id":"urn:uuid:1fa476dd-ce67-94ed-8469-07a9d1e5cedc"},{"@id":"urn:uuid:5355b089-8cce-2754-e74c-ce8ac755a4d6"},{"@id":"urn:uuid:cef1b181-e73a-f8f8-169e-2d74b948dffa"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Enligt 7 kap. 13 § miljöbalken (MB) gäller strandskydd vid havet och vid insjöar och vattendrag. \n\nVid generellt strandskydd\nEnligt 7 kap. 13 § MB omfattar strandskyddet land- och vattenområdet intill 100 meter från strandlinjen vid normalt medelvattenstånd (strandskyddsområde).\n\nDetta kartskikt innehålller strandskyddsområden vid liten sjö och litet vattendrag som är upphävda enligt beslut av Länsstyrelsen fram till och med 2025-06-30. Länsstyrelsen kan from 1 juli 2025 inte längre upphäva strandskyddet vid en liten sjö och litet vattendrag enligt 7 kap. 18 § p.2 miljöbalken, i de fall området har liten betydelse för att tillgodose strandskyddets syften."},"dct:identifier":"13a21a15-599e-4e9f-88d0-190151c239b9","dct:issued":{"@type":"xsd:date","@value":"2017-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:b365f0c6ef963edb7813efb2c5b069d80ab5ed3cc8fcf62a0a9775a6168ea265_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Upphävda strandskydd vid mindre sjö och vattendrag"}},{"@id":"urn:uuid:1fa476dd-ce67-94ed-8469-07a9d1e5cedc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_strandskydd_EXT/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:5355b089-8cce-2754-e74c-ce8ac755a4d6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.naturvard_strandskydd_upphavda_mindre.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Enheten för naturskydd och tillsyn","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b365f0c6ef963edb7813efb2c5b069d80ab5ed3cc8fcf62a0a9775a6168ea265_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Enheten för naturskydd och tillsyn"},{"@id":"urn:uuid:cef1b181-e73a-f8f8-169e-2d74b948dffa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_3/MapServer/32"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LstF Upphävda strandskydd vid mindre sjö och vattendrag"}}],"@id":"urn:source:b365f0c6ef963edb7813efb2c5b069d80ab5ed3cc8fcf62a0a9775a6168ea265"},{"@graph":[{"@id":"_:b3bd6527627439cc761983b3a41b77a673ec95a6103c97ac54d56e8889c865ea_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:b3bd6527627439cc761983b3a41b77a673ec95a6103c97ac54d56e8889c865ea_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010---121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/1e5e76fc-2f17-4dcc-aa8f-6019f0bd414a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51"},"dcat:endpointURL":{"@id":"https://inspire-raa.metria.se/raafeed/PS.Buildings-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Utbredningsområde för enskilda och statliga byggnadsminnen och kyrkliga kulturminnen som är registrerade i Bebyggelseregistret. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"1e5e76fc-2f17-4dcc-aa8f-6019f0bd414a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Byggnadsminnen och kyrkliga kulturminnen INSPIRE nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b3bd6527627439cc761983b3a41b77a673ec95a6103c97ac54d56e8889c865ea_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b3bd6527627439cc761983b3a41b77a673ec95a6103c97ac54d56e8889c865ea_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:b3bd6527627439cc761983b3a41b77a673ec95a6103c97ac54d56e8889c865ea"},{"@graph":[{"@id":"_:b3f63aa55a598f60d12cb4b60ac97fdfba7e54f84ea61ff85984d85ef1f2441f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Morän från sparade provrester från tidigare karteringsaktiviteter vid SGU, tillsammans med nya moränprov från tidigare inte undersökta områden, har använts för detta dataset (geokemisk atlas). Ett provtagningsnät för hela landet definierades med 12,5 km mellan provlokalerna vilket gett en provtäthet av 1 prov per 150 km2. Proven är tagna (grävda med spade) från C-horisonten på ett djup av ungefär 0,8 m där moränen vanligen inte har störts av vittring. Sandig morän dominerar, speciellt i områden ovanför högsta kustlinjen, men kan variera från lerig till grusig. Ungefär 0,8 kg prov frys- eller vakuumtorkades och siktades till finfraktionen <63 μm med nylonsikt. Provuppsättningen utgjordes av 2 578 moränprov och ytterligare 153 standardprov för analys och kvalitetskontroll.\n\nMoränproven analyserades på ALS Scandinavia AB i Luleå. Två gram prov blandades med 20 ml kungsvattenlösning och analyserades med induktivt kopplad plasmasektorfältsmasspektrometer (ICP-SFMS). Metoden hos ALS är optimerad för att ge data för grundämnen med ett brett koncentrationsintervall. För att klara av detta är detektionsgränserna i regel höga. För ett antal grundämnen som vanligtvis förekommer i låga halter i morän (Ag, Au, Rh och Te) hamnar merparten av resultaten under detektionsgränsen. Därför har en separat analys av Ag, Au, Rh och Te gjorts på det geokemiska laboratoriet vid SGU med en metod som är optimerad för grundämnen med låga koncentrationer. SGU-metoden liknar ALS-metoden men använder 5 g prov i 20 ml kungsvatten. Lösningen innehåller därför högre nivåer av element som förekommer i låga halter vilket ger en noggrann bestämning av grundämnen ned till miljarddelar (ppb) i provet.\n\nProver analyserades även med avseende på pH. Fyra gram torkat moränprov av fraktionen <63 μm blandades med 20 ml avjoniserat vatten (MilliQ®), och efter 48 timmar mättes pH med en elektrod av märket Radiometer CDM83 i ett system av typen MeterLab® pHM240 på SGU. pH har mätts sedan 1983 men inte för varje moränprov under de första tio åren. Ett provtagningsnät för datasetet (geokemisk atlas) kunde ändå konstrueras med ungefär samma avstånd mellan lokalerna som i datasetet för de kemiska analyserna. 2 614 prov analyserades med avseende på pH."}},{"@id":"_:b3f63aa55a598f60d12cb4b60ac97fdfba7e54f84ea61ff85984d85ef1f2441f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/1be88e7d-2199-4864-9eb8-b51ef0141ddb","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3aad388d-bb5c-8fd3-c2bc-eac196d0e7d1"},{"@id":"urn:uuid:436eb57c-b86f-d322-8b1a-c68744372dff"},{"@id":"urn:uuid:66b98cf5-a118-d061-2dc8-876df9558515"},{"@id":"urn:uuid:739810bd-4a23-0e69-c926-2cfb60279810"},{"@id":"urn:uuid:a4c3868e-e3a3-3d25-cfe7-11b1e24b5901"},{"@id":"urn:uuid:bd8cf608-9d39-fb72-5160-7a9a8b1e91eb"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Markgeokemi, Geokemisk atlas över Sverige innehåller information om olika grundämnen i morän i Sverige. Provtagning har skett i första hand i anslutning till befintligt vägnät. Partiell lakning har gjorts med kungsvatten, den lösta delen av provet har analyserats med masspektrometer, ICP-MS."},"dct:identifier":"1be88e7d-2199-4864-9eb8-b51ef0141ddb","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-10"},"dct:provenance":{"@id":"_:b3f63aa55a598f60d12cb4b60ac97fdfba7e54f84ea61ff85984d85ef1f2441f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:b3f63aa55a598f60d12cb4b60ac97fdfba7e54f84ea61ff85984d85ef1f2441f_b1n0"},"dct:title":{"@language":"sv","@value":"Markgeokemi, geokemisk atlas över Sverige"}},{"@id":"urn:uuid:3aad388d-bb5c-8fd3-c2bc-eac196d0e7d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/geokemi/markgeokemi-analysdata-atlas-api.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:436eb57c-b86f-d322-8b1a-c68744372dff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/markgeokemi-atlas-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:66b98cf5-a118-d061-2dc8-876df9558515","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppna