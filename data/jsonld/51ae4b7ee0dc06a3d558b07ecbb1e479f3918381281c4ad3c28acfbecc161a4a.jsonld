":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/80489e55-4332-4ad8-b1b4-0fbdbec555da","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/stompunkt-visning-api"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visningstjänst för stompunkter i de nationella referenssystemen, SWEREF 99 och RH 2000."},"dct:identifier":"80489e55-4332-4ad8-b1b4-0fbdbec555da","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Stompunkt Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:77bd977b9a2892a2c1a77c7a5f084e275faaa845956fb4ea2f70c68e19c6e4f7"},{"@graph":[{"@id":"_:77d8e49c11f387f7c389caecaeba1a9da2edbed2d1902b8ad15645a805e224d4_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Torvförekomsterna är ett urval ur SGUs öppna data Torvlagerföljder, där observationer som bedömts vara relevanta ur energisynpunkt inkluderats i denna datamängd.\n\nEnergimineralen är ett urval ur produkten Mineralresurser där fyndigheter av kolväten som har bedömts vara av intresse ur nergisynpunkt inkluderats.\n\nInformationen har transformerats för att harmonisera med Inspire dataspecifikation för tema Energiresurser."}},{"@id":"_:77d8e49c11f387f7c389caecaeba1a9da2edbed2d1902b8ad15645a805e224d4_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7ed76a64-fe0f-48c1-9ec0-b648f50087b1","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:22c8e5ac-c46b-2f1a-66ac-8cb0caad6436"},{"@id":"urn:uuid:93156e7a-39ac-5664-f021-7d70833e6902"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"ER.Energiresurser innehåller uppgifter om torvförekomster och energimineral från SGUs databaser och är transformerad för att harmonisera med Inspire dataspecifikation för tema Energiresurser. Infomationen tillhandhålls i GML-format."},"dct:identifier":"7ed76a64-fe0f-48c1-9ec0-b648f50087b1","dct:issued":{"@type":"xsd:date","@value":"2020-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-02"},"dct:provenance":{"@id":"_:77d8e49c11f387f7c389caecaeba1a9da2edbed2d1902b8ad15645a805e224d4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:77d8e49c11f387f7c389caecaeba1a9da2edbed2d1902b8ad15645a805e224d4_b1n0"},"dct:title":{"@language":"sv","@value":"ER.Energiresurser"}},{"