96938ff-70de-9052-a7ff-08bf264242dc"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tillståndspliktig miljöfarlig verksamhet. Denna datamängd innehåller punkter för anläggningar enligt NACE 10-33 . Källa: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfarlig verksamhet. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län."},"dct:identifier":"a9941eee-1bc0-42df-a476-de6171f49806","dct:issued":{"@type":"xsd:date","@value":"2019-09-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:1b3627b85703455903fbe91def6b61ca746ee33e7677cff3f097cb93d11d30eb_b0n0"},"dct:title":{"@language":"sv","@value":"SE.PF Tillverkningsindustrier (NACE C)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1b3627b85703455903fbe91def6b61ca746ee33e7677cff3f097cb93d11d30eb_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"},{"@id":"urn:uuid:95303daa-9ace-e802-33f3-e557695c39ba","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/pf_tillverkning.xml"},"dct:description":{"@language":"sv","@value":"LST ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST ATOM"}},{"@id":"urn:uuid:a96938ff-70de-9052-a7ff-08bf264242dc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_pf/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}}],"@id":"urn:source:1b3627b85703455903fbe91def6b61ca746ee33e7677cff3f097cb93d11d30eb"},{"@graph":[{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är mottagna under vegetationsperioden respektive period, och har en geometrisk upplösning på 10-30 meter. Undantaget är data från 1970-talet som har 80 meter upplösning."}},{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1976"}},{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"80182","http://www.w3.org/2006/vcard/ns#street-address":"Geodatasupport, Lantmäteriet"},{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:026-633600"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/da3e5412-e9e8-431d-a7a0-f7d70403f426","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109"},"dcat:distribution":[{"@id":"urn:uuid:e60753da-12da-8775-18e1-2531a898de29"},{"@id":"urn:uuid:ff454070-adee-f6f6-7e75-6a580bfc2558"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är motttagna under vegetationsperioden respektive period, och har en geometrisk upplösning på 10-30 meter. Undantaget är data från 1970-talet som har 80 meters upplösning."},"dct:identifier":"da3e5412-e9e8-431d-a7a0-f7d70403f426","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-01"},"dct:provenance":{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b1n0"},"dct:temporal":{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b2n0"},"dct:title":{"@language":"sv","@value":"Saccess, ortokorrigerade kartriktiga scener"}},{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Lantmäteriet","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodatasupport@lm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Lantmäteriet"},{"@id":"urn:uuid:e60753da-12da-8775-18e1-2531a898de29","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://saccess.lantmateriet.se/"},"dct:description":{"@language":"sv","@value":"Tjänsten Saccess för att ladda ned satellitbilder."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Saccess"}},{"@id":"urn:uuid:ff454070-adee-f6f6-7e75-6a580bfc2558","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/geodata/vara-produkter/produktlista/satellitbilder/"},"dct:description":{"@language":"sv","@value":"Mer information om produkten finns att hämta på Lantmäteriets webbsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets webbsida"}}],"@id":"urn:source:1bb0789d5ef053fd6e52c941e650c91550be2dbe9b27804117284c0f173752fc"},{"@graph":[{"@id":"_:1cb8ae4b4a80f020d98ee6a7e3c3aa897450890e92189d00bce847ef0eb7a59d_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59207701286 69.059970495251,23.995285895186 69.059970495251,23.995285895186 55.17707889327,10.59207701286 55.17707889327,10.59207701286 69.059970495251))"}},{"@id":"_:1cb8ae4b4a80f020d98ee6a7e3c3aa897450890e92189d00bce847ef0eb7a59d_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ff8d6f6c-ed65-4710-a357-b55fd827ab73","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:1497be6c-c70a-4f20-672e-3cfb1699bbc7"},{"@id":"urn:uuid:1749556f-918a-7bb8-46cd-180522454a0c"},{"@id":"urn:uuid:1a282178-9cd1-567b-6c99-57cae599173e"},{"@id":"urn:uuid:1cb2d770-bf21-f506-5d4a-e83e6ae738e9"},{"@id":"urn:uuid:94fa0511-4fff-d3ec-a811-5faf77690ebf"},{"@id":"urn:uuid:f8f9283c-ff52-0b1e-40f3-415d78faa89d"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Fiskekartan.se innehåller skikt över Sveriges fiskevårdsområden. Skiktet är heltäckande och ska innehålla alla områden. I södra Sverige har oftast respektive vatten digitaliserats genom att sjöar och vattendrag hämtats från fastighetskartans vattenskikt. I norra Sverige är områdena vanligtvis avsevärt större och i de områdena visas områdenas yttergränser istället för enskilda ingående vatten. \n\nSkiktet har producerats av Länsstyrelsen i Jönköpings län och rättas kontinuerligt om felaktigheter förekommer. Gränserna för områdena har har digitaliserats från fiskevårdsområdenas beslut om bildande, stadgar och förrättningskartor. Därefter har berörd Länsstyrelse och fiskevårdsområdesförening fått möjlighet att granska den digitaliserade gränsen. Mindre felaktigheter i gränserna kan förekomma. Om fel uppmärksammas vill vi att ni uppmärksammar Länsstyrelsen på detta genom att skicka epost till fiskekartan@lansstyrelsen.se."},"dct:identifier":"ff8d6f6c-ed65-4710-a357-b55fd827ab73","dct:issued":{"@type":"xsd:date","@value":"2020-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-03-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:1cb8ae4b4a80f020d98ee6a7e3c3aa897450890e92189d00bce847ef0eb7a59d_b0n0"},"dct:title":{"@language":"sv","@value":"LST Fiskevårdsområden FVOF - Fiskekartan.se"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1cb8ae4b4a80f020d98ee6a7e3c3aa897450890e92189d00bce847ef0eb7a59d_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:1497be6c-c70a-4f20-672e-3cfb1699bbc7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.fiskekartan_fvof.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:1749556f-918a-7bb8-46cd-180522454a0c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/rest/services/SvenskaFiskekartan/lst_svenskafiskekartan_webbgis/MapServer/1/query?where=OBJECTID+%3E+0&geometryType=esriGeometryEnvelope&outFields=*&returnGeometry=true&returnIdsOnly=false&returnCountOnly=false&returnZ=false&returnM=false&returnDistinctValues=false&returnExtentsOnly=false&f=kmz"},"dct:description":{"@language":"sv","@value":"Länk för nedladdning till kmz-fil. Genereras vid klick och kan ta en liten stund att genereras och laddas ned."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fiskevårdsområden (kmz)"}},{"@id":"urn:uuid:1a282178-9cd1-567b-6c99-57cae599173e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/rest/services/SvenskaFiskekartan/lst_svenskafiskekartan_webbgis/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fiskevårdsområden - REST-tjänst"}},{"@id":"urn:uuid:1cb2d770-bf21-f506-5d4a-e83e6ae738e9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://fiskekartan.se/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Svenska Fiskekartan"}},{"@id":"urn:uuid:94fa0511-4fff-d3ec-a811-5faf77690ebf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/services/SvenskaFiskekartan/lst_svenskafiskekartan_webbgis/MapServer/WMSServer?layers=fvof"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Fiskevårdsområden - WMS-tjänst"}},{"@id":"urn:uuid:f8f9283c-ff52-0b1e-40f3-415d78faa89d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Fiskekartan_EXT/MapServer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Visningstjänst (MapService)"}}],"@id":"urn:source:1cb8ae4b4a80f020d98ee6a7e3c3aa897450890e92189d00bce847ef0eb7a59d"},{"@graph":[{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Område framtaget av UNESCO 2004"}},{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.30409 57.1455,12.45513 57.1455,12.45513 57.06233,12.30409 57.06233,12.30409 57.1455))"}},{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/79c765a9-67e2-4f1f-96eb-244977e83f21","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea"},"dcat:distribution":[{"@id":"urn:uuid:d1e56669-ed40-5e94-522a-a7d0652e921f"},{"@id":"urn:uuid:f5ff8000-3a28-4160-e5f9-e7dbb0c5fb97"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Område att beakta vid detalj- och Översiktsplanearbete. Område avgränsat av UNESCO. \n\nRadiostation i Grimeton öppnade för telegramtrafik 1924 och är idag ensam kvar av det världsomspännande nätverk med nio stationer som företaget General Electric byggde upp under åren 1918 till 1924. Stationerna försågs med dåtidens mest avancerade teknik för trådlös långvåg, uppfunnen av den svensk-amerikanske ingenjören Ernst F W Alexanderson. De sex 127 meter höga antenntornen syns vida i det öppna landskapet. Radiostationen blev skyddad som byggnadsminne 1996 och förklarades som världsarv av UNESCO:s världsarvskommitté 2004, med motiveringen att ”Grimeton Radiostation, Varberg, är ett unikt och enastående monument som representerar utvecklingsprocessen inom kommunikationsteknologin under perioden efter första världskriget”."},"dct:identifier":"79c765a9-67e2-4f1f-96eb-244977e83f21","dct:issued":{"@type":"xsd:date","@value":"2017-02-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-02-24"},"dct:provenance":{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Grimeton (buffert)"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:d1e56669-ed40-5e94-522a-a7d0652e921f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://grimeton.org/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"https://grimeton.org/"}},{"@id":"urn:uuid:f5ff8000-3a28-4160-e5f9-e7dbb0c5fb97","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_Grimeton_buffert.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:1cdbca855654ac2fda743cebae100cf3282f3ca2b2a3aed604eaa9f4d6095736"},{"@graph":[{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Gränsen för fjällnära skog togs fram i början av 1990-talet och finns beskriven i Skogsstyrelsens författningssamling, SKSFS 1991:3, Förordning om gränsen för fjällnära skog. 2018 gjordes en uppdatering med syfte att öka lägesnoggrannheten. Utifrån koordinater och beskrivningstexter kvalitetssäkrades gränsen längs hela utbredningen. Gränsen har digitaliserats utifrån koordinater från förordningen, fastighetskartan och historiskt kartmaterial. Där det är möjligt utgår gränsen från platser i terrängen och i fastighetskartan som läget var i början av 90-talet."}},{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2010"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2010"}},{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/3f51720f-d714-4649-a905-0c50927e62ca","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:37ac667e-3428-c227-5292-d2f6ec6efb43"},{"@id":"urn:uuid:ad333879-adb6-6a86-e4ba-7d7ddf5e4380"}],"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Geodata som anger gräns för fjällnära skog, upprättad av Skogsstyrelsen. Den digitaliserade gränsen är lämplig att använda för att få en överblick på området för fjällnära skog. Det är viktigt att komma ihåg att den digitala gränsen inte har rättsverkan. Det är Skogsstyrelsens författningssamling, SKSFS 1991:3, Förordning om gränsen för fjällnära skog som utgör de juridiska dokument som gäller."},"dct:identifier":"3f51720f-d714-4649-a905-0c50927e62ca","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-29"},"dct:provenance":{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b1n0"},"dct:temporal":{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b2n0"},"dct:title":{"@language":"sv","@value":"BR.Gräns för fjällnära skog upprättad av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:37ac667e-3428-c227-5292-d2f6ec6efb43","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaFjallnaragransyta/MapServer/WmsServer?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS-tjänst med gräns för fjällnära skog producerad av Skogsstyrelsen"},"dct:title":{"@language":"sv","@value":"Gräns för fjällnära skog producerad av Skogsstyrelsen"}},{"@id":"urn:uuid:ad333879-adb6-6a86-e4ba-7d7ddf5e4380","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Fjallnaragr.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av gräns för fjällnära skog, upprättad Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av gräns för fjällnära skog - atomflöde"}}],"@id":"urn:source:1cedd57964b684c77e840af4aab024925804cbe56541d72578e8f0e9935c639c"},{"@graph":[{"@id":"_:1e6d52dae79a11588518fcdaa65bb60f673fbb3500008ca0f7d1202c95b2afef_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från i mitten på 1930-talet började man framställa de Ekonomiska kartorna. Under åren 1992-97 digitaliserades den analoga informationen. Datamängden kompletterades och vidareutvecklades med t.ex. förbättrad lägesnoggrannhet vid uppbyggnaden av Grundläggande Geografiska Data (GGD) 1995-2004. Fjällområdet karterades mellan åren 2006-2012. Efter att uppbyggnaden av GGD avslutades 2004 har fokus lagts på att förbättra informationens aktualitet och tillgänglighet. Uppdateringen av de topografiska objekten sker dels i egen regi och dels i samverkan med de myndigheter eller organisationer som ansvarar för respektive informationsslag."}},{"@id":"_:1e6d52dae79a11588518fcdaa65bb60f673fbb3500008ca0f7d1202c95b2afef_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/11979ab2-5f17-4cc8-b524-826295805f3e","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:02dfa2b9-d660-d066-9640-51fd04aecc64"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten har ett liknande innehåll som Topografi 10 Nedladdning, vektor och är framtagen för att i första hand användas för utskrift. Kartan innehåller bland annat byggnader, markslag, vägar och fastighetsgränser. Kartan kan väljas med antingen fastighetsindelning eller vägnamn."},"dct:identifier":"11979ab2-5f17-4cc8-b524-826295805f3e","dct:issued":{"@type":"xsd:date","@value":"2018-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-01"},"dct:provenance":{"@id":"_:1e6d52dae79a11588518fcdaa65bb60f673fbb3500008ca0f7d1202c95b2afef_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:1e6d52dae79a11588518fcdaa65bb60f673fbb3500008ca0f7d1202c95b2afef_b1n0"},"dct:title":{"@language":"sv","@value":"Karta 1:10 000 med vägnamn Nedladdning, raster"}},{"@id":"urn:uuid:02dfa2b9-d660-d066-9640-51fd04aecc64","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/karta-1-10-000-nedladdning-raster"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Karta 1:10 000 Nedladdning, raster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Karta 1:10 000 Nedladdning, raster"}}],"@id":"urn:source:1e6d52dae79a11588518fcdaa65bb60f673fbb3500008ca0f7d1202c95b2afef"},{"@graph":[{"@id":"_:1f2f1df2f5b68de88582efeb2f0a0c65c98aa02d17bbfa1819d8d2e773bb5e27_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"AM.Grundvattenförekomster är en anpassad version av SGUs produkt Grundvattenförekomster (öppna data) i syfte att uppfylla Inspire dataspecifikation för tema Områden med särskild förvaltning/begränsning/reglering, samt enheter för rapportering."}},{"@id":"_:1f2f1df2f5b68de88582efeb2f0a0c65c98aa02d17bbfa1819d8d2e773bb5e27_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/87b73ddd-82fc-4f9e-8142-7c3c4c1667b7","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:32b08040-4c44-ff4c-d3b6-e21398c1b7f1"},{"@id":"urn:uuid:6ea92991-9c62-9f5d-31b4-7e91dedfc552"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"AM.Grundvattenförekomster är anpassad för att överensstämma med Inspire dataspecifikation för tema Områden med särskild förvaltning/begränsning/reglering, samt enheter för rapportering.\n\nAM.Grundvattenförekomster redovisar förekomster av grundvatten som utpekats inom vattenförvaltningen. Vattenförvaltningen arbetar med att uppfylla kraven i ramdirektivet för vatten 2006/60/EG) och grundvattendirektivet (2006/118/EG) m.fl. direktiv. Grundvattenförekomsternas gränser sammanfaller huvudsakligen med SGU:s karterade grundvattenmagasin i sand och grus samt i sedimentära och kristallina akviferer, men är särskilt avgränsade för vattenförvaltningens syften.\n\nGrundvattenförekomster finns i jord eller berg som har speciellt goda förutsättningar för\ngrundvattenutvinning. Grundvattenförekomsterna utgör viktiga resurser för bl.a. dricksvattenförsörjning."},{"@language":"sv","@value":"Informationen utgör ett beslutsunderlag i kommunal planering för markanvändning, vattenförsörjning, grundvattenskydd samt grundvattenrelaterade tillstånds- och tillsynsfrågor."}],"dct:identifier":"87b73ddd-82fc-4f9e-8142-7c3c4c1667b7","dct:issued":{"@type":"xsd:date","@value":"2018-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-06-02"},"dct:provenance":{"@id":"_:1f2f1df2f5b68de88582efeb2f0a0c65c98aa02d17bbfa1819d8d2e773bb5e27_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:1f2f1df2f5b68de88582efeb2f0a0c65c98aa02d17bbfa1819d8d2e773bb5e27_b1n0"},"dct:title":{"@language":"sv","@value":"AM.Grundvattenförekomster"}},{"@id":"urn:uuid:32b08040-4c44-ff4c-d3b6-e21398c1b7f1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/AM-WaterBodyForWFD"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"AM.Grundvattenförekomster"},"dct:title":{"@language":"sv","@value":"AM.WaterBodyForWFD"}},{"@id":"urn:uuid:6ea92991-9c62-9f5d-31b4-7e91dedfc552","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/AM_SGU_WaterBodyForWFD.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}}],"@id":"urn:source:1f2f1df2f5b68de88582efeb2f0a0c65c98aa02d17bbfa1819d8d2e773bb5e27"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/82583042-e261-4479-a9a0-ecbd3b375989","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/MR-Mineralresurser?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"MR.Mineralresurser (visningstjänst) är en OGC Web Map Service  i syfte att uppfylla Inspires dataspecifikation för tema Mineralresurser. Den underliggande datamängden är framtagen och harmoniserad enligt specifikationer från olika EU-projekt, bland annat Minerals4EU och ProSUM och innehåller information om mineralfyndigheter, gruvor, gruvavfall och produktion.\n\nDatamängden baseras på SGUs mineralresursdatabas (punktuppgifter om mineral och bergartsförekomster), samt kompletterande sammanställningar av bland annat metallhalter och tonnage för större fält av mineralfyndigheter från SGUs malmdatabas.\n\nVisningstjänsten presenterar informationen med attribut enligt EarthResourceML Lite."},"dct:identifier":"82583042-e261-4479-a9a0-ecbd3b375989","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"MR.Mineralresurser (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:1f7e35d0fbbf8e25be572bf880ef64bf2a93b528e21f8597c2efebd411583998"},{"@graph":[{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Åtgärdsprogram för hotade arter och naturtyper, samt regeringens satsning på våtmarker. Åtgärdsprogram för rikkärr."}},{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.588 58.5965,19.7352 58.5965,19.7352 56.7007,17.588 56.7007,17.588 58.5965))"}},{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.94718 57.4414,18.77836 57.4414,18.77836 56.89866,17.94718 56.89866,17.94718 57.4414))"}},{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/fce6a925-61de-44a0-ad4b-f6c4452aa11c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4"},"dcat:distribution":[{"@id":"urn:uuid:9d426395-ac93-837b-d21c-77ec60f58d61"},{"@id":"urn:uuid:a01c7d41-eec7-2ef3-35ae-411fc7ce0088"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Vegetationsanalys m h a fjärranalys och AI inom potentiella rikkärr, Gotlands södra del"},"dct:identifier":"fce6a925-61de-44a0-ad4b-f6c4452aa11c","dct:issued":{"@type":"xsd:date","@value":"2024-08-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-15"},"dct:provenance":{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:1f7ec5d0406b56b9a1351d1e7bc9abb7f905e1265358f883d9489dec7122143f_b