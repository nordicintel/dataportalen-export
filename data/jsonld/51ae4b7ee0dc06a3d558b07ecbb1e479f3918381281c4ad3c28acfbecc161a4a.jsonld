976595ee51_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:spatial":{"@id":"_:8454e9a81661a7b4b05604b058e59945d48257cc3cd85c067488d1976595ee51_b1n0"},"dct:temporal":{"@id":"_:8454e9a81661a7b4b05604b058e59945d48257cc3cd85c067488d1976595ee51_b2n0"},"dct:title":{"@language":"sv","@value":"Skador och förgiftningar"}},{"@id":"urn:uuid:2ee1977c-d1a2-35f3-f6b7-4afe9477b243","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-ska-wfs.map&service=wfs&request=GetCapabilities"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens Geodata nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Socialstyrelsens Geodata nedladdningstjänst"}},{"@id":"urn:uuid:632bf758-6f93-73d4-af61-1f88ccd5bbb9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-ska-wms.map&service=wms&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Socialstyrelsens Geodata visningstjänst"},"dct:title":{"@language":"sv","@value":"Socialstyrelsens Geodata visningstjänst"}},{"@id":"urn:uuid:96966ce9-5c9b-fd18-68fa-d9c83d8f615b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.socialstyrelsen.se/kartvisning/index.html"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens karttjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Socialstyrelsens karttjänst"}}],"@id":"urn:source:8454e9a81661a7b4b05604b058e59945d48257cc3cd85c067488d1976595ee51"},{"@graph":[{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen som ryms i denna produkt är framtagen genom olika verksamheter under lång tid. Äldre data har migrerats från andra databaser och nya data tas kontinuerligt in via SGU:s inrapporteringstjänst som validerar data utefter överenskomna regler för att säkerställa att data uppfyller datavärdskapets krav. Data levereras från ett stort antal utförare och verksamheter. Leveranser kan identifieras genom attributet leveransid och godkänns av personal på SGU, levererade data lagras internt på SGU och godkända leveranser tillgängliggörs genom OGC-APIer."}},{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/b1781847-f669-45d2-8d9b-b0e676211910","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:18237d2a-4eb1-00b3-a2ae-6b40748c84af"},{"@id":"urn:uuid:73627f01-ce67-a704-3003-341c827a5063"},{"@id":"urn:uuid:96c0e125-8260-90fd-6b27-b008fa9d43e2"},{"@id":"urn:uuid:9e044110-d9d4-745a-62f1-d4f6ccc5e2c3"},{"@id":"urn:uuid:cbda800d-21dd-57ea-580e-e0a8a25da206"},{"@id":"urn:uuid:dc91f50a-738a-1d09-19ca-ef530c701a96"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"sv","@value":"Informationen kan användas som referensmaterial för beskrivningen av miljötillståndet, uppföljning av miljömålen samt som stöd i arbetet enligt vattenförvaltningsförordningen"},{"@language":"sv","@value":"Miljögifter, analysresultat och provplatser omfattar öppet tillgängliga data om organiska föroreningar och grundämnen (inklusive metaller) främst i biota, sediment och vatten, samt för matriser där screeningar av miljögifter utförts (slam, mark, damm, grundvatten, livsmedel, med flera), bland annat sådana som SGU samlat in och/eller förvaltar genom det nationella datavärdskapet för miljögifter, finansierade av Naturvårdsverket. Data härstammar huvudsakligen från nationell, regional och kommunal miljöövervakning, forskningsprojekt, undersökningar av förorenade områden och sediment samt recipientkontrollprogram.\n\nUtöver analysresultat, omfattar produkten också kringinformation rörande provtagningsomständigheter, analysförfarande och provplatsinformation. Analysresultat och provplatsinformation tillhandahålls som separata informationsmängder, sammanlänkade genom provplatsens id  (nationellt_provplatsid) i det nationella stationsregistret https://stationsregister.miljodatasamverkan.se.\n\nProdukten är tänkt att utgöra en samlad källa till rådata för tolkning och analys av miljögifter i Sveriges biota och sediment över tid och rum samt nya miljöföroreningar eller kemikalierisker för människan eller miljön. Det bör dock understrykas att materialet omfattar data såväl från opåverkade områden som lokalt påverkade och/eller förorenade. Ambitionen är att över tid utöka denna produkt med mer data, såväl från SGU:s egenfinansierade verksamhet som genom det nationella datavärdskapet för miljögifter."}],"dct:identifier":"b1781847-f669-45d2-8d9b-b0e676211910","dct:issued":{"@type":"xsd:date","@value":"2025-12-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b1n0"},"dct:temporal":{"@id":"_:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12_b2n0"},"dct:title":{"@language":"sv","@value":"Miljögifter, analysresultat och provplatser"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:18237d2a-4eb1-00b3-a2ae-6b40748c84af","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/miljoovervakning_grundvatten"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Nationell miljöövervakning, grundvattenkemi,Regional miljöövervakning, grundvattenkemi"},"dct:title":{"@language":"sv","@value":"grundvatten:SE.GOV.SGU.NATIONELL_MILJOOVERVAKNING_GRUNDVATTEN_VY,grundvatten:SE.GOV.SGU.REGIONAL_MILJOOVERVAKNING_GRUNDVATTEN_VY"}},{"@id":"urn:uuid:73627f01-ce67-a704-3003-341c827a5063","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/kartor/kartvisaren/miljokartvisare/kartvisare-och-utsok-av-halter-miljogifter/"},"dct:description":{"@language":"sv","@value":"Kartvisare för miljöövervakning grundvattenkemi. Gränssnittet erbjuder statistiska funktioner och nedladdning av tidsseriedata."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare och utsökning av halter av miljögifter"}},{"@id":"urn:uuid:96c0e125-8260-90fd-6b27-b008fa9d43e2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/miljogifter-analysresultat-provplatser-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:9e044110-d9d4-745a-62f1-d4f6ccc5e2c3","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/miljogifter-analysresultat-provplatser/ogc/features/v1?"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:cbda800d-21dd-57ea-580e-e0a8a25da206","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/miljogifter-analysresultat-provplatser/miljogifter-analysresultat-provplatser.zip"},"dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning GeoPackage"}},{"@id":"urn:uuid:dc91f50a-738a-1d09-19ca-ef530c701a96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/nationella-datavardskap/datavardskap-for-miljogifter/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Webbplats datavärdskap för miljögifter"}}],"@id":"urn:source:8470ca30dcb783b194455e0d746a14e76414395b8f1806e83c72c78d97391d12"},{"@graph":[{"@id":"_:84ff5b5a0e71ba9a2b19bf2748e6853feea6161083d6ad65a31f6936a63dc7c6_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är framtagen och harmoniserad enligt specifikationer från olika EU-projekt, bland annat Minerals4EU och ProSUM och innehåller information om mineralfyndigheter, gruvor, gruvavfall och produktion. Datamängden baseras på SGUs mineralresursdatabas (punktuppgifter om mineral och bergartsförekomster), samt kompletterande sammanställningar av bland annat metallhalter och tonnage för större fält av mineralfyndigheter från SGUs malmdatabas."}},{"@id":"_:84ff5b5a0e71ba9a2b19bf2748e6853feea6161083d6ad65a31f6936a63dc7c6_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/fdc2a96a-530b-4d51-8158-a81dc520438d","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:8f5e1f73-8053-757d-3fed-43b3cc718e67"},{"@id":"urn:uuid:b25f7f1f-2c4f-abed-970b-ade82b408f90"},{"@id":"urn:uuid:c5a1d38f-8f59-b7d6-17f8-ec4d8e108629"},{"@id":"urn:uuid:cc463955-322a-c644-d2b3-1f82a42046ea"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"sv","@value":"Datamängden är framtagen och harmoniserad enligt specifikationer från olika EU-projekt, bland annat Minerals4EU och ProSUM, och vänder sig i första hand till professionella användare så som geologer, prospektörer och beslutsfattare inom samhällsbyggnad och miljö, men kan även användas av andra intresserade."},{"@language":"sv","@value":"MR.Mineralresurser innehåller rikstäckande information om mineralresurser i Sverige i syfte att uppfylla Inspires dataspecifikation för tema Mineralresurser. Datamängden är framtagen och harmoniserad enligt specifikationer från olika EU-projekt, bland annat Minerals4EU och ProSUM och innehåller information om mineralfyndigheter, gruvor, gruvavfall och produktion. Datamängden baseras på SGUs mineralresursdatabas (punktuppgifter om mineral och bergartsförekomster), samt kompletterande sammanställningar av bland annat metallhalter och tonnage för större fält av mineralfyndigheter från SGUs malmdatabas."}],"dct:identifier":"fdc2a96a-530b-4d51-8158-a81dc520438d","dct:issued":{"@type":"xsd:date","@value":"2015-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2015-06-01"},"dct:provenance":{"@id":"_:84ff5b5a0e71ba9a2b19bf2748e6853feea6161083d6ad65a31f6936a63dc7c6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:84ff5b5a0e71ba9a2b19bf2748e6853feea6161083d6ad65a31f6936a63dc7c6_b1n0"},"dct:title":{"@language":"sv","@value":"MR.Mineralresurser"}},{"@id":"urn:uuid:8f5e1f73-8053-757d-3fed-43b3cc718e67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://m4eu.sgu.se/m4eu/services/m4eu_v2020.8?service=WFS&request=GetCapabilities"},"dct:description":{"@language":"sv","@value":"Inspire nedladdningstjänster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Inspire download services"}},{"@id":"urn:uuid:b25f7f1f-2c4f-abed-970b-ade82b408f90","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/m4eu/services/m4eu?service=WFS&request=GetCapabilities"},"dct:description":{"@language":"sv","@value":"Inspire\n\t\t\t\t\t\t\t\t\tnedladdningstjänster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Inspire download services"}},{"@id":"urn:uuid:c5a1d38f-8f59-b7d6-17f8-ec4d8e108629","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/MR-Mineralresurser"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}},{"@id":"urn:uuid:cc463955-322a-c644-d2b3-1f82a42046ea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/MR-Mineralresurser?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}}],"@id":"urn:source:84ff5b5a0e71ba9a2b19bf2748e6853feea6161083d6ad65a31f6936a63dc7c6"},{"@graph":[{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är ursprungligen framställd genom en harmonisering och sammanslagning av Grundvatten 1:50 000 och Grundvatten 1:250 000, där information från Grundvatten 1:50 000 har fått företräde. Datamängden tillförs infomrmation genom nykartering i skala 1:50 000. Till grund för materialet ligger SGUs jordarts- och berggrundskartor, fältundersökningar där grundvattennivåer mäts, källor inventeras m.m. Vidare utförs geofysiska mätningar, sonderingsborrningar och drivning av observationsrör samt vattenprovtagning."}},{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1980"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c0265eb3-931b-4e4f-b5a0-45c49181a816","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:5586153f-17e2-96a3-2078-f91647205d51"},{"@id":"urn:uuid:c2e344be-1f94-0ecf-ec25-65dd99bf85c2"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"sv","@value":"GE.Hydrogeologi ger en generaliserad bild över grundvattentillgångar i jord och berg och överensstämmer med Inspires dataspecifikation för tema Geologi. Datamängden innehåller objekttyperna Aquifer, AquiferSystems, Aquiclude, Groundwaterbody samt information om naturliga källor. I denna datamängd redovisas endast det översta grundmagasinet i jord och det översta grundvattenmagasinet i sedimentärt berg.\n\nInformationen utgör ett beslutsunderlag i kommunal planering för markanvändning, vattenförsörjning, grundvattenskydd samt grundvattenrelaterade tillstånds- och tillsynsfrågor. Informationens detaljeringsgrad skiljer sig över landet, översiktlig information i skala 1:250 000 dominerar men mer detaljerad information i skala 1:50 000 finns över flera områden i framför allt södra Sverige."},{"@language":"sv","@value":"Informationen utgör ett beslutsunderlag i kommunal planering för markanvändning, vattenförsörjning, grundvattenskydd samt grundvattenrelaterade tillstånds- och tillsynsfrågor."}],"dct:identifier":"c0265eb3-931b-4e4f-b5a0-45c49181a816","dct:issued":{"@type":"xsd:date","@value":"2015-10-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b1n0"},"dct:temporal":{"@id":"_:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Hydrogeologi"}},{"@id":"urn:uuid:5586153f-17e2-96a3-2078-f91647205d51","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Hydrogeologi"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"GE.Hydrogeologi,GE.Aquifer,GE.AquiferSystems,GE.Aquiclude,GE.GroundWaterBody,GE.Spring"},"dct:title":{"@language":"sv","@value":"GE.SGU.Hydrogeology,GE.Aquifer,GE.AquiferSystems,GE.Aquiclude,GE.GroundWaterBody,GE.Spring"}},{"@id":"urn:uuid:c2e344be-1f94-0ecf-ec25-65dd99bf85c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Hydrogeology.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}}],"@id":"urn:source:861fbfa3e6e869c31e0c3e13ac439b830476a43208f9cdc927e6ea74c2f69e2e"},{"@graph":[{"@id":"_:862ceca39636767287759e43813f9617ca54d0c6866232e62abb92690444e35c_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.25429 57.13988,14.48327 57.13988,14.48327 55.34071,12.25429 55.34071,12.25429 57.13988))"}},{"@id":"_:862ceca39636767287759e43813f9617ca54d0c6866232e62abb92690444e35c_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/4a0e6d1c-abf5-4a30-8819-c4d8e1253bc7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9"},"dcat:distribution":{"@id":"urn:uuid:6180aad6-fd63-b180-f444-bdb3892ddf3c"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"GIS-Skikt över historiska våtmarker på Generalstabskartan, södra verket.\nSkiktet är automatiskt genererat av en AI (ett convolutional neural network), som lärt sig hur våtmark symboliseras i kartan över Jönköpings län, och sedan applicerades den kunskapen på hela Generalstabskartan södra verket. \n\nSkiktet kan användas till uppskattningar av historisk våtmarksareal inom större områden.\nFör visualisering och mindre lokala analyser bör materialet användas ihop med Generalstabskartan då det kan finns stora lokala avvikelser mellan moderna kartor och Generalstabskartan.\n\nSkiktet är automatiskt genererat av en AI (ett convolutional neural network) som är tränad till att efterlikna uppmärkningen av våtmarker som utförts i Jönköpings län (se https://ext-geodatakatalog.lansstyrelsen.se/GeodataKatalogen/GetMetaDataById?id=8e099e52-a708-4fd1-95d2-d102fc6f6282&showmetadataview). \nSkiktet kan användas till uppskattningar av historisk våtmarksareal inom större områden.\nFör visualisering och mindre lokala analyser bör materialet användas ihop med Generalstabskartan då det kan finns stora lokala avvikelser mellan moderna kartor och Generalstabskartan.\nArtikel om skiktet finns fritt tillgänglig här: Identifying wetland areas in historical maps using deep convolutional neural networks - ScienceDirect. https://www.sciencedirect.com/science/article/pii/S1574954122000061?via%3Dihub"},"dct:identifier":"4a0e6d1c-abf5-4a30-8819-c4d8e1253bc7","dct:issued":{"@type":"xsd:date","@value":"2021-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-01-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:862ceca39636767287759e43813f9617ca54d0c6866232e62abb92690444e35c_b0n0"},"dct:title":{"@language":"sv","@value":"LST Våtmarker Generalstabskartan"}},{"@id":"urn:uuid:6180aad6-fd63-b180-f444-bdb3892ddf3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.LST_vatmarker_generalstabskartan.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:862ceca39636767287759e43813f9617ca54d0c6866232e62abb92690444e35c_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Vattenenheten"}],"@id":"urn:source:862ceca39636767287759e43813f9617ca54d0c6866232e62abb92690444e35c"},{"@graph":[{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inte känt"}},{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2013"}},{"@id":"https://www.geodata.se/resources/7feffc56-6d36-431a-a192-249fabf1b515","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2ce53f7f-40bd-dce6-eec0-550ba8af2529"},{"@id":"urn:uuid:85ddf366-f630-6b50-1867-87687d29af3f"},{"@id":"urn:uuid:e2a4ed33-a5dc-fac3-18d8-ef98112d7c85"},{"@id":"urn:uuid:f18230dc-7c61-d6b0-c688-13dbd0545da0"},{"@id":"urn:uuid:f3c2c9c0-6dc0-8fb3-8e0b-9599928d7977"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"MSB har regeringens uppdrag att förse landets kommuner och länsstyrelser med översiktlig kartläggning av områden som kan översvämmas utmed landets sjöar och vattendrag. Syftet med översvämningskarteringarna är bland annat att vara ett planeringsunderlag för kommunernas översiktliga fysiska planering och som ett underlag för arbetet med de kommunala handlingsprogrammen. Karteringarna kan även vara ett stöd i räddningstjänstens övergripande planering av insatser. MSB:s översvämningskarteringar uppdateras löpande genom att de hydrauliska modellerna förbättras och nya klimatanpassade flödesberäkningar för slutet av seklet används. De uppdaterade översvämningskarteringarna visar vattnets utbredning vid 3 olika flöden, det beräknade högsta flödet samt klimatanpassat 100-års och 200-års flöde för slutet av seklet. Med en händelses återkomsttid menas att den inträffar eller överträffas i genomsnitt en gång under denna tid. Det innebär att sannolikheten för exempelvis ett 100-års flöde är 1 på 100 för varje enskilt år. Sannolikheten för att flödet ska inträffa 1 gång under 100-årsperioden är 63 procent och sannolikheten att det ska inträffa 2 gånger under samma period är 40 procent."},"dct:identifier":"7feffc56-6d36-431a-a192-249fabf1b515","dct:issued":{"@type":"xsd:date","@value":"2015-04-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-13"},"dct:provenance":{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b1n0"},"dct:temporal":{"@id":"_:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff_b2n0"},"dct:title":{"@language":"sv","@value":"Översvämningskartering"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:2ce53f7f-40bd-dce6-eec0-550ba8af2529","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/oversvamning/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"MSB:s sida för visning av översvämningskarteringar, genomförda från och med 2013"}},{"@id":"urn:uuid:85ddf366-f630-6b50-1867-87687d29af3f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_Oversvam.xml"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av översvämningskarteringar, genomförda från och med 2013 i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:e2a4ed33-a5dc-fac3-18d8-ef98112d7c85","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://undefined"},"dct:description":{"@language":"sv","@value":"undefined"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"},{"@id":"urn:uuid:f18230dc-7c61-d6b0-c688-13dbd0545da0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/InspireMSB_oversvam.zip"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av översvämningskarteringar, genomförda från och med 2013 i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:f3c2c9c0-6dc0-8fb3-8e0b-9599928d7977","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/oversvamning/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst översvämning OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}}],"@id":"urn:source:8631ed5830dec033a85ebf8af4eb284e14c2d1b9a9e86ae85c59c6e715344dff"},{"@graph":[{"@id":"_:86b1bad0f9939bd0cf6d99ad63196a7a0111a00a16d7e064870eae1d4962a499_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/oc-obs-currentspeed/OF.PointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs-currentspeed/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs-currentspeed/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:86b1bad0f9939bd0cf6d99ad63196a7a0111a00a16d7e064870eae1d4962a499_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/ede5f8c0-2379-11ed-832f-911b23582b4f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/oc-obs-currentspeed/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter strömhastighet. Tjänsten visar alla stationer som någonsin levererat data för denna parametrar. Insamlade från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"ede5f8c0-2379-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Strömhastighet: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:86b1bad0f9939bd0cf6d99ad63196a7a0111a00a16d7e064870eae1d4962a499"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/69c466b6-185d-498f-8a38-684d42c03da5","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://api.lantmateriet.se/tyngdkraft-nedladdning/atom/v1"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten visar detaljmätta tyngdkraftspunkter i Sverige från Lantmäteriets grunddatalager. Tjänsten uppfyller kraven för Inspire."},"dct:identifier":"69c466b6-185d-498f-8a38-684d42c03da5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Tyngdkraft Nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:86f01ac21d8c88678a464251196941d9417f15aa6f71f3edc98207e0fb14ddc0"},{"@graph":[{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sveriges geologiska undersökning (SGU) bedriver en maringeologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål.\nI samband med maringeologisk kartläggning längs Västernorrlands kust utvecklade SGU en metod för att kartlägga och undersöka fiberhaltiga sediment, metoden finns redovisad i SGU-rapport 2011:04. Hittills har tre undersökningar genomförts i bottenområden i anslutning till trä-, pappers- och massaindustrier. Resultaten från dessa finns redovisade i SGU-rapport 2014:16, SGU-rapport 2016:21 samt SGU maringeologi rapport2017:2. En kortare summering av det nationella kunskapsläget avseende fiberhaltiga sediment finns i SGU-rapport 2017:07.\nMaringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (hydroakustisk profilering) samt bottenyteavbildande mätningar (hydroakustisk yttäckning).\nBottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden.\nFiberhaltiga sediment genererar speciella hydroakustiska signaturer. Dessa signaturer orsakas av innehållet av material från träfibrer och ofta även gas. Gasen bildas i samband med den rötning som uppstår när det organiska träfibermaterialet bryts ner under syrefria förhållanden. Gasen orsakar gasavgångshål eller gaskratrar som ofta syns tydligt i den bottentopografiska modellen. Gas orsakar liksom även trä och träfiber, en dämpning, reflektion och refraktion av den utsända ljudpulsen så att en så kallad utsläckning kan uppstå. Gas har också en lägre ljudhastighet än vatten vilket gör att den reflekterade ljudpulsen blir reverserad. Dessa signaturer kan därigenom användas för att indikera potentiell utbredning av fibersediment, en utbredning som sedan måste bekräftas, justeras eller förkastas med hjälp av sedimentprovtagning. Metoden finns utförligt beskriven i SGU-rapport 2011:04."}},{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.708791185733 65.818961595237,23.333204956634 65.818961595237,23.333204956634 60.923896137312,13.708791185733 60.923896137312,13.708791185733 65.818961595237))"}},{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2016"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2010"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e1144b78-5f4d-4a0c-be9b-c42a82a6349f","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0016c096-ed5d-4db7-949a-6581115f5069"},{"@id":"urn:uuid:4660c6bf-5afe-6767-a07f-81d71d8fe5ff"},{"@id":"urn:uuid:8d72f76a-5f01-aaa4-5ed8-c36e1987e7c8"},{"@id":"urn:uuid:9de2c2b4-186c-8f32-57b8-598ce7d4327b"},{"@id":"urn:uuid:bd2fe348-9fa5-aed8-c4f2-830aadb94ba0"},{"@id":"urn:uuid:de8c4d53-b75e-e083-a320-152e0ed46f26"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Fiberhaltiga sediment innehåller uppgifter om utbredning av fiberhaltiga sediment inom utvalda områden av svenska kust- och sjöbottnar. Fiberhaltiga sediment innehåller antropogent/industriellt bearbetade träfibrer, framför allt massafibrer för pappers- eller boardtillverkning. Dessa material innehåller vanligtvis stora mängder metaller och organiska föroreningar som kan vara ett problem för organismer i hav och sjöar.\n\nKarteringen har resulterat i ytor som är uppdelade i fem olika klasser, fiberbank, fiberrikt sediment, trä- och barkflis, fyllning samt fiberfattigt eller fiberfritt område."},"dct:identifier":"e1144b78-5f4d-4a0c-be9b-c42a82a6349f","dct:issued":{"@type":"xsd:date","@value":"2018-08-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b1n0"},"dct:temporal":{"@id":"_:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078_b2n0"},"dct:title":{"@language":"sv","@value":"Fiberhaltiga sediment"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0016c096-ed5d-4db7-949a-6581115f5069","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/fiberhaltiga-sediment-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:4660c6bf-5afe-6767-a07f-81d71d8fe5ff","@type":"dcat:Distribution","dcat:accessU