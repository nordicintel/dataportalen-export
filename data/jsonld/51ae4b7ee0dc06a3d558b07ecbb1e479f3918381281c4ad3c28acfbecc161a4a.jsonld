},"dct:identifier":"5ffa0655-239f-4de0-8b6c-969dbae02de5","dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:644891f36807aa9548d71c1b2664ccde3c46071c8d633aee04be6c6227c2c80e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:644891f36807aa9548d71c1b2664ccde3c46071c8d633aee04be6c6227c2c80e_b1n0"},"dct:title":{"@language":"sv","@value":"Fysisk påverkan i svenska kustvatten 1960 och framåt: Vågexponering"}},{"@id":"urn:uuid:07cb0e58-3afb-7ad5-fb4b-982c5a46bcb8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-vagexponering/fysisk-paverkan-kust-vagexponering-2021-10-01.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Datapaket: Vågexponering"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:644891f36807aa9548d71c1b2664ccde3c46071c8d633aee04be6c6227c2c80e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"}],"@id":"urn:source:644891f36807aa9548d71c1b2664ccde3c46071c8d633aee04be6c6227c2c80e"},{"@graph":[{"@id":"_:64864e66144da46bf6baa918387a213a08786cbf49350230a9a9ea003763caa1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtagen enligt förordning (2009:956) om översvämningsrisker 2018"}},{"@id":"_:64864e66144da46bf6baa918387a213a08786cbf49350230a9a9ea003763caa1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"https://www.geodata.se/resources/e021cfa6-9cb5-49c5-a7cf-c0c815f3dfa2","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:174cebaa-50c3-1d84-9117-9108e06a9741"},{"@id":"urn:uuid:2e0ffd54-0b28-8332-ccf6-b202b9e2abe8"},{"@id":"urn:uuid:94072e7f-c320-930b-851d-3203ff9a6c9e"},{"@id":"urn:uuid:99d917e0-087c-1f4f-1e20-ea4abb3816f1"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Områden redovisas som ett punktobjekt och visar historiska översvämningar (PFRA) som MSB använt vid revidering av steg 1, identifiering av områden med betydande översvämningsrisk (APSFR) enligt förordningen om översvämningsrisker (SFS 2009:956).\nDatamängden visar översvämningar som har inträffat för Sveriges områden med betydande översvämningsrisk enligt förordningen (SFS 2009:956) om översvämningsrisker. Områdena redovisas endast som ett punktobjekt och inte utbredningen för området. Mer information finns att läsa på https://www.msb.se/sv/amnesomraden/skydd-mot-olyckor-och-farliga-amnen/naturolyckor-och-klimat/oversvamning/oversvamningsdirektivet/"},"dct:identifier":"e021cfa6-9cb5-49c5-a7cf-c0c815f3dfa2","dct:issued":{"@type":"xsd:date","@value":"2019-08-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-08-23"},"dct:provenance":{"@id":"_:64864e66144da46bf6baa918387a213a08786cbf49350230a9a9ea003763caa1_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:64864e66144da46bf6baa918387a213a08786cbf49350230a9a9ea003763caa1_b1n0"},"dct:title":{"@language":"sv","@value":"PFRA - områden med historiska översvämningar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:174cebaa-50c3-1d84-9117-9108e06a9741","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/pfra/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst för PFRA"}},{"@id":"urn:uuid:2e0ffd54-0b28-8332-ccf6-b202b9e2abe8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_PFRA.xml"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av MSB:s PFRA inom översvämningsdirektivet i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:94072e7f-c320-930b-851d-3203ff9a6c9e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/InspireMSB_pfra.zip"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av MSB:s PFRA inom översvämningsdirektivet i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:99d917e0-087c-1f4f-1e20-ea4abb3816f1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/pfra/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst pfra OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:64864e66144da46bf6baa918387a213a08786cbf49350230a9a9ea003763caa1"},{"@graph":[{"@id":"_:6533111571a6afe530b6df38b0a47dd4820ae540bb11e28363e68ecbdf302ac7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://gis.sgi.se/dokument/geodatasezip/stabilitetsberakningspaketet_innehåll.xls"}},{"@id":"_:6533111571a6afe530b6df38b0a47dd4820ae540bb11e28363e68ecbdf302ac7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.87 58.36,12.39 58.36,12.39 57.73,11.87 57.73,11.87 58.36))"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/9f84fc51-ff39-4528-ba78-f8a69c61e63f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:272d50e1-a4c0-a33f-7647-1ba6d8e1046c"},{"@id":"urn:uuid:a64a9820-12e9-72b7-77d2-1929d9ec443a"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Utredd sektion (reviderad juni 12) med länkar till utförda stabilitetsberäkningar och CAD sektionsritningar. (262 sektioner). Se vidare https://gis.sgi.se/dokument/geodatasezip/stabilitetsberakningspaketet_innehåll.xls och respektive Tekniskt PM och MUR Markundersökningsrapport.\n[Geoteknik]"},"dct:identifier":"9f84fc51-ff39-4528-ba78-f8a69c61e63f","dct:issued":{"@type":"xsd:date","@value":"2012-03-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:6533111571a6afe530b6df38b0a47dd4820ae540bb11e28363e68ecbdf302ac7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:6533111571a6afe530b6df38b0a47dd4820ae540bb11e28363e68ecbdf302ac7_b1n0"},"dct:title":{"@language":"sv","@value":"GÄU Göta älvutredningen: Stabilitetsberäkningar och sektionsritningar - datapaket"}},{"@id":"urn:uuid:272d50e1-a4c0-a33f-7647-1ba6d8e1046c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/borrhal_gotaalv/"},"dct:description":{"@language":"sv","@value":"Borrhål, profilritningar och stabilitetsberäkningar Göta älvdalen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:a64a9820-12e9-72b7-77d2-1929d9ec443a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_stabilitetsberakningspaketet_120801.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}}],"@id":"urn:source:6533111571a6afe530b6df38b0a47dd4820ae540bb11e28363e68ecbdf302ac7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/b5ed10be-a2b3-48f6-8815-6a2a60f02444","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_250k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden GE.Jordarter 1:250 000, Nordligaste Sverige visas i denna OGC WMS-tjänst. Lager som ingår är geologiska enheters litologi och ålder. I denna tjänst visas attribut enligt GeoSciML Lite 4.1 och med symbolisering enligt INSPIRE dataspecifikation för geologi."},"dct:identifier":"b5ed10be-a2b3-48f6-8815-6a2a60f02444","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:250 000, Nordligaste Sverige (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:6555975997e430ede897b38cd905afd70f582a0b819ba956cb7c63d65ae36806"},{"@graph":[{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sveriges geologiska undersökning (SGU) bedriver en marin¬geologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. \nMaringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (hydroakustisk profilering) samt bottenyteavbildande mätningar (hydroakustisk bottenavsökning).\n\nBottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. \nBottenyteavbildande mätningar görs med multistråleekolod, interferometrisk sonar och sidoavsökande sonar. Mätningar med multistråleekolod och interferometrisk sonar ger flygbildsliknande information om havsbotten men även vattendjup samt information om havsbottenytans struktur och hårdhet.\n\nData som samlas in med hjälp av hydroakustiska mätningar tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där direkta observationer av de geologiska förhållandena gjorts genom sedimentprovtagning och/eller visuell observation av havsbottnen med hjälp av undervattenskamera. Sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart.\n\nEfter insamling och bearbetning görs en geologisk tolkning av materialet och geologiska kartor framställs."}},{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((8.26 65.82,24.10 65.82,24.10 54.95,8.26 54.95,8.26 65.82))"}},{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1969"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/35162fca-9663-49a5-bc0d-3a3377b6274f","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3e9d577f-594c-179f-bacf-2d32f58c1f52"},{"@id":"urn:uuid:891c8b57-7f1d-00b7-3d18-090c960b6034"},{"@id":"urn:uuid:897fb087-7077-eeb0-b44b-fb1e5637eb2a"},{"@id":"urn:uuid:b616f810-9fc0-edf1-700b-8406911f0283"},{"@id":"urn:uuid:fc7512d1-9e58-9bd2-8102-ae8129fa6fe2"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Datamängden Marina sedimentprover innehåller uppgifter om sedimentprover med avseende på jordarternas beskaffenhet samt för några utvalda provplatser även ytsedimentens innehåll av utvalda grundämnen, oorganiska föreningar och organiska miljöföroreningar. Observationerna är gjorda i samband med SGUs reguljära maringeologiska kartläggning eller vid uppdrag där uppdragsgivaren har tillåtit publicering av data. \n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Den information som tas fram används som underlag för till exempel planering av- och beslut om skydd eller nyttjande av havsbottnen, vid projektering av marina anläggningsarbeten och miljöövervakning. Den utgör också ett viktigt underlag för biologiska inventeringar och Försvarsmakten."},{"@language":"sv","@value":"Informationen syftar till att tillhandahålla beskrivningar av kvalitetssäkrade sedimentprovtagningar. Dessutom tillhandahålls kvalitetssäkrade kemisk analyser på ett stort antal grundämnen såväl som på organiska miljögifter."}],"dct:identifier":"35162fca-9663-49a5-bc0d-3a3377b6274f","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b1n0"},"dct:temporal":{"@id":"_:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba_b2n0"},"dct:title":{"@language":"sv","@value":"Marina sedimentprov"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:3e9d577f-594c-179f-bacf-2d32f58c1f52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/marina-sedimentprov/marina-sedimentprov.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:891c8b57-7f1d-00b7-3d18-090c960b6034","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/marina-sedimentprov"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:897fb087-7077-eeb0-b44b-fb1e5637eb2a","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/marina-sedimentprov/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:b616f810-9fc0-edf1-700b-8406911f0283","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-maringeologi.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst.Innehåller marina sedimentprov och maringeologisk kartinformation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:fc7512d1-9e58-9bd2-8102-ae8129fa6fe2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/marina-sedimentprov-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}}],"@id":"urn:source:656ee53ee4c53dcab9a43530d2f23ff666feefb9ed8f85ac2cb0654899ced7ba"},{"@graph":[{"@id":"_:658b933073b2d0a72f0981ae25325dd61e9b6028fe86a71aae45f95acf7d419c_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ebb71680-ef34-45ba-a38b-80809aa6621b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7"},"dcat:endpointURL":{"@id":"https://urn.kb.se/resolve?urn=urn:nbn:se:naturvardsverket:diva-10881"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Här finns kartunderlag och en kartberättelse som beskriver exploateringen av Sveriges stränder 2013–2023. Kartskikten visar vilka stränder som var eller inte var exploaterade 2013, 2018 och 2023. Det finns även skikt med rutor som ger en översiktlig bild av exploateringen 2023 och även förändringen i exploateringsgrad mellan 2013 och 2023. I kartberättelsen redovisas kortfattat metodik och resultat där delar av resultatet illustreras på kartor.\n\nI rapporten Exploatering av stränder i Sverige 2013–2023 beskrivs metod och resultat mer utförligt.\n\nKarteringen redovisar resultat för stränder vid fastlandskust, havsöar, sjöar, breda vattendrag och smala vattendrag. För varje strandtyp finns tre bredder på strandzoner, 30 meter, 100 meter respektive 300 meter.\nDe variabler som används för att få ett mått på påverkan inom strandzonerna är byggnader, vägar och järnvägar. Variablerna kan antas spegla en generell exploateringsutveckling samtidigt som de är lätt tillgängliga och väl dokumenterade.\n\nI metoden läggs buffertzoner av olika storlek till variablerna. Buffertzonerna antas ge ett ungefärligt mått på hur stor yta kring variabeln som påverkas. Samtliga buffertzoner läggs sedan samman till en gemensam yta som får representera den exploaterade ytan.\n\nResultatet redovisas i form av vektordata som omfattar samtliga år, zonbredder, strandtyper och exploateringsvariabler för alla stränder i hela landet. \nResultatet redovisas även i 5*5 kilometer rutor som innehåller arealstatistik för 100 meters zonerna för samtliga strandtyper. I det ena rutskiktet redovisas andel exploaterad strandzon år 2023. Det andra rutskiktet visar förändringen mellan 2013 och 2023."},"dct:identifier":"ebb71680-ef34-45ba-a38b-80809aa6621b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering i Sverige 2013-2023"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Natur","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:658b933073b2d0a72f0981ae25325dd61e9b6028fe86a71aae45f95acf7d419c_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-natur@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Natur"}],"@id":"urn:source:658b933073b2d0a72f0981ae25325dd61e9b6028fe86a71aae45f95acf7d419c"},{"@graph":[{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Åtgärdsprogram för hotade arter och naturtyper, samt regerings satsning på våtmarker. Åtgärdsprogram för rikkärr"}},{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.588 58.5965,19.7352 58.5965,19.7352 56.7007,17.588 56.7007,17.588 58.5965))"}},{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/00ebdb12-2fc9-42fd-ad13-3f341f2fa275","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4"},"dcat:distribution":[{"@id":"urn:uuid:29d6d56a-0939-f464-6b82-8e0189b1b5be"},{"@id":"urn:uuid:c5f4a24b-857c-dad4-f27d-2d0b06030a62"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Vegetationsanalys m h a fjärranalys och AI inom potentiella rikkärr, Gotlands mellersta del"},"dct:identifier":"00ebdb12-2fc9-42fd-ad13-3f341f2fa275","dct:issued":{"@type":"xsd:date","@value":"2024-08-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-16"},"dct:provenance":{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Rikkärr vegetationsanalys mitt"}},{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Naturvårdsenheten"},{"@id":"urn:uuid:29d6d56a-0939-f464-6b82-8e0189b1b5be","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTI/LstI_rikkarr_ext/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:c5f4a24b-857c-dad4-f27d-2d0b06030a62","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.LstI_vegetationsanalys_mitt_rikkarr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:65c07cf352ffa8592a8f3d053500a3e21305026144cdce6c9c12485171b5d5e9"},{"@graph":[{"@id":"_:669419d3c81096337b533a2a62e6821b2e2091c8fb9ff58b5d2b0008acef92a9_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:669419d3c81096337b533a2a62e6821b2e2091c8fb9ff58b5d2b0008acef92a9_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/08e4da50-b14f-11ea-8f8b-197eadf2f6fe","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Denna produkt är skapad med hjälp av data från EU Copernicus Marine Services.\n\nDatamängden innehåller karta över isläget i Östersjön. Analysen är baserad på satellitdata och in-situ observationer, och är manuellt producerad i en GIS-programvara.\nDataformat är ESRI shapefil med följande attributuppsättning:\n\niceact (iskoncentration i tiondelar)\n01 - Open Water (<1/10)\n10 - 1/10\n20 - 2/10\n30 - 3/10\n40 - 4/10\n50 - 5/10\n60 - 6/10\n70 - 7/10\n80 - 8/10\n90 - 9/10\n91 - 9+/10\n92 - 10/10\n98 - Ice Free\n\nicetck (medeltjocklek i cm) \nicemax (maximal tjocklek i cm)\nicemin (minimumtjocklek i cm)\n\ntype (istyp enligt WMO standard)\n0 - Ice Free\n1 - Open Water\n2 - Very Open Ice\n3 - Open Ice\n4 - Close Ice\n5 - Very Close Ice\n6 - Consolidated Ice\n7 - Level Ice\n8 - Fast Ice\n9 - New Ice\n10 - Rotten Ice\n\ndeformatio (deformationsgrad)\n0 - No Deformation\n1 - Rafted Ice\n2 - Slightly Ridged Ice\n3 - Moderately Ridged Ice\n4 - Heavily Ridged Ice\n5 - Brash Ice Barrier\n\n\npublicatio (publikationsdatum YYYY-MM-DD hh:mm:ss)\n\nchartdate (kartans gällandedatum, YYYY-MM-DD)"},"dct:identifier":"08e4da50-b14f-11ea-8f8b-197eadf2f6fe","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.SR Analyskarta havsis: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:669419d3c81096337b533a2a62e6821b2e2091c8fb9ff58b5d2b0008acef92a9"},{"@graph":[{"@id":"_:67530eb903584783e39e32fc9e21c53397a85e99b936c192e721c396894ef223_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningtjänst HIROMB (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:67530eb903584783e39e32fc9e21c53397a85e99b936c192e721c396894ef223_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, HIROMB"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/a79b4700-944f-11ea-a966-bfa48b38ccc2","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar det geografiska området som HIROMB producerade data för.\nModellen HIROMB avvecklades december 2016 och ersattes då av NEMO. \n\nFör HIROMB täcker området hela Östersjön och Sveriges västkust (Kattegatt och Skagerrak). Den västliga gränsen går strax väster om Jyllands nordspets.\nKoordinater för området ges av hörnen:\nsydvästra            53.7N, 9.38E\nnordvästra          65.9N, 9.38E\nnordöstra            65.9N, 30.23E\nsydöstra              53.7N, 39.23E"},"dct:identifier":"a79b4700-944f-11ea-a966-bfa48b38ccc2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografisk prognosmodell, HIROMB BS01 - Historiska analysdata: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:67530eb903584783e39e32fc9e21c53397a85e99b936c192e721c396894ef223"},{"@graph":[{"@id":"_:6798a4f8ca7461ae73e98704d26317739f91879065ac8c8301d3300ad5ed556c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Fastighetsindelningen i produkten motsvarar gränserna i den digitala registerkartan. Dessa gränser har skapats under lång tid med olika metoder, vilket innebär att kvaliteten varierar. Vissa gränser på landsbygden kommer från laga skiften från mitten av 1800-talet och kan ha felmarginaler på flera meter.  Idag mäter vi in nya fastigheter med satellitpositionering som kan ha en noggrannhet på några centimeter."}},{"@id":"_:6798a4f8ca7461ae73e98704d26317739f91879065ac8c8301d3300ad5ed556c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3a506458-f9b6-4514-998a-9412289aa306","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:27b33da5-294b-045e-92e7-2299428a71e8"},{"@id":"urn:uuid:6e7b407d-57c1-fb79-8f52-46ab6ddb3ada"},{"@id":"urn:uuid:dfe2b3ea-e7de-2521-ced4-d226641be231"},{"@id":"urn:uuid:e51559b4-3621-5fdd-d199-cb4fc8206bc3"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller fastighets- och samfällighetsgeometrier i marknivå. Även fiskeområden och gränspunkter ingår."},"dct:identifier":"3a506458-f9b6-4514-998a-9412289aa306","dct:issued":{"@type":"xsd:date","@value":"2025-02-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-11"},"dct:provenance":{"@id":"_:6798a4f8ca7461ae73e98704d26317739f91879065ac8c8301d3300ad5ed556c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:6798a4f8ca7461ae73e98704d26317739f91879065ac8c8301d3300ad5ed556c_b1n0"},"dct:title":{"@language":"sv","@value":"Fastighetsindelning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:27b33da5-294b-045e-92e7-2299428a71e8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetsindelning-nedladdning-vektor-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Fastighetsindelning Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Fastighetsindelning Nedladdning, vektor"}},{"@id":"urn:uuid:6e7b407d-57c1-fb79-8f52-46ab6ddb3ada","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/stac-vektor/v1/collections/fastighetsindelning"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Fastighetsindelning Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till STAC nedladdningstjänst"}},{"@id":"urn:uuid:dfe2b3ea-e7de-2521-ced4-d226641be231","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.lantmateriet.se/ogc-features/v1/fastighetsindelning"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Fastighetsindelning Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida för OGC API Features"}},{"@id":"urn:uuid:e51559b4-3621-5fdd-d199-cb4fc8206bc3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetsindelning-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Fastighetsindelning Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Fastighetsindelning Direkt"}}],"@id":"urn:source:6798a4f8ca7461ae73e98704d26317739f91879065ac8c8301d3300ad5ed556c"},{"@graph":[{"@id":"_:6801ef24997247f201a718c39989510dd203e5670d78e3eb15443dd9aebf8bcf_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Jorddjupsmodellen grundas på analys av jorddjupsinformation från brunnsborrningar, undersökningsborrningar, karteringsobservationer, externa jorddjupsuppgifter, schakter och seismiska undersökningar. För att identifiera områden och platser där jordtäcket är mycket tunt eller saknas helt har information från bl.a. SGU:s jordartskartor och databaser med punktobservationer av berg använts. Jorddjupet har beräknats genom interpolering av kända jorddjupsdata. Eftersom vissa jordarter uppvisar betydligt större jorddjup än andra har jordartskartan använts som stöd vid denna interpolering. Information om sprickzoner i berggrunden har använts för att ta fram områden med speciellt stora jorddjup.\n\nSjöar har maskats bort ur den resulterande jorddjupsmodellen med hjälp av GSD-Översiktskartan.\n\nDen geometriska upplösningen för jorddjupsmodellen är 10 x 10 meter. Jorddjupen anges som heltalsuppgifter i meter. Bergytans höjd över havet levereras dock med en geometrisk upplösning på 50 x 50 meter för att begränsa filstorleken. \n\nMer information: Mer att läsa om jorddjupsmodellen finns i SGU Rapport 2014:14 Rikstäckande jorddjupsmodell (https://resource.sgu.se/produkter/sgurapp/s1414-rapport.pdf).\n\nOsäkerheten i beräkningarna ökar med avståndet till punkter med uppmätta jorddjup. Om avståndet överstiger flera hundra meter till närmaste observation är osäkerheten i det beräknade jorddjupet betydande. Underlaget som används består till viss del av bulkinlagrade punkter från Trafikverket. Dessa punkter har ej granskats individuellt och i stället har stickprovskontroller genomförts. Ställvis kan detta påverka modellens kvalitet men vi bedömer att punkterna i sin helhet tillför ökad kvalitet till jorddjupsmodellen.\n\nI områden där moderna jordartskartor saknas har Jordarter 1:750 000 Mittnorden och Jordarter 1:1 miljon utnyttjats. Den har avsevärt sämre upplösning vilket avspeglas i den resulterande jorddjupsmodellen i dessa områden. En täckningskarta med utnyttjade jordartskartor medföljer leveransen."}},{"@id":"_:6801ef24997247f201a718c39989510dd203e5670d78e3eb15443dd9aebf8bcf_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/86ad0f3f-8559-496f-9724-275bc1d69066","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:13353924-a42a-d1b3-7e47-f1fec4d522db"},{"@id":"urn:uuid:6c780333-a186-df6c-83a7-9c50bca9fe1f"},{"@id":"urn:uuid:885c66a7-f272-9945-80a0-f6894e0938aa"},{"@id":"urn:uuid:c2bf6991-3f64-7eaf-8e8b-a23ee190fb5c"},{"@id":"urn:uuid:d707e290-7c7a-809d-72e9-a90b554e40f8"},{"@id":"urn:uuid:d8a78f40-ee08-0743-d698-d08e4ea6da4b"},{"@id":"urn:uuid:e7702af5-fa52-f111-ed2b-24f1fe40f08c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Jorddjupet har stor betydelse inom en rad olika\n                                        områden. Några exempel är planering av olika typer av\n                                        byggande, infrastruktur och\n                                        grundvattenskydd."},{"@language":"sv","@value":"Jorddjupsmodellen ger en mycket översiktlig bild av jordtäckets mäktighet. Jorddjupet har beräknats genom interpolering av kända jorddjupsdata, inhämtade genom exempelvis borrningar. Som stöd i interpoleringen mellan observationspunkter har bl.a. yttäckande jordartsinformation använts.\n\nJorddjupet har stor betydelse inom en rad olika områden. Några exempel är planering av olika typer av byggan¬de, infrastruktur och grundvattenskydd. I en sådan planering ingår bl.a. att finna lämpliga tekniska lösningar och kostnadsberäkningar beroende av jorddjupet. I många fall vill man undvika stora jorddjup, till exempel för att undvika höga kostnader i samband med borrning. I andra fall är stora jorddjup en fördel, exempelvis för att jordlagren har en stor magasinerande förmåga för grundvatten. Vidare är jorddjupsdata tillsammans med uppgift om jordart viktiga vid hydrologisk modellering."}],"dct:identifier":"86ad0f3f-8559-496f-9724-275bc1d69066","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:6801ef24997247f201a718c39989510dd203e5670d78e3eb15443dd9aebf8bcf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:6801ef24997247f201a718c39989510dd203e5670d78e3eb15443dd9aebf8bcf_b1n0"},"dct:title":{"@language":"sv","@value":"Jorddjupsmodell"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:13353924-a42a-d1b3-7e47-f1fec4d522db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jorddjupsmodell?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:6c780333-a186-df6c-83a7-9c50bca9fe1f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-jorddjup.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:885c66a7-f272-9945-80a0-f6894e0938aa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jorddjupsmodell/jorddjupsmodell.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:c2bf6991-3f64-7eaf-8e8b-a23ee190fb5c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jorddjupsmodell-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:d707e290-7c7a-809d-72e9-a90b554e40f8","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jorddjupsmodell/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:d8a78f40-ee08-0743-d698-d08e4ea6da4b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jorddjupsmodell/wcs?service=WCS&request=GetCapabilities&version=2.0.1"},"dct:title":{"@language":"sv","@value":"Capabilitiesdokument OGC Web Coverage Service"}},{"@id":"urn:uuid:e7702af5-fa52-f111-ed2b-24f1fe40f08c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/produkter/sgurapp/s1414-rapport.pdf"},"dct:description":{"@language":"sv","@value":"Mer att läsa om jorddjupsmodellen finns i SGU Rapport 2014:14 Rikstäckande jorddjupsmodell (https://resource.sgu.se/produkter/sgurapp/s1414-rapport.pdf)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU Rapport 2014:14 Rikstäckande jorddjupsmodell"}}],"@id":"urn:source:6801ef24997247f201a718c39989510dd203e5670d78e3eb15443dd9aebf8bcf"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/96a317fb-3d5d-4acb-8ec5-c713b9438a4c","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik per km ruta( 1x1 km). Data innehåller totalbefolkning, könsindelat samt 5-årsklasser. Statistiken finns från 2015-12-31 till 2025-12-31. Nationella data ej INSPIRE.\n\nStatistik för flera år och med andra grupperingar kan beställas från SCB på uppdragsbasis."},"dct:identifier":"96a317fb-3d5d-4acb-8ec5-c713b9438a4c","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Befolkningsstatistik på km-ruta WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:68f811b7d4bc75280a00234bacc19f2ee36bbca422d04625621d6c8c8f8a5421"},{"@graph":[{"@id":"_:693ca12111609feb3d793534b91380b5bb88857638e1939b84068dffa3c5f684_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Över Sverige används information från produkten Topografi 50 Nedladdning, vektor från Lantmäteriet samt delar av Topografi 10 Nedladdning, vektor. Höjdpunkter och höjdkurvor har genererats ur produkten Markhöjdmodell Nedladdning.  Information över grannländerna har hämtats från respektive land. För Sverige, Norge, Danmark och Finland används ENC (Electronic Navigational Chart) över kust och större insjöar."}},{"@id":"_:693ca12111609feb3d793534b91380b5bb88857638e1939b84068dffa3c5f684_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/e02ca3bb-f042-481f-8c67-22471a6db823","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:054efcff-b4a3-ab8c-0f3e-2d0eeeb5bb19"},{"@id":"urn:uuid:95b21f57-bdd8-81c0-661c-2ddbb1308092"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten är Försvarsmaktens sverigetäckande topografisk fältkarta i skala 1:50 000. NMK står för Nationell militär karta. Produkten finns i tre versioner: tryckfiler för att trycka papperskartor, georefererade rasterbilder för användning i olika programvaror, och utskriftsfiler för A3-färgskrivare."},"dct:identifier":"e02ca3bb-f042-481f-8c67-22471a6db823","dct:issued":{"@type":"xsd:date","@value":"2025-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-01"},"dct:provenance":{"@id":"_:693ca12111609feb3d793534b91380b5bb88857638e1939b84068dffa3c5f684_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:693ca12111609feb3d793534b91380b5bb88857638e1939b84068dffa3c5f684_b1n0"},"dct:title":{"@language":"sv","@value":"NMK50 Nedladdning"}},{"@id":"urn:uuid:054efcff-b4a3-ab8c-0f3e-2d0eeeb5bb19","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/stac-karta/v1"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för NMK50 Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till STAC nedladdningstjänst"}},{"@id":"urn:uuid:95b21f57-bdd8-81c0-661c-2ddbb1308092","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/nmk50-nedladdning-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för NMK50 Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för NMK50 Nedladdning"}}],"@id":"urn:source:693ca12111609feb3d793534b91380b5bb88857638e1939b84068dffa3c5f684"},{"@graph":[{"@id":"_:6947c44a4cea93db6704ea8a0bc91a65e5132061c68c66db9e0fdc2fead3d73d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:6947c44a4cea93db6704ea8a0bc91a65e5132061c68c66db9e0fdc2fead3d73d_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/04bd6fcd-3327-4da3-a533-82f5060b7486","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaSumpskog/MapServer/WmsServer?"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"WMS-tjänst som visualiserar Sumpskogar inventerade av Skogsstyrelsen"},"dct:identifier":"04bd6fcd-3327-4da3-a533-82f5060b7486","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"HB.Sumpskogar inventerade av Skogsstyrelsen.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6947c44a4cea93db6704ea8a0bc91a65e5132061c68c66db9e0fdc2fead3d73d_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:6947c44a4cea93db6704ea8a0bc91a65e5132061c68c66db9e0fdc2fead3d73d_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:6947c44a4cea93db6704ea8a0bc91a65e5132061c68c66db9e0fdc2fead3d73d"},{"@graph":[{"@id":"_:696ff4021cc765cc4c54852eb7897112e5be6c5c321af0f520d3ea4db87f1b0f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"I och med en uppdatering 2021 har processen för framtagandet av modellen förbättrats, primärt beroende på nyare datorer och uppdaterade programvaror. Detta har föranlett möjligheten att köra modellen med högre upplösning på indata (Lantmäteriets nationella höjdmodell). Resultatet är att aktsamhetsområden generellt blir något mindre i samband med att noggrannheten ökar.\n\nFör en utförligare beskrivning av datakvalitet, se aktuell produktbeskrivning https://resource.sgu.se/dokument/produkter/fiberhaltiga-sediment-beskrivning.pdf.\n\nAktsamhetsområden - Strandnära\nAnalysen kompletterar den lutningsbaserade analysen och bygger på att avstånd till närmaste strandlinje är minst 50 m, att området ligger under högsta kustlinjen (HK, högsta havsnivån sedan inlandsisen drog sig tillbaka) och att det inte är jordarten berg eller morän. Vattenytor med storlek mindre än 10 000 m2 har inte inkluderats i analysen.\n\nAktsamhetsområden – Efterarbetad lutningsanalys\nAlgoritmen har utvecklats av Ari Tryggvason vid Uppsala universitet med ekonomiskt stöd från SGU (Tryggvason m. fl., 2014). Produkten omfattar områden som täcks av SGUs jordartskartor i skala \n\n1:25 000–1:100 000 och Lantmäteriets nationella höjdmodell (GSD-Höjd Grid2+). Denna produkt är en vidareutveckling av beräkningsalgoritmen (Tryggvason m. fl., 2014) som utifrån jordartstyp, terrängmodell och kritisk lutning definierar markområden med finkornig jordart som har förutsättningar för jordskred.\n\nGenom en serie GIS-analyser (postprocessering) har de vanligaste systematiska felen minimerats. GIS-analyserna innefattar buffring av berg och morän (10-30m beroende på karteringsmetodik), filtrering av små områden (< 1000m2) och sammanslagning av två olika körningar av algoritmen."}},{"@id":"_:696ff4021cc765cc4c54852eb7897112e5be6c5c321af0f520d3ea4db87f1b0f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.213159496033 65.161399424304,21.460658877243 65.161399424304,21.460658877243 55.179249144957,11.213159496033 55.179249144957,11.213159496033 65.161399424304))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/092925e2-12bd-4943-95c8-2476809987ff","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:4c7d5581-157b-b2e8-ba7c-6fce3d877a17"},{"@id":"urn:uuid:7a54acec-fa36-12b4-663c-67918d4baa40"},{"@id":"urn:uuid:7faff744-43dd-e47d-6485-85c59e68eb0a"},{"@id":"urn:uuid:9722c5e6-d9f8-6412-d3b4-ce28add2f6eb"},{"@id":"urn:uuid:b8ac3599-f86c-5c91-d43a-f623b9e56be4"},{"@id":"urn:uuid:be8d42af-cae2-ebdd-9c79-2925f9778dc7"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Informationen är tänkt att användas i tidigt planeringsskede för att identifiera områden där skredfara kan förekomma och där ytterligare bedömningar/undersökningar kan behöva göras."},{"@language":"sv","@value":"Produkten ger översiktlig information om förutsättningar för jordskred i finjord. Informationen är tänkt att användas i tidigt planeringsskede för att identifiera områden där skredfara kan förekomma och där ytterligare bedömningar/undersökningar kan behöva göras.\n\nInformationen är avsedd för användning endast i områden med finkorniga jordarter (främst lera och silt). Således ger den inte någon information om förutsättningar för skred i områden med morän (vilka beroende på kornstorlekssammansättningen kan ha egenskaper som är potentiellt skredkänsliga). Detta gäller framförallt områden i fjällnära miljö där sluttningar är branta och moränens kornstorlek ställvis finkornig. Denna produkt kan därför ge en missvisande bild i dessa huvudsakligen fjällnära områden.\n\nInformationen bygger på en beräkningsalgoritm (Tryggvason m. fl., 2014) som utifrån jordartstyp (enligt SGUs produkt Jordarter 1:25 000 - 1:100 000), terrängmodell (Lantmäteriets nationella höjdmodell) och kritisk lutning (1:10 = 5,7 grader = 10%) definierar markområden med finkornig jordart som har förutsättningar för jordskred. \n\nDessa områden har sedan bearbetats ytterligare i GIS-miljö för att minimera systematiska fel. Det slutgiltiga resultatet kallas i denna produkt aktsamhetsområden. \n\nEtt lerlagers skredbenägenhet beror inte bara på marklutning, utan även på dess tekniska egenskaper. Metoden tar inte hänsyn till detta utan betraktar alla jordlager av viss jordartstyp (främst silt och lera) som skredkänsliga vid viss marklutning. Detta innebär att inom många av de identifierade aktsamhetsområdena är lerornas egenskaper sådana att någon risk för skred knappast föreligger, trots att lutningskriteriet är uppfyllt.\nSom komplement till modelleringen baserad på lutningsanalys innehåller produkten även en enklare GIS-analys i huvudsak baserad på närhet till vatten. \n\nGrundläggande geoteknisk/geologisk kompetens är nödvändig för att kunna tolka informationen på ett riktigt sätt."}],"dct:identifier":"092925e2-12bd-4943-95c8-2476809987ff","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-19"},"dct:provenance":{"@id":"_:696ff4021cc765cc4c54852eb7897112e5be6c5c321af0f520d3ea4db87f1b0f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:696ff4021cc765cc4c54852eb7897112e5be6c5c321af0f520d3ea4db87f1b0f_b1n0"},"dct:title":{"@language":"sv","@value":"Förutsättningar för skred i finkornig jordart"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:4c7d5581-157b-b2e8-ba7c-6fce3d877a17","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/forutsattningar-skred-finkornig-jordart/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:7a54acec-fa36-12b4-663c-67918d4baa40","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-forutsattning-for-jordskred.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:7faff744-43dd-e47d-6485-85c59e68eb0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/forutsattning-skred-finkornig-jordart"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:9722c5e6-d9f8-6412-d3b4-ce28add2f6eb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/forutsattningar-skred-finkornig-jordart-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:b8ac3599-f86c-5c91-d43a-f623b9e56be4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-forutsattning-for-jordskred.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:be8d42af-cae2-ebdd-9c79-2925f9778dc7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/forutsattningar-skred-finkornig-jordart/forutsattningar-skred-finkornig-jordart.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:696ff4021cc765cc4c54852eb7897112e5be6c5c321af0f520d3ea4db87f1b0f"},{"@graph":[{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.01343 66.8429,23.24347 66.8429,23.24347 55.89555,12.01343 55.89555,12.01343 66.8429))"}},{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/b8bbb27b-4aa5-4244-aeea-6c76f868d109","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:1da15c83-bdaa-9a9d-c440-901a78b82de8"},{"@id":"urn:uuid:7e5a46f0-fd83-2a06-b782-1f6ac7fa1922"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samtliga knickpoints och knickzones som finns inlagda i Nationella Biotopkarteringsdatabasen.\nVarje knickpoint och knickzone ligger på en biotopkarterad sträcka med ett protokoll A.\n\nEn knickpoint eller knickzone är en punkt eller kortare sträcka med en tydlig förändring i bottenlutning eller bottennivå i likhet med\nett vattenfall.\nSkiktet innehåller bara mänskligt orsakade knickpoints och knickzones. Naturliga fall räknas inte som knickpoints eller knickzones.\n\nKoordinater för knickpointen eller knickzonen ligger inlagda som punktobjekt. Varje objekt har en punkt.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till det Protokoll A som den objektet ligger inlagd på.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"b8bbb27b-4aa5-4244-aeea-6c76f868d109","dct:issued":{"@type":"xsd:date","@value":"2021-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b0n0"},{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Knickpoints och Knickzones - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:1da15c83-bdaa-9a9d-c440-901a78b82de8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.Biotop_Knickpoints_Knickzones.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:7e5a46f0-fd83-2a06-b782-1f6ac7fa1922","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}}],"@id":"urn:source:69785c9d5f59981c10cf334406e63f7aa1a81c433869869b8744dfb7e6a6fb2a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a411205e-4e5c-4c58-8247-8d40cda0bf92","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Berggrund_1M"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden GE.Berggrund 1:1 miljon täckande hela Sverige visas i denna OGC WMS-tjänst. Lager som ingår är geologiska enheters litologi och ålder, samt förkastningar. I denna tjänst visas attribut enligt GeoSciML Lite 4.1 och med symbolisering enligt INSPIRE dataspecifikation för geologi."},"dct:identifier":"a411205e-4e5c-4c58-8247-8d40cda0bf92","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Berggrund 1:1 miljon (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:6b29d4973ed0e0acb545accc1c0c0c885872fd8bb8a06888315bc7d28f54b5c4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021006537","@type":"foaf:Agent","dct:identifier":"2021006537","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ivo.se"},"foaf:name":{"@language":"sv","@value":"Inspektionen för vård och omsorg"},"foaf:page":{"@id":"https://www.ivo.se"}},{"@id":"https://www.geodata.se/resources/1e3aa127-c497-4908-ad64-7d48e1f8513d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://ivo.metria.se/geoserver/ivo/ows?layers=US.childCareService,US.housing,US.outpatientService"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"---sammanfattning"},"dct:identifier":"1e3aa127-c497-4908-ad64-7d48e1f8513d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006537"},"dct:title":{"@language":"sv","@value":"US.AdministrativaOchSocialaOffentligaTjänster.IVO.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:6b49e92a55ece93f11a01973286f28177bb7380652d48cd649349570e3f06f10"},{"@graph":[{"@id":"_:6b7e3d3bbc13bf1881e2bf1e642c7c84cf19bc3bddcc22222e10498641af6c82_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU påbörjade under 2014 ett tvåårigt projekt för att skanna 200 000 meter borrkärna från Norrbotten och Västerbotten. Skanningsprojektet har som mål att skapa en databas med optiska och infraröda data som ett komplement till de fysiska borrkärnor som finns i SGU:s arkiv i Malå. Skanningen utförs av tjänsteleverantörerna SPECIM, Spectral Imaging Ltd. och GeoSpectral Imaging Ltd. I projektet ingår fotografering med högupplöst optisk kamera samt infraröd avbildning (eng. hyperspectral infrared core imaging). \n\nDen infraröda avbildningen är en passiv, icke-förstörande analysteknik som utnyttjar mineralens förmåga att reflektera och absorbera olika våglängder av det elektromagnetiska spektrumet. Kamerorna i skannern täcker det synliga spektrumet, samt den kortvågiga (VNIR-SWIR) och långvågiga (LWIR) delen av det infraröda. Mineralen som utgör beståndsdelarna i borrkärnan ger ofta karakteristiska signaturer i dessa våglängdsintervall och kombinationen av kortvågig och långvågig IR ger ett dataset som har stor potential för mineralidentifikation. VNIR-SWIR-kameran är till exempel särskilt lämpad för att ge mineralogisk information om ler- och omvandlingsmineral och karbonater, medan LWIR-kameran kan ge information om vanliga silikatmineral som kvarts och fältspat. Under skanningen produceras också en högupplöst optisk bild.\n\nDen borrkärneskanner som använts är sisuRock. SisuRock är en automatiserad hyperspektral skanner som kan skanna hela borrkärnelådor. Rådata är oprocesserade bilder och spektraldata som insamlats under skanningsprocessen. Dessa data har inte genomgått någon vidare processering (ingen datakorrektion eller normalisering), förutom grundläggande kvalitetskontroll som är genomfört under skanningsprocessen för att säkerställa att data är komplett och korrekt insamlat.\n\nRådata (nivå 0) har inte genomgått dataprocessering, men grundläggande kvalitetskontroll under skanningsprocessen är genomfört för att säkerställa att data är komplett och korrekt insamlat. Detta inkluderar: \n•\tCheck och kvalitetskontroll av bilddata \n•\tKvalitetskontroll av kalibreringsfiler \n•\tKvalitetskontroll av filnamn och filformat\n•\tGenomgång av metadata för att säkerställa att skanningsdata är korrekt"}},{"@id":"_:6b7e3d3bbc13bf1881e2bf1e642c7c84cf19bc3bddcc22222e10498641af6c82_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.41 68.92,22.86 68.92,22.86 56.69,11.41 56.69,11.41 68.92))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/1f68a843-92e3-4abd-8adf-7a8916b62a0b","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:36abcc19-dbeb-e2fb-b9b9-b97109db726a"},{"@id":"urn:uuid:3d371290-4f38-9424-fd51-bf44992318fe"},{"@id":"urn:uuid:4760dbea-c6b3-d8bf-b203-2463fc16b5fa"},{"@id":"urn:uuid:6aa95f8f-15de-73e8-9d7b-4fcb6bfa0ae2"},{"@id":"urn:uuid:7c44a9e9-499e-d51e-4531-c081f84ec086"},{"@id":"urn:uuid:a8d00d04-4c9d-1f41-c6a1-10ba976cf452"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Rådata kan bearbetas vidare för att få fram produkt som kan användas i vidare tolkning av borrkärnans sammansättning. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling. På längre sikt kan resultaten ge ökad kunskap om malmbildningsprocesser och detta kan möjliggöra ett mer effektivt utnyttjande av landets mineralresurser. Analysdata från borrkärneskanningen kan sannolikt också användas för andra ändamål än malmprospektering som t.ex. underlag för miljöutredningar och forskning.\n\nPotentiella användare är prospekteringsbolag, gruvbolag, konsulter, forskare och studenter."},{"@language":"sv","@value":"Tillhandahållande:\nProdukten tillhandahålls som komprimerade zip-filer med data per borrhål. Länkar till de nedladdningsbara filerna kommer du åt via SGU:s produkt Borrhål, antingen genom att ladda ner borrhål som en förpaketerad GeoPackage-databas för användning i en GIS-klient, eller genom direktåtkomst via ett API.\n\nHär kan du läsa mer om produkterna Borrhål och Hyperspektral IR\nhttps://www.sgu.se/produkter-och-tjanster/geologiska-data/malmer-och-mineral--geologisk-data/borrkarnor-och-borrhal/\n\nBeskrivning:\nHyperspektral IR, data från borrkärnor (rådata, nivå 0) består dels av bilder tagna med högupplöst optisk kamera, dels av infraröda bilder. Data har tagits fram genom att borrkärnor från SGU:s arkiv har skannats och analyserats med avseende på mineralens förmåga att reflektera och absorbera olika våglängder av det elektromagnetiska spektrumet.\n\nKamerorna i skannern täcker det synliga spektrumet, samt den kortvågiga och långvågiga delen av det infraröda (IR) spektrumet. Mineralen som utgör beståndsdelarna i borrkärnan ger ofta karakteristiska signaturer i dessa våglängdsintervall och kombinationen av kortvågig och långvågig IR ger ett dataset som har stor potential för mineralidentifikation. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling.\n\nInformationen består av rådata, dvs. den har inte genomgått någon vidare processering (ingen datakorrektion eller normalisering).\n\nRådata kan bearbetas vidare för att få fram produkt som kan användas i vidare tolkning av borrkärnan sammansättning. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling. På längre sikt kan resultaten ge ökad kunskap om malmbildningsprocesser och detta kan möjliggöra ett mer effektivt utnyttjande av landets mineralresurser. Analysdata från borrkärneskanningen kan sannolikt också användas för andra ändamål än malmprospektering som till exempel underlag för miljöutredningar och forskning.\n\nPotentiella användare är prospekteringsbolag, gruvbolag, konsulter, forskare och studenter."}],"dct:identifier":"1f68a843-92e3-4abd-8adf-7a8916b62a0b","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:6b7e3d3bbc13bf1881e2bf1e642c7c84cf19bc3bddcc22222e10498641af6c82_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:6b7e3d3bbc13bf1881e2bf1e642c7c84cf19bc3bddcc22222e10498641af6c82_b1n0"},"dct:title":{"@language":"sv","@value":"Hyperspektral IR, data från borrkärnor (rådata, nivå 0)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:36abcc19-dbeb-e2fb-b9b9-b97109db726a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/geologiska-data/malmer-och-mineral--geologiska-data/borrkarnor-och-borrhal/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om borrhål och borrkärnor"}},{"@id":"urn:uuid:3d371290-4f38-9424-fd51-bf44992318fe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:4760dbea-c6b3-d8bf-b203-2463fc16b5fa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:6aa95f8f-15de-73e8-9d7b-4fcb6bfa0ae2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hyperspektral-ir-niva-0-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:7c44a9e9-499e-d51e-4531-c081f84ec086","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hyperspektral-ir-level-0-description-eng.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Product description"}},{"@id":"urn:uuid:a8d00d04-4c9d-1f41-c6a1-10ba976cf452","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/borrkarnor"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst"}}],"@id":"urn:source:6b7e3d3bbc13bf1881e2bf1e642c7c84cf19bc3bddcc22222e10498641af6c82"},{"@graph":[{"@id":"_:6bd29f239060f6d4a956da09410d1a8ef2fdbb483c63ce9e48d17aa73acfa145_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Utvalda berggrundshällar har besökts för dokumentation och provtagning. Berggrunden på provtagningsplatsen har beskrivits med avseende på dess mineralogi, strukturer och texturer m.m. Analyser av Los Angelesvärde (LA), kulkvarnsvärde (AN), microDeval-värde (MDE), korndensitet (ρ), tunnslip, petrofysik m.m. har gjorts. Berggrundens strålning har mätts i fält med en spektrometer.\n\nEn klassning av analysmaterialet har gjorts på de mest kritiska kravsatta egenskaperna som är relevanta för respektive användningsområde (se vidare i t.ex. Ballast för asfaltmassor och tankbeläggningar för vägar, flygfält och andra trafikerade ytor [SS-EN 13043], Ballast för betong [SS-EN 12620] och Makadamballast för järnväg [SS-EN 13450]).\n\nBergkvalitetskartering har i första hand utförts i Sveriges tätortregioner såsom Stockholm, Mälardalen, Avesta, Falun, Göteborg, Uddevalla, Stenungsund, Trollhättan, Borås, Varberg, Falkenberg, Linköping, Södertälje, Nyköping, Skåne, Uppsala, Gävle, Sundsvall, Umeå m.fl."}},{"@id":"_:6bd29f239060f6d4a956da09410d1a8ef2fdbb483c63ce9e48d17aa73acfa145_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.359397376215 62.75211568707,19.211157647862 62.75211568707,19.211157647862 55.486902189042,11.359397376215 55.486902189042,11.359397376215 62.75211568707))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8e1833dc-d9b9-4e9d-82a3-1274a84a916a","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:275e8132-95ce-a3cc-80cc-dc1fbefe66f6"},{"@id":"urn:uuid:9a71ec85-1e5d-01ac-f7d4-4528437782b0"},{"@id":"urn:uuid:d226fb55-1748-25ca-b292-10e709cf88f5"},{"@id":"urn:uuid:e0c33686-455c-428e-069c-d9a437d7b0c8"},{"@id":"urn:uuid:eb345286-c809-5c08-f7d4-f36a025fe0cf"},{"@id":"urn:uuid:fa457995-3c00-70fe-fb24-807fc6b513bd"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Bergkvalitet, tekniska analyser innehåller lägesuppgifter och analysresultat för prover tagna på berghällar. Det huvudsakliga ändamålet med analyserna är att underlätta en utvärdering av det bästa användningsområdet för olika bergarter, som t.ex. ballast för väg, järnväg och betong. Provresultaten kan med fördel användas av såväl prospektörer som planerare, för att få närmare information om var bra respektive dåligt bergmaterial för ballastproduktion finns."},"dct:identifier":"8e1833dc-d9b9-4e9d-82a3-1274a84a916a","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:6bd29f239060f6d4a956da09410d1a8ef2fdbb483c63ce9e48d17aa73acfa145_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:6bd29f239060f6d4a956da09410d1a8ef2fdbb483c63ce9e48d17aa73acfa145_b1n0"},"dct:title":{"@language":"sv","@value":"Bergkvalitet, tekniska analyser"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:275e8132-95ce-a3cc-80cc-dc1fbefe66f6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager. Bergkvalitetsinformation ingår bland annan information relaterad till ballast."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU Kartvisare Ballast"}},{"@id":"urn:uuid:9a71ec85-1e5d-01ac-f7d4-4528437782b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/bergkvalitet-tekniska-analyser-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:d226fb55-1748-25ca-b292-10e709cf88f5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/bergkvalitet-tekniska-analyser/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:e0c33686-455c-428e-069c-d9a437d7b0c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/service/wms/130/ballast"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:eb345286-c809-5c08-f7d4-f36a025fe0cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager. Bergkvalitetsinformation ingår bland annan information relaterad till ballast."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU Kartvisare Ballast"}},{"@id":"urn:uuid:fa457995-3c00-70fe-fb24-807fc6b513bd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/bergkvalitet-tekniska-analyser/bergkvalitet-tekniska-analyser.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:6bd29f239060f6d4a956da09410d1a8ef2fdbb483c63ce9e48d17aa73acfa145"},{"@graph":[{"@id":"_:6c8aea76181c03d2df851d40451868b8e4c54d912b98028e3da1908a89bd2eac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inte känt."}},{"@id":"_:6c8aea76181c03d2df851d40451868b8e4c54d912b98028e3da1908a89bd2eac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.038635971645 69.293574885576,24.561057154638 69.293574885576,24.561057154638 55.033102271276,10.038635971645 55.033102271276,10.038635971645 69.293574885576))"}},{"@id":"https://www.geodata.se/resources/47867c8e-bdb5-442d-8971-a4a7be0c2f6d","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:276e6ee1-f2d7-d1a4-6965-142e20c204a0"},{"@id":"urn:uuid:a1cfdce2-68cf-f8dd-32fc-e4b07b599644"},{"@id":"urn:uuid:b7e1e8de-c5da-93bc-eeed-7e052bbdb3e4"}],"dcat:keyword":"Myndigheten för civilt försvar","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"MSB har tagit fram 9 st utbredningsskikt längs hela Sveriges kust för en vattenståndsnivå från 1 m till 5 m i RH2000. En förenkling har gjorts för att underlätta hanteringen av de stora datamängderna. Det innebär att öar mindre än 5000 kvadratmeter som riskeras att översvämmas har tagits bort och illustreras därför som översvämmade vid respektive havsvattenstånd."},"dct:identifier":"47867c8e-bdb5-442d-8971-a4a7be0c2f6d","dct:issued":{"@type":"xsd:date","@value":"2023-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-10-16"},"dct:provenance":{"@id":"_:6c8aea76181c03d2df851d40451868b8e4c54d912b98028e3da1908a89bd2eac_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:6c8aea76181c03d2df851d40451868b8e4c54d912b98028e3da1908a89bd2eac_b1n0"},"dct:title":{"@language":"sv","@value":"Kustöversvämningar"}},{"@id":"urn:uuid:276e6ee1-f2d7-d1a4-6965-142e20c204a0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gisapp.msb.se/arcgis/services/Oversvamningskarteringar/kustoversvamning/MapServer/WmsServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst för kustöversvämningarna"}},{"@id":"urn:uuid:a1cfdce2-68cf-f8dd-32fc-e4b07b599644","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gisapp.msb.se/apps/oversvamningsportal/hemta-data.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdning av kustöversvämningarna i Shape-format"}},{"@id":"urn:uuid:b7e1e8de-c5da-93bc-eeed-7e052bbdb3e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gisapp.msb.se/apps/oversvamningsportal/avancerade-kartor/kustoversvamning.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sida för visning av kustöversvämningarna"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:6c8aea76181c03d2df851d40451868b8e4c54d912b98028e3da1908a89bd2eac"},{"@graph":[{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skiktet är framtaget inom ramen för projektet ”LEIF i praktiken, Levande Ekosystem I Framtiden – från teoretiskt underlag till praktisk rådgivning” och är en vidaretillämpning av metodiken BRIFUNK, som tagits fram genom projektet ” Landskapsekologisk brist- och funktionalitetsanalys för Östra Vätterbranterna”. Med BRIFUNK-metoden har tröskelvärden för hur stor areal av sin specifika levnadsmiljö olika arter kräver för att överleva i ett landskap. Även om de beräknade tröskelvärdena inte är exakta, så ger de tillräckligt god vägledning för att veta att strategin ger god naturvårdsnytta. \n\nI LEIF-projektet har tröskelvärden från BRIFUNK legat till grund för framtagande av kartor som visar på vilka landskapsavsnitt som når, eller ligger nära att nå, ekologisk hållbarhet och som därför bör prioriteras för åtgärder. Som underlag för var lämpliga torra friska naturliga gräsmarker återfinns användes gräsmarker från SJV Ängs- och betesmarksinventeringen.\n\nGenom en täthetsanalys pekades områden ut som når upp till tröskelvärden för habitatmängd, det vill säga där en tillräckligt stort areal lämpliga gräsmarker återfinns inom ett 25 kvadratkilometer stort område. Områden med tillräcklig habitatmängd visas i grönt, ju mörkare desto större habitatmängd. Gula områden visar var lämpliga habitat återfinns men i en för lite mängd för att nå upp till tröskelvärdet. Utanför gröna och gula områden har inga lämpliga habitat inventerats."}},{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.03733 58.21864,14.92106 58.21864,14.92106 57.5685,14.03733 57.5685,14.03733 58.21864))"}},{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/86ae64aa-b5ea-49c3-978e-c4ca58bb49eb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":[{"@id":"urn:uuid:5dc3aa78-dda7-c710-5fb9-cccb5a02e2ce"},{"@id":"urn:uuid:679cab30-755d-5edf-2e2d-eb7f339f7263"},{"@id":"urn:uuid:731f2bd3-aabd-fa94-40eb-db16bf72ef07"},{"@id":"urn:uuid:e70caf07-ba95-8237-d9fc-66aa5a6e982e"},{"@id":"urn:uuid:ea88a33b-a095-a6e2-27cb-91005ebc7548"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skiktet är framtaget inom ramen för projektet ”LEIF i praktiken, Levande Ekosystem I Framtiden – från teoretiskt underlag till praktisk rådgivning”. Genom en täthetsanalys pekades områden ut som når upp till tröskelvärden för habitatmängd, det vill säga där en tillräckligt stor areal torra friska naturliga gräsmarker återfinns inom ett 25 kvadratkilometer stort område för arters överlevnad i landskapet. Områden med tillräcklig habitatmängd visas i grönt, ju mörkare desto större habitatmängd. Gula områden visar var lämpliga habitat återfinns men i en för liten mängd för att nå upp till tröskelvärdet. Utanför gröna och gula områden har inga lämpliga habitat inventerats. Se tillkomsthistorik och rapport för metodik och begränsningar. OBS lyr-fil finns i nuläget inte tillgänglig för externa användare men kan skickas efter önskemål till gis.jonkoping@lansstyrelsen.se"},"dct:identifier":"86ae64aa-b5ea-49c3-978e-c4ca58bb49eb","dct:issued":{"@type":"xsd:date","@value":"2016-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-12-01"},"dct:provenance":{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b1n0"},"dct:title":{"@language":"sv","@value":"LstF Levande ekosystem i framtiden - Torra friska naturliga gräsmarker"}},{"@id":"urn:uuid:5dc3aa78-dda7-c710-5fb9-cccb5a02e2ce","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/jonkoping/GDK_dokument/2017-03-LEIF-i-praktiken.pdf"},"dct:description":{"@language":"sv","@value":"Meddelande nr 2017:03 \"LEIF i praktiken Levande Ekosystem I Framtiden – från teoretiskt underlag till praktisk rådgivning\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"2017-03-LEIF-i-praktiken.pdf"}},{"@id":"urn:uuid:679cab30-755d-5edf-2e2d-eb7f339f7263","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_2/MapServer/22"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:731f2bd3-aabd-fa94-40eb-db16bf72ef07","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_levande_ekosystem_i_framtiden_EXT/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Landenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Landenheten"},{"@id":"urn:uuid:e70caf07-ba95-8237-d9fc-66aa5a6e982e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.LstF_Levande_ekosystem_i_framtiden_TFNGrasmarker.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:ea88a33b-a095-a6e2-27cb-91005ebc7548","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_2/MapServer/WMSServer?layers=LstF_Levande_ekosystem_i_framtiden_Torra_friska_naturliga_grasmarker"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Levande_ekosystem_i_framtiden_Torra_friska_naturliga_grasmarker (WMS)"}}],"@id":"urn:source:6cde55dc6df7540228884bffa4fe35872c3b1c41487299d6374568457e7ce499"},{"@graph":[{"@id":"_:6cf4744eb7c19f6d43399f2e0ead75de06545d072c039b94cb16e3e1182e8fdb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Planer och bestämmelser är hämtade från en rad olika ursprungsmaterial. De kan t.ex. vara digitaliserade från gamla kartor eller inmätta med hög noggrannhet med GPS. Därför är innehållet av varierande kvalitet.\nDagens redovisning av planer och bestämmelser i fastighetsregistret grund-lades i samband med införandet av plan- och bygglagen 1987 och det redo-visningssystem som då infördes i fastighetsregistret."}},{"@id":"_:6cf4744eb7c19f6d43399f2e0ead75de06545d072c039b94cb16e3e1182e8fdb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/c9fd562b-9afd-4541-9a3a-7c70bf81b0a0","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:3c374e6d-54a1-17bb-53d6-52d11166ed4a"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Produkten innehåller planer och bestämmelser om markens användning från Registerkartan samt upplysningstext. Dessutom innehåller produkten fornlämningar och övriga kulturhistoriska lämningar från Riksantikvarieämbetet samt texter för lämningar."},"dct:identifier":"c9fd562b-9afd-4541-9a3a-7c70bf81b0a0","dct:issued":{"@type":"xsd:date","@value":"2021-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-29"},"dct:provenance":{"@id":"_:6cf4744eb7c19f6d43399f2e0ead75de06545d072c039b94cb16e3e1182e8fdb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:6cf4744eb7c19f6d43399f2e0ead75de06545d072c039b94cb16e3e1182e8fdb_b1n0"},"dct:title":{"@language":"sv","@value":"Markreglerande bestämmelse Nedladdning, vektor"}},{"@id":"urn:uuid:3c374e6d-54a1-17bb-53d6-52d11166ed4a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markreglerande-bestammelse-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Markreglerande bestämmelse Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Markreglerande bestämmelse Nedladdning, vektor"}}],"@id":"urn:source:6cf4744eb7c19f6d43399f2e0ead75de06545d072c039b94cb16e3e1182e8fdb"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/220ff04b-9f4c-4448-be92-416ba2fa3e30","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Demografiska statistikområden (DeSO) är en rikstäckande indelning skapad av SCB som började gälla i januari 2018. En ny version publicerades 2025.\n\nDeSO delar in Sverige i 6 160 områden där de flesta områden har en befolkning mellan 700 och 3 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering.\n\nDeSO har inte benämningar eller namn utan beskrivs med en kod med nio unika positioner. De första fyra består av läns- och kommunkoden och pekar ut det län och den kommun som området ligger i. \n\nDen femte positionen pekar ut vilken kategori som området tillhör A, B eller C. A är områden som till största del ligger utanför större befolkningskoncentrationer eller tätorter.  B är områden som till större delen ligger i befolkningskoncentrationer eller tätorter men som inte är en centralort. Kategori C är de områden som till större delen finns i kommunens centralort. \n\nDe tre efterföljande positionerna består av ett löpnummer som sorterar områdena geografiskt. Den här sorteringen utgår ifrån kategorierna och börjar i söder och fortsätter norröver. Den sista positionen är en reservplats som kommer användas i fall ett DeSO i framtiden behöver splittras. Ett DeSO kan bara förekomma på en plats."},"dct:identifier":"220ff04b-9f4c-4448-be92-416ba2fa3e30","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Demografiska statistikområden - DeSO WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:6d70e91315cfb0881ef2014155f91005999ffd90b13edacdbc0c964206446c4c"},{"@graph":[{"@id":"_:6dc015f9710ffa39e558ffd385c1bc455c63ca40a9d390dd74e55fd1643fa039_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Uppdateringen av de topografiska objekten sker dels i egen regi och dels i samverkan med de myndigheter eller organisationer som ansvarar för respektive informationsslag.\nInsamling och uppdatering hos Lantmäteriet idag görs bland annat genom stereokartering i tredimensionella flygbilder eller genom skärmdigitalisering med hjälp av ortofoto.\nSamverkan över hela landet sker för kraftledningar, NSL-objekt (Nationell strandlinje), naturvårdsområden och militära områden. För att uppnå fullständighet krävs dock kompletteringar genom fotogrammetrisk uppdatering."}},{"@id":"_:6dc015f9710ffa39e558ffd385c1bc455c63ca40a9d390dd74e55fd1643fa039_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/c5a50553-21e0-4801-bfbd-7e99c2ffc610","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:7d3f571c-323f-e6fb-451f-2d0a33c3db15"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Datamängd innehållande markytor, hydrografi, anläggningsområden, ledningar, naturvård, militära områden, höjdkurvor och text från grunddata anpassat till skalområde 1:10 000. Datamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Topografi Visning vector tiles"},"dct:identifier":"c5a50553-21e0-4801-bfbd-7e99c2ffc610","dct:issued":{"@type":"xsd:date","@value":"2008-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:6dc015f9710ffa39e558ffd385c1bc455c63ca40a9d390dd74e55fd1643fa039_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:6dc015f9710ffa39e558ffd385c1bc455c63ca40a9d390dd74e55fd1643fa039_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för topografi 1:10 000"}},{"@id":"urn:uuid:7d3f571c-323f-e6fb-451f-2d0a33c3db15","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-visning-vector-tiles-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Topografi Visning vector tiles"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografi Visning, vector tiles"}}],"@id":"urn:source:6dc015f9710ffa39e558ffd385c1bc455c63ca40a9d390dd74e55fd1643fa039"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/672ee8f6-6ef5-45ca-8b89-8a59f0256fdc","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://www.lantmateriet.se/sv/nationella-geodataplattformen/datamangder/befintliga-och-paborjade-datamangder/detaljplan/"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visningstjänst som uppfyller Inspire-direktivet för informationen planerad markanvändning (Planned Land Use inom temat Land Use). Området är Sverige. \nDataprodukten innehåller information om detaljplaner i Sverige. Det huvudsakliga syftet med  \nen detaljplan är att reglera användning av mark- och vattenområden samt bebyggelse.\nMed detaljplan avses sådan plan som beskrivs i 4 kap 2 § Plan- och bygglagen (2010:900) \n(PBL). Dataprodukten kan även innehålla de planer som har upprättats med stöd av tidigare \nlagstiftning, och som enligt PBLs övergångsbestämmelser gäller som detaljplan. Dessa är \nbyggnadsplan, stadsplan och avstyckningsplan.\nKommunen kan välja att tillgängliggöra information när som helst i detaljplaneprocessen.\nDataprodukten kan därför innehålla information som ännu inte fått laga kraft. Detaljplaner \npåbörjade innan 2022-01-01 behöver inte tillgängliggöras digitalt och kan därför saknas i \ndataprodukten.\nDetaljplaneinformation har tagits fram på kommunal nivå sedan lång tid tillbaka. Under årens \nlopp har de lagar och rekommendationer som kommunerna haft att förhålla sig till förändrats.\nOlika kommuner arbetar också med detaljplaneprocessen på olika sätt. Detta gör att \nredovisningen av detaljplaneinformation ser olika ut."},"dct:identifier":"672ee8f6-6ef5-45ca-8b89-8a59f0256fdc","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Detaljplan - visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:6df585e6810cd1db507ac62b7d6a0ce5451a52a0e9a402aa5c286d235a43e615"},{"@graph":[{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Jordarter 1:25 000–1:100 000 är en sammanslagning av de tidigare produkterna Jordarter 1:50 000 och Jordarter 1:100 000–1:200 000, förutom att områden i skala 1:200 000 överförts till en egen produkt, Jordarter 1:200 000, Västernorrland.\n\nInformationen bygger på kartläggningar som påbörjades på 1960-talet och pågår än idag. Kartläggningen har under åren utförts med olika metoder, på skiftande geografiskt underlag samt för presentationsskalor från 1:25 000 till 1:100 000. Den tidiga informationen har digitaliserats från tryckt kartunderlag. Från 1990-talet produceras data i digital miljö.  Många kartlagda områden har publicerats som tryckta kartor inom SGU:s serier Ae, Ak och K och till dessa finns ofta utgivna kartbladsbeskrivningar som innehåller kompletterande information om arbetsmetoder och geologiska förhållanden. Information om dessa beskrivningar finns på www.sgu.se.\n\nEftersom olika karteringsmetoder har tillämpats i olika områden och under olika perioder, så är produktens kvalitet inte enhetlig utan skiljer sig från område till område. Den mest detaljerad kartläggningen, som bygger på omfattande fältarbete har utförts främst i tätbefolkade områden i södra Sverige. I glest bebyggda områden har en mer översiktlig karteringsmetod, som huvudsakligen bygger på flygbildstolkning, tillämpats.  Informationens kvalitet beror också på vilket geografiskt underlag som använts vid kartläggningen.\n\nGemensamt för alla karttyper är att jordartsobservationerna i fält i huvudsak görs på ca en halv meters djup, dvs. under matjord och jordmån.  Jordartsklassificeringen grundas i huvudsak på okulär bedömning. Referensprover för jordartsanalyser tas i begränsad omfattning. Befintliga jordskärningar dokumenteras. Kompletterande schaktningar, borrningar och geofysiska mätningar utförs i mycket begränsad omfattning. Ett urval av information från externa källor, i första hand geotekniska utredningar och grundvattenutredningar ställs samman och används som underlag i kartläggningen.\n\nUppgifter om jordartsanalyser, isräfflor, jorddjup, jordlagerföljder, skred och raviner samlas också in och finns tillgängliga i andra produkter."}},{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.81 67.53,24.18 67.53,24.18 55.22,10.81 55.22,10.81 67.53))"}},{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1962"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2410c2e5-2a0e-4a47-9273-b7b77517420a","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0fdbd270-4a6f-74bb-8473-3c6af6e125a9"},{"@id":"urn:uuid:12518b25-8449-1754-d529-8c36557ecb1c"},{"@id":"urn:uuid:1abdccfc-b853-5d88-3333-4fc5d297f998"},{"@id":"urn:uuid:57c76512-344e-0ff1-fc50-faaec6056439"},{"@id":"urn:uuid:87012035-4775-2250-6d8e-ebee79103c8e"},{"@id":"urn:uuid:af7c4791-f92b-d808-9960-eb98cb8b6fe2"},{"@id":"urn:uuid:e2f84aa8-f869-0b7b-0e2f-281e68934fc4"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Jordartskartan visar jordarternas utbredning i eller nära markytan samt förekomsten av block i markytan. Jordarterna indelas efter bildningsätt och kornstorlekssammansättning. Ytliga jordlager med en mäktighet som understiger en halv till en meter samt jordlager på djupet redovisas i vissa fall. Även vissa landformer, såsom t ex moränbacklandskap, moränryggar och flygsanddyner redovisas.\nSyftet med jordartskartan är att ge underlag för analyser av grundvattenförhållanden, spridning av föroreningar i mark och grundvatten, markstabilitet, erosion, byggbarhet, naturvärden och andra markrelaterade frågor. Informationen i kartan kan med fördel användas för framställning av olika tematiska produkter, t ex grundvattnets sårbarhet, markens genomsläpplighet, erosionskänslighet och skredförutsättningar. Informationen ligger till grund för SGUs tryckta jordartskartor och olika karttjänster.\nKartläggningen har skett med olika metoder, skiftande geografiskt underlag samt för presentationsskalor från 1:25 000 till 1:100 000. Detta gör att det finns stora skillnader i kvalitet inom produkten, både vad gäller lägesnoggrannhet och jordarternas indelning. De skillnader i karteringsmetod som tillämpats vid kartläggningen redovisas genom att informationen har märkts som olika karttyper."},{"@language":"sv","@value":"Syftet med jordartskartan är att ge underlag för analyser av grundvattenförhållanden, spridning av föroreningar i mark och grundvatten, markstabilitet, erosion, byggbarhet, naturvärden och andra markrelaterade frågor. Informationen i kartan kan med fördel användas för framställning av olika tematiska produkter, t ex grundvattnets sårbarhet, markens genomsläpplighet, erosionskänslighet och skredförutsättningar. Informationen ligger till grund för SGUs tryckta jordartskartor och olika karttjänster."}],"dct:identifier":"2410c2e5-2a0e-4a47-9273-b7b77517420a","dct:issued":{"@type":"xsd:date","@value":"2014-02-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-18"},"dct:provenance":{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b1n0"},"dct:temporal":{"@id":"_:6e0d3dfa389f86c67c61c28c7c9101dde6dbee5387f5d667178f52a577dd0999_b2n0"},"dct:title":{"@language":"sv","@value":"Jordarter 1:25 000-1:100 000"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0fdbd270-4a6f-74bb-8473-3c6af6e125a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Surficial-25k-100k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id"