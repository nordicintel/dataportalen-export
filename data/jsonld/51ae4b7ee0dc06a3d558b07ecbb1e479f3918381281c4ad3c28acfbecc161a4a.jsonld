apServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS Extern"}},{"@id":"urn:uuid:8e059bc0-9d14-25b4-33a7-790a0e74c9cc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_Strandexploatering_2023Analys_2023_Zon_300_m.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering 2023 Zon 300 meter"}},{"@id":"urn:uuid:c29bc720-eb9e-2cf4-bf82-9fc1f58757af","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_Strandexploatering_2023Analys_2023_Zon_030_m.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering 2023 Zon 30 meter"}},{"@id":"urn:uuid:c75a6fb2-469a-099d-619e-3c6d21c7ef27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Strandexploatering_2018_EXT/MapServer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer Extern"}},{"@id":"urn:uuid:eb8ae550-7fa8-4b7b-1227-886dd040953e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_Andel_expl_strandzon_100m_inom_5x5_km_2023Analys.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering Exploatering inom zon 100 meter rutor 5x5 kilometer 2023"}},{"@id":"urn:uuid:f9c9fc6b-9385-5bc6-935f-e61c71e1bf6c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_Strandexploatering_2018_Zon_030_m.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering 2018 Zon 100 meter"}},{"@id":"urn:uuid:ff78d24e-12f9-057c-6c94-f8e0fe77d460","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_Strandexploatering_2013_Zon_100_m.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST Strandexploatering 2013 Zon 100 meter"}}],"@id":"urn:source:b507235f6c1da65075c846eeb8878c4148c45ff714739060403ed6f7fefb146a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c276f01d-428f-4fdb-87ac-a6c4cad0916e","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/grundvattenmagasin?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Grundvattenmagasin innehåller framför allt information om grundvatten i större magasin längs grusåsar och i sedimentär berggrund. Vid kartläggningen bestäms bland annat riktningar för grundvattenströmmar, grundvattendelares lägen och grundvattenmagasinets storlek och uttagsmöjligheter. Vid kartering i detaljerad skala bestäms även tillrinningsområden till magasinet, ytvattenkontakter med mera.\nSGU:s information om grundvatten utgör ett viktigt underlag i planeringen av samhällets vattenförsörjning. Den är också en av förutsättningarna för att vi i Sverige ska kunna uppnå miljökvalitetsmålet Grundvatten av god kvalitet och bidrar till att vi ska kunna uppfylla de krav som ställs i EU:s ramdirektiv för vatten. Dessutom används grundvatteninformationen i frågor som rör markanvändning och fysisk planering i allmänhet, till exempel som underlag för miljökonsekvensbeskrivningar, för åtgärdsprogram för skydd av grundvattnet och vid byggen av deponier, vägar, industrier med mera."},"dct:identifier":"c276f01d-428f-4fdb-87ac-a6c4cad0916e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Grundvattenmagasin (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b59cbb8199a4be6f79b2ef0af4ad18163cce5e35af1a2322ad8eac0738abbc86"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/17098667-31e6-4b38-b3ed-40108205b626","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/inspire/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyråns visningstjänst Inspire innehåller datamängderna: \nPD.Befolkningsfördelning.Totalbefolkning, \nPD.Befolkningsfördelning.Kön, \nPD.Befolkningsfördelning.5årsklasser, \nUS.AdministrativaOchSocialaOffentligaTjänster.MyndighetsOchKommunkontor,\nUS.AdministrativaOchSocialaOffentligaTjänster.Förskolor."},"dct:identifier":"17098667-31e6-4b38-b3ed-40108205b626","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyråns visningstjänst Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b60d2391b991c4ad3b9f114f0a2368f6bec31c75330abc01c07c5e406c672291"},{"@graph":[{"@id":"_:b666a359bf6dec6e410cd479d555dca138d94079198e7e118116550d7e3227a9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För skalområdet 1:10 000 har fotogrammetriska metoder med flygbilder utnyttjats till stor del vid uppbyggnad och ajourhållning t.ex. stereokartering och skärmdigitalisering på digitalt ortofoto."}},{"@id":"_:b666a359bf6dec6e410cd479d555dca138d94079198e7e118116550d7e3227a9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/88757412-c808-4496-919c-276eca8083c7","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:28c7b3a1-5cab-2742-4601-0fcaf437304e"},{"@id":"urn:uuid:d5cd20f3-0a0a-867a-cda2-6f6d54ec5392"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Datamängd innehållande strandlinje, vattenytor, vattendrag, sankmark, glaciär, vattenfall, fors, sluss, damm, brygga, pir och kaj från grunddata anpassat till skalområde 1:10 000.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Basemap Visning, Inspire"},"dct:identifier":"88757412-c808-4496-919c-276eca8083c7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-01"},"dct:provenance":{"@id":"_:b666a359bf6dec6e410cd479d555dca138d94079198e7e118116550d7e3227a9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:b666a359bf6dec6e410cd479d555dca138d94079198e7e118116550d7e3227a9_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för hydrografi Basemap Visning"}},{"@id":"urn:uuid:28c7b3a1-5cab-2742-4601-0fcaf437304e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/inspire/basemap/wms/v1?request=GetCapabilities&version=1.1.1&services=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt till tjänsten Basemap Visning, Inspire"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt"}},{"@id":"urn:uuid:d5cd20f3-0a0a-867a-cda2-6f6d54ec5392","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/basemap-visning-inspire-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Basemap Visning, Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Basemap Visning, Inspire."}}],"@id":"urn:source:b666a359bf6dec6e410cd479d555dca138d94079198e7e118116550d7e3227a9"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e6d098d6-26d6-4695-9bf2-68cd67668a24","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-magnet"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Geofysiska flygmätningar, magnetfält visar uppmätta variationer i det magnetiska totalfältet efter subtraktion av det geomagnetiska referensfältet (DGRF 1965.0) och baseras på flygburna mätningar på 30/60 meters höjd under åren 1960–2005. Flygmagnetiska data används huvudsakligen i samband med geologisk kartläggning och prospektering och ger information om berggrundens strukturella drag och uppbyggnad oberoende av jord- och vattendjup. Informationen är av stor vikt då endast några få procent av Sveriges berggrund är blottad, övriga delar är täckta av jord eller vatten. \n\nJordskorpans magnetiska egenskaper bestäms huvudsakligen av förekomsten av det magnetiska mineralet magnetit i de olika bergarterna. Djup- och ytfördelningen av olika bergarter kan tolkas ur mönstren i anomalikartan. Bergartsutbredning, strykning och stupningsriktningar kan bestämmas med olika geofysiska tolkningstekniker. Förkastningar och deras relativa rörelser kan ses som förskjutningar i det magnetiska mönstret. \nMagnetfältet uttrycks i enheten nanoTesla (nT)."},"dct:identifier":"e6d098d6-26d6-4695-9bf2-68cd67668a24","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, magnetfält (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b6a425ee627b270183684bce231a11062069b6f7a90278d36687ccc186336e0e"},{"@graph":[{"@id":"_:b7309268f0e29da2083611cc53261cb543fb9b258ea5ff79dac05fc34746c4ed_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ett av de planeringsunderlag för samhällsbyggande som tidigare har använts kontinuerligt är den byggnadsgeologiska kartan för Stockholm. SGU har arbetat med att uppdatera vår byggnadsgeologiska information för Stockholm, Göteborg och Malmö. Den ursprungliga kartan trycktes i slutet av 1970-talet och digitaliserades av Stockholms stad på 1990-talet. Ett stort behov av att uppdatera denna information har uttryckts av olika aktörer i samhället, men ansvaret för denna uppdatering var otydligt. SGU har bedrivit viss verksamhet för att samla in relevant information för detta ändamål, inklusive potentiella svaghetszoner.\n\nMed hjälp av dokumentation från tunneldrivningar eller detaljerad kartläggning inför grundläggning av andra konstruktioner, framför allt ingenjörsgeologiska karteringar, extraherat information gällande observationer av svaghetszoner. Flera tunnelprojekt har använts i arbetet. Information om varje svaghetszons bergtekniska karaktär har ställts samman i tabeller som utgör underlaget för produkten. Dessa observationer tillsammans med annan information, såsom höjdmodellen, används för att tolka geometrin och karaktären hos potentiella svaghetszoner med fokus på konstruktionsrelaterade frågor."}},{"@id":"_:b7309268f0e29da2083611cc53261cb543fb9b258ea5ff79dac05fc34746c4ed_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.4348 60.6721,20.5846 60.6721,20.5846 55.2235,10.4348 55.2235,10.4348 60.6721))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/0291a183-efc7-4579-9ee1-97595e0f5304","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1f13362e-cb25-d3a9-bd7c-48b5b119d67c"},{"@id":"urn:uuid:350a7655-6f5c-13c1-1fdc-4f3e642591cf"},{"@id":"urn:uuid:3bba9457-442c-306b-f927-ea139c895a20"},{"@id":"urn:uuid:70fe8715-7793-53f4-c302-a8b83906ca92"},{"@id":"urn:uuid:9af67bb4-e17d-2d31-b3c6-a079f16c3da1"},{"@id":"urn:uuid:a61346b3-d8ee-cef6-1bd0-c9948717e88d"},{"@id":"urn:uuid:d3287c06-5545-89a3-1a8c-bae6e649e2ec"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Informationen kan tjäna som ett byggnadsgeologisk planeringsunderlag vid samhällsbyggande."},{"@language":"sv","@value":"Svaghetszon är en allmän byggnadsteknisk term som avser ett område med låg mekanisk stabilitet i en bergmassa, vilket kan påträffas vid ytan eller under jord. Dessa svaghetszoner representerar ofta, men inte alltid, spröda deformationszoner, såsom sprickzoner eller olika typer av gångbergarter.\n\nI samband med olika infrastrukturprojekts avslut tas inte alltid värdefull information om hand på ett konsekvent sätt. Därför arbetar SGU kontinuerligt med att samla in, lagra och tillhandahålla geologisk information från externa aktörer så att det kan återanvändas och kan komma till nytta i framtida projekt inom undermarksplanering. Svaghetszoner baseras på bland annat undermarksinformation från olika byggnationer, som till exempel tunnlar, och andra underlag.\n\nProdukten består av två huvuddelar: dels en linjetabell som innehåller tillhörande sammanfattande attribut, dels en separat stödtabell med individuella fältobservationer och deras attribut. De individuella observationsattributen sammanställs för att generera de övergripande karaktärsattributen för en zon, som sedan ingår i linjetabellen.\nSvaghetszonsobservationer baseras på data från både ytan och underjorden, såsom häll-, borrhåls- och tunnelobservationer, insamlade från förundersökningar till färdigställandet av ett infrastrukturprojekt. Dessa observationer kommer främst från ingenjörsgeologiska karteringar. Varje observationspunkt beskrivs med parametrar enligt tabellen nedan.\n\nKonfidensnivån för en observation är en kvalitativ bedömning (hög, medel eller låg) baserad på hur tydliga de dokumenterade bevisen är för zonens existens, samt hur väl dess orientering och karaktär kan fastställas. Av säkerhetsskäl saknar observationerna geometri i tabellen.\n\nProcessen fokuserar sedan på att korrelera dessa observationer med topografiska linjära sänkor, så kallade lineament, för att avgöra om de representerar potentiella svaghetszoner och för att fastställa deras karaktär, orientering och utsträckning. Varje tolkad linje eller svaghetszon tilldelas en övergripande konfidensnivå baserat på tolkningens tillförlitlighet. I zoner med hög konfidens finns tydliga kopplingar till olika observationer, objekt eller referenser. För dessa zoner anges även lutning (stupning) och uppskattad bredd.\n\nFör 3D-visualisering specificeras även zonens riktning (strykning) för att visa åt vilket håll den lutar enligt högerhandsregeln.\n\nInledningsvis är informationen begränsad till Stockholm, Göteborg och Malmö, men den kan i framtiden utökas till andra områden i Sverige där mer detaljerad information behövs.\n\nEftersom informationen grundas på extern information och som tagits fram med olika metoder, under många år, är kvaliteten varierande. Tolkningar görs av SGU utifrån tillgängligt material och resultatet blir därefter."}],"dct:identifier":"0291a183-efc7-4579-9ee1-97595e0f5304","dct:issued":{"@type":"xsd:date","@value":"2018-05-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-31"},"dct:provenance":{"@id":"_:b7309268f0e29da2083611cc53261cb543fb9b258ea5ff79dac05fc34746c4ed_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:b7309268f0e29da2083611cc53261cb543fb9b258ea5ff79dac05fc34746c4ed_b1n0"},"dct:title":{"@language":"sv","@value":"Svaghetszoner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1f13362e-cb25-d3a9-bd7c-48b5b119d67c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/svaghetszoner-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:350a7655-6f5c-13c1-1fdc-4f3e642591cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/berggrund/svaghetszoner-nedladdning.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:3bba9457-442c-306b-f927-ea139c895a20","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}},{"@id":"urn:uuid:70fe8715-7793-53f4-c302-a8b83906ca92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/svaghetszoner/svaghetszoner.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:9af67bb4-e17d-2d31-b3c6-a079f16c3da1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/svaghetszoner/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:a61346b3-d8ee-cef6-1bd0-c9948717e88d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/svaghetszoner"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:d3287c06-5545-89a3-1a8c-bae6e649e2ec","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/svaghetszoner-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:b7309268f0e29da2083611cc53261cb543fb9b258ea5ff79dac05fc34746c4ed"},{"@graph":[{"@id":"_:b7f208de8dc11d56f8b7aa939404fae3c80a31ce561dede6808bb3e97b57316d_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/oc-obs-waveheight/OF.PointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveheight/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveheight/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:b7f208de8dc11d56f8b7aa939404fae3c80a31ce561dede6808bb3e97b57316d_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/01228720-2396-11ed-832f-911b23582b4f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/oc-obs-waveheight/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter våghöjd. Tjänsten visar alla stationer som någonsin levererat data för denna parametrar. Insamlade från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"01228720-2396-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer- Våghöjd: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b7f208de8dc11d56f8b7aa939404fae3c80a31ce561dede6808bb3e97b57316d"},{"@graph":[{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/010be12b-bcda-4ba0-d07b-eff5bb227b80","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:32ffbae1-dacf-4b21-3ed1-70fcaae3fd65"},{"@id":"urn:uuid:b05f70c5-4dde-d974-6094-ce0d2b1630df"}],"dcat:distribution":[{"@id":"urn:uuid:08b64457-5a63-4961-3f3f-2167b9dddc97"},{"@id":"urn:uuid:522c3031-3b63-e6f3-0e1d-7855ee3fb95c"},{"@id":"urn:uuid:5fee1de4-38e4-2863-f7bc-903fd256938f"}],"dcat:keyword":[{"@language":"sv","@value":"Anläggningar för miljöövervakning"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Platser där det utförts mätningar av elfiske, sjöprovfiske och kustprovfiske. Det gäller mätningar för att uppskatta vilka arter och hur stor mängd av olika fiskar som förekommer på platsen."},"dct:identifier":"010be12b-bcda-4ba0-d07b-eff5bb227b80","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-16"},"dct:provenance":{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b1n0"},"dct:title":{"@language":"sv","@value":"Stationsregistret: Platser för miljöövervakning: Datavärdskap Provfiske"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:08b64457-5a63-4961-3f3f-2167b9dddc97","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"Stationsregistrets WFS tjänst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.WFS"}},{"@id":"urn:uuid:32ffbae1-dacf-4b21-3ed1-70fcaae3fd65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sveriges Lantbruksuniversitet (SLU)","http://www.w3.org/2006/vcard/ns#organization-name":"Sveriges Lantbruksuniversitet (SLU)"},{"@id":"urn:uuid:522c3031-3b63-e6f3-0e1d-7855ee3fb95c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.WMS"}},{"@id":"urn:uuid:5fee1de4-38e4-2863-f7bc-903fd256938f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Provfiske/atomDatasetFeed-SE_EF_StnReg_DV_Provfiske.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.ATOM"}},{"@id":"urn:uuid:b05f70c5-4dde-d974-6094-ce0d2b1630df","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet sjöar och vattendrag","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:datavard-vatten@slu.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Datavärdskapet sjöar och vattendrag"}],"@id":"urn:source:b819bf10b66763da9d25169be08e84d146dd3b8f75ab83e34f2ccad02d98b1e0"},{"@graph":[{"@id":"_:b845132aa13a76d3897361ea80c03ff76f95d6800957d476b3d5388b4ccdc068_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:b845132aa13a76d3897361ea80c03ff76f95d6800957d476b3d5388b4ccdc068_b0n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/ca15774c-dc20-44f0-a6a3-189ddad2477f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Denna produkt består av polygoner som representerar avrinningsområden på land och i hav.\nAvrinningsområdena är genererade för alla vattenförekomster, mätstationer i SMHI:s grundnät samt ett ytterligare urval av mätstationer och dammar vilka är viktiga för den hydrologiska modellen. Genereringen är baserad på en höjdmodell med 10 m upplösning.\n\nNorska och finska avrinningsområden är hämtade från Norges vassdrags- og energidirektorat (NVE) samt Finlands miljöcentral (Syke) och är till viss del hopslagna för att bättre harmonisera med de svenska. Vid gränsen är utländska avrinningsområdena geometriskt justerade efter de svenska avrinningsområdena.\n\nAlla avrinningsområden ingår i det logiska nätverket som kopplar avrinningsområden till varandra efter hur vattnet rinner i naturen. \n\nProdukten delavrinningsområden, som baserar sig på version SVAR 2022:1.2, innehåller polygoner som representerar svenska och delar av norska och finska delavrinningsområden.\nTjänsten nedladdning ATOM innehåller endast delavrinningsområden som rinner till eller befinner sig inom Sverige."},"dct:identifier":"ca15774c-dc20-44f0-a6a3-189ddad2477f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.HY Delavrinningsområden (SVAR2022): Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b845132aa13a76d3897361ea80c03ff76f95d6800957d476b3d5388b4ccdc068"},{"@graph":[{"@id":"_:b8e4307b2f2129a28a4d49d1d1bd3c1edb0350604311eb641f7f84c1a3891553_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.357304807640388 69.38676654411378,24.5757818120779 69.38676654411378,24.5757818120779 54.567387185701335,9.357304807640388 54.567387185701335,9.357304807640388 69.38676654411378))"}},{"@id":"_:b8e4307b2f2129a28a4d49d1d1bd3c1edb0350604311eb641f7f84c1a3891553_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/d39cb05b-94ed-e402-efde-a22e2158e877","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":[{"@id":"urn:uuid:369aade7-67d4-b313-3a0a-79ad2ad89583"},{"@id":"urn:uuid:eed36b2d-01e4-deab-ddb8-49828623d109"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Halter av totalkväve i trendsjöar, trendvattendrag och omdrevssjöar"},"dct:identifier":"d39cb05b-94ed-e402-efde-a22e2158e877","dct:issued":{"@type":"xsd:date","@value":"2014-09-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-02-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:b8e4307b2f2129a28a4d49d1d1bd3c1edb0350604311eb641f7f84c1a3891553_b0n0"},"dct:title":{"@language":"sv","@value":"Kväve i sjöar och vattendrag"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_e1da4e07"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b8e4307b2f2129a28a4d49d1d1bd3c1edb0350604311eb641f7f84c1a3891553_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:369aade7-67d4-b313-3a0a-79ad2ad89583","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.ad23bfe185cbe8fec87b71/1674221829453/officiell-statistik-dataunderlag-diagram-totalkvave-trendvattendrag-1997-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Halter totalkväve i trendvattendrag"}},{"@id":"urn:uuid:eed36b2d-01e4-deab-ddb8-49828623d109","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.ad23bfe185cbe8fec87ac8/1674221687920/officiell-statistik-dataunderlag-diagram-totalkvave-trendsjoar-1997-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Totalkväve i trendsjöar"}}],"@id":"urn:source:b8e4307b2f2129a28a4d49d1d1bd3c1edb0350604311eb641f7f84c1a3891553"},{"@graph":[{"@id":"_:b964581ca9a0216e94a6ec9af4469b9335a6bb60b094b6d9dd1bc44c6d520390_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Under åren 1992–97 digitaliserades den analoga informationen och en första digital version av grunddata skapades. Målet var att göra en rikstäck-ande databas i skala 1:10 000. Det som saknades var fjällområdet. Data-mängden kompletterades och vidareutvecklades med till exempel förbätt-rad lägesosäkerhet vid uppbyggnaden av Grundläggande Geografiska Data (GGD) 1995–2004. Fjällområdet karterades mellan åren 2006–2012.\nIdag sker inget fältarbete enligt tidigare modell. Insamlingen i egen regi genomförs genom tolkning i flygbilder i stereo och ortofoto. En stor del av information samlas in i samverkan med andra statliga myndigheter, kom-muner och organisationer. Vägar och järnvägar hämtas från Trafikverket."}},{"@id":"_:b964581ca9a0216e94a6ec9af4469b9335a6bb60b094b6d9dd1bc44c6d520390_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d09898c1-94aa-4ea5-bda5-da34946aca70","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:9e4d4d00-163e-1c1a-2c83-855bf5598160"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Produkten passar utmärkt som bakgrundskarta och som indata till GIS-tillämpningar. Den är lämplig att använda i skalområdena 1:1 000 - 1:20 000. Innehållet består bland annat av byggnader, markslag, vägar, hydrografi, samt Lantmäteriets granskade och fastställda namn som finns i Ortnamnsregistret."},"dct:identifier":"d09898c1-94aa-4ea5-bda5-da34946aca70","dct:issued":{"@type":"xsd:date","@value":"2021-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:b964581ca9a0216e94a6ec9af4469b9335a6bb60b094b6d9dd1bc44c6d520390_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:b964581ca9a0216e94a6ec9af4469b9335a6bb60b094b6d9dd1bc44c6d520390_b1n0"},"dct:title":{"@language":"sv","@value":"Topografi 10 Nedladdning, vektor"}},{"@id":"urn:uuid:9e4d4d00-163e-1c1a-2c83-855bf5598160","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-10-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Topografi 10 Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografi 10 Nedladdning, vektor"}}],"@id":"urn:source:b964581ca9a0216e94a6ec9af4469b9335a6bb60b094b6d9dd1bc44c6d520390"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/4a677b5a-ae28-411a-98b0-ed4bad1c1cf3","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Arbetsplatsområden utanför tätorter är koncentrationer av arbetsställen med minst 50 sysselsatta och högst 300 meter mellan byggnaderna. SCB avgränsar polygoner för dessa och beräknar sedan statistik per område utifrån registerdata. Arbetsplatsområden är en äldre inledning som efter referensår 2010 har utgått och ersatts av statistikprodukten verksamhetsområden."},"dct:identifier":"4a677b5a-ae28-411a-98b0-ed4bad1c1cf3","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Arbetsplatsområden utanför tätorter WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b9721efae2b5ab0be684f2bcd5178e4a0ca752f82d80576b5263eff4843bf418"},{"@graph":[{"@id":"_:b981e272e7a2c5a0c34277717f6665fc2945dda3e86317f870500d2bd0ff2fb8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Undersökningsområden med  tillhörande stationer, profiler eller svepområden från ett antal geofysiska datamängder vid SGU har transformerats för att överensstämma med Inspires dataspecifikation för tema Geologi (applikationsschemat för Geofysik). Inga mätresultat ingår i denna datamängd."}},{"@id":"_:b981e272e7a2c5a0c34277717f6665fc2945dda3e86317f870500d2bd0ff2fb8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.45406568521 68.826151428181,25.52305593672 68.826151428181,25.52305593672 54.899419669258,10.45406568521 54.899419669258,10.45406568521 68.826151428181))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8faf3566-a9d3-4d64-957d-334268d5fb54","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:a15c4470-ac46-2888-a97b-2bc0bfb67066"},{"@id":"urn:uuid:b82dae0f-80ee-8a6c-0a2a-fce9d8dc4f0b"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"GE.Geofysik är framtagen i syfte att uppfylla Inspire dataspecifikation för tema Geologi (applikationsschemat för Geofysik). GE.Geofysik redovisar undersökningsområden och tillhörande stationer, profiler eller svepområden från ett antal geofysiska datamängder vid SGU. Inga mätdata redovisas i denna datamängd.\n\nUndersökningar som redovisas är flygeofysiska undersökningar, markgeofysiska undersökningar med seismik och markradar,  tyngdkraftsmätningar, side-scan sonar-mätningar samt magnetobservationer."},"dct:identifier":"8faf3566-a9d3-4d64-957d-334268d5fb54","dct:issued":{"@type":"xsd:date","@value":"2019-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-02"},"dct:provenance":{"@id":"_:b981e272e7a2c5a0c34277717f6665fc2945dda3e86317f870500d2bd0ff2fb8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:b981e272e7a2c5a0c34277717f6665fc2945dda3e86317f870500d2bd0ff2fb8_b1n0"},"dct:title":{"@language":"sv","@value":"GE.Geofysik"}},{"@id":"urn:uuid:a15c4470-ac46-2888-a97b-2bc0bfb67066","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Geofysik"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}},{"@id":"urn:uuid:b82dae0f-80ee-8a6c-0a2a-fce9d8dc4f0b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Geophysics.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}}],"@id":"urn:source:b981e272e7a2c5a0c34277717f6665fc2945dda3e86317f870500d2bd0ff2fb8"},{"@graph":[{"@id":"_:b98aa000c2abb8d44644004bad63b8ef814bdb364222d1f917b795c39d716be4_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:b98aa000c2abb8d44644004bad63b8ef814bdb364222d1f917b795c39d716be4_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/7566cbd6-9d63-4a5c-b706-f70e365a55b0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:3103fb24-24dc-3e24-7336-1c882f2b00fd"},{"@id":"urn:uuid:dba184de-965e-5f01-68e8-432f268f0749"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Datamängden visar de våtmarker som berörs av kalkningsverksamheten i Sverige. Skiktet bygger på geodata från respektive länsstyrelse som kompletterats med data från Nationella kalkdatabasen. Varje län ansvarar för att de områden som finns med i skiktet är aktuella och kommer in med uppdateringar när ändringar sker. Skiktet kalkade våtmarker uppdateras en gång per år av länsstyrelsens förvaltningsobjekt Vatten och miljömål."},"dct:identifier":"7566cbd6-9d63-4a5c-b706-f70e365a55b0","dct:issued":{"@type":"xsd:date","@value":"2021-11-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:b98aa000c2abb8d44644004bad63b8ef814bdb364222d1f917b795c39d716be4_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen -kalkade våtmarker"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b98aa000c2abb8d44644004bad63b8ef814bdb364222d1f917b795c39d716be4_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:3103fb24-24dc-3e24-7336-1c882f2b00fd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Nationella_Kalkdatabasen_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS-tjänst"}},{"@id":"urn:uuid:dba184de-965e-5f01-68e8-432f268f0749","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_kalkade_vatmark.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:b98aa000c2abb8d44644004bad63b8ef814bdb364222d1f917b795c39d716be4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/ca96da7a-bb8f-4b26-859e-22d9b5ca8100","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik per km ruta( 1x1 km). Data innehåller totalbefolkning, könsindelat samt 5-årsklasser. Statistiken finns från 2015-12-31 till 2025-12-31. Nationella data ej INSPIRE.\n\nStatistik för flera år och med andra grupperingar kan beställas från SCB på uppdragsbasis."},"dct:identifier":"ca96da7a-bb8f-4b26-859e-22d9b5ca8100","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Befolkningsstatistik på km-ruta WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:b9d5925b765a06a4a582a537c26896da5bc944df47554a08b326500a1d98a758"},{"@graph":[{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"På 1930-talet infördes en ny teknik med flygbilder vilket gjorde det möjligt att kartlägga stora områden till låg kostnad. Det geodetiska systemet RT38 infördes vilket gjorde att man kunde framställa moderna och enhetliga kartor med hög lägesriktighet. En plan togs fram för att kartlägga Sverige i skala 1:10 000. För första gången samlades både fastighetsinformation och geografisk information med hög lägesnoggrannhet och stor detaljrikedom i ett gemensamt dokument."}},{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1978"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1935"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/e44b006b-5201-488b-a3e0-6b5a97de0989","@type":"dcat:Dataset","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Ekonomiska kartan (1935-1978) är en registerkarta som redovisar fastigheter, registerbeteckningar, bostadsbyggnader, tomt och trädgård, odlingsområden, fornminnen samt ett stort antal ortnamn. Skalan är 1:10 000, förutom över Norrlands inland där skalan är 1:20 000."},"dct:identifier":"e44b006b-5201-488b-a3e0-6b5a97de0989","dct:issued":{"@type":"xsd:date","@value":"1935-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1935-01-01"},"dct:provenance":{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b1n0"},"dct:temporal":{"@id":"_:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0_b2n0"},"dct:title":{"@language":"sv","@value":"Ekonomiska kartan"}}],"@id":"urn:source:ba17287a3cb257477191e94fd323997423cce7ab24b3bab3ca322fffecec4ca0"},{"@graph":[{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Insamling av data för utveckling av bedömningsgrund."}},{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.916516418854954 60.070550713937195,19.995029803705144 60.070550713937195,19.995029803705144 55.64834409285052,13.916516418854954 55.64834409285052,13.916516418854954 60.070550713937195))"}},{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/03a54707-54fe-64c7-4f45-2d5f14e6a4c5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:450a8c02-39c4-1af7-e72d-75e210e7ab51"},"dcat:distribution":[{"@id":"urn:uuid:af37085c-4fbe-8520-90a4-628b9b5e2b20"},{"@id":"urn:uuid:bd1016fc-89ea-be89-fe05-509e34386eb8"},{"@id":"urn:uuid:eb594197-f069-2ea9-ef1c-5bb90b25eda4"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Havs och vattenmyndigheten arbetar med utveckling av nya biologiska bedömningsgrunder för kusten inom vattenförvaltningen. Biologiska bedömningsgrunder är ett viktigt verktyg för att utvärdera ekologisk status samt för att implementera lämpliga åtgärder som förbättrar vattenkvalitén och bidrar till sammanhängande funktionella ekosystem. Syftet med detta projekt var att utveckla biologiska bedömningsgrunder i Östersjön som även är känsliga för fysisk påverkan med koppling till kvalitetsfaktorn Makroalger och Gömfröiga växter enligt föreskriften HVMFS 2019:25. \nArbetet utmynnade i tre föreslagna och utvärderade parametrar; Artdiversitet, Täckningsgrad och Ytutbredning. Den data som samlades in har mätts med hjälp av kratt- och videoprov och akustiska metoder i tre olika områden i Östersjön - Stockholm, Östergötland och Blekinge. Data består av GIS filer och beskrivning av arter som påträffades vid olika djup längs provtagna transekter. Inom varje lokal samlades data in i ett påverkat område och ett icke-påverkat för att analysera skillnaden. Detaljerad beskrivning om metoder, analys och resultat och går att få vid kontakt med Havs- och vattenmyndigheten."},"dct:identifier":"03a54707-54fe-64c7-4f45-2d5f14e6a4c5","dct:issued":{"@type":"xsd:date","@value":"2026-01-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-07"},"dct:provenance":{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b1n0"},"dct:title":{"@language":"sv","@value":"Gömfröiga växter"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:450a8c02-39c4-1af7-e72d-75e210e7ab51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Vattenmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Vattenmiljöenheten"},{"@id":"urn:uuid:af37085c-4fbe-8520-90a4-628b9b5e2b20","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/gomfroiga-vaxter/2025-06-18/gomfroiga-vaxter-2025-06-18.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Gömfröiga växter direktnedladdning"}},{"@id":"urn:uuid:bd1016fc-89ea-be89-fe05-509e34386eb8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/gomfroiga-vaxter/wfs"},"dct:description":{"@language":"sv","@value":"WFS-tjänst för gömfröiga växter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Gömfröiga växter WFS"}},{"@id":"urn:uuid:eb594197-f069-2ea9-ef1c-5bb90b25eda4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/gomfroiga-vaxter/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Gömfröiga växter som WMS"},"dct:title":{"@language":"sv","@value":"Gömfröiga växter WMS"}}],"@id":"urn:source:ba685ca1150ad58e6d73c12c71b70e394a28a9da556aea8faeaeaa9267dee960"},{"@graph":[{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"GE.Jordarter 1:25 000-1:100 000 Sverige är en transformerad version av SGUs produkt Jordarter 1:25 000-1:100 000 i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nInfomrationen är förenklad dels när det gäller jordarternas indelning i litologiska enheter, dels när det gäller ingående polygonskikt med litologiska enheter. I denna version redovisas endast JG2 Grundlager, vilket innebär att evenuella underliggande lager eller överliggande tunna eller osammanhängande ytlager inte redovisas.\n\nInformationen bygger på kartläggningar som påbörjades på 1960-talet och pågår än idag.\n\nKartläggningen har under åren utförts med olika metoder, på skiftande geografiskt underlag samt för presentationsskalor från 1:25 000 till 1:100 000. Den tidiga informationen har digitaliserats från tryckt kartunderlag. Från 1990-talet produceras data i digital miljö. Många kartlagda områden har publicerats som tryckta kartor inom SGUs serier Ae, Ak och K och till dessa finns ofta utgivna kartbladsbeskrivningar som innehåller kompletterande information om arbetsmetoder och geologiska förhållanden. Information om dessa beskrivningar finns på www.sgu.se.\n\nEftersom olika karteringsmetoder har tillämpats i olika områden och under olika perioder, så är produktens kvalitet inte enhetlig utan skiljer sig från område till område. Den mest detaljerade kartläggningen, som bygger på omfattande fältarbete har utförts främst i tätbefolkade områden i södra Sverige. I glest bebyggda områden har en mer översiktlig karteringsmetod, som huvudsakligen bygger på flygbildstolkning, tillämpats. Informationens kvalitet beror också på vilket geografiskt underlag som\nanvänts vid kartläggningen.\n\nGemensamt för alla karttyper är att jordartsobservationerna i fält i huvudsak görs på ca en halv meters\ndjup, dvs. under matjord och jordmån. Jordartsklassificeringen grundas i huvudsak på okulär bedömning.\n\nReferensprover för jordartsanalyser tas i begränsad omfattning. Befintliga jordskärningar dokumenteras. Kompletterande schaktningar, borrningar och geofysiska mätningar utförs i mycket begränsad omfattning. Ett urval information från externa källor, i första hand geotekniska utredningar och grundvattenutredningar ställs samman och används som underlag i kartläggningen.\n\nUppgifter om jordartsanalyser, isräfflor, jorddjup, jordlagerföljder, skred och raviner samlas också in och finns tillgängliga i andra produkter."}},{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.21314662596 67.326063512293,24.816974695746 67.326063512293,24.816974695746 55.179248744753,11.21314662596 55.179248744753,11.21314662596 67.326063512293))"}},{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1962"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/45a1e47f-17e9-4799-ab3a-fd771b7a131c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:8b263b08-47c8-c538-b004-da105ac20e6b"},{"@id":"urn:uuid:9d6c273b-66ab-4c20-23ea-bec2b8882ec4"},{"@id":"urn:uuid:ebe41b9f-5a69-ca5f-4d88-4456c250aaee"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"GE.Jordarter 1:25 000-1:100 000 är en transformerad version av SGUs produkt Jordarter 1:25 000-1:100 000 i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nInformationen är förenklad dels när det gäller jordarternas indelning i litologiska enheter, dels när det gäller ingående polygonskikt med litologiska enheter. I denna version redovisas endast JG2 Grundlager, vilket innebär att evenuella underliggande lager eller överliggande tunna eller osammanhängande ytlager inte redovisas.\n\nKartläggningen har skett med olika metoder, skiftande geografiskt underlag samt för presentationsskalor från 1:25 000 till 1:100 000. Detta gör att det finns stora skillnader i kvalitet inom produkten, både vad gäller lägesnoggrannhet och jordarternas indelning."},"dct:identifier":"45a1e47f-17e9-4799-ab3a-fd771b7a131c","dct:issued":{"@type":"xsd:date","@value":"2019-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-07"},"dct:provenance":{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b1n0"},"dct:temporal":{"@id":"_:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:25 000 - 1:100 000"}},{"@id":"urn:uuid:8b263b08-47c8-c538-b004-da105ac20e6b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Surficial_25-100K.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:9d6c273b-66ab-4c20-23ea-bec2b8882ec4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Surficial-25k-100k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:ebe41b9f-5a69-ca5f-4d88-4456c250aaee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_25-100k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:ba9aae60a4bfe11419d797296e8a69466c0b54c4d695cf890b0c7babdd64644d"},{"@graph":[{"@id":"_:bad23d3b94328bda28f74324ce81f84ae3ada49aa20c72db6007a426d5a8a5d1_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.06551 58.15043,15.65026 58.15043,15.65026 56.87259,13.06551 56.87259,13.06551 58.15043))"}},{"@id":"_:bad23d3b94328bda28f74324ce81f84ae3ada49aa20c72db6007a426d5a8a5d1_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/21b92c30-18a6-40c4-9e6a-23ab2a8ebde9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":[{"@id":"urn:uuid:106f9cef-5d90-a9f5-d6d1-d2317e587cda"},{"@id":"urn:uuid:2c533b13-98fd-f565-58a4-d896a82df482"},{"@id":"urn:uuid:c396604f-5d09-e605-062d-8bba9953c20d"},{"@id":"urn:uuid:d30eebf7-1a9e-1609-0148-488b66c08bcf"},{"@id":"urn:uuid:ed1bb1da-6408-bba7-12b0-3499462b04cd"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skiktet är framtaget inom ramen för projektet ”LEIF i praktiken, Levande Ekosystem I Framtiden – från teoretiskt underlag till praktisk rådgivning”. Genom en täthetsanalys pekades områden ut som når upp till tröskelvärden för habitatmängd, det vill säga där ett tillräckligt stort antal lämpliga träd återfinns inom ett 25 kvadratkilometer stort område för arters överlevnad i landskapet. Områden med tillräcklig habitatmängd visas i grönt, ju mörkare desto större habitatmängd. Gula områden visar var lämpliga habitat återfinns men i en för lite mängd för att nå upp till tröskelvärdet. Utanför gröna och gula områden har inga lämpliga habitat inventerats. Se tillkomsthistorik och rapport för metodik och begränsningar. OBS lyr-fil finns i nuläget inte tillgänglig för externa användare men kan skickas efter önskemål till gis.jonkoping@lansstyrelsen.se"},"dct:identifier":"21b92c30-18a6-40c4-9e6a-23ab2a8ebde9","dct:issued":{"@type":"xsd:date","@value":"2016-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-03-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:bad23d3b94328bda28f74324ce81f84ae3ada49aa20c72db6007a426d5a8a5d1_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Levande ekosystem i framtiden - Ek"}},{"@id":"urn:uuid:106f9cef-5d90-a9f5-d6d1-d2317e587cda","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.LstF_Levande_ekosystem_i_framtiden_Ek.xml"},"dct:description":{"@language":"s