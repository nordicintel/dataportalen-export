b3f-08a1-ca8a-58fc-ea0a9051f5b2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Oceanografi_marinbiologi/atomDatasetFeed-SE_EF_StnReg_DV_Oceanografi_marinbiologi.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.ATOM"}},{"@id":"urn:uuid:ca96affc-6a42-245c-c3be-89aea45a8304","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet oceanografi och marinbiologi","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:shark@smhi.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Datavärdskapet oceanografi och marinbiologi"},{"@id":"urn:uuid:e22b3eea-8d3c-4382-f87b-e47b84860e0f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.WMS"}}],"@id":"urn:source:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16"},{"@graph":[{"@id":"_:7fd299ad50fd6b753a7e47d4acde5aa7633f5bad3a54ce5f9163f1b56ae764f2_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/9bf90404-6b90-4ac2-9c13-c44ced9f0457","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:endpointURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_us/ows?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Metadatastandarden ISO19139/119 är den föredragna metadatastandarden som ska användas för tjänster (WMS, WFS, WCS)."},"dct:identifier":"9bf90404-6b90-4ac2-9c13-c44ced9f0457","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"SE.LST INSPIRE US Visningstjänst (WMS)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7fd299ad50fd6b753a7e47d4acde5aa7633f5bad3a54ce5f9163f1b56ae764f2_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"}],"@id":"urn:source:7fd299ad50fd6b753a7e47d4acde5aa7633f5bad3a54ce5f9163f1b56ae764f2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/123059c2-11c3-4cb4-bcf0-d05924e16a10","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs.atom"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänsten tillhandahåller oceanografiska observationer; parametrarna salthalt, våghöjd, vågperiod, vågriktning,  ytvattentemperatur, havsvattenstånd, strömriktning och strömhastighet. Dessa kan lad\ndas ned stationsvis på tre olika sätt; alla data fram till kl 00 innevarande dygn, alla data senaste dygnet eller data för senaste timmen."},"dct:identifier":"123059c2-11c3-4cb4-bcf0-d05924e16a10","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:805388045f937878d2d3e7038cf21932160ff2784f249503f6e3c2b1a8000a3b"},{"@graph":[{"@id":"_:805afb1dc002eed5d660b4296e171a130d097da571c5a9c3d8b3b240c5f3dd50_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Torvlagerföljder har samlats in av SGU vid särskilda systematiska undersökningar av torvmarker, jordartskartläggning samt särskilda undersökningar av torvmarker i samband med forskningsprojekt. Lagerföljderna är registrerade utifrån borrningar i torvmarker och i undantagsfall från skärningar i diken.\n\nTorven är i de flesta fall klassificerad enligt ett finskt system som utarbetades av Heikurainen 1973. Den nomenklaturen är en förenkling av den som utarbetades av von Post och Granlund (1926) och som redovisas i SGUs rapport C 335. Vissa av torvlagerföljderna har dock klassificerats enligt den nomenklatur som togs fram av von Post och Granlund.\n\nSamtliga torvlagerföljder har samlats in vid undersökningar som syftat till att fastställa torvlagrens utbredning och egenskaper. De geologer som utfört undersökningarna har varit specialiserade på undersökningar av torv. Kvalitén på denna information får därmed betraktas som genomgående hög. Positionering har gjorts med vid karteringstillfället befintliga kartunderlag. Eftersom databasen inkluderar information som samlats in under nästan hundra år varierar den geografiska noggrannheten beroende på vilket kartunderlag som funnits tillgängligt. Data som samlats in under 2000-talet har positionerats m h a gps.\n\nDet finns för närvarande flera kolumner i produkten där uppgifter saknas. När ytterligare data tillförs produkten kommer dock informationen kompletteras."}},{"@id":"_:805afb1dc002eed5d660b4296e171a130d097da571c5a9c3d8b3b240c5f3dd50_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/80bd68d9-659a-43b1-af52-6f85d4b7a503","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:31cb500e-2df4-6bf6-0565-d747e4e28d0d"},{"@id":"urn:uuid:6f1a7f5f-a1db-a3f0-6008-43e90cedc659"},{"@id":"urn:uuid:80939539-294d-547a-c59e-d38aa897dc87"},{"@id":"urn:uuid:adf79843-f296-570e-e058-e265c8a8d233"},{"@id":"urn:uuid:d5018c94-7de4-67df-c499-4b5ed99a768a"},{"@id":"urn:uuid:e24134bf-bbe3-2c8d-cf90-673599fe277c"},{"@id":"urn:uuid:e3283a43-31ea-25d2-da54-819555df7553"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Produkten innehåller uppgifter om torvlagrens mäktighet och karaktäristiska egenskaper, t.ex. torvens sammansättning, humifieringsgrad och blöthet. Informationen bygger på observationer från borrningar i torvmarker. Till stor del utgörs materialet av information som digitaliserats från SGU:s torvarkiv. I detta arkiv finns en stor mängd information om den svenska torvens egenskaper och utbredning. Materialet består av resultat från inventeringar, rapporter, kartor, dagböcker och publikationer från de senaste hundra åren. Eftersom materialet samlats in under en lång tid så har delvis olika nomenklatur använts. Dessutom varierar positioneringsnoggrannheten beroende på vilket kartunderlag som används vid insamlingen.\nPå SGU:s hemsida finns ytterligare information om det omfattande analoga material som finns i torvarkivet. Produkten inkluderar även data som samlats in under 2000-talet.\n."},"dct:identifier":"80bd68d9-659a-43b1-af52-6f85d4b7a503","dct:issued":{"@type":"xsd:date","@value":"2018-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-29"},"dct:provenance":{"@id":"_:805afb1dc002eed5d660b4296e171a130d097da571c5a9c3d8b3b240c5f3dd50_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:805afb1dc002eed5d660b4296e171a130d097da571c5a9c3d8b3b240c5f3dd50_b1n0"},"dct:title":{"@language":"sv","@value":"Torvlagerföljder"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:31cb500e-2df4-6bf6-0565-d747e4e28d0d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/torvlagerfoljder-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:6f1a7f5f-a1db-a3f0-6008-43e90cedc659","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/torvlagerfoljder/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:80939539-294d-547a-c59e-d38aa897dc87","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/torvlagerfoljder-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:adf79843-f296-570e-e058-e265c8a8d233","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/jordarter/torvlagerfoljder-nedladdning.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},