L"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst\n\t\t\t\t\t\t\t\t\t(RSS/Atomflöde)"}}],"@id":"urn:source:877cce834490d8810998aae470101e0c72112350951aa34d3dbf0bf4089b8078"},{"@graph":[{"@id":"_:88d124cdf3a50143aedc6bbac16a2250b3c55413af8a92151d4b8c536cd8915b_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:88d124cdf3a50143aedc6bbac16a2250b3c55413af8a92151d4b8c536cd8915b_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/59884bdc-725b-41cc-89f6-52da7fd15245","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Sumpskogar.xml"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"ATOM-flöde för nedladdning (ZIP) av Sumpskogar inventerade av Skogsstyrelsen"},"dct:identifier":"59884bdc-725b-41cc-89f6-52da7fd15245","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"HB.Sumpskogar inventerade av Skogsstyrelsen.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/e