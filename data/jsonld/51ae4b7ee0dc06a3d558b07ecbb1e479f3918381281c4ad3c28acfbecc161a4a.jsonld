37e5d59e68f43693b77aec399178b3988e45"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/748f1dda-d83d-44ec-bafc-796d105a4c64","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/rattighet-visning-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten presenterar information om rättigheter och gemensamhetsanläggningar som redovisas i Fastighetsregistrets allmänna del. Informationen är uppdelad i två separata skikt; Rättigheter och Gränspunktstext, rättigheter."},"dct:identifier":"748f1dda-d83d-44ec-bafc-796d105a4c64","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Rättighet Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:bb9b3c9177e725a6f4824dc0fa74e368698b2ae8e3f37450ff083456769e3ad8"},{"@graph":[{"@id":"_:bc4ec79628efc0f272be1aa06153b23b68faa5c104c3cd641de48b993b4ece75_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59207701286 69.059970495251,24.177674044859 69.059970495251,24.177674044859 55.137212557872,10.59207701286 55.137212557872,10.59207701286 69.059970495251))"}},{"@id":"_:bc4ec79628efc0f272be1aa06153b23b68faa5c104c3cd641de48b993b4ece75_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/69e39654-24e6-4c83-87e6-bcdf49045e5f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0"},"dcat:distribution":[{"@id":"urn:uuid:1ad6bc83-5a7f-a00a-ff83-a993f34f056c"},{"@id":"urn:uuid:3cac0dfb-8424-d591-6778-33c78f93fe0e"},{"@id":"urn:uuid:92dd2743-8f4c-5d90-aeb0-3df197cbd057"},{"@id":"urn:uuid:fe2a30d8-c7a0-eb9a-d3fd-6ad921ed2c2c"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Vandringshinder i vatten. Baserat på data i Nationella Biotopkarteringsdatabasen. Omfattar data från genomförda biotop- eller vandringshinderkarteringar. \n \nUppgifter om objekt som kan utgöra vandringshinder för vattenlevande organismer. Exempel på objekt är dammar, vägpassager, fiskgaller etc. Omfattar både naturliga och artificiella vandringshinder. Data kan användas för åtgärdsplanering, bedömning av kontinuitet, forskning m m. \n\nVissa vandringshinder kan ha flera dataprotokoll. Dessa presenteras på kartan som separata punkter på exakt samma plats och med referens till samma vandringshinder. Om data från lagret ska användas för att presentera statistik över vandringshinder måste dessa dubbletter sorteras bort innan statistiken färdigställs för att inte ge ett missvisande antal vandringshinder.\n \nObservera att alla läns data ej är inlagd ännu. Komplettering pågår.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"69e39654-24e6-4c83-87e6-bcdf49045e5f","dct:issued":{"@type":"xsd:date","@value":"2010-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:bc4ec79628efc0f272be1aa06153b23b68faa5c104c3cd641de48b993b4ece75_b0n0"},"dct:title":{"@language":"sv","@value":"LST Biotopkartering vandringshinder Aktuell"}},{"@id":"urn:uuid:1ad6bc83-5a7f-a00a-ff83-a993f34f056c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Biotopkartering_vandringshinder_EXT/MapServer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapService"}},{"@id":"urn:uuid:3cac0dfb-8424-d591-6778-33c78f93fe0e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Geodata/Datadistribution/ZIP/LST_Biotopkartering_vandringshinder.zip"},"dct:description":{"@language":"sv","@value":"Veckovis uppdaterad shapefil över vandringshinder från biotopkarteringsdatabasen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"LST_Biotopkartering_vandringshinder.zip"}},{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bc4ec79628efc0f272be1aa06153b23b68faa5c104c3cd641de48b993b4ece75_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Vatten och miljömål"},{"@id":"urn:uuid:92dd2743-8f4c-5d90-aeb0-3df197cbd057","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.Biotopkartering_vandringshinder.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:fe2a30d8-c7a0-eb9a-d3fd-6ad921ed2c2c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Biotopkartering_vandringshinder_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS"}}],"@id":"urn:source:bc4ec79628efc0f272be1aa06153b23b68faa5c104c3cd641de48b993b4ece75"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/7e7a789b-3187-4f40-ac3d-11f4ac150cc6","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Demografiska statistikområden (DeSO) är en rikstäckande indelning skapad av SCB som började gälla i januari 2018. En ny version publicerades 2025.\n\nDeSO delar in Sverige i 6 160 områden där de flesta områden har en befolkning mellan 700 och 3 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering.\n\nDeSO har inte benämningar eller namn utan beskrivs med en kod med nio unika positioner. De första fyra består av läns- och kommunkoden och pekar ut det län och den kommun som området ligger i. \n\nDen femte positionen pekar ut vilken kategori som området tillhör A, B eller C. A är områden som till största del ligger utanför större befolkningskoncentrationer eller tätorter.  B är områden som till större delen ligger i befolkningskoncentrationer eller tätorter men som inte är en centralort. Kategori C är de områden som till större delen finns i kommunens centralort. \n\nDe tre efterföljande positionerna består av ett löpnummer som sorterar områdena geografiskt. Den här sorteringen utgår ifrån kategorierna och börjar i söder och fortsätter norröver. Den sista positionen är en reservplats som kommer användas i fall ett DeSO i framtiden behöver splittras. Ett DeSO kan bara förekomma på en plats."},"dct:identifier":"7e7a789b-3187-4f40-ac3d-11f4ac150cc6","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Demografiska statistikområden - DeSO WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:bc7466f842f3158ec4b522e1ffe09c5054dc49ece31a190ff0eae4421295c644"},{"@graph":[{"@id":"_:bca858291822b26f8b8fcc2d434a3b6378b491aa72a657451275aa7edf4276b8_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.62891 58.13399,15.2147 58.13399,15.2147 57.0471,13.62891 57.0471,13.62891 58.13399))"}},{"@id":"_:bca858291822b26f8b8fcc2d434a3b6378b491aa72a657451275aa7edf4276b8_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/61b8ab84-39bb-4181-833c-d09640580238","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7"},"dcat:distribution":[{"@id":"urn:uuid:055caded-78b8-6293-8d30-6942d53e7537"},{"@id":"urn:uuid:513baa25-fd5b-39ff-d229-887a38d943c8"},{"@id":"urn:uuid:a33106f3-8255-129a-3541-2567e2074259"},{"@id":"urn:uuid:cfa27a4f-180a-1430-0e9d-1d6b2a332e8e"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Underlaget innehåller en dokumentation och kulturhistorisk värdering av vattenanknutna forn- och kulturlämningar i Jönköpings län samt i gränsvattendrag mot andra län. \n\nLstF KulturAqua -kulturhistoria vid vatten är en GISifiering och förädling av en accessdatabas för projekt Kultur Aqua: Inventering av Kulturmiljöer vid, i och inom 100 meter från vattendrag eller med indirekt anknytning till sådana miljöer. Databasen redovisar inventeringar utförda inom Jönköpings län samt i gränsvattendrag mot andra län, åren 2004-2006, 2010-2012 samt fortlöpande fr.o.m år 2013. Inventeringen och databasen syftar till att synliggöra alla kända och sedan tidigare icke-registrerade fornlämningar och industrilämningar vattendragsvis, och ska utgöra underlag för naturvård och kulturmiljövård i samband med biotopåterställande åtgärder som kan beröra kulturmiljöer. Objekten i databasen och konceptet med Kultur Aqua är att redovisa all kulturhistoria på ett bräde med en spännvidd från äldre stenålder fram till industrilämningar från mitten av 1900-talet. I databasen finns värderingsmetoden framtagen för Kultur Aqua för att kunna göra prioriteringar när flera olika intressen står på spel. Anvisar om lagrum behöver tillämpas, huvudsakligen Kulturmiljölagen (KML) styrt efter en fornlämnings klassning som fornlämning. Även klassningar som riksintressen kan vara styrande i juridisk mening och beröra andra lagstiftningar som MB, Plan- och bygglagen samt Skogsvårdslagens hänsynsparagrafer. Databasen är uppbyggd/modifierad av arkeologer verksamma vid Länsstyrelsen i Jönköpings län samt Jönköpings läns museum. Ansvarig för datasetets ajourhållning är Länsstyrelsens projektledare/arkeolog på Kulturmiljöenheten. Grunderna för projektet samt de dokument som styr värderingsmetoder kan laddas ned på länsstyrelsens hemsida. En mer utförlig beskrivning av resursens uppbyggnad och attributfält finns nedan. Skiktet kommer att uppdateras då fler objekt tillkommit från ytterligare inventeringar samt att äldre icke-införda geometrier och data tillförs. Konceptet med de omfattande rapporterna kommer att förändras, istället kommer en lightversion av rapport framställas baserat på enkla data för inventerade objekt. Mer fokus kommer att läggas på enklare inventeringar och GIS-skiktet som signalmarkör för en kulturmiljö att ev. ytterligare fördjupade studier/utredningar och inventeringar behöver göras om en \"hotbild\" eller åtgärd blir aktuell."},"dct:identifier":"61b8ab84-39bb-4181-833c-d09640580238","dct:issued":{"@type":"xsd:date","@value":"2014-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-02-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:bca858291822b26f8b8fcc2d434a3b6378b491aa72a657451275aa7edf4276b8_b0n0"},"dct:title":{"@language":"sv","@value":"LstF KulturAqua - kulturhistoria vid vatten"}},{"@id":"urn:uuid:055caded-78b8-6293-8d30-6942d53e7537","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.kultur_kulturaqua.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:513baa25-fd5b-39ff-d229-887a38d943c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_1/MapServer/WMSServer?layers=lstf_kulturaqua_kulturhistoria_vid_vatten"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"lstf_kulturaqua_kulturhistoria_vid_vatten (WMS)"}},{"@id":"urn:uuid:a33106f3-8255-129a-3541-2567e2074259","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_kulturmiljo_EXT/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:cfa27a4f-180a-1430-0e9d-1d6b2a332e8e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_1/MapServer/10"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Kulturmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bca858291822b26f8b8fcc2d434a3b6378b491aa72a657451275aa7edf4276b8_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Kulturmiljöenheten"}],"@id":"urn:source:bca858291822b26f8b8fcc2d434a3b6378b491aa72a657451275aa7edf4276b8"},{"@graph":[{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är baserat på den indelning som gjordes för limniska vattentypsregioner 2006. Denna indelning beskrivs i Bilaga 1 i Naturvårdsverkets författningssamling (2006). I denna revidering har höjdskiktet oh_riks i översiktskartan från Lantmäteriet använts för att ta fram Norra Sverige >800 m och Norra Sverige <200 m. Norrlands inland mellan 800 m och 200 m är resterande områden norr om 60 grader N fram tills 60 graders-linjen möter Dalälvens huvudavrinningsområde, där utgör i stället huvudavrinningsområdet gränsen mot Södra Sverige. Sveriges landsgräns från översiktskartan har använts för att redigera avrinningsområden utanför Sveriges gränser. Kustområden framtagna i Svenskt Vattenarkiv, SVAR från SMHI har använts för att avgränsa de limniska vattentypsregionerna mot kusten."}},{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/8d392f6d-fdb3-ded2-7d85-c4658bfbba79","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:450a8c02-39c4-1af7-e72d-75e210e7ab51"},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"}],"dcat:distribution":[{"@id":"urn:uuid:0d2e626f-0190-25cc-fd84-696f93c60138"},{"@id":"urn:uuid:76c4b2f0-2bb6-5757-8532-a028b18b8255"}],"dcat:keyword":[{"@language":"sv","@value":"Biogeografiska regioner"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/br"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Sverige har delats upp i fyra olika regioner för att underlätta arbetet med typning av sjöar och vattendrag. De fyra regionerna är indelade efter en gräns mellan norra och södra Sverige, 800 meter över havet i norra Sverige, 200 meter över havet i norra Sverige samt regionen däremellan. Kartskiktet ska vara en hjälp för typning av rapporterings- och vattenförekomster enligt Havs- och vattenmyndighetens föreskrifter (HVMFS 2017:20) om kartläggning och analys av ytvatten enligt förordningen (2004:660) om förvaltning av kvaliteten på vattenmiljön."},"dct:identifier":"8d392f6d-fdb3-ded2-7d85-c4658bfbba79","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-26"},"dct:provenance":{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:bd21e526b071baa2d5144d29cc3b1945bddff55bbf2a2f5787922e274400dddb_b1n0"},"dct:title":{"@language":"sv","@value":"Limniska vattentypsregioner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0d2e626f-0190-25cc-fd84-696f93c60138","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://geodata.havochvatten.se/geoservices/limniska-vattentypsregioner/ows"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":