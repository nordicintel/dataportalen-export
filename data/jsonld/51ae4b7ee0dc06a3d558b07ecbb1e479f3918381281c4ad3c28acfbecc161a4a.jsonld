f2e28bc100255d6bd5acbb0f191833d64_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:c96365db90ce75f8987ce3279d032d6f2e28bc100255d6bd5acbb0f191833d64_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:c96365db90ce75f8987ce3279d032d6f2e28bc100255d6bd5acbb0f191833d64_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/b279267b-54a4-4c8d-bd35-7969d8eb396e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0b1a8862-a371-2721-fcc1-2b2a9c0880e9"},{"@id":"urn:uuid:15cca012-2555-665e-efe5-cf2ea572e8c4"}],"dcat:keyword":[{"@language":"sv","@value":"Administrativa enheter"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Detta är inspirerepresentationen av sjöterritoriets gräns i havet, angränsandezonens yttre avgränsningslinje, gräns för ekonomisk zon och kontinentalsockelns yttre avgränsningslinje sammanslaget. Mer information finns i metadata för respektive ingående datamängd."},"dct:identifier":"b279267b-54a4-4c8d-bd35-7969d8eb396e","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:c96365db90ce75f8987ce3279d032d6f2e28bc100255d6bd5acbb0f191833d64_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:c96365db90ce75f8987ce3279d032d6f2e28bc100255d6bd5acbb0f191833d64_b1n0"},"dct:temporal":{"@id":"_:c96365db90ce75f8987ce3279d032d6f2e28bc100255d6bd5acbb0f191833d64_b2n0"},"dct:title":{"@language":"sv","@value":"AU.MaritimeBoundary"}},{"@id":"urn:uuid:0b1a8862-a371-2721-fcc1-2b2a9c0880e9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geokatalog.sjofartsverket.se/MapService/wfs.axd/InspireAuDownload"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för Maritime Boundaries"}},{"@id":"urn:uuid:15cca012-2555-665e-efe5-cf2ea572e8c4","@t