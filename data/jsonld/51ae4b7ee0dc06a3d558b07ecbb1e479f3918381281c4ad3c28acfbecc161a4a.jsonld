21005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/cd20b459-cd6e-4a0a-9b15-22dfae6eacbb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7"},"dcat:distribution":[{"@id":"urn:uuid:33e14b3a-2652-81b1-52c6-c943a3c80d44"},{"@id":"urn:uuid:50eaf8fe-81ac-205e-d5a5-59815b46a2e6"},{"@id":"urn:uuid:af335007-aea5-6230-3c5c-a6da8b504463"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Produkten identifierar översiktligt områden som kan ha förutsättningar för erosion, ras och/eller\nslamströmmar. Dessa områden kan vara känsliga för påverkan på vegetationen liksom förändringar\nav vattenmängder, vattnets flödesvägar och rinnhastigheter, det vill säga påverkan som ofta uppstår\nvid skogsbruk och exploatering"},"dct:identifier":"cd20b459-cd6e-4a0a-9b15-22dfae6eacbb","dct:issued":{"@type":"xsd:date","@value":"2016-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-01-01"},"dct:provenance":{"@id":"_:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4_b1n0"},"dct:temporal":{"@id":"_:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4_b2n0"},"dct:title":{"@language":"sv","@value":"Ras och skred upprättad av Skogsstyrelsen"}},{"@id":"urn:uuid:33e14b3a-2652-81b1-52c6-c943a3c80d44","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaRasoskred/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS-tjänst med Ras och skred"}},{"@id":"urn:uuid:50eaf8fe-81ac-205e-d5a5-59815b46a2e6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skogsstyrelsen.se/sjalvservice/karttjanster/skogsstyrelsens-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om Skogsstyrelsens geodata"}},{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst -","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:af335007-aea5-6230-3c5c-a6da8b504463","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Rasochskred.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning- Risk för ras och skred"}}],"@id":"urn:source:2ca59c6fa4600997a7211edcc22273742fd6a016db907d9bdc3d2c9b99e235f4"},{"@graph":[{"@id":"_:2cd9a1476b9a25bcbfa1baed62da67d631258028adbc7af66b14c9aa4752fc0e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkommit genom Försvarsmaktens försorg"}},{"@id":"_:2cd9a1476b9a25bcbfa1baed62da67d631258028adbc7af66b14c9aa4752fc0e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004615","@type":"foaf:Agent","dct:identifier":"2021004615","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:exp-hkv@mil.se"},"foaf:name":{"@language":"sv","@value":"Försvarsmakten"},"foaf:page":{"@id":"https://www.forsvarsmakten.se"}},{"@id":"https://www.geodata.se/resources/766efb67-5e40-481e-9327-e4d56cb8e1f3","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:42f518c2-65e0-1f70-da2b-c9d2d16f2184"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Totalförsvaret består av två delar – en militär respektive en civil del. Försvarsmakten  redovisar områden av riksintresse samt av betydelse för totalförsvarets militära del. Områdenas gränser redovisas utifrån tillgängliga fastighetsuppgifter från Fortifikationsverket. Försvarsmakten är enligt förordningen (1988:896) om hushållning med mark- och vattenresurser m.m. sektorsmyndighet avseende redovisning av områden som av myndigheten bedöms vara av riksintresse för totalförsvarets militära del. I begreppet militär del ingår också civila myndigheter så som FOI, FRA och FMV vilkas intressen Försvarsmakten företräder. Redovisningen av riksintressen omfattar anläggningar med påverkansområden som Försvarsmakten bedömer har betydelse ur planhänseende.\n\nMer information återfinns på Försvarsmaktens webbplats: https://www.forsvarsmakten.se/regler-och-tillstand/samhallsplanering/riksintressen/"},"dct:identifier":"766efb67-5e40-481e-9327-e4d56cb8e1f3","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-16"},"dct:provenance":{"@id":"_:2cd9a1476b9a25bcbfa1baed62da67d631258028adbc7af66b14c9aa4752fc0e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004615"},"dct:spatial":{"@id":"_:2cd9a1476b9a25bcbfa1baed62da67d631258028adbc7af66b14c9aa4752fc0e_b1n0"},"dct:title":{"@language":"sv","@value":"Riksintressen för totalförsvarets militära del"}},{"@id":"urn:uuid:42f518c2-65e0-1f70-da2b-c9d2d16f2184","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.forsvarsmakten.se/globalassets/02-om-forsvarsmakten/myndighetsinformation/dokument/riksintressen/riksintressen_och_paverkningsomraden_2026.gdb.zip"},"dct:description":{"@language":"sv","@value":"FM:s webbsite"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"www.forsvarsmakten.se"}}],"@id":"urn:source:2cd9a1476b9a25bcbfa1baed62da67d631258028adbc7af66b14c9aa4752fc0e"},{"@graph":[{"@id":"_:2e5f499d00aac6f79d7c32045ed2c6b87fae4282c7ff68c84436e34874fdbef0_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:2e5f499d00aac6f79d7c32045ed2c6b87fae4282c7ff68c84436e34874fdbef0_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010---121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/78aa241c-626f-4360-aea1-6b0a1fb0a34f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51"},"dcat:endpointURL":{"@id":"https://inspire-raa.metria.se/geoserver/Byggnader/ows?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datasetet visar det geografiska läget för enskilda och statliga byggnadsminnen och kyrkor som är registrerade i Bebyggelseregistret. Datasetet ingår i INSPIRE-direktivets tema byggnader."},"dct:identifier":"78aa241c-626f-4360-aea1-6b0a1fb0a34f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2e5f499d00aac6f79d7c32045ed2c6b87fae4282c7ff68c84436e34874fdbef0_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2e5f499d00aac6f79d7c32045ed2c6b87fae4282c7ff68c84436e34874fdbef0_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:2e5f499d00aac6f79d7c32045ed2c6b87fae4282c7ff68c84436e34874fdbef0"},{"@graph":[{"@id":"_:2e6a76180460c26f22593b9263335fee24a454e2411ec9f3c9fa2438bdf93267_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:p