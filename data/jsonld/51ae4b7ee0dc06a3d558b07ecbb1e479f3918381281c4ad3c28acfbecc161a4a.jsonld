escription":{"@language":"sv","@value":"Nedladdningstjänst för temat AU Maritima enheter."},"dct:identifier":"28a22f44-af8a-4112-ac1d-1ce2d17ee9f1","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"AU.Maritima enheter - nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d9fabd9922d5a85401f6257f479084b3901c6ed7f4f8860d56071da598a8ca0f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/13933768-654e-4df6-ac27-5e62e8a07573","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografisk-webbkarta-visning-cache-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten ger tillgång till skikt med topografisk kartinformation. Ett färgsatt skikt och ett som är nedtonat i gråskala. Produkten är anpassad för skärmvisning. Den har hög prestanda vid många samtidiga anrop då den skickar förgenererade bilder i fasta skalnivåer."},"dct:identifier":"13933768-654e-4df6-ac27-5e62e8a07573","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Topografisk webbkarta Visning, cache"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:da0be3959c3a79c80967a11437079a99cccadc663564ed3f38983725fb1b9eb4"},{"@graph":[{"@id":"_:da476959e42c233639a3f2b8a9db8f899d2f3c196909755947d5609b3be6ae9a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havs- och vattenmyndighetens kartläggning och övervakning av fysisk påverkan i svenska kustvatten startades 2017"}},{"@id":"_:da476959e42c233639a3f2b8a9db8f899d2f3c196909755947d5609b3be6ae9a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 66.00,24.20 66.00,24.20 55.13,10.59 55.13,10.59 66.00))"}},{"@id":"_:da476959e42c233639a3f2b8a9db8f899d2f3c196909755947d5609b3be6ae9a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/4167e0a4-e661-040e-3566-19c03738faff","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uui