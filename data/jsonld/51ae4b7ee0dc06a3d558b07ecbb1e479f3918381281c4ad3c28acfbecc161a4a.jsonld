BLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Produkten består av dammpunkter med unik identitet. En delmängd av dammarna har också namn. Uppgifterna om dammarna har inrapporterats till SMHI av länsstyrelserna."},"dct:identifier":"7e4675f9-93d0-41a0-98c4-1ad678d3cd7f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.HY Dammregistret: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:fcd71a046b972842bd72d1f7a007a3110865255a84fafa204227f3aef208ee9f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000035","@type":"foaf:Agent","dct:identifier":"2120000035","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:varmdo.kommun@varmdo.se"},"foaf:name":{"@language":"sv","@value":"Värmdö kommun"},"foaf:page":{"@id":"https://www.varmdo.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://www.varmdo.se/upplevaochgora/kultur/bildarkiv.4.4b2bd6f9148a6b349f4b4e73.html"}},{"@id":"https://www.geodata.se/resources/3eccfd5d-8aed-4483-bd60-d2bd430f92c7","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:22935c30-4491-5149-7498-bb3da661b9d6"},"dct:description":{"@language":"sv","@value":"Primärkarta över Värmdökommun. Primärkarta finns för de centrala delarna av kommunen/tätorter. Informationen består av vägar, byggnader, anläggningar på allmän mark, fastigheter och höjdkurvor."},"dct:identifier":"3eccfd5d-8aed-4483-bd60-d2bd430f92c7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2012-02-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000035"},"dct:title":{"@language":"sv","@value":"Primärkarta Värmdökommun"}},{"@id":"urn:uuid:22935c30-4491-5149-7498-bb3da661b9d6","@type":"dcat:Distribution","dca