"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/68236a5b-6323-47dd-b3e2-1e18c1ceb855","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:f04ea2b7-1dba-1d23-494c-4a82cdc65e94"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Halterna av radioaktiva ämnen bundna till partiklar i luften har övervakats i Sverige sedan 1950-talet. I nuvarande program ingår 6 provtagningsstationer där luft kontinuerligt samlas in på filter, vilka sedan mäts en gång i veckan. Huvudsyftet med att övervaka halterna i luft är att snabbt upptäcka och följa utsläpp till luft som når Sverige. Även den långsiktiga utvecklingen avseende cesium-137 efter Tjernobylolyckan kan följas. Halter i luft rapporteras till EU i enlighet med Euratomfördraget. Data från dessa provtagningsstationer är tillgängliga från Strålsäkerhetsmyndigheten på begäran. Kartan visar provtagningsstationernas geografiska läge."},"dct:identifier":"68236a5b-6323-47dd-b3e2-1e18c1ceb855","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b1n0"},"dct:temporal":{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: radioaktiva ämnen i luft"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"},{"@id":"urn:uuid:f04ea2b7-1dba-1d23-494c-4a82cdc65e94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}}],"@id":"urn:source:a88ef12026abdd8f6c34843b4a445082c59e9d36223ca11631902f5e0ff4af52"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/339a8ebc-31f6-4e2f-9b0b-b32851451791","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/markgeokemi-regional-v2"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Markgeokemi, regional provtagning visar provtagningsplatser samt analysresultat för ett urval av grundämnen inom den regionala markgeokemiska undersökningen på Sveriges geologiska undersökning (SGU). Provtagningsplatserna visas indelade efter de analysmetoder som använts på proverna: Totalhalt XRF, Salpetersyralakning ICP-MS, Kungsvattenlakning ICP-MS, Kungsvattenlakning ICP-AES samt Kungsvattenlakning AAS. Totalhalt XRF. Flera analysmetoder kan ha använts på samma provplats.\n\nGeokemisk kartering vid SGU bedrivs i syfte att visa den naturliga förekomsten av huvudämnen och spårämnen samt pH i mark och vatten. I den regionala markgeokemiska karteringen provtas och analyseras finfraktionen (<0,063 mm) av morän med en provtäthet på ca 1 prov per 6 till 7 km2.\n\nNSG-SGAB databas är en arkiverad sammanställning av geokemisk kartering av morän vilken genomfördes av Nämnden för statens gruvegendom (NSG) år 1987-1991. Analysresultat sammanställdes av Sveriges geologiska AB (SGAB) tillsammans med data från Terra Mining Co., STC Minerals och Sveriges geologiska undersökning. Moränprover analyserades efter kungsvattenlakning med ICP-AES och AAS metoder.\n\nAntal tillgängliga grundämnen varierar i olika års provtagningsserier, vilket beror på teknikutveckling."},"dct:identifier":"339a8ebc-31f6-4e2f-9b0b-b32851451791","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Markgeokemi, regional provtagning (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a8f591d289a19354f3f7180310cf2774bf596b9dcd91e5c47109f5cf9ee84487"},{"@graph":[{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventering i fält, digitalisering och fastighetsrättslig registrering"}},{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2018"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1994"}},{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/772d46b8-25a2-42f7-b3da-4b17f610bc53","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:c169bbe3-a93c-b4a1-a146-445baccd9e1a"},{"@id":"urn:uuid:f3501dc5-2128-b358-dd29-55f750d3e25c"}],"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Naturtyper och biotoper"},{"@language":"sv","@value":"Skyddade områden"}],"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/hb"},{"@id":"http://inspire.ec.europa.eu/theme/ps"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Det är vanligt att livsmiljöer som har stor betydelse för växt- och djurarter bara påträffas som små spridda öar i ett mer alldagligt landskap. I den svenska lagstiftningen finns en möjlighet att avsätta sådana områden som så kallade biotopskyddsområden. Skogsstyrelsen ansvarar för detta områdesskydd om biotoperna ligger på skogsmark, på annan mark är länsstyrelserna ansvarig. De områden som kan få denna status är, enligt lagtexten, \"mindre mark- eller vattenområden som utgör livsmiljö för hotade djur- eller växtarter eller som annars är särskilt skyddsvärda\". Syftet med att skapa biotopskyddsområden är alltså enligt lagtexten förhållandevis entydigt de biologiska värdena. \nDet är vanligt att storleken på områdena som skyddas är 2-10 hektar men de kan vara upp till cirka 20 hektar stora. Rätten att färdas och vistas kan regleras i områdena, men i övrigt formuleras inga föreskrifter eller förbud för varje särskilt område. Det finns i stället en allmän regel från lagtexten, som säger att det i områdena inte får bedrivas verksamhet eller vidtas åtgärder som kan skada naturmiljön."},"dct:identifier":"772d46b8-25a2-42f7-b3da-4b17f610bc53","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-29"},"dct:provenance":{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b1n0"},"dct:temporal":{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b2n0"},"dct:title":{"@language":"sv","@value":"PS.Biotopskydd beslutade av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:c169bbe3-a93c-b4a1-a146-445baccd9e1a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaBiotopskydd/MapServer/WmsServer?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst - Biotopskydd"}},{"@id":"urn:uuid:f3501dc5-2128-b358-dd29-55f750d3e25c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Biotopskydd.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av biotopskydd producerade av Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av biotopskydd - atomflöde"}}],"@id":"urn:source:a9224b9528fac94bce2a5ebcc1b4bfd48b8cedebb024703b7e0363cfd631e99b"},{"@graph":[{"@id":"_:a92c1098bdd653d45d27e735fc743fc1a3e16d31eda5e646f94316b44e1f3e92_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:a92c1098bdd653d45d27e735fc743fc1a3e16d31eda5e646f94316b44e1f3e92_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/7157be6b-db4e-4566-b74f-3e1d3613bfcf","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:endpointURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets visningstjänst\nInnehåller visningstjänst för datamängderna:\n\nArtdata observation\nJordbruksblock\nJordbruksblock, senaste året\nJordbruksskiften\nJordbruksskiften, senaste året\nNitratkänsliga områden\nNitratmätstationer\nProduktionsplatser\nRestriktionsområden\nVattenbruksanläggningar\nÄngs- och betesmarksinventeringen\nÄngs- och betesmarksinventeringen naturtyper"},"dct:identifier":"7157be6b-db4e-4566-b74f-3e1d3613bfcf","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a92c1098bdd653d45d27e735fc743fc1a3e16d31eda5e646f94316b44e1f3e92_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a92c1098bdd653d45d27e735fc743fc1a3e16d31eda5e646f94316b44e1f3e92_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"}],"@id":"urn:source:a92c1098bdd653d45d27e735fc743fc1a3e16d31eda5e646f94316b44e1f3e92"},{"@graph":[{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ursprungsvärden angivna i RT90 avrundat till närmast jämna 100-tal meter. t.ex. 6593700, 1613300, sedan transformerat till SWEREF99TM via lantmäteriets koordinattransformator."}},{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2006"}},{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/337ad7f8-f036-4f24-a6e4-653956f374e1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:d8c00ae3-8d31-4583-003d-337f76b42dde"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har haft ett övervakningsprogram avseende halter av radioaktiva ämnen i havsvatten sedan 2006. I nuvarande program ingår 6 provtagningsstationer som provtas 1-2 gånger per år. Halter i havsvatten rapporteras till EU i enlighet med Euratomfördraget. Data från dessa provtagningsstationer är tillgängliga via Strålsäkerhetsmyndigheten webbplats. Kartan visar provtagningsstationernas geografiska läge."},"dct:identifier":"337ad7f8-f036-4f24-a6e4-653956f374e1","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b1n0"},"dct:temporal":{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: radioaktiva ämnen i havsvatten"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"},{"@id":"urn:uuid:d8c00ae3-8d31-4583-003d-337f76b42dde","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}}],"@id":"urn:source:a946eed30aa2ded9ee93a85768a809b40ee8c172e7c26e7ca73e0723397394ad"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/8435e760-e770-11ea-ac97-ab810184d520","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp.atom"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Dammregistret\nProdukten består av dammpunkter med unik identitet. En delmängd av dammarna har också namn. Uppgifterna om dammarna har inrapporterats till SMHI av länsstyrelserna. \n\nAvrinningsområden\nAvrinningsområden är avgränsade med vattendelare och en eller flera utloppsplatser.\nOm ett avrinningsområde definieras för en utloppsplats inom ett befintligt avrinningsområde\nså bildas delavrinningsområden. En utloppsplats för ett delområde blir då inloppsplats\nför delområdet som ligger nedströms.\nVattendelarna är abstrakta avgränsningar som görs efter höjdinformation. Vattendelarna\nskapas i kartdata på högsta möjliga ställen med början vid valda utloppsplatser så\natt det skapas ett avgränsat område uppströms. Man antar att nederbörd rinner av åt\nolika håll vid en vattendelare, som om vattnet rinner av på markytan eller som om\nvattendelaren fortsätter lodrätt ner i marken.\nFör ett avrinningsområde kan vattenföringen i utloppsplatsen beräknas med hjälp av\ninformation om områdets area, mark, sjöar, vattendragslängder, nederbörd, avdunstning,\nsnömagasinering m.m.\nProdukten innehåller 52358 polygoner som representerar delavrinningsområden som tillsammans\ntäcker hela Sverige."},"dct:identifier":"8435e760-e770-11ea-ac97-ab810184d520","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.HY Dammregistret, Del- och Huvudavrinningsområden: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a96fdee5f1e27a40005e7c1e813e58a2dcb93bf0939d28e896bf1aa7296e1ba5"},{"@graph":[{"@id":"_:a975d85fe1ee0a6d9f71cb6fed020d64e0fe51c99da25094b0f9aaa754683844_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:a975d85fe1ee0a6d9f71cb6fed020d64e0fe51c99da25094b0f9aaa754683844_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a8f1a87f-4761-4fd8-8e12-a90d56c74e2b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:distribution":[{"@id":"urn:uuid:b9d0eefd-ed1a-27e6-8112-70878881a06f"},{"@id":"urn:uuid:c07ccf8f-1932-2122-f132-e9eeed82565a"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tillståndspliktig miljöfarlig verksamhet. Denna datamängd innehåller punkter för anläggningar enligt NACE 05-09 . Källa: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfarlig verksamhet. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län."},"dct:identifier":"a8f1a87f-4761-4fd8-8e12-a90d56c74e2b","dct:issued":{"@type":"xsd:date","@value":"2019-09-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:a975d85fe1ee0a6d9f71cb6fed020d64e0fe51c99da25094b0f9aaa754683844_b0n0"},"dct:title":{"@language":"sv","@value":"SE.PF Täkter (NACE B)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a975d85fe1ee0a6d9f71cb6fed020d64e0fe51c99da25094b0f9aaa754683844_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"},{"@id":"urn:uuid:b9d0eefd-ed1a-27e6-8112-70878881a06f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_pf/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}},{"@id":"urn:uuid:c07ccf8f-1932-2122-f132-e9eeed82565a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/pf_takter.xml"},"dct:description":{"@language":"sv","@value":"LST ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST ATOM"}}],"@id":"urn:source:a975d85fe1ee0a6d9f71cb6fed020d64e0fe51c99da25094b0f9aaa754683844"},{"@graph":[{"@id":"_:a9d49e6c1f2bc4b39710df69f31f70ac8aedcb3214e30f38bc3ab541c66f145e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen baseras på SGUs produkt Berggrund 1:1 M, och har transformerats för att överensstämma med Inspire dataspecifikation för tema Geologi, genom kodning enligt GeoSciML 4.1. \n\nGrundkällorna för information till berggrundskartan över Sverige i skala 1:1 miljon är berggrundsgeologiska kartdatabaser sammanställda av Sveriges geologiska undersökning över den fennoskandiska skölden år 2001, och över den kaledoniska orogenen och det neoproterozoiska–fanerozoiska plattformstäcket år 1994. Informationen som presenteras i dessa två kartsammanställningar har systematiskt uppdaterats med information från SGUs berggrundsgeologiska kartdatabaser i skala 1:50 000 och 1:250 000 som var tillgänglig år 2009. Vissa uppgifter från vetenskapliga publikationer ingick också i sammanställningen. En tryckt karta som utgavs år 2012 (Bergman, S., Stephens, M.B., Andersson, J., Kathol, B. & Bergman, T., 2012: Sveriges berggrund, skala 1:1 miljon. Sveriges geologiska undersökning K 423) innehåller information om den dåvarande täckningsgraden för berggrundsgeologiska kartdatabaser i skala 1:50 000 och 1:250 000. Den rumsliga utbredningen av berggrundsenheter och strukturer i de lokala och regionala databaserna baseras på en integrerad tolkning av geologiska och geofysiska grunddata. Geologin är sammanställd fram till gränsen för den svenska ekonomiska zonen. Smärre korrigeringar i databasen gjordes 2016.\n\nKartbilden är generaliserad för att ge god läsbarhet i presentationsskalan 1:1 miljon. Generaliseringen innebär att man medvetet ritar fel för att öka läsbarheten. Exempelvis kan flera små närliggande objekt ritas som ett objekt eller en flikig gräns mellan två objekt ritas som en utjämnad linje. Det är viktigt att ta hänsyn till detta t.ex. vid tolkning av resultat från GIS-analys. Kartan bör inte förstoras till annan skala."}},{"@id":"_:a9d49e6c1f2bc4b39710df69f31f70ac8aedcb3214e30f38bc3ab541c66f145e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.40 68.82,25.52 68.82,25.52 54.90,10.40 54.90,10.40 68.82))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/53849f12-8795-48da-a839-64b792eba33e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:748406ed-ad4d-7bda-ccb5-173f7752475f"},{"@id":"urn:uuid:e2dab316-b178-8931-881e-ccd9c88e8256"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"GE.Berggund 1:1 miljon är en förenklad och transformerad version av SGUs produkt Berggrund 1:1 miljon i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nBerggrundskartan är en tvådimensionell modell av berggrundens överyta och ger en översiktlig bild av huvuddragen i Sveriges berggrund. Produkten beskriver utbredningen av olika berggrundsenheter, materialsammansättning och geologiska händelser som har påverkat enheterna. Deformationszoner som förkastningar redovisas också.\n\nProdukten är anpassad för presentation i skala 1:1 miljon, vilket innebär att informationen är kraftigt generaliserad."},{"@language":"sv","@value":"Syftet med berggrundskartan är att ge underlag för mycket översiktlig planering och analys, forskning och utbildning. Kartbilden är anpassad för presentation i skala 1:1 miljon, vilket innebär att informationen är generaliserad och inte avsedd för mer detaljerat bruk."}],"dct:identifier":"53849f12-8795-48da-a839-64b792eba33e","dct:issued":{"@type":"xsd:date","@value":"2019-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-01-21"},"dct:provenance":{"@id":"_:a9d49e6c1f2bc4b39710df69f31f70ac8aedcb3214e30f38bc3ab541c66f145e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:a9d49e6c1f2bc4b39710df69f31f70ac8aedcb3214e30f38bc3ab541c66f145e_b1n0"},"dct:title":{"@language":"sv","@value":"GE.Berggrund 1:1 miljon"}},{"@id":"urn:uuid:748406ed-ad4d-7bda-ccb5-173f7752475f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Berggrund_1M"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:e2dab316-b178-8931-881e-ccd9c88e8256","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Bedrock_1M.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}}],"@id":"urn:source:a9d49e6c1f2bc4b39710df69f31f70ac8aedcb3214e30f38bc3ab541c66f145e"},{"@graph":[{"@id":"_:a9d74da1919eb06034a1325ddf67acf0f0e0b643e6e8796e8c110df21ea03c0f_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/64870b0d-1f23-2815-1812-915f119676b9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":{"@id":"urn:uuid:6a866f50-1694-72ba-4572-8e78f7571b62"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Företagsekonomisk data för yrkesfisket till havs som samlas in inom DCF/EU-MAP. Data innehåller exempelvis landad vikt och värde, förädlingsvärde, bruttoresultat, nettoresultat antal arbetande etc. Pga sekretess är den aggregerad på olika nivåer bland annat vilket område man mestadels har sitt fiske, vilken art man landar till största del av eller vilken längd- och redskapssegment man tillhör."},"dct:identifier":"64870b0d-1f23-2815-1812-915f119676b9","dct:issued":{"@type":"xsd:date","@value":"2008-12-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2008-12-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Ekonomisk data för yrkesfisket till havs, DCF/EU-MAP"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a9d74da1919eb06034a1325ddf67acf0f0e0b643e6e8796e8c110df21ea03c0f_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:6a866f50-1694-72ba-4572-8e78f7571b62","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://havsbanken.havochvatten.se/dv/ui/project.jsp?pageid=visualAnalyzer&reportpath=%252F%2540Catalog%252Fshared%252FEkbas%252FEkonomisk%20information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Ekonomiskdata för yrkesfisket till havs, DCF/EU-MAP"}}],"@id":"urn:source:a9d74da1919eb06034a1325ddf67acf0f0e0b643e6e8796e8c110df21ea03c0f"},{"@graph":[{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"A collection of spatial data officially published by Sweden AIP."}},{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.01 70.01,25.01 70.01,25.01 53.01,10.01 53.01,10.01 70.01))"}},{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60179","http://www.w3.org/2006/vcard/ns#street-address":"Hospitalsgatan 30"},{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:011-192000"}},{"@id":"http://dataportal.se/organisation/SE2021000795","@type":"foaf:Agent","dct:identifier":"2021000795","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lfv@lfv.se"},"foaf:name":{"@language":"sv","@value":"Luftfartsverket"},"foaf:page":{"@id":"https://www.lfv.se"}},{"@id":"https://www.geodata.se/resources/ff084649-0ec8-4149-94cf-3a8cce587462","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:d5f903d7-545f-6c1e-7849-fbc4007c05ba"},"dcat:distribution":[{"@id":"urn:uuid:5f1c0955-b572-778e-5d69-beb9db8fabdb"},{"@id":"urn:uuid:d6d86408-cdf9-bf37-d599-aa42d7ac6804"},{"@id":"urn:uuid:f24ebb9e-aec8-ea3c-ea73-5ea182a1e6e9"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Transportnät"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/tn"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Aeronautical Information (mAIS) is the official Swedish GIS dataset covering Air Traffic Management spatial information. The data set defined by approximately 40 layers covering the different feature types from Sweden AIP (Aeronautical Information Package), including Controlled Airspaces, Restricted Airspaces, Routes, Significant Points, Navigational Aids, Aerodrome facilities, En-route obstacles etc. The dataset does not follow the Feature Type definition of INSPIRE. The dataset is namespaced as \"mais\"."},"dct:identifier":"ff084649-0ec8-4149-94cf-3a8cce587462","dct:issued":{"@type":"xsd:date","@value":"2012-06-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-06-04"},"dct:provenance":{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000795"},"dct:spatial":{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b1n0"},"dct:title":{"@language":"sv","@value":"Aeronautical Information (mAIS) - Dataset"}},{"@id":"urn:uuid:5f1c0955-b572-778e-5d69-beb9db8fabdb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://daim.lfv.se/geoserver/mais/wfs?"},"dct:description":{"@language":"sv","@value":"WFS-sida för nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"WFS"}},{"@id":"urn:uuid:d5f903d7-545f-6c1e-7849-fbc4007c05ba","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Operations AIM","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:aim-konsult@lfv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Luftfartsverket"},{"@id":"urn:uuid:d6d86408-cdf9-bf37-d599-aa42d7ac6804","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://daim.lfv.se/geoserver/mais/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS-sida för karttjänst"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"urn:uuid:f24ebb9e-aec8-ea3c-ea73-5ea182a1e6e9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.lfv.se"},"dct:description":{"@language":"sv","@value":"Description of LFV."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LFV"}}],"@id":"urn:source:aa1eb91a82311f7f280196ca0fa60ffe0adf68a812bb545939dc0c49cf1776ba"},{"@graph":[{"@id":"_:aa4d1af701f760664d15e2a76d7db3010344b18e9ee084e01c3e20e229673f0e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ythöjdmodellen framställs genom matchning av flygbilder från Nationella bildförsörjningsprogrammet. Det resulterande punktmolnet glesas ut och omsamplas så att det blir 0.25 respektive 0,5 m mellan punkterna där det finns flygfoton med 0.15 respektive 0,25 m upplösning på marken och 0.5 respektive 1 m där det finns flygfoton med 0.37 respektive 0,48 m upplösning. Där det saknas punkter fylls hålen igen med interpolerade värden. Ingen interpolering har gjorts i ythöjdmodellen före 2019 vilket innebär att punktmolnet innehåller tomma områden. Punkterna får sina färger från flygbildernas pixelvärden i samband med matchningen."}},{"@id":"_:aa4d1af701f760664d15e2a76d7db3010344b18e9ee084e01c3e20e229673f0e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/f4945139-3c9b-4237-bf48-899ff7124714","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:33081a11-d890-24dc-b494-d6d1c3b1fbbb"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ythöjdmodell Nedladdning, från flygbilder i färg levereras med färg från flygbildernas pixelvärden.\nYthöjdmodellen skapas genom flygbildsmatchning och är en typ av höjdmodell som beskriver vad som syns från luften. Ovansidan av vegetation, byggnader och annat ovanpå marken finns med. På öppen mark, där det inte finns vegetation, byggnader eller annat, visar ythöjdmodellen markytan. Punkterna som utgör ythöjdmodellen är inte en tredimensionell svärm med punkter, utan det är ett lager höjdsatta punkter (2,5D-modell). Ythöjdmodellen har flera användningsområden, den kan till exempel användas för att visualisera landskapet och hitta förändringar, beräkna skogstillväxt, höjdsätta 3D-data, eller simulera hur gasutsläpp färdas."},"dct:identifier":"f4945139-3c9b-4237-bf48-899ff7124714","dct:issued":{"@type":"xsd:date","@value":"2016-10-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-01"},"dct:provenance":{"@id":"_:aa4d1af701f760664d15e2a76d7db3010344b18e9ee084e01c3e20e229673f0e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:aa4d1af701f760664d15e2a76d7db3010344b18e9ee084e01c3e20e229673f0e_b1n0"},"dct:title":{"@language":"sv","@value":"Ythöjdmodell Nedladdning, från flygbilder i färg"}},{"@id":"urn:uuid:33081a11-d890-24dc-b494-d6d1c3b1fbbb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/ythojdmodell-nedladdning"},"dct:description":{"@language":"sv","@value":"Produktsida för Ythöjdmodell Nedladdning, från flygbilder i färg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktsida för Ythöjdmodell Nedladdning, från flygbilder i färg"}}],"@id":"urn:source:aa4d1af701f760664d15e2a76d7db3010344b18e9ee084e01c3e20e229673f0e"},{"@graph":[{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Jorddjupsobservationerna härrör från olika databaser på SGU och har samlats in med olika metodik under lång tid. Observationerna är gjorda i fält i samband med SGU:s inventeringar och karteringar eller har sammanställts av SGU efter rapportering från externa aktörer, exempelvis inom brunnsborrning eller geotekniska undersökningar. De olika uppgifterna rörande jorddjup i ursprungsdatabaserna har sedan sammanställts till en gemensam modell i denna produkt. \n\nEn uppskattning av lägesnoggrannhet redovisas för varje observation. I övrigt finns ingen systematisk kvalitetsrapportering."}},{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1956"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3c0baffe-a75f-4cfb-a644-e15381d5cfc1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:10892375-a7ee-c172-0784-b0d5936ffce1"},{"@id":"urn:uuid:147b7f89-85f0-4da8-e778-19e7daa430fa"},{"@id":"urn:uuid:1e739fdb-e234-3b11-bd70-94f294b444f3"},{"@id":"urn:uuid:308be172-7e3c-386c-e7a9-86e635af2ebf"},{"@id":"urn:uuid:4c8ff010-e505-16b8-5578-e16e4d32242c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Datamängden är en sammanställning av jorddjupsuppgifter som punktdata från olika databaser vid SGU. Dessa databaser är sådana som innehåller stratigrafiska observationer eller på annat sätt innehåller uppgifter om jorddjup eller hällobservationer. Med jorddjup avses mäktigheten av jordlagren ner till fast berg. \n\nJorddjupsobservationer innehåller information om jorddjup som finns inlagrat i SGUs olika databaser. Informationen kan delas upp i tre kategorier: 1) observationer där jordmäktigheten ner till berg har konstaterats, 2) observationer där berg inte har påträffats och 3) observationer där berget går i dagen (jorddjupet är 0 meter)."},"dct:identifier":"3c0baffe-a75f-4cfb-a644-e15381d5cfc1","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b1n0"},"dct:temporal":{"@id":"_:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54_b2n0"},"dct:title":{"@language":"sv","@value":"Jorddjupsobservationer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10892375-a7ee-c172-0784-b0d5936ffce1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jorddjupsobservationer-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:147b7f89-85f0-4da8-e778-19e7daa430fa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jorddjupsobservationer/jorddjupsobservationer.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:1e739fdb-e234-3b11-bd70-94f294b444f3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jorddjupsobservationer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:308be172-7e3c-386c-e7a9-86e635af2ebf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-jorddjup.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:4c8ff010-e505-16b8-5578-e16e4d32242c","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jorddjupsobservationer/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:aa7dec2af751ec53e64c9a7bf3de972a02d10bf1294715a3334ec61f2fc8ee54"},{"@graph":[{"@id":"_:aadda9388c348e81227525e48935aa076a4c3ffe0c51cbc1560d26ac203f31af_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från och med 2014 t.o.m. 2018 genomfördes flygfotografering med 0.48 m upplösning i fjällen och Sveriges inland, samt med 0.24 m upplösning i södra Sverige, längs Norrlandskusten och över ett antal tätorter i inlandet. Tidigare genomfördes flygfotografering med 0.24 m upplösning endast över ett antal tätorter. (Se tjänsten Geolex som finns på www.lantmateriet.se) Distinkta objekt på marken (taknockar, murhörn, större brunnar, vägmarkeringar etc.) ska ha en lägesnoggrannhet på högst 0,6 meter i plan och 0,8 meter i höjd för 0,48-bilder samt 0,3 respektive 0,4 för 0,24-bilder (uttryckt som medelfel) för att uppfylla Lantmäteriets krav på datamängden. \nFrån och med 2019 genomförs flygfotografering med 0.37 m upplösning i fjällen och Sveriges inland, samt med 0.15 m upplösning i södra Sverige, längs Norrlandskusten och över ett antal tätorter i inlandet. (Se tjänsten Geolex som finns på www.lantmateriet.se/geolex). Distinkta objekt på marken (taknockar, murhörn, större brunnar, vägmarkeringar etc.) ska ha en lägesnoggrannhet på högst 0,5 meter i plan och 0,7 meter i höjd för 0,37-bilder samt 0,2 respektive 0,25 för 0,15-bilder (uttryckt som medelfel) för att uppfylla Lantmäteriets krav på datamängden."}},{"@id":"_:aadda9388c348e81227525e48935aa076a4c3ffe0c51cbc1560d26ac203f31af_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/836d8acb-84b7-42b7-90ba-a588d623faea","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:3a75ec7d-0af1-113f-df5e-f4e7511ce2ca"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Produkten innehåller digitala flygbilder. För många av flygbilderna finns dessutom orienteringsdata. Flygbilderna finns med olika kombinationer av våglängdsband och med olika upplösningar, beroende på var i landet bilden är tagen och vilket årtal den är från."},"dct:identifier":"836d8acb-84b7-42b7-90ba-a588d623faea","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-01"},"dct:provenance":{"@id":"_:aadda9388c348e81227525e48935aa076a4c3ffe0c51cbc1560d26ac203f31af_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:aadda9388c348e81227525e48935aa076a4c3ffe0c51cbc1560d26ac203f31af_b1n0"},"dct:title":{"@language":"sv","@value":"Flygbilder Nedladdning"}},{"@id":"urn:uuid:3a75ec7d-0af1-113f-df5e-f4e7511ce2ca","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/flygbilder-nedladdning"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Flygbilder Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Flygbilder Nedladdning"}}],"@id":"urn:source:aadda9388c348e81227525e48935aa076a4c3ffe0c51cbc1560d26ac203f31af"},{"@graph":[{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"GE.Jordarter 1:200 000, Västernorrland är en transformerad version av SGUs produkt Jordarter 1:200 000 i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nDen ursprungliga karteringen utfördes under åren 1967 till 1979 och publicerades i Jordartskarta över Västernorrlands län (skala 1:200 000), SGU serie Ca 55 (1987). Under 2005 digitaliserades de områden av kartan där SGU inte hade jordartsinformation i skalområdet 1:25 000 till 1:100 000 och hydrografi (sjö och hav) från GSD-Översiktskartan infördes. I samband med digitaliseringen gjordes vissa omtolkningar och förenklingar. Produktens redovisning motsvarar därför inte helt den tryckta kartans."}},{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.838156630466 62.859455530374,18.272619147271 62.859455530374,18.272619147271 62.220011370139,14.838156630466 62.220011370139,14.838156630466 62.859455530374))"}},{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1979"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1979"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2344af6f-722b-4fa7-b017-84be9023a039","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0906ac9d-c9cf-950d-def3-1631a7379686"},{"@id":"urn:uuid:1acdca4c-8eab-87e1-eb44-be2542a3d0ab"},{"@id":"urn:uuid:38e93949-40d0-cd3b-fa0b-1ffeaf167ffb"},{"@id":"urn:uuid:f9a22f99-8894-cbbb-918e-f92c346c98c8"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"GE.Jordarter 1:200 000, Västernorrland är en transformerad version av SGUs produkt Jordarter 1:200 000, Västernorrland i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nKartan ger en mycket översiktlig bild av jordartsförhållandena inom de delar av Västernorrlands län där SGU saknar mer detaljerad jordartsinformation. Den kommer successivt att ersättas med jordartskartor i skalområdet 1:25 000 till 1:100 000. Kartan bör användas med stor försiktighet vid analyser och bedömningar av markförhållanden."},{"@language":"sv","@value":"Kartan ger en mycket översiktlig bild av jordartsförhållandena inom de delar av Västernorrlands län där SGU saknar mer detaljerad jordartsinformation."}],"dct:identifier":"2344af6f-722b-4fa7-b017-84be9023a039","dct:issued":{"@type":"xsd:date","@value":"2019-01-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-01-21"},"dct:provenance":{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b1n0"},"dct:temporal":{"@id":"_:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130_b2n0"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:200 000, Västernorrland"}},{"@id":"urn:uuid:0906ac9d-c9cf-950d-def3-1631a7379686","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Surficial-200k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:1acdca4c-8eab-87e1-eb44-be2542a3d0ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_200k?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:38e93949-40d0-cd3b-fa0b-1ffeaf167ffb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Surficial_200K.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:f9a22f99-8894-cbbb-918e-f92c346c98c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_200k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:aafb11a48db479aa8f00e1f3ef1cd454eba40ef89cde0958f48861de49dc3130"},{"@graph":[{"@id":"_:ab80c2bc1baf6dfc328f9c6f08f1054b6ad27d2c32fac6b76d47141fdd25b89c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkomsthistorik:\nFältundersökningar utfördes med SGU:s forskningsfartyg R/V Ocean Surveyor under  2018.\n\nFör mer information om utnyttjade metoder och datakvalitet hänvisas till separat projektrapport.\n\nBiologiska och substratkartor producerades med hjälp av en sammanställning av miljövariabler eller ”predictors”, vilka förbereddes med olika bio-geofysiska metoder för att estimera täckningsgrad (%) för varje sediment- och biotatyp. Dessa matades sedan in i maskininlärningsalgoritmer, ”Boosted Regression Trees” (BRT), vilka genomfördes av ”gbm” och ”caret” paketen i R (v3.4) för miljö- och statistiska beräkningar.\n\nSGU Ytsubstratkartan producerades genom att kombinera dataseten från sedimentkartorna från alla fraktioner för att skapa tematiska kartor av sedimentstorleksutbredning i kartläggningsområdet.\n\nHelcom HUB kartor togs fram genom att integrera både biologi och substratkartorna som använder det gemensamma ramverket för att definiera marina miljöklasser i Östersjöregionen (se HELCOM 2013). Det togs fram för att vara kompatibelt med den Europeiska EUNIS strukturen. Klassificeringen är hierarkisk och indelad i sex nivåer av habitat och biotoper.\n\nNatura 2000 kartor togs fram genom att integrera både biologi och substratkartorna för att skapa tematiska kartor genom de allmänt-överenskomna klassificerings kriteriet för skyddade områden av EU-medlemsländer som överenskommits i EU-kommissionen.\n\nBackscatter-kartan baseras från EM2040 systemet och bearbetades med FMGT (v7.8).\n\nBatymertidata producerades genom bearbetning av data insamlad av EM2040 MBES under 2018. En mängd griddar med 0,50 m upplösning i GeoTiff format producerades och reducerades till 5 m upplösning för denna produkt.\n\nDatakvalitet:\nNoggrannhetsbedömningar har utförts för varje modellerat dataset.\n\nNoggrannhetsbedömningar av batymetridatan utfördes med dubbelkontrollanalys genom att följa instruktioner från International Hydrographic Organization (IHO)-44 samt Sjöfartsverkets genomförande av IHO-44 och visa att batymetrinäten var inom IHO-44 Order1."}},{"@id":"_:ab80c2bc1baf6dfc328f9c6f08f1054b6ad27d2c32fac6b76d47141fdd25b89c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((18.0972 56.832,18.7092 56.832,18.7092 56.2833,18.0972 56.2833,18.0972 56.832))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/72b9f330-fb7f-4362-989a-a877a9d58154","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:678896c1-43d9-66d7-63c1-4dd3ae8af758"},{"@id":"urn:uuid:6a7a3265-bf1c-449d-c2a1-61bc7e792345"},{"@id":"urn:uuid:a2327de0-3bdf-57bc-8783-d575cb33d026"},{"@id":"urn:uuid:eb57b0f1-ede0-ce56-2483-905371775c3c"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Habitatkartorna över Hoburgs bank är resultaten från den utbredda marina habitatkartläggningen från Hoburgs bank, ett grunt havsbottenområde som sträcker sig från södra Gotland till centrala och sydvästra delarna av Egentliga Östersjön. Kartorna skapades genom att integrera bio-geofysiska data, samt maskininlärningsmodellering för att producera kontinuerliga täckningsmodeller (%) av substrat och biota. Dessa (biofysiska och geologiska) kontinuerliga modeller kombinerades sedan för att producera bentiska habitatkartor som kategoriseras enligt olika klassificeringssystem. Dessa inkluderar klassificeringssystemet HELCOM HUB för Östersjön samt det europeiska initiativprogrammet Natura 2000.\n\nKartorna och modellerna som producerats med denna metod är dessutom högupplösta (5 m), vilket gör att de kan skalas upp till skalor relevanta för förvaltning, samtidigt som den behåller viktig information från högupplösta data."},"dct:identifier":"72b9f330-fb7f-4362-989a-a877a9d58154","dct:issued":{"@type":"xsd:date","@value":"2022-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-12"},"dct:provenance":{"@id":"_:ab80c2bc1baf6dfc328f9c6f08f1054b6ad27d2c32fac6b76d47141fdd25b89c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ab80c2bc1baf6dfc328f9c6f08f1054b6ad27d2c32fac6b76d47141fdd25b89c_b1n0"},"dct:title":{"@language":"sv","@value":"Habitatkartering, Hoburgs bank"}},{"@id":"urn:uuid:678896c1-43d9-66d7-63c1-4dd3ae8af758","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/habitatkartering-hoburgs-bank-oppnadata-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:6a7a3265-bf1c-449d-c2a1-61bc7e792345","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/marin/nedladdning-habitatkartering-hoburgs-bank.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Öppna data Nedladdning ATOM"}},{"@id":"urn:uuid:a2327de0-3bdf-57bc-8783-d575cb33d026","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/geologiska-data/maringeologi--geologiska-data/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Maringeologi, Öppna data"}},{"@id":"urn:uuid:eb57b0f1-ede0-ce56-2483-905371775c3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/publikation/sgurapport/sgurapport202034rapport/s2034-rapport.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU-Rapport 2020:34"}}],"@id":"urn:source:ab80c2bc1baf6dfc328f9c6f08f1054b6ad27d2c32fac6b76d47141fdd25b89c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a3d6383c-86e6-4fce-abf5-228ec75c2620","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighet-och-samfallighet-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Aktuell information om fastigheter och samfälligheter finns i Fastighetsregistrets allmänna delen.  Där finns bl. a.:\n\n•fastighetsindelning, både gällande och historisk  \n•fastighetsrättsliga åtgärder, t.ex. avstyckningar \n•nuvarande och tidigare fastighetsbeteckning \n•centralpunktskoordinat \n•läns- och kommuntillhörighet \n•fastighetens areal"},"dct:identifier":"a3d6383c-86e6-4fce-abf5-228ec75c2620","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighet och Samfällighet Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:aba7b0a7f21ce2c90ca18e15053dee1820a136efd43bf9b156a4cd42a5c14693"},{"@graph":[{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"koordinaterna för anläggningarna är tagna utefter mejeriernas läge på hitta.se. Ursprungsvärden angivna i RT90 avrundat till närmast jämna 100-tal meter. t.ex. 6593700, 1613300, sedan transformerat till SWEREF99TM via lantmäteriets koordinattransformator."}},{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2007"}},{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/3d69100b-4898-49c1-b31c-d922ba1d6857","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:d9199341-0939-f68f-b95b-5d284a22c8c8"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har sedan 1960-talet provtagit mjölk från representativa mejerier och mätt halter av radioaktiva ämnen, i huvudsak Cs-137. I nuvarande program provtas mjölk från 5 mejerier 4 gånger per år vilken mäts med avseende på Cesium-137, Kalium-40 och Strontium-90 (två mejerier). Förhöjda halter i mjölk är en snabb respons på storskaliga nedfall, t ex i händelse av en kärnkraftsolycka, och utgör då också en potentiellt viktig exponeringsväg för människor. Halter i mjölk rapporteras även till EU i enlighet med Euratomfördraget. Data fr o m 2007 från dessa provtagningsstationer finns tillgängliga via Strålsäkerhetsmyndighetens webbplats. Kartan visar provtagningsstationernas (mejeriernas) geografiska läge."},"dct:identifier":"3d69100b-4898-49c1-b31c-d922ba1d6857","dct:issued":{"@type":"xsd:date","@value":"2016-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-23"},"dct:provenance":{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b1n0"},"dct:temporal":{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: radioaktiva ämnen i konsumtionsmjölk"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"},{"@id":"urn:uuid:d9199341-0939-f68f-b95b-5d284a22c8c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}}],"@id":"urn:source:ac1477c9fdc7c933bf1cccb8b7cd7046f2712d60322836c71d43b6c4e801e411"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/1bcb75c5-495d-4d1c-adb6-fd08874a51b8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/bedrock1m_gsml_gu/wfs?service=WFS&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"en","@value":"The dataset GE.Bedrock 1:1 million covering the whole of Sweden is available in this OGC WFS service. The service delivers data compliant to the Inspire theme Geology encoded as GeoSciML 4.0. FeatureTypes included are MappedFeature and GeologicUnit. MappedFeatures (geometry) are specified by GeologicUnits containing information on lithology and age.\n\nThe underlying dataset  GE.Bedrock 1:1 million also contains information on shear displacement structures like faults that are not included in this service."},"dct:identifier":"1bcb75c5-495d-4d1c-adb6-fd08874a51b8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"en","@value":"GE.Bedrock 1:1 million OneGeology (direct access download service)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:acae8791635b44143a1053867720517339f1d950ffadd8582ca8786835630930"},{"@graph":[{"@id":"_:ad12ee68a4c30a9d4ed75234617d1bca567c78f645fd07089f5963bc1e33fc80_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Miljöhälsoenkäten är en urvalsundersökning bland befolkningen 18-84 år. Värden presenteras på länsnivå."}},{"@id":"_:ad12ee68a4c30a9d4ed75234617d1bca567c78f645fd07089f5963bc1e33fc80_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:ad12ee68a4c30a9d4ed75234617d1bca567c78f645fd07089f5963bc1e33fc80_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2015"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2007"}},{"@id":"_:ad12ee68a4c30a9d4ed75234617d1bca567c78f645fd07089f5963bc1e33fc80_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sv","http://www.w3.org/2006/vcard/ns#locality":"Östersund","http://www.w3.org/2006/vcard/ns#postal-code":"83140","http://www.w3.org/2006/vcard/ns#street-address":"Forskarens väg 3"},{"@id":"_:ad12ee68a4c30a9d4ed75234617d1bca567c78f645fd07089f5963bc1e33fc80_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-2052959"}},{"@id":"http://dataportal.se/organisation/SE2021006545","@type":"foaf:Agent","dct:identifier":"2021006545","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@folkhalsomyndigheten.se"},"foaf:name":{"@language":"sv",