2a6db872418262e65149a505af1351153464d0fe3f1b282778eac4b6d3cfc9"},{"@graph":[{"@id":"_:14741e9aad8feb271701cb0869d56bda3e0f88dd4b0e975aab573ebe1069b229_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.16557 58.41003,16.23652 58.41003,16.23652 56.57523,12.16557 56.57523,12.16557 58.41003))"}},{"@id":"_:14741e9aad8feb271701cb0869d56bda3e0f88dd4b0e975aab573ebe1069b229_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/24f012cf-af33-4585-bb1b-22f828db515b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":[{"@id":"urn:uuid:08be992c-276c-c9fb-e259-a4770e423cff"},{"@id":"urn:uuid:480cbea3-5f19-54a4-f0b5-85f0fb4609bf"},{"@id":"urn:uuid:b39ed2cd-4282-233c-e511-866a2b4f9c22"},{"@id":"urn:uuid:c9741092-5deb-0ac4-a3d0-eb96909a9331"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skiktet är framtaget i samband med en satellitsbildsbaserad analys inom ramen för den regionala miljöövervakningen. Skiktet visar information om tjäderlämpliga marker för året 2018. ”Habitat Suitability Index” (HSI) har utvecklats för att kunna modellera tjäderlämplig mark i Jönköpings län. Röd färg har det högsta HSI - värdet och visar områden som är mest lämpliga för tjäder, mörk grön färg är näst bäst lämpliga osv. Områden som är lämpliga för tjäder är också värdefulla områden för många andra skogslevande arter. Datat kan användas vid olika ärenden t.ex. vid skydd av värdefull natur och tillståndsärenden (vindkraft, vägbyggen mm)."},"dct:identifier":"24f012cf-af33-4585-bb1b-22f828db515b","dct:issued":{"@type":"xsd:date","@value":"2020-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-02-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:14741e9aad8feb271701cb0869d56bda3e0f88dd4b0e975aab573ebe1069b229_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Barrskogens värdefulla områden i Jönköpings län (HSI) – 2018"}},{"@id":"urn:uuid:08be992c-276c-c9fb-e259-a4770e423cff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_habitat_suitability_index_tjader_EXT/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:480cbea3-5f19-54a4-f0b5-85f0fb4609bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_2/MapServer/WMSServer?layers=LstF_Barrskogens_vardefulla_omraden_i_Jonkopings_lan_HSI_2018"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Barrskogens_vardefulla_omraden_i_Jonkopings_lan_HSI_2018 (WMS)"}},{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Landenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:14741e9aad8feb271701cb0869d56bda3e0f88dd4b0e975aab573ebe106