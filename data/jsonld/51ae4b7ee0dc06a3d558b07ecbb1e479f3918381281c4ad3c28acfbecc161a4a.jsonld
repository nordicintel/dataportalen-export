":[{"@id":"_:ea263415e07df9b2625e5b641d1b78f70e2c2755d2312ebfc9f5f3ca43597c15_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:ea263415e07df9b2625e5b641d1b78f70e2c2755d2312ebfc9f5f3ca43597c15_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/4d9a6af3-a99b-9763-8c95-86d26632b1c5","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":[{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e"}],"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-bedomningsomraden/ows?"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Jordobservation och miljö"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visninsgtjänst (WMS) för datamängden Havsmiljöområdesindelning enligt havsmiljöförordningen Bedömningsområden"},"dct:identifier":"4d9a6af3-a99b-9763-8c95-86d26632b1c5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Bedömningsområden.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ea263415e07df9b2625e5b641d1b78f70e2c2755d2312ebfc9f5f3ca43597c15_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ea263415e07df9b2625e5b641d1b78f70e2c2755d2312ebfc9f5f3ca43597c15_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsmiljöenheten"}],"@id":"urn:source:ea263415e07df9b2625e5b641d1b78f70e2c2755d2312ebfc9f5f3ca43597c15"},{"@graph":[{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geografisk information i Fiskets geografier har digitaliserats från nationella föreskrifter som reglerar fiske i Sverige. Även vissa EU-förordningar (som oftast berör fritidsfiske i svenskt vatten) har digitaliserats. Områden har skapats i programmet QGIS eller FME. Fiskets geografier uppdateras med nya publiceringar i samband med ändringar till lagar och föreskrifter som ingår i informationsmängden. I regel sker nya publiceringar flera gånger per år. \n\nGeografiska beskrivningar kan vara angivna som geografiska koordinater (punkter) eller referera till olika gränser och djupangivelser (linjer). Det förekommer också hänvisningar till landskapsformationer eller byggnader. Många geografiska beskrivningar är mycket gamla och refererar till landmärken eller naturliga formationer, utan att ange koordinater. Ytorna som bygger på icke-koordinatsatta geografiska beskrivningar håller inte en bra kvalitet och bör betraktas som osäkra. \n\nGeografierna i Fiskets geografier är inte rättsverkande, och det är alltid EU förordningen, föreskriften eller annan lagstiftningen som gäller i domstolen."}},{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/b130034f-beec-5459-bc75-8f31f159f812","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:0ca422db-8b37-0e3d-122c-a4b731783fa9"},{"@id":"urn:uuid:32d7924f-0fd7-c000-70cf-f530e2ae4509"},{"@id":"urn:uuid:85dd2182-8339-c3cd-a12f-2844e68b22e4"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Områden med särskild förvaltning/begränsningar/reglering samt enheter för rapportering"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/am"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden beskriver områden som regleras av föreskrifter för fritids- som yrkesmässigt fiske i Skagerrak, Kattegatt och Östersjön, samt i Sveriges sjöar, vattendrag och kanaler. Vissa EU-förordningar som även berör fritidsfiske inkluderas också i datamängden. \nFiskets geografier uppdateras med nya publiceringar i samband med ändringar till lagar och föreskrifter som ingår i informationsmängden. I regel sker nya publiceringar flera gånger per år. \nGeografierna i Fiskets geografier är inte rättsverkande, och det är alltid EU förordningen, föreskriften eller annan lagstiftning som gäller i domstolen."},"dct:identifier":"b130034f-beec-5459-bc75-8f31f159f812","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-02"},"dct:provenance":{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b1n0"},"dct:title":{"@language":"sv","@value":"Fiskets geografier"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0ca422db-8b37-0e3d-122c-a4b731783fa9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fiskets-geografier/atom-fiskets-geografier-datafeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Fiskets geografier"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"AM.Fiskets geografier.ATOM"}},{"@id":"urn:uuid:32d7924f-0fd7-c000-70cf-f530e2ae4509","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fiskets-geografier/2026-04-02/fiskets-geografier-2026-04-02.zip"},"dct:description":{"@language":"sv","@value":"Fiskets geografier nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Fiskets geografier nedladdning"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:85dd2182-8339-c3cd-a12f-2844e68b22e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/fiskets-geografier/ows?"},"dct:description":{"@language":"sv","@value":"Fiskets geografier karttjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Fiskets geografier karttjänst"}}],"@id":"urn:source:ea7afbdfc2a246482671e3ec412c83026ba951f279e4adf9f8d456770376a270"},{"@graph":[{"@id":"_:eb4b0f49dfcfd12cf3cabc6017311950562b853811b6237383ca5dfb8ce03757_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:eb4b0f49dfcfd12cf3cabc6017311950562b853811b6237383ca5dfb8ce03757_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/705e7542-12da-470d-a0d0-be693976723b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:endpointURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst Inspire\nInnehåller nedladdningstjänst för datamängderna:\nAF.Produktionsplatser\nAF.Vattenbruk\nAM.Nitratkänsliga områden\nHB.Ängs-och betesmarksinventeringen \nHB.Ängs-och betesmarksinventeringen naturtyper\nLU.Jordbruksblock\nNitratmätstationer"},"dct:identifier":"705e7542-12da-470d-a0d0-be693976723b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:eb4b0f49dfcfd12cf3cabc6017311950562b853811b6237383ca5dfb8ce03757_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:eb4b0f49dfcfd12cf3cabc6017311950562b853811b6237383ca5dfb8ce03757_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"}],"@id":"urn:source:eb4b0f49dfcfd12cf3cabc6017311950562b853811b6237383ca5dfb8ce03757"},{"@graph":[{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tolkning och digitalisering av strandlinjerna samt analysen av strandlinjens förändring för Skånes kust har gjorts inom SGUs projekt Skånestrand med syftet att belysa strandlinjens ändringar pga. erosion och deposition av sediment längs stränderna.\nTolkning och digitalisering av strandlinjerna samt analysen av strandlinjens förändring för Hallands kust har gjorts inom SGUs projekt Halland strand, vilket delfinansierats av Statens geotekniska institut (SGI).\nMotsvarande tolkning av strandlinjer har inte gjorts för Sölvesborgs kommun, Blekinge.\n\nKvaliteten i tolkningen av strandlinjen varierar mellan olika bilder. Särskilt vid långgrunda stränder med vass och annan vegetation har det varit svårt att säkert avgöra strandens läge. Bilderna från 1939-40 har sämre noggrannhet än de övriga. De har dels sämre skärpa, dels är de inte lika noggrant rektifierade. En förskjutning på upp till 70 m har observerats, vilket delvis har kompenserats för vid tolkningen. Ytterligare en felkälla, särskilt vid långgrunda stränder, är att vattenståndet varierat vid flygfotograferingen."}},{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.324069654424 57.134319827149,14.538044789421 57.134319827149,14.538044789421 55.313917612916,12.324069654424 55.313917612916,12.324069654424 57.134319827149))"}},{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1975"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1939"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8b5b4d1e-5365-4f6b-9264-e28f152763fd","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:2beb83ff-ee76-49e6-a26e-93c5dbcc6cc5"},{"@id":"urn:uuid:861ee471-34c3-3d06-6f84-0fc05c360e79"},{"@id":"urn:uuid:bf480ace-0c8a-b5bc-becd-7e0e08f8b775"},{"@id":"urn:uuid:e2e98a98-e83c-2591-ff75-7f54a72d47ab"},{"@id":"urn:uuid:eab8cb1a-9e58-4a86-21e5-cb8de7785e29"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Informationen utger ett historiskt underlag för att belysa strandlinjens ändringar pga. erosion och deposition av sediment längs stränderna."},{"@language":"sv","@value":"Produkten visar strandlinjens läge längs Sydsveriges kust som den tolkats från ortofoton från olika år. Som underlag har använts Lantmäteriets rektifierade historiska ortofoton samt ortofoton från 1939–1940 från Geocentrum, Lunds universitet. De flesta av Lantmäteriets ortofoton är sammansatta av en mosaik av bilder från olika årtal. I de fallen har en uppdelning efter årtal gjorts och bilderna har grupperats i decennier avseende flygår. Bilderna finns från 1970-talet, 1960-talet, 1950-talet och 1939-40 och täcker in större delen av den skånska kusten. \nProdukten innehåller också en analys av hur strandlinjen förändrats från 1940 till 2010."}],"dct:identifier":"8b5b4d1e-5365-4f6b-9264-e28f152763fd","dct:issued":{"@type":"xsd:date","@value":"2016-06-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b1n0"},"dct:temporal":{"@id":"_:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318_b2n0"},"dct:title":{"@language":"sv","@value":"Historiska strandlinjer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:2beb83ff-ee76-49e6-a26e-93c5dbcc6cc5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/historiska-strandlinjer-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:861ee471-34c3-3d06-6f84-0fc05c360e79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-skanestrand.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:bf480ace-0c8a-b5bc-becd-7e0e08f8b775","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/historiska-strandlinjer/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:e2e98a98-e83c-2591-ff75-7f54a72d47ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/historiska-strandlinjer/historiska-strandlinjer.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:eab8cb1a-9e58-4a86-21e5-cb8de7785e29","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/historiska-strandlinjer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}}],"@id":"urn:source:eb5ce7d01a9cc852b09d0fab1cdb7b81ec01f2a94bc1178e1e34b94f45996318"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3ce36da9-f0ff-4acd-9f62-69dffbd5c2b7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Regionala statistikområden (RegSO) är en rikstäckande indelning skapad av SCB som började gälla 1 juni 2020. En ny version publicerades 2025.\n\nRegSO delar in Sverige i 3 363 områden med en befolkning mellan 650 och 23 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering."},"dct:identifier":"3ce36da9-f0ff-4acd-9f62-69dffbd5c2b7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Regionala statistikområden - RegSO WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ebaa523d85eecd6e37e0115c1274e314077fe0dfb29c2968d174c62cb950dcf4"},{"@graph":[{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.2929 60.50717,14.35735 60.50717,14.35735 59.17296,12.2929 59.17296,12.2929 60.50717))"}},{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/3413d11b-1656-42d9-8d24-dc207a30166d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d"},"dcat:distribution":[{"@id":"urn:uuid:bf9de077-a2c0-c9e9-3caa-a4834b072449"},{"@id":"urn:uuid:fbd49f00-3b20-2184-7fc8-5d22c40f28e3"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Sammanställning av påträffade objekt i samband med inventering av kulturmiljöer längs vattendrag i Värmlands län inom projektet VaKul. Inventeringarna genomfördes 2011-2016. Sammanställningen gjordes inför ett analysarbete 2016. Skiktet innehåller både lämningar och byggnader"},"dct:identifier":"3413d11b-1656-42d9-8d24-dc207a30166d","dct:issued":{"@type":"xsd:date","@value":"2012-12-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-12-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b0n0"},{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Vattenförvaltning och kultur (VaKul) inventering (punktobjekt)"}},{"@id":"urn:uuid:bf9de077-a2c0-c9e9-3caa-a4834b072449","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.LstS_inventering_kulturmiljovarden_vattendrag_punkt.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"},{"@id":"urn:uuid:fbd49f00-3b20-2184-7fc8-5d22c40f28e3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Kultur_faktaunderlag_ext/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:ec546678d45395f8026dea43f77d56696db664657ae4b5cfb003f1170bafac69"},{"@graph":[{"@id":"_:eca33e1114dd4d43b0e2540c105d161adfde0d622767b78711708d5c7231be79_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Uppgifterna i datamängderna är hämtade från inventeringar, dokumentationer, arkiv och litteratur. Registret fylls kontinuerligt på med ny information. Byggnadsgeometrier kommer antingen från Fastighetsregistret, när byggnaden finns där, eller digitaliseras av registreraren baserat på inventeringsdokumentationen och med fastighetskartan som underlag."}},{"@id":"_:eca33e1114dd4d43b0e2540c105d161adfde0d622767b78711708d5c7231be79_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.20306140895 69.527398458431,25.013990578477 69.527398458431,25.013990578477 54.769334649272,10.20306140895 54.769334649272,10.20306140895 69.527398458431))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/ca484649-0ec8-4149-94cf-3a8cce587400","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:25e9f82f-3b03-3ac5-eade-bbe1b5b97618"},{"@id":"urn:uuid:a952df7e-0b08-4f6a-0145-9de072ae9c37"},{"@id":"urn:uuid:e81e8055-39dd-91fd-67be-0d9c9ae00aa0"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller information om det byggda kulturarvet i Sverige, med tyngdpunkt på byggnader och anläggningar skyddade enligt kulturmiljölagen (1988:950) och förordningen (1988:1229) om statliga byggnadsminnen.\n\nBebyggelseregistret har släppts i en ny version våren 2025. I och med detta har också nya geodatatjänster tagits fram. Under en övergångsperiod kommer vissa av de gamla geodatatjänsterna finnas tillgängliga parallellt med de nya. Anledningen är att de som är beroende av de gamla tjänsterna ska få tid på sig att ställa om. De tjänster som hämtar information från det gamla registret har fått tillägget ”Gamla registret” efter sitt namn. Uppdateringar av byggnadsminnen, statliga byggnadsminnen och kyrkliga kulturminnen kommer att göras i både de gamla och de nya tjänsterna så länge de finns tillgängliga parallellt. Den nya informationsmodellen skiljer sig en del åt från den gamla och därför är attributdata också olika. Exakt vad som ändrats syns i produktbeskrivningarna för respektive tjänst."},"dct:identifier":"ca484649-0ec8-4149-94cf-3a8cce587400","dct:issued":{"@type":"xsd:date","@value":"1998-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1998-01-01"},"dct:provenance":{"@id":"_:eca33e1114dd4d43b0e2540c105d161adfde0d622767b78711708d5c7231be79_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:eca33e1114dd4d43b0e2540c105d161adfde0d622767b78711708d5c7231be79_b1n0"},"dct:title":{"@language":"sv","@value":"Information om det byggda kulturarvet, hela Sverige"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:25e9f82f-3b03-3ac5-eade-bbe1b5b97618","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dct:description":{"@language":"sv","@value":"Här kan du ladda ned öppna data och hämta wfs som tillhandahålls av Riksantikvarieämbetet."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Riksantikvarieämbetet öppna data-portal"}},{"@id":"urn:uuid:a952df7e-0b08-4f6a-0145-9de072ae9c37","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://app.raa.se/open/bebyggelse/sok-bebyggelseobjekt"},"dct:description":{"@language":"sv","@value":"Söktjänsten Bebyggelseregistret"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Söktjänsten Bebyggelseregistret"}},{"@id":"urn:uuid:e81e8055-39dd-91fd-67be-0d9c9ae00aa0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.raa.se/hitta-information/bebyggelseregistret/"},"dct:description":{"@language":"sv","@value":"Startsida för Bebyggelseregistret med länkar till mer information om bland annat vanliga frågor och informationsägare."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Bebyggelseregistret, startsida"}}],"@id":"urn:source:eca33e1114dd4d43b0e2540c105d161adfde0d622767b78711708d5c7231be79"},{"@graph":[{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Vid Brunnsarkivet på SGU lagras brunnsuppgifter som insamlats genom Lagen om uppgiftsskyldighet (SFS 1975:424, SFS 1985:245). Brunnsdatabasen innehåller uppgifter från närmare 800 000 brunnar \n(oktober 2023) och växer med ca 25 000 brunnsuppgifter varje år, varav ca 20 000 är energibrunnar för bergvärme/bergkyla och ca 5 000 är vattenbrunnar.\n\nKvaliteten på informationen är kraftigt beroende av informationslämnarnas, dvs. brunnsborrarnas, noggrannhet och ambitionsnivå.  Positionsfelets bedömda storlek beror bl.a. på om brunnsuppgiften innehåller en eller flera av uppgifterna ort, fastighetsbeteckning, borradress, koordinat m.fl. Det vanligaste är att fastighetsbeteckning finns och koordinatsättningen utförs då med hjälp av fastighetsbeteckningen och brunnen får då oftast samma koordinat som huvudbyggnadens mittpunkt. Om fastigheten är mycket stor eller utspridd på flera områden kan brunnens position bli \nosäker.\n\nFrån brunnsborrarna inkomna protokoll innehåller ibland endast uppgifter om vilken ort brunnen är borrad i, ibland finns endast fastighetsbeteckning, detta gör att lägesangivelsen kan bli osäker om fastigheten t.ex. är stor eller utspridd på flera områden."}},{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1976"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ab6f8831-829b-413f-8a2d-ed338f3aafeb","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1cdf374f-ee28-5456-ec40-11444554c82c"},{"@id":"urn:uuid:4ff8f809-0f58-bb76-87c8-c25b7ea03431"},{"@id":"urn:uuid:7fb082b6-2dd3-4659-fc04-7c60409272fe"},{"@id":"urn:uuid:8a5b10b2-95c0-e917-64af-d4b15b956376"},{"@id":"urn:uuid:aa829fcd-5eb0-e0f9-9690-17eeed2b04ef"},{"@id":"urn:uuid:d4d8d07b-6c54-f23c-a931-5b4f11fc6f3b"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"I Brunnar finns uppgifter om enskilda brunnars läge och tekniska data såsom djup, jorddjup, foderrörslängd, dimensioner, vattenkapacitet, vattennivåer och vad brunnen används till. Produkten innehåller även information om lagerföljder. Uppgifterna gäller främst bergborrade brunnar och utgörs av de uppgifter som brunnsborrare sedan 1976 enligt lag skickar in till SGU.\n\nInformationen används flitigt, både som praktisk upplysning till allmänhet och brunnsborrare, och för forskningsändamål, t.ex. statistiska bearbetningar"},"dct:identifier":"ab6f8831-829b-413f-8a2d-ed338f3aafeb","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b1n0"},"dct:temporal":{"@id":"_:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36_b2n0"},"dct:title":{"@language":"sv","@value":"Brunnar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1cdf374f-ee28-5456-ec40-11444554c82c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-brunnar.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av\n\t\t\t\t\t\t\t\t\tWMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:4ff8f809-0f58-bb76-87c8-c25b7ea03431","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/brunnar/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API -Features"}},{"@id":"urn:uuid:7fb082b6-2dd3-4659-fc04-7c60409272fe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/brunnar-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:8a5b10b2-95c0-e917-64af-d4b15b956376","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-brunnar.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:aa829fcd-5eb0-e0f9-9690-17eeed2b04ef","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/brunnar/brunnar.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:d4d8d07b-6c54-f23c-a931-5b4f11fc6f3b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/brunnar"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Services"}}],"@id":"urn:source:ed939f4fb83e3caeed39772187f13cd1bbe43315c26fe4358ed547aae82c9d36"},{"@graph":[{"@id":"_:ed99cce1b3c0b44f8b9069ce5e5471236e4a4b60cceca990b72e4582285ded07_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen bygger på sammanställningar av befintligt material, främst från kartor och beskrivningar från jordartskarteringen. Detta har resulterat i drygt 900 observationspunkter relativt jämnt fördelade längst högsta kustlinjen. Högsta kustlinjen har sedan konstruerats genom en rasterbaserad modell baserad på observationerna och GSD-Höjddata, grid 50+ från Lantmäteriet.\n\nProdukten lämpar sig för presentation inom skalområdet 1:100 000 – 1:200 000.\nLägesnoggrannheten för observationspunkterna är ca 50 meter. Den konstruerade högsta kustlinjen baseras på GSD-Höjddata, grid 50+ från Lantmäteriet som har en lägesnoggrannhet på 50 meter och ett medelfel i höjd på ca +- 2 meter. Kustlinjen har dock generaliserats kraftigt, och mindre lägesfel i observationsdata och höjdmodellen kan generera ett större fel i den konstruerade kustlinjen. Den resulterande lägesnoggrannheten är därför betydligt lägre än hos de ingående datakällorna"}},{"@id":"_:ed99cce1b3c0b44f8b9069ce5e5471236e4a4b60cceca990b72e4582285ded07_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2f5a84e7-6eea-4cf7-b34f-dc2c218353cb","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:35dfb845-23e2-84a6-276a-87a147fad201"},{"@id":"urn:uuid:502e7528-3652-75c9-fc9a-ce63f720572d"},{"@id":"urn:uuid:8400bbcf-3847-b41e-dfb7-4e2fb1ec598a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Informationen ger underlag för bedömning av markegenskaper som jordarternas sammansättning och uppbyggnad samt för modellering av landskapets utveckling (paleogeografi) och landhöjningen."},{"@language":"sv","@value":"Produkten visar läget av högsta kustlinjen, HK, dvs. den högsta nivån i terrängen där strandmärken från det hav, eller de stadier av Östersjön, som täckte delar av landet vid inlandsisens försvinnande, påträffas. Högsta kustlinjen varierar i hela landet. De högsta nivåerna, cirka 289 meter ovan dagens yta, finns i Ångermanland. I sydligaste Sverige ligger högsta kustlinjen endast 10-20 meter ovan dagens havsyta. Exempel på strandmärken är erosionshak och strandvallar"}],"dct:identifier":"2f5a84e7-6eea-4cf7-b34f-dc2c218353cb","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:ed99cce1b3c0b44f8b9069ce5e5471236e4a4b60cceca990b72e4582285ded07_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ed99cce1b3c0b44f8b9069ce5e5471236e4a4b60cceca990b72e4582285ded07_b1n0"},"dct:title":{"@language":"sv","@value":"Högsta kustlinjen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:35dfb845-23e2-84a6-276a-87a147fad201","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/hogsta-kustlinjen/hogsta-kustlinjen.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:502e7528-3652-75c9-fc9a-ce63f720572d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hogsta-kustlinjen-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:8400bbcf-3847-b41e-dfb7-4e2fb1ec598a","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/hogsta-kustlinjen/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:ed99cce1b3c0b44f8b9069ce5e5471236e4a4b60cceca990b72e4582285ded07"},{"@graph":[{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGUs sverigetäckande tyngdkraftsgrid visar Sveriges tyngdkraftsfält uttryckt som Bougueranomali (mGal) i referensfältet RG82 och har tagits fram på årsbasis under lång tid. Tyngdkraftsgridden är framtagen genom att interpolera med 500m x 500m cellstorlek mellan punktvisa tyngdkraftsmätningar från vilka Bougueranomalier har beräknats. I områden där det är glest mellan mätpunkterna, t.ex. över fjällområdena och havet, är gridden kraftigt interpolerad.\n\nFrån tyngdkraftsgridden extraheras Bougueranomlivärden till en kommaseparerad textfil (csv) som innehåller koordinatsatta, interpolerade anomalivärden med 500m x 500m punktavstånd.\n\nKvaliteten för de enskilda mätpunkterna som ligger till grund för tyngdkraftsgridden varierar mycket eftersom SGU har bedrivit tyngdkraftsmätningar sedan 1950-talet och mätinstrumenten med tiden har förbättrats. I takt med att instrumentutvecklingen har gått framåt så har det också blivit möjligt att bestämma både tyngdkraften och positionen mer noggrant.\nPå grund av ojämn geografisk fördelning mellan mätpunkterna varierar kvaliteten i den griddade informationen. I områden där det är glest mellan mätpunkterna, t.ex. över fjällområdena och havet, är gridden kraftigt interpolerad vilket leder till ökad osäkerhet."}},{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.27 69.10,24.23 69.10,24.23 55.04,10.27 55.04,10.27 69.10))"}},{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1957"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/d5a4cb02-6e2b-46a1-a19b-5aa0a73945ec","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:11199d6c-6423-250f-1166-6b1993be2cbf"},{"@id":"urn:uuid:60b67305-bd23-6840-7546-1125b247c06f"},{"@id":"urn:uuid:6e15e2b2-f210-e847-9be6-e80e0d3135d9"},{"@id":"urn:uuid:71037bf5-260b-d9af-4d9b-110beda83fa7"},{"@id":"urn:uuid:b4b0fd42-2e68-a372-ce8a-02b4f8e94a6a"},{"@id":"urn:uuid:d68014af-55a5-37fa-98e5-077ac393c772"},{"@id":"urn:uuid:e948f965-68db-9def-69e3-6b1462dc93b6"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Genom mätningar av tyngdkraften kan man kartlägga variationer i massfördelningen i jordskorpan. Dessa variationer beror på skillnader i berggrundens sammansättning.\n \nGeofysiska markmätningar, tyngdkraft interpolerad (översiktlig) innehåller griddata som åskådliggör de variationer som finns i Sveriges tyngdkraftsfält, uttryckt som Bougueranomali. Från punktvisa mätningar av tyngdkraften i hela Sverige har Bougueranomalier (mGal) beräknats i referensfältet RG82. Dessa har sedan griddats med cellstorleken 500m x 500m. Från gridden har koordinatsatta Bougueranomalier extraherats med samma punktavstånd motsvarande griddens cellstorlek till en csv fil."},"dct:identifier":"d5a4cb02-6e2b-46a1-a19b-5aa0a73945ec","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-26"},"dct:provenance":{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b1n0"},"dct:temporal":{"@id":"_:eec3e979b74633fd7e2785fb6fb81581ee62e0fb55f776d2234c19967602ef6f_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, tyngdkraft interpolerad (översiktlig)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:11199d6c-6423-250f-1166-6b1993be2cbf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-markmatningar-tyngdkraft-interpolerad-oversiktlig-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:60b67305-bd23-6840-7546-1125b247c06f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-mark-tyngdkraf