tLiteral","@value":"POLYGON((13.66977 63.99472,16.48694 63.99472,16.48694 62.78344,13.66977 62.78344,13.66977 63.99472))"}},{"@id":"_:1fb22d6863f641d56f8ba7d3387c9434c2be5c5d01f871177ced8e95868cb639_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/22bb4a66-2aaa-4c53-a91d-76ad2e1ec871","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:b4f717f4-b0d7-a658-73b0-5b1e6cb903ce"},"dcat:distribution":[{"@id":"urn:uuid:3bc1e41e-78e9-6e2b-469c-6065e2355f5f"},{"@id":"urn:uuid:9af58663-29ec-3d21-bbe8-f45205b59827"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Rikkärrsinventering i Jämtlands län med naturvärdesklassning på objektsnivå. Inventerades under perioden 1996-2000. Rapport för materialet Rikkärr i Jämtlands kambrosilurområde.\nNaturvärdesklassning enligt följande\n0 Oklassade objekt\n1 Mycket höga naturvärden\n2 Höga naturvärden\n3 Vissa naturvärden\n4 Låga naturvärden"},"dct:identifier":"22bb4a66-2aaa-4c53-a91d-76ad2e1ec871","dct:issued":{"@type":"xsd:date","@value":"2003-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-12-14"},"dct:provenance":{"@id":"_:1fb22d6863f641d56f8ba7d3387c9434c2be5c5d01f871177ced8e95868cb639_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:1fb22d6863f641d56f8ba7d3387c9434c2be5c5d01f871177ced8e95868cb639_b1n0"},"dct:title":{"@language":"sv","@value":"LstZ Rikkärrsinventering (Extern)"}},{"@id":"urn:uuid:3bc1e41e-78e9-6e2b-469c-6065e2355f5f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstz.LstZ_rikkarrsinventering.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:9af58663-29ec-3d21-bbe8-f45205b59827","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTZ/LSTZ_Vatmark/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:b4f717f4-b0d7-a658-73b0-5b1e6cb903ce","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstZ Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1fb22d6863f641d56f8ba7d3387c9434c2be5c5d01f871177ced8e95868cb639_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jamtland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstZ Naturvårdsenheten"}],"@id":"urn:source:1fb22d6863f641d56f8ba7d3387c9434c2be5c5d01f871177ced8e95868cb639"},{"@graph":[{"@id":"_:200203f2386418240f3b7bc5759ee31cca35b9a25b083229397e69c778c4b69b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"IT-systemet som används för att registrera och lagra hamnnoder för sjövägsnätet är Sjövägsdatabasen. PortNode genereras från noder i Sjöfartsverkets sjövägsnät utan bearbetning. Mappningen mellan Inspire PortNode och Sjöfartsverkets sjövägsdata är fullständig."}},{"@id":"_:200203f2386418240f3b7bc5759ee31cca35b9a25b083229397e69c778c4b69b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/cd80e981-3ae6-4e01-a8fb-33d5a26eb9ac","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:abcfbcaf-aa74-24e1-3a88-16776774ab7a"},"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Transportnät"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/tn"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden redovisar länkar i sjövägsnätet enligt Inspiretema transportnät (TN) WaterwayLink. Datamängden går att komma åt via wms och wfs."},"dct:identifier":"cd80e981-3ae6-4e01-a8fb-33d5a26eb9ac","dct:issued":{"@type":"xsd:date","@value":"2020-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-11-24"},"dct:provenance":{"@id":"_:200203f2386418240f3b7bc5759ee31cca35b9a25b083229397e69c778c4b69b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:200203f2386418240f3b7bc5759ee31cca35b9a25b083229397e69c778c4b69b_b1n0"},"dct:title":{"@language":"sv","@value":"TN.Water.PortNode"}},{"@id":"urn:uuid:abcfbcaf-aa74-24e1-3a88-16776774ab7a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets webbplats"}}],"@id":"urn:source:200203f2386418240f3b7bc5759ee31cca35b9a25b083229397e69c778c4b69b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/870353ca-54b7-4d09-9957-0f3ebe15f7fa","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/basemap-visning-inspire-api"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten innehåller administrativ indelning, adress, byggnad, marktäcke, ortnamn och är utformad enligt EU-direktivet Inspire. Produkten innehåller även hydrografi och transport som inte uppfyller Inspires krav."},"dct:identifier":"870353ca-54b7-4d09-9957-0f3ebe15f7fa","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Basemap Visning, Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:20d5564ca1cddd37ed64c6322139d5c2dca41a087bf5fd7aedaacba490f59c54"},{"@graph":[{"@id":"_:21d965083f531812758cbdc0d5214f2c9b181beeee6be162c5ec52f45bd437ac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Statistiken avser folkbokförd befolkning beräknad från adresser i Registret över Totalbefolkningen (RTB). Koordinater hämtas från Lantmäteriets Fastighetsdatabas och Adressdatabas. \n\nData avser befolkade rutor. En statistisk metod används för att skydda enskildas uppgifter i den redovisade statistiken. På grund av detta är inte alltid de redovisade totalerna lika med summan av deras redovisade delar. Rutor utan befolkning är inte del av data.\n\nInspire koden bildas av Northing (Y) och Easting (X) och representerar rutans nedre vänstra hörn. Även upplösningen samt koordinatsystem finns i koden. Koden blir 31-ställig."}},{"@id":"_:21d965083f531812758cbdc0d5214f2c9b181beeee6be162c5ec52f45bd437ac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:21d965083f531812758cbdc0d5214f2c9b181beeee6be162c5ec52f45bd437ac_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-12-31"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id"