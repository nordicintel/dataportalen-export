c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ivo.metria.se/geoserver/ivo/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"IVO visningstjänst för geografisk data"},"dct:title":{"@language":"sv","@value":"IVO visningstjänst för geografisk data"}},{"@id":"urn:uuid:6b3d96ec-d9e7-1275-a8f4-66d69fc1eb83","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/ivofeed/filer/IVO_US.SHAPE.zip"},"dct:description":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data, direkt nedladdning SHAPE"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data, direkt nedladdning SHAPE"}},{"@id":"urn:uuid:72e0f98f-6955-f8dc-ca74-0191969c6f57","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/ivofeed/ivo_topfeed.xml"},"dct:description":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data"}},{"@id":"urn:uuid:8c534b71-36eb-e004-07e8-fffdb856edb5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/ivofeed/filer/gml/usGovServIVO.gml"},"dct:description":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data, direkt nedladdning GML"},"dct:title":{"@language":"sv","@value":"IVO nedladdningstjänst för geografisk data, direkt nedladdning GML"}}],"@id":"urn:source:27e7a6525478a6a08e812f662fd8c67bcaaa54627f08f4b571f2525608318d16"},{"@graph":[{"@id":"_:2825f3267184d0d33f64b61c479e30517b0419991d1fd41cf760f6ad096f8f8b_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/605e174c-2bf8-4fb5-9d8f-1d3bb148ce27","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:a2c24d64-236f-7041-91ee-4969f78d77c3"},"dcat:endpointURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/lst_topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Generell nedladdningstjänst (ATOM) för Länsstyrelsens INSPIRE-datamängder"},"dct:identifier":"605e174c-2bf8-4fb5-9d8f-1d3bb148ce27","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"SE.LST INSPIRE Nedladdningstjänst (ATOM)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:a2c24d64-236f-7041-91ee-4969f78d77c3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST Planeringskatalogens nationella redaktion","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2825f3267184d0d33f64b61c479e30517b0419991d1fd41cf760f6ad096f8f8b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:planeringskatalogen@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST Planeringskatalogens nationella redaktion"}],"@id":"urn:source:2825f3267184d0d33f64b61c479e30517b0419991d1fd41cf760f6ad096f8f8b"},{"@graph":[{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Databasen innehåller data från flygmätningar sedan 1973. Flyghöjd över marken, mätlinjeseparation och navigeringssystem har modifierats med tiden.\n\nMellan 1973–1990 registrerades informationen från en sändare (GBR i England) vilket gör att informationen om markens elektriska egenskaper är riktningsberoende (ger preferens åt strukturer som ligger i rikting mot sändaren).\n\nFr.o.m. 1991 registreras samtliga tre magnetiska komponenter från två sändare samtidigt, vilket gör det möjligt att ta fram mer riktningsoberoende information (Pedersen m.fl, 2009). Ur dessa data kan även tipper, peaker, skenbar resistivitet och strömtäthet beräknas.\nMätpunktsavståndet är 16 till cirka 60 meter, beroende på vilket mätsystem som använts. Mätlinjeavståndet är normalt 200 meter över land och 400 till 1000 meter över hav och i fjällområden. Till och med år 1994 var den nominella flyghöjden 30 meter, från och med 1995 är den 60 meter.\n\nEn sammanvägd, relativ kvalitetsbedömning har gjorts på data och redovisas som ett kvalitetsvärde (QUALITY) från 1 och uppåt, där 1 är lägsta kvalitet. Kvalitetsbedömningen utgår huvudsakligen från vilket mätsystem som använts. Generellt sett har modernare mätningar högre kvalitet än äldre och kan således komma att bli allt bättre."}},{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1973"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8fc0c951-7c7a-4949-8f2e-ed43ce267688","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:2d56cbeb-6aa6-e26d-fb0f-3030db105105"},{"@id":"urn:uuid:56f579a1-2fb4-0205-6f46-5aa5ffeb185e"},{"@id":"urn:uuid:5eacaeee-b583-5544-f93b-8347132230ec"},{"@id":"urn:uuid:6be4694b-a19f-66e7-9eda-5f319e407318"},{"@id":"urn:uuid:829ec3da-f426-cd6d-60b9-384a15cbb562"},{"@id":"urn:uuid:ce2890aa-fec9-f239-dce3-ad1071cbcff6"},{"@id":"urn:uuid:f06fea59-5fd0-56f4-69d5-4a0caff90971"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"SGU använder i sina flygmätningar den så kallade VLF-metoden (Very Low Frequency), vilket är en konceptuellt enkel men effektiv metod för att få information om hur bra marken leder ström. Metoden går ut på att mäta de magnetfält som induceras av strömmar i marken, som i sin tur uppstår på grund av interaktion med radiovågor från sändare i VLF-bandet.\n\nGeofysiska flygmätningar, elektromagnetiska fält, VLF (detaljerad) innehåller information om den magnetiska komponenten (H) av det elektromagnetiska fältet i VLF-bandet (frekvensbandet 15–30 kHz), vilken varierar beroende på markens elektriska ledningsförmåga. Denna är beräknad för koordinatsatta punkter, ur mätningar gjorda från flygplan på låg höjd. \n\nSamtliga mätningar har gjorts med en 3-axlig antenn som mäter amplitud och fas av den magnetiska vektorns komponenter.\n\nMetodens djupseende varierar med hur bra marken leder elektrisk ström, från ett par hundra meter i kristallin berggrund till några tiotal meter i konduktiva tjocka lerlager."},"dct:identifier":"8fc0c951-7c7a-4949-8f2e-ed43ce267688","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b1n0"},"dct:temporal":{"@id":"_:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, elektromagnetiska fält, VLF (detaljerad)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:2d56cbeb-6aa6-e26d-fb0f-3030db105105","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/om-sgu/verksamhet/kartlaggning/geofysik_att_se_ner_i_berget/flyggeofysisk-matning/"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sveriges geologiska undersökning"}},{"@id":"urn:uuid:56f579a1-2fb4-0205-6f46-5aa5ffeb185e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-vlf/geofysik-flyg-em-vlf.zip"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: GeoPackage med flygormåden"}},{"@id":"urn:uuid:5eacaeee-b583-5544-f93b-8347132230ec","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-elektromagnetiska-falt-vlf-detaljerad-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:6be4694b-a19f-66e7-9eda-5f319e407318","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-vlf/2013_FBCG_20617.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: Exempel XYZ-fil för flygområde 2013_FBCG_20617"}},{"@id":"urn:uuid:829ec3da-f426-cd6d-60b9-384a15cbb562","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-resistivitet.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare Skenbar resistivitet"}},{"@id":"urn:uuid:ce2890aa-fec9-f239-dce3-ad1071cbcff6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-flyg-em-vlf/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:f06fea59-5fd0-56f4-69d5-4a0caff90971","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-skenbar-resistivitet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst Skenbar resistivitet"}}],"@id":"urn:source:28330e357141b9f846dabd50e90a952077b62963eb678fa18c6c99b8c724a62b"},{"@graph":[{"@id":"_:2840a56aa5046130765d677365d84cd68c08029835d0a077b97aaa456b0353b9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://gis.sgi.se/startgsp"}},{"@id":"_:2840a56aa5046130765d677365d84cd68c08029835d0a077b97aaa456b0353b9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.039851888106 69.064001823926,25.958243331996 69.064001823926,25.958243331996 54.802444805481,11.039851888106 54.802444805481,11.039851888106 69.064001823926))"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/1f6c201e-d787-4ccc-8e3b-be7a681be3de","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:22b1eec9-2f6f-589f-f0dc-847cf97ce607"},{"@id":"urn:uuid:367838ee-54e4-1613-cd36-3dfe3bd6ce20"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Inom ramen för projektet \"Geoteknisk sektorsportal - nationell datainfrastruktur för tillgång till genomförda geotekniska undersökningar\" har datakedjan \"borrningar i fält --> Geosuite desktop branschstandardprogram --> GeoSuite SQL Server databas --> WMS\" gjorts tillgänglig. Den del som SGI har ansvar för kallas BGA Braschens Geotekniska Arkiv. Här visas till GeoSuite SQL Server databas uppladdade Geosuite borrhål och projektområden. [Geoteknik]"},"dct:identifier":"1f6c201e-d787-4ccc-8e3b-be7a681be3de","dct:issued":{"@type":"xsd:date","@value":"2013-10-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:2840a56aa5046130765d677365d84cd68c08029835d0a077b97aaa456b0353b9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:2840a56aa5046130765d677365d84cd68c08029835d0a077b97aaa456b0353b9_b1n0"},"dct:title":{"@language":"sv","@value":"Branschens Geotekniska Arkiv (Geosuite borrhål och projektområde)"}},{"@id":"urn:uuid:22b1eec9-2f6f-589f-f0dc-847cf97ce607","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/startgsp"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:367838ee-54e4-1613-cd36-3dfe3bd6ce20","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mapsext.sgi.se/geoserver/wms?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"surveypoint_info_gis"}}],"@id":"urn:source:2840a56aa5046130765d677365d84cd68c08029835d0a077b97aaa456b0353b9"},{"@graph":[{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Naturcentrums inventering av Jätteträd 2000-2005.Helt färdig"}},{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.47601 57.07324,13.32332 57.07324,13.32332 56.48104,12.47601 56.48104,12.47601 57.07324))"}},{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/3f2173d9-4254-4bf2-bf0b-81a7a7dc7ac8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:b5e4ea4b-658e-e002-57b3-fe5cb7207ea8"},"dcat:distribution":{"@id":"urn:uuid:452a6fa5-d364-2e6f-47f3-9bcf95374477"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventering av grova träd under åren 2000-2005, utförd av Naturcentrum. Merparten av de registrerade träden finns i Halmstad kommun. Kombineras med LstN Trädinventering och LstN Skyddsvärda träd (Kungsbacka) för en mer heltäckande bild av länets särskilt skyddsvärda träd."},"dct:identifier":"3f2173d9-4254-4bf2-bf0b-81a7a7dc7ac8","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-01-01"},"dct:provenance":{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Skyddsvärda träd (Äldre inventering)"}},{"@id":"urn:uuid:452a6fa5-d364-2e6f-47f3-9bcf95374477","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.Lst_Tradinventering_NaturC.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:b5e4ea4b-658e-e002-57b3-fe5cb7207ea8","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Beredskapsfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Beredskapsfunktionen"}],"@id":"urn:source:284fa7b597c5318d313746b65fa3badf7302b12733f69edc7af6282f3696d250"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/0ec4d46a-533a-40f6-bf59-216bf3fdce43","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-skred.html"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten visar morfologiskt framträdande spår i terrängen av inträffade jordskred på land samt raviner i lösa jordlager. \n\nTillsammans med jordartskartor och höjddata kan informationen användas för en översiktlig bedömning av skredkänslighet och markstabilitet. \n\nDe flesta skred har skett i lerjord, men det förekommer även spår av skred i sandjordar, inte minst i de norrländska älvdalarna, samt i moränjordar. I de fall skred har inträffat i sandjord finns ofta silt- eller lerlager under ett ytligt sandlager. Spår av jordras har också inkluderats i den mån de har gett upphov till former liknande jordskredsspår.\n\nJordskreden har inträffat någon gång efter den senaste istiden. I några fall finns uppgifter om när skredet skett, se information på Statens geotekniska instituts webbplats: http://gis.swedgeo.se/skred/.\n\nSärskilt i Norrlands inland finns en mängd spår av jordskred i moränterräng. Dessa jordskred har av allt att döma utlösts av kraftiga jordbävningar som ägde rum under den senaste istidens slutskede eller strax därefter, dvs. för ca 10 000 år sedan.\n\nRaviner uppstår genom erosion av rinnande vatten (ytvatten eller grundvattenutflöde) i lösa jordlager. Vid ökad avrinning till följd av intensiv nederbörd eller förändrad markanvändning kan nya raviner skapas och befintliga raviner växa till. I ravinernas slänter sker ofta mindre ras och skred. Såväl morfologiskt mycket framträdande skredkanter och raviner som former utjämnade genom till exempel markplanering och jordbruk har redovisats."},"dct:identifier":"0ec4d46a-533a-40f6-bf59-216bf3fdce43","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jordskred och raviner (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:28698019a989091e5de3b585902e2f7678d2f7badaee1f15b68fd52c7b4dbc7a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/15a859cf-8e7c-46a7-8b7c-fa9756afa8af","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-25-100-tusen-fastmark"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Produkten är tänkt att användas t ex som underlag för en tidig bedömning av vilka markområden som har förutsättningar att beröras av ytterligare skred vid t ex ett inträffat eller pågående jordskred."},{"@language":"sv","@value":"Visningstjänsten presenterar en starkt förenklad bild av markens stabilitetsegenskaper. Produkten bygger på en omklassning av grundlagret i datamängden JORDARTER 1:25 000 – 1:100 000 till tre stabilitetsklasser: Fastmark, Ej fastmark och Ej bedömd mark.\nLäs mer om den bakomliggande datamängden här: https://resource.sgu.se/dokument/produkter/jordarter-25-100000-beskrivning.pdf\nTill klassen fastmark räknas områden med berg, morän, isälvssediment, grus, blockjord och liknande. Till klassen ej fastmark räknas områden med silt, lera, torv, gyttja, postglacial sand och andra avlagringar som i många fall underlagras av silt, lera eller fyllning. Hänsyn har inte tagits till t ex marklutning och fuktighetsförhållanden.\nProdukten är tänkt att användas t ex som underlag för en tidig bedömning av vilka markområden som har förutsättningar att beröras av ytterligare skred vid t ex ett inträffat eller pågående jordskred.\nMed tanke på eventuella brister i underlaget skall alltid en platsspecifik bedömning göras i terrängen."}],"dct:identifier":"15a859cf-8e7c-46a7-8b7c-fa9756afa8af","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Fastmark (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:28743244b26b89e9dcebb4c08bcce56d7a65a2a691f5b7ec66734cdc50a1a7c3"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3b1a2aec-8fc4-4288-b763-9abf1317ae75","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/grundvattentillgang?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Grundvattentillgång i små magasin visar en beräkning av grundvattentillgång för vattenförsörjning i Sverige med fokus på små grundvattenmagasin. Beräkningen baseras på ett antal antaganden och ett relativt översiktligt grundmaterial och är därmed förknippade med osäkerheter.  SGU anser att den presenterade beräknade grundvattentillgången kan vara relevant och användbar för översiktlig riskbedömning och planering avseende vattenuttag från små grundvattenmagasin. Däremot bedömer SGU att resultaten generellt inte är tillräckligt precisa och detaljerade för att bedöma vattentillgång och risk för vattenbrist för enskilda fastigheter. \n\nGrundvattentillgång i små magasin omfattar en rikstäckande beräkning och resultatet presenteras i enheten l/dygn/ha i ett raster med cellstorlek på 100x100 m."},"dct:identifier":"3b1a2aec-8fc4-4288-b763-9abf1317ae75","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Grundvattentillgång i små magasin (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:28e75375803677f1a51cbf19a9747b47b75aff445f62a49acf53bf40ffb66696"},{"@graph":[{"@id":"_:290ea1484f80e73122a1a4aa7255ad37ca487ac850db1ba905dce0f58824016e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Uttag ur NikIta, tidigare Miljöreda. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län."}},{"@id":"_:290ea1484f80e73122a1a4aa7255ad37ca487ac850db1ba905dce0f58824016e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/c0159074-d0ff-4b56-bc1f-7909c984f9cb","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:a5042db5-230b-42cc-91b4-51d81b6c62c0"},{"@id":"urn:uuid:af60cee9-b5f5-bfc6-0cec-dfdfd6e49326"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Punkter för Tillståndspliktiga miljöfarliga verksamheter där utvinningsavfallsanläggningar finns registrerade. \n\n Källa: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfarlig verksamhet. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län."},"dct:identifier":"c0159074-d0ff-4b56-bc1f-7909c984f9cb","dct:issued":{"@type":"xsd:date","@value":"2019-11-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-10-01"},"dct:provenance":{"@id":"_:290ea1484f80e73122a1a4aa7255ad37ca487ac850db1ba905dce0f58824016e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:290ea1484f80e73122a1a4aa7255ad37ca487ac850db1ba905dce0f58824016e_b1n0"},"dct:title":{"@language":"sv","@value":"SE.US Utvinningsavfallsanläggningar"}},{"@id":"urn:uuid:a5042db5-230b-42cc-91b4-51d81b6c62c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/am_utvinningsavfall.xml"},"dct:description":{"@language":"sv","@value":"lst atom"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"lst atom"}},{"@id":"urn:uuid:af60cee9-b5f5-bfc6-0cec-dfdfd6e49326","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_us/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"wms"},"dct:title":{"@language":"sv","@value":"wms"}}],"@id":"urn:source:290ea1484f80e73122a1a4aa7255ad37ca487ac850db1ba905dce0f58824016e"},{"@graph":[{"@id":"_:296be8bc654aea5d9239acba53a21fba8037c488cb8f5a401e2c6d0dbc28d4b3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Det IT-system som används för att registrera och lagra sjövägsdata, dvs nätanknuten sjövägsdata, för sjövägsnätet är Sjövägsdatabasen. WaterwayLinkSequence genereras från noder i Sjöfartsverkets sjövägsnät utan bearbetning. Mappningen mellan Inspire WaterwayLinkSequence och Sjöfartsverkets sjövägsdata är fullständig."}},{"@id":"_:296be8bc654aea5d9239acba53a21fba8037c488cb8f5a401e2c6d0dbc28d4b3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/f10c0b78-db8f-49b7-bf09-1edf02f5e975","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:95b57227-1b5b-31b5-dc98-463658944002"},"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Transportnät"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/tn"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden redovisar länkar i sjövägsnätet enligt Inspiretema transportnät (TN) WaterwayLink. Datamängden går att komma åt via wms och wfs."},"dct:identifier":"f10c0b78-db8f-49b7-bf09-1edf02f5e975","dct:issued":{"@type":"xsd:date","@value":"2020-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-11-24"},"dct:provenance":{"@id":"_:296be8bc654aea5d9239acba53a21fba8037c488cb8f5a401e2c6d0dbc28d4b3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:296be8bc654aea5d9239acba53a21fba8037c488cb8f5a401e2c6d0dbc28d4b3_b1n0"},"dct:title":{"@language":"sv","@value":"TN.Water.WaterwayLinkSequence"}},{"@id":"urn:uuid:95b57227-1b5b-31b5-dc98-463658944002","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets webbplats"}}],"@id":"urn:source:296be8bc654aea5d9239acba53a21fba8037c488cb8f5a401e2c6d0dbc28d4b3"},{"@graph":[{"@id":"_:2a2dd6175a899cf87da56fa88a7855ddf22ba72b699a750afe98b4bedd98eac5_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10630","http://www.w3.org/2006/vcard/ns#street-address":"Rålambsvägen 5"},{"@id":"_:2a2dd6175a899cf87da56fa88a7855ddf22ba72b699a750afe98b4bedd98eac5_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46752473000"}},{"@id":"http://dataportal.se/organisation/SE2021000555","@type":"foaf:Agent","dct:identifier":"2021000555","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sherko.alemdar@socialstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Socialstyrelsen"},"foaf:page":{"@id":"https://www.socialstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ngs.ehalsomyndigheten.se/organisation/SE2021000555"}},{"@id":"https://www.geodata.se/resources/c5295776-adff-4a69-bd59-6c7fb5529127","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:0f306638-cab9-24f1-be66-0e3761e36747"},"dcat:endpointURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-dod-wfs.map&service=wfs&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens statistikdatabas, antal döda i vissa miljörelaterade sjukdomar som\nJ44 KOL,\nJ45-J46 Astma\nJ60-J70 Lungsjukdomar av yttre orsaker\nunder åren 2017-2019 per 100 000 invånare"},"dct:identifier":"c5295776-adff-4a69-bd59-6c7fb5529127","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:title":{"@language":"sv","@value":"Dödsorsaker nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:0f306638-cab9-24f1-be66-0e3761e36747","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Ämnesansvarig dödsorsaker","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2a2dd6175a899cf87da56fa88a7855ddf22ba72b699a750afe98b4bedd98eac5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:inspire@socialstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2a2dd6175a899cf87da56fa88a7855ddf22ba72b699a750afe98b4bedd98eac5_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Socialstyrelsen"}],"@id":"urn:source:2a2dd6175a899cf87da56fa88a7855ddf22ba72b699a750afe98b4bedd98eac5"},{"@graph":[{"@id":"_:2a31d3b4c853010b1090b2464ca090cb5299306d4308da1bbbe08b59620e8902_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Grundkällorna för information till berggrundskartan över Sverige i skala 1:1 miljon är berggrundsgeologiska kartdatabaser sammanställda av Sveriges geologiska undersökning över den Fennoskandiska skölden år 2001, och över den Kaledoniska orogenen (bergskedjan) och det Neoproterozoiska–Fanerozoiska plattformstäcket år 1994. Informationen som presenteras i dessa två kartsammanställningar har systematiskt uppdaterats med information från SGU:s berggrundsgeologiska kartdatabaser i skala 1:50 000 och 1:250 000 som var tillgänglig år 2009. Vissa uppgifter från vetenskapliga publikationer ingick också i sammanställningen.\nEn tryckt karta som utgavs år 2012 (Bergman, S., Stephens, M.B., Andersson, J., Kathol, B. & Bergman, T., 2012: Sveriges berggrund, skala 1:1 miljon. Sveriges geologiska undersökning K 423) innehåller information om den dåvarande täckningsgraden för berggrundsgeologiska kartdatabaser i skala 1:50 000 och 1:250 000. Den rumsliga utbredningen av berggrundsenheter och strukturer i de lokala och regionala databaserna baseras på en integrerad tolkning av geologiska och geofysiska grunddata.\nGeologin är sammanställd fram till gränsen för den svenska ekonomiska zonen. Smärre korrigeringar i databasen gjordes 2016.\n\nKartbilden är generaliserad för att ge god läsbarhet i presentationsskalan 1:1 miljon. Generaliseringen innebär att man medvetet ritar fel för att öka läsbarheten. Exempelvis kan flera små närliggande objekt ritas som ett objekt eller en flikig gräns mellan två objekt ritas som en utjämnad linje. Det är viktigt att ta hänsyn till detta t.ex. vid tolkning av resultat från GIS-analys. Kartan bör inte förstoras till annan skala."}},{"@id":"_:2a31d3b4c853010b1090b2464ca090cb5299306d4308da1bbbe08b59620e8902_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.454065684577 68.826151469458,25.523055337971 68.826151469458,25.523055337971 54.899419677871,10.454065684577 54.899419677871,10.454065684577 68.826151469458))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7adf7a5b-4222-4646-8a25-de89b3b82fdb","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:6107fe24-2caa-568d-e794-429469e46710"},{"@id":"urn:uuid:6ebbfa63-ec5a-060f-e6a7-b6f963c4d5cc"},{"@id":"urn:uuid:85057e77-bfc0-9fe0-cea9-44307e617fc9"},{"@id":"urn:uuid:a17902df-7dd4-5143-4925-d1fa631d39d4"},{"@id":"urn:uuid:d1af7670-76c2-5161-af9b-853ce1230774"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Berggrundskartan är en tvådimensionell modell av berggrundens överyta och ger en översiktlig bild av huvuddragen i Sveriges berggrund. Kartan visar utbredningen av olika berggrundsenheter och stora deformationszoner (sprickzoner, förkastningar och plastiska skjuvzoner). Berggrundsenheterna kan bestå av en eller flera bergarter och de först nämnda är generellt de vanligaste. Vissa viktiga enheter som är för smala för att visas som ytor är representerade med linjer. Åldern för varje berggrundsenhet redovisas, liksom vilken större litotektonisk enhet (t.ex. en äldre bergskedja) den tillhör. I ett separat lager visas enbart utbredningen av de större litotektoniska enheterna, och i ytterligare ett lager är dessa indelade i litotektoniska underenheter.\n\nSyftet med berggrundskartan är att ge underlag för mycket översiktlig planering och analys, forskning och utbildning. Kartbilden är anpassad för presentation i skala 1:1 miljon, vilket innebär att informationen är generaliserad och inte avsedd för mer detaljerat bruk."},{"@language":"sv","@value":"Syftet med berggrundskartan är att ge underlag för mycket översiktlig planering och analys, forskning och utbildning. Kartbilden är anpassad för presentation i skala 1:1 miljon, vilket innebär att informationen är generaliserad och inte avsedd för mer detaljerat bruk."}],"dct:identifier":"7adf7a5b-4222-4646-8a25-de89b3b82fdb","dct:issued":{"@type":"xsd:date","@value":"2010-05-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:2a31d3b4c853010b1090b2464ca090cb5299306d4308da1bbbe08b59620e8902_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:2a31d3b4c853010b1090b2464ca090cb5299306d4308da1bbbe08b59620e8902_b1n0"},"dct:title":{"@language":"sv","@value":"Berggrund 1:1 miljon"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6107fe24-2caa-568d-e794-429469e46710","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/berggrund_1M"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:6ebbfa63-ec5a-060f-e6a7-b6f963c4d5cc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-berggrund-1-miljon.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:85057e77-bfc0-9fe0-cea9-44307e617fc9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/berggrund1miljon/berggrund1miljon.zip"},"dct:description":{"@language":"sv","@value":"Zip-fil med data i shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP vektordata"}},{"@id":"urn:uuid:a17902df-7dd4-5143-4925-d1fa631d39d4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/berggrund-1miljon-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:d1af7670-76c2-5161-af9b-853ce1230774","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/berggrund1miljon/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:2a31d3b4c853010b1090b2464ca090cb5299306d4308da1bbbe08b59620e8902"},{"@graph":[{"@id":"_:2ac97bae7c71f48442e079bfe21760ce0b361b11fa0350ddef12ec1129b7e553_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"IT-systemet som används för att registrera och lagra sjövägsytor  för sjövägsnätet är Sjövägsdatabasen. FairwayArea genereras i Sjöfartsverkets sjövägsnät utan bearbetning. Mappningen mellan Inspire FairwayArea och Sjöfartsverkets sjövägsdata är fullständig."}},{"@id":"_:2ac97bae7c71f48442e079bfe21760ce0b361b11fa0350ddef12ec1129b7e553_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/bb896ade-151e-4def-bfb0-8610c1549c81","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:fb3fad67-5823-b753-890b-c9ccb20d1821"},"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Transportnät"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/tn"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden redovisar sjövägsytor enligt Inspiretema transportnät (TN) WaterwayLink."},"dct:identifier":"bb896ade-151e-4def-bfb0-8610c1549c81","dct:issued":{"@type":"xsd:date","@value":"2008-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2008-01-01"},"dct:provenance":{"@id":"_:2ac97bae7c71f48442e079bfe21760ce0b361b11fa0350ddef12ec1129b7e553_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:2ac97bae7c71f48442e079bfe21760ce0b361b11fa0350ddef12ec1129b7e553_b1n0"},"dct:title":{"@language":"sv","@value":"TN.Water.FaiwayArea"}},{"@id":"urn:uuid:fb3fad67-5823-b753-890b-c9ccb20d1821","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets webbsida"}}],"@id":"urn:source:2ac97bae7c71f48442e079bfe21760ce0b361b11fa0350ddef12ec1129b7e553"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1f1dcb5a-66d2-4464-b79a-fafcadde94a8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-visning-vector-tiles-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten visar topografisk information från Lantmäteriets grunddatalager. Formatet, vector tiles, ger andra möjligheter för användning än visningstjänster i rasterformat."},"dct:identifier":"1f1dcb5a-66d2-4464-b79a-fafcadde94a8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Topografi Visning, vector tiles"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:2af32d5941e123f11c84b46a87bd6376143c58dc99c697ad7abe8690e2331e15"},{"@graph":[{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skiktet togs fram i samband med ett inventeringsprojekt om länets kyrkobyggnader på Länsstyrelsen i Kronobergs initiativ tillsammans med Riksantikvarieämbetet och Smålands museum. Syftet var att få koll på vilka kyrkoruiner som finns i länet."}},{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.43739 57.13048,15.42096 57.13048,15.42096 56.457,13.43739 56.457,13.43739 57.13048))"}},{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/0a38da51-92e7-4ac2-b595-24edfd6ee5d2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:3f3f4b09-a3c0-0bb7-0c0c-0483717a1174"},{"@id":"urn:uuid:f701aceb-58c8-7c6f-49c3-402e5736873e"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Kulturhistorisk inventering från 1996 av länets kyrkoruiner/före detta kyrkor."},"dct:identifier":"0a38da51-92e7-4ac2-b595-24edfd6ee5d2","dct:issued":{"@type":"xsd:date","@value":"1996-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1996-01-01"},"dct:provenance":{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Kyrkoruiner"}},{"@id":"urn:uuid:3f3f4b09-a3c0-0bb7-0c0c-0483717a1174","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg205_kylemn.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:f701aceb-58c8-7c6f-49c3-402e5736873e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:2b5157214b12bb24e95f661b99db974c6031e183a4beb885a083d73a13690146"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/df5db288-cf61-48ea-8691-14970723e4f7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/malmer-anrikningsverk"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Malmer och anrikningsverk presenterar den information som återfinns i den nedladdningsbara produkten Malmer och anrikningsverk (öppna data).\n\n Malmer innehåller uppgifter om produktion vid gruvor och gruvområden med uppgifter om namn på gruvan eller gruvområdet, malmtyp, produktionsår, producerad mängd malm och metallhalter, producerad mängd gråberg och andra uppgifter. Malmer innehåller även uppgifter om rapporterade reserver och tillgångar vid svenska fyndigheter med information om typ av malm, mängd malm och metallhalt.\n\n Anrikningsverk innehåller uppgifter om mängd malm som processats vid anrikningsverket och mängd producerat mineralkoncentrat, allt med metallhalter. Mängden producerad anrikningssand har beräknats som mellanskillnaden mellan ingående malm och utgående mineralkoncentrat.\n\nMalmer har delats i separata lager för huvudsaklig råvara och anrikningsverk är uppdelat i separata lager för ingående malm till anrikningsverket och producerat mineralkoncentrat. Dessutom redovisas gruvavfall i separata lager för gråberg och anrikningssand.\n\n Statistik om malm i Sverige är användbart för beslutsfattare inom kommuner, län och statsmakter, för gruv- och prospekteringsbolag och för allmänheten. Här kan man se var de senaste hundra årens gruvor och anrikningsverk har funnits och vad de har producerat. Information om möjliga framtida malmer finns också med."},"dct:identifier":"df5db288-cf61-48ea-8691-14970723e4f7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Malmer och anrikningsverk (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:2b693606cab2fa4488b88724d0946d7f7eb6dcf66a646bdb89c5905d45176795"},{"@graph":[{"@id":"_:2b83eefaf7f5d6474eee27ac55bfe44d2fa8bded35e83edefd35de15177c68d1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Detaljplaner har tagits fram av Sveriges kommuner under lång tid, och på senare år har en del \näldre planer digitaliserats och vektoriserats. Detaljplaner som påbörjas efter 2021-12-31 ska \nskapas digitalt. \nOriginal av äldre detaljplaner är vanligen arkiverade på arkivbeständigt papper, \nfortsättningsvis kallade analoga detaljplaner. Plankartor, som är en del av detaljplaner, \ndigitaliseras i två steg. Först skannas den analoga kartan vilket resulterar i en georefererad \nbild (fil i rasterformat). Sedan vektoriseras plankartan genom att lägesbestämma positionerna\noch ytbilda bestämmelserna, exempelvis manuellt på en datorskärm eller med automatiska \nmetoder i en dator. Till varje yta kan attribut ges avseende bestämmelse, lägesosäkerhet, \nlägesbestämningsmetod etcetera. Om plankartan är arkiverad i rasterformat kan vektorisering \ngöras utan föregående skanning. \nDetaljplanens geometrier kan tas fram genom olika lägesbestämningsmetoder. Vid \nlägesbestämning används vanligen information i grundkartan som underlag, därför kommer \nvissa kvalitetsuppgifter om geometrierna att härstamma från kvaliteten på grundkartan. Detta \nbeskrivs närmare för varje lägesbestämningsmetod nedan. \nMer information om grundkartan finns i HMK – Digital grundkarta 2020. \nMer detaljerad information om hur datainsamlingen har genomförts för specifika detaljplaner \nkan fås av respektive kommun."}},{"@id":"_:2b83eefaf7f5d6474eee27ac55bfe44d2fa8bded35e83edefd35de15177c68d1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/bb6a68cc-35a4-4b53-902e-142cd18826fb","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:41f34007-dec7-34f8-b86f-2e877036f1b9"},{"@id":"urn:uuid:8cea08bb-10b4-2456-1b29-192b548afab1"},{"@id":"urn:uuid:f3533957-0299-a508-c4f0-d817d925f391"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Markanvändning"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/lu"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Dataprodukten innehåller information om detaljplaner i Sverige. Det huvudsakliga syftet med \nen detaljplan är att reglera användning av mark- och vattenområden samt bebyggelse.\nMed detaljplan avses sådan plan som beskrivs i 4 kap 2 § Plan- och bygglagen (2010:900) \n(PBL). Dataprodukten kan även innehålla de planer som har upprättats med stöd av tidigare \nlagstiftning, och som enligt PBLs övergångsbestämmelser gäller som detaljplan. Dessa är \nbyggnadsplan, stadsplan och avstyckningsplan. \nKommunen kan välja att tillgängliggöra information när som helst i detaljplaneprocessen. \nDataprodukten kan därför innehålla information som ännu inte fått laga kraft. Detaljplaner \npåbörjade innan 2022-01-01 behöver inte tillgängliggöras digitalt och kan därför saknas i \ndataprodukten.\nDetaljplaneinformation har tagits fram på kommunal nivå sedan lång tid tillbaka. Under årens \nlopp har de lagar och rekommendationer som kommunerna haft att förhålla sig till förändrats. \nOlika kommuner arbetar också med detaljplaneprocessen på olika sätt. Detta gör att\nredovisningen av detaljplaneinformation ser olika ut."},"dct:identifier":"bb6a68cc-35a4-4b53-902e-142cd18826fb","dct:issued":{"@type":"xsd:date","@value":"2022-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-01-01"},"dct:provenance":{"@id":"_:2b83eefaf7f5d6474eee27ac55bfe44d2fa8bded35e83edefd35de15177c68d1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:2b83eefaf7f5d6474eee27ac55bfe44d2fa8bded35e83edefd35de15177c68d1_b1n0"},"dct:title":{"@language":"sv","@value":"Detaljplan - datamängd"}},{"@id":"urn:uuid:41f34007-dec7-34f8-b86f-2e877036f1b9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/distribution/geodatakatalog/visning/v1/detaljplan/v1/wms?request=GetCapabilities&version=1.1.1&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Detaljplan Visning"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt för Detaljplan Visning"}},{"@id":"urn:uuid:8cea08bb-10b4-2456-1b29-192b548afab1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/distribution/geodatakatalog/sokning/v1/detaljplan/v2/"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Detaljplan Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt för Detaljplan Nedladdning"}},{"@id":"urn:uuid:f3533957-0299-a508-c4f0-d817d925f391","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/nationella-geodataplattformen/datamangder/befintliga-och-paborjade-datamangder/detaljplan/"},"dct:description":{"@language":"sv","@value":"Beskrivning av datamängd Detaljplan med länk till produktspecifikation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Beskrivning av datamängd Detaljplan"}}],"@id":"urn:source:2b83eefaf7f5d6474eee27ac55bfe44d2fa8bded35e83edefd35de15177c68d1"},{"@graph":[{"@id":"_:2bc87f4045732108a64ecb2f68a37b41bf637e58bcd052d665fb4e190f8fc9ba_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen är framtagen i samarbete mellan SGU och institutionen för geovetenskaper vid Naturhistoriska riksmuseet i Stockholm. Syftet är att samla alla tillgängliga geokronologiska data från Sverige för forskningsändamål. Informationen är även tänkt att kunna användas inom prospektering, samhällsplanering, och av en bredare allmänhet med intresse för Sveriges berggrund.\n\nI källreferensen till varje åldersbestämning finns generellt detaljerad information om bakgrund, syfte, metoder, data, datakvalitet, diskussion och slutsatser. Lägesnoggrannheten är varierande, men generellt bättre för åldersbestämningar beskrivna i senare publikationer."}},{"@id":"_:2bc87f4045732108a64ecb2f68a37b41bf637e58bcd052d665fb4e190f8fc9ba_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7b084085-a5c7-463a-a000-85188dff7bc3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:2181b6d0-1e59-89cc-b356-7cb1b9d076bb"},{"@id":"urn:uuid:36e762d7-e466-8085-ed37-bb3c4e6ab771"},{"@id":"urn:uuid:7046093f-297b-d176-07fa-77f15d521dd2"},{"@id":"urn:uuid:ae6a8a36-de16-00cf-49c2-29f7931d1d38"},{"@id":"urn:uuid:fa029f25-d06a-1c79-1265-fd6de4d969e0"},{"@id":"urn:uuid:fb00bacb-b4d4-52fb-a807-6129afa76d68"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Bergets ålder, isotopanalyser innehåller radiometriska åldersbestämningar av svensk berggrund, sammanlagt ca 2700 poster (Fig. 1). Förutom provets ålder med felmarginal, finns information om provets läge, bergartstyp, daterat material, analysmetod samt hur åldern tolkas etc. \nTill varje post finns en litteraturhänvisning till källan för informationen. I källreferensen finns generellt detaljerad information om bakgrund, syfte, metoder, data, diskussion och slutsatser. Engelska används som språk i data."},{"@language":"sv","@value":"Syftet är att samla alla tillgängliga geokronologiska data från Sverige på ett ställe. Informationen används inom forskning, men är även tänkt att användas inom prospektering, samhällsplanering, och av en bredare allmänhet med intresse för Sveriges berggrund."}],"dct:identifier":"7b084085-a5c7-463a-a000-85188dff7bc3","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-13"},"dct:provenance":{"@id":"_:2bc87f4045732108a64ecb2f68a37b41bf637e58bcd052d665fb4e190f8fc9ba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:2bc87f4045732108a64ecb2f68a37b41bf637e58bcd052d665fb4e190f8fc9ba_b1n0"},"dct:title":{"@language":"sv","@value":"Bergets ålder, isotopanalyser"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:2181b6d0-1e59-89cc-b356-7cb1b9d076bb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-bergets-alder.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:36e762d7-e466-8085-ed37-bb3c4e6ab771","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/bergets-alder-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:7046093f-297b-d176-07fa-77f15d521dd2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/alder"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:ae6a8a36-de16-00cf-49c2-29f7931d1d38","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/bergets-alder/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:fa029f25-d06a-1c79-1265-fd6de4d969e0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/bergets-alder/bergets-alder.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:fb00bacb-b4d4-52fb-a807-6129afa76d68","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/bedrock-age-description-eng.pdf"},"dct:description":{"@language":"sv","@value":"Product descritpion (in English)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Product descritpion"}}],"@id":"urn:source:2bc87f4045732108a64ecb2f68a37b41bf637e58bcd052d665fb4e190f8fc9ba"},{"@graph":[{"@id":"_:2be11ca3bbdd39137d3f135eb2ef205e485780848bdc9f4327732aca42474cf7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Säterkartläggning 2012 till 2014"}},{"@id":"_:2be11ca3bbdd39137d3f135eb2ef205e485780848bdc9f4327732aca42474cf7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.93076 60.89832,13.73243 60.89832,13.73243 59.59937,11.93076 59.59937,11.93076 60.89832))"}},{"@id":"_:2be11ca3bbdd39137d3f135eb2ef205e485780848bdc9f4327732aca42474cf7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/43743a01-a617-4996-b857-85b7667e6798","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:52cd3d97-2889-a739-7768-bec22124b74c"},"dcat:distribution":[{"@id":"urn:uuid:33317fa8-c45a-2bc1-b4c3-2da48c890b13"},{"@id":"urn:uuid:b87c2f20-5835-62f1-21ae-cfd2390edd6e"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Säterinventering under 2012 till 2014. Vilka sätrar finns kvar i Värmland? Hur ser det ut med restaureringsbehov och möjligheterna för att återuppta säterbruket på de olika sätrarna? Bygger på återbesök av sätrar som ingick i \"Inventering och bevarandeplan för sätrar i Värmland\", 1998 av Länsstyrelsen Värmland och Värmlands museum."},"dct:identifier":"43743a01-a617-4996-b857-85b7667e6798","dct:issued":{"@type":"xsd:date","@value":"2014-04-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-04-02"},"dct:provenance":{"@id":"_:2be11ca3bbdd39137d3f135eb2ef205e485780848bdc9f4327732aca42474cf7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:2be11ca3bbdd39137d3f135eb2ef205e485780848bdc9f4327732aca42474cf7_b1n0"},"dct:title":{"@language":"sv","@value":"LstS Säterkartläggning (Fäbod) 2014"}},{"@id":"urn:uuid:33317fa8-c45a-2bc1-b4c3-2da48c890b13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lansstyrelsen.se/varmlan