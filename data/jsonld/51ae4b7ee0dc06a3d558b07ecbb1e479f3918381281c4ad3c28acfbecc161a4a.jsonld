90dabf2d031f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/registerbeteckning-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Registerbeteckning Direkt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Registerbeteckning Direkt."}},{"@id":"urn:uuid:fba69bb3-eaa8-f8ac-938c-0bf939703c67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markreglerande-bestammelse-visning-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Markreglerande bestämmelse Visning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Markreglerande bestämmelse Visning."}}],"@id":"urn:source:c6970d7adb9bcb31d4fa3d474541aa46752a4962958e40cbd6c872260aba24cc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/5d97527a-63c1-4d88-a044-544c0862591d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www,sjofartsverket.se"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för inspiretemat TN Sjötransportnätet."},"dct:identifier":"5d97527a-63c1-4d88-a044-544c0862591d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"TN.Water.Watertransportnetwork.Download"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c69842fd7e20d4c106e7c1f149aaec57fbd68b89af570177c6256a31ae5735d2"},{"@graph":[{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Digitaliserat utifrån HVMFS 2019:21"}},{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 62.00,20.00 62.00,20.00 55.00,11.00 55.00,11.00 62.00))"}},{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/b4be88d1-7816-8d52-1915-8ef66f40aa95","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:bd7d9a2b-0ec7-477d-2699-ca9aa954b71e"},{"@id":"urn:uuid:e8564e91-72db-8567-656a-cc5624938e29"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Hanteringsområdet omfattar den del av Sverige där signalkräfta i huvudsak finns etablerad och där den enligt HaV kan fortsätta att nyttjas genom fiske. Syftet är att visa var fiske får bedrivas förutsatt att signalkräftan inte sprids. Utanför hanteringsområdet är hantering, inklusive fiske straffbar. Därmed är det viktigt att detaljerade gränser finns.\n\nInformationsmängden omfattar gränser bestående av kommun- och länsgränser, riksvägar och gränser för delavrinningsområden."},"dct:identifier":"b4be88d1-7816-8d52-1915-8ef66f40aa95","dct:issued":{"@type":"xsd:date","@value":"2023-06-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b1n0"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:bd7d9a2b-0ec7-477d-2699-ca9aa954b71e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/hanteringsomrade-signalkrafta/2023-08-09/hanteringsomrade-signalkrafta-2023-08-09.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}},{"@id":"urn:uuid:e8564e91-72db-8567-656a-cc5624938e29","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/hanteringsomrade-signalkrafta/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Hanteringsområde för signalkräfta"}}],"@id":"urn:source:c736f8eebebc84fb5c88bf9726d700c41beaf9d259103f74d98aa523d4e01d8b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/5109baab-748a-4b19-ad43-94f82be18312","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografisk-webbkarta-visning-skiktindelad-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten ger tillgång till skikt med topografisk kartinformation som är färgsatta och nedtonade i gråskala. Produkten är anpassad för skärmvisning. Kartinformationen är uppdelad i flera skikt vilket gör det möjligt att välja vilken information som visas i kartbilden."},"dct:identifier":"5109baab-748a-4b19-ad43-94f82be18312","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Topografisk webbkarta Visning, skiktindelad"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c7483d9b63698e3f20393ace255d4cff462debe3ad4f6b944cbd85f8aaea4533"},{"@graph":[{"@id":"_:c77d1fca9b4261edd0feca3846c4711c872cef177a37bfaa2aee3c423a790add_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datasetet innehåller ytor.\n\nVärldsarvens digitala gränser härstammar från olika källor och har skapats hos länsstyrelserna under lång tid och skilda omständigheter. Det är därför svårt att göra en uttömmande beskrivning av hur de har lägesbestämts. De äldre världsarven har digitaliserats utifrån den handritade karta som skickades in till UNESCO. Världsarv tillkomna eller uppdaterade efter år 2004 har sannolikt digitaliserats mot fastighetskartan (skala 1:10 000).\n\nCentrumpunkterna för Struves meridianbåge är korrekt placerade, men ytorna har digitaliserats på ett schablonmässigt sätt för att vara synliga på kartan i Länsstyrelsen Norrbottens kulturmiljövårdsprogram. Dessa ytor visar således inte världsarvets faktiska utbredning."}},{"@id":"_:c77d1fca9b4261edd0feca3846c4711c872cef177a37bfaa2aee3c423a790add_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.203061578412 69.527398460505,25.013956127431 69.527398460505,25.013956127431 54.769334649279,10.203061578412 54.769334649279,10.203061578412 69.527398460505))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/3cd09743-275e-4c97-b736-f7d243ed615c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:5dddc960-7ef1-2a09-b442-1e9d2c77c829"},{"@id":"urn:uuid:61e1e13e-1295-ccc4-13b3-b12e9535674a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängd med Sveriges världsarv. Utgörs av geografiska områden som pekats ut i enlighet med Unescos konvention den 16 november 1972 om skydd för världens kultur- och naturarv. Innehåller endast världsarvsområdet, inte buffertzon."},"dct:identifier":"3cd09743-275e-4c97-b736-f7d243ed615c","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-10-01"},"dct:provenance":{"@id":"_:c77d1fca9b4261edd0feca3846c4711c872cef177a37bfaa2aee3c423a790add_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:c77d1fca9b4261edd0feca3846c4711c872cef177a37bfaa2aee3c423a790add_b1n0"},"dct:title":{"@language":"sv","@value":"Världsarv i Sverige - information om datamängden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:5dddc960-7ef1-2a09-b442-1e9d2c77c829","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/evenemang-och-upplevelser/upplev-kulturarvet/varldsarv-i-sverige/"},"dct:description":{"@language":"sv","@value":"Startsida för världsarv i Sverige med länkar till mer information om världsarv som bland annat vanliga frågor med mera."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Världsarv i Sverige"}},{"@id":"urn:uuid:61e1e13e-1295-ccc4-13b3-b12e9535674a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dct:description":{"@language":"sv","@value":"Här kan du ladda ned öppna data och hämta wms:er som tillhandahålls av Riksantikvarieämbetet."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Riksantikvarieämbetet öppna data-portal"}}],"@id":"urn:source:c77d1fca9b4261edd0feca3846c4711c872cef177a37bfaa2aee3c423a790add"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8eef4173-5a91-4c0d-8b66-f3af26b46f64","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/berggrund_1M"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten berggrund 1:1 miljon är framför allt till för dig som vill få en översiktlig bild av Sveriges berggrund. Kartbilden är anpassad för presentation i skala 1:1 miljon, vilket innebär att informationen är kraftigt generaliserad. \n\nHär visas de olika bergarternas utbredning och, om du väljer detta lager, tektonik och diabasgångar. Det finns även möjlighet att få fram en kartbild som visar bergarterna indelade efter ålder, dvs. en karta som beskriver till vilken geologiska bildningsperiod bergarterna hör."},"dct:identifier":"8eef4173-5a91-4c0d-8b66-f3af26b46f64","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Berggrund 1:1 miljon (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c7b62ba0af0c83ed1d45f0c0dff06e9b7a9596a06496c58076e2bee94f354365"},{"@graph":[{"@id":"_:c7c8e77fb0b70cec1f6efb4b49b9eb7be7ffa6ac9088a64c5efd204db50b116d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:c7c8e77fb0b70cec1f6efb4b49b9eb7be7ffa6ac9088a64c5efd204db50b116d_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010---121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"fo