2cd6c564dcb336b3333bec_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1998"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1990"}},{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/c952b07e-854f-460c-9306-392eadfc099c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:137a9cee-c41e-1119-bd6b-5f6fcff80eea"},{"@id":"urn:uuid:b10ab052-0ca8-d381-5cf8-808dd4f94b8d"}],"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Naturtyper och biotoper"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/hb"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Samlingsnamn för all skogsklädd våtmark. 3 typer, myrskog, fuktskog och strandskog. Myrskogen kan delas in i kärrskog och mosseskog. Fuktskogen delas in i översilningsskog och övrig fuktskog."},"dct:identifier":"c952b07e-854f-460c-9306-392eadfc099c","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-09-27"},"dct:provenance":{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b1n0"},"dct:temporal":{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b2n0"},"dct:title":{"@language":"sv","@value":"HB.Sumpskogar inventerade av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:137a9cee-c41e-1119-bd6b-5f6fcff80eea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaSumpskog/MapServer/WmsServer?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst - Sumpskogar"}},{"@id":"urn:uuid:b10ab052-0ca8-d381-5cf8-808dd4f94b8d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Sumpskogar.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av sumpskogar producerade av Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av sumpskogar - atomflöde"}}],"@id":"urn:source:81841b7279e01a2507098fcd590b801624093640bb2cd6c564dcb336b3333bec"},{"@graph":[{"@id":"_:81e01465d7703206dfa20e03f99f24aa3a115af863d17b344261761bb966f62e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:81e01465d7703206dfa20e03f99f24aa3a115af863d17b344261761bb966f62e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/20414189-4CEB-47C4-95CB-3006F4C3CBFB","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:70829fcb-3bd1-3cb7-1841-6f68a0ccd198"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Medeldjup beräknat utifrån samtliga mätta djupvärden i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 500 m upplösning. Medelvärdenas position är respektive rutas mittpunkt och beräknas endast i rutor med minst ett mätt djupvärde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"20414189-4CEB-47C4-95CB-3006F4C3CBFB","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-01"},"dct:provenance":{"@id":"_:81e01465d7703206dfa20e03f99f24aa3a115af863d17b344261761bb966f62e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:81e01465d7703206dfa20e03f99f24aa3a115af863d17b344261761bb966f62e_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 500 m upplösning - medeldjup"}},{"@id":"urn:uuid:70829fcb-3bd1-3cb7-1841-6f68a0ccd198","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:81e01465d7703206dfa20e03f99f24aa3a115af863d17b344261761bb966f62e"},{"@graph":[{"@id":"_:81fa8a51f9d14d3eb594b820e4d4a0cfec535af4d37cceba8cb7da474f1268bc_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/7862dd35-3f40-6c5e-e0f3-c90c57546cf8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:0d215e47-eb14-ebe9-af63-4ffd87d471e4"},{"@id":"urn:uuid:987a3f97-2f7b-7e22-db26-cd628e5cd80f"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Statistik rörande fritidsfisket i Sverige. Bland annat information om fritidsfiskets omfattning, fångster samt ekonomi kopplat till fritidsfiskeaktiviteten."},"dct:identifier":"7862dd35-3f40-6c5e-e0f3-c90c57546cf8","dct:issued":{"@type":"xsd:date","@value":"2018-01-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige 2015"}},{"@id":"urn:uuid:0d215e47-eb14-ebe9-af63-4ffd87d471e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/data-kartor-och-rapporter/data-och-statistik/officiell-statistik/officiell-statistik---fiske/fangststatistik-for-fritidsfisket.html"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (HaV)"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:81fa8a51f9d14d3eb594b820e4d4a0cfec535af4d37cceba8cb7da474f1268bc_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:987a3f97-2f7b-7e22-db26-cd628e5cd80f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/statistik-efter-amne/jord-och-skogsbruk-fiske/fiske/fritidsfiske/"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (SCB)"}}],"@id":"urn:source:81fa8a51f9d14d3eb594b820e4d4a0cfec535af4d37cceba8cb7da474f1268bc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/72252052-e2a3-4014-bc68-c5d9a3420d83","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/bergartskemi"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Bergartskemi innehåller information om olika grundämnen i bergartsprov från Sverige. Provtagning har i huvudsak skett i anslutning till ordinarie fältarbeten vid SGU. En del analysvärden är hämtade från litteraturen och andra är inhämtade från prospekteringsbolag. Analys har skett med olika så kallade analyspaket och analysmetoder, även olika laboratorium har använts över tiden. Datamängden Bergartskemi innehåller lägesuppgifter, kort beskrivning samt kemiska analyser av bergartsprover.\n\nMängden information om proven, provtagningsmetodik, analys- och provberedningsmetod, analyslaboratorium och mängden analyserade element varierar stort.\n\nEtt urval och en gruppering av element har gjorts för att särredovisa element som bedömts vara särskilt intressanta i prospekteringssammanhang, eller med toxiska egenskaper för dricksvatten. Samtliga analyserade element och provtagningsplatser redovisas dessutom i ett gemensamt lager."},"dct:identifier":"72252052-e2a3-4014-bc68-c5d9a3420d83","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Bergartskemi (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:8262e2d6ab043194eeb49634382580d85318683e6c71a3bf4b8e17f7ad54efa2"},{"@graph":[{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geografisk information är belägenhetsadress på arbetsställe. Utifrån arbetsställenas adresser har koordinater från Lantmäteriet kopplats på. Detta har gjorts genom att geokoda adresserna i flera steg och med olika metoder. Ett visst bortfall finns när koordinater inte kunnat kopplas till belägenhetsadressen. Informationen som finns i det Allmänna företagsregistret är senast kända uppgift (det vill säga kan informationen vara tio år gammal)."}},{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2025"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/0f548d7e-e574-4c84-820c-54e5ccceda93","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:588990d1-5e3d-0ebb-122c-a8263ce3e562"},{"@id":"urn:uuid:8b329f9a-c3cf-f907-2bcd-04816910cbf3"},{"@id":"urn:uuid:8fd746fc-9eb8-a90c-c2e0-c58bd1e21e50"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Myndighets- och kommunkontorens geografiska punkt tas fram med hjälp av det Allmänna företagsregistret samt Geografidatabasen. De juridiska formerna som används är 82 (Kommuner), 83 (Kommunalförbund), 84 (Regioner), 85 (Allmänna försäkringskassor) och 89 (Regionala statliga myndigheter). Geografisk information är belägenhetsadress på arbetsställe.\n\nGeokodade myndighets- och kommunkontor uppdateras en gång om året och källan är frysning av årsstatistik som är baserad på SAMU ramar (avser november). Årsregistret skapas i december."},"dct:identifier":"0f548d7e-e574-4c84-820c-54e5ccceda93","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-13"},"dct:provenance":{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b1n0"},"dct:temporal":{"@id":"_:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87_b2n0"},"dct:title":{"@language":"sv","@value":"US.AdministrativaOchSocialaOffentligaTjänster.MyndighetsOchKommunkontor"}},{"@id":"urn:uuid:588990d1-5e3d-0ebb-122c-a8263ce3e562","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SCB:s öppna geodata"}},{"@id":"urn:uuid:8b329f9a-c3cf-f907-2bcd-04816910cbf3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/inspire/US.PublicAdministrationOffice/ows?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Myndighets och Kommunkontor WMS"}},{"@id":"urn:uuid:8fd746fc-9eb8-a90c-c2e0-c58bd1e21e50","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://share.scb.se/OV0105/Xml/US/us_administrativaochsocialaoffentligatjanster_myndighetsochkommunkontor_atom_nt.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av GML format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atomflöde för Myndighets och Kommunkontor"}}],"@id":"urn:source:82e593e4e077b47e77fd3773bf49af6a2acd55831b5f28a4afe4c60b1b899e87"},{"@graph":[{"@id":"_:82ef1be5fdd29f74fddd2582019c0b3967dd079d9aa733e2d9d1a75e9cac2e89_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11219 65.81117,21.48543 65.81117,21.48543 56.0694,11.11219 56.0694,11.11219 65.81117))"}},{"@id":"_:82ef1be5fdd29f74fddd2582019c0b3967dd079d9aa733e2d9d1a75e9cac2e89_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a4d67799-0dff-4b8e-a720-f9d155309f8f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:454cf732-8cbc-6db3-19e2-c18ccd5a7238"},{"@id":"urn:uuid:8ede13e7-5343-a27f-d111-6cdd4244293c"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Åtgärdsområden för kalkning som ursprungligen sammanställts av HaV. Skiktet bygger på geodata från respektive länsstyrelse som kompletterats med data från Nationella kalkdatabasen. Varje län ansvarar för att de områden som finns med i skiktet är aktuella och kommer in med uppdateringar till länsstyrelsen i Jönköpings län när ändringar sker. Åtgärdsområdesskiktet uppdateras en gång per år av länsstyrelsen i Jönköpings län."},"dct:identifier":"a4d67799-0dff-4b8e-a720-f9d155309f8f","dct:issued":{"@type":"xsd:date","@value":"2019-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:82ef1be5fdd29f74fddd2582019c0b3967dd079d9aa733e2d9d1a75e9cac2e89_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - åtgärdsområden"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:82ef1be5fdd29f74fddd2582019c0b3967dd079d9aa733e2d9d1a75e9cac2e89_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:454cf732-8cbc-6db3-19e2-c18ccd5a7238","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_atgardsomraden.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:8ede13e7-5343-a27f-d111-6cdd4244293c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:82ef1be5fdd29f74fddd2582019c0b3967dd079d9aa733e2d9d1a75e9cac2e89"},{"@graph":[{"@id":"_:8380e2199c583f98e6d2ccacaae04f9dc0ffe790116fd5173beba4140af16978_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Updates are conducted periodically by Lantmäteriet and more continuously in cooperation with other government agencies, municipalities and organizations. \nCollection methods used by Lantmäteriet are interpretation of aerial stereo or orthophotos.\nTimeliness in different areas, depends on Lantmäteriet´s image supply program and the agreements that exist with cooperation partners.\nRoads are kept up to date based on changes in the NVDB, National Road database\n\nAjourhållningen sker dels periodiskt i Lantmäteriets egen regi, dels mer kontinuerligt i samverkan med andra statliga myndigheter, kommuner och organisationer. Insamlingsmetoder som används inom egen regi är framförallt tolkning i flygbilder i stereo eller ortofoto. Aktualiteten i olika områden beror därför på bildförsörjningsprogrammet och de avtal som finns med samverkansparterna.\nVägar ajourhålls utifrån förändringar i NVDB, Nationell Vägdatabas som Trafikverket är huvudman för."}},{"@id":"_:8380e2199c583f98e6d2ccacaae04f9dc0ffe790116fd5173beba4140af16978_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/ec6cda58-be88-4f98-9fd5-933a8f4b0a4e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:74e85af9-fb66-c6bb-a90c-6db4ad49ea60"},{"@id":"urn:uuid:c359dcd5-9aba-e775-e66a-ea27a76af4fd"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängd för transport i skalområdet 1:10 000. Innehåller vägar, traktorvägar, järnvägar, järnvägsstationer, färjeleder, cykelvägar, stigar och leder, linbanor, kraftledningar, transformatorstationer, bommar samt vändplaner.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Basemap Visning, Inspire.\n\nDataset for transportation, scale 1:10 000. Contains roads, tractor track, railroads, railway stations, cycle path, footpath, hiking trails, aerial cableway, electricity transmission line, transformerstation, barrier and turning place.\nThe dataset can´t be ordered separately. It is only included in existing service: Base map View Service INSPIRE"},"dct:identifier":"ec6cda58-be88-4f98-9fd5-933a8f4b0a4e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-01-01"},"dct:provenance":{"@id":"_:8380e2199c583f98e6d2ccacaae04f9dc0ffe790116fd5173beba4140af16978_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:8380e2199c583f98e6d2ccacaae04f9dc0ffe790116fd5173beba4140af16978_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för transport 1:10 000"}},{"@id":"urn:uuid:74e85af9-fb66-c6bb-a90c-6db4ad49ea60","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/inspire/basemap/wms/v1?request=GetCapabilities&version=1.1.1&services=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för tjänsten Basemap Visning, Inspire"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt"}},{"@id":"urn:uuid:c359dcd5-9aba-e775-e66a-ea27a76af4fd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/basemap-visning-inspire-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Basemap Visning, Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Basemap Visning, Inspire"}}],"@id":"urn:source:8380e2199c583f98e6d2ccacaae04f9dc0ffe790116fd5173beba4140af16978"},{"@graph":[{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Regeringen har gett Skogsstyrelsen och Sveriges lantbruksuniversitet (SLU) i uppdrag att uppdatera, utveckla och tillgängliggöra Skogliga grunddata. Uppdraget ska utföras via Lantmäteriets laserskanning av Sveriges skogsmark."}},{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.10 69.06,21.63 69.06,21.63 55.16,9.10 55.16,9.10 69.06))"}},{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/e2dc79ff-1105-4f04-a220-6a9000e6a968","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f"},{"@id":"urn:uuid:f715a479-9dff-725b-3ae6-2e0e450966a2"}],"dcat:distribution":{"@id":"urn:uuid:8d406515-f4dd-636b-7916-9ed7b1dd9399"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Skogliga grunddata består av ett antal olika kartprodukter producerade genom\nsambearbetning av data från Lantmäteriets nationella laserskanning och provytor från SLU:s\nRiksskogstaxering. I skogliga grunddata finns information om:\nVolym (enhet: m3sk/hektar)\nGrundytevägd medelhöjd (Hgv) (enhet dm)\nGrundyta (Gy) (enhet: cm)\nGrundytevägd medeldiameter (Dgv) (enhet: cm)\nBiomassa (enhet: ton torrsubstans/hektar)"},"dct:identifier":"e2dc79ff-1105-4f04-a220-6a9000e6a968","dct:issued":{"@type":"xsd:date","@value":"2018-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-01"},"dct:provenance":{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a0f7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:83ae8e0ad755dc0359926ce7d7565f29dd53e759ad06b1f986e1b793e3f6a