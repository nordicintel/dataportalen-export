652a27ef1ba95bf9575ce075b30dc7babd6c089206d8ad88cd5a211a9c5"},{"@graph":[{"@id":"_:08391f9109db534e94b64ae5d5b71f6fd6d319a0b55436be179d161d6eadb3ca_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtagen enligt förordning (2009:956) om översvämningsrisker 2018"}},{"@id":"_:08391f9109db534e94b64ae5d5b71f6fd6d319a0b55436be179d161d6eadb3ca_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"https://www.geodata.se/resources/9648e0d4-4d88-4f7b-81e2-b8403488542e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:20b529a3-3863-20b9-69cc-fe692b2825db"},{"@id":"urn:uuid:5de968f2-f54f-b2af-d299-20e81f2c1a12"},{"@id":"urn:uuid:75dcbb05-3032-b1e1-d092-d71d0242f806"},{"@id":"urn:uuid:f1cdaa71-287a-2784-b4fe-0294969ff856"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Utbredningsskikt för beräknade högsta flödet/nivån motsvarande hotkartor/riskkartor för de områden med betydande översvämningsrisk enligt förordningen om översvämningsrisker (SFS 2009:956) 2018. För vattendrag finns endast utbredningsskikt för ett avgränsat område och inte hela vattendraget. Om ett område identifierats utifrån hav och det i området också finns ett vattendrag eller en sjö så finns även hotkartor/riskkartor framtagna för dessa. \nFör vattendrag och sjö används beräkningar för dagens klimat medan för havet har beräkningarna klimatanpassats till slutet av seklet där landhöjning ingår. \nDatamängden är ett resultat av revideringen av steg 2 för cykel 2 (2019) inom översvämningsdirektivet men även för steg 2 i cykel 1 (2013) finns även med i datamängden och där ingick inte översvämningar från havet som de gör i revideringen av steg 2 för cykel 2 (2019).\nFör vattendrag har en 2 dimensionell hydraulisk modell använts för att ta fram utbredningen. För havet, Vänern, Vättern och Mälaren har en analys av höjd använts. Vilken cykel respektive hotkarta/riskkarta är i från framgår i attributtabellen.\n\nMer information om förordningen om översvämningsrisker finns på: https://www.msb.se/sv/amnesomraden/skydd-mot-olyckor-och-farliga-amnen/naturolyckor-och-klimat/oversvamning/oversvamningsforordningens-tre-steg/"},"dct:identifier":"9648e0d4-4d88-4f7b-81e2-b8403488542e","dct:issued":{"@type":"xsd:date","@value":"2019-09-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-11"},"dct:provenance":{"@id":"_:08391f9109db534e94b64ae5d5b71f6fd6d319a0b55436be179d161d6eadb3ca_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:08391f9109db534e94b64ae5d5b71f6fd6d319a0b55436be179d161d6eadb3ca_b1n0"},"dct:title":{"@language":"sv","@value":"Hot- och riskkartor, utbredning BHF"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:20b529a3-3863-20b9-69cc-fe692b2825db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/HotRiskbhf.zip"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, BHF i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:5de968f2-f54f-b2af-d299-20e81f2c1a12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/hotochriskbhf/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Sida för visningstjänst av utbredningsområden för hot- och riskkartor, BHF"}},{"@id":"urn:uuid:75dcbb05-3032-b1e1-d092-d71d0242f806","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_HotRiskBHF.xml"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, BHF i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"},{"@id":"urn:uuid:f1cdaa71-287a-2784-b4fe-0294969ff856","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/hotochriskbhf/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst hot och risk bhf OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}}],"@id":"urn:source:08391f9109db534e94b64ae5d5b71f6fd6d319a0b55436be179d161d6eadb3ca"},{"@graph":[{"@id":"_:0874cb938cbbd1da44a084f7ad2c58840544c1c79b30be6f61737abe4cae87fc_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"h