9227df32a5f69218b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:4cdb7cdc61ef66631c369e420c0fe226c9ca694ff1f916d9227df32a5f69218b_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2006"}},{"@id":"https://www.geodata.se/resources/6341813c-bfa3-45df-8234-13cf583bf533","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:14f568ec-f9f1-d1bf-de70-238879f40145"},{"@id":"urn:uuid:176c4913-208c-9754-0d7c-5d1cd3f2d33b"},{"@id":"urn:uuid:718e1232-e746-b92d-587b-6ade96255791"},{"@id":"urn:uuid:7c0e8010-7041-1e1e-39a5-ef9c2b805a56"},{"@id":"urn:uuid:a09be386-fec2-00cc-eabc-7556d3032a54"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Data om skyddsrum. I lagen om skyddsrum (2006:545) finns det bestämmelser om hur skyddsrum skall\nutformas och placeras, byggas, utrustas och underhållas och kontrolleras."},"dct:identifier":"6341813c-bfa3-45df-8234-13cf583bf533","dct:issued":{"@type":"xsd:date","@value":"2009-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-16"},"dct:provenance":{"@id":"_:4cdb7cdc61ef66631c369e420c0fe226c9ca694ff1f916d9227df32a5f69218b_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:4cdb7cdc61ef66631c369e420c0fe226c9ca694ff1f916d9227df32a5f69218b_b1n0"},"dct:temporal":{"@id":"_:4cdb7cdc61ef66631c369e420c0fe226c9ca694ff1f916d9227df32a5f69218b_b2n0"},"dct:title":{"@language":"sv","@value":"Skyddsrum"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:14f568ec-f9f1-d1bf-de70-238879f40145","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/skyddsrum/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst för MCF:s skyddsrum"}},{"@id":"urn:uuid:176c4913-208c-9754-0d7c-5d1cd3f2d33b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/filer/shape/Skyddsrum.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av MCF:s skyddsrum i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:718e1232-e746-b92d-587b-6ade96255791","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/filer/geopackage/Skyddsrum_EPSG3006.gpkg"},"dct:description":{"@language":"sv","@value":"Nedladdning av MCF:s skyddsrum i Geopackage-format"}},{"@id":"urn:uuid:7c0e8010-7041-1e1e-39a5-ef9c2b805a56","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/MSB_TopAtomFeed_skyddsrum.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för MCF:s skyddsrum i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:a09be386-fec2-00cc-eabc-7556d3032a54","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/skyddsrum/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst skyddsrum OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:4cdb7cdc61ef66631c369e420c0fe226c9ca694ff1f916d9227df32a5f69218b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/c5295776-adff-4a69-bd59-6c7fb55291007457484568474","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www.raa.se/hitta-information/bebyggelseregistret"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller information om det byggda kulturarvet i Sverige, med tyngdpunkt på byggnader skyddade enligt Kulturminneslagen och Förordningen (1988:1229) om statliga byggnadsminnen. Datauttagen kan omfatta alla byggnader som förekommer i databasen, eller begränsas med parametrarna Byggnadsminnen (samtliga eller per län) eller Kyrkor (samtliga eller per stift)."},"dct:identifier":"c5295776-adff-4a69-bd59-6c7fb55291007457484568474","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Information om det byggda kulturarvet, hela Sverige, nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4ceeb92133eb7a70d49a52ccac1cf4b7df7162124bd20a00bd699fe73da5674f"},{"@graph":[{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"På land har spår av inträffade jordskred och raviner har identifierats genom bildtolkning på skärm med Lantmäteriets GSD-Höjddata, grid 2+ och information från SGU:s jordartsgeologiska databaser som underlag\n\nMer information: Mer att läsa om jordskred och raviner finns på SGU:s webbplats www.sgu.se.\n\nUnderhåll\nProdukten uppdateras med ny information allt eftersom produktionen av den nya nationella höjdmodellen, GSD-Höjddata grid 2+ fortskrider.\n\nDatakvalitet\nLägesfel på 30 m, felklassningar och ofullständigheter kan förekomma.\nRaviner med ett djup understigande ca 3 m har normalt inte kartlagts, inte heller raviner vars former utjämnats genom schaktning och utfyllnad.\nJordskredsärr med en linjelängd under 30–50 m har normalt inte kartlagts. I en del fall har spåren efter inträffade jordskred blivit otydliga genom schaktning och utfyllnader. Sådana spår har normalt inte kartlagts."}},{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.29935052872 68.41782664298,25.333380295315 68.41782664298,25.333380295315 55.282768354203,11.29935052872 55.282768354203,11.29935052872 68.41782664298))"}},{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2013"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/4480828d-a912-46ba-89b3-814000434aa1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3184b363-8738-5b05-de69-196cc5cc66f5"},{"@id":"urn:uuid:3520f58b-ef2c-d1ba-eb92-d59f2c8d1fa8"},{"@id":"urn:uuid:8d8ac55b-f4ca-3735-e5fd-3fd02a8afdcf"},{"@id":"urn:uuid:b6212e9f-91b9-3e70-c3f4-fe0ea6cf04c6"},{"@id":"urn:uuid:c9148341-d4b9-eb99-ca4f-126cfcfae510"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Produkten visar morfologiskt framträdande spår i terrängen av inträffade jordskred på land samt raviner i lösa jordlager. \nTillsammans med jordartskartor och höjddata kan informationen användas för en översiktlig bedömning av skredkänslighet och markstabilitet. \n\nDe flesta skred har skett i lerjord, men det förekommer även spår av skred i sandjordar, inte minst i de norrländska älvdalarna, samt i moränjordar. I de fallen skred har inträffat i sandjord finns ofta silt- eller lerlager under ett ytligt sandlager. Spår av jordras har också inkluderats i den mån de har gett upphov till former liknande jordskredsspår."},{"@language":"sv","@value":"Tillsammans med jordartskartor och höjddata kan informationen användas för en översiktlig bedömning av skredkänslighet och markstabilitet."}],"dct:identifier":"4480828d-a912-46ba-89b3-814000434aa1","dct:issued":{"@type":"xsd:date","@value":"2014-02-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b1n0"},"dct:temporal":{"@id":"_:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99_b2n0"},"dct:title":{"@language":"sv","@value":"Jordskred och raviner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:3184b363-8738-5b05-de69-196cc5cc66f5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordskred-raviner/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:3520f58b-ef2c-d1ba-eb92-d59f2c8d1fa8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordskred-raviner-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:8d8ac55b-f4ca-3735-e5fd-3fd02a8afdcf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordskred-raviner/jordskred-raviner.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:b6212e9f-91b9-3e70-c3f4-fe0ea6cf04c6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jordskred-raviner"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:c9148341-d4b9-eb99-ca4f-126cfcfae510","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-skred.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:4d7fbe9a88e30e2644aac8065c80e764a8f3f318b6f564b2fae776125cdfca99"},{"@graph":[{"@id":"_:4e32b2c3c70b7f24ec6666ee9f9b81af679cac1e31994bfddba41cbd29119079_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Produkten bytte namn från Biogeokemi till Biogeokemi, regional provtagning 2021-11-26.\n\nProvtagning\nBäckvattenväxter provtogs i mindre vattendrag i stora delar av Sverige förutom den nordligaste delen och fjällkedjan. Provtagning har skett för hand i mindre, rinnande vattendrag (bäckar, diken). Provmaterialet består huvudsakligen av rötter av olika starrarter (Carex), hela plantor av Näckmossa (Fontinalis Antipyretica) samt rötter av Älggräs (Filipendula Ulmaria). I de fall där ingen av ovanstående arter påträffats kan andra, främst rotprov från olika gräsarter, förekomma. För att prov skall anses vara acceptabelt skall det helst bedömas vara vattendränkt under hela året, möjligen med undantag för perioder av extrem torka. Bäckvattenväxtprov tas i regel längs en kortare sträcka i vattendraget, och kan därmed betraktas som ett kompositprov.\nVarje prov har en unik kombination av IDKOD och IDNR. IDKOD är uppbyggt efter ”XXyy”, där yy anger årtal. t ex anger XX85 provtagningsår 1985, XX01 står för 2001. IDNR är provets individuella ID-nummer.\n\nProvberedning\nBäckvattenväxterna inaskas, och större synliga oorganiska partiklar avlägsnas innan analys. Prov avsedda för analys Hg och Se torkas i rumstemperatur.\nAnalysering\n\nAnalysering har skett med ett antal olika metoder. Analysmetoderna beskrivs närmare under varje filrubrik nedan och filerna är indelade efter analysmetod. \npH mätning av rinnande vatten från den biogeokemiska karteringen har skett i fält.\n\nDatakvalitet\nSGU skickar kontinuerligt med egna standardprov tillsammans med ordinarie prov för att verifiera hur analyskvaliteten varierar över tid. Anlitade laboratorium använder även interna och externa geostandarder för att kontrollera sin kvalitet."}},{"@id":"_:4e32b2c3c70b7f24ec6666ee9f9b81af679cac1e31994bfddba41cbd29119079_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/882ea7d7-483a-4d89-9a60-9a09d125387e","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3c6c3b17-39f4-8ff2-d796-1dfcfb60ffaa"},{"@id":"urn:uuid:75ef2825-b7a2-c530-caa4-d0741b3468d7"},{"@id":"urn:uuid:98ddf02d-49a1-30c9-6442-34e4f51f4994"},{"@id":"urn:uuid:ab7c1509-971e-8eee-1553-230134d1059b"},{"@id":"urn:uuid:b16ed883-394a-9b19-c13f-2fa82a81d7b5"},{"@id":"urn:uuid:b5d06ff1-0eaa-0720-be2d-a23410537982"},{"@id":"urn:uuid:b9678da7-7425-6857-1273-0e48cfc94eef"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"När mineralen i berg och jord vittrar frigörs metaller som kommer ut i miljön. Men även metaller som frigörs när människan utnyttjar och utvinner naturtillgångar tillförs miljön. Många giftiga tungmetaller, t.ex. bly, kvicksilver och kadmium har dessutom fått sina kretslopp förändrade genom att de används av människan. Försurningen har också radikalt förändrat kretsloppen för många metaller. Biogeokemisk kartläggning av tungmetaller i miljön ger underlag till bland annat miljöundersökningar. Analys av rötter av vissa örter och vattenlevande mossor från bäckar ger en bild av belastningen av vattendrag och visar på halterna av metaller i berggrunden och jordarterna men också utsläpp och nedfall av tungmetaller. Växterna suger åt sig metaller från det förbirinnande vattnet. En styrka med denna kartläggning är att levande material provtas, vilket ger information om vad som tagits upp av växterna, och därför är biotillgängligt. Vi kan alltså på detta sätt få reda på vilka metaller vi själva får i oss."},{"@language":"sv","@value":"Produkten innehåller information om olika grundämnen i bäckvattenväxter samt pH i rinnande vatten. Analysresultat redovisas med olika analysmetoder, såväl totalhalter som syralakbara halter har bestämts. Produkten är direkt resultat av mångårigt geokemiskt karteringsprogram. Geokemisk kartering vid SGU bedrivs huvudsakligen i syfte att visa den naturliga förekomsten av huvudämnen och spårämnen i vattenväxter samt pH i vatten. Inom regional biogeokemisk kartering provtogs och analyserats bäckvattenväxter, som olika Carex-arter (rötter), Filipendula ulmaria (rötter) och Fontinalis antipyretica (hela växten). Växter samlades från mindre bäckar med en provtäthet av 1 prov per 7 km2. \nBäckvattenväxter (rötter) och mossa anses vara provmedier som utan åtskiljning tar upp spårelement och därför avspeglar bäckvattenkemin. Bäckvattenväxter utsätts för både naturlig och antropogen påverkan. På grund av kemiska vittringsprocesser visar metallkoncentrationerna i bäckvatten på den kemiska sammansättningen i omgivande berggrund och jord. Utbytet av metaller mellan vatten och växtrötter är en långsam process som verkar inte påverkas av säsongsvariationer. Man kan uppskatta att biogeokemiska prov visar biotillgängliga metallkoncentrationer i akvatiska växter.\nHuvud- och spårelement i som analyseras i växtprov kommer ursprungligen från de levande rötterna och bladmossan, samt från minerogent material och järn-manganhydroxider som är associerade med växten. Andra geokemiska källor, till exempel humuspartiklar, anses ha mindre betydelse. \nVäxtproven har analyserats på 30 grundämnen med röntgenfluorescens (XRF), där Al, As, Ba, Ca, Cl, Co, Cr, Cu, Fe, K, Mg, Mn, Mo, Na, Ni, P, Pb, Rb, S, Si, Sr, Ti, U, V, W, Y, Zn och Zr gett tillräckligt hög analyskvalitet för att kunna användas för tolkning. En delmängd av proven har också analyserats på Hg, Cd, Se, Au, Sb, Bi och Tl med syralakning kombinerat med atomabsorptions-spektrometri (AAS) och induktivt kopplad plasmamasspektrometri (ICP-MS). Resultat från fjorton grundämnen (As, Cd, Co, Cr, Cu, Hg, Mo, Ni, Pb, Se, U, V, W och Zn) har regelbundet blivit publicerade på SGU i form av rapporter, kartor och databaser. \nProvresultaten visar hur spridningsmönster av olika grundämnen i vattendragen varierar inom landet. Variation beror på såväl det naturliga tillskottet från jordarter och berggrund som på tillskottet från olika föroreningskällor."}],"dct:identifier":"882ea7d7-483a-4d89-9a60-9a09d125387e","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:4e32b2c3c70b7f24ec6666ee9f9b81af679cac1e31994bfddba41cbd29119079_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:4e32b2c3c70b7f24ec6666ee9f9b81af679cac1e31994bfddba41cbd29119079_b1n0"},"dct:title":{"@language":"sv","@value":"Biogeokemi, regional provtagning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:3c6c3b17-39f4-8ff2-d796-1dfcfb60ffaa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/biogeokemi-regional-provtagning-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Biogeokemi, regional provtagning (visningstjänst)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:75ef2825-b7a2-c530-caa4-d0741b3468d7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/biogeokemi-regional?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:98ddf02d-49a1-30c9-6442-34e4f51f4994","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-biogeokemi-koppar.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:ab7c1509-971e-8eee-1553-230134d1059b","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/biogeokemi-regional/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:b16ed883-394a-9b19-c13f-2fa82a81d7b5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-biogeokemi-regional-provtagning.html"},"dct:description":{"@language":"sv","@value":"Kartvisara