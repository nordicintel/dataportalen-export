/dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/5699461a-602e-e472-8c17-f0f02d176e0d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"urn:uuid:8fd8bc4e-483b-d9f4-a052-56e669393348"},"dcat:distribution":[{"@id":"urn:uuid:02b036bb-5645-4c2f-891d-ead11ac41e71"},{"@id":"urn:uuid:ec07a5a2-e0b0-01ea-765c-1f33d1d0b078"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kommunal miljöövervakning vid badplatser"},"dct:identifier":"5699461a-602e-e472-8c17-f0f02d176e0d","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:8cf968ef55c9d67c42d626e5a8b1baf4888234ae869a2531dd6d5914b9ca423d_b0n0"},"dct:title":{"@language":"sv","@value":"Badvattenkvalitet"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:02b036bb-5645-4c2f-891d-ead11ac41e71","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://havbipub.havochvatten.se/analytics/saw.dll?PortalPages&PortalPath=%252Fshared%252FHemsidan%252FBadplats%252F_portal%252FBadplats"},"dct:description":{"@language":"sv","@value":"Här finns data gällande enskilda provtagningar av indikatorbakterier vid EU-bad och övriga bad, där provet nulägesbedömts som tjänligt, tjänligt med anmärkning eller otjänligt. Här finns även den historiska bedömningen klassificering av badvattenkvalitet, där fyra på varandra följande års badsäsongers nulägesbedömningar använts för att ge ett EU-bad eller ett övrigt bad en klassificering av badvattenkvaliteten. Klassificeringen bedöms som utmärkt, bra, tillfredsställande eller dålig."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data om badvattenkvalitet & nulägesbedömningar vid EU-bad & övriga bad"}},{"@id":"urn:uuid:8fd8bc4e-483b-d9f4-a052-56e669393348","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskap för badvattenkvalitet","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8cf968ef55c9d67c42d626e5a8b1baf4888234ae869a2531dd6d5914b9ca423d_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:badvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Datavärdskap för badvattenkvalitet"},{"@id":"urn:uuid:ec07a5a2-e0b0-01ea-765c-1f33d1d0b078","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://www.havochvatten.se/data-kartor-och-rapporter/data-och-statistik/data-och-apier/api-badplatser-och-badvatten.html"},"dct:description":{"@language":"sv","@value":"Detta API är till för dig som vill hämta information om badplatser och badvatten i Sverige. Detta API tillhandahåller dels myndighetens ’Öppna data om badvattenkvalitet & nulägesbedömningar vid EU-bad & övriga bad’ datamängd samt information om badvattentemperaturer i hav via det europeiska rymdprogrammet Copernicus. För frågor om datalicens gällande extern data hänvisar vi till den externa datamängdsägaren."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"API badplatser & badvatten"}}],"@id":"urn:source:8cf968ef55c9d67c42d626e5a8b1baf4888234ae869a2531dd6d5914b9ca423d"},{"@graph":[{"@id":"_:8d27cc1597e8be3b0d6b0a6ae3a0877a82488c4499f38a5fd99c48b4494b9b80_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:8d27cc1597e8be3b0d6b0a6ae3a0877a82488c4499f38a5fd99c48b4494b9b80_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/8fc4c4dc-1ced-4564-8992-e524c254a44f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:distribution":[{"@id":"urn:uuid:374d7a5a-ad62-9802-9d3f-d7205e198e44"},{"@id":"urn:uuid:9208875a-89c2-94eb-0abd-484a78d41711"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tillståndspliktiga miljöfarliga verksamheter. Denna datamängd innehåller punkter för anläggningar som innehåller avfallsdeponier.\n\nKälla: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfa