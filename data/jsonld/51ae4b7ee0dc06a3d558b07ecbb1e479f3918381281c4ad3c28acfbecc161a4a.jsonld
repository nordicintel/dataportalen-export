http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Miljövårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c5e498ff998493afd896fb4f55c619d9f9f727a34aa95e62fb02a39b0f6dde67_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Miljövårdsenheten"},{"@id":"urn:uuid:fc7a7029-ea41-ba67-a53b-ea32f02153ce","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.Lst_Tradinventering_Kungsbacka.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:c5e498ff998493afd896fb4f55c619d9f9f727a34aa95e62fb02a39b0f6dde67"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/f965e6b0-02e5-466a-a28e-3136ce9baf62","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/riksintressen-mineral"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"I visningstjänsten Riksintressen mineral återfinns områden som anses innehålla fyndigheter av riksintresse. Fyndigheterna på dessa platser består av ämnen och material, exempelvis natursten, industrimineral och metaller, vilka av SGU bedöms som viktiga. Bedömningen görs i enlighet med miljöbalken (3 kap. 7 § andra stycket). Det är SGU som ansvarar för att de berörda länsstyrelserna förses med information om vilka områden som bedöms utgöra riksintressen. \n\nPå kartan visas de områden som SGU bedömer vara av riksintresse. I nuläget omfattas cirka 150 områden och av dessa är cirka 100 detaljavgränsade medan de resterande har lägesbestämts med en centrumkoordinat, det vill säga har endast markerats med en punkt på kartan."},"dct:identifier":"f965e6b0-02e5-466a-a28e-3136ce9baf62","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Riksintressen, mineral (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:c624a6c9ca4d6ed0a02310976f71442d4f67a1bdcce0396c28152f57ee5ee00f"},{"@graph":[{"@id":"_:c6970d7adb9bcb31d4fa3d474541aa46752a4962958e40cbd6c872260aba24cc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Fastighetsregistret byggdes upp mellan 1970-1995 samtidigt som registerreformen genomfördes genom digitalisering av Jordregistret och Stadregistren."}},{"@id":"_:c6970d7adb9bcb31d4fa3d474541aa46752a4962958e40cbd6c872260aba24cc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8871b7d0-c572-46e2-a0b0-8255dfd2ac3f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:04eb121a-b8e4-fbf3-306a-7acd9e43c405"},{"@id":"urn:uuid:1be4a1eb-a047-0b4d-79c5-12c8337f6bea"},{"@id":"urn:uuid:35d9978c-e453-7354-4909-61b2afcfed82"},{"@id":"urn:uuid:45a4d473-c6dc-6f2e-074c-5b3570e8017a"},{"@id":"urn:uuid:4c252dcf-81e1-e3ab-35d8-c33b644bffc7"},{"@id":"urn:uuid:7260e98d-a3d8-d218-cf27-3233da9dfce8"},{"@id":"urn:uuid:86c6219b-5c6b-eaa6-33f5-701944ab3d8c"},{"@id":"urn:uuid:91631cf7-e87a-ccbb-0261-ef94df6e0937"},{"@id":"urn:uuid:b705d3f7-30ed-8f85-51df-aa9b402a22f1"},{"@id":"urn:uuid:bbed53fd-0f68-4e12-979d-79ae44119692"},{"@id":"urn:uuid:c9620e5a-ac93-80c4-9ef0-925c9ef14d74"},{"@id":"urn:uuid:f07edd03-2c44-d7d0-bdb3-90dabf2d031f"},{"@id":"urn:uuid:fba69bb3-eaa8-f8ac-938c-0bf939703c67"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"I fastighetsregistret igår information om fastigheter, samfälligheter, gemensamhetsanläggningar, rättigheter, taxering, belägenhetsadress, planer och markreglerande bestämmelser.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Belägenhetsadress Direkt, Fastighet och Samfällighet Direkt, Fastighetsinformation Nedladdning, Gemensamhetsanläggning Direkt, Inskrivning Direkt, Markreglerande bestämmelse Direkt, Markreglerande bestämmelse Visning, Referens Uppslag Adress, Referens Uppslag Organisation, Registerbeteckning Direkt, Rättighet Direkt, Rättighet Visning och Taxering Direkt."},"dct:identifier":"8871b7d0-c572-46e2-a0b0-8255dfd2ac3f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:c6970d7adb9bcb31d4fa3d474541aa46752a4962958e40cbd6c872260aba24cc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:c6970d7adb9bcb31d4fa3d474541aa46752a4962958e40cbd6c872260aba24cc_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för fastighetsregistret"}},{"@id":"urn:uuid:04eb121a-b8e4-fbf3-306a-7acd9e43c405","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/belagenhetsadress-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Belägenhetsadress Direkt"}},{"@id":"urn:uuid:1be4a1eb-a047-0b4d-79c5-12c8337f6bea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/taxering-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Taxering Direkt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Taxering Direkt."}},{"@id":"urn:uuid:35d9978c-e453-7354-4909-61b2afcfed82","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/rattighet-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Rättighet Direkt."},"dct:format":{"@id":"ht