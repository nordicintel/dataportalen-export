atement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Produkten baseras på nationella markhöjdmodellen i form av ett 1-meters grid. En heltäckande terrängmodell (DTM) i form av ett 1-meters grid skapas utifrån laserpunkter klassade som mark och vatten. Beräkningen sker genom linjär interpolering i ett TIN (Triangulated Irregular Network). Höjdvärden redovisas med två decimaler."}},{"@id":"_:df52051ac508f9aecedfcea5cc144e3958cce94c6be8e68defd9be9f378678d1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1b48584d-f6d6-43fb-a6fd-7610a33de491","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:497346e0-8271-40a2-5149-dad16d951ac1"},{"@id":"urn:uuid:657a4efd-c1dd-0ef0-7b7b-d5bde3c3717d"}],"dcat:keyword":{"@language":"sv","@value":"HV