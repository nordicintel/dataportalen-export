tvattenområden som ingår i Länsstyrelsens förteckning över musselvatten som skall skyddas enligt förordningen (SFS 2001:554) om miljökvalitetsnormer för fisk- och musselvatten. Områdena baseras på SMHI:s Havsområdesregister version 2007 (SVAR).\n\n.."},"dct:identifier":"54a5fb97-abd7-4c86-8108-bb56cd6f3896","dct:issued":{"@type":"xsd:date","@value":"2013-12-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:4e83bcbd602179a595f6f65bf3a5d110374dc251c480410dc21c67fa97bdc9c6_b0n0"},"dct:title":{"@language":"sv","@value":"SE.AM Musselvatten"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4e83bcbd602179a595f6f65bf3a5d110374dc251c480410dc21c67fa97bdc9c6_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"},{"@id":"urn:uuid:91ed3180-7460-aef4-9a66-6782d025da03","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_am/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}},{"@id":"urn:uuid:dfc88c9a-b6d9-d935-fddb-46705f6b09bd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/am_musselvatten.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}}],"@id":"urn:source:4e83bcbd602179a595f6f65bf3a5d110374dc251c480410dc21c67fa97bdc9c6"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/675a56b5-ac77-4eb0-980c-ecd4b0b7e462","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://api.lantmateriet.se/marktacke/atom/v1.1/inspire/lc"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst enligt Inspires dataspecifikation för temat Marktäcke (Land Cover). Område: Kommun Den tekniska lösningen på nedladdningsplatsen är ett så kallat Atomflöde."},"dct:identifier":"675a56b5-ac77-4eb0-980c-ecd4b0b7e462","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Marktäcke Nedladdning Inspire"},