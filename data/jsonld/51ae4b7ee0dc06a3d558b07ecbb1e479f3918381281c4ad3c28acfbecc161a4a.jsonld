value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d5a02753-c5b8-4965-b898-3766f1f002d6","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/samfallighetsforening-nedladdning"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten levererar information om samfällighetsföreningar, vägföreningar, vägsamfälligheter och föreningar bildade enligt lagen om vissa gemensamhetsanläggningar. Uttagen är en ögonblicksbild över hur informationen ser ut just vid uttagstillfället.\n\nProdukten går att beställa både som engångsuttag och abonnemang. Samtliga uttag är av typen basuttag.\nUrval görs på information, vilka informationsmängder som ska levereras, och bestånd, för vilka föreningar informationen ska levereras."},"dct:identifier":"d5a02753-c5b8-4965-b898-3766f1f002d6","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Samfällighetsförening Nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:8e51b67aa0bb81d668266b19a475f282d0b7a8089ade120d37013d33d548d08c"},{"@graph":[{"@id":"_:8e7041308615955f904c10935b13577507070b8a19bf6a8a08279419ae035b25_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.95283340485226 69.17730630757458,25.61388205941512 69.17730630757458,25.61388205941512 54.34726061945611,7.95283340485226 54.34726061945611,7.952