266c82d3fa928cf7ed00d7e6c8c7272e41690090dad25db9e1b6ed875bba0"},{"@graph":[{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.9745 69.0599,24.1776 69.0599,24.1776 59.8547,11.9745 59.8547,11.9745 69.0599))"}},{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.99758 69.05815,24.06578 69.05815,24.06578 61.56316,11.99758 61.56316,11.99758 69.05815))"}},{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/b665a528-cd25-4612-8ab3-fa3e692b46c3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":{"@id":"urn:uuid:6a5cf7c7-d89c-565d-ab79-b1ed0d219b5f"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Kärnområden är områden som utgör kraftcentrum inom samebyn. Sådana bör skyddas därför att de har en totalkvalitet som har avgörande betydelse för möjligheterna att varaktigt bedriva renskötsel inom samebyn.\n\nGränserna för riksintresseområden är inte absoluta, utan indikerar att värden eller egenskaper av högt allmänt intresse enligt Hushållningsbestämmelserna i 3 eller 4 kap. miljöbalken finns att ta hänsyn till"},"dct:identifier":"b665a528-cd25-4612-8ab3-fa3e692b46c3","dct:issued":{"@type":"xsd:date","@value":"2015-02-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b0n0"},{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b1n0"}],"dct:title":{"@language":"sv","@value":"ST Riksintresse Rennäringen - Kärnområde"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:6a5cf7c7-d89c-565d-ab79-b1ed0d219b5f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_ren.omr_riks.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:6ef45e55c09fe3be174e2c28486de25bc69a45676e11e995a3333a6c3dae366a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/2e93b618-4736-4efc-8335-12c152fcc57e","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www,sjofartsverket.se"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visningstjänst för inspiretemat TN Sjötransportnätet."},"dct:identifier":"2e93b618-4736-4efc-8335-12c152fcc57e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"TN.Water.Watertransportnetwork.View"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:704f2c640aaaca039b8ddeab0e88037444619bc794170f62f0b6595b56f22bbf"},{"@graph":[{"@id":"_:71ea1c012a85c0975c0729af0750fbb29406ddc247a12569e30dac42a7e7b72a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtagen enligt förordning (2009:956) om översvämningsrisker 2018"}},{"@id":"_:71ea1c012a85c0975c0729af0750fbb29406ddc247a12569e30dac42a7e7b72a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"https://www.geodata.se/resources/b066ec12-da75-44fc-8354-446f19263655","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0a6f68e2-f162-93e0-52c4-7076d7ad3ffc"},{"@id":"urn:uuid:4b3dd0cb-29a4-101a-e4c3-992aa645e828"},{"@id":"urn:uuid:6ffbf550-07ea-722e-69ac-d1a2d5b6eac2"},{"@id":"urn:uuid:981e5ba3-9063-beed-8c3a-dd857ebecc97"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Utbredningsskikt för klimatanpassat 100-års flödet/nivån i slutet av seklet motsvarande hotkartor/riskkartor för de områden med betydande översvämningsrisk enligt förordningen om översvämningsrisker (SFS 2009:956) 2018. För vattendrag finns endast utbredningsskikt för ett avgränsat område och inte hela vattendraget. Om ett område identifierats utifrån hav och det i området också finns ett vattendrag eller en sjö så finns även hotkartor/riskkartor framtagna för dessa. Datamängden är ett resultat av revideringen av steg 2 för cykel 2 (2019) inom översvämningsdirektivet men även för steg 2 i cykel 1 (2013) finns även med i datamängden och där ingick inte översvämningar från havet som de gör i revideringen av steg 2 för cykel 2 (2019).\n\nFör vattendrag har en 2 dimensionell hydraulisk modell använts för att ta fram utbredningen. För havet, Vänern, Vättern och Mälaren har en analys av höjd använts. Vilken cykel respektive hotkarta/riskkarta är i från framgår i attributtabellen.\n\nMer information om förordningen om översvämningsrisker finns på: https://www.msb.se/sv/amnesomraden/skydd-mot-olyckor-och-farliga-amnen/naturolyckor-och-klimat/oversvamning/oversvamningsforordningens-tre-steg/"},"dct:identifier":"b066ec12-da75-44fc-8354-446f19263655","dct:issued":{"@type":"xsd:date","@value":"2019-09-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-12"},"dct:provenance":{"@id":"_:71ea1c012a85c0975c0729af0750fbb29406ddc247a12569e30dac42a7e7b72a_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:71ea1c012a85c0975c0729af0750fbb29406ddc247a12569e30dac42a7e7b72a_b1n0"},"dct:title":{"@language":"sv","@value":"Hot- och riskkartor, utbredning 100-års flöde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:0a6f68e2-f162-93e0-52c4-7076d7ad3ffc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/hotochrisk100/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst hot och risk 100 årsflöde OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:4b3dd0cb-29a4-101a-e4c3-992aa645e828","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/MSB_TopAtomFeed_HotRisk100.xml"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, 100-års flöde i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:6ffbf550-07ea-722e-69ac-d1a2d5b6eac2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/filer/shape/HotRisk100.zip"},"dct:description":{"@language":"sv","@value":"Sida för nedladdning av utbredningsområden för hot- och riskkartor, 100-års flöde i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:981e5ba3-9063-beed-8c3a-dd857ebecc97","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/hotochrisk100/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Sida för visningstjänst av utbredningsområden för hot- och riskkartor, 100-års flöde"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:71ea1c012a85c0975c0729af0750fbb29406ddc247a12569e30dac42a7e7b72a"},{"@graph":[{"@id":"_:734a33997f10dc3c99ef1d960659d243a17b280d38ef911370bb555860dcd218_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},"dct:description":{"@language":"sv","@value":"Inspireanpassad nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:734a33997f10dc3c99ef1d960659d243a17b280d38ef911370bb555860dcd218_b0n0"},"dct:title":{"@language":"sv","@value":"Inspireanpassad nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/a4530722-7f80-4b5e-8106-7e76abc0d77c","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänsten levererar alla parametrar som ingår i det första tidssteget i prognosmodellen (nulägesbeskrivningen) dygnsvis."},"dct:identifier":"a4530722-7f80-4b5e-8106-7e76abc0d77c","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografisk prognosmodell, HIROMB BS01 - Historiska analysdata: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:734a33997f10dc3c99ef1d960659d243a17b280d38ef911370bb555860dcd218"},{"@graph":[{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SCB har tidigare, för 2010, publicerat geografiskt avgränsade handelsområden med tillhörande statistik. Sedan den publiceringen har dock statistiken genomgått omfattande förändringar i fråga om definition av handelsområden och metod för att skapa handelsområdenas geografiska gränser. Bland annat är metoden från och med 2015 års handelsområden helt automatiserad, till skillnad från 2010 års handelsområden, som till stor del producerades med manuella justeringar av de geografiska gränserna. Handelsområdena från och med 2015 har dessutom tydligare fokus på detaljhandeln, då endast arbetsställen med SNI-kod 47 Detaljhandel ingår, medan 2010 års handelsområden även omfattade exempelvis restauranger och personbilshandel. Statistik och avgränsningar för 2015 är därför inte jämförbara med 2010 års handelsområden."}},{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2020"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2015"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d6169d03-5dfc-4de0-a7f5-14b9eaba0cf3","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:5fd72fb7-b58f-9262-9172-c151dc92d16a"},{"@id":"urn:uuid:6cc1362c-29bd-9bb7-2505-fd6b43c1ab13"},{"@id":"urn:uuid:b92dd6b6-4577-79ac-288c-1fe3e21db970"},{"@id":"urn:uuid:f0f2e154-39d8-3d41-633a-a49292391383"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Handelsområden är koncentrationer av arbetsställen i SCB:s företagsdatabas med SNI 47 Detaljhandel, vilka tillsammans bildar ett geografiskt avgränsat område, bestående av: \n1. minst fem detaljhandelsföretag, eller\n2. fyra detaljhandelsföretag, vilka tillsammans har minst 100 anställda.\n\nSyftet med handelsområdena är att ge en både översiktlig och heltäckande bild av detaljhandeln i Sverige, avseende geografisk lokalisering, antal handelsområden, antal anställda inom handelsområdena och hur mycket mark de tar i anspråk.\n\nHandelsområden redovisas som ytor.\n\nHandelsområden kan överlappa andra typer av områdesavgränsningar från SCB, som tätorter och småorter. Handelsområden utgör ett komplement till datamängden verksamhetsområden. Dessa två områdestyper kan överlappa varandra geografiskt. Handelsområden publiceras från och med 2015 vart femte år."},"dct:identifier":"d6169d03-5dfc-4de0-a7f5-14b9eaba0cf3","dct:issued":{"@type":"xsd:date","@value":"2022-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-18"},"dct:provenance":{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b1n0"},"dct:temporal":{"@id":"_:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd_b2n0"},"dct:title":{"@language":"sv","@value":"Handelsområden"}},{"@id":"urn:uuid:5fd72fb7-b58f-9262-9172-c151dc92d16a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/mi0815"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktspecifikation"}},{"@id":"urn:uuid:6cc1362c-29bd-9bb7-2505-fd6b43c1ab13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/statistiska-handelsomraden/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för handelsområden"}},{"@id":"urn:uuid:b92dd6b6-4577-79ac-288c-1fe3e21db970","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Handelsområden WFS"}},{"@id":"urn:uuid:f0f2e154-39d8-3d41-633a-a49292391383","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Handelsområden WMS"}}],"@id":"urn:source:74599489d4f5334c19b59d8129bd50b447e20b0d6b8685f707d07a6162d4b8bd"},{"@graph":[{"@id":"_:74e8829a6810b7689d8a25f7d451b01020d84e896c9fa417f9ee49cb04b091dc_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/eac3ecfe-9c80-b086-521b-3b52518e71a4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218"},"dcat:distribution":[{"@id":"urn:uuid:1b37fa8e-3640-d518-5b49-a5af4f7011f2"},{"@id":"urn:uuid:35fe3661-9abb-9e87-e173-33f6ce42f186"},{"@id":"urn:uuid:b5958e4e-26e9-8ca3-9f9e-fa63feddbd62"},{"@id":"urn:uuid:deb48931-1350-503f-5eb1-61ee75c50802"},{"@id":"urn:uuid:e09b2a5a-7762-f554-f775-fcb9b2ee4b3c"},{"@id":"urn:uuid:e84d7a7c-440b-c706-d47a-7c89f7fc9d96"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En havsplan ger vägledning om användning för de områden som omfattas av havsplanen. Sverige har tre havsplaner: Bottniska viken, Östersjön och Västerhavet. Dessa beslutades av regeringen den 10 februari 2022. Plankartan ska tolkas i den ungefärliga skalan mellan 1:700 000 och 1:1 000 000.\nPå ingångssidan finns mer information om havsplanering och en webbkarta som visar plankarta samt planeringsförutsättningar."},"dct:identifier":"eac3ecfe-9c80-b086-521b-3b52518e71a4","dct:issued":{"@type":"xsd:date","@value":"2022-02-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Havsplaner för Bottniska viken, Östersjön och Västerhavet. 2022"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1b37fa8e-3640-d518-5b49-a5af4f7011f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.5a0266c017f99791d0e68c2b/1655131290482/havsplaner-beslutade-2022.pdf"},"dct:description":{"@language":"sv","@value":"Formellt beslutsdokument"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plandokument: Havsplaner för Bottniska viken, Östersjön och Västerhavet, 2022"}},{"@id":"urn:uuid:35fe3661-9abb-9e87-e173-33f6ce42f186","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsplaner-2022/ows"},"dct:description":{"@language":"sv","@value":"Karttjänst (Web Map Service) för havsplaner"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta WMS"}},{"@id":"urn:uuid:9e124da0-8d44-601a-db3a-45ededadd218","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsplaneringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:74e8829a6810b7689d8a25f7d451b01020d84e896c9fa417f9ee49cb04b091dc_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsplaneringsenheten"},{"@id":"urn:uuid:b5958e4e-26e9-8ca3-9f9e-fa63feddbd62","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/Datadokumentation_Havsplaner_2022.pdf"},"dct:description":{"@language":"sv","@value":"Stöddokumentation som beskriver innehåll och struktur i de geografiska datafilerna"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Geodatadokumentation för plankarta"}},{"@id":"urn:uuid:deb48931-1350-503f-5eb1-61ee75c50802","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/havsplaner-2022-02-10-gpkg.zip"},"dct:description":{"@language":"sv","@value":"Plankarta i Geopackage-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta Geopackage"}},{"@id":"urn:uuid:e09b2a5a-7762-f554-f775-fcb9b2ee4b3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://geodata.havochvatten.se/geoservices/havsplaner-2022/ows"},"dct:description":{"@language":"sv","@value":"Karttjänst (Web Feature Service) för havsplaner"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta WFS"}},{"@id":"urn:uuid:e84d7a7c-440b-c706-d47a-7c89f7fc9d96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsplaner-2022/2022-02-10/havsplaner-2022-02-10-shape.zip"},"dct:description":{"@language":"sv","@value":"Plankarta i Shapefil-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Plankarta Shape"}}],"@id":"urn:source:74e8829a6810b7689d8a25f7d451b01020d84e896c9fa417f9ee49cb04b091dc"},{"@graph":[{"@id":"_:75350dcb6b6f28ffbc1df5525790d22dd70063938ceca5810cd0e9cb456f92c2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Häradsekonomiska kartan (1859–1934) baserades på laga skifteskartor och beskriver markanvändning, vegetation, bebyggelse, kommunikationer och gränser.\n\nLantmäteriet har gjort geografiska kartor sedan 1600-talet och dessa kan idag hittas i Lantmäteristyrelsens arkiv som \"Läns- och häradskartor\" eller som sockenkartor.\n\nEn föregångare till Häradsekonomiska kartan var de kartor som producerades i samband med Sockenkarteverket. Produktionen av dessa kartor upphörde i praktiken när Rikets ekonomiska kartverk bildades år 1859. \n\nKartorna från laga skiftet sammanställdes till sockenkartor i skala 1:20 000. Liksom sockenkartorna baserades Häradsekonomiska kartorna på laga skifteskartor och ger en bra överblick över markanvändning, vegetation, bebyggelse, kommunikationer och gränser. Till kartorna hör böcker med ekonomisk-statistisk beskrivning för varje län.\n\nHäradsekonomiska kartan trycktes i färg i skalorna 1:20 000 eller 1:50 000 och fick efterhand en standardiserad bladindelning. Den täcker dock inte hela Sverige utan bara delar av Götaland och Svealand (helt i 13 län). Det finns också underlagskartor (stom-konceptversioner) för några fler län i skala 1:20 000. Dessa finns tillgängliga digitalt via e-tjänsten Historiska kartor."}},{"@id":"_:75350dcb6b6f28ffbc1df5525790d22dd70063938ceca5810cd0e9cb456f92c2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:75350dcb6b6f28ffbc1df5525790d22dd70063938ceca5810cd0e9cb456f92c2_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1934"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1859"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/39daa8d5-611a-42b6-a5da-ebc2a549b96e","@type":"dcat:Dataset","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Häradsekonomiska kartan (1859–1934) baserades på laga skifteskartor och beskriver markanvändning, vegetation, bebyggelse, kommunikationer och gränser."},"dct:identifier":"39daa8d5-611a-42b6-a5da-ebc2a549b96e","dct:issued":{"@type":"xsd:date","@value":"1859-01-01"},"dct:language":{"@