d":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:caed9d60c0b79f84410f4ddd62f877b5500f5bd5531b0943bedbdb500530a368_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:4eb7602b-208c-a2d4-33a1-56d8e14812f8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.5a0c1a2c18fa6d6097b797e9/1717148852317/dataunderlag-till-diagram-diagram-forsurning-1996-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Tillståndsklasser i grundvatten- försurning"}}],"@id":"urn:source:caed9d60c0b79f84410f4ddd62f877b5500f5bd5531b0943bedbdb500530a368"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/e4dda033-43f8-4f55-b78a-d28639bb843a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://share.scb.se/OV0105/Xml/US/us_administrativaochsocialaoffentligatjanster_forskolor_atom_nt.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Förskolornas geografiska punkt tas fram med hjälp av det Allmänna företagsregistret samt Geografidatabasen. Branschkoden som används är SNI 85100 (Förskola). Geografisk information är belägenhetsadress på arbetsställe.\n\nGeokodade förskolor uppdateras en gång om året och källan är frysning av årsstatistik som är baserad på SAMU ramar (avser november). Årsregistret skapas i december."},"dct:identifier":"e4dda033-43f8-4f55-b78a-d28639bb843a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"US.AdministrativaOchSocialaOffentligaTjänster.Förskolor.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:cb337f793f418ad1fea2df562b7a043ef6142f643805a8f11e3545acb0f7d614"},{"@graph":[{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Miljöhälsoenkäten är en urvalsundersökning bland befolkningen 18-84 år. Värden presenteras på länsnivå."}},{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2015"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2015"}},{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sv","http://www.w3.org/2006/vcard/ns#locality":"Östersund","http://www.w3.org/2006/vcard/ns#postal-code":"83140","http://www.w3.org/2006/vcard/ns#street-address":"Forskarens väg 3"},{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-2052959"}},{"@id":"http://dataportal.se/organisation/SE2021006545","@type":"foaf:Agent","dct:identifier":"2021006545","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@folkhalsomyndigheten.se"},"foaf:name":{"@language":"sv","@value":"Folkhälsomyndigheten"},"foaf:page":{"@id":"https://www.folkhalsomyndigheten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://free.entryscape.com/store/360/resource/1"}},{"@id":"https://www.geodata.se/resources/6d35a2fa-20d4-48e8-9747-351cfe10d3df","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:88426ed8-0ad2-e045-1e73-0e46d3d327ed"},"dcat:distribution":[{"@id":"urn:uuid:487d1e6f-f4cd-bbd5-d1c2-e7697df3ebeb"},{"@id":"urn:uuid:8e90b977-807e-8fa0-ba58-ffa4f8767701"},{"@id":"urn:uuid:f1a70451-da82-3ac2-57a2-9fb230ba90c0"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Andel personer som dagligen utsätts för andras tobakrök utomhus. I Utomhus ingår uteserveringar, hållplatser, entréer. Data presenteras på länsnivå."},"dct:identifier":"6d35a2fa-20d4-48e8-9747-351cfe10d3df","dct:issued":{"@type":"xsd:date","@value":"2100-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2100-01-01"},"dct:provenance":{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006545"},"dct:spatial":{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b1n0"},"dct:temporal":{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b2n0"},"dct:title":{"@language":"sv","@value":"Exponerad för miljötobaksrök utomhus"}},{"@id":"urn:uuid:487d1e6f-f4cd-bbd5-d1c2-e7697df3ebeb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geonode.folkhalsomyndigheten.se/layers/my_geonode_data:geonode:ExpoMiljotobak_LANKarta_region"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Geonode - FOHM"}},{"@id":"urn:uuid:88426ed8-0ad2-e045-1e73-0e46d3d327ed","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Folkhälsomyndigheten FhS","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:folkhalsostudio@folkhalsomyndigheten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Folkhälsomyndigheten"},{"@id":"urn:uuid:8e90b977-807e-8fa0-ba58-ffa4f8767701","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://app.statisticsstudio.com/public/player?type=appref&id=32a2ceb0-8ab9-401e-a7bd-902abd9af2ad"},"dct:description":{"@language":"sv","@value":"Folkhälsomyndigheten - FolkhälsoStudio"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Folkhälsostudio"}},{"@id":"urn:uuid:f1a70451-da82-3ac2-57a2-9fb230ba90c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geonode.folkhalsomyndigheten.se/geoserver/ows?service=WFS&version=1.0.0&request=GetFeature&typename=geonode%253AExpoMiljotobak_LANKarta_region&outputFormat=SHAPE-ZIP&srs=EPSG%253A3006&format_options=charset%253AUTF-8"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Geonode - FOHM"}}],"@id":"urn:source:cc9086fa9269f7ee09f4b720452faba64060610948c6dcbf21fe2dc4f9c96fc6"},{"@graph":[{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Grundläggande data för Skånes kust har samlats in i SGU:s projekt Skånestrand under åren 2012–2014. Analys, sammanställning och utveckling av de olika metoderna för att visa erosionsförhållanden har skett i samma projekt 2015 (Malmberg m.fl. 2014, 2016). Mindre revideringar har utförts under 2016 och 2017.\nKusten längs Sölvesborgs kommun, Blekinge, kartlades 2015–2016 i SGU:s projekt Uppgradering, jord. Analys och sammanställning av erosionsförhållanden och erosionskänslighet gjordes i samma projekt 2018.\nKusten längs Halland, från Skånegränsen till Varberg, kartlades 2018 i SGU:s projekt Halland strand, vilket delfinansierats av Staten geotekniska institut (SGI). Analys och sammanställning av erosionsförhållanden och erosionskänslighet gjordes i samma projekt 2019. Metodik och resultat redovisas i Malmberg m.fl. (2019). Inga nya maringeologiska undersökningar gjordes i detta projekt vilket gör att tillförlitligheten i bedömningarna av erosionskänslighet längs denna kuststräcka är lägre än för övriga stränder.\nI samband med projektet ”Klimatanpassningsåtgärder i kustzonen”, år 2020, tillkom:\n•\ten inrapportering och klassificering av befintliga erosions- och översvämningsåtgärder kända av kustkommuner och myndigheter längs Hallands och Skånes kuster\n•\tdynfotens förändring i läge mellan 2007 och 2018 i Skåne\n•\tstrandmaterial med dynamik i Skåne\n•\tbottenmaterial med dynamik i Skåne\n•\tSkånekustens översiktliga indelning i sedimentsystem \n•\tkustparallell riktning och storlek på sedimenttransport modellerad med vågmodellen SWAN för tidsperioden 1979 till 2020 i Halland och Skåne\n\nMetodik och resultat redovisas i Nyberg m.fl. (2020 och 2021).\n\nÖlands stränder kartlades och analyserades med avseende på erosionsförhållanden 2023 i ett projekt finansierat av SMHI (Myndighetsnätverket för klimatanpassning) och SGI. Här gjordes inte heller några maringeologiska undersökningar så bedömningarna har liknande noggrannhet som i Halland.\n\nVästra och norra Gotlands stränder kartlades och analyserades med avseende på erosionsförhållanden 2024 i ett projekt finansierat av SMHI (Myndighetsnätverket för klimatanpassning) och SGI. Inte heller här gjordes några maringeologiska undersökningar så bedömningarna har liknande noggrannhet som i Halland och på Öland."}},{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.7436 57.5301,17.3653 57.5301,17.3653 55.2183,11.7436 55.2183,11.7436 57.5301))"}},{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2012"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/64627395-1100-4a05-9ea7-c391d1f760ff","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:34d5dee1-3727-ee7d-ae39-eeb16bd7ba85"},{"@id":"urn:uuid:3a8d31f1-1d0d-a813-ca5d-c46b8c68cd78"},{"@id":"urn:uuid:bb6044c6-e6ce-4735-9bce-8d0708b43d1d"},{"@id":"urn:uuid:ceefd043-f528-4fca-3c5f-78636bd0d5be"},{"@id":"urn:uuid:dfb79137-6a8e-64cf-e79e-3e7c43cb2f68"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Informationen utgör ett underlag för att belysa strandlinjens ändringar pga. erosion och deposition av sediment längs stränderna."},{"@language":"sv","@value":"Produkten innehåller information om erosionsförhållanden längs Sydsveriges havsstränder. Baserat på detaljerad kartläggning av stränder och havsbotten runt kusten har erosionsförhållanden och erosionskänslighet bedömts och beräknats med två olika metoder. Metodik och resultat redovisas i Malmberg m.fl. (2014 och 2016).\n\nEn indelning har gjorts i olika strandtyper efter strändernas geologi, topografi och sedimentdynamik. De olika strandtyperna karaktäriseras av olika erosionsförhållanden beroende på om stränderna främst präglas av pålagring, erosion eller huvudsakligen är i balans samt hur snabbt erosionen sker. Dessutom visas en prognos för vilka erosionsförhållanden man kan förvänta sig i framtiden vid en havsnivåhöjning på ca 1 m.\n\nSträndernas känslighet för erosion visas med ett beräknat erosionsindex, baserat på en analys av jordarter på stränder och havsbotten, marklutning, erosionsprocesser och sedimentbudget på stränder och havsbotten samt vind- och vågexponering (Malmberg m.fl. 2016). \n\nI samband med fältinsamlingen har hårda erosionsskydd inventerats och sträckor med aktiv erosion kartlagts."}],"dct:identifier":"64627395-1100-4a05-9ea7-c391d1f760ff","dct:issued":{"@type":"xsd:date","@value":"2016-06-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-30"},"dct:provenance":{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b1n0"},"dct:temporal":{"@id":"_:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6_b2n0"},"dct:title":{"@language":"sv","@value":"Stranderosion, kust"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:34d5dee1-3727-ee7d-ae39-eeb16bd7ba85","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/stranderosion-kust-v2?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:3a8d31f1-1d0d-a813-ca5d-c46b8c68cd78","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/stranderosion-kust/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:bb6044c6-e6ce-4735-9bce-8d0708b43d1d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/stranderosion-kust-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:ceefd043-f528-4fca-3c5f-78636bd0d5be","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-skanestrand.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:dfb79137-6a8e-64cf-e79e-3e7c43cb2f68","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/stranderosion-kust/stranderosion-kust.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:ccb86efd4378dc469e52ee44686a0042a2ae150a87669bc8c36bb3c7d99ad4f6"},{"@graph":[{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59207701286 69.059970495251,24.177674044859 69.059970495251,24.177674044859 55.137212557872,10.59207701286 55.137212557872,10.59207701286 69.059970495251))"}},{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/22f4326a-afe1-410c-9325-8468bbe0f453","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0"},"dcat:distribution":[{"@id":"urn:uuid:1622e648-0a6d-4644-6e90-9e2a27906ae9"},{"@id":"urn:uuid:644c23d3-f200-83e9-978d-8acaecce2eae"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Vandringshinder i vatten. Baserat på data i Nationella Biotopkarteringsdatabasen. Omfattar data från genomförda biotop- eller vandringshinderkarteringar.\nObservera att skiktet är samma skikt som används i databasens karttjänst, och innehåller därmed inte all information som finns i protokollen.\n\nKoordinater för protokollen ligger inlagda som punktobjekt. Varje vandringshinder representeras av en punkt.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till objektets mest aktuella protokoll i databasen.\n\nUppgifter om objekt som kan utgöra vandringshinder för vattenlevande organismer. Exempel på objekt är dammar, vägpassager, fiskgaller etc. Omfattar både naturliga och artificiella vandringshinder. Data kan användas för åtgärdsplanering, bedömning av kontinuitet, forskning m m.\n\nObservera att alla läns data ej är inlagd ännu. Komplettering pågår.\n\nKoordinater är Sweref 99 TM."},"dct:identifier":"22f4326a-afe1-410c-9325-8468bbe0f453","dct:issued":{"@type":"xsd:date","@value":"2021-04-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b0n0"},{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Vandringshinder - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:1622e648-0a6d-4644-6e90-9e2a27906ae9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.Biotop_Vandringshinder.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:644c23d3-f200-83e9-978d-8acaecce2eae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:838ea933-75b4-eddc-a685-121f714ea9f0","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ccde48ec058dddf4e1314620629c2dc21853706420db81124862cc35b50a71d7_b2n0"},"http://www.w3.org/2006/vcard/