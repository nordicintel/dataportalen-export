cb0b26932ebd318c191099fd87d95ef22d119ddd9be2_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Hav Substrat"}},{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Miljö- och vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5b94d5119470bbc46494cb0b26932ebd318c191099fd87d95ef22d119ddd9be2_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Miljö- och vattenenheten"},{"@id":"urn:uuid:ffc8e327-7054-f334-4a36-2a4071ad4692","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.Hav_TG_GIS_Substrat.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:5b94d5119470bbc46494cb0b26932ebd318c191099fd87d95ef22d119ddd9be2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/194bad55-b90b-473e-be13-c0329e8aa451","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://mapsext.sgi.se/geoserver/wms?request=GetCapabilities&service=WMS&layers=lagergrupp_sgi_skane_halland_ksi"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Kustsårbarhetsindex är tänkt att användas när kommunerna arbetar med olika former av samhällsplanering, t ex för att identifiera sårbara områden i kommunen som behöver åtgärdas i framtiden. Länsstyrelser och andra myndigheter kan också använda kartorna vid granskning och uppföljning.\nKustsårbarhetsindex bygger på vilka förutsättningar som finns längs kusten och som kan påverka erosion, vilka krafter som verkar mot kusten och vilka samhällsvärden som är hotade.\n\nSkåne är särskilt drabbat, många skånska kustkommuner utsätts redan i dag för stranderosion. Efter Skåne kommer verktyg att tas fram på liknande sätt för andra län, bland annat Halland, Blekinge, östra Småland, Öland och Gotland.\nKustsårbarhetsindex är utvecklat i samarbete med SGU. \n\nKontakt i stranderosionsfrågor: Per Danielsson, nationellt ansvarig för stranderosion på SGI.\n\nhttp://www.sgi.se/sv/samhallsplanering--sakerhet/stranderosionskartering/"},"dct:identifier":"194bad55-b90b-473e-be13-c0329e8aa451","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Kustsårbarhetsindex.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:5c7dc8d04bfe7f3b7ea8797c648703a54ab65f21b3145c054b3c2f259cd2ccfd"},{"@graph":[{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"koordinaterna för anläggningarna är tagna utefter sjukhusens läge på hitta.se. Ursprungsvärden angivna i RT90 avrundat till närmast jämna 100-tal meter. t.ex. 6593700, 1613300, sedan transformerat till SWEREF99TM via lantmäteriets koordinattransformator."}},{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2001"}},{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/8f5000b7-016f-45fc-847d-81a754d77543","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:7de45b85-330d-7740-72be-5ac68890e714"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har sedan 2001 provtagit blandad kost, i form av ett hopslaget prov av all föda som serveras en patient på ett sjukhus under ett dygn. I nuvarande program provtas kost från 3 sjukhuskök 2 gånger per år vilken mäts avseende cesium-137 och strontium-90.  Halter i blandad kost rapporteras även till EU i enlighet med Euratomfördraget. Data fr o m 2001 för dessa mätningar finns tillgängliga på begäran från Strålsäkerhetsmyndigheten. Kartan visar provtagningsstationernas (sjukhusens) geografiska läge."},"dct:identifier":"8f5000b7-016f-45fc-847d-81a754d77543","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b1n0"},"dct:temporal":{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: radioaktiva ämnen i blandad kost"}},{"@id":"urn:uuid:7de45b85-330d-7740-72be-5ac68890e714","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"}],"@id":"urn:source:5d01d34fd9d3209ad390694d77661a340b30cafe915030e2086f691d831b127a"},{"@graph":[{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Länsstyrelsen."}},{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((15.986540801503 60.750293967738,19.154925617554 60.750293967738,19.154925617554 57.124835066666,15.986540801503 57.124835066666,15.986540801503 60.750293967738))"}},{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((16.56022 60.44874,18.26568 60.44874,18.26568 57.3944,16.56022 57.3944,16.56022 60.44874))"}},{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/7c1bbbcf-bfea-4a72-b71d-4d380f2f8095","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:a2c24d64-236f-7041-91ee-4969f78d77c3"},"dcat:distribution":[{"@id":"urn:uuid:6188c02e-f5f4-2971-c26d-08393c19a777"},{"@id":"urn:uuid:7bca3acb-17dc-0f7e-4239-3c1e699ac39d"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Område av riksintresse för slutförvaring av radioaktivt avfall från kärnkraftverk.\n\n\nGränserna för riksintresseområden är inte absoluta, utan indikerar att värden eller egenskaper av högt allmänt intresse enligt Hushållningsbestämmelserna i 3 och 4 kap. miljöbalken finns att ta hänsyn till."},"dct:identifier":"7c1bbbcf-bfea-4a72-b71d-4d380f2f8095","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-01-16"},"dct:provenance":{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b1n0"},{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b2n0"}],"dct:title":{"@language":"sv","@value":"LST Riksintresse Slutförvaring"}},{"@id":"urn:uuid:6188c02e-f5f4-2971-c26d-08393c19a777","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.Riks_slutforvaring.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:7bca3acb-17dc-0f7e-4239-3c1e699ac39d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_LST.Riks_slutforvaring.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:a2c24d64-236f-7041-91ee-4969f78d77c3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST Planeringskatalogens nationella redaktion","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:planeringskatalogen@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST Planeringskatalogens nationella redaktion"}],"@id":"urn:source:5d54aef54ab86d9d4095348215ace3b7b5fdb710b123d140d8d03bfe5da07542"},{"@graph":[{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"DeSO följer läns- och kommungränserna och tar i största möjliga mån hänsyn till geografiska förutsättningar såsom vattendrag och gator. Vid skapandet av den första versionen 2018 skapades det runt tätorter med fler än 1000 invånare en buffer på 200 meter, dessa befolkningskoncentrationer ligger till grund för kategoriseringen av respektive område. Förutom tätortsavgränsningen var valdistriktsindelningen en viktig del vid skapandet av DeSO version 2018."}},{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2018"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/b5892392-6ab5-4b2e-ab8f-2acb83f9bfa8","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:07f68f85-18fb-4da8-f97e-279618a553f2"},{"@id":"urn:uuid:17d7f42f-a723-924c-f43a-a5ae25bce16e"},{"@id":"urn:uuid:365f16d2-46aa-0cd1-1557-b1b18e3c8917"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Demografiska statistikområden (DeSO) är en rikstäckande indelning skapad av SCB som började gälla i januari 2018. En ny DeSO -version publicerades 2025.\n\nDeSO delar in Sverige i 6 160 områden där de flesta områden har en befolkning mellan 700 och 3 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering.\n\nDeSO har inte benämningar eller namn utan beskrivs med en kod med nio unika positioner. De första fyra består av läns- och kommunkoden och pekar ut det län och den kommun som området ligger i. \n\nDen femte positionen pekar ut vilken kategori som området tillhör A, B eller C. A är områden som till största del ligger utanför större befolkningskoncentrationer eller tätorter.  B är områden som till större delen ligger i befolkningskoncentrationer eller tätorter men som inte är en centralort. Kategori C är de områden som till större delen finns i kommunens centralort. \n\nDe tre efterföljande positionerna består av ett löpnummer som sorterar områdena geografiskt. Den här sorteringen utgår ifrån kategorierna och börjar i söder och fortsätter norröver. Den sista positionen är en reservplats som kommer användas i fall ett DeSO i framtiden behöver splittras. Ett DeSO kan bara förekomma på en plats."},"dct:identifier":"b5892392-6ab5-4b2e-ab8f-2acb83f9bfa8","dct:issued":{"@type":"xsd:date","@value":"2018-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-28"},"dct:provenance":{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b1n0"},"dct:temporal":{"@id":"_:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0_b2n0"},"dct:title":{"@language":"sv","@value":"Demografiska statistikområden - DeSO"}},{"@id":"urn:uuid:07f68f85-18fb-4da8-f97e-279618a553f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/regional-statistik-och-kartor/regionala-indelningar/demografiska-statistikomraden-deso/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Demografiska statistikområden - DeSO"}},{"@id":"urn:uuid:17d7f42f-a723-924c-f43a-a5ae25bce16e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"DeSO"},"dct:title":{"@language":"sv","@value":"DeSO"}},{"@id":"urn:uuid:365f16d2-46aa-0cd1-1557-b1b18e3c8917","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"DeSO WFS"}}],"@id":"urn:source:5e8c3be764cc00a22a67c7d187db162ee613f9273c164bbd293dcfcde6acbbc0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/425d638a-67d5-48bd-9842-3a014996aba8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Verksamhetsområden är geografiska områdesavgränsningar som redovisas med uppgifter om antal anställda, antal arbetsställen, största bransch (på avdelningsnivå enligt SNI 2007) och areal. \n\nEtt verksamhetsområde kan bestå antingen av en koncentration av flera arbetsställen, som tillsammans bildar ett geografiskt avgränsat område, eller ett område som karaktäriseras av storskalig och industriellt präglad markanvändning och har minst ett arbetsställe. Ett verksamhetsområde är minst 3 hektar stort. \n\nExempel på verksamhetsområden är flygplatser, gruvor och täkter, områden med industri, handel, företagsparker, tekniska anläggningar och logistik eller områden med högskolor, universitet och vårdinrättningar. Verksamhetsområden utgör ett komplement till datamängden handelsområden. Dessa två områdestyper kan överlappa varandra geografiskt.\n\nVerksamhetsområden kan överlappa andra typer av områdesavgränsningar från SCB, som tätorter och småorter. Verksamhetsområden publiceras från och med 2015 vart femte år. Verksamhetsområden ersätter den tidigare datamängden arbetsplatsområden utanför tätort, som togs fram för åren 2005 och 2010."},"dct:identifier":"425d638a-67d5-48bd-9842-3a014996aba8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Verksamhetsområden WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:5f03b4e45bc505d379065aaeaf6d96569803489d366469e5a41e0b1778cb29b1"},{"@graph":[{"@id":"_:5f05f0651c786c7179fd1412ddb19994772cffbc65df40ffc12d1866d90c9b26_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59207701286 69.059970495251,24.177674044859 69.059970495251,24.177674044859 55.137212557872,10.59207701286 55.137212557872,10.59207701286 69.059970495251))"}},{"@id":"_:5f05f0651c786c7179fd1412ddb19994772cffbc65df40ffc12d1866d90c9b26_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/2a6738c5-f7a6-413b-8612-e1f4c21f2955","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b"},"dcat:distribution":[{"@id":"urn:uuid:e9255264-5a3b-7562-4c0c-0a0c51901e0a"},{"@id":"urn:uuid:fe5a069d-0698-262c-4d00-d088aa718352"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Länsstyrelsernas publika datamängd för eldningsförbud enligt Lag (2003:778) om skydd mot olyckor. En länsstyrelse eller en kommun kan besluta att införa och att häva ett eldningsförbud i skog och mark. Syftet med eldningsförbudet är att förebygga skogsbränder.\n\nEn kommun kan ha andra eldningsförbud eller regler enligt annan lagstiftning för att till exempel motverka negativ påverkan på miljö och hälsa i tätbebyggt område eller skydda speciella byggnader. Information om sådana förbud söks hos respektive kommun.\n\nAnger information om bland annat:\n•\tvem som fattat beslut om eldningsförbudet,\n•\tstartdatum för eldningsförbudet, \n•\tlänk till beslutet om eldningsförbudet eller länk till mer information om eldningsförbudet på annan webbplats, samt\n•\tstatus när det gäller eldningsförbud i respektive kommun. \n\nDet finns fem olika typer av status av eldningsförbud som kan anges. De är:\n1.\teldningsförbud, \n2.\tinget eldningsförbud,\n3.\tskärpt eldningsförbud, \n4.\tannat eldningsförbud, samt\n5.\tej angivet\n\nOm det helt saknas information, status ej angivet, för en kommun betyder det att det saknas information om eldningsförbud från den kommunen eller att tjänsten inte används av den länsstyrelse kommunen tillhör. Det betyder dock inte att det saknas ett eldningsförbud.\n\nInformationen i datamängden uppdateras av de länsstyrelser som använder den, när en länsstyrelse eller kommun beslutat att införa eller häva ett eldningsförbud och rapporterat till länsstyrelsen.\n\nFör att veta exakt vad rådande eldningsförbud innebär söks mer information hos respektive kommun eller länsstyrelse. Status Eldningsförbud och Skärpt eldningsförbud grundas på en vägledning från Myndigheten för samhällsskydd och beredskap.\n\nTekniska uppdateringar av information om eldningsförbud blir synliga i datamängden vid varje heltimme mellan 7:00 och 18:00.\nResursdatum i denna metadatabeskrivning återspeglar alltså inte om skiktet blivit uppdaterat, utan det sker löpande och kan ses för varje enskild kommun när det senast uppdaterades i attributen."},"dct:identifier":"2a6738c5-f7a6-413b-8612-e1f4c21f2955","dct:issued":{"@type":"xsd:date","@value":"2020-04-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-09-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:5f05f0651c786c7179fd1412ddb19994772cffbc65df40ffc12d1866d90c9b26_b0n0"},"dct:title":{"@language":"sv","@value":"LST Eldningsförbud kommuner"}},{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällskydd och beredskap","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5f05f0651c786c7179fd1412ddb19994772cffbc65df40ffc12d1866d90c9b26_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo.samhallsskydd.och.beredskap@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällskydd och beredskap"},{"@id":"urn:uuid:e9255264-5a3b-7562-4c0c-0a0c51901e0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_eldningsforbud_EXT/MapServer/0"},"dct:description":{"@language":"sv","@value":"REST adress till tjänst med lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-api"}},{"@id":"urn:uuid:fe5a069d-0698-262c-4d00-d088aa718352","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_eldningsforbud_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS lager"}}],"@id":"urn:source:5f05f0651c786c7179fd1412ddb19994772cffbc65df40ffc12d1866d90c9b26"},{"@graph":[{"@id":"_:5f5abf158afd37dd4c1192b6ba962a0d001373f8418f45027694b29a74dec533_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Genom inventering ute i fält."}},{"@id":"_:5f5abf158afd37dd4c1192b6ba962a0d001373f8418f45027694b29a74dec533_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/ff565c7e-24dc-4e5b-93a7-3ca181f912bb","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1766b20f-1253-dd82-81b9-78625abf752e"},{"@id":"urn:uuid:328d39cc-f064-adb7-6f2f-acfc227ef849"},{"@id":"urn:uuid:373e8492-190b-9b7c-7c0b-8a852ca21905"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Kartskiktet Ängs- och betesmarksinventeringen innehåller ytor för alla marker som besökts vid inventeringen till och med 2011.\nSveriges ängs- och betesmarker har inventerats. Det innebär att 300 000 hektar mark undersöktes under åren 2002 till 2004. Detta för att se var markerna finns och vilka speciella naturvärden och kulturlämningar som finns där, till exempel speciella växter eller gamla byggnader.\nInventeringen visade att det finns 270 000 hektar värdefulla marker i Sverige. 7 000 hektar av dem är ängar och 229 000 är betesmarker. Resten behöver restaureras för att kvaliteten på dem ska bevaras.\nFortsatt inventering sker inom landsbygdsprogrammet (2007-2013). \nInventeringen används för att kunna göra utvärderingar och uppföljningar av miljöersättningar och andra åtgärder för naturmiljö och kulturmiljö. Uppgifterna kan användas som underlag vid rådgivning, samhällsplanering och forskning.\nResultatet av inventeringen finns i databasen TUVA. Den är även tillgänglig på Jordbruksverkets webbplats. Från inventeringen finns två kartskikt. Det ena innehåller alla marker som besökts vid inventeringen (ängs- och betesmarksobjekt). Det andra skiktet (naturtypsytor) innehåller de marker som inventerats fullständigt. I detta skikt är de inventerade markerna nedbrutna så att varje naturtyp har en egen yta, enligt Natura 2000 definitionen."},"dct:identifier":"ff565c7e-24dc-4e5b-93a7-3ca181f912bb","dct:issued":{"@type":"xsd:date","@value":"2022-11-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:5f5abf158afd37dd4c1192b6ba962a0d001373f8418f45027694b29a74dec533_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:5f5abf158afd37dd4c1192b6ba962a0d001373f8418f45027694b29a74dec533_b1n0"},"dct:title":{"@language":"sv","@value":"Ängs- och betesmarksinventeringen"}},{"@id":"urn:uuid:1766b20f-1253-dd82-81b9-78625abf752e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://jordbruksverket.se/download/18.255f72e81830fdabedd29ebd/1682489162311/Arslager-geometri%20-2022.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Jordbruksverket TUVA-databasen"}},{"@id":"urn:uuid:328d39cc-f064-adb7-6f2f-acfc227ef849","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://epub.sjv.se/inspire/wfs?service=wfs&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverket"}},{"@id":"urn:uuid:373e8492-190b-9b7c-7c0b-8a852ca21905","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://epub.sjv.se/inspire/wms?service=wms&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Jordbruksverket"}}],"@id":"urn:source:5f5abf158afd37dd4c1192b6ba962a0d001373f8418f45027694b29a74dec533"},{"@graph":[{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 69.05997,24.17767 69.05997,24.17767 55.16437,10.59208 55.16437,10.59208 69.05997))"}},{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/8d121e71-bd49-4d6d-b505-6dfa4dc085e7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:1cdbcb9e-67de-e57d-ac22-6b396855f99b"},{"@id":"urn:uuid:83fa1ae9-7d32-dcb1-87df-efef5009676b"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samtliga Protokoll A för biotopkarteringsmetoden från 2017 som finns inlagda i Nationella Biotopkarteringsdatabasen. \nVarje Protokoll A representerar en biotopkarterad sträcka i ett vattendrag.\n\nKoordinater för protokollen ligger inlagda som punktobjekt. Varje protokoll A har en startpunkt och en slutpunkt.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till objektets protokoll i databasen.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"8d121e71-bd49-4d6d-b505-6dfa4dc085e7","dct:issued":{"@type":"xsd:date","@value":"2021-04-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b0n0"},{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Protokoll A, samtliga inventerade sträckor, punkter (metoder från 2017) - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5fde9c6e148930505b630596ed7a72f6eca30094b35c90b17f06de607279da6c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@i