ependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/oc-obs-currentdirection/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter strömriktning. Tjänsten visar alla stationer som någonsin levererat data för denna parametrar. Insamlade från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"d1f503a0-2373-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Strömriktning: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4087288f9ea431b807fa4ac91a6860e555ed419acfdb9ab142bdc257cdd663d1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"