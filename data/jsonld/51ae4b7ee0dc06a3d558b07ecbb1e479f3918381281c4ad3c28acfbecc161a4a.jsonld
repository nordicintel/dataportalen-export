83ac05","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d"},"dcat:distribution":[{"@id":"urn:uuid:2f092953-4aaa-ae92-fdfd-ea77f7d7f937"},{"@id":"urn:uuid:b36bc64f-5b16-a77d-d367-bdc600b3c65d"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skikt med det utvidgade strandskyddet. Gäller fr o m 1 jan 2015.  Observera, skiktet innehåller inte det generella strandskyddet (100 m)."},"dct:identifier":"29385b19-abef-419e-a45d-e31f5483ac05","dct:issued":{"@type":"xsd:date","@value":"2014-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:16f31cee58eabaf2df8632f88a1f3eedd46ea4cadc9cbfa8a1fb5fc287c4331e_b0n0"},{"@id":"_:16f31cee58eabaf2df8632f88a1f3eedd46ea4cadc9cbfa8a1fb5fc287c4331e_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Utvidgat strandskydd"}},{"@id":"urn:uuid:2f092953-4aaa-ae92-fdfd-ea77f7d7f937","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.Utvidgat_strandskydd_beslutat.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:b36bc64f-5b16-a77d-d367-bdc600b3c65d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Strandskydd_ext/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:16f31cee58eabaf2df8632f88a1f3eedd46ea4cadc9cbfa8a1fb5fc287c4331e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"}],"@id":"urn:source:16f31cee58eabaf2df8632f88a1f3eedd46ea4cadc9cbfa8a1fb5fc287c4331e"},{"@graph":[{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/e819149f-3db7-4c01-9661-88ae842c5038","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:35f9816d-9ed7-08a1-2e4f-f74ca10b14b0"},{"@id":"urn:uuid:586f3086-c1bc-19f8-bbe4-76437c9057e3"},{"@id":"urn:uuid:85426413-5604-faeb-fe96-c9166f47cbb4"},{"@id":"urn:uuid:f5c1af74-6b8d-35a4-1221-e2eebc5e5a23"}],"dcat:keyword":{"@language":"sv","@value":"Administrativa enheter"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Kontinentalsockelns yttre gräns sträcker sig från den punkt i Idefjorden, där fastighetsindelat område inte längre når ut till den avtalade avgränsningen mot Norge, till en punkt på avgränsningslinjen mot Finland med latituden 65° 35´N . Runt ön Märket i Ålands hav följer gränsen baslinjerna. Kontinentalsockelns inre gräns definieras av de (mot havet) yttersta fastighetsgränserna. Dessa gränser är sällan fastställda och redovisas alltså inte med stöd av den nya lagen. Det finns även områden i några av de stora insjöarna som inte är fastighetsindelade.\n\nFöljande attribut finns i punkt shape-filen:\nLöpnummer - Löpnummer för kontinentalsockelpunkter (KP).\nLöpnr_KP - Löpnummer för signifikanta punkter på Kontinentalsockelns yttre avgränsningslinje.\nLatitud & Longitud - Alla punkter utmed gränsen beskrivs med geografiska koordinater i latitud och longitud uttryckta i referenssystemet SWEREF 99 dels i grader och decimala minuter som det står i lagen och dels i decimala grader.\nPunkttyp - Följande punkttyper förekommer:\n• brytpunkt som avtalats med annan stat (KP), dock med undantag av punkterna\nvid ön Märket, för vilka det inte finns något avtal med annan stat,\n• segmenterad punkt på en rät geodetisk linje eller på en loxodrom mellan\ntvå brytpunkter (MP), och\n• punkt på mittlinjen i Öresund som beskrivs med de koordinater som den\n27 november 2014 utgjorde redovisning av denna avgränsningslinje i Sjöfartsverkets sjökortsdatabas (ML).\nPunktnamn - Namn i de fall sådant förekommer (gäller avtalade punkter på riksgräns).\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner.\nUnikt ID – Ett unikt ID som Sjöfartsverket adderat.\n\nFöljande attribut finns i linje shape-filen:\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner."},"dct:identifier":"e819149f-3db7-4c01-9661-88ae842c5038","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b1n0"},"dct:temporal":{"@id":"_:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c_b2n0"},"dct:title":{"@language":"sv","@value":"Kontinentalsockelns yttre avgränsningslinje"}},{"@id":"urn:uuid:35f9816d-9ed7-08a1-2e4f-f74ca10b14b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Havsgranser/"},"dct:description":{"@language":"sv","@value":"Information om havsgränser på Sjöfartsverkets hemsida"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Havsgränser"}},{"@id":"urn:uuid:586f3086-c1bc-19f8-bbe4-76437c9057e3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/sv/tjanster/havsgranser/kontinentalsockelgrans/"},"dct:description":{"@language":"sv","@value":"Information om kontinentalsockelgräns."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kontinetalsockelgräns"}},{"@id":"urn:uuid:85426413-5604-faeb-fe96-c9166f47cbb4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/globalassets/sjokort-och-sjogeografi/kontinentalsockelns_yttre_avgransningslinje.zip"},"dct:description":{"@language":"sv","@value":"Neddladdning av shapefile för kontinentalsockelgränsen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Shapefil för kontinentalsockelgränsen."}},{"@id":"urn:uuid:f5c1af74-6b8d-35a4-1221-e2eebc5e5a23","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/pages/110583/Kontinentalsockelns_yttre_avgr%C3%A4nsningslinje.zip"},"dct:description":{"@language":"sv","@value":"Shape-fil och metadata för kontinentalsockelns yttreavgränsningslinje förpackat i en zip-fil."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Kontinentalsockelns yttreavgränsningslinje.zip"}}],"@id":"urn:source:170d004ca13bfd4f9d29b4cee3a1659383c4570b3e845a876f4903a38db17e7c"},{"@graph":[{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Den digitaliserade gränsen är framtagen utgående från ett diagram med axlar för höjd över havet och breddgrad samt Lantmäteriets höjdmodell (50 m)"}},{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2010"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2010"}},{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/2905ce03-3e4c-4e85-817c-fbc8ee4c4446","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:87c16bc0-59c2-a2d9-a13f-cdcaf21b335b"},{"@id":"urn:uuid:a1df9eea-1efa-a47b-d8df-e4bd472ba956"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Geodata som anger gräns för odling av contortatall. Upprättad av Skogsstyrelsen grundat på höjd över havet samt breddgrad."},"dct:identifier":"2905ce03-3e4c-4e85-817c-fbc8ee4c4446","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-29"},"dct:provenance":{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b1n0"},"dct:temporal":{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b2n0"},"dct:title":{"@language":"sv","@value":"BR.Gräns för contortatall upprättad av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:87c16bc0-59c2-a2d9-a13f-cdcaf21b335b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaContortagransyta/MapServer/WmsServer?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst - gräns för contortatall"}},{"@id":"urn:uuid:a1df9eea-1efa-a47b-d8df-e4bd472ba956","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Contortatallgr.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av gräns för odling av contortatall, upprättad Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av gräns för odling av contortatall - atomflöde"}}],"@id":"urn:source:17d854edf362f40611d0dcd4543f07d81ee0ae32113c0c7aa715f5e1c281d8d8"},{"@graph":[{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"PMP är en prognosdatabas som skapas genom att meteorologen väljer in data från ett antal prognosmodeller samt använder metoder för efterbearbetning. Slutprodukten, PMPs datamängd, innehåller prognosdata för upp till 240 timmar. PMP uppdateras minst 1 gång per timme. PMP har funnits sedan år 2000 och har ständigt utvecklats, bland annat genom minskat gridavstånd (fler beräkningspunkter), förbättrade modeller för inval, nya kvalitetskontroller och moderniserad arbetsmetodik."}},{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((27.39 70.74,37.93 70.74,37.93 52.50,27.39 52.50,27.39 70.74))"}},{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/cc1d6b00-fc79-4f47-9b3e-ecebbc4df658","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1025cc3d-1ee9-73e1-ae09-a00bfc8ccba5"},{"@id":"urn:uuid:756a24e8-01fa-9435-e0a2-1dbc9fdbf7ea"}],"dcat:keyword":{"@language":"sv","@value":"Geografiska meteorologiska förhållanden"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/mf"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"I denna datamängd finns prognosdata i realtid från de två senaste körningarna av PMP.\n\nPMP är en prognosdatabas som är kvalitetskontrollerad av en meteorolog. Databasen består av prognosvärden utlagda i ett grid (fält).  Varje parameter har ett värde i varje gridpunkt och vid varje specifik tidpunkt. Avståndet mellan gridpunkterna är ca 2,8 km.\n\nTidsupplösningen på informationen i PMP glesas ut efterhand. För de första dygnen finns data för varje timme, därefter finns data för var tredje timme, därefter var sjätte timme och för de sista dygnen i databasen är tidsupplösningen 12 timmar. \nPMP skapas genom att meteorologen väljer in data från ett antal prognosmodeller samt använder metoder för efterbearbetning. Slutprodukten, PMPs datamängd, innehåller prognosdata för upp till 240 timmar.\n\nPMP3g uppdateras minst 1 gång varje timme.\n\nVia denna tjänst levereras PMP-data för en rad parametrar. En beskrivning av dessa hittar du via https://opendata.smhi.se/metfcst/pmp/parameters#parameter-table.\n\nVia denna nedladdningstjänst får du filer som innehåller alla parametrar för hela det geografiska området och alla höjder, för det aktuella tidssteget.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER:\nKoordinater för området ges av hörnen:\nSydvästra   52.50 N, 2.25 W\nNordvästra 70.67 N, -8.55 E\nNordöstra   70.74 N, 37.93 E\nSydöstra      52.54 N, 27.39 W \t  \n\nGridrutorna är 2,8 km.\n\nANVÄNDNING:\nPå SMHI används PMP som underlag för prognoser till såväl allmänhet som kommersiella kunder. Väderprognoserna på smhi.se och appen \"SMHI väder\" baseras på information från PMP. \n\nFORMAT:\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"cc1d6b00-fc79-4f47-9b3e-ecebbc4df658","dct:issued":{"@type":"xsd:date","@value":"2025-02-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-17"},"dct:provenance":{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b1n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk modell PMP3g - Prognosdata realtid"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb_b2n0"},"dct:title":{"@language":"sv","@value":"Information om format"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"urn:uuid:1025cc3d-1ee9-73e1-ae09-a00bfc8ccba5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/meteorology/pmp3g/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. LEVERANS Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdning"}},{"@id":"urn:uuid:756a24e8-01fa-9435-e0a2-1dbc9fdbf7ea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om dataformat"}}],"@id":"urn:source:17e08c0f7226e91214d799300f8d479131130afd0f6365ac2f6b58de9fa8a8eb"},{"@graph":[{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är insamlad av SGU i den geologiska karteringen. Insamlingen har skett främst inom den hydrogeologiska och jordartsgeologiska karteringen. Informationen används för att få en tredimensionell bild av geologi och grundvattenmagasin.\n\nDen största delen data är insamlad från mitten av 1990-talet och framåt.\n\nDatakvalitet:\nPositionen av profilen är bestämd med karta, (topografisk eller ekonomisk), med eller utan GPS som stöd. De flesta profiler är längdmätta med mäthjul (ibland måttband) vid mättillfället. Antal mätpunkter (trace) per meter är vanligtvis fyra till fem. En del profiler är mätta med ett fixt antal mätningar per tidsenhet.\n\nProfilerna är ofta höjdbestämda med barometer och ibland avvägda med avvägningsinstrument och/eller höjdbestämda med den nationella höjdbasen. Den absoluta höjden kommer från avvägningar till känd höjd eller från nationella höjdbasen."}},{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1990"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/39de44a4-db9f-4121-8aaf-aeba7c8f35da","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:56d0da98-7d4b-7c1f-cabe-a1f87b55b246"},{"@id":"urn:uuid:c8643d1b-73ab-d996-5ce8-c00113d7f31b"},{"@id":"urn:uuid:ea36eda9-e18c-7f62-af94-4871a04a2afc"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Geofysiska markmätningar, markradar innehåller information om mätningar markradar. Informationen består av profillinjer med uppgifter om mätningarna, och i förekommande fall en URL till ett bearbetat radargram i pdf-format för profilen. I de bearbetade radargrammen kan man till exempel se grundvattenytor, geologiska strukturer och berggrundsytan."},"dct:identifier":"39de44a4-db9f-4121-8aaf-aeba7c8f35da","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b1n0"},"dct:temporal":{"@id":"_:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, markradar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:56d0da98-7d4b-7c1f-cabe-a1f87b55b246","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-mark-markradar/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:c8643d1b-73ab-d996-5ce8-c00113d7f31b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-markmatningar-markradar-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:ea36eda9-e18c-7f62-af94-4871a04a2afc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-mark-markradar/geofysik-mark-markradar.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:181eaf2e830f2a41aef88769cf3f0237e71ea02535ef651c61805e5cdfd6f1c0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/520f036c-acca-43d2-bb3f-2dc81ef226c9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://mapsext.sgi.se/geoserver/wms?request=GetCapabilities&service=WMS"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Inom ramen för förstudien/utvecklingsprojektet \"Geoteknisk sektorsportal - nationell datainfrastruktur för tillgång till genomförda geotekniska undersökningar\" har en webbapplikation för registrering av (både analoga och GeoSuite digitala) geotekniska undersökningsområden utvecklats. Registering sker via ett särskilt WFS/OpenLayers-baserat gränssnitt eller som uppladd shp enligt en fastlagd struktur. I projektet deltar SGI, SGU, Trafikverket, SKL och Lantmäteriet och med finansiering från MSB. SGI är värd/huvudman för registreringsapplikationen och publicering av WMS. [Geoteknik]"},"dct:identifier":"520f036c-acca-43d2-bb3f-2dc81ef226c9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"Geotekniska undersökningsområden - WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:1869458c4bb37de7e68fb89dc4040dd588def4229314f78337ec35e3c3654f5a"},{"@graph":[{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bedömningsområden har tagits fram på olika nivåer; kustvattentyper, utsjövatten, bassänger, grupper av bassänger och förvaltningsområde för att kunna rapportera olika delar på olika geografisk skala. Grunden för indelningen är de 12 bassängerna (tre i delregion Nordsjön och 9 i region Östersjön). Indelningen i havsbassänger bygger på den indelning som gjorts i Svenskt havsområdesregister som är en del av Svenskt Vattenarkiv (SVAR). Dessa bassänger är vid behov indelade i kustvatten respektive utsjövatten. Utsjövattnen följer alltid indelningen i bassänger och definieras av kustvattnets avgränsningslinjer och den yttre avgränsningslinjen för svensk ekonomisk zon och följer indelning i havsbassänger. Kustvattnen är indelade i kustvattentyper och följer indelningen av kustvatten enligt Havs- och vattenmyndighetens föreskrifter om kartläggning och analys av ytvatten HVMFS 2017:20 enligt förordningen 2004:660 \nom förvaltningen av kvaliteten på vattenmiljön. I vissa fall används grupper av bassänger som bedömningsområde. Bassänggrupper har definierats som flera bassänger inom ett större havsområde. Inom svenskt havsområde finns tre bassänggrupper, en i Nordsjön och två i Östersjön. Alla dessa bedömningsområden, utom grupper av bassänger, finns på kartor i bilaga 1 i Havs- och vattenmyndighetens föreskrifter om vad som kännetecknar god miljöstatus samt miljökvalitetsnormer med indikatorer för Nordsjön och Östersjön."}},{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.00 66.18,24.29 66.18,24.29 54.61,7.00 54.61,7.00 66.18))"}},{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/4d61d52e-6f0a-0c62-8061-d9b08e1eba7a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e"},"dcat:distribution":[{"@id":"urn:uuid:0cb62807-5cfc-df8b-ca82-ec613f6e7fb3"},{"@id":"urn:uuid:e59d9b8e-73bd-9138-71a7-412cc30e4917"},{"@id":"urn:uuid:fb3dd2e4-7f21-914f-3592-93339f663477"},{"@id":"urn:uuid:fda97c9b-2bc3-600e-7162-3677b8af1d15"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Havsområden"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/sr"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen (2010:1341), uppdaterad 2018"},"dct:identifier":"4d61d52e-6f0a-0c62-8061-d9b08e1eba7a","dct:issued":{"@type":"xsd:date","@value":"2018-11-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-26"},"dct:provenance":{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b1n0"},"dct:title":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen - Bedömningsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0cb62807-5cfc-df8b-ca82-ec613f6e7fb3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-bedomningsomraden/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen 2018 - Bedömningsområden Inspire WMS"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Bedömningsområden.WMS"}},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsmiljöenheten"},{"@id":"urn:uuid:e59d9b8e-73bd-9138-71a7-412cc30e4917","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsmiljoforordningen-bedomningsomraden/atom-havsmiljoforordningen-bedomningsomraden-datafeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Havsområdesindelning enligt havsmiljöförordningen -Bedömningsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"AM.Havsområdesindelning enligt havsmiljöförordningen Bedömningsområden.ATOM"}},{"@id":"urn:uuid:fb3dd2e4-7f21-914f-3592-93339f663477","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/havsmiljoforordningen-bedomningsomraden/2018-11-27/havsmiljoforordningen-bedomningsomraden-2018-11-27.zip"},"dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen 2018 - Bedömningsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Bedömningsområden Nedladdning"}},{"@id":"urn:uuid:fda97c9b-2bc3-600e-7162-3677b8af1d15","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/havsmiljoforordningen-bedomningsomraden/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Havsområdesindelning enligt havsmiljöförordningen 2018 - Bedömningsområden"},"dct:title":{"@language":"sv","@value":"Bedömningsområden  Karttjänst"}}],"@id":"urn:source:186c08929ae9db19deac6d1d42cbad4c0e97bff4a68929b82755989bcc98a3e5"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/125fddd3-b0c5-4524-bc77-a8f0903bdcd2","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://m4eu.sgu.se/m4eu/services/m4eu_v2020.8?service=WFS&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"MR.Mineralresurser (nedladdningstjänst för direktåtkomst) är en OGC Web Feature Service  i syfte att uppfylla Inspires dataspecifikation för tema Mineralresurser. Den underliggande datamängden är framtagen och harmoniserad enligt specifikationer från olika EU-projekt, bland annat Minerals4EU och ProSUM och innehåller information om mineralfyndigheter, gruvor, gruvavfall och produktion.\n\nDatamängden baseras på SGUs mineralresursdatabas (punktuppgifter om mineral och bergartsförekomster), samt kompletterande sammanställningar av bland annat metallhalter och tonnage för större fält av mineralfyndigheter från SGUs malmdatabas.\n\nInformation"},"dct:identifier":"125fddd3-b0c5-4524-bc77-a8f0903bdcd2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"MR.Mineralresurser (nedladdningstjänst för direktåtkomst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:187fafdafcc64977e7eafe7ba2cfed7c4de4d4c4777fbac9e115eb0b9893b9ce"},{"@graph":[{"@id":"_:18e925946af37ec2d82558a58decb4c80da97437e3f0b61d0ea5c7d9cb1069bd_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:18e925946af37ec2d82558a58decb4c80da97437e3f0b61d0ea5c7d9cb1069bd_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010---121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/18c398dd-2cf2-4bf6-a85d-9e86020b026b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51"},"dcat:endpointURL":{"@id":"https://inspire-raa.metria.se/geoserver/Fornlamningar/ows?layers=PS.ProtectedSite"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kända och registrerade fornlämningar i kulturmiljöregistret. Fornlämningar kan finnas både på land och i vatten. Datasetet ingår i INSPIRE-direktivets tema skyddade områden."},"dct:identifier":"18c398dd-2cf2-4bf6-a85d-9e86020b026b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Skyddade områden, Fornlämningar INSPIRE visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:18e925946af37ec2d82558a58decb4c80da97437e3f0b61d0ea5c7d9cb1069bd_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:18e925946af37ec2d82558a58decb4c80da97437e3f0b61d0ea5c7d9cb1069bd_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:18e925946af37ec2d82558a58decb4c80da97437e3f0b61d0ea5c7d9cb1069bd"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e989fc1b-cf56-44ba-a5c2-10960b78f3f3","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/forutsattning-skred-finkornig-jordart"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Informationen är tänkt att användas i tidigt planeringsskede för att identifiera områden där skredfara kan förekomma och där ytterligare bedömningar/undersökningar kan behöva göras."},{"@language":"sv","@value":"Visningstjänsten visar datamängden Förutsättningar för skred i finkornig jordart och ger översiktlig information om förutsättningar för jordskred i finjord. Informationen är tänkt att användas i tidigt planeringsskede för att identifiera områden där skredfara kan förekomma och där ytterligare bedömningar/undersökningar kan behöva göras.\n\nInformationen bygger på en beräkningsalgoritm som utifrån jordartstyp (enligt SGUs produkt Jordarter 1:25 000 - 1:100 000), terrängmodell (Lantmäteriets nationella höjdmodell) och kritisk lutning (1:10) definierar markområden med finkornig jordart som har förutsättningar för jordskred."}],"dct:identifier":"e989fc1b-cf56-44ba-a5c2-10960b78f3f3","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Förutsättningar för skred i finkornig jordart (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:1910b021f0cd86fa8e75daf4b7c472ccba1b43f4ea2d1dbeb8c779bca7710d72"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/59525d51-79d7-4982-a679-32781d4c89da","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-gammastralning-kalium"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Geofysiska flygmätningar, gammastrålning kalium visar fördelningen av kalium i den översta delen av berggrunden eller jordarterna. Det radioaktiva sönderfall som utnyttjats för beräkningen av kaliumhalten är gammastrålningen från sönderfallet av kalium-40 till argon-40. Kalium-40 utgör 0,0118 % av naturligt förekommande kalium. Halten kalium är uttryckt becquerel per kg(Bq/kg) samt i procent (%)."},"dct:identifier":"59525d51-79d7-4982-a679-32781d4c89da","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, gammastrålning kalium (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:19524112b32162ad83494c25393a8a9d0671a7790e2753ba0bc9ba3bfe4cb684"},{"@graph":[{"@id":"_:195e1c32ca31b381a9829db8dbf4045a3544c7e671ace861a3c48a5c2c2029b7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"bla"}},{"@id":"_:195e1c32ca31b381a9829db8dbf4045a3544c7e671ace861a3c48a5c2c2029b7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:195e1c32ca31b381a9829db8dbf4045a3544c7e671ace861a3c48a5c2c2029b7_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2020"}},{"@id":"_:195e1c32ca31b381a9829db8dbf4045a3544c7e671ace861a3c48a5c2c2029b7_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:195e1c32ca31b381a9829db8dbf4045a3544c7e671ace861a3c48a5c2c2029b7_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/6cfad5df-c8ba-48f1-99ac-09a901b45fca","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f"},"dcat:distribution":{"@id":"urn:uuid:d38ee4ea-0944-9b60-21cc-38c1e3e0c