:"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/4f88f4a0-051e-4527-a69b-9e9f2b6d8580","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:3c2fa28b-5816-5fe0-c981-1d09a205a2f9"},{"@id":"urn:uuid:d923c58a-4d29-5c36-10ec-a9520f3d628b"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Enligt nitratdirektivet (rådets direktiv 91/676/EEG om skydd mot att vatten förorenas av nitrater från jordbruket) ska varje medlemsstat med vissa intervall övervaka nitrathalten i vatten vid platser som är representativa för deras ytvatten och grundvatten. Uppgifter om nitrathalter kommer från mätstationer i de nationella och regionala miljöövervakningsprogrammen och den samordnade recipientkontrollen. Datavärdarna för programmen har levererat uppgifterna till Jordbruksverket, som har sammanställt uppgifterna och rapporterat dem till EU-kommissionen."},"dct:identifier":"4f88f4a0-051e-4527-a69b-9e9f2b6d8580","dct:issued":{"@type":"xsd:date","@value":"2022-12-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:8ee20689f67a5b6454e49005dca746dc2ce746f5631215cb523d41d27ec7e254_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:8ee20689f67a5b6454e49005dca746dc2ce746f5631215cb523d41d27ec7e254_b1n0"},"dct:title":{"@language":"sv","@value":"Nitratmätstationer"}},{"@id":"urn:uuid:3c2fa28b-5816-5fe0-c981-1d09a205a2f9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/nitratmatstationer/atom-datasetfeed-nitratmatstationer.