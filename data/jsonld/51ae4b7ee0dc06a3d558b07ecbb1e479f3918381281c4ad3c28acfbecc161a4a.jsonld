s#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"},{"@id":"urn:uuid:d602f70e-4693-04da-4163-ad2e433a7e03","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://projektkatalog.havochvatten.se"},"dct:description":{"@language":"sv","@value":"Katalog för projekt finansierade av havs- och vattenmiljöanslaget"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"ProKat - Projekt finansierade av havs- och vattenmiljöanslaget"}}],"@id":"urn:source:0dd38c68a741a7998dcf95bf34827073c50645a196ede0aa38f563b78efc9d77"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/951b7d2f-d115-45c9-8f25-8822eff32189","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/lagenhet-nedladdning"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Lägenhet Nedladdning innehåller information från lägenhetsregistret som är ett nationellt register över Sveriges alla bostadslägenheter. Lägenhetsregistret regleras i lägenhetsregisterlagen och är inte allmänt tillgänglig. Uppgift om vem som bor i lägenheten finns inte i lägenhetsregistret.\nProdukten levererar information om byggnader inklusive lägenhet samt registerbeteckningar. Uttagen är en ögonblicksbild över hur informationen ser ut just vid uttagstillfället.\n\nProdukten går att beställa både som engångsuttag och abonnemang.\nEngångsuttag - Uttaget är ett basuttag som skapas en gång och ger en ögonblicksbild av respektive informationsmängd såsom den ser ut vid sammanställning av leveransen.\nAbonnemang - Det första uttaget är alltid ett basuttag medan efterföljande är så kallade förändringsuttag. Så länge abonnemanget är aktivt kan nya förändringsuttag eller basuttag skapas.\n\nUrval görs på information dvs vilka informationsmängder för byggnad samt om registerbeteckning som ska levereras Urvalet görs även utifrån bestånd för vilka byggnader och registerbeteckningar informationen ska levereras. Kunden kan välja län, kommun eller bifoga fil med identiteter för registerenheter."},"dct:identifier":"951b7d2f-d115-45c9-8f25-8822eff32189","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Lägenhet Nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0ef261b579e3c6ce435425a1e0000b79f156f95dcf1ad41d67c49115dc107649"},{"@graph":[{"@id":"_:0f9abf098d8927561f4a7b7d700342a228798e42c482dc236d973eaf6f8b030f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data avseende djupinformation har sitt ursprung i sjömätningar från 1820 och framåt. Nautisk information uppdateras dagligen. Övrig data kommer från externa källor."}},{"@id":"_:0f9abf098d8927561f4a7b7d700342a228798e42c482dc236d973eaf6f8b030f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8EF1BC75-4CC3-4F27-B9BB-FDFF42474014","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:6a8d0911-e9da-f2a5-2cea-238bc1144437"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Täckning över hela svenska kusten. Korten används vid angöring och navigering i kustnära farvatten samt som underlag vid planering.\nSkalan är vanligtvis 1:250 000."},"dct:identifier":"8EF1BC75-4CC3-4F27-B9BB-FDFF42474014","dct:issued":{"@type":"xsd:date","@value":"2012-10-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-10-18"},"dct:provenance":{"@id":"_:0f9abf098d8927561f4a7b7d700342a228798e42c482dc236d973eaf6f8b030f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:0f9abf098d8927561f4a7b7d700342a228798e42c482dc236d973eaf6f8b030f_b1n0"},"dct:title":{"@language":"sv","@value":"Sjökort - Kustkort"}},{"@id":"urn:uuid:6a8d0911-e9da-f2a5-2cea-238bc1144437","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Sjofart/Sjokort/"},"dct:description":{"@language":"sv","@value":"Sjökort och Publikationer på Sjöfartsverkets officiella hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjökort och Publikationer"}}],"@id":"urn:source:0f9abf098d8927561f4a7b7d700342a228798e42c482dc236d973eaf6f8b030f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/5b01407c-4466-4853-bdfa-c9a4ed07f99b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/kallor"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Informationen kan bland annat användas för att välja ut provtagningspunkter för kemisk karakterisering av grundvatten eller för miljöövervakning."},{"@language":"sv","@value":"Visningstjänsten Källor visar naturliga grundvattenutflöden, företrädesvis längs de större rullstensåsarna i Sverige. Produkten innehåller uppgifter om källornas läge, flöde, akvifertyp (geologisk miljö) och i viss omfattning vattenkvalitet med mera. Källor kan vara av stor vikt för specifika biotoper samt har i många fall en stor kulturhistorisk betydelse. Informationen kan bland annat användas för att välja ut provtagningspunkter för kemisk karakterisering av grundvatten eller för miljöövervakning."}],"dct:identifier":"5b01407c-4466-4853-bdfa-c9a4ed07f99b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Källor (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:10a11c0d310eaab69677039fb3d5a1dc9095b825ae41d87851cdaaf7c7354173"},{"@graph":[{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:100 000 är en transformerad version av SGUs produkt Maringeologi 1:100 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden. Endast karterade områden utanför territorialgränsen redovisas.\n\nMaringeologi 1:100 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke. För närvarande är endast områden utanför svenskt territorialhav offentligt tillgängliga.\n\nSveriges geologiska undersökning (SGU) bedriver en marin¬geologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. Maringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (akustisk profilering) samt bottenyteavbildande mätningar. Bottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. Bottenyteavbildande mätningar (akustisk bottenavsökning) har för denna produkt utförts med sidoavsökande sonar. Mätningar med den bogserande sidoavsökande sonaren ger en yttäckande avbildning av havsbottenytans hårdhet. De hydroakustiska data som samlats in tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där såväl mätningar som direkta sedimentprovtagningar och visuella observationer av de geologiska förhållandena gjorts. De sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagningarna föregås av en besiktning av bottenytan med hjälp av undervattenskamera. Efter insamling och bearbetning görs en geologisk tolkning av materialet, för presentation i skala 1:100 000."}},{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.03 65.90,24.23 65.90,24.23 54.95,10.03 54.95,10.03 65.90))"}},{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1969"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/9ba8de1b-4486-48a9-b55f-f3e3ee0bcbd2","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0ed29447-b001-03c4-6d74-8dd6e33f9192"},{"@id":"urn:uuid:a214a487-9b6d-9039-0cda-3226b572cd54"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:100 000 är en transformerad version av SGUs produkt Maringeologi 1:100 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden. Endast karterade områden utanför territorialgränsen redovisas.\n\nMaringeologi 1:100 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke. För närvarande är endast områden utanför svenskt territorialhav offentligt tillgängliga."},"dct:identifier":"9ba8de1b-4486-48a9-b55f-f3e3ee0bcbd2","dct:issued":{"@type":"xsd:date","@value":"2021-10-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2021-10-20"},"dct:provenance":{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b1n0"},"dct:temporal":{"@id":"_:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140_b2n0"},"dct:title":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:100 000"}},{"@id":"urn:uuid:0ed29447-b001-03c4-6d74-8dd6e33f9192","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/SR_SGU_SeaBedArea_100K.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}},{"@id":"urn:uuid:a214a487-9b6d-9039-0cda-3226b572cd54","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SR-Havsbottenyttacke_100k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:113a01003257f88cf43c3e043b17dd7767a28c2d82e63b9596a41bd949fd7140"},{"@graph":[{"@id":"_:11cd62599b822f6e1d307abdacd08e9fa2742d7113823f1ae22ef9e64b92d156_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Innehållet i Topografi 50 Nedladdning, vektor framställs genom automatisk generalisering av den grunddatamängd som ingår i Topografi 10 Nedladdning, vektor. Den automatiska generaliseringsprocessen består av en mängd GIS-operationer som stegvis bearbetar data till att passa för presentation i en översiktlig kartskala. Innehållet struktureras om till viss del, vissa kartobjekt slås samman eller tas bort och ibland överdrivs de i storlek eller flyttas från varandra."}},{"@id":"_:11cd62599b822f6e1d307abdacd08e9fa2742d7113823f1ae22ef9e64b92d156_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/b4cfbef9-6f84-47e7-a689-d3977e608e1a","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:45657952-d325-1750-769d-b96c3257b077"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Produkten passar utmärkt som bakgrundskarta och som indata till GIS-tillämpningar. Den är lämplig att använda i skalområdena 1:15 000 - 1:50 000. Innehållet består bland annat av markslag, vägar, stigar, vägbommar och höjdkurvor (10 m ekvidistans i fjällområden och 5 m ekvidistans i övriga landet)."},"dct:identifier":"b4cfbef9-6f84-47e7-a689-d3977e608e1a","dct:issued":{"@type":"xsd:date","@value":"2022-09-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:11cd62599b822f6e1d307abdacd08e9fa2742d7113823f1ae22ef9e64b92d156_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:11cd62599b822f6e1d307abdacd08e9fa2742d7113823f1ae22ef9e64b92d156_b1n0"},"dct:title":{"@language":"sv","@value":"Topografi 50 Nedladdning, vektor"}},{"@id":"urn:uuid:45657952-d325-1750-769d-b96c3257b077","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-50-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Topografi 50 Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografi 50 Nedladdning, vektor"}}],"@id":"urn:source:11cd62599b822f6e1d307abdacd08e9fa2742d7113823f1ae22ef9e64b92d156"},{"@graph":[{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ursprungligen (1997) användes Lantmäteriets marktäckelager åker  för att få fram jordbruksblocken. Sedan dess används de av Lantmäteriet producerade ortofotona för att uppdatera gränserna, samt fältbesök."}},{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2021-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2021-01-01"}},{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/e317c48b-2a5e-4590-a2d5-c79900541d13","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:5259708d-f844-b97e-c15a-afe85e5c3a13"},{"@id":"urn:uuid:76727607-e4e2-dafb-bfa7-5027bf038007"},{"@id":"urn:uuid:c74891cd-2d7a-8263-dbdb-49f25051d7c9"},{"@id":"urn:uuid:cd3ec4b3-0400-7c57-1688-df284ccd5482"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Markanvändning"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/lu"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ett skifte är ett sammanhängande markområde inom ett block där en jordbrukare odlar en gröda eller sköter marken på ett annat sätt. \nFör att få ersättning för jordbruksstöd (EU-stöd) ansöker lantbrukare om stöd hos Jordbruksverket via en SAM-ansökan. \n\nInformationsmängden innehåller skiften där ansökt areal och beslutad areal är densamma. Datan gäller för föregående år. Informationsmängden är begränsad till Gårdsstöd.\n\nGrödkodslistan nås via: https://jordbruksverket.se/stod/lantbruk-skogsbruk-och-tradgard/sam-ansokan-och-allmant-om-jordbrukarstoden/grodkoder"},"dct:identifier":"e317c48b-2a5e-4590-a2d5-c79900541d13","dct:issued":{"@type":"xsd:date","@value":"2022-02-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b1n0"},"dct:temporal":{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b2n0"},"dct:title":{"@language":"sv","@value":"Jordbruksskiften"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:5259708d-f844-b97e-c15a-afe85e5c3a13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/jordbruksskiften/20250326/jordbruksskiften.gml.zip"},"dct:description":{"@language":"sv","@value":"Nerladdningsbar fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"},{"@id":"urn:uuid:76727607-e4e2-dafb-bfa7-5027bf038007","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/jordbruksskiften/atom-datasetfeed-jordbruksskiften.xml"},"dct:description":{"@language":"sv","@value":"Atom dataset feed för datamängden Jordbruksskiften"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom dataset feed för datamängden Jordbruksskiften"}},{"@id":"urn:uuid:c74891cd-2d7a-8263-dbdb-49f25051d7c9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&TYPENAMES=senaste_arslager_skifte"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst (WFS)"}},{"@id":"urn:uuid:cd3ec4b3-0400-7c57-1688-df284ccd5482","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layer=arslager_skifte"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Jordbruksverkets visningstjänst (WMS)"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets visningstjänst (WMS)"}}],"@id":"urn:source:11e4ef98892c58e2a456ddde2914d7b36b4ca702bb018545a4db28b8a935de94"},{"@graph":[{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.63387 62.15739,19.31871 62.15739,19.31871 56.92272,14.63387 56.92272,14.63387 62.15739))"}},{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/0aeabb67-fd02-45bc-a620-7feee88e71cf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":{"@id":"urn:uuid:ea88800f-131a-596e-aa79-273338e76594"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Denna datamängd innehåller linjer som representerar markavvattningsföretag. Det är en spegling av de objekt i Vattenarkivet som har geometrier som linjer, med en uppdatering per vecka. Alla län har inte geometrier som linjer men det kan ändå finnas objekt att söka på i Vattenarkivet, se länk under Onlinekällor. \nFör varje objekt i denna tjänst finns en länk till Länsstyrelsernas Vattenarkiv där mer information om objektet finns, t.e.x. länkade kartor/ritningar samt akter. De äldsta är från 1840-talet. Materialet som länsstyrelsen har är i första hand markavvattningar i jordbrukslandskapet. Handlingarna är uppkomna i gamla Lantbruksnämnden med föregångare.\n\nMarkavvattning är enligt dagens definition i 11 kapitlet 2 § miljöbalken \"åtgärder som utförs för att avvattna mark, [...] eller som utförs för att sänka eller tappa ur ett vattenområde eller för att skydda mot vatten, när syftet med åtgärden är att varaktigt öka en fastighets lämplighet för något visst ändamål\".\nDikning, bortledning av vatten eller invallning som görs för att dränera mark eller skydda mot översvämning räknas som markavvattning, om det görs för att få en bestående förändring i marken."},"dct:identifier":"0aeabb67-fd02-45bc-a620-7feee88e71cf","dct:issued":{"@type":"xsd:date","@value":"2019-09-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b0n0"},{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Vattenarkiv - Markavvattningsföretag, linjer för nedladdning"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:ea88800f-131a-596e-aa79-273338e76594","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_sde.GV_WEBGIS_LIN.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:12c60114397661af20961ced439c6ab7b74f680f88c6f067065e5bcccaade9be"},{"@graph":[{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sedan 1998 registrerar Skogsstyrelsen avverkningsanmälningarnas geometrier digitalt. 2007 gjordes de tillgängliga externt."}},{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.50,24.50 69.50,24.50 55.00,10.50 55.00,10.50 69.50))"}},{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1998"}},{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183"},{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/a614362f-0bec-47f8-b10f-1ea51e8b1ec6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7"},"dcat:distribution":[{"@id":"urn:uuid:24ff66da-2324-497d-882c-825d560d9b67"},{"@id":"urn:uuid:596d5509-5d86-45f2-f7f2-1cdb61dd1c41"},{"@id":"urn:uuid:61c949f3-8fb4-d783-5efb-222cbed1b40b"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Yttre gränser för avverkningsanmälda områden. Anmälan till Skogsstyrelsen görs vid; föryngringsavverkning, avverkning för annat ändamål än virkesproduktion, uttag av skogsbränsle, användning av utländska trädslag, skyddsdikning och för samråd om åtgärder som väsentligt ändrar naturmiljön. I vissa fall krävs ett tillstånd. Sedan 1998 finns kartfiguren digitalt. Anmälningar som är giltiga (max 5 år) och är där högst 75% är avverkad visas."},"dct:identifier":"a614362f-0bec-47f8-b10f-1ea51e8b1ec6","dct:issued":{"@type":"xsd:date","@value":"2007-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2007-01-01"},"dct:provenance":{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b1n0"},"dct:temporal":{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b2n0"},"dct:title":{"@language":"sv","@value":"Avverkningsanmälningar upprättad av Skogsstyrelsen"}},{"@id":"urn:uuid:24ff66da-2324-497d-882c-825d560d9b67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaAvverkningsanmalan/MapServer/WmsServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"WMS-tjänst med Avverkningsanmälningar inkomna till Skogsstyrelsen."}},{"@id":"urn:uuid:596d5509-5d86-45f2-f7f2-1cdb61dd1c41","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/AvverkAnm.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av Avverkningsanmälningar - atomflöde"}},{"@id":"urn:uuid:61c949f3-8fb4-d783-5efb-222cbed1b40b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skogsstyrelsen.se/sjalvservice/karttjanster/skogsstyrelsens-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om Skogsstyrelsens geodata"}},{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst -","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:12d4042ad9eb4d8bf05cbc199a1c9498be96d1c151224a4fb1806111f06fe771"},{"@graph":[{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen i denna produkt är framtagen genom olika verksamheter, vilket ska beaktas vid vidare användning och tolkning. \nMiljöövervakning:\nStora delar av produkten består av data härrörande från det svenska miljöövervakningssystemet och förvaltas genom de nationella datavärdskapen för grundvatten respektive miljögifter. \nIngående löpande delprogram är nationell och regional miljöövervakning av grundvattenkvalitet inom programområde Sötvatten, samt grundvattenkemiska data från den Integrerade Miljöövervakningen inom programområde Skog. Mer information om dessa verksamheter kan erhållas via aktuella program/delprogramsbeskrivningar. Fördjupad information kring analys- och provtagningsförfarande kan erhållas via kopplad övervakningsmanual (undersökningstyp).\nGrundvattenkemiska data från tillfälliga undersökningar utförda inom miljöövervakningssystemet ryms också inom denna produkt. Fördjupad information finns dokumenterad genom projektrapporter och/eller uppdragsbeskrivningar/överenskommelser. \nGrundvattennätet:\nProdukten omfattar den grundvattenkemiska delen av SGU:s så kallade Grundvattennät. Mer information om Grundvattennätet kan erhållas via SGU.\nÖvriga data:\nProdukten rymmer ytterligare data avseende grundvattnets kvalitet; exempelvis statligt finansierade undersökningar bortom miljöövervakningsanslaget, verksamhetsutövares recipientkontroll eller lokal miljöövervakning utförd av kommuner.\nDatakvalitet:\nTill följd av spridningen i ursprung, finns det en betydande variation i precision och kvalitet av tillhandahållna analys- och provplatsdata. Detsamma gäller kopplad kringinformation. Harmoniseringen med datavärdskapet för miljögifter innebär vidare att produkten omfattar data från två olika databaser. Som nämnt är informationen så långt möjligt harmoniserad, men diskrepanser avseende framför allt värdeförråd kvarstår."}},{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.9635 69.06,24.1664 69.06,24.1664 55.3374,10.9635 55.3374,10.9635 69.06))"}},{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1962"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7e7585a2-3ebd-427f-83d0-fdb1e2527502","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:17580c5e-21fb-a5f7-2dad-8db846675cfb"},{"@id":"urn:uuid:2118a2db-1ff8-c7cf-6812-fa6e8a9c69bb"},{"@id":"urn:uuid:bd0bebf2-9e1e-72e1-5055-05bbd05ad527"},{"@id":"urn:uuid:cb0c2ba5-fa93-56bd-52f3-cd625e9cf8b6"},{"@id":"urn:uuid:fc60ce54-1a78-6772-f19b-eaf7fb52fb59"},{"@id":"urn:uuid:ff07c368-633b-a7f4-fb31-9b346bb66846"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"sv","@value":"Grundvattenkvalitet, analysresultat och provplatser (version 2) omfattar öppet tillgängliga grundvattenkemiska och -mikrobiologiska data insamlade och/eller förvaltade av SGU. En stor del av ingående data är insamlat inom ramen för det nationella datavärdskapet för grundvatten, sedan 2011 på uppdrag av Havs- och vattenmyndigheten (HaV). Från och med denna version tillgängliggörs även grundvattendata från datavärdskapet för miljögifter, för vilket Naturvårdsverket (NV) är uppdragsgivare.\n\nVersionen är harmoniserad med datavärdskapet för miljögifter. Detta innebär att omfattning, attributnamn och värdeförråd avser omfatta och följa de namn och värdeförråd som används av registret för miljödatakoder https://kodlistor.miljodatasamverkan.se/def/vocabularies. Diskrepanser föreligger dock, vilket avses hanteras löpande framöver.\n\nUtöver analysresultat, omfattar produkten också kringinformation rörande provtagningsomständigheter, analysförfarande och provplatsinformation. Analysresultat och provplatsinformation tillhandahålls som separata informationsmängder, sammanlänkade genom provplatsens id (nationellt_provplatsid) i det nationella stationsregistret https://stationsregister.miljodatasamverkan.se.\n\nProdukten är tänkt att utgöra en samlad källa till rådata för tolkning och analys av Sveriges grundvattenkvalitet över tid och rum. Det bör dock understrykas att materialet hittills företrädesvis omfattar data från områden som inte är lokalt påverkade och/eller förorenade. Ambitionen är dock att utöka denna produkt med mer och annan typ av data avseende grundvattnets kvalitet, vilket denna produkt i och med harmonisering med datavärdskap för miljögifter ger stöd för."},{"@language":"sv","@value":"Informationen kan användas som referensmaterial för beskrivningen av miljötillståndet, uppföljning av miljömålen samt som stöd i arbetet enligt vattenförvaltningsförordningen"}],"dct:identifier":"7e7585a2-3ebd-427f-83d0-fdb1e2527502","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b1n0"},"dct:temporal":{"@id":"_:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962_b2n0"},"dct:title":{"@language":"sv","@value":"Grundvattenkvalitet, analysresultat och provplatser (version 2)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:17580c5e-21fb-a5f7-2dad-8db846675cfb","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/grundvattenkvalitet-analysresultat-provplatser-v2/ogc/features/v1?"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:2118a2db-1ff8-c7cf-6812-fa6e8a9c69bb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/miljoovervakning_grundvatten"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Nationell miljöövervakning, grundvattenkemi,Regional miljöövervakning, grundvattenkemi"},"dct:title":{"@language":"sv","@value":"grundvatten:SE.GOV.SGU.NATIONELL_MILJOOVERVAKNING_GRUNDVATTEN_VY,grundvatten:SE.GOV.SGU.REGIONAL_MILJOOVERVAKNING_GRUNDVATTEN_VY"}},{"@id":"urn:uuid:bd0bebf2-9e1e-72e1-5055-05bbd05ad527","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattenkvalitet-analysresultat-provplatser-v2-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:cb0c2ba5-fa93-56bd-52f3-cd625e9cf8b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/grundvattenkvalitet-analysresultat-provplatser-v2/grundvattenkvalitet-analysresultat-provplatser-v2.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:fc60ce54-1a78-6772-f19b-eaf7fb52fb59","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/grundvatten/miljoovervakning-av-grundvatten/kartvisare-och-diagram-for-miljoovervakning-av-grundvattenkemi/"},"dct:description":{"@language":"sv","@value":"Kartvisare för miljöövervakning grundvattenkemi. Gränssnittet erbjuder statistiska funktioner och nedladdning av tidsseriedata."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:ff07c368-633b-a7f4-fb31-9b346bb66846","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/grundvatten/miljoovervakning-av-grundvatten/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Webbplats Miljöövervakning grundvatten"}}],"@id":"urn:source:1305f6d3aeee898eb787c43875077c278dbaf390e614e469bf4b981100f7a962"},{"@graph":[{"@id":"_:13146751cca21e7d57e1925ff90f6650a14ee14a786ed3c021b028b4bbe32704_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från och med 2014 t.o.m. 2018 genomfördes flygfotografering med 0.48 m upplösning i fjällen och Sveriges inland, samt med 0.24 m upplösning i södra Sverige, längs Norrlandskusten och över ett antal tätorter i inlandet. Tidigare genomfördes flygfotografering med 0.24 m upplösning endast över ett antal tätorter. (Se tjänsten Geolex som finns på www.lantmateriet.se) Distinkta objekt på marken (taknockar, murhörn, större brunnar, vägmarkeringar etc.) ska ha en lägesnoggrannhet på högst 0,6 meter i plan och 0,8 meter i höjd för 0,48-bilder samt 0,3 respektive 0,4 för 0,24-bilder (uttryckt som medelfel) för att uppfylla Lantmäteriets krav på datamängden. \nFrån och med 2019 genomförs flygfotografering med 0.37 m upplösning i fjällen och Sveriges inland, samt med 0.15 m upplösning i södra Sverige, längs Norrlandskusten och över ett antal tätorter i inlandet. (Se tjänsten Geolex som finns på www.lantmateriet.se/geolex). Distinkta objekt på marken (taknockar, murhörn, större brunnar, vägmarkeringar etc.) ska ha en lägesnoggrannhet på högst 0,5 meter i plan och 0,7 meter i höjd för 0,37-bilder samt 0,2 respektive 0,25 för 0,15-bilder (uttryckt som medelfel) för att uppfylla Lantmäteriets krav på datamängden."}},{"@id":"_:13146751cca21e7d57e1925ff90f6650a14ee14a786ed3c021b028b4bbe32704_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/944474f5-737e-4cac-bf41-318d13bc4de6","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:fb0b22ee-8b4b-561c-94e7-4efa4067aa4f"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Bildgeometri i form av Ori-filer från Match-AT till flygbilder med upplösningarna 0.15 m, 0.24 m, 0,37 m och 0.48 m."},"dct:identifier":"944474f5-737e-4cac-bf41-318d13bc4de6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:13146751cca21e7d57e1925ff90f6650a14ee14a786ed3c021b028b4bbe32704_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:13146751cca21e7d57e1925ff90f6650a14ee14a786ed3c021b028b4bbe32704_b1n0"},"dct:title":{"@language":"sv","@value":"Flygbilder Nedladdning, orienteringsdata"}},{"@id":"urn:uuid:fb0b22ee-8b4b-561c-94e7-4efa4067aa4f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/flygbilder-nedladdning"},"dct:description":{"@language":"sv","@value":"Mer information om produkten finns att tillgå på Lantmäteriets webbplats."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets webbplats"}}],"@id":"urn:source:13146751cca21e7d57e1925ff90f6650a14ee14a786ed3c021b028b4bbe32704"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/32c0f222-5a8c-48c6-afee-325d81b584b8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/data/service/wms/130/ballast"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Syftet med visningstjänsten Ballast är att samla olika typer av information från SGU som har betydelse för planeringen av samhällets ballastförsörjning."},{"@language":"sv","@value":"Visningstjänsten Ballast innehåller information som har betydelse för planeringen av samhällets ballastförsörjning. Informationen erbjuder ett geologiskt underlag för såväl myndigheter i deras arbete med planering av materialförsörjning och tillståndsgivning av täkter som ballastbranschens planering inför nya täkter.\n\nTjänsten innehåller information om berg av olika kvaliteter med avseende på väg, betong och järnväg. Tekniska analyser och glimmerhalter redovisas som punktinformation. Naturgrusavlagringar redovisas dels med avseende på materialsammansättning och dels med klassning av natur/geovetenskapligt värde. Tjänsten innehåller även information om förekomster av morän och tillståndsgivna täkter."}],"dct:identifier":"32c0f222-5a8c-48c6-afee-325d81b584b8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Ballast (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:1360eabf67e9227a888228f29026cd5553a3c374c035f90f75bc97698036dcfb"},{"@graph":[{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skapad av Sjöfartsverket på begäran från HaV"}},{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((4.6098287142719325 67.60002896375278,22.94136816878584 67.60002896375278,22.94136816878584 54.4804042479978,4.6098287142719325 54.4804042479978,4.6098287142719325 67.60002896375278))"}},{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/163384e2-09ec-f4fb-57bd-7779760b64c4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:450a8c02-39c4-1af7-e72d-75e210e7ab51"},"dcat:distribution":[{"@id":"urn:uuid:09c4366a-30a8-0e60-ec3a-5f7a48fbb42b"},{"@id":"urn:uuid:6e297bcc-6a9a-f349-2c58-35a5532074bf"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En linje dragen en nautisk mil utanför den svenska baslinjen. Finns som både punkt- och linjelager."},"dct:identifier":"163384e2-09ec-f4fb-57bd-7779760b64c4","dct:issued":{"@type":"xsd:date","@value":"2023-09-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-09-14"},"dct:provenance":{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b1n0"},"dct:title":{"@language":"sv","@value":"Baslinje + 1 nautisk mil"}},{"@id":"urn:uuid:09c4366a-30a8-0e60-ec3a-5f7a48fbb42b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/baslinje-plus-en-nautisk-mil/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Baslinje + en nautisk mil"}},{"@id":"urn:uuid:450a8c02-39c4-1af7-e72d-75e210e7ab51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Vattenmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Vattenmiljöenheten"},{"@id":"urn:uuid:6e297bcc-6a9a-f349-2c58-35a5532074bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/baslinje-plus-en-nautisk-mil/2023-08-29/baslinje-plus-en-nautisk-mil-2023-08-29.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Baslinje + en nautisk mil"}}],"@id":"urn:source:1370e43923c47e117b34efbd7bcd8f1d795ac205159e5a497db8cee51ecfc30c"},{"@graph":[{"@id":"_:13e0b43795fe5417ce1a0d108eec5a95732297bb570c97f54e3ddba3bd2dacb6_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bakgrundskartor skapade av aggregerad data från Open Street Map, Lantmäteriet, Natural Earth"}},{"@id":"_:13e0b43795fe5417ce1a0d108eec5a95732297bb570c97f54e3ddba3bd2dacb6_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5.808165173226979 70.38965366895914,24.914067281103787 70.38965366895914,24.914067281103787 53.76949578989519,5.808165173226979 53.76949578989519,5.808165173226979 70.38965366895914))"}},{"@id":"_:13e0b43795fe5417ce1a0d108eec5a95732297bb570c97f54e3ddba3bd2dacb6_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/30ccc06f-79bb-9a62-67af-1449a26f1791","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f54c7eec-56da-1c4b-eac5-97912c338cdc"},"dcat:distribution":{"@id":"urn:uuid:46ed8dc5-e24e-5fbc-5732-4ea7ee75ac4e"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Informationsmängden innehåller global utbredning av land, hav och vatten samt större orter i världen. Informationsmängden täcker hela världen men på en översiktlig nivå och är tänkt att användas från världstäckande kartor ner till skala 1:100 000.\nInformationsmängden är framtagen för att utgöra innehållet i en enklare, översiktlig, global bakgrundskarta. Denna bakgrundskarta är tänkt att användas som förval i Havs- och vattenmyndighetens GIS-verktyg, kartmallar och webbkartor. \nInformationsmängden är framtagen i syfte att tillhandahållas som färdig visningstjänst, internt och externt, via Havs-och vattenmyndighetens publika karttjänstemiljö."},"dct:identifier":"30ccc06f-79bb-9a62-67af-1449a26f1791","dct:issued":{"@type":"xsd:date","@value":"2024-04-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-26"},"dct:provenance":{"@id":"_:13e0b43795fe5417ce1a0d108eec5a95732297bb570c97f54e3ddba3bd2dacb6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:13e0b43795fe5417ce1a0d108eec5a95732297bb570c97f54e3ddba3bd2dacb6_b1n0"},"dct:title":{"@language":"sv","@value":"HaV Bakgrundskartor"}},{"@id":"urn:uuid:46ed8dc5-e24e-5fbc-5732-4ea7ee75ac4e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/hav-bakgrundskartor/wms"},"dct:format":{"@id":"http://publicat