e"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:eee0c7f79df84cc464702d36dc1f8701a8ce058bb8c88a6f33fa309867c3e78e_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:eee0c7f79df84cc464702d36dc1f8701a8ce058bb8c88a6f33fa309867c3e78e"},{"@graph":[{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Finns dokumenterad i länkat dokument"}},{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.20993 57.1885,14.63167 57.1885,14.63167 55.38151,12.20993 55.38151,12.20993 57.1885))"}},{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/5ccd73b3-e421-498d-bf58-1e6f4f75298d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b"},"dcat:distribution":[{"@id":"urn:uuid:2377975f-a8ad-1793-9bab-6989398bdef1"},{"@id":"urn:uuid:50fc1e57-af1d-68d4-4a0e-5f60faa0eace"},{"@id":"urn:uuid:713c6251-32a2-7721-856c-392e78f9fe59"},{"@id":"urn:uuid:714c18d0-9b0b-3f01-88e5-9a36c5f0ed4c"},{"@id":"urn:uuid:d9e19a05-839f-75e4-e2d5-7dcbcdf4682b"},{"@id":"urn:uuid:f547deae-a21b-ecc3-d734-83f556423b73"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Länsstyrelsernas skikt över sjöar passande för skopning med skogsbrandflyg, flygplan och helikopter. Sjöarna är ett urval (ca 40000 st) där ca 3600 st är teoretiskt sett möjliga att använda för flygplanskopning. Sedan anger varje län baserat efter okulär besiktning av ortofoton och andra grunddata om sjöarna är lämpliga för vilket flygcertifikatstyp (alfa, bravo, charlie) och om de är lämpliga för skopning med helikopter.\n\nSjöarna har även klassats om de berör skyddad natur såsom nationalpark, naturreservat, natura2000, djur- och växtskydd, tillträdesförbud, vattenskydd, artskydd mm. Djup från SMHIS sjöregister samt ett index på deras flikighet.\n\nMer utförlig metodbeskrivning finns via länk i metadataposten."},"dct:identifier":"5ccd73b3-e421-498d-bf58-1e6f4f75298d","dct:issued":{"@type":"xsd:date","@value":"2020-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-09-14"},"dct:provenance":{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b1n0"},{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b2n0"}],"dct:title":{"@language":"sv","@value":"LST Sjöar för skogsbrandflyg - Extern visning"}},{"@id":"urn:uuid:2377975f-a8ad-1793-9bab-6989398bdef1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_skogsbrandflyg/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Sjöar för skogsbrandflyg - flygplan (REST-tjänst)"}},{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällskydd och beredskap","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo.samhallsskydd.och.beredskap@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällskydd och beredskap"},{"@id":"urn:uuid:50fc1e57-af1d-68d4-4a0e-5f60faa0eace","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geoportal.lansstyrelsen.se/standard/?appid=154655c2463b461bb6a18f59cd4e122d"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Sjöar för skogsbrandflyg - Webbkarta visning"}},{"@id":"urn:uuid:713c6251-32a2-7721-856c-392e78f9fe59","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Referensdokument/Dokumentation_och_process_for_framtagande-LST_Sjoar_for_brandflyg.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Dokumentation_och_process_for_framtagande-LST_Sjoar_for_brandflyg.pdf"}},{"@id":"urn:uuid:714c18d0-9b0b-3f01-88e5-9a36c5f0ed4c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/lst_skogsbrandflyg/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LST Sjöar för skogsbrandflyg (WMS-tjänst)"}},{"@id":"urn:uuid:d9e19a05-839f-75e4-e2d5-7dcbcdf4682b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.LST_sjoar_brandflyg_och_helikopter_ext.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:f547deae-a21b-ecc3-d734-83f556423b73","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_skogsbrandflyg/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Sjöar för skogsbrandflyg - helikopter (REST-tjänst)"}}],"@id":"urn:source:ef05bd8a05b84eca5f4bd4d3f7c0a855392eb4888d7c598e133f1d8da90ce3b4"},{"@graph":[{"@id":"_:ef22c984851e6779e4d1a9ca09b30b99d777d750a682d938da1a8cbfb0d510d5_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/29573aec-5dc2-fc71-a46f-a58115eee269","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/download/provningsgrupper-for-vattenkraftverk/atom-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Prövningsgrupper för vattenkraftverk."},"dct:identifier":"29573aec-5dc2-fc71-a46f-a58115eee269","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Prövningsgrupper för vattenkraftverk.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ef22c984851e6779e4d1a9ca09b30b99d777d750a682d938da1a8cbfb0d510d5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"}],"@id":"urn:source:ef22c984851e6779e4d1a9ca09b30b99d777d750a682d938da1a8cbfb0d510d5"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2e1c50bb-5b68-4b0e-aff6-ac2f49d19fdc","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/historiska-strandlinjer"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Historiska strandlinjer visar strandlinjens läge längs Skånes kust som den tolkats från ortofoton från olika år. Som underlag har använts Lantmäteriets rektifierade historiska ortofoton samt ortofoton från 1939–1940 från Geocentrum, Lunds universitet. De flesta av Lantmäteriets ortofoton är sammansatta av en mosaik av bilder från olika årtal. I de fallen har en uppdelning efter årtal gjorts och bilderna har grupperats i decennier avseende flygår. Bilderna finns från 1970-talet, 1960-talet, 1950-talet och 1939-40 och täcker in större delen av den skånska kusten.\n\nTjänsten innehåller också en analys av hur strandlinjen förändrats från 1940 till 2010."},"dct:identifier":"2e1c50bb-5b68-4b0e-aff6-ac2f49d19fdc","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Historiska strandlinjer (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f095948f3dfcd11e55b97cdc3b3061f43db471c5171d374b748aa1d2278f8e8b"},{"@graph":[{"@id":"_:f1b94e3fb233d10c861e65b574f9725a09787e70de6c98d2c92b1edb2cd3de4a_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:f1b94e3fb233d10c861e65b574f9725a09787e70de6c98d2c92b1edb2cd3de4a_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/08f0ee60-02c3-40d4-a3f7-77dfddbf5cf9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:endpointURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/atom-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Atom-nedladdningstjänst"},"dct:identifier":"08f0ee60-02c3-40d4-a3f7-77dfddbf5cf9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst ATOM Inspire"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f1b94e3fb233d10c861e65b574f9725a09787e70de6c98d2c92b1edb2cd3de4a_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f1b94e3fb233d10c861e65b574f9725a09787e70de6c98d2c92b1edb2cd3de4a_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"}],"@id":"urn:source:f1b94e3fb233d10c861e65b574f9725a09787e70de6c98d2c92b1edb2cd3de4a"},{"@graph":[{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ytorna är hämtade från olika andra inventeringar och är inte inmätta i fält. För vissa områden är avgränsningen bara en grov avgränsning av\nutredningsområde medan för andra, där större utredning skett, är gränsen mer noggrann."}},{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.2988 57.2386,15.8367 57.2386,15.8367 56.3591,13.2988 56.3591,13.2988 57.2386))"}},{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.30497 57.18739,15.71508 57.18739,15.71508 56.39658,13.30497 56.39658,13.30497 57.18739))"}},{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/03ab7c1d-52a0-467a-ad4d-d013e51ea4d7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761"},"dcat:distribution":[{"@id":"urn:uuid:3850923f-65ac-9874-78ae-0fb1fef32d9b"},{"@id":"urn:uuid:e5a8d2c9-421d-a854-8bab-fac4a8960800"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Länsstyrelsen beslutade den 5 september 2018 om ”Plan för skydd av värdefull natur i Kronobergs län 2018–2022”. Planen redovisar vilka områden som Länsstyrelsen och kommunerna utreda för formellt skydd av värdefulla naturmiljöer. Syftet med planen är att bidra till öppenhet, skapa framförhållning, göra nödvändiga prioriteringar och presentera hur aktuella miljömål ska kunna nås. Planen ska styra och underlätta arbetet men är inte bindande. Beslutet om plan är förlängt tom 2025. \n\nGIS-skiktet visar vilka ytor som ingår i planen, men observera följande: \n- Detta är en plan- det går inte att i förväg förutse exakt vilka områden som i slutänden blir föremål för formellt skydd eftersom detta beror av flera faktorer som klarläggs vid närmre utredning t.ex. vilka naturvärden som finns vid närmre fältinventering och berörda fastighetsägares önskemål om typ av avsättningar. Det påverkas också av vilka önskemål om skydd som kommer in från fastighetsägare, vilka områden som bjuds ut till\nförsäljning, m.m.\n\n-För vissa områden är avgränsningen bara en grov avgränsning av\nutredningsområde medan för andra, där större utredning skett, är gränsen mer noggrann."},"dct:identifier":"03ab7c1d-52a0-467a-ad4d-d013e51ea4d7","dct:issued":{"@type":"xsd:date","@value":"2024-01-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-01-15"},"dct:provenance":{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b1n0"},{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b2n0"}],"dct:title":{"@language":"sv","@value":"LstG Områdesskyddsplan"}},{"@id":"urn:uuid:3850923f-65ac-9874-78ae-0fb1fef32d9b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_naturskydd_ext/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Naturskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Naturskydd"},{"@id":"urn:uuid:e5a8d2c9-421d-a854-8bab-fac4a8960800","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.Omradesskyddsplan.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:f342e272dacfe8eaa5853a21fa58b01153b76c82a5a1aa0789c5b83f77ebd2ef"},{"@graph":[{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kartbilden grundas på sammanställning och digitalisering av äldre undersökningsmaterial (exempelvis fältkartor från tidigare undersökningar, tidigare flygbildstolkningar och NSG (Nämnden för statens gruvegendomar) kompletterat med flygbildstolkning med stöd av fältobservationer längs det glesa vägnätet. Inom fjällområdet har fältkontroller gjorts utifrån flyg och helikopterrekognosering.\nSammanställningen av kartan avslutades 2011, efter att ha pågått i ca 10 år.  Projektledare har varit Robert Lagerbäck.\n\nUnderlag som använts för vattenmask och länsgräns är GSD översiktskarta.\nLägesnoggrannheten är ca 200 m. Betydligt större fel samt felklassningar kan dock förekomma.\nFelaktiga avgränsningar, felklassningar och förbisedda geologiska objekt kan ge sämre kvalitet på data. Dessa fel, som till stor del beror på hur väl de olika objekten framträder i flygbild, är geografiskt ojämnt fördelade. Lägesfelen i avgränsningarna kan i enskilda fall uppgå till flera hundra meter. Det bör dock poängteras att geologiska gränser sällan är skarpa eller väldefinierade i terrängen. Ofta är det fråga om övergångszoner som kan vara hundratals meter breda. Exempel på felklassningar är att svallningspåverkad morän kodats som svallsediment och vice versa. Generellt är osäkerheten i klassningen större i dalgångar med finsediment än i högre liggande moränterräng.\nDen geologiska informationen har lägesbestämts i förhållande till ett visst topografiskt underlag och får då samma lägesfel som detta. Dessa fel kan bli störande om den geologiska informationen presenteras tillsammans med annan geografisk information. Detta fel torde i de flesta fall understiga 50 m. I undantagsfall har lägesfel i det topografiska underlaget på upp till 100 m konstaterats.\nGeneralisering innebär att man medvetet ritar “fel“ för att öka kartans läsbarhet i en viss skala. Exempel: flera små närliggande objekt kan ritas som ett objekt, en flikig gräns mellan två objekt ritas som en utjämnad linje. Lägesfelen pga. generalisering torde maximalt uppgå till ca 200 m.\nDen geologiska informationen har lägesbestämts i förhållande till ett visst topografiskt underlag och får då samma lägesfel som detta. Dessa fel kan bli störande om den geologiska informationen presenteras tillsammans med annan geografisk information. Detta fel torde i de flesta fall understiga 50 m. I undantagsfall har lägesfel i det topografiska underlaget på upp till 100 m konstaterats."}},{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.52 69.06,24.00 69.06,24.00 65.29,14.52 65.29,14.52 69.06))"}},{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2009"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1999"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/498c902a-3c1c-4c0e-9f94-a972bbf4a638","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:146bd99b-c4e8-e72e-1700-c926c4e2f563"},{"@id":"urn:uuid:2933f41f-211d-8f73-d723-07d1d957dd0f"},{"@id":"urn:uuid:332a8a41-2910-2e4c-c504-fb150f3fe17d"},{"@id":"urn:uuid:5ed3d286-6c6f-e413-7740-350bebe361b6"},{"@id":"urn:uuid:87a30c05-5da7-01de-3c6e-cfe247d783e5"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Kartan Jordarter 1:250 000 nordligaste Sverige täcker nordligaste delen av Sverige och ger en mycket översiktlig bild av jordarternas fördelning och landformer. Kartan kan användas som ett mycket översiktligt planerings- och resurshushållningsunderlag för prospekteringsföretag, länsstyrelse, kommuner m.fl. intressenter. Kartbilden är generaliserad för presentation i skala 1:250 000 och minsta redovisade yta är ca 0,1 km2"},{"@language":"sv","@value":"Kartan kan användas som ett mycket översiktligt planerings- och resurshushållningsunderlag för prospekteringsföretag, länsstyrelse, kommuner m.fl. intressenter."}],"dct:identifier":"498c902a-3c1c-4c0e-9f94-a972bbf4a638","dct:issued":{"@type":"xsd:date","@value":"2011-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b1n0"},"dct:temporal":{"@id":"_:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5_b2n0"},"dct:title":{"@language":"sv","@value":"Jordarter 1:250 000, Nordligaste Sverige"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:146bd99b-c4e8-e72e-1700-c926c4e2f563","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-jordarter-norra-sverige-250-tusen.html"},"dct:description":{"@language":"sv","@value":"Kartvisapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:2933f41f-211d-8f73-d723-07d1d957dd0f","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordarter250k/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:332a8a41-2910-2e4c-c504-fb150f3fe17d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordarter250k/jordarter250k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:5ed3d286-6c6f-e413-7740-350bebe361b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordarter-250000-nordligaste-sverige-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:87a30c05-5da7-01de-3c6e-cfe247d783e5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-norra-sverige-250-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}}],"@id":"urn:source:f36ff3f0d815b7d204a4ed54388a415b19dfea58e61f3406c1b37bdfc936dca5"},{"@graph":[{"@id":"_:f391134b3b7686e9dca0140a5f01d77ab2f15681ecbcf4c2237f3d3c26f59050_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.30519 62.91659,13.94388 62.91659,13.94388 61.94169,13.30519 61.94169,13.30519 62.91659))"}},{"@id":"_:f391134b3b7686e9dca0140a5f01d77ab2f15681ecbcf4c2237f3d3c26f59050_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/f3edbb25-3963-4db9-8ea8-024ae79947e1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:dfa0147e-e99b-9d26-ff15-3ec11abdd083"},"dcat:distribution":[{"@id":"urn:uuid:54539347-906e-08ca-4a4d-f3261c4bbb4f"},{"@id":"urn:uuid:e72a67a4-086e-d5e6-7702-d84fbdaba067"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Syftet med projektet ”Biologiskt kulturarv vid fäbodmiljöer” som sedan resulterade i aktuell rapport, var att öka kunskapen och förståelsen av värdet av det biologiska kulturarvet och fortsatt fäbodbruk i Jämtlands län. Rapporten innehåller en inventering av fjällnära fäbodar med kontinuerlig betesdrift och inslag av traditionell fäboddrift samt en beskrivning av berörda fäbodars bevarandevärden. Berörda fäbodar är lokaliserade i Berg, Härjedalen och Krokoms kommuner. Fäbodbruket utgör en stor del av vår kulturhistoria som också har avspeglat sig i naturen.\n\nKartskiktet är ett komplement till rapporten och pekar ut området runt de fäbodvallarna som ingår i rapporten. Kartskiktets huvudsyfte är att flagga områdena som nämns i rapporten för att tillsammans med rapporten få kunskap om fäbodarna och deras värden. \n\nUnderlaget kan användas främst inom översiktsplanering. Det kan även användas vid andra större exploateringar i fjällnära miljö, vid bildande av naturreservat eller åtgärder kopplat till friluftsliv."},"dct:identifier":"f3edbb25-3963-4db9-8ea8-024ae79947e1","dct:issued":{"@type":"xsd:date","@value":"2024-02-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-02-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:f391134b3b7686e9dca0140a5f01d77ab2f15681ecbcf4c2237f3d3c26f59050_b0n0"},"dct:title":{"@language":"sv","@value":"LstZ Biologiskt kulturarv fäbodar"}},{"@id":"urn:uuid:54539347-906e-08ca-4a4d-f3261c4bbb4f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lansstyrelsen.se/store/35/resource/2017_22"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biologiskt kulturarv vid fäbodmiljöer"}},{"@id":"urn:uuid:dfa0147e-e99b-9d26-ff15-3ec11abdd083","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstZ Samhällsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f391134b3b7686e9dca0140a5f01d77ab2f15681ecbcf4c2237f3d3c26f59050_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jamtland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstZ Samhällsenheten"},{"@id":"urn:uuid:e72a67a4-086e-d5e6-7702-d84fbdaba067","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstz.LstZ_biologiskt_kulturarv_fabodar.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:f391134b3b7686e9dca0140a5f01d77ab2f15681ecbcf4c2237f3d3c26f59050"},{"@graph":[{"@id":"_:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73f0f795fa_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sammanslagning av regionala skikt och baseras på brytpunkter som finns i annat skikt."}},{"@id":"_:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73f0f795fa_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0618,24.2195 69.0618,24.2195 54.9805,10.0301 54.9805,10.0301 69.0618))"}},{"@id":"_:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73f0f795fa_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59207701286 69.059970495251,24.177674044859 69.059970495251,24.177674044859 55.35172137072,10.59207701286 55.35172137072,10.59207701286 69.059970495251))"}},{"@id":"_:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73