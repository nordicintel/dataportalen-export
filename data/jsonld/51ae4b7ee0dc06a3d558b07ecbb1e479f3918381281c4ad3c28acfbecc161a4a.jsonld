jö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:7e7b3a91-4dc0-5f76-9e42-5019f160e08b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/12"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:fdb5d174-09a7-a43e-b2f6-9c91abcd2563","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.Flottade_sjoar_Kronoberg.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47"},{"@graph":[{"@id":"_:a1dd921dedf70733c9d3faa6b2b5e6e42f6b00f277739af4cbb1713fbbee9134_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Laserskanning från flygplan med upplösningen 1-2 punkter/kvm. Kvalitetsgranskning och klassificering av laserpunkter till mark, vatten, bro (klassificeringsnivå 3), low point (noise), high noise (punkter som registrerats ovan mark, vegetation, byggnad - exempelvis moln) samt oklassificerat."}},{"@id":"_:a1dd921dedf70733c9d3faa6b2b5e6e42f6b00f277739af4cbb1713fbbee9134_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/9b896e4a-e604-468d-9a4e-ae1b6695d80c","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:1f9d7c91-179b-d18d-aff8-73991ef63927"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Laserdata Nedladdning, skog innehåller ett punktmoln med klassificerade punkter baserat på flygburen laserskanning från 2018 och framåt med en punkttäthet av 1-2 punkter per kvadratmeter. Tidigare hette produkten Laserdata Skog."},"dct:identifier":"9b896e4a-e604-468d-9a4e-ae1b6695d80c","dct:issued":{"@type":"xsd:date","@value":"2018-08-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{