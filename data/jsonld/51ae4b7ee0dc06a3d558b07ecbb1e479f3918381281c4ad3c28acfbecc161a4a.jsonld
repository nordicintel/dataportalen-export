58e06005cbe","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Prövningsgrupper för vattenkraftverk.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:24ea53a231a4b90134c92a42b2bd15fb49854d42a6273e8089483ba28f0e0020_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"}],"@id":"urn:source:24ea53a231a4b90134c92a42b2bd15fb49854d42a6273e8089483ba28f0e0020"},{"@graph":[{"@id":"_:24f27c234a13e1adf3e98543b619f8c545da320aac77c0c7340c3ca6882f4c5d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Beräkningen av hydraulisk konduktivitet, K, baseras på uppgifter om brunnskapacitet, djup, brunnstyp med mera i SGU:s Brunnsarkiv samt flera antaganden. Beräkningarna inkluderar också en djupnormering av K i syfte att underlätta jämförelser av områden med olika brunnsdjup. I praktiken innebär det att de resultat som presenteras för brunnar och karta antas representera hydraulisk konduktivitet i berg inom 100 m från markytan med undantag för den allra översta delen av berggrunden eftersom den delen i brunnarna som regel är tätad med foderrör.\n\nMetoden som använts och diskussion om osäkerheter, begränsningar och användning av resultat redovisas mer utförligt i SGU-rapport 2021:09 (Hjerne m.fl. 2021). \n\nProdukten är ett resultat av en beräkning baserad på brunnsdata som i sig kan vara osäkra samt en interpolering av dessa data. Osäkerheten i indata bedöms kunna vara betydande för en enskild brunn. Detta medför att osäkerheten i interpolerad hydraulisk konduktivitet i områden med få brunnar bör vara betydande.\n\nVid användning av data är det på grund av osäkerheter mycket viktigt att vara försiktig med slutsatser eller vidare beräkningar baserat på ett fåtal brunnar eller interpolerade resultat i områden med få brunnar. Eftersom tätheten av brunnar är mycket varierande i Sverige är det därmed också mycket svårt att specificera vilken skala som är lämplig vid användning av data. SGU:s bedömning är att produkten i alla fall inte ska användas i större skala än (dvs inte mer förstorat än) 1:100 000."}},{"@id":"_:24f27c234a13e1adf3e98543b619f8c545da320aac77c0c7340c3ca6882f4c5d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/02d62bbb-f00c-44d3-972f-c1037d445ee6","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:163744bb-5e03-310c-bebe-15f49dbc6fa2"},{"@id":"urn:uuid:3421f406-14fc-1cd0-5185-24d85a50e270"},{"@id":"urn:uuid:8fa82c88-8b6d-ac51-d917-ed61bd4b38e5"},{"@id":"urn:uuid:90be85a1-5727-db03-b129-42931707774d"},{"@id":"urn:uuid:b6fbfa34-5a7f-2f23-552d-a3abc0c53694"},{"@id":"urn:uuid:c1e43d1d-6dca-55d2-d08d-5e7a5508d61f"},{"@id":"urn:uuid:d9d19088-e35b-3aa6-b9d3-2ac50ee879c1"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Datamängden ”Hydraulisk konduktivitet i berg” inkluderar beräknad hydraulisk konduktivitet (K) i berget närmast bergborrade brunnar från Brunnsarkivet samt en interpolation av dessa värden. Förutom osäkerhet i indata ingår dessutom ett antal antaganden i beräkningarna, vilket medför en viss osäkerhet i slutresultatet. Osäkerheten i beräknad hydraulisk konduktivitet kan vara betydande för en enskild brunn. Detta medför att osäkerheten i interpolerad hydraulisk konduktivitet i områden med få brunnar är stor.\n\nProdukten vänder sig framför allt till specialister inom hydrogeologi. Den kan användas som underlag för hydrogeologiska utredningar där grundvatten i berg är en viktig faktor att ha hänsyn till, till exempel enskild vattenförsörjning, tunnlar, bergtäkter och gruvor. På grund av de osäkerheter och begränsningar som finns i underlaget samt syfte och krav på utredningen kan det krävas kompletterande undersökningar. Men även i dessa fall kan datamängden vara värdefull vid inledande utredningar.\n\nInterpolationen omfattar en rikstäckande beräkning och resultatet presenteras i enheten m/s (meter per sekund) i ett raster med cellstorlek på 100x100 m. Beräknad hydraulisk konduktivitet i berg omfattar den delmängd av bergborrade brunnar i Brunnsarkivet som SGU bedömer det är rimligt att använda för detta syfte."},"dct:identifier":"02d62bbb-f00c-44d3-972f-c1037d445ee6","dct:issued":{"@type":"xsd:date","@value":"2021-02-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:24f27c234a13e1adf3e98543b619f8c545da320aac77c0c7340c3ca6882f4c5d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:24f27c234a13e1adf3e98543b619f8c545da320aac77c0c7340c3ca6882f4c5d_b1n0"},"dct:title":{"@language":"sv","@value":"Hydraulisk konduktivitet i berg"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:163744bb-5e03-310c-bebe-15f49dbc6fa2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/hydraulisk-konduktivitet-berg/wcs?service=WCS&request=GetCapabilities&version=2.0.1"},"dct:title":{"@language":"sv","@value":"Capabilitiesdokument OGC Web Coverage Service"}},{"@id":"urn:uuid:3421f406-14fc-1cd0-5185-24d85a50e270","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/genomslapplighet-berg?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Services"}},{"@id":"urn:uuid:8fa82c88-8b6d-ac51-d917-ed61bd4b38e5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/hydraulisk-konduktivitet-berg/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:90be85a1-5727-db03-b129-42931707774d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hydraulisk-konduktivitet-berg-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:b6fbfa34-5a7f-2f23-552d-a3abc0c53694","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/publikation/sgurapport/sgurapport202109rapport/s2109-rapport.pdf"},"dct:description":{"@language":"sv","@value":"Externt publicerade SGU-rapporter i PDF-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU-rapporter"}},{"@id":"urn:uuid:c1e43d1d-6dca-55d2-d08d-5e7a5508d61f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-hydraulisk-konduktivitet.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:d9d19088-e35b-3aa6-b9d3-2ac50ee879c1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/hydraulisk-konduktivitet-berg/hydraulisk-konduktivitet-berg.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:24f27c234a13e1adf3e98543b619f8c545da320aac77c0c7340c3ca6882f4c5d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/852b1dfd-f47e-49f8-bcd3-1a3313ec8a42","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Fritidshusområden definieras som koncentrerad bebyggelse med minst 50 fritidshus. Fritidshus definieras som småhus utan folkbokförd befolkning. Fritidshusområden kan överlappa SCB:s statistiska tätorter och småorter. Geodata är polygoner. Den första årsversionen avser 2000. Uppdatering har gjorts vart femte år, vilket ger fem versioner till och med 2020."},"dct:identifier":"852b1dfd-f47e-49f8-bcd3-1a3313ec8a42","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Fritidshusområden WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:25706885fa698250b5669188eabfd67e100eb2bc4f673f53db27305c0a476020"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004573","@type":"foaf:Agent","dct:identifier":"2021004573","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:kansli@sametinget.se"},"foaf:name":{"@language":"sv","@value":"Sametinget"},"foaf:page":{"@id":"https://www.sametinget.se"}},{"@id":"https://www.geodata.se/resources/57913449-08fa-4e6d-b207-98fa0cba9c33","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://gisportal.sametinget.se/server/services/INSPIRE/Renskotselomr/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"WMS- tjänsten visar renskötselns ungefärliga utbredning i Sverige och är Sametingets sätt att ge en konceptuell bild av var renskötselrätt i dagsläget utövas och kan anses föreligga med stöd av bl.a. urminnes hävd. För vissa områden råder det oenighet om renskötselrättens utbredning. Till stöd för underlaget har Gränsdragningskommissionens utredning (SOU2006:14) använts. Den avsåg att ge vägledning när det gäller var renskötselrätt i större eller mindre grad kan föreligga. Den sammanställning av kunskapsunderlag som utredningen gjorde är omfattande och kan användas för att ge fingervisningar om renskötselrätten utbredning, även om utredningens slutsatser och ställningstaganden kan ifrågasättas. \nFör vidare rättslig information av relevans för tolkning av datamängden hänvisas till rennäringslagen och avgöranden i allmän domstol."},"dct:identifier":"57913449-08fa-4e6d-b207-98fa0cba9c33","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004573"},"dct:title":{"@language":"sv","@value":"Renskötselområdets ungefärliga utbredning i Sverige Inspire visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:2576e21bcb14b16291cc75b742c40a1668182dc23451811dd993d4a84a1e3a15"},{"@graph":[{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.25653 60.50951,14.35791 60.50951,14.35791 59.17563,12.25653 59.17563,12.25653 60.50951))"}},{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/4b0dd9e8-d915-47c7-93a9-bd061d58b1fa","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d"},"dcat:distribution":[{"@id":"urn:uuid:24e45f99-dcc0-6b4a-ffb0-87977f35fafd"},{"@id":"urn:uuid:8e792b45-b653-0b52-0758-c7f1115973db"},{"@id":"urn:uuid:ce8f97f7-afde-4ec1-3c67-62df17173d16"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Sammanställning av påträffade objekt i samband med inventering av kulturmiljöer längs vattendrag i Värmlands län inom projektet VaKul. Inventeringarna genomfördes 2011-2016. Sammanställningen gjordes inför ett analysarbete 2016."},"dct:identifier":"4b0dd9e8-d915-47c7-93a9-bd061d58b1fa","dct:issued":{"@type":"xsd:date","@value":"2012-12-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-12-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b0n0"},{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Vattenförvaltning och kultur (VaKul) inventering (linjeobjekt)"}},{"@id":"urn:uuid:24e45f99-dcc0-6b4a-ffb0-87977f35fafd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.LstS_inventering_kulturmiljovarden_vattendrag_linje.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:8e792b45-b653-0b52-0758-c7f1115973db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Kultur_faktaunderlag_ext/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:ce8f97f7-afde-4ec1-3c67-62df17173d16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_LSTS.LstS_inventering_kulturmiljovarden_vattendrag_linje.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"}],"@id":"urn:source:25bc011c394917b2eeeeaf78206bda5da142773d0f6a1e8a6df5986fb5534d22"},{"@graph":[{"@id":"_:263d17b334b7f874547ddca7730c8fd0fa8bfbcfc16650a5d61437911d6780fa_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"IT-systemet som används för att registrera och lagra sjövägsdata, dvs nätanknuten sjövägsdata, för sjövägsnätet är Sjövägsdatabasen. WaterwayLink genereras från noder i Sjöfartsverkets sjövägsnät utan bearbetning. Mappningen mellan Inspire WaterwayLink och Sjöfartsverkets sjövägsdata är fullständig."}},{"@id":"_:263d17b334b7f874547ddca7730c8fd0fa8bfbcfc16650a5d61437911d6780fa_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/797e411c-be30-48a3-bf6c-44cb35e9cd8a","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:7fe3bcae-78fa-2f79-26ec-11bdebbf5d87"},"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Transportnät"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/tn"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden redovisar länkar i sjövägsnätet enligt Inspiretema transportnät (TN) WaterwayLink. Datamängden går att komma åt via wms och wfs."},"dct:identifier":"797e411c-be30-48a3-bf6c-44cb35e9cd8a","dct:issued":{"@type":"xsd:date","@value":"2020-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-11-24"},"dct:provenance":{"@id":"_:263d17b334b7f874547ddca7730c8fd0fa8bfbcfc16650a5d61437911d6780fa_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:263d17b334b7f874547ddca7730c8fd0fa8bfbcfc16650a5d61437911d6780fa_b1n0"},"dct:title":{"@language":"sv","@value":"TN.Water.WaterwayLink"}},{"@id":"urn:uuid:7fe3bcae-78fa-2f79-26ec-11bdebbf5d87","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjöfartsverkets webbplats"}}],"@id":"urn:source:263d17b334b7f874547ddca7730c8fd0fa8bfbcfc16650a5d61437911d6780fa"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/736a17f7-8bea-457c-880d-dd1423878c89","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetspris?view=oversikt"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten Fastighetsprisuttag ger dig möjlighet att beställa fastighetsprisinformation i digital form för integrering i dina egna system. Informationen levereras enligt fastighetsprisformatet som textfiler."},"dct:identifier":"736a17f7-8bea-457c-880d-dd1423878c89","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighetsprisuttag"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:2640772ce7dace32561c34e25298c4a2be8fd54d0642a9c9373eab39abc63808"},{"@graph":[{"@id":"_:2659f8e754dc4b20dfb974b6280f65aa490aadbb16254759c92023e9e0f261d3_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/1e616565-7089-089f-50f0-b209458eb652","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:670748b3-06da-23a5-3bb7-ff65485777c5"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Övervakning av impulsivt buller genom insamling av uppgifter från utförare av bullrande aktiviteter till havs. Nationellt datavärdskap för impulsivt undervattensbuller saknas. Tills vidare lagrar HaV de rådata som samlas in och levererar dem till Ices som fungerar som internationell datavärd för impulsivt undervattensbuller.\nHos Ices presenteras årliga datasammanställningar på karta och data kan laddas ner kostnadsfritt."},"dct:identifier":"1e616565-7089-089f-50f0-b209458eb652","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Impulsivt undervattensbuller"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2659f8e754dc4b20dfb974b6280f65aa490aadbb16254759c92023e9e0f261d3_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:670748b3-06da-23a5-3bb7-ff65485777c5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.ices.dk/data/data-portals/Pages/impulsive-noise.aspx"},"dct:description":{"@language":"sv","@value":"Nationellt datavärdskap för impulsivt undervattensbuller saknas. Tills vidare lagrar HaV de rådata som samlas in och levererar dem till Ices som fungerar som internationell datavärd för impulsivt undervattensbuller.\nHos Ices presenteras årliga datasammanställningar på karta och data kan laddas ner kostnadsfritt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"ICES Impulsive Noise Register"}}],"@id":"urn:source:2659f8e754dc4b20dfb974b6280f65aa490aadbb16254759c92023e9e0f261d3"},{"@graph":[{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1998"}},{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/14758754-6a3c-470d-bc2e-b94d7b7cd9f7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f"},"dcat:distribution":[{"@id":"urn:uuid:1bfc9164-334f-12f9-baca-8e8cdcab0548"},{"@id":"urn:uuid:70a45608-c63e-743d-82c9-438ce99bf7de"},{"@id":"urn:uuid:97122171-6de7-8430-98f8-fb6803ad8f24"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Inventering av forn- och kulturlämningar på skogsmark. Uppgifterna är preliminära eftersom de inte genomgått fullständig kvalitetsgranskning för överföring till fornminnesregistret. För att få en komplett bild av fornminnena inom ett område måste man även ha ett datauttag från Riksantikvarieämbetets geografiska databas KMR."},"dct:identifier":"14758754-6a3c-470d-bc2e-b94d7b7cd9f7","dct:issued":{"@type":"xsd:date","@value":"2020-12-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-12-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b0n0"},"dct:temporal":{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b1n0"},"dct:title":{"@language":"sv","@value":"Skog och Historia - upprättad av Skogsstyrelsen"}},{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Skogsstyrelsen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:1bfc9164-334f-12f9-baca-8e8cdcab0548","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaSkoghistoria/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst för Skog och Historia"}},{"@id":"urn:uuid:70a45608-c63e-743d-82c9-438ce99bf7de","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skogsstyrelsen.se/sjalvservice/karttjanster/skogsstyrelsens-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om Skogsstyrelsens geodata"}},{"@id":"urn:uuid:97122171-6de7-8430-98f8-fb6803ad8f24","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/SkogoHistoria.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för Skog och Historia"}}],"@id":"urn:source:269e0554457a2cb6ab796880ddf9bbc12998564aaff585ae13c13970142da368"},{"@graph":[{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se SGI Varia 512"}},{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.233744597823 68.89875681452,26.05200323436 68.89875681452,26.05200323436 55.060433091505,11.233744597823 55.060433091505,11.233744597823 68.89875681452))"}},{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2023"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1050"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/6dd93da0-f1ae-4190-a92b-8b39c8dcfb41","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:16d409a7-bec8-3f72-efb0-c2e02f919ba2"},{"@id":"urn:uuid:5903bcc1-8cbb-3d08-4619-a83ec8f155cc"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"SGI är statens sakkunnigorgan i skred-, ras- och stranderosionsfrågor och medverkar till att minska riskerna inom det geotekniska området i samhället. Utgångspunkten för verksamheten är att människor ska kunna bo på säker grund, så att liv och egendom inte går till spillo vid naturolyckor av typen skred och ras eller vid stranderosion. \nSGI's skreddatabas är en sammanställning över inträffade skred, ras och övriga jordrörelser i Sverige med tillhörande beskrivning av typ av händelse, omfattning, läge etc - se SGI Varia 512. Antal objekt är 1564 st (aug 2023). \nVissa större skred har en utförligare beskrivning (orsak, händelseförlopp, erfarenhetsåterföring mm) i MSB's Naturolycksdatabas. [Geoteknik]"},"dct:identifier":"6dd93da0-f1ae-4190-a92b-8b39c8dcfb41","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-10"},"dct:provenance":{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b1n0"},"dct:temporal":{"@id":"_:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f_b2n0"},"dct:title":{"@language":"sv","@value":"Inträffade skred, ras och övriga jordrörelser (skreddatabas)"}},{"@id":"urn:uuid:16d409a7-bec8-3f72-efb0-c2e02f919ba2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/skred/"},"dct:description":{"@language":"sv","@value":"Tittskåp"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Inträffade skred, ras och övriga jordrörelser"}},{"@id":"urn:uuid:5903bcc1-8cbb-3d08-4619-a83ec8f155cc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/SGI_Skreddatabas_ver2.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}}],"@id":"urn:source:2749f0e555a74652b0d39516e5cc6e8c861a60f3b4c6197671a519702b0cce4f"},{"@graph":[{"@id":"_:27e7a6525478a6a08e812f662fd8c67bcaaa54627f08f4b571f2525608318d16_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Information om kvalitet datamängd"}},{"@id":"_:27e7a6525478a6a08e812f662fd8c67bcaaa54627f08f4b571f2525608318d16_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.342131910008 67.426534205312,28.390844545473 67.426534205312,28.390844545473 55.739864518069,9.342131910008 55.739864518069,9.342131910008 67.426534205312))"}},{"@id":"_:27e7a6525478a6a08e812f662fd8c67bcaaa54627f08f4b571f2525608318d16_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2003"},"dcat:startDate":{"@type":"xsd:gY