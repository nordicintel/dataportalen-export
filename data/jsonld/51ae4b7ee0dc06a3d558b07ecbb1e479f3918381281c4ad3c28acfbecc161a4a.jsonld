:spatial":{"@id":"_:350e26e2f17eb6a79b9db2baaed26f4e10807d10edb8cbf61afeec46719ce87b_b1n0"},"dct:title":{"@language":"sv","@value":"Fysisk påverkan i svenska kustvatten 1960 och framåt: Bottenstörningar"}},{"@id":"urn:uuid:2c97079f-1b17-c5e5-74a8-87b58afbc091","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-bottenstorningar/fysisk-paverkan-kust-bottenstorningar-2021-10-01.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Datapaket: Bottenstörningar"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:350e26e2f17eb6a79b9db2baaed26f4e10807d10edb8cbf61afeec46719ce87b_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"}],"@id":"urn:source:350e26e2f17eb6a79b9db2baaed26f4e10807d10edb8cbf61afeec46719ce87b"},{"@graph":[{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Scannat och digitaliserat från Lantmäteriets topografiska karta skala 1:50000. Klassning gjord efter inventering i fält."}},{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.03816 65.04354,16.97948 65.04354,16.97948 61.57855,12.03816 61.57855,12.03816 65.04354))"}},{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/fcaf6670-81fe-4d4b-8466-76536499ae41","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:b4f717f4-b0d7-a658-73b0-5b1e6cb903ce"},"dcat:distribution":[{"@id":"urn:uuid:2f2c542e-d2fe-a7c8-6961-ebb5e515d4d1"},{"@id":"urn:uuid:da152d05-04aa-47b1-9e36-650c57dbf99e"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Visar alla objekt i Jämtlands län som ingick i våtmarksinventeringen (VMI) 1990-1993. Skiktet skall användas för Jämtlands län istället för det nationella skiktet för VMI från Naturvårdsverket på grund av ett antal fel i naturvärdesklassningen samt att bleke- och rikkärrsområden är sammanslagna med VMI. Skikten är naturvärdesklassade från 1-4 i VMI. Objektens storlek är generellt sett över 50 hektar, dock finns undantag i östra Jämtland.\nNaturvärdesklasser är enligt följande \n1 Mycket högt naturvärde\n2 Högt naturvärde\n3 Vissa naturvärden\n4 Låga naturvärden"},"dct:identifier":"fcaf6670-81fe-4d4b-8466-76536499ae41","dct:issued":{"@type":"xsd:date","@value":"2000-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2000-01-01"},"dct:provenance":{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b1n0"},"dct:title":{"@language":"sv","@value":"LstZ Våtmarksinventering (Extern)"}},{"@id":"urn:uuid:2f2c542e-d2fe-a7c8-6961-ebb5e515d4d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstz.LstZ_Vatmarksinventering.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:b4f717f4-b0d7-a658-73b0-5b1e6cb903ce","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstZ Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jamtland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstZ Naturvårdsenheten"},{"@id":"urn:uuid:da152d05-04aa-47b1-9e36-650c57dbf99e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTZ/LSTZ_Vatmark/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:3679eb9b5dddb8cb95b7e17ffdfb6a6e4ede53c435fc5107d01ce55e70685dbc"},{"@graph":[{"@id":"_:374a180efa90602b12bef01718b3fb1d85b3cb47386a55c994bc5c4935fbe636_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sedan januari 2023 förvaltar Skolverket skolenhetsregistret, som bland annat fungerar som urvalsram för statistikinsamling och undersökningar. \n\nSkolenhetsregistret uppdateras årligen av skolornas huvudmän, som vid förändringar ändrar uppgifterna löpande under resterande året. Två – tre gånger per år uppdateras datamängden på geodataportalen.\n \n\nAntal skolenheter per skolform september 2025:\n\nFörskoleklass – 3561 st\n\nGrundskola – 4686 st\n\nSameskola – 5 st\n\nSpecialskola – 10 st\n\nGymnasieskola – 1290 st\n\nAnpassad grundskola – 748 st\n\nAnpassad gymnasieskola – 254 st\n\n \n\nFör mer information om skolenheter och skolenhetsregistret:\n\nhttps://www.skolverket.se/om-skolverket/webbplatser-och-tjanster/andra-webbplatser-och-tjanster/skolenhetsregistret"}},{"@id":"_:374a180efa90602b12bef01718b3fb1d85b3cb47386a55c994bc5c4935fbe636_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,22.00 69.00,22.00 54.00,11.00 54.00,11.00 69.00))"}},{"@id":"http://dataportal.se/organisation/SE2021004185","@type":"foaf:Agent","dct:identifier":"2021004185","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.skolverket.se/"},"foaf:mbox":{"@id":"mailto:support.oppnadata@skolverket.se"},"foaf:name":{"@language":"sv","@value":"Skolverket"},"foaf:page":{"@id":"https://www.skolverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://dataportal.se/organisation/SE202100-4185"}},{"@id":"https://www.geodata.se/resources/05b5aefc-434c-4b05-90bc-f5b2bd86e297","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2e4c4ff2-6fe8-8fa1-ad49-dde165095dac"},{"@id":"urn:uuid:61bc928c-618c-ffc2-0648-e4b04d406b58"},{"@id":"urn:uuid:75576329-c2d6-fed1-27e2-e0214256cd1a"},{"@id":"urn:uuid:9ea5fffa-5636-3f6a-cda4-571ec320a9c8"},{"@id":"urn:uuid:cc08378d-89fb-8366-efd4-28d71e6a2570"},{"@id":"urn:uuid:f765e949-a0be-ba63-7eff-d7ea2e0d9c96"}],"dcat:keyword":[{"@language":"sv","@value":"Allmännyttiga och offentliga tjänster"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/us"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Skolenheter i Sverige för förskoleklass, grundskolan, anpassade grundskolan, specialskolan, sameskolan, gymnasieskolan samt anpassade gymnasieskolan. Uppgifterna avser läsåret 2025/26 och är fria för både privat och juridisk person att använda utan kostnad."},"dct:identifier":"05b5aefc-434c-4b05-90bc-f5b2bd86e297","dct:issued":{"@type":"xsd:date","@value":"2014-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-06"},"dct:provenance":{"@id":"_:374a180efa90602b12bef01718b3fb1d85b3cb47386a55c994bc5c4935fbe636_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004185"},"dct:spatial":{"@id":"_:374a180efa90602b12bef01718b3fb1d85b3cb47386a55c994bc5c4935fbe636_b1n0"},"dct:title":{"@language":"sv","@value":"US.Skolenheter"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:2e4c4ff2-6fe8-8fa1-ad49-dde165095dac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skolverket.se/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Swedish National Agency for Education"}},{"@id":"urn:uuid:61bc928c-618c-ffc2-0648-e4b04d406b58","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/svfeed/filer/usGovServ.Education.Sweden.zip"},"dct:description":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst direkt nedladdning GML"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst direkt nedladdning GML"}},{"@id":"urn:uuid:75576329-c2d6-fed1-27e2-e0214256cd1a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-skolverket.metria.se/geoserver/skolverket/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Skolenheter INSPIRE Visningstjänst"},"dct:title":{"@language":"sv","@value":"Skolenheter INSPIRE Visningstjänst"}},{"@id":"urn:uuid:9ea5fffa-5636-3f6a-cda4-571ec320a9c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/svfeed/SV_TopAtomFeed.xml"},"dct:description":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst ATOM"}},{"@id":"urn:uuid:cc08378d-89fb-8366-efd4-28d71e6a2570","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/svfeed/filer/skolor_atom.zip"},"dct:description":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst direkt nedladdning SHAPE"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Skolenheter INSPIRE Nedladdningstjänst direkt nedladdning SHAPE"}},{"@id":"urn:uuid:f765e949-a0be-ba63-7eff-d7ea2e0d9c96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skolverket.se/om-skolverket/webbplatser-och-tjanster/andra-webbplatser-och-tjanster/skolenhetsregistret"},"dct:description":{"@language":"sv","@value":"Skolenhetsregistret"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Skolenhetsregistret"}}],"@id":"urn:source:374a180efa90602b12bef01718b3fb1d85b3cb47386a55c994bc5c4935fbe636"},{"@graph":[{"@id":"_:3785a7ba1fd9186a5921eb705becec58d78c9b03767c24ad1e5eece22e45deec_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För att få fram sannolikheten för om en sur sulfatjord förekommer i områden där observationer saknas, har en yttäckande modellering gjorts som bygger på sambandet mellan de observationer som finns och geografisk information. Observationerna utgörs av förekomsten av sura sulfatjordar på en specifik plats, och den geografiska informationen av markhöjdmodell grid 50+ (©Lantmäteriet), Nationella marktäckedata (©Naturvårdsverket), Jordbruksblock (©Jordbruksverket), samt SGU:s jordartsinformation, nivå under Högsta kustlinjen, och gammastrålning.\n\nModelleringsmetoden Random Forest har använts med hjälp av verktyget randomForest i statistikprogrammet R (R Core Team 2014). Random Forest är en klassificeringsalgoritm (Breiman 2001) där sambandet mellan ett stort antal parametrar testas och där sedan de mest sannolika sambanden används för att ta fram en modell. För att erhålla en bedömning av modellernas kvalitet delades punktobservationerna i två delar, där 70 procent användes till träning av modellen (maskininlärning) och 30 procent till validering av modellen.\n\nDatakvalitet:\nKartan är en modell, och i många områden saknas verifierade observationer som visar om sur sulfatjord förekommer eller inte. Även om det enligt kartan inte är sannolikt att sådan jord förekommer i ett visst område betyder det inte att det helt kan uteslutas. Det betyder i stället att det är större sannolikhet att det inte finns sur sulfatjord där än att det finns.\n\nModellversion 1.0 av datamängden använde en upplösning av 20x20 m, nerskalad från Höjddata grid 2+ (©Lantmäteriet). Nuvarande version har en upplösning av 50x50 m. Anledningen till detta är två-delad:\n\n1. Kovariaten gammastrålning baseras på SGU:s flygburna geofysik som levereras i en upplösning av 200x200 m; vi bedömer att dess användning till modelleringen bör begränsas till maximalt 50x50 m.\n\n2. När 20 m upplösning appliceras uppstår vissa felaktigheter i modellens prediktering; exempelvis anges ofta botten av raviner systematiskt som potentiell sur sulfatjord. När 50 m celler används så sorteras dessa fel bort, eftersom bredden av ravinernas bottnar inte avgränsas i denna upplösning. Den samlade bedömningen av förändringen till 50x50 m är att detta generellt ger en mer rättvisande bild över sannolikheten för sur sulfatjords utbredning, utifrån nu tillgängliga indata."}},{"@id":"_:3785a7ba1fd9186a5921eb705becec58d78c9b03767c24ad1e5eece22e45deec_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((15.628134851753 67.11180425322,24.734938990087 67.11180425322,24.734938990087 61.731284579305,15.628134851753 61.731284579305,15.628134851753 67.11180425322))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/26b1885e-7ed2-46a6-b530-c6d95f6e841d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:4fa5d939-2f47-3fe8-a764-89ea9d225aa3"},{"@id":"urn:uuid:4fb09601-90c8-070a-30ea-820fe20493c3"},{"@id":"urn:uuid:6ae97008-877e-2e26-2dc7-2a7245be9ff0"},{"@id":"urn:uuid:7125ad22-e16c-e4b4-9142-27d6a1399de8"},{"@id":"urn:uuid:8d9e5e67-b58f-7d00-486a-150f764cd935"},{"@id":"urn:uuid:c9a2d058-99a5-6db5-a798-05c0690c38dd"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Produkten ”Sur sulfatjord” består av dels en yttäckande modellering dels insamlade punktobservationer. Båda dessa datamängder visar förekomster av sur sulfatjord. Den yttäckande modelleringen omfattar Västernorrlands, Västerbottens och Norrbottens kustområden där en yttäckande karta tagits fram. I övriga delar av landet saknas tillräckligt med data för att ta fram en karta och där finns därför endast punktobservationer. Förhoppningsvis kommer det i framtiden vara möjligt att ta fram ett kartunderlag som omfattar alla de delar av Sverige där sura sulfatjordar förekommer. I SGU-rapporten 2019:13 (Becher m.fl. 2019) beskrivs jordarna mer utförligt, samt hur de undersöks och klassificerat. Kartunderlagen kan användas för att identifiera områden där det är:\n\n•\tviktigt att undvika markanvändning som kan leda till negativ påverkan från sur sulfatjord eller \n•\tlämpligt att vidta åtgärder för att minska miljöbelastning från jordarna\nDen modellerade kartan visar den predikterade utbredningen av sur sulfatjord. Punktobservationerna kommer från kartering och provtagning av sur sulfatjord som utförts inom olika projekt på SGU. \n\nBåde punktobservationerna och den yttäckande modellen delas in i tre klasser:\n•\t”Ej sur sulfatjord”\n•\t”Aktiv sur sulfatjord på potentiell sur sulfatjord”\n•\t”Potentiell sur sulfatjord” \n\nFör varje modellerad klass finns dessutom ett separat raster som visar hur säker klassningen är i varje cell (från 0 – 100 procents sannolikhet).\nI södra Sverige finns sura sulfajordar ofta i områden som på jordartskartan redovisas som gyttjelera, lergyttja eller gyttja. Det går därför att använde punktobservationerna i kombination med jordartskartan för att få en översiktlig bild av var sura sulfatjordar kan förekomma.\n\nDe punktobjekt som redovisas finns även med i den SGU-produkt som heter Jordlagerföljder. Där finns mer information om platsernas jordarter och jordlagrens mäktighet.\n\nDen yttäckande modelleringen redovisas primärt i rasterformat, men en vektoriserad version ingår också i produkten."},"dct:identifier":"26b1885e-7ed2-46a6-b530-c6d95f6e841d","dct:issued":{"@type":"xsd:date","@value":"2019-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-09"},"dct:provenance":{"@id":"_:3785a7ba1fd9186a5921eb705becec58d78c9b03767c24ad1e5eece22e45deec_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:3785a7ba1fd9186a5921eb705becec58d78c9b03767c24ad1e5eece22e45deec_b1n0"},"dct:title":{"@language":"sv","@value":"Sur sulfatjord"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:4fa5d939-2f47-3fe8-a764-89ea9d225aa3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/sur-sulfatjord/wcs?request=GetCapabilities&service=WCS&version=2.0.1"},"dct:title":{"@language":"sv","@value":"Capabilitiesdokument OGC Web Coverage Service )"}},{"@id":"urn:uuid:4fb09601-90c8-070a-30ea-820fe20493c3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/sur-sulfatjord"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Services"}},{"@id":"urn:uuid:6ae97008-877e-2e26-2dc7-2a7245be9ff0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/sur-sulfatjord/sur-sulfatjord.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:7125ad22-e16c-e4b4-9142-27d6a1399de8","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/sur-sulfatjord/ogc/features/v1?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features )"}},{"@id":"urn:uuid:8d9e5e67-b58f-7d00-486a-150f764cd935","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-sur-sulfatjord.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:c9a2d058-99a5-6db5-a798-05c0690c38dd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/sur-sulfatjord-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:3785a7ba1fd9186a5921eb705becec58d78c9b03767c24ad1e5eece22e45deec"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/0d327750-9767-41ae-a49f-a09e45be0a55","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://gis.sgi.se/inspire_nedladdning/geotiff/sgi_skane_halland_ksi_raster.zip"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kustsårbarhetsindex är tänkt att användas när kommunerna arbetar med olika former av samhällsplanering, t ex för att identifiera sårbara områden i kommunen som behöver åtgärdas i framtiden. Länsstyrelser och andra myndigheter kan också använda kartorna vid granskning och uppföljning.\nKustsårbarhetsindex bygger på vilka förutsättningar som finns längs kusten och som kan påverka erosion, vilka krafter som verkar mot kusten och vilka samhällsvärden som är hotade.\n\nSkåne är särskilt drabbat, många skånska kustkommuner utsätts redan i dag för stranderosion. Efter Skåne kommer verktyg att tas fram på liknande sätt för andra län, bland annat Halland, Blekinge, östra Småland, Öland och Gotland.\nKustsårbarhetsindex är utvecklat i samarbete med SGU. \n\nKontakt i stranderosionsfrågor: Per Danielsson, nationellt ansvarig för stranderosion på SGI.\n\nhttp://www.sgi.se/sv/samhallsplanering--sakerhet/stranderosionskartering/"},"dct:identifier":"0d327750-9767-41ae-a49f-a09e45be0a55","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Kustsårbarhetsindex.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:37dc4d15890148822f5ea3c2021cbc4e81c25cc8078f134238bf5d8446ba4404"},{"@graph":[{"@id":"_:387b1921f2f9e4bb4bae2053b755b411cda49b324ad37cbe4b2652cff974a0ee_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:387b1921f2f9e4bb4bae2053b755b411cda49b324ad37cbe4b2652cff974a0ee_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/a91b5df8-2a25-4df5-8527-0c5922f6841d","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaContortagransyta/MapServer/WmsServer?"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"WMS-tjänst som visualiserar gräns för contortatall, upprättad av Skogsstyrelsen"},"dct:identifier":"a91b5df8-2a25-4df5-8527-0c5922f6841d","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"BR.Gräns för contortatall upprättad av Skogsstyrelsen.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:387b1921f2f9e4bb4bae2053b755b411cda49b324ad37cbe4b2652cff974a0ee_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:387b1921f2f9e4bb4bae2053b755b411cda49b324ad37cbe4b2652cff974a0ee_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:387b1921f2f9e4bb4bae2053b755b411cda49b324ad37cbe4b2652cff974a0ee"},{"@graph":[{"@id":"_:38adf0b51f883f0964c21e9c2a0e3fabf92f4411e511af9dd58f67869d9c9114_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Föreningarna anmäler själva förändringar i stadgar, styrelsesammansättning m.m. till Lantmäteriet. Datum för föreningsstämman införs i registret tillsammans med uppgifter om den nya styrelsen eller andra uppgifter."}},{"@id":"_:38adf0b51f883f0964c21e9c2a0e3fabf92f4411e511af9dd58f67869d9c9114_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.10,24.18 69.10,24.18 55.14,10.61 55.14,10.61 69.10))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/bd576da5-c686-4bba-a1d8-921d35bd8b62","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:14f0c40f-a85c-2b1c-acb4-da5f625dfcee"},{"@id":"urn:uuid:4f5e93bd-1829-e889-f6bf-e33eb26c87a9"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samfällighetsföreningsregistret och innehåller information om bl.a:\n- Typ av förening: samfällighetsförening, vägförening, vägsamfällighet eller förening enligt lagen om  vissa gemensamhetsanläggningar\n- Namn på förening, organisationsnummer och länskod\n- Namn och adressuppgifter för styrelsemedlemmar\n- Uppgifter om vad föreningen förvaltar t.ex. vägar, vattenförsörjning, avloppsanläggning, grönområden, bad- och/eller båtanläggning.\nDatamängden kan beställas  endast genom befintliga produkter: Samfällighetsförening Direkt och Samfällighetsförening Nedladdning."},"dct:identifier":"bd576da5-c686-4bba-a1d8-921d35bd8b62","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:38adf0b51f883f0964c21e9c2a0e3fabf92f4411e511af9dd58f67869d9c9114_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:38adf0b51f883f0964c21e9c2a0e3fabf92f4411e511af9dd58f67869d9c9114_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för samfällighetsföreningsregistret"}},{"@id":"urn:uuid:14f0c40f-a85c-2b1c-acb4-da5f625dfcee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/samfallighetsforening-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Samfällighetsförening Direkt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Samfällighetsförening Direkt."}},{"@id":"urn:uuid:4f5e93bd-1829-e889-f6bf-e33eb26c87a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/samfallighetsforening-nedladdning"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Samfällighetsförening Nedladdning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Samfällighetsförening Nedladdning."}}],"@id":"urn:source:38adf0b51f883f0964c21e9c2a0e3fabf92f4411e511af9dd58f67869d9c9114"},{"@graph":[{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data från flygmätningar har samlats in sedan 1960. Flyghöjd över marken, mätlinjeseparation och navigeringssystem har modifierats med tiden. Likaså har sensorer uppdaterats med förbättrad känslighet och upplösning \nMätpunktsavståndet är ca 6 till 40 meter, beroende på vilket mätsystem som använts. Mätlinjeavståndet är normalt 200 meter över land och 400 till 1000 meter över hav samt 2000 meter över norra fjällkedjan. Till och med år 1994 var den nominella flyghöjden 30 meter, från och med 1995 är den 60 meter.\n\nDen bästa mätningen har valts om flera mätningar funnits över samma område. Mätdata har interpolerats (bi-linjär interpolation) till en ytbild med 200 x 200 m cellstorlek. Magnetfältet över områden som flugits på 30 m höjd har räknats upp analytiskt till 60 m höjd med metoden upward continuation.\n\nEn ascii-fil med 200 m cellstorlek har slutligen skapats från den interpolerade ytan.\n\nDen relativa noggrannheten varierar mellan < 0.3 nT upp till 15 nT."}},{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1960"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ca484649-0ec8-4149-94cf-3a8cce58746c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0689a845-652e-731a-6730-464ed089d3e2"},{"@id":"urn:uuid:0f823d8f-7735-531c-06b4-cd8007d78443"},{"@id":"urn:uuid:100b8305-ab72-66d9-e845-c7878850a486"},{"@id":"urn:uuid:2b26f5b8-64d3-b929-4696-09d339c648a9"},{"@id":"urn:uuid:59f29aa6-82ed-40d6-036e-0762625d799f"},{"@id":"urn:uuid:b9794147-fe28-cf73-9cf5-a163b50e8720"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Användningsområden för informationen är t.ex. prospektering, infrastruktur och samhällsplanering."},{"@language":"sv","@value":"Vid flygmätningar av jordens magnetfält registreras mycket små variationer i magnetfältets styrka. Detta ger bland annat information om djup- och ytfördelningen av olika bergarter och bergartsled, samt deras stryknings- och stupningsriktningar. Förkastningar och deras relativa rörelser kan i vissa fall också identifieras i de magnetiska mönstren.\n\nGeofysiska flygmätningar, magnetfält (översiktlig) innehåller uppmätta variationer i det magnetiska totalfältet efter subtraktion av det geomagnetiska referensfältet (DGRF 1965.0). Data är därefter interpolerade till 200 x 200 m cellstorlek. Mätningarna är gjorda från flygplan på låg höjd från 1960 och framåt."}],"dct:identifier":"ca484649-0ec8-4149-94cf-3a8cce58746c","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b1n0"},"dct:temporal":{"@id":"_:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, magnetfält (översiktlig)"}},{"@id":"urn:uuid:0689a845-652e-731a-6730-464ed089d3e2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/om-sgu/verksamhet/kartlaggning/geofysik_att_se_ner_i_berget/flyggeofysisk-matning/"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sveriges geologiska undersökning"}},{"@id":"urn:uuid:0f823d8f-7735-531c-06b4-cd8007d78443","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-magnetfalt-oversiktlig-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:100b8305-ab72-66d9-e845-c7878850a486","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-magnetfalt.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:2b26f5b8-64d3-b929-4696-09d339c648a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-magnetfalt-oversiktlig/geofysik-flyg-magnetfalt-oversiktlig.zip"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:59f29aa6-82ed-40d6-036e-0762625d799f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-magnetfalt.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:b9794147-fe28-cf73-9cf5-a163b50e8720","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-magnet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}}],"@id":"urn:source:38db4e183ec2a486293ec485eff54495679891d1865cf982f425c76e1f4b9407"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e1e55c3e-f1b7-4310-861d-0e7fb9824004","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/geologiskt-intressanta-platser"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Geologiskt intressanta platser innehåller information om platser med geologiska naturvärden. Platserna kan vara besöksvärda och användbara för att sprida geologisk kunskap men också enbart intressanta ur ett strikt geologiskt vetenskapligt perspektiv. \n\nGeologiskt intressanta platser (visningstjänst) redovisar en delmängd ur datamängden Geologiskt intressanta platser (öppna data)."},"dct:identifier":"e1e55c3e-f1b7-4310-861d-0e7fb9824004","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geologiskt intressanta platser (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:3902b384affd577a70678305efa0e6a9ea68f0f9a2a0a3d2d4e381a380434790"},{"@graph":[{"@id":"_:390a8320f370c78c5ec52aba432a1fab76d0382b5ab0418677affbf9cf64a398_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/a67491f2-b73e-11f7-c360-f2947c7f135b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:56e6c825-1d95-2b8c-cb56-917cf8abc9d8"},{"@id":"urn:uuid:b9387734-b5cf-f0ba-e485-05d585f518c8"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Statistik rörande fritidsfisket i Sverige. Bland annat information om fritidsfiskets omfattning, fångster samt ekonomi kopplat till fritidsfiskeaktiviteten."},"dct:identifier":"a67491f2-b73e-11f7-c360-f2947c7f135b","dct:issued":{"@type":"xsd:date","@value":"2018-01-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige 2014"}},{"@id":"urn:uuid:56e6c825-1d95-2b8c-cb56-917cf8abc9d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/data-kartor-och-rapporter/data-och-statistik/officiell-statistik/officiell-statistik---fiske/fangststatistik-for-fritidsfisket.html"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (HaV)"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:390a8320f370c78c5ec52aba432a1fab76d0382b5ab0418677affbf9cf64a398_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:b9387734-b5cf-f0ba-e485-05d585f518c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/statistik-efter-amne/jord-och-skogsbruk-fiske/fiske/fritidsfiske/"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (SCB)"}}],"@id":"urn:source:390a8320f370c78c5ec52aba432a1fab76d0382b5ab0418677affbf9cf64a398"},{"@graph":[{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventering av naturvärden i skogsmark och senare digitalisering av område"}},{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.50,24.50 69.50,24.50 55.00,10.50 55.00,10.50 69.50))"}},{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-08-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-07-01"}},{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183"},{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/4647d99c-960f-4537-b3de-acdb9k61e72b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7"},"dcat:distribution":[{"@id":"urn:uuid:0d5f101a-5433-5a9b-5f37-3fbe859ecfd2"},{"@id":"urn:uuid:5caa2a60-e3d6-e88a-3bfa-b126fa0a9b78"},{"@id":"urn:uuid:a80f1344-1ffa-33a6-3e0e-f13e7db0f333"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Under inventeringen av nyckelbiotoper har man också registrerat andra objekt som har naturvärden, utan att nå upp till samma kvalitet som en nyckelbiotop. Resultatet används till rådgivning och planering av insatser för naturvården."},"dct:identifier":"4647d99c-960f-4537-b3de-acdb9k61e72b","dct:issued":{"@type":"xsd:date","@value":"1991-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1991-01-01"},"dct:provenance":{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b1n0"},"dct:temporal":{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b2n0"},"dct:title":{"@language":"sv","@value":"Naturvärdesobjekt - Skogsstyrelsen"}},{"@id":"urn:uuid:0d5f101a-5433-5a9b-5f37-3fbe859ecfd2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skogsstyrelsen.se/skogensparlor"},"dct:description":{"@language":"sv","@value":"Karttjänst som informerar om områden med höga naturvärden i skogen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Skogens pärlor - värdefulla skogsmiljöer"}},{"@id":"urn:uuid:5caa2a60-e3d6-e88a-3bfa-b126fa0a9b78","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaObjektnaturvarde/MapServer/WmsServer?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS-tjänst innehållande objekt med naturvärden producerade av Skogsstyrelsen."},"dct:title":{"@language":"sv","@value":"Naturvärden från Skogsstyrelsen"}},{"@id":"urn:uuid:99e91ab3-cb67-6398-b4ef-8bc648a5fef7","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst -","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:a80f1344-1ffa-33a6-3e0e-f13e7db0f333","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Naturvarden.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av objekt med naturvärden producerade av Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av objekt med naturvärden - atomflöde"}}],"@id":"urn:source:393003c049ebc115661efda05d957ffb5e3256ee7bba9f57a3fe8e24f349d021"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/345891d6-6ee6-437e-b53f-ee2f5a22e1ef","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/svaghetszoner"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Informationen kan tjäna som ett byggnadsgeologisk planeringsunderlag vid samhällsbyggande."},{"@language":"sv","@value":"Svaghetszoner baseras på bland annat undermarksinformation från olika byggnationer, som t.ex. tunnlar, och andra underlag som höjddata och geofysik. Varje svaghetszon beskrivs av olika parametrar och mängden information som underlag bygger upp säkerheten i observationen vilket betecknas konfidens. I zoner med hög konfidens är kopplingar till olika observationer, objekt eller referenser gjorda. Till dessa zoner finns även information om hur zonen lutar (stupning) och vilken uppskattad bredd den har. För 3D-visualisering är även zonens riktning (strykning) angiven för att veta åt vilket håll zonen lutar åt enligt högerhandsregeln. I första hand är informationen begränsad till Stockholm men senare utökas att täcka andra områden i Sverige med behov av mer detaljerad information."}],"dct:identifier":"345891d6-6ee6-437e-b53f-ee2f5a22e1ef","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Svaghetszoner, tolkade linjer (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:3a4527eb7ffc7debda21981f53fb0d3dc42db5d7fb4198b5d764f8ebcc329fe6"},{"@graph":[{"@id":"_:3a9826bf6217513e8627de1e03f7f4e05a0304663497f9734269b9155c9a8bd1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:25 000 är en transformerad version av SGUs produkt Maringeologi 1:25 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden.\n\nMaringeologi 1:25 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke.\n\nSyftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. Maringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenyteavbildande mätningar samt bottenpenetrerande mätningar (akustisk profilering). Bottenyteavbildande mätningar (akustisk bottenavsökning) görs med multistråleekolod, interferometrisk sonar och sidoavsökande sonar. Mätningar med multistråleekolod och interferometrisk sonar ger flygbildsliknande information om både vattendjup och havsbottenytans hårdhet struktur och textur. Mätningar med sidoavsökande sonar ger en flygbildsliknande avbildning av havsbottenytans hårdhet, struktur och textur. Bottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. De hydroakustiska data som samlats in tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där såväl mätningar som direkta sedimentprovtagningar och visuella observationer av de geologiska förhållandena gjorts. De sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagningarna föregås av en besiktning av bottenytan med hjälp av undervattenskamera. Efter insamling och bearbetning görs en geologisk tolkning av materialet, för presentation i skala 1:25 000."}},{"@id":"_:3a9826bf6217513e8627de1e03f7f4e05a0304663497f9734269b9155c9a8bd1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.48 56.53,14.59 56.53,14.59 55.29,12.48 55.29,12.48 56.53))"}},{"@id":"_:3a9826bf6217513e8627de1e03f7f4e05a0304663497f9734269b9155c9a8bd1_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2012"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/fe957417-c0e4-422c-9f3b-2f95504c4ccc","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:8993aece-184d-7dce-9c98-a0cd442759f2"},{"@id":"urn:uuid:cc072b53-f15d-cb72-cd67-f40e6f8c491f"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:25 000 är en transformerad version av SGUs produkt Maringeologi 1:25 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden.\n\nMaringeologi 1:25 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke."},"dct:identifier":"fe957417-c0e4-422c-9f3b-2f95504c4ccc","dct:issued":{"@type":"xsd:date","@value":"2019-10-01"},"dct:lan