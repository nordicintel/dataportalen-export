-b832-8d5130f673c3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}}],"@id":"urn:source:6153e49993e96a9347c2997809ed94eef62901ba23cace01beb79dc17229169c"},{"@graph":[{"@id":"_:616d436da7857c3878d3de9702b2b43524ff5cac028f936626a39f82b42aacb4_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.12314 59.22252,15.4711 59.22252,15.4711 57.12242,11.12314 57.12242,11.12314 59.22252))"}},{"@id":"_:616d436da7857c3878d3de9702b2b43524ff5cac028f936626a39f82b42aacb4_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/91024a50-9d46-45de-ad8d-a289a3a2c846","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:384dd39d-e284-7d11-8c5c-eba7d4cb36c2"},{"@id":"urn:uuid:665c06fb-0491-476c-7115-196737427721"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Provplatser där vattenkemi undersöks. Kartskiktet hämtar uppgifter från Nationella kalkdatabasen. Varje län ansvarar för att de provplatser som finns med i skiktet är aktuella. Nationella kalkdatabasen är ännu inte komplett i alla län vad gäller provplatser där vattenkemi undersöks i kalkade vatten."},"dct:identifier":"91024a50-9d46-45de-ad8d-a289a3a2c846","dct:issued":{"@type":"xsd:date","@value":"2019-08-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-08-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:616d436da7857c3878d3de9702b2b43524ff5cac028f936626a39f82b42aacb4_b0n0"},"dct:title":{"@language":"sv","@value":"Lst Nationella Kalkdatabasen - provplatser vattenkemi"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:616d436da7857c3878d3de9702b2b43524ff5cac028f936626a39f82b42aacb4_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:384dd39d-e284-7d11-8c5c-eba7d4cb36c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_nkdb_provplatser_vattenkemi.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:665c06fb-0491-476c-7115-196737427721","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella.lansstyrelsen.se/arcgis/rest/services/LST/lst_lst_nationella_kalkdatabasen/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:616d436da7857c3878d3de9702b2b43524ff5cac028f936626a39f82b42aacb4"},{"@graph":[{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Riksskogstaxeringen är en årlig stickprovsinventering. Ett slumpvis urval av provytor inventeras och utgör sedan underlag för skattningar av arealer och virkesvolymer. Provytorna är cirkulära och är av effektivitetsskäl samlade (klustrade) i sk. trakter. Trakterna har kvadratisk eller rektangulär form och varierande sidlängd i olika delar av landet. Även antalet provytor per trakt varierar över landet. 1983 infördes trakter med permanenta provytor i Riksskogstaxeringens inventering som komplement till de\ntillfälliga trakterna. Kombinationen av permanenta och tillfälliga trakter medför ökad precision i skattningar av förändringar. Radien är 10 m för de permanenta ytorna och 7 m för de tillfälliga. Fem års återinventeringsintervall tillämpas för de permanenta trakterna. Två tredjedelar av stickprovet utgörs av permanenta trakter och resten är tillfälliga. Varje år inventeras totalt cirka 11 000 förrådsprovytor. Drygt hälften av dessa hamnar på produktiv skogsmark. Den sammanlagda provytearealen på produktiv skogsmark är cirka 130 hektar per år, vilket innebär att inte mer än 0,006 ‰ av den produktiva skogsmarksarealen inventeras. Trots att det är en mycket liten andel av den totala arealen som inventeras kan uppgifter med acceptabel säkerhet presenteras på läns-, landsdels- och riksnivå."}},{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.50 68.60,25.20 68.60,25.20 55.20,9.50 55.20,9.50 68.60))"}},{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2017"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2013"}},{"@id":"http://dataportal.se/organisation/SE2021002817","@type":"foaf:Agent","dct:identifier":"2021002817","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:dcu@slu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges lantbruksuniversitet"},"foaf:page":{"@id":"https://www.slu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18"}},{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":[{"@language":"en","@value":"Swedish University of Agricultural Sciences"},{"@language":"sv","@value":"Sveriges lantbruksuniversitet"}]},{"@id":"https://www.geodata.se/resources/4d60be18-6e3f-444b-8d56-d2f309e99617","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:75a7c0f3-6b37-8f8c-023f-f7a989a7df24"},{"@id":"urn:uuid:92670dc8-e1c7-c333-0f5c-54d70d340411"},{"@id":"urn:uuid:f8954466-9e21-74b4-df24-00f664b62b1f"}],"dcat:keyword":[{"@language":"sv","@value":"Anläggningar för miljöövervakning"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Riksskogstaxeringen är en landsomfattande, årlig stickprovsinventering av landets skogar, som pågått sedan 1923. Syftet är främst att ge relevant underlag till skogspolitiken, men också till skogsnäringen och den skogliga forskningen. Med åren har metoderna förändrats och innehållet utökats till att omfatta mer än det rent skogliga. Sålunda har inventeringen av de ägoslag som kan omföras till skogsmark utökats, och innehållet i övrigt blivit mer omfattande. Man kan säga att inventeringen kommit att ge allt mer information av ekologisk och miljömässig natur, en utveckling som för övrigt med stor sannolikhet kommer att fortsätta. Statistik och data från Riksskogstaxeringen används i flera olika sammanhang. Det främsta användningsområdet, och samtidigt det som gav anledning till att taxeringen påbörjades under 1920-talet, är att utgöra ett underlag till utformningen av landets skogspolitik. Betydelsefulla användare är de myndigheter som ansvarar för utformning och uppföljning av skogs- och miljöpolitiken, främst Skogsstyrelsen och Naturvårdsverket. Länsorgan som t.ex. länsstyrelser utnyttjar statistiken i länsvisa planer för skog och miljö. Andra viktiga användningsområden är forskning runt skog och miljö och som åskådnings- och arbetsmaterial i undervisningen. Statistiken används även som planerings- och beslutsunderlag av företag och branchorganisationer som exv. LRF Skogsägarna och Skogsindustrierna. Riksskogstaxeringen bedrivs som en stickprovsinventering. Metoden beskrivs under rubiken \"Tillkomsthistorik\".\nDetta är serien för de datamängder som skapats av Riksskogstaxeringen. Datamängden utgörs av följande statistikprodukter: \"Gran - virkesförråd m3sk per hektar\", \"Tall - virkesförråd m3sk per hektar\", \"Övriga löv - virkesförråd m3sk per hektar\", \"Totala virkesförråd m3sk per hektar\", \"Död ved - virkesförråd m3sk per hektar\", \"Andel Röjningsskog\", \"Andel Gallringsskog\", \"Andel Slutavverkningsskog\" & \"Bonitet m3sk per hektar och år\". ”Björk – virkesförråd m3sk per hektar”, ”Medeltillväxt m3sk per ha och år”"},"dct:identifier":"4d60be18-6e3f-444b-8d56-d2f309e99617","dct:issued":{"@type":"xsd:date","@value":"2014-09-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-02-02"},"dct:provenance":{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002817"},"dct:spatial":{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b1n0"},"dct:temporal":{"@id":"_:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467_b2n0"},"dct:title":{"@language":"sv","@value":"EF.Riksskogstaxeringens statistikprodukter"}},{"@id":"urn:uuid:75a7c0f3-6b37-8f8c-023f-f7a989a7df24","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://wms.slu.se/inspire/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml"},{"@id":"urn:uuid:92670dc8-e1c7-c333-0f5c-54d70d340411","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://wms.slu.se/inspire-atom/SLU_EFRiksskog_TopAtomFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Riksskogstaxeringens statistikprodukter"}},{"@id":"urn:uuid:f8954466-9e21-74b4-df24-00f664b62b1f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.slu.se/riksskogstaxeringen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Riksskogstaxeringen"}}],"@id":"urn:source:627d3abbef1a6fdca3a62bc243c71b7d48efa27be79b1c2956f5c1e983f8e467"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a7a3a617-b606-4cbb-bd95-9200b86b1043","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Grönområden i tätorter avgränsas geografiskt av SCB som ett led i produktionen av officiell statistik om grönytor och grönområden i tätorter. Datat som tillgängliggörs här är alltså primärt avsett för statistikproduktion.\n\nEtt grönområde definieras av SCB som ett område av sammanhängande grönytor som uppgår till minst 0,5 hektar och som är allmänt tillgängligt. Betesmark räknas till grönområden, men inte åkermark. Grönområden avgränsas geografiskt till inom tätort. Minsta redovisningsenhet är 0,5 hektar. Definitionen tar därmed inte hänsyn till huruvida områdena är utpekade som grönområden i kommunernas översikts- eller detaljplaner.\n\nAvgränsningen av grönområden baseras på satellitdata som sambearbetas med geografisk information och registerdata från Lantmäteriet. \n\nData finns för två olika referenstidpunkter, 2010 och 2015. 2010-års data omfattar endast grönområden i de 37 största tätorterna enligt 2010-års tätortsavgränsning. 2015-års data omfattar grönområden i samtliga tätorter enligt 2015-års tätortsavgränsning."},"dct:identifier":"a7a3a617-b606-4cbb-bd95-9200b86b1043","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Grönområden i tätorter WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:63532b32ae14ed252adfaa780e3a50a3770edc3a260e3eee42498015c4e0d4db"},{"@graph":[{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.691129148234 61.055977154527,14.952672447346 61.055977154527,14.952672447346 58.725618080278,11.691129148234 58.725618080278,11.691129148234 61.055977154527))"}},{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/5426228d-6652-405b-bf9f-a00c816753b5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6c156db3-e7e8-5eb9-6f3c-0c39e25e9fc2"},"dcat:distribution":[{"@id":"urn:uuid:4ab527ab-bcfd-1910-c948-196208ab62bd"},{"@id":"urn:uuid:c4cf9849-ca78-e6fd-d33d-1bbb20aefe26"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Datamängd med licensområden för älgjakt inom Värmland"},"dct:identifier":"5426228d-6652-405b-bf9f-a00c816753b5","dct:issued":{"@type":"xsd:date","@value":"2003-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b0n0"},{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Licensområden älgjakt"}},{"@id":"urn:uuid:4ab527ab-bcfd-1910-c948-196208ab62bd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.alg_licensomr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:6c156db3-e7e8-5eb9-6f3c-0c39e25e9fc2","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Djurskydd och Vilt","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Djurskydd och Vilt"},{"@id":"urn:uuid:c4cf9849-ca78-e6fd-d33d-1bbb20aefe26","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Jaktomraden_ext/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:63ca22654941953602f3a1f0146842293c02c2ac8abb4ef6392a7899106b7ca0"},{"@graph":[{"@id":"_:642ae1a4e8cb0c1ab62d2da235bc4d2b12fdadb1bd958e35d739e4125f41fefd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Statistiken avser folkbokförd befolkning beräknad från adresser i Registret över Totalbefolkningen (RTB). Koordinater hämtas från Lantmäteriets Fastighetsdatabas och Adressdatabas. \n\nData avser befolkade rutor. En statistisk metod används för att skydda enskildas uppgifter i den redovisade statistiken. På grund av detta är inte alltid de redovisade totalerna lika med summan av deras redovisade delar. Rutor utan befolkning är inte del av data.\n\nInspire koden bildas av Northing (Y) och Easting (X) och representerar rutans nedre vänstra hörn. Även upplösningen samt koordinatsystem finns i koden. Koden blir 31-ställig."}},{"@id":"_:642ae1a4e8cb0c1ab62d2da235bc4d2b12fdadb1bd958e35d739e4125f41fefd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:642ae1a4e8cb0c1ab62d2da235bc4d2b12fdadb1bd958e35d739e4125f41fefd_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-12-31"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/84f2be64-d320-485a-b65b-24fa3f100469","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2a1cb501-4de8-a555-b2f7-cd18e575dd3a"},{"@id":"urn:uuid:9a674db9-fde0-6d13-1d39-641b306907c4"},{"@id":"urn:uuid:ad4464df-8f3a-83dd-b4ff-6d7ef360e812"}],"dcat:keyword":[{"@language":"sv","@value":"Befolkningsfördelning – demografi"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/them