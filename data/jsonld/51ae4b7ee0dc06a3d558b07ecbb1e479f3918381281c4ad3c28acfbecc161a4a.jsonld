eAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/bee3b55a-1b4a-6b9c-8d37-9cc6e4ce9c0f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:ceeb9cc0-7148-339a-b82f-b2cc92501ecd"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Övervakning av makroskräp på havsbotten. Skräp samlas in i samband med trålundersökningar av fisk. De rådata som samlas in lagras hos SLU Aqua och uppdateras årligen. Rådata från alla deltagande länder lagras även hos ICES. Hos ICES finns dock inte data från kusttrålningen."},"dct:identifier":"bee3b55a-1b4a-6b9c-8d37-9cc6e4ce9c0f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Makroskräp på havsbotten"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5a1041c381b9258e487f326f6fb6a24b9083b89de8ca54ae56ed872695326e8a_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:ceeb9cc0-7148-339a-b82f-b2cc92501ecd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datras.ices.dk/Data_products/Download/Download_Data_public.aspx"},"dct:description":{"@language":"sv","@value":"De rådata som samlas in lagras hos SLU Aqua och uppdateras årligen. Rådata från alla deltagande länder lagras även hos ICES. Hos ICES finns dock inte data från kusttrålningen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"ICES DATRAS"}}],"@id":"urn:source:5a1041c381b9258e487f326f6fb6a24b9083b89de8ca54ae56ed872695326e8a"},{"@graph":[{"@id":"_:5a60eee7af6f380133204e3e8e3274ee6692c5647aaddaa02705370641325de4_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kommunen är den myndighet som ansvarar för byggnadsregistreringen och för att uppgifterna är korrekta.  Ajourhållningstiden varierar för de olika kommunerna."}},{"@id":"_:5a60eee7af6f380133204e3e8e3274ee6692c5647aaddaa02705370641325de4_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/cd8f3195-fc4e-40f5-941c-5d0d449fb09e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0cee0a30-fca6-1932-add6-583784c93f6e"},{"@id":"urn:uuid:9677837a-129f-b077-4000-93d3b741ce30"},{"@id":"urn:uuid:a62cb405-f9e1-bae2-4e93-0a850f8a4c62"},{"@id":"urn:uuid:d617e9f5-f8ff-8dd9-740c-5d04f9e65f4e"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Datamängd för alla byggnader med undantag för avregistrerade byggnader.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Byggnad Nedladdning Inspire och Basemap Visning, Inspire.\nDataset for all buildings except for unregistered buildings.\nThe dataset can’t be ordered separately. It is only included in existing services: Building Download IINSPIRE and Base map View Service INSPIRE"},"dct:identifier":"cd8f3195-fc4e-40f5-941c-5d0d449fb09e","dct:issued":{"@type":"xsd:date","@value":"2013-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-01"},"dct:provenance":{"@id":"_:5a60eee7af6f380133204e3e8e3274ee6692c5647aaddaa02705370641325de4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:5a60eee7af6f380133204e3e8e3274ee6692c5647aaddaa02705370641325de4_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för byggnad Inspire"}},{"@id":"urn:uuid:0cee0a30-fca6-1932-add6-583784c93f6e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/basemap/wms/v1?service=WMS&request=GetCapabilities&version=1.3.0"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för tjänsten Basemap Visning, Inspire (öppen capabilityfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Basemap Visning, Inspire"}},{"@id":"urn:uuid:9677837a-129f-b077-4000-93d3b741ce30","