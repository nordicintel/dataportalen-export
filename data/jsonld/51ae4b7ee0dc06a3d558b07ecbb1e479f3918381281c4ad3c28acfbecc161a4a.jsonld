5 56.40177,13.42455 57.19261))"}},{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a9f8aeff-9732-4b7a-bb17-b61f1e19b8c9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:576cd1dd-6a7a-b9be-8c61-f7466cd20fee"},{"@id":"urn:uuid:7ad8a72c-7b09-982e-7b7d-a270fb3dd715"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventering av offentliga lokaler i länet 1995. Ordenshus, nykterhetslokaler, frikyrkobyggnader med flera."},"dct:identifier":"a9f8aeff-9732-4b7a-bb17-b61f1e19b8c9","dct:issued":{"@type":"xsd:date","@value":"1995-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1995-01-01"},"dct:provenance":{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Offentliga lokaler"}},{"@id":"urn:uuid:576cd1dd-6a7a-b9be-8c61-f7466cd20fee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg205_kofflok.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:7ad8a72c-7b09-982e-7b7d-a270fb3dd715","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/5"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:b47b5f16c5ea15ca60523085171fc23956e10629eb9342707c0de448ad549c41"},{"@graph":[{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Karteringsarbetet av markens stabilitet i finkorniga jordar inom bebyggda områden har pågått sedan 1986. Det är ett riksomfattande arbete som utförs successivt och kommunvis.  Från 1986 till 2009 hade Räddningsverket i uppgift att utföra översiktliga stabilitetskarteringar. Då Räddningsverket upphörde 31 december 2008 övergick uppdraget att framställa översiktliga karteringar till Myndigheten för samhällsskydd och beredskap, MSB. Digitala redovisningar av karterade områden har pågått sedan år 2001. Olika konsulter har utförd den digitala redovisningen något olika. Under år 2010-2011 har därför MSB harmoniserat alla karteringar som fanns i digitalt format till ett gemensamt format och sammanfört alla olika karteringar till nationella skikt.\n\nGenom att studera jordarter, topografi, närhet till vattendrag och i fält studera grundvattenutströmning i slänter kan marken delas in i stabilitetszoner för karta 1A. För karta 1B genomförs studier av befintliga geotekniska utredningar och nya fältundersökningar. Utifrån stabilitetsberäkningar kan markens stabilitet bedömas och rekommendationer om fortsatta utredningar lämnas.\n\nUnderlaget till den översiktliga stabilitetskarteringen utgörs av Fastighetskartan, Jordartskarta, kommunala primärkartor, Topografiska kartan, tidigare geotekniska utredningar samt nya fältundersökningar.\n\nInsamling görs när respektive kommun har karterats. Kartering har i första hand prioriterats i de kommuner där förutsättningarna för skred är som störst; Västra Götalands län, Värmlands län, Västernorrlands län och Västerbottens län."}},{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.88 68.97,24.18 68.97,24.18 55.30,10.88 55.30,10.88 68.97))"}},{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2001"}},{"@id":"https://www.geodata.se/resources/2905b7b7-be1d-45d5-9f62-9278680eb4f2","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1e30d98a-d6d3-62af-673b-cb5ff7977025"},{"@id":"urn:uuid:2a7459a0-e0e3-f9cc-1330-45d435a9100a"},{"@id":"urn:uuid:6c54e339-76bc-8255-a86d-39a56d17ef21"},{"@id":"urn:uuid:b05d15c6-1db8-2386-85c5-b0a1ca3314a7"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"MSB har regeringens uppdrag att stödja kommuner och länsstyrelser med översiktliga kartläggningar av markens stabilitet i bebyggda områden där det finns förutsättningar för jordrörelser. Syftet är att identifiera bebyggda områden som översiktligt inte kan klassas som stabila. Karteringen ska utgöra ett stöd i kommunens riskinventering och riskhantering och kan användas som underlag för kommunens översiktplaner. Avsikten är att kommunen själv ska gå vidare och utföra detaljerade utredningar i utpekade områden.\nData redovisar\n•\tområden som översiktligt identifierats ha tillfredsställande stabilitet.\n•\tområden som översiktligt inte kan klassas som tillfredsställande stabilt eller som är otillräckligt utrett. På grund av avsaknad av bebyggelse rekommenderas inte detaljerad utredning.\n•\tområden som översiktligt inte kan klassas som tillfredsställande stabilt eller som är otillräckligt utrett och detaljerad utredning rekommenderas.\n•\tområden där detaljerad utredning bedöms som speciellt angeläget.\n•\tområden som tidigare har klassats som tillfredsställande stabilt eller som har förstärkts men som inte har följt skredkommissionens anvisningar.\n•\tområden där översyn av tidigare utredningar och stabiliserande åtgärder bedöms som speciellt angeläget.\nDessutom ingår filer som visas kvickleraförekomst, fyllning, stabilitetsåtgärder och stabilitetszoner i datamängden.\n\nKartfiler i digital form finns för karteringar genomförda efter 2001. Karteringen är genomförd inom begränsade områden som är bebyggda och där förutsättningar för skred bedöms finnas.\nÖver tiden kan exempelvis erosion och mänsklig aktivitet påverka förhållandena.\nDen översiktliga stabilitetskarteringen visar rådande stabilitetsförhållanden vid karteringstillfället. Innehållet i och tillförlitligheten hos de översiktliga stabilitetskarteringarna varierar eftersom metoderna förfinats med åren. MSB gör inte några uppdateringar av materialet utifrån förändrade förhållanden eller genomförda utredningar eller förstärkningar."},"dct:identifier":"2905b7b7-be1d-45d5-9f62-9278680eb4f2","dct:issued":{"@type":"xsd:date","@value":"2000-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2000-01-01"},"dct:provenance":{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b1n0"},"dct:temporal":{"@id":"_:b48932dc83246dbbf171af90d80cc424c04e70d73794418499884d7bf2e85923_b2n0"},"dct:title":{"@language":"sv","@value":"Översiktlig stabilitetskartering"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:1e30d98a-d6d3-62af-673b-cb5ff7977025","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/StabKart.zip"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av Översiktliga stabilitetskarteringar i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:2a7459a0-e0e3-f9cc-1330-45d435a9100a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/stabilitet/ows?"},"dcat:mediaT