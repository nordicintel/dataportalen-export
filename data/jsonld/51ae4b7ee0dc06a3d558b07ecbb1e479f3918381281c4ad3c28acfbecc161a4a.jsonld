e","@value":"2024-11-15"},"dct:provenance":{"@id":"_:b28baa2231ffa89c0d18ef1ca0230499f0c0925d8c9c33f900e223cf5ffc0387_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:b28baa2231ffa89c0d18ef1ca0230499f0c0925d8c9c33f900e223cf5ffc0387_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Kulturmiljövårdsprogrammet"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b28baa2231ffa89c0d18ef1ca0230499f0c0925d8c9c33f900e223cf5ffc0387_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b28baa2231ffa89c0d18ef1ca0230499f0c0925d8c9c33f900e223cf5ffc0387_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:b5e497bd-0b9a-4f67-b66a-03d68bf600bd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg401_kultpr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:f6a14bed-9dd6-7c96-7f7c-80188936b887","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:b28baa2231ffa89c0d18ef1ca0230499f0c0925d8c9c33f900e223cf5ffc0387"},{"@graph":[{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/83724c31-7ce9-4a13-bdd9-d57656a077e7","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:962230b2-cc85-8c7e-b4b2-0167c2f9418c"},{"@id":"urn:uuid:fa89d13c-b22c-a598-4666-204024367d8d"}],"dcat:keyword":[{"@language":"sv","@value":"Administrativa enheter"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Detta är inspirerepresentationen av baslinjer. Mer information finns i metadata för Baslinjer.\n\nLagen (2017:1272) om Sveriges sjöterritorium och maritima zoner gäller från och med 1 mars 2018\nBaslinjer och gränser redovisas med samtliga koordinater i bilagor till lagen. De linjer som definierar gränserna har delats i kortare segment för att redovisas korrekt i förekommande kartprojektioner. \nBaslinjepunkter, punkter på lågvattenlinjen och lågvattenskär har inspekterats och mätts in och ligger till grund för den beräkning som gjorts av sjöterritoriets gräns i havet och gränsen för angränsande zon. Räta baslinjer går mellan baslinjepunkter belägna på kustens lågvattenlinje (-0,5 meter RH2000) och följer kustens huvudriktning. Normala baslinjer förekommer längs vissa delar av Skånes, Ölands och Gotlands kuster och följer lågvattenlinjen längs de kuststräckor där vi inte har räta baslinjer. Punkterna på lågvattenlinjen är belägna på normala baslinjer och har valts ut i de fall läget förväntas påverka beräkningen av sjöterritoriets gräns i havet. Lågvattenskär är belägna utanför baslinjerna och har valts ut på motsvarande grunder.\n\nFöljande attribut finns i punkt shape-filen:\nLöpnr_dels - Löpnummer för baslinjepunkterna (BP) för respektive delsträcka.\nDelsträcka – Baslinjerna redovisas med följande delsträckor; Fast land och Öland, Gotland inklusive Fårö och Lilla Karlsö, Gotska Sandön, Stora Karlsö, Märket, Märkeshällarna.\nPunktnummer_namn – Nummer och namn på baslinjepunkter och lågvattenskär\nLatitud & Longitud - Alla punkter utmed gränsen beskrivs med geografiska koordinater i latitud och longitud uttryckta i referenssystemet SWEREF 99 dels i grader och decimala minuter som det står i lagen och dels i decimala grader.\nPunkttyp - Följande punkttyper förekommer:\n• punkt på lågvattenlinjen utmed normal baslinje (LP),\n• ändpunkt på rät baslinje, baslinjepunkt (BP),\n• segmenterad punkt på en rät geodetisk linje mellan två baslinjepunkter\n(MP), och\n• punkt på lågvattenskär beläget utanför en baslinje (LS).\nTyp av baslinje - Vilken typ av baslinje (rät/normal) som startar i punkten.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner. \nUnikt ID – Ett unikt ID som Sjöfartsverket adderat.\n\nFöljande attribut finns i linje shape-filen:\nDelsträcka – Delsträcka för rät baslinje.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner."},"dct:identifier":"83724c31-7ce9-4a13-bdd9-d57656a077e7","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b1n0"},"dct:temporal":{"@id":"_:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1_b2n0"},"dct:title":{"@language":"sv","@value":"AU.Baseline"}},{"@id":"urn:uuid:962230b2-cc85-8c7e-b4b2-0167c2f9418c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/pages/110583/Baslinjer.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av shapefile med baslinjer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Baslinjer-shape"}},{"@id":"urn:uuid:fa89d13c-b22c-a598-4666-204024367d8d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Havsgranser/Baslinjer/"},"dct:description":{"@language":"sv","@value":"Information om baslinjer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Baslinjer"}}],"@id":"urn:source:b2920fa41d8bf431c6cd8eee6ec045a4384370d634e9f53ce4196bd63ea37dc1"},{"@graph":[{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventering i fält samt digitalisering"}},{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2017"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1994"}},{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/826540b3-0f0b-4864-9d3f-7d4e1771c70c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:60c9caf2-2d2d-0274-4854-f6de06694032"},{"@id":"urn:uuid:e0735d10-0ed6-f4ca-c5c0-3cf971348bc3"}],"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Naturtyper och biotoper"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/hb"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En nyckelbiotop är ett skogsområde som från en samlad bedömning av biotopens struktur, artinnehåll, historik och fysiska miljö idag har mycket stor betydelse för skogens flora och fauna. Där finns eller kan förväntas finnas rödlistade arter."},"dct:identifier":"826540b3-0f0b-4864-9d3f-7d4e1771c70c","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-09-27"},"dct:provenance":{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b1n0"},"dct:temporal":{"@id":"_:b29b1855126e2a702cffd7f567241ad5359be24186f0202e25ecee88c1094161_b2n0"},"dct:title":{"@language":"sv","@value":"HB.Nyckelbiotoper inventerade av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type