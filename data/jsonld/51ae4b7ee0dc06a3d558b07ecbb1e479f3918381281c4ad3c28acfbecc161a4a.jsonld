language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tillståndspliktig miljöfarlig verksamhet. Denna datamängd innehåller punkter för anläggningar för energiproduktionsanläggningar enligt NACE D35. \n\nKälla: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfarlig verksamhet. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län.\n\nDatamängden saknar uppgifter om vattenkraftsproduktion.\n.."},"dct:identifier":"07f2fd09-574e-4169-a2dd-577139922dc3","dct:issued":{"@type":"xsd:date","@value":"2019-09-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:88e121b2b562afd5ee0db877508fb269302b80c96d1975cb262c8a722aadaed3_b0n0"},"dct:title":{"@language":"sv","@value":"SE.PF Energiproduktionsanläggningar (NACE D)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:353a77df-1c7c-2b36-811a-a034351dda41","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_pf/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:88e121b2b562afd5ee0db877508fb269302b80c96d1975cb262c8a722aadaed3_b1n0"},"http:/