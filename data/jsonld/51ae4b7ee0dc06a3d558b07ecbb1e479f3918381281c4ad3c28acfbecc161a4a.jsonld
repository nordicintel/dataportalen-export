0/01/rdf-schema#value":{"@language":"sv","@value":"Världsarv enligt UNESCO 2004"}},{"@id":"_:8c96b300b5111465e56718e644a94ae2036e73c3ade20a9157780cb598e34ee7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.36515 57.12801,12.43238 57.12801,12.43238 57.09074,12.36515 57.09074,12.36515 57.12801))"}},{"@id":"_:8c96b300b5111465e56718e644a94ae2036e73c3ade20a9157780cb598e34ee7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/c46834e0-edd2-4a1f-a266-92d9a47d3b1d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea"},"dcat:distribution":[{"@id":"urn:uuid:0663ac8c-36f6-4c8c-bd7b-4da5dbeb437f"},{"@id":"urn:uuid:38c42b5f-ccf0-f54c-6ede-8668afabb9df"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Radiostation i Grimeton öppnade för telegramtrafik 1924 och är idag ensam kvar av det världsomspännande nätverk med nio stationer som företaget General Electric byggde upp under åren 1918 till 1924. Stationerna försågs med dåtidens mest avancerade teknik för trådlös långvåg, uppfunnen av den svensk-amerikanske ingenjören Ernst F W Alexanderson. De sex 127 meter höga antenntornen syns vida i det öppna landskapet. Radiostationen blev skyddad som byggnadsminne 1996 och förklarades som världsarv av UNESCO:s världsarvskommitté 2004, med motiveringen att ”Grimeton Radiostation, Varberg, är ett unikt och enastående monument som representerar utvecklingsprocessen inom kommunikationsteknologin under perioden efter första världskriget\"."},"dct:identifier":"c46834e0-edd2-4a1f-a266-92d9a47d3b1d","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-02-24"},"dct:provenance":{"@id":"_:8c96b300b5111465e56718e644a94ae2036e73c3ade20a9157780cb598e34ee7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:8c96b300b5111465e56718e644a94ae2036e73c3ade20a9157780cb598e34ee7_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Grimeton"}},{"@id":"urn:uuid:0663ac8c-36f6-4c8c-bd7b-4da5dbeb437f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_Grimeton.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8c96b300b5111465e56718e644a94ae2036e73c3ade20a9157780cb598e34ee7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:38c42b5f-ccf0-f54c-6ede-8668afabb9df","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://grimeton.org/"},"dct:description":{"@language":"sv","@value":"Hemsida"},"dct:form