3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtagen enligt förordning (2009:956) om översvämningsrisker 2018"}},{"@id":"_:a3441a6dcd7b7e9c53a1e5604fc4092b8329bde875a5e309100739b94c1e63ff_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"https://www.geodata.se/resources/f4976af1-5d2f-40eb-b1bd-b9c34c304e7c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2a19460d-8ffe-8a1d-17ea-42664f73dfd0"},{"@id":"urn:uuid:53e99ff0-16d2-9b48-1e77-5cfe8a4e1ead"},{"@id":"urn:uuid:87132a5d-2e6f-36eb-5b10-47b06e022812"},{"@id":"urn:uuid:ee4def61-e861-a480-dde0-6cde0500cf1c"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Punktobjekt som redovisar mittpunkten för berörd tätort för Sveriges områden med betydande översvämningsrisk (APSFR) enligt förordningen (SFS 2009:956) om översvämningsrisker. Datamängden är ett resultat av revidering av steg 1 för cykel 2 inom översvämningsdirektivet. MSB utförde revideringen och identifierade områdena under2017-2018. \nDatamängden visar Sveriges områden med betydande översvämningsrisk (APSFR) enligt förordningen (SFS 2009:956) om översvämningsrisker. MSB har reviderat steg 1 enligt översvämningsförordningen under 2017 - 2018. Områdena redovisas endast som ett punktobjekt och inte utbredningen för området. Mer information finns att läsa på https://www.msb.se/sv/amnesomraden/skydd-mot-olyckor-och-farliga-amnen/naturolyckor-och-klimat/oversvamning/oversvamningsdirektivet/"},"dct:identifier":"f4976af1-5d2f-40eb-b1bd-b9c34c304e7c","dct:issued":{"