r alla träd som är över fem meter höga i öppen mark och tätorter i Hallands län. Kartläggningen har gjorts av Geografiska Informationsbyrån. Underlag för kartläggningen är Skogsstyrelsens rasterskikt som baseras på laserdata från den nationella höjdmodellen. Se vidare i leveransbeskrivning."},"dct:identifier":"c142f045-dc4d-4b53-913b-3610433af035","dct:issued":{"@type":"xsd:date","@value":"2017-11-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-11-16"},"dct:provenance":{"@id":"_:e5d5d29d7026af00aa21d6ed12c4103a0208adfc2e307a232e4b72d42bc20612_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:e5d5d29d7026af00aa21d6ed12c4103a0208adfc2e307a232e4b72d42bc20612_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Trädkartering laser 2017 (GI) - träd"}},{"@id":"urn:uuid:8d02713c-5003-fb4b-1a92-dbac514db8f5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_GI_Tradkartering_trad.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:9d869934-6c32-8bcb-58ad-62a29ea45794","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Enheten för naturvård och miljöövervakning","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e5d5d29d7026af00aa21d6ed12c4103a0208adfc2e307a232e4b72d42bc20612_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Enheten för naturvård och miljöövervakning"}],"@id":"urn:source:e5d5d29d7026af00aa21d6ed12c4103a0208adfc2e307a232e4b72d42bc20612"},{"@graph":[{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Vindkarteringen togs fram år 2011 enligt MIUU-modellen och de metoder som har utvecklats vid Uppsala universitet."}},{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ea553fb5-a80d-4cf3-84ae-74593cd34918","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:distribution":[{"@id":"urn:uuid:68c3eb62-fe43-2e1b-5310-ac4470404b82"},{"@id":"urn:uuid:7490560f-71f0-32bf-4a98-8d52d6a5b561"},{"@id":"urn:uuid:97f2be32-6092-7991-ab4e-e80c78c14e96"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Den nationella vindkarteringen är en kartläggning av vindförhållandena i Sverige genom en modellberäkning av vindhastigheten. Den senaste vindkarteringen togs fram år 2011 enligt MIUU-modellen och de metoder som har utvecklats vid Uppsala universitet.\n\nVindkarteringen är gjord med en matematisk-fysikalisk modell (MIUU-modellen) som beskriver tillstånd i atmosfären såsom vindhastigheten. Modellen bygger på stor mängd grunddata och modellberäkningarna baseras på 192 modellerade fall av väder samt olika vind- och temperaturförhållanden som vägs samman. Resultatet har sedan analyserats statistiskt ur ett långtidsperspektiv för att göra årsklimatet representativt för en 30-års period.\n\nUpplösningen i denna vindkartering är 0,25 km2 vilket ger större variationer och upplösning i terräng och vindhastighet än tidigare vindkartering, trots detta förekommer det fortfarande variationer i terrängen vid mindre skala. Dessa variationer påverkar vindhastigheterna lokalt, men förbises av modellen på grund av vald upplösning. Detta betyder att lokala variationer och mer komplex terräng därför inte syns i vindkarteringen, vilket kan innebära att såväl högre som lägre vindhastigheter i praktiken förekommer.\n\nDet bör noteras att denna modellberäkning av årsmedelvinden är schablonkorrigerad avseende nollplansförskjutningen för att kunna ange höjd ovan mark. Nollplansförskjutningen är normalt cirka ¾ av vegetationens höjd, vilket i denna vindkartering innebär 15 meter.\n\nDenna datamängd och metadata tillhandahålls åt Energimyndigheten av Länsstyrelserna genom datavärdskap. \n\nInformation om datamängden och metodik finns på Energimyndighetens sida:\nhttp://www.energimyndigheten.se/fornybart/vindkraft/planering-och-tillstand/vindkraftsplanering1/nationell-vindkartering/"},"dct:identifier":"ea553fb5-a80d-4cf3-84ae-74593cd34918","dct:issued":{"@type":"xsd:date","@value":"2019-10-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-01-22"},"dct:provenance":{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b1n0"},"dct:title":{"@language":"sv","@value":"SE.ER Vindkartering 140m (2011)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:68c3eb62-fe43-2e1b-5310-ac4470404b82","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_er/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e5d636ab5e0a5dfc38ce77976d6f4fc7b5161dbe0c786c3f058fd43b7a8605d8_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"},{"@id":"urn:uuid:7490560f-71f0-32bf-4a98-8d52d6a5b561","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/er_vindkartering_140m_2011.xml"},"dct:description":{"@language":"sv","@value":"LST ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST ATOM"}},{"@id":"urn:uuid:97f2be32-6092-7991-ab4e-e80c78c14e96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.energimyndigheten.se/fornybart/vindkraft/planering-och-tillstand/vindkraftsplanering1/nationell-vindkartering/"},"dct:description":{"@language":"sv","@value":"Sida hos information med information om Vindkartering, metodik samt fler hö