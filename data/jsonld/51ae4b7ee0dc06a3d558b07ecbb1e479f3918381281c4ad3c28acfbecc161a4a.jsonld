":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.49368 57.05051,12.59444 57.05051,12.59444 57.01543,12.49368 57.01543,12.49368 57.05051))"}},{"@id":"_:cdcdb91d97726ae3fdf8701695667faaa5adceca4814b2ce9c3f724d61bc7966_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/e0da3927-27e7-497a-b0cf-124b140ea033","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea"},"dcat:distribution":{"@id":"urn:uuid:7ea0a95c-59e3-ee60-6d4b-b981adf44aa7"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Kunskapsöversikt framtagen inom länsstyrelsens projekt Vattenförvaltning och kulturarv, VaKul. Innefattar karakterisering och kartläggning av områdets kulturmiljövärden. I arbetet från 2013 och framåt har fältpunkter lagts till i LstN Vattenanknutna kulturmiljöer punkt."},"dct:identifier":"e0da3927-27e7-497a-b0cf-124b140ea033","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-03-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:cdcdb91d97726ae3fdf8701695667faaa5adceca4814b2ce9c3f724d61bc7966_b0n0"},"dct:title":{"@language":"sv","@value":"LstN Vattenanknutna kulturmiljöer punkt GPS"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:cdcdb91d97726ae3fdf8701695667faaa5adceca4814b2ce9c3f724d61bc7966_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:7ea0a95c-59e3-ee60-6d4b-b981adf44aa7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_Vattenanknutna_kulturmiljoer_punkt_falt.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:cdcdb91d97726ae3fdf8701695667faaa5adceca4814b2ce9c3f724d61bc7966"},{"@graph":[{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Slingram-data från flygmätningar har samlats in av LKAB och SGU mellan åren 1980 och 1991. Metoden bygger på att en spole sänder ut ett konstant elektromagnetiskt fält med bestämd frekvens, samtidigt som en mottagarspole, belägen på ett fast avstånd från sändarspolen, registrerar det resulterande elektromagnetiska fältet. Primärfältet från sändaren reduceras bort, vilket ger det fält som inducerats av elektriskt ledande strukturer i marken. Levererade data avser information om det inducerade fältet, från vilket markens elektriska ledningsförmåga kan beräknas.\n\nMätsystemet kan bestå av ett eller flera spolpar. Två olika mätsystem har använts; Slingram 80 och Slingram 84. Slingram 80 använde en frekvens (3720 Hz), medan Slingram 84 använde två frekvenser (910 Hz och 7040 Hz). Lägre frekvenser speglar förhållandena på större djup. LKAB använde endast Slingram 80 och SGU använde båda systemen vid olika tidpunkter.\n\nFlyghöjd över marken är 30 m och mätlinjeseparationen är 100 m till 800 m. Mätpunktsavståndet varierar mellan 20 m och 40 m. \n\nDatakvalitet:\nMätvärdena i en mätpunkt representerar medelvärdet över en större yta på marken ner till några decimeters djup. För uran och torium har radiometrisk jämvikt förutsatts i sönderfallskedjan.\n\nEn sammanvägd relativ kvalitetsbedömning har även gjorts, vilken redovisas som ett kvalitetsvärde (QUALITY) från 1 och uppåt, där 1 är lägsta kvalitet. Kvalitetsbedömningen utgår huvudsakligen från vilket mätsystem som använts. Generellt sett är modernare mätningar av högre kvalitet än äldre och kan därmed bli allt bättre."}},{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.028321585655 68.270292587629,24.353912206579 68.270292587629,24.353912206579 57.157108908275,14.028321585655 57.157108908275,14.028321585655 68.270292587629))"}},{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1991"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1980"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/5fd1debb-bb64-4b03-8c8f-fe7c891d694d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:4957c7da-6946-d6d2-565f-f73305ccb38f"},{"@id":"urn:uuid:6ae20efe-a972-aff4-08e0-7d8c549563c5"},{"@id":"urn:uuid:7924105d-b56e-1dd7-b1e4-b58f0997e878"},{"@id":"urn:uuid:c4694c30-1ee8-c343-ca50-b14b3304c9b9"},{"@id":"urn:uuid:f9af57c4-6f7e-5d95-9968-73d49f333a6a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Genom att mäta hur marken reagerar på elektromagnetiska vågor går det att få information om markens förmåga att leda elektrisk ström. God elektrisk ledningsförmåga är exempelvis förknippat med vissa typer av bergarter, vattenförande sprickzoner i berggrunden eller vattenrika jordarter.\n\nGeofysiska flygmätningar, slingram (detaljerad) innehåller punktinformation om det inducerade (sekundära) elektromagnetiska fältets real- och imaginärdel från flygburna mätningar med slingram-system i syfte att skapa en bild av markens ledningsförmåga."},"dct:identifier":"5fd1debb-bb64-4b03-8c8f-fe7c891d694d","dct:issued":{"@type":"xsd:date","@value":"2016-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b1n0"},"dct:temporal":{"@id":"_:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, elektromagnetiska fält, slingram (detaljerad)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:4957c7da-6946-d6d2-565f-f73305ccb38f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-elektromagnetiska-falt-slingram-detaljerad-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:6ae20efe-a972-aff4-08e0-7d8c549563c5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/om-sgu/verksamhet/kartlaggning/geofysik_att_se_ner_i_berget/flyggeofysisk-matning/"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sveriges geologiska undersökning"}},{"@id":"urn:uuid:7924105d-b56e-1dd7-b1e4-b58f0997e878","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-slingram-detaljerad/geofysik-flyg-em-slingram-detaljerad.zip"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: GeoPackage med flygområden"}},{"@id":"urn:uuid:c4694c30-1ee8-c343-ca50-b14b3304c9b9","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-flyg-em-slingram-detaljerad/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:f9af57c4-6f7e-5d95-9968-73d49f333a6a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-em-slingram-detaljerad/1980_FUAO_30037.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: Exempel XYZ-fil för flygområde 1980_FUAO_30037"}}],"@id":"urn:source:cde2e9d2d9dbf6bea9a1007d04461a6c4b681e2c0fc890ab495e353adea587ac"},{"@graph":[{"@id":"_:cdf0bbaaca5ce77c857e14f3d776ad08983aa0972d9e90f1237df71cad19d9f3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från i mitten på 1930-talet började man framställa de Ekonomiska kartorna. Den geometriska kvaliteten hos förrättningskartorna varierar beroende på när de framställts. Det finns fastighetsgränser som är inmätta under 1800-talet. I allmänhet är fastighetsgränser i mer samlad bebyggelse av senare datum och av bättre kvalitet. Under åren 1992-97 digitaliserades den analoga informationen. Datamängden kompletterades och vidareutvecklades med t.ex. förbättrad lägesnoggrannhet vid uppbyggnaden av Grundläggande Geografiska Data (GGD) 1995-2004. Fjällområdet karterades mellan åren 2006-2012. Efter att uppbyggnaden av GGD avslutades 2004 har fokus lagts på att förbättra informationens aktualitet och tillgänglighet. Uppdateringen av de topografiska objekten sker dels i egen regi och dels i samverkan med de myndigheter eller organisationer som ansvarar för respektive informationsslag. Fastighetsgränser mäts in i samband med förrättningar. Det sker i kommunal eller statlig regi. Gränserna kan även uppdateras i samband med kvalitetsförbättrande åtgärder."}},{"@id":"_:cdf0bbaaca5ce77c857e14f3d776ad08983aa0972d9e90f1237df71cad19d9f3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d74388b9-9618-4507-a09e-26963d381381","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:6f805dbf-82ff-a75e-2d56-4b5f457799eb"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten har ett liknande innehåll som Topografi 10 Nedladdning, vektor och är framtagen för att i första hand användas för utskrift. Kartan innehåller bland annat byggnader, markslag, vägar och fastighetsgränser. Kartan kan väljas med antingen fastighetsindelning eller vägnamn."},"dct:identifier":"d74388b9-9618-4507-a09e-26963d381381","dct:issued":{"@type":"xsd:date","@value":"2018-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-01"},"dct:provenance":{"@id":"_:cdf0bbaaca5ce77c857e14f3d776ad08983aa0972d9e90f1237df71cad19d9f3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:cdf0bbaaca5ce77c857e14f3d776ad08983aa0972d9e90f1237df71cad19d9f3_b1n0"},"dct:title":{"@language":"sv","@value":"Karta 1:10 000 med fastighetsindelning Nedladdning, raster"}},{"@id":"urn:uuid:6f805dbf-82ff-a75e-2d56-4b5f457799eb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/karta-1-10-000-nedladdning-raster"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Karta 1:10 000 Nedladdning, raster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Karta 1:10 000 Nedladdning, raster"}}],"@id":"urn:source:cdf0bbaaca5ce77c857e14f3d776ad08983aa0972d9e90f1237df71cad19d9f3"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/cd03efe9-6ace-47cf-912d-b0b15fb4e8bd","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-25-100-tusen-genomslapplighet"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"sv","@value":"Produkten är tänkt att användas t ex som ett första underlag vid bedömning av spridningsrisken av förorenande ämnen från olyckor. Med tanke på eventuella brister i underlaget skall alltid en platsspecifik bedömning göras i terrängen."},{"@language":"sv","@value":"Visningstjänsten presenterar en starkt förenklad bild över markens genomsläpplighet. Produkten bygger på en omklassning av grundlagret i datamängden JORDARTER 1:25 000 – 1:100 000 till fyra klasser av genomsläpplighet: låg, medelhög, hög eller ej bedömd genomsläpplighet.\nLäs mer om den bakomliggande datamängden här: https://resource.sgu.se/dokument/produkter/jordarter-25-100000-beskrivning.pdf.\nKlassificeringen baseras på kornstorlek hos jordarten i grundlagret. En jordarts förmåga till genomsläpplighet beror dock inte bara på kornstorlek utan även på t.ex. läge i terrängen, mättnadsgrad, grundvattennivå samt det utsläppta ämnets viskositet mm. Produkten tar inte hänsyn till detta, och inte heller till eventuella ytlager eller underliggande lager.\nProdukten är tänkt att användas t ex som ett första underlag vid bedömning av spridningsrisken av förorenande ämnen från olyckor. Med tanke på eventuella brister i underlaget skall alltid en platsspecifik bedömning göras i terrängen."}],"dct:identifier":"cd03efe9-6ace-47cf-912d-b0b15fb4e8bd","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Genomsläpplighet (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ce31447a0b7a5bbbf57fa010996e3008c7f03960b634d66db5e8b4d651088588"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ffb16e9e-e7f0-432a-b89e-b5ddf1744e9c","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/mrr"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten för mineralrättigheter är ett utdrag ur Bergstatens mineralrättsregister. Här kan du se ansökta och beviljade bearbetningskoncessioner och undersökningstillstånd. Information om tillståndets identitetsnummer, namn på tillståndet, ägare till tillståndet samt giltighetstiden finns tillgänglig."},"dct:identifier":"ffb16e9e-e7f0-432a-b89e-b5ddf1744e9c","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Mineralrättigheter (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ce8b72113549e8addc6c4cbfe3d0e436169ebc37acc3d9f2a8d0221d78ba2502"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/608917af-128d-47bd-8047-451550f19107","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markreglerande-bestammelse-visning-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten presenterar information om planer och bestämmelser som redovisas i Fastighetsregistrets allmänna del. Informationen är uppdelad i fem separata skikt; Bestämmelser, Gränspunktstext, bestämmelser, Fastighetsplaner, Detaljplaner och Ändring av detaljplaner."},"dct:identifier":"608917af-128d-47bd-8047-451550f19107","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Markreglerande bestämmelse Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ced11fce7229a2395d4ee0e392a66eecb582a7c1828d1d897722d7f98061a1f2"},{"@graph":[{"@id":"_:cef8eaec257c3ea08024ad75e0eafd3a66d546758c1d76f2c08721fb46861360_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Provtagning har skett i första hand i områden med ett befintligt vägnät. I områden utan vägar har transport skett till fots, med helikopter och med båt.\n\nSGU skickar kontinuerligt med egna standardprover tillsammans med ordinarie prover för att verifiera hur analyskvaliteten varierar över tid. Anlitade laboratorium använder även interna och externa geostandarder för att kontrollera sin kvalitet. De externa analyserna har normalt genomgått ett snarlikt förfarande.\n\nOxider anges i procent. Grundämnen anges i ppm förutom kol och svavel, vilka anges som totalhalt i procent. Fe2O3 anges vanligen som totalhalt i ICP-MS analyserna från 1990-talet och framåt.\n\nNoggrannhet för koordinatsättningen är ca +/- 10 m för de prov som är tagna från och med år 2006."}},{"@id":"_:cef8eaec257c3ea08024ad75e0eafd3a66d546758c1d76f2c08721fb46861360_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a20dee7a-ca67-4dc0-8426-11dbfa16c94e","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:04e2fb07-d0e6-edc2-10ab-9ebb4d8414e9"},{"@id":"urn:uuid:2e5cb37f-e866-7824-93c1-d7a75d52e286"},{"@id":"urn:uuid:2fc4689c-d43c-8f34-e623-ff68247c0807"},{"@id":"urn:uuid:3c066dce-9421-8d7b-a3af-66e6873e75f1"},{"@id":"urn:uuid:4090ace1-bac3-dc7e-ea8d-cd43d99d47ca"},{"@id":"urn:uuid:fe95604c-46ff-03f4-b64b-aa097b33b4c5"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Bergartskemi innehåller information om olika grundämnen i bergartsprov från Sverige. Provtagning har i huvudsak skett i anslutning till ordinarie fältarbeten vid SGU. Ett mycket stort antal analyser kommer från provtagna borrkärnor från främst prospekteringsbolag, där data enligt lagkrav lämnats in till Bergsstaten. En del analysvärden är hämtade från litteraturen. Analys har skett med olika så kallade analyspaket och analysmetoder, även olika laboratorium har använts över tiden. Datamängden Bergartskemi innehåller lägesuppgifter, kort beskrivning samt kemiska analyser av bergartsprover. Mängden information om proven, provtagningsmetodik, analys- och provberedningsmetod, analyslaboratorium och mängden analyserade element varierar stort."},"dct:identifier":"a20dee7a-ca67-4dc0-8426-11dbfa16c94e","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:cef8eaec257c3ea08024ad75e0eafd3a66d546758c1d76f2c08721fb46861360_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:cef8eaec257c3ea08024ad75e0eafd3a66d546758c1d76f2c08721fb46861360_b1n0"},"dct:title":{"@language":"sv","@value":"Bergartskemi"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:04e2fb07-d0e6-edc2-10ab-9ebb4d8414e9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-bergartskemi.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:2e5cb37f-e866-7824-93c1-d7a75d52e286","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/bergartskemi"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:2fc4689c-d43c-8f34-e623-ff68247c0807","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/lithogeochemistry-description.pdf"},"dct:description":{"@language":"sv","@value":"Product description (in English)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Product description"}},{"@id":"urn:uuid:3c066dce-9421-8d7b-a3af-66e6873e75f1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/bergartskemi/bergartskemi.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:4090ace1-bac3-dc7e-ea8d-cd43d99d47ca","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/bergartskemi/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:fe95604c-46ff-03f4-b64b-aa097b33b4c5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/bergartskemi-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:cef8eaec257c3ea08024ad75e0eafd3a66d546758c1d76f2c08721fb46861360"},{"@graph":[{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havs- och vattenmyndighetens kartläggning och övervakning av fysisk påverkan i svenska kustvatten startades 2017"}},{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 66.00,24.20 66.00,24.20 55.13,10.59 55.13,10.59 66.00))"}},{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/456c245d-9ba9-b8e7-8f7f-a629c3112022","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:05178902-fe27-61fb-0880-2b91b7ab9ea6"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Underlag eller skikt för potentiella påverkanszoner för nutida period (tiden närmast 2016). Påverkanszonerna visar en klassad risk (1–5) för påverkan på morfologiskt tillstånd, hydrografiska förhållanden och konnektivitet. Påverkanszonerna har tagits fram med utgångspunkt från fysiska påverkanstryck och naturmiljöns känslighet. Metoden med vilken zonerna tagits fram tar hänsyn till egenskaper hos objekten och hos den omkringliggande miljön, det vill säga djup, vågexponering och geologi eller bottensubstrat.\nPåverkanszonerna är inte tänkta att användas vid uppföljning och planering i detalj för enskilda objekt, utan på en mer övergripande nivå eller skala."},"dct:identifier":"456c245d-9ba9-b8e7-8f7f-a629c3112022","dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b1n0"},"dct:title":{"@language":"sv","@value":"Fysisk påverkan i svenska kustvatten 1960 och framåt: Påverkanzoner"}},{"@id":"urn:uuid:05178902-fe27-61fb-0880-2b91b7ab9ea6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-paverkanszoner/fysisk-paverkan-kust-paverkanszoner-2021-10-01.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Datapaket: Påverkans­zoner"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"}],"@id":"urn:source:cfe2e70a8fdbb38e7cde371fe2c558c197beef41959c1c7bff087e93822fd82b"},{"@graph":[{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"koordinaterna för anläggningarna är tagna utefter vattenverkens läge på hitta.se. Ursprungsvärden angivna i RT90 avrundat till närmast jämna 100-tal meter. t.ex. 6593700, 1613300, sedan transformerat till SWEREF99TM via lantmäteriets koordinattransformator."}},{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2001"}},{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/63c8f07f-c43f-40f4-8026-745de9ee262a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:8f744f52-ec01-5f50-50c2-628c66403fcc"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har sedan Tjernobylolyckan 1986 provtagit dricksvatten och mätt halter av radioaktiva ämnen, i huvudsak Cs-137. I nuvarande program provtas dricksvatten från 6 vattenverk 2 gånger per år vilket mäts med avseende på cesium-137, strontium-90, tritium (H-3), total-alfa, total-beta och radium-226. Halter i dricksvatten rapporteras även till EU i enlighet med Euratomfördraget. Data fr o m 2001 från dessa provtagningsstationer finns tillgängliga vis Strålsäkerhetsmyndighetens webbplats. Kartan visar provtagningsstationernas (vattenverkens) geografiska läge."},"dct:identifier":"63c8f07f-c43f-40f4-8026-745de9ee262a","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b1n0"},"dct:temporal":{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: radioaktiva ämnen i dricksvatten"}},{"@id":"urn:uuid:8f744f52-ec01-5f50-50c2-628c66403fcc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"}],"@id":"urn:source:d05c92818af3eaa13226b26b031161ac631adcf944dee425f5e05d986e94957b"},{"@graph":[{"@id":"_:d0bcda5c0f64f50c9b83a56fabc09be96b050ffe92bd053a775b4bfbc4bcfc85_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.809380423765 58.187238575521,15.665760275297 58.187238575521,15.665760275297 56.878972116417,12.809380423765 56.878972116417,12.809380423765 58.187238575521))"}},{"@id":"_:d0bcda5c0f64f50c9b83a56fabc09be96b050ffe92bd053a775b4bfbc4bcfc85_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/4b63a634-0507-417b-940a-18179db03386","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":[{"@id":"urn:uuid:a1a7ceb1-63c4-b3f6-a9f2-7bd47a2f02a1"},{"@id":"urn:uuid:f1bdb7dc-4729-1829-2f3b-04dce76990db"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Skikt över beslutade viltvårdsområden i Jönköpings län. Viltvårdsområden beslutade enligt lag (2000:592) om viltvårdsområden."},"dct:identifier":"4b63a634-0507-417b-940a-18179db03386","dct:issued":{"@type":"xsd:date","@value":"2004-05-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:d0bcda5c0f64f50c9b83a56fabc09be96b050ffe92bd053a775b4bfbc4bcfc85_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Viltvårdsområde (VVO)"}},{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Landenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d0bcda5c0f64f50c9b83a56fabc09be96b050ffe92bd053a775b4bfbc4bcfc85_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Landenheten"},{"@id":"urn:uuid:a1a7ceb1-63c4-b3f6-a9f2-7bd47a2f02a1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_viltvard_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:f1bdb7dc-4729-1829-2f3b-04dce76990db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.Viltvardsomraden.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:d0bcda5c0f64f50c9b83a56fabc09be96b050ffe92bd053a775b4bfbc4bcfc85"},{"@graph":[{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sveriges geologiska undersökning (SGU) bedriver en marin¬geologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål.\nMaringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (hydroakustisk profi¬lering) samt bottenyteavbildande mätningar (hydroakustisk yttäckning). \nBottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. \nBottenyteavbildande mätningar har för denna produkt utförts med sidoavsökande sonar. Mätningar med den bogserande sidoavsökande sonaren ger en yttäckande avbildning av havsbottenytans hårdhet. \nDe hydroakustiska data som samlats in tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där såväl mätningar som direkta sedimentprovtagningar och visuella observationer av de geologiska förhållandena gjorts. \nDe sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagningarna föregås av en besiktning av bottenytan med hjälp av undervattenskamera.\nEfter insamling och bearbetning görs en geologisk tolkning av materialet, för presentation i skala 1:500 000."}},{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.96 65.95,24.29 65.95,24.29 55.35,9.96 55.35,9.96 65.95))"}},{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2008"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1969"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/db06ea6f-1f4b-4aa7-bde6-c1579ff65ca2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0303240f-4f42-54cc-5783-fecaacbd7f58"},{"@id":"urn:uuid:61b1ea14-1a70-e241-4052-e2e471248e42"},{"@id":"urn:uuid:85c5f357-e193-b4a1-2ecc-ce2558511d94"},{"@id":"urn:uuid:bb3e2cb2-bb2a-900c-89b4-d1ebeb7375b3"},{"@id":"urn:uuid:c9506b76-bc47-3bf4-abd7-c317a9245a01"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag vid biologiska inventeringar samt för Försvarsmakten."},{"@language":"sv","@value":"Maringeologi 1:500 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Produkten ger bland annat information om bottenmaterial, olika sediments mäktighet och bildningssätt. \n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag för Försvarsmakten samt vid biologiska inventeringar."}],"dct:identifier":"db06ea6f-1f4b-4aa7-bde6-c1579ff65ca2","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b1n0"},"dct:temporal":{"@id":"_:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775_b2n0"},"dct:title":{"@language":"sv","@value":"Maringeologi 1:500 000"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0303240f-4f42-54cc-5783-fecaacbd7f58","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/maringeologi-500000-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:61b1ea14-1a70-e241-4052-e2e471248e42","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/maringeologi500k/maringeologi500k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:85c5f357-e193-b4a1-2ecc-ce2558511d94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/maringeologi-500-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:bb3e2cb2-bb2a-900c-89b4-d1ebeb7375b3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-maringeologi.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst.Innehåller marina sedimentprov och maringeologisk kartinformation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:c9506b76-bc47-3bf4-abd7-c317a9245a01","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/maringeologi500k/ogc/features/v1/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:d0bfab85a04cd8bd800d41e3cbf2dce03b46e93b800f3b0b3056d42330400775"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004185","@type":"foaf:Agent","dct:identifier":"2021004185","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.skolverket.se/"},"foaf:mbox":{"@id":"mailto:support.oppnadata@skolverket.se"},"foaf:name":{"@language":"sv","@value":"Skolverket"},"foaf:page":{"@id":"https://www.skolverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://dataportal.se/organisation/SE202100-4185"}},{"@id":"https://www.geodata.se/resources/71c432f6-3484-40f9-89d2-eb668f28d9aa","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://gis-services.metria.se/svfeed/SV_TopAtomFeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Skolenheter i Sverige för förskoleklass, grundskolan, anpassade grundskolan, specialskolan, sameskolan, gymnasieskolan samt anpassade gymnasieskolan. Uppgifterna avser läsåret 2024/25 och är fria för både privat och juridisk person att använda utan kostnad."},"dct:identifier":"71c432f6-3484-40f9-89d2-eb668f28d9aa","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004185"},"dct:title":{"@language":"sv","@value":"US.Skolenheter.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d0e8d56084cca0a73c2835ccb19762edaf93ab75177ee0ffa18e8af2f1af625e"},{"@graph":[{"@id":"_:d10f1952d7e5d480b41a671e752f27624885c7bbb531cbe80bcab68f4a4e05f4_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/e3327332-de5d-c4c1-7f82-8c2a36223095","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},"dcat:endpointURL":{"@id":"https://geodata.havochvatten.se/download/omr-skyddade-enl-sfs-2001-554/atom-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Områden skyddade enligt SFS 2001:554 (tidigare Områden skyddade enligt förordning om miljökvalitetsnormer för fisk- och musselvatten)."},"dct:identifier":"e3327332-de5d-c4c1-7f82-8c2a36223095","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Områden skyddade enligt SFS 2001:554.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d10f1952d7e5d480b41a671e752f27624885c7bbb531cbe80bcab68f4a4e05f4_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"}],"@id":"urn:source:d10f1952d7e5d480b41a671e752f27624885c7bbb531cbe80bcab68f4a4e05f4"},{"@graph":[{"@id":"_:d14b22dfed52de27d24fda10e59b7da72b6d7c2e4457f2543888b3e462ab0a12_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://gis.sgi.se/startgsp"}},{"@id":"_:d14b22dfed52de27d24fda10e59b7da72b6d7c2e4457f2543888b3e462ab0a12_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.039851888106 69.064001823926,25.958243331996 69.064001823926,25.958243331996 54.802444805481,11.039851888106 54.802444805481,11.039851888106 69.064001823926))"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/069ba893-e6c7-4bb1-8d55-922abddaab80","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:10cbec6e-0504-796a-8163-27a3eab39339"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Inom ramen för förstudien/utvecklingsprojektet \"Geoteknisk sektorsportal - nationell datainfrastruktur för tillgång till genomförda geotekniska undersökningar\" har en webbapplikation för registrering av (både analoga och GeoSuite digitala) geotekniska undersökningsområden utvecklats. Registering sker via ett särskilt WFS/OpenLayers-baserat gränssnitt eller som uppladd shp enligt en fastlagd struktur. I projektet deltar SGI, SGU, Trafikverket, SKL och Lantmäteriet och med finansiering från MSB. SGI är värd/huvudman för registreringsapplikationen och publicering av WMS. [Geoteknik]"},"dct:identifier":"069ba893-e6c7-4bb1-8d55-922abddaab80","dct:issued":{"@type":"xsd:date","@value":"2011-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:d14b22dfed52de27d24fda10e59b7da72b6d7c2e4457f2543888b3e462ab0a12_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:d14b22dfed52de27d24fda10e59b7da72b6d7c2e4457f2543888b3e462ab0a12_b1n0"},"dct:title":{"@language":"sv","@value":"Geotekniska undersökningsområden"}},{"@id":"urn:uuid:10cbec6e-0504-796a-8163-27a3eab39339","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/startgsp"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Geoteknisk sektorsportal"}}],"@id":"urn:source:d14b22dfed52de27d24fda10e59b7da72b6d7c2e4457f2543888b3e462ab0a12"},{"@graph":[{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geodata har tagits fram av Havs- och vattenmyndigheten. Utpekade områden baseras på ekonomiskt underlag samt vetenskapliga undersökningar, se FINFO 2006:1 och följande kompletteringar för mer information. Utformningen av sjöar och vattendrag följer SMHI:s SVAR databas, medans övriga områden har ritats av Havs- och vattenmyndigheten."}},{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.50 69.50,25.00 69.50,25.00 54.50,9.50 54.50,9.50 69.50))"}},{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/b81d9f82-3c24-bcea-6116-1ad5da653292","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:8ca7fdaf-a319-a7b4-b6c2-930a2b6f0297"},{"@id":"urn:uuid:ce2bab7b-be68-afc6-082d-a97930647446"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Områden som är av riksintresse för yrkesfisket är utpekade inom havsområde, sjöar och vattendrag samt för fiskehamnar.\n\nHavs- och vattenmyndigheten lämnar uppgifter om områden som är av riksintresse för yrkesfiske enligt Miljöbalkens bestämmelser om riksintresse, MB 3 kap. 5§.\n\nTillämpning av hushållningsbestämmelserna i MB 3 kap. 5 § innebär att planeringen för användning av mark- och vattenområden ska säkerställa fiskesektorns tillgång till fångstområden i både havet och inlandsvatten. Det är också avgörande att planeringen säkerställer nödvändig infrastruktur av hamnar med service för fiskefartygen och som erbjuder lämpliga möjligheter för landning av fångsten.\n\nBoverket anger i sin vägledning till riksintressemyndigheterna tre generella kriterier. De områden som anges som riksintresse för yrkesfiske uppfyller sammantaget dessa kriterier:\n\n1. området hyser värden av stor nationell vikt\n2. området behövs för att uppfylla Sveriges internationella åtaganden eller\n3. området behövs för att genomföra eller upprätthålla nationellt viktiga strukturer."},"dct:identifier":"b81d9f82-3c24-bcea-6116-1ad5da653292","dct:issued":{"@type":"xsd:date","@value":"2023-01-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-07"},"dct:provenance":{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b1n0"},"dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"},{"@id":"urn:uuid:8ca7fdaf-a319-a7b4-b6c2-930a2b6f0297","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/riksintresse-for-yrkesfiske/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske - WMS tjänst"}},{"@id":"urn:uuid:ce2bab7b-be68-afc6-082d-a97930647446","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/riksintresse-for-yrkesfiske/2023-08-07/riksintresse-for-yrkesfiske-2023-08-07.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Riksintresse för yrkesfiske - nedladdningsbar fil"}}],"@id":"urn:source:d2030368db05a6462c2a542d2d99eab29122a353c5a5e18e1ba29d8a6c731886"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/fdd69965-97f5-4296-88de-0f1a4316eafa","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojdmodell-visning-api"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten uppfyller kraven för EU-direktivet Inspire och visar rasterbilder över Sverige som visualiserar terrängens form i två varianter, en lutningsbild och en skuggningsbild. Tidigare hette produkten Höjdmodell Visning."},"dct:identifier":"fdd69965-97f5-4296-88de-0f1a4316eafa","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Markhöjdmodell Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d24121498c9bcc71ff34d4be5cbd79333b81421361660959745304b81b3364d1"},{"@graph":[{"@id":"_:d2562b6aeee239a8b72ac87fdabfebe11cd54e03456a2be5b83946a2ea12ae06_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Kartan sammanställdes ursprungligen under tidigt 1990-tal med befintliga jordartskartor i större skala som underlag, och överfördes manuellt till ett mycket översiktligt topografiskt underlag. Efter digitalisering låg informationen till grund för publicering av jordartskartan i Sveriges Nationalatlas, bandet Berg och jord (1994). Sedan dess har endast enstaka uppenbart felklassade ytor korrigerats, samt en omgjord klassificering gjorts för att överensstämma med övriga jordartskartor från SGU.\n\nLägesfelen är betydande beroende på den kraftiga generaliseringen och det mycket översiktliga topografiska underlaget, och kan uppgå till flera kilometer. Som exempel kan nämnas att utbredningen av isälvssediment är kraftigt överdriven för att de ska framträda tydligt i skala 1:1miljon."}},{"@id":"_:d2562b6aeee239a8b72ac87fdabfebe11cd54e03456a2be5b83946a2ea12ae06_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3e441ea4-1cd9-4249-8196-9b96853bbfba","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:6854e722-b168-a234-c91c-244f292492e8"},{"@id":"urn:uuid:8c114e91-0fc3-49f9-5c58-0b2872629bf1"},{"@id":"urn:uuid:b1543a1c-dc0e-7b61-1e58-68aa1ac82a84"},{"@id":"urn:uuid:c9e97933-97f8-f4e2-94ac-9ab2650c30c2"},{"@id":"urn:uuid:cb47e1e5-351c-7813-1eb8-5f9dcaf47b1c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kartan återger huvuddragen i Sveriges jordartsgeologi. Noggrannheten varierar eftersom den är en sammanställning baserad på jordartskartor i olika skalor och med skiftande kvalitet. Kartbilden är mycket kraftigt generaliserad och jordartsindelningen är grovt förenklad. Minsta redovisade yta är ca 1 km2.\n\nInformationen är endast avsedd att använda för översikter på nationell nivå, och bör utnyttjas med försiktighet i analyssammanhang."},"dct:identifier":"3e441ea4-1cd9-4249-8196-9b96853bbfba","dct:issued":{"@type":"xsd:date","@value":"2001-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2001-01-01"},"dct:provenance":{"@id":"_:d2562b6aeee239a8b72ac87fdabfebe11cd54e03456a2be5b83946a2ea12ae06_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:d2562b6aeee239a8b72ac87fdabfebe11cd54e03456a2be5b83946a2ea12ae06_b1n0"},"dct:title":{"@language":"sv","@value":"Jordarter 1:1 miljon"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6854e722-b168-a234-c91c-244f292492e8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordarter1miljon/jordarter1miljon.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:8c114e91-0fc3-49f9-5c58-0b2872629bf1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-jordarter-1-miljon.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:b1543a1c-dc0e-7b61-1e58-68aa1ac82a84","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordarter1miljon/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:c9e97933-97f8-f4e2-94ac-9ab2650c30c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-1-miljon"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:cb47e1e5-351c-7813-1eb8-5f9dcaf47b1c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordarter-1miljon-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}}],"@id":"urn:source:d2562b6aeee239a8b72ac87fdabfebe11cd54e03456a2be5b83946a2ea12ae06"},{"@graph":[{"@id":"_:d2924f380b993cf8df0b91bc1a3463593a93854ee30400314e29445706aa7b83_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Utanför kommunernas ansvarsområden har byggnadernas geometri huvudsakligen insamlats genom fotogrammetrisk detaljmätning av Lantmäteriet och externa aktörer i uppbyggnadsskedet. Uppdateringen har sedan skötts av Lantmäteriet. Innanför kommunens ansvarsområden har byggnadsgeometrierna insamlats av kommunen och levererats till Lantmäteriet som sedan bearbetat och lagrat dessa. Data från kommunerna kan ha olika ursprung. Vanligt är geodetisk och fotogrammetrisk detaljmätning men även andra mätmetoder förekommer."}},{"@id":"_:d2924f380b993cf8df0b91bc1a3463593a93854ee30400314e29445706aa7b83_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3caf63b6-b462-49f7-a89f-6dc0fa855ece","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0d83cec2-bea7-5b5d-4dfb-37fb93e28595"},{"@id":"urn:uuid:3d257a0a-c09d-f2f5-42e9-dcecac51720f"},{"@id":"urn:uuid:5afee852-6de8-f68f-177e-b1aa25958614"},{"@id":"urn:uuid:adb4769e-0620-c953-c162-753ec0c3067a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller byggnadsytor. Byggnaderna har information om ändamål och i vissa fall även namn."},"dct:identifier":"3caf63b6-b462-49f7-a89f-6dc0fa855ece","dct:issued":{"@type":"xsd:date","@value":"2025-02-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-24"},"dct:provenance":{"@