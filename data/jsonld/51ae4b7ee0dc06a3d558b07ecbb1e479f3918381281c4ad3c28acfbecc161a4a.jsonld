och torrlagts."},"dct:identifier":"dc20eee9-b5a3-19b3-3e9e-bfbbd1fb0391","dct:issued":{"@type":"xsd:date","@value":"2020-09-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:fd15809960f42bc1b0e842afdd9fe8ac6c1b2761bfe32de3f67b595031bd2750_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:fd15809960f42bc1b0e842afdd9fe8ac6c1b2761bfe32de3f67b595031bd2750_b1n0"},"dct:title":{"@language":"sv","@value":"Fysisk påverkan i svenska kustvatten 1960 och framåt: Nutid och historisk kartering"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fd15809960f42bc1b0e842afdd9fe8ac6c1b2761bfe32de3f67b595031bd2750_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:f63e29e6-2bac-74ed-1401-4b9da29102e7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/fysisk-paverkan-kust-nutid-och-historisk-kartering/fysisk-paverkan-kust-nutid-och-historisk-kartering-2021-10-01.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Datapaket: Nutid och historisk kartering"}}],"@id":"urn:source:fd15809960f42bc1b0e842afdd9fe8ac6c1b2761bfe32de3f67b595031bd2750"},{"@graph":[{"@id":"_:fd96c58376f17ade5ed29bb45a2527f9cc60598f24b1b4d2a75643cec93eddbe_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 69.05997,24.17767 69.05997,24.17767 55.13721,10.59208 55.13721,10.59208 69.05997))"}},{"@id":"_:fd96c58376f17ade5ed29bb45a2527f9cc60598f24b1b4d2a75643cec93eddbe_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/072b6b36-2cf6-4717-a616-bbf3fddea83d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:06741957-5243-b991-0a54-f232c5ab64d8"},{"@id":"urn:uuid:12196d5a-1fa0-da7a-cc5b-014931991fa1"},{"@id":"urn:uuid:1cd49a05-17b9-0f5b-b3d4-244e373ae217"},{"@id":"urn:uuid:294b9d9d-78a1-a308-6b44-bdca09a2aef9"},{"@id":"urn:uuid:bdd85eb7-2561-aea9-6510-1a8151e08815"},{"@id":"urn:uuid:cf4f2898-1ef5-6b28-4f58-0ac1b14cd976"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Detta kartlager visar Länsstyrelsernas tolkning av de områden som riksdagen beslutat är av riksintresse för rörligt friluftsliv enligt 4 kap. 2 § miljöbalken. Inom dessa områden skall ”turismens och friluftslivets, främst det rörliga friluftslivets, intressen särskilt beaktas vid bedömningen av tillåtligheten av exploateringsföretag eller andra ingrepp i miljön”. Denna bestämmelse har sitt ursprung i lagen (1987:12) om hushållning med naturresurser m.m. Då riksdagen fattade beslut om riksintresset fanns den geografiska avgränsningen enbart beskriven i text med ortsnamn och/eller andra geografiskt fasta punkter, samt en grov illustration i förarbetena (prop. 1985/86:3). Länsstyrelserna har senare gjort en mer preciserad tolkning av den geografiska avgränsningen i samråd med berörda kommuner. \n \nObservera att detta gis-skikt endast är en indikativ tolkning av gränserna. För aktuell avgränsning se gällande översiktsplan. Det är i den kommunala översiktsplaneringen som innebörden av de geografiska riksintressebestämmelserna i 4 kap miljöbalken kan konkretiseras.\n\nDet tidigare namnet Rörligt Friluftsliv förekommer på vissa platser och avser samma data.\n \nFör mer information om bakgrunden till riksintressebestämmelserna, se Boverkets vägledning i PBL kunskapsbanken."},"dct:identifier":"072b6b36-2cf6-4717-a616-bbf3fddea83d","dct:issued":{"@type":"xsd:date","@value":"2015-08-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:fd96c58376f17ade5ed29bb45a2527f9cc60598f24b1b4d2a75643cec93eddbe_b0n0"},"dct:title":{"@language":"sv","@value":"LST Riksintresse Turism och friluftsliv MB 4kap1,2"}},{"@id":"urn:uuid:06741957-5243-b991-0a54-f232c5ab64d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geoportal.lansstyrelsen.se/standard/?appid=81396d57b4c2491b8cd72d25b5a71b55&bookmarkid=10687"},"dct:description":{"@language":"sv","@value":"Kartvisare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:12196d5a-1fa0-da7a-cc5b-014931991fa1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/sv/PBL-kunskapsbanken/riksintressen/riksintressen-enligt-4-kap-mb/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Boverket, PBL-kunskapsbanken"}},{"@id":"urn:uuid:1cd49a05-17b9-0f5b-b3d4-244e373ae217","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Riksintressen_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Riksintresse turism och friluftsliv MB4kap2"}},{"@id":"urn:uuid:294b9d9d-78a1-a308-6b44-bdca09a2aef9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Geodata/Datadistribution/ZIP/LST_RI_Rorligt_friluftsliv_MB4kap2.zip"},"dct:description":{"@language":"sv","@value":"LYR-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"LYR-fil"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fd96c58376f17ade5ed29bb45a2527f9cc60598f24b1b4d2a75643cec93eddbe_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:bdd85eb7-2561-aea9-6510-1a8151e08815","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"5"}},{"@id":"urn:uuid:cf4f2898-1ef5-6b28-4f58-0ac1b14cd976","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_RI_Rorligt_friluftsliv_MB4kap2.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:fd96c58376f17ade5ed29bb45a2527f9cc60598f24b1b4d2a75643cec93eddbe"},{"@graph":[{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ursprungligen (1997) användes Lantmäteriets marktäckelager åker  för att få fram jordbruksblocken. Sedan dess används de av Lantmäteriet producerade ortofotona för att uppdatera gränserna, samt fältbesök."}},{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1998-01-01"}},{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/df439ba5-014e-44ec-86cb-ddb9e5ba306c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:1dbbcac1-eea6-3e09-e3d5-5340a9243d16"},{"@id":"urn:uuid:1df4d6ad-1e2a-ea5b-d073-6fdb86c931b4"},{"@id":"urn:uuid:88479719-8c06-e67d-d555-2065a2cb3e19"},{"@id":"urn:uuid:a2a92785-bcd0-4cac-c5ea-6cce960b3ff3"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Markanvändning"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/lu"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Jordbruksblock är en datamängd som innehåller uppgifter om maximalt stödberättigande jordbruksmark enligt EU:s definitioner. Jordbruksblocken används av Jordbruksverket för att administrera stöd till lantbrukare, till exempel för att kontrollera arealuppgifterna i lantbrukarnas ansökningar och för att informera lantbrukarna om gällande uppgifter. \n\n\nDatamängden innehåller inte all jordbruksmark i Sverige, utan bara de delar som en lantbrukare har sökt stöd för någon gång.\n\nEtt block är en polygon/yta som avgränsar ett område med jordbruksmark. Ett block avgränsas av fasta avgränsningar. Exempel på fasta avgränsningar är vägar, stenmurar, skog och bebyggelse. Ett block kan också avgränsas av regiongränser (församlingsgränserna från 2000). Ett block måste, med få undantag, vara minst 0,1 hektar. På ett block kan bara en lantbrukare ha jordbruksmark (undantag för betesmark som sambetas).\nDatamängden Jordbruksblock innehåller cirka 1 143 000 block. Av dessa är cirka 891 000 åkermarksblock och ca 252 000 betesmarksblock. Den totala arealen är 3,2 miljoner hektar, varav 2,7 miljoner hektar är åkermark och 510 000 hektar är betesmark. Genomsnitts-arealen för åkermarksblocken är 3,03 ha och för betesmarksblocken är motsvarande siffra 2,03 ha."},"dct:identifier":"df439ba5-014e-44ec-86cb-ddb9e5ba306c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b1n0"},"dct:temporal":{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b2n0"},"dct:title":{"@language":"sv","@value":"Jordbruksblock"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:1dbbcac1-eea6-3e09-e3d5-5340a9243d16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layer=arslager_block"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS-tjänst Jordbruksblock"},"dct:title":{"@language":"sv","@value":"WMS-tjänst Jordbruksblock"}},{"@id":"urn:uuid:1df4d6ad-1e2a-ea5b-d073-6fdb86c931b4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/jordbruksblock/20250326/jordbruksblock.gml.zip"},"dct:description":{"@language":"sv","@value":"Rikstäckande GML-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"},{"@id":"urn:uuid:88479719-8c06-e67d-d555-2065a2cb3e19","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/jordbruksblock/atom-datasetfeed-jordbruksblock.xml"},"dct:description":{"@language":"sv","@value":"Atom dataset feed för datamängden Jordbruksblock"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom dataset feed för datamängden Jordbruksblock"}},{"@id":"urn:uuid:a2a92785-bcd0-4cac-c5ea-6cce960b3ff3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&TYPENAMES=arslager_block"},"dct:description":{"@language":"sv","@value":"WFS-tjänst Jordbruksblock"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"WFS-tjänst Jordbruksblock"}}],"@id":"urn:source:fd9d3bd9d7c39dbe1ff09e7f3d33cc47fc8ac999af6a4fad96d35d7ccec95890"},{"@graph":[{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Läget hämtat från Ekonomiska kartan, satt med olika kvalitet."}},{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.31516 57.20477,15.6123 57.20477,15.6123 56.3872,13.31516 56.3872,13.31516 57.20477))"}},{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/cca833e3-691c-4691-8f56-583057171b7e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:67008ba4-069c-3545-10ae-78e09a8c1e66"},{"@id":"urn:uuid:b0c01cfd-df91-c2c2-91c2-6b2ae37d3907"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventering utförd av PG Vejde 1929 redovisat i boken \"Herrgårdar i Kronobergs län\""},"dct:identifier":"cca833e3-691c-4691-8f56-583057171b7e","dct:issued":{"@type":"xsd:date","@value":"2015-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-15"},"dct:provenance":{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Herrgårdar"}},{"@id":"urn:uuid:67008ba4-069c-3545-10ae-78e09a8c1e66","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg205_kherrg.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:b0c01cfd-df91-c2c2-91c2-6b2ae37d3907","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/2"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:fda0ef57f19e41a97f99b447afd625d0eb0a309ca3c9ab57a08d5a872a67433c"},{"@graph":[{"@id":"_:fdfbf2c2f91e34f1ea7f212f1ee022cf2da5c7ce891040cf3f4e02a888ffa485_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen kommer huvudsakligen från inventeringar, anmälningar och arkeologiska undersökningar. En stor del av informationen kommer från den s.k. fornminnesinventeringen som pågick 1938-2002. Vid överföring av information från analog till digital form ingick kvalitetssäkring på en övergripande nivå men inte av varje enskild post. Endast den mest nödvändiga informationen kvalitetssäkrades; lämningstyp, antikvarisk bedömning samt läge. Övrig information kvalitetssäkrades inte, detta gäller bland annat beskrivningarna. Kvalitetssäkring pågår hela tiden och fel rättas löpande. Informationen digitaliserades mellan 1999 och 2006. 2003 publicerades det första datat. Det tillkommer kontinuerligt information om nya lämningar. Enligt kulturmiljölagen (1988:950) är fornlämningar skyddade oavsett om de är registrerade eller ej."}},{"@id":"_:fdfbf2c2f91e34f1ea7f212f1ee022cf2da5c7ce891040cf3f4e02a888ffa485_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.203061578412 69.527398460505,25.013956127431 69.527398460505,25.013956127431 54.769334649279,10.203061578412 54.769334649279,10.203061578412 69.527398460505))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/3b74f891-e63d-41af-be42-6c718420a764","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:d40f463b-7ece-3c20-c10e-13d89a452ecc"},{"@id":"urn:uuid:e77bab5f-913a-0470-a585-776d16c5c8e2"},{"@id":"urn:uuid:e8d2d268-51ad-4783-add8-ea18b89038da"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Information om fornlämningar och övriga kulturhistoriska lämningar som är kända och registrerade. Lämningar kan finnas både på land och i vatten."},"dct:identifier":"3b74f891-e63d-41af-be42-6c718420a764","dct:issued":{"@type":"xsd:date","@value":"2003-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1999-01-01"},"dct:provenance":{"@id":"_:fdfbf2c2f91e34f1ea7f212f1ee022cf2da5c7ce891040cf3f4e02a888ffa485_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:fdfbf2c2f91e34f1ea7f212f1ee022cf2da5c7ce891040cf3f4e02a888ffa485_b1n0"},"dct:title":{"@language":"sv","@value":"Kulturhistoriska lämningar - information om datamängden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:d40f463b-7ece-3c20-c10e-13d89a452ecc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/fornsok/"},"dct:description":{"@language":"sv","@value":"Startsida för Fornsök med länkar till mer information om bland annat vanliga frågor och informationsägare."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om Fornsök"}},{"@id":"urn:uuid:e77bab5f-913a-0470-a585-776d16c5c8e2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://app.raa.se/open/fornsok/"},"dct:description":{"@language":"sv","@value":"Riksantikvarieämbetets söktjänst Fornsök innehåller information om alla kända registrerade fornlämningar och övriga kulturhistoriska lämningar i Sverige, både på land och i vatten."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fornsök"}},{"@id":"urn:uuid:e8d2d268-51ad-4783-add8-ea18b89038da","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dct:description":{"@language":"sv","@value":"Här kan du ladda ned öppna data och hämta wms:er som tillhandahålls av Riksantikvarieämbetet."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Riksantikvarieämbetet öppna data-portal"}}],"@id":"urn:source:fdfbf2c2f91e34f1ea7f212f1ee022cf2da5c7ce891040cf3f4e02a888ffa485"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a5a69138-9e56-4b6b-bfbb-209effb232f4","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Regionala statistikområden (RegSO) är en rikstäckande indelning skapad av SCB som började gälla 1 juni 2020. En ny version publicerades 2025.\n\nRegSO delar in Sverige i 3 363 områden med en befolkning mellan 650 och 23 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering."},"dct:identifier":"a5a69138-9e56-4b6b-bfbb-209effb232f4","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Regionala statistikområden - RegSO WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:fe784d0264b3325eaa6225c5e52f39bccf2d6eca358a85cbcb0ef2f4497a45c3"},{"@graph":[{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data från flygmätningar har samlats in sedan 1960. Flyghöjd över marken, mätlinjeseparation och navigeringssystem har modifierats med tiden. Likaså har sensorer uppdaterats med förbättrad känslighet och upplösning.\n\nMätpunktsavståndet är ca 6 till 40 meter, beroende på vilket mätsystem som använts. Mätlinjeavståndet är normalt 200 meter över land och 400 till 1000 meter över hav samt 2000 meter över norra fjällkedjan. Till och med år 1994 var den nominella flyghöjden 30 meter, från och med 1995 är den 60 meter.\n\nDatakvalitet:\nRelativ noggrannhet per år för genomförd mätning:\n1960–1967 \t10–15 nT \n1968–1981\t5 nT \n1982–1994 \t2 nT \n1995–2006 \t< 1 nT\n2007– \t< 0.3 nT\n\n En sammanvägd relativ kvalitetsbedömning har även gjorts, vilken redovisas som ett kvalitetsvärde (QUALITY) från 1 och uppåt, där 1 är lägsta kvalitet. Kvalitetsbedömningen utgår huvudsakligen från vilket mätsystem som använts. Generellt sett är modernare mätningar av högre kvalitet än äldre. Kvaliteten kommer att fortsätta höjas då navigations- och mätsystem blir allt bättre."}},{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1960"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/6f80f4fc-6372-48d7-a850-936c3edd7245","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1a35cfc4-7df2-8708-a6e6-eec0ff69bc91"},{"@id":"urn:uuid:6139ba10-e45a-1d8d-1192-dd9561f68e97"},{"@id":"urn:uuid:7a3bc0d1-c048-9aba-2290-b7928deb1c5f"},{"@id":"urn:uuid:7b118831-fbfc-40fa-5a7f-423b4ce06898"},{"@id":"urn:uuid:8ce24e11-e036-8792-6e8b-0f616ef1c43b"},{"@id":"urn:uuid:f7baaede-7a69-4349-8f0c-42f51f1993f2"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Användningsområden är t.ex. prospektering, infrastruktur och samhällsplanering."},{"@language":"sv","@value":"Vid flygmätningar av jordens magnetfält registreras mycket små variationer i magnetfältets styrka. Detta ger bland annat information om djup- och ytfördelningen av olika bergarter och bergartsled, samt deras stryknings- och stupningsriktningar. Förkastningar och deras relativa rörelser kan i vissa fall också identifieras i de magnetiska mönstren.\n\nGeofysiska flygmätningar, magnetfält (detaljerad) innehåller uppmätta variationer i det magnetiska totalfältet före och efter subtraktion av det geomagnetiska referensfältet (DGRF 1965.0). Mätningarna är gjorda från flygplan på låg höjd från 1960 och framåt. Filen innehåller värdet för enskild mätpunkt. Mätpunktsavståndet varierar beroende på var och när data samlats in."}],"dct:identifier":"6f80f4fc-6372-48d7-a850-936c3edd7245","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b1n0"},"dct:temporal":{"@id":"_:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, magnetfält (detaljerad)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1a35cfc4-7df2-8708-a6e6-eec0ff69bc91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-magnet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:6139ba10-e45a-1d8d-1192-dd9561f68e97","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-magnetfalt.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:7a3bc0d1-c048-9aba-2290-b7928deb1c5f","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-flyg-magnetfalt-detaljerad/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:7b118831-fbfc-40fa-5a7f-423b4ce06898","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-magnetfalt-detaljerad/geofysik-flyg-magnetfalt-detaljerad.zip"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: GeoPackage med flygområden"}},{"@id":"urn:uuid:8ce24e11-e036-8792-6e8b-0f616ef1c43b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-magnetfalt-detaljerad-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:f7baaede-7a69-4349-8f0c-42f51f1993f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-magnetfalt-detaljerad/1995_FJBE_329.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: Exempel XYZ-fil för flygområde 1995_FJBE_329"}}],"@id":"urn:source:ff408347a8a90a9bdc54d1574088cc5325fda1c52324014881df829b5706d464"},{"@graph":[{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SCB fick 2018 i uppdrag av regeringen att ta fram en rikstäckande områdesindelning för statistik uppföljning av segregation. Regeringen bedömde senare att indelningen även skulle bidra till uppföljning och utvärdering av jämställdhetspolitiska delmål och till uppföljning och utvärdering av integration och etablering.\n\nUppdraget innebar att RegSO skapades genom att Demografiska statistikområden (DeSO) aggregerades och gavs namn. Uppdraget utfördes i nära samarbete med landets kommuner och Delegationen mot segregation (Delmos)."}},{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2020"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/41595023-07e9-4729-8f41-d9203dc8d0a1","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:036157d3-f32b-45cb-c63e-99ad1203c7b0"},{"@id":"urn:uuid:1f9ac9b7-391f-dc8c-0826-a253903b0fd9"},{"@id":"urn:uuid:396b47f1-4ea8-9080-0da5-c22e3164db4a"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Regionala statistikområden (RegSO) är en rikstäckande indelning skapad av SCB som började gälla 1 juni 2020. En ny version publicerades 2025.\n\nRegSO delar in Sverige i 3 363 områden med en befolkning mellan 650 och 23 000 invånare. Indelningen följer läns- och kommungränserna som gällde vid publicering."},"dct:identifier":"41595023-07e9-4729-8f41-d9203dc8d0a1","dct:issued":{"@type":"xsd:date","@value":"2020-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-28"},"dct:provenance":{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b1n0"},"dct:temporal":{"@id":"_:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419_b2n0"},"dct:title":{"@language":"sv","@value":"Regionala statistikområden - RegSO"}},{"@id":"urn:uuid:036157d3-f32b-45cb-c63e-99ad1203c7b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"RegSo WFS"}},{"@id":"urn:uuid:1f9ac9b7-391f-dc8c-0826-a253903b0fd9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/regional-statistik-och-kartor/regionala-indelningar/regionala-statistikomraden-regso/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Regionala statistikområden - RegSO"}},{"@id":"urn:uuid:396b47f1-4ea8-9080-0da5-c22e3164db4a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"RegSO WMS"}}],"@id":"urn:source:ff5dd12bd076157ac445256413f8c60200303389474c07ebc902dc14eaafb419"},{"@graph":[{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skapades för att visualisera informationen från Åtgärder i Vatten och för att underlätta nyttjandet av databasen."}},{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.085183446057012 69.07117514056338,23.805728584504376 69.07117514056338,23.805728584504376 54.89766247376792,10.085183446057012 54.89766247376792,10.085183446057012 69.07117514056338))"}},{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/55310e83-de9b-475d-31f1-466079a0b1ad","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:1d2db4f9-6d0d-9238-0cf0-ca5cbba8efae"},"dcat:distribution":{"@id":"urn:uuid:84165602-edf8-22ea-4adc-29a4ec909cdb"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En webb-karta för att visualisera information från databasen Åtgärder i vatten med syfte att sprida information om genomförda åtgärder."},"dct:identifier":"55310e83-de9b-475d-31f1-466079a0b1ad","dct:issued":{"@type":"xsd:date","@value":"2024-09-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-09-16"},"dct:provenance":{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b1n0"},"dct:title":{"@language":"sv","@value":"Webbkarta för Åtgärder i Vatten"}},{"@id":"urn:uuid:1d2db4f9-6d0d-9238-0cf0-ca5cbba8efae","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Enheten för åtgärdssamordning","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Enheten för åtgärdssamordning"},{"@id":"urn:uuid:84165602-edf8-22ea-4adc-29a4ec909cdb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/191b5069e79e4eb58cd86314c3782207/page/Start/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:ffb1e2ad2842df41d8b917b3539a681b86652244392205d09067cf4feaa922e7"}]}
