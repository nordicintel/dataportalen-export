ifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/53fb1706-ebb8-4ec4-88fe-a0fe27b3dfe7","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:0f08c73f-af17-83c1-40de-533e75aecd63"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Registret täcker hela landet och omfattar alla typer av fastigheter. \nInformationen om en överlåtelse kan till exempel vara köpeskilling, köpedatum, köpare och säljare. Registret innehåller endast helförvärv. Förutom överlåtelser via köp innehåller fastighetsprisregistret information om överlåtelser som skett via arv, byte eller gåva. Registret innehåller överlåtelser som lagts in 2014-09-20 och senare.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Fastighetsprisavisering och Fastighetsprisuttag"},"dct:identifier":"53fb1706-ebb8-4ec4-88fe-a0fe27b3dfe7","dct:issued":{"@type":"xsd:date","@value":"1994-01-01"},"dct:modified":{"@type":"xsd:date","@value":"1994-01-01"},"dct:provenance":{"@id":"_:a1fd2a2c5fbd9e46f2ba21d455378c5258e68cad0779f7bb2de303b103c18c23_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:a1fd2a2c5fbd9e46f2ba21d455378c5258e68cad0779f7bb2de303b103c18c23_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för fastighetsprisregistret"}},{"@id":"urn:uuid:0f08c73f-af17-83c1-40de-533e75aecd63","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetspris"},"dct:description":{"@language":"sv","@value":"Mer information om produkten Fastighetsprisuttag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Fastighetspris"}}],"@id":"urn:source:a1fd2a2c5fbd9e46f2ba21d455378c5258e68cad0779f7bb2de303b103c18c23"},{"@graph":[{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Åtgärdsprogram för hotade arter och naturtyper. Åtgärdsprogram för rikkärr."}},{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.588 58.5965,19.7352 58.5965,19.7352 56.7007,17.588 56.7007,17.588 58.5965))"}},{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((18.1003 57.99104,19.22356 57.99104,19.22356 56.91202,18.1003 56.91202,18.1003 57.99104))"}},{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/f8ea170a-7a22-49a5-907f-a0139c1cefbe","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4"},"dcat:distribution":[{"@id":"urn:uuid:144cc957-7931-123c-8319-f595fa4825ec"},{"@id":"urn:uuid:71475c3d-b280-e0b2-d978-900ab81c9784"},{"@id":"urn:uuid:8af00b8f-71b2-ff00-54f6-c5f8dd23d16c"},{"@id":"urn:uuid:fc871aae-8503-3100-cd14-4c7955bc9e63"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Återinventering 2022-2023 av 502 tidigare inventerade rikkärr 2008, med klassning av naturvärden (NVI) , utökad med bedömning av negativ påverkan och åtgärdsbehov. Inom åtgärdsprogram för rikkärr."},"dct:identifier":"f8ea170a-7a22-49a5-907f-a0139c1cefbe","dct:issued":{"@type":"xsd:date","@value":"2024-08-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-14"},"dct:provenance":{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b1n0"},{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b2n0"}],"dct:title":{"@language":"sv","@value":"LstI Inv Rikkärr Externt"}},{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a206424c2a8df8e5a3382e66967ddf69eeb75fd4ff8731d87c63460129452205_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#orga