"@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:ae79a043-2808-6546-3ed6-bbc1bccdb8ac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Kultur_faktaunderlag_ext/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:945ab192589a1b488da454f3bba219e583d5cbe58c1456fa306a8b81864ccf5e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"}],"@id":"urn:source:945ab192589a1b488da454f3bba219e583d5cbe58c1456fa306a8b81864ccf5e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/31e68673-69e6-4d70-9778-f284c8418352","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_200k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"DatamängdenGE.Jordarter 1:200 000, Västernorrland visas i denna OGC WMS-tjänst. Lager som ingår är geologiska enheters litologi och ålder. I denna tjänst visas attribut enligt GeoSciML Lite 4.1 och med symbolisering enligt INSPIRE dataspecifikation för geologi."},"dct:identifier":"31e68673-69e6-4d70-9778-f284c8418352","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:200 000, Västernorrland (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9465db8c5617f2febb1982bff4ebbf03cd9cc9b6a1b54ea2df9e1d32c8501863"},{"@graph":[{"@id":"_:94705a29f4536429e5585477141041179e0f6ecc9637869c54e98d0577e46ae3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Jordlagerföljder har samlats in i samband med SGU:s jordarts- och grundvattenkartläggning. Insamling har även skett från ett stort antal geotekniska undersökningar utförda av andra aktörer, i första hand Trafikverket, kommuner och olika konsulter. De lagerföljder som SGU registrerar vid kartläggningen kommer ofta från täkter, naturliga skärningar samt egna maskingrävningar och borrningar.\n\nPositionering har gjorts med befintliga kartunderlag vid karteringstillfället och med GPS då det funnits möjlighet. De geotekniska undersökningarna som utgör underlag för information är av varierande ålder och kvalitet. Positionering har gjorts med befintliga plankartor i handlingarna i kombination med Lantmäteriets Fastighetskarta. \nLagerföljderna har datalagrats under en lång tid och framför allt i äldre data finns felaktigheter och ofullständigheter."}},{"@id":"_:94705a29f4536429e5585477141041179e0f6ecc9637869c54e98d0577e46ae3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a72d6694-1169-47b3-aa53-8b7b264d9738","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:66f81bd6-db5d-a6c6-cbfd-958f679b2966"},{"@id":"urn:uuid:7674bc7c-8694-1607-b145-ab1e4248d389"},{"@id":"urn:uuid:c79cc8cb-9a93-0d7e-0f98-b3c25c055165"},{"@id":"urn:uuid:ddaff21d-e25c-ad2f-7b11-f2c0ebb7b2d1"},{"@id":"urn:uuid:ef0c15e7-b4c2-454a-41c7-80baa0109d17"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Informationen utgör underlag för bedömningar av jordlagrens mäktighet, uppbyggnad och egenskaper."},{"@language":"sv","@value":"Produkten innehåller uppgifter om jorddjup, jordlagrens mäktighet och karaktäristiska egenskaper, t.ex. bildningssätt och kornstorlek. Informationen bygger på observationer i skärningar eller på resultat av borrningar/sonderingar. Positioneringsnoggrannheten kan variera beroende på vilket kartunderlag som används vid insamlingen."}],"dct:identifier":"a72d6694-1169-47b3-aa53-8b7b264d9738","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:94705a29f4536429e5585477141041179e0f6ecc9637869c54e98d0577e46ae3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:94705a29f4536429e5585477141041179e0f6ecc9637869c54e98d0577e46ae3_b1n0"},"dct:title":{"@language":"sv","@value":"Jordlagerföljder"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:66f81bd6-db5d-a6c6-cbfd-958f679b2966","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-lagerobservationer.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation där jordlagerföljder ingår tillsammans med andra lagerföljdsuppgifter. I kartvisaren visas även skisser över lagren i lagerföljderna."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisarapplikation"}},{"@id":"urn:uuid:7674bc7c-8694-1607-b145-ab1e4248d389","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-lagerobservationer.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation där jordlagerföljder ingår tillsammans med andra lagerföljdsuppgifter. I kartvisaren visas även skisser över lagren i lagerföljderna."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisarapplikation"}},{"@id":"urn:uuid:c79cc8cb-9a93-0d7e-0f98-b3c25c055165","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordlagerfoljder-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:ddaff21d-e25c-ad2f-7b11-f2c0ebb7b2d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordlagerfoljder/jordlagerfoljder.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:ef0c15e7-b4c2-454a-41c7-80baa0109d17","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordlagerfoljder/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:94705a29f4536429e5585477141041179e0f6ecc9637869c54e98d0577e46ae3"},{"@graph":[{"@id":"_:9472703ed5ad322c3217c68aaaca56d29b5c8cb1ee4888cbd67d3278226256bd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är insamlat genom laserskanning från flygplan. Laserpunktmolnet har kvalitetsgranskats och klassificerats som mark, vatten, broar eller övrigt. Utifrån mark- och vattenpunkter skapas sedan en höjdmodell, ett grid med upplösning 1 m. Utifrån gridet skapas terrängskuggnings- och terränglutningsbilder."}},{"@id":"_:9472703ed5ad322c3217c68aaaca56d29b5c8cb1ee4888cbd67d3278226256bd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/52bbca40-a04c-425a-884a-adba2d244ff7","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:53c02054-c53f-dd7c-3536-a0478b1991fa"},{"@id":"urn:uuid:62449d92-48f6-8271-4027-9eb66afab6c6"},{"@id":"urn:uuid:6844bf94-4e99-4a9a-6c6b-985d487ee179"},{"@id":"urn:uuid:da013e12-a016-0301-da3f-6a6baa39cd89"},{"@id":"urn:uuid:fcc2aef0-b309-a4be-4fcc-4b6abf00e6f4"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Grid med 1 meters upplösning. Uppdateras kontinuerligt utifrån laserdata och bildmatchning. Datamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Höjdmodell Nedladdning, Höjdmodell Visning och Höjd Direkt."},"dct:identifier":"52bbca40-a04c-425a-884a-adba2d244ff7","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-01-01"},"dct:provenance":{"@id":"_:9472703ed5ad322c3217c68aaaca56d29b5c8cb1ee4888cbd67d3278226256bd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:9472703ed5ad322c3217c68aaaca56d29b5c8cb1ee4888cbd67d3278226256bd_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd grid 1 m"}},{"@id":"urn:uuid:53c02054-c53f-dd7c-3536-a0478b1991fa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/hojdmodell/wms/v1.1?request=GetCapabilities&version=1.1.1&service=wms"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Markhöjdmodell Nedladdning WCS-version 1.0.0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Markhöjdmodell Nedladdning"}},{"@id":"urn:uuid:62449d92-48f6-8271-4027-9eb66afab6c6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojdmodell-visning-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Markhöjdmodell Visning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Markhöjdmodell Visning"}},{"@id":"urn:uuid:6844bf94-4e99-4a9a-6c6b-985d487ee179","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojd-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Markhöjd Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Markhöjd Direkt"}},{"@id":"urn:uuid:da013e12-a016-0301-da3f-6a6baa39cd89","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojdmodell-nedladdning-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Markhöjdmodell Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Markhöjdmodell nedladdning"}},{"@id":"urn:uuid:fcc2aef0-b309-a4be-4fcc-4b6abf00e6f4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/ortofoto/wms/v1.3?service=WMS&request=GetCapabilities&version=1.1.1"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt till tjänsten Markhöjdmodell Visning (Öppen capabilitiesfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Markhöjdmodell Visning"}}],"@id":"urn:source:9472703ed5ad322c3217c68aaaca56d29b5c8cb1ee4888cbd67d3278226256bd"},{"@graph":[{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SCB har avgränsat polygonerna med hjälp av SCB:s register över bostadsbestånd och fastighetstaxeringar, i kombination med Lantmäteriets fastighetskarta. Metoden innebär i korthet att byggnadskroppar för fritidshus buffras, kombineras och bildar polygoner med fritidshusområden."}},{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2020"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2000"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/5b566a30-1e36-446b-af29-d277159af244","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:88a8a51a-538b-2cb2-70cd-490d0a4dcd08"},{"@id":"urn:uuid:d945d3b3-bdf4-58f8-be69-e4f8b6a4316e"},{"@id":"urn:uuid:da29833f-0722-7d5c-10bb-7206a61ea294"},{"@id":"urn:uuid:e316e43a-87a5-a967-ddbb-2d0a1cdf64cc"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Fritidshusområden definieras som koncentrerad bebyggelse med minst 50 fritidshus. Fritidshus definieras som småhus utan folkbokförd befolkning. Fritidshusområden kan överlappa SCB:s statistiska tätorter och småorter. Geodata är polygoner. Den första årsversionen avser 2000. Uppdatering har gjorts vart femte år, vilket ger fem versioner till och med 2020."},"dct:identifier":"5b566a30-1e36-446b-af29-d277159af244","dct:issued":{"@type":"xsd:date","@value":"2022-11-24"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-24"},"dct:provenance":{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b1n0"},"dct:temporal":{"@id":"_:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e_b2n0"},"dct:title":{"@language":"sv","@value":"Fritidshusområden"}},{"@id":"urn:uuid:88a8a51a-538b-2cb2-70cd-490d0a4dcd08","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/mi0806"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktspecifikation"}},{"@id":"urn:uuid:d945d3b3-bdf4-58f8-be69-e4f8b6a4316e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Fritidshusområden WMS"}},{"@id":"urn:uuid:da29833f-0722-7d5c-10bb-7206a61ea294","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/statistiska-fritidshusomraden/"},"dct:description":{"@language":"sv","@value":"Nedladdning av årsfiler i formatet geopackage"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för fritidshusområden"}},{"@id":"urn:uuid:e316e43a-87a5-a967-ddbb-2d0a1cdf64cc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Fritidshusområden WFS"}}],"@id":"urn:source:9587f89536ea1d81aec11cc50325aa089b95377a9b56a65c33dbe85d2f60131e"},{"@graph":[{"@id":"_:95b1660d2ad0c6b049d7884