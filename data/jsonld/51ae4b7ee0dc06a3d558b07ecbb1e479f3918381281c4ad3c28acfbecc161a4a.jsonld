39816 69.3377099999694,25.550370951523195 69.3377099999694,25.550370951523195 54.99231754747407,8.198029034339816 54.99231754747407,8.198029034339816 69.3377099999694))"}},{"@id":"_:96a6e6b0334e476dadb5a437c385f2b0420759e8214a2951dc3275d9712bdce2_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/26110dd6-6704-556d-e94b-240decc148fb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:90965389-fac3-f66d-bbf9-4d121c6acf9a"},"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Klorid i grundvatten i nationella övervakningsprogram"},"dct:identifier":"26110dd6-6704-556d-e94b-240decc148fb","dct:issued":{"@type":"xsd:date","@value":"2014-09-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:96a6e6b0334e476dadb5a437c385f2b0420759e8214a2951dc3275d9712bdce2_b0n0"},"dct:title":{"@language":"sv","@value":"Klorid i grundvatten"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_e1da4e07"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:96a6e6b0334e476dadb5a437c385f2b0420759e8214a2951dc3275d9712bdce2_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:90965389-fac3-f66d-bbf9-4d121c6acf9a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.5a0c1a2c18fa6d6097b79bf7/1717150137767/dataunderlag-till-diagram-tillstandsklasser-klorid-1996-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Tillståndsklasser klorid i grundvatten"}}],"@id":"urn:source:96a6e6b0334e476dadb5a437c385f2b0420759e8214a2951dc3275d9712bdce2"},{"@graph":[{"@id":"_:96ec62d0eaae3114cf58804c254414b2066b80eb87405909e91d8cf869f0a441_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datasetet skapas utifrån insamlade nivåmätningar från nivåloggrar och manuellt mätta nivåer och uppdateras dagligen."}},{"@id":"_:96ec62d0eaae3114cf58804c254414b2066b80eb87405909e91d8cf869f0a441_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/4b474a62-6be9-492e-a818-33ccd3f1c537","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0d47a387-6e45-615a-7eb7-43faf73ea39e"},{"@id":"urn:uuid:12826319-d475-03be-505d-f1c73ba51c9d"},{"@id":"urn:uuid:16798ef9-88e1-199e-720b-6191a0d74448"},{"@id":"urn:uuid:42574bf0-efd9-f9e3-fb66-fa1221bb4da0"},{"@id":"urn:uuid:995b8834-cd25-fdfe-76b2-b734d741aff2"},{"@id":"urn:uuid:9a9349da-4a31-904a-a22f-fbaf03fda2df"},{"@id":"urn:uuid:b0e15e95-0df5-39fa-c22a-f710b20cf0fd"},{"@id":"urn:uuid:eb9f18a0-3d9e-e84d-f015-e793b9f525b1"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"sv","@value":"Den viktigaste användningen är att utgöra referens vid bedömning angående eventuell påverkan på grundvattennivån av olika händelser. SGU presenterar varje månad en sammanställning av grundvattennivåsituationen i landet i förhållande till långtidsmedelvärdet. Data används även inom miljömålsuppföljning och som stöd i arbetet enligt vattenförvaltningsförordningen."},{"@language":"sv","@value":"I datasetet ”Grundvattennivåer, observerade\" redovisas uppmätta grundvattennivåer samt information om platserna där nivåer mäts av SGU eller inom miljöövervakningen av grundvatten. Syftet med mätningarna är att studera tidsmässiga variationer i grundvattnets mängd och beskaffenhet, i förhållande till geologi, topografi och klimat. Information om exempelvis jordart, topografiskt läge och typ av akvifer har stor betydelse för att bedöma grundvattennivåns variationsmönster. SGU har gjort mätningar av grundvattennivån sedan slutet av 1960-talet. Resultaten från mätningarna är användbara för referensändamål, prognoser, miljökontroll och resursberäkningar.\n\nAntalet mättillfällen, uppdateringsfrekvens och mätmetod varierar stort mellan mätstationerna med allt från ett tiotal manuella mätningar till mer än tiotusen mätningar som uppdateras på dagligen. Numera används vanligtvis tryckgivare som ger möjlighet till mätning av grundvattennivån flera gånger per dygn. Många tryckgivare skickar automatiskt mätdata direkt till SGU för publicering varje dygn och vidare användning. För andra tryckgivare är det nödvändigt att manuellt hämta och publicera data vilket normalt då görs någon gång per år.\n\nDatasetet innehåller samtliga nivådata och det bör noteras att kvaliteten på data varierar. Innan data används bör kvaliteten kontrolleras exempelvis genom att plotta uppmätta grundvattennivåer."}],"dct:identifier":"4b474a62-6be9-492e-a818-33ccd3f1c537","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:96ec62d0eaae3114cf58804c254414b2066b80eb87405909e91d8cf869f0a441_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:96ec62d0eaae3114cf58804c254414b2066b80eb87405909e91d8cf869f0a441_b1n0"},"dct:title":{"@language":"sv","@value":"Grundvattennivåer, observerade"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0d47a387-6e45-615a-7eb7-43faf73ea39e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/grundvatten/grundvattennivaer-nedladdning.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:12826319-d475-03be-505d-f1c73ba51c9d","@t