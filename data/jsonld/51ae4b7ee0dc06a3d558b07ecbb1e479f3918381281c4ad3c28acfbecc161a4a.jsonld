":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:dfa14a8ef6c4cf013331fb30998c8997b04d60472058715733aaa1c475319bb7_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:dfa14a8ef6c4cf013331fb30998c8997b04d60472058715733aaa1c475319bb7_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:dfa14a8ef6c4cf013331fb30998c8997b04d60472058715733aaa1c475319bb7"},{"@graph":[{"@id":"_:e021463cdb8d84f8b88cd046ac93abb3fbf2e2bdf4707e6f9733c665243b7847_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bergsstaten är enligt mineralförordningen 56 § skyldig att hålla ett mineralrättsregister. Data har sammanställts sedan mitten av 1980-talet till nutid."}},{"@id":"_:e021463cdb8d84f8b88cd046ac93abb3fbf2e2bdf4707e6f9733c665243b7847_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e5496203-17f6-4bb1-bad6-9661167b3aed","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:80cd38cc-9eed-b8a5-d58e-e0e9da91e663"},{"@id":"urn:uuid:df3463ec-cc3c-424f-08cd-e19e37970881"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"sv","@value":"AM.Tillstånd för prospektering och gruvbrytning är ett urval och transformering av SGUs produkt Mineralrättigheter i syfte att uppfylla Inspires dataspecifikation för tema Områden med särskild förvaltning/begränsningar/reglering samt enheter för rapportering.\n\nDatamängden innehåller rikstäckande information om gällande undersökningstillstånd, bearbetningskoncessioner och markanvisningar. Informationen uppdateras normalt den 10:e varje månad med information som är aktuell den sista månaden innan. Pga av driftproblem uppdateras Inspire-version för närvarande endast var 6:e månad.\n\nVissa tillstånd kan ha ett datum i attributet VALIDTO som har passerats men är ändå gällande. Det beror på att när en ansökan om förlängning gjorts är tillståndet gällande tills det att beslutet vunnit laga kraft."},{"@language":"sv","@value":"För bolag är uppgifter om gällande tillstånd intressant. För\n\t\t\t\t\tmyndigheter och kommuner används databasen i frågor som rör exempelvis\n\t\t\t\t\tmarkanvändning och fysisk planering."}],"dct:identifier":"e5496203-17f6-4bb1-bad6-9661167b3aed","dct:issued":{"@type":"xsd:date","@value":"2020-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-30"},"dct:provenance":{"@id":"_:e021463cdb8d84f8b88cd046ac93abb3fbf2e2bdf4707e6f9733c665243b7847_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:e021463cdb8d84f8b88cd046ac93abb3fbf2e2bdf4707e6f9733c665243b7847_b1n0"},"dct:title":{"@language":"sv","@value":"AM.Tillstånd för prospektering och gruvbrytning"}},{"@id":"urn:uuid:80cd38cc-9eed-b8a5-d58e-e0e9da91e663","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/AM_SGU_ProspectingAndMiningPermitArea.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}},{"@id":"urn:uuid:df3463ec-cc3c-424f-08cd-e19e37970881","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/AM-ProspectingAndMiningPermitArea"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:e021463cdb8d84f8b88cd046ac93abb3fbf2e2bdf4707e6f9733c665243b7847"},{"@graph":[{"@id":"_:e054b35f0ec02b78ecdc3f46eec0ec78fcfb0a2f1dc76a19e55ff6784ed4d4d2_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:e054b35f0ec02b78ecdc3f46eec0ec78fcfb0a2f1dc76a19e55ff6784ed4d4d2_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/97a3c679-739f-425e-bd05-123bc9bcefb8","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaFjallnaragransyta/MapServer/WmsServer?"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"WMS-tjänst som visualiserar gräns för fjällnara skog, upprättad av Skogsstyrelsen. Den digitaliserade gränsen är lämplig att använda för att få en överblick på området för fjällnära skog. Det är viktigt att komma ihåg att den digitala gränsen inte har rättsverkan. Det är Skogsstyrelsens författningssamling, SKSFS 1991:3, Förordning om gränsen för fjällnära skog som utgör de juridiska dokument som gäller."},"dct:identifier":"97a3c679-739f-425e-bd05-123bc9bcefb8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"BR.Gräns för fjällnära skog upprättad av Skogsstyrelsen.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e054b35f0ec02b78ecdc3f46eec0ec78fcfb0a2f1dc76a19e55ff6784ed4d4d2_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e054b35f0ec02b78ecdc3f46eec0ec78fcfb0a2f1dc76a19e55ff6784ed4d4d2_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:e054b35f0ec02b78ecdc3f46eec0ec78fcfb0a2f1dc76a19e55ff6784ed4d4d2"},{"@graph":[{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Statusklassningen baseras på data från satelliten Sentinel-3 OLCI. Två olika algoritmer har använts att beräkna klorofyllkoncentration och tre olika för siktdjup. Status har sedan beräknats med SMHIs klassningsverktyg Vattenstatus. Korrigering för salthalt har gjorts med data från SHMIs kustzonsmodell där det är relevant."}},{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.632821083068839 69.690664764176,26.507821083068812 69.690664764176,26.507821083068812 54.54657953840501,9.632821083068839 54.54657953840501,9.632821083068839 69.690664764176))"}},{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/851b0a54-857a-a638-1dc8-e50a3b9e013a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":[{"@id":"urn:uuid:a95091cc-9ec3-bfe3-affb-452eb8916720"},{"@id":"urn:uuid:af4c862f-4824-9f2e-acb5-fdf88ff8b514"},{"@id":"urn:uuid:f8476f16-b052-badb-5c77-23fbbf01d612"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller satellitbaserad data och statusklassningar av klorofyll a och siktdjup samt data om absorption och turbiditet i Sveriges kustvattenförekomster. Data är analyserad för perioden 2016 till 2018. Datamängden består av geografisk information, tidsserier och enskilda mätdata.\n\nEnbart geografisk data är tillgänglig i denna post. Övrig information inklusive leveransrapport kan efterfrågas via miljoovervakning@havochvatten.se."},"dct:identifier":"851b0a54-857a-a638-1dc8-e50a3b9e013a","dct:issued":{"@type":"xsd:date","@value":"2023-07-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-07-03"},"dct:provenance":{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b1n0"},"dct:title":{"@language":"sv","@value":"Satellitbaserad statusklassning av Sveriges kustvattenförekomster, 2016-2018"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e0964d315b85d037df8fe2260a7725a7911595e0fd9b41427315d11fa96f9a12_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:a95091cc-9ec3-bfe3-affb-452eb8916720","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/satellitbaserad-statusklassning-kustvatten/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Satellitbaserad statusklassning av sveriges kustvattenförekomster"}},{"@id":"urn:uuid:af4c862f-4824-9f2e-acb5-fdf88ff8b514","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/satellitbaserad-statusklassning-kustvatten/wms"},"dcat:mediaType":