s://opendata-view.smhi.se/oc-obs-seawaterlevelhourvalues/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter havsvattenstånd. Tjänsten visar alla stationer som någonsin levererat data för denna parametrar. Insamlade från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"d1a489f0-2384-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havsvattenstånd RH2000, timvärde: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f6190975db7e38483a294a5dca5e1f51d9644a521d38b13132abfedbf978b610"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000555","@type":"foaf:Agent","dct:identifier":"2021000555","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sherko.alemdar@socialstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Socialstyrelsen"},"foaf:page":{"@id":"https://www.socialstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ngs.ehalsomyndigheten.se/organisation/SE2021000555"}},{"@id":"https://www.geodata.se/resources/bdeb7f20-3ae8-4d60-b576-1ac2a533dd06","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-dod-wms.map&service=wms&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens statistikdatabas, antal döda i vissa miljörelaterade sjukdomar som J44 KOL, J45-J46 Astma J60-J70 Lungsjukdomar av yttre orsaker under åren 2020-2022 per 100 000 invånare"},"dct:identifier":"bdeb7f20-3ae8-4d60-b576-1ac2a533dd06","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:title":{"@language":"sv","@value":"Dödsorsaker visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f65287a414f386095f119259c18fed8168d70c562614e110fc53b3192f0cb8e7"},{"@graph":[{"@id":"_:f6c0cdf8ebf07841a6d07302554aabcae234ede05286718af2e0fdc6168889af_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"IDA är ett webbaserat informationssystem som används som stöd vid planering, uppföljning och utvärdering av skyddet mot olyckor i kommuner, länsstyrelser och nationella myndigheter. Systemet innehåller statistik och analyser för området skydd mot olyckor och kriser. IDA visar data från MSB:s egna databaser men också data som hämtas från andra myndigheter."}},{"@id":"_:f6c0cdf8ebf07841a6d07302554aabcae234ede05286718af2e0fdc6168889af_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"https://www.geodata.se/resources/632d5cd3-bf47-408b-b5be-f1caa53f0281","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:125b7f16-3712-ed18-da71-77593eff713a"},{"@id":"urn:uuid:2952fa5e-864e-b354-dbaa-443e15fb8012"},{"@id":"urn:uuid:3bdd2f37-565b-df26-37bc-ad7d46c98a24"},{"@id":"urn:uuid:9f7a8d6d-76fd-27b3-5fcb-b7c08953131d"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"OBS! Gammal datamängd som inte uppdateras längre.\n\nDatabasen innehåller uppgifter om stora olyckor i Sverige från 1950 och framåt. Med stora olyckor menas olyckor där minst fyra personer har omkommit, minst tio personer har skadats eller där konsekvenserna på annat sätt bedömts vara särskilt omfattande. Detta arbete omfattade genomgångar av årsböcker, tidningsartiklar, rapporter från diverse kommissioner, andra rapporter med anknytning till området. En del uppgifter har även kompletterats efter kontakt med de kommuner där olyckor inträffat. Datamaterialet har därefter kompletterats årligen. Databasen uppdateras inte längre."},"dct:identifier":"632d5cd3-bf47-408b-b5be-f1caa53f0281","dct:issued":{"@type":"xsd:date","@value":"2006-09-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-01"},"dct:provenance":{"@id":"_:f6c0cdf8ebf07841a6d07302554aabcae234ede05286718af2e0fdc6168889af_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:f6c0cdf8ebf07841a6d07302554aabcae234ede05286718af2e0fdc6168889af_b1n0"},"dct:title":{"@language":"sv","@value":"Stora olyckor"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:125b7f16-3712-ed18-da71-77593eff713a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/storaolyckor/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"MSB:s sida för visning av stora olyckor."}},{"@id":"urn:uuid:2952fa5e-864e-b354-dbaa-443e15fb8012","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/storaolyckor/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst stora olyckor OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:3bdd2f37-565b-df26-37bc-ad7d46c98a24","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/MSB_TopAtomFeed_storaolyckor.xml"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av stora olyckor i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:9f7a8d6d-76fd-27b3-5fcb-b7c08953131d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/shape/InspireMSB_storaolyckor.zip"},"dct:description":{"@language":"sv","@value":"MSB:s sida för nedladdning av stora olyckor i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:f6c0cdf8ebf07841a6d07302554aabcae234ede05286718af2e0fdc6168889af"},{"@graph":[{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU påbörjade systematiska tyngdkraftsmätningar i slutet av 1950-talet i samband med järnmalmsinventeringen i Norrbottens län. De nationella regionala mätningarna initierades i mitten av 1960-talet, främst som stöd för SGU:s berggrundskartläggning. Idag genomförs tyngdkraftsmätningar i huvudsak där det bedrivs eller kommer att bedrivas berggrundskartläggning. Det förekommer också mätningar för att lokalisera områden med stora jorddjup och potentiella grundvattenmagasin.\n\nKvaliteten för de enskilda mätpunkterna varierar mycket eftersom SGU har bedrivit tyngdkraftsmätningar sedan 1950-talet och mätinstrumenten med tiden har förbättrats. I takt med att instrumentutvecklingen har gått framåt så har det också blivit möjligt att bestämma både tyngdkraften och positionen mer noggrant. \nI leveransfilen finns flera kolumner med attribut som indikerar kvaliteten på tyngdkraftsmätningarna och positionsbestämningarna. Det finns också attribut som beskriver om mätningarna blivit utförda på marken, till sjöss, från luften eller på sjö-/havsisar."}},{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.45406568521 68.811883612563,25.516224301706 68.811883612563,25.516224301706 54.899419669258,10.45406568521 54.899419669258,10.45406568521 68.811883612563))"}},{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1957"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/f87b2da1-44a5-455d-8258-914e0f790373","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:10860249-f901-2fad-70fd-e7acc616d3b4"},{"@id":"urn:uuid:31bd9822-5d90-1e0f-125f-7c894733ae3d"},{"@id":"urn:uuid:406e3760-e9d8-92b5-d22d-c0464bb67801"},{"@id":"urn:uuid:73a143ed-8c0f-f448-c6d7-a5f76b26ab4a"},{"@id":"urn:uuid:90b2d706-5bcc-4716-0a75-fa1a25e52271"},{"@id":"urn:uuid:d08293d8-50ba-70bf-8ce7-22774b98fb53"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Genom mätningar av tyngdkraften kan man kartlägga variationer i massfördelningen i jordskorpan. Dessa variationer beror på skillnader i berggrundens sammansättning. \n\nGeofysiska markmätningar, tyngdkraft innehåller punktinformation om tyngdkraftsmätningar över hela Sverige. Från tyngdkraftsmätningarna har Bougueranomalier (mGal) beräknats i referensfältet RG82. Mätpunkttätheten varierar över landet. Mätningarna har utförts av SGU och flera andra organisationer. Mätpunkternas lägen, mätningarnas Bougueranomalier samt mätningarnas noggrannhet redovisas i datamängden."},{"@language":"sv","@value":"Informationen används bl.a. inom prospektering."}],"dct:identifier":"f87b2da1-44a5-455d-8258-914e0f790373","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-19"},"dct:provenance":{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b1n0"},"dct:temporal":{"@id":"_:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska markmätningar, tyngdkraft"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10860249-f901-2fad-70fd-e7acc616d3b4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/markgeofysik-tyngdkraft"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:31bd9822-5d90-1e0f-125f-7c894733ae3d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-mark-tyngdkraft/geofysik-mark-tyngdkraft.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:406e3760-e9d8-92b5-d22d-c0464bb67801","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-mark-tyngdkraft/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:73a143ed-8c0f-f448-c6d7-a5f76b26ab4a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-tyngdkraft.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:90b2d706-5bcc-4716-0a75-fa1a25e52271","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-tyngdkraft.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:d08293d8-50ba-70bf-8ce7-22774b98fb53","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-markmatningar-tyngdkraft-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:f6c4cc85d6c8791617bd74c998f7cb61bfe6d41c59cd5e92df99bd66f5f60ddc"},{"@graph":[{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.80721 60.8935,14.42517 60.8935,14.42517 58.78236,11.80721 58.78236,11.80721 60.8935))"}},{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/2f092d11-20e0-45be-b3b0-cfc99637f156","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d"},"dcat:distribution":[{"@id":"urn:uuid:329289e6-13cc-d228-788b-074f340a2899"},{"@id":"urn:uuid:ce63845d-4f70-e5e2-0e18-0ad887923ef1"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Kulturmiljöprogrammet - Ditt Värmland, 1989. Totalt pekades 381 värmländska miljöer ut för deras höga kulturhistoriska värden såsom tätorter, fornlämningar, gårdar, byar och odlingslandskap."},"dct:identifier":"2f092d11-20e0-45be-b3b0-cfc99637f156","dct:issued":{"@type":"xsd:date","@value":"1989-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1989-01-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b0n0"},{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Kulturmiljöprogrammet - Ditt Värmland"}},{"@id":"urn:uuid:329289e6-13cc-d228-788b-074f340a2899","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.kultprog.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:ce63845d-4f70-e5e2-0e18-0ad887923ef1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Kultur_faktaunderlag_ext/MapServer/7"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:dd2fe676-16b5-58fa-29b8-f2f77edc3e0d","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Samhällsbyggnadsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Samhällsbyggnadsenheten"}],"@id":"urn:source:f6e52ddf2a5a8c297242e6f3db07e7d5de86f6332ac63cb16898ada3cd0361df"},{"@graph":[{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inte känt"}},{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2099"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2008"}},{"@id":"https://www.geodata.se/resources/1e3c8e08-df6c-4999-90ac-225d7bdae1a6","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:27f9fb31-b846-15e9-40fc-8f84ad8433bc"},{"@id":"urn:uuid:2fe932e3-7972-0aec-1976-cae63089de6b"},{"@id":"urn:uuid:45365a80-0a04-ce64-7795-6598f88b5039"},{"@id":"urn:uuid:64173b6f-0728-cbc2-893e-62bcaad44dad"},{"@id":"urn:uuid:7bd5a1d3-6daa-bb7e-aebb-47307fb4afe7"},{"@id":"urn:uuid:d98790d3-9cef-095f-7505-926ff29d2296"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Data om brandstationers lägen. Räddningstjänst är kommunens ansvar enligt Lagen (2003:778) om skydd mot olyckor. Kommunen ansvarar för tillsyn inom kommunens område och länsstyrelsen inom länet. Den centrala tillsynen utövas av MSB som samlar in information om brandstationerna. Brandstationernas positionering uppdateras kontinuerligt, på grund av detta kan vissa felaktigheter finnas. Har man uppgifter om att en brandstation är felpositionerad kan man rapportera det till MSB.OBS! Lägesnoggrannheten för brandstationerna är av varierande kvalitét."},"dct:identifier":"1e3c8e08-df6c-4999-90ac-225d7bdae1a6","dct:issued":{"@type":"xsd:date","@value":"2008-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-13"},"dct:provenance":{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b1n0"},"dct:temporal":{"@id":"_:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1_b2n0"},"dct:title":{"@language":"sv","@value":"Brandstationer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:27f9fb31-b846-15e9-40fc-8f84ad8433bc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/MSB_TopAtomFeed_brandstationer.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för MCF:s brandstationer i GML-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"}},{"@id":"urn:uuid:2fe932e3-7972-0aec-1976-cae63089de6b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/nedladdning/filer/shape/brandstationer.zip"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för MCF:s brandstationer i Shape-format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:45365a80-0a04-ce64-7795-6598f88b5039","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://undefined"},"dct:description":{"@language":"sv","@value":"undefined"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:64173b6f-0728-cbc2-893e-62bcaad44dad","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/brandstationer/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst för MCF:s brandstationer"}},{"@id":"urn:uuid:7bd5a1d3-6daa-bb7e-aebb-47307fb4afe7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.mcf.se/brandstationer/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst brandstationer OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}},{"@id":"urn:uuid:d98790d3-9cef-095f-7505-926ff29d2296","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis-services.metria.se/arcgis/rest/services/msb/InspireMSB_Brandstationer/MapServer/exts/InspireView/service"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Brandstationer, anspänningstid,Brandstationer"},"dct:title":{"@language":"sv","@value":"Brandstationer_symbol,Brandstationer"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"}],"@id":"urn:source:f77b29a2f0082ad7601f8c3e2afe43d216b3a1541ffbb620b7884b58c278f2c1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/3ddab141-1702-4d34-9dd1-a63c02e5a6ff","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/SGI_Skreddatabas_ver2.zip"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"SGI Statens geotekniska institut är statens sakkunnigorgan i skred-, ras- och stranderosionsfrågor och medverkar till att minska riskerna inom det geotekniska området i samhället. Utgångspunkten för verksamheten är att människor ska kunna bo på säker grund, så att liv och egendom inte går till spillo vid naturolyckor av typen skred och ras eller vid stranderosion. SGI's skreddatabas är en sammanställning över inträffade skred, ras och övriga jordrörelser i Sverige med tillhörande beskrivning av typ av händelse, omfattning, läge etc - se vidare SGI Varia 512. Antal objekt apr 2026: 1576 st. Vissa större skred har en utförligare beskrivning (orsak, händelseförlopp, erfarenhetsåterföring mm) i MSB's Naturolycksdatabas. [Geoteknik]"},"dct:identifier":"3ddab141-1702-4d34-9dd1-a63c02e5a6ff","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"Inträffade skred, ras och övriga jordrörelser (skreddatabas) - nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f77b988f2f4442cfe3a0adedf5f908c64bb4f51690e1760fd8e4270730b9351a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/2a2e9f33-e11c-4a86-b004-d50aa2dc81f3","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografisk-webbkarta-visning-oversiktlig-api?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten ger tillgång till skikt med topografisk kartinformation. Ett färgsatt skikt och ett som är nedtonat i gråskala. Produkten är anpassad för skärmvisning. Den har hög prestanda vid många samtidiga anrop då den skickar förgenererade bilder i fasta skalnivåer. Anpassad för att användas i skalor mindre än 1:30 236."},"dct:identifier":"2a2e9f33-e11c-4a86-b004-d50aa2dc81f3","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Topografisk webbkarta Visning, översiktlig"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f7c62a32077fc84133b965568b021d10eb5f63df606e604219a370e9520f7749"},{"@graph":[{"@id":"_:f7f4197204b5e0089b748ee88da5b9d1b08bd4172a8e07fd806e11f061ddc31e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"I samband med SGU:s jordartskartering utfördes de analyser som beskrivs här. Merparten av analyserna redovisas även i beskrivningarna till jordartskartorna. Det finns dock ytterligare analyser, som inte redovisas i beskrivningarna och som ännu inte lagts in i SGU:s databas. Syftet var ursprungligen främst att verifiera de jordartsbedömningar som utfördes i fält. De analyserade jordproverna är tagna i samband med SGU:s länskartering (Serie Ca), Aa-kartering, Ad-kartering, Ae-kartering samt dagens karteringar, samlade i serie K. De olika typerna av jordartskartering beskrivs på SGU:s hemsida (www.sgu.se). \n\nDe data som redovisas från kornstorleksanalyserna uppskattas till ±5% av angivet procenttal. De fel som kan finnas i angivna lägen (koordinater) varierar mellan de olika karttyperna. Då det gäller data från Ad- och de flesta Ae- kartorna bedöms felet kunna vara upp till 100 meter från angiven koordinat. Läget för de prover som redovisas i serie K och i vissa fall i serie Ae har bestämts med hjälp av GPS. I dessa fall uppskattas lägesfelen vara mindre än 10 meter i förhållande till angiven koordinat. För de äldsta kartorna (Serie Aa och Ca) bedöms lägesfelen kunna uppgå till 500 m i förhållande till angiven koordinat."}},{"@id":"_:f7f4197204b5e0089b748ee88da5b9d1b08bd4172a8e07fd806e11f061ddc31e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e289e408-1014-4bdc-b762-bb054d653a5d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:31c8dcfc-d4d4-3184-0ea6-917e7b13f14f"},{"@id":"urn:uuid:3746f11a-0977-6e5f-697a-f83b42275646"},{"@id":"urn:uuid:74ed7a6f-eec6-48d3-430d-c6f50bef014d"},{"@id":"urn:uuid:77be67c8-766c-961d-ad26-9169cc73333a"},{"@id":"urn:uuid:8981e2cf-84c7-7c91-a36d-13ed178dea1c"},{"@id":"urn:uuid:d7db344c-4c20-0ae9-8225-cee923d06af9"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Produkten omfattar resultat från analyser, främst kornstorleksanalyser, vilka utförts inom SGU:s jordartskartering. I vissa fall redovisas även jordarnas innehåll av organiskt material och/eller kalk. I några fall har även andra parametrar analyserats (t.ex. pH, basmineralindex och innehåll av magnetit). \n\nJordarternas kornstorleksfördelning är avgörande för en rad viktiga egenskaper (exempelvis vattenhållande förmåga, genomsläpplighet och erosionsbenägenhet). Denna produkt kan användas tillsammans med SGU:s jordartskartor för att illustrera jordarternas kornstorleksfördelning i en viss region. I viss utsträckning kan data även användas för att uppskatta andra egenskaper hos jordarna, exempelvis andelen lättvittrade mineral (t.ex. kalcit). I beskrivningarna till jordartskartorna är det möjligt att läsa mer om jordarternas egenskaper och bildningssätt i specifika områden. Kornstorleksdata redovisas enligt den nomenklatur som upprättats av Sveriges geotekniska förening (SGF 1981). Det gäller även de prover som ursprungligen klassificerats enligt Atterbergs nomenklatur, som användes av SGU fram till 1996."},"dct:identifier":"e289e408-1014-4bdc-b762-bb054d653a5d","dct:issued":{"@type":"xsd:date","@value":"2018-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:f7f4197204b5e0089b748ee88da5b9d1b08bd4172a8e07fd806e11f061ddc31e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:f7f4197204b5e0089b748ee88da5b9d1b08bd4172a8e07fd806e11f061ddc31e_b1n0"},"dct:title":{"@language":"sv","@value":"Jordartsanalyser"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:31c8dcfc-d4d4-3184-0ea6-917e7b13f14f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/jordartsanalyser-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:3746f11a-0977-6e5f-697a-f83b42275646","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/jordartsanalyser/jordartsanalyser.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:74ed7a6f-eec6-48d3-430d-c6f50bef014d","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/jordartsanalyser/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:77be67c8-766c-961d-ad26-9169cc73333a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/jordarter/jordartsanalyser-nedladdning.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:8981e2cf-84c7-7c91-a36d-13ed178dea1c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}},{"@id":"urn:uuid:d7db344c-4c20-0ae9-8225-cee923d06af9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordartsanalyser-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:f7f4197204b5e0089b748ee88da5b9d1b08bd4172a8e07fd806e11f061ddc31e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8f996548-5ddd-472b-97ba-bad2d6f171ed","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/miljoovervakning_grundvatten"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"SGU är datavärd för miljöövervakning grundvatten. Datavärdskap är ett system som inrättats av Naturvårdsverket för att öka tillgänglighet och leverans av miljöövervakningsdata. Data samlas in inom ramen för programmen referensstationer grundvatten, SGUs grundvattennät och integrerad miljöövervakning. I Miljöövervakning grundvattenkemi - WMS visas endast information om provtagningsstationer och platser. För nedladdning av tidsseriedata och statistisk information hänvisas till SGUs kartvisarapplikation  eller våra öppna data (online-källor)"},"dct:identifier":"8f996548-5ddd-472b-97ba-bad2d6f171ed","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Miljöövervakning, grundvattenkemi (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f83c1bcc22ab45a5bc0a3fc6c2119d447eadf58a697a685dab3cf323d3211bd1"},{"@graph":[{"@id":"_:f9200b9fc0f0279939d42bf236b86f398d99a70355fa3bddca0ba69823ea9d3d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Beräkningen av grundvattentillgång i små magasin baseras på en mängd olika underlag och antaganden. Kortfattat avgörs grundvattentillgången enligt beräkningen av den mest begränsande faktorn av grundvattenbildning, uttagskapacitet i brunn samt magasineringsförmåga i jord och berg i kombination med torrperiod. Dessa faktorer beräknas i sin tur baserat på befintliga underlag som till exempel jordart och jorddjup samt antaganden och beräkningar av grundvattennivå, grundvattenbildning, vattenavgivningstal, torrperiod, avsänkning vid pumpning med mera. \n\nMetoden som använts och diskussion om osäkerheter, begränsningar och användning av resultat redovisas utförligt i SGU-rapport 2021:08 (Hjerne m.fl. 2021).\n\nDatakvalitet:\nProdukten är ett resultat av en beräkning baserad på många underlag av varierande kvalitet och mer eller mindre välgrundade antaganden. Underlagen som använts för beräkningen är högst varierande i skala är det svårt att specificera vilken skala som är lämplig. SGU:s bedömning är att produkten i alla fall inte ska användas i en skala som överstiger (dvs inte mer förstorat än) 1:100 000.\nSGU har vid beräkningen försökt att göra konservativa antaganden, det vill säga att vid osäkerheter, har ett värden föredragits som resulterar i en lägre grundvattentillgång snarare än en högre. Vid användning av resultaten att den grundvattentillgång som presenteras är det dock mycket viktigt att komma ihåg, att resultatet inte på något sätt utgör en garanterad vattentillgång eller miniminivå. Det kan mycket väl finnas områden där grundvattentillgången är mindre än vad som presenterats."}},{"@id":"_:f9200b9fc0f0279939d42bf236b86f398d99a70355fa3bddca0ba69823ea9d3d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/eb6cce38-f2ec-4c6e-ab97-225a1ebd04e6","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:4a601c44-24d8-fca6-6e28-c4040dd42c44"},{"@id":"urn:uuid:6bd1ce38-7725-2655-ea16-6d54874b6978"},{"@id":"urn:uuid:774ce9d4-76bf-0f65-f6bd-a50289eeacbd"},{"@id":"urn:uuid:f284a496-f68f-96de-1a57-252b7f9f05f7"},{"@id":"urn:uuid:fcba3bba-32bd-69fb-40a8-77adc5623582"},{"@id":"urn:uuid:fd7c58c7-f667-0e87-844e-8507157f47c8"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Datamängden Grundvattentillgång i små magasin visar en beräkning av grundvattentillgång för vattenförsörjning i Sverige med fokus på små grundvattenmagasin. Beräkningen baseras på ett antal antaganden och ett relativt översiktligt grundmaterial och är därmed förknippade med osäkerheter.  SGU anser att den presenterade beräknade grundvattentillgången kan vara relevant och användbar för översiktlig riskbedömning och planering avseende vattenuttag från små grundvattenmagasin. Däremot bedömer SGU att resultaten generellt inte är tillräckligt precisa och detaljerade för att bedöma vattentillgång och risk för vattenbrist för enskilda fastigheter. \n\nGrundvattentillgång i små magasin omfattar en rikstäckande beräkning och resultatet presenteras i enheten l/dygn/ha (liter per dygn per hektar) i ett raster med cellstorlek på 100x100 m."},"dct:identifier":"eb6cce38-f2ec-4c6e-ab97-225a1ebd04e6","dct:issued":{"@type":"xsd:date","@value":"2021-02-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:f9200b9fc0f0279939d42bf236b86f398d99a70355fa3bddca0ba69823ea9d3d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:f9200b9fc0f0279939d42bf236b86f398d99a70355fa3bddca0ba69823ea9d3d_b1n0"},"dct:title":{"@language":"sv","@value":"Grundvattentillgång i små magasin"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:4a601c44-24d8-fca6-6e28-c4040dd42c44","@type":"dcat:Distribution","dcat:accessURL":{"@id":"h