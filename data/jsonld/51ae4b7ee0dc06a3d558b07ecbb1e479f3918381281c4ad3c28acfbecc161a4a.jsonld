ations.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängd för att visualisera Havsmiljöbedömningar i Havsbanken."},"dct:identifier":"33bb452e-4a15-8132-b03a-01ff86e95351","dct:issued":{"@type":"xsd:date","@value":"2024-05-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:558abdf2b144249144cb22c8539c2be6f9c2a0e106bc0bed2440ddd50e45c678_b0n0"},"dct:title":{"@language":"sv","@value":"Havsmiljöbedömningar"}},{"@id":"urn:uuid:07effdf6-7b3e-8b51-237c-b182a7388e45","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://havbipub.havochvatten.se/dv/ui/project.jsp?pageid=visualAnalyzer&reportpath=%252F%2540Catalog%252Fshared%252FHemsidan%252FHavsmilj%C3%B6bed%C3%B6mning%252FDV%252FHavsmilj%C3%B6bed%C3%B6mningar"},"dct:description":{"@language":"sv","@value":"Webbaserat verktyg som presenterar Sveriges bedömningar av god miljöstatus som görs av Havs- och vattenmyndigheten."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Havs- och vattenmyndighetens visualisering av havsmiljöbedömningen"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:558abdf2b144249144cb22c8539c2be6f9c2a0e106bc0bed2440ddd50e45c678_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"},{"@id":"urn:uuid:69337b3a-6a41-6da4-cff8-8cd452f44a2e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:558abdf2b144249144cb22c8539c2be6f9c2a0e106bc0bed2440ddd50e45c678_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsmiljöenheten"}],"@id":"urn:source:558abdf2b144249144cb22c8539c2be6f9c2a0e106bc0bed2440ddd50e45c678"},{"@graph":[{"@id":"_:55bf3e38d80568d39ff8bd2939ee6ac1e4f9d9058290bc953ad86779df492000_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bergsstaten är enligt mineralförordningen 56 § skyldig att hålla ett mineralrättsregister. Data har sammanställts sedan mitten av 1980-talet till nutid. Det digitala Mineralrättsregistret utvecklades och kom i drift år 2000."}},{"@id":"_:55bf3e38d80568d39ff8bd2939ee6ac1e4f9d9058290bc953ad86779df492000_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e78b3467-5612-4f79-828a-bac35c3bb1d1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:14041756-0f3b-43ae-6e6a-f4d321a910ca"},{"@id":"urn:uuid:53261910-1b75-7d4a-0e54-ac1f61981abc"},{"@id":"urn:uuid:6d31d6a1-db92-5127-39e8-48f1db2cfb4b"},{"@id":"urn:uuid:9466ad88-71d2-5958-a04e-07a965d1beb7"},{"@id":"urn:uuid:b0c646cd-3f18-abdd-2e16-56276ca3b74b"},{"@id":"urn:uuid:e2359b7f-4d92-0591-3ff6-09275c7a409a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"sv","@value":"Datamängden Mineralrättigheter innehåller rikstäckande information enligt följande\nUndersökningstillstånd:\n-\tAnsökta\n-\tBeviljade\n-\tFörfallna\n-\tUnder förbudsår\nBearbetningskoncessioner:\n-\tAnsökta\n-\tBeviljade\n-\tFörfallna \nMarkanvisningar:\n-\tAnsökta\n-\tBeviljade\n\nInformationen består bland annat av innehavare, valt koncessionsmineral i första hand, tillståndets namn, ansökningsdatum, län, kommun, tillståndets yta i hektar, identitetsnummer och giltighetstid\n\nDatamängden Mineralrättigheter innehåller rikstäckande information om ansökta, beviljade och förfallna undersökningstillstånd, samt undersökningstillstånd under förbudsår. Ansökta och beviljade bearbetningskoncessioner och markanvisningar ingår också i databasen. Innehavare, valt förstahandsmineral, tillståndets namn, ansökningsdatum, län, kommun, tillståndets yta i hektar, identitetsnummer och giltighetstid framgår också.\n\nDatamängden Mineralrättigheter är ett arbetsverktyg för Bergsstaten bl.a. för kontroll så att exempelvis nytt undersökningstillstånd aldrig beviljas på redan upptagen yta. För de som vill undersöka efter koncessionsmineraler (bolag och privatpersoner) är uppgifter om gällande tillstånd samt historik intressant. För myndigheter och kommuner används databasen i frågor som rör exempelvis markanvändning och fysisk planering."},{"@language":"sv","@value":"Datamängden Mineralrättigheter är ett arbetsverktyg för Bergsstaten bl.a. för kontroll så att exempelvis nytt undersökningstillstånd aldrig beviljas på redan upptagen yta. För bolag är uppgifter om gällande tillstånd samt historik intressant. För myndigheter och kommuner används databasen i frågor som rör exempelvis markanvändning och fysisk planering."}],"dct:identifier":"e78b3467-5612-4f79-828a-bac35c3bb1d1","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-27"},"dct:provenance":{"@id":"_:55bf3e38d80568d39ff8bd2939ee6ac1e4f9d9058290bc953ad86779df492000_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:55bf3e38d80568d39ff8bd2939ee6ac1e4f9d9058290bc953ad86779df492000_b1n0"},"dct:title":{"@language":"sv","@value":"Mineralrättigheter"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:14041756-0f3b-43ae-6e6a-f4d321a910ca","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/mrr"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:53261910-1b75-7d4a-0e54-ac1f61981abc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-mineralrattigheter.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:6d31d6a1-db92-5127-39e8-48f1db2cfb4b","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/mineralrattigheter/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:9466ad88-71d2-5958-a04e-07a965d1beb7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/mineralrattigheter/mineralrattigheter.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:b0c646cd-3f18-abdd-2e16-56276ca3b74b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/mineralrattigheter-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:e2359b7f-4d92-0591-3ff6-09275c7a409a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-mineralrattigheter.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:55bf3e38d80568d39ff8bd2939ee6ac1e4f9d9058290bc953ad86779df492000"},{"@graph":[{"@id":"_:561eab4a5430af103caac07926f69d39e0e127fc6d74c4dd8c3071df38f037b5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Klassningen till fastmark görs med en enkel omklassning från grundlagret i produkten Jordarter 1:25 000–1:100 000.\n\nGrundlagret ger en heltäckande bild av jordarternas utbredning i eller nära markytan. Lagret avser den jordartstyp som normalt kan förväntas på karteringsdjup, dvs. ca 0,5 m under markytan, och som bedöms ha en mäktighet väl överstigande 0,5 meter. Dessutom redovisas i detta lager områden där berggrunden går i dagen eller endast täcks av tunna eller osammanhängande jordlager.\n\nGrundlagret är omklassat till fyra genomsläpplighetsklasser (låg genomsläpplighet, medelhög genomsläpplighet, hög genomsläpplighet och ej bedömd genomsläpplighet) baserat på överslagsvärden för permeabilitet för olika jordarter redovisade i tabellen nedan (efter Larsson, 2008). En jordarts förmåga till genomsläpplighet beror dock inte bara på kornstorlek utan även på t.ex. läge i terrängen, mättnadsgrad, grundvattennivå samt det utsläppta ämnets viskositet mm. Produkten tar inte hänsyn till detta, och inte heller till eventuella ytlager eller underliggande lager.\n\nI lagret med täckningsområde redovisas bland annat karteringsmetod. I övrigt hänvisas till beskrivningen av den underliggande produkten Jordarter 1:25 000–1:100 000."}},{"@id":"_:561eab4a5430af103caac07926f69d39e0e127fc6d74c4dd8c3071df38f037b5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e624be92-0afd-4260-b00e-5bef176d4c28","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:527a435d-fc0c-c4cf-6c1c-60abfad78496"},{"@id":"urn:uuid:7c0eef35-d80c-d7bf-4285-43629b45ea9b"},{"@id":"urn:uuid:b111dba2-96d1-f1b6-0b54-ad3db4f9b69a"},{"@id":"urn:uuid:b8136c06-5b7a-f043-2b22-1b8ac4a1f908"},{"@id":"urn:uuid:b96c9fee-6ce1-7aed-678f-92147ef61190"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Genomsläpplighet redovisar en starkt förenklad bild över markens genomsläpplighet. Produkten bygger på en omklassning av grundlagret i datamängden Jordarter 1:25 000–1:100 000 till fyra klasser av genomsläpplighet: låg, medelhög, hög eller ej bedömd genomsläpplighet.\n\nKlassificeringen baseras på kornstorlek hos jordarten i grundlagret. En jordarts förmåga till genomsläpplighet beror dock inte bara på kornstorlek utan även på t.ex. läge i terrängen, mättnadsgrad, grundvattennivå samt det utsläppta ämnets viskositet mm. Produkten tar inte hänsyn till detta, och inte heller till eventuella ytlager eller underliggande lager.\nProdukten är bland annat tänkt att användas som ett första underlag vid bedömning av spridningsrisken av förorenande ämnen från olyckor. Med tanke på eventuella brister i underlaget skall alltid en platsspecifik bedömning göras i terrängen."},"dct:identifier":"e624be92-0afd-4260-b00e-5bef176d4c28","dct:issued":{"@type":"xsd:date","@value":"2024-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-20"},"dct:provenance":{"@id":"_:561eab4a5430af103caac07926f69d39e0e127fc6d74c4dd8c3071df38f037b5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:561eab4a5430af103caac07926f69d39e0e127fc6d74c4dd8c3071df38f037b5_b1n0"},"dct:title":{"@language":"sv","@value":"Genomsläpplighet"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:527a435d-fc0c-c4cf-6c1c-60abfad78496","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/genomslapplighet/genomslapplighet.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:7c0eef35-d80c-d7bf-4285-43629b45ea9b","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/genomslapplighet/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:b111dba2-96d1-f1b6-0b54-ad3db4f9b69a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-25-100-tusen-genomslapplighet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Genomsläpplighet (visningstjänst)"},"dct:title":{"@language":"sv","@value":"Genomsläpplighet (visningstjänst)"}},{"@id":"urn:uuid:b8136c06-5b7a-f043-2b22-1b8ac4a1f908","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/genomslapplighet-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:b96c9fee-6ce1-7aed-678f-92147ef61190","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-genomslapplighet.html?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:561eab4a5430af103caac07926f69d39e0e127fc6d74c4dd8c3071df38f037b5"},{"@graph":[{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 69.05997,24.17767 69.05997,24.17767 55.16437,10.59208 55.16437,10.59208 69.05997))"}},{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/9d28612a-647f-4dbe-8e78-66971835b90c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:28268a67-c59a-f1a7-b771-1489422a1fe5"},{"@id":"urn:uuid:738c0870-0d98-2c69-5b51-962e48ae6ffb"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samtliga Protokoll A för metoder som är äldre än metoden från 2017 som finns inlagda i Nationella Biotopkarteringsdatabasen. \nVarje Protokoll A representerar en biotopkarterad sträcka i ett vattendrag.\n\nKoordinater för protokollen ligger inlagda som punktobjekt. Varje protokoll A har en startpunkt och en slutpunkt.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till objektets protokoll i databasen.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"9d28612a-647f-4dbe-8e78-66971835b90c","dct:issued":{"@type":"xsd:date","@value":"2021-04-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b0n0"},{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Protokoll A, samtliga inventerade sträckor, punkter (metoder äldre än 2017) - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:28268a67-c59a-f1a7-b771-1489422a1fe5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.Biotop_ProtA_Punkter_samtl_inv_strackor.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:738c0870-0d98-2c69-5b51-962e48ae6ffb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}}],"@id":"urn:source:570b88339b98fda27a3e11abb348490e45e43f2fc5427d7b43446ccd2a254178"},{"@graph":[{"@id":"_:572e16d6d3a908f568b4e6fd638b571e71c431edc34767c130881c3764326d51_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.821547006427 58.279680553423,15.665760275297 58.279680553423,15.665760275297 56.823602486482,12.821547006427 56.823602486482,12.821547006427 58.279680553423))"}},{"@id":"_:572e16d6d3a908f568b4e6fd638b571e71c431edc34767c130881c3764326d51_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/e42a7146-37b6-4a32-bd37-6227f9a9873e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4"},"dcat:distribution":[{"@id":"urn:uuid:3094d65d-bcfe-4e93-3295-34b9e592b883"},{"@id":"urn:uuid:42099c00-be06-32d3-daa4-dcc5f24da6cf"},{"@id":"urn:uuid:9ca64266-fbc5-8115-c9e5-3c2824392e17"},{"@id":"urn:uuid:e4a1f616-35da-a1c0-8a0a-91474e54dde0"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Förteckning över blivande naturreservat och andra områdesskydd i Jönköpings län där markägarna är kontaktade"},"dct:identifier":"e42a7146-37b6-4a32-bd37-6227f9a9873e","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:572e16d6d3a908f568b4e6fd638b571e71c431edc34767c130881c3764326d51_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Naturreservat - planerade områdesskydd"}},{"@id":"urn:uuid:3094d65d-bcfe-4e93-3295-34b9e592b883","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.naturvard_plan_omsky.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:42099c00-be06-32d3-daa4-dcc5f24da6cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_2/MapServer/WMSServer?layers=LstF_Naturreservat_planerade_omradesskydd"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Naturreservat_planerade_omradesskydd"}},{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Enheten för naturskydd och tillsyn","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:572e16d6d3a908f568b4e6fd638b571e71c431edc34767c130881c3764326d51_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Enheten för naturskydd och tillsyn"},{"@id":"urn:uuid:9ca64266-fbc5-8115-c9e5-3c2824392e17","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_2/MapServer/31"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:e4a1f616-35da-a1c0-8a0a-91474e54dde0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_naturvard_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:572e16d6d3a908f568b4e6fd638b571e71c431edc34767c130881c3764326d51"},{"@graph":[{"@id":"_:57c5fdcb67d538c1e6ca77cc0dc34ead90fb627aa0d99b479f3af35df6a3ccf0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU påbörjade under 2014 ett tvåårigt projekt för att skanna 200 000 meter borrkärna från Norrbotten och Västerbotten. Skanningsprojektet har som mål att skapa en databas med optiska och infraröda data som ett komplement till de fysiska borrkärnor som finns i SGU:s arkiv i Malå. Skanningen utförs av tjänsteleverantörerna SPECIM, Spectral Imaging Ltd. och GeoSpectral Imaging Ltd. I projektet ingår fotografering med högupplöst optisk kamera samt infraröd avbildning (eng. hyperspectral infrared core imaging). \n\nDen infraröda avbildningen är en passiv, icke-förstörande analysteknik som utnyttjar mineralens förmåga att reflektera och absorbera olika våglängder av det elektromagnetiska spektrumet. Kamerorna i skannern täcker det synliga spektrumet, samt den kortvågiga (VNIR-SWIR) och långvågiga (LWIR) delen av det infraröda. Mineralen som utgör beståndsdelarna i borrkärnan ger ofta karakteristiska signaturer i dessa våglängdsintervall och kombinationen av kortvågig och långvågig IR ger ett dataset som har stor potential för mineralidentifikation. VNIR-SWIR-kameran är till exempel särskilt lämpad för att ge mineralogisk information om ler- och omvandlingsmineral och karbonater, medan LWIR-kameran kan ge information om vanliga silikatmineral som kvarts och fältspat.\n\nDen borrkärneskanner som använts är sisuRock. SisuRock är en automatiserad hyperspektral skanner som kan skanna hela borrkärnslådor. Level 2 data representerar en processeringsnivå där data är klargjort för eventuell vidare spektral processering och produktgenerering.  Data är korrigerat för reflektans och har genomgått nivå 1 processering dvs. kalibrering, band ”subsetting” (borttagning av våglängdsband som kan ge upphov till brus i datasetet vid vidare processering) och felkorrigering. En mask har använts för att ta bort bakgrunden från bilden så att endast borrkärnelådan är synlig. I tillägg har en mask för att extrahera själva borrkärnan från borrkärnelådan tagits fram.\n\nGrundläggande kvalitetskontroll är gjord under skanningsprocessen är genomfört för att säkerställa att data är komplett och korrekt insamlat. Detta inkluderar: \n•\tCheck och kvalitetskontroll av bilddata \n•\tKvalitetskontroll av kalibreringsfiler \n•\tKvalitetskontroll av filnamn och filformat\n•\tGenomgång av metadata för att säkerställa att skanningsdata är korrekt"}},{"@id":"_:57c5fdcb67d538c1e6ca77cc0dc34ead90fb627aa0d99b479f3af35df6a3ccf0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.41 68.92,22.86 68.92,22.86 56.70,11.41 56.70,11.41 68.92))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8d1ffe9e-fcc6-4b23-a8f4-bec869dc952f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:00a2f878-41e2-c3b8-501a-f300562c7838"},{"@id":"urn:uuid:2ae26592-a089-2b12-e3ce-db8fc957d354"},{"@id":"urn:uuid:46d7437e-b3f4-e082-16d7-29aa94cad603"},{"@id":"urn:uuid:77bb1290-5f35-a8c6-221a-543b6060a576"},{"@id":"urn:uuid:ea1ed031-948b-ca66-2686-03a2c72034f2"},{"@id":"urn:uuid:f302e46b-dae0-1a50-0144-4a2c9873570c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Nivå 2 data kan bearbetas vidare för att få fram tolkningar av mineralsammansättningen i borrkärnan. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling. På längre sikt kan resultaten ge ökad kunskap om malmbildningsprocesser och detta kan möjliggöra ett mer effektivt utnyttjande av landets mineralresurser. Analysdata från borrkärneskanningen kan sannolikt också användas för andra ändamål än malmprospektering som t.ex. underlag för miljöutredningar och forskning. \nPotentiella användare är prospekteringsbolag, gruvbolag, konsulter, forskare och studenter."},{"@language":"sv","@value":"Tillhandahållande:\nProdukten tillhandahålls som komprimerade zip-filer med data per borrhål. Länkar till de nedladdningsbara filerna kommer du åt via SGU:s produkt Borrhål, antingen genom att ladda ner borrhål som en förpaketerad GeoPackage-databas för användning i en GIS-klient, eller genom direktåtkomst via ett API.\n\nHär kan du läsa mer om produkterna Borrhål och Hyperspektral IR\nhttps://www.sgu.se/produkter-och-tjanster/geologiska-data/malmer-och-mineral--geologisk-data/borrkarnor-och-borrhal/\n\nBeskrivning:\nHyperspektral IR, data från borrkärnor (processerad, nivå 2) består dels av bilder tagna med högupplöst optisk kamera, dels av infraröda bilder. Data har tagits fram genom att borrkärnor från SGU:s arkiv har skannats och analyserats med avseende på mineralens förmåga att reflektera och absorbera olika våglängder av det elektromagnetiska spektrumet.\n\nKamerorna i skannern täcker det synliga spektrumet, samt den kortvågiga och långvågiga delen av det infraröda (IR) spektrumet. Mineralen som utgör beståndsdelarna i borrkärnan ger ofta karakteristiska signaturer i dessa våglängdsintervall och kombinationen av kortvågig och långvågig IR ger ett dataset som har stor potential för mineralidentifikation. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling.\n\nNivå 2 representerar en processeringsnivå där data är klargjort för eventuell vidare spektral processering och produktgenerering. Notera att mineralidentifikation inte ingår i nivå 2, utan detta kräver vidare bearbetning och tolkning av datat. \n\nNivå 2 data kan bearbetas vidare för att få fram tolkningar av mineralsammansättningen i borrkärnan. Information om mineralsammansättningen i en borrkärna ger kunskap användbar för tolkning och modellering av bergarters ursprung och geologiska utveckling. På längre sikt kan resultaten ge ökad kunskap om malmbildningsprocesser och detta kan möjliggöra ett mer effektivt utnyttjande av landets mineralresurser. Analysdata från borrkärneskanningen kan sannolikt också användas för andra ändamål än malmprospektering som t.ex. underlag för miljöutredningar och forskning.\n\nPotentiella användare är prospekteringsbolag, gruvbolag, konsulter, forskare och studenter."}],"dct:identifier":"8d1ffe9e-fcc6-4b23-a8f4-bec869dc952f","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:57c5fdcb67d538c1e6ca77cc0dc34ead90fb627aa0d99b479f3af35df6a3ccf0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:57c5fdcb67d538c1e6ca77cc0dc34ead90fb627aa0d99b479f3af35df6a3ccf0_b1n0"},"dct:title":{"@language":"sv","@value":"Hyperspektral IR, data från borrkärnor (processerad, nivå 2)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:00a2f878-41e2-c3b8-501a-f300562c7838","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:2ae26592-a089-2b12-e3ce-db8fc957d354","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:46d7437e-b3f4-e082-16d7-29aa94cad603","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hyperspektral-ir-niva-2-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:77bb1290-5f35-a8c6-221a-543b6060a576","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/borrkarnor"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst"}},{"@id":"urn:uuid:ea1ed031-948b-ca66-2686-03a2c72034f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/geologiska-data/malmer-och-mineral--geologiska-data/borrkarnor-och-borrhal/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Information om borrhål och borrkärnor"}},{"@id":"urn:uuid:f302e46b-dae0-1a50-0144-4a2c9873570c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/hyperspektral-ir-level-2-description-eng.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Product description"}}],"@id":"urn:source:57c5fdcb67d538c1e6ca77cc0dc34ead90fb627aa0d99b479f3af35df6a3ccf0"},{"@graph":[{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar/"}},{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2018"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2012"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/b8b131d6-4176-497c-8855-217da20bb81f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:10216a7a-0035-c106-b4a3-86d35f236a50"},{"@id":"urn:uuid:1ff7d27d-fb15-6bdf-9aac-8e0d36d43d8d"},{"@id":"urn:uuid:9e41dd11-6f8f-c458-fe8e-65bef6acf011"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Skredrisk-, sannolikhets-, och konsekvenskartor framtagna med en något enklare metodik än i GÄU Göta ÄlvUtredningen. Kartering är likväl baserad på en baserat på en stor mängd digitala data. Norsälven (2015) var det första vattendraget där denna förenklad metodik för tillämpades. 2017 utfördes Säveån. Metodutvecklingen har genomförts för att få ned utredningskostnaderna och förenkla tolkningen av kartorna, och därigenom öka användbarheten av resultatet. Metodiken för riskkartering som tagits fram är applicerbar för skredriskkartering längs andra vattendrag – t ex Säveån (2017) och Ångermanälven (senare). Allteftersom respektive vattendrag karteras klart kommer det att tillfogas datamängen för ”övriga prioriterade älvar”. Både metodiken för sannolikhetsklassning och konsekvensklassning kan användas var för sig, metodiken för konsekvensklassning kan även användas för kartering av andra naturhändelser. Används vid prioritering av åtgärder, inför planering av ny bebyggelse och planering av åtgärder för befintlig bebyggelse. Se vidare http://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar/\n[Geoteknik]"},"dct:identifier":"b8b131d6-4176-497c-8855-217da20bb81f","dct:issued":{"@type":"xsd:date","@value":"2015-12-21"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-11"},"dct:provenance":{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b1n0"},"dct:temporal":{"@id":"_:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad_b2n0"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Skredriskkartering övriga prioriterade älvar"}},{"@id":"urn:uuid:10216a7a-0035-c106-b4a3-86d35f236a50","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/inspire_nedladdning/SGI_TopAtomFeed_OvrigaAlvar.xml"},"dct:description":{"@language":"sv","@value":"SGI Inspire Nedladdningstjänst, ATOM, övriga älvar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGI Inspire Feature Download service, ATOM"}},{"@id":"urn:uuid:1ff7d27d-fb15-6bdf-9aac-8e0d36d43d8d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/inspire_nedladdning/shp/ovriga_alvar.zip"},"dct:description":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Skredriskkartering övriga prioriterade älvar, Nedladdnings tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga Riskområden, Skredriskkartering övriga prioriterade älvar"}},{"@id":"urn:uuid:9e41dd11-6f8f-c458-fe8e-65bef6acf011","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mapsext.sgi.se/geoserver/inspire_ovrigaalvar/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"SGI Inspire WMS, Naturliga Riskområden, Övriga Prioriterade älvar"},"dct:title":{"@language":"sv","@value":"SGI Inspire View Service"}}],"@id":"urn:source:58f411a134ea220d5984b95b8ad9627adde8d0245ff62bf703039a8905ce45ad"},{"@graph":[{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Den ursprungliga karteringen utfördes under åren 1967 till 1979 och publicerades i Jordartskarta över Västernorrlands län (skala 1:200 000), SGU serie Ca 55 (1987). Under 2005 digitaliserades de områden av kartan där SGU inte hade jordartsinformation i skalområdet 1:25 000 till 1:100 000 och hydrografi (sjö och hav) från GSD-Översiktskartan infördes. I samband med digitaliseringen gjordes vissa omtolkningar och förenklingar. Produktens redovisning motsvarar därför inte helt den tryckta kartans.\n\nLägesfel på flera hundra meter kan förekomma, liksom felaktiga jordartsklassificeringar."}},{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.838156630466 62.859455530374,18.272619147271 62.859455530374,18.272619147271 62.220011370139,14.838156630466 62.220011370139,14.838156630466 62.859455530374))"}},{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"1979"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1979"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/484f86e7-4e02-4bb0-a6eb-8e22f61da88d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0dbc918b-f679-8f87-ff61-83f1c4b49176"},{"@id":"urn:uuid:2bef9599-305c-c9e8-ac01-c8e9e8f01b4c"},{"@id":"urn:uuid:8be44ee4-35fc-0510-1cc2-ed3fae13d904"},{"@id":"urn:uuid:ac49028d-38e8-3dfd-27a6-9ca0b00c7452"},{"@id":"urn:uuid:eb6ce1b6-625e-5fb3-e456-9a5030d3403e"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Kartan ger en mycket översiktlig bild av jordartsförhållandena inom de delar av Västernorrlands län där SGU saknar mer detaljerad jordartsinformation. Den kommer successivt att ersättas med jordartskartor i skalområdet 1:25 000 till 1:100 000. Kartan bör användas med stor försiktighet vid analyser och bedömningar av markförhållanden."},{"@language":"sv","@value":"Kartan ger en mycket översiktlig bild av jordartsförhållandena inom de delar av Västernorrlands län där SGU saknar mer detaljerad jordartsinformation."}],"dct:identifier":"484f86e7-4e02-4bb0-a6eb-8e22f61da88d","dct:issued":{"@type":"xsd:date","@value":"2014-02-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-26"},"dct:provenance":{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b1n0"},"dct:temporal":{"@id":"_:59a09456f3cbf3928155c9ec935c48207b4c7e536787ac423a1daf2f60322673_b2n0"},"dct:title":{"@language":"sv","@value":"Jordarter 1:200 000, Västernorrland"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0dbc918b-f679-8f87-ff61-83f1c4b49176","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/jordarter-200000-vasternorrland-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:2bef9599-305c-c9e8-ac01-c8e9e8f01b4c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resou