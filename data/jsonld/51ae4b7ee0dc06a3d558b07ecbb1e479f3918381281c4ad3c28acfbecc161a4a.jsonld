id":"_:3b7aac3009c3f2d1d74090ab8e3c3420af75fb04ed18fa3b35b48ecac7a33d3f_b2n0"}],"dct:title":{"@language":"sv","@value":"LstI Rikkärr vegetationsanalys norr"}},{"@id":"urn:uuid:108c010c-76e9-6157-40fc-22116486bec4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3b7aac3009c3f2d1d74090ab8e3c3420af75fb04ed18fa3b35b48ecac7a33d3f_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Naturvårdsenheten"},{"@id":"urn:uuid:4a1a3305-e350-5980-aed1-61ef0d5719b1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.LstI_vegetationsanalys_norr_rikkarr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:a423c6c1-a799-8ad5-eb1d-1776c13bcc1c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTI/LstI_rikkarr_ext/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:3b7aac3009c3f2d1d74090ab8e3c3420af75fb04ed18fa3b35b48ecac7a33d3f"},{"@graph":[{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d232815f-5e16-4b0a-9d94-e756f4c4afa9","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0e9c6802-b0e8-d7e3-4096-6855c2cb9fb1"},{"@id":"urn:uuid:6b008eac-639f-3c81-9caf-6723b154d547"}],"dcat:keyword":{"@language":"sv","@value":"Administrativa enheter"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Lagen (2017:1272) om Sveriges sjöterritorium och maritima zoner gäller från och med 1 mars 2018\nBaslinjer och gränser redovisas med samtliga koordinater i bilagor till lagen. De linjer som definierar gränserna har delats i kortare segment för att redovisas korrekt i förekommande kartprojektioner. \nBaslinjepunkter, punkter på lågvattenlinjen och lågvattenskär har inspekterats och mätts in och ligger till grund för den beräkning som gjorts av sjöterritoriets gräns i havet och gränsen för angränsande zon. Räta baslinjer går mellan baslinjepunkter belägna på kustens lågvattenlinje (-0,5 meter RH2000) och följer kustens huvudriktning. Normala baslinjer förekommer längs vissa delar av Skånes, Ölands och Gotlands kuster och följer lågvattenlinjen längs de kuststräckor där vi inte har räta baslinjer. Punkterna på lågvattenlinjen är belägna på normala baslinjer och har valts ut i de fall läget förväntas påverka beräkningen av sjöterritoriets gräns i havet. Lågvattenskär är belägna utanför baslinjerna och har valts ut på motsvarande grunder.\n\nFöljande attribut finns i punkt shape-filen:\nLöpnr_dels - Löpnummer för baslinjepunkterna (BP) för respektive delsträcka.\nDelsträcka – Baslinjerna redovisas med följande delsträckor; Fast land och Öland, Gotland inklusive Fårö och Lilla Karlsö, Gotska Sandön, Stora Karlsö, Märket, Märkeshällarna.\nPunktnummer_namn – Nummer och namn på baslinjepunkter och lågvattenskär\nLatitud & Longitud - Alla punkter utmed gränsen beskrivs med geografiska koordinater i latitud och longitud uttryckta i referenssystemet SWEREF 99 dels i grader och decimala minuter som det står i lagen och dels i decimala grader.\nPunkttyp - Följande punkttyper förekommer:\n• punkt på lågvattenlinjen utmed normal baslinje (LP),\n• ändpunkt på rät baslinje, baslinjepunkt (BP),\n• segmenterad punkt på en rät geodetisk linje mellan två baslinjepunkter\n(MP), och\n• punkt på lågvattenskär beläget utanför en baslinje (LS).\nTyp av baslinje - Vilken typ av baslinje (rät/normal) som startar i punkten.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner. \nUnikt ID – Ett unikt ID som Sjöfartsverket adderat.\n\nFöljande attribut finns i linje shape-filen:\nDelsträcka – Delsträcka för rät baslinje.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner."},"dct:identifier":"d232815f-5e16-4b0a-9d94-e756f4c4afa9","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b1n0"},"dct:temporal":{"@id":"_:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b_b2n0"},"dct:title":{"@language":"sv","@value":"Baslinjer"}},{"@id":"urn:uuid:0e9c6802-b0e8-d7e3-4096-6855c2cb9fb1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/globalassets/sjokort-och-sjogeografi/baslinjer.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av shapefile med baslinjer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Baslinjer-shape"}},{"@id":"urn:uuid:6b008eac-639f-3c81-9caf-6723b154d547","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/sv/tjanster/havsgranser/baslinjer/"},"dct:description":{"@language":"sv","@value":"Information om baslinjer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Baslinjer"}}],"@id":"urn:source:3be26da68d8d59437c1b09a56ccbc985fee05a47eb7420a3b366005be339329b"},{"@graph":[{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventeringspunkter från kustområden mellan 2018 och 2021. \nDropvideo med punktanalys av antalet arter per punkt."}},{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.95232 58.58721,19.44639 58.58721,19.44639 56.82802,17.95232 56.82802,17.95232 58.58721))"}},{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a24bf956-908b-49d4-b15d-5fa6eb08838e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5"},"dcat:distribution":{"@id":"urn:uuid:0447a2e1-0bb1-f121-f7fd-dca554df54c4"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Länsstyrelsen Gotlands artinventeringar via dropvideo mellan 2018-2021. Visar hur mycket av varje art so finns på en specifik plats."},"dct:identifier":"a24bf956-908b-49d4-b15d-5fa6eb08838e","dct:issued":{"@type":"xsd:date","@value":"2021-01-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-01-29"},"dct:provenance":{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Hav Arter täckningsgrad"}},{"@id":"urn:uuid:0447a2e1-0bb1-f121-f7fd-dca554df54c4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.Hav_TG_GIS_Taxa.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Miljö- och vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Miljö- och vattenenheten"}],"@id":"urn:source:3c39fcc7ee274862d53b91adce863d6164f13c89b60aa65c2913e9f4aab64ce3"},{"@graph":[{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är mottagna under vegetationsperioden respektive period, och har en geometrisk upplösning på 10-30 meter. Undantaget är data från 1970-talet som har 80 meter upplösning."}},{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1976"}},{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"80182","http://www.w3.org/2006/vcard/ns#street-address":"Geodatasupport, Lantmäteriet"},{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:026-633600"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/c2be5e62-4779-4965-9cd9-2611e357c6a2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109"},"dcat:distribution":[{"@id":"urn:uuid:7d71fbb1-38dd-4a5a-6ec9-8ea9aaf226ef"},{"@id":"urn:uuid:e6615e5e-99de-be00-b017-f3354539eadd"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är motttagna under vegetationsperioden respektive period, och har en geometrisk upplösning på 10-30 meter. Undantaget är data från 1970-talet som har 80 meters upplösning."},"dct:identifier":"c2be5e62-4779-4965-9cd9-2611e357c6a2","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-01"},"dct:provenance":{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b1n0"},"dct:temporal":{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b2n0"},"dct:title":{"@language":"sv","@value":"Saccess, systemkorrigerade scener"}},{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Lantmäteriet","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3c8afdb30310521ef2a12224f9d907d13ae4aaa8c3c52547c263b0095c666f44_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodatasupport@lm.se"},"http://www.w3.org/200