20f34ad4-9e3c-c393-9c9a-7b5c7a1bd5c5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"AM.Fiskets geografier.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a3e201e661b0bbdd0c0971fe01b3d33b0797ebdfc4b1290c7f4a0cf9fd8ceed5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"}],"@id":"urn:source:a3e201e661b0bbdd0c0971fe01b3d33b0797ebdfc4b1290c7f4a0cf9fd8ceed5"},{"@graph":[{"@id":"_:a55890c03bbc1b69d8801505720e43e7d66fec15395dc86f72a7fb874ad201e6_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.07743 58.18724,15.66576 58.18724,15.66576 56.87897,13.07743 56.87897,13.07743 58.18724))"}},{"@id":"_:a55890c03bbc1b69d8801505720e43e7d66fec15395dc86f72a7fb874ad201e6_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/8c5b47c5-709a-44fd-bf1f-98fcaf3e6556","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7"},"dcat:distribution":[{"@id":"urn:uuid:3b030b82-f20b-309a-567b-621b1eba5a2e"},{"@id":"urn:uuid:48af57d1-cf9a-d01e-b1c3-2de33f567413"},{"@id":"urn:uuid:be9a722c-0a6c-43af-7a16-06a2f5968f7b"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventering av samtliga förekommande frikyrkobyggnader i länet. Inventeringen pågick under åren 1999 till augusti 2001. I enstaka fall kan vissa objekt tillkomma i de fall ny information tillkommer. Syfte: Skapa förutsättningar för att kunna bevara och vårda de kulturhistoriskt mest värdefulla byggnaderna och lokalerna som en viktig del av länets kulturarv. Inventeringen spänner över ca 140 år, från 1860 till och med utgången av år 1999.\n\nSom ett komplement till databasen är det planerat/pågående en vidareutveckling/uppföljning och förändring av via ett nytt skikt som visar vilka förändringar som skett av frikyrkorna sedan den första inventeringen skedde. Byggnadsantikvarie har på uppdrag gått igenom och återbesökt länets frikyrkor (resultat troligen i exceltabell)."},"dct:identifier":"8c5b47c5-709a-44fd-bf1f-98fcaf3e6556","dct:issued":{"@type":"xsd:date","@value":"2001-09-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2001-09-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:a55890c03bbc1b69d8801505720e43e7d66fec15395dc86f72a7fb874ad201e6_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Kultur Frikyrkor"}},{"@id":"urn:uuid:3b030b82-f20b-309a-567b-621b1eba5a2e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_1/MapServer/WMSServer?layers=lstf_frikyrkor"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"lstf_frikyrkor (WMS)"}},{"@id":"urn:uuid:48af57d1-cf9a-d01e-b1c3-2de33f567413","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_kulturmiljo_EXT/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:be9a722c-0a6c-43af-7a16-06a2f5968f7b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.kultur_frikyrkor.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Kulturmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a55890c03bbc1b69d8801505720e43e7d66fec15395dc86f72a7fb874ad201e6_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Kulturmiljöenheten"}],"@id":"urn:source:a55890c03bbc1b69d8801505720e43e7d66fec15395dc86f72a7fb874ad201e6"},{"@graph":[{"@id":"_:a5a375b2597a9c9c82b4a2c416704eada5f67d1349fa9d18a127cd841a7bc2bf_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/f9ff2a0e-0e42-34eb-2c07-1decaf3965bf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3c4fa969-0f10-376b-4c3a-33f51fdecf65"},"dcat:distribution":[{"@id":"urn:uuid:8b92937b-05ce-d280-4cf0-c996b14208c8"},{"@id":"urn:uuid:ecba9a53-ab09-cd91-2aad-4ec5f62f5471"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Havs- och vattenmyndighetens diarieförda ärenden. I vårt diarium kan du söka ärenden från den 1 januari 2013 och framåt. För varje ärende visas ärendemening, handläggande enhet, handläggare samt händelser i ärendet. Om du vill få tillgång till hela ärendet eller äldre ärenden kontaktar du våra registratorer.\n\nI diariet hittar du också underlagsrapporter. Det är en utredning eller kunskapssammanställning som används som underlag för myndighetens verksamhet."},"dct:identifier":"f9ff2a0e-0e42-34eb-2c07-1decaf3965bf","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2013-01-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Havs- och vattenmyndighetens huvuddiarium"}},{"@id":"urn:uuid:3c4fa969-0f10-376b-4c3a-33f51fdecf65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndighetens diarium","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a5a375b2597a9c9c82b4a2c416704eada5f67d1349fa9d18a127cd841a7bc2bf_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndighetens diarium"},{"@id":"urn:uuid:8b92937b-05ce-d280-4cf0-c996b14208c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/om-oss-kontakt-och-karriar/diarium/om-diariet.html"},"dct:description":{"@language":"sv","@value":"Om Havs- och vattenmyndighetens diarium"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:ecba9a53-ab09-cd91-2aad-4ec5f62f5471","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/om-oss-kontakt-och-karriar/diarium.html"},"dct:description":{"@language":"sv","@value":"Söksida för Havs- och vattenmyndighetens diarium"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}}],"@id":"urn:source:a5a375b2597a9c9c82b4a2c416704eada5f67d1349fa9d18a127cd841a7bc2bf"},{"@graph":[{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sverigekartan skala 1:1 miljon har förminskats och genereraliserats manuellt. Kartan har sedan digitaliserats.\n\nLägesnoggrannheten är uppskattad till 2-4 km."}},{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2001"}},{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"80182","http://www.w3.org/2006/vcard/ns#street-address":"Geodatasupport, Lantmäteriet"},{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:026-633600"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/57050110-5693-485b-b496-732c87f862ea","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109"},"dcat:distribution":{"@id":"urn:uuid:7204368e-4b75-aafe-473c-71f7b7d7de43"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten innehåller kustlinje, riksgräns, polcirkeln och gradnät/rutnät."},"dct:identifier":"57050110-5693-485b-b496-732c87f862ea","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-01-01"},"dct:provenance":{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b1n0"},"dct:temporal":{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b2n0"},"dct:title":{"@language":"sv","@value":"GSD-Sverigekartan 1:20 miljon, vektor"}},{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Lantmäteriet","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodatasupport@lm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Lantmäteriet"},{"@id":"urn:uuid:7204368e-4b75-aafe-473c-71f7b7d7de43","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/sverigekartor"},"dct:description":{"@language":"sv","@value":"Produktsida för Sverigekartor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets webbplats"}}],"@id":"urn:source:a5e8804e4ad1f4c547ff5fce57537722dc06edf0a54c23482307081a8e226b6b"},{"@graph":[{"@id":"_:a6264ad544a9a4d4294410aaec30b88d625d849aa71ffd194758d8df4df4305e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Berggrund 1:50 000–1:250 000 är en sammanslagning av de tidigare produkterna Berggrund 1:50 000 och Berggrund 1:250 000. Informationen bygger på kartläggningar och sammanställningar som påbörjades på 1960-talet och pågår än idag. Kartläggningen har under åren utförts med olika metoder, med olika observationstäthet på skiftande geografiskt underlag samt för presentationsskalor från 1:50 000 till 1:250 000. Den tidiga informationen har digitaliserats från tryckt kartunderlag. Från slutet av 1990-talet produceras data i digital miljö. Över många kartlagda områden har det publicerats kartor inom SGU:s serier Af, Ai, Ba, Ca och K och till dessa finns vanligen utgivna beskrivningar som innehåller kompletterande information om geologiska förhållanden och arbetsmetoder. Information om dessa beskrivningar finns på www.sgu.se. De flesta kartor och beskrivningar kan laddas ner kostnadsfritt från tjänsten GeoLagret via www.sgu.se.\n\nEftersom olika karteringsmetoder har tillämpats i olika områden och under olika perioder, så är produktens kvalitet inte enhetlig utan skiljer sig från område till område. Den mest detaljerade kartläggningen (Karttyp 1–3, se nedan), som bygger på omfattande fältarbete har utförts främst i tätbefolkade och prospekteringsintressanta områden i delar av södra och norra Sverige. I andra områden har mer översiktliga karteringsmetoder tillämpats. Flygmätta geofysiska data är särskilt viktiga för att tolka de stora områden där berggrunden är täckt av lösa avlagringar. Informationens kvalitet beror också på vilka geofysiska data som varit tillgängliga vid kartläggningen. De skillnader i karteringsmetod som tillämpats vid kartläggningen redovisas genom att informationen har märkts som olika karttyper ."}},{"@id":"_:a6264ad544a9a4d4294410aaec30b88d625d849aa71ffd194758d8df4df4305e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.05,24.18 69.05,24.18 55.33,11.11 55.33,11.11 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/5e0f2b85-84d6-4d0c-af76-656c6f6d2a46","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:15c4f25d-2682-0845-41c8-3efd19061405"},{"@id":"urn:uuid:437683da-617c-e81e-85d9-726ac6439f97"},{"@id":"urn:uuid:7303eab6-c903-b731-331b-1f1b99b19bbd"},{"@id":"urn:uuid:9a072e53-9c39-0c9f-3fd1-afe8f9e662db"},{"@id":"urn:uuid:d1c4feab-1d6a-50b7-d799-7cf05d2340ef"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Berggrundskartan är en tvådimensionell modell av berggrundens överyta, som beskriver viktiga egenskaper hos identifierade geologiska enheter, deras geometri, det material som bygger upp enheterna och geologiska händelser som de genomgått. I berggrundskartan ingår även berggrundens strukturer och deras egenskaper. Berggrundskartan bygger på geologiska fältobservationer i kombination med tolkning av analysresultat och geofysiska data. Syftet med berggrundskartan är att ge underlag för analyser i samband med prospektering, översiktsplanering av byggen och anläggningar, geotermisk energiutvinning, arbete med olika frågor inom miljöområdet, forskning och utbildning. Informationen i kartan kan användas för framställning av olika tematiska produkter, t ex kartor över näringsinnehåll, värmeledningsförmåga och lämplighet för anläggningar. Informationen ligger till grund för SGU:s tryckta berggrundskartor och olika karttjänster. Kartläggningen har skett från början av 1960-talet med olika metoder, olika observationstäthet och för olika presentationsskalor. Detta gör att det finns stora skillnader i kvalitet inom produkten, både vad gäller lägesnoggrannhet och informationsinnehåll. De skillnader i karteringsmetod som tillämpats vid kartläggningen redovisas genom att informationen har märkts som olika karttyper."},{"@language":"sv","@value":"Syftet med berggrundskartan är att ge underlag för analyser i samband med prospektering, översiktsplanering av byggen och anläggningar, geotermisk energiutvinning, arbete med olika frågor inom miljöområdet, forskning och utbildning. Informationen i kartan kan användas för framställning av olika tematiska produkter, t ex kartor över näringsinnehåll, värmeledningsförmåga och lämplighet för anläggningar. Informationen ligger till grund för SGUs tryckta berggrundskartor och olika karttjänster."}],"dct:identifier":"5e0f2b85-84d6-4d0c-af76-656c6f6d2a46","dct:issued":{"@type":"xsd:date","@value":"2016-06-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-31"},"dct:provenance":{"@id":"_:a6264ad544a9a4d4294410aaec30b88d625d849aa71ffd194758d8df4df4305e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:a6264ad544a9a4d4294410aaec30b88d625d849aa71ffd194758d8df4df4305e_b1n0"},"dct:title":{"@language":"sv","@value":"Berggrund 1:50 000 - 1:250 000"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:15c4f25d-2682-0845-41c8-3efd19061405","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/berggrund-50-250000-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:437683da-617c-e81e-85d9-726ac6439f97","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-berg-50-250-tusen.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:7303eab6-c903-b731-331b-1f1b99b19bbd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/berggrund-50-250-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:9a072e53-9c39-0c9f-3fd1-afe8f9e662db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/berggrund50k-250k/berggrund50k-250k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:d1c4feab-1d6a-50b7-d799-7cf05d2340ef","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/berggrund50k-250k/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:a6264ad544a9a4d4294410aaec30b88d625d849aa71ffd194758d8df4df4305e"},{"@graph":[{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 63.9956,19.6076 63.9956,19.6076 55.9133,10.592 55.9133,10.592 63.9956))"}},{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 63.99566,19.6076 63.99566,19.6076 55.91333,10.59208 55.91333,10.59208 63.99566))"}},{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/2b5b141f-a9a4-433a-8dc7-bf983acdb859","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:00d35fc1-d547-2a75-d78f-0ada71bc8cb2"},{"@id":"urn:uuid:8b464752-70dc-e942-180c-28727dd4072a"},{"@id":"urn:uuid:a69cd3ab-24fc-0390-3507-7984998f6093"},{"@id":"urn:uuid:a8a6b175-a0c4-b192-3946-59d89869dc86"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Detta kartlager visar Länsstyrelsernas tolkning av de områden som riksdagen beslutat är av riksintresse för obruten kust enligt 4 kap. 3 § miljöbalken.  Denna bestämmelse har sitt ursprung i lagen (1987:12) om hushållning med naturresurser m.m. Då riksdagen fattade beslut om riksintresset fanns den geografiska avgränsningen enbart beskriven i text med ortsnamn och/eller andra geografiskt fasta punkter, samt en grov illustration i förarbetena (prop. 1985/86:3). Länsstyrelserna har senare gjort en mer preciserad tolkning av den geografiska avgränsningen i samråd med berörda kommuner.\n \nObservera att detta gis-skikt endast är en indikativ tolkning av gränserna. För aktuell avgränsning se gällande översiktsplan. Det är i den kommunala översiktsplaneringen som innebörden av de geografiska riksintressebestämmelserna i 4 kap miljöbalken kan konkretiseras.\n \nFör mer information om bakgrunden till riksintressebestämmelserna, se Boverkets vägledning i PBL kunskapsbanken."},"dct:identifier":"2b5b141f-a9a4-433a-8dc7-bf983acdb859","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b0n0"},{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Riksintresse Obruten kust MB4kap1,3"}},{"@id":"urn:uuid:00d35fc1-d547-2a75-d78f-0ada71bc8cb2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST RI Obruten kust"},"dct:title":{"@language":"sv","@value":"3"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:8b464752-70dc-e942-180c-28727dd4072a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/sv/PBL-kunskapsbanken/riksintressen/riksintressen-enligt-4-kap-mb/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Boverket PBL-kunskapsbanken"}},{"@id":"urn:uuid:a69cd3ab-24fc-0390-3507-7984998f6093","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.LST_RI_Obruten_kust_MB4kap3.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:a8a6b175-a0c4-b192-3946-59d89869dc86","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Riksintressen_EXT/MapServer/2"},"dct:description":{"@language":"sv","@value":"Restgränssnitt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Riksintresse Obruten kust MB 4 kap 1,3"}}],"@id":"urn:source:a66359fed7225743963f161ba2253fb04999ffcc8cae2ddb38ac0edf23d60c07"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1cb811e5-da52-4ec1-8641-30e12bc08ee6","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/dokumentation/GEODOK/9/latest.html"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten ger möjlighet att hämta referens till fastighet eller samfällighet genom att ange adressbeteckning. Registerenhetsreferensen kan sedan användas för att hämta ytterligare information via övriga direktåtkomstprodukter."},"dct:identifier":"1cb811e5-da52-4ec1-8641-30e12bc08ee6","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Referens Uppslag Adress"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a69babd20510538d7e13e7d47006ba0e0a999c073fb7e8e0137e336197f6ce2e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3d6399af-c6e1-4177-8b3b-7d7cea8dbd5c","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Berggrund_50k-250k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Inspire visningstjänst för datamängden GE.Berggrund 1:50 000 - 1:250 000"},"dct:identifier":"3d6399af-c6e1-4177-8b3b-7d7cea8dbd5c","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Berggrund 1:50 000 - 1:250 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a724b3739859b8e6deb1bea3580884f1945efd904b1d3dc652dd719440fb5d54"},{"@graph":[{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SCB tar fram gränser för tätorter med hjälp av registerdata, till exempel SCB:s register över totalbefolkningen (RTB) och Lantmäteriets fastighetskarta och koordinatsatta byggnadsregister. \n\nTill och med 2010 års tätortsavgränsningar dominerade de manuella momenten i framtagandet av tätorter. Tätorterna avgränsades utgående från fastighetsdata från Lantmäteriet (fastigheter och byggnader). Dessutom användes flygfoton från Lantmäteriets WMS-tjänst. Vid avgränsningen utgick SCB från tidigare avgränsning och lade till områden där ny bebyggelse tillkommit. För att fånga nya tätorter skapades buffertar runtom byggnader utanför tidigare tätorter. Manuell kontroll gjordes av varje tätort.\n\nInför arbetet med 2015 års gränser fick SCB tillgång till teknik och data som gjorde det möjligt att förändra och effektivisera metoderna på ett kvalitetssäkert sätt. Tätorter avgränsas numera automatiskt, nya gränser skapas för alla tätorter genom att buffra byggnader och fastigheter. Samtliga tätorter granskas manuellt, men justeringar av gränser görs endast i undantagsfall och framför allt på tätorter med mer än 10 000 invånare."}},{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2023"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1990"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/f0f6cef8-41cd-4ebd-88e5-ea6c2ed7109e","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0dc4dafc-9f85-dd99-2551-3904d15964d4"},{"@id":"urn:uuid:52c44389-6c07-3611-1986-6657a8897a3d"},{"@id":"urn:uuid:881dafdf-a10a-1760-3c6b-394a31f847d1"},{"@id":"urn:uuid:afc3c404-8c0f-21a0-45c4-be0fc9d25c8d"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tätorter är koncentrerad bebyggelse med minst 200 invånare. SCB tar fram gränser för tätorter med hjälp av registerdata, till exempel SCB:s register över totalbefolkningen (RTB), SCB:s företagsregister samt Lantmäteriets fastighetskarta och koordinatsatta byggnadsregister. Öppna geodata visas som polygoner och fram till 2015 har tätorter uppdaterats vart femte år. Sedan 2016 uppdateras de vart tredje eller vart annat år."},"dct:identifier":"f0f6cef8-41cd-4ebd-88e5-ea6c2ed7109e","dct:modified":{"@type":"xsd:date","@value":"2024-11-01"},"dct:provenance":{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b1n0"},"dct:temporal":{"@id":"_:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675_b2n0"},"dct:title":{"@language":"sv","@value":"Tätorter"}},{"@id":"urn:uuid:0dc4dafc-9f85-dd99-2551-3904d15964d4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.scb.se/mi0810"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktspecifikation"}},{"@id":"urn:uuid:52c44389-6c07-3611-1986-6657a8897a3d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Tätorter WFS"}},{"@id":"urn:uuid:881dafdf-a10a-1760-3c6b-394a31f847d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/statistiska-tatorter/"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av filer i geopackage format."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för tätorter"}},{"@id":"urn:uuid:afc3c404-8c0f-21a0-45c4-be0fc9d25c8d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Tätorter WMS"}}],"@id":"urn:source:a74e35e14d83d48c993e25d93435c1ef189ae6363d187d552a5de9422e65c675"},{"@graph":[{"@id":"_:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventering på Kulturmiljöenheten 2004 (arbetsmaterial)"}},{"@id":"_:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.00081 60.17882,14.19201 60.17882,14.19201 59.36479,12.00081 59.36479,12.00081 60.17882))"}},{"@id":"_:a776d5d2c24397235482f99f858c58051dbbbfdccfb3418ffcbde7974dd3e91f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataporta