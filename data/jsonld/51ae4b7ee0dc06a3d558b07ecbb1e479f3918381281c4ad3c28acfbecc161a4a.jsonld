nguage":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/1e69b9ba-4b5b-44c5-b47f-72ec336be7f3","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51"},"dcat:endpointURL":{"@id":"https://inspire-raa.metria.se/raafeed/BU.Buildings-topfeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datasetet visar det geografiska läget för enskilda och statliga byggnadsminnen och kyrkor som är registrerade i Bebyggelseregistret. Datasetet ingår i INSPIRE-direktivets tema byggnader."},"dct:identifier":"1e69b9ba-4b5b-44c5-b47f-72ec336be7f3","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:61ea9aa6-3bd2-bf12-be33-f7c416706f51","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Metria","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5a8e31cdb80892e5876dd0c02d7260a714f706859b177536dc075659072cea4b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5a8e31cdb80892e5876dd0c02d7260a714f706859b177536dc075659072cea4b_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:5a8e31cdb80892e5876dd0c02d7260a714f706859b177536dc075659072cea4b"},{"@graph":[{"@id":"_:5a9cc5cbd84ecb754bf2b9d8c7d06ea3704d340d9944f872144ce5d7d01a103e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas (källdata) fylls kontinuerligt med ny sjömätningsdata samt med skannade djup från äldre sjömätningar."}},{"@id":"_:5a9cc5cbd84ecb754bf2b9d8c7d06ea3704d340d9944f872144ce5d7d01a103e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30000 65.87000,23.51000 65.87000,23.51000 54.80000,10.30000 54.80000,10.30000 65.87000))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1acab5c8-3b1f-4b85-821f-281e72f8b979","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:b965584b-bbaf-f794-9df1-f547cb5c0aa3"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Oreducerad djupdatamängd från arkivlagret i Sjöfartsverkets djupdatabas. Upplösningen varierar kraftigt, framförallt beroende på insamlingsmetod och vattendjup, från flera hundra mätpunkter per m² till flera km mellan varje mätpunkt. Inom vissa områden saknas djupinformation helt. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"1acab5c8-3b1f-4b85-821f-281e72f8b979","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-11-23"},"dct:provenance":{"@id":"_:5a9cc5cbd84ecb754bf2b9d8c7d06ea3704d340d9944f872144ce5d7d01a103e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:5a9cc5cbd84ecb754bf2b9d8c7d06ea3704d340d9944f872144ce5d7d01a103e_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata"}},{"@id":"urn:uuid:b965584b-bbaf-f794-9df1-f547cb5c0aa3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:5a9cc5cbd84ecb754bf2b9d8c7d06ea3704d340d9944f872144ce5d7d01a103e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/19aa04d6-f2c9-4070-8633-59f496519fd1","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/markhojd-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten ger svar på frågor om höjd för enskilda punkter eller brytpunkter på en linje alternativt polygon. Tidigare hette produkten Höjd Direkt."},"dct:identifier":"19aa04d6-f2c9-4070-8633-59f496519fd1","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Markhöjd Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:5ac178b97123f8e31a67bcef3ef744734a430351ec297086bb35669d938842b3"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/4ff040d0-c539-461f-9b39-25e28573b898","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/rattighet-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten ger möjlighet att hämta information om rättigheter från fastighetsregistrets allmänna del. Tjänsten består av ett antal fördefinierade delar som kan hämtas tillsammans eller var och en för sig.\nFastighetsregistrets allmänna del innehåller information om rättigheter. En rättighet kan medföra rätt för en ägare till en fastighet, person eller bolag att för visst ändamål använda ett område av annan ägares fastighet eller anläggning. Exempel på rättigheter är väg, brygga och el-ledning."},"dct:identifier":"4ff040d0-c539-461f-9b39-25e28573b898","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Rättighet Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:5b09f5d3f1704a5dcb990213def591c2b9fda90043051bc0bb0247e198075bc7"},{"@graph":[{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 66.8429,23.24347 66.8429,23.24347 55.68924,10.59208 55.68924,10.59208 66.8429))"}},{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/866aee82-09c5-40b4-b5a7-5420924828d5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9"},"dcat:distribution":[{"@id":"urn:uuid:e8b15883-8a58-3591-9b91-01a8a7842be4"},{"@id":"urn:uuid:f2881d5a-5b85-54dd-c3e9-e56cddc17b99"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Samtliga bestämmande sektioner som finns inlagda i Nationella Biotopkarteringsdatabasen och som är inmatade med koordinater.\nVarje bestämmande sektion ligger på en biotopkarterad sträcka med ett protokoll A.\nEftersom en bestämmande sektion kan påverka flera sträckor uppströms kan det vara bra att samköra det här skiktet med skiktet för protokoll A. Då kan du lätt kontrollera vilka de efterföljande sträckorna är.\n\nEn bestämmande sektion är en punkt som är någon form av tröskel eller strypning som har avgörande betydelse för sträckan den ligger på och sträckor uppströms. \nEtt kriterium för en bestämmande sektion är att det ska vara en permanent struktur. En vedansamling, grusbank eller liknande kan inte vara en bestämmande sektion.\n\nKoordinater för den bestämmande sektionen ligger inlagda som punktobjekt. Varje bestämmande sektion har en punkt.\nMängden data för objekten är begränsat i skiktet, men varje punkt har en länk till det Protokoll A som den bestämmande sektionen ligger inlagd på.\n\nKoordinater är i Sweref 99 TM."},"dct:identifier":"866aee82-09c5-40b4-b5a7-5420924828d5","dct:issued":{"@type":"xsd:date","@value":"2021-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b0n0"},{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Bestämmande sektioner - Biotopkarteringsdatabasen"}},{"@id":"urn:uuid:054df213-7e73-b0a3-05f5-093b3c141de9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Vatten och miljömål","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vatten.miljomal@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Vatten och miljömål"},{"@id":"urn:uuid:e8b15883-8a58-3591-9b91-01a8a7842be4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lstext.Biotop_Bestammande_sektioner.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:f2881d5a-5b85-54dd-c3e9-e56cddc17b99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://biotopkartering.lansstyrelsen.se"},"dct:description":{"@language":"sv","@value":"Nationell databas för biotopkartering - vattendrag"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Biotopkarteringsdatabasen"}}],"@id":"urn:source:5b6e5f23f106ecef9aeafc83f4a56d47283f01631d40d1cd27b66adb9c27bcb5"},{"@graph":[{"@id":"_:5b845477488580880800cc2702bdbefc05836641ebceae64bf49ae6fee137ff4_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Relativ tyngdkraftsmätning utförd av Lantmäteriet och SGU sedan 1960-talet."}},{"@id":"_:5b845477488580880800cc2702bdbefc05836641ebceae64bf49ae6fee137ff4_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.56 68.83,25.59 68.83,25.59 55.26,11.56 55.26,11.56 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/b6b5fb29-59f0-4650-9ef1-724db13567c1","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2034f736-d576-38c0-872c-f5c05246ed9b"},{"@id":"urn:uuid:5810e1c3-cb39-517b-7ad3-f3f3d4ea0d32"},{"@id":"urn:uuid:72ddc40f-5292-5e85-1244-74c6911bfed1"},{"@id":"urn:uuid:844a0480-04a0-9861-b804-5ba6fe14fb61"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Detaljpunkter med mätt tyngdkraft som ligger till grund för geoidmodellering.\nDatamängden ingår i produkterna Tyngdkraft nedladdning och Tyngdkraft Visning."},"dct:identifier":"b6b5fb29-59f0-4650-9ef1-724db13567c1","dct:issued":{"@type":"xsd:date","@value":"2017-05-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-31"},"dct:provenance":{"@id":"_:5b845477488580880800cc2702bdbefc05836641ebceae64bf49ae6fee137ff4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:5b845477488580880800cc2702bdbefc05836641ebceae64bf49ae6fee137ff4_b1n0"},"dct:title":{"@language":"sv","@value":"Detaljtyngdkraftsdata"}},{"@id":"urn:uuid:2034f736-d576-38c0-872c-f5c05246ed9b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/tyngdkraft-visning-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Tyngdkraft Visning."},"dct:format":{"@id":"http://publications.europa.eu/resource/