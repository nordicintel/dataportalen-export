tp://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:3cba67e6f24e867415e489083d76fe48ba98b19b1619820f0cd6fa78abcb856b_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:7beb8997-7fe2-5c9d-3e11-1e60d8a71ea2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg303_kul_res.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:3cba67e6f24e867415e489083d76fe48ba98b19b1619820f0cd6fa78abcb856b"},{"@graph":[{"@id":"_:3cbaef7105fe192fbe63f51e5b8484a110a51a3b09b040f92b569c4c8b7d6732_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/ae5b3858-f067-0fe6-4b59-a0ece5f3a7a5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:d505132d-7684-b6c4-178b-1f8cc266401e"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Övervakning av kontinuerligt undervattensbuller i havet. Rådata och processad data med 20 sekunders medelvärden lagras nationellt hos FOI då nationellt datavärdskap för undervattensbuller saknas. Signalbehandlad data laddas upp på Ices regionala databas och dessa data kan laddas ner kostnadsfritt från Ices hemsida eller via API"},"dct:identifier":"ae5b3858-f067-0fe6-4b59-a0ece5f3a7a5","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Kontinuerligt undervattensbuller"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3cbaef7105fe192fbe63f51e5b8484a110a51a3b09b040f92b569c4c8b7d6732_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:d505132d-7684-b6c4-178b-1f8cc266401e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://underwaternoise.ices.dk/continuous/submissions"},"dct:description":{"@language":"sv","@value":"Rådata och processad data med 20 sekunders medelvärden lagras nationellt hos FOI då nationellt datavärdskap för undervattensbuller saknas. Signalbehandlad data laddas upp på Ices regionala databas och dessa data kan laddas ner kostnadsfritt från Ices hemsida eller via API:\n\nhttps://underwaternoise.ices.dk/continuous/webservices\nhttps://underwaternoise.ices.dk/continuous/submissions"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"ICES Continous Underwater Noise Registry"}}],"@id":"urn:source:3cbaef7105fe192fbe63f51e5b8484a110a51a3b09b040f92b569c4c8b7d6732"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/23b71708-78f1-411c-84a6-a7af88bfbcf5","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/ortofoto-visning-api"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten innehåller ortofoton (ortogonalprojicerade flygbilder, skalriktiga i markytan) i färg (RGB) i fyra detaljeringsnivåer (upplösningar) samt infrarött (IR) i en nivå. Produkten uppfyller kraven för EU-direktivet Inspire."},"dct:identifier":"23b71708-78f1-411c-84a6-a7af88bfbcf5","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Ortofoto Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:3d1d20ab85a4a6b2870582ab30821ac1f6eae2daa2fc940fb728ef1a202a83aa"},{"@graph":[{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data från flygmätningar har samlats in sedan 1968. Flyghöjd över marken, mätlinjeseparation och navigeringssystem har modifierats med tiden. Likaså har sensorer uppdaterats med förbättrad känslighet och upplösning.\n\nNaI-detektorer med kristallvolymer från 6 till 16 liter har använts i samtliga mätningar. Kalibrering av SGUs system görs på plattor med kända koncentrationer av K, U och Th på Dala Airport, samt med flygningar på olika höjder över hav för korrektion av bakgrund och kosmisk strålning.\nMätpunktsavståndet är 16 till cirka 60 meter, beroende på vilket mätsystem som använts. Mätlinjeavståndet är normalt 200 meter över land och 400 till 1000 meter över hav och i fjällområden. Till och med år 1994 var den nominella flyghöjden 30 meter, från och med 1995 är den 60 meter.\n\nMätdata har interpolerats till en ytbild med 200 x 200 m cellstorlek. I områden med 200 m linjeseparation har data interpolerats med metoden inverse distance. I områden med linjeseparation större än 200 m har ett tre mätpunkters lågpassfilter längs mätlinjen applicerats innan interpolation med minimum curvature. Samtliga mätdata i databasen med detaljerade data har använts i interpolationen, vilket gör att kvaliteten i interpolerade data kan vara lägre i områden där både äldre och nyare mätningar finns.\n\nVärdena i en punkt representerar ett beräknat medelvärde över ett flertal mätpunkter som representerar förhållandena över en större yta på marken. För uran och torium har radiometrisk jämvikt förutsatts i sönderfallskedjan. \nDessa data bör endast användas för regionala studier av gammastrålningens fördelning."}},{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1968"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/891427b8-a46a-408c-a62f-18ea489953a5","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:5161eb52-34ed-eeef-a247-d8ae28001457"},{"@id":"urn:uuid:76a8250f-3649-0fb1-9505-8db8090d8a80"},{"@id":"urn:uuid:7c1a0d9e-f2f9-2d31-80cc-051a44cea2a8"},{"@id":"urn:uuid:b62ea1e1-2b96-bb20-8a7b-423e548bbc8b"},{"@id":"urn:uuid:c741608d-5293-3ded-2d44-b4ab740995bf"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Gammastrålning är en del av människans naturliga miljö. Delar av strålningen kommer från marken under oss, det vill säga från berggrunden och jordarterna.\n\nGeofysiska flygmätningar, gammastrålning (översiktlig) innehåller interpolerade värden från den mer detaljerade mätningen av gammastrålning, som också finns att tillgå, i ett jämnt 200 x 200 m grid. Denna grid bör endast användas för regionala studier av gammastrålningens fördelning. \nInformationen avser halter av de naturligt förekommande radioaktiva isotoperna K-40 (kalium), U-238 (uran) och Th-232 (torium), i markens översta delar. Halterna är beräknade ur mätningar gjorda från flygplan på låg höjd.\n\nVärdena i en punkt representerar ett beräknat medelvärde över ett flertal mätpunkter som representerar förhållandena över en större yta på marken. För uran och torium har radiometrisk jämvikt förutsatts i sönderfallskedjan."},{"@language":"sv","@value":"Gammastrålningsinformation, dvs. information om joniserande strålning ifrån marken, används framför allt vid berggrundsgeologiska undersökningar, som underlag vid radonundersökningar och i arbetet för en säker strålmiljö. Med hjälp av gammastrålningsmätningar kan markens halt av de naturligt förekommande radioaktiva isotoperna av kalium, uran och torium beräknas. För mätningar gjorda 1986 och därefter kan, p.g.a Tjernobylolyckan, även cesiumbeläggningen beräknas. Mätningarnas ursprungliga ändamål var att kartlägga Sveriges urantillgångar. Andra användare än SGU och Strålsäkerhetsmyndigheten är konsulter i geo- och radonbranschen, prospektörer samt kommuner och länsstyrelser."}],"dct:identifier":"891427b8-a46a-408c-a62f-18ea489953a5","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b1n0"},"dct:temporal":{"@id":"_:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, gammastrålning (översiktlig)"}},{"@id":"urn:uuid:5161eb52-34ed-eeef-a247-d8ae28001457","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/index.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:76a8250f-3649-0fb1-9505-8db8090d8a80","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/om-sgu/verksamhet/kartlaggning/geofysik_att_se_ner_i_berget/flyggeofysisk-matning/"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sveriges geologiska undersökning"}},{"@id":"urn:uuid:7c1a0d9e-f2f9-2d31-80cc-051a44cea2a8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-gammastralning-oversiktlig/geofysik-flyg-gammastralning-oversiktlig.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:b62ea1e1-2b96-bb20-8a7b-423e548bbc8b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-gammastralning-oversiktlig-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:c741608d-5293-3ded-2d44-b4ab740995bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/index.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:3d71c3f344b6bd69550b3a3d0d353f8d08143c5c21f4204e99373bfd95d8fe07"},{"@graph":[{"@id":"_:3d758fdab14c19f0e293bde71c8b07e27a994eebcf9222cf364601dfe92111d8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkomsthistorik"}},{"@id":"_:3d758fdab14c19f0e293bde71c8b07e27a994eebcf9222cf364601dfe92111d8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/8dc84872-9704-43ad-a082-1fe28ccfae5b","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:61e2157e-88f2-9355-9f72-3e7e99c08210"},{"@id":"urn:uuid:71240eb5-b6ad-b653-6ad5-74f427cd605e"},{"@id":"urn:uuid:9315b1e6-14df-017b-986e-50445bd5fad1"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Datasetet visar det geografiska läget för enskilda och statliga byggnadsminnen och kyrkor som är registrerade i Bebyggelseregistret. Datasetet ingår i INSPIRE-direktivets tema byggnader."},"dct:identifier":"8dc84872-9704-43ad-a082-1fe28ccfae5b","dct:issued":{"@type":"xsd:date","@value":"2020-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-15"},"dct:provenance":{"@id":"_:3d758fdab14c19f0e293bde71c8b07e27a994eebcf9222cf364601dfe92111d8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":{"@id":"_:3d758fdab14c19f0e293bde71c8b07e27a994eebcf9222cf364601dfe92111d8_b1n0"},"dct:title":{"@language":"sv","@value":"INSPIRE Byggnader - byggnadsminnen och kyrkliga kulturminnen"}},{"@id":"urn:uuid:61e2157e-88f2-9355-9f72-3e7e99c08210","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/geoserver/Byggnader/ows?request=getcapabilities&service=wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Visningstjänst"},"dct:title":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Visningstjänst"}},{"@id":"urn:uuid:71240eb5-b6ad-b653-6ad5-74f427cd605e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/files/gml/BU.Buildings.gml"},"dct:description":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Nedladdningstjänst direkt nedladdning GML"},"dct:title":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Nedladdningstjänst direkt nedladdning GML"}},{"@id":"urn:uuid:9315b1e6-14df-017b-986e-50445bd5fad1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire-raa.metria.se/raafeed/BU.Buildings-topfeed.xml"},"dct:description":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Nedladdningstjänst ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Byggnader, Byggnadsminnen och kyrkor INSPIRE Nedladdningstjänst ATOM"}}],"@id":"urn:source:3d758fdab14c19f0e293bde71c8b07e27a994eebcf9222cf364601dfe92111d8"},{"@graph":[{"@id":"_:3d7980e3f72aa885f43794668e8f71f1e9634df4dec40f35549e1a700fbfa844_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:3d7980e3f72aa885f43794668e8f71f1e9634df4dec40f35549e1a700fbfa844_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/9b81eaf3-8f1f-43a2-b997-54266b834381","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Skogsskbestgr.xml"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"ATOM-flöde för nedladdning (ZIP) av gräns för skogsskyddsbestämmelser upprättad av Skogsstyrelsen"},"dct:identifier":"9b81eaf3-8f1f-43a2-b997-54266b834381","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"BR.Gräns för skogsskyddsbestämmelser upprättad av Skogsstyrelsen.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3d7980e3f72aa885f43794668e8f71f1e9634df4dec40f35549e1a700fbfa844_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:3d7980e3f72aa885f43794668e8f71f1e9634df4dec40f35549e1a700fbfa844_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:3d7980e3f72aa885f43794668e8f71f1e9634df4dec40f35549e1a700fbfa844"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a04f1eed-c907-4a93-904d-cbdb3f39d9d4","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/sur-sulfatjord"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten ”Sur sulfatjord” visar var det kan finnas sura sulfatjordar längs Västernorrlands, Västerbottens och Norrbottens kust. Informationen kan användas för att identifiera områden där det är viktigt att undvika markanvändning som kan leda till negativ påverkan från sur sulfatjord eller där det är lämpligt att vidta åtgärder för att minska miljöbelastning från jordarna.\n\n”Sur sulfatjord” består av en yttäckande modellering och insamlade punktobservationer av sur sulfatjord. Den modellerade kartan visar den sannolika utbredningen av sur sulfatjord. Punktobservationerna kommer från kartering och provtagning av sur sulfatjord som utförts inom olika projekt på SGU. Klasserna i den yttäckande modellen är ”Ej sur sulfatjord”, ”Aktiv sur sulfatjord på potentiell sur sulfatjord” och ”Potentiell sur sulfatjord”."},"dct:identifier":"a04f1eed-c907-4a93-904d-cbdb3f39d9d4","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Sur sulfatjord (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:3dbabaf904b7072ecf4328a63bd030fcb4c0ebcf5facdb7f08378f386353f4c4"},{"@graph":[{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Trädkartering baserat på laserdata från Nationella Höjdmodellen, se vidare i leveransbeskrivning."}},{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.89919 57.58009,13.63797 57.58009,13.63797 56.33844,11.89919 56.33844,11.89919 57.58009))"}},{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/337e6b36-93b7-4da0-829e-7b3d2cc966b8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9d869934-6c32-8bcb-58ad-62a29ea45794"},"dcat:distribution":{"@id":"urn:uuid:6ddfd5fd-45ef-a25c-89f6-97388880e625"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Kartering av potentiella alléträd över fem meter höga längs vägnätet ”Vägtrafiknätet” från Trafikverket inom öppen mark och tätort. Övriga villkor som satts upp är:\n• Träd i allé ska ligga inom 15 m från vägmitt \n• Det får vara max 20m mellan träden\n• Minst 5 träd i rad/samling enligt ovanstående villkor\nKartläggningen har gjorts av Geografiska Informationsbyrån. Underlag för kartläggningen är Skogsstyrelsens rasterskikt som baseras på laserdata från den nationella höjdmodellen. Se vidare i leveransbeskrivning."},"dct:identifier":"337e6b36-93b7-4da0-829e-7b3d2cc966b8","dct:issued":{"@type":"xsd:date","@value":"2017-09-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-11-24"},"dct:provenance":{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Trädkartering laser 2017 (GI) - träd i alléer"}},{"@id":"urn:uuid:6ddfd5fd-45ef-a25c-89f6-97388880e625","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_GI_Tradkartering_alle.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:9d869934-6c32-8bcb-58ad-62a29ea45794","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Enheten för naturvård och miljöövervakning","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Enheten för naturvård och miljöövervakning"}],"@id":"urn:source:3e788d322ea0707b589cb3ff2bac745da4dd16f981ed3ce8c393003848e277ce"},{"@graph":[{"@id":"_:3e874d817196f795157c8d81ad03a01cd352f7a72aa33ec28a716035331b6cba_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://gis.sgi.se/nks"}},{"@id":"_:3e874d817196f795157c8d81ad03a01cd352f7a72aa33ec28a716035331b6cba_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.039851888106 69.064001823926,25.958243331996 69.064001823926,25.958243331996 54.802444805481,11.039851888106 54.802444805481,11.039851888106 69.064001823926))"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/1137a32f-b4cc-43ad-b9d7-f60ebce5c61e","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:55bf6787-92da-4a1f-468c-42f45930dd96"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Geografisk översikt över de klimatrelaterade utredningar SGI utfört själva eller i samarbete med andra. Exempel på utredningar är regionala och länsvisa klimat- och sårbarhetsanalyser på uppdrag av länsstyrelser och kommuner. Som en del i MSB:s översiktliga stabilitetskartering så har SGI också gjort ett antal förstudier och huvudstudier för finkornig respektive grovkornig jord. (Se även MSB:s hemsida för fler, av andra utförda översiktliga stabilitetskarteringar). SGI har även utfört ett antal andra risk- och klimatrelaterade studier för olika geografiska områden i landet. \n \nSyftet med tittskåpet är att geografiskt åskådliggöra i vilka län och kommuner som utredningarna finns genomförda av SGI. Målgruppen för tittskåpet är handläggare vid kommuner, länsstyrelser och myndigheter, men även andra intressenter som konsulter, markägare och forskare. Tittskåpet länkar direkt till skriftliga rapporter i PDF-format. GIS-data finns i vissa fall tillgängliga via den s.k. Geodataportalen. [Geoteknik][Klimatanpassning]"},"dct:identifier":"1137a32f-b4cc-43ad-b9d7-f60ebce5c61e","dct:issued":{"@type":"xsd:date","@value":"2012-12-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:3e874d817196f795157c8d81ad03a01cd352f7a72aa33ec28a716035331b6cba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:3e874d817196f795157c8d81ad03a01cd352f7a72aa33ec28a716035331b6cba_b1n0"},"dct:title":{"@language":"sv","@value":"Rapporter om stabilitetsförhållanden, naturolyckor, hållbarhet och klimat"}},{"@id":"urn:uuid:55bf6787-92da-4a1f-468c-42f45930dd96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/nks"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Rapporter om stabilitetsförhållanden, naturolyckor, hållbarhet och klimat"}}],"@id":"urn:source:3e874d817196f795157c8d81ad03a01cd352f7a72aa33ec28a716035331b6cba"},{"@graph":[{"@id":"_:3f473284b263700485769db997bdbafca8fc676b41d825238c63e87390ee1ecf_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021000555","@type":"foaf:Agent","dct:identifier":"2021000555","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sherko.alemdar@socialstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Socialstyrelsen"},"foaf:page":{"@id":"https://www.socialstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ngs.ehalsomyndigheten.se/organisation/SE2021000555"}},{"@id":"https://www.geodata.se/resources/f553f428-c4c9-42cd-a167-4b31680b5034","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:6055d4dd-cc2c-ba8c-9809-882467b2c00a"},"dcat:endpointURL":{"@id":"https://geodata.socialstyrelsen.se/cgi/mapserv.exe?map=/ms4w/maps/sos-ska-wfs.map&service=wfs&request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Socialstyrelsens statistikdatabas skador och förgiftningar, antal vårdade patienter i sluten eller öppen specialiserad vård med vissa miljörelaterade skador som\nX40-X49 Förgiftningsolyckor\nunder åren 2018-2020 per 100 000 invånare"},"dct:identifier":"f553f428-c4c9-42cd-a167-4b31680b5034","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000555"},"dct:title":{"@language":"sv","@value":"Skador och förgiftningar nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:6055d4dd-cc2c-ba8c-9809-882467b2c00a","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Ämnesansvarig skador","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3f473284b263700485769db997bdbafca8fc676b41d825238c63e87390ee1ecf_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:inspire@socialstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Socialstyrelsen"}],"@id":"urn:source:3f473284b263700485769db997bdbafca8fc676b41d825238c63e87390ee1ecf"},{"@graph":[{"@id":"_:3f7c9cdde845d3da61cf77db48b6f6a51e58e2bd6bb35d62d0d77720a2894ead_b0n0","@type":"dct:Location","http://www.w3.org/ns/