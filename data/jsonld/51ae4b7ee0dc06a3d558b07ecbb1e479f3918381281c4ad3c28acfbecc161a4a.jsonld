flyg - Bevakningsslingor"}},{"@id":"urn:uuid:35b2a79f-b199-e407-f7ab-4e6ffb6f4d2d","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Skogsbrandflyg_EXT/MapServer/1"},"dct:description":{"@language":"sv","@value":"MapServer REST länk"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST API"}},{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällskydd och beredskap","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73f0f795fa_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo.samhallsskydd.och.beredskap@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällskydd och beredskap"},{"@id":"urn:uuid:fbee319c-4482-bf17-801b-418ee91cf930","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Skogsbrandflyg_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST Skogsbrandflyg - bevakningsslingor"},"dct:title":{"@language":"sv","@value":"3"}}],"@id":"urn:source:f3c3a9342929f630ff2ed37bcf2cece7a9dc120730d1ce24e28c4a73f0f795fa"},{"@graph":[{"@id":"_:f3c5f98277b8e25820b1ce6c5efd84f99b219bfd59414354018a4d30528a04fa_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Huvudavrinningsområden visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f3c5f98277b8e25820b1ce6c5efd84f99b219bfd59414354018a4d30528a04fa_b0n0"},"dct:title":{"@language":"sv","@value":"Huvudavrinningsområden visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/87942412-ca64-4161-8c0c-675b0ca3421b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Denna produkt består av polygoner som representerar de huvudavrinningsområden som mynnar i Sverige. Ett huvudavrinningsområdes ursprungliga definition bestod av områden som har sin mynning i havet och uppmäter en areal av minst 200 km2;. Det nya underlaget uppfyller inte alltid storlekskriteriet men eftersom att indelningen av huvudavrinningsområden är allmänt vedertagen så har den bibehållits, fast med uppdaterade gränser.\n\nProdukten huvudavrinningsområden som baserar sig på version SVAR 2022:1.2, innehåller polygoner som representerar de svenska huvudavrinningsområdena."},"dct:identifier":"87942412-ca64-4161-8c0c-675b0ca3421b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.HY Huvudavrinningsområden (SVAR2022): Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:f3c5f98277b8e25820b1ce6c5efd84f99b219bfd59414354018a4d30528a04fa"},{"@graph":[{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Områden som avverkats enligt skillnadsanalys i satellitbilder."}},{"@id":"_:f4937cea79d1b47afe19e93f3c44d2a477a28236e433ffd4a56a0e17b8fab4ef_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"ht