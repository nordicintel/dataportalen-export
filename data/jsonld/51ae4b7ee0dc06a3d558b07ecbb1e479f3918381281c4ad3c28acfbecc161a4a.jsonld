gu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/b4286c38-3af8-4aad-95d5-11300b454b1a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/miljoovervakning_sediment"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Sedimenten i ackumulationsområden utgör en sänka för många grundämnen och miljögifter. Analys av sedimentprover har därför blivit ett betydelsefullt verktyg i miljöövervakningsarbetet. Datavärdskap är ett system som inrättats av Naturvårdsverket för att öka tillgänglighet och leverans av olika typer av miljöövervakningsdata, bl.a. sediment.\n\nI Miljöövervakning marina sediment - WMS visas endast information om provtagningsstationer och platser inom ramen för nationell-, regional- och lokal miljöövervakning av sediment samt dumpningsplatser. För nedladdning av tidsseriedata och statistisk information hänvisas till SGUs kartvisarapplikation (online-källa)."},"dct:identifier":"b4286c38-3af8-4aad-95d5-11300b454b1a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Miljöövervakning, havs- och sjösediment (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:ca7f3de5f1b08c4e6bd9c88dd9b2e4916145081e5ec1fa045cf72459eaaaadd4"},{"@graph":[{"@id":"_:caed9d60c0b79f84410f4ddd62f877b5500f5bd5531b0943bedbdb500530a368_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGO