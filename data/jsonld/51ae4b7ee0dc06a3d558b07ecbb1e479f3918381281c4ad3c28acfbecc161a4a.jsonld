contactPoint":{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7"},"dcat:distribution":[{"@id":"urn:uuid:a4c2d79d-d396-342c-7485-da7d2b5f244d"},{"@id":"urn:uuid:c125e212-ef04-80d7-e109-9355914052ea"},{"@id":"urn:uuid:d47ae7c9-6958-3c30-d9da-767bb4d5e656"},{"@id":"urn:uuid:e94ffc26-2615-e069-2edc-9cefc5e87185"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Nationellt särskilt Värdefulla vattendrag och sjöar utpekade av kulturmiljöenheten. En klassning över värdefulla vattendrag i Jönköpings län. Används i miljömålsarbetet. Klassningen gäller värdefulla kulturmiljöer där dessa ligger vid, i eller nära vattendrag. I regel där riksintressena skär vattendrag, bruksmiljöer etc. Riksantikvarieämbetet/Naturvårdsverket ansvar övergripande för de nationella skikten. Miljöbalken reglerar skydd av utpekade områden, mark- och vattenområden i övrigt."},"dct:identifier":"da88f22e-4079-49eb-ba51-05cd34493b62","dct:issued":{"@type":"xsd:date","@value":"2005-03-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:50cd44d450a6ebe63fa64ef85a1947b584c4c7db83494b4c50870873a0577530_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Värdefulla vatten Kulturmiljöer"}},{"@id":"urn:uuid:a4c2d79d-d396-342c-7485-da7d2b5f244d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.kultur_VardefullaVattenKultur.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c125e212-ef04-80d7-e109-9355914052ea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_vardefulla_vatten_EXT/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Kulturmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:50cd44d450a6ebe63fa64ef85a1947b584c4c7db83494b4c50870873a0577530_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Kulturmiljöenheten"},{"@id":"urn:uuid:d47ae7c9-6958-3c30-d9da-767bb4d5e656","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_3/MapServer/15"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:e94ffc26-2615-e069-2edc-9cefc5e87185","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_3/MapServer/WMSServer?layers=lstf_vardefulla_vatten_i_jonkopings_lan_kulturmiljoer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"lstf_vardefulla_vatten_i_jonkopings_lan_kulturmiljoer (WMS)"}}],"@id":"urn:source:50cd44d450a6ebe63fa64ef85a1947b584c4c7db83494b4c50870873a0577530"},{"@graph":[{"@id":"_:514432c5d328f8ae62b5af0bb960e7b4eb57e88088df62b8c6543573e84a911d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Innehållet i Karta 1:50 000, raster bygger på Karta 1:50 000 Nedladdning, vektor som framställs genom automatisk generalisering av den grunddatamängd som ingår i Topografi 10 Nedladdning, vektor. Den automatiska generaliseringsprocessen (AG-processen) består av en mängd GIS-operationer som stegvis bearbetar data till att passa för presentation i en översiktlig kartskala. Innehållet struktureras om till viss del, vissa kartobjekt slås samman eller tas bort och ibland överdrivs de i storlek eller flyttas från varandra."}},{"@id":"_:514432c5d328f8ae62b5af0bb960e7b4eb57e88088df62b8c6543573e84a911d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/da076f04-278e-41b6-85b2-ff67b3e0a719","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:27bd16c9-8a3c-1fc9-a414-ffadbf4c8883"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Produkten är en rasterkarta i form av en digital bild och innehåller bland annat byggnader, markslag och vägar. Den är framtagen för att i första hand användas för utskrift."},"dct:identifier":"da076f04-278e-41b6-85b2-ff67b3e0a719","dct:issued":{"@type":"xsd:date","@value":"2018-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:514432c5d328f8ae62b5af0bb960e7b4eb57e88088df62b8c6543573e84a911d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:514432c5d328f8ae62b5af0bb960e7b4eb57e88088df62b8c6543573e84a911d_b1n0"},"dct:title":{"@language":"sv","@value":"Karta 1:50 000 Nedladdning, raster"}},{"@id":"urn:uuid:27bd16c9-8a3c-1fc9-a414-ffadbf4c8883","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/karta-1-10-000-nedladdning-raster"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Karta 1:50 000, raster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Karta 1:50 000, raster"}}],"@id":"urn:source:514432c5d328f8ae62b5af0bb960e7b4eb57e88088df62b8c6543573e84a911d"},{"@graph":[{"@id":"_:51560d43506cb269cf40ad8ca1630fc9b3a51e1bf52ae3fad9b0575257734b1f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För CLC2012 har i huvudsak bilder registrerade av SPOT 4 och 5 från åren 2011-2012 använts och visuellt jämförts med de bilder som användes vid produktionen av CLC 2006 för att identifiera de förändringar som skett mellan referensåren 2006 och 2012.\nFör CLC2018 har bilder från Sentinel 2, registrerade under 2017, använts och jämförts med de bilder som användes vid produktionen av CLC2012."}},{"@id":"_:51560d43506cb269cf40ad8ca1630fc9b3a51e1bf52ae3fad9b0575257734b1f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/ef14f285-bb11-4d9b-bfc1-4e99ebebc415","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:87f62d42-33c7-6bce-3938-bc68ad83ca4f"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"I Corine Land Cover redovisas för Sverige vegetation och markslag i 35 olika klasser samt de  Klassificeringen är treställig med följande huvudklasser:\n•\tAnlagda ytor\n•\tJordbruksmark\n•\tSkog\n•\tVåtmarker\n•\tVatten\n\nCLC 2018 utgörs av följande tre skikt:\n• CLC 2012 – En reviderad version av 2012 års uppdatering. Minsta redovisningsenhet är 25 hektar.\n• CHA 2018 – De förändringar som detekterats vid jämförelser mellan satellitbilder från basåret 2012 och bilder från basåret 2018. Minsta redovisningsenhet är 5 hektar i detta skikt.\n• CLC 2018 – En sammanslagning av den reviderade CLC 2012-basen och förändringsskiktet CHA 2018. Ytorna är generaliserade till en minimistorlek om 25 hektar.\n\nCLC 2012 utgörs av följande tre skikt:\n• CLC 2006 – En reviderad version av 2006 års uppdatering. Minsta redovisningsenhet är 25 hektar.\n• CHA 2012 – De förändringar som detekterats vid jämförelser mellan satellitbilder från basåret 2006 och bilder från basåret 2012. Minsta redovisningsenhet är 5 hektar i detta skikt.\n• CLC 2012 – En sammanslagning av den reviderade CLC 2006-basen och förändringsskiktet CHA 2012. Ytorna är generaliserade till en minimistorlek om 25 hektar."},"dct:identifier":"ef14f285-bb11-4d9b-bfc1-4e99ebebc415","dct:issued":{"@type":"xsd:date","@value":"2015-11-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-11-03"},"dct:provenance":{"@id":"_:51560d43506cb269cf40ad8ca1630fc9b3a51e1bf52ae3fad9b0575257734b1f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:51560d43506cb269cf40ad8ca1630fc9b3a51e1bf52ae3fad9b0575257734b1f_b1n0"},"dct:title":{"@language":"sv","@value":"Corine Land Cover"}},{"@id":"urn:uuid:87f62d42-33c7-6bce-3938-bc68ad83ca4f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/Om-Lantmateriet/Samverkan-med-andra/internationell-samverkan/corine-land-cover/"},"dct:description":{"@language":"sv","@value":"Mer information om produkten finns att tillgå på http://www.lantmateriet.se/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets hemsida"}}],"@id":"urn:source:51560d43506cb269cf40ad8ca1630fc9b3a51e1bf52ae3fad9b0575257734b1f"},{"@graph":[{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ägarna skickar in koordinatuppgift"}},{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/ca484649-0ec8-4149-94cf-3a8cce587762","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:879c67a7-e01c-ad4a-a751-8910f0190563"},{"@id":"urn:uuid:906bd7f4-8381-08cf-3381-eadd42472fe4"},{"@id":"urn:uuid:daffd8b7-36db-caaa-c5ab-17db25c76062"},{"@id":"urn:uuid:e73ee7a5-5440-4799-48a6-7ae15e0b14b2"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Vattenbruksanläggningar\nEnligt vattenbruksdirektivet (rådets direktiv 2006/88/EG om djurhälsokrav för djur och produkter från vattenbruk och om förebyggande och bekämpning av vissa sjukdomar hos vattenlevande djur) ska Sverige hålla ett register med uppgifter om varje vattenbruksföretag och deras anläggningar. Vattenbruksanläggningarnas geografiska läge ska anges med koordinater. \nVattenbruk, dvs. odling av fisk, skaldjur och alger, är en växande näring med stor potential i Sverige. Vattenbruket producerar god och miljömässigt bra mat men också miljötjänster såsom upptag av näring genom musselodling.\nIdag odlas fisk främst i kassar i öppet vatten men även i viss utsträckning i slutna system eller dammar på land. Musslor och ostron odlas främst på rep eller i korgar i öppet vatten längs västkusten. Viss odling av kräftor sker också i dammar på land.\nSyftet med registret över vattenbruksanläggningarna är bland annat att göra det möjligt att förstå smittspridningen genom att följa djur vid förflyttning mellan olika platser vid utbrott av smittsamma sjukdomar."},"dct:identifier":"ca484649-0ec8-4149-94cf-3a8cce587762","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b1n0"},"dct:title":{"@language":"sv","@value":"Vattenbruksanläggningar"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"},{"@id":"urn:uuid:879c67a7-e01c-ad4a-a751-8910f0190563","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/vattenbruksanlaggningar/atom-datasetfeed-vattenbruksanlaggningar.xml"},"dct:description":{"@language":"sv","@value":"Atom dataset feed för datamängden Vattenbruksanläggningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom dataset feed för datamängden Vattenbruksanläggningar"}},{"@id":"urn:uuid:906bd7f4-8381-08cf-3381-eadd42472fe4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/vattenbruksanlaggningar/20250326/vattenbruksanlaggningar.gml.zip"},"dct:description":{"@language":"sv","@value":"Rikstäckande GML-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}},{"@id":"urn:uuid:daffd8b7-36db-caaa-c5ab-17db25c76062","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layers=inspire:vattenbruksanlaggningar"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WMS-tjänst"}},{"@id":"urn:uuid:e73ee7a5-5440-4799-48a6-7ae15e0b14b2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&layers=inspire:vattenbruksanlaggningar"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets WFS-tjänst"}}],"@id":"urn:source:52244bf82e8259ce059c8ff019e75d23378400b9447a10ba3d285673a7847790"},{"@graph":[{"@id":"_:527eb7f733b76d8fdbcf2364b2d55a83ec2d3266ef873251b0aa1982f390f0c2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"The data began to be collected in the 1930s through the interpretation of aerial images in stereo and reconnaissance in the field. Nowadays photogrammetric techniques with aerial imagery are used for updating, for example stereo mapping and screen digitization of digital orthophoto.\n\nData började samlas in på 1930-talet genom tolkning av flygbilder i stereo och rekognosering i fält. Numera nyttjas helt fotogrammetriska metoder med flygbilder för ajourhållning t.ex. stereokartering och skärmbildsdigitalisering på digitalt ortofoto."}},{"@id":"_:527eb7f733b76d8fdbcf2364b2d55a83ec2d3266ef873251b0aa1982f390f0c2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3542ba2c-db3e-409b-b357-723864763373","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1f9f7482-1759-db1a-ba2f-22a0f770d9fb"},{"@id":"urn:uuid:2085a5e3-19a1-ff0e-dd76-840daa0d187e"},{"@id":"urn:uuid:982e408f-6dd5-3109-a9a1-90dfb4ac032b"},{"@id":"urn:uuid:f14b8117-1f6a-6605-a0df-aa8f9f879aed"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Data om marktäcke anpassat för skalområdet 1:10 000. Marktäcket inkluderar information om skog, åker, öppen mark och bebyggelseområde.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Marktäcke nedladdning Inspire och Basemap Visning Inspire\n\nDataset for Land cover in scale 1:10 000. The Land cover includes information about forest, arable land, open land and built-up areas.\nThe dataset can’t be ordered separately. It is only included in existing services: Land cover download Inspire and Basemap. Download Inspire"},"dct:identifier":"3542ba2c-db3e-409b-b357-723864763373","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:527eb7f733b76d8fdbcf2364b2d55a83ec2d3266ef873251b0aa1982f390f0c2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:527eb7f733b76d8fdbcf2364b2d55a83ec2d3266ef873251b0aa1982f390f0c2_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för marktäcke Inspire"}},{"@id":"urn:uuid:1f9f7482-1759-db1a-ba2f-22a0f770d9fb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/marktacke-nedladdning-vektor-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Marktäcke Nedladdning Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktsida för Marktäcke Nedladdning Inspire."}},{"@id":"urn:uuid:2085a5e3-19a1-ff0e-dd76-840daa0d187e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/marktacke/atom/v1.1/inspire/lc"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Marktäcke Nedladdning Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Marktäcke Nedladdning Inspire"}},{"@id":"urn:uuid:982e408f-6dd5-3109-a9a1-90dfb4ac032b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/basemap/wms/v1?service=WMS&request=GetCapabilities&version=1.3.0"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för tjänsten Basemap Visning Inspire (öppen capabilityfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Basemap Visning Inspire"}},{"@id":"urn:uuid:f14b8117-1f6a-6605-a0df-aa8f9f879aed","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/basemap-visning-inspire-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Basemap Visning Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktsida för Basemap Visning Inspire."}}],"@id":"urn:source:527eb7f733b76d8fdbcf2364b2d55a83ec2d3266ef873251b0aa1982f390f0c2"},{"@graph":[{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"koordinaterna för anläggningarna avser laboratoriernas  läge. Ingående personer bor i hela regionen kring laboratoriet."}},{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2100"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1959"}},{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"171 16","http://www.w3.org/2006/vcard/ns#street-address":"Solna Strandväg 96"},{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687994000"}},{"@id":"http://dataportal.se/organisation/SE2021005737","@type":"foaf:Agent","dct:identifier":"2021005737","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@ssm.se"},"foaf:name":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten"},"foaf:page":{"@id":"https://www.stralsakerhetsmyndigheten.se"}},{"@id":"https://www.geodata.se/resources/b5d23610-d572-42d5-98bf-b916808febe1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859"},"dcat:distribution":{"@id":"urn:uuid:52ef7773-07c8-83a6-9661-6c07be946234"},"dcat:keyword":{"@language":"sv","@value":"Anläggningar för miljöövervakning"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Strålsäkerhetsmyndigheten har genomfört helkroppsmätningar avseende främst cesium-137 i olika referensgrupper av Sveriges befolkning sedan slutet av 1950-talet. I nuvarande program mäts referensgrupper i Stockholm och Umeå årligen, medan grupper av renägande samer och jägare i Gävletrakten mäts ungefär vart femte år. Data från dessa mätningar kan göras tillgängliga på begäran från Strålsäkerhetsmyndigheten. Kartan visar mätplatsernas geografiska läge, de personer som ingår i referensgrupperna bor i omgivande region."},"dct:identifier":"b5d23610-d572-42d5-98bf-b916808febe1","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-05-30"},"dct:provenance":{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005737"},"dct:spatial":{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b1n0"},"dct:temporal":{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning av joniserande strålning: helkroppsmätning av radioaktiva ämnen i människa"}},{"@id":"urn:uuid:52ef7773-07c8-83a6-9661-6c07be946234","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"websida med information om miljöövervakning vid strålsäkerhetsmyndigheten samt möjlighet att visa och ladda ned data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens websida om miljöövervakning"}},{"@id":"urn:uuid:9532703b-af16-a597-6554-bdfe032b9859","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Strålsäkerhetsmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@ssm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Strålsäkerhetsmyndigheten"}],"@id":"urn:source:537ce9a7f13210d9c3e410c503ef535a4f4c1238d670c1964c15b5792549194b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/29a1d782-41f3-4799-8bc8-c7bd9ff90f14","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tätorter är koncentrerad bebyggelse med minst 200 invånare. SCB tar fram gränser för tätorter med hjälp av registerdata, till exempel SCB:s register över totalbefolkningen (RTB), SCB:s företagsregister samt Lantmäteriets fastighetskarta och koordinatsatta byggnadsregister. Öppna geodata visas som polygoner och fram till 2015 har tätorter uppdaterats vart femte år. Sedan 2016 uppdateras de vart tredje eller vart annat år."},"dct:identifier":"29a1d782-41f3-4799-8bc8-c7bd9ff90f14","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"Tätorter WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:539bfddb14b2ac6333586e7aa1dc6d59d2cd13bfcda5addefc127d7d8be01e29"},{"@graph":[{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ytor från LM Fastighetskartan vektor med vissa justeringar"}},{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.29851 59.38498,14.11207 59.38498,14.11207 58.37512,12.29851 58.37512,12.29851 59.38498))"}},{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/62c2a72d-895f-4a70-b1b5-1efba1fa0285","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3a7df11c-b439-e261-1d62-206b100e777c"},"dcat:distribution":{"@id":"urn:uuid:b3cfbafe-06ad-1502-804d-a2e60a516e6a"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Fågelskär som årligen inventeras i Vänern"},"dct:identifier":"62c2a72d-895f-4a70-b1b5-1efba1fa0285","dct:issued":{"@type":"xsd:date","@value":"2014-06-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-02"},"dct:provenance":{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b1n0"},"dct:title":{"@language":"sv","@value":"LstS Fågelskärsinventering i Vänern - fågelskär"}},{"@id":"urn:uuid:3a7df11c-b439-e261-1d62-206b100e777c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Naturvårdsenheten"},{"@id":"urn:uuid:b3cfbafe-06ad-1502-804d-a2e60a516e6a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.LstS_fagelskarsinv_vanern_fagelskar.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:53c2ffdd22c8fddb65d340a88ce086730cd905a5b7010f4231a5f385a75a1caa"},{"@graph":[{"@id":"_:53f180433fe10fa9b17614eeda37d1f2b385dcbbb34de82a43244644bac4c5e1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tolkningen baseras på punktvisa observationer och provtagningar som med hjälp av andra informationsslag såsom berggrundsinformation, geofysiska mätningar och topografiska data sammanställts till en heltäckande karta. \nSamtliga vanligt förekommande bergarter ingår bland de bergarter som provtas. Eftersom bergmaterials ballastegenskaper varierar beroende på deras kornstorlek, mineralogi och omvandlingsgrad har urvalet för provtagningen gjorts så att även dessa variationer har fångats upp, till exempel genom provtagning i både fin- och grovkorniga bergartsled där sådana förekommer.\nUtvalda berggrundshällar har besökts för dokumentation och provtagning. Berggrunden på provtagningsplatsen har beskrivits med avseende på dess mineralogi, strukturer och texturer m.m. Analyser av Los Angelesvärde (LA), kulkvarnsvärde (AN), microDeval-värde (MDE), korndensitet (ρ), tunnslip, plastisk viskositet, flytgränsspänningsvärde, alkalisilikareaktivitet (ASR) och petrofysiska parametrar har gjorts. Berggrundens strålning har mätts i fält med en spektrometer.\nEn klassning av analysmaterialet har gjorts på kravsatta och de mest kritiska egenskaperna, som är relevanta för respektive användningsområde (se vidare i till exempel Ballast för asfaltmassor och tankbeläggningar för vägar, flygfält och andra trafikerade ytor [SS-EN 13043], Ballast för betong [SS-EN 12620] och Makadamballast för järnväg [SS-EN 13450]).\nBergkvalitetskartering har i första hand utförts i Sveriges tätortsregioner såsom Stockholm, Mälardalen, Avesta, Falun, Göteborg, Uddevalla, Stenungsund, Trollhättan, Borås, Varberg, Falkenberg, Linköping, Södertälje, Nyköping, Skåne, Uppsala, Gävle, Sundsvall, Umeå."}},{"@id":"_:53f180433fe10fa9b17614eeda37d1f2b385dcbbb34de82a43244644bac4c5e1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.768109209944 63.873698052138,21.125796919806 63.873698052138,21.125796919806 55.433793672023,11.768109209944 55.433793672023,11.768109209944 63.873698052138))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/34c84460-b35d-4ed7-8ed1-f4a58d3e3c70","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:3170a37d-ed9d-b0cd-5f34-411ecf8da2ba"},{"@id":"urn:uuid:4452480e-fdad-bdfe-00b0-250edac274cd"},{"@id":"urn:uuid:a1e145ee-5445-4a08-d212-ddd4430cb8ee"},{"@id":"urn:uuid:db3981ad-96c3-4b69-2131-da68bad23774"},{"@id":"urn:uuid:e99eaf7e-4adc-1f1a-4168-4115c28c696a"},{"@id":"urn:uuid:ecb0f34b-7897-b198-e8e2-92fe4b37b18f"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Bergkvalitet är en yttäckande produkt där berggrundsytor har delats in i olika bergkvalitetsklasser. Huvudsakligen har klassningen gjorts för vägändamål, men för vissa områden finns även klassning gjord för järnväg- och betongändamål. \nDet huvudsakliga ändamålet med klassningen är att underlätta en utvärdering av det bästa användningsområdet för olika bergarter, som till exempel ballast för väg, järnväg och betong. I samband med den kommunala översiktsplaneringen ska bergkvalitetskartan kunna erbjuda ett geologiskt underlag för framtida markanvändning och därmed till exempel underlätta övergången från grus- till krossbergsproduktion.\nBergkvalitetskartan är en tematisk karta som kompletterar SGU:s berggrundskartor i skala 1:50 000 och 1:250 000."},{"@language":"sv","@value":"Det huvudsakliga ändamålet med klassningen är att underlätta en utvärdering av det bästa användningsområdet för olika bergarter, som t.ex. ballast för väg, järnväg och betong. I samband med den kommunala översiktsplaneringen ska bergkvalitetskartan kunna erbjuda ett geologiskt underlag för framtida markanvändning och därmed t.ex. underlätta övergången från grus- till krossbergsproduktion."}],"dct:identifier":"34c84460-b35d-4ed7-8ed1-f4a58d3e3c70","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-26"},"dct:provenance":{"@id":"_:53f180433fe10fa9b17614eeda37d1f2b385dcbbb34de82a43244644bac4c5e1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:53f180433fe10fa9b17614eeda37d1f2b385dcbbb34de82a43244644bac4c5e1_b1n0"},"dct:title":{"@language":"sv","@value":"Bergkvalitet"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:3170a37d-ed9d-b0cd-5f34-411ecf8da2ba","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/bergkvalitet/bergkvalitet.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:4452480e-fdad-bdfe-00b0-250edac274cd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager. Bergkvalitetsinformation ingår bland annan information relaterad till ballast."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU Kartvisare Ballast"}},{"@id":"urn:uuid:a1e145ee-5445-4a08-d212-ddd4430cb8ee","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/bergkvalitet/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:db3981ad-96c3-4b69-2131-da68bad23774","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/bergkvalitet-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:e99eaf7e-4adc-1f1a-4168-4115c28c696a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/service/wms/130/ballast"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:ecb0f34b-7897-b198-e8e2-92fe4b37b18f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager. Bergkvalitetsinformation ingår bland annan information relaterad till ballast."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU Kartvisare Ballast"}}],"@id":"urn:source:53f180433fe10fa9b17614eeda37d1f2b385dcbbb34de82a43244644bac4c5e1"},{"@graph":[{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/08edb4a3-d485-4634-867c-f989befb6b56","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:6d03b8a0-29b2-5d2e-3c50-36667797b123"},{"@id":"urn:uuid:d3456421-3d78-bde8-d0f4-c07ca02c1e30"}],"dcat:keyword":{"@language":"sv","@value":"Administrativa enheter"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Gräns för ekonomisk zon följer den gräns som överenskommits med våra grannländer längs de sträckor där sjöterritoriets gräns i havet inte når ut till densamma. Det bildas på så vis fyra zoner; en i Bottenviken, Bottenhavet, egentliga östersjön och på Västkusten.\n\nFöljande attribut finns i punkt shape-filen:\nLöpnummer - Löpnummer för ekonomiska zonen (EZ).\nDelsträcka – Ekonomiska zonen redovisas med följande delsträckor; Västkusten, Östersjön, Bottenhavet, Bottenviken.\nLöpnr_dels - Löpnummer för punkter (EZ) för respektive delsträcka.\nLöpnr_EZ - Löpnummer för signifikanta punkter på den ekonomiska zonens yttre avgränsningslinje.\nLatitud & Longitud - Alla punkter utmed gränsen beskrivs med geografiska koordinater i latitud och longitud uttryckta i referenssystemet SWEREF 99 dels i grader och decimala minuter som det står i lagen och dels i decimala grader.\nPunkttyp - Följande punkttyper förekommer:\n• brytpunkt som avtalats med annan stat (EZ), och\n• segmenterad punkt på en rät geodetisk linje eller på en loxodrom mellan\ntvå brytpunkter (MP).\n• skärningspunkt med den angränsande zonens avgränsningslinjer (AZ),\nPunktnamn - Namn i de fall sådant förekommer (gäller avtalade punkter på riksgräns).\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner.\nUnikt ID – Ett unikt ID som Sjöfartsverket adderat.\n\nFöljande attribut finns i linje shape-filen:\nDelsträcka – Ekonomiska zonen redovisas med följande delsträckor; Västkusten, Östersjön, Bottenhavet, Bottenviken.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner."},"dct:identifier":"08edb4a3-d485-4634-867c-f989befb6b56","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b1n0"},"dct:temporal":{"@id":"_:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc_b2n0"},"dct:title":{"@language":"sv","@value":"Gräns för ekonomisk zon"}},{"@id":"urn:uuid:6d03b8a0-29b2-5d2e-3c50-36667797b123","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/sv/tjanster/havsgranser/grans-for-ekonomisk-zon/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Gräns för ekonomisk zon"}},{"@id":"urn:uuid:d3456421-3d78-bde8-d0f4-c07ca02c1e30","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/globalassets/sjokort-och-sjogeografi/ekonomiska_zonens_yttre_avgransningslinjer.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Shapefil Ekonomiska zonens yttre avgränsningslinjer"}}],"@id":"urn:source:542e5c7899cb41ff7f9cc2abac423bf58f5af66d10c5d22d58db39af3005ecfc"},{"@graph":[{"@id":"_:54be0ed82a8ced9433b09276cbb8c0f6933c7e380749f64ef48e24555abff3c2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är mottagna under vegetationsperioden respektive period, och har en geometrisk upplösning på 10-30 meter. Undantaget är data från 1970-talet som har 80 meter upplösning."}},{"@id":"_:54be0ed82a8ced9433b09276cbb8c0f6933c7e380749f64ef48e24555abff3c2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:54be0ed82a8ced9433b09276cbb8c0f6933c7e380749f64ef48e24555abff3c2_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1976"}},{"@id":"_:54be0ed82a8ced9433b09276cbb8c0f6933c7e380749f64ef48e24555abff3c2_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"80182","http://www.w3.org/2006/vcard/ns#street-address":"Geodatasupport, Lantmäteriet"},{"@id":"_:54be0ed82a8ced9433b09276cbb8c0f6933c7e380749f64ef48e24555abff3c2_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:026-633600"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/fb439ff8-6006-4bb5-8cdd-bf48b7d7ac56","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:36a8d012-e98d-59a5-1df2-d9e5e375b109"},"dcat:distribution":[{"@id":"urn:uuid:15a697b3-1cb2-f67e-c2df-6bdeecd724a8"},{"@id":"urn:uuid:7dd8ed1d-973b-2750-2b4b-438db9f99a91"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Saccess innehåller optiska satellitdata från 1970-tal, 1980-tal, millennieskiftet och 2005. Med början 2007 uppdateras Saccess årligen med ett nytt rikstäckande dataset. Data är motttagna under vegetationsperio