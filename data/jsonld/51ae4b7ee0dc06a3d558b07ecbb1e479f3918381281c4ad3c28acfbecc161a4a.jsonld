":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:4768dae09c5d7b0f5feecde297b7cd6c00f05216e309f0424bf0af0c73065696_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria"}],"@id":"urn:source:4768dae09c5d7b0f5feecde297b7cd6c00f05216e309f0424bf0af0c73065696"},{"@graph":[{"@id":"_:47c0254fc8cd10a9b140513151b9624a27bd27bd7cc0891164f4f4bc3125297b_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"802 64","http://www.w3.org/2006/vcard/ns#street-address":"Lantmäterigatan 2D"},{"@id":"_:47c0254fc8cd10a9b140513151b9624a27bd27bd7cc0891164f4f4bc3125297b_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021004284","@type":"foaf:Agent","dct:identifier":"2021004284","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@svk.se"},"foaf:name":{"@language":"sv","@value":"Svenska kraftnät"},"foaf:page":{"@id":"https://www.svk.se"}},{"@id":"https://www.geodata.se/resources/3bc1ae01-1eb2-4e8a-8453-dd8e9c937771","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4efb458d-a1cf-0420-a058-77617952d7e4"},"dcat:endpointURL":{"@id":"https://inspire-skn.metria.se/geoserver/skn/ows?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Stamnätets ledningar är motorvägar i elsystemet. Via stamnätet transporteras elen från de stora kraftverken till alla lokala och regionala elnät i Sverige. Det svenska stamnätet för el består av 15 000 km kraftledningar, 160 transformator- och kopplingsstationer och 17 utlandsförbindelser."},"dct:identifier":"3bc1ae01-1eb2-4e8a-8453-dd8e9c937771","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004284"},"dct:title":{"@language":"sv","@value":"US.TransmissionsnätFörEl.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4efb458d-a1cf-0420-a058-77617952d7e4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"GIS Support GIS Support","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:47c0254fc8cd10a9b140513151b9624a27bd27bd7cc0891164f4f4bc3125297b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:47c0254fc8cd10a9b140513151b9624a27bd27bd7cc0891164f4f4bc3125297b_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria AB"}],"@id":"urn:source:47c0254fc8cd10a9b140513151b9624a27bd27bd7cc0891164f4f4bc3125297b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/3d29c4a7-24a1-44d2-aab6-7118be4a5138","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www.sjofartsverket.se/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten visar de datamängder som idag finns insamlade för uppfyllande av Inspire-direktivets krav i Transportnätstemat (TN) för kategorin Sjötransportnät (tn-w). Datamängderna är ej strukturerade enligt Inspires datamodell. Andra attribut och flera sjösäkerhetsanordningar ingår än vad som omfattas av Inspire."},"dct:identifier":"3d29c4a7-24a1-44d2-aab6-7118be4a5138","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"Sjövägar - WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:47d44e838c958864c87c116ac41b2bad5889d7de0d2a05a696e84b037ccfcb8c"},{"@graph":[{"@id":"_:481be44736785d2835ccaeec7e757a01f7c6d175dfeee915234abe7d7b48c417_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Vi har skannat analoga flygbilder med 15 micron (motsvarar en bildupplösning på ~0,5 m) från olika årtal, främst från 1950-talet fram till 2006, och lagrat dem digitalt. Till dessa bilder finns även information om bildgeometri och andra metadata."}},{"@id":"_:481be44736785d2835ccaeec7e757a01f7c6d175dfeee915234abe7d7b48c417_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:481be44736785d2835ccaeec7e757a01f7c6d175dfeee915234abe7d7b48c417_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2006"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1930"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/0eba83b5-10c4-47b8-a73f-20f49c5f7a78","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:3c1bc68f-194a-121a-9671-824600435ccc"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Produkten innehåller flygbilder från slutet av 1920-talet fram till 2006, främst i sv/v, men många flygbilder finns även i färg och IR. Om bilderna inte redan finns i digital form, så skannas de vid beställning. Det finns även orienteringsdata för många av flygbilderna och på beställning kan vi framställa orienteringsdata för de bilder som saknar det. Flygbilderna finns rikstäckande och har oftast en upplösning på ca 0,5 m, men det finns även bilder med annan upplösning."},"dct:identifier":"0eba83b5-10c4-47b8-a73f-20f49c5f7a78","dct:issued":{"@type":"xsd:date","@value":"1930-01-01"},"dct:language":{"@id":"http