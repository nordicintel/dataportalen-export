ms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar det geografiska området som NEMO-nordic producerar data för.\n\nFör NEMO täcker området hela Östersjön och Sveriges västkust inklusive Nordsjön och Engelska kanalen.\nKoordinater för området ges av hörnen:\nSydvästra  \tlat: 48.5N \tlon: 4.1W\nNordvästra\tlat: 65.9N \tlon: 4.1W\nNordöstra \tlat: 65.9N \tlon: 30.2E\nSydöstra\tlat: 48.5N \tlon: 30.2E"},"dct:identifier":"5f77fe70-9452-11ea-a966-bfa48b38ccc2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografisk prognosmodell, NEMO-Nordic - Historiska analysdata: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0874cb938cbbd1da44a084f7ad2c58840544c1c79b30be6f61737abe4cae87fc"},{"@graph":[{"@id":"_:0887d1adc9d37d379e2c3e2cd9041c24eea70d6d804c5d08e235f11a73f78d9b_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.809380423765 58.306231799121,16.31578223087 58.306231799121,16.31578223087 56.534587273928,12.809380423765 56.534587273928,12.809380423765 58.306231799121))"}},{"@id":"_:0887d1adc9d37d379e2c3e2cd9041c24eea70d6d804c5d08e235f11a73f78d9b_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/c0fa5c92-a8e6-45e5-ab56-2c49d33e60fd","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9"},"dcat:distribution":[{"@id":"urn:uuid:06ac7a17-1702-831e-84ca-cf1294460751"},{"@id":"urn:uuid:68aa7c23-bdea-03f3-e437-0349ba959c37"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Uppgifter om kvicksilverhalten i gädda i olika sjöar i Jönköpings län. Riktade medelvärden (mg Hg/kg) dvs uppmätt kvicksilverhalt är omräknad till 1 kilo fisk. Tidigaste uppgift 1972. Miljöövervakning inom programområdena \"Sjöar och vattendrag\" och \"Hälsa\"."},"dct:identifier":"c0fa5c92-a8e6-45e5-ab56-2c49d33e60fd","dct:issued":{"@type":"xsd:date","@value":"2001-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2001-01-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:0887d1adc9d37d379e2c3e2cd9041c24eea70d6d804c5d08e235f11a73f78d9b_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Kvicksilver i gädda"}},{"@id":"urn:uuid:06ac7a17-1702-831e-84ca-cf1294460751","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_miljoovervakning_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:68aa7c23-bdea-03f3-e437-0349ba959c37","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.miljoovervakning_HG_GADDA.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0887d1adc9d37d379e2c3e2cd9041c24eea70d6d804c5d08e235f11a73f78d9b_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Vattenenheten"}],"@id":"urn:source:0887d1adc9d37d379e2c3e2cd9041c24eea70d6d804c5d08e235f11a73f78d9b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/4436b5ac-94c8-4b8c-ad7a-0cdc56e8242b","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/maringeologi-500-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Maringeologi 1:500 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Produkten ger bland annat information om bottenmaterial, olika sediments mäktighet och bildningssätt.\n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag vid biologiska inventeringar samt för Försvarsmakten.\n\nPå grund av restriktioner genom Lagen om skydd av geografisk information (2016:319) visas endast information utanför sjöterritoriets gräns i havet (tidigare territorialgränsen) med undantag för data som beviljats spridningstillstånd av Sjöfartsverket."},"dct:identifier":"4436b5ac-94c8-4b8c-ad7a-0cdc56e8242b","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Maringeologi 1:500 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0887db8bd1e63099a0a12d7c1ef2ca832044652e7eaccc7e0580fd873592f0cc"},{"@graph":[{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:500 000 är en transformerad version av SGUs produkt Maringeologi 1:500 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden. Endast karterade områden utanför territorialgränsen redovisas.\n\nMaringeologi 1:500 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke.För närvarande är endast områden utanför svenskt territorialhav offentligt tillgängliga.Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. Maringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (akustisk profilering) samt bottenyteavbildande mätningar. Bottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en grafisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. Bottenyteavbildande mätningar görs med multistråleekolod, interferometrisk sonar och sidoavsökande sonar vilka alla ger upphov till grafiska bilder över havsbottenytans areella fördelning av sediment och berg. Mätningar med multistråleekolod och interferometrisk sonar ger dessutom information om vattendjupet inom ett avsökt område. Data som samlas in med hjälp av hydroakustiska mätningar tolkas till geologiska förhållanden. Dessa tolkningar utgår från ett antal platser där såväl mätningar som direkta observationer av de geologiska förhållandena gjorts genom sedimentprovtagning och visuell observation av havsbottnen med hjälp av undervattenskamera. Sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagning föregås av en besiktning av bottenytan med hjälp av undervattenskamera. Efter insamling och bearbetning görs en geologisk tolkning av materialet. Beroende på syfte samt hur insamlingen har skett görs presentationen i olika skalor."}},{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.96 69.95,24.29 69.95,24.29 55.35,9.96 55.35,9.96 69.95))"}},{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2008"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1969"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/3c07e708-6610-494d-ab08-1360673024b2","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:c218f45c-6dfe-94bc-c3c8-3494ec4f575e"},{"@id":"urn:uuid:d241cb2d-3354-7ee5-1da4-b5920a64e7f7"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:500 000 är en transformerad version av SGUs produkt Maringeologi 1:500 000 i syfte att uppfylla Inspire dataspecifikation för tema Havsområden. Endast karterade områden utanför territorialgränsen redovisas.\n\nMaringeologi 1:500 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ) och har för detta ändamål kodats om till Inspires kodlista för havsbottenyttäcke.För närvarande är endast områden utanför svenskt territorialhav offentligt tillgängliga."},"dct:identifier":"3c07e708-6610-494d-ab08-1360673024b2","dct:issued":{"@type":"xsd:date","@value":"2019-10-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-07"},"dct:provenance":{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b1n0"},"dct:temporal":{"@id":"_:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45_b2n0"},"dct:title":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:500 000"}},{"@id":"urn:uuid:c218f45c-6dfe-94bc-c3c8-3494ec4f575e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/SR_SGU_SeaBedArea_500K.xml"},"dct:description":{"@language":"sv","@value":"Atom Feed för nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire Atom Feed"}},{"@id":"urn:uuid:d241cb2d-3354-7ee5-1da4-b5920a64e7f7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SR-Havsbottenyttacke_500k"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}}],"@id":"urn:source:08e4d8d89ae92f05c8193d84c71b8f5b8a65133a76e23e834c5ebea1782f8a45"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://www.geodata.se/resources/a94f7d3e-f57f-4f62-b47c-c69a6507e050","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://www.raa.se/hitta-information/bebyggelseregistret/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst bestående av fördefinierade datauttag med information om det byggda kulturarvet i Sverige, med tyngdpunkt på byggnader och anläggningar skyddade enligt kulturmiljölagen (1988:950) och förordningen (1988:1229) om statliga byggnadsminnen."},"dct:identifier":"a94f7d3e-f57f-4f62-b47c-c69a6507e050","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Information om det byggda kulturarvet, nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:09d6e8052d6685feb2dc8034f0abbb92215b48bfa29070dbc125fd11ee4b4151"},{"@graph":[{"@id":"_:09d7bbbc0c836b15947cb6852e37cf6246711b4c7ff703167a274bb7b3db1abb_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:09d7bbbc0c836b15947cb6852e37cf6246711b4c7ff703167a274bb7b3db1abb_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/2d34c855-d6a6-426c-8021-b5d59c9e5a8e","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Fjallnaragr.xml"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"ATOM-flöde för nedladdning (ZIP) av gräns för fjällnara skog, upprättad av Skogsstyrelsen. Den digitaliserade gränsen är lämplig att använda för att få en överblick på området för fjällnära skog. Det är viktigt att komma ihåg att den digitala gränsen inte har rättsverkan. Det är Skogsstyrelsens författningssamling, SKSFS 1991:3, Förordning om gränsen för fjällnära skog som utgör de juridiska dokument som gäller."},"dct:identifier":"2d34c855-d6a6-426c-8021-b5d59c9e5a8e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"BR.Gräns för fjällnära skog upprättad av Skogsstyrelsen.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:09d7bbbc0c836b15947cb6852e37cf6246711b4c7ff703167a274bb7b3db1abb_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:09d7bbbc0c836b15947cb6852e37cf6246711b4c7ff703167a274bb7b3db1abb_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:09d7bbbc0c836b15947cb6852e37cf6246711b4c7ff703167a274bb7b3db1abb"},{"@graph":[{"@id":"_:09e265681f5810255a51dcbaf0d10fe29af8b7b290a2d0c92c17bb879c5f3650_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är insamlad genom manuell digitalisering ur Lantmäteriets grundläggande geografiska data (GGD) i skala 1:10 000 och Fjällkartan/Vägkartan 1:100 000.\nThe amount of data is collected by manual digitization of Lantmäteriet´s geographical information (GGD) in the scale of 1:10 000 and Mountain Map/Road Map 1:100 000."}},{"@id":"_:09e265681f5810255a51dcbaf0d10fe29af8b7b290a2d0c92c17bb879c5f3650_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.3987 69.4093,27.5474 69.4093,27.5474 54.7967,7.3987 54.7967,7.3987 69.4093))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/21f64a74-ef54-42db-88e9-adb9bb533dc8","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:3d0b79c7-0c63-1949-b336-f8ed75d1d7b6"},{"@id":"urn:uuid:61f10f62-625b-8a1e-d7cf-868536114db7"},{"@id":"urn:uuid:ce171d73-e49b-3451-eba9-ae09ee429bce"},{"@id":"urn:uuid:dc9a21df-be09-1898-68a1-339b0bccbfd2"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Datamängd för ortnamn för tjänster anpassade till Inspire innehållande ortnamn från Ortnamnsdatabasen.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Basemap Visning Inspire."},"dct:identifier":"21f64a74-ef54-42db-88e9-adb9bb533dc8","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:09e265681f5810255a51dcbaf0d10fe29af8b7b290a2d0c92c17bb879c5f3650_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:09e265681f5810255a51dcbaf0d10fe29af8b7b290a2d0c92c17bb879c5f3650_b1n0"},"dct:title":{"@language":"sv","@value":"Datamängd för ortnamn Inspire"}},{"@id":"urn:uuid:3d0b79c7-0c63-1949-b336-f8ed75d1d7b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/ortnamn/atom/v1/inspire/gn"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för atomflödet för Ortnamn Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt för Ortnamn Inspire"}},{"@id":"urn:uuid:61f10f62-625b-8a1e-d7cf-868536114db7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.lantmateriet.se/sv/geodata/vara-produkter/produktlista/ortnamn-nedladdning-inspire/"},"dct:description":{"@language":"sv","@value":"Produktsida för Ortnamn Nedladdning Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Ortnamn Nedladdning, Inspire"}},{"@id":"urn:uuid:ce171d73-e49b-3451-eba9-ae09ee429bce","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/basemap-visning-inspire-api"},"dct:description":{"@language":"sv","@value":"Produktsida för Basemap Visning, Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Basemap Visning, Inspire"}},{"@id":"urn:uuid:dc9a21df-be09-1898-68a1-339b0bccbfd2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/basemap/wms/v1?service=WMS&request=GetCapabilities&version=1.3.0"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt för tjänsten Basemap Visning, Inspire (öppen capabilityfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Basemap Visning, Inspire"}}],"@id":"urn:source:09e265681f5810255a51dcbaf0d10fe29af8b7b290a2d0c92c17bb879c5f3650"},{"@graph":[{"@id":"_:0a0efaff9368090ed5a1cdd0a62d81838d50521222708c4b4aa0ffce2c18967d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU har systematiskt undersökt bergarters petrofysiska egenskaper sedan 1960-talet med mätningar av magnetiska egenskaper och densitet. Även radiometriska egenskaper, samt i vissa fall porositet, har mätts eller beräknats.\n\nDatakvaliteten och mätnoggrannheten har förbättrats med tiden tack vare att instrumenteringen i laboratoriet har uppgraderats vid några tillfällen. Det är inte fullständigt dokumenterat när sådana förbättringar har skett men i den mån det är känt så finns notering vid beskrivning av respektive metod.\n\nProvpunkternas geografiska läge har fram till 1994 bestämts med hjälp av befintligt kartmaterial, vilket gör det svårt att bedöma en generell noggrannhet. Dessa fel bedöms i normalfallet inte överstiga 100 m. Däremot bedöms det, för de äldsta proverna, kunna förekomma fel på upp till 1000 m där positionsbestämning gjorts i svår terräng och utifrån dåtidens kartor. Satellitbaserade positioneringssystem som GPS (Global Positioning System) var i drift redan under 1990-talet och när den militära stör-signalen upphörde kunde noggrannhet i position generellt sägas vara bättre än ungefär 10 meter."}},{"@id":"_:0a0efaff9368090ed5a1cdd0a62d81838d50521222708c4b4aa0ffce2c18967d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c64804b6-159e-4946-8485-db32ee94cd2d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:13f32177-fd89-cae5-de90-f3e96b1f96bc"},{"@id":"urn:uuid:2bb340ee-b464-3416-f833-c415d146f9a0"},{"@id":"urn:uuid:85b91041-a522-2f8c-25ef-7a42e28c04f1"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"sv","@value":"Informationen används bl.a. inom prospektering."},{"@language":"sv","@value":"Petrofysik handlar om bergarternas fysikaliska egenskaper. De egenskaper som undersökts är främst bergarternas magnetism, densitet och radiometri. Även bergarters porositet har undersökts men i mycket begränsad omfattning.\nProdukten Petrofysiska data innehåller data från både laboratorie- och fältmätningar av bergartsprover från hela Sverige. Dessa data grundar sig på direkta mätningar eller provtagningar, genomförda på blottad berggrund, bergprover eller borrkärnor.\nPetrofysiska data används för att identifiera och klassificera bergarter och är viktiga vid modellering av jordens geologiska struktur i tre dimensioner, utifrån geofysiska mätningar och andra observationer. Exempelvis kan petrofysiska data användas för att bedöma om avvikelser i jordens magnet- eller tyngdkraftfält orsakas av en djupt eller ytligt liggande bergartsförändring. Informationen bidrar även till förståelse av de geologiska processer som en bergart har genomgått.\nKlassificering och kartering av bergkroppar görs även för ingenjörsmässiga ändamål och där ligger petrofysiska data till grund för volymberäkningar och bedömning om brytningsmetoder men också för beslut om lämplighet och kvalitet relaterat till infrastruktur."}],"dct:identifier":"c64804b6-159e-4946-8485-db32ee94cd2d","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:0a0efaff9368090ed5a1cdd0a62d81838d50521222708c4b4aa0ffce2c18967d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:0a0efaff9368090ed5a1cdd0a62d81838d50521222708c4b4aa0ffce2c18967d_b1n0"},"dct:title":{"@language":"sv","@value":"Petrofysik, densitet och magnetiska egenskaper"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:13f32177-fd89-cae5-de90-f3e96b1f96bc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/petrofysik-densitet-magnetiska-egenskaper/petrofysik-densitet-magnetiska-egenskaper.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:2bb340ee-b464-3416-f833-c415d146f9a0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/petrofysik-densitet-magnetiska-egenskaper-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:85b91041-a522-2f8c-25ef-7a42e28c04f1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/petrofysik-densitet-magnetiska-egenskaper/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:0a0efaff9368090ed5a1cdd0a62d81838d50521222708c4b4aa0ffce2c18967d"},{"@graph":[{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Underlag för utökat strandskydd för remiss som sedan beslutades 2014."}},{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.4956 57.18203,15.16995 57.18203,15.16995 56.38236,13.4956 56.38236,13.4956 57.18203))"}},{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/1d0a91a6-5d19-4123-ba2f-a80717306a1b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761"},"dcat:distribution":[{"@id":"urn:uuid:54dfbd16-dace-4d8b-2335-899da64abe74"},{"@id":"urn:uuid:fd2c1cbf-2ddf-f019-2dc6-56b4a14524b9"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Utökat strandskydd enligt beslut november 2014. OBSERVERA att filen innehåller bara områden med utökat strandskydd."},"dct:identifier":"1d0a91a6-5d19-4123-ba2f-a80717306a1b","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-01-01"},"dct:provenance":{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Utökat strandskydd 2014"}},{"@id":"urn:uuid:54dfbd16-dace-4d8b-2335-899da64abe74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_naturskydd_ext/MapServer/7"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Naturskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Naturskydd"},{"@id":"urn:uuid:fd2c1cbf-2ddf-f019-2dc6-56b4a14524b9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.Strandskydd_utokat_remiss2014.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:0a3ed87896230828940508420f916906e9ce56a756995e7549dbef6a041fa1ad"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/510be705-94e8-4136-88dd-63728127fc0a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/registerbeteckning-direkt-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten ger möjlighet att söka aktuella uppgifter om fastighetsbeteckningar, samfälligheter och gemensamhetsanläggningar ur den allmänna delen av Lantmäteriets fastighetsregister och visa dem i en karta eller ett ortofoto. Informationen omfattar: \n- registerbeteckning \n- status \n- koordinat.\nRegisterbeteckning i Lantmäteriets fastighetsregister uppdateras dagligen av statliga och kommunala lantmäterimyndigheter. Tjänsten kan beställas fristående, men används framför allt tillsammans med andra direkttjänster."},"dct:identifier":"510be705-94e8-4136-88dd-63728127fc0a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Registerbeteckning Direkt"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0af04299e18cf8b0aacd68eb2b415ff8f9bb40475cff306fece1407b042904f4"},{"@graph":[{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inventering i fält, digitalisering och överenskommet avtal (vanligtvis 50 år)"}},{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1994"}},{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55183","http://www.w3.org/2006/vcard/ns#street-address":"Vallgatan 8"},{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/f56d281c-8246-40aa-83cd-9db0d4389d5a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:distribution":[{"@id":"urn:uuid:57158a2e-acc2-53a6-3986-23c07320d6a9"},{"@id":"urn:uuid:b3e10830-8d86-783a-4579-5f7c6dfe7b21"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Naturvårdsavtalet är ett civilrättsligt avtal som tecknas mellan Skogsstyrelsen, länsstyrelse eller kommun och markägare som är intresserade av naturvård. Syftet med avtalet är att bevara och utveckla områden med höga naturvärden. Avtalstiden kan variera mellan 1 och 50 år och utgör en del av det långsiktiga skogsskyddet. Markägaren får viss ekonomisk ersättning för de begränsningar i brukandet som avtalet medför. Ersättningen grundas på områdets skogliga ekonomiska värde (bedömt rotnetto) och avtalstidens längd. Naturvårdsavtal kan träffas både för områden som är beroende av skötsel för att bevara naturvärdena och för sådana områden där naturvärdena gynnas bäst av fri utveckling. Områdena har vanligtvis en storlek på mellan 3 till 20 hektar men det förekommer områden på mer än 100 hektar."},"dct:identifier":"f56d281c-8246-40aa-83cd-9db0d4389d5a","dct:issued":{"@type":"xsd:date","@value":"2010-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-29"},"dct:provenance":{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b1n0"},"dct:temporal":{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b2n0"},"dct:title":{"@language":"sv","@value":"AM.Naturvårdsavtal upprättade av Skogsstyrelsen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:57158a2e-acc2-53a6-3986-23c07320d6a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/Naturvardsavtal.xml"},"dct:description":{"@language":"sv","@value":"Atomflöde för avisering av naturvårdsavtal upprättade av Skogsstyrelsen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdning av naturvårdsavtal - atomflöde"}},{"@id":"urn:uuid:b3e10830-8d86-783a-4579-5f7c6dfe7b21","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodpags.skogsstyrelsen.se/arcgis/services/Geodataportal/GeodataportalVisaNaturvardsavtal/MapServer/WmsServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst av naturvårdsavtal - wms"}}],"@id":"urn:source:0b8d3fbaa5917ef296f6a812324a60cb7df42a5aa9b1301f6bfd88fcbad3f224"},{"@graph":[{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Insamling av källinformation startades i samband med SGU:s länskartering, grundvattenkartor i skala 1:250 000 SGU serie Ah, och insamlingen har fortsatt vid den lokala grundvatten- och jordartskarteringen i skala 1:50 0000.\n\nParallellt med detta har andra myndigheter, allmänhet med flera samlat in uppgifter om källor med andra utgångspunkter, som från och med december 2025 ingår i denna informationsmängd. Det rör sig då om källor registrerade i Riksantikvarieämbetets fornminnesarkiv, Naturvårdsverkets sammanställning av Natura-naturtyper, Skogsstyrelsens nyckelbiotopsinventering, samt Artportalens (SLU Artdatabanken) observationsdata för biotopen källor eller där källor angivits i fritext\n\nDatakvalitet:\nLägesfel kan variera och är beroende av bland annat kartunderlag och tillgång till GPS."}},{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1985"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ee586b30-b4bd-4e68-bcd2-16a1f247928f","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:5c3f8ed7-4867-45e3-b4c7-e4c9fab3983a"},{"@id":"urn:uuid:71361d96-043a-7bb5-393b-25839cf60f73"},{"@id":"urn:uuid:8204f444-3442-f7ab-5469-b943e1525838"},{"@id":"urn:uuid:84e10660-8ebe-ff13-0e84-4e69ce0b6b86"},{"@id":"urn:uuid:9ec66e5c-3b7a-7e53-5700-dd15d220bdf0"},{"@id":"urn:uuid:b6f89638-f974-a39e-86d6-a4f205f6fc47"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"sv","@value":"Informationen kan bl.a. användas för att välja ut provtagningspunkter för kemisk karakterisering av grundvatten eller för miljöövervakning."},{"@language":"sv","@value":"Källarkivet innehåller information om totalt cirka 14 500 källor (dvs. naturliga grundvattenutflöden), varav ca 2 500 är insamlade och besökta av SGU och dessa källor finns framför allt längs de större rullstensåsarna i Sverige. Dessa källor innehåller, förutom uppgift om läge och namn, också uppgifter om flöde, akvifertyp och i viss omfattning vattenkvalitet med mera. Övriga ca 12 000 källuppgifter innehåller främst uppgifter om källornas läge, namn och informationsursprung. Källor kan vara av stor vikt för specifika arter och livsmiljötyper samt har i många fall en stor kulturhistorisk betydelse. Informationen kan bland annat användas för att välja ut provtagningspunkter för kemisk karakterisering av grundvatten eller för miljöövervakning."}],"dct:identifier":"ee586b30-b4bd-4e68-bcd2-16a1f247928f","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-10"},"dct:provenance":{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b1n0"},"dct:temporal":{"@id":"_:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c_b2n0"},"dct:title":{"@language":"sv","@value":"Källor"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:5c3f8ed7-4867-45e3-b4c7-e4c9fab3983a","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/kallor/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:71361d96-043a-7bb5-393b-25839cf60f73","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/kallor/kallor.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:8204f444-3442-f7ab-5469-b943e1525838","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/kallor"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:84e10660-8ebe-ff13-0e84-4e69ce0b6b86","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-kallor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:9ec66e5c-3b7a-7e53-5700-dd15d220bdf0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-kallor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:b6f89638-f974-a39e-86d6-a4f205f6fc47","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/kallor-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}}],"@id":"urn:source:0bd232628ad239ab183a26c579501d7552b6b5585492683154070c8eddd4553c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/85a7cb13-c2fe-4bfa-80a4-58eb10e3ecbe","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/AM-WaterBodyForWFD"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Inspire visningstjänst för datamängden AM.Grundvattenförekomster"},"dct:identifier":"85a7cb13-c2fe-4bfa-80a4-58eb10e3ecbe","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"AM.Grundvattenförekomster (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0c27d6a1e1ae0e00d012d6e35e3cb30820dccd9e0d6c68d5cb7a737004ee6dcb"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/a49b4f90-3c12-423b-85c0-c8d141d6ca38","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/met-obs/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar meteorologiska stationer som mäter en eller flera av parametrarna temperatur, nederbörd, vindriktning, vindhastighet, relativ luftfuktighet, lufttryck, rådande väder, sikt, snödjup, molnmängd, globalstrålning och solskenstid. Tjänsten visar alla stationer som någonsin levererat data för dessa parametrar.."},"dct:identifier":"a49b4f90-3c12-423b-85c0-c8d141d6ca38","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:0c3a53464a6c5f026f596d8407a9350ca2cafa548a91935465fecf1ab09967cf"},{"@graph":[{"@id":"_:0c624a3f6892e2204e90cd5d284d158141192f76429f4c4c71ad4b1e42d429ed_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.06545 58.15042,15.66821 58.15042,15.66821 56.87258,13.06545 56.87258,13.06545 58.15042))"}},{"@id":"_:0c624a3f6892e2204e90cd5d284d158141192f76429f4c4c71ad4b1e42d429ed_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/458a66b5-8345-459c-8429-881326f903f0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c"},"dcat:distribution":[{"@id":"urn:uuid:3dc077b9-2b43-77ec-f8f1-3632022daa6c"},{"@id":"urn:uuid:64d2c89f-b64a-d00d-ebf8-e8c49118a264"},{"@id":"urn:uuid:8cab029d-aff2-d7fd-a73d-30606f79dbbf"},{"@id":"urn:uuid:c6b23113-df97-30e2-7a70-9217b51fb082"},{"@id":"urn:uuid:ee3a73f7-1497-2c79-641d-398f02b1323a"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skiktet är framtaget inom ramen för projektet ”LEIF i praktiken, Levande Ekosystem I Framtiden – från teoretiskt underlag till praktisk rådgivning”. Genom en täthetsanalys pekades områden ut som når upp till tröskelvärden för habitatmängd, det vill säga där ett tillräckligt stort antal lämpliga träd återfinns inom ett 25 kvadratkilometer stort område för arters överlevnad i landskapet. Områden med tillräcklig habitatmängd visas i grönt, ju mörkare desto större habitatmängd. Gula områden visar var lämpliga habitat återfinns men i en för lite mängd för att nå upp till tröskelvärdet. Utanför gröna och gula områden har inga lämpliga habitat inventerats. Se tillkomsthistorik och rapport för metodik och begränsningar. OBS lyrfil finns i nuläget inte tillgänglig för externa användare men kan skickas efter önskemål till gis.jonkoping@lansstyrelsen.se"},"dct:identifier":"458a66b5-8345-459c-8429-881326f903f0","dct:issued":{"@type":"xsd:date","@value":"2016-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-03-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:0c624a3f6892e2204e90cd5d284d158141192f76429f4c4c71ad4b1e42d429ed_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Levande ekosystem i framtiden - Ask, Alm, Lönn"}},{"@id":"urn:uuid:3dc077b9-2b43-77ec-f8f1-3632022daa6c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_2/MapServer/WMSServer?layers=LstF_Levande_ekosystem_i_framtiden_Ask_Alm_Lonn"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Levande_ekosystem_i_framtiden_Ask_Alm_Lonn (WMS)"}},{"@id":"urn:uuid:64d2c89f-b64a-d00d-ebf8-e8c49118a264","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_2/MapServer/20"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:7f502a8e-e373-00d6-95c2-5f4eb8c6940c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Landenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0c624a3f6892e2204e90cd5d284d158141192f76429f4c4c71ad4b1e42d429ed_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Landenheten"},{"@id":"urn:uuid:8cab029d-aff2-d7fd-a73d-30606f79dbbf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/jonkoping/GDK_dokument/2017-03-LEIF-i-praktiken.pdf"},"dct:description":{"@language":"sv","@value":"Meddelande nr 2017:03 \"LEIF i praktiken - Levande Ekosystem I Framtiden – från teoretisktunderlag till praktisk rådgivning\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"2017-03-LEIF-i-praktiken.pdf"}},{"@id":"urn:uuid:c6b23113-df97-30e2-7a70-9217b51fb082","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_levande_ekosystem_i_framtiden_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:ee3a73f7-1497-2c79-641d-398f02b1323a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.LstF_Levande_ekosystem_i_framtiden_Ask_Alm_Lonn.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:0c624a3f6892e2204e90cd5d284d158141192f76429f4c4c71ad4b1e42d429ed"},{"@graph":[{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Dygnsberäknad modelldata från meteorologisk information sedan starten 1999, under brandrisksäsongen."}},{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.10,24.50 69.10,24.50 55.10,10.50 55.10,10.50 69.10))"}},{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2022"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1999"}},{"@id":"https://www.geodata.se/resources/bc2a236c-d57d-4bf9-890f-70509739b212","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:574e09da-9664-d7db-8cef-15dbbfeca71b"},{"@id":"urn:uuid:601597a5-ef2a-33db-71f3-80746a7d3295"},{"@id":"urn:uuid:8e09d36e-53f3-6fd3-53a3-46904aaf4191"},{"@id":"urn:uuid:f32c4833-07fe-c2e1-2b68-7589c5a49a0a"}],"dcat:keyword":["Myndigheten för civilt försvar",{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"I beslutsstödsystemet Brandrisk Skog och Mark beräknas brandriskprognoser och meteorologiska data redovisas som stöd för beslut i frågor om brand i vegetation. När prognosen upphört görs en ny beräkning av brandriskvärdena utifrån senast tillgänglig väderdata. Denna \"analysdata\" lagras. Efter varje års brandsäsong sparas den analyserade historiska datamängden för de modellberäknade rutorna om 2,8 km * 2,8 km med mittpunkten angiven i x och y-koordinater. Sedan 2021 års data har punkter utökats markant och rutstorleken korrigerats till 2,8 km * 2,8 km. Observera att WMS-tjänsten endast innehåller föregående års data. \n\nVarje 2,8 km * 2,8 km ruta har attributen som anges nedan (viss variation kan förekomma från år till år): \nID: Intern MSB uppgift \nPunktID: Intern MSB uppgift för unik gridruta. Uppgiften tillkom år 2015, innan det fanns inte värdet. \nTime: Användes till och med år 2014 för att ange datum för statistikvärden. Från och med 2015 lagras istället datum i fältet ”Datum”. \nTemp: Temperatur i grader Celsius 2 m över marken kl 12 UTC enligt beräkningsmodell för aktuell gridruta. \nRH: Relativa luftfuktigheten angiven i % 2 m över marken kl 12 UTC enligt beräkningsmodell för aktuell gridruta. \nVindhastighet: Vindhastighet i m/s (medelvind) 10 m över marken kl 12 UTC enligt beräkningsmodell för aktuell gridruta. \nNederbord: Nederbörd aktuellt dygn 18 UTC-18 UTC föregående dygn enligt beräkningsmodell för aktuell gridruta. \nFFMC: Fine Fuel Moisture Code representerar fuktigheten på blad och gräs. Den maximala vattenmagasineringen i detta skikt är mindre än 1 mm. Ingår i FWI-modellen. \nDMC: Duff Moisture Code representerar fuktigheten i ett något djupare skikt än det allra ytligaste i FWI-modellen, t ex mossa och den  övre delen av humuslagret. Magasineringen i detta skikt motsvarar ca 15 mm vatten. \nDC: Drought Code visar fukthalten i tjocka kompakta humuslager (ca 100 mm vatten). DC ingår i FWI-modellen. \nISI: Initial Spread Index. Ett mått på brandens spridningshastighet. Ett index som används för att räkna fram ett FWI-värde. Beräknas ur FFMC och förstärks av vindhastigheten. \nBUI: Buildup Index. Kan ses som ett allmänt fuktighetsmått för de något djupare markskikten. Ett indexvärde som används för att räkna fram ett brandriskvärde, FWI-värde. Viktat medelvärde av DMC och DC. \nFWI: Fire Weather Index. Brandriskvärde som räknas fram ur ISI och BUI, vilka i sin tur baseras på tre grundvärden för fukthalter i olika skikt (FFMC, DMC och DC). Indata till beräkningen är dygnsnederbörden samt temperatur, relativ fuktighet och vindhastighet mitt på dagen. \nFWI-index: Index för Spridningsrisk och Brandbeteende i skogsmark. Baseras på grundvärdet FWI (se ovan). För närvarande indelat i sex olika indexnivåer (1, 2, 3, 4, 5, 5E) där index 1 är lägsta risken och index 5E är högsta risken. \nBränsleuttorkning: Indexvärden för uttorkningen i bränslet och de nedre markskikt som har störst betydelse för en skogsbrand. För närvarande indelat i sex olika indexnivåer (1, 2, 3, 4, 5, 5E) där index 1 är lägsta risken och index 5E är högsta risken.\nTmedel: Dygnsmedel temperatur 2 m över marken enligt SMHI beräkningsmodell för aktuell gridruta. \nRn: Spridningshastighet i m/min för brand i oklippt, obetat stående fjolårsgräs.\nGfi: Brandrisknivåer för gräsbrand, följande beteckningar används: \nMycket stor gräsbrandsrisk (6) \nStor gräsbrandsrisk (5)\nMåttlig gräsbrandsrisk (4)\nLiten gräsbrandsrisk (3)\nGräsbrandssäsongen slut (2)\nSnö - Snötäckt mark (1)\nData saknas/Ej säsong (-1)\nVindriktning: Vindriktning i grader varifrån vinden kommer (indelning 360 grader, 180 grader motsvarar sydlig vind) kl 12 UTC enligt beräkningsmodell för aktuell gridruta. \nE: Gridrutans öst-västliga läge (mittpunkt) som anges i SWEREF 99 TM. OBS: före år 2015 angavs denna information i fält ”y”. \nN: Gridrutans nord-sydliga läge (mittpunkt) som anges i SWEREF99 TM. OBS: före år 2015 angavs denna information i fält ”x”. \nKommun: Kommunkod för den kommun som koordinaten i fälten ”E” och ”N” ligger inom."},"dct:identifier":"bc2a236c-d57d-4bf9-890f-70509739b212","dct:issued":{"@type":"xsd:date","@value":"1999-03-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"1999-03-01"},"dct:provenance":{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b0n0"},"dct:publisher":{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796"},"dct:spatial":{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b1n0"},"dct:temporal":{"@id":"_:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51_b2n0"},"dct:title":{"@language":"sv","@value":"Brandriskvärden, analyserade"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:574e09da-9664-d7db-8cef-15dbbfeca71b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/filer/brandrisk/Brandriskdata_2022.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av brandriskvärden 2022 i CSV-format."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Indata för brandriskvärdena 2022 i CSV-format"}},{"@id":"urn:uuid:601597a5-ef2a-33db-71f3-80746a7d3295","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/brandrisk/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst för MSB:s brandriskvärden"},"dct:title":{"@language":"sv","@value":"Visningstjänst för MSB:s brandriskvärden"}},{"@id":"urn:uuid:8e09d36e-53f3-6fd3-53a3-46904aaf4191","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/nedladdning/brandrisk.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för MSB:s brandriskvärden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för MSB:s brandriskvärden"}},{"@id":"urn:uuid:e9b4a9f5-d3fb-a480-8907-8b72a12c4796","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:Registrator@mcf.se"},"foaf:name":"Myndigheten för civilt försvar"},{"@id":"urn:uuid:f32c4833-07fe-c2e1-2b68-7589c5a49a0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://inspire.msb.se/brandrisk/ogc/features/v1/"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst Brandrisk OGC API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"}}],"@id":"urn:source:0c786b4a0fe7fcceaabd75085ca9451198bfbd75f6ba9f309c792ee683e07a51"},{"@graph":[{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skiktet skapades mha metodiken i rapporten \"Erfarenhetsrapport Sårbarhetskartor för grundvatten anpassade för räddnignstjänstens behov\" SGU-rapport 2009:5 (https://www.sgu.se/samhallsplanering/risker/samverkan-kring-kris-och-riskhantering/sarbarhetskartor-for-grundvatten/), (http://resource.sgu.se/produkter/sgurapp/s0905-rapport.pdf). Jordarter klassificerades enligt SGUs rekommendation på genomsläpplighet och skikten som användes var: \"SGU Jordartsgeologi Lokal A Förenklad jordartsindelning (J_BAS), (fd Ae)\" och \"SGU Jordartsgeologi Regional C Förenklad jordartsindelning (J_BAS)\" samt skiktet för grundvatten \"SGU_Hydrogeologi_Grundvatten_lokal_Grundvattenmagasin_GMAG\"Markytor vars genomsläpplighet klassificerades som mycket hög, samt mark med underliggande grundvattenmagasin klassades som att ha mycket hög sårbarhet.Hög riskklass buffrades ut 50 meter gentemot lägre riskklasser och Mycket hög riskklass buffrades ut 50 meter gentemot lägre riskklasser.Närhet till vattendrag och sjöar som enl SGU metod nedklassats pga utflöde har inte tagits i beaktande då risk för spridning anses vara stor nära vattendrag."}},{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.90773 58.38911,15.80489 58.38911,15.80489 56.80108,12.90773 56.80108,12.90773 58.38911))"}},{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/a1d63032-6683-411c-ad89-8eea5b3a76a5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:104351d6-155f-a897-d943-fc70809664d4"},"dcat:distribution":[{"@id":"urn:uuid:25b60c22-40ab-5e43-8864-f48662b84bb3"},{"@id":"urn:uuid:3ca04845-fd92-3c5a-5e11-afaa5368ac26"},{"@id":"urn:uuid:7d169af3-2073-f1e1-22f0-a36b4e0510b8"},{"@id":"urn:uuid:89a2117c-3862-d02a-4696-feda2174353b"},{"@id":"urn:uuid:9d8ac6ee-76f3-60b1-f9d9-807de0bc49b1"},{"@id":"urn:uuid:c4dc432c-cd74-eb32-c7c8-1f7e7b7bfabe"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Markytans genomsläpplighet baserat på jordartkarteringar från SGU. Analysen bygger på en rapport från SGU som baserar riskbedömningen på markens genomsläpplighet av vätskor beroende på jordart och kornstorlek och underliggande grundvattenmagasin. Från 2012"},"dct:identifier":"a1d63032-6683-411c-ad89-8eea5b3a76a5","dct:issued":{"@type":"xsd:date","@value":"2012-08-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-08-10"},"dct:provenance":{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b1n0"},"dct:title":{"@language":"sv","@value":"LstF Jordarter genomsläpplighet (infiltration)"}},{"@id":"urn:uuid:104351d6-155f-a897-d943-fc70809664d4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Beredskapsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Beredskapsenheten"},{"@id":"urn:uuid:25b60c22-40ab-5e43-8864-f48662b84bb3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_halsa_sakerhet_EXT/MapServer/3"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:3ca04845-fd92-3c5a-5e11-afaa5368ac26","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/produkter/sgurapp/s0905-rapport.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU-rapport 2009:5"}},{"@id":"urn:uuid:7d169af3-2073-f1e1-22f0-a36b4e0510b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_2/MapServer/WMSServer?layers=LstF_Jordarter_genomslapplighet_infiltration"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"LstF_Jordarter_genomslapplighet_infiltration (WMS)"}},{"@id":"urn:uuid:89a2117c-3862-d02a-4696-feda2174353b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_2/MapServer/15"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:9d8ac6ee-76f3-60b1-f9d9-807de0bc49b1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.beredskap_jordarter_genomslapplighet.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c4dc432c-cd74-eb32-c7c8-1f7e7b7bfabe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/samhallsplanering/risker/samverkan-kring-kris-och-riskhantering/sarbarhetskartor-for-grundvatten/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGUs webb"}}],"@id":"urn:source:0d3404fd93dc1a703cf95e9c8e76009025873ecddebd37ed6bc8492983620056"},{"@graph":[{"@id":"_:0d7e471152d60b4e203e3a2fc019e420adbe5801b80767ad99a658c1a3ed32f9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från 1992 till 1997 digitaliserades den analoga informationen och den första digitala versionen av grunddata skapades. Målet var att skapa en rikstäckande databas i skala 1:10 000. Vid utvecklingen av Grundläggande Geografiska Data (GGD) under perioden 1995–2004 kompletterades och förbättrades datamängden genom att till exempel lägesosäkerheten förbättrades. Fjällområdet saknades från början men karterades mellan åren 2006 och 2012.\n\nTidigare gjorde Lantmäteriet fältarbete, idag utförs insamlingen av Lantmäteriet genom tolkning av flygbilder i stereo och ortofoto. En stor del av information samlas in i samverkan med andra statliga myndigheter, kommuner och organisationer."}},{"@id":"_:0d7e471152d60b4e203e3a2fc019e420adbe5801b80767ad99a658c1a3ed32f9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/d515adec-9a52-4c5b-9937-13ccca5f0f01","@type":["dcat:Dataset","http://entryscape.c