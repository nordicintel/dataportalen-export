","@value":"Atom-fil"}}],"@id":"urn:source:48f358ae5595b4802779d5b077db57fb9f330fd856eaad66f2eb7c6676616181"},{"@graph":[{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.9745 69.0599,23.8887 69.0599,23.8887 61.0314,11.9745 61.0314,11.9745 69.0599))"}},{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.97458 69.05997,23.89014 69.05997,23.89014 61.03148,11.97458 61.03148,11.97458 69.05997))"}},{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/b1d59cb0-2e71-4c08-b99d-e4cc7507cb92","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:15e33b36-5bcb-bb2d-a770-c3f825cf27b5"},{"@id":"urn:uuid:8aaab230-a44e-692c-c6fc-ca16303712a5"},{"@id":"urn:uuid:a720ea46-fb2b-229b-6170-e31660bba20c"},{"@id":"urn:uuid:f664d593-a5f6-05f0-fd0c-425333bd001c"},{"@id":"urn:uuid:fec4697f-b76a-3783-0a68-cb7deb444988"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Detta kartlager visar Länsstyrelsernas tolkning av de områden som riksdagen beslutat är av riksintresse för obrutet fjäll enligt 4 kap. 5 § miljöbalken.  Denna bestämmelse har sitt ursprung i lagen (1987:12) om hushållning med naturresurser m.m. Då riksdagen fattade beslut om riksintresset fanns den geografiska avgränsningen enbart beskriven i text med ortsnamn och/eller andra geografiskt fasta punkter, samt en grov illustration i förarbetena (prop. 1985/86:3). Länsstyrelserna har senare gjort en mer preciserad tolkning av den geografiska avgränsningen i samråd med berörda kommuner.\n \nObservera att detta gis-skikt endast är en indikativ tolkning av gränserna. För aktuell avgränsning se gällande översiktsplan. Det är i den kommunala översiktsplaneringen som innebörden av de geografiska riksintressebestämmelserna i 4 kap miljöbalken kan konkretiseras.\n \nFör mer information om bakgrunden till riksintressebestämmelserna, se Boverkets vägledning i PBL kunskapsbanken."},"dct:identifier":"b1d59cb0-2e71-4c08-b99d-e4cc7507cb92","dct:issued":{"@type":"xsd:date","@value":"2016-12-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b0n0"},{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Riksintresse Obrutet Fjäll MB4kap1,5"}},{"@id":"urn:uuid:15e33b36-5bcb-bb2d-a770-c3f825cf27b5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Geodata/Datadistribution/ZIP/LST_RI_Obrutet_fjall_MB4kap5.zip"},"dct:description":{"@language":"sv","@value":"LYR-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"LYR-fil"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:8aaab230-a44e-692c-c6fc-ca16303712a5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/sv/PBL-kunskapsbanken/riksintressen/riksintressen-enligt-4-kap-mb/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Boverket PBL-kunskapsbanken"}},{"@id":"urn:uuid:a720ea46-fb2b-229b-6170-e31660bba20c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.Lst_RI_Obrutet_fjall_MB4kap5.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:f664d593-a5f6-05f0-fd0c-425333bd001c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"2"}},{"@id":"urn:uuid:fec4697f-b76a-3783-0a68-cb7deb444988","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Riksintressen_EXT/MapServer/3"},"dct:description":{"@language":"sv","@value":"LST Riksintresse obrutet fjäll MB 4 kap 5"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST_Riksintresse_Obrutet_fjall_MB4kap1,5"}}],"@id":"urn:source:48f52efa5bcbe69df42c3e725ae2e31684277c7246284ae7b646215d31597ebe"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/7def3342-9033-41e4-921e-709350eda1e9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Visningstjänst för INSPIRE temat Höjd (Elevation). Informationen i tjänsten är hämtat från Sjöfartsverkets djupdatabas (DIS) . I tjänsten presenteras reducerade djupvärden i en upplösning av 500 x 500 meter. Djupen representerar minsta, största och medel djupen inom respektive cell/pixel."},"dct:identifier":"7def3342-9033-41e4-921e-709350eda1e9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"Djupdata 500 m upplösning - Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4911a7db4c69e3193be7ab9cdc50e8ca5eb494247e96eb1171c6fe809795be77"},{"@graph":[{"@id":"_:496b214ec095b0445dcf20270bc96a20dbe34608f1610d74b5bfcd662d2065c5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:496b214ec095b0445dcf20270bc96a20dbe34608f1610d74b5bfcd662d2065c5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30000 65.87000,23.51000 65.87000,23.51000 54.80000,10.30000 54.80000,10.30000 65.87000))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/58e3f95f-344a-43ac-9ac9-aecced84d56f","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:628edf7c-093a-1c4b-eaec-221f9938d599"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Medeldjup beräknat utifrån samtliga mätta djupvärden i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 100 m upplösning. Medelvärdenas position är respektive rutas mittpunkt och beräknas endast i rutor med minst ett mätt djupvärde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"58e3f95f-344a-43ac-9ac9-aecced84d56f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-02"},"dct:provenance":{"@id":"_:496b214ec095b0445dcf20270bc96a20dbe34608f1610d74b5bfcd662d2065c5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:496b214ec095b0445dcf20270bc96a20dbe34608f1610d74b5bfcd662d2065c5_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 100 m upplösning - medeldjup"}},{"@id":"urn:uuid:628edf7c-093a-1c4b-eaec-221f9938d599","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:496b214ec095b0445dcf20270bc96a20dbe34608f1610d74b5bfcd662d2065c5"},{"@graph":[{"@id":"_:49b54c8d777324eacf5aad49f4ea91871fa78e3f9822c204354e64e677e1c473_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Information i databasen kommer från dokumentation av aktuella borrhål, så som rapporter och borrprotokoll, i samband med borrning, kartering och analys."}},{"@id":"_:49b54c8d777324eacf5aad49f4ea91871fa78e3f9822c204354e64e677e1c473_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/7d25f577-182e-4eff-8092-70b45fca8f8d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:39350f4b-7695-6fb1-d1b3-9abccb23b8e8"},{"@id":"urn:uuid:3c307375-66ac-24e6-95f3-92fa6e10c6ed"},{"@id":"urn:uuid:757e1933-a8e9-b4ec-714b-a67859feae89"},{"@id":"urn:uuid:a78b9b90-1bcb-92b5-d7bf-c53dc123779c"},{"@id":"urn:uuid:ce0ff234-47c4-2cc2-8c59-90b0c66f9f63"},{"@id":"urn:uuid:d4745a21-4d83-4b8f-0caf-76e3125623d7"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Syftet med produkten är att tillhandahålla borrhålsinformation från den svenska berggrunden.\n\nDatamängden Borrhål innehåller koordinatsatt information om borrhål från vilka SGU i många fall förvaltar borrkärnor, kax mm. Materialet kommer från borrningar gjorda i samband med prospekterings- och anläggningsarbeten över hela Sverige.\n\nProdukten innehåller information om borrhålet och om det finns en borrkärna bevarad vid SGU. En del av borrkärnorna som täcker olika svenska mineraliseringar och malmtyper har fotograferats och skannats med infraröd hyperspektral teknik. Produkten innehåller länkar till nedladdning av data för både rådata (level 0) och bearbetade data (level 2). Det finns även en länk till en extern sida med möjlighet att titta på högupplösta optiska bilder, FCC-bilder samt IR-spektra för den aktuella kärnan. Detta kräver att en särskilt app (Intellicore) är installerad på din dator. Om appen inte redan är installerad på din dator får du en fråga om du vill installera den."},"dct:identifier":"7d25f577-182e-4eff-8092-70b45fca8f8d","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:49b54c8d777324eacf5aad49f4ea91871fa78e3f9822c204354e64e677e1c473_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:49b54c8d777324eacf5aad49f4ea91871fa78e3f9822c204354e64e677e1c473_b1n0"},"dct:title":{"@language":"sv","@value":"Borrhål"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:39350f4b-7695-6fb1-d1b3-9abccb23b8e8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/borrkarnor"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:3c307375-66ac-24e6-95f3-92fa6e10c6ed","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:757e1933-a8e9-b4ec-714b-a67859feae89","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/borrhal/borrhal.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:a78b9b90-1bcb-92b5-d7bf-c53dc123779c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/borrhal-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:ce0ff234-47c4-2cc2-8c59-90b0c66f9f63","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-borrkarnor.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:d4745a21-4d83-4b8f-0caf-76e3125623d7","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/borrhal/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:49b54c8d777324eacf5aad49f4ea91871fa78e3f9822c204354e64e677e1c473"},{"@graph":[{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkomst i samband med kvarn- och såginventeringen genomförd 1999."}},{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.33555 57.22399,15.68184 57.22399,15.68184 56.35903,13.33555 56.35903,13.33555 57.22399))"}},{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-223-70-00"}},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/08f22cd1-848c-4504-86a2-5db81f81205c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e"},"dcat:distribution":[{"@id":"urn:uuid:7695a57e-0d04-9194-3bc8-31f16ae87f01"},{"@id":"urn:uuid:7bc78371-036e-f47c-6f6f-00c623dbc7d6"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventering av kvarnar och sågar 1999. Länkar till objektspecifika beskrivningar är brutna. För information om en anläggning, vänd dig till kulturmiljöenheten på Länsstyrelsen Kronoberg."},"dct:identifier":"08f22cd1-848c-4504-86a2-5db81f81205c","dct:issued":{"@type":"xsd:date","@value":"2015-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-15"},"dct:provenance":{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Kultur Industriminnen kvarnar och sågar"}},{"@id":"urn:uuid:7695a57e-0d04-9194-3bc8-31f16ae87f01","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_kulturmiljo_ext/MapServer/11"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:76aa5440-0213-2c70-b3dd-61bf3184851e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Kulturmiljö","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Kulturmiljö"},{"@id":"urn:uuid:7bc78371-036e-f47c-6f6f-00c623dbc7d6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg205_indmin99.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:49ec0fbbf0d625247fae00047f3de6ea90f03e06529e6959a62d3f9e8a915d8f"},{"@graph":[{"@id":"_:4a2993f0d6a4ef3cd7d9d9c31f7d1a55ae17899ff166e60b4872345188133736_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data avseende djupinformation har sitt ursprung i sjömätningar från 1820 och framåt. Nautisk information uppdateras dagligen. Övrig data kommer från externa källor."}},{"@id":"_:4a2993f0d6a4ef3cd7d9d9c31f7d1a55ae17899ff166e60b4872345188133736_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.35355 69.2327,29.83354 69.2327,29.83354 54.13254,10.35355 54.13254,10.35355 69.2327))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/DD605F42-5A69-4A8E-97CE-7360F71D9978","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:bcab998d-cdad-988f-249e-ea55de84db67"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Korten täcker stora delar av Sveriges sjöterritorium. De används för navigering i öppen sjö samt för översiktlig planering.\nSkalan är vanligtvis 1:500 000. \nDessutom finns ett sjökort som täcker hela Sverige i skala 1:1 600 000."},"dct:identifier":"DD605F42-5A69-4A8E-97CE-7360F71D9978","dct:issued":{"@type":"xsd:date","@value":"2012-09-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-09-27"},"dct:provenance":{"@id":"_:4a2993f0d6a4ef3cd7d9d9c31f7d1a55ae17899ff166e60b4872345188133736_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:4a2993f0d6a4ef3cd7d9d9c31f7d1a55ae17899ff166e60b4872345188133736_b1n0"},"dct:title":{"@language":"sv","@value":"Sjökort - Översiktskort"}},{"@id":"urn:uuid:bcab998d-cdad-988f-249e-ea55de84db67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Sjofart/Sjokort/"},"dct:description":{"@language":"sv","@value":"Sjökort och Publikationer på Sjöfartsverkets officiella hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjökort och Publikationer"}}],"@id":"urn:source:4a2993f0d6a4ef3cd7d9d9c31f7d1a55ae17899ff166e60b4872345188133736"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2609c66a-b146-4825-9c05-307b2dfc038e","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/SR-Havsbottenyttacke_500k"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden SR.Havsbottenyttäcke 1:500 000 visas i denna OGC WMS-tjänst."},"dct:identifier":"2609c66a-b146-4825-9c05-307b2dfc038e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"SR.Havsbottenyttäcke 1:500 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4a43442337f5c355e86fc711ebdb5c2116fa6029935897013b95399435599e88"},{"@graph":[{"@id":"_:4a80ca5ae99feac72a50b6757125f759300a8a64433539b0d80259df402f69a8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkomsthistorik:\nFältundersökningar utfördes med SGU:s forskningsfartyg R/V Ocean Surveyor under  2016 och 2017.\n\nFör mer information om utnyttjade metoder och datakvalitet hänvisas till separat projektrapport.\n\nBiologi- och substratkartor producerades med hjälp av en sammanställning av miljövariabler vilka förbereddes med olika biogeofysiska metoder, som matades in i maskininlärningsalgoritmer (boosted regression trees (BRT) som implementerades av gbm och caret-paketet i R ( v3.1.4)) för att förutsäga rumslig täckning (% täckning) för varje biota och sedimenttyp.\n\nSGU Ytsubstratkartan producerades genom att kombinera dataseten från sedimentkartorna från alla fraktioner för att skapa tematiska kartor av sedimentstorleksutbredning i kartläggningsområdet.\n\nHelcom HUB kartor togs fram genom att integrera både biologi och substratkartorna som använder det gemensamma ramverket för att definiera marina miljöklasser i Östersjöregionen (se HELCOM 2013). Det togs fram för att vara kompatibelt med den Europeiska EUNIS strukturen. Klassificeringen är hierarkisk och indelad i sex nivåer av habitat och biotoper.\n\nNatura 2000 kartor togs fram genom att integrera både biologi och substratkartorna för att skapa tematiska kartor genom de allmänt-överenskomna klassificerings kriteriet för skyddade områden av EU-medlemsländer som överenskommits i EU-kommissionen.\n\nBackscatter-kartan baseras på data från EM2040 MBES och bearbetades med FMGT (v7.6.3).\n\nBatymertidata producerades genom bearbetning data insamlad av EM2040 MBES under 2016 och 2017. En mängd griddar med 0,50 m upplösning i GeoTiff format producerades och reducerades till 5 m upplösning för denna produkt.\n\nDatakvalitet:\nNoggrannhetsbedömningar har utförts för varje modellerat dataset.\n\nNoggrannhetsbedömningar av batymetridatan utfördes med dubbelkontrollanalys genom att följa instruktioner från International Hydrographic Organization (IHO)-44 samt Sjöfartsverkets genomförande av IHO-44 och visar att batymetrigriddet ligger inom IHO-44 Special Order."}},{"@id":"_:4a80ca5ae99feac72a50b6757125f759300a8a64433539b0d80259df402f69a8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.0068 56.2914,17.9019 56.2914,17.9019 55.9652,17.0068 55.9652,17.0068 56.2914))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/fd6ce43f-d734-4487-8ce2-5f5e5052c3f0","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:6ff140ea-1dc5-cd18-72a7-287141126fdb"},{"@id":"urn:uuid:b2a7da9b-6b36-2732-64d1-1a66dc8c5d92"},{"@id":"urn:uuid:b6962a19-ea05-4381-3087-b4254e1e783e"},{"@id":"urn:uuid:f124ab1f-b6f9-6000-f16e-808c8fa3d3b2"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Habitatkartorna över Norra Midsjöbanken är resultaten från den utbredda marina habitatkartläggningen från Norra Midsjöbanken, en offshorebank som sträcker sig från södra Gotland och väster om Öland till centrala och sydvästra delarna av Egentliga Östersjön. Kartorna skapades genom att integrera bio-geofysiska data, samt maskininlärningsmodellering för att producera kontinuerliga täckningsmodeller (%) av substrat och biota. Dessa (biofysiska och geologiska) kontinuerliga modeller kombinerades sedan för att producera bentiska habitatkartor som kategoriseras enligt olika klassificeringssystem. Dessa inkluderar klassificeringssystemet HELCOM HUB för Östersjön samt det europeiska initiativprogrammet Natura 2000.\nKartorna och modellerna som producerats med denna metod är dessutom högupplösta (5 m), vilket gör att de kan skalas upp till skalor relevanta för förvaltning, samtidigt som den behåller viktig information från högupplösta data."},"dct:identifier":"fd6ce43f-d734-4487-8ce2-5f5e5052c3f0","dct:issued":{"@type":"xsd:date","@value":"2022-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-12"},"dct:provenance":{"@id":"_:4a80ca5ae99feac72a50b6757125f759300a8a64433539b0d80259df402f69a8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:4a80ca5ae99feac72a50b6757125f759300a8a64433539b0d80259df402f69a8_b1n0"},"dct:title":{"@language":"sv","@value":"Habitatkartering, Norra Midsjöbanken"}},{"@id":"urn:uuid:6ff140ea-1dc5-cd18-72a7-287141126fdb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/marin/nedladdning-habitatkartering-norra-midsjobanken.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Öppna data Nedladdning ATOM"}},{"@id":"urn:uuid:b2a7da9b-6b36-2732-64d1-1a66dc8c5d92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter-och-tjanster/geologiska-data/maringeologi--geologiska-data/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Maringeologi, Öppna data"}},{"@id":"urn:uuid:b6962a19-ea05-4381-3087-b4254e1e783e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/habitatkartering-norra-midsjobanken-oppnadata-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:f124ab1f-b6f9-6000-f16e-808c8fa3d3b2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/publikation/sgurapport/sgurapport202034rapport/s2034-rapport.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SGU-Rapport 2020:34"}}],"@id":"urn:source:4a80ca5ae99feac72a50b6757125f759300a8a64433539b0d80259df402f69a8"},{"@graph":[{"@id":"_:4aa28686a5385847ceabb0fd529a76212ff6a82b06c4df164d9af3b741443720_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.658409854022644 69.38550540738328,24.06303854493584 69.38550540738328,24.06303854493584 54.83971444173534,9.658409854022644 54.83971444173534,9.658409854022644 69.38550540738328))"}},{"@id":"_:4aa28686a5385847ceabb0fd529a76212ff6a82b06c4df164d9af3b741443720_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/1fcee331-f30e-7084-b1fc-fc007b26264a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":[{"@id":"urn:uuid:3a67e980-a7d4-64a8-e9df-c70260ee5ff3"},{"@id":"urn:uuid:8a774e01-2a18-b710-c116-f0e5eabe8788"},{"@id":"urn:uuid:f370611d-d3ba-9489-bcf8-364c2dbeb74a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Tidserie av status gällande totalfosfor i omdrevsjöar, trendvattendrag och trendsjöar"},"dct:identifier":"1fcee331-f30e-7084-b1fc-fc007b26264a","dct:issued":{"@type":"xsd:date","@value":"2017-01-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-02-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:4aa28686a5385847ceabb0fd529a76212ff6a82b06c4df164d9af3b741443720_b0n0"},"dct:title":{"@language":"sv","@value":"Fosfor i sjöar och vattendrag"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_e1da4e07"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4aa28686a5385847ceabb0fd529a76212ff6a82b06c4df164d9af3b741443720_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"},{"@id":"urn:uuid:3a67e980-a7d4-64a8-e9df-c70260ee5ff3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.ad23bfe185cbe8fec877f9/1674220250287/officiell-statistik-kartunderlag-totalfosfor-omdrevssjoar-2016-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Totalfosfor i omdrevsjöar"}},{"@id":"urn:uuid:8a774e01-2a18-b710-c116-f0e5eabe8788","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.ad23bfe185cbe8fec8768f/1674219648830/officiell-statistik-dataunderlag-diagram-totalfosfor-trendvattendrag-1997-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Totalfosfor i trendsjöar"}},{"@id":"urn:uuid:f370611d-d3ba-9489-bcf8-364c2dbeb74a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.ad23bfe185cbe8fec87750/1674220112648/officiell-statistik-kartunderlag-totalfosfor-trendvattendrag-2019-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Totalfosfor i Trendvattendrag"}}],"@id":"urn:source:4aa28686a5385847ceabb0fd529a76212ff6a82b06c4df164d9af3b741443720"},{"@graph":[{"@id":"_:4abed8fc45af6f90a603ddb17246b2f39117c6d593ca0e8eab5425390b6c438e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Innehållet i Topografi 100 Nedladdning, vektor framställs genom automatisk generalisering av den grunddatamängd som ingår i Topografi 10 Nedladdning, vektor. Den automatiska generaliseringsprocessen (AG-processen) består av en mängd GIS-operationer som stegvis bearbetar data till att passa för presentation i en översiktlig kartskala. Innehållet struktureras om till viss del, vissa kartobjekt slås samman eller tas bort och ibland överdrivs de i storlek eller flyttas från varandra."}},{"@id":"_:4abed8fc45af6f90a603ddb17246b2f39117c6d593ca0e8eab5425390b6c438e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/9de2cb7a-8162-44d9-9224-385b60ed0aec","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:ec66c0e8-0fc7-2093-c0a0-a52fc80723ab"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Produkten passar utmärkt som bakgrundskarta och som indata till GIS-tillämpningar. Den är lämplig att använda i skalområdena 1:30 000 - 1:100 000. Innehållet består bland annat av administrativa gränser, markslag, vägar, järnvägar, fjällinformation och höjdkurvor med 10 m ekvidistans."},"dct:identifier":"9de2cb7a-8162-44d9-9224-385b60ed0aec","dct:issued":{"@type":"xsd:date","@value":"2023-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:provenance":{"@id":"_:4abed8fc45af6f90a603ddb17246b2f39117c6d593ca0e8eab5425390b6c438e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:4abed8fc45af6f90a603ddb17246b2f39117c6d593ca0e8eab5425390b6c438e_b1n0"},"dct:title":{"@language":"sv","@value":"Topografi 100 Nedladdning, vektor"}},{"@id":"urn:uuid:ec66c0e8-0fc7-2093-c0a0-a52fc80723ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/topografi-100-nedladdning-vektor"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Topografi 100 Nedladdning, vektor"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Topografi 100 Nedladdning, vektor"}}],"@id":"urn:source:4abed8fc45af6f90a603ddb17246b2f39117c6d593ca0e8eab5425390b6c438e"},{"@graph":[{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Detta fylls inom kort"}},{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/eb4d21fa-f874-581a-6560-d048da0a9ab8","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},{"@id":"urn:uuid:fa5e702e-d659-d024-55f3-1776919633b3"}],"dcat:distribution":[{"@id":"urn:uuid:52b01117-3a5d-8d41-bd57-94e7399ddc40"},{"@id":"urn:uuid:ceebf03a-c1e3-c54e-6afb-74d51467f812"},{"@id":"urn:uuid:e9af6682-77f7-eba3-2e75-65c5f0111e45"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Områden med särskild förvaltning/begränsningar/reglering samt enheter för rapportering"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/am"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datat innehåller den geografiska avgränsningen av prövningsgrupper för omprövning av vattenkraftverk enligt den nationella planen för omprövning.\nI bilagan till förordning (1998:1388) om vattenverksamheter framgår prövningsgruppernas namn och tidpunkten för när ansökan senast ska lämnas in. Enligt 39 a § i samma förordning ska Havs- och vattenmyndigheten föra en förteckning över prövningsgrupperna samt kartor som visar prövningsgruppernas geografiska avgränsning.\nDen geografiska avgränsningen tillhör Havs- och vattenmyndighetens föreskrift HVMFS 2020:25."},"dct:identifier":"eb4d21fa-f874-581a-6560-d048da0a9ab8","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-26"},"dct:provenance":{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b1n0"},"dct:title":{"@language":"sv","@value":"Prövningsgrupper för vattenkraftverk"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndigheten"},{"@id":"urn:uuid:52b01117-3a5d-8d41-bd57-94e7399ddc40","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/provningsgrupper-for-vattenkraftverk/atom-provningsgrupper-for-vattenkraftverk-med-tidsplan-datafeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) för datamängden Prövningsgrupper för vattenkraftverk."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"AM.Prövningsgrupper för vattenkraftverk.ATOM"}},{"@id":"urn:uuid:ceebf03a-c1e3-c54e-6afb-74d51467f812","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/provningsgrupper-for-vattenkraftverk/2021-12-13/provningsgrupper-for-vattenkraftverk-2021-12-13.zip"},"dct:description":{"@language":"sv","@value":"Datamängden är en sammanslagning av SMHI:s delavrinningsområden för huvuddelen av Sverige. Dessa sammanslagna delavrinningsområden definierar därmed de prövningsgrupper som utgör grunden för de omprövningar av vattenkraftverk med flera verksamheter som definieras i 11 kap 6 § miljöbalken. Datamängden ska kompletteras med årtal."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Prövningsgrupper för vattenkraftverk - nedladdning"}},{"@id":"urn:uuid:e9af6682-77f7-eba3-2e75-65c5f0111e45","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/provningsgrupper-for-vattenkraftverk/ows?"},"dct:description":{"@language":"sv","@value":"Datat innehåller den geografiska avgränsningen av prövningsgrupper för omprövning av vattenkraftverk enligt den nationella planen för omprövning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Prövningsgrupper för vattenkraft WFS"}},{"@id":"urn:uuid:fa5e702e-d659-d024-55f3-1776919633b3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöprövningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöprövningsenheten"}],"@id":"urn:source:4b0232012b21a512f2abf133ac671028852d3a4cbade9a81b0d471399ac9e703"},{"@graph":[{"@id":"_:4b79c63838d5c19f22e629642c0e49a2126cad5f482c29ca1dcc9139f4efa2d1_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/02ebee3f-0644-04a3-c713-d73f5c22e33a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3c4fa969-0f10-376b-4c3a-33f51fdecf65"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Havs- och vattenmyndighetens bibliotek är ett specialbibliotek med inriktning på litteratur om myndighetens ansvarsområden, det vill säga bevarande, restaurering och hållbart nyttjande av sjöar, vattendrag, hav och fiskeresurserna.\n\nBibliotekskatalogen var sökbar 2021-2025. Då myndighetens tryckta samling numera är avvecklad är denna post och därmed katalogen arkiverad. Kontakta Havs- och vattenmyndighetens diarum för information om katalogens innehåll."},"dct:identifier":"02ebee3f-0644-04a3-c713-d73f5c22e33a","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Havs- och vattenmyndighetens bibliotekskatalog"}},{"@id":"urn:uuid:3c4fa969-0f10-376b-4c3a-33f51fdecf65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havs- och vattenmyndighetens diarium","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4b79c63838d5c19f22e629642c0e49a2126cad5f482c29ca1dcc9139f4efa2d1_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havs- och vattenmyndighetens diarium"}],"@id":"urn:source:4b79c63838d5c19f22e629642c0e49a2126cad5f482c29ca1dcc9139f4efa2d1"},{"@graph":[{"@id":"_:4b924f51af278912d6b3f05efbf8fa4eb123f131e9051ce26025232c8a8ab56a_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((3.8886158368996795 69.59284272672247,24.777081773352258 69.59284272672247,24.777081773352258 54.814440078929266,3.8886158368996795 54.814440078929266,3.8886158368996795 69.59284272672247))"}},{"@id":"_:4b924f51af278912d6b3f05efbf8fa4eb123f131e9051ce26025232c8a8ab56a_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE202