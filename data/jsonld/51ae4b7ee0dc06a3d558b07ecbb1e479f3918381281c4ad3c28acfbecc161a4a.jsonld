d":"https://www.geodata.se/resources/67a9d4c8-55f6-43fc-8da1-a3f873e264de","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d"},"dcat:endpointURL":{"@id":"https://geodpags.skogsstyrelsen.se/geodataport/feeds/biotopskydd.xml"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"ATOM-flöde för nedladdning (ZIP) av Biotopskydd på skogsmark beslutade av Skogsstyrelsen"},"dct:identifier":"67a9d4c8-55f6-43fc-8da1-a3f873e264de","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:title":{"@language":"sv","@value":"PS.Biotopskydd på skogsmark beslutade av Skogsstyrelsen.ATOM"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:10c2ea27-6f5f-cf0b-6c6b-9df129dd385d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kundtjänst","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:981909f0d2028f538f837fa95a1295fa35f6a8b46fa7ef3891f85b20e33b54bb_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:981909f0d2028f538f837fa95a1295fa35f6a8b46fa7ef3891f85b20e33b54bb_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"}],"@id":"urn:source:981909f0d2028f538f837fa95a1295fa35f6a8b46fa7ef3891f85b20e33b54bb"},{"@graph":[{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Folkhälsomyndighetens Nationella folkhälsoenkät är en urvalsundersökning bland befolkningen 16-84 år. Värden presenteras som icke åldersstandardiserade 4-årsmedelvärden på länsnivå."}},{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.00 69.00,26.00 69.00,26.00 55.00,11.00 55.00,11.00 69.00))"}},{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2018"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2004"}},{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-2052959"}},{"@id":"http://dataportal.se/organisation/SE2021006545","@type":"foaf:Agent","dct:identifier":"2021006545","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@folkhalsomyndigheten.se"},"foaf:name":{"@language":"sv","@value":"Folkhälsomyndigheten"},"foaf:page":{"@id":"https://www.folkhalsomyndigheten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://free.entryscape.com/store/360/resource/1"}},{"@id":"https://www.geodata.se/resources/7fc28e72-9b3b-49e9-bf92-0b5d3c98c833","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:4efcc007-937e-b37e-6504-86b90374062c"},"dcat:distribution":[{"@id":"urn:uuid:0a9e6c85-6eb8-c744-91e0-ef4a0f0487e0"},{"@id":"urn:uuid:312559d1-bb8c-e352-7635-c26eb1b095df"},{"@id":"urn:uuid:5060281e-5f26-8722-3855-aedcfa968110"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Människors hälsa och säkerhet"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/hh"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Redovisningen bygger på fråga i Nationella folkhälsoenkäten: Röker du dagligen? Nationella folkhälsoenkäten är en urvalsundersökning\nbland befolkningen 16-84 år. Värden presenteras som icke åldersstandardiserade 4-årsmedelvärden. Data presenteras på länsnivå."},"dct:identifier":"7fc28e72-9b3b-49e9-bf92-0b5d3c98c833","dct:issued":{"@type":"xsd:date","@value":"2100-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2100-01-01"},"dct:provenance":{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006545"},"dct:spatial":{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b1n0"},"dct:temporal":{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b2n0"},"dct:title":{"@language":"sv","@value":"Daglig tobaksrökning"}},{"@id":"urn:uuid:0a9e6c85-6eb8-c744-91e0-ef4a0f0487e0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geonode.folkhalsomyndigheten.se/maps/new?layer=geonode:DagligTobak_LANKarta_region"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Geonode - FOHM"}},{"@id":"urn:uuid:312559d1-bb8c-e352-7635-c26eb1b095df","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://app.statisticsstudio.com/public/player?type=appref&id=78e0c500-796c-411e-984d-cc73ba0adb95"},"dct:description":{"@language":"sv","@value":"Folkhälsomyndigheten - Folkhälsostudio"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Folkhälsostudio"}},{"@id":"urn:uuid:4efcc007-937e-b37e-6504-86b90374062c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Folkhälsomyndigheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:folkhalsostudio@folkhalsomyndigheten.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949_b4n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Folkhälsomyndigheten"},{"@id":"urn:uuid:5060281e-5f26-8722-3855-aedcfa968110","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geonode.folkhalsomyndigheten.se/geoserver/ows?service=WFS&version=1.0.0&request=GetFeature&typename=geonode%253ADagligTobak_LANKarta_region&outputFormat=SHAPE-ZIP&srs=EPSG%253A3006&format_options=charset%253AUTF-8"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Geonode - FOHM"}}],"@id":"urn:source:9840ceedb900dbfe896ecce7dbaf01da82a9a13206c190e50610a68726c4f949"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/7567faa4-f034-49aa-a99c-539b7ab47d30","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://share.scb.se/OV0105/Xml/PD/pd_befolkningsfordelning_kon_atom_nt.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik redovisas för Rutor (1x1 km). Statistiken avser 2024-12-31."},"dct:identifier":"7567faa4-f034-49aa-a99c-539b7ab47d30","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:title":{"@language":"sv","@value":"PD.Befolkningsfördelning.Kön.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9884985fcbaf1df0d94b8868d99340dc69b3df7a23417ffa90e33cfc7f2b90a7"},{"@graph":[{"@id":"_:99022bef27a00fe63577109614e871c317d42b91df1a7f302d9454f57797a4c8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen baseras på SGUs produkt Jordarter 1:1 million, och har transformerats för att överensstämma med Inspire dataspecifikation för tema Geologi, genom kodning enligt GeoSciML 4.1. \nDatamängden är en sammanslagning av de tidigare produkterna Berggrund 1:50 000 och Berggrund 1:250 000. Informationen bygger på kartläggningar som påbörjades på 1960-talet och pågår än idag. Kartläggningen har under åren utförts med olika metoder, med olika observationstäthet på skiftande geografiskt underlag samt för presentationsskalor från 1:50 000 till 1:250 000. Den tidiga informationen har digitaliserats från tryckt kartunderlag. Från slutet av 1990-talet produceras data i digital miljö. Många kartlagda områden har publicerats som tryckta kartor inom SGUs serier Af, Ai, Ba, Ca och K och till dessa finns ofta utgivna beskrivningar som innehåller kompletterande information om arbetsmetoder och geologiska förhållanden. Information om dessa beskrivningar finns på www.sgu.se. \nEftersom olika karteringsmetoder har tillämpats i olika områden och under olika perioder, så är produktens kvalitet inte enhetlig utan skiljer sig från område till område. Den mest detaljerad kartläggningen, som bygger på omfattande fältarbete har utförts främst i tätbefolkade och prospekteringsintressanta områden i delar av södra och norra Sverige.\n\nGemensamt för alla metoder är att de bygger på observationer i fält av berghällar. Den insamlade informationen grundas i huvudsak på okulär bedömning. Prover för mikroskopundersökning, kemiska bergartsanalyser, petrofysiska analyser, åldersbestämningar m.m. tas i varierande omfattning. Information från externa källor, i första hand prospekteringsrapporter och forskningarbeten ställs samman och används i förekommande fall."}},{"@id":"_:99022bef27a00fe63577109614e871c317d42b91df1a7f302d9454f57797a4c8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.006066050558 68.826177947333,25.489895879277 68.826177947333,25.489895879277 55.083847482766,11.006066050558 55.083847482766,11.006066050558 68.826177947333))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/eb187085-be16-4b45-aa95-c49f06765b07","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:386d9731-f673-c1ed-7fc2-56df1f00225a"},{"@id":"urn:uuid:7313de95-def3-0e4b-33c3-8bea8f5a588b"},{"@id":"urn:uuid:813c0aac-58ed-c57e-6178-b06a924779d1"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"GE.Jordarter 1:1 miljon är en transformerad version av SGUs produkt Jordarter 1:1 miljon i syfte att uppfylla Inspire dataspecifikation för tema Geologi genom kodning enligt GeoSciML 4.1.\n\nProdukten är rikstäckande och återger huvuddragen i Sveriges jordartsgeologi. Noggrannheten varierar eftersom den är en sammanställning baserad på jordartskartor i olika skalor och med skiftande kvalitet. Kartbilden är mycket kraftigt generaliserad och jordartsindelningen är grovt förenklad. Minsta redovisade yta är ca 1 km2. Informationen är endast avsedd att använda för översikter på nationell nivå, och bör utnyttjas med försiktighet i analyssammanhang."},"dct:identifier":"eb187085-be16-4b45-aa95-c49f06765b07","dct:issued":{"@type":"xsd:date","@value":"2018-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2019-01-21"},"dct:provenance":{"@id":"_:99022bef27a00fe63577109614e871c317d42b91df1a7f302d9454f57797a4c8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:99022bef27a00fe63577109614e871c317d42b91df1a7f302d9454f57797a4c8_b1n0"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:1 miljon"}},{"@id":"urn:uuid:386d9731-f673-c1ed-7fc2-56df1f00225a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_1M"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Inspire visningstjänster"},"dct:title":{"@language":"sv","@value":"Inspire View Services"}},{"@id":"urn:uuid:7313de95-def3-0e4b-33c3-8bea8f5a588b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Surficial-1m?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"undefined"},"dct:title":{"@language":"sv","@value":"undefined"}},{"@id":"urn:uuid:813c0aac-58ed-c57e-6178-b06a924779d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/atom/inspire/datasets/GE_SGU_Surficial_1M.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av SGU-data inom Inspire."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (RSS/Atomflöde)"}}],"@id":"urn:source:99022bef27a00fe63577109614e871c317d42b91df1a7f302d9454f57797a4c8"},{"@graph":[{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data från flygmätningar har samlats in sedan 1968. Flyghöjd över marken, mätlinjeseparation och navigeringssystem har modifierats med tiden. Likaså har sensorer uppdaterats med förbättrad känslighet och upplösning.\n\nNaI-detektorer med kristallvolymer från 6 till 16 liter har använts i samtliga mätningar. Kalibrering av SGU:s system görs på plattor med kända koncentrationer av K, U och Th på Dala Airport, samt med flygningar på olika höjder över hav för korrektion av bakgrund och kosmisk strålning.\n\nMätpunktsavståndet är 16 till cirka 60 meter, beroende på vilket mätsystem som använts. Mätlinjeavståndet är normalt 200 meter över land och 400 till 1000 meter över hav och i fjällområden. Till och med år 1994 var den nominella flyghöjden 30 meter, från och med 1995 är den 60 meter.\n\nMätvärdena i en mätpunkt representerar medelvärdet över en större yta på marken ner till några decimeters djup. För uran och torium har radiometrisk jämvikt förutsatts i sönderfallskedjan. \nEn sammanvägd, relativ kvalitetsbedömning har gjorts på data och redovisas som ett kvalitetsvärde (QUALITY) från 1 och uppåt, där 1 är lägsta kvalitet. Kvalitetsbedömningen utgår huvudsakligen från vilket mätsystem som använts. Generellt sett har modernare mätningar högre kvalitet än äldre."}},{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1968"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ba484649-0ec8-4149-94cf-3a8cce58746b","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0ae2be3e-3cf9-a3e8-27df-143b2cb0936f"},{"@id":"urn:uuid:29764f55-c7a4-ef2e-0d54-722f1c0b6286"},{"@id":"urn:uuid:29ea028c-3fa0-3790-dd7d-96a20e55b25c"},{"@id":"urn:uuid:49317579-1f1f-0296-1f21-7da1cc5784b5"},{"@id":"urn:uuid:b00cab08-78e9-d696-014c-393634a95eab"},{"@id":"urn:uuid:d7f3f2fc-d1af-71be-90bb-9dbf80786fb3"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"sv","@value":"Gammastrålning är en del av människans naturliga miljö. Delar av strålningen kommer från marken under oss, det vill säga från berggrunden och jordarterna.\n\nGeofysiska flygmätningar, gammastrålning (detaljerad) innehåller information om halter av de naturligt förekommande radioaktiva isotoperna K-40 (kalium), U-238 (uran) och Th-232 (torium), i markens översta delar. Halterna är beräknade ur mätningar gjorda från flygplan på låg höjd.\n\nMätvärdena i en mätpunkt representerar medelvärdet över en större yta på marken ner till några decimeters djup. För uran och torium har radiometrisk jämvikt förutsatts i sönderfallskedjan."},{"@language":"sv","@value":"Gammastrålningsinformation, dvs. information om joniserande strålning ifrån marken, används framför allt vid berggrundsgeologiska undersökningar, som underlag vid radonundersökningar och i arbetet för en säker strålmiljö. Med hjälp av gammastrålningsmätningar kan markens halt av de naturligt förekommande radioaktiva isotoperna av kalium, uran och torium beräknas. För mätningar gjorda 1986 och därefter kan, p.g.a Tjernobylolyckan, även cesiumbeläggningen beräknas. Mätningarnas ursprungliga ändamål var att kartlägga Sveriges urantillgångar. Andra användare än SGU och Strålsäkerhetsmyndigheten är konsulter i geo- och radonbranschen, prospektörer samt kommuner och länsstyrelser."}],"dct:identifier":"ba484649-0ec8-4149-94cf-3a8cce58746b","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b1n0"},"dct:temporal":{"@id":"_:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8_b2n0"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, gammastrålning (detaljerad)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0ae2be3e-3cf9-a3e8-27df-143b2cb0936f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/om-sgu/verksamhet/kartlaggning/geofysik_att_se_ner_i_berget/flyggeofysisk-matning/"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sveriges geologiska undersökning"}},{"@id":"urn:uuid:29764f55-c7a4-ef2e-0d54-722f1c0b6286","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-gammastralning-detaljerad/geofysik-flyg-gammastralning-detaljerad.zip"},"dct:description":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: GeoPackage med flygområden"}},{"@id":"urn:uuid:29ea028c-3fa0-3790-dd7d-96a20e55b25c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/geofysik-flyg-gammastralning-detaljerad/1969_FJAB_10086.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP: Exempel XYZ-fil för flygområde 1995_FJBE_329"}},{"@id":"urn:uuid:49317579-1f1f-0296-1f21-7da1cc5784b5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/index.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:b00cab08-78e9-d696-014c-393634a95eab","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/geofysik-flyg-gammastralning-detaljerad/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:d7f3f2fc-d1af-71be-90bb-9dbf80786fb3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/geofysiska-flygmatningar-gammastralning-detaljerad-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}}],"@id":"urn:source:996eeb42bcce6b643dc0f60ed9404dd570a972e27fa5b3af7d456cf8687b85f8"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ca7d5807-f3c0-4229-8014-c22d7e12895a","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-1-miljon"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Kartan återger huvuddragen i Sveriges jordartsgeologi. Noggrannheten varierar eftersom den är en sammanställning baserad på jordartskartor i olika skalor och med skiftande kvalitet. Kartbilden är mycket kraftigt generaliserad och jordartsindelningen är grovt förenklad. Minsta redovisade yta är ca 1 km2. Informationen är endast avsedd att använda för översikter på nationell nivå, och bör utnyttjas med försiktighet i analyssammanhang."},"dct:identifier":"ca7d5807-f3c0-4229-8014-c22d7e12895a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jordarter 1:1 miljon (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:996fa6201eb60ef18040324e414d92c07897c5c15ac4e3330321b9440e5ecb51"},{"@graph":[{"@id":"_:998a139391f61cc136516d2dd935c02ed0390418d177c636ebbe6545e2c4f095_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ad1e234f-d765-4c47-9ebc-1c2bd51cc544","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:endpointURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_am/ows?"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Metadatastandarden ISO19139/119 är den föredragna metadatastandarden som ska användas för tjänster (WMS, WFS, WCS)."},"dct:identifier":"ad1e234f-d765-4c47-9ebc-1c2bd51cc544","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"SE.LST INSPIRE AM Visningstjänst (WMS)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:998a139391f61cc136516d2dd935c02ed0390418d177c636ebbe6545e2c4f095_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"}],"@id":"urn:source:998a139391f61cc136516d2dd935c02ed0390418d177c636ebbe6545e2c4f095"},{"@graph":[{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.6911 61.0559,14.4759 61.0559,14.4759 58.7256,11.6911 58.7256,11.6911 61.0559))"}},{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.71152 61.03479,14.28181 61.03479,14.28181 59.15959,11.71152 59.15959,11.71152 61.03479))"}},{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/83ad0007-d560-4c22-9438-83a01af7abdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3a7df11c-b439-e261-1d62-206b100e777c"},"dcat:distribution":[{"@id":"urn:uuid:73997355-5416-c844-5f65-991a42baadea"},{"@id":"urn:uuid:7b362c2f-92a5-081e-b826-b2b05ef2c97d"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Områden där det pågår reservatsbildning i Värmlands län"},"dct:identifier":"83ad0007-d560-4c22-9438-83a01af7abdf","dct:issued":{"@type":"xsd:date","@value":"2020-05-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b0n0"},{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b1n0"}],"dct:title":{"@language":"sv","@value":"LstS Pågående naturreservatsbildning (Extern)"}},{"@id":"urn:uuid:3a7df11c-b439-e261-1d62-206b100e777c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstS Naturvårdsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varmland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstS Naturvårdsenheten"},{"@id":"urn:uuid:73997355-5416-c844-5f65-991a42baadea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsts.LstS_natres_pg_extern.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:7b362c2f-92a5-081e-b826-b2b05ef2c97d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTS/LstS_Naturreservat_ext/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:9b9445fc7b921be05a40fac563f9a1a2ff5bda0cb646857eb52751597182a572"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/339d3817-9a70-41d5-85e6-4c06178903bf","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/biogeokemi-regional?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Biogeokemi, regional provtagning visar provtagningsplatser samt analysresultat för ett urval av grundämnen inom den regionala biogeokemiska undersökningen på Sveriges geologiska undersökning (SGU). Provtagningsplatserna visas indelade efter de analysmetoder som använts på proverna: Totalhalt XRF, Salpetersyralakning AAs och ICP-MS samt Kungsvattenlakning AAs och ICP-MS.\n\nGeokemisk kartering vid SGU bedrivs huvudsakligen i syfte att visa den naturliga förekomsten av huvudämnen och spårämnen i vattenväxter samt pH i vatten. Inom regional biogeokemisk kartering provtogs och analyserats bäckvattenväxter, som olika Carex-arter (rötter), Filipendula ulmaria (rötter) och Fontinalis antipyretica (hela växten). Växter samlades från mindre bäckar med en provtäthet av 1 prov per 7 km2.\n\nBäckvattenväxter (rötter) och mossa anses vara provmedier som utan åtskiljning tar upp spårelement och därför avspeglar bäckvattenkemin. Bäckvattenväxter utsätts för både naturlig och antropogen påverkan. På grund av kemiska vittringsprocesser visar metallkoncentrationerna i bäckvatten på den kemiska sammansättningen i omgivande berggrund och jord. Utbytet av metaller mellan vatten och växtrötter är en långsam process som verkar inte påverkas av säsongsvariationer. Man kan uppskatta att biogeokemiska prov visar biotillgängliga metallkoncentrationer i akvatiska växter.\n\nHuvud- och spårelement i som analyseras i växtprov kommer ursprungligen från de levande rötterna och bladmossan, samt från minerogent material och järn-manganhydroxider som är associerade med växten. Andra geokemiska källor, till exempel humuspartiklar, anses ha mindre betydelse.\n\nProvresultaten visar hur spridningsmönster av olika grundämnen i vattendragen varierar inom landet. Variation beror på såväl det naturliga tillskottet från jordarter och berggrund som på tillskottet från olika föroreningskällor."},"dct:identifier":"339d3817-9a70-41d5-85e6-4c06178903bf","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Biogeokemi, regional provtagning (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9ba44d0e1ae512e9b587fa28b8c64cbcb8eb79595f09f4606855b1414317043c"},{"@graph":[{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se https://gis.sgi.se/dokument/geodatasezip/erosionspaketet_innehåll.xls"}},{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.87 58.36,12.39 58.36,12.39 57.73,11.87 57.73,11.87 58.36))"}},{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2012-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2009-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/a6e2da4b-89f5-44b1-a453-316006054135","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:2b3ea605-5848-32d3-3fe2-f541554c735e"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Innehåll: sedimentprover, erosionsskydd över vattenytan, särskilda erosionsområden, bottenivåförändring 2003-2009, se vidare https://gis.sgi.se/dokument/geodatasezip/erosionspaketet_innehåll.xls och GÄU_delrapport_1.pdf \n\nSamtliga rapporter  från GÄU: https://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar/gota-alv/verktyg-underlag-och-rapporter/\n[Geoteknik]"},"dct:identifier":"a6e2da4b-89f5-44b1-a453-316006054135","dct:issued":{"@type":"xsd:date","@value":"2012-03-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b1n0"},"dct:temporal":{"@id":"_:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c_b2n0"},"dct:title":{"@language":"sv","@value":"GÄU Göta älvutredningen: Erosion - datapaket"}},{"@id":"urn:uuid:2b3ea605-5848-32d3-3fe2-f541554c735e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_erosionspaketet_120801.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}}],"@id":"urn:source:9c14d686344d21f765aff248ab88263e8d2b31ad381f16b493a049eca1b7147c"},{"@graph":[{"@id":"_:9c2372c0fa856029bc839901ab29991924b821ae0b17d18c5c84c1f551a7b614_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/39be184c-91aa-4d63-9536-f832a40f10b2","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7"},"dcat:endpointURL":{"@id":"https://ext-geodata-applikationer.lansstyrelsen.se/arcgis/services/LST/lst_nationella_vardetrakter/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Karttjänst som sammanställer de olika Länsstyrelsernas värdetrakter, framtagna inom arbetet med grön infrastruktur, för olika naturtyper. Om det saknas trakter för något län kan det bero på två saker; antingen har de inte valt att slå samman sitt läns skikt med övriga län eller så har de inte analyserat naturtypen. Länen har inte nödvändigtvis haft samma metodik för att ta fram sina värdetrakter.\nVärdetrakterna beskriver områden med högre koncentrationer av värden och värdekärnor än omgivande landskap. De ska utgöra underlag för prioritering av insatser i jord- och skogsbruk, naturvårdsinsatser samt fungera som underlag vid prövning och planering. Trakterna ska inte likställas med områdesskydd.\nFör mer information om länens metoder för framtagning av trakter och eventuell redovisning av föreslagna trakter hänvisar vi till respektive Länsstyrelse."},"dct:identifier":"39be184c-91aa-4d63-9536-f832a40f10b2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:title":{"@language":"sv","@value":"LST (GI) Nationella Värdetrakter - Karttjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:263bb01a-afad-f4c5-b916-cae43056c5f7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Natur","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9c2372c0fa856029bc839901ab29991924b821ae0b17d18c5c84c1f551a7b614_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-natur@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Natur"}],"@id":"urn:source:9c2372c0fa856029bc839901ab29991924b821ae0b17d18c5c84c1f551a7b614"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8d433e20-0664-49f5-8445-b23d10bd7f16","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/marina-sedimentprov"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten Marina sedimentprover innehåller uppgifter om sedimentprover med avseende på jordarternas beskaffenhet samt för några utvalda provplatser även ytsedimentens innehåll av utvalda grundämnen, oorganiska föreningar och organiska miljöföroreningar. Observationerna är gjorda i samband med SGUs reguljära maringeologiska kartläggning eller vid uppdrag där uppdragsgivaren har tillåtit publicering av data.\n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Den information som tas fram används som underlag för till exempel planering av- och beslut om skydd eller nyttjande av havsbottnen, vid projektering av marina anläggningsarbeten och miljöövervakning. Den utgör också ett viktigt underlag för biologiska inventeringar och Försvarsmakten."},"dct:identifier":"8d433e20-0664-49f5-8445-b23d10bd7f16","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Marina sedimentprov (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9c59d71913db94ff17f450c5270b51b695b70114b9f3bc7a332c6bb09b12e1b6"},{"@graph":[{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.0301 69.0617,24.2195 69.0617,24.2195 54.9804,10.0301 54.9804,10.0301 69.0617))"}},{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.20993 57.1885,14.63167 57.1885,14.63167 55.38151,12.20993 55.38151,12.20993 57.1885))"}},{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/c6830c65-edfc-4509-8099-6536e3f851ee","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b"},"dcat:distribution":[{"@id":"urn:uuid:42f1c299-b0bc-0614-9062-034852c0997e"},{"@id":"urn:uuid:4cc7c78f-0a81-6195-05a0-20d423fc4ab1"},{"@id":"urn:uuid:561241d9-9bd8-fa1f-bb28-86175b82d862"},{"@id":"urn:uuid:f21bb8aa-9027-d6c5-5364-8445241a43ef"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Länsstyrelsernas skikt över sjöar passande för skopning med skogsbrandflyg, flygplan och helikopter. Sjöarna är ett urval (ca 40000 st) där ca 3600 st är teoretiskt sett möjliga att använda för flygplanskopning. Sedan anger varje län baserat efter okulär besiktning av ortofoton och andra grunddata om sjöarna är lämpliga för vilket flygcertifikatstyp (alfa, bravo, charlie) och om de är lämpliga för skopning med helikopter.\n\nSjöarna har även klassats om de berör skyddad natur såsom nationalpark, naturreservat, natura2000, djur- och växtskydd, tillträdesförbud, vattenskydd, artskydd mm. Djup från SMHIS sjöregister samt ett index på deras flikighet.\n\nMer utförlig metodbeskrivning finns via länk i metadataposten."},"dct:identifier":"c6830c65-edfc-4509-8099-6536e3f851ee","dct:issued":{"@type":"xsd:date","@value":"2020-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-09-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b0n0"},{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Sjöar för skopning - skogsbrand"}},{"@id":"urn:uuid:41a18fdf-a6c3-73a4-3ea0-d2982f1ed19b","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällskydd och beredskap","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo.samhallsskydd.och.beredskap@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällskydd och beredskap"},{"@id":"urn:uuid:42f1c299-b0bc-0614-9062-034852c0997e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Skogsbrandflyg_EXT/MapServer/3"},"dct:description":{"@language":"sv","@value":"Sjöar för skopning - skogsbrandflyg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST länk"}},{"@id":"urn:uuid:4cc7c78f-0a81-6195-05a0-20d423fc4ab1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Referensdokument/Dokumentation_och_process_for_framtagande-LST_Sjoar_for_brandflyg.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Dokumentation_och_process_for_framtagande-LST_Sjoar_for_brandflyg.pdf"}},{"@id":"urn:uuid:561241d9-9bd8-fa1f-bb28-86175b82d862","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Skogsbrandflyg_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST Sjöar för skopning - brandflyg"},"dct:title":{"@language":"sv","@value":"1"}},{"@id":"urn:uuid:f21bb8aa-9027-d6c5-5364-8445241a43ef","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Skogsbrandflyg_EXT/MapServer/2"},"dct:description":{"@language":"sv","@value":"Sjöar för skopning - Helikopter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST länk"}}],"@id":"urn:source:9c5c1027b541892f5828e2468120505fd07217d9954ce9eef856c9397a38261f"},{"@graph":[{"@id":"_:9ca57616857636b36a7b9115098721afd012f35bd4796d329c8d232bed4c0298_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Bedömningen av månadens grundvattensituation tas fram genom att jämföra aktuella grundvattennivåer i mitten av månaden med månadens genomsnittliga nivå sedan 1970-talet. Kartan utgår från ett urval av de 330 observationsrör i SGUs grundvattennät där grundvattennivån mäts två gånger per månad."}},{"@id":"_:9ca57616857636b36a7b9115098721afd012f35bd4796d329c8d232bed4c0298_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/6951b494-d315-4004-8703-1dc943b22f7c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:17f94581-f191-ebaa-7ffe-2c03c1e96381"},{"@id":"urn:uuid:6e9c9877-8ac9-763d-5ebb-d293dfe9d353"},{"@id":"urn:uuid:80174bab-fe96-2e98-b3c0-9a115b98768b"},{"@id":"urn:uuid:94213033-75e8-2d2f-a052-497256bbc9eb"},{"@id":"urn:uuid:ea7aff54-79c2-4e6e-07bd-8f28c14ee601"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Bedömningen av månadens grundvattensituation tas fram genom att jämföra aktuella grundvattennivåer i mitten av månaden med månadens genomsnittliga nivå sedan 1970-talet. Kartan utgår från ett urval av de 330 observationsrör i SGUs grundvattennät där grundvattennivån mäts två gånger per månad, datum som redovisas i tabellen är satt till den 15:e i varje månad men redovisningen gäller ett medelförhållande under månaden."},"dct:identifier":"6951b494-d315-4004-8703-1dc943b22f7c","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-02-24"},"dct:provenance":{"@id":"_:9ca57616857636b36a7b9115098721afd012f35bd4796d329c8d232bed4c0298_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9ca57616857636b36a7b9115098721afd012f35bd4796d329c8d232bed4c0298_b1n0"},"dct:title":{"@language":"sv","@value":"Månadskarta över grundvattensituationen"}},{"@id":"urn:uuid:17f94581-f191-ebaa-7ffe-2c03c1e96381","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU. Beskrivning av API för nedladdning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}},{"@id":"urn:uuid:6e9c9877-8ac9-763d-5ebb-d293dfe9d353","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/grundvatten/manadskarta-grundvattensituationen-api.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:80174bab-fe96-2e98-b3c0-9a115b98768b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/manadskartan-grundvattensituationen-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:94213033-75e8-2d2f-a052-497256bbc9eb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/manadskarta-grundvattensituationen-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:ea7aff54-79c2-4e6e-07bd-8f28c14ee601","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-grundvattenniva.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:9ca57616857636b36a7b9115098721afd012f35bd4796d329c8d232bed4c0298"},{"@graph":[{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Statistiken avser folkbokförd befolkning beräknad från adresser i Registret över Totalbefolkningen (RTB). Koordinater hämtas från Lantmäteriets Fastighetsdatabas och Adressdatabas. \n\nData avser befolkade rutor. En statistisk metod används för att skydda enskildas uppgifter i den redovisade statistiken. På grund av detta är inte alltid de redovisade totalerna lika med summan av deras redovisade delar. Rutor utan befolkning är inte del av data. \n\nInspire koden bildas av Northing (Y) och Easting (X) och representerar rutans nedre vänstra hörn. Även upplösningen samt koordinatsystem finns i koden. Koden blir 31-ställig."}},{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-12-31"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/efb52885-a112-402e-9286-e942227d6385","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:aa7ac0c1-b5ad-057b-7bb9-2ded8f669507"},{"@id":"urn:uuid:baf3e93a-6654-befb-589d-ac308f7e3257"},{"@id":"urn:uuid:d2d5fdca-a77c-f1b6-e850-834c1edb0109"}],"dcat:keyword":[{"@language":"sv","@value":"Befolkningsfördelning – demografi"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/pd"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Befolkningsstatistik redovisas för Rutor (1x1 km). Statistiken avser 2024-12-31."},"dct:identifier":"efb52885-a112-402e-9286-e942227d6385","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-05"},"dct:provenance":{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b1n0"},"dct:temporal":{"@id":"_:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3_b2n0"},"dct:title":{"@language":"sv","@value":"PD.Befolkningsfördelning.5årsklasser"}},{"@id":"urn:uuid:aa7ac0c1-b5ad-057b-7bb9-2ded8f669507","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://share.scb.se/OV0105/Xml/PD/pd_befolkningsfordelning_5arsklasser_atom_nt.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning i GML format"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atomflöde Befolkningsfördelning 5-årsklasser"}},{"@id":"urn:uuid:baf3e93a-6654-befb-589d-ac308f7e3257","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"SCB:s öppna geodata"}},{"@id":"urn:uuid:d2d5fdca-a77c-f1b6-e850-834c1edb0109","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/inspire/PD.StatisticalDistribution.AgeBy5YearsValue/ows?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Befolkningsfördelning 5årsklasser WMS"}}],"@id":"urn:source:9cebe1f49e0f7268246cbbdcabc6a8790990f5d66549418221c7a6e502de2da3"},{"@graph":[{"@id":"_:9d09024976ef5be3d2b1d5bef32c392f87970d12e3965492877acb366e4e793e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data avseende djupinformation har sitt ursprung i sjömätningar från 1820 och framåt. Nautisk information uppdateras dagligen. Övrig data kommer från externa källor."}},{"@id":"_:9d09024976ef5be3d2b1d5bef32c392f87970d12e3965492877acb366e4e793e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/D898BE1A-24B5-4C6D-81AE-B5C2C6A25ACA","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:bd1a3749-246e-d636-7e64-225e508f3f5f"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Korten täcker hela Sveriges skärgård. De används vid navigering inomskärs och i kustnära områden.\nSkalan är vanligtvis 1:50 000."},"dct:identifier":"D898BE1A-24B5-4C6D-81AE-B5C2C6A25ACA","dct:issued":{"@type":"xsd:date","@value":"2012-10-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-10-17"},"dct:provenance":{"@id":"_:9d09024976ef5be3d2b1d5bef32c392f87970d12e3965492877acb366e4e793e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:9d09024976ef5be3d2b1d5bef32c392f87970d12e3965492877acb366e4e793e_b1n0"},"dct:title":{"@language":"sv","@value":"Sjökort - Skärgårdskort"}},{"@id":"urn:uuid:bd1a3749-246e-d636-7e64-225e508f3f5f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Sjofart/Sjokort/"},"dct:description":{"@language":"sv","@value":"Sjökort och Publikationer på Sjöfartsverkets officiella hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjökort och Publikationer"}}],"@id":"urn:source:9d09024976ef5be3d2b1d5bef32c392f87970d12e3965492877acb366e4e793e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://www.geodata.se/resources/e61fb610-22e0-11ed-832f-911b23582b4f","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-view.smhi.se/oc-obs-seatemperature/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten är en WMS-tjänst som visar oceanografiska stationer som mäter havstemperatur. Tjänsten visar alla stationer som någonsin levererat data. Data är insamlad från fartyg (FERRYBOX) eller havsbojar."},"dct:identifier":"e61fb610-22e0-11ed-832f-911b23582b4f","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havstemperatur: Visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9de357ca1c24a419f3ea28959b2567ed3e1669999b2c3f7725f90aea4ee66dcb"},{"@graph":[{"@id":"_:9e2e9090969ea2db3486788495b36b9e73ac80541a9aaee2ebf6a9dd59088c8a_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.80938 58.18724,16.31578 58.18724,16.31578 56.53459,12.80938 56.53459,12.80938 58.18724))"}},{"@id":"_:9e2e9090969ea2db3486788495b36b9e73ac80541a9aaee2ebf6a9dd59088c8a_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/35c711be-1ffa-49db-898f-53fcfc536f5e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9"},"dcat:distribution":{"@id":"urn:uuid:870016a6-2d94-59fc-bddd-37f7ef0470a1"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Uppgifter om kvicksilverhalten i gädda i olika sjöar i Jönköpings län. Riktade medelvärden (mg Hg/kg) dvs mätvärdena är omräknade för att motsvara 1 kg fisk. Tidigaste uppgift 1972. Miljöövervakning inom programområdena \"Sjöar och vattendrag\" och \"Hälsa\". Endast senaste mätningen för varje vatten är med."},"dct:identifier":"35c711be-1ffa-49db-898f-53fcfc536f5e","dct:issued":{"@type":"xsd:date","@value":"2001-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2001-01-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:9e2e9090969ea2db3486788495b36b9e73ac80541a9aaee2ebf6a9dd59088c8a_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Kvicksilver i gädda - senaste mätningarna"}},{"@id":"urn:uuid:870016a6-2d94-59fc-bddd-37f7ef0470a1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_miljoovervakning_EXT/MapServer/1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9e2e9090969ea2db3486788495b36b9e73ac80541a9aaee2ebf6a9dd59088c8a_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Vattenenheten"}],"@id":"urn:source:9e2e9090969ea2db3486788495b36b9e73ac80541a9aaee2ebf6a9dd59088c8a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/a9881bb1-2067-40cd-863a-5a06d3e34d18","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/inspire/GE-Jordarter_1M"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Datamängden GE.Jordarter 1:1 miljon täckande hela Sverige visas i denna OGC WMS-tjänst. Lager som ingår är geologiska enheters litologi och ålder. I denna tjänst visas attribut enligt GeoSciML Lite 4.1 och med symbolisering enligt INSPIRE dataspecifikation för geologi."},"dct:identifier":"a9881bb1-2067-40cd-863a-5a06d3e34d18","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"GE.Jordarter 1:1 miljon (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9e3fbc0446aca0a0e6fc351ac245cbf2f81aa97722f7abcfac86a36a36fc4bd6"},{"@graph":[{"@id":"_:9e6ced619199260999db3523106ffff22b9bc151b6d6d6f7a69aeaf3dce0d5a9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För att avgränsa en grundvattenförekomst måste minst ett av följande tre kriterier vara uppfyllt enligt 1 kap 1 § SGU:s föreskrifter om kartläggning, riskbedömning och klassificering av status för grundvatten (SGU-FS 2023:1):\n\n-\tDet pågår eller är möjligt att göra vattenuttag som är större än 10 m3/dygn.\n-\tDet pågår eller är möjligt att göra vattenuttag som förser minst 50 personer med dricksvatten.\n-\tDet finns mänsklig påverkan som kan medföra betydande skada på grundvattenanslutna ytvattenförekomster eller grundvattenberoende terrestra ekosystem.\n\nInför varje förvaltningscykel används nytillkommen kunskap för att förbättra avgränsningen av Sveriges grundvattenförekomster. Ny kunskap kan till exempel komma efter att SGU har gjort en mer detaljerad kartläggning av det grundvattenmagasin som grundvattenförekomsten finns i, eller att vattenmyndigheterna har fått fram ny information i sin kartläggning.\n\nGrundvattnets status avseende kemi och kvantitet bedöms av vattenmyndigheterna, som också enligt miljöbalken fastställer miljökvalitetsnormer för grundvattenförekomsterna. Detta ger förekomsterna en rättsligt bindande ställning inom samhällsplaneringen."}},{"@id":"_:9e6ced619199260999db3523106ffff22b9bc151b6d6d6f7a69aeaf3dce0d5a9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/ab250f60-7f72-425d-a5bc-2bc9a13ff007","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:1a657efd-f705-f3aa-795c-df77e966816c"},{"@id":"urn:uuid:9bca2b61-3d64-44f3-fa41-1459a8f7517e"},{"@id":"urn:uuid:a0874298-12b2-5c35-afd8-63f24de9c312"},{"@id":"urn:uuid:b4332447-4f9b-963a-2530-35cc3ec5cab1"},{"@id":"urn:uuid:e688c024-689f-afa6-28f9-d2703a801fb0"},{"@id":"urn:uuid:f158e9f1-a5be-d85d-6e4d-a06549d9fd58"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten redovisar förekomster av grundvatten som utpekats inom vattenförvaltningen. Vattenförvaltningen arbetar med att uppfylla kraven i ramdirektivet för vatten (2000/60/EG) inklusive grundvattendirektivet (2006/118/EG) och övriga dotterdirektiv. Grundvattenförekomsternas gränser sammanfaller huvudsakligen med SGU:s grundvattenmagasin i sand och grus men är för sedimentära och kristallina akviferer särskilt avgränsade för vattenförvaltningens syften.\n\nVattenförvaltningens arbete genomförs i så kallade förvaltningscykler på sex år, varav den första förvaltningscykeln startade 2004. Produkten innehåller samtliga grundvattenförekomster som varit aktuella sedan den första förvaltningscykeln."},"dct:identifier":"ab250f60-7f72-425d-a5bc-2bc9a13ff007","dct:issued":{"@type":"xsd:date","@value":"2014-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:9e6ced619199260999db3523106ffff22b9bc151b6d6d6f7a69aeaf3dce0d5a9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9e6ced619199260999db3523106ffff22b9bc151b6d6d6f7a69aeaf3dce0d5a9_b1n0"},"dct:title":{"@language":"sv","@value":"Grundvattenförekomster"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:1a657efd-f705-f3aa-795c-df77e966816c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattenforekomster-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:9bca2b61-3d64-44f3-fa41-1459a8f7517e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/grundvatten/grundvattenforekomster-api.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:a0874298-12b2-5c35-afd8-63f24de9c312","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/oppna-data/"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU. Beskrivning av API för nedladdning av grundvattenförekomster."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna data vid SGU"}},{"@id":"urn:uuid:b4332447-4f9b-963a-2530-35cc3ec5cab1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/grundvattenforekomster/ogc/features/v1"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:e688c024-689f-afa6-28f9-d2703a801fb0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/grundvattenforekomster/grundvattenforekomster.zip"},"dct:description":{"@language":"sv","@value":"Information om öppna data vid SGU. Beskrivning av API för nedladdning av grundvattenförekomster."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:f158e9f1-a5be-d85d-6e4d-a06549d9fd58","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/grundvattenforekomster-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:9e6ced619199260999db3523106ffff22b9bc151b6d6d6f7a69aeaf3dce0d5a9"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/1eed77bb-4930-4a8e-9020-604a06cfed73","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://www.lantmateriet.se/sv/nationella-geodataplattformen/datamangder/befintliga-och-paborjade-datamangder/detaljplan/"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst som uppfyller Inspire-direktivet för informationen planerad markanvändning (Planned Land Use inom temat Land Use). Området är Sverige.  \nDataprodukten innehåller information om detaljplaner i Sverige. Det huvudsakliga syftet med  \nen detaljplan är att reglera användning av mark- och vattenområden samt bebyggelse.\nMed detaljplan avses sådan plan som beskrivs i 4 kap 2 § Plan- och bygglagen (2010:900) (PBL). Dataprodukten kan även innehålla de planer som har upprättats med stöd av tidigare lagstiftning, och som enligt PBLs övergångsbestämmelser gäller som detaljplan. Dessa är byggnadsplan, stadsplan och avstyckningsplan.\nKommunen kan välja att tillgängliggöra information när som helst i detaljplaneprocessen.\nDataprodukten kan därför innehålla information som ännu inte fått laga kraft. Detaljplaner påbörjade innan 2022-01-01 behöver inte tillgängliggöras digitalt och kan därför saknas i dataprodukten.\nDetaljplaneinformation har tagits fram på kommunal nivå sedan lång tid tillbaka. Under årens lopp har de lagar och rekommendationer som kommunerna haft att förhålla sig till förändrats.\nOlika kommuner arbetar också med detaljplaneprocessen på olika sätt. Detta gör att \nredovisningen av detaljplaneinformation ser olika ut."},"dct:identifier":"1eed77bb-4930-4a8e-9020-604a06cfed73","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Detaljplan - nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9e8ba99bbc38672ab47692719e50dd275c3a8c78b52f3871564dd9f880adeeb3"},{"@graph":[{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU är på uppdrag av Naturvårdsverket datavärd för data som insamlats inom miljöövervakningen. De nationella datavärdarna är ett system som inrättats för att öka tillgänglighet och leverans av olika typer av miljöövervakningsdata till samhället, bl.a. Miljöövervakning, havs och sjösediment. Data från övervakningen levereras till SGU av den organisation som utfört provtagningen, t.ex. Länsstyrelsen. En datavärds uppdrag är att leveranskontrollera och tillgängliggöra data. I uppdraget ingår också att ta fram vissa bearbetningar av data."}},{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1985"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/8d3c75a0-5a14-4e78-aadf-4685132426e9","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2068dc2f-cbb3-ce5f-bc97-ebf3ac8179c0"},{"@id":"urn:uuid:35237456-def1-4167-26d5-87a7363e2bfb"},{"@id":"urn:uuid:c9c99e4b-2f65-5535-7130-bb2ec46e3619"},{"@id":"urn:uuid:fc61bb4b-d93f-3a76-5a03-28f230bb3aae"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"I ”Miljöövervakning, havs och sjösediment” redovisas punktdata som samlas in inom ramen för nationell-, regional- och lokal miljöövervakning. Syftet är i första hand att redovisa tillstånd och trender av miljögiftsbelastning i sediment.\nAnalyserna görs på prover tagna från sediment i ackumulationsområden som ofta utgör en sänka för många grundämnen och miljögifter.\nDessa data kan laddas ned över valfritt län eller miljöövervakningsstation. Via SGUs kartvisare ”Miljöövervakning, havs- och sjösediment” erbjuds även grafisk presentation av tidsserier och statistisk information."},{"@language":"sv","@value":"Miljöövervakning har till syfte att ge en bild av tillståndet i miljön och att tillhandahålla underlagsdata för att upptäcka förändringar i miljön över tid. Ansvaret för den svenska miljöövervakningen ligger på Naturvårdsverket och Havs- och vattenmyndigheten. Vilka parametrar som övervakas styrs av uppsatta miljömål, krav i lagstiftning och EU-direktiv samt av Sveriges åtaganden inom internationella konventioner. Sveriges miljöarbete grundar sig i stor utsträckning på resultaten från den nationella miljöövervakningen.\nMiljöövervakningen i Sverige är uppdelad i olika programområden där Miljöövervakning, havs och sjösediment hamnar under programområdet \"Kust och hav\" och ska bland annat ge underlag för uppföljning av de nationella miljökvalitetsmålen. Framförallt är det fyra mål som särskilt berör havsmiljön: \"Hav i balans samt levande kust och skärgård\", \"Ingen övergödning\", \"Ett rikt växt- och djurliv\" samt miljömålet \"Giftfri miljö\". Läs mer om miljömålen på www.miljomal.se. \nSyftet med den nationella miljöövervakningen i sediment är i första hand att redovisa tillstånd och trender av miljögiftsbelastning i de större havsbassängerna: Bottenviken, Bottenhavet, egentliga Östersjön, Kattegatt och Skagerack. Finkorniga, recenta sediment som återfinns inom så kallade ackumulationsbottnar kan innehålla ansenliga mängder tungmetaller och miljögifter och utgöra sänkor för dessa ämnen. Kemisk analys av sedimentprover från ackumulationsbottnar har därför blivit ett betydelsefullt verktyg i miljöövervakningen."}],"dct:identifier":"8d3c75a0-5a14-4e78-aadf-4685132426e9","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-01"},"dct:provenance":{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b1n0"},"dct:temporal":{"@id":"_:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f_b2n0"},"dct:title":{"@language":"sv","@value":"Miljöövervakning, havs- och sjösediment"}},{"@id":"urn:uuid:2068dc2f-cbb3-ce5f-bc97-ebf3ac8179c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/oppnadata/marin/miljoovervakning-sediment-api.xml"},"dct:description":{"@language":"sv","@value":"Nedladdning av Öppna data vid SGU."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"SGU Öppna data nedladdningstjänst (RSS/Atomflöde)"}},{"@id":"urn:uuid:35237456-def1-4167-26d5-87a7363e2bfb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-miljoovervakning-sediment.html"},"dct:description":{"@language":"sv","@value":"Kartvisare för miljöövervakning marina sediment. Gränssnittet erbjuder statistiska funktioner och nedladdning av tidsseriedata."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare för miljöövervakning marina sediment"}},{"@id":"urn:uuid:c9c99e4b-2f65-5535-7130-bb2ec46e3619","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/oppnadata/miljoovervakning-sediment-oppnadata-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:fc61bb4b-d93f-3a76-5a03-28f230bb3aae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/miljoovervakning_sediment"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Dumpningsområden,Dumpningsplatser,Enstaka kartläggningar,Nationell miljöövervakning havssediment,Miljöövervakning sjösediment,Regional miljöövervakning havssediment"},"dct:title":{"@language":"sv","@value":"marin:SE.GOV.SGU.NMSD.DUMPNINGSOMRADE_VY,marin:SE.GOV.SGU.NMSD.DUMPNINGSPLATSER_VY,marin:SE.GOV.SGU.NMSD.ENSTAKA_KARTLAGGNINGAR_VY,marin:SE.GOV.SGU.NMSD.NATIONELL_MILJOOVERVAKNING_HAV_VY,marin:SE.GOV.SGU.NMSD.NATIONELL_MILJOOVERVAKNING_SJO_VY,marin:SE.GOV.SGU.NMSD.REGIONAL_MILJOOVERVAKNING_VY"}}],"@id":"urn:source:9ee0ef5a6bc936dd341aca44b48ccc889c7573577f36158acf79c4f5767eb62f"},{"@graph":[{"@id":"_:9eefd45dc29d802951211ad9b18efdd3c2d353219efbdbf1679eb693b7e12041_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.16577 58.14398,15.62108 58.14398,15.62108 56.93782,13.16577 56.93782,13.16577 58.14398))"}},{"@id":"_:9eefd45dc29d802951211ad9b18efdd3c2d353219efbdbf1679eb693b7e12041_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/5de6e621-b019-488d-9d1c-893746f01972","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7"},"dcat:distribution":[{"@id":"urn:uuid:0af07f53-86f7-df8e-249a-3f5ad25eefa4"},{"@id":"urn:uuid:75c659a8-996a-2a24-928d-78386e3b33e4"},{"@id":"urn:uuid:75d0ae8a-53ed-7571-ffcd-c1235a2f20b0"},{"@id":"urn:uuid:dd617ec6-37cd-384f-015f-17d349bdf0ab"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Totalinventering med vissa avgränsningar av länets mest kulturhistoriskt intressanta industrimiljöer i fält såsom verkstäder, industrier och kommunaltekniska verk, där någon byggnadskropp uppförts före utgången av år1965. Syfte: Skapa förutsättningar för att kunna bevara och vårda de kulturhistoriskt mest värdefulla byggnaderna och lokalerna som en viktig del av länets utpekade kulturarv och som grund verka för bevarande och levandegörande av detta kulturarv.\nSkiktet skapades huvudsakligen under mitten och slutet av 1990-talet och är inte ett komplett register. Många objekt har försvunnit eller brunnit ner, rivits eller modifierats och detta har inte uppdaterats i databasen, varför ett utvecklingsbehov finns att löpande uppdatera sådana händelser. Fler objekt tillkommer även efter hand som Länsstyrelsen får kännedom om nya i samband med inventeringar eller andra informationskällor."},"dct:identifier":"5de6e621-b019-488d-9d1c-893746f01972","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2014-03-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:9eefd45dc29d802951211ad9b18efdd3c2d353219efbdbf1679eb693b7e12041_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Kultur Industrimiljö"}},{"@id":"urn:uuid:0af07f53-86f7-df8e-249a-3f5ad25eefa4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.kultur_industrimiljo.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:75c659a8-996a-2a24-928d-78386e3b33e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/rest/services/LSTF/lstf_wms_1/MapServer/7"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"REST-tjänst (ArcGIS MapService)"}},{"@id":"urn:uuid:75d0ae8a-53ed-7571-ffcd-c1235a2f20b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala.lansstyrelsen.se/arcgis/services/LSTF/lstf_wms_1/MapServer/WMSServer?layers=lstf_industrimiljo"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"lstf_industrimiljo (WMS)"}},{"@id":"urn:uuid:d0eae96c-ee91-6f49-8a2b-3ea2ee465fe7","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Kulturmiljöenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9eefd45dc29d802951211ad9b18efdd3c2d353219efbdbf1679eb693b7e12041_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Kulturmiljöenheten"},{"@id":"urn:uuid:dd617ec6-37cd-384f-015f-17d349bdf0ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_kulturmiljo_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}}],"@id":"urn:source:9eefd45dc29d802951211ad9b18efdd3c2d353219efbdbf1679eb693b7e12041"},{"@graph":[{"@id":"_:9ef9250275e96ad356a92be1352dbc23ee5d08136dce688b505f0e76a2e87a41_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Databasen och tillhörande inmatningsapplikation utvecklades under åren 1988 till 1993 av Michael Stephens, Gunnar Nilsson och Magnus Ripa för att lagra deskriptiva och kvantitativa data från berggrundsgeologiska fältobservationer. Innan dess fanns sådan information endast tillgänglig i analoga fältdagböcker. Termlistorna (värdeförråden) har fortlöpande reviderats och kompletterats, särskilt under perioden 2001 till 2009. Nya databasfält har tillkommit vid flera tillfällen för att tillgodose förändrade informationsbehov. År 2011 infördes regler om att vissa databasfält ska vara obligatoriskt ifyllda vid leverans till databasen. Nya fältobservationsdata har kontinuerligt tillförts databasen sedan början av 1990-talet. Digitalisering av information ur äldre dagböcker har endast skett i begränsad omfattning. Ett urval av informationen i databasen är samlad i produkten som beskrivs här. Produkten uppdaterades 2015 med förenklad symbolisering av strukturmätningarna."}},{"@id":"_:9ef9250275e96ad356a92be1352dbc23ee5d08136dce688b505f0e76a2e87a41_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/565b66c3-28da-4c19-bf40-037d565b34ca","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:b7c5c73e-54fb-99cd-0b7f-43bf821f3c0a"},{"@id":"urn:uuid:e80d5dce-c7ee-4f1a-e818-2ac3a5756f69"},{"@id":"urn:uuid:f397fa19-e44f-c8bc-42fc-27432efd64e6"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Berggrundsobservationer innehåller punktobjekt med information från berggrundsgeologiska observationer och mätningar från hällar samt andra ställen där berggrunden är blottad, som exempelvis i borrhål och tunnlar. Informationen bygger på fältbedömningar och vissa mätningar. \nFältobservationsdata har kontinuerligt tillförts produkten sedan början av 1990-talet. Digitalisering av information ur äldre analoga dagböcker har endast skett i begränsad omfattning. \nProdukten innehåller dels observationsresultat, t.ex. bergart och struktur, dels mätresultat, t.ex. riktningar för lagring och magnetisk susceptibilitet. \nI punktskiktet berggrundsobservationer_berg representerar en punkt en observerad bergart. Om flera bergarter dokumenterades på samma punkt finns det alltså flera sådana på varandra i punktskiktet. Samma gäller för de uppmätta strukturerna i punktskiktet berggrundsobservationer_strukturer."},"dct:identifier":"565b66c3-28da-4c19-bf40-037d565b34ca","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:9ef9250275e96ad356a92be1352dbc23ee5d08136dce688b505f0e76a2e87a41_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:9ef9250275e96ad356a92be1352dbc23ee5d08136dce688b505f0e76a2e87a41_b1n0"},"dct:title":{"@language":"sv","@value":"Berggrundsobservationer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:b7c5c73e-54fb-99cd-0b7f-43bf821f3c0a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/berggrundsobservationer/berggrundsobservationer.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:e80d5dce-c7ee-4f1a-e818-2ac3a5756f69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/berggrundsobservationer-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:f397fa19-e44f-c8bc-42fc-27432efd64e6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/berggrundsobservationer/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}}],"@id":"urn:source:9ef9250275e96ad356a92be1352dbc23ee5d08136dce688b505f0e76a2e87a41"},{"@graph":[{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning.\n\n    För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/2a22a5c4-88be-03ed-fc48-fd63acdc467e","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:210a9804-afc2-4ee3-6f7a-941399d00dcf"},{"@id":"urn:uuid:af037d58-48d7-146c-ff08-da3471347b65"}],"dcat:distribution":[{"@id":"urn:uuid:11c7e288-7b89-044f-da7a-da0c08ea7b0e"},{"@id":"urn:uuid:63de64ff-b403-0328-09f4-9931a7b92dc7"},{"@id":"urn:uuid:edaa78d6-0dd7-7582-9497-7a2b1d6886a4"}],"dcat:keyword":[{"@language":"sv","@value":"Anläggningar för miljöövervakning"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/ef"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Platser där det utförts mätningar av grundvattenkemi och grundvattennivåer."},"dct:identifier":"2a22a5c4-88be-03ed-fc48-fd63acdc467e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-16"},"dct:provenance":{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b1n0"},"dct:title":{"@language":"sv","@value":"Stationsregistret: Platser för miljöövervakning: Datavärdskap Grundvatten"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:11c7e288-7b89-044f-da7a-da0c08ea7b0e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Grundvatten/atomDatasetFeed-SE_EF_StnReg_DV_Grundvatten.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.ATOM"}},{"@id":"urn:uuid:210a9804-afc2-4ee3-6f7a-941399d00dcf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sveriges Geologiska Undersökning (SGU)","http://www.w3.org/2006/vcard/ns#organization-name":"Sveriges Geologiska Undersökning (SGU)"},{"@id":"urn:uuid:63de64ff-b403-0328-09f4-9931a7b92dc7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.WMS"}},{"@id":"urn:uuid:af037d58-48d7-146c-ff08-da3471347b65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Datavärdskapet grundvattenkemi och grundvattennivåer","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:grundvatten.datavardskap@sgu.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Datavärdskapet grundvattenkemi och grundvattennivåer"},{"@id":"urn:uuid:edaa78d6-0dd7-7582-9497-7a2b1d6886a4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"Stationsregistrets WFS tjänst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"EF.Stationsregister.WFS"}}],"@id":"urn:source:9f393b127f3136289af2187c612d361a29905f183735091dfa6a8d47764883f6"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/e04a0e7c-2c86-4931-a6f5-bab4091c8745","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/ortofoto-historiska-visning-api"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten innehåller historiska ortofoton (ortogonalprojicerade flygbilder, skalriktiga i markytan) i sv/v, färg (RGB) och infrarött (IR) från åren 1949 – 2005, uppdelade i olika lager. Produkten uppfyller kraven för EU-direktivet Inspire."},"dct:identifier":"e04a0e7c-2c86-4931-a6f5-bab4091c8745","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Ortofoto historiska Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:9f9e68173a24801e27871549b9474159befb09bb7c63dca7be7634d163e7a151"},{"@graph":[{"@id":"_:a050e4397ae99fea679bb10e135def4eddff56f5388412ce3880bcbece6d0fb0_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.57342 58.18612,15.659 58.18612,15.659 56.94495,13.57342 56.94495,13.57342 58.18612))"}},{"@id":"_:a050e4397ae99fea679bb10e135def4eddff56f5388412ce3880bcbece6d0fb0_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/5a435161-125d-4514-8c19-b81d31fd4e86","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4"},"dcat:distribution":{"@id":"urn:uuid:201d2bf4-5b30-ab82-c8f4-2ae90288b016"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Värdetrakter i skogsmark, från skogsstrategi 2020. Strategi för formellt skydd av skog i Jönköpings län. Meddelande nr 2020:4. Länsstyrelsen i Jönköpings län."},"dct:identifier":"5a435161-125d-4514-8c19-b81d31fd4e86","dct:issued":{"@type":"xsd:date","@value":"2020-02-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-02-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:a050e4397ae99fea679bb10e135def4eddff56f5388412ce3880bcbece6d0fb0_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Värdetrakter i skogsmark"}},{"@id":"urn:uuid:201d2bf4-5b30-ab82-c8f4-2ae90288b016","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTF/LSTF_vardetrakter_skog_EXT/MapServer/0"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:638963ee-40bf-5daf-78b0-c664ae89a7f4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Enheten för naturskydd och tillsyn","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a050e4397ae99fea679bb10e135def4eddff56f5388412ce3880bcbece6d0fb0_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Enheten för naturskydd och tillsyn"}],"@id":"urn:source:a050e4397ae99fea679bb10e135def4eddff56f5388412ce3880bcbece6d0fb0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/e00e798c-b1ab-45f7-9205-259d54c25553","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/strand-jordart-eroderbarhet"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten visar datamängden Stränders jordart och eroderbarhet och ger information om jordartstyp samt jordartens eroderbarhet längs stränder.\n\nProdukten bygger på en omklassning längs stränder av grundlagret (JG2) i datamängden Jordarter 1:25 000 – 1:100 000 till sju förenklade jordartsklasser och fyra eroderbarhetsklasser. Produkten redovisar förhållandena vi karteringstillfället. Byggnation och markarbeten kan ha ändrat strandens egenskaper. Kartan bör därför tolkas med stor försiktighet inom tätorter."},"dct:identifier":"e00e798c-b1ab-45f7-9205-259d54c25553","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Stränders jordart och eroderbarhet (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a0a52c95d08c373494460ec26fecb750c476049148fedc7b9af647c5be8be74c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002817","@type":"foaf:Agent","dct:identifier":"2021002817","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:dcu@slu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges lantbruksuniversitet"},"foaf:page":{"@id":"https://www.slu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18"}},{"@id":"https://admin.dataportal.se/store/818/resource/7a304d752476b2c8e9ed2619e4376e18","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Academia-ScientificOrganisation"},"foaf:name":[{"@language":"en","@value":"Swedish University of Agricultural Sciences"},{"@language":"sv","@value":"Sveriges lantbruksuniversitet"}]},{"@id":"https://www.geodata.se/resources/98a1ee35-cbbc-4fc1-8e55-f2c7c60d7535","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"http://wms.slu.se/inspire-atom/SLU_EFRiksskog_TopAtomFeed.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM) riksskogstaxeringen, skogliga skattningar"},"dct:identifier":"98a1ee35-cbbc-4fc1-8e55-f2c7c60d7535","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002817"},"dct:title":{"@language":"sv","@value":"EF.Riksskogstaxeringens statistikprodukter.atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:a0f87d964a5ce12a9b7417dbe570c9e2ff554e8f58e3cdedee3b297467ad4f38"},{"@graph":[{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Verksamhetsområden tas fram genom en omfattande bearbetning dels av geografisk information från Lantmäteriets geografiska grunddata, dels av registeruppgifter från SCB:s företagsdatabas (FDB). Från Lantmäteriets geografiska grunddata hämtas uppgifter om byggnader, fastigheter, anläggningsområden, ytor för industri och handel, samt gränser för kommuner och län. Information från SCB:s företagsdatabas innehåller uppgifter om arbetsställen, antal anställda per arbetsställe samt koordinater för arbetsställena. Produktionen av verksamhetsområden har gjorts i GIS med hjälp av automatiska bearbetningar med väl utarbetade och repeterbara metoder. Granskning har genomförts kontinuerligt under produktionsprocessen för att säkerställa områdenas kvalitet. Vid behov har vissa manuella justeringar av underlagsdata gjorts, bland annat genom rättning av felaktiga eller saknade arbetsställekoordinater i företagsdatabasen samt vid behov justering eller komplettering av felaktig eller saknad geometri i Lantmäteriets geografiska grunddata (gäller framför allt anläggningsområden, ytor för industri och handel samt byggnader).\n\nDen första publiceringen av verksamhetsområden avser 2015. Verksamhetsområden har delvis föregåtts av arbetsplatsområden utanför tätort, som publicerats för åren 2005 och 2010. Till skillnad från arbetsplatsområden utanför tätort omfattar verksamhetsområden också arealer inom tätort. Det finns också skillnader vad gäller metod och urval mellan verksamhetsområden och arbetsplatsområden utanför tätort."}},{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.95 69.08,24.17 69.08,24.17 55.33,10.95 55.33,10.95 69.08))"}},{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2020"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2015"}},{"@id":"http://dataportal.se/organisation/SE2021000837","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"SCB tillgängliggör statistik från ett flertal datamängder inom sin avgiftsfinansierade verksamhet. Dessa datamängder skräddarsys efter kundernas behov genom sambearbetningar från SCB:s olika register. SCB tar ut avgifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/7bffb76f-d034-4088-abfa-92183e3469a9","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:30ef0736-a5e7-7a78-5b4f-68ddd6d75533"},{"@id":"urn:uuid:88d0e539-d5bd-e176-1362-d67dcb6cd64f"},{"@id":"urn:uuid:9d1540ed-eb43-fd12-fd47-ea9626a77763"},{"@id":"urn:uuid:9daa320a-3e9b-0b25-5b07-1ae0afcb7184"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Verksamhetsområden är geografiska områdesavgränsningar som redovisas med uppgifter om antal anställda, antal arbetsställen, största bransch (på avdelningsnivå enligt SNI 2007) och areal. \n\nEtt verksamhetsområde kan bestå antingen av en koncentration av flera arbetsställen, som tillsammans bildar ett geografiskt avgränsat område, eller ett område som karaktäriseras av storskalig och industriellt präglad markanvändning och har minst ett arbetsställe. Ett verksamhetsområde är minst 3 hektar stort. \n\nExempel på verksamhetsområden är flygplatser, gruvor och täkter, områden med industri, handel, företagsparker, tekniska anläggningar och logistik eller områden med högskolor, universitet och vårdinrättningar. Verksamhetsområden utgör ett komplement till datamängden handelsområden. Dessa två områdestyper kan överlappa varandra geografiskt.\n\nVerksamhetsområden kan överlappa andra typer av områdesavgränsningar från SCB, som tätorter och småorter. Verksamhetsområden publiceras från och med 2015 vart femte år. Verksamhetsområden ersätter den tidigare datamängden arbetsplatsområden utanför tätort, som togs fram för åren 2005 och 2010."},"dct:identifier":"7bffb76f-d034-4088-abfa-92183e3469a9","dct:issued":{"@type":"xsd:date","@value":"2020-11-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-18"},"dct:provenance":{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:spatial":{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b1n0"},"dct:temporal":{"@id":"_:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5_b2n0"},"dct:title":{"@language":"sv","@value":"Verksamhetsområden"}},{"@id":"urn:uuid:30ef0736-a5e7-7a78-5b4f-68ddd6d75533","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/vara-tjanster/oppna-data/oppna-geodata/statistiska-verksamhetsomraden/"},"dct:description":{"@language":"sv","@value":"Beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Öppna geodata för verksamhetsområden"}},{"@id":"urn:uuid:88d0e539-d5bd-e176-1362-d67dcb6cd64f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wms?service=wms&version=1.3.0&request=GetCapabilities"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Verksamhetsområden WMS"}},{"@id":"urn:uuid:9d1540ed-eb43-fd12-fd47-ea9626a77763","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.scb.se/geoserver/stat/wfs?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Verksamhetsområden WFS"}},{"@id":"urn:uuid:9daa320a-3e9b-0b25-5b07-1ae0afcb7184","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/mi0815"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktspecifikation"}}],"@id":"urn:source:a15e7e172069401cdb062ee2613416dca8035a4b4a3ee6d85479c1ce716cf4d5"},{"@graph":[{"@id":"_:a16a2108216b05d6691dfda16e83f5e76419f29995ce2e0723b4377dab38505d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/13774679-bfa0-bc54-36c1-517433a8c2e3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c"},"dcat:distribution":[{"@id":"urn:uuid:1e130ae9-bc4c-963a-8545-16ca5b173a2a"},{"@id":"urn:uuid:53225116-5088-6014-cdf8-07ac4edaa0a8"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Statistik rörande fritidsfisket i Sverige. Bland annat information om fritidsfiskets omfattning, fångster samt ekonomi kopplat till fritidsfiskeaktiviteten."},"dct:identifier":"13774679-bfa0-bc54-36c1-517433a8c2e3","dct:issued":{"@type":"xsd:date","@value":"2018-01-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige 2016"}},{"@id":"urn:uuid:1e130ae9-bc4c-963a-8545-16ca5b173a2a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.scb.se/hitta-statistik/statistik-efter-amne/jord-och-skogsbruk-fiske/fiske/fritidsfiske/"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (SCB)"}},{"@id":"urn:uuid:53225116-5088-6014-cdf8-07ac4edaa0a8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/data-kartor-och-rapporter/data-och-statistik/officiell-statistik/officiell-statistik---fiske/fangststatistik-for-fritidsfisket.html"},"dct:description":{"@language":"sv","@value":"Statistiken beskriver bland annat antal fritidsfiskare, antal fiskedagar och fångster uppdelat på fiske i kust och hav respektive i sjöar och vattendrag samt den ekonomiska omfattningen av fritidsfisket."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Fritidsfiske i Sverige (HaV)"}},{"@id":"urn:uuid:698483a2-0a42-3931-c75a-c30c6f477b0c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fiskeregleringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a16a2108216b05d6691dfda16e83f5e76419f29995ce2e0723b4377dab38505d_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Fiskeregleringsenheten"}],"@id":"urn:source:a16a2108216b05d6691dfda16e83f5e76419f29995ce2e0723b4377dab38505d"},{"@graph":[{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Projektet \"Inventering av flottningslämningar och kulturhistorisk bedömning av vandringshinder i Kronobergs län 2012\" startade 17/9 2012 och slutade 14/12 2012. Syftet var att inventera flottningslämningar i länet och plocka fram en metod som ska kunna användas i Södra Sverige för samma typ av inventering."}},{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.49893 57.3109,15.37128 57.3109,15.37128 56.21629,13.49893 56.21629,13.49893 57.3109))"}},{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:a1b2ec2de9837edeebdc1c9548d2a72efd519f10b34373f1eee9cc4589593e47_b3n0","http