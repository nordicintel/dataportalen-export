8133-d853bf6c2327","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:21c0d3a4-241d-4da3-f03c-a803d5a103ae"},{"@id":"urn:uuid:490a93fe-8cda-da00-01ae-0cc4ec445ecf"},{"@id":"urn:uuid:e8ee9d2a-306a-5e31-5038-1af9b8c48432"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Lagret visar de områden som har beslutats som riksintresse för vindbruk den 30 mars 2015. Dessa områden ska läsas ihop med dokumenten beskrivningen och miljöbedömningen som finns tillgängligt på http://www.energimyndigheten.se/fornybart/riksintressen-for-energiandamal/riksintressen-for-vindbruk/\n\nGränserna för riksintresseområden är inte absoluta, utan indikerar att värden eller egenskaper av högt allmänt intresse enligt hushållningsbestämmelserna i 3 och 4 kap. miljöbalken finns att ta hänsyn till."},"dct:identifier":"ee096c6b-2245-4e7a-8133-d853bf6c2327","dct:issued":{"@type":"xsd:date","@value":"2015-03-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-03-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:780bad3f593eb75ef4c83a5d13fffa9c3577a095c2c551d7a1b57d28f482a9cc_b0n0"},"dct:title":{"@language":"sv","@value":"STEM Riksintresse Energiproduktion, vindbruk 2015"}},{"@id":"urn:uuid:21c0d3a4-241d-4da3-f03c-a803d5a103ae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.energimyndigheten.se/globalassets/fornybart/riksintressen/1ri_vind2015_land_hav_150330.shp.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"zip-fil på Energimyndighetens webbplats"}},{"@id":"urn:uuid:490a93fe-8cda-da00-01ae-0cc4ec445ecf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.energimyndigheten.se/energisystem-och-analys/tillstand-och-provning/riksintressen-for-energi/riksintressen-for-vindbruk/"},"dct:description":{"@language":"sv","@value":"Energimyndighetens webbplats"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Riksintresse vindbruk"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:780bad3f593eb75ef4c83a5d13fffa9c3577a095c2c551d7a1b57d28f482a9cc_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:e8ee9d2a-306a-5e31-5038-1af9b8c48432","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/STEM/STEM_Riksintresse_Energi_EXT/MapServer/WMSServer"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"STEM Riksintresse Energiproduktion MB3kap8 vindbruk 2015"}}],"@id":"urn:source:780bad3f593eb75ef4c83a5d13fffa9c3577a095c2c551d7a1b57d28f482a9cc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/31a1f0fb-1718-4f9d-8d63-f60701d84027","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetsinformation-nedladdning"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Produkten levererar information om adresser, byggnader, bestämmelser, fastigheter, samfälligheter, gemensamhetsanläggningar, rättigheter samt inskrivningar från fastighetsregistret som kan integreras i egna system och applikationer. Uttagen är en ögonblicksbild över hur informationen ser ut just vid uttagstillfället.\n\nProdukten går att beställa både som engångsuttag och abonnemang. Urval görs på information, vilka informationsmängder som ska levereras, och bestånd, för vilka registerenheter informationen ska levereras. "},"dct:identifier":"31a1f0fb-1718-4f9d-8d63-f60701d84027","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighetsinformation Nedladdning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:7814afa79cd1253b8bda79accecf26fee5d72b64b0e501bd0c13cc80b55a6aa5"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a8f53240-4384-49b8-836c-8531334f4c20","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/referens-uppslag-organisation-api"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Tjänsten används för att få en lista på de registerenheter och taxeringsenheter som ett företag/organisation är lagfaren/taxerad ägare till eller tomträttsinnehavare till.\nSvaret kan användas i andra geodatatjänster för att hämta information."},"dct:identifier":"a8f53240-4384-49b8-836c-8531334f4c20","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Referens Uppslag Organisation"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:78a9a56399d802607e416d9a515f41411fbd29f7db4409780d36b4fba710d7bf"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/4b910fe6-a6fb-4a61-9826-c2b4aecc9fe7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geokatalog.sjofartsverket.se/MapService/wms.axd/InspireAu"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Metadatastandarden ISO19139/119 är den föredragna metadatastandarden som ska användas för tjänster (WMS, WFS, WCS)."},"dct:identifier":"4b910fe6-a6fb-4a61-9826-c2b4aecc9fe7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:title":{"@language":"sv","@value":"AU.Maritima enheter - visningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:78de38908393bc8ef01822d5cb982c63f930136629f2dfcee0e9e9ad8d893555"},{"@graph":[{"@id":"_:7960fa5aceb535b3b73ff742612165e9317a7ed529fc2df433ff191fdc6fa7c6_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:7960fa5aceb535b3b73ff742612165e9317a7ed529fc2df433ff191fdc6fa7c6_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ab9da71c-d88c-406b-b3a9-5eeb16fc92f0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65"},"dcat:distribution":[{"@id":"urn:uuid:7ce2967c-8bbf-9d41-fabf-75884b1a3f47"},{"@id":"urn:uuid:86d73dea-fc2a-9a54-856a-ff0cdcb95e17"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Tillståndspliktig miljöfarlig verksamhet. Denna datamängd innehåller punkter för anläggningar enligt NACE 36-39 . Källa: Länsstyrelsernas handläggningssystem (NikITa) för tillsyn av miljöfarlig verksamhet. Respektive länsstyrelse ansvarar för informationen om anläggningar i sitt län."},"dct:identifier":"ab9da71c-d88c-406b-b3a9-5eeb16fc92f0","dct:issued":{"@type":"xsd:date","@value":"2019-10-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:7960fa5aceb535b3b73ff742612165e9317a7ed529fc2df433ff191fdc6fa7c6_b0n0"},"dct:title":{"@language":"sv","@value":"SE.PF Vatten, avlopp, avfall (NACE E)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:6ca762f5-4643-6d59-783e-7d6f14a87d65","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LST FO Miljöskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7960fa5aceb535b3b73ff742612165e9317a7ed529fc2df433ff191fdc6fa7c6_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fo-miljoskydd@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LST FO Miljöskydd"},{"@id":"urn:uuid:7ce2967c-8bbf-9d41-fabf-75884b1a3f47","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-ows.lansstyrelsen.se/inspire_pf/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"LST WMS"},"dct:title":{"@language":"sv","@value":"LST WMS"}},{"@id":"urn:uuid:86d73dea-fc2a-9a54-856a-ff0cdcb95e17","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/Geodata/Inspire/ATOM/pf_vatten_avlopp_avfall.xml"},"dct:description":{"@language":"sv","@value":"LST ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"LST ATOM"}}],"@id":"urn:source:7960fa5aceb535b3b73ff742612165e9317a7ed529fc2df433ff191fdc6fa7c6"},{"@graph":[{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Regeringen har gett Skogsstyrelsen och Sveriges lantbruksuniversitet (SLU) i uppdrag att uppdatera, utveckla och tillgängliggöra Skogliga grunddata. Uppdraget ska utföras via Lantmäteriets laserskanning av Sveriges skogsmark."}},{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.50,24.50 69.50,24.50 55.00,10.50 55.00,10.50 69.50))"}},{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-359300"}},{"@id":"http://dataportal.se/organisation/SE2021005612","@type":"foaf:Agent","dct:identifier":"2021005612","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Skogsstyrelsen"},"foaf:page":{"@id":"https://www.skogsstyrelsen.se/"}},{"@id":"https://www.geodata.se/resources/e90e1465-5137-4310-8f88-e00ed8900f27","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f"},"dcat:distribution":{"@id":"urn:uuid:a1847ede-a7bc-272a-ef8e-a9ce7cc660ba"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"I produkten ingår två kartskikt som beskriver markfuktighet. Dessa rasterkartor är producerade genom sambearbetning av data från Lantmäteriets nationella laserskanning och provytor från Riksskogstaxeringen (SLU). Rastercellerna har en storlek på 2 x 2 meter. Värdena för en rastercell beskriver medel-markfuktigheten under året. Markfuktighetskartan bygger på hydrologiska modelleringar baserat på  GSD-Höjddata grid 2+ © Lantmäteriet. \n\nNedan följer en kort beskrivning av de variabler som ingår i produkten. \n\nSLU Markfuktighetskarta \n\nSLU markfuktighetskarta skapades genom att kombinera information i 24 olika kartor och använda fältdata från 20 000 av riksskogstaxeringens provytor som är fördelade över hela Sverige för att träna modellen (genom så kallad maskininlärning) var det är torrt och var det är blött. Det gör att kartan är anpassad för olika regioner med olika topografi, klimat, och jordarter. SLU markfuktighetskarta visar hur sannolikt det är att en pixel i kartan ska klassificeras som blöt, det kan ses som ett index där 0 är torr och 100 blöt. På SLU Markfuktighetskarta indikerar färgerna olika markfuktighet; torr mark är röd, fuktig mark är gul, frisk-fuktig mark är grön, fuktig mark är turkos och blöt mark är blå. Men färgerna på kartan ”smälter ihop” för att få mjukare övergångar. \n\nSLU Markfuktighetskarta klassad \n\nDen klassade markfuktighetskartan visar markfuktigheten indelad i tre klasser: 1. torr-frisk, 2. frisk-fuktig och 3. fuktig-blöt. Öppet vatten (sjöar och vattendrag) har klassats som 4.  Läs mer om de enskilda rasterkartorna på http://www.slu.se/mfk."},"dct:identifier":"e90e1465-5137-4310-8f88-e00ed8900f27","dct:issued":{"@type":"xsd:date","@value":"2018-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-01"},"dct:provenance":{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005612"},"dct:spatial":{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b1n0"},"dct:title":{"@language":"sv","@value":"Markfuktighetskarta"}},{"@id":"urn:uuid:08ddfb57-4eb2-7251-7e43-65da7221937f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Skogsstyrelsen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:skogsstyrelsen@skogsstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Skogsstyrelsen"},{"@id":"urn:uuid:a1847ede-a7bc-272a-ef8e-a9ce7cc660ba","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.skogsstyrelsen.se/skogligagrunddata"},"dct:description":{"@language":"sv","@value":"Startsida för information om Skogliga grunddata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Skogliga grunddata"}}],"@id":"urn:source:79fe2cd89d677d5fbcfe3f887a0209a6ee57c36fa1bd54b0c30428334b0a4e57"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/8792a8c9-4cea-4161-831a-81e6009e6ff7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://mapsext.sgi.se/geoserver/wms?request=GetCapabilities&service=WMS&layers=ovriga_alvar_risk"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Skredrisk-, sannolikhets-, och konsekvenskartor framtagna med en något enklare metodik än i GÄU Göta ÄlvUtredningen. Kartering är likväl baserad på en baserat på en stor mängd digitala data. Norsälven (2015) var det första vattendraget där denna förenklad metodik för tillämpades. Metodutvecklingen har genomförts för att få ned utredningskostnaderna och förenkla tolkningen av kartorna, och därigenom öka användbarheten av resultatet. Metodiken för riskkartering som tagits fram är applicerbar för skredriskkartering längs andra vattendrag – t ex Säveån (2017) och Ångermanälven (senare). Allteftersom respektive vattendrag karteras klart kommer det att tillfogas datamängen för ”övriga prioriterade älvar”. Både metodiken för sannolikhetsklassning och konsekvensklassning kan användas var för sig, metodiken för konsekvensklassning kan även användas för kartering av andra naturhändelser. Används vid prioritering av åtgärder, inför planering av ny bebyggelse och planering av åtgärder för befintlig bebyggelse. Se vidare https://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar\n[Geoteknik]"},"dct:identifier":"8792a8c9-4cea-4161-831a-81e6009e6ff7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"NZ.Naturliga riskområden, Skredriskkartering övriga prioriterade älvar.WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:7a661a45571387ffe9d521fd837c1a31849a1f51d2462cb6164532e7868432ef"},{"@graph":[{"@id":"_:7a89ba1e92111c4a4cbe3cd20be98d6f1f18fc8a53c56bd44bb28e80e1c0c315_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"https://www.sgi.se/vara-expertomraden/skred-ras-och-erosion/skredsakring-langs-gotaalv/gotaalvutredningen"}},{"@id":"_:7a89ba1e92111c4a4cbe3cd20be98d6f1f18fc8a53c56bd44bb28e80e1c0c315_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.87 58.36,12.39 58.36,12.39 57.73,11.87 57.73,11.87 58.36))"}},{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/e9702747-5d3d-4387-b426-2aeafd660c53","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:41fe7432-f273-e8a4-80ad-865a1413694d"},{"@id":"urn:uuid:7cf12fc4-935c-9865-2269-36064e316af4"},{"@id":"urn:uuid:890ed2ae-b83b-b271-7279-a2c429dc04cf"},{"@id":"urn:uuid:bbca3e6e-7192-5db0-6782-fd04bbd40def"},{"@id":"urn:uuid:cbbbc172-a056-9752-533c-62eff9881479"},{"@id":"urn:uuid:ccc8ea35-d733-1ec1-35eb-d39dcdbedf30"},{"@id":"urn:uuid:df4e0c7e-3c4f-5925-d247-290537ab61f5"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Samtliga UTFÖRDA BORRHÅL INOM GÖTA ÄLVUTREDNINGEN (1870 st). \nSex kommunvisa paket och kataloger med profilritningar (jpg-bilder) förekommer (i syfte att hålla datamängden nere): \\ale_do9_do11; \\gbg_do1_do2_do10_do11; \\knglv_do2_do3_do11; \\ledet_do4_do5_do6_do7_do8_do11; \\thn_do5_do6_do7_do11; \\vborg_do6_do11\nSe vidare https://gis.sgi.se/dokument/geodatasezip/borrhalspaketet_innehåll.xls \n\nSamtliga rapporter  från GÄU: https://www.sgi.se/sv/samhallsplanering--sakerhet/skredriskutredningar/gota-alv/verktyg-underlag-och-rapporter/\n\n[Geoteknik]"},"dct:identifier":"e9702747-5d3d-4387-b426-2aeafd660c53","dct:issued":{"@type":"xsd:date","@value":"2012-03-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-09"},"dct:provenance":{"@id":"_:7a89ba1e92111c4a4cbe3cd20be98d6f1f18fc8a53c56bd44bb28e80e1c0c315_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:spatial":{"@id":"_:7a89ba1e92111c4a4cbe3cd20be98d6f1f18fc8a53c56bd44bb28e80e1c0c315_b1n0"},"dct:title":{"@language":"sv","@value":"GÄU Göta älvutredningen: Utförda borrhål - datapaket"}},{"@id":"urn:uuid:41fe7432-f273-e8a4-80ad-865a1413694d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/borrhal_gotaalv/"},"dct:description":{"@language":"sv","@value":"Borrhål, profilritningar och stabilitetsberäkningar Göta älvdalen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"}},{"@id":"urn:uuid:7cf12fc4-935c-9865-2269-36064e316af4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_ale.zip"},"dct:description":{"@language":"sv","@value":"Ale kn, 22MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:890ed2ae-b83b-b271-7279-a2c429dc04cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_ledet.zip"},"dct:description":{"@language":"sv","@value":"Lilla Edet kn, 81MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:bbca3e6e-7192-5db0-6782-fd04bbd40def","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_knglv.zip"},"dct:description":{"@language":"sv","@value":"Kungälv kn, 32MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:cbbbc172-a056-9752-533c-62eff9881479","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_thn.zip"},"dct:description":{"@language":"sv","@value":"Trollhättan kn, 61MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:ccc8ea35-d733-1ec1-35eb-d39dcdbedf30","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_vborg.zip"},"dct:description":{"@language":"sv","@value":"Vänersborg kn, 24MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}},{"@id":"urn:uuid:df4e0c7e-3c4f-5925-d247-290537ab61f5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.sgi.se/dokument/geodatasezip/gau_borrhalspaketet_120801_gbg.zip"},"dct:description":{"@language":"sv","@value":"Göteborg kn, 31MB"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"}}],"@id":"urn:source:7a89ba1e92111c4a4cbe3cd20be98d6f1f18fc8a53c56bd44bb28e80e1c0c315"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/0fa3140c-e652-495d-80b2-27b6a416b0fa","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/flyggeofysik-meta?"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Visningstjänsten \"Geofysiska flygmätningar, metadata\" visar var flyggeofysiska data har samlats in. Data är uppdelade i lager efter mätmetod, och för varje flygområde finns metadata som beskriver området och hur mätningen utfördes.\n\nTjänsten visar endast var flyggeofysiska data finns, samt deras metadata. För att beställa data, vänligen vänd dig till SGUs kundtjänst.  Ange vilken mätmetod som data önskas för samt koordinaterna för området som data önskas för. Istället för koordinater kan även flygid från denna visningstjänst anges."},"dct:identifier":"0fa3140c-e652-495d-80b2-27b6a416b0fa","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Geofysiska flygmätningar, metadata (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:7b512471a8ebae806ec3761cbcf1830b493a92aab8c0fb520c2bcd5044aac593"},{"@graph":[{"@id":"_:7b8eb83ca16f0efc5b2db24647a73dbe1576d999f067fb6269fd610df78a955f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"SGU har systematiskt undersökt bergarters petrofysiska egenskaper sedan 1960-talet med mätningar av magnetiska egenskaper och densitet. Även gammastrålning, samt i vissa fall porositet, har mätts eller beräknats.\nNär teknologi tillät produktion av handhållna instrument för att mäta gammastrålning började all sådan mätning göras på berghäll under fältarbete, vilket gett upphov till datamängderna i denna produkt.\n\nDatakvalitet och mätnoggrannhet har förbättrats vid de tillfällen som instrumenteringen uppgraderats. För gammastrålningsmätningar på häll anges en kvalitetsparameter som baseras på en bedömning av hällytans lämplighet för mätning. Denna parameter tar dock inte med instrumentens noggrannhet eller precision.\n\nProvpunkternas geografiska läge har fram till 1994 bestämts med hjälp av befintligt kartmaterial, vilket gör det svårt att lova en generell noggrannhet. Dessa fel bedöms i normalfallet inte överstiga 100 m. Däremot bedöms det, för de äldsta proverna, kunna förekomma fel på upp till 1000 m där positionsbestämning gjorts i svår terräng och utifrån dåtidens kartor, i väglös terräng, samt dåligt med geografiska referenser. Satellitbaserade positioneringssystem som GPS (Global Positioning System) var i drift redan under 1990-talet och när den militära stör-signalen upphörde kunde noggrannhet i position generellt sägas vara bättre än ungefär 10 meter."}},{"@id":"_:7b8eb83ca16f0efc5b2db24647a73dbe1576d999f067fb6269fd610df78a955f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/aa484649-0ec8-4149-94cf-3a8cce58746a","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:61624520-62dc-42a6-a98e-e169b4a95526"},{"@id":"urn:uuid:a1087590-a901-8ef9-f058-a1385e1cfb28"},{"@id":"urn:uuid:e2610f4a-2eff-2eef-0ee5-33ea8e27770a"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Informationen används bl.a. inom prospektering."},{"@language":"sv","@value":"Petrofysik handlar om bergarternas fysikaliska egenskaper. De egenskaper som undersökts är främst bergarternas magnetism, densitet och radiometri. Även bergarters porositet har undersökts men i mycket begränsad omfattning.\n\nProdukten Gammastrålning innehåller data från fältmätningar vid blottad berggrund från observerade berghällar i Sverige. Bedömning om bergarters Gammastrålning används ofta som hjälp för att karaktärisera och klassificera bergarter och för byggmaterial finns normer och riktlinjer som beskriver gränsvärden för sådan strålning. Kontroll och kännedom om gammastrålning i berg är viktigt för brytning, och täktverksamhet, men även vid uppläggning och deposition. Eftersom mätning av gammastrålning bedömer halter av radioaktiva isotoper så ger det genetisk information och tidsinformation via sönderfallskedjans status. \n\nTrots att den joniserande strålningen dämpas kraftigt av endast några centimeter tjockt jordtäcke, och att därtill majoriteten av markytan är täckt av jordmaterial, så är mätningar av gammastrålning på berghällar ett kraftfullt verktyg för att tolka yttäckande strålningsmätningar. Dessutom följer materialtransport efter vittringsprocesser, och glaciationsepoker mönster som är dokumenterade och kartlagda inom kvartärgeologi."}],"dct:identifier":"aa484649-0ec8-4149-94cf-3a8cce58746a","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:7b8eb83ca16f0efc5b2db24647a73dbe1576d999f067fb6269fd610df78a955f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:7b8eb83ca16f0efc5b2db24647a73dbe1576d999f067fb6269fd610df78a955f_b1n0"},"dct:title":{"@language":"sv","@value":"Petrofysik, gammastrålning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:61624520-62dc-42a6-a98e-e169b4a95526","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/petrofysik-gammastralning/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:a1087590-a901-8ef9-f058-a1385e1cfb28","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/petrofysik-gammastralning-beskrivning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:e2610f4a-2eff-2eef-0ee5-33ea8e27770a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/petrofysik-gammastralning/petrofysik-gammastralning.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:7b8eb83ca16f0efc5b2db24647a73dbe1576d999f067fb6269fd610df78a955f"},{"@graph":[{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Okänt"}},{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.4535 57.5968,13.694 57.5968,13.694 56.3235,11.4535 56.3235,11.4535 57.5968))"}},{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b2n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.90967 57.50359,13.26412 57.50359,13.26412 56.59961,11.90967 56.59961,11.90967 57.50359))"}},{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/8272b0c0-c979-438a-b2c4-70c399107462","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea"},"dcat:distribution":{"@id":"urn:uuid:adeb063e-5cbb-95f9-b788-8fcacaa60dbc"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Landskapsbildsskydd är en äldre form av naturskydd som tillkom för att kunna ingripa mot sådant som kan uppfattas som förfulande i landskapet. Även om begreppet inte längre finns i dagens lagstiftning (miljöbalken) gäller fortfarande bestämmelserna i landskapsbildsskyddsområdena, så länge Länsstyrelsen inte beslutat om något annat. \n\nFör varje landskapsbildsskyddsområde finns ett beslut med föreskrifter. Föreskrifterna kan variera men innebär att det krävs tillstånd för att utföra vissa åtgärder som kan ha negativ effekt på landskapsbilden. Vanligtvis krävs tillstånd för:\n1. Ny byggnad alternativt för nybebyggelse/nybyggnad. Begreppet nybebyggelse/nybyggnad innefattar förutom helt nya byggnader även yttre om-, till- och påbyggnad av befintliga byggnader. Det krävs även tillstånd för till exempel friggebodar, växthus och mindre utbyggnader eller små byggnader som kanske inte kräver bygglov. \n2. Omfärgning eller ändring av fasad- och takbeklädnad eller uppförande av plank \n3. Schaktning (grävning, sprängning och borttransport av jord), tippning och fyllning \n4. Anläggande av väg \n5. Upplag \n6. Täktverksamhet \n7. Skogsplantering och avverkning \n8. Ledningsdragning \n9. Anläggande av parkering och camping för allmänheten"},"dct:identifier":"8272b0c0-c979-438a-b2c4-70c399107462","dct:issued":{"@type":"xsd:date","@value":"2016-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2016-01-01"},"dct:provenance":{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b1n0"},{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b2n0"}],"dct:title":{"@language":"sv","@value":"LstN Landskapsbildsskydd"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:adeb063e-5cbb-95f9-b788-8fcacaa60dbc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.Lst_Lbildsskydd.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:7c3a6365b2850f45e3c0cfc4be924f2bb36a9f4ae3b4151f80358b30e7e437f1"},{"@graph":[{"@id":"_:7c3be96fd56a5d15ea9047f4dc7020df325b0392b42aec95cb4eea5ab49fa80b_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60179","http://www.w3.org/2006/vcard/ns#street-address":"Hospitalsgatan 30"},{"@id":"_:7c3be96fd56a5d15ea9047f4dc7020df325b0392b42aec95cb4eea5ab49fa80b_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:011-192000"}},{"@id":"http://dataportal.se/organisation/SE2021000795","@type":"foaf:Agent","dct:identifier":"2021000795","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lfv@lfv.se"},"foaf:name":{"@language":"sv","@value":"Luftfartsverket"},"foaf:page":{"@id":"https://www.lfv.se"}},{"@id":"https://www.geodata.se/resources/ff8af5b5-9076-43bb-8e16-509d551e5baf","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:d5f903d7-545f-6c1e-7849-fbc4007c05ba"},"dcat:endpointURL":{"@id":"https://daim.lfv.se/geoserver/mais/wfs?request=GetCapabilities"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Aeronautical Information (mAIS) is the official Swedish GIS dataset covering Air Traffic Management spatial information. The dataset, defined by approximately 40 layers, covers the different feature types from Sweden AIP (Aeronautical Information Package). The dataset does not follow the Feature Type definition of INSPIRE. The dataset is namespaced as \"mais\"."},"dct:identifier":"ff8af5b5-9076-43bb-8e16-509d551e5baf","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000795"},"dct:title":{"@language":"sv","@value":"Aeronautical Information (mAIS) - WFS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:d5f903d7-545f-6c1e-7849-fbc4007c05ba","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Operations AIM","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7c3be96fd56a5d15ea9047f4dc7020df325b0392b42aec95cb4eea5ab49fa80b_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:aim-konsult@lfv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7c3be96fd56a5d15ea9047f4dc7020df325b0392b42aec95cb4eea5ab49fa80b_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Luftfartsverket"}],"@id":"urn:source:7c3be96fd56a5d15ea9047f4dc7020df325b0392b42aec95cb4eea5ab49fa80b"},{"@graph":[{"@id":"_:7cc4b5029484fe455a911a742aa23bc4f1ee24af17e7666dd4780a79960c0dde_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.34499 58.25469,15.58884 58.25469,15.58884 56.88378,13.34499 56.88378,13.34499 58.25469))"}},{"@id":"_:7cc4b5029484fe455a911a742aa23bc4f1ee24af17e7666dd4780a79960c0dde_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/e4852c6d-286e-46cb-a1e6-788a6b0ad7fc","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9"},"dcat:distribution":{"@id":"urn:uuid:0b589c56-8b52-f7f9-e52a-6f6e59135fe8"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Skiktet innehåller undersökningslokaler för sediment. Data kommer från länsstyrelsen i Jönköpings egna databas för sediment. Endast tabellen Lokaler uppdateras årligen. Resultat från sedimentundersökningar uppdateras inte sedan 2010 utan lagras istället i den nationella screeningdatabasen."},"dct:identifier":"e4852c6d-286e-46cb-a1e6-788a6b0ad7fc","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:7cc4b5029484fe455a911a742aa23bc4f1ee24af17e7666dd4780a79960c0dde_b0n0"},"dct:title":{"@language":"sv","@value":"LstF Undersökningslokaler för sediment"}},{"@id":"urn:uuid:0b589c56-8b52-f7f9-e52a-6f6e59135fe8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstf.miljoovervakning_lokal_sed.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:af4f2fdb-473a-73c4-3eb6-32675d742ab9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstF Vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7cc4b5029484fe455a911a742aa23bc4f1ee24af17e7666dd4780a79960c0dde_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jonkoping@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstF Vattenenheten"}],"@id":"urn:source:7cc4b5029484fe455a911a742aa23bc4f1ee24af17e7666dd4780a79960c0dde"},{"@graph":[{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Materialet blev klar 1988 och publicerades 1989. Arbetet gjordes av adjunkt Ingvar Christoffersson, Ljungby."}},{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.28622 57.22596,15.83015 57.22596,15.83015 56.35451,13.28622 56.35451,13.28622 57.22596))"}},{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/ad51dd63-db13-492b-ae1c-79c69bf7da85","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761"},"dcat:distribution":[{"@id":"urn:uuid:d3dd80c4-e6fb-95df-f04c-68d094792c73"},{"@id":"urn:uuid:fd5672e9-6851-7de4-7b73-f646e71b0f7b"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Naturvårdsprogram/plan för Kronobergs län från 1989.Med naturvårdsplan avses länsstyrelsens långsiktiga handlingsplan för skydd och vård av från naturvårdssynpunkt värdefulla områden (definition ur Naturvårdsverkets skrift Översiktlig naturinventering och naturvårdsplanering, Råd och anvisningar (SNV 1975:1)). Länsstyrelsen har under en lång följd av år genomfört inventeringar och utredningar för att få kunskap om känsliga och hotade växter, djur och naturmiljöer. Tanken med naturvårdsprogrammet var att samla all vid den tiden tillgänglig kunskap om alla typer av natur. Den blev klar 1988 och publicerades 1989. Arbetet gjordes av adjunkt Ingvar Christoffersson, Ljungby. Tilläggas kan att Ingvar, som nu är död, hade särskilt stor kunskap om naturen i västra delen av länet, inte minst om myrmarkerna. Naturvårdsprogrammet består av två delar. Boken ”Kronobergs natur” (del 1) är beskrivande och en redovisning av den allmänna naturvårdens intresse inom länet. Inga vägningar har gjorts mot andra sektorsintressen. Del 2 är ett åtgärdsprogram som bland annat anger i vilken omfattning och turordning samt på vilket sätt de värdefulla områdena bör säkerställas. Åtgärdsprogrammet är avsett att omprövas med fem års mellanrum men så har inte skett av resursskäl. Vid utgivandet tillhörde till boken en översiktskarta över länet, dessutom fanns kommunkartor i skala 1:50 000. Första gången ett naturvårdsprogram för Kronobergs län presenterades var 1973 (Naturvårdsplan för Kronobergs län). Del 1 kan fortfarande användas som underlag vid all typ av handläggning m.m. men det ska beaktas att förhållandena kan ha ändrats sedan boken skrevs. Del 2 är främst ett verktyg för handläggare av formellt skydd. Tilläggas bör att varken Länsstyrelsen eller någon annan har full kunskap om hela naturlandskapet i länet. Nya värdefulla områden upptäcks kontinuerligt och det finns ett stort behov att komplettera och fördjupa inventeringar av vissa naturtyper, växter och djur. I och med att inventeringen gjordes för ca 30 år sedan kan vissa beskrivningar vara inaktuella. Artrika odlingslandskap kan ha vuxit igen, äldre skogar ha avverkats och nya vägar m.m. har byggts. Men trots allt är de mycket användbara och värden på landskapsnivå är i stort de samma."},"dct:identifier":"ad51dd63-db13-492b-ae1c-79c69bf7da85","dct:issued":{"@type":"xsd:date","@value":"2023-12-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-12-21"},"dct:provenance":{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Naturvårdsprogrammet"}},{"@id":"urn:uuid:d3dd80c4-e6fb-95df-f04c-68d094792c73","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-lokala-visning.lansstyrelsen.se/arcgis/rest/services/LSTG/LstG_naturskydd_ext/MapServer/4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"MapServer"}},{"@id":"urn:uuid:e51dec5d-b238-97d6-4627-3ac8b0f63761","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Naturskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Naturskydd"},{"@id":"urn:uuid:fd5672e9-6851-7de4-7b73-f646e71b0f7b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.pg401_nvprog.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:7cf88542bf01c79fa1685a70a3ea96ba5b21cb62e77716316d931922c6cbbda2"},{"@graph":[{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skyfallskarteringen är gjord 2015 efter den första versionen av Jönköpings \"Skyfallskartering i GIS - Arbetssätt och metod, Meddelande nr 2014:28 metod för skyfallskartering\" och är baserad på Lantmäteriets nya höjdmodell, byggnader i fastighetskartan samt sjöar och vattendrag. Ingen hänsyn till dagvattensystem eller infiltration utan är till för att bedöma konsekvenserna av extremnederbördstillfällen."}},{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.298661854902 57.051211637753,14.302864731479 57.051211637753,14.302864731479 56.601097552477,13.298661854902 56.601097552477,13.298661854902 57.051211637753))"}},{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/2c1a63d1-9fb7-43f3-b3b7-9fd5978ebb9b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:2847288c-236e-70ae-63b3-2d298d727a08"},"dcat:distribution":{"@id":"urn:uuid:19445d21-1843-eea0-0ddb-64da7cff086a"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Lågpunktskartering som visar instängda områden i Lessebo tätort i Kronobergs län. Djupet i lågpunkterna är uppdelat i 7 djupklasser 0,5–10, 10–20, 21–30, 31–50, 51–70, 71–100 och 101–350 cm. Materialet är baserat på lantmäteriets höjdscanning med 2 meters upplösning men har generaliserats till en upplösning på 4 meter.\n\nSkyfallskarteringen är gjord efter den första versionen av Jönköpings \"Skyfallskartering i GIS - Arbetssätt och metod, Meddelande nr 2014:28 metod för skyfallskartering\" och är baserad på Lantmäteriets nya höjdmodell, byggnader i fastighetskartan samt sjöar o vattendrag. Detta är en topografisk analys som inte tar hänsyn till markens infiltrationskapacitet eller redan inbyggda åtgärder, till exempel vägtrummor eller kulvertar.\n\nDe instängda områdena har tagits fram med ett GIS-verktyg som identifierar instängda områden och fyller dem med vatten. Lågpunkterna fylls upp till kanten med vatten om de matchar kriteriet i sökområdet. Resultatet är inte kopplat till ett visst regn så det är egentligen ingen skyfallskartering. Underlaget ger generellt en första överblick över möjliga problemområden."},"dct:identifier":"2c1a63d1-9fb7-43f3-b3b7-9fd5978ebb9b","dct:issued":{"@type":"xsd:date","@value":"2015-12-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-03-06"},"dct:provenance":{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b1n0"},"dct:title":{"@language":"sv","@value":"LstG Skyfallskartering Ljungby tätort"}},{"@id":"urn:uuid:19445d21-1843-eea0-0ddb-64da7cff086a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstg.Skyfall_Ljungby_tatort_4m.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:2847288c-236e-70ae-63b3-2d298d727a08","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstG Försvar och beredskap","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kronoberg@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstG Försvar och beredskap"}],"@id":"urn:source:7d75d4ef9cf86380578a98cd637d537c6b7efd2cb998e15bcf83f03d4df36729"},{"@graph":[{"@id":"_:7dc55b0ec961d6036210879a106036568b62b0603471e27d8456d90761435d75_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:7dc55b0ec961d6036210879a106036568b62b0603471e27d8456d90761435d75_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30000 65.87000,23.51000 65.87000,23.51000 54.80000,10.30000 54.80000,10.30000 65.87000))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/5158a39c-6c10-4863-b952-93a04461b705","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:7f761118-a23d-69ca-969e-171291dd7535"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Maxdjup (djupast) i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 100 m upplösning. Djupets faktiska position bibehålls. Djup genereras endast i rutor med minst ett mätt värde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"5158a39c-6c10-4863-b952-93a04461b705","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-02"},"dct:provenance":{"@id":"_:7dc55b0ec961d6036210879a106036568b62b0603471e27d8456d90761435d75_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:7dc55b0ec961d6036210879a106036568b62b0603471e27d8456d90761435d75_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 100 m upplösning - maxdjup"}},{"@id":"urn:uuid:7f761118-a23d-69ca-969e-171291dd7535","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:7dc55b0ec961d6036210879a106036568b62b0603471e27d8456d90761435d75"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/cc2ae076-2549-4074-aa81-a182ac404dd9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/berggrund-50-250-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Berggrundskartan är en tvådimensionell modell av berggrundens överyta, som beskriver viktiga egenskaper hos identifierade geologiska enheter, deras geometri, det material som bygger upp enheterna och geologiska händelser som de genomgått. I berggrundskartan ingår även berggrundens strukturer och deras egenskaper. Berggrundskartan bygger på geologiska fältobservationer i kombination med tolkning av analysresultat och geofysiska data. Syftet med berggrundskartan är att ge underlag för analyser i samband med prospektering, översiktsplanering av byggen och anläggningar, geotermisk energiutvinning, arbete med olika frågor inom miljöområdet, forskning och utbildning. Informationen i kartan kan användas för framställning av olika tematiska produkter, t ex. kartor över näringsinnehåll, värmeledningsförmåga och lämplighet för anläggningar."},"dct:identifier":"cc2ae076-2549-4074-aa81-a182ac404dd9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Berggrund 1:50 000 - 1:250 000 (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:7dc828134af6c105efc3a009cc3931bd81ceed2a9be230e49a39e89383eee387"},{"@graph":[{"@id":"_:7e592bb88faae2579f31cdc347ba6d4782da56e444a2d77a7d35e876afe872b5_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-download-icemap.smhi.se/inspire.xml","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-icemap.smhi.se/inspire.xml"},"dcat:downloadURL":{"@id":"https://opendata-download-icemap.smhi.se/inspire.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7e592bb88faae2579f31cdc347ba6d4782da56e444a2d77a7d35e876afe872b5_b0n0"},"dct:title":{"@language":"sv","@value":"Inspireanpassad nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.geodata.se/resources/a73a6950-b14e-11ea-8f8b-197eadf2f6fe","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://opendata-download-icemap.smhi.se/inspire.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Denna produkt är skapad med hjälp av data från EU Copernicus Marine Services.\n\nDatamängden innehåller karta över isläget i Östersjön. Analysen är baserad på satellitdata och in-situ observationer, och är manuellt producerad i en GIS-programvara.\nDataformat är ESRI shapefil med följande attributuppsättning:\n\niceact (iskoncentration i tiondelar)\n01 - Open Water (<1/10)\n10 - 1/10\n20 - 2/10\n30 - 3/10\n40 - 4/10\n50 - 5/10\n60 - 6/10\n70 - 7/10\n80 - 8/10\n90 - 9/10\n91 - 9+/10\n92 - 10/10\n98 - Ice Free\n\nicetck (medeltjocklek i cm) \nicemax (maximal tjocklek i cm)\nicemin (minimumtjocklek i cm)\n\ntype (istyp enligt WMO standard)\n0 - Ice Free\n1 - Open Water\n2 - Very Open Ice\n3 - Open Ice\n4 - Close Ice\n5 - Very Close Ice\n6 - Consolidated Ice\n7 - Level Ice\n8 - Fast Ice\n9 - New Ice\n10 - Rotten Ice\n\ndeformatio (deformationsgrad)\n0 - No Deformation\n1 - Rafted Ice\n2 - Slightly Ridged Ice\n3 - Moderately Ridged Ice\n4 - Heavily Ridged Ice\n5 - Brash Ice Barrier\n\n\npublicatio (publikationsdatum YYYY-MM-DD hh:mm:ss)\n\nchartdate (kartans gällandedatum, YYYY-MM-DD)"},"dct:identifier":"a73a6950-b14e-11ea-8f8b-197eadf2f6fe","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:title":{"@language":"sv","@value":"SE.SR Analyskarta havsis: Nedladdningstjänst"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:7e592bb88faae2579f31cdc347ba6d4782da56e444a2d77a7d35e876afe872b5"},{"@graph":[{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sveriges geologiska undersökning (SGU) bedriver en marin¬geologisk kartering av det svenska kontinentalsockelområdet. Den maringeologiska karteringen har pågått sedan 1969. Syftet med undersökningen är att ta fram kunskap och information avseende havsbottnens sammansättning, egenskaper och uppbyggnad som underlag i kustzons- och havsplanering samt i arbetet med de marina direktiven och nationella miljömål. \nMaringeologisk undersökning bygger i stor utsträckning på hydroakustiska mätningar och sedimentprovtagning samt visuella bottenobservationer. De hydroakustiska mätningarna innefattar bottenpenetrerande mätningar (hydroakustisk profi¬lering) samt bottenyteavbildande mätningar (hydroakustisk yttäckning). \nBottenpenetrerande mätningar görs med s.k. sedimentekolod och seismisk utrustning vilka ger en akustisk bild av havsbottnens vertikala uppbyggnad, från bottenytan ned till den övre delen av berggrunden. \nBottenyteavbildande mätningar görs med multistråleekolod, interferometrisk sonar och sidoavsökande sonar vilka alla ger upphov till grafiska bilder över havsbottenytans areella fördelning av sediment och berg. Mätningar med multistråleekolod och interferometrisk sonar ger dessutom information om vattendjupet inom ett avsökt område.\nDe hydroakustiska data som samlats in tolkas till geologiska förhållanden. Tolkningarna utgår från ett antal platser där såväl mätningar som direkta sedimentprovtagningar och visuella observationer av de geologiska förhållandena gjorts. \nDe sedimentprovtagare som används är olika varianter av gripskopor, lådprovtagare och rörprovtagare. Maximal kärnlängd som kan erhållas är 6 meter. Provtagare väljs efter syfte med provtagningen samt förväntad jordart. Provtagningarna föregås av en besiktning av bottenytan med hjälp av undervattenskamera.\nEfter insamling och bearbetning görs en geologisk tolkning av materialet, för presentation i skala 1:25 000."}},{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.480255943076 56.52870933197,14.593585147816 56.52870933197,14.593585147816 55.290395124427,12.480255943076 55.290395124427,12.480255943076 56.52870933197))"}},{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2012"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/23276dd6-90ab-435e-af05-f52331ad1c4e","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:034b91b7-408f-52ac-c13d-2308ce645962"},{"@id":"urn:uuid:3b8d6c9b-4c4d-c83c-47c3-5c12562e3d06"},{"@id":"urn:uuid:3c3009b3-fa08-e892-20af-f3a707ccfd16"},{"@id":"urn:uuid:618a4cbc-96f5-2418-2639-3af82d532f5c"},{"@id":"urn:uuid:69cde080-6313-c37b-25d1-ecee6bb8fb7c"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"sv","@value":"Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag vid biologiska inventeringar samt för Försvarsmakten."},{"@language":"sv","@value":"Maringeologi 1:25 000 innehåller uppgifter om jordarternas och bergets utbredning inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Produkten ger bland annat information om bottenmaterial, olika sediments mäktighet och bildningssätt samt innehåll av organiskt material.\n\nSGU ansvarar för att utforska och kartlägga bottenförhållanden inom svenskt territorialhav och svensk ekonomisk zon (EEZ). Informationen som tas fram används som underlag vid planering av och beslut om skydd och nyttjande av havsbottnen, bland annat vid projektering av marina anläggningsarbeten och vid miljöövervakning. Den utgör också viktigt underlag för Försvarsmakten samt vid biologiska inventeringar."}],"dct:identifier":"23276dd6-90ab-435e-af05-f52331ad1c4e","dct:issued":{"@type":"xsd:date","@value":"2016-06-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SV"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b1n0"},"dct:temporal":{"@id":"_:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e_b2n0"},"dct:title":{"@language":"sv","@value":"Maringeologi 1:25 000"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:034b91b7-408f-52ac-c13d-2308ce645962","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/maringeologi-25000-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:3b8d6c9b-4c4d-c83c-47c3-5c12562e3d06","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/maringeologi25k/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:3c3009b3-fa08-e892-20af-f3a707ccfd16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-maringeologi.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst.Innehåller marina sedimentprov och maringeologisk kartinformation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:618a4cbc-96f5-2418-2639-3af82d532f5c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/maringeologi-25-tusen"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:69cde080-6313-c37b-25d1-ecee6bb8fb7c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/maringeologi25k/maringeologi25k.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}}],"@id":"urn:source:7f02c641ba2ca03b4eb6bb063c535df0cd9b6ae250d4d412c51d319f3ea2012e"},{"@graph":[{"@id":"_:7f75e3a9f840f5eb55125d3326a3098b3c759eaac6603861dee60d4cf8960255_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Sjöfartsverkets djupdatabas, som varit i drift sedan 2002, innehåller sjömätningsdata insamlat med allt från mekaniska handlod till moderna digitala metoder. I områden där det inte finns moderna mätningar lagras data som digitaliseras från äldre analoga kartor. De äldsta av dessa är från 1800-talets mitt. Inom vissa områden saknas djupinformation helt. Databasen fylls kontinuerligt på och uppdateras med nyinsamlad information. Denna stora variation av insamlingsmetoder och ålder på data innebär att databasen inte är homogen vad gäller kvalitet och datatäthet. Parallellt med den totala djupdatamängden innehåller djupdatabasen även 9 lager med en reducerad djupdatamängd; min-, max- och medeldjup tas fram inom varje ruta i ett rutnät med kvadratiska 20, 100 och 500 m rutor. För min- och maxdjup behålls de mätta djupens faktiska position och för medeldjup blir positionen mitt i varje ruta. Alla reducerade lager uppdateras automatiskt vid varje uppdatering av djupdatabasen."}},{"@id":"_:7f75e3a9f840f5eb55125d3326a3098b3c759eaac6603861dee60d4cf8960255_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/648DE577-B5DE-4A38-BE54-94C8028C34F4","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:8a118374-6606-0c8c-dcc5-2dd22802dd85"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Minsta djup (grundast)  i Sjöfartsverkets djupdatabas inom varje ruta i ett regelbundet rutnät med 500 m upplösning. Djupets faktiska position bibehålls. Djup genereras endast i rutor med minst ett mätt värde. Datamängden innehåller ingen information om datakvalitet."},"dct:identifier":"648DE577-B5DE-4A38-BE54-94C8028C34F4","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2015-12-01"},"dct:provenance":{"@id":"_:7f75e3a9f840f5eb55125d3326a3098b3c759eaac6603861dee60d4cf8960255_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:7f75e3a9f840f5eb55125d3326a3098b3c759eaac6603861dee60d4cf8960255_b1n0"},"dct:title":{"@language":"sv","@value":"Djupdata 500 m upplösning - minsta djup"}},{"@id":"urn:uuid:8a118374-6606-0c8c-dcc5-2dd22802dd85","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Maritima-Tjanster/Djupdata---detaljerad-djupinformation/"},"dct:description":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Djupdata - detaljerad djupinformation"}}],"@id":"urn:source:7f75e3a9f840f5eb55125d3326a3098b3c759eaac6603861dee60d4cf8960255"},{"@graph":[{"@id":"_:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. För Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.51 69.51,25.51 69.51,25.51 54.51,9.51 54.51,9.51 69.51))"}},{"@id":"_:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"_:7fce7f6a028ba5dca2eabf1090835bd2deba2ff864aebb0f03472e095ff83a16_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/5a52fadd-b6c2-818f-aa5b-3f8cf7d5a243","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"urn:uuid:4aedd6f9-cc2c-e7ae-d0fe-81c97e547c1f"},{"@id":"urn:uuid:ca96affc-6a42-245c-c3be-89aea45a8304"}],"dcat:distribution":[{"@id":"urn:uuid:90905d12-9bd2-022c-d0d4-0774d706ee55"},{"@id":"urn:uuid:c1e15b3f-08a1-ca8a-58fc-ea0a9051f5b2"},{"@id":"urn:uuid:e22b3eea-8d3c-4382-f87b-e47b84860e0f"}],"dcat:keyword":[{"@language":"sv","@value":"Anläggningar för miljöövervakning"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dcat: