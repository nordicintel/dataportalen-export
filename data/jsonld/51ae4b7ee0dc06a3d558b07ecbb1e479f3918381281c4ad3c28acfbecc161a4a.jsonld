8","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Havsplaneringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d3e6881966b30a8522210ef4ace7b4be8ef8cf28c95174b5a4d640bf6d71fbf4_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Havsplaneringsenheten"},{"@id":"urn:uuid:f8d1b1a0-2739-6a0a-9d75-c0c6fac4b450","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.60662d6719060e439995829e/1720078618557/R%C3%A4ttelse_v1_2024-07-03.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Rättelse av Konsekvensbeskrivning"}}],"@id":"urn:source:d3e6881966b30a8522210ef4ace7b4be8ef8cf28c95174b5a4d640bf6d71fbf4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/c1645388-b1a0-4ba6-b6bf-d75d3ad664fe","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/atom/inspire/sgu-inspiredownload.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Tjänsten syftar till att uppfylla Inspires krav på nedladdningstjänster genom att tillhandahålla fördefinierade datamängder i GML-format via ett RSS/Atomflöde."},{"@language":"sv","@value":"Tjänsten är Sveriges geologiska undersöknings nedladdningstjänst för fördefinierade datamängder som ingår i Inspiredirektivet. Via tjänsten kan de olika datamängder som SGU tillhandahåller inom Inspire laddas ner som zippade GML-filer. Tjänsten kommer att tillhandahålla både datamängder som uppfyller Inspires dataspecifikationer och datamängder som ännu inte harmoniserats enligt Inspires krav och riktlinjer."}],"dct:identifier":"c1645388-b1a0-4ba6-b6bf-d75d3ad664fe","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"SGU Inspire nedladdningstjänst (Atomflöde)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d48d82618280bacde39ead91cc4e4fd2178a35c2eab6d185ce6ec8f794c8dae3"},{"@graph":[{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Framtaget av Naturvårdsverket, Fiskeriverket och Riksantikvarieämbetet. Ska uppdateras inom de närmsta 5 åren."}},{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.50 69.50,25.00 69.50,25.00 54.50,10.50 54.50,10.50 69.50))"}},{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/ef5b9e32-e080-80ad-bff2-55955c9888f5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:99b93282-af50-6c75-9276-a68df68caeae"},"dcat:distribution":[{"@id":"urn:uuid:01f1f833-567d-4a4f-df7d-7cdfb8afd2b7"},{"@id":"urn:uuid:e998a842-ba67-2fc8-b673-b8aedcea2939"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Geografiska underlag som beskriver natur- och kulturvärden i limnisk miljö. Fungerat som prioriteringsunderlag i arbetet med skydd av sjöar och vattendrag, restaurering och åtgärdsarbete, samhällsplanering och för myndighetsarbete vid prövning och tillsyn."},"dct:identifier":"ef5b9e32-e080-80ad-bff2-55955c9888f5","dct:issued":{"@type":"xsd:date","@value":"2006-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-03"},"dct:provenance":{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b1n0"},"dct:title":{"@language":"sv","@value":"Värdefulla vatten"}},{"@id":"urn:uuid:01f1f833-567d-4a4f-df7d-7cdfb8afd2b7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/download/vardefulla-vatten/2021-02-02/vardefulla-vatten-2021-02-02.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Värdefulla vatten"}},{"@id":"urn:uuid:99b93282-af50-6c75-9276-a68df68caeae","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Enheten för biologisk mångfald","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:havochvatten@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Enheten för biologisk mångfald"},{"@id":"urn:uuid:e998a842-ba67-2fc8-b673-b8aedcea2939","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.havochvatten.se/geoservices/vardefulla-vatten/ows"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Värdefulla vatten"}}],"@id":"urn:source:d49a70414c09105d351b00151266ac79521f5ba0ca79b06cbba706b6c7d1cf78"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/9c820e32-6283-4b1a-b749-4c23f4760e50","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://resource.sgu.se/service/wms/130/jordarter-norra-sverige-250-tusen"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"Kartan Jordarter 1:250 000 nordligaste Sverige täcker nordligaste delen av Sverige och ger en mycket översiktlig bild av jordarternas fördelning och landformer. Kartan kan användas som ett mycket översiktligt planerings- och resurshushållningsunderlag för prospekteringsföretag, länsstyrelse, kommuner m.fl. intressenter. Kartbilden är generaliserad för presentation i skala 1:250 000 och minsta redovisade yta är ca 0,1 km2."},"dct:identifier":"9c820e32-6283-4b1a-b749-4c23f4760e50","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:title":{"@language":"sv","@value":"Jordarter 1:250 000, Nordligaste Sverige (visningstjänst)"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d56ba908081b3631a1f2ece18194e31dcafe0625792db6e9e96b686a44b46202"},{"@graph":[{"@id":"_:d58e0bb2a01dd50ac9a47a6aa82fd2c34377653ace151fc3f33749c927f9b92f_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.311680763587669 69.7759699910859,25.749079350189504 69.7759699910859,25.749079350189504 54.72996544132201,7.311680763587669 54.72996544132201,7.311680763587669 69.7759699910859))"}},{"@id":"_:d58e0bb2a01dd50ac9a47a6aa82fd2c34377653ace151fc3f33749c927f9b92f_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021006420","@type":"foaf:Agent","dct:identifier":"2021006420","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:havochvatten@havochvatten.se"},"foaf:name":{"@language":"sv","@value":"Havs- och Vattenmyndigheten"},"foaf:page":{"@id":"https://www.havochvatten.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/1"}},{"@id":"https://www.geodata.se/resources/15d3ec8f-bd44-0f89-155b-c9440ce916c8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e"},"dcat:distribution":{"@id":"urn:uuid:1764a6a4-341b-09c7-d090-055c72a72b38"},"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Statusbedömning för fisk i sjöar"},"dct:identifier":"15d3ec8f-bd44-0f89-155b-c9440ce916c8","dct:issued":{"@type":"xsd:date","@value":"2017-01-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-01-18"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006420"},"dct:spatial":{"@id":"_:d58e0bb2a01dd50ac9a47a6aa82fd2c34377653ace151fc3f33749c927f9b92f_b0n0"},"dct:title":{"@language":"sv","@value":"Fisk i sjöar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_e1da4e07"}},{"@id":"urn:uuid:1764a6a4-341b-09c7-d090-055c72a72b38","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/download/18.57f200c11929bb6637e8c3e/1729251984210/dataunderlag-diagram-bedomning-av-fiskfaunans-ekologiska-status-i-trendsjoar-1994-2021.xlsx"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Bedömning av fiskfaunans ekologiska status i trendsjöar, via provfisken"}},{"@id":"urn:uuid:3589507b-cf2d-295f-d385-1c96bd8cd17e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöövervakningsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d58e0bb2a01dd50ac9a47a6aa82fd2c34377653ace151fc3f33749c927f9b92f_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoovervakning@havochvatten.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Miljöövervakningsenheten"}],"@id":"urn:source:d58e0bb2a01dd50ac9a47a6aa82fd2c34377653ace151fc3f33749c927f9b92f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021000712","@type":"foaf:Agent","dct:identifier":"2021000712","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgi@swedgeo.se"},"foaf:name":{"@language":"sv","@value":"Statens geotekniska institut"},"foaf:page":{"@id":"https://www.swedgeo.se"}},{"@id":"https://www.geodata.se/resources/a8d30808-d3a7-4d97-ae82-d2838c2a06cb","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://mapsext.sgi.se/geoserver/wms?request=GetCapabilities&service=WMS"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"SGI Statens geotekniska institut är statens sakkunnigorgan i skred-, ras- och stranderosionsfrågor och medverkar till att minska riskerna inom det geotekniska området i samhället. Utgångspunkten för verksamheten är att människor ska kunna bo på säker grund, så att liv och egendom inte går till spillo vid naturolyckor av typen skred och ras eller vid stranderosion. \nSGI's skreddatabas är en sammanställning över inträffade skred, ras och övriga jordrörelser i Sverige med tillhörande beskrivning av typ av händelse, omfattning, läge etc - se vidare SGI Varia 512. Antal objekt nov 2016: 1501 st. Vissa större skred har en utförligare beskrivning (orsak, händelseförlopp, erfarenhetsåterföring mm) i MSB's Naturolycksdatabas.\n[Geoteknik]"},"dct:identifier":"a8d30808-d3a7-4d97-ae82-d2838c2a06cb","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000712"},"dct:title":{"@language":"sv","@value":"Inträffade skred, ras och övriga jordrörelser (skreddatabas) - WMS"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d612e2dd6533124eb5b53bd97f08d8bdcfec2a9b377b086c03170ab19abb9b31"},{"@graph":[{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 60.9085,19.991 60.9085,19.991 55.1372,10.592 55.1372,10.592 60.9085))"}},{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.679361661249 60.855415345455,19.99108363737 60.855415345455,19.99108363737 55.137212557872,10.679361661249 55.137212557872,10.679361661249 60.855415345455))"}},{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/4b8f6d97-e309-4ec1-995c-3bcc09d10ecb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c"},"dcat:distribution":[{"@id":"urn:uuid:1d26010c-900f-3d7b-4476-8679f47972b7"},{"@id":"urn:uuid:302144c2-7c18-672b-990e-0a7c09d94ed4"},{"@id":"urn:uuid:327c39d4-f771-1c08-35b6-385bbe1b3b25"},{"@id":"urn:uuid:7d460a9f-eb6a-db70-4150-97b269a9b587"},{"@id":"urn:uuid:d0622ee3-dab0-233b-01d1-7def452726b5"}],"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Detta kartlager visar Länsstyrelsernas tolkning av de områden som riksdagen beslutat är av riksintresse för högexploaterad kust enligt 4 kap. 4 § miljöbalken.  Denna bestämmelse har sitt ursprung i lagen (1987:12) om hushållning med naturresurser m.m. Då riksdagen fattade beslut om riksintresset fanns den geografiska avgränsningen enbart beskriven i text med ortsnamn och/eller andra geografiskt fasta punkter, samt en grov illustration i förarbetena (prop. 1985/86:3). Länsstyrelserna har senare gjort en mer preciserad tolkning av den geografiska avgränsningen i samråd med berörda kommuner.\n \nObservera att detta gis-skikt endast är en indikativ tolkning av gränserna. För aktuell avgränsning se gällande översiktsplan. Det är i den kommunala översiktsplaneringen som innebörden av de geografiska riksintressebestämmelserna i 4 kap miljöbalken kan konkretiseras.\n \nFör mer information om bakgrunden till riksintressebestämmelserna, se Boverkets vägledning i PBL kunskapsbanken."},"dct:identifier":"4b8f6d97-e309-4ec1-995c-3bcc09d10ecb","dct:issued":{"@type":"xsd:date","@value":"2020-03-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":[{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b0n0"},{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b1n0"}],"dct:title":{"@language":"sv","@value":"LST Riksintresse Högexploaterad kust MB4kap1,4"}},{"@id":"urn:uuid:1d26010c-900f-3d7b-4476-8679f47972b7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/services/LST/LST_Riksintressen_EXT/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"WMS tjänst"},"dct:title":{"@language":"sv","@value":"4"}},{"@id":"urn:uuid:302144c2-7c18-672b-990e-0a7c09d94ed4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/Gemensamt/Geodata/Datadistribution/ZIP/LST_RI_Hogexploateradkust_MB4kap4.zip"},"dct:description":{"@language":"sv","@value":"LST_RI_Hogexploateradkust_MB4kap4.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"LST_RI_Hogexploateradkust_MB4kap4.zip"}},{"@id":"urn:uuid:327c39d4-f771-1c08-35b6-385bbe1b3b25","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/sv/PBL-kunskapsbanken/riksintressen/riksintressen-enligt-4-kap-mb/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Boverket PBL-kunskapsbanken"}},{"@id":"urn:uuid:5fce2a3e-0afc-ea9c-db21-8a873de78d6c","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Förvaltningsobjekt Samhällsplanering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsplanering@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Förvaltningsobjekt Samhällsplanering"},{"@id":"urn:uuid:7d460a9f-eb6a-db70-4150-97b269a9b587","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-geodata-nationella-visning.lansstyrelsen.se/arcgis/rest/services/LST/LST_Riksintressen_EXT/MapServer/1"},"dct:description":{"@language":"sv","@value":"Restgränssnitt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"LST Riksintresse högexploaterad kust MB4kap1,4"}},{"@id":"urn:uuid:d0622ee3-dab0-233b-01d1-7def452726b5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_lst.Lst_RI_Hogexploateradkust_MB4kap4.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:d64bd06e0cd0edb492fb0117ee34c41078f49a0eff58590fed7faeab996e2d38"},{"@graph":[{"@id":"_:d6a791435596963e36ac60610fa765664e8e39f6a0d5896b1418dae43126d250_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen har samlats in genom manuell registrering och digitalisering i samband med regionala inventeringar. Rekommenderad presentationsskala är 1:50 000-1:250 000."}},{"@id":"_:d6a791435596963e36ac60610fa765664e8e39f6a0d5896b1418dae43126d250_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/2999b34a-dca5-4a83-87c8-bfbdd69e4f8d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:0981b5d0-23ef-3128-0618-54e7d75fbe79"},{"@id":"urn:uuid:184f3e7b-e3ff-5a7a-676f-0216a937018b"},{"@id":"urn:uuid:55581c21-7f2a-94ec-41c7-30912ebaba21"},{"@id":"urn:uuid:8405aa0f-f9dd-23cc-a0c9-c0b1390fad65"},{"@id":"urn:uuid:c001967d-bed7-c13b-588a-d01e508c565a"},{"@id":"urn:uuid:f30e9a77-4d8e-dddb-ce9c-448d649433b8"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"sv","@value":"Informationen är avsedd att utgöra ett underlag för planering och hållbart utnyttjande av naturresurser."},{"@language":"sv","@value":"Produkten innehåller uppgifter om läge, utbredning, uttagbar volym, kvalitet, materialtyp och naturvärden för grus-, berg- och moränförekomster. Informationen kan anpassas till olika användnings¬områden. Några exempel är täkttillståndsprövning, översikter och samman¬ställningar samt kommunal planering med översikts-, hushållnings- och naturresursplaner. Informationen har samlats in genom manuell registrering och digitalisering i samband med regionala inventeringar. Rekommenderad presentationsskala är 1:50 000 - 1:250 000."}],"dct:identifier":"2999b34a-dca5-4a83-87c8-bfbdd69e4f8d","dct:issued":{"@type":"xsd:date","@value":"2008-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:d6a791435596963e36ac60610fa765664e8e39f6a0d5896b1418dae43126d250_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:d6a791435596963e36ac60610fa765664e8e39f6a0d5896b1418dae43126d250_b1n0"},"dct:title":{"@language":"sv","@value":"Grus och krossberg"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:0981b5d0-23ef-3128-0618-54e7d75fbe79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grus-krossberg-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:184f3e7b-e3ff-5a7a-676f-0216a937018b","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/grus-krossberg/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:55581c21-7f2a-94ec-41c7-30912ebaba21","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:8405aa0f-f9dd-23cc-a0c9-c0b1390fad65","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/grus-krossberg/grus-krossberg.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:c001967d-bed7-c13b-588a-d01e508c565a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/service/wms/130/ballast"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:uuid:f30e9a77-4d8e-dddb-ce9c-448d649433b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-ballast.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:d6a791435596963e36ac60610fa765664e8e39f6a0d5896b1418dae43126d250"},{"@graph":[{"@id":"_:d6ea99823dcb5e05bdd578f8ea54701e109bbb97c547344dbebcf9904b6580a6_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Gävle","http://www.w3.org/2006/vcard/ns#postal-code":"802 64","http://www.w3.org/2006/vcard/ns#street-address":"Lantmäterigatan 2D"},{"@id":"_:d6ea99823dcb5e05bdd578f8ea54701e109bbb97c547344dbebcf9904b6580a6_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:010-121-81-00"}},{"@id":"http://dataportal.se/organisation/SE2021004284","@type":"foaf:Agent","dct:identifier":"2021004284","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@svk.se"},"foaf:name":{"@language":"sv","@value":"Svenska kraftnät"},"foaf:page":{"@id":"https://www.svk.se"}},{"@id":"https://www.geodata.se/resources/bf46495a-2a8b-4440-b431-ba9966f47eb9","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"urn:uuid:4efb458d-a1cf-0420-a058-77617952d7e4"},"dcat:endpointURL":{"@id":"https://gis-services.metria.se/svkfeed/svk_topfeed_transmission.xml"},"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Stamnätets ledningar är motorvägar i elsystemet. Via stamnätet transporteras elen från de stora kraftverken till alla lokala och regionala elnät i Sverige. Det svenska stamnätet för el består av 15 000 km kraftledningar, 160 transformator- och kopplingsstationer och 17 utlandsförbindelser."},"dct:identifier":"bf46495a-2a8b-4440-b431-ba9966f47eb9","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004284"},"dct:title":{"@language":"sv","@value":"US.TransmissionsnätFörEl.Atom"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}},{"@id":"urn:uuid:4efb458d-a1cf-0420-a058-77617952d7e4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"GIS Support GIS Support","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d6ea99823dcb5e05bdd578f8ea54701e109bbb97c547344dbebcf9904b6580a6_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support@metria.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d6ea99823dcb5e05bdd578f8ea54701e109bbb97c547344dbebcf9904b6580a6_b1n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Metria AB"}],"@id":"urn:source:d6ea99823dcb5e05bdd578f8ea54701e109bbb97c547344dbebcf9904b6580a6"},{"@graph":[{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Dropvideo i transekter på 10 meter och sedan analys av 10 stycken 1m2 ytor längs med transekten. Tillkom 2015-2018. Utfördes av konsult."}},{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.95232 58.59666,19.44639 58.59666,19.44639 56.82802,17.95232 56.82802,17.95232 58.59666))"}},{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/767b01df-da2a-48e0-a4b3-3bebc8ea23cf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5"},"dcat:distribution":{"@id":"urn:uuid:111bc6e4-5561-ed1e-31c4-3025dcbac2c0"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Lst I naturvärdeskartering. Anger hur höga naturvärden som finns på en 1m2 yta. Data insamlad med dropvideo och sedan analyserad av konsulter. Insamlad mellan åren 2015-2018."},"dct:identifier":"767b01df-da2a-48e0-a4b3-3bebc8ea23cf","dct:issued":{"@type":"xsd:date","@value":"2018-09-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-09-28"},"dct:provenance":{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b1n0"},"dct:title":{"@language":"sv","@value":"LstI Hav Naturvärden"}},{"@id":"urn:uuid:111bc6e4-5561-ed1e-31c4-3025dcbac2c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lsti.Hav_Poang_GIS_max.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:c5bf71b9-52f6-5334-e06a-0d63ff2c3ed5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstI Miljö- och vattenenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gotland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstI Miljö- och vattenenheten"}],"@id":"urn:source:d81eca6c2896ccda7ebfdd510837725a3d04235e4110061e29b6389d2fa46dbf"},{"@graph":[{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Produkten innehåller både översiktlig information (skala 1:250 000) och mer detaljerad information (skala 1:50 000). I områden där detaljerad information finns framtagen har den översiktliga informationen ersatts av den detaljerade informationen. Vilka objekt som karterats med respektive metod framgår av lagret ”Karteringsmetod”. Den översiktliga informationen har sitt ursprung i SGU:s länskartor som finns publicerade i SGU:s serie Ah.\n\nInformationen är framtagen genom insamling av tidigare gjorda utredningar via kommuner och länsstyrelser, besiktningar i fält, källinventering m.m. För den detaljerade informationen har mer omfattande fältarbeten utförts i form av geofysiska arbeten (t.ex. seismik, resistivitet och georadar), borrningar, sonderingar, grundvattennivåmätningar m.m. Den detaljerade informationen är i regel baserad på ett bättre underlag än den översiktliga, i form av t.ex. modernare jordartsunderlag, terrängkartor etc. Insamling av information i ett område har gjorts under en viss period (engångsinsamling) och har i regel inte uppdaterats sedan dess."}},{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1980"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/703e7a68-714d-477e-a508-a482f291a69b","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:18afeaa5-1e76-ea71-2b13-72092e0f545e"},{"@id":"urn:uuid:788cfd5e-2528-cfad-d905-555ecfe500b3"},{"@id":"urn:uuid:9a3717c9-05bd-e054-d33d-81cfe9af7014"},{"@id":"urn:uuid:a3bac9bf-cf41-dadd-5fec-503d0ee98160"},{"@id":"urn:uuid:b913fd02-2a09-3ede-09da-a5da81b2dc85"},{"@id":"urn:uuid:c8eccc92-33c7-964b-1df2-a842f46c1c6f"},{"@id":"urn:uuid:d2335bdd-d8c3-6738-90cf-cd84aede107b"},{"@id":"urn:uuid:d47a557d-6ca7-9912-d95e-d6b4b2e87972"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"sv","@value":"Produkten Grundvattenmagasin innehåller framför allt information om grundvatten i större magasin längs grusåsar och i sedimentär berggrund. Vid kartläggningen av grundvattenmagasinen bestäms bl.a. grundvattnets strömningsriktningar, grundvattendelares lägen samt grundvattenmagasinets storlek och uttagsmöjligheter. Vid kartering i detaljerad skala bestäms även tillrinningsområden till magasinet, ytvattenkontakter m.m.\n\nSGU:s information om grundvatten utgör ett viktigt underlag i planeringen av samhällets vattenförsörjning. Den är också en av förutsättningarna för att vi i Sverige ska kunna uppnå miljökvalitetsmålet Grundvatten av god kvalitet och bidrar till att vi ska kunna uppfylla de krav som ställs i EG:s ramdirektiv för vatten. Dessutom används grundvatteninformationen i frågor som rör markanvändning och fysisk planering i allmänhet, t.ex. som underlag för miljökonsekvensbeskrivningar, för åtgärdsprogram för skydd av grundvattnet och vid byggen av deponier, vägar, industrier m.m."},{"@language":"sv","@value":"SGUs information om grundvatten utgör ett viktigt underlag i planeringen av samhällets vattenförsörjning. Den är också en av förutsättningarna för att vi i Sverige ska kunna uppnå miljökvalitetsmålet Grundvatten av god kvalitet och bidrar till att vi ska kunna uppfylla de krav som ställs i EGs ramdirektiv för vatten. Dessutom används grundvatteninformationen i frågor som rör markanvändning och fysisk planering i allmänhet, t.ex. som underlag för miljökonsekvensbeskrivningar, för åtgärdsprogram för skydd av grundvattnet och vid byggen av deponier, vägar, industrier m.m."}],"dct:identifier":"703e7a68-714d-477e-a508-a482f291a69b","dct:issued":{"@type":"xsd:date","@value":"2012-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-18"},"dct:provenance":{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b1n0"},"dct:temporal":{"@id":"_:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe_b2n0"},"dct:title":{"@language":"sv","@value":"Grundvattenmagasin"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:18afeaa5-1e76-ea71-2b13-72092e0f545e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattenmagasin-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning - Esri"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:788cfd5e-2528-cfad-d905-555ecfe500b3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattenmagasin-beskrivning-esri.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning - Esri"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:9a3717c9-05bd-e054-d33d-81cfe9af7014","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://apps.sgu.se/kartvisare/kartvisare-grundvattenmagasin.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}},{"@id":"urn:uuid:a3bac9bf-cf41-dadd-5fec-503d0ee98160","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/grundvattenmagasin?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:title":{"@language":"sv","@value":"Visningstjänst"}},{"@id":"urn:uuid:b913fd02-2a09-3ede-09da-a5da81b2dc85","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/grundvattenmagasin/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:c8eccc92-33c7-964b-1df2-a842f46c1c6f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/grundvattenmagasin-beskrivning-mapinfo.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning - Mapinfo"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:d2335bdd-d8c3-6738-90cf-cd84aede107b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/grundvattenmagasin/grundvattenmagasin.zip"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning - Mapinfo"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:d47a557d-6ca7-9912-d95e-d6b4b2e87972","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apps.sgu.se/kartvisare/kartvisare-grundvattenmagasin.html"},"dct:description":{"@language":"sv","@value":"Kartvisarapplikation för presentation av WMS-lager."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Kartvisare"}}],"@id":"urn:source:d8408bff3f9aa40910330721a30413edbb0527fcf3995998c662904de0f82ffe"},{"@graph":[{"@id":"_:d8537a9ad94fd25e37415e54d3f87bff11ded03c5a86461164120266862c2e74_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data avseende djupinformation har sitt ursprung i sjömätningar från 1820 och framåt. Nautisk information uppdateras dagligen. Övrig data kommer från externa källor."}},{"@id":"_:d8537a9ad94fd25e37415e54d3f87bff11ded03c5a86461164120266862c2e74_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.30 65.87,23.51 65.87,23.51 54.80,10.30 54.80,10.30 65.87))"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8A96234B-5816-4BE2-A9C5-6E8D0729B46D","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:df75285b-c7de-8fd8-251f-ac89b7e8a870"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"I många sjökort finns specialer, d.v.s. oftast mindre områden som redovisas i bättre skala än huvudkortet. Mestadels över större och mindre hamnar."},"dct:identifier":"8A96234B-5816-4BE2-A9C5-6E8D0729B46D","dct:issued":{"@type":"xsd:date","@value":"2012-10-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2012-10-18"},"dct:provenance":{"@id":"_:d8537a9ad94fd25e37415e54d3f87bff11ded03c5a86461164120266862c2e74_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:d8537a9ad94fd25e37415e54d3f87bff11ded03c5a86461164120266862c2e74_b1n0"},"dct:title":{"@language":"sv","@value":"Sjökort - Specialer"}},{"@id":"urn:uuid:df75285b-c7de-8fd8-251f-ac89b7e8a870","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.sjofartsverket.se/sv/Sjofart/Sjokort/"},"dct:description":{"@language":"sv","@value":"Sjökort och Publikationer på Sjöfartsverkets officiella hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Sjökort och Publikationer"}}],"@id":"urn:source:d8537a9ad94fd25e37415e54d3f87bff11ded03c5a86461164120266862c2e74"},{"@graph":[{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ortofoto är flygbildsdata som korrigerats geometriskt till en skalriktig avbildning av markytan. Det sker genom att bilderna räknas om från flygbildens centralprojektion till en ortogonal projektion. En noggrann höjdmodell har använts för att korrigera för variationer i flygbildens skala som orsakas av höjdskillnader i terrängen. De digitala bilderna räknas om till ortofoto med enhetlig skala. Lantmäteriets ortofoton är mosaiker av flera bilder, där bara de mest centrala delarna av bilderna används. Skarvarna mellan bilderna döljs så långt det är möjligt. \n\nFör äldre ortofoton med 0,5 m upplösning har höjddata 50 m (den gamla höjdmodellen) använts, vilket ger ett förväntat medelfel i plan på ca 1 m. För nyare ortofoton med 0,5 m upplösning, som bygger på 20 m grid från den nya höjdmodellen, är medelfelet ungefär detsamma. Däremot är tillförlitligheten större och lokalt kan det vara betydligt bättre geometri (jämfört med de ortofoton där den gamla höjdmodellen använts), framför allt i ytterkanterna av flygstråken, där höjdmodellen har störst påverkan. Vid framställningen av ortofoto med upplösningen 0,25 m användes en höjdmodell med 10 m grid, som ger ett beräknat medelfel i plan på ca 0,30 m i det färdiga ortofotot. För enskilda tätorter har höjdmodellen tidigare framställts genom bildmatchning och manuell editering. Där den nya höjdmodellen funnits tillgänglig har ett grid med 4 m upplösning använts. Det påverkar noggrannheten i ortofotot marginellt, men lokalt kan det vara avsevärt bättre geometri, framför allt i ytterkanterna av flygstråken. Ortofoton med upplösningen 0,16 m/pixel resp. 0,4 m/pixel (d.v.s. ortofoton fr.o.m. 2019) har uppskattade medelfel på 0,2 m resp. 0,8 meter.\n\nFlygbilder med 0,48 meters upplösning ger ortofoton med 0,5 meter/pixel (vilket alltså motsvarar 0,5 x 0,5 meter på marken) och flygbilder med 0,24 meters upplösning ger ortofoton med 0,25 meter/pixel. Flygbilder med 0,37 meters upplösning ger ortofoton med 0,4 meter/pixel och flygbilder med 0,15 meters upplösning ger ortofoton med 0,16 meter/pixel. \n\nOrtofoton i färg (RGB) respektive IR (IRG) har en radiometrisk upplösning på 24 bitar (8 bitar per färgband) och ortofoton i 4 kanaler har en radiometrisk upplösning på 32 bitar. Ortofotona har vanligtvis osynliga sömmar för samtliga ingående bilder."}},{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2006"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/223e1f42-2992-4ccb-9acb-aec9cd47deb2","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1648d4b2-c521-8fb3-3c17-5b3218c8d095"},{"@id":"urn:uuid:1915be75-945b-30ed-8560-e9022d4f91e7"},{"@id":"urn:uuid:ca589a5c-ab3a-edf3-03c4-8f17d8432705"}],"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller ortofoton, som är flygbilder skalriktiga i markplan."},"dct:identifier":"223e1f42-2992-4ccb-9acb-aec9cd47deb2","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-01"},"dct:provenance":{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b1n0"},"dct:temporal":{"@id":"_:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac_b2n0"},"dct:title":{"@language":"sv","@value":"Ortofoto"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"}},{"@id":"urn:uuid:1648d4b2-c521-8fb3-3c17-5b3218c8d095","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/ortofoto-nedladdning-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Ortofoto Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Ortofoto Nedladdning"}},{"@id":"urn:uuid:1915be75-945b-30ed-8560-e9022d4f91e7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/ortofoto/atom/v1/inspire/oi"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt till atomflödet för Ortofoto Nedladdning Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till atomflödet för Ortofoto Nedladdning Inspire"}},{"@id":"urn:uuid:ca589a5c-ab3a-edf3-03c4-8f17d8432705","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/stac-bild/v1/"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Ortofoto Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till STAC nedladdningstjänst"}}],"@id":"urn:source:d9322882bfbd6e189aa3238bdac07599df2a0fa069a65704a7f51c9444dec0ac"},{"@graph":[{"@id":"_:d95d4409adb95a300cb8a4c9b605a622ff0701924d41415aff8209a79f82a8fb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Laserskanning från flygplan. Laserpunktmolnet genomgår kvalitetsgranskning och klassificering av laserpunkter till mark, vatten, broar och övrigt."}},{"@id":"_:d95d4409adb95a300cb8a4c9b605a622ff0701924d41415aff8209a79f82a8fb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.26 68.83,25.59 68.83,25.59 55.26,11.26 55.26,11.26 68.83))"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8f5e284e-1cff-4f38-a023-1545c501f989","@type":"dcat:Dataset","dcat:distribution":{"@id":"urn:uuid:9a9d8d6d-2c41-a99e-7c64-31f228cc8ff9"},"dcat:keyword":{"@language":"sv","@value":"Geodatasamverkan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Laserdata Nedladdning, NH utgörs av ett punktmoln med klassificerade punkter baserad på laserdata insamlade åren 2009-2019 med en punkttäthet av 0,5-1 punkter per kvadratmeter, ner till 0,25 punkter per kvadratmeter i kalfjällsområden. Tidigare hette produkten Laserdata NH."},"dct:identifier":"8f5e284e-1cff-4f38-a023-1545c501f989","dct:issued":{"@type":"xsd:date","@value":"2009-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-02"},"dct:provenance":{"@id":"_:d95d4409adb95a300cb8a4c9b605a622ff0701924d41415aff8209a79f82a8fb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:d95d4409adb95a300cb8a4c9b605a622ff0701924d41415aff8209a79f82a8fb_b1n0"},"dct:title":{"@language":"sv","@value":"Laserdata Nedladdning, NH"}},{"@id":"urn:uuid:9a9d8d6d-2c41-a99e-7c64-31f228cc8ff9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/laserdata-nedladdning-nh"},"dct:description":{"@language":"sv","@value":"Produktsida för Laserdata Nedladdning, NH"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Lantmäteriets webbplats"}}],"@id":"urn:source:d95d4409adb95a300cb8a4c9b605a622ff0701924d41415aff8209a79f82a8fb"},{"@graph":[{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Den befintliga ythydrografin delas upp i sjöar och vattendrag och befintliga linjevattendrag knyts ihop med stomlinjer genom vattenytorna. Flödesriktning beräknas med hjälp av det nya högkvalitativa höjddata som finns. Unika ID:n samt övrig nödvändig attributinformation genereras för den objektifierade datamängden. Nätverket skapas där logiken, alltså vilket objekt ligger nedströms vilket objekt, hämtas från geometrierna och dess attribut.\n\nThe existing hydrography are split into lakes and streams and existing streams are tied together with fictitious axis \nthrough the water surface. Flow direction is calculated using the new high-quality elevation data available. Unique IDs and other necessary attribute information are generated for the objectified data set. A network is created."}},{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2015-01-14"}},{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/a2acb721-a900-42e7-9386-90f712836e64","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:19b79204-81b6-a59d-7f1a-36d0546ffa2f"},{"@id":"urn:uuid:1f081157-47eb-705c-8429-d8f7ba0a7603"},{"@id":"urn:uuid:38b0555b-337f-4876-a948-421ff10f28bd"},{"@id":"urn:uuid:603eeae5-7bcc-9523-adb1-6b4161457699"},{"@id":"urn:uuid:7acfe9e6-94bd-92a4-58f9-8d5ae9b7eb93"},{"@id":"urn:uuid:d83f3bc9-a704-940d-b311-53c5768f68aa"},{"@id":"urn:uuid:ed21721a-1641-febe-52fc-da50f09fc300"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sjöar och vattendrag med nätverksbildad hydrografi för skalområde 1:10 000.\nDatamängden kan inte beställas separat utan ingår endast i befintliga tjänster: Hydrografi Direkt, Hydrografi Nedladdning och Hydrografi Visning Inspire."},"dct:identifier":"a2acb721-a900-42e7-9386-90f712836e64","dct:issued":{"@type":"xsd:date","@value":"2015-01-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-01"},"dct:provenance":{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:spatial":{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b1n0"},"dct:temporal":{"@id":"_:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0_b2n0"},"dct:title":{"@language":"sv","@value":"Hydrografi"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"urn:uuid:19b79204-81b6-a59d-7f1a-36d0546ffa2f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.lantmateriet.se/hydrografi/atom/v1.1/"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt till atomflöde för Hydrografi Nedladdning, nätverk"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt till atomflöde, nätverk"}},{"@id":"urn:uuid:1f081157-47eb-705c-8429-d8f7ba0a7603","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/hydrografi-visning-inspire-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Visning Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Visning Inspire"}},{"@id":"urn:uuid:38b0555b-337f-4876-a948-421ff10f28bd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/hydrografi-direkt-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Direkt"}},{"@id":"urn:uuid:603eeae5-7bcc-9523-adb1-6b4161457699","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/capabilities/inspire/hy/wms/v1?service=WMS&request=GetCapabilities&version=1.1.1"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt till tjänsten Hydrografi Visning Inspire (Öppen capabilityfil)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Hydrografi Visning Inspire (Öppen capabilityfil)"}},{"@id":"urn:uuid:7acfe9e6-94bd-92a4-58f9-8d5ae9b7eb93","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.lantmateriet.se/ogc-features/v1/hydrografi"},"dct:description":{"@language":"sv","@value":"Åtkomstpunkt för Hydrografi Direkt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida för OGC API Features"}},{"@id":"urn:uuid:d83f3bc9-a704-940d-b311-53c5768f68aa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/hydrografi-nedladdning-api"},"dct:description":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Produktdokumentation för Hydrografi Nedladdning"}},{"@id":"urn:uuid:ed21721a-1641-febe-52fc-da50f09fc300","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://maps.lantmateriet.se/inspire/hy/wms/v1?service=WMS&request=GetCapabilities&version=1.1.1"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Åtkomstpunkt till tjänsten Hydrografi Visning Inspire (ordinarie åtkomstpunkt)"},"dct:title":{"@language":"sv","@value":"Åtkomstpunkt Hydrografi Visning Inspire (ordinarie åtkomstpunkt)"}}],"@id":"urn:source:d987788d201088941acfaefd838896223ca62eafa9e8e6634c0c9413476c96b0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004888","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Lantmäteriet tillgängliggör datamängder som fastighetsinformation ( ej adresser, byggnader, gränser, beteckningar), Swepos Nätverks-RTK, visningstjänster för geografisk information, Laserdata NH och flygbilder. Avgifter tas ut genom transaktionsbaserad avgift, abonnemang eller engångsuttag. Avgiftens storlek varierar, men exempel är: 750 kr i administrativ avgift per beställning, 800 kr per timme för bearbetning."},"dct:identifier":"2021004888","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:lantmateriet@lm.se"},"foaf:name":{"@language":"sv","@value":"Lantmäteriet"},"foaf:page":{"@id":"https://www.lantmateriet.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.geodata.se/codelist/organisationer/lantmateriet"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/099b8d93-c8c1-4a66-9eba-13d6db1085a7","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:endpointURL":{"@id":"https://geotorget.lantmateriet.se/geodataprodukter/fastighetsindelning-visning-api"},"dcat:keyword":[{"@language":"sv","@value":"Geodatasamverkan"},{"@language":"sv","@value":"Inspire"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Med våra visningstjänster kan du använda Lantmäteriets kartor i dina egna system eller applikationer. Visningstjänsterna går att kombinera med våra övriga geodatatjänster. Tjänsten ger tillgång till fastighetsinformation från Lantmäteriets grunddatalager. Kartinformationen är uppdelad i tio separata skikt. För vart och ett av skikten finns ett eller flera fördefinierade presentationssätt, så kallade ”stilar”.\nTjänsten uppfyller EU-direktivet Inspire för temat Fastighetsområden (Cadastral parcels). Inspireinformationen finns i skikten Cadastral parcels, Cadastral boundary och Cadastal zoning."},"dct:identifier":"099b8d93-c8c1-4a66-9eba-13d6db1085a7","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004888"},"dct:title":{"@language":"sv","@value":"Fastighetsindelning Visning"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:d993692b4b50871f99832e3469eed0755e9eaf697ecaac38c59e444adca44074"},{"@graph":[{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havsgränsutredningen har redovisat sitt arbete i betänkandet SOU 2015:10 ”Gränser i havet” som resulterat i proposition och riksdagsbeslut och ett antal nya eller justerade lagar och förordningar som gäller från 1 mars 2018. Begreppen som tillämpas baseras på Förenta Nationernas Havsrättskonvention 1982."}},{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.00 66.00,24.50 66.00,24.50 54.50,10.00 54.50,10.00 66.00))"}},{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2018-03-01"}},{"@id":"http://dataportal.se/organisation/SE2021000654","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Sjöfartsverket tillgängliggör datamängder som sjögeografisk data, fartygsrörelser och vind- och vattendata, inom sin avgiftsfinansierade verksamhetsdel. Avgifter tas ut genom engångsavgift, månadsavgift, årsavgift, löpande eller royalties beroende på tjänst eller transaktion. Avgiftens storlek kan variera mellan 1 000 kr upp till 300 000kr i engångsavgifter inklusive potentiell royalty, och löpande årliga eller månatliga kostnader som kan ligga på 1 000 kronor upp till 100 000kr. Kostnadsfria datamängder omfattar havsgränser, vind- och vattendata och lågupplöst djupdata"},"dct:identifier":"2021000654","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:info@sjofartsverket.se"},"foaf:name":{"@language":"sv","@value":"Sjöfartsverket"},"foaf:page":{"@id":"https://www.sjofartsverket.se"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://www.geodata.se/resources/8117e790-311b-4e3d-b3ba-f403bd639603","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:14bac632-62d2-72f4-ef5d-ac052f4915e9"},{"@id":"urn:uuid:ecb390b6-01cc-9f8d-9362-5b5e4870b23e"}],"dcat:keyword":{"@language":"sv","@value":"Administrativa enheter"},"dcat:theme":{"@id":"http://inspire.ec.europa.eu/theme/au"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"En sammanhållen lag har utformats för att redovisa flera typer av gränser. En så kallad ”angränsande zon” inrättas som sträcker sig upp till 24 nautiska mil utanför baslinjerna och går längs de sträckor där sjöterritoriets gräns i havet inte når ut till den med grannländerna överenskomna avgränsningslinjen. Det bildas ett område, som en enklav, mellan Gotland och fastlandet som inte ingår i den angränsande zonen.\n\nFöljande attribut finns i punkt shape-filen:\nDelsträcka – Angränsande zon redovisas med följande delsträckor; Västkusten, Östersjön, Mellan Gotland och fastland, Bottenhavet, Bottenviken.\nLöpnr_dels - Löpnummer för punkter (AZ) för respektive delsträcka.\nLöpnr_AZ - Löpnummer för signifikanta punkter på den angränsande zonens yttre avgränsningslinje.\nLatitud & Longitud - Alla punkter utmed gränsen beskrivs med geografiska koordinater i latitud och longitud uttryckta i referenssystemet SWEREF 99 dels i grader och decimala minuter som det står i lagen och dels i decimala grader.\nPunkttyp - Följande punkttyper förekommer:\n• brytpunkt på den angränsande zonens avgränsningslinjer (AZ),\n• segmenterad punkt på en rät geodetisk linje mellan två brytpunkter (MP),\n• segmenterad punkt på en cirkelbåge mellan två brytpunkter (MC).\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner.\nUnikt ID – Ett unikt ID som Sjöfartsverket adderat.\n\nFöljande attribut finns i linje shape-filen:\nDelsträcka – Angränsande zon redovisas med följande delsträckor; Västkusten, Östersjön, Bottenhavet, Bottenviken.\nKälla - Lag (2017:1272) om Sveriges sjöterritorium och maritima zoner."},"dct:identifier":"8117e790-311b-4e3d-b3ba-f403bd639603","dct:issued":{"@type":"xsd:date","@value":"2018-03-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-03-02"},"dct:provenance":{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000654"},"dct:spatial":{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b1n0"},"dct:temporal":{"@id":"_:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e_b2n0"},"dct:title":{"@language":"sv","@value":"Angränsande zonens yttre avgränsningslinjer"}},{"@id":"urn:uuid:14bac632-62d2-72f4-ef5d-ac052f4915e9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/sv/tjanster/havsgranser/angransande-zon/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Angränsande zon"}},{"@id":"urn:uuid:ecb390b6-01cc-9f8d-9362-5b5e4870b23e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sjofartsverket.se/globalassets/sjokort-och-sjogeografi/angransande_zonens_yttre_avgransningslinjer.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Shapefil Angränsande zon"}}],"@id":"urn:source:d9c0fd27146c30db8b4e031be68f4b70694baf6fe954b70d062b25678614263e"},{"@graph":[{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ägarna rapporterar in koordinater"}},{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Jönköping","http://www.w3.org/2006/vcard/ns#postal-code":"55182"},{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:036-155000"}},{"@id":"http://dataportal.se/organisation/SE2021004151","@type":"foaf:Agent","dct:identifier":"2021004151","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jordbruksverket@jordbruksverket.se"},"foaf:name":{"@language":"sv","@value":"Statens jordbruksverk"},"foaf:page":{"@id":"https://www.jordbruksverket.se/"}},{"@id":"https://www.geodata.se/resources/820478e6-f66f-4380-9d56-83e8c0eb32f8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca"},"dcat:distribution":[{"@id":"urn:uuid:3c31e715-0d03-c71a-687e-24d396e306da"},{"@id":"urn:uuid:a31bca72-3096-98e4-5ec7-540d47c3546a"},{"@id":"urn:uuid:adcf6839-84f9-ace7-a25f-63a1277ea50d"},{"@id":"urn:uuid:f38360b9-181b-69d7-9e9a-5be66f3f3cac"}],"dcat:keyword":{"@language":"sv","@value":"Inspire"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Anläggningar för djurhållning\nAnläggningar som håller landlevande djur ska anmäla sin djurhållning till Jordbruksverket.\nDatamängden innehåller endast uppgifter om de arter som definieras som produktionsdjur\n* Nötkreatur\n* Grisar\n* Får\n* Getter\n* Fjäderfän \n\nEtt anläggningsnummer består av landsbeteckningen SE följt av sex siffror. Anläggningsnumret är knutet till den anläggning eller plats där verksamheten bedrivs.\nPlatsens geografiska utformning avgör om ett eller flera anläggningsnummer behövs. Om beten ligger mindre än 500 meter från varandra fågelvägen, och det inte finns andra klövdjur som tillhör någon annan mellan platserna, räknas de som samma anläggning.\nOm avståndet är större än 500 meter, eller om det finns andra klövdjur som tillhör någon annan mellan platserna, ska platserna ha olika anläggningsnummer.\nUppgifter om anläggningen:\n- vilket djurslag som finns på anläggningen"},"dct:identifier":"820478e6-f66f-4380-9d56-83e8c0eb32f8","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004151"},"dct:spatial":{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b1n0"},"dct:title":{"@language":"sv","@value":"Produktionsplatser för djurhållning"}},{"@id":"urn:uuid:3c31e715-0d03-c71a-687e-24d396e306da","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdn.jordbruksverket.se/inspire/atom/produktionsplatser/20250326/produktionsplatser.gml.zip"},"dct:description":{"@language":"sv","@value":"Rikstäckande GML-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nerladdningsbar GML-fil"}},{"@id":"urn:uuid:527a1cd0-5fda-93a2-21c2-cbb1660405ca","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Jordbruksverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.support@jordbruksverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d9d99a36f2ee71bf33bdcf4c1622228f710b6a69563d534767f691f1ee7021fb_b3n0"},"http://www.w3.org/2006/vcard/ns#organization-name":"Jordbruksverket"},{"@id":"urn:uuid:a31bca72-3096-98e4-5ec7-540d47c3546a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WMS&request=GetCapabilities&layers=produktionsplatser"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Jordbruksverkets visningstjänst (WMS)"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets visningstjänst (WMS)"}},{"@id":"urn:uuid:adcf6839-84f9-ace7-a25f-63a1277ea50d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://epub.sjv.se/inspire/inspire/ows?service=WFS&request=GetCapabilities&TYPENAMES=produktionsplatser"},"dct:description":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:title":{"@language":"sv","@value":"Jordbruksverkets nedladdningstjänst (WFS)"}},{"@id":"urn:uuid:f38360b9-181b-69d7-9e9a-5be66f3f3cac","@type":"dcat:Distribution"