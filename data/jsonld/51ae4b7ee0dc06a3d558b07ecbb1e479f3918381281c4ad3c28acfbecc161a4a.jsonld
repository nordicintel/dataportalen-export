af:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/54f483b4-8d54-4bca-9aa1-d5ec2852f57a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea"},"dcat:distribution":{"@id":"urn:uuid:640d8d0c-6424-92f0-5e36-76df8e6cdbb1"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kunskapsöversikt framtagen inom länsstyrelsens projekt Vattenförvaltning och kulturarv, VaKul. Innefattar karakterisering och kartläggning av områdets kulturmiljövärden."},"dct:identifier":"54f483b4-8d54-4bca-9aa1-d5ec2852f57a","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-04-10"},"dct:provenance":{"@id":"_:2c14fe421d5762b2ae10ff61a56b37646938409da7c89d6e642f21d888b4dd25_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:2c14fe421d5762b2ae10ff61a56b37646938409da7c89d6e642f21d888b4dd25_b1n0"},"dct:title":{"@language":"sv","@value":"LstN Vattenanknutna kulturmiljöer punkt"}},{"@id":"urn:uuid:10ffcd4b-90f0-2d16-cfa0-fbd3e8183fea","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Kulturmiljöfunktionen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2c14fe421d5762b2ae10ff61a56b37646938409da7c89d6e642f21d888b4dd25_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Kulturmiljöfunktionen"},{"@id":"urn:uuid:640d8d0c-6424-92f0-5e36-76df8e6cdbb1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.LstN_Vattenanknutna_kulturmiljoer_punkt.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}}],"@id":"urn:source:2c14fe421d5762b2ae10ff61a56b37646938409da7c89d6e642f21d888b4dd25"},{"@graph":[{"@id":"_:2c5a497c3749c9fc89c6e2f3558f6269351f34e1335a6aac98095e23ba3223cd_b0n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.91252 57.57303,13.43338 57.57303,13.43338 56.3632,11.91252 56.3632,11.91252 57.57303))"}},{"@id":"_:2c5a497c3749c9fc89c6e2f3558f6269351f34e1335a6aac98095e23ba3223cd_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://dataportal.se/organisation/SE2021002361-LST","@type":"foaf:Agent","dct:identifier":"2021002361-LST","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lansstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Länsstyrelserna gemensamt"},"foaf:page":{"@id":"https://lansstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lansstyrelsen.se/store/2/resource/1"},{"@id":"https://metadata.havochvatten.se/store/1/resource/108"}]},{"@id":"https://www.geodata.se/resources/354dd0cb-1f48-4c52-af54-a1217517aa75","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9d869934-6c32-8bcb-58ad-62a29ea45794"},"dcat:distribution":{"@id":"urn:uuid:033a52bd-8dec-db62-dbab-56c3aba1fe1c"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Rikkärren är en ovanlig naturtyp med mycket höga naturvärden. Rikkärr är kalkrika myrar som även är rika på arter, de är dock inte näringsrika utan snarare relativt näringsfattiga.\n\nDetta underlag är resultat från en inventering för att hitta rikkärr 2007-2008. Inventeringen är inte heltäckande, ytterligare rikkärr kan förekomma i länet. \nInventeringen finns beskriven i rapport i meddelandeserien 2008:20. Resultat av rikkärrsinventering i Halland 2007-2008. \n\nYtterligare rikkärr har lagts till efter inventeringen. Se fält BESKR."},"dct:identifier":"354dd0cb-1f48-4c52-af54-a1217517aa75","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002361-LST"},"dct:spatial":{"@id":"_:2c5a497c3749c9fc89c6e2f3558f6269351f34e1335a6aac98095e23ba3223cd_b0n0"},"dct:title":{"@language":"sv","@value":"LstN Rikkärr"}},{"@id":"urn:uuid:033a52bd-8dec-db62-dbab-56c3aba1fe1c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ext-dokument.lansstyrelsen.se/gemensamt/geodata/ATOM/ATOM_Lstn.Lst_rikkarr.xml"},"dct:description":{"@language":"sv","@value":"Atom-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:title":{"@language":"sv","@value":"Atom-fil"}},{"@id":"urn:uuid:9d869934-6c32-8bcb-58ad-62a29ea45794","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"LstN Enheten för naturvård och miljöövervakning","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2c5a497c3749c9fc89c6e2f3558f6269351f34e1335a6aac98095e23ba3223cd_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:halland@lansstyrelsen.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"LstN Enheten för naturvård och miljöövervakning"}],"@id":"urn:source:2c5a497c3749c9fc89c6e2f3558f6269351f34e1335a6aac98095e23ba3223cd"},{"@graph":[{"@id":"_:2c79ea0b51e79add83d147899eff7dda8b10a6a2393e5262c778512df08ef66b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen har byggts upp genom sammanställning av information från geologisk litteratur, berggrundskartor, prospekteringsrapporter, pågående SGU-karteringar och länsvisa inventeringar av mineral- och bergartsförekomster.\n\nInformationen är engelskspråkig och vänder sig i första hand till professionella användare så som geologer, prospektörer och beslutsfattare inom samhällsbyggnad och miljö, men kan naturligtvis även användas av andra intresserade.\n\nSamtliga förekomster är lägesangivna i koordinatsystemet SWEREF99TM och varje förekomst har en angiven uppskattad lägesnoggrannhet beroende på informationskälla. Lägesnoggrannheten anges i fyra fasta kategorier, där precisionen varierar från 10 m till 500 m. För spårbarhet till informationskällan och den lagrade informationen finns minst en litteraturreferens angiven till varje förekomst. Till varje uttag från databasen levereras en referenslista med fullständiga referenser."}},{"@id":"_:2c79ea0b51e79add83d147899eff7dda8b10a6a2393e5262c778512df08ef66b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59 69.05,24.18 69.05,24.18 55.15,10.59 55.15,10.59 69.05))"}},{"@id":"http://dataportal.se/organisation/SE2021002528","@type":"foaf:Agent","dct:identifier":"2021002528","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sgu@sgu.se"},"foaf:name":{"@language":"sv","@value":"Sveriges geologiska undersökning"},"foaf:page":{"@id":"https://www.sgu.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.havochvatten.se/store/1/resource/51"}},{"@id":"https://www.geodata.se/resources/10022911-6684-4068-bd66-fa18eade4ab3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"urn:uuid:104457c8-c06a-acfe-6bcb-b625f911a436"},{"@id":"urn:uuid:12f09645-532a-a97d-fe6d-9c4946a27b90"},{"@id":"urn:uuid:6ec22420-ba24-d072-e239-bf6ae301789c"},{"@id":"urn:uuid:6ef7543c-14cc-f45e-d602-d74fdccfb6a4"},{"@id":"urn:uuid:9df2b9cd-5792-9ea2-1cea-e94af7a1fd29"},{"@id":"urn:uuid:beb7f77c-1887-27c0-2a66-91951b054eb2"}],"dcat:keyword":{"@language":"sv","@value":"HVD"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Mineralresurser är en rikstäckande produkt och innehåller punktdata med information om Sveriges mineral- och bergartsförekomster, samt underordnat också förekomster med naturgas och olja. För närvarande finns information om ca 20 000 förekomster. Data innefattar allt från småförekomster så som mineraliserade hällar och skärpningar till nedlagda och aktiva gruvor eller bergtäkter samt mineralförekomster kända genom kärnborrning. För samtliga förekomster finns information om namn, läge, lägesnoggrannhet, ekonomisk status och vilken metall, mineral eller bergart som är av intresse på platsen, samt litteraturreferenser till informationen. För en stor del av förekomsterna finns också information om storlek på gruvhål, värdbergart, mineralsammansättning och bildningsålder. \nSe vidare även SGU:s produkt ”Malmer och anrikningsverk” för uppgifter om malmproduktion vid gruvor och gruvområden, samt även uppgifter om rapporterade reserver och tillgångar vid svenska fyndigheter."},"dct:identifier":"10022911-6684-4068-bd66-fa18eade4ab3","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-09"},"dct:provenance":{"@id":"_:2c79ea0b51e79add83d147899eff7dda8b10a6a2393e5262c778512df08ef66b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002528"},"dct:spatial":{"@id":"_:2c79ea0b51e79add83d147899eff7dda8b10a6a2393e5262c778512df08ef66b_b1n0"},"dct:title":{"@language":"sv","@value":"Mineralresurser"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"urn:uuid:104457c8-c06a-acfe-6bcb-b625f911a436","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/data/oppnadata/mineralresurser/mineralresurser.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:title":{"@language":"sv","@value":"Nedladdning ZIP"}},{"@id":"urn:uuid:12f09645-532a-a97d-fe6d-9c4946a27b90","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sgu.se/oppnadata/mineralresurser/ogc/features/v1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Landningssida OGC API - Features"}},{"@id":"urn:uuid:6ec22420-ba24-d072-e239-bf6ae301789c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/dokument/produkter/mineralresurser-beskrivning.pdf"},"dct:description":{"@language":"sv","@value":"Produktbeskrivningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"Produktbeskrivningar"}},{"@id":"urn:uuid:6ef7543c-14cc-f45e-d602-d74fdccfb6a4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://resource.sgu.se/service/wms/130/mineralresurser"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst"},"dct:title":{"@language":"sv","@value":"Web Map Service"}},{"@id":"urn:u