,"dct:format":"text/csv","dct:title":{"@language":"sv","@value":"leverantörsreskontra 2025-11"}},{"@id":"https://opendata.vasteras.se/store/1/resource/137","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"leverantörsreskontra 2025-12"}},{"@id":"https://opendata.vasteras.se/store/1/resource/140","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.vasteras.se/rowstore/dataset/79389e88-55fc-4982-8ab1-80773860d081"},"dct:conformsTo":{"@id":"https://opendata.vasteras.se/rowstore/dataset/79389e88-55fc-4982-8ab1-80773860d081/swagger"},"dct:description":{"@language":"sv","@value":"Leverantörsreskontra 2025 i Västerås Stad"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-03T06:20:20.753Z"},"dct:source":{"@id":"https://opendata.vasteras.se/store/1/resource/95"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra 2025"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://opendata.vasteras.se/rowstore/dataset/79389e88-55fc-4982-8ab1-80773860d081/swagger"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://opendata.vasteras.se/store/1/resource/93","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"https://opendata.vasteras.se/store/1/resource/140"},{"@id":"https://opendata.vasteras.se/store/1/resource/95"}],"dcat:keyword":["Västerås stad",{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Upphandling"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/DCAT-AP-SE/3.0.0"},"dct:description":{"@language":"sv","@value":"Datamängden avser öppna data avseende leverantörsfakturor för Västerås Stads förvaltningar.\n\nDatamängden utgår från den nationella specifikation som finns framtagen för leverantörsreskontra (https://lankadedata.se/spec/leverantorsreskontra/). Datamängden innehåller data över bokförda leverantörsfakturor för Västerås Stads förvaltningar. Beloppen som redovisas är SEK, exkl. moms.\n\nDatamängden publiceras en gång per månad och varje publicering innehåller föregående bokföringsperiods leverantörsfakturor.\nAv sekretesskäl exkluderas leverantörsfakturor som är sekretessmarkerade i Västerås Stads fakturasystem. Därtill döljs de organisationsnummer som utgörs av personnummer eller samordningsnummer.\n\nFakturor inom eller mellan förvaltningar i Västerås Stad inkluderas inte i datamängden. Konton avseende moms samt öresutjämning inkluderas inte i datamängden. Ombokningar (rättningar) i ekonomisystemet inkluderas ej i datamängden. De frivilliga fälten \"grund\", \"avtal\", \"s_kod_nr\" i den nationella specifikationen för leverantörsreskontra lämnas tomma då det inte finns stöd för dessa i Västerås Stads relevanta system."},"dct:issued":{"@type":"xsd:date","@value":"2026-06-29"},"dct:publisher":{"@id":"https://opendata.vasteras.se/store/1/resource/1"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra 2025"}},{"@id":"https://opendata.vasteras.se/store/1/resource/94","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"leverantörsreskontra 2025-01"},{"@id":"https://opendata.vasteras.se/store/1/resource/95","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://opendata.vasteras.se/store/1/resource/122"},{"@id":"https://