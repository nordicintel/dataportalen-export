alue":"POLYGON((9.5 69.5,25.5 69.5,25.5 54.5,9.5 54.5,9.5 69.5))"}},{"@id":"_:dce96b1aa6be7b74b2c88843e5d48c5cbab93954a7277083fcaa68ce1e25e306_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2022"}},{"@id":"http://dataportal.se/organisation/SE2021006883","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"För att skapa ett hållbart välfärdssamhälle behöver digitaliseringen av Sverige intensifieras. Därför finns Digg. Tillsammans med hela den offentliga förvaltningen arbetar vi för att omställningen ska bli verklighet, och till nytta för alla."},"dct:identifier":"2021006883","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:dataportal@digg.se"},"foaf:name":[{"@language":"en","@value":"Agency for Digital Government"},{"@language":"sv","@value":"Myndigheten för digital förvaltning"}],"foaf:page":{"@id":"https://www.digg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.digg.se/store/1/resource/1"}},{"@id":"https://catalog.digg.se/store/1/resource/3","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"DIGG:s kundtjänst","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@digg.se"}},{"@id":"https://catalog.digg.se/store/1/resource/4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.digg.se/store/1/resource/3"},"dcat:distribution":{"@id":"https://catalog.digg.se/store/1/resource/5"},"dcat:keyword":[{"@language":"en","@value":"Catalogues"},{"@language":"en","@value":"Dataportal"},{"@language":"en","@value":"Open data"},{"@language":"sv","@value":"DIGG"},{"@language":"sv","@value":"Metadata"},{"@language":"sv","@value":"Sveriges dataportal"},{"@language":"sv","@value":"dataportal.se"},{"@language":"sv","@value":"Öppna data"}],"dcat:landingPage":{"@id":"https://admin.dataportal.se/status/overview"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/DCAT-AP-SE/3.0.0"},"dct:description":[{"@language":"en","@value":"Current harvesting status on which organisations are publishing a data catalogue to the national dataportal in Sweden. The report corresponds to what worked and what did not, e.g. how many datasets have been added, updated, deleted, or are unchanged. There is also information on how many mandatory and recommended values ​​are missing as well as a link to a copy of what was retrieved at the time of harvest."},{"@language":"sv","@value":"Datamängden innehåller det senaste dygnets skördningsrapporter för organisationer på Sveriges dataportal. Skördningsrapporten motsvarar vad som fungerat och inte, t.ex. hur många datamängder som tillkommit, uppdaterats, tagits bort, eller är oförändrade. Där finns även information om hur många obligatoriska och rekommenderade värden som saknas samt en länk till en kopia på det som hämtats vid skördningstillfället."}],"dct:issued":{"@type":"xsd:gYear","@value":"2022"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006883"},"dct:source":{"@id":"https://catalog.digg.se/store/1/resource/4"},"dct:spatial":[{"@id":"_:dce96b1aa6be7b74b2c88843e5d48c5cbab93954a7277083fcaa68ce1e25e306_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:temporal":{"@id":"_:dce96b1aa6be7b74b2c88843e5d48c5cbab93954a7277083fcaa68ce1e25e306_b1n0"},"dct:title":[{"@language":"en","@value":"Status on the Swedish dataportal"},{"@language":"sv","@value":"Status på Sveriges dataportal"}],"foaf:page":{"@id":"https://docs.dataportal.se/registry/api/"}},{"@id":"https://catalog.digg.se/store/1/resource/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://admin.dataportal.se/store/search?type=solr&query=tag.literal:latest+AND+metad