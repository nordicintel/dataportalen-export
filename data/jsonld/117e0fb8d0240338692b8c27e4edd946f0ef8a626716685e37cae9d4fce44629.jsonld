31"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021006883","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"För att skapa ett hållbart välfärdssamhälle behöver digitaliseringen av Sverige intensifieras. Därför finns Digg. Tillsammans med hela den offentliga förvaltningen arbetar vi för att omställningen ska bli verklighet, och till nytta för alla."},"dct:identifier":"2021006883","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:dataportal@digg.se"},"foaf:name":[{"@language":"en","@value":"Agency for Digital Government"},{"@language":"sv","@value":"Myndigheten för digital förvaltning"}],"foaf:page":{"@id":"https://www.digg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.digg.se/store/1/resource/1"}},{"@id":"https://catalog.digg.se/store/1/resource/103","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.digg.se/store/1/resource/3"},"dcat:distribution":[{"@id":"https://catalog.digg.se/store/1/resource/106"},{"@id":"https://catalog.digg.se/store/1/resource/108"}],"dcat:keyword":[{"@language":"en","@value":"einvoice"},{"@language":"en","@value":"electronic invoice"},{"@language":"en","@value":"electronic order"},{"@language":"sv","@value":"DIGG"},{"@language":"sv","@value":"e-faktura"},{"@language":"sv","@value":"e-order"},{"@language":"sv","@value":"efaktura"},{"@language":"sv","@value":"elektronisk faktura"},{"@language":"sv","@value":"elektronisk handel"},{"@language":"sv","@value":"elektronisk order"},{"@language":"sv","@value":"eorder"}],"dcat:landingPage":{"@id":"https://www.digg.se/kunskap-och-stod/e-handel"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/ac