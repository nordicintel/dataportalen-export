,"@value":"electronic order"},{"@language":"sv","@value":"DIGG"},{"@language":"sv","@value":"Digg"},{"@language":"sv","@value":"e-faktura"},{"@language":"sv","@value":"e-order"},{"@language":"sv","@value":"efaktura"},{"@language":"sv","@value":"elektronisk faktura"},{"@language":"sv","@value":"elektronisk handel"},{"@language":"sv","@value":"elektronisk order"},{"@language":"sv","@value":"eorder"}],"dcat:landingPage":{"@id":"https://www.digg.se/kunskap-och-stod/e-handel"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Recurrent survey for E-commerce follow-up for government agencies with more then 50 manpower."},{"@language":"sv","@value":"Återkommande uppföljning av införande och utveckling av e-handel inom statliga myndigheter. Uppföljningen utförs genom en enkät som skickas till statliga myndigheter med fler än 50 årsarbetskrafter (ÅA) och som lyder under förordning 2003:770 om statliga myndigheters elektroniska informationsutbyte och tillhörande föreskrifter."}],"dct:issued":{"@type":"xsd:date","@value":"2024-06-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006883"},"dct:spatial":{"@id":"_:178aedd7396c0bc1fddcb52e8b2884052053251fb6fb8c5d227ae201ab7b2d33_b0n0"},"dct:temporal":{"@id":"_:178aedd7396c0bc1fddcb52e8b2884052053251fb6fb8c5d227ae201ab7b2d33_b1n0"},"dct:title":[{"@language":"en","@value":"E-commerce follow-up for government agencies 2023"},{"@language":"sv","@value":"Uppföljning av myndigheternas e-handel 2023"}]},{"@id":"https://catalog.digg.se/store/1/resource/127","@type":"http://entrysca