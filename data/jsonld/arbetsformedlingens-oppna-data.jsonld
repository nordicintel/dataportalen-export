3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"ssyk"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The data set contains occupations with relations to SSYK 4-level groups and the relations between SSYK level 4 groups and occupation fields.Occupations in the data set are created and continuously updated in consultation with stakeholders in the labor market. They are categorized according to SSYK, Swedish Standard Classification of Occupations, which is based on ISCO, the International Standard Classification of Occupation. The current version is SSYK 2012.. The occupation fields are produced by the Swedish Employment Service (Arbetsförmedlingen)."},{"@language":"sv","@value":"Datamängden innehåller yrkesbenämningar med relationer till SSYK nivå 4-grupper och relationer mellan SSYK nivå 4-grupperna och yrkesområden.Yrkesbenämningarna i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden. De är kategoriserade enligt SSYK, Svensk standard för yrkesklassificering som bygger på den internationella yrkesklassificeringen ISCO, International Standard Classification of Occupation. Den nuvarande versionen är SSYK-2012. Yrkesområdena är framtagna av Arbetsförmedlingen."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"Occupation fields with related SSYK level 4 groups and occupations"},{"@language":"sv","@value":"Yrkesområden med relationer till SSYK nivå fyra och yrkesbenämningar"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ffeb81e61e8e0206d8343eab67944ee934457aec6e1b5add514fddf49d5f2e50_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/occupation-fields-with-related-ssyk-level-4-groups-and-occupations/occupation-fields-with-related-ssyk-level-4-groups-and-occupations.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of occupation fields nested under data and concepts. Each occupation field is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type) and definition (description), as well as a list narrower of SSYK level 4 groups. Each SSYK level 4 group has the fields id, preferred_label, type, ssyk_code_2012 (four-digit SSYK code) and definition, as well as its own list narrower of occupations where each occupation has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av yrkesområden nästlade under data och concepts. Varje yrkesområde representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp) och definition (beskrivning), samt en lista narrower med underordnade SSYK nivå 4-grupper. Varje SSYK nivå 4-grupp har fälten id, preferred_label, type, ssyk_code_2012 (fyrställig SSYK-kod) och definition, samt en egen lista narrower med underordnade yrkesbenämningar där varje yrkesbenämning har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Occupation fields with related SSYK level 4 groups and occupations"},{"@language":"sv","@value":"Yrkesområden med relationer till SSYK nivå fyra och yrkesbenämningar"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechd