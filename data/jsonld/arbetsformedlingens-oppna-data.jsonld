e/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-level-hierarchy/sun-level-hierarchy.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-level-hierarchy/sun-level-hierarchy.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-level-hierarchy/sun-level-hierarchy.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"sun"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"utbildning"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The data set contains the entire SUN level structure with associated description texts and SUN 2020 codes.SUN, the Swedish education nomenclature, is used for classifying education programs and to describe individuals' education. SUN is divided into two structures, one for education field descriptions and one for education level descriptions. The current version is SUN 2020."},{"@language":"sv","@value":"Datamängden innehåller hela SUN-nivåstrukturen med tillhörande beskrivningstexter och SUN2020-koder.SUN , Svensk utbildningsnomenklatur, används bland annat för att klassificera utbildningar och beskriva individers utbildning. SUN är indelad i två strukturer, en för utbildningsinriktning och en för utbildningsnivå. Den nuvarande versionen är SUN 2020."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SUN level hierarchy"},{"@language":"sv","@value":"Hela SUN-nivåstrukturen"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-level-hierarchy/sun-level-hierarchy.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c5aadf6cf475f352dc0194e6966b53bacf445a2415bf346fbfaa73dfd23b8519_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-level-hierarchy/sun-level-hierarchy.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-level-hierarchy/sun-level-hierarchy.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-level-hierarchy/sun-level-hierarchy.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a hierarchical structure nested under data and concepts. The structure starts from SUN education level 1 entries, where each entry has the fields id, preferred_label, type, definition and sun_education_level_code_2020, as well as a list narrower of level 2 entries. The hierarchy continues through level 3 with the same fields at each level."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en hierarkisk struktur nästlad under data och concepts. Strukturen utgår från SUN-nivå 1, där varje begrepp har fälten id, preferred_label, type, definition och sun_education_level_code_2020, samt en lista narrower med begrepp på nivå 2. Hierarkin fortsätter genom nivå 3 med samma fält på varje nivå."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SUN level hierarchy"},{"@language":"sv","@value":"Hela SUN-nivåstrukturen"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDa