ce"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/keyword-concepts-with-relations/keyword-concepts-with-relations.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/keyword-concepts-with-relations/keyword-concepts-with-relations.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"taxonomi"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The data set contains keyword-concepts with relations to concepts, of other types, that they refer to."},{"@language":"sv","@value":"Datamängden innehåller sökbegrepp med relationer till begrepp som de refererar till."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"Keyword concepts with relations"},{"@language":"sv","@value":"Sökbegrepp med relation till andra begrepp"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/keyword-concepts-with-relations/keyword-concepts-with-relations.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://