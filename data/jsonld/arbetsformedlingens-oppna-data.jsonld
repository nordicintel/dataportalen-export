0194d084506c8716164df753e3dba77ef4a46a6338813789247c1743_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:c5bf54e90194d084506c8716164df753e3dba77ef4a46a6338813789247c1743_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://apier.arbetsformedlingen.se/#dataserviceJobposting","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactJobposting"},"dcat:endpointURL":{"@id":"https://apier.arbetsformedlingen.se/direct-transferred-job-posting/v1/prod"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://arbetsformedlingen.se/for-arbetsgivare/rekrytera/annonsera-i-platsbanken/sa-har-annonserar-du-i-platsbanken"},"dcat:servesDataset":{"@id":"https://arbetsformedlingen.se/#datasetPlatsannonser"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Partner API for publishing job advertisements in the Swedish Employment Agency's Platsbanken service. Access requires registration, and employers who want to advertise must have an employer account. Advertising conditions must be followed, more information can be found in the supplier documentation."},{"@language":"sv","@value":"Partner-API för publicering av platsannonser i Arbetsförmedlingens tjänst Platsbanken. För att få åtkomst krävs registrering, och arbetsgivare som ska annonsera måste ha ett arbetsgivarkonto. Annonseringsvillkor ska följas, mer information finns i leverantörsdokumentationen."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"Direct Transferred Job Posting API"},{"@language":"sv","@value":"Direct Transferred Job Posting"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":[{"@id":"https://arbetsformedlingen.se/for-arbetsgivare/rekrytera/annonsera-i-platsbanken/for-over-annonser-till-platsbanken/koppla-ditt-rekryteringsverktyg-till-platsbanken"},{"@id":"https://data.arbetsformedlingen.se/documents/jobposting/DirectTransferredJobPostingAPIdocumentation.pdf"},{"@id":"https://data.arbetsformedlingen.se/documents/jobposting/Release_Notes.pdf"}]},{"@id":"https://apier.arbetsformedlingen.se/#distributionJobposting","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://apier.arbetsformedlingen.se/#dataserviceJobposting"},"dcat:accessURL":{"@id":"https://data.arbetsformedlingen.se/documents/jobposting/DirectTransferredJobPostingAPIdocumentation.pdf"},"dct:description":[{"@language":"en","@value":"Direct Transferred Job Posting is an API for publishing job ads from external systems to the Swedish Public Employment Service's job bank. The integration makes it possible to publish and manage job ads. The API is a partner API and requires registration for access."},{"@language":"sv","@value":"Direct Transferred Job Posting är ett api för att publicera platsannonser från externa system till Arbetsförmedlingens Platsbank. Integrationen möjliggör att kunna publicera samt hantera platsannonser. Api:et är ett partner-api och kräver registrering för åtkomst. "}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:title":{"@language":"sv","@value":"Direct Transferred Job Posting API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://data.arbetsformedlingen.se/#contactPlatsannonser","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c5bf54e90194d084506c8716164df753e3dba77ef4a46a6338813789247c1743_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c5bf54e90194d084506c8716164df753e3dba77ef4a46a6338813789247c1743_b1n0"}},{"@id":"https://data.arbetsformedlingen.se/#datasetP