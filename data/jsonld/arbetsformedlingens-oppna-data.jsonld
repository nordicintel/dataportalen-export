en interimslösning tills en ny back-end till yrkesinformation är skapad och kan exporteras externt. En ny back-end beräknas vara på plats i slutet av 2026 eller i början av 2027."}],"dct:issued":{"@type":"xsd:date","@value":"2026-04-08"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2026-04-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:temporal":{"@id":"_:80333e3f5450093b90fb8f769a7c2b9dd202ccf0e38e51b5ff5361d62033e76b_b2n0"},"dct:title":[{"@language":"en","@value":"Occupational information interim solution"},{"@language":"sv","@value":"Yrkesinformation interimslösning"}]}],"@id":"urn:source:80333e3f5450093b90fb8f769a7c2b9dd202ccf0e38e51b5ff5361d62033e76b"},{"@graph":[{"@id":"_:820e00700b3fc5cad1813e4c358cd0a120c38dc20189dced0b7389774e259d60_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:820e00700b3fc5cad1813e4c358cd0a120c38dc20189dced0b7389774e259d60_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:pag