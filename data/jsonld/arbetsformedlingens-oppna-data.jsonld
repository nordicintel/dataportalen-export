71 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"skill"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"taxonomi"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":[{"@language":"en","@value":"The data set contains the Swedish Retail and Wholesale Council skill concepts with relations to occupations or SSYK level 4 groups.These concepts are an example of how the skill requirements can be made visible and what they mean in different occupations.The skills described here are intended to be helpful for employers in formulating advertisements for job vacancies and for jobseekers to create an understanding of what is required in different professional roles.The source of the skills is Yrkeskartan, produced by the Swedish Retail and Wholesale Council in collaboration with the staffing and recruitment company Poolia."},{"@language":"sv","@value":"Datamängden innehåller Handelsrådets kompetensbegrepp med relationer till yrkesbenämningar eller SSYK nivå 4-grupper.De här kompetensbegreppen är ett exempel på hur man kan synliggöra kraven på kompetens och vad kraven innebär i olika yrken.Kompetensbegreppen är tänkta att vara till hjälp för arbetsgivare i formulering av annonser för lediga jobb och för arbetssökande för att skapa förståelse för vad som krävs i olika yrkesroller.Källan till kompetensbegreppen är Yrkeskartan som Handelsrådet har tagit fram i samarbete med bemannings- och rekryteringsföretaget Poolia."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"Swedish Retail and Wholesale Council skills"},{"@language":"sv","@value":"Handelsrådets kompetenser med relation till yrke"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f65da6d8d6ce5f764c95e54aebd3dd3e736b8ca9387838943e71bf11f13f612a_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/swedish-retail-and-wholesale-council-skills/swedish-retail-and-wholesale-council-skills.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of Swedish Retail and Wholesale Council skill concepts nested under data and concepts. Each concept is represented by an object with the fields preferred_label (name), type (concept type) and definition (description of the skill), as well as a list related of related occupations or SSYK level 4 groups where each concept has the fields id (concept ID), preferred_label, type, ssyk_code_2012 (SSYK code, if applicable) and definition."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av Handelsrådets kompetensbegrepp nästlade under data och concepts. Varje begrepp representeras av ett objekt med fälten preferred_label (namn), type (begreppstyp) och definition (beskrivning av kompetensen), samt en lista related med relaterade yrkesbenämningar eller SSYK nivå 4-grupper där varje begrepp har fälten id (begrepps-id), preferred_label, type, ssyk_code_2012 (SSYK-kod, om tillämpligt) och definition."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Swedish Retail and Wholesale Council skills"},{"@language":"sv","@value":"Handelsrådets kompetenser med relation till yrke"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonom