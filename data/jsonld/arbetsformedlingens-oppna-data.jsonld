"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"ssyk"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The data set contains skills and occupations with relations to SSYK level 4 groups.Occupations and skill concepts in the data set are created and continuously updated in consultation with stakeholders in the labor market."},{"@language":"sv","@value":"Datamängden innehåller kompetensbegrepp och yrkesbenämningar och till vilka SSYK nivå 4-grupper de är kopplade.Yrkesbenämningarna och kompetensbegreppen i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SSYK level 4 with related skills and occupations"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till kompetensbegrepp och yrkesbenämningar"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-skills-and-occupations/ssyk-level-4-with-related-skills-and-occupations.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4766ff91f35cceec6e61d76567bc39c189e892c18d6be244365f874c05153c67_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-skills-and-occupations/ssyk-level-4-with-related-skills-and-occupations.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-with-related-skills-and-occupations/ssyk-level-4-with-related-skills-and-occupations.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-with-related-skills-and-occupations/ssyk-level-4-with-related-skills-and-occupations.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SSYK level 4 groups nested under data and concepts. Each group is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type) and definition (description), as well as a list narrower of occupations and a list related of skill concepts. Each occupation and skill concept has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SSYK nivå 4-grupper nästlade under data och concepts. Varje grupp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp) och definition (beskrivning), samt en lista narrower med underordnade yrkesbenämningar och en lista related med relaterade kompetensbegrepp. Varje yrkesbenämning och kompetensbegrepp har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SSYK level 4 with related skills and occupations"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till kompetensbegrepp och yrkesbenämningar"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-work