level-1.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sni-level-1/sni-level-1.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sni-level-1/sni-level-1.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"företag"},{"@language":"sv","@value":"sni"},{"@language":"sv","@value":"taxonomi"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The data set contains the first level of the SNI structure with associated SNI codes.SNI, the Swedish Standard Industrial Classification, is used to categorize companies and workplaces according to their carried out activities. The current version is SNI 2007."},{"@language":"sv","@value":"Datamängden innehåller nivå ett av SNI-strukturen med tillhörande SNI-koder.SNI, Svensk näringsgrensindelning, används för att beskriva företags verksamhet. Den nuvarande versionen är SNI 2007."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SNI level 1"},{"@language":"sv","@value":"Nivå ett i SNI-strukturen"}],"http://entryscape.com/terms/ser