.se/organisation/SE2021002114"},"dct:spatial":{"@id":"http://sws.geonames.org/6695072"},"dct:title":[{"@language":"en","@value":"Job Ads"},{"@language":"sv","@value":"Platsannonser"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://apier.arbetsformedlingen.se/#dataserviceJobposting"},{"@id":"https://historical.api.jobtechdev.se/#dataserviceHistoriska_annonser"},{"@id":"https://jobsearch.api.jobtechdev.se/#dataserviceJobsearch"},{"@id":"https://jobstream.api.jobtechdev.se/#dataserviceJob_Stream"},{"@id":"https://links.api.jobtechdev.se/#dataserviceJobAd_Links"}]},{"@id":"https://historical.api.jobtechdev.se/#dataserviceHistoriska_annonser","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#Historiska_annonser2"},"dcat:endpointDescription":{"@id":"https://historical.api.jobtechdev.se/"},"dcat:endpointURL":{"@id":"https://historical.api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/historiska_annonser/"},"dcat:servesDataset":{"@id":"https://historical.api.jobtechdev.se/#Platsannonser"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"Historical ads from Arbetsförmedlingen 2016 and forward. The ads are available through an api, in a search page as well as in various file formats.Ads been converted to current format and enriched."},{"@language":"sv","@value":"API:et Historiska platsannonser använder datamängden för historiska platsannonser och återanvänder koden för JobSearch för att bygga ett nytt sök för platsannonser som har varit publicerade på Arbetsförmedlingens Platsbanken. Apiet innehåller platsannonser från 2016 och framåt, för att annonsen ska hittas i Apiet behöver den vara avpublicerad från Platsbanken. Alla platsannonser är berikade med kompetenser, samt innehåller data om distansarbete."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/#dataserviceHistoriska_annonser/license"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"Historiska_annonser"},{"@language":"sv","@value":"Historiska platsannonser"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/job-ads/historical-ads/historical-api/-/blob/main/docs/historical%20ads.md"}},{"@id":"https://historical.api.jobtechdev.se/#distributionHistoriska_annonser","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://historical.api.jobtechdev.se/#dataserviceHistoriska_annonser"},"dcat:accessURL":{"@id":"https://historical.api.jobtechdev.se"},"dct:conformsTo":{"@id":"https://historical.api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"Explore the Historical Ads API via Swagger Interface "},{"@language":"sv","@value":"API:et Historiska platsannonser använder datamängden för historiska platsannonser och återanvänder koden för JobSearch för att bygga ett nytt sök för platsannonser som har publicerats på Arbetsförmedlingens Platsbanken. Apiet innehåller platsannonser från 2016 och framåt för att annonsen ska hittas i Apiet behöver den vara avpublicerad från Platsbanken. Alla platsannonser är berikade med kompetenser, samt innehåller data om distansarbete."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Historical job ads"},{"@language":"sv","@value":"Historiska platsannonser API"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://historical.api.jobtechdev.se/#distributionHistoriska_annonser_dataset","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.arbetsformedlingen.se/annonser/historiska/index.html"},"dct:description":[{"@language":"en","@value":"Historical Jobs is a dataset with all the job abs, which have been published on the Swedish Public Employment Service’s Job Board (Platsbanken) since 2006. It contains data from job ads, for instance, information about occupation, employer, place, time, etc). The dataset includes approximately 6,9 million job ads nowadays. The dataset is continuously updated."},{"@language":"sv","@value":"Historiska platsannonser är en datamängd med alla platsannonser som har publicerats på Arbetsförmedlingens Platsbanken sedan 2006. Det innehåller data som finns i platsannonser, t ex information om tjänst, arbetsgivare, ort och tidpunkt. Datamängden innehåller cirka 6,9 miljoner annonser. Det uppdateras kontinuerligt. "}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Historical Ads"},{"@language":"sv","@value":"Historiska platsannonser Fil"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://jobsearch.api.jobtechdev.se/#dataserviceJobsearch","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointJobsearch2"},"dcat:endpointDescription":{"@id":"https://jobsearch.api.jobtechdev.se/"},"dcat:endpointURL":{"@id":"https://jobsearch.api.jobtechdev.se"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobsearch/"},"dcat:servesDataset":{"@id":"https://arbetsformedlingen.se/#datasetPlatsannonser"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"API for job ads published in Arbetsförmedlingens Platsbanken"},{"@language":"sv","@value":"API:et JobSearch gör det enkelt att skapa en egen söktjänst i appar eller webbsidor där sökningen sker mot JobSearch och sökresultatet kommer tillbaka i lättanvänt json-format."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobSearch"},{"@language":"sv","@value":"JobSearch"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/job-ads/jobsearch/jobsearch-api/-/blob/main/docs/GettingStartedJobSearchSE.md"}},{"@id":"https://jobsearch.api.jobtechdev.se/#distributionJobsearch","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://jobsearch.api.jobtechdev.se/#dataserviceJobsearch"},"dcat:accessURL":{"@id":"https://jobsearch.api.jobtechdev.se/"},"dct:conformsTo":{"@id":"https://jobsearch.api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"The API JobSearch makes it possible to search among the Swedish Public Employment Service's job advertisements in different ways. It provides information through free text search, but also through structured search terms, based on, for example, professions or themes of geography. The API JobSearch makes it easier to create own search engine tool in apps and/or webpages, when the search process goes through JobSearch, and the search result is returning in an easy-to-use json format."},{"@language":"sv","@value":"JobSearch möjliggör att söka bland Arbetsförmedlingens platsannonser på olika sätt. Dels med fritextsökning, men även med strukturerade sökbegrepp baserade på till exempel yrken eller geografi. API:et JobSearch gör det enkelt att skapa en egen söktjänst i appar eller webbsidor där sökningen sker mot JobSearch och sökresultatet kommer tillbaka i lättanvänt json-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Job Search API"},{"@language":"sv","@value":"Job Search API"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://jobstream.api.jobtechdev.se/#dataserviceJob_Stream","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointJob_Stream2"},"dcat:endpointDescription":{"@id":"https://jobstream.api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://jobstream.api.jobtechdev.se"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobstream/"},"dcat:servesDataset":{"@id":"https://arbetsformedlingen.se/#datasetPlatsannonser"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"API for job ads published in Arbetsförmedlingens Platsbanken."},{"@language":"sv","@value":"API för platsannonser publicerade i Arbetsförmedlingens tjänst Platsbanken"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"Jobstream"},{"@language":"sv","@value":"JobStream "}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/job-ads/JobStream/jobstream-api/-/blob/main/docs/GettingStartedJobStreamSE.md?ref_type=heads"}},{"@id":"https://jobstream.api.jobtechdev.se/#distributionJob_Stream","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://jobstream.api.jobtechdev.se/#dataserviceJob_Stream"},"dcat:accessURL":{"@id":"https://jobstream.api.jobtechdev.se"},"dct:conformsTo":{"@id":"https://jobstream.api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"JobStream provides access to all job advertisements, published on the Swedish Public Employment Service’s Job board (Platsbanken), including real-time information, related to changes, regarding these advertisements, e.g. publishing or deleting of job posts, or updates of job ads texts.By using this API, it gives the opportunity to make a copy of all the job advertisements, published on the Swedish Public Employment Service’s Job board (Platsbanken). It is also possible to filter by professions and/or themes of geography. Furthermore, it can be used to create an own search engine, or to conduct different types of analysis. The advertisements can be kept up-to-date via JobStream, while changes are saved in the own database, including expired and/or depublished job advertisements."},{"@language":"sv","@value":"JobStream ger tillgång till alla platsannonser som är publicerade i Platsbanken, inklusive realtidsinformation om förändringar som sker runt eller i dessa platsannonser, t.ex. publiceringar, avpubliceringar eller uppdateringar av annonstexter. Det ger möjlighet att ha en egen kopia av alla platsannonser som publiceras via Arbetsförmedlingen. Det går även att filtrera på yrkes- eller geografiska begrepp. Det kan användas för att skapa en egen sökmotor, eller för olika typer av analys. Platsannonserna kan hållas uppdaterade via JobStream så att ändringar sparas i den egna databasen, och så att avpublicerade platsannonser kan hanteras."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"JobStream API"},{"@language":"sv","@value":"JobStream API"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://links.api.jobtechdev.se/#dataserviceJobAd_Links","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#JobAd_Links2"},"dcat:endpointDescription":{"@id":"https://links.api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://links.api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobad-links/"},"dcat:servesDataset":{"@id":"https://arbetsformedlingen.se/#datasetPlatsannonser"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":["en¤",{"@language":"sv","@value":"JobAd Links är ett sök-API med stöd för fritextsökning och filter. Det ger tillgång till praktiskt taget alla platsannonser på marknaden och möjliggör för användare att söka bland hela arbetsmarknadens utbud av platsannonser."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobAd Links"},{"@language":"sv","@value":"JobAd Links"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/job-ads/getting-started-code-examples/code-examples-start-here#jobtech-links"}},{"@id":"https://links.api.jobtechdev.se/#distributionJobAd_Links","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://links.api.jobtechdev.se/#dataserviceJobAd_Links"},"dcat:accessURL":{"@id":"https://links.api.jobtechdev.se/"},"dct:conformsTo":{"@id":"https://links.api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"Explore the JobAd Links API via Swagger Interface "},{"@language":"sv","@value":"Utforska API JobAd Links via Swaggergränsnitt"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"JobAd Links API"},{"@language":"sv","@value":"JobAd Links API"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa