ormedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"ssyk"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The dataset contains occupations with relations to SSYK level 4 groups.Occupations in the data set are created and continuously updated in consultation with stakeholders in the labor market. They are categorized according to SSYK, Swedish Standard Classification of Occupations, which is based on ISCO, the International Standard Classification of Occupation. The current version is SSYK 2012."},{"@language":"sv","@value":"Datamängden innehåller yrkesbenämningar med relationer till SSYK nivå 4-grupper.Yrkesbenämningarna i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden. De är kategoriserade enligt SSYK, Svensk standard för yrkesklassificering som bygger på den internationella yrkesklassificeringen ISCO, International Standard Classification of Occupation. Den nuvarande versionen är SSYK-2012."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SSYK level 4 groups with related occupations"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till yrkesbenämningar"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:47480ade42a62002faf92fb0bc61977bf64af9f80af1653eb712a00631b21cf5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-groups-with-related-occupations/ssyk-level-4-groups-with-related-occupations.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SSYK level 4 groups nested under data and concepts. Each group is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type), ssyk_code_2012 (four-digit SSYK code) and definition (description of the group), as well as a list narrower of related occupations where each occupation has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SSYK nivå 4-grupper nästlade under data och concepts. Varje grupp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp), ssyk_code_2012 (fyrställig SSYK-kod) och definition (beskrivning av gruppen), samt en lista narrower med underordnade yrkesbenämningar där varje yrkesbenämning har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SSYK level 4 groups with related occupations"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till yrkesbenämningar"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-working-hours/concepts-describing-working-hours.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/countries/countries.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/driving-licences/driving-licences.json#about0"},{"@id":"h