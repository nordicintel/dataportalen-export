.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://jobed-connect-api.jobtechdev.se/#dataserviceJobEd_Connect","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#JobEd_Connect2"},"dcat:endpointDescription":{"@id":"https://jobed-connect-api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://jobed-connect-api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobed-connect/"},"dcat:servesDataset":{"@id":"https://jobed-connect-api.jobtechdev.se/#datasetJobEd_Connect"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"JobEd_Connect API extracts relevant labor market data from job ad texts."},{"@language":"sv","@value":"API:et JobEd Connect är en lösning som gör det möjligt att se vilka yrken som är mest relaterade till en viss utbildning. Kopplingen mellan utbildning och yrke görs automatiskt med hjälp av de kunskapsmål som nämns i utbildningsbeskrivningen och de kompetenser som arbetsgivare oftast frågar efter för yrket. Det går också att få fram vilka utbildningar som bäst matchar ett visst yrke och dess mest efterfrågade kompetenser. Lösningen bygger primärt på data från berikade historiska platsannonser, samt data från utbildningssystemet SUSA-navet."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobEd Connect"},{"@language":"sv","@value":"JobEd Connect"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/education/education-api/-/blob/main/README.md"}},{"@id":"https://www.arbetsformedlingen.se/#JobEd_Connect2","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b387aa4875c5d77a7a10ae3f51892f5fc4b1662b092bde8f31b9cbc0a38b0484_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}}],"@id":"urn:source:b387aa4875c5d77a7a10ae3f51892f5fc4b1662b092bde8f31b9cbc0a38b0484"},{"@graph":[{"@id":"_:b7c276ccb73e3eda3da959aeda11cbcd1557486d8234905dae18bd2ee5fb2037_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:b7c276ccb73e3eda3da959aeda11cbcd1557486d8234905dae18bd2ee5fb2037_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"sun"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"utbildning"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The data set contains the third level (3 digits) of the SUN field structure with associated descriptions and SUN 2020 codes.SUN, the Swedish education nomenclature, is used for classifying education programs and to describe individuals' education. SUN is divided into two structures, one for education field descriptions and one for education level descriptions. The current version is SUN 2020."},{"@language":"sv","@value":"Datamängden innehåller nivå tre (3 siffror) av SUN-strukturens inriktningsstruktur med tillhörande beskrivningstexter och SUN2020-koder.SUN , Svensk utbildningsnomenklatur, används bland annat för att klassificera utbildningar och beskriva individers utbildning. SUN är indelad i två strukturer, en för utbildningsinriktning och en för utbildningsnivå. Den nuvarande versionen är SUN 2020."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SUN field hierarchy level 3"},{"@language":"sv","@value":"SUN inriktning nivå tre"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b7c276ccb73e3eda3da959aeda11cbcd1557486d8234905dae18bd2ee5fb2037_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-field-hierarchy-level-3/sun-field-hierarchy-level-3.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SUN education field level 3 entries nested under data and concepts. Each entry is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type), definition (description) and sun_education_field_code_2020 (three-digit SUN field code)."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SUN-inriktningsbegrepp på nivå 3 nästlade under data och concepts. Varje begrepp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp), definition (beskrivning) och sun_education_field_code_2020 (tresiffrig SUN-inriktningskod)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SUN field hierarchy level 3"},{"@language":"sv","@value":"SUN inriktning nivå tre"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/ta