1f62fdfd183187_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:ba1d77fc86678db636ed9104e56c647f0cec88e0ab354aa1601f62fdfd183187_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"skill"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"ssyk"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The data set contains the entire SSYK structure and occupations with relations to their SSYK level 4 groups.Occupations in the data set are created and continuously updated in consultation with stakeholders in the labor market. They are categorized according SSYK, Swedish Standard Classification of Occupations based on ISCO, the International Standard Classification of Occupation. The current version is SSYK 2012."},{"@language":"sv","@value":"Datamängden innehåller hela SSYK-strukturen och kopplingar mellan yrkesbenämningar och SSYK nivå 4.Yrkesbenämningarna i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden. De är kategoriserade enligt SSYK, Svensk standard för yrkesklassificering som bygger på den internationella yrkesklassificeringen ISCO, International Standard Classification of Occupation. Den nuvarande versionen är SSYK-2012."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"The SSYK hierarchy with occupations"},{"@language":"sv","@value":"Hela SSYK-strukturen med yrkesbenämningar"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ba1d77fc86678db636ed9104e56c647f0cec88e0ab354aa1601f62fdfd183187_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/the-ssyk-hierarchy-with-occupations/the-ssyk-hierarchy-with-occupations.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a hierarchical structure nested under data and concepts. The structure starts from SSYK level 1 groups, where each group has the fields id (concept ID), preferred_label (name), type (concept type) and ssyk_code_2012 (SSYK code), as well as a list narrower of SSYK level 2 groups. The hierarchy continues through levels 3 and 4, where level 4 groups also have the field definition (description) and a list narrower of occupations. Each occupation has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en hierarkisk struktur nästlad under data och concepts. Strukturen utgår från SSYK nivå 1-grupper, där varje grupp har fälten id (begrepps-id), preferred_label (namn), type (begreppstyp) och ssyk_code_2012 (SSYK-kod), samt en lista narrower med underordnade SSYK nivå 2-grupper. Hierarkin fortsätter genom nivå 3 och 4, där nivå 4-grupperna även har fältet definition (beskrivning) och en lista narrower med underordnade yrkesbenämningar. Varje yrkesbenämning har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"The SSYK hierarchy with occupations"},{"@language":"sv","@value":"Hela SSYK-strukturen med yrkesbenämningar"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-working-hours/concepts-describing-working-hours.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/countries/countries.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/driving-licences/driving-licences.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/employment-length-concepts/employment-length-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/employment-type-concepts/employment-type-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/employment-variety-concepts/employment-variety-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/eu-regions/eu-regions.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/isco-level-4-groups/isco-level-4-groups.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/keyword-concepts-with-relations/keyword-concepts-with-relations.json#about0"},{"@id":"https://data.arbetsforme