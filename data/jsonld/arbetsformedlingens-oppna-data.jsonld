.org/2006/vcard/ns#street-address":"Elektrongatan 4"},{"@id":"_:84b5f10ab21225430f18eb5dd0fd9b2c0502fa1f2f1b2222b5e0d32b2504bb38_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#Taxonomi","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#contactTaxonomi"},"dcat:distribution":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#distributionTaxonomi"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"occupation"},{"@language":"en","@value":"skills"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/data/dataservice/taxonomy/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Employment market taxonomy  provides access to the words and concepts used in the labor market as well as information on how these are linked to each other. It can be, for example, job titles, competence concepts or the connection between professions and skills. The occupational names are structured according to the Standard for Swedish Occupational Classification (SSYK)."},{"@language":"sv","@value":"Arbetsmarknadstaxonomi ger tillgång till de ord och begrepp som används på arbetsmarknaden samt information om hur dessa är kopplade till varandra. Det kan till exempel vara yrkesbenämningar, kompetensbegrepp eller kopplingen mellan yrken och kompetenser. Yrkesbenämningarna är strukturerade enligt Standard för Svensk Yrkesklassificering (SSYK)."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"http://sws.geonames.org/6695072"},"dct:title":[{"@language":"en","@value":"Employment market taxonomy"},{"@language":"sv","@value":"Arbetsmarknadstaxonomi"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#contactTaxonomi","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedl