,"@value":"The data set contains the third level of the SNI structure with associated SNI codes.SNI, the Swedish Standard Industrial Classification, is used to categorize companies and workplaces according to their carried out activities. The current version is SNI 2007."},{"@language":"sv","@value":"Datamängden innehåller nivå tre av SNI-strukturen med tillhörande SNI-koder.SNI, Svensk näringsgrensindelning, används för att beskriva företags verksamhet. Den nuvarande versionen är SNI 2007."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SNI level 3"},{"@language":"sv","@value":"Nivå tre i SNI-strukturen"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sni-level-3/sni-level-3.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:27cdec7571acc52ea69e45188592572184a1101f6f7322ffff4dc5feeb619d17_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sni-level-3/sni-level-3.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sni-level-3/sni-level-3.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sni-level-3/sni-level-3.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SNI level 3 entries nested under data and concepts. Each entry is represented by an object with the fields preferred_label (name), type (concept type) and sni_level_code_2007 (three-digit SNI code)."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SNI nivå 3-begrepp nästlade under data och concepts. Varje begrepp representeras av ett objekt med fälten preferred_label (namn), type (begreppstyp) och sni_level_code_2007 (tresiffrig SNI-kod)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SNI level 3"},{"@language":"sv","@value":"Nivå tre i SNI-strukturen"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.