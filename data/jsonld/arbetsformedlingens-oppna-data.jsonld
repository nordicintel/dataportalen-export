"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#JobAd_Enrichments","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactJobAd_Enrichments"},"dcat:distribution":{"@id":"https://jobad-enrichments-api.jobtechdev.se/#distributionJobAd_Enrichments"},"dcat:keyword":[{"@language":"en","@value":"job ads"},{"@language":"en","@value":"labour market"},{"@language":"en","@value":"platsbanken"},{"@language":"en","@value":"vacancies"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"jobbannonser"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"platsannonser"},{"@language":"sv","@value":"platsbanken"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobad-enrichments/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"JobAd Enrichments is an AI solution that automatically retrieves relevant words and phrases in job advertisements, while filtering out redundant information. The API contributes to a more accurate match between employers and job seekers, and makes it easier to navigate and quickly find a way on digital advertising platforms. Irrelevant search results are a common problem among users of digital matching services and advertising platforms. Being forced to spend time cleaning and sorting among search results makes job search more difficult. With JobAd Enrichments, problems can be minimized, and players, offering digital services, do not have to spend time and resources on manual management."},{"@language":"sv","@value":"JobAd Enrichments är en AI-lösning som automatiskt hämtar ut relevanta ord och uttryck i platsannonser samtidigt som överflödig information filtreras bort. API:et bidrar till en mer träffsäker matchning mellan arbetsgivare och arbetssökande, och gör det lättare att navigera och snabbt hitta rätt på digitala annonsplattformar. Irreleventa sökträffar är ett vanligt problem bland användare av digitala matchningstjänster och annonsplattformar. Att tvingas lägga tid på att rensa och sortera bland sökträffar försvårar jobbsökandet. Med JobAd Enrichments kan problemen minimeras, och aktörer som erbjuder digitala tjänster slipper lägga tid och resurser på manuell hantering."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"http://sws.geonames.org/6695072"},"dct:title":[{"@language":"en","@value":"JobAd Enrichments"},{"@language":"sv","@value":"JobAd Enrichments"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://jobad-enrichments-api.jobtechdev.se/#dataserviceJobAd_Enrichments"}},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#dataserviceJobAd_Enrichments","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#JobAd_Enrichments2"},"dcat:endpointDescription":{"@id":"https://jobad-enrichments-api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://jobad-enrichments-api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobad-enrichments/"},"dcat:servesDataset":{"@id":"https://jobad-enrichments-api.jobtechdev.se/#datasetJobAd_Enrichments"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"JobAd Enrichments API extracts relevant labor market data from job ad texts."},{"@language":"sv","@value":"JobAd Enrichments är en AI-lösning som automatiskt hämtar ut relevanta ord och uttryck i platsannonser samtidigt som överflödig information filtreras bort. API:et bidrar till en mer träffsäker matchning mellan arbetsgivare och arbetssökande, och gör det lättare att navigera och snabbt hitta rätt på digitala annonsplattformar. Irreleventa sökträffar är ett vanligt problem bland användare av digitala matchningstjänster och annonsplattformar. Att tvingas lägga tid på att rensa och sortera bland sökträffar försvårar jobbsökandet. Med JobAd Enrichments kan problemen minimeras, och aktörer som erbjuder digitala tjänster slipper lägga tid och resurser på manuell hantering."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/#dataserviceJobAd_Enrichments/license"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobAd Enrichments"},{"@language":"sv","@value":"JobAd Enrichments"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/enrichment/jobtech-jobad-enrichments-frontend-v2"}},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#distributionJobAd_Enrichments","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://jobad-enrichments-api.jobtechdev.se/#dataserviceJobAd_Enrichments"},"dcat:accessURL":{"@id":"https://jobad-enrichments-api.jobtechdev.se"},"dct:conformsTo":{"@id":"https://jobad-enrichments-api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"Explore the JobAd Enrichments API via Swagger Interface "},{"@language":"sv","@value":"Utforska APIet JobAd Enrichments via Swaggergränsnitt"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"JobAd Enrichments"},{"@language":"sv","@value":"JobAd Enrichments"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://www.arbetsformedlingen.se/#JobAd_Enrichments2","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http: