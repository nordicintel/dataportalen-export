0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:000000"}},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://www.arbetsformedlingen.se/#datasetYrkesbarometer","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https:/www.arbetsformedlingen.se/#contactYrkesbarometer"},"dcat:distribution":[{"@id":"https://www.arbetsformedlingen.se/#distributionYrkesbarometer"},{"@id":"https://www.arbetsformedlingen.se/#distributionYrkesbarometerHistoriska"}],"dcat:keyword":[{"@language":"en","@value":"forecasts"},{"@language":"en","@value":"labour market"},{"@language":"en","@value":"occupations"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"prognos"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataset/yrkesbarometer/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The dataset shows current assessments of job opportunities and the recruitment situation in various professions, both at county level and nationally. In addition to a current picture, a forecast is also given of how the demand for labor in each profession is expected to develop over a five-year period. The occupational barometer is updated twice a year, every spring and autumn.."},{"@language":"sv","@value":"Datamängden visar nulägesbedömningar av möjligheterna till arbete samt rekryteringssituationen inom olika yrken, såväl på länsnivå som nationellt. Förutom en nulägesbild ges även en prognos över hur efterfrågan på arbetskraft inom respektive yrke förväntas utvecklas på fem års sikt. Yrkesbarometern uppdateras två gånger per år. Från och med våren 2026 övergår yrkesbarometerns publicering till att ske i juni och december, i stället för som tidigare i mars och september. Bakgrunden till detta är bland annat möjligheter till bättre datainhämtning samt för att bättre synka med gymnasie- och högskoleval."}],"dct:issued":{"@type":"xsd:date","@value":"2024-04-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:39cf786a45595f43cde46c42900f001c6db499337f47e121360a540ccb22b55a_b0n0"},"dct:title":[{"@language":"en","@value":"Yrkesbarometer"},{"@language":"sv","@value":"Yrkesbarometer"}]},{"@id":"https://www.arbetsformedlingen.se/#distributionYrkesbarometer","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.arbetsformedlingen.se/prognoser"},"dcat:downloadURL":{"@id":"https://data.arbetsformedlingen.se/prognoser/yrkesbarometer.json"},"dct:description":[{"@language":"en","@value":"The current situation assessments are mainly based on information from a survey from the Swedish Public Employment Service, Statistics Sweden's register statistics and the Swedish Public Employment Service's operational statistics. The forecasts are mainly based on industry forecasts made in the regional analysis and forecasting system Raps and population projections from Statistics Sweden."},{"@language":"sv","@value":"Nulägesbedömningarna baseras i huvudsak på information från en enkätundersökning från Arbetsförmedlingen, SCB:s registerstatistik samt Arbetsförmedlingens verksamhetsstatistik. Prognoserna baseras i huvudsak på branschprognoser som görs i det regionala analys- och prognossystemet Raps samt befolkningsframskrivningar från SCB. "}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Yrkesbarometer"},{"@language":"sv","@value":"Yrkesbarometer "}],"foaf:page":{"@id":"https://data.arbetsformedlingen.se/prognoser/beskrivningar"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://www.arbetsformedlingen.se/#distributionYrkesbarometerHistoriska","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.arbetsformedlingen.se/prognoser/historiska/"},"dct:description":[{"@language":"en","@value":"Over the years, the Swedish Public Employment Service has used different methods to make assessments and forecasts for occupations. During the period 2007–2019, the forecasts were based on local assessments from the public employment service offices, which collected information from employers and other actors in the labor market, as well as macroeconomic analyses. During the period 2021–2023, the Swedish Public Employment Service has instead used a data-driven method that is based on statistics from Statistics Sweden and a division of the workforce into different skill profiles. The Occupational Barometer was first published in the spring of 2024. Due to different methods, the assessments cannot be compared over time. The link below provides historical data from 2007 onwards."},{"@language":"sv","@value":"Arbetsförmedlingen har under åren använt olika metoder för att göra bedömningar och prognoser för yrken. Under perioden 2007–2019 baserades prognoserna på lokala bedömningar från arbetsförmedlingskontoren, som samlade information från arbetsgivare och andra aktörer på arbetsmarknaden, samt makroekonomiska analyser. Under perioden 2021–2023 har Arbetsförmedlingen istället använt en datadriven metod som bygger på statistik från SCB och en uppdelning av arbetskraften i olika kompetensprofiler. Yrkesbarometern publicerades första gången under våren 2024. På grund av olika metoder kan bedömningarna inte jämföras över tid. På filytan finns historiska data från år 2007 och framåt."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Historical assessments and forecasts for professions"},{"@language":"sv","@value":"Historiska bedömningar och prognoser för yrken "}],"foaf:page":{"@id":"https://data.arbetsformedlingen.se/prognoser/historiska/beskrivningar"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https:/www.arbetsformedlingen.se/#contactYrkesbarometer","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:39cf786a45595f43cde46c42900f001c6db499337f47e121360a540ccb22b55a_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:jobtechdev@arbetsformedlingen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39cf786a45595f43cde46c42900f001c6db499337f47e121360a540ccb22b55a_b2n0"}}],"@id":"urn:source:39cf786a45595f43cde46c42900f001c6db499337f47e121360a540ccb22b55a"},{"@graph":[{"@id":"_:3c93ba98fcf7854a5c53a6ba62a44a063131244b4918acdfb4d6790290fbb68c_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:3c93ba98fcf7854a5c53a6ba62a44a063131244b4918acdfb4d6790290fbb68c_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbe