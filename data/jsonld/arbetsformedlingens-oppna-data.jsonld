dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#JobAd_Enrichments2"},"dcat:endpointDescription":{"@id":"https://jobad-enrichments-api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://jobad-enrichments-api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobad-enrichments/"},"dcat:servesDataset":{"@id":"https://jobad-enrichments-api.jobtechdev.se/#datasetJobAd_Enrichments"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"JobAd Enrichments API extracts relevant labor market data from job ad texts."},{"@language":"sv","@value":"JobAd Enrichments är en AI-lösning som automatiskt hämtar ut relevanta ord och uttryck i platsannonser samtidigt som överflödig information filtreras bort. API:et bidrar till en mer träffsäker matchning mellan arbetsgivare och arbetssökande, och gör det lättare att navigera och snabbt hitta rätt på digitala annonsplattformar. Irreleventa sökträffar är ett vanligt problem bland användare av digitala matchningstjänster och annonsplattformar. Att tvingas lägga tid på att rensa och sortera bland sökträffar försvårar jobbsökandet. Med JobAd Enrichments kan problemen minimeras, och aktörer som erbjuder digitala tjänster slipper lägga tid och resurser på manuell hantering."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/#dataserviceJobAd_Enrichments/license"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobAd Enrichments"},{"@language":"sv","@value":"JobAd Enrichments"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/enri