oup)."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SSYK nivå 2-grupper nästlade under data och concepts. Varje grupp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp), ssyk_code_2012 (tvåställig SSYK-kod) och definition (beskrivning av gruppen)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SSYK level 2 groups"},{"@language":"sv","@value":"Nivå två i SSYK-strukturen"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"