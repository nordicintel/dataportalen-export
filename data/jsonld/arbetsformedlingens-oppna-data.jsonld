":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://jobed-connect-api.jobtechdev.se/#JobEd_Connect","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactJobEd_Connect"},"dcat:distribution":{"@id":"https://jobed-connect-api.jobtechdev.se/#distributionJobEd_Connect"},"dcat:keyword":[{"@language":"en","@value":"education"},{"@language":"en","@value":"job ads"},{"@language":"en","@value":"labour market"},{"@language":"en","@value":"platsbanken"},{"@language":"en","@value":"skills"},{"@language":"en","@value":"susa-navet"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadsutbildning"},{"@language":"sv","@value":"jobbannonser"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"platsannonser"},{"@language":"sv","@value":"platsbanken"},{"@language":"sv","@value":"susa-navet"},{"@language":"sv","@value":"utbildning"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobed-connect/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"The API JobEd Connect is a solution that makes it possible to provide digital career guidance by linking education programs to job occupations. The link between education programs and job occupations is generated automatically with the help of the informative text in the knowledge goal objectives, appearing in the description of education programs and competencies in job ads. It is also possible to find out which education program is related to a greater extent to a specific job occupation and its most particular in-demand skills. The solution is developed primarily on data from enriched historical job ads and the National Education Database SUSA Hub (in Swedish SUSA-navet."},{"@language":"sv","@value":"API:et JobEd Connect är en lösning som gör det möjligt att se vilka yrken som är mest relaterade till en viss utbildning. Kopplingen mellan utbildning och yrke görs automatiskt med hjälp av de kunskapsmål som nämns i utbildningsbeskrivningen och de kompetenser som arbetsgivare oftast frågar efter för yrket. Det går också att få fram vilka utbildningar som bäst matchar ett visst yrke och dess mest efterfrågade kompetenser. Lösningen bygger primärt på data från berikade historiska platsannonser, samt data från utbildningssystemet SUSA-navet."}],"dct:issued":{"@type":"xsd:date","@value":"2023-03-15"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"http://sws.geonames.org/6695072"},"dct:temporal":{"@id":"_:d6be368670fef0b1ddec61ec485919e19008914bbcf55e4e3002eca4ab71b9da_b0n0"},"dct:title":[{"@language":"en","@value":"JobEd Connect"},{"@language":"sv","@value":"JobEd Connect"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://jobed-connect-api.jobtechdev.se/#dataserviceJobEd_Connect"}},{"@id":"https://jobed-connect-api.jobtechdev.se/#dataserviceJobEd_Connect","@type":"dcat:DataService","dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#JobEd_Connect2"},"dcat:endpointDescription":{"@id":"https://jobed-connect-api.jobtechdev.se"},"dcat:endpointURL":{"@id":"https://jobed-connect-api.jobtechdev.se/swagger.json"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/jobed-connect/"},"dcat:servesDataset":{"@id":"https://jobed-connect-api.jobtechdev.se/#datasetJobEd_Connect"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://swagger.io/specification/v2/"},"dct:description":[{"@language":"en","@value":"JobEd_Connect API extracts relevant labor market data from job ad texts."},{"@language":"sv","@value":"API:et JobEd Connect är en lösning som gör det möjligt att se vilka yrken som är mest relaterade till en viss utbildning. Kopplingen mellan utbildning och yrke görs automatiskt med hjälp av de kunskapsmål som nämns i utbildningsbeskrivningen och de kompetenser som arbetsgivare oftast frågar efter för yrket. Det går också att få fram vilka utbildningar som bäst matchar ett visst yrke och dess mest efterfrågade kompetenser. Lösningen bygger primärt på data från berikade historiska platsannonser, samt data från utbildningssystemet SUSA-navet."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:title":[{"@language":"en","@value":"JobEd Connect"},{"@language":"sv","@value":"JobEd Connect"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://gitlab.com/arbetsformedlingen/education/education-api/-/blob/main/README.md"}},{"@id":"https://jobed-connect-api.jobtechdev.se/#distributionJobEd_Connect","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://jobed-connect-api.jobtechdev.se/#dataserviceJobEd_Connect"},"dcat:accessURL":{"@id":"https://jobed-connect-api.jobtechdev.se/"},"dct:conformsTo":{"@id":"https://jobed-connect-api.jobtechdev.se/swagger.json"},"dct:description":[{"@language":"en","@value":"Explore the JobEd Connect API via Swagger Interface "},{"@language":"sv","@value":"Utforska APIet JobEd Connect via Swaggergränsnitt"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"JobEd Connect"},{"@language":"sv","@value":"JobEd Connect"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://www.arbetsformedlingen.se/#JobEd_Connect2","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d6be368670fef0b1ddec61ec485919e19008914bbcf55e4e3002eca4ab71b9da_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://www.arbetsformedlingen.se/#contactJobEd_Connect","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d6be368670fef0b1ddec61ec485919e19008914bbcf55e4e3002eca4ab71b9da_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d6be368670fef0b1ddec61ec485919e19008914bbcf55e4e3002eca4ab71b9da_b3n0"}}],"@id":"urn:source:d6be368670fef0b1ddec61ec485919e19008914bbcf55e4e3002eca4ab71b9da"},{"@graph":[{"@id":"_:dacc6d170ca70580e59384852b8fa84e01a661474fc6f9afb8a9f8fbe2df4005_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"_:dacc6d170ca70580e59384852b8fa84e01a661474fc6f9afb8a9f8fbe2df4005_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":" Sverige","http://www.w3.org/2006/vcard/ns#locality":" Solna","http://www.w3.org/2006/vcard/ns#postal-code":" 171 54","http://www.w3.org/2006/vcard/ns#street-address":"Elektrogatan 4"},{"@id":"http://dataportal.se/organisation/SE2021002114","@type":"foaf:Agent","dct:identifier":"2021002114","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:jobtechdevelopment@arbetsformedlingen.se"},"foaf:name":{"@language":"sv","@value":"Arbetsförmedlingen"},"foaf:page":{"@id":"https://www.arbetsformedlingen.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://apier.arbetsformedlingen.se/#publisherJobposting"},{"@id":"https://arbetsformedlingen.se/#publisherHistoriska_annonser2"},{"@id":"https://arbetsformedlingen.se/result.rdf#publisher"},{"@id":"https://jobad-enrichments-api.jobtechdev.se/#publisherJobAd_Enrichments2"},{"@id":"https://jobed-connect-api.jobtechdev.se/#publisherJobEd_Connect2"},{"@id":"https://jobsearch.api.jobtechdev.se/#publisherJobsearch2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherJob_Stream2"},{"@id":"https://jobstream.api.jobtechdev.se/#publisherjobstream2"},{"@id":"https://links.api.jobtechdev.se/#publisherJobAd_links2"},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json#about0","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"arbetsmarknadstaxonomi"},{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"en","@value":"yrke"},{"@language":"en","@value":"yrkessamling"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"kompetens"},{"@language":"sv","@value":"taxonomi"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"The data set contains occupations that usually do not require vocational training.The list is created for those who want to build services for jobseekers who lack education and / or work experience and for those who want to find out about opportunities to enter the labor market.Note that the list contains occupations, not titles of individual jobs. It is intended to show opportunities, exceptions for individual employers can always occur.Occupations in the data set are created and continuously updated in consultation with stakeholders in the labor market. They are categorized according to SSYK, Swedish Standard Classification of Occupations, which is based on ISCO, the International Standard Classification of Occupation. The current version is SSYK 2012."},{"@language":"sv","@value":"Datamängden innehåller yrken som vanligtvis inte kräver en yrkesutbildning.Listan är skapad till den som vill bygga tjänster för arbetssökande som saknar utbildning och/eller arbetslivserfarenhet och till den som vill orientera sig om möjligheterna att komma in på arbetsmarknaden.Observera att listan innehåller yrkesbenämningar, inte titlar på enstaka jobb. Den är tänkt att visa på möjligheter, undantag hos enstaka arbetsgivare kan alltid förekomma.Yrkesbenämningarna i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden. De är kategoriserade enligt SSYK, Svensk standard för yrkesklassificering som bygger på den internationella yrkesklassificeringen ISCO, International Standard Classification of Occupation. Den nuvarande versionen är SSYK-2012."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"Occupations with no edcuational requirements"},{"@language":"sv","@value":"Yrken utan krav på utbildning"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:dacc6d170ca70580e59384852b8fa84e01a661474fc6f9afb8a9f8fbe2df4005_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/occupations-with-no-edcuational-requirements/occupations-with-no-edcuational-requirements.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a concept nested under data and concepts. The concept is represented by an object with the fields preferred_label, id and type, as well as a list related of occupations where each occupation has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med ett begrepp nästlat under data och concepts. Begreppet representeras av ett objekt med fälten preferred_label, id och type, samt en lista related med yrkesbenämningar där varje yrkesbenämning har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Occupations with no edcuational requirements"},{"@language":"sv","@value":"Yrken utan krav på utbildning"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-working-hours/concepts-describing-working-hours.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/countries/countries.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/driving-licences/driving-licences.json#about0"},{"@id":"https://data