data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The data set contains skill concepts with skill headlines and relations to SSYK level 4 groups. A skill concept is related to one skill headline and typically at least one SSYK level 4 group.Skill concepts in the data set are created and continuously updated in consultation with stakeholders in the labor market."},{"@language":"sv","@value":"Datamängden innehåller kompetensbegrepp efter kompetensrubrik och till vilka SSYK nivå 4-grupper de är kopplade. Ett kompetensbegrepp är kopplat till en kompetensrubrik och i regel  till minst en SSYK nivå 4-grupp.Kompetensbegreppen i datamängden är skapade och uppdateras kontinuerligt i samråd med aktörerna på arbetsmarknaden."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"Skills with related skill headlines and SSYK level 4 groups"},{"@language":"sv","@value":"Kompetensbegrepp och relationer till kompetensrubrik och nivå fyra i SSYK-strukturen"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/skills-with-related-skill-headlines-and-ssyk-level-4-groups/skills-with-related-skill-headlines-and-ssyk-level-4-groups.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:820e00700b3fc5cad1813e4c358cd0a120c38dc20189dced0b7389774e259d60_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/skills-with-related-skill-headlines-and-ssyk-level-4-groups/skills-with-related-skill-headlines-and-ssyk-level-4-groups.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/skills-with-related-skill-headlines-and-ssyk-level-4-groups/skills-with-related-skill-headlines-and-ssyk-level-4-groups.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/skills-with-related-skill-headlines-and-ssyk-level-4-groups/skills-with-related-skill-headlines-and-ssyk-level-4-groups.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SSYK level 4 groups nested under data and concepts. Each group is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type) and definition (description), as well as a list related of skill concepts. Each skill concept has the fields id, preferred_label and type, as well as a list broader of parent skill headlines where each headline has the fields id, preferred_label and type."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SSYK nivå 4-grupper nästlade under data och concepts. Varje grupp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp) och definition (beskrivning), samt en lista related med relaterade kompetensbegrepp. Varje kompetensbegrepp har fälten id, preferred_label och type, samt en lista broader med överordnade kompetensrubriker där varje rubrik har fälten id, preferred_label och type."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Skills with related skill headlines and SSYK level 4 groups"},{"@language":"sv","@value":"Kompetensbegrepp och relationer till kompetensrubrik och nivå fyra i SSYK-strukturen"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/que