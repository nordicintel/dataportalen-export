@value":"EN301549"},{"@language":"sv","@value":"WCAG"},{"@language":"sv","@value":"digital tillgänglighet"},{"@language":"sv","@value":"tillgänglighet"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataset/accessibility-requirements/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dcat:version":"version 1.0.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"https://www.etsi.org/standards"},"dct:description":[{"@language":"en","@value":"The data set contains all requirements found in the European standard EN 301 549 V3.2.1 and referred to in Swedish legislation – the Digital Public Service Accessibility Act (DOS). Several requirements in the EN standard are similar to those in the international standard Web Content Accessibility Guidelines (WCAG) that has existed since 1999. In cases where a requirement is found in both WCAG and the EN standard, it is marked in the list of requirements."},{"@language":"sv","@value":"Datamängden innehåller alla krav som finns i den europeiska standarden EN 301 549 V3.2.1 och som den svenska lagstiftningen – lagen om tillgänglighet till digital offentlig service (DOS) – pekar på. Flera krav i EN-standarden överensstämmer med den internationella standarden Web Content Accessibility Guidelines (WCAG) som funnits sedan 1999. I de fall ett krav finns i både WCAG och i EN-standarden så är det markerat i kravlistan."}],"dct:identifier":"arbetsformedlingen-dataset-tillganglighetskrav-v1","dct:issued":{"@type":"xsd:date","@value":"2026-01-01"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2026-01-01"},"dct:publisher":{"@id":"http://dataportal.se/organisat