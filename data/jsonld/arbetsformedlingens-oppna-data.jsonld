erarchy-level-2/sun-field-hierarchy-level-2.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"sun"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"utbildning"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The data set contains the second level (2 digits) of the SUN field structure with associated descriptions and SUN 2020 codes.SUN, the Swedish education nomenclature, is used for classifying education programs and to describe individuals' education. SUN is divided into two structures, one for education field descriptions and one for education level descriptions. The current version is SUN 2020."},{"@language":"sv","@value":"Datamängden innehåller nivå två (2 siffror) av SUN-strukturens inriktningsstruktur med tillhörande beskrivningstexter och SUN2020-koder.SUN , Svensk utbildningsnomenklatur, används bland annat för att klassificera utbildningar och beskriva individers utbildning. SUN är indelad i två strukturer, en för utbildningsinriktning och en för utbildningsnivå. Den nuvarande versionen är SUN 2020."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SUN field hierarchy level 2"},{"@language":"sv","@value":"SUN inriktning nivå två"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-2/sun-field-hierarchy-level-2.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5fdfa2e7d787888c9af76eebe52acb9d4b48485432c6fc90c997bd20f0081a4d_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/sun-field-hierarchy-level-2/sun-field-hierarchy-level-2.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-field-hierarchy-level-2/sun-field-hierarchy-level-2.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/sun-field-hierarchy-level-2/sun-field-hierarchy-level-2.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SUN education field level 2 entries nested under data and concepts. Each entry is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type), definition (description) and sun_education_field_code_2020 (two-digit SUN field code)."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SUN-inriktningsbegrepp på nivå 2 nästlade under data och concepts. Varje begrepp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp), definition (beskrivning) och sun_education_field_code_2020 (tvåsiffrig SUN-inriktningskod)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SUN field hierarchy level 2"},{"@language":"sv","@value":"SUN inriktning nivå två"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataservice/employer-market-taxonomy"},"dcat:servesDataset":[{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/all-concepts/all-concepts.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concept-types/concept-types.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-and-common-relations/concepts-and-common-relations.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-occupation-experience-in-years/concepts-describing-occupation-experience-in-years.json#about0"},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/concepts-describing-working-hours/concepts-describing-working-hours.json#about0"},{"@id":"https://data.arbets