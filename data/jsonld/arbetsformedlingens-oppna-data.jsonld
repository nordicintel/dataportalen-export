t:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json#distrib"},"dcat:keyword":[{"@language":"en","@value":"labour market"},{"@language":"en","@value":"skill"},{"@language":"en","@value":"taxonomy"},{"@language":"sv","@value":"arbetsmarknad"},{"@language":"sv","@value":"arbetsmarknadstaxonomi"},{"@language":"sv","@value":"isco"},{"@language":"sv","@value":"ssyk"},{"@language":"sv","@value":"taxonomi"},{"@language":"sv","@value":"yrke"}],"dcat:landingPage":{"@id":"http://atlas.jobtechdev.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The dataset contains the SSYK level 4 groups and the ISCO level 4 groups with relations between the two standards.SSYK, Swedish Standard Classification of Occupations is based on the international classification of occupations ISCO, the International Standard Classification of Occupation. The current versions are SSYK 2012 and ISCO 08."},{"@language":"sv","@value":"Datamängden visar grupperna i nivå fyra (fyrställiga) av ISCO- och SSYK-strukturerna och hur de är relaterade till varandra.SSYK, Svensk standard för yrkesklassificering, bygger på den internationella yrkesklassificeringen ISCO, International Standard Classification of Occupation. Den nuvarande versionen är SSYK-2012 och ISCO-08."}],"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:title":[{"@language":"en","@value":"SSYK level 4 with related ISCO level 4 groups"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till ISCO nivå fyra"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8cfc474de61f414d8580dab0a563b84ca6a8e1c6817e61429dda26a2c954738a_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/taxonomy/version/latest/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json#distrib","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi"},"dcat:accessURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json"},"dcat:downloadURL":{"@id":"https://data.jobtechdev.se/taxonomy/version/31/query/ssyk-level-4-with-related-isco-level-4-groups/ssyk-level-4-with-related-isco-level-4-groups.json"},"dct:description":[{"@language":"en","@value":"The distribution consists of a JSON-encoded file with a list of SSYK level 4 groups nested under data and concepts. Each group is represented by an object with the fields id (concept ID), preferred_label (name), type (concept type), ssyk_code_2012 (four-digit SSYK code) and definition (description), as well as a list related of ISCO level 4 groups where each group has the fields id, preferred_label, type, isco_code_08 (four-digit ISCO-08 code) and definition."},{"@language":"sv","@value":"Distributionen består av en JSON-kodad fil med en lista av SSYK nivå 4-grupper nästlade under data och concepts. Varje grupp representeras av ett objekt med fälten id (begrepps-id), preferred_label (namn), type (begreppstyp), ssyk_code_2012 (fyrställig SSYK-kod) och definition (beskrivning), samt en lista related med relaterade ISCO nivå 4-grupper där varje grupp har fälten id, preferred_label, type, isco_code_08 (fyrställig ISCO-08-kod) och definition."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"SSYK level 4 with related ISCO level 4 groups"},{"@language":"sv","@value":"SSYK nivå fyra med relationer till ISCO nivå fyra"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/#dataserviceTaxonomi","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://www.arbetsformedlingen.se/#contactPointTaxonomi2"},"dcat:endpointDescription":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:endpointURL":{"@id":"https://taxonomy.api.jobtechdev.se/v1/taxonomy/swagger-ui/"},"dcat:keyword":{"@language":"sv","@value":"datatjänst"},"dcat:landingPage":{"@id":"https