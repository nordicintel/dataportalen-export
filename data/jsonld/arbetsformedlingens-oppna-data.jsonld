.se/v1/taxonomy/#publisherTaxonomi2"}]},{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/#about0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/#contact"},"dcat:distribution":{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/#distrib"},"dcat:keyword":[{"@language":"en","@value":"behavior"},{"@language":"en","@value":"job ads"},{"@language":"en","@value":"key word"},{"@language":"en","@value":"trends"},{"@language":"sv","@value":"Platsbanken"},{"@language":"sv","@value":"beteende"},{"@language":"sv","@value":"jobbannonser"},{"@language":"sv","@value":"platsannonser"},{"@language":"sv","@value":"sökningar"},{"@language":"sv","@value":"sökord"},{"@language":"sv","@value":"trender"}],"dcat:landingPage":{"@id":"https://data.arbetsformedlingen.se/dataset/jobsearch-trends/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"en","@value":"JobSearch Trends is a data set with files that contain top search keywords on the Swedish Public Employment Service’s Job Board Platsbanken. New files are to be generated daily with the most common keywords within profession, language, skills, location, and employer, among others. The data set consists of JSON files, which make raw data available in a structured way. "},{"@language":"sv","@value":"JobSearch Trends är en datamängd med filer som innehåller de mest använda sökorden på Arbetsförmedlingens annonsplattform Platsbanken. Nya filer genereras varje dag med de vanligaste sökorden inom till exempel yrke, språk, kompetens, ort och arbetsgivare. Datamängden består av JSON-filer som tillgängliggör rådata på ett strukturerat sätt."}],"dct:issued":{"@type":"xsd:date","@value":"2022-05-04"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002114"},"dct:spatial":{"@id":"https://www.geonames.org/6695072/european-union.html"},"dct:temporal":{"@id":"_:8baa23246dfdcdf8cd72946805302fdd4563802fe911fe5355f9346deca4a521_b0n0"},"dct:title":[{"@language":"en","@value":"JobSearch Trends"},{"@language":"sv","@value":"JobSearch Trends"}]},{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Arbetsförmedlingen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8baa23246dfdcdf8cd72946805302fdd4563802fe911fe5355f9346deca4a521_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailTo:opendata@arbetsformedlingen.se"}},{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/#distrib","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.arbetsformedlingen.se/annonser/search-trends/index.html"},"dct:description":[{"@language":"en","@value":"A web page with a listing of download links to all the files in the data set."},{"@language":"sv","@value":"En webbsida med en lista med nedladdningslänkar till alla filer i datamängden."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Download the files"},{"@language":"sv","@value":"Ladda ner filerna "}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distri