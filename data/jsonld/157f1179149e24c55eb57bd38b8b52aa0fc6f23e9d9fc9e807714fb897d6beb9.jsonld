ms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"424097C3784590835D842D3FC3365BE1F8B5BA53"},{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b8n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Skara","http://www.w3.org/2006/vcard/ns#postal-code":"532 88","http://www.w3.org/2006/vcard/ns#street-address":"Skara Stadshus"},{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b9n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4651132000"}},{"@id":"http://dataportal.se/organisation/SE2120001702","@type":"foaf:Agent","dct:identifier":"2120001702","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:skara.kommun@skara.se"},"foaf:name":{"@language":"sv","@value":"Skara kommun"},"foaf:page":{"@id":"https://www.skara.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.skara.se/store/1/resource/1"}},{"@id":"https://catalog.skara.se/store/1/resource/37","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.skara.se/store/1/resource/62"},"dcat:distribution":[{"@id":"https://catalog.skara.se/store/1/resource/56"},{"@id":"https://catalog.skara.se/store/1/resource/58"},{"@id":"https://catalog.skara.se/store/1/resource/60"}],"dcat:keyword":[{"@language":"en","@value":"area"},{"@language":"en","@value":"land"},{"@language":"en","@value":"lots"},{"@language":"en","@value":"plots"},{"@language":"en","@value":"property"},{"@language":"en","@value":"queue"},{"@language":"en","@value":"villa"},{"@language":"sv","@value":"fastigheter"},{"@language":"sv","@value":"mark"},{"@language":"sv","@value":"tomt"},{"@language":"sv","@value":"tomtkö"},{"@language":"sv","@value":"villa"}],"dcat:landingPage":{"@id":"https://www.skara.se/byggaboochmiljo/levaochboiskarakommun/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/AS_NEEDED"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/ledigatomter/3.0"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001702"},"dct:description":[{"@language":"en","@value":"Describes vacant land and in some cases building-ready plots for villas, residential buildings, industry and commercial activities that are available for purchase by Skara municipality. \n\nThe dataset contains several distributions where the CSV distribution is the one that evaluates correctly against the CSV schema in the specification. In addition to this, Skara municipality has chosen to distribute flowing data directly from gis-system as GeoJSON, as well as a JSON generated from CSV but with the addition that it contains surface description in the form of Polygon in SWEREF99:1330."},{"@language":"sv","@value":"Beskriver ledig tomtmark och i viss fall byggklara tomter för villor, bostadshus, industri och kommersiell verksamhet som finns tillgänglig för köp av Skara kommun. \n\nDatamängden innehåller flera distributioner där CSV-distributionen är den som utvärderar korrekt mot CSV-schema i specifikationen. Utöver detta har Skara kommun valt att distribuera flödande data direkt från kartsystem som GeoJSON, samt en JSON genererad från CSV men med tillägget att den innehåller ytbeskrivning i form av Polygon i SWEREF99:1330."}],"dct:identifier":["available-plots","ledig-tomtmark"],"dct:issued":{"@type":"xsd:date","@value":"2024-11-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-17T09:06:00.000Z"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001702"},"dct:source":{"@id":"https://catalog.skara.se/store/1/resource/37"},"dct:spatial":[{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b0n0"},{"@id":"https://sws.geonames.org/2678205"}],"dct:title":[{"@language":"en","@value":"Available plots, vacant land"},{"@language":"sv","@value":"Lediga Tomter, ledig tomtmark"}],"http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"Initial release"},{"@language":"sv","@value":"Första versionen"}],"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b1n0"}},{"@id":"https://catalog.skara.se/store/1/resource/56","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.skara.se:8443/geoserver/ext/ows?service=WFS&version=1.1.0&request=GetFeature&typeName=tomter_y_vy_open&outputFormat=application/json&srsname=EPSG:4326"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"37384"},"dcat:downloadURL":{"@id":"https://karta.skara.se:8443/geoserver/ext/ows?service=WFS&version=1.1.0&request=GetFeature&typeName=tomter_y_vy_open&outputFormat=application/json&srsname=EPSG:4326"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/ledigatomter/3.0"},"dct:description":[{"@language":"en","@value":"Available plots, GeoJSON, as streaming data via API from GIS-system. The dataset is updated in real time as changes occur. Contains an attribute of typ \"geometry\" describing a surface as a number of points in a polygon in WGS84 format."},{"@language":"sv","@value":"Lediga tomter, GeoJSON, som strömmande data via API från GIS-system. Datat uppdateras i realtid när ändringar sker. Innehåller attribut typ \"geometry\" som beskriver yta som en polygon av punkter enligt WGS84."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-11-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-17"},"dct:rights":{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b2n0"},"dct:title":[{"@language":"en","@value":"Available plots, as GeoJSON with surface polygon geometry"},{"@language":"sv","@value":"Lediga tomter, as GeoJSON med yta som polygon"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b3n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skara.se/store/1/resource/58","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skara.se/store/1/resource/61"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"13930"},"dcat:downloadURL":{"@id":"https://catalog.skara.se/store/1/resource/61"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/ledigatomter/3.0"},"dct:description":[{"@language":"en","@value":"Available land and plots in Skara municipality. Updated on interval. Use another distribution if you want continuously updated flowing data."},{"@language":"sv","@value":"Ledig tomtmark i Skara kommun. Uppdateras med intervall, för ständigt uppdaterad data använd API för Geo JSON"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2024-11-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T11:57:19Z"},"dct:rights":{"@id":"_:c3c4627aca73a0938bf13e9344a3792f0808b34d32a05709231dbde31c742bfd_b4n0"},"dct:title":[{"@l