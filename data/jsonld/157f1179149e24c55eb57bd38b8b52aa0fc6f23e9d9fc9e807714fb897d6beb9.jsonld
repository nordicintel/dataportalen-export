"dct:conformsTo":{"@id":"https://catalog.skara.se/rowstore/dataset/96a21ba4-476c-4a5e-be01-d48f39943749/swagger"},"dct:description":[{"@language":"en","@value":"Public toilets as per specifikation, as an API"},{"@language":"sv","@value":"Offentliga toaletter enligt specifikation, som API"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2026-06-24"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-24T16:03:49.334Z"},"dct:source":{"@id":"https://catalog.skara.se/store/1/resource/100"},"dct:title":[{"@language":"de","@value":"Öffentliche Toiletten (API)"},{"@language":"en","@value":"Public toilets (API)"},{"@language":"fr","@value":"Toilettes publiques (API)"},{"@language":"it","@value":"Bagni pubblici (API)"},{"@language":"sv","@value":"Offentliga toaletter (API)"}],"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.skara.se/rowstore/dataset/96a21ba4-476c-4a5e-be01-d48f39943749/swagger"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://catalog.skara.se/store/1/resource/62","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2d5eb62879a8fbcf463d2eaada3956eb0d99ddc5adbb60bbdf990154332702b2_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@skara.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:2d5eb62879a8fbcf463d2eaada3956eb0d99ddc5adbb60bbdf990154332702b2_b2n0"},{"@id":"_:2d5eb62879a8fbcf463d2eaada3956eb0d99ddc5adbb60bbdf990154332702b2_b3n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://www.skara.se"}},{"@id":"https://catalog.skara.se/store/1/resource/98","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.skara.se/store/1/resource/62"},"dcat:distribution":[{"@id":"https://catalog.skara.se/store/1/resource/100"},{"@id":"https://catalog.skara.se/store/1/resource/102"}],"dcat:keyword":[{"@language":"de","@value":"WC"},{"@language":"de","@value":"toiletten"},{"@language":"en","@value":"restroom"},{"@language":"en","@value":"toilet"},{"@language":"fr","@value":"cabinet"},{"@language":"fr","@value":"toilette"},{"@language":"it","@value":"bagni"},{"@language":"it","@value":"bagno"},{"@language":"sv","@value":"toalett"}],"dcat:landingPage":{"@id":"https://www.skara.se/trafikochgator/torgochallmannaplatser/offentligatoaletter.3239.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/public-toilets/0.5"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001702"},"dct:description":[{"@language":"de","@value":"Öffentliche Toiletten, die von der Gemeinde Skara betrieben werden und für Einwohner und Besucher zugänglich sind. Beachten Sie, dass mehrere Toiletten saisonabhängig geöffnet sind und abends sowie nachts geschlossen sein können. Bei Vandalismus können die Anlagen ohne Vorwarnung zur Reparatur geschlossen werden. Koordinaten gemäß WGS84."},{"@language":"en","@value":"Public toilets operated by Skara Municipality and available to residents and visitors. Please note that several of the toilets are seasonal and may be closed during evenings and nights. In the event of vandalism, the facilities may be closed without prior notice for repairs. Coordinates according to WGS84."},{"@language":"fr","@value":"Toilettes publiques gérées par la commune de Skara et accessibles aux habitants et aux visiteurs. Veuillez noter que plusieurs toilettes sont ouvertes selon la saison et peuvent être fermées le soir et la nuit. En cas de vandalisme, les installations peuvent être fermées sans préavis pour réparation. Coordonnées selon WGS84."},{"@language":"it","@value":"Servizi igienici pubblici gestiti dal Comune di Skara e accessibili a residenti e visitatori. Si prega di notare che diversi bagni sono aperti stagionalmente e possono essere chiusi la sera e di notte. In caso di atti vandalici, le strutture potranno essere chiuse senza preavviso per riparazioni. Coordinate secondo WGS84."},{"@language":"sv","@value":"Offentliga toaletter som drivs i offentlig regi av Skara kommun och som är tillgängliga för invånare och besökare. Observera att flera av toaletterna är säsongsöppna och kan vara stängda på kvälls- och nattetid. Vid eventuell skadegörelse kan anläggningarna komma att stängas utan förvarning för reparation/åtgärd. Koordinater enligt WGS84."}],"dct:identifier":["offentliga-toaletter","public-toilets"],"dct:issued":{"@type":"xsd:date","@value":"2026-06-24"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2026-06-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001702"},"dct:source":{"@id":"https://catalog.skara.se/store/1/resource/98"},"dct:spatial":[{"@id":"_:2d5eb62879a8fbcf463d2eaada3956eb0d99ddc5adbb60bbdf990154332702b2_b4n0"},{"@id":"https://sws.geonames.org/2678205"}],"dct:title":[{"@language":"de","@value":"Öffentliche Toiletten"},{"@language":"en","@value":"Public toilets"},{"@language":"fr","@value":"Toilettes publiques"},{"@language":"it","@value":"Bagni pubblici"},{"@language":"sv","@value":"Offentliga toaletter"}],"http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"Experimental release"},{"@language":"sv","@value":"Experimentell version"}]},{"@id":"https://catalog.skara.se/store/1/resource/99","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"offentliga_toaletter_enriched.csv"}}],"@id":"urn:source:2d5eb62879a8fbcf463d2eaada3956eb0d99ddc5adbb60bbdf990154332702b2"},{"@graph":[{"@id":"_:bcb2629604941bfc3bcb387b6b4da1e4267821104d9dfbfb56756e2ef3c808d7_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"b2bfcdc2459057965689f9c3ac6c58f4ae8bafee"},{"@id":"_:bcb2629604941bfc3bcb387b6b4da1e4267821104d9dfbfb56756e2ef3c808d7_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46506777087"}},{"@id":"_:bcb2629604941bfc3bcb387b6b4da1e4267821104d9dfbfb56756e2ef3c808d7_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"b2bfcdc2459057965689f9c3ac6c58f4ae8bafee"},{"@id":"_:bcb2629604941bfc3bcb387b6b4da1e4267821104d9dfbfb56756e2ef3c808d7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Skara","http://www.w3.org/2006/vcard/ns#postal-code":"532 88","http://www.w3.org/2006/vcard/ns#street-address":"Skara Stadshus"},{"@id":"_:bcb2629604941bfc3bcb387b6b4da1e4267821104d9dfbfb56756e2ef3c808d7_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4