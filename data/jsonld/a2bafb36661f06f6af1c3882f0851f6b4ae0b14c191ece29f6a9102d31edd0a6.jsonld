{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#label":{"@language":"sv","@value":"Testresultaten publiceras av ADAC (Allgemeiner Deutscher Automobil-Club) i samband med deras halvårliga bilbarnstolstest. Barnsakert.se extraherar, strukturerar och tillgängliggör dessa offentligt publicerade resultat i maskinläsbart format. ADAC:s pressmeddelanden och testöversikter utgör primärkällan."}},{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2026-07-18"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-01-01"}},{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Tyresö","http://www.w3.org/2006/vcard/ns#postal-code":"135 62","http://www.w3.org/2006/vcard/ns#street-address":"Slånbacken 14"},{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46735531024"}},{"@id":"https://www.adac.de/#organisation","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:name":"ADAC e.V."},{"@id":"https://www.barnsakert.se/#organisation","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":"Barnsakert.se (Colombos AB)"},{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.csv#dist","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.csv"},"dcat:downloadURL":{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.csv"},"dct:description":{"@language":"sv","@value":"Platt tabell med ett testresultat per rad. Lämpad för import i kalkylark eller dataanalysverktyg."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"ADAC test results (CSV)"},{"@language":"sv","@value":"ADAC testresultat (CSV)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.json#dist","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.json"},"dcat:downloadURL":{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.json"},"dct:description":{"@language":"sv","@value":"Fullständig datamängd med testresultat, delbetyg och produktegenskaper i JSON-format."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"ADAC test results (JSON)"},{"@language":"sv","@value":"ADAC testresultat (JSON)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.barnsakert.se/oppna-data#adac-testresultat","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.barnsakert.se/oppna-data#kontakt"},"dcat:distribution":[{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.csv#dist"},{"@id":"https://www.barnsakert.se/data/adac-barnstolstest.json#dist"}],"dcat:keyword":["Barnsakert.se (Colombos AB)",{"@language":"en","@value":"ADAC"},{"@language":"en","@value":"child car seat"},{"@language":"en","@value":"child safety"},{"@language":"en","@value":"crash test"},{"@language":"sv","@value":"ADAC"},{"@language":"sv","@value":"barnsäkerhet"},{"@language":"sv","@value":"bilbarnstol"},{"@language":"sv","@value":"bilbarnstolstest"},{"@language":"sv","@value":"krocktest"}],"dcat:landingPage":{"@id":"https://www.barnsakert.se/oppna-data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:conformsTo":{"@id":"https://www.adac.de/rund-ums-fahrzeug/ausstattung-technik-zubehoer/kindersitze/kindersitztest/"},"dct:creator":{"@id":"https://www.adac.de/#organisation"},"dct:description":[{"@language":"en","@value":"Compilation of published test results from ADAC's independent child car seat tests (Kindersitztest). Contains ratings, sub-ratings and product attributes extracted from ADAC's official press releases. Data sourced from ADAC's publicly available test results. Barnsakert.se has compiled and structured the results in machine-readable format. ADAC has not approved or reviewed this compilation. The dataset covers 295 products and is updated twice a year. Source references to ADAC's original publications are included."},{"@language":"sv","@value":"Sammanställning av publicerade testresultat från ADAC:s oberoende bilbarnstolstest (Kindersitztest). Datamängden innehåller betyg, delbetyg och produktegenskaper extraherade från ADAC:s officiella pressmeddelanden och testöversikter. Datan är hämtad från ADAC:s offentligt publicerade testresultat. Barnsakert.se har sammanställt och strukturerat resultaten i maskinläsbart format. ADAC har inte godkänt eller granskat denna sammanställning. Datamängden omfattar 295 produkter och uppdateras två gånger per år. Källhänvisningar till ADAC:s originalpublikationer ingår i datamängden."}],"dct:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-18"},"dct:provenance":{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b0n0"},"dct:publisher":{"@id":"https://www.barnsakert.se/#organisation"},"dct:spatial":{"@id":"http://publications.europa.eu/resource/authority/country/SWE"},"dct:temporal":{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b1n0"},"dct:title":[{"@language":"en","@value":"ADAC child car seat test — compiled results"},{"@language":"sv","@value":"ADAC bilbarnstolstest — sammanställda testresultat"}],"foaf:page":{"@id":"https://www.barnsakert.se/oppna-data"}},{"@id":"https://www.barnsakert.se/oppna-data#kontakt","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Barnsakert.se","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:leo@barnsakert.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd_b3n0"}}],"@id":"urn:source:1b3ce28a7b685cfa0a680d21011bd706cd5887aeec5566237f70c1d56ada87fd"},{"@graph":[{"@id":"https://www.barnsakert.se/data/dcat-ap.rdf","@type":"dcat:Catalog","dcat:dataset":{"@id":"https://www.barnsakert.se/oppna-data#adac-testresultat"},"dcat:themeTaxonomy":{"@id":"http://publications.europa.eu/resource/authority/data-theme"},"dct:description":[{"@language":"en","@value":"Data catalog from Barnsakert.se, an independent Swedish knowledge base for child car safety. Contains compiled test results related to child car seats."},{"@language":"sv","@value":"Datakatalog från Barnsakert.se, en oberoende svensk kunskapsbank för barnsäkerhet i bil. Innehåller sammanställda testresultat relaterade till bilbarnstolar."}],"dct:issued":{"@type":"xsd:date","@value":"2026-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-18"},"dct:publisher":{"@id":"https://www.barnsakert.se/#organisation"},"dct:spatial":{"@id":"http://publications.europa.eu/resource/authority/country/SWE"},"dct:title":[{"@language":"en","@value":"Barnsakert.se — open data"},{"@language":"sv","@value":"Barnsakert.se — öppna data"}],"foaf:homepage":{"@id":"https://www.barnsakert.se"}}],"@id":"urn:source:2a628a8f790282c907bed5f1d73ca6c38911c7122e7edcf52c391232ae25750e"}]}
