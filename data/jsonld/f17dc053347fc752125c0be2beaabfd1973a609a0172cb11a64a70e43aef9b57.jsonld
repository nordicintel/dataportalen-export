p://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Varberg direkt","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f261987740aaab812af23baea74d1a71db413a11070412195e52377cd816af2c_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varbergdirekt@varberg.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f261987740aaab812af23baea74d1a71db413a11070412195e52377cd816af2c_b1n0"}},{"@id":"https://editera.dataportal.se/store/167/resource/12","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/167/resource/11"},"dcat:distribution":{"@id":"https://editera.dataportal.se/store/167/resource/13"},"dcat:inSeries":{"@id":"https://editera.dataportal.se/store/167/resource/39"},"dcat:keyword":[{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"faktura"},{"@language":"sv","@value":"inköp"},{"@language":"sv","@value":"leverantörsreskontra"},{"@language":"sv","@value":"upphandling"},{"@language":"sv","@value":"utgift"}],"dcat:landingPage":{"@id":"https://varberg.se/kommun-och-politik/service-och-kvalitetsarbete/oppen-data-jamfor-oss-med-andra-kommuner/oppna-data-om-leverantorsfakturor-leverantorsreskontra"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":{"@language":"sv","@value":"Leverantörsreskontra – öppna data om leverantörsfakturor\nI datamängden leverantörsreskontra finns information om inköp som Varbergs kommun har gjort.\n\nLeverantörsreskontra innehåller information om leverantörsfakturor som har kommit till Varbergs kommun under respektive år/månad. Observera att Varbergs kommun även kan ha utgifter som betalas ut utan koppling till en faktura.\n\nI leverantörsreskontra framgår hur varje faktura är bokförd, fakturabilden publiceras inte då den kan innehålla sekretess- eller personuppgifter. Personuppgifter är markerade som [innehåller personuppgifter].\n\nInformationen publiceras i tabellform och innehåller:\n\n- verifikationsnummer (Varbergs kommuns egen numrering)\n- leverantörens namn\n- leverantörens organisationsnummer\n- konto\n- kontotext (anger i klartext vilken slags kostnad det gäller)\n- konterat belopp exklusive moms\n- bokföringsdatum\n- förvaltning\n- fakturanummer"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001249"},"dct:spatial":{"@id":"https://sws.geonames.org/2664994"},"dct:temporal":{"@id":"_:f261987740aaab812af23baea74d1a71db413a11070412195e52377cd816af2c_b2n0"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2020"}},{"@id":"https://editera.dataportal.se/store/167/resource/13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://varberg.se/download/18.2b514d9b18a92e6fafc53b41/1650356411398/Leverant%C3%B6rsreskontra2020.csv"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2020"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://editera.dataportal.se/store/87/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Mattias Axell","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:f261987740aaab812af23baea74d1a71db413a11070412195e52377cd816af2c_b3n0"},{"@id":"_:f261987740aaab812af23baea74d1a71db413a11070412195e52377cd816af2c_b4n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mattias@meta