rtal.se/store/87/resource/2"},{"@id":"https://editera.dataportal.se/store/87/resource/4"}],"dcat:keyword":[{"@language":"en","@value":"invoice"},{"@language":"en","@value":"purchase"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"faktura"},{"@language":"sv","@value":"inköp"},{"@language":"sv","@value":"utgift"},{"@language":"sv","@value":"verifikat"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:description":{"@language":"sv","@value":"Information om gjorda inköp med belopp, köpare- och leverantörsinformation"},"dct:issued":[{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2020-10-08"},{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2021-03-23"}],"dct:modified":{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2021-03-25"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/238/leverant%C3%B6rsreskontra-som-%C3%B6ppna-data-hur-du-publicerar?_=1694522571624"},{"@id":"https://gitlab.com/lankadedata/spec/levreskontra"},{"@id":"https://lankadedata.se/spec/levreskontra/"},{"@id":"https://lankadedata.se/spec/levreskontra/schema.json"},{"@id":"https://www.dataportal.se/terminology/leverantorsreskontra_grund"}],"http://www.w3.org/ns/dx/prof/hasToken":"leverantorsreskontra"},{"@id":"https://editera.dataportal.se/store/167/resource/11","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Varberg direkt","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varbergdirekt@varberg.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b1n0"}},{"@id":"https://editera.dataportal.se/store/167/resource/39","@type":"dcat:DatasetSeries","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/167/resource/11"},"dcat:keyword":[{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"faktura"},{"@language":"sv","@value":"inköp"},{"@language":"sv","@value":"leverantörsreskontra"},{"@language":"sv","@value":"upphandling"},{"@language":"sv","@value":"utgift"}],"dcat:landingPage":{"@id":"https://varberg.se/kommun-och-politik/service-och-kvalitetsarbete/oppen-data-jamfor-oss-med-andra-kommuner/oppna-data-om-leverantorsfakturor-leverantorsreskontra"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":{"@language":"sv","@value":"Leverantörsreskontra – öppna data om leverantörsfakturor\nI datamängden leverantörsreskontra finns information om inköp som Varbergs kommun har gjort.\n\nLeverantörsreskontra innehåller information om leverantörsfakturor som har kommit till Varbergs kommun under respektive år/månad. Observera att Varbergs kommun även kan ha utgifter som betalas ut utan koppling till en faktura.\n\nI leverantörsreskontra framgår hur varje faktura är bokförd, fakturabilden publiceras inte då den kan innehålla sekretess- eller personuppgifter. Personuppgifter är markerade som [innehåller personuppgifter].\n\nInformationen publiceras i tabellform och innehåller:\n\n- verifikationsnummer (Varbergs kommuns egen numrering)\n- leverantörens namn\n- leverantörens organisationsnummer\n- konto\n- kontotext (anger i klartext vilken slags kostnad det gäller)\n- konterat belopp exklusive moms\n- bokföringsdatum\n- förvaltning\n- fakturanummer"},"dct:issued":{"@type":"xsd:date","@value":"2022-03-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001249"},"dct:spatial":{"@id":"https://sws.geonames.org/2664994"},"dct:temporal":{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b2n0"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor"}},{"@id":"https://editera.dataportal.se/store/87/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Mattias Axell","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b3n0"},{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b4n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mattias@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/2","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Eric Hjelmestam","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b5n0"},{"@id":"_:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46_b6n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:eric@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Matthias Palmér","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matthias@metasolutions.se"}},{"@id":"https://lankadedata.se/spec/levreskontra/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Leverantörsreskontra"}}],"@id":"urn:source:85f1ce8354e4123499bfda188e5a254ce4e8508769a1cdc0e96e48c194491d46"},{"@graph":[{"@id":"_:a52aab24b9c154c09df5b13e5a2822d07ae889631e