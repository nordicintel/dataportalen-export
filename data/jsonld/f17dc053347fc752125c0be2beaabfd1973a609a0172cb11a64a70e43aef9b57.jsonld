ps://community.dataportal.se/topic/238/leverant%C3%B6rsreskontra-som-%C3%B6ppna-data-hur-du-publicerar?_=1694522571624"},{"@id":"https://gitlab.com/lankadedata/spec/levreskontra"},{"@id":"https://lankadedata.se/spec/levreskontra/"},{"@id":"https://lankadedata.se/spec/levreskontra/schema.json"},{"@id":"https://www.dataportal.se/terminology/leverantorsreskontra_grund"}],"http://www.w3.org/ns/dx/prof/hasToken":"leverantorsreskontra"},{"@id":"https://editera.dataportal.se/store/167/resource/11","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Varberg direkt","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a52aab24b9c154c09df5b13e5a2822d07ae889631e2841a1715b361eab132f83_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:varbergdirekt@varberg.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a52aab24b9c154c09df5b13e5a2822d07ae889631e2841a1715b361eab132f83_b1n0"}},{"@id":"https://editera.dataportal.se/store/167/resource/48","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/167/resource/11"},"dcat:distribution":{"@id":"https://editera.dataportal.se/store/167/resource/52"},"dcat:inSeries":{"@id":"https://editera.dataportal.se/store/167/resource/39"},"dcat:keyword":[{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"faktura"},{"@language":"sv","@value":"inköp"},{"@language":"sv","@value":"leverantörsreskontra"},{"@language":"sv","@value":"upphandling"},{"@language":"sv","@value":"utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":{"@language":"sv","@value":"Leverantörsreskontra – öppna data om leverantörsfakturor\nI datamängden leverantörsreskontra finns information om inköp som Varbergs kommun har gjort.\n\nLeverantörsreskontra innehåller information om leverantörsfakturor som har kommit till Varbergs kommun under respektive år/månad. Observera att Varbergs kommun även kan ha utgifter som betalas ut utan koppling till en faktura.\n\nI leverantörsreskontra framgår hur varje faktura är bokförd, fakturabilden publiceras inte då den kan innehålla sekretess- eller personuppgifter. Personuppgifter är markerade som [innehåller personuppgifter].\n\nInformationen publiceras i tabellform och innehåller:\n\n- verifikationsnummer (Varbergs kommuns egen numrering)\n- leverantörens namn\n- leverantörens organisationsnummer\n- konto\n- kontotext (anger i klartext vilken slags kostnad det gäller)\n- konterat belopp exklusive moms\n- bokföringsdatum\n- förvaltning\n- fakturanummer"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001249"},"dct:spatial":{"@id":"https://sws.geonames.org/2664994"},"dct:temporal":{"@id":"_:a52aab24b9c154c09df5b13e5a2822d07ae889631e2841a1715b361eab132f83_b2n0"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2025"}},{"@id":"https://editera.dataportal.se/store/167/resource/52","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"_:a52aab24b9c154c09df5b13e5a2822d07ae889631e2841a1715b361eab132f83_b3n0"},{"@id":"https://varberg.se/download/18.35c10e5d19a1ffd438def834/1772120430715/Leverant%C3%B6rsreskontra2025.csv"}],"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2025, CSV"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://editera.dataportal.se/st