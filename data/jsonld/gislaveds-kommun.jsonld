den enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}},{"@id":"https://editera.dataportal.se/store/168/resource/12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://hub.arcgis.com/api/v3/datasets/4edf8960cd3a494b9db725e05ee5aefd_0/downloads/data?format=shp&spatialRefId=3857&where=1%253D1"},"dct:description":[{"@language":"en","@value":"Barbeque areas in the municipality of Gislaved. (.shp)\n\nAttributes: organization number=source, id, Name, updated, latitude, longitude and wood_storage."},{"@language":"sv","@value":"Grillplatser i Gislaveds kommun. (.shp)\n\nAttribut: organisationsnummer=source, id, Namn=Name, uppdaterad=updated, latitude, longitude samt vedförråd=wood_storage."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Barbeque areas (.shp)"},{"@language":"sv","@value":"Grillplatser (.shp)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://editera.dataportal.se/store/168/resource/13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://hub.arcgis.com/api/v3/datasets/4edf8