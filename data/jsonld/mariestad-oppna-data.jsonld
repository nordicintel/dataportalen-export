{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2120001686"}},{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"SE","http://www.w3.org/2006/vcard/ns#locality":"Töreboda","http://www.w3.org/2006/vcard/ns#postal-code":"545 22","http://www.w3.org/2006/vcard/ns#street-address":"Drottninggatan 4, Box 83"},{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4650618000"}},{"@id":"http://dataportal.se/organisation/SE2120001686","@type":"foaf:Agent","dct:identifier":"2120001686","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:info@mariestad.se"},"foaf:name":{"@language":"sv","@value":"Mariestads kommun"},"foaf:page":{"@id":"https://mariestad.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.mariestad.se/store/1/resource/1"}},{"@id":"https://catalog.mariestad.se/store/1/resource/15","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.mariestad.se/store/1/resource/37"},"dcat:distribution":{"@id":"https://catalog.mariestad.se/store/1/resource/16"},"dcat:keyword":[{"@language":"en","@value":"menu, restaurant, lunch, school lunch"},{"@language":"sv","@value":"meny, restaurang, skolmat, matsedel"}],"dcat:landingPage":{"@id":"https://skolmaten.se/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"School restaurant menus are presented in a web interface with RSS capabilities per school for the schools in the municipality. By having each school sharing the menu in the service provided by Skolmaten.se, the information is shown in the app developed by this said service. The app Skolmaten is available on all popular mobile platforms.\n\nMenus are presented as an RSS flow and can therefore be modified or reused in apps for smartphones and or tablets or other platforms and services capable of handling RSS and show the menus as an overlay on calendar apps etc. This way both the children and their parents can access the menus easily for their own school the way most convenient for them.\n\nThe service is provaided by a cooperation between the schools and the service provider Skolmaten, and it is each school that is sharing the information, which ensures high data quality - the data is shared close to the unit that runs each shool restaurant.\n\nFor more information about the service Skolmaten\", visit their website at. http://www.dinskolmat.se/"},{"@language":"sv","@value":"Skolmatsmenyer presenteras i ett webbaserat gränssnitt med RSS-funktionalitet per skola, för skolorna i kommunen. Genom att skolornas matbespisningar delar informationen till tjänsten Skolmaten.se, hamnar den i den app som utvecklats till den tjänsten. Skolmaten finns att ladda ned som app för alla mobilplattformar. \n\nMaten per skola presenteras som ett RSS-flöde och kan därför anpassas och läggas till i appar i smartphones och tablets eller andra plattformar och tjänster som stödjer RSS för att skapa en meny som presenteras i en exempelvis en kalender. På så vis kan både barn och föräldrar enkelt ta del av skolmatsedeln för sin skola på det vis de själva önskar, dag för dag. \n\nTjänsten tillhandahålls genom avtal mellan kommunen och Skolmaten.se och det är respektive skola som själva lägger ut informationen vilket borgar för hög kvalitet - informationen delas nära källan och ofta av den funktion som förestår skolbespisningen på varje skolenhet.\n\nLäs gärna mer om tjänsten \"Skolmaten\" på deras egen webb: http://www.dinskolmat.se/"}],"dct:issued":{"@type":"xsd:date","@value":"2020-11-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@language":"sv","@value":"https://skolmaten.se/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001686"},"dct:spatial":{"@id":"http://sws.geonames.org/2692611"},"dct:title":[{"@language":"en","@value":"School restaurant menu for the municipality of Mariestad"},{"@language":"sv","@value":"Skolmatsmenyer för Mariestads kommuns skolor"}]},{"@id":"https://catalog.mariestad.se/store/1/resource/16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skolmaten.se/d/mariestads-kommun/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2020-11-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b0n0"},"dct:title":[{"@language":"en","@value":"School lunch menu for schools i Mariestad municipality"},{"@language":"sv","@value":"Skolmatsedel för skolor i Mariestad"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.mariestad.se/store/1/resource/37","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"MTG Öppna Data","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalutveckling@toreboda.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884_b2n0"}}],"@id":"urn:source:2ff47e6d475fe480131188ca2514ece88b88a8a3a2111e389a4876fc75a55884"},{"@graph":[{"@id":"_:3177c414060c157579b0ca731db4790720a5beca1c2f7c1fb76da8eaee81e903_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"SE","http://www.w3.org/2006/vcard/ns#locality":"Töreboda","http://www.w3.org/2006/vcard/ns#postal-code":"545 22","http://www.w3.org/2006/vcard/ns#street-address":"Drottninggatan 4, Box 83"},{"@id":"_:3177c414060c157579b0ca731db4790720a5beca1c2f7c1fb76da8eaee81e903_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4650618000"}},{"@id":"_:3177c414060c157579b0ca731db4790720a5beca1c2f7c1fb76da8eaee81e903_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.439407102625376 58.88626935513298,13.954729930986218 58.88626935513298,13.954729930986218 58.55843410962797,13.439407102625376 58.55843410962797,13.439407102625376 58.88626935513298))"}},{"@id":"http://dataportal.se/organisation/SE2120001686","@type":"foaf:Agent","dct:identifier":"2120001686","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:info@mariestad.se"},"foaf:name":{"@language":"sv","@value":"Mariestads kommun"},"foaf:page":{"@id":"https://mariestad.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.mariestad.se/store/1/resource/1"}},{"@id":"https://catalog.mariestad.se/store/1/resource/37","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"MTG Öppna Data","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3177c414060c157579b0ca731db4790720a5beca1c2f7c1fb76da8eaee81e903_b0n0"},"http://www.w3.org/2006/vcard/ns#has