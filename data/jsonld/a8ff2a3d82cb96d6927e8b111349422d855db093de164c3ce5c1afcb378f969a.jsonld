ource/46"},"dcat:distribution":[{"@id":"https://catalog.skl.se/store/1/resource/340"},{"@id":"https://catalog.skl.se/store/1/resource/342"}],"dcat:keyword":[{"@language":"sv","@value":"Primärvård"},{"@language":"sv","@value":"Region"},{"@language":"sv","@value":"Specialiserad somatisk vård"},{"@language":"sv","@value":"Tandvård"},{"@language":"sv","@value":"Vårdval"},{"@language":"sv","@value":"Vårdvalets namn"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:description":{"@language":"sv","@value":"Införda valfrihetssystem med regionerna som huvudmän 2007 och framåt, grupperade per huvud- och delverksamhetsområden. Datumangivelser för respektive valfrihetssystems införande samt eventuell upphörande, inklusive beslutad framtida tidpunkt."},"dct:issued":{"@type":"xsd:date","@value":"2024-05-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:title":{"@language":"sv","@value":"Regionernas valfrihetssystem 2024"}},{"@id":"https://catalog.skl.se/store/1/resource/339","@type":"http://entryscape.com/terms/File","dct:title":"Regionernas valfrihetssystem 2024-xlsx.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/340","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/339"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/339"},"dct:description":{"@language":"sv","@value":"Regionernas valfrihetssystem 2024"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:rights":{"@id":"_:a3202da9d0c55c613ed9e402c804d1bcb99748bb61974fb10485460305f03f5e_b0n0"},"dct:title":{"@language":"sv","@value":"Regionernas valfrihetssystem 2024"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/341","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Regionernas valfrihetssystem 2024-csv.csv"},{"@id":"https://catalog.skl.se/store/1/resource/342","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/341"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/341"},"dct:description":{"@language":"sv","@value":"Regionernas valfrihetssystem 2024"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2024-05-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-30T06:45:20.331Z"},"dct:rights":{"@id":"_:a3202da9d0c55c613ed9e402c804d1bcb99748bb61974fb10485460305f03f5e_b1n0"},"dct:title":{"@language":"sv","@value":"Regionernas valfrihetssystem 2024"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}}],"@id":"urn:source:a3202da9d0c55c613ed9e402c804d1bcb99748bb61974fb10485460305f03f5e"},{"@graph":[{"@id":"_:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"115ae1307d76cabe549171819cf41b4659"},{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-42~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:keyword":[{"@language":"sv","@value":"DRG"},{"@language":"sv","@value":"kostnad per patient"},{"@language":"sv","@value":"psykiatri"},{"@language":"sv","@value":"slutenvård"},{"@language":"sv","@value":"vårdhändelse"},{"@language":"sv","@value":"vårdtillfälle"},{"@language":"sv","@value":"öppenvård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи и други статистически данни за специализирани психиатрични амбулаторни и болнични грижи за единадесетте региона, докладващи психиатрията в базата данни KPP на SKR. 3-годишни данни, обобщени за DRG/MDC или диагностична категория.\n\nРезултатите не се съобщават от болницата или региона в отворени данни. Всеки, който работи в някой от участващите региони, може да получи идентификационни данни за вход и достъп до повече данни."},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady a další statistiky na specializovanou psychiatrickou ambulantní a lůžkovou péči pro jedenáct regionů, které hlásí psychiatrii do databáze SKR KPP. 3leté údaje agregované o DRG/MDC nebo diagnostické kategorii.\n\nVýsledky nejsou hlášeny nemocnicí nebo regionem v otevřených datech. Každý, kdo pracuje v některém ze zúčastněných regionů, může získat přihlašovací údaje a přístup k dalším údajům."},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger og anden statistik for specialiseret psykiatrisk ambulant og indlagt behandling for de elleve regioner, der indberetter psykiatri til SKR's KPP-database. 3-årige data aggregeret på DRG/MDC eller diagnostisk kategori.\n\nResultaterne indberettes ikke af hospital eller region i åbne data. Alle, der arbejder i en af de deltagende regioner, kan få loginoplysninger og adgang til flere data."},{"@language":"de-t-sv-t0-mtec","@value":"Kosten und andere Statistiken für die spezialisierte psychiatrische ambulante und stationäre Versorgung für die elf Regionen, die die Psychiatrie an die KPP-Datenbank des SKR melden. 3-Jahres-Daten aggregiert auf DRG / MDC oder Diagnosekategorie.\n\nDie Ergebnisse werden nicht von Krankenhäusern oder Regionen in offenen Daten gemeldet. Jeder, der in einer der teilnehmenden Regionen arbeitet, kann Anmeldeinformationen und Zugriff auf weitere Daten erhalten."},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος και άλλα στατιστικά στοιχεία για εξειδικευμένη ψυχιατρική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη για τις έντεκα περιφέρειες που αναφέρουν ψυχιατρική στη βάση δεδομένων KPP της SKR. Τριετή συγκεντρωτικά δεδομένα για την DRG/MDC ή τη διαγνωστική κατηγορία.\n\nΤα αποτελέσματα δεν αναφέρονται από το νοσοκομείο ή την περιοχή στα ανοικτά δεδομένα. Οποιοσδήποτε εργάζεται σε οποιαδήποτε από τις συμμετέχουσες περιφέρειες μπορεί να λάβει διαπιστευτήρια σύνδεσης και πρόσβαση σε περισσότερα δεδομένα."},{"@language":"en-t-sv-t0-mtec","@value":"Costs and other statistics for specialised psychiatric outpatient and inpatient care for the eleven regions reporting psychiatry to SKR's KPP database. 3-year data aggregated on DRG/MDC or diagnostic category.\n\nThe results are not reported by hospital or region in open data. Anyone working in any of the participating regions can get login credentials and access to more data."},{"@language":"es-t-sv-t0-mtec","@value":"Costos y otras estadísticas para la atención psiquiátrica especializada ambulatoria y hospitalaria para las once regiones que informan de psiquiatría a la base de datos KPP de SKR. Datos a 3 años agregados en DRG/MDC o categoría diagnóstica.\n\nLos resultados no son reportados por hospital o región en datos abiertos. Cualquier persona que trabaje en cualquiera de las regiones participantes puede obtener credenciales de inicio de sesión y acceso a más datos."},{"@language":"et-t-sv-t0-mtec","@value":"Psühhiaatrilise ambulatoorse ja statsionaarse eriravi kulud ja muu statistika üheteistkümnes piirkonnas, mis teatavad psühhiaatriast SKRi KPP andmebaasis. kolme aasta koondandmed DRG/MDC või diagnostilise kategooria kohta.\n\nAvatud andmetes ei esitata tulemusi haiglate ega piirkondade kaupa. Igaüks, kes töötab mis tahes osalevas piirkonnas, saab sisselogimisandmed ja juurdepääsu rohkematele andmetele."},{"@language":"fi-t-sv-t0-mtec","@value":"Psykiatrisen avo- ja laitoshoidon kustannukset ja muut tilastot niillä 11 alueella, jotka raportoivat psykiatriasta SKR:n KPP-tietokantaan. DRG/MDC:stä tai diagnostisesta luokasta kootut kolmen vuoden tiedot.\n\nAvoimissa tiedoissa tuloksia ei raportoida sairaala- tai aluekohtaisesti. Kuka tahansa, joka työskentelee millä tahansa osallistuvalla alueella, voi saada kirjautumistiedot ja pääsyn muihin tietoihin."},{"@language":"fr-t-sv-t0-mtec","@value":"Coûts et autres statistiques pour les soins psychiatriques ambulatoires et hospitaliers spécialisés pour les onze régions déclarant la psychiatrie à la base de données KPP de SKR. Données triennales agrégées sur DRG/MDC ou catégorie diagnostique.\n\nLes résultats ne sont pas rapportés par l'hôpital ou la région dans les données ouvertes. Toute personne travaillant dans l'une des régions participantes peut obtenir des identifiants de connexion et accéder à plus de données."},{"@language":"ga-t-sv-t0-mtec","@value":"Costais agus staitisticí eile maidir le sainchúram síciatrach othar seachtrach agus othar cónaitheach don aon réigiún déag a thuairiscíonn síciatracht do bhunachar sonraí KPP SKR. Sonraí 3 bliana comhiomlánaithe maidir le DRG/MDC nó catagóir dhiagnóiseach.\n\nNí thuairiscíonn an t-ospidéal ná an réigiún na torthaí i sonraí oscailte. Is féidir le duine ar bith atá ag obair in aon cheann de na réigiúin rannpháirteacha dintiúir logála isteach agus rochtain a fháil ar níos mó sonraí."},{"@language":"hr-t-sv-t0-mtec","@value":"Troškovi i druge statistike za specijaliziranu psihijatrijsku ambulantnu i bolničku skrb za jedanaest regija koje prijavljuju psihijatriju u SKR-ovu bazu podataka KPP. Trogodišnji agregirani podaci o DRG-u/MDC-u ili dijagnostičkoj kategoriji.\n\nRezultati nisu prijavljeni po bolnicama ili regijama u otvorenim podacima. Svatko tko radi u bilo kojoj od regija sudionica može dobiti vjerodajnice za prijavu i pristup većem broju podataka."},{"@language":"hu-t-sv-t0-mtec","@value":"A speciális pszichiátriai járóbeteg- és fekvőbeteg-ellátás költségei és egyéb statisztikái a pszichiátriát az SKR KPP adatbázisába jelentő tizenegy régióban. DRG/MDC vagy diagnosztikai kategória alapján összesített hároméves adatok.\n\nAz eredményeket a nyílt hozzáférésű adatokban sem a kórházak, sem a régiók nem jelentik. Bárki, aki a részt vevő régiók bármelyikében dolgozik, bejelentkezési hitelesítő adatokat kaphat, és több adathoz férhet hozzá."},{"@language":"it-t-sv-t0-mtec","@value":"Costi e altre statistiche per l'assistenza psichiatrica specialistica ambulatoriale e ospedaliera per le undici regioni che segnalano la psichiatria alla banca dati KPP di SKR. Dati triennali aggregati su DRG/MDC o categoria diagnostica.\n\nI risultati non sono riportati dall'ospedale o dalla regione in dati aperti. Chiunque lavori in una delle regioni partecipanti può ottenere le credenziali di accesso e l'accesso a più dati."},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos ir kiti statistiniai duomenys, susiję su specializuota psichiatrine ambulatorine ir stacionarine priežiūra vienuolikoje regionų, pranešančių apie psichiatriją SKR KPP duomenų bazėje. 3 metų suvestiniai DRG/MDC arba diagnostikos kategorijos duomenys.\n\nApie rezultatus ligoninėse ar regionuose nepateikiama atvirųjų duomenų. Kiekvienas, dirbantis bet kuriame iš dalyvaujančių regionų, gali gauti prisijungimo duomenis ir prieigą prie daugiau duomenų."},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas un cita statistika par specializēto psihiatrisko ambulatoro un stacionāro aprūpi vienpadsmit reģionos, kas ziņo par psihiatriju SKR KPP datubāzē. 3 gadu dati, kas apkopoti par DRG/MDC vai diagnostikas kategoriju.\n\nRezultātus neziņo pēc slimnīcas vai reģiona atklātajos datos. Ikviens, kas strādā kādā no iesaistītajiem reģioniem, var saņemt pieteikšanās datus un piekļuvi papildu datiem."},{"@language":"mt-t-sv-t0-mtec","@value":"Spejjeż u statistika oħra għall-kura psikjatrika speċjalizzata outpatient u inpatient għall-ħdax-il reġjun li jirrapportaw il-psikjatrija fil-bażi tad-data tal-KPP ta’ SKR. Data ta’ 3 snin aggregata dwar id-DRG/MDC jew il-kategorija dijanjostika.\n\nIr-riżultati ma jiġux irrappurtati mill-isptar jew mir-reġjun f’data miftuħa. Kull min jaħdem fi kwalunkwe wieħed mir-reġjuni parteċipanti jista’ jikseb kredenzjali ta’ login u aċċess għal aktar data."},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten en andere statistieken voor gespecialiseerde psychiatrische poliklinische en intramurale zorg voor de elf regio's die psychiatrie rapporteren aan de KPP-database van SKR. Geaggregeerde gegevens over drie jaar over DRG/MDC of diagnostische categorie.\n\nDe resultaten worden niet gerapporteerd door het ziekenhuis of de regio in open data. Iedereen die in een van de deelnemende regio's werkt, kan inloggegevens en toegang tot meer gegevens krijgen."},{"@language":"pl-t-sv-t0-mtec","@value":"Koszty i inne statystyki dotyczące specjalistycznej ambulatoryjnej i szpitalnej opieki psychiatrycznej w jedenastu regionach zgłaszających psychiatrę do bazy danych KPP SKR. 3-letnie dane zagregowane dotyczące DRG/MDC lub kategorii diagnostycznej.\n\nWyniki nie są zgłaszane przez szpital lub region w otwartych danych. Każdy, kto pracuje w dowolnym z uczestniczących regionów, może uzyskać dane logowania i dostęp do większej ilości danych."},{"@language":"pt-t-sv-t0-mtec","@value":"Custos e outras estatísticas para cuidados psiquiátricos especializados em ambulatório e internamento para as onze regiões que comunicam a psiquiatria à base de dados KPP da SKR. Dados de 3 anos agregados em DRG/MDC ou categoria de diagnóstico.\n\nOs resultados não são relatados pelo hospital ou região em dados abertos. Qualquer pessoa que trabalhe em qualquer uma das regiões participantes pode obter credenciais de login e acesso a mais dados."},{"@language":"ro-t-sv-t0-mtec","@value":"Costuri și alte statistici pentru asistența psihiatrică specializată în ambulatoriu și spitalizare pentru cele unsprezece regiuni care raportează psihiatria către baza de date KPP a SKR. date pe 3 ani agregate privind DRG/MDC sau categoria de diagnostic.\n\nRezultatele nu sunt raportate de spital sau regiune în date deschise. Oricine lucrează în oricare dintre regiunile participante poate obține acreditări de conectare și acces la mai multe date."},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady a iné štatistiky pre špecializovanú psychiatrickú ambulantnú a ústavnú starostlivosť pre jedenásť regiónov, ktoré hlásia psychiatriu do databázy KPP SKR. 3-ročné súhrnné údaje o DRG/MDC alebo diagnostickej kategórii.\n\nVýsledky nie sú hlásené nemocnicou alebo regiónom v otvorených dátach. Ktokoľvek, kto pracuje v ktorejkoľvek zo zúčastnených oblastí, môže získať prihlasovacie údaje a prístup k ďalším údajom."},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški in drugi statistični podatki za specializirano psihiatrično ambulantno in bolnišnično oskrbo za enajst regij, ki poročajo o psihiatriji v podatkovni zbirki KPP SKR. triletni podatki, združeni za DRG/MDC ali diagnostično kategorijo.\n\nBolnišnica ali regija ne poroča o rezultatih v odprtih podatkih. Vsi, ki delajo v kateri koli od sodelujočih regij, lahko dobijo poverilnice za prijavo in dostop do več podatkov."},{"@language":"sv","@value":"Kostnader och annan statistik för specialiserad psykiatrisk öppen- och slutenvård för de elva regioner som rapporterar psykiatri till SKR:s KPP-databas. Treårsdata aggregerat på DRG/MDC eller diagnoskategori.\n\nResultaten redovisas inte uppdelat på sjukhus eller region i öppna data. Den som arbetar i någon av de regioner som deltar kan få inloggningsuppgifter och tillgång till mer data."},{"@language":"uk-t-sv-t0-mtec","@value":"Витрати та інша статистика спеціалізованої психіатричної амбулаторної та стаціонарної допомоги для одинадцяти регіонів, які повідомляють про психіатрію, до бази даних KPP SKR. 3-річні дані, агреговані за DRG/MDC або діагностичною категорією.\n\nРезультати не повідомляються лікарнею або регіоном у відкритих даних. Будь-хто, хто працює в будь-якому з регіонів-учасниць, може отримати облікові дані для входу та доступ до більшої кількості даних."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) — специализирани психиатрични амбулаторни и стационарни грижи"},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) - specializovaná psychiatrická ambulantní a lůžková péče"},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) – specialiseret psykiatrisk ambulant behandling og indlæggelse"},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) - spezialisierte psychiatrische ambulante und stationäre Versorgung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) - εξειδικευμένη ψυχιατρική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη"},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) - specialised psychiatric outpatient and inpatient care"},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP): atención psiquiátrica especializada ambulatoria y hospitalaria"},{"@language":"et-t-sv-t0-mtec","@value":"Kulu patsiendi kohta (KPP) – spetsiaalne psühhiaatriline ambulatoorne ja statsionaarne ravi"},{"@language":"fi-t-sv-t0-mtec","@value":"Kustannukset potilasta kohti - erikoistunut psykiatrinen avo- ja laitoshoito"},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) - soins psychiatriques ambulatoires et hospitaliers spécialisés"},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) - sainchúram síciatrach othar seachtrach agus othar cónaitheach"},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) – specijalizirana psihijatrijska ambulantna i bolnička skrb"},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) – speciális pszichiátriai járóbeteg- és fekvőbeteg-ellátás"},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) - cure psichiatriche specialistiche ambulatoriali e ospedaliere"},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos vienam pacientui (KPP) – specializuota psichiatrinė ambulatorinė ir stacionarinė priežiūra"},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz pacientu (KPP) – specializēta psihiatriskā ambulatorā un stacionārā aprūpe"},{"@language":"mt-t-sv-t0-mtec","@value":"Kost għal kull pazjent (KPP) - kura psikjatrika speċjalizzata outpatient u inpatient"},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) - gespecialiseerde psychiatrische poliklinische en intramurale zorg"},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) – specjalistyczna ambulatoryjna i szpitalna opieka psychiatryczna"},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) - cuidados psiquiátricos especializados em ambulatório e internamento"},{"@language":"ro-t-sv-t0-mtec","@value":"Cost per pacient (KPP) - asistență psihiatrică specializată ambulatorie și spitalizare"},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) – špecializovaná psychiatrická ambulantná a ústavná starostlivosť"},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) – specializirana psihiatrična ambulantna in bolnišnična oskrba"},{"@language":"sv","@value":"Kostnad per patient (KPP) - specialiserad psykiatrisk öppen- och slutenvård"},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість за пацієнта (KPP) - спеціалізована психіатрична амбулаторна та стаціонарна допомога"}]},{"@id":"http://data.europa.eu/88u/record/https-catalog-skl-se-store-1-resource-42~~1","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://catalog.skl.se/store/1/resource/42","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:08Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:50Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-42~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-catalog-skl-se-store-1-resource-42~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-23T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:50Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]}],"@id":"urn:source:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d"},{"@graph":[{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}},{"@id":"https://catalog.skl.se/store/1/resource/485","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:distribution":[{"@id":"https://catalog.skl.se/store/1/resource/487"},{"@id":"https://catalog.skl.se/store/1/resource/489"},{"@id":"https://catalog.skl.se/store/1/resource/491"},{"@id":"https://catalog.skl.se/store/1/resource/493"},{"@id":"https://catalog.skl.se/store/1/resource/495"},{"@id":"https://catalog.skl.se/store/1/resource/497"},{"@id":"https://catalog.skl.se/store/1/resource/499"},{"@id":"https://catalog.skl.se/store/1/resource/501"},{"@id":"https://catalog.skl.se/store/1/resource/503"},{"@id":"https://catalog.skl.se/store/1/resource/505"},{"@id":"https://catalog.skl.se/store/1/resource/507"},{"@id":"https://catalog.skl.se/store/1/resource/509"},{"@id":"https://catalog.skl.se/store/1/resource/511"},{"@id":"https://catalog.skl.se/store/1/resource/513"}],"dcat:inSeries":{"@id":"https://catalog.skl.se/store/1/resource/483"},"dcat:keyword":[{"@language":"sv","@value":"DRG (Diagnosis Related Groups)"},{"@language":"sv","@value":"KPP (Kostnad Per Patient)"},{"@language":"sv","@value":"Klassifikation"},{"@language":"sv","@value":"Psykiatrisk vård"},{"@language":"sv","@value":"Somatisk slutenvård"},{"@language":"sv","@value":"Somatisk vård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"NordDRG är ett system för klassificering av vårdkontakter och står för Nordiska ländernas samarbete med DRG (Diagnosis Related Groups). Socialstyrelsen ansvarar för arbetet med DRG. Socialstyrelsen tar fram prospektiva DRG-viktlistor (prognostiserade vikter) varje år för somatisk och psykiatrisk vård. SKR ansvarar för KPP-databasen och tar fram retrospektiva DRG-viktlistor varje år utifrån utfall i KPP-databasen. \n\nVikterna skapas per år och relaterar alltid till vikten 1 som är genomsnittskostnaden för ett vårdtillfälle inom den specialiserade somatiska vården (kostnadsytterfall exkluderade). Vikterna skapas även för varje vårdgren (somatisk vård, psykiatrisk vård och primärvård i kombination med öppen och sluten vård) för sig."},"dct:issued":{"@type":"xsd:date","@value":"2024-12-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:title":{"@language":"sv","@value":"Retrospektiva vikter för NordDRG"}},{"@id":"https://catalog.skl.se/store/1/resource/486","@type":"http://entryscape.com/terms/File","dct:title":"vikter2018.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/487","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/486"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/486"},"dct:description":{"@language":"sv","@value":"DRG Vikter 2018"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-10T07:44:42.485Z"},"dct:title":{"@language":"sv","@value":"DRG Vikter 2018"}},{"@id":"https://catalog.skl.se/store/1/resource/488","@type":"http://entryscape.com/terms/File","dct:title":"vikter2019.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/489","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/488"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/488"},"dct:description":{"@language":"sv","@value":"DRG Vikter 2019"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-10T07:45:18.849Z"},"dct:title":{"@language":"sv","@value":"DRG Vikter 2019"}},{"@id":"https://catalog.skl.se/store/1/resource/490","@type":"http://entryscape.com/terms/File","dct:title":"vikter2020.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/491","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/490"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/490"},"dct:description":{"@language":"sv","@value":"DRG Vikter 2020"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-10T07:45:40.158Z"},"dct:title":{"@language":"sv","@value":"DRG Vikter 2020"}},{"@id":"https://catalog.skl.se/store/1/resource/492","@type":"http://entryscape.com/terms/File","dct:title":"vikter2021.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/493","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/492"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/492"},"dct:description":{"@language":"sv","@value":"DRG Vikter 2021"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-10T07:46:09.456Z"},"dct:title":{"@lang