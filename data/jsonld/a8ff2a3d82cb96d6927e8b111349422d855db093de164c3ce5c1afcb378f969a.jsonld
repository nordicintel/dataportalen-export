pa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kostnader och annan statistik för specialiserad psykiatrisk öppen- och slutenvård för de elva regioner som rapporterar psykiatri till SKR:s KPP-databas. Treårsdata aggregerat på DRG/MDC eller diagnoskategori.\n\nResultaten redovisas inte uppdelat på sjukhus eller region i öppna data. Den som arbetar i någon av de regioner som deltar kan få inloggningsuppgifter och tillgång till mer data."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":{"@language":"sv","@value":"Kostnad per patient (KPP) - specialiserad psykiatrisk öppen- och slutenvård"}},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}}],"@id":"urn:source:37abd3caf38932b6fc8e24b9dd4884268c9d61be87f082eea5140607dd661106"},{"@graph":[{"@id":"_:3e66d22f28bd58b310ca172301eaf5c4204284a7413f7f81f681874559b9c0c5_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionURL":{"@id":"https://skr.se/skr/ekonomijuridik/ekonomi/redovisningbokforing/regionbas.24246.html"}},{"@id":"_:3e66d22f28bd58b310ca172301eaf5c4204284a7413f7f81f681874559b9c0c5_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionURL":{"@id":"https://skr.se/skr/ekonomijuridik/ekonomi/redovisningbokforing/regionbas.24246.html"}},{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/355","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:distribution":[{"@id":"https://catalog.skl.se/store/1/resource/357"},{"@id":"https://catalog.skl.se/store/1/resource/363"},{"@id":"https://catalog.skl.se/store/1/resource/376"}],"dcat:keyword":[{"@language":"sv","@value":"baskontoplan"},{"@language":"sv","@value":"bokföring"},{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"klassificeringssystem"},{"@language":"sv","@value":"normalkontoplan"},{"@language":"sv","@value":"redovisning"}],"dcat:landingPage":{"@id":"https://skr.se/skr/ekonomijuridik/ekonomi/redovisningbokforing/regionbas.24246.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Region-Bas är baskontoplanen för regioner. Den baskontoplan som finns för näringslivet är en förebild för Region-Bas. De olika kontoplanerna uppvisar likheter men också olikheter som bland annat förklaras av att redovisningen styrs av olika lagstiftningar, samt ett antal sektorspecifika förhållanden. SKR uppdaterar baskontoplanen i samverkan med en arbetsgrupp med representanter från ett antal regioner och SCB. Det löpande underhållsarbetet innebär att kontoplanen får en årlig uppdatering och en ny version presenteras på SKR:s webbplats varje år. Den version som publiceras här avser räkenskapsåret 2025."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-05-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Region-Bas"}},{"@id":"https://catalog.skl.se/store/1/resource/356","@type":"http://entryscape.com/terms/File","dct:title":"Region-Bas-2025.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/357","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/356"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/356"},"dct:description":{"@language":"sv","@value":"Region-Bas är baskontoplanen för regioner. Den baskontoplan som finns för näringslivet är en förebild för Region-Bas. De olika kontoplanerna uppvisar likheter men också olikheter som bland annat förklaras av att redovisningen styrs av olika lagstiftningar, samt ett antal sektorspecifika förhållanden. SKR uppdaterar baskontoplanen i samverkan med en arbetsgrupp med representanter från ett antal regioner och SCB. Det löpande underhållsarbetet innebär att kontoplanen får en årlig uppdatering och en ny version presenteras på SKR:s webbplats varje år."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2023-05-04"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-12T09:23:46.990Z"},"dct:rights":{"@id":"_:3e66d22f28bd58b310ca172301eaf5c4204284a7413f7f81f681874559b9c0c5_b0n0"},"dct:title":{"@language":"sv","@value":"Region-Bas"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/362","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Region-Bas-2025.csv"},{"@id":"https://catalog.skl.se/store/1/resource/363","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/362"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/362"},"dct:description":{"@language":"sv","@value":"Region-Bas är baskontoplanen för regioner. Den baskontoplan som finns för näringslivet är en förebild för Region-Bas. De olika kontoplanerna uppvisar likheter men också olikheter som bland annat förklaras av att redovisningen styrs av olika lagstiftningar, samt ett antal sektorspecifika förhållanden. SKR uppdaterar baskontoplanen i samverkan med en arbetsgrupp med representanter från ett antal regioner och SCB. Det löpande underhållsarbetet innebär att kontoplanen får en årlig uppdatering och en ny version presenteras på SKR:s webbplats varje år."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-12T13:11:20.254Z"},"dct:rights":{"@id":"_:3e66d22f28bd58b310ca172301eaf5c4204284a7413f7f81f681874559b9c0c5_b1n0"},"dct:title":{"@language":"sv","@value":"Region-Bas"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/376","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.skl.se/rowstore/dataset/5bec38f5-8f47-400e-853b-9b83b2022afd"},"dct:conformsTo":{"@id":"https://catalog.skl.se