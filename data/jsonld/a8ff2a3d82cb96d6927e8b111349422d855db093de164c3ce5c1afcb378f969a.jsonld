skl.se/store/1/resource/388"},{"@id":"https://catalog.skl.se/store/1/resource/39"},{"@id":"https://catalog.skl.se/store/1/resource/42"},{"@id":"https://catalog.skl.se/store/1/resource/428"},{"@id":"https://catalog.skl.se/store/1/resource/437"},{"@id":"https://catalog.skl.se/store/1/resource/483"},{"@id":"https://catalog.skl.se/store/1/resource/485"},{"@id":"https://catalog.skl.se/store/1/resource/532"},{"@id":"https://catalog.skl.se/store/1/resource/55"},{"@id":"https://catalog.skl.se/store/1/resource/73"},{"@id":"https://catalog.skl.se/store/1/resource/80"}],"dct:description":"SKR","dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:title":"Sveriges Kommuner och Regioner"}],"@id":"urn:source:7d93e07c2a49340a9fd31f84bb1f3908b520968568db73159963f192caae85db"},{"@graph":[{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}},{"@id":"https://catalog.skl.se/store/1/resource/483","@type":"dcat:DatasetSeries","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:keyword":[{"@language":"sv","@value":"DRG (Diagnosis Related Groups)"},{"@language":"sv","@value":"KPP (Kostnad Per Patient)"},{"@language":"sv","@value":"Klassifikation"},{"@language":"sv","@value":"Psykiatrisk vård"},{"@language":"sv","@value":"Somatisk slutenvård"},{"@language":"sv","@value":"Somatisk vård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"NordDRG är ett system för klassificering av vårdkontakter och står för Nordiska ländernas samarbete med DRG (Diagnosis Related Groups). Socialstyrelsen ansvarar för arbetet med DRG. Socialstyrelsen tar fram prospektiva DRG-viktlistor (prognostiserade vikter) varje år för somatisk och psykiatrisk vård. SKR ansvarar för KPP-databasen och tar fram retrospektiva DRG-viktlistor varje år utifrån utfall i KPP-databasen. \n\nVikterna skapas per år och relaterar alltid till vikten 1 som är genomsnittskostnaden för ett vårdtillfälle inom den specialiserade somatiska vården (kostnadsytterfall exkluderade). Vikterna skapas även för varje vårdgren (somatisk vård, psykiatrisk vård och primärvård i kombination med öppen och sluten vård) för sig."},"dct:issued":{"@type":"xsd:date","@value":"2024-12-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:title":{"@language":"sv","@value":"Retrospektiva vikter för NordDRG"}}],"@id":"urn:source:8907f06c95e14a996c41b0f05aed1054acf5f1e9ff7a400bdaa507d1b9511f5c"},{"@graph":[{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/200","@type":"