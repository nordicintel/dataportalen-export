rity/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:description":{"@language":"sv","@value":"Data avseende SKR:s senaste prognos för vissa utvalda variabler. Uppdateras fem gånger per år i samband med publicering av SKR:s prognoser. Det sker i februari, maj, augusti, oktober och december.\n\nNotera att data för sysselsatta och arbetslöshet avser 15-74 år enligt Arbetskraftsundersökningarna (AKU). Data för timlön och lönesumma enligt Nationalräkenskaperna (NR) avser anställda.\n\nKällor för publicerad data är Macrobond, Medlingsinstitutet, Riksbanken, Skatteverket och Statistiska centralbyrån samt Sveriges Kommuner och Regioner."},"dct:issued":{"@type":"xsd:date","@value":"2026-10-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:title":{"@language":"sv","@value":"Makroekonomiska nyckeltal för svensk ekonomi"}},{"@id":"https://catalog.skl.se/store/1/resource/429","@type":"http://entryscape.com/terms/File","dct:title":"SKR makroekonomisk prognos.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/430","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/429"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/429"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-06T11:26:38.750Z"},"dct:title":{"@language":"sv","@value":"Makroekonomiska nyckeltal, prognoser"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.skl.se/store/1/resource/431","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"SKR makroekonomisk prognos.csv"},{"@id":"https://catalog.skl.se/store/1/resource/432","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/431"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/431"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-06T11:26:52.711Z"},"dct:title":{"@language":"sv","@value":"Makroekonomiska nyckeltal, prognoser"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.skl.se/store/1/resource/436","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.skl.se/rowstore/dataset/02e32240-6f88-4505-8d4c-c9db988615b3"},"dct:conformsTo":{"@id":"https://catalog.skl.se/rowstore/dataset/02e32240-6f88-4505-8d4c-c9db988615b3/swagger"},"dct:description":{"@language":"sv","@value":"Makroekonomiska nyckeltal, prognoser"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-06T11:26:58.284Z"},"dct:source":{"@id":"https://catalog.skl.se/store/1/resource/432"},"dct:title":{"@language":"sv","@value":"Makroekonomiska nyckeltal, prognoser"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.skl.se/rowstore/dataset/02e32240-6f88-4505-8d4c-c9db988615b3/swagger"}},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}}],"@id":"urn:source:488f3e112232b4427a549eb7a29847fe90bf2473cdfc4a6a36f78aa2e27ae336"},{"@graph":[{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/167","@type":"http://entryscape.com/terms/File","dct:format":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","dct:title":"Kontaktuppgifter-regioner.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/168","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/167"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/167"},"dct:description":{"@language":"sv","@value":"Webbadress, e-postadress och telefonnummer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-09T14:06:38.818Z"},"dct:title":{"@language":"sv","@value":"Kontaktuppgifter till regioner_xls"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/169","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Kontaktuppgifter-regioner.csv"},{"@id":"https://catalog.skl.se/store/1/resource/170","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/169"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/169"},"dct:description":{"@language":"sv","@value":"Webbadress, e-postadress och telefonnummer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-09T14:09:38.189Z"},"dct:title":{"@language":"sv","@value":"Kontaktuppgifter till regioner_csv"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/313","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.skl.se/rowstore/dataset/13e89a69-b7d7-443f-9944-5f936b8a1959"},"dct:conformsTo":{"@id":"https://catalog.skl.se/rowstore/dataset/13e89a69-b7d7-443f-9944-5f936b8a1959/swagger"},"dct:description":{"@language":"sv","@value":"Kontaktuppgifter till regioner_json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-09T14:10:33.099Z"},"dct:source":{"@id":"https://catalog.skl.se/store/1/resource/170"},"dct:title":{"@language":"sv","@value":"Kontaktuppgifter till regioner_json"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/store/1/resource/46","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@skr.se"}},{"@id":"https://catalog.skl.se/store/1/resource/55","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:distribution":[{"@id":"https://catalog.skl.se/store/1/resource/168"},{"@id":"https://catalog.skl.se/store/1/resource/170"},{"@id":"https://catalog.skl.se/store/1/resource/313"}],"dcat:keyword":[{"@language":"sv","@value":"E-postadress"},{"@language":"sv","@value":"Kontaktuppgifter"},{"@language":"sv","@value":"Regioner"},{"@language":"sv","@value":"Telefonnummer"},{"@language":"sv","@value":"Webbadress"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"E-postadresser, webbadresser, organisationsnummer, postadresser och telefonnummer till regionerna. Uppgifterna är hämtade från Sveriges Kommuners och Regioners (SKR:s) kontaktportal."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@language":"sv","@value":"Uppgifterna är hämtade ur Sveriges Kommuners och Landstings (SKR:s) intressentregister."},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:source":{"@id":"https://catalog.skl.se/store/1/resource/55"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":{"@language":"sv","@value":"Kontaktuppgifter till regioner"}}],"@id":"urn:source:508bd3c2c136b0f23e26805828c5933c138123698e6e9bee3c65c97d1619de68"},{"@graph":[{"@id":"_:5e5570d0af1bdbd6355e3a8f7ade35b21303d79ec114e3d2e6234fff1b85227b_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"f3712d7fddc8567bf91b086c1c143a978"},{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-39~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:keyword":[{"@language":"sv","@value":"DRG"},{"@language":"sv","@value":"kostnad per patient"},{"@language":"sv","@value":"slutenvård"},{"@language":"sv","@value":"somatik"},{"@language":"sv","@value":"vårdhändelse"},{"@language":"sv","@value":"vårdtillfälle"},{"@language":"sv","@value":"öppenvård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) в специализирана соматична амбулаторна и болнична помощ. 3-годишни данни на ниво събитие за полагане на грижи. Резултатите не се съобщават от болницата или региона в отворени данни. Всеки, който работи в някой от участващите региони, може да получи идентификационни данни за вход и достъп до повече данни. "},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) ve specializované somatické ambulantní a lůžkové péči. Údaje za 3 roky na úrovni pečovatelské akce. Výsledky nejsou hlášeny nemocnicí nebo regionem v otevřených datech. Každý, kdo pracuje v některém ze zúčastněných regionů, může získat přihlašovací údaje a přístup k dalším údajům. "},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) ved specialiseret somatisk ambulant behandling og indlæggelse. 3-års data på plejebegivenhedsniveau. Resultaterne indberettes ikke af hospital eller region i åbne data. Alle, der arbejder i en af de deltagende regioner, kan få loginoplysninger og adgang til flere data. "},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) in der spezialisierten somatischen ambulanten und stationären Versorgung. 3-Jahres-Daten auf Pflege-Ereignis-Ebene. Die Ergebnisse werden nicht von Krankenhäusern oder Regionen in offenen Daten gemeldet. Jeder, der in einer der teilnehmenden Regionen arbeitet, kann Anmeldeinformationen und Zugriff auf weitere Daten erhalten. "},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) στην εξειδικευμένη σωματική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη. Τριετή δεδομένα σε επίπεδο εκδήλωσης φροντίδας. Τα αποτελέσματα δεν αναφέρονται από το νοσοκομείο ή την περιοχή στα ανοικτά δεδομένα. Οποιοσδήποτε εργάζεται σε οποιαδήποτε από τις συμμετέχουσες περιφέρειες μπορεί να λάβει διαπιστευτήρια σύνδεσης και πρόσβαση σε περισσότερα δεδομένα. "},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) in specialised somatic outpatient and inpatient care. 3-year data at care event level. The results are not reported by hospital or region in open data. Anyone working in any of the participating regions can get login credentials and access to more data. "},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP) en atención somática especializada ambulatoria y hospitalaria. Datos de 3 años a nivel de evento de atención. Los resultados no son reportados por hospital o región en datos abiertos. Cualquier persona que trabaje en cualquiera de las regiones participantes puede obtener credenciales de inicio de sesión y acceso a más datos. "},{"@language":"et-t-sv-t0-mtec","@value":"Somaatilise ambulatoorse ja statsionaarse eriravi kulud patsiendi kohta. 3-aastased andmed hooldussündmuse tasandil. Avatud andmetes ei esitata tulemusi haiglate ega piirkondade kaupa. Igaüks, kes töötab mis tahes osalevas piirkonnas, saab sisselogimisandmed ja juurdepääsu rohkematele andmetele. "},{"@language":"fi-t-sv-t0-mtec","@value":"Somaattisen avo- ja laitoshoidon kustannukset potilasta kohti. 3 vuoden tiedot hoitotapahtumatasolla. Avoimissa tiedoissa tuloksia ei raportoida sairaala- tai aluekohtaisesti. Kuka tahansa, joka työskentelee millä tahansa osallistuvalla alueella, voi saada kirjautumistiedot ja pääsyn muihin tietoihin. "},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) dans les soins somatiques ambulatoires et hospitaliers spécialisés. Données sur 3 ans au niveau de l'événement de soins. Les résultats ne sont pas rapportés par l'hôpital ou la région dans les données ouvertes. Toute personne travaillant dans l'une des régions participantes peut obtenir des identifiants de connexion et accéder à plus de données. "},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) i sainchúram othar seachtrach sómach agus othar cónaitheach. Sonraí 3 bliana ar leibhéal an imeachta cúraim. Ní thuairiscíonn an t-ospidéal ná an réigiún na torthaí i sonraí oscailte. Is féidir le duine ar bith atá ag obair in aon cheann de na réigiúin rannpháirteacha dintiúir logála isteach agus rochtain a fháil ar níos mó sonraí. "},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) u specijaliziranoj somatskoj ambulantnoj i bolničkoj skrbi. Trogodišnji podaci na razini događaja povezanih sa skrbi. Rezultati nisu prijavljeni po bolnicama ili regijama u otvorenim podacima. Svatko tko radi u bilo kojoj od regija sudionica može dobiti vjerodajnice za prijavu i pristup većem broju podataka. "},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) a speciális szomatikus járóbeteg- és fekvőbeteg-ellátásban. 3 éves adatok az ápolási esemény szintjén. Az eredményeket a nyílt hozzáférésű adatokban sem a kórházak, sem a régiók nem jelentik. Bárki, aki a részt vevő régiók bármelyikében dolgozik, bejelentkezési hitelesítő adatokat kaphat, és több adathoz férhet hozzá. "},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) nell'assistenza somatica specialistica ambulatoriale e ospedaliera. Dati triennali a livello di evento assistenziale. I risultati non sono riportati dall'ospedale o dalla regione in dati aperti. Chiunque lavori in una delle regioni partecipanti può ottenere le credenziali di accesso e l'accesso a più dati. "},{"@language":"lt-t-sv-t0-mtec","@value":"Specializuotos somatinės ambulatorinės ir stacionarinės priežiūros išlaidos vienam pacientui (KPP). 3 metų duomenys priežiūros įvykio lygmeniu. Apie rezultatus ligoninėse ar regionuose nepateikiama atvirųjų duomenų. Kiekvienas, dirbantis bet kuriame iš dalyvaujančių regionų, gali gauti prisijungimo duomenis ir prieigą prie daugiau duomenų. "},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz vienu pacientu specializētajā somatiskajā ambulatorajā un stacionārajā aprūpē. 3 gadu dati aprūpes pasākumu līmenī. Rezultātus neziņo pēc slimnīcas vai reģiona atklātajos datos. Ikviens, kas strādā kādā no iesaistītajiem reģioniem, var saņemt pieteikšanās datus un piekļuvi papildu datiem. "},{"@language":"mt-t-sv-t0-mtec","@value":"Spiża għal kull pazjent (KPP) f’kura speċjalizzata somatika outpatient u inpatient. Data ta’ 3 snin fil-livell ta’ avveniment ta’ kura. Ir-riżultati ma jiġux irrappurtati mill-isptar jew mir-reġjun f’data miftuħa. Kull min jaħdem fi kwalunkwe wieħed mir-reġjuni parteċipanti jista’ jikseb kredenzjali ta’ login u aċċess għal aktar data. "},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) in gespecialiseerde somatische poliklinische en intramurale zorg. Gegevens over 3 jaar op het niveau van zorgevenementen. De resultaten worden niet gerapporteerd door het ziekenhuis of de regio in open data. Iedereen die in een van de deelnemende regio's werkt, kan inloggegevens en toegang tot meer gegevens krijgen. "},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) w specjalistycznej ambulatoryjnej i szpitalnej opiece somatycznej. 3-letnie dane na poziomie wydarzenia związanego z opieką. Wyniki nie są zgłaszane przez szpital lub region w otwartych danych. Każdy, kto pracuje w dowolnym z uczestniczących regionów, może uzyskać dane logowania i dostęp do większej ilości danych. "},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) em cuidados ambulatórios somáticos especializados e em regime de internamento. Dados de 3 anos a nível do evento de prestação de cuidados. Os resultados não são relatados pelo hospital ou região em dados abertos. Qualquer pessoa que trabalhe em qualquer uma das regiões participantes pode obter credenciais de login e acesso a mais dados. "},{"@language":"ro-t-sv-t0-mtec","@value":"Costul per pacient (KPP) în asistența medicală somatică ambulatorie și spitalicească specializată. Date pe 3 ani la nivel de eveniment de îngrijire. Rezultatele nu sunt raportate de spital sau regiune în date deschise. Oricine lucrează în oricare dintre regiunile participante poate obține acreditări de conectare și acces la mai multe date. "},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) v špecializovanej somatickej ambulantnej a ústavnej starostlivosti. 3-ročné údaje na úrovni udalosti týkajúcej sa starostlivosti. Výsledky nie sú hlásené nemocnicou alebo regiónom v otvorených dátach. Ktokoľvek, kto pracuje v ktorejkoľvek zo zúčastnených oblastí, môže získať prihlasovacie údaje a prístup k ďalším údajom. "},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) v specializirani somatski ambulantni in bolnišnični oskrbi. 3-letni podatki na ravni dogodka oskrbe. Bolnišnica ali regija ne poroča o rezultatih v odprtih podatkih. Vsi, ki delajo v kateri koli od sodelujočih regij, lahko dobijo poverilnice za prijavo in dostop do več podatkov. "},{"@language":"sv","@value":"Kostnad per patient (KPP) inom specialiserad somatisk öppen- och slutenvård. Treårsdata på vårdhändelsenivå. Resultaten redovisas inte uppdelat på sjukhus eller region i öppna data. Den som arbetar i någon av de regioner som deltar kan få inloggningsuppgifter och tillgång till mer data. "},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість на одного пацієнта (KPP) у спеціалізованій соматичній амбулаторній та стаціонарній допомозі. 3-річні дані на рівні подій догляду. Результати не повідомляються лікарнею або регіоном у відкритих даних. Будь-хто, хто працює в будь-якому з регіонів-учасниць, може отримати облікові дані для входу та доступ до більшої кількості даних. "}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) — специализирани соматични амбулаторни и болнични грижи"},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) - specializovaná somatická ambulantní a lůžková péče"},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) – specialiseret somatisk ambulant behandling og indlæggelse"},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) - spezialisierte somatische ambulante und stationäre Versorgung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) - εξειδικευμένη σωματική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη"},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) - specialised somatic outpatient and inpatient care"},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP): atención somática especializada ambulatoria y hospitalaria"},{"@language":"et-t-sv-t0-mtec","@value":"Kulu patsiendi kohta (KPP) – spetsiaalne somaatiline ambulatoorne ja statsionaarne ravi"},{"@language":"fi-t-sv-t0-mtec","@value":"Kustannukset potilasta kohti - erikoistunut somaattinen avo- ja laitoshoito"},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) - soins somatiques ambulatoires et hospitaliers spécialisés"},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) - sainchúram othar seachtrach sómach agus othar cónaitheach"},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) – specijalizirana somatska ambulantna i bolnička skrb"},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) - speciális szomatikus járóbeteg- és fekvőbeteg-ellátás"},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) - assistenza somatica specialistica ambulatoriale e ospedaliera"},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos vienam pacientui (KPP) – specializuota somatinė ambulatorinė ir stacionarinė priežiūra"},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz pacientu (KPP) – specializētā somatiskā ambulatorā un stacionārā aprūpe"},{"@language":"mt-t-sv-t0-mtec","@value":"Kost għal kull pazjent (KPP) - kura speċjalizzata somatika outpatient u inpatient"},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) - gespecialiseerde somatische poliklinische en intramurale zorg"},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) - specjalistyczna somatyczna opieka ambulatoryjna i szpitalna"},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) - cuidados somáticos especializados em ambulatório e em regime de internamento"},{"@language":"ro-t-sv-t0-mtec","@value":"Cost per pacient (KPP) - asistență somatică specializată ambulatorie și spitalizare"},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) – špecializovaná somatická ambulantná a ústavná starostlivosť"},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) – specializirana somatska ambulantna in bolnišnična oskrba"},{"@language":"sv","@value":"Kostnad per patient (KPP) - specialiserad somatisk öppen- och slutenvård"},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість на одного пацієнта (KPP) - спеціалізована соматична амбулаторна та стаціонарна допомога"}]},{"@id":"http://data.europa.eu/88u/record/https-catalog-skl-se-store-1-resource-39~~1","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://catalog.skl.se/store/1/resource/39","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:08Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"20