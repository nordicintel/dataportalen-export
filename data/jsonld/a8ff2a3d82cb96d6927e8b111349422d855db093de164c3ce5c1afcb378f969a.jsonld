e":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/348","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:distribution":[{"@id":"https://catalog.skl.se/store/1/resource/350"},{"@id":"https://catalog.skl.se/store/1/resource/352"},{"@id":"https://catalog.skl.se/store/1/resource/354"}],"dcat:keyword":[{"@language":"sv","@value":"baskontoplan"},{"@language":"sv","@value":"bokföring"},{"@language":"sv","@value":"ekonomi"},{"@language":"sv","@value":"klassificeringssystem"},{"@language":"sv","@value":"normalkontoplan"},{"@language":"sv","@value":"redovisning"}],"dcat:landingPage":{"@id":"https://skr.se/skr/ekonomijuridik/ekonomi/redovisningbokforing/kommunbas.24254.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kommun-Bas är baskontoplanen för kommuner. Den baskontoplan som finns för näringslivet har alltid varit och är en förebild för Kommun-Bas. De olika kontoplanerna uppvisar likheter men också olikheter som bland annat förklaras av att redovisningen styrs av olika lagstiftningar, samt ett antal sektorspecifika förhållanden. SKR uppdaterar baskontoplanen i samverkan med en arbetsgrupp med representanter från ett antal kommuner och SCB. Det löpande underhållsarbetet innebär att kontoplanen får en årlig uppdatering och en ny version presenteras på SKR:s webbplats varje år. Den version som publiceras här avser räkenskapsåret 2025."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-05-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Kommun-Bas"}},{"@id":"https://catalog.skl.se/store/1/resource/349","@type":"http://entryscape.com/terms/File","dct:title":"Kommun-Bas-2025.xlsx"},{"@id":"https://catalog.skl.se/store/1/resource/350","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.skl.se/store/1/resource/349"},"dcat:downloadURL":{"@id":"https://catalog.skl.se/store/1/resource/349"},"dct:description":{"@language":"sv","@value":"Kommun-Bas är baskontoplanen för kommuner. Den baskontoplan som finns för näringslivet har alltid varit och är en förebild för Kommun-Bas. De olika kontoplanerna uppvisar likheter men också olikheter som bland annat förklaras av att redovisningen styrs av olika lagstiftningar, samt ett antal sektorspecifika förhållanden. SKR uppdaterar baskontoplanen i samverkan med en arbetsgrupp med representanter från ett antal kommuner och SCB. Det löpande underhållsarbetet innebär att kontoplanen får en årlig uppdatering och en ny version presenteras på SKR:s webbplats varje år."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-12T09:20:30.242Z"},"dct:rights":{"@id":"_:113c649e08e7df9381f6542c90fa3f559e60f2a073919813ddc4f5d6a5ca292b_b0n0"},"dct:title":{"@language":"sv","@value":"Kommun-Bas"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.skl.se/st