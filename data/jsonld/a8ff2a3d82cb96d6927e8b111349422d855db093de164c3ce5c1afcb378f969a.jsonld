cklat ett system för yrkesklassificering som indelningsgrund för anställda hos arbetsgivare som är medlemmar i Sveriges Kommuner och Landsting och Pacta. Systemet kallas arbetsidentifikation (AID) och började tillämpas 2008 och reviderades 2018."}},{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]},{"@id":"https://catalog.skl.se/store/1/resource/14","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:distribution":{"@id":"https://catalog.skl.se/store/1/resource/154"},"dcat:keyword":[{"@language":"sv","@value":"ansvar"},{"@language":"sv","@value":"arbetsidentifikation"},{"@language":"sv","@value":"etikett"},{"@language":"sv","@value":"förhandling"},{"@language":"sv","@value":"klassificeringssystem"},{"@language":"sv","@value":"lönebildning"},{"@language":"sv","@value":"löneläge"},{"@language":"sv","@value":"lönestatistik"},{"@language":"sv","@value":"lönestruktur"},{"@language":"sv","@value":"löneutveckling"}],"dcat:landingPage":{"@id":"https://skr.se/skr/arbetsgivarekollektivavtal/lonebildning/arbetsidentifikationaid.157.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR), AkademikerAlliansen, Kommunal, Offentliganställdas Förhandlingsråd (OFR) och Pacta har gemen