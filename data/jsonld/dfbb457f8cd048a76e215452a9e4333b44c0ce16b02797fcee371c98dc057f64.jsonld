ortal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://statistikdatabasen.scb.se/contactperson/1370","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":" Byggande och bebyggelse","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:byggande.bebyggelse@scb.se"}},{"@id":"https://statistikdatabasen.scb.se/dataset/TAB752","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://statistikdatabasen.scb.se/contactperson/1370"},"dcat:distribution":[{"@id":"https://statistikdatabasen.scb.se/distribution/en/TAB752"},{"@id":"https://statistikdatabasen.scb.se/distribution/sv/TAB752"}],"dcat:keyword":[{"@language":"en","@value":"Housing, construction and building"},{"@language":"en","@value":"Rents for dwellings"},{"@language":"en","@value":"Rents for rented dwellings 2003-2015"},{"@language":"sv","@value":"Boende, byggande och bebyggelse"},{"@language":"sv","@value":"Hyror i bostadslägenheter"},{"@language":"sv","@value":"Hyror m.m. för hyreslägenheter 2003-2015"}],"dcat:landingPage":[{"@id":"https://www.statistikdatabasen.scb.se/goto/en/ssd/Bhudef2ny"},{"@id":"https://www.statistikdatabasen.scb.se/goto/sv/ssd/Bhudef2ny"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021000837"},"dct:description":[{"@language":"en","@value":"Number of rented dwellings with tenancy by type of ownership, year of construction/valuation, year, annual rent and year"},{"@language":"sv","@value":"Antal lägenheter m