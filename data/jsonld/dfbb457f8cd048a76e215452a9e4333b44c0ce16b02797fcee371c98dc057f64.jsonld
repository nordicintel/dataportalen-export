gifter för dessa tjänster enligt principen om full kostnadstäckning, vilket innebär att avgiften ska motsvara den faktiska kostnaden för att producera och handlägga uppdraget. Avgiften bestäms av SCB i enlighet med avgiftsförordningen (1992:191) och myndighetens instruktion. Storleken på avgiften varierar beroende på uppdragets omfattning och komplexitet."},"dct:identifier":"2021000837","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":[{"@id":"mailto:https://www.scb.se/"},{"@id":"mailto:px@scb.se"}],"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB - Statistiska centralbyrån"},"foaf:page":{"@id":"https://www.scb.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset/scb"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset/scb"},{"@id":"https://www.dataportal.se/organisations/612_5672"},{"@id":"https://www.dataportal.se/organisations/612_5673"},{"@id":"https://www.dataportal.se/organisations/778_1b1c866785c22474e0adb68eec49a4b2"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://statistikdatabasen.scb.se/contactperson/2034","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Ann-Marie Karlsson","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ann-marie.karlsson@jordbruksverket.se"}},{"@id":"https://statistikdatabasen.scb.se/dataset/TAB1915","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://statistikdatabasen.scb.se/contactperson/2034"},"dcat:distribution":{"@id":"https://statistikdatabasen.scb.se/distribution/sv/TAB1915"},"dcat:keyword":[{"@language":"sv","@value":"Allmän jordbruksstatistik"},{"@language":"sv","@value":"Historisk statistik, trädgårdsodling"},{"@language":"sv","@value":"Jord- och skogsbruk, fiske"}],"dcat:landingPage":{"@id":"https://www.statistikdatabasen.scb.se/goto/sv/ssd/Kap2o5T01"},"dcat:t