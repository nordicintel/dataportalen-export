tt urval av nyckeltal som stöd gäller för Region Blekinges genomförande av Agenda 2030."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Agenda 2030"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/74","@type":"http://entryscape.com/terms/File","dct:title":"balans_och_resultaträkning.json"},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/75","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/74"},"dcat:downloadURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/74"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Resultat- och balansräkning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/76","@type":"http://entryscape.com/terms/File","dct:title":"Befolkning.json"},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/77","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/76"},"dcat:downloadURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/76"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Befolkning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/78","@type":"http://entryscape.com/terms/File","dct:title":"BRP.json"},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/78"},"dcat:downloadURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/78"},"dct:description":{"@language":"sv","@value":"Värdet av de ekonomiska aktiviteterna i samhället mäts traditionellt med hjälp av BNP och den regionala varianten av detta mått – BRP (bruttoregionprodukten). BNP/BRP säger dock inget om värdet av produktionen har lett till ökad livskvalitet för medborgarna.\n\nBNP/BRP säger heller inget om produktionen skett på ett sådant sätt att vi inte äventyrar kommande generationers möjlighet till välfärd. Därför har Tillväxtverket och Reglab Länk till annan webbplats, öppnas i nytt fönster. tagit fram BRP+, ett system som på ett sammanhållet sätt mäter regional utveckling ekonomiskt, miljömässigt och socialt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"BRP"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/80","@type":"http://entryscape.com/terms/File","dct:title":"finansiella_nyckeltal.json"},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/81","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/80"},"dcat:downloadURL":{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/80"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Finansiella nyckeltal"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.regionblekinge.se/store/2/resource/82","@t