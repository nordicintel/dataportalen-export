änds och utvecklas.\n\t\t"},"dct:issued":{"@type":"xsd:date","@value":"2025-09-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://www.statskontoret.se/datasets/dcat#agent1"},"dct:title":{"@language":"sv","@value":"Ord och begrepp inom ekonomisk styrning"},"https://www.w3.org/ns/dcat#contactPoint":{"@id":"https://www.statskontoret.se/datasets/dcat#org"},"https://www.w3.org/ns/dcat#theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}}],"@id":"urn:source:171f806c7c0c573d17ec26fc34e667bb5d7ca4f0af8738e2a479cace05c35dc6"},{"@graph":[{"@id":"https://www.statskontoret.se/datasets/dcat#agent1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":"Statskontoret"},{"@id":"https://www.statskontoret.se/datasets/dcat#dist2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.statskontoret.se/psidata/manadsutfall"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":"Filnedladdning i CSV-format","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/legalcode.sv"},"dct:title":{"@language":"se","@value":"Månadsutfall"}},{"@id":"https://www.statskontoret.se/datasets/dcat#ds1","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://www.statskontoret.se/datasets/dcat#dist2"},"dcat:keyword":["Statskontoret",{"@language":"sv","@value":"Anslag"},{"@language":"sv","@value":"Inkomster"},{"@language":"sv","@value":"Inkomsttitlar"},{"@language":"sv","@value":"Myndigheter"},{"@language":"sv","@value":"Skatter"},{"@language":"sv","@value":"Staten"},{"@language":"sv","@value":"Statens budget"},{"@language":"sv","@value":"Statsbidrag"},{"@language":"sv","@value":"Statsbudg