imental"}},{"@id":"https://catalog.tjorn.se/store/1/resource/28","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.tjorn.se/rowstore/dataset/b2f5a691-9114-4a39-80aa-5aa471315d04"},"dct:conformsTo":{"@id":"https://catalog.tjorn.se/rowstore/dataset/b2f5a691-9114-4a39-80aa-5aa471315d04/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://catalog.tjorn.se/store/1/resource/20"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.tjorn.se/rowstore/dataset/b2f5a691-9114-4a39-80aa-5aa471315d04/swagger"}},{"@id":"https://catalog.tjorn.se/store/1/resource/60","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Tjörns kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kommun@tjorn.se"}},{"@id":"https://catalog.tjorn.se/store/1/resource/9","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.tjorn.se/store/1/resource/60"},"dcat:distribution":[{"@id":"https://catalog.tjorn.se/store/1/resource/20"},{"@id":"https://catalog.tjorn.se/store/1/resource/28"}],"dcat:keyword":[{"@language":"sv","@value":"Tjörn Kommun"},{"@language":"sv","@value":"ambiductor AB"},{"@language":"sv","@value":"kubikmeter"},{"@language":"sv","@value":"vattenflöde"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Vattenmätare som registrerar vattenflöden hos kunder inom olika områden för kommunen.\n\nMätarens namn: Ambiductor W1h Vattenmätare  \nTillverkare: Ambiductor AB \nModell: W1h \nMätare storlek: DN20 \nMätarens längd: 190 mm \nMätområde: Q3 4.0 m3/h  \nMätprincip: Ultraljudsteknologi \nKommunikationsgränssnitt: LoRaWAN\nStrömförbrukning: Batteri \nMontering: Inline (rörmontering) \nÖvrig info: digital, inkl backventil \n\nData från vattenmätare i ett område hos kunder i kommunen, där informationen är anonymiserad för att säkerställa användarnas integritet och sekretess. Vattensensor Ambiductor W1h, som är konstruerad med senaste teknologin för att säkerställa en effektiv och pålitlig vattenmätning. Mätaren har en storlek på DN20 och har en längd på 190 mm, vilket gör den idealisk för inline-montering på vattenledningar. Den har ett imponerande mätområde på Q3 4.0 m3/h och använder sig av ultraljudsteknologi för att noggrant mäta vattenflödet. Dessutom är denna digitala vattenmätare utrustad med en inbyggd backventil för att säkerställa korrekt flödesriktning och förhindra eventuell återströmning."},"dct:issued":{"@type":"xsd:date","@value":"2023-09-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001306"},"dct:spatial":[{"@id":"_:1b33f71deddfea50f9be69562c5e17cbda35fce8a941256e10ca00668a768d25_b0n0"},{"@id":"https://sws.geonames.org/2668674"}],"dct:temporal":{"@id":"_:1b33f71deddfea50f9be69562c5e17cbda35fce8a941256e10ca00668a768d25_b1n0"},"dct:title":[{"@language":"en","@value":"Water flow"},{"@language":"sv","@value":"Vattenflöde"}]}],"@id":"urn:source:1b33f71deddfea50f9be69562c5e17cbda35fce8a941256e10ca00668a768d25"},{"@graph":[{"@id":"_:4bb274cc43d0fdb3f044d23feb816403f56f43a1844e6498d8fe2c0b312e63f6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.390172985776225 58.093038492935335,11.801798263349648 58.093038492935335,11.801798263349648 57.91685516218564,11.390172985776225 57.91685516218564,11.390172985776225 58.093038492935335))"}},{"@id":"_:4bb274cc43d0fdb3f044d23feb816403f56f43a1844e6498d8fe2c0b312e63f6_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-05-16"}},{"@id":"http://dataportal.se/organisation/SE2120001306","@type":"foaf:Agent","dct:identifier":"2120001306","