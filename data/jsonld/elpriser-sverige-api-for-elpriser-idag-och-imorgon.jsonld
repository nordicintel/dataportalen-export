e.rdf#dataset-exchanges"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-fcr"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-forecasts"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-grid"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-production"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Free electricity price API from Elpriser Sverige for today’s and tomorrow’s spot prices in all Swedish bidding zones: SE1, SE2, SE3 and SE4. Retrieve quarter-hour or hourly electricity prices as JSON or CSV without an API key. Tomorrow’s prices are shown after publication by the source. Available historical prices and additional power system data in JSON, including generation, load and trade, are also provided. Limit: 30 requests per minute per client IP. Requests read stored data without starting upstream collection. Check status, stale, dates and coverage; HTTP 200 does not guarantee complete or current data. An attribution link is required by the terms of use."},{"@language":"sv","@value":"Kostnadsfritt elpris-API från Elpriser Sverige för dagens och morgondagens spotpriser i alla svenska elområden: SE1, SE2, SE3 och SE4. Hämta elpriser per kvart eller timme i JSON eller CSV, utan API-nyckel. Morgondagens priser visas först när de har publicerats av källan. Tillgänglig elprishistorik ingår, liksom kompletterande elsystemdata i JSON om bland annat produktion, elbehov och handel. Högst 30 anrop per minut och klientadress. API-anrop läser sparat underlag och startar ingen källhämtning. Kontrollera status, stale, datum och täckning; HTTP 200 garanterar inte komplett eller aktuellt underlag. Tillbakalänk krävs enligt användningsvillkoren."}],"dct:format":"application/json","dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:title":[{"@language":"en","@value":"API for today’s and tomorrow’s electricity prices in Sweden"},{"@language":"sv","@value":"Elpris-API för dagens och morgondagens elpriser i Sverige"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Elpriser Sverige – RVSMR AB","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontaktadress"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lukas@fjong.io"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare","@type":["foaf:Agent","foaf:Organization"],"dct:description":[{"@language":"en","@value":"Publisher of Elpriser Sverige."},{"@language":"sv","@value":"Utgivare av Elpriser Sverige."}],"dct:identifier":"559071-9547","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:homepage":{"@id":"https://elprisersverige.nu/"},"foaf:name":{"@language":"sv","@value":"RVSMR AB"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}}],"@id":"urn:source:c34e92d9e32f8d3dda6a37a2880936caf3e56e429df600d264c399392ca90856"},{"@graph":[{"@id":"_:e92d5379a6c55ff9c00745a8a5ea3435dc14c172f1f7fe2fac36be00abd7d964_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.5935025 55.1370957, 24.1776850 55.1370957, 24.1776850 69.0599735, 10.5935025 69.0599735, 10.5935025 55.1370957))"},"dcat:centroid":{"@type":"http://www.opengis.net