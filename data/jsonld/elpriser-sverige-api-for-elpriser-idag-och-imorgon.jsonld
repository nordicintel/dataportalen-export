{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#katalog","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-balance"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-elpriser"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-exchanges"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-fcr"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-forecasts"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-grid"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-production"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:service":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"},"dcat:themeTaxonomy":{"@id":"http://publications.europa.eu/resource/authority/data-theme"},"dct:conformsTo":{"@id":"https://docs.dataportal.se/dcat/3.0.1/sv/"},"dct:description":[{"@language":"en","@value":"Find today’s and tomorrow’s electricity prices in Sweden through the free Elpriser Sverige API. The catalog describes quarter-hour and hourly spot prices for SE1–SE4 in JSON and CSV without an API key. Tomorrow’s prices become available after publication by the source. Available historical electricity prices and additional datasets about the Swedish power system are also included. Catalog metadata is provided under CC0 as required by DCAT-AP-SE. The API and its data are subject to separate terms requiring an attribution link."},{"@language":"sv","@value":"Hitta dagens och morgondagens elpriser i Sverige via Elpriser Sveriges kostnadsfria API. Katalogen beskriver spotpriser per kvart och timme för SE1–SE4 i JSON och CSV, utan API-nyckel. Morgondagens priser är tillgängliga efter publicering hos källan. Här finns även tillgänglig elprishistorik och kompletterande datamängder om det svenska elsystemet. Katalogens metadata tillhandahålls under CC0 enligt DCAT-AP-SE. API:t och dess data omfattas av separata användningsvillkor med obligatorisk tillbakalänk."}],"dct:issued":{"@type":"xsd:date","@value":"2026-10-07"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-07"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:spatial":{"@id":"http://publications.europa.eu/resource/authority/country/SWE"},"dct:title":[{"@language":"en","@value":"Elpriser Sverige – API for electricity prices today and tomorrow"},{"@language":"sv","@value":"Elpriser Sverige – API för elpriser idag och imorgon"}],"foaf:homepage":{"@id":"https://elprisersverige.nu/api"}}],"@id":"urn:source:27688381d6bb0d4cc4cc7e71ca1e41623a3f5b03b0c7550fa51a3ec2f0d0a4b7"},{"@graph":[{"@id":"_:289f8ff680d65e58b0c30a12a99668987bc850c33573db294da1949fa22e86a6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.5935025 55.1370957, 24.1776850 55.1370957, 24.1776850 69.0599735, 10.5935025 69.0599735, 10.5935025 55.1370957))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(15 62)"},"dct:source":[{"@id":"https://sws.geonames.org/2661886/"},{"@id":"https://www.openstreetmap.org/relation/52822"}]},{"@id":"https://elprisersverige.nu/api/v1/openapi.json","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"OpenAPI-beskrivning av API-anrop, parametrar, svar och fel."},"dct:title":{"@language":"sv","@value":"Elpriser Sveriges API-kontrakt v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:endpointDescription":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dcat:endpointURL":[{"@id":"https://elprisersverige.nu/api/v1/prices"},{"@id":"https://elprisersverige.nu/api/v1/system"}],"dcat:keyword":[{"@language":"en","@value":"electricity prices"},{"@language":"sv","@value":"elpriser"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api"},"dcat:servesDataset":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-balance"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-elpriser"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-exchanges"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-fcr"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-forecasts"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-grid"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-production"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Free electricity price API from Elpriser Sverige for today’s and tomorrow’s spot prices in all Swedish bidding zones: SE1, SE2, SE3 and SE4. Retrieve quarter-hour or hourly electricity prices as JSON or CSV without an API key. Tomorrow’s prices are shown after publication by the source. Available historical prices and additional power system data in JSON, including generation, load and trade, are also provided. Limit: 30 requests per minute per client IP. Requests read stored data without starting upstream collection. Check status, stale, dates and coverage; HTTP 200 does not guarantee complete or current data. An attribution link is required by the terms of use."},{"@language":"sv","@value":"Kostnadsfritt elpris-API från Elpriser Sverige för dagens och morgondagens spotpriser i alla svenska elområden: SE1, SE2, SE3 och SE4. Hämta elpriser per kvart eller timme i JSON eller CSV, utan API-nyckel. Morgondagens priser visas först när de har publicerats av källan. Tillgänglig elprishistorik ingår, liksom kompletterande elsystemdata i JSON om bland annat produktion, elbehov och handel. Högst 30 anrop per minut och klientadress. API-anrop läser sparat underlag och startar ingen källhämtning. Kontrollera status, stale, datum och täckning; HTTP 200 garanterar inte komplett eller aktuellt underlag. Tillbakalänk krävs enligt användningsvillkoren."}],"dct:format":"application/json","dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:title":[{"@language":"en","@value":"API for today’s and tomorrow’s electricity prices in Sweden"},{"@language":"sv","@value":"Elpris-API för dagens och morgondagens elpriser i Sverige"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:distribution":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-units-json"},"dcat:keyword":["RVSMR AB",{"@language":"sv","@value":"installerad effekt"},{"@language":"sv","@value":"produktionsenheter"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api#elsystem"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Latest stored ENTSO-E annual register with assets, EIC identifiers, production types, validity periods, generators and reported MW capacity. Conflicting reports yield capacityMW=null. Coverage is not all Swedish capacity and does not represent current generation."},{"@language":"sv","@value":"Senast sparade årsregister från ENTSO-E med anläggningar, EIC-identiteter, kraftslag, giltighetsperioder, generatorer och rapporterad effekt i MW. Motstridiga rapporterade värden ger capacityMW=null. Registertäckningen motsvarar inte hela Sveriges kapacitet och beskriver inte aktuell produktion."}],"dct:identifier":"elprisersverige:units","dct:issued":{"@type":"xsd:date","@value":"2026-10-06"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:source":{"@id":"https://transparency.entsoe.eu/"},"dct:spatial":[{"@id":"_:289f8ff680d65e58b0c30a12a99668987bc850c33573db294da1949fa22e86a6_b0n0"},{"@id":"http://publications.europa.eu/resource/authority/country/SWE"}],"dct:temporal":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#period-units"},"dct:title":[{"@language":"en","@value":"Installed capacity by generation unit"},{"@language":"sv","@value":"Installerad effekt per produktionsenhet"}],"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-units-json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"},"dcat:accessURL":{"@id":"https://elprisersverige.nu/api#elsystem"},"dct:description":[{"@language":"en","@value":"Data via the documented API. Select a bidding zone; price queries also accept dates. Check status, freshness and coverage."},{"@language":"sv","@value":"Underlag via API enligt dokumentationen. Välj elområde; prisfrågor kan också avgränsas med datum. Kontrollera status, aktualitet och täckning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:title":[{"@language":"en","@value":"Installed capacity by generation unit – JSON"},{"@language":"sv","@value":"Installerad effekt per produktionsenhet – JSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Elpriser Sverige – RVSMR AB","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontaktadress"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lukas@fjong.io"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare","@type":["foaf:Agent","foaf:Organization"],"dct:description":[{"@language":"en","@value":"Publisher of Elpriser Sverige."},{"@language":"sv","@value":"Utgivare av Elpriser Sverige."}],"dct:identifier":"559071-9547","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:homepage":{"@id":"https://elprisersverige.nu/"},"foaf:name":{"@language":"sv","@value":"RVSMR AB"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}}],"@id":"urn:source:289f8ff680d65e58b0c30a12a99668987bc850c33573db294da1949fa22e86a6"},{"@graph":[{"@id":"_:34f9d84058e478dfba2edd34f3cde44d46a14d81950e7ba614a2c15232e0a654_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.5935025 55.1370957, 24.1776850 55.1370957, 24.1776850 69.0599735, 10.5935025 69.0599735, 10.5935025 55.1370957))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(15 62)"},"dct:source":[{"@id":"https://sws.geonames.org/2661886/"},{"@id":"https://www.openstreetmap.org/relation/52822"}]},{"@id":"https://elprisersverige.nu/api/v1/openapi.json","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"OpenAPI-beskrivning av API-anrop, parametrar, svar och fel."},"dct:title":{"@language":"sv","@value":"Elpriser Sveriges API-kontrakt v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:endpointDescription":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dcat:endpointURL":[{"@id":"https://elprisersverige.nu/api/v1/prices"},{"@id":"https://elprisersverige.nu/api/v1/system"}],"dcat:keyword":[{"@language":"en","@value":"electricity prices"},{"@language":"sv","@value":"elpriser"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api"},"dcat:servesDataset":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-balance"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-elpriser"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-exchanges"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-fcr"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-forecasts"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-grid"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-production"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Free electricity price API from Elpriser Sverige for today’s and tomorrow’s spot prices in all Swedish bidding zones: SE1, SE2, SE3 and SE4. Retrieve quarter-hour or hourly electricity prices as JSON or CSV without an API key. Tomorrow’s prices are shown after publication by the source. Available historical prices and additional power system data in JSON, including generation, load and trade, are also provided. Limit: 30 requests per minute per client IP. Requests read stored data without starting upstream collection. Check status, stale, dates and coverage; HTTP 200 does not guarantee complete or current data. An attribution link is required by the terms of use."},{"@language":"sv","@value":"Kostnadsfritt elpris-API från Elpriser Sverige för dagens och morgondagens spotpriser i alla svenska elområden: SE1, SE2, SE3 och SE4. Hämta elpriser per kvart eller timme i JSON eller CSV, utan API-nyckel. Morgondagens priser visas först när de har publicerats av källan. Tillgänglig elprishistorik ingår, liksom kompletterande elsystemdata i JSON om bland annat produktion, elbehov och handel. Högst 30 anrop per minut och klientadress. API-anrop läser sparat underlag och startar ingen källhämtning. Kontrollera status, stale, datum och täckning; HTTP 200 garanterar inte komplett eller aktuellt underlag. Tillbakalänk krävs enligt användningsvillkoren."}],"dct:format":"application/json","dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:title":[{"@language":"en","@value":"API for today’s and tomorrow’s electricity prices in Sweden"},{"@language":"sv","@value":"Elpris-API för dagens och morgondagens elpriser i Sverige"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:distribution":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-load-outlook-json"},"dcat:keyword":["RVSMR AB",{"@language":"sv","@value":"elbehov"},{"@language":"sv","@value":"lastprognoser"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api#elsystem"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Latest stored ENTSO-E minimum and maximum load forecasts in MW per calendar day or week. UTC boundaries and Swedish calendar periods. Load forecasts, not price forecasts or statistical uncertainty intervals."},{"@language":"sv","@value":"Senast sparade ENTSO-E-prognoser för lägsta och högsta elbehov i MW per kalenderdag respektive vecka. Intervallens gränser anges i UTC; kalendern är svensk. Värdena är lastprognoser, inte prisprognoser eller osäkerhetsintervall."}],"dct:identifier":"elprisersverige:load-outlook","dct:issued":{"@type":"xsd:date","@value":"2026-10-06"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:source":{"@id":"https://transparency.entsoe.eu/"},"dct:spatial":[{"@id":"_:34f9d84058e478dfba2edd34f3cde44d46a14d81950e7ba614a2c15232e0a654_b0n0"},{"@id":"http://publications.europa.eu/resource/authority/country/SWE"}],"dct:temporal":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#period-load-outlook"},"dct:title":[{"@language":"en","@value":"Weekly and monthly electricity load forecasts"},{"@language":"sv","@value":"Vecko- och månadsprognoser för elbehov"}],"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-load-outlook-json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"},"dcat:accessURL":{"@id":"https://elprisersverige.nu/api#elsystem"},"dct:description":[{"@language":"en","@value":"Data via the documented API. Select a bidding zone; price queries also accept dates. Check status, freshness and coverage."},{"@language":"sv","@value":"Underlag via API enligt dokumentationen. Välj elområde; prisfrågor kan också avgränsas med datum. Kontrollera status, aktualitet och täckning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:title":[{"@language":"en","@value":"Weekly and monthly electricity load forecasts – JSON"},{"@language":"sv","@value":"Vecko- och månadsprognoser för elbehov – JSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Elpriser Sverige – RVSMR AB","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontaktadress"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lukas@fjong.io"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare","@type":["foaf:Agent","foaf:Organization"],"dct:description":[{"@language":"en","@value":"Publisher of Elpriser Sverige."},{"@language":"sv","@value":"Utgivare av Elpriser Sverige."}],"dct:identifier":"559071-9547","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:homepage":{"@id":"https://elprisersverige.nu/"},"foaf:name":{"@language":"sv","@value":"RVSMR AB"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}}],"@id":"urn:source:34f9d84058e478dfba2edd34f3cde44d46a14d81950e7ba614a2c15232e0a654"},{"@graph":[{"@id":"_:596dac5cc20b0e34d6b60aca25fd1d9995aa6e2f1e98f1edd737f2bd55126cd0_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.5935025 55.1370957, 24.1776850 55.1370957, 24.1776850 69.0599735, 10.5935025 69.0599735, 10.5935025 55.1370957))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(15 62)"},"dct:source":[{"@id":"https://sws.geonames.org/2661886/"},{"@id":"https://www.openstreetmap.org/relation/52822"}]},{"@id":"https://elprisersverige.nu/api/v1/openapi.json","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"OpenAPI-beskrivning av API-anrop, parametrar, svar och fel."},"dct:title":{"@language":"sv","@value":"Elpriser Sveriges API-kontrakt v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:endpointDescription":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dcat:endpointURL":[{"@id":"https://elprisersverige.nu/api/v1/prices"},{"@id":"https://elprisersverige.nu/api/v1/system"}],"dcat:keyword":[{"@language":"en","@value":"electricity prices"},{"@language":"sv","@value":"elpriser"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api"},"dcat:servesDataset":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-balance"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-elpriser"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-exchanges"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-fcr"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-forecasts"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-grid"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-load-outlook"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-production"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Free electricity price API from Elpriser Sverige for today’s and tomorrow’s spot prices in all Swedish bidding zones: SE1, SE2, SE3 and SE4. Retrieve quarter-hour or hourly electricity prices as JSON or CSV without an API key. Tomorrow’s prices are shown after publication by the source. Available historical prices and additional power system data in JSON, including generation, load and trade, are also provided. Limit: 30 requests per minute per client IP. Requests read stored data without starting upstream collection. Check status, stale, dates and coverage; HTTP 200 does not guarantee complete or current data. An attribution link is required by the terms of use."},{"@language":"sv","@value":"Kostnadsfritt elpris-API från Elpriser Sverige för dagens och morgondagens spotpriser i alla svenska elområden: SE1, SE2, SE3 och SE4. Hämta elpriser per kvart eller timme i JSON eller CSV, utan API-nyckel. Morgondagens priser visas först när de har publicerats av källan. Tillgänglig elprishistorik ingår, liksom kompletterande elsystemdata i JSON om bland annat produktion, elbehov och handel. Högst 30 anrop per minut och klientadress. API-anrop läser sparat underlag och startar ingen källhämtning. Kontrollera status, stale, datum och täckning; HTTP 200 garanterar inte komplett eller aktuellt underlag. Tillbakalänk krävs enligt användningsvillkoren."}],"dct:format":"application/json","dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:title":[{"@language":"en","@value":"API for today’s and tomorrow’s electricity prices in Sweden"},{"@language":"sv","@value":"Elpris-API för dagens och morgondagens elpriser i Sverige"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-elpriser","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:distribution":[{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-elpriser-csv"},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-elpriser-json"}],"dcat:keyword":["RVSMR AB",{"@language":"sv","@value":"SE1"},{"@language":"sv","@value":"SE2"},{"@language":"sv","@value":"SE3"},{"@language":"sv","@value":"SE4"},{"@language":"sv","@value":"elpris"},{"@language":"sv","@value":"elpris-API"},{"@language":"sv","@value":"elpriser idag"},{"@language":"sv","@value":"elpriser imorgon"},{"@language":"sv","@value":"kvartspris"},{"@language":"sv","@value":"spotpris"},{"@language":"sv","@value":"timpris"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api#anrop"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Today’s and tomorrow’s electricity prices in Sweden through a free API without an API key. Retrieve spot prices for bidding zones SE1, SE2, SE3 and SE4 as JSON or CSV, at quarter-hour or hourly resolution. Tomorrow’s electricity prices become available after publication by the source; these are auction results, not price forecasts. Available historical electricity prices are also included. Original day-ahead prices come from ENTSO-E in EUR/MWh. Optional SEK/kWh reference conversion uses the latest ECB business-day rate dated D−2 or earlier, at most ten days back. Excludes VAT, taxes, grid fees and supplier charges. Native quarter-hour or hourly intervals; hourly aggregation is available. UTC intervals are grouped by Europe/Stockholm calendar days. Maximum 31 days per request. The archive is being backfilled; consult /api/v1/areas and each day’s status. The earliest allowed query date in 2015 is not a claim of historical coverage."},{"@language":"sv","@value":"Dagens och morgondagens elpriser i Sverige via ett kostnadsfritt API utan API-nyckel. Hämta spotpriser för elområdena SE1, SE2, SE3 och SE4 som JSON eller CSV, per kvart eller timme. Morgondagens elpriser blir tillgängliga först när de har publicerats av källan; de är auktionerade priser, inte prisprognoser. API:t innehåller även tillgänglig elprishistorik. Ursprungliga dagenförepriser kommer från ENTSO-E och anges i EUR/MWh. Valfri referensomräkning till SEK/kWh använder ECB-kurs från senaste bankdag D−2 eller tidigare, högst tio dagar bakåt. Priserna är exklusive moms, energiskatt, nätavgifter och elhandlarens påslag. Källans kvart- eller timintervall bevaras; timaggregering kan väljas. UTC-intervall grupperas efter svensk kalenderdag i Europe/Stockholm. Högst 31 dagar per anrop. Arkivet fylls på; kontrollera faktisk täckning i /api/v1/areas och status för varje dygn. 2015 är en tillåten frågegräns, inte ett löfte om tillgänglig historik."}],"dct:identifier":"elprisersverige:elpriser","dct:issued":{"@type":"xsd:date","@value":"2026-10-05"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:relation":[{"@id":"https://elprisersverige.nu/api/v1/areas"},{"@id":"https://elprisersverige.nu/api/v1/status"}],"dct:source":[{"@id":"https://data.ecb.europa.eu/"},{"@id":"https://transparency.entsoe.eu/"}],"dct:spatial":[{"@id":"_:596dac5cc20b0e34d6b60aca25fd1d9995aa6e2f1e98f1edd737f2bd55126cd0_b0n0"},{"@id":"http://publications.europa.eu/resource/authority/country/SWE"}],"dct:temporal":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#period-elpriser"},"dct:title":[{"@language":"en","@value":"Electricity prices today and tomorrow in Sweden – spot prices in SE1–SE4"},{"@language":"sv","@value":"Elpriser idag och imorgon i Sverige – spotpriser i SE1–SE4"}],"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-elpriser-csv","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#api-v1"},"dcat:accessURL":{"@id":"https://elprisersverige.nu/api#anrop"},"dct:description":[{"@language":"en","@value":"Prices via API. Select area and dates as documented. CSV omits stale, dataVersion and full coverage metadata; use JSON for quality checks."},{"@language":"sv","@value":"Prisunderlag via API. Välj område och datum enligt guiden. CSV innehåller inte JSON-fälten stale, dataVersion eller fullständig täckningsmetadata; använd JSON för kvalitetskontroll."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:title":[{"@language":"en","@value":"Electricity prices today and tomorrow in Sweden – spot prices in SE1–SE4 – CSV"},{"@language":"sv","@value":"Elpriser idag och imorgon i Sverige – spotpriser i SE1–SE4 – CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-elpriser-json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution