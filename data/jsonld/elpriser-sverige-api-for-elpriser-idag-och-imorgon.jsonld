ige.nu/dcat-ap-se.rdf#dataset-units"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Free electricity price API from Elpriser Sverige for today’s and tomorrow’s spot prices in all Swedish bidding zones: SE1, SE2, SE3 and SE4. Retrieve quarter-hour or hourly electricity prices as JSON or CSV without an API key. Tomorrow’s prices are shown after publication by the source. Available historical prices and additional power system data in JSON, including generation, load and trade, are also provided. Limit: 30 requests per minute per client IP. Requests read stored data without starting upstream collection. Check status, stale, dates and coverage; HTTP 200 does not guarantee complete or current data. An attribution link is required by the terms of use."},{"@language":"sv","@value":"Kostnadsfritt elpris-API från Elpriser Sverige för dagens och morgondagens spotpriser i alla svenska elområden: SE1, SE2, SE3 och SE4. Hämta elpriser per kvart eller timme i JSON eller CSV, utan API-nyckel. Morgondagens priser visas först när de har publicerats av källan. Tillgänglig elprishistorik ingår, liksom kompletterande elsystemdata i JSON om bland annat produktion, elbehov och handel. Högst 30 anrop per minut och klientadress. API-anrop läser sparat underlag och startar ingen källhämtning. Kontrollera status, stale, datum och täckning; HTTP 200 garanterar inte komplett eller aktuellt underlag. Tillbakalänk krävs enligt användningsvillkoren."}],"dct:format":"application/json","dct:license":{"@id":"https://elprisersverige.nu/api#villkor"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:title":[{"@language":"en","@value":"API for today’s and tomorrow’s electricity prices in Sweden"},{"@language":"sv","@value":"Elpris-API för dagens och morgondagens elpriser i Sverige"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://elprisersverige.nu/kontakt"}},{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#dataset-balance","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#kontakt"},"dcat:distribution":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#distribution-balance-json"},"dcat:keyword":["RVSMR AB",{"@language":"sv","@value":"balansläge"},{"@language":"sv","@value":"obalansvolym"}],"dcat:landingPage":{"@id":"https://elprisersverige.nu/api#elsystem"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:conformsTo":{"@id":"https://elprisersverige.nu/api/v1/openapi.json"},"dct:description":[{"@language":"en","@value":"Latest stored ENTSO-E balancing state in MW per minute and imbalance volume in MWh per quarter-hour. Direction A01/A02 and periods are retained. Delays, nulls and missing coverage must be handled explicitly and never treated as zero."},{"@language":"sv","@value":"Senast sparade ENTSO-E-uppgifter om balansläge i MW per minut och obalansvolym i MWh per kvart. Riktning A01/A02 och period bevaras. Fördröjningar, null och saknad täckning ska hanteras uttryckligen och får inte tolkas som noll."}],"dct:identifier":"elprisersverige:balance","dct:issued":{"@type":"xsd:date","@value":"2026-10-06"},"dct:publisher":{"@id":"https://elprisersverige.nu/dcat-ap-se.rdf#utgivare"},"dct:source":{"@id":"https://transparency.entsoe.eu/"},"dct:spatial":[{"@id":"_:5cba9834558f4f7b7cfd910974a16804bbaaa606d67cfd7cdca8e6ddf7725b2d_b0n0"},{"@id":"http://publications.europa.eu/resource/authority/country/SWE"}],