heter och företag i Västsverige"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/83","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://www.vastsverige.com/api/categories/"},{"@id":"https://www.vastsverige.com/api/configurations/"},{"@id":"https://www.vastsverige.com/api/detail/"},{"@id":"https://www.vastsverige.com/api/get/"},{"@id":"https://www.vastsverige.com/api/image/"}],"dct:description":{"@language":"sv","@value":"Information om evenemang, sevärdheter och företag i Västsverige"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-sa/4.0/"},"dct:title":{"@language":"en","@value":"Evenemang, sevärdheter och företag i Västsverige"},"foaf:page":[{"@id":"https://vgregion.entryscape.net/store/7/resource/84"},{"@id":"https://www.vastsverige.com/swagger/ui/index"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/84","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Turistrådet Västsveriges API dokumentation"},"dct:title":{"@language":"sv","@value":"Turistrådet Västsveriges API dokumentation"}}],"@id":"urn:source:3a21707fc01d69a1f24d9f84eede4f9d4ff789cab1059e057ad89fc661abab1e"},{"@graph":[{"@id":"https://vgregion.entryscape.net/store/7/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://vgregion.entryscape.net/store/7/resource/104"},{"@id":"https://vgregion.entryscape.net/store/7/resource/11"},{"@id":"https://vgregion.entryscape.net/store/7/resource/110"},{"@id":"https://vgregion.entryscape.net/store/7/resource/115"},{"@id":"https://vgregion.entryscape.net/store/7/resource/125"},{"@id":"https://vgregion.entryscape.net/store/7/resource/131"},{"@id":"https://vgregion.entryscape.net/store/7/resource/141"