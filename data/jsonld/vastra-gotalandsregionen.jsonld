{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:0d7111577b430e0c853d6d224cbe8db52b69289b78911391612c7490892eeb95_b0n0","@type":"http://schema.org/Offer","http://schema.org/description":{"@language":"sv","@value":"Avgiftsfri"},"http://schema.org/mainEntityOfPage":{"@id":"https://www.creativecommons.se/"}},{"@id":"http://dataportal.se/organisation/SE2321000131","@type":"foaf:Agent","dct:identifier":"2321000131","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.nilsson@vgregion.se"},"foaf:name":{"@language":"sv","@value":"Västra Götalandsregionen"},"foaf:page":{"@id":"https://www.vgregion.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"http://dataportal.se/organisation/vgr"},{"@id":"https://vgregion.entryscape.net/store/7/resource/1"}]},{"@id":"http://dataportal.se/organisation/vgr","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:name":[{"@language":"en","@value":"Västra Götaland Regional Council OLD"},{"@language":"sv","@value":"Västra Götalandsregionen GAMMAL"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/141","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://vgregion.entryscape.net/store/7/resource/150"},"dcat:distribution":[{"@id":"https://vgregion.entryscape.net/store/7/resource/177"},{"@id":"https://vgregion.entryscape.net/store/7/resource/180"}],"dcat:keyword":[{"@language":"sv","@value":"Datadelning"},{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"},{"@language":"sv","@value":"Öppna data"}],"dcat:landingPage":{"@id":"https://www.vgregion.se/dataverkstad"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:description":{"@language":"sv","@value":"Den nationella dataverkstaden för regional och kommunal datadelning, som samordnas av Västra Götalandsregionen, har kartlagt vilka regioner och kommuner i Sverige som publicerar öppna data. \n\nKartläggningen har genomförts genom att söka efter öppna datamängder på respektive organisations hemsida samt på Sveriges dataportal, www.dataportal.se.\n\nFörsta publiceringen genomfördes i juni 2023. Målsättningen är att denna data ska uppdateras löpande, med ett intervall om 6 månader."},"dct:issued":{"@type":"xsd:date","@value":"2024-10-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Regioner och kommuner som publicerar öppna data"},"http://schema.org/offers":{"@id":"_:0d7111577b430e0c853d6d224cbe8db52b69289b78911391612c7490892eeb95_b0n0"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/150","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Fredrik Eriksson, projektledare för nationell dataverkstad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fredrik.c.eriksson@vgregion.se"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/176","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Publicerande regioner och kommuner oktober 2024 - publicerad dataportal.csv"},{"@id":"https://vgregion.entryscape.net/store/7/resource/177","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vgregion.entryscape.net/store/7/resource/176"},"dcat:downloadURL":{"@id":"https://vgregion.entryscape.net/store/7/resource/176"},"dct:description":{"@language":"sv","@value":"Datamängden beskriver vilka regioner och kommuner som publicerar öppna data. Datamängden innehåller fem fält; \n#1. Organization = Organisationens namn i klartext\n#2. Region = Vilken region (läs län) som organisationen tillhör i klartext\n#3. Publishing_Open_Data = Om en organisation publicerar öppna data anges TRUE, i annat fall anges FALSE\n#4. Exist_On_National_Dataportal = Om den publicerade datan även finns länkad till den nationella dataportalen\n#5. Link_To_Open_Data_Web = Länksökvägen till organisationens öppna datasida (även kallad PSIDATA-sida)\n#6. Comment = Eventuella kommentarer som är relevanta i sammanhanget."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-28T10:38:04.617Z"},"dct:title":{"@language":"sv","@value":"Regioner och kommuner som publicerar öppna data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/180","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://vgregion.entryscape.net/rowstore/dataset/105d0e07-d206-40f3-90d5-0e6691b7d1cf"},"dct:conformsTo":{"@id":"https://vgregion.entryscape.net/rowstore/dataset/105d0e07-d206-40f3-90d5-0e6691b7d1cf/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-28T10:38:22.839Z"},"dct:source":{"@id":"https://vgregion.entryscape.net/store/7/resource/177"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://vgregion.entryscape.net/rowstore/dataset/105d0e07-d206-40f3-90d5-0e6691b7d1cf/swagger"}}],"@id":"urn:source:0d7111577b430e0c853d6d224cbe8db52b69289b78911391612c7490892eeb95"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000131","@type":"foaf:Agent","dct:identifier":"2321000131","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.nilsson@vgregion.se"},"foaf:name":{"@language":"sv","@value":"Västra Götalandsregionen"},"foaf:page":{"@id":"https://www.vgregion.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"http://dataportal.se/organisation/vgr"},{"@id":"https://vgregion.entryscape.net/store/7/resource/1"}]},{"@id":"http://dataportal.se/organisation/vgr","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:name":[{"@language":"en","@value":"Västra Götaland Regional Council OLD"},{"@language":"sv","@value":"Västra Götalandsregionen GAMMAL"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/11","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://vgregion.entryscape.net/store/7/resource/55"},"dcat:keyword":[{"@language":"en","@value":"Accessibility"},{"@language":"sv","@value":"Tillgänglighet"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"\nWhilst many people want to play an active part in community life and take advantage of what society has to offer, not everyone has the same opportunity to do so.\n\nThe aim of TD – the accessibility database – is that every establishment, service or space is described sufficiently well to make it easy for you to decide if you want to visit it or not. See https://www.t-d.se/ for more information."},{"@language":"sv","@value":"Tillgänglighetsdatabasen (TD) är idag den enda databas i Sverige som erbjuder information till invånare och besökare om fysisk tillgänglighet i vardagen. TD ägs, driftas och utvecklas av Västra Götalandsregionen. Mer information finns på https://www.t-d.se/."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:source":{"@id":"https://vgregion.entryscape.net/store/7/resource/11"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"The Accessibility Database (TD)"},{"@language":"sv","@value":"Tillgänglighetsdatabasen (TD)"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/55","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://td.portal.azure-api.net/"},"dct:description":[{"@language":"en","@value":"\nWhilst many people want to play an active part in community life and take advantage of what society has to offer, not everyone has the same opportunity to do so.\n\nThe aim of TD – the accessibility database – is that every establishment, service or space is described sufficiently well to make it easy for you to decide if you want to visit it or not. See https://www.t-d.se/ for more information."},{"@language":"sv","@value":"Tillgänglighetsdatabasen (TD) är idag den enda databas i Sverige som erbjuder information till invånare och besökare om fysisk tillgänglighet i vardagen. TD ägs, driftas och utvecklas av Västra Götalandsregionen. Mer information finns på https://www.t-d.se/."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"The Accessibility Database"},{"@language":"sv","@value":"Tillgänglighetsdatabasen (TD)"}],"foaf:page":{"@id":"https://td.portal.azure-api.net/"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}}],"@id":"urn:source:156fae823148f4f2baa4801502c37d7c1a01cfffda61c1cf299a42af4a97b8db"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000131","@type":"foaf:Agent","dct:identifier":"2321000131","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.nilsson@vgregion.se"},"foaf:name":{"@language":"sv","@value":"Västra Götalandsregionen"},"foaf:page":{"@id":"https://www.vgregion.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"http://dataportal.se/organisation/vgr"},{"@id":"https://vgregion.entryscape.net/store/7/resource/1"}]},{"@id":"http://dataportal.se/organisation/vgr","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:name":[{"@language":"en","@value":"Västra Götaland Regional Council OLD"},{"@language":"sv","@value":"Västra Götalandsregionen GAMMAL"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/110","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"https://vgregion.entryscape.net/store/7/resource/112"},{"@id":"https://vgregion.entryscape.net/store/7/resource/114"},{"@id":"https://vgregion.entryscape.net/store/7/resource/124"}],"dcat:keyword":[{"@language":"sv","@value":"Inkubator"},{"@language":"sv","@value":"Inkubatorer"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"En inkubator har till uppgift att underlätta för nystartade tillväxt- och kunskapsföretag genom rådgivning, hjälp med patent, finansiering med mera.\n\nDenna datamängd innehåller en sammanställning över inkubatorer i Västra Götaland. De uppgifter som finns om respektive verksamhet är: namn, adress, koordinater och URL. Koordinater i SWEREF 99 TM."},"dct:issued":{"@type":"xsd:date","@value":"2023-03-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:spatial":{"@id":"https://sws.geonames.org/3337386"},"dct:title":{"@language":"sv","@value":"Inkubatorer"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/111","@type":"http://entryscape.com/term