File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Leverantörsfaktura 202607"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/279","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Leverantörsfaktura 202608"}}],"@id":"urn:source:e0027b49d9a674816e8804cfa30aaf003086405f1b64a8c8c59560254987b16d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000131","@type":"foaf:Agent","dct:identifier":"2321000131","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.nilsson@vgregion.se"},"foaf:name":{"@language":"sv","@value":"Västra Götalandsregionen"},"foaf:page":{"@id":"https://www.vgregion.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"http://dataportal.se/organisation/vgr"},{"@id":"https://vgregion.entryscape.net/store/7/resource/1"}]},{"@id":"http://dataportal.se/organisation/vgr","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:name":[{"@language":"en","@value":"Västra Götaland Regional Council OLD"},{"@language":"sv","@value":"Västra Götalandsregionen GAMMAL"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/69","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Fredrik Eriksson, Regional samordnare av öppna data","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:fredrik.c.eriksson@vgregion.se"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/70","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://vgregion.entryscape.net/store/7/resource/69"},"dcat:distribution":{"@id":"https://vgregion.entryscape.net/store/7/resource/72"},"dcat:keyword":[{"@language":"sv","@value":"datamängder"},{"@language":"sv","@value":"kandidater"},{"@language":"sv","@value":"öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:description":{"@language":"sv","@value":"Inventeringsunderlaget innehåller en lista på 50 öppna datamängder som efterfrågats i det så kallade ÖDIS-projektet (Stockholm). Den ursprungliga listan har analyserats, städats och konkretiserats ytterligare till sin nuvarande utformning. Inventeringsunderlaget används för att kartlägga Västra Götalandskommunernas intresse av att tillgängliggöra informationsmängderna som öppna data. Resultatet kommer att ligga till grund för våra kommande regionala öppna data-projekt."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:title":{"@language":"sv","@value":"Inventeringsunderlag öppna datamängder"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/71","@type":"http://entryscape.com/terms/File","dct:format":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","dct:title":"Inventeringsunderlag intressanta datamängder - Publicerad portal.xlsx"},{"@id":"https://vgregion.entryscape.net/store/7/resource/72","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vgregion.entryscape.net/store/7/resource/71"},"dcat:downloadURL":{"@id":"https://vgregion.entryscape.net/store/7/resource/71"},"dct:description":{"@language":"sv","@value":"Inventeringsunderlag januari 2021"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2021-01-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-02-01T16:34:39+01:00"},"dct:title":{"@language":"sv","@value":"Lista på potentiella öppna datamängder"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:e03fbf0a05cdd943378a55ee3d5a2473f9a2450424ab95283db92ff97fbd06c0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000131","@type":"foaf:Agent","dct:identifier":"2321000131","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.nilsson@vgregion.se"},"foaf:name":{"@language":"sv","@value":"Västra Götalandsregionen"},"foaf:page":{"@id":"https://www.vgregion.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"http://dataportal.se/organisation/vgr"},{"@id":"https://vgregion.entryscape.net/store/7/resource/1"}]},{"@id":"http://dataportal.se/organisation/vgr","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:name":[{"@language":"en","@value":"Västra Götaland Regional Council OLD"},{"@language":"sv","@value":"Västra Götalandsregionen GAMMAL"}]},{"@id":"https://vgregion.entryscape.net/store/7/resource/36","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"https://vgregion.entryscape.net/store/7/resource/38"},{"@id":"https://vgregion.entryscape.net/store/7/resource/40"},{"@id":"https://vgregion.entryscape.net/store/7/resource/52"}],"dcat:keyword":[{"@language":"en","@value":"Hospital"},{"@language":"sv","@value":"Sjukhus"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Compilation of hospitals in Västra Götaland. The data set contains id,  hospital name, street name, street number, postal code, postal code area, owner, hospital group, x coordinate and y coordinate.\n\nThe addresses are visital addresses. The spatial reference system is SWEREF 99 TM (EPSG:3006)."},{"@language":"sv","@value":"Sammanställning över sjukhus i Västra Götaland. Datamängden innehåller id, sjukhusets namn, gatunamn, gatunummer, postnummer, postort, ägare, sjukhusgrupp, x-koordinat och y-koordinat.\n\nAdressinforma