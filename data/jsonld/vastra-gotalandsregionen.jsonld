/ns#hasEmail":{"@id":"mailto:mattias@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/2","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Eric Hjelmestam","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:e0027b49d9a674816e8804cfa30aaf003086405f1b64a8c8c59560254987b16d_b2n0"},{"@id":"_:e0027b49d9a674816e8804cfa30aaf003086405f1b64a8c8c59560254987b16d_b3n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:eric@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Matthias Palmér","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matthias@metasolutions.se"}},{"@id":"https://lankadedata.se/spec/levreskontra/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Leverantörsreskontra"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/181","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"https://vgregion.entryscape.net/store/7/resource/183"},{"@id":"https://vgregion.entryscape.net/store/7/resource/185"},{"@id":"https://vgregion.entryscape.net/store/7/resource/241"},{"@id":"https://vgregion.entryscape.net/store/7/resource/243"},{"@id":"https://vgregion.entryscape.net/store/7/resource/254"},{"@id":"https://vgregion.entryscape.net/store/7/resource/268"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller grundläggande information om de leverantörsfakturor som inkommit till Västra Götalandsregionens förvaltningar.\n\nI datamängden finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av och begära ut den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare eller privatperson och att namn och organisationsnummer kan omfattas av bestämmelserna i den allmänna dataskyddsförordningen.\n\nVästra Götalandsregionens öppna data-initiativ var under uppbyggnad 2024 och därför finns inte samtliga regionens förvaltningar representerade i den data som publiceras för 2024."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000131"},"dct:temporal":{"@id":"_:e0027b49d9a674816e8804cfa30aaf003086405f1b64a8c8c59560254987b16d_b4n0"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://vgregion.entryscape.net/store/7/resource/183","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://vgregion.entryscape.net/store/7/resource/271"},{"@id":"https://vgregion.entryscape.net/store/7/resourc