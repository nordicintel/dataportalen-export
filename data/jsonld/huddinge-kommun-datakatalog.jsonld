ekt_p_fritid_skidanl","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Skidanläggning"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:4cce1c6f13c28214c05ae2f13b1b8cd9d1f84f27c2d0d525f793a42a4ceab666_b0n0"}}],"@id":"urn:source:4cce1c6f13c28214c05ae2f13b1b8cd9d1f84f27c2d0d525f793a42a4ceab666"},{"@graph":[{"@id":"_:4ecec3f6e447b65b484a4f996bd30528f51db2c7d6ac081ddc0180ee627b4cd7_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3","@type":"foaf:Agent","foaf:name":{"@language":"en","@value":"KSF Strategiska enheten"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/567","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stockholms universitet"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/569","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/611"},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/6"}],"dcat:distribution":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/572"},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/573"},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/574"}],"dcat:keyword":[{"@language":"sv","@value":"Biotop"},{"@language":"sv","@value":"Ekosystem tjänster"},{"@language":"sv","@value":"Gröna infrastruktur"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:creator":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/567"},"dct:description":{"@language":"sv","@value":"BIOTOP Stockholms klassificeringssystem har utgått från Stockholms stads befintliga biotopdatabas (Miljöförvaltning, 2012). För att passa en modern och kostnadseffektiv karteringsmetod och det ökade fokuset på den urbana miljön har systemet modifierats och vidareutvecklats. Metoden är under fortsatt uppbyggnad varför dess klassificeringssystem och övrig hörande dokumentation är ett levande dokument. BIOTOP Stockholm innehåller två hierarkiska nivåer, (huvudklasser och biotoper), samt en rad beskrivande tilläggsattribut som på olika sätt förtydligar databasens innehåll och egenskaper."},"dct:identifier":"ds_su_biotopdatabasen_y_huvudklass","dct:issued":{"@type":"xsd:date","@value":"2020"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},"dct:title":{"@language":"sv","@value":"Biotopdatabas - huvudklasser"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:4ecec3f6e447b65b484a4f996bd30528f51db2c7d6ac081ddc0180ee627b4cd7_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/572","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?layers=cartesia-lmvtopodim-direkt+theme-biotopdatabas_huvudklasser"},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddi