/115"},"dcat:keyword":{"@language":"sv","@value":"simhall"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Inomhus\nAnläggning för fritid, träning eller tävling. Avser byggnad med utformning för motionssim, simidrotter, simskola, allmänhetens badande samt ofta olika rehabfunktioner. Storlek på huvudbassäng och eventuell möjlighet till simhopp anges liksom eventuell publikkapacitet.\n\nUtomhus\nUtomhusbassäng(er) öppna för allmänheten hela eller delar av året. Storlek på huvudbassäng och eventuell möjlighet till simhopp anges liksom eventuell publikkapacitet."},"dct:identifier":"ds_kuf_kultur_fritidsobjekt_p_fritid_simanl","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Simanläggning"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:b650a327dc8a9b37bdc122b63e3b7f79e51c5c53a1d39eef61bc9a86a9f7b687_b0n0"}}],"@id":"urn:source:b650a327dc8a9b37bdc122b63e3b7f79e51c5c53a1d39eef61bc9a86a9f7b687"},{"@graph":[{"@id":"_:b6ddde8f27120bbf3386f9cb52ae088684d159a0e029afd6b7434ae04283b60a_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Kultur- och fritidsförvaltningen"},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kultur- och fritidsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kulturfritid@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/203","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Lokal som nyttjas kontinuerligt av företag, grupper av utövare och/eller föreningar, för framställning av konst inom alla genrer, ex bild och form, slöjd, hantverk, dans, film mm, undantaget musik (som karteras under kategorin \"Musikstudio/replokal\"). Avser ej mindre faciliteter, ex bild- eller slöjdsal i skola eller fritidsverksamhet, och heller ej enskilda ateljéer i privatbostad el annat som kan innehålla uppgifter som kan spåras till enskild person."},"dct:identifier":"ds_kuf_kultur_fritidsobjekt_p_kultur_konstnarlig_prod","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Konstnärlig produktionsplats/ateljé"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:b6ddde8f27120bbf3386f9cb52ae088684d159a0e029afd6b7434ae04283b60a_b0n0"}}],"@id":"urn:source:b6ddde8f27120bbf3386f9cb52ae088684d159a0e029afd6b7434ae04283b60a"},{"@graph":[{"@id":"_:b767a8b5a1113568e1f3302da0eedefcf41631509ccdaadaf667a95b6dd86038_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.e