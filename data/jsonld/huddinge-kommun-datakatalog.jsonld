a kurser."},"dct:identifier":"ds_kuf_kultur_fritidsobjekt_p_kultur_kulturutbildning","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Kulturutbildning"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:a0757e2b6d894c099691fecf3a70c33178cbf8f5afcc8615c929e843e3ad549a_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/223","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se/spatialmap?mapheight=748.2&mapwidth=1533&label=&ignorefavorite=true&profile=csm_standard_profile&selectorgroups=fritid_kultur+kultur&layers=theme-sgd-tomtkarta-wms+theme-kultur_kulturutbildning+theme-kommun_mask&opacities=1+1+1&mapext=131291.0082438684+6556954.51228416+170676.7938001127+6576106.10827126&maprotation="},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Webbkarta"}}],"@id":"urn:source:a0757e2b6d894c099691fecf3a70c33178cbf8f5afcc8615c929e843e3ad549a"},{"@graph":[{"@id":"_:a0fb91984515c1a8e520df065ca690ca6818e1442e38cacede29ff2d0f744a1b_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/842"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/740","@type":"dcat:Dataset","dcat:contact