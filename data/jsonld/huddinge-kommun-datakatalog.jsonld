metadatakatalog.huddinge.se/store/23/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:trafik@huddinge.se"},"foaf:name":"KSF Enhet Trafikplanering"},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/619","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"KSF Enhet Trafikplanering","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:trafik@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/704","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/619"},"dcat:distribution":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/705"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Data om typ av gata utifrån funktion eller utformning för kommunala och enskilda vägar.\n\nHuvudgata inom tätort. Ingår i huvudnätet för biltrafik. Oftast med kommunal väghållning\n\nLokalnät stor: för biltrafik, större lokalgata.\nHär ingår normalt uppsamlande lokalgator.\nVägarna är dimensionerade för oskyddade trafikanter i blandtrafik\n\nLokalnät för biltrafik: Gågator och gator inom gångfartsområde ingår och dessa är då reglerade för att fordon ska köra i gångfart.\n\nKvartersväg: Gränd/kvartersväg, det vill säga väg utanför gatumark.\n\nParkeringsområdesväg: Väg utanför gatumark, men inom eller genom område med parkeringsplatser.\n\nInfarts/utfartsväg: Vägavsnitt på kvartersmark som leder in till parkeringsområde eller kvartersväg.\n\nLeveransväg: Väg fram till industrilokaler, tex varuintag. Adressplats kan förekomma.\n\nSmåväg: I Gatutyp hanteras endast enskilda vägar i de fall de finns utanför tätort och av kommunen klassats som bra bilväg, som i en del fall får kommunalt driftbidrag."},"dct:identifier":"ds_nvdb_gatutyp_l","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":{"@language":"sv","@value":"Gatutyp (NVDB)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:176ae432b1872fe41ebcb5f1f6c87fe225cb28f38108cff0189de45f619fc759_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/705","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://csm.huddinge.sokigohosting.com/spatialmap?ignorefavorite=true&profile=huddinge_internkarta&layers=theme-sgd-tomtkarta-wms+theme-nvdb_gatutyp_l+theme-kommun_mask"},"dct:title":{"@language":"sv","@value":"HuGIS (Webbkarta)"}}],"@id":"urn:source:176ae432b1872fe41ebcb5f1f6c87fe225cb28f38108cff0189de45f619fc759"},{"@graph":[{"@id":"_:1788703adf4e2b63f17917e261501f82813d3529c9030f626d8d1cad55af9f97_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"dcat:role":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3","@type":"foaf:Agent","foaf:name":{"@language":"en","@value":