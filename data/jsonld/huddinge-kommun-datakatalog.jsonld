ag för grön infrastruktur i planarbetet. Analysen är en modellering och bygger på geografiska data som jätteträd, gammal skog, småvatten och vattendrag samt blomrika marker.  Utfört av Ekologigruppen AB."},"dct:identifier":"ds_nka_sprid_analys_omr_y_insekt","dct:issued":{"@type":"xsd:gYear","@value":"2018"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:spatial":{"@id":"http://sws.geonames.org/2704619"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/environment"}],"dct:title":{"@language":"sv","@value":"Kärnområden (Nyttoinsekt)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:93757dbe67f65def8fb246a83f39740295a5ff02ce4d7ecd92ddc301abedc732_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/19/resource/222","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Ekologigruppen AB"}},{"@id":"https://metadatakatalog.huddinge.se/store/19/resource/299","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?layers=cartesia-lmvtopodim-direkt+theme-karnomraden_nyttoinsekt"},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/19/resource/300","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/19/resource/301","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WFS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http:/