dinge.se/store/25/resource/215","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KUF?SERVICE=WFS&REQUEST=GetCapabilities&token=513f200077af4fa09eaca6f1e4cb534d"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":{"@language":"sv","@value":"WFS"}}],"@id":"urn:source:3eeaec9c6bd0af2f79349a32fe3e5050f70c71a4e4ccf6ae81f7c0db95dd09ab"},{"@graph":[{"@id":"_:3ef6e526884f07b36bdda399301c653da24020dbf8b9fb8eb80fb5488b6a4b03_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"dcat:role":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3","@type":"foaf:Agent","foaf:name":{"@language":"en","@value":"KSF Strategiska enheten"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/543","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/611"},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/6"}],"dcat:distribution":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/583"},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/584"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Skyfallsmodellering över hela Huddinge kommun för det s.k. Köpenhamnsregnet. Resultatet ska främst användas för planering av krisberedskap och inte för planläggning. Lagret visar det maximala vattendjupet som kan uppstå på marken någon gång under modelleringsperioden på 6 h. Modelleringen är utförd på uppdrag av SVOA och kommunen av WSP år 2018 och metoden finns beskriven i rapport ”Skyfallsmodellering Huddinge kommun, 2018-06-19”. "},"dct:identifier":"ds_stra_skyfall_kopenhamn_maxflux_y","dct:issued":{"@type":"xsd:gYear","@value":"2018"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:spatial":{"@id":"http://sws.geonames.org/2704619"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/climatologyMeteorologyAtmosphere"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/inlandWaters"}],"dct:title":{"@language":"sv","@value":"Skyfallsmodellering Köpenhamnsregnet, maxflöden (m3/s/m)"},"foaf:page":{"@id":"https://sgd-dok-ext.sokigohosting.com/huddinge/KSF_PLAN/Skyfallskartering/Rapport-skyfallsmodellering_Huddinge_2018-06-19.pdf"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:3ef6e526884f07b36bdda399301c653da24020dbf8b9fb8eb80fb5488b6a4b03_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/583","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?layers=cartesia-lmvtopodim-direkt+theme-skyfallsmodellering_kopenhamnsregnet_maxfloden_m3sm"},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/584","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":