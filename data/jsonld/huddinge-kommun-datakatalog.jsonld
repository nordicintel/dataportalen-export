ccessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Kartan visar hur kommunens olika mark- och vattenområden ska bevaras eller utvecklas fram till år 2050, exempelvis var vi tillåter ny bebyggelse, vilka naturområden vi ska bevara samt hur vi utvecklar infrastrukturen.\n\nKlicka på ett objekt i kartan för att få upp en informationsruta där du kan läsa mer om vad lagret visar samt våra viktigaste ställningstaganden. \n\nLängst ner i inforutan finns en länk till en webbsida med ytterligare information om lagret."},"dct:identifier":"mark_vattenanvandningskarta_op2050","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/planningCadastre"},"dct:title":{"@language":"sv","@value":"Mark- och vattenanvändningskarta för ÖP2050"},"http://schema.org/diagram":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/753"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:948b9ef374a7ee6f9b494d747c2f0f87c87e1bde050a34f3a22c8a272b07ecbc_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/729","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se/spatialmap?mapheight=676.2&mapwidth=1541&label=&ignorefavorite=true&profile=op2050&selectorgroups=&layers=cartesia-lmvtopodim-direkt+theme-skogsomrade_op+theme-sjoar_op+theme-odlingslandskap_op+theme-naturreservat_op+theme-entre_storre_friluftsomrade_op+theme-verksamhetsomrade_op+theme-bebyggelsereserv_op+theme-fritidshusomrade_infor_omvandling_op+theme-omrade_dar_komplettering_kan_provas_op+theme-omrade_for_komplettering_op+theme-naturreservat_som_utreds_for_bebyggelse_op+theme-sjukvard_och_hogre_utbildning_op+theme-utvecklingsomrade_under_utre