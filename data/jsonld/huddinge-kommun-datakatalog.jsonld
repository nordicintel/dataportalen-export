ublications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/26/resource/470","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/MBF?SERVICE=WFS&REQUEST=GetCapabilities&token=9a11171d115c4a3c841c84f1dba068ef"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":{"@language":"sv","@value":"WFS"}},{"@id":"https://metadatakatalog.huddinge.se/store/26/resource/537","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"MBF Lantmäteriavdelningen KLM"}},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"MBF Lantmäteriavdelningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lantmateri@huddinge.se"}}],"@id":"urn:source:2b051706de6aa4bbfc373e315ac3d8127bf4e6f5e1662974ec04576b8294413d"},{"@graph":[{"@id":"_:2ba6fe366ba47a37b5be16c9696c190fec8cd85e8f20913559064fb26bd0aae3_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Kultur- och fritidsförvaltningen"},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kultur- och fritidsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kulturfritid@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/186","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115"},"dcat:keyword":{"@language":"sv","@value":"skridskobana"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Isbana\nAvser anläggning utomhus med konstfrusen is för olika isaktiviteter.\n\nIshall\nAvser anläggning med konstfrusen is och mått avsedda för ishockey, konståkning med mera. Ange hur många rinkar som finns i anläggningen. Vissa av dessa anläggningar används ibland även för andra idrotter samt för andra större evenemang. Om så är fallet ska anläggningen även karteras som evenemangsarena bland kulturobjekten.\n\nBandyplan\nAnläggning för träning, tävling och fritid. Avser yta med konstfrusen is och mått för bandy. Ange inomhus/utomhus och eventuell publikkapacitet. Vissa objekt kan även användas som bollplaner sommartid.\n\nCurlinghall\nAnläggning för träning, tävling och fritid med konstfrusen is och mått för curling. Ange om hallen är sammanbyggd med en ishall."},"dct:identifier":"ds_kuf_kultur_fritidsobjekt_p_fritid_isanlaggning","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Isanläggning"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:2ba6fe366ba47a37b5be16c9696c190fec8cd85e8f20913559064fb26bd0aae3_b0n0"}}],"@id":"urn:source:2ba6fe366ba47a37b5be16c9696c190fec8cd85e8f20913559064fb26bd0aae3"},{"@graph":[{"@id":"_:2f5bf4fbe472a5943ab47ff7fc5db4f8934953a31437079636b90690bf0a817f_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/15"}},{"@id":"https://metadatakatalog.huddinge.se/store/13/resource/857","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://metadatakatalog.huddinge.se/store/13/resource/858"},"dcat:keyword":["MCF - Myndigheten för Civilt Försvar",{"@language":"sv","@value":"brandstationer"}],"dcat:landingPage":{"@id":"https://www.geodata.se/geodataportalen/srv/swe/catalog.search#/metadata/1e3c8e08-df6c-4999-90ac-225d7bdae1a6"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Brandstationer inom och angränsande till Huddinge kommun"},"dct:identifier":"ds_brandstationer_wms_mcf","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/15"},"dct:title":{"@language":"sv","@value":"Brandstationer (WMS, MCF)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:2f5bf4fbe472a5943ab47ff7fc5db4f8934953a31437079636b90690bf0a817f_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/13/resource/858","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se/spatialmap?layers=cartesia-lmvtopodim-direkt+theme-brandstationer_wms_mcf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/15","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":{"@language":"sv","@value":"MCF - Myndigheten för Civilt Försvar"}}],"@id":"urn:source:2