BF Stadsmiljöavdelningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gator@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/9/resource/522","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se/spatialmap?mapheight=1043&mapwidth=1878&label=&ignorefavorite=true&profile=csm_standard_profile&selectorgroups=schaktarbeten_och_trafikforeskrifter&layers=theme-sgd-tomtkarta-wms+theme-trafikanordningar_planerade_isy_case+theme-kommun_mask&opacities=1+1+1&mapext=131056.96474385228+6555854.254358249+169113.87641018315+6576945.057513429&maprotation="},"dct:title":{"@language":"sv","@value":"Webbkarta"}}],"@id":"urn:source:096b877e11d0aae96d3e22920ed3e881e7c600d7413e57473a678911a411d32a"},{"@graph":[{"@id":"_:09870a7fc5fc92b164db11c8fc4d19cba595de1b940feed06b5aeed75ef422ae_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Kultur- och fritidsförvaltningen"},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kultur- och fritidsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kulturfritid@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/177","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/25/resource/115"},"dcat:keyword":{"@language":"sv","@value":"fotbollsplan"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Konstgräs_11\n11-spelsstorlek, konstgräs. Bollplan för träning, tävling och fritid. Avser anläggning med linjer, mått och utrustning för fotboll.\n\nGräs_11\n11-spelsstorlek, naturgräs. Anläggning för träning, tävling och fritid. Avser anläggning med linjer, mått och utrustning för fotboll. Kan även användas för exempelvis amerikansk fotboll, rugby och ultimate frisbee. \n\nKonstgräs_5-9\n5-9-spelsstorlek, konstgräs. Anläggning för träning, tävling och fritid. Avser anläggning med linjer, mått och utrustning för fotboll. Förekommer ofta som kluster av flera banor så planstorleken kan varieras. OBS endast separata 5-9-spelsplaner tas med här. 11-spelsplaner karteras för sig.\n\nGräs_5-9 \n5-9-spelsstorlek, naturgräs. Anläggning för träning, tävling och fritid. Avser anläggning med linjer, mått och utrustning för fotboll. Förekommer ofta som kluster av flera banor så planstorleken kan varieras. OBS endast separata 5-9-spelsplaner tas med här. 11-spelsplaner karteras för sig.\n\nÅretrunt\nBollplan/anläggning för träning som mestadels används vintertid. Avser byggnad, tält eller uppvärmd konstgräsplan med linjer, mått och utrustning för fotboll.  Anläggningarna kan vara olika stora med olika underlag. Ange underlag och storlek på planen."},"dct:identifier":"ds_kuf_kultur_fritidsobjekt_p_fritid_bollplan","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/society"},"dct:title":{"@language":"sv","@value":"Bollplan"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:09870a7fc5fc92b164db11c8fc4d19cba595de1b940feed06b5aeed75ef422ae_b0n0"}}],"@id":"urn:source:09870a7fc5fc92b164db11c8fc4d19cba595de1b940feed06b5aeed75ef422ae"},{"@graph":[{"@id":"_:0a5e8e56e309d01e1ba63446bab3679613d6960c662a32f37a959cf0b6c3338e_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/1"}},{"@id":"http://dataportal.se/organisation/SE2120000068","@type":"foaf:Agent","dct:identifier":"2120000068","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:gis-support@huddinge.se"},"foaf:name":{"@language":"sv","@value":"Huddinge kommun"},"foaf:page":{"@id":"https://www.huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/1","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:trafik@huddinge.se"},"foaf:name":"KSF Enhet Trafikplanering"},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/619","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"KSF Enhet Trafikplanering","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:trafik@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/699","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/619"},"dcat:distribution":[{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/797"},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/798"},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/799"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Dygnsekvivalenta ljudnivåer från vägtrafik (kommunala och statliga vägar) 1,5 m över mark.\n\nStrategisk bullerkartläggning av\nomgivningsbuller i Huddinge kommun år\n2021. Beräknat enligt de nordiska\nberäkningsmetoderna för väg- och spårtrafik,\ndygnsekvivalenta och maximala ljudnivåer.\n\nBeräkning gjord av Structor."},"dct:identifier":"ds_trl_buller_gnm_vag_leq","dct:issued":{"@type":"xsd:gYear","@value":"2021"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/health"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"}],"dct:title":{"@language":"sv","@value":"Samlat vägnät dygnsbuller (utbredning)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:0a5e8e56e309d01e1ba63446bab3679613d6960c662a32f37a959cf0b6c3338e_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/797","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?mapheight=993&mapwidth=1925&label=&ignorefavorite=true&selectorgroups=buller+belysning+bullerkartering_2021_utbredning&layers=theme-sgd-tomtkarta-wms+theme-fb-fastighetsyta+theme-buller_gnm_vag_leq+theme-kommun_mask&opacities=1+1+1+1&mapext=125924.04915199999+6553853.6252928+175075.950848+6579146.3747072&maprotation="},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/798","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/799","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WFS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1