"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/3","@type":"foaf:Agent","foaf:name":{"@language":"en","@value":"KSF Strategiska enheten"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/567","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Stockholms universitet"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/570","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/611"},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/6"}],"dcat:distribution":[{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/575"},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/576"},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/577"}],"dcat:keyword":[{"@language":"sv","@value":"Biotop"},{"@language":"sv","@value":"Ekosystem tjänster"},{"@language":"sv","@value":"Gröna infrastruktur"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:creator":{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/567"},"dct:description":{"@language":"sv","@value":"BIOTOP Stockholms klassificeringssystem har utgått från Stockholms stads befintliga biotopdatabas (Miljöförvaltning, 2012). För att passa en modern och kostnadseffektiv karteringsmetod och det ökade fokuset på den urbana miljön har systemet modifierats och vidareutvecklats. Metoden är under fortsatt uppbyggnad varför dess klassificeringssystem och övrig hörande dokumentation är ett levande dokument. BIOTOP Stockholm innehåller två hierarkiska nivåer, (huvudklasser och biotoper), samt en rad beskrivande tilläggsattribut som på olika sätt förtydligar databasens innehåll och egenskaper."},"dct:identifier":"ds_su_biotopdatabasen_y","dct:issued":{"@type":"xsd:date","@value":"2020"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/biota"},"dct:title":"Biotopdatabas - biotoper","http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:bffe328b6ed457e0aab6b779854184cce5805ce5d10223f6f6d1503c5763d919_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/575","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?layers=cartesia-lmvtopodim-direkt+theme-biotopdatabas_biotoper"},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/576","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/577","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WFS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":{"@language":"sv","@value":"WFS"}},{"@id":"https://metadatakatalog.huddinge.se/store/12/resource/611","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"KSF Strategiska enheten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:KSFSamhallsbyggnadsavdelEnhetStrategiska@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/5/resource/6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"MBF Lantmäteriavdelningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lantmateri@huddinge.se"}}],"@id":"urn:source:bffe328b6ed457