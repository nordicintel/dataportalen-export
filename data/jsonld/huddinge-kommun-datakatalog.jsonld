Enhet Trafikplanering","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:trafik@huddinge.se"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/712","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/619"},"dcat:distribution":{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/713"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Bärighetsklass (BK) är den klassificering som används för att gradera bärighet. Bärighet beskriver hur tunga fordon en bro eller väg får belastas med. Bärighetsklassen (BK) avgör vilka fordonsvikter som är tillåtna på vägen eller bron.\nDenna information används för trasportdispenser samt allmänheten som behöver trafikera fordon på Huddinge vägar."},"dct:identifier":"ds_nvdb_barighetsklass_l","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":{"@language":"sv","@value":"Bärighetsklass (NVDB)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:5ca8cfc92c3a65e261b4b8b2952f1e1e9c4e3dac71e5f0f1511d413affc592c5_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/713","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://csm.huddinge.sokigohosting.com/spatialmap?ignorefavorite=true&profile=huddinge_internkarta&layers=theme-sgd-tomtkarta-wms+theme-nvdb_barighetsklass+theme-kommun_mask"},"dct:title":{"@language":"sv","@value":"HuGIS (Webbkarta)"}}],"@id":"urn:source:5ca8cfc92c3a65e261b4b8b2952f1e1e9c4e3dac71e5f0f1511d413affc592c5"},{"@graph":[{"@id":"http