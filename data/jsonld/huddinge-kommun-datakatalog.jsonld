keyword":[{"@language":"sv","@value":"buller"},{"@language":"sv","@value":"trafik"},{"@language":"sv","@value":"verksamhet"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Kartläggning av områden som beräknas ha\ndygnsekvivalenta ljudnivåer om 40 dBA eller\nlägre för buller från trafik\noch verksamheter. Kartläggningen baseras på den bullerkartläggning av väg- och spårtrafik i kommunen som genomfördes 2021. Kartan visar en anpassning av den ursprungliga analysen, där små ytor har tagits bort för bättre läsbarhet."},"dct:identifier":"ds_trl_tysta_omraden_y","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/environment"},"dct:title":{"@language":"sv","@value":"Tysta områden"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:b43427ab14b37bc598119ef78f1c690c47de563470739c72699bc3f725511af6_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/813","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/814","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WFS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":{"@language":"sv","@value":"WFS"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/815","@type":"dcat:Distribution","d