g av\nomgivningsbuller i Huddinge kommun år\n2021. Beräknat enligt de nordiska\nberäkningsmetoderna för väg- och spårtrafik,\ndygnsekvivalenta och maximala ljudnivåer.\n\nBeräkning gjord av Structor."},"dct:identifier":"ds_trl_buller_gnm_alla_bullerkallor_lmax","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000068"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/health"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"}],"dct:title":{"@language":"sv","@value":"Alla bullerkällor maxbuller (utbredning)"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:9c68284cf5f607bec7e2bdaefb8a8b313fe03827682be0c2f7adac7e111a3d4a_b0n0"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/780","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.huddinge.se?mapheight=993&mapwidth=1925&label=&ignorefavorite=true&selectorgroups=buller+belysning+bullerkartering_2021_utbredning&layers=theme-sgd-tomtkarta-wms+theme-fb-fastighetsyta+theme-buller_gnm_alla_bullerkallor_lmax+theme-kommun_mask&opacities=1+1+1+1&mapext=125924.04915199999+6553853.6252928+175075.950848+6579146.3747072&maprotation="},"dct:title":{"@language":"sv","@value":"Webbkarta"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/781","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WMS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1b51531c"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":{"@language":"sv","@value":"WMS"}},{"@id":"https://metadatakatalog.huddinge.se/store/23/resource/782","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gd-huddinge.sokigohosting.com/public-maps/Oppnadata/KSF?SERVICE=WFS&REQUEST=GetCapabilities&token=7f76920a28154b588684ef2b1