{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:915d75e3613c91dc4784f71b78c20c51e7daea923f19a88bc464d6aa39243fcb_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2025-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2025-01-01"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#agent","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/PrivateIndividual(s)"},"foaf:name":"Vårdbetyg"},{"@id":"https://vardbetyg.se/data/dcat.rdf#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Vårdbetyg","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hej@vardbetyg.se"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#dataset","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://vardbetyg.se/data/dcat.rdf#contact"},"dcat:distribution":[{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-fotnoter"},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-fragor"},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-kommuner"},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-utmarkelser"},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-vardcentraler"}],"dcat:keyword":["Vårdbetyg",{"@language":"en","@value":"Sweden"},{"@language":"en","@value":"health centres"},{"@language":"en","@value":"patient survey"},{"@language":"en","@value":"primary care"},{"@language":"en","@value":"waiting times"},{"@language":"sv","@value":"Sverige"},{"@language":"sv","@value":"patientenkät"},{"@language":"sv","@value":"primärvård"},{"@language":"sv","@value":"väntetider"},{"@language":"sv","@value":"vårdcentraler"}],"dcat:landingPage":{"@id":"https://vardbetyg.se/riket"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},"dcat:version":"2.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"An open, downloadable dataset covering Swedish health centres (vårdcentraler): patient experience from the National Patient Survey 2025 (scored 0-100 across six dimensions, per unit) combined with the National Board of Health and Welfare's primary-care waiting-time statistics (accessibility), plus the Vårdbetyg composite score per unit. Aggregated from public sources with an open method; units with too few respondents are published without a score."},{"@language":"sv","@value":"Ett öppet, nedladdningsbart dataset över svenska vårdcentraler: patientupplevelse från Nationell Patientenkät 2025 (poäng 0-100 över sex dimensioner, per enhet) sammanvägt med Socialstyrelsens väntetidsstatistik för primärvård (tillgänglighet), samt det sammanvägda Vårdbetyget per enhet. Aggregerat från öppna källor med en öppen metod; enheter med för få svar publiceras utan poäng."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://vardbetyg.se/data/dcat.rdf#agent"},"dct:spatial":{"@id":"http://publications.europa.eu/resource/authority/country/SWE"},"dct:temporal":{"@id":"_:915d75e3613c91dc4784f71b78c20c51e7daea923f19a88bc464d6aa39243fcb_b0n0"},"dct:title":[{"@language":"en","@value":"Vårdbetyg - open dataset for Swedish health centres (2025)"},{"@language":"sv","@value":"Vårdbetyg - öppet dataset för svenska vårdcentraler (2025)"}],"foaf:page":{"@id":"https://github.com/arpi09/vardbetyg-open-data"},"http://www.w3.org/ns/adms#versionNotes":[{"@language":"en","@value":"Footnote codes for missing values (F01 to F06) in units.csv (columns vardbetyg_fotnot and tillganglighet_fotnot) and in each unit’s data.json, the code list as its own file (fotnoter.csv) and the schema_version column."},{"@language":"sv","@value":"Fotnotskoder för saknade värden (F01 till F06) i units.csv (kolumnerna vardbetyg_fotnot och tillganglighet_fotnot) och i varje enhets data.json, kodlistan som egen fil (fotnoter.csv) och kolumnen schema_version."}]},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-fotnoter","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vardbetyg.se/data/fotnoter.csv"},"dcat:downloadURL":{"@id":"https://vardbetyg.se/data/fotnoter.csv"},"dct:description":[{"@language":"en","@value":"The code list F01 to F06: why a value is missing in the dataset (too few responses, not reported with a reason, not applicable, the rating rests on 1 of 2 sources). The codes describe the source, never the health centre. UTF-8."},{"@language":"sv","@value":"Kodlistan F01 till F06: varför ett värde saknas i datasetet (för få svar, ej rapporterat med orsak, ej tillämpligt, betyget bygger på 1 av 2 källor). Koderna beskriver källan, aldrig vårdcentralen. UTF-8."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Footnote codes for missing values, CSV"},{"@language":"sv","@value":"Fotnotskoder för saknade värden, CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-fragor","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vardbetyg.se/data/fragor.csv"},"dcat:downloadURL":{"@id":"https://vardbetyg.se/data/fragor.csv"},"dct:description":[{"@language":"en","@value":"Question level from the patient survey: one row per health centre and scored question, with the question score, confidence interval, share of positive answers and respondent count. Added depth, not part of the Vårdbetyg. UTF-8, dot as decimal separator."},{"@language":"sv","@value":"Frågenivån ur patientenkäten: en rad per vårdcentral och betygsatt fråga, med frågepoäng, konfidensintervall, andel positiva svar och antal svarande. Fördjupning, ingår inte i Vårdbetyget. UTF-8, punkt som decimaltecken."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Survey questions (per unit and question), CSV"},{"@language":"sv","@value":"Enkätfrågor (per enhet och fråga), CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-kommuner","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vardbetyg.se/data/kommuner.csv"},"dcat:downloadURL":{"@id":"https://vardbetyg.se/data/kommuner.csv"},"dct:description":[{"@language":"en","@value":"Aggregates per municipality: number of health centres, number with a published score, mean and top scores, and total respondents. UTF-8, dot as decimal separator."},{"@language":"sv","@value":"Aggregat per kommun: antal vårdcentraler, antal med publicerat betyg, medel- och toppbetyg samt summa svarande. UTF-8, punkt som decimaltecken."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Municipalities (aggregated), CSV"},{"@language":"sv","@value":"Kommuner (aggregat), CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-utmarkelser","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vardbetyg.se/data/utmarkelser.csv"},"dcat:downloadURL":{"@id":"https://vardbetyg.se/data/utmarkelser.csv"},"dct:description":[{"@language":"en","@value":"One row per award: Top 10% in Sweden, Top-rated in the municipality and Most improved, with award year, measurement year, name and HSA id. The same awards the site shows. They cannot be bought and never affect the score. UTF-8, dot as decimal separator."},{"@language":"sv","@value":"En rad per utmärkelse: Topp 10 % i Sverige, Topprankad i kommunen och Årets klättrare, med utmärkelseår, mätår, namn och HSA-id. Samma utmärkelser som sajten visar. De kan inte köpas och påverkar aldrig betyget. UTF-8, punkt som decimaltecken."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Health centres with an award, CSV"},{"@language":"sv","@value":"Utmärkta vårdcentraler, CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"}},{"@id":"https://vardbetyg.se/data/dcat.rdf#distribution-vardcentraler","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://vardbetyg.se/data/vardcentraler.csv"},"dcat:downloadURL":{"@id":"https://vardbetyg.se/data/vardcentraler.csv"},"dct:description":[{"@language":"en","@value":"One row per health centre: name, municipality, region, HSA id when known, the Vårdbetyg score, category scores and each survey dimension with confidence interval, plus respondent count and response rate. UTF-8, dot as decimal separator."},{"@language":"sv","@value":"En rad per vårdcentral: namn, kommun, region, HSA-id när det är känt, Vårdbetyg, kategoripoäng och varje enkätdimension med konfidensintervall, samt antal svarande och svarsfrekvens. UTF-8, punkt som decimaltecken."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Health centres (per unit), CSV"},{"@language":"sv","@value":"Vårdcentraler (per enhet), CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"}}],"@id":"urn:source:915d75e3613c91dc4784f71b78c20c51e7daea923f19a88bc464d6aa39243fcb"},{"@graph":[{"@id":"https://vardbetyg.se/data/dcat.rdf#catalog","@type":"dcat:Catalog","dcat:dataset":{"@id":"https://vardbetyg.se/data/dcat.rdf#dataset"},"dcat:themeTaxonomy":{"@id":"http://publications.europa.eu/resource/authority/data-theme"},"dct:description":[{"@language":"en","@value":"Catalogue of open data from Vårdbetyg, independent ratings of Swedish healthcare built on open data. Contains the open dataset with patient experience (National Patient Survey), accessibility (National Board of Health and Welfare primary-care waiting times) and the composite Vårdbetyg score per unit. Vårdbetyg is independent and does not represent any public authority or region."},{"@language":"sv","@value":"Katalog över öppna data från Vårdbetyg, oberoende betyg på svensk vård byggt på öppna data. Innehåller det öppna datasetet med patientupplevelse (Nationell Patientenkät), tillgänglighet (Socialstyrelsens väntetider i primärvården) och det sammanvägda Vårdbetyget per vårdcentral. Vårdbetyg är fristående och representerar ingen myndighet eller region."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"https://vardbetyg.se/data/dcat.rdf#agent"},"dct:title":[{"@language":"en","@value":"Vårdbetyg open data catalogue"},{"@language":"sv","@value":"Vårdbetygs öppna datakatalog"}],"foaf:homepage":{"@id":"https://vardbetyg.se"}}],"@id":"urn:source:f2fe75a2788bb2531850387e231a4c0d0b54242d7b278eaec189e783217a7ad1"}]}
