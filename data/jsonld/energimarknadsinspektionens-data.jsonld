rce/11","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik Ei","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:statistik@ei.se"}},{"@id":"https://ei.entryscape.net/store/1/resource/130","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://ei.entryscape.net/store/1/resource/11"},"dcat:distribution":[{"@id":"https://ei.entryscape.net/store/1/resource/142"},{"@id":"https://ei.entryscape.net/store/1/resource/144"}],"dcat:keyword":[{"@language":"sv","@value":"el"},{"@language":"sv","@value":"elavtal"},{"@language":"sv","@value":"elleverantörer"},{"@language":"sv","@value":"elpriser"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"prisutveckling"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Elleverantörers priser/kWh för konsumenter med en årsförbrukning på 20 000 kWh. Priserna är angivna i totalt pris/kWh och innebär att konsumentens samtliga kostnader för förbrukad el är inkluderade, dvs; elpris, påslag, avgifter och moms. Priserna är från den 15:e varje månad och baseras på inrapporterade uppgifter till elpriskollen.se. Rörliga priser och anvisade priser är alltid förgående månads priser. Filen uppdateras omkring den 17:e varje månad, dock saknas priser för november 2020-mars 2021 pga databortfall. I juni 2026 bytte ”Rörligt pris löpande” namn till ”Månadspris”. Ändringen gjordes även på historiska avtal bakåt i tiden men påverkar inte statistiken. OBS! Filen inkluderar även rabattavtal."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005695"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Elleverantörers priser för konsumenter 20 000 kWh/år"}},{"@id":"https://ei.entryscape.net/store/1/resource/141","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Prices 20000 kWh electricity suppliers_october2026.csv"},{"@id":"https://ei.entryscape.net/store/1/resource/142","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ei.entryscape.net/store/1/resource/141"},"dcat:downloadURL":{"@id":"https://ei.entryscape.net/store/1/resource/141"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16T09:42:30.825Z"}},{"@id":"https://ei.entryscape.net/store/1/resource/144","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://ei.entryscape.net/rowstore/dataset/8db5a77c-ef90-49f0-8e2f-18327735c463"},"dct:conformsTo":{"@id":"https://ei.entryscape.net/rowstore/dataset/8db5a77c-ef90-49f0-8e2f-18327735c463/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16T09:43:00.150Z"},"dct:source":{"@id":"https://ei.entryscape.net/store/1/resource/142"}}],"@id":"urn:source:c9b7f98af7fb62c7102fdad6a9960eb653e9fdb2df3d3986f9a2305ea005dbcd"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005695","@type":"foaf:Agent","dct:identifier":"2021005695","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:marit.widman@ei.se"},"foaf:name":{"@language":"sv","@value":"Energimarknadsinspektionen"},"foaf:page":{"@id":"https://www.energimarknadsinspektionen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ei.entryscape.net/store/1/resource/1"}},{"@id":"https://ei.entryscape.net/store/1/resource/11","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik Ei","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:statistik@ei.se"}},{"@id":"https://ei.entryscape.net/store/1/resource/267","