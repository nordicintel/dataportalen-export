öra olika elnätsföretag samlar Ei in data från företagen för 15 olika typkundgrupper. Samtliga nätföretags uppgifter för olika typer av större säkringskunder från 1999 återfinns i statistikfilen."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005695"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Elnätsföretagens elnätsavgifter större säkringskunder"}},{"@id":"https://ei.entryscape.net/store/1/resource/198","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Större säkringskunder 1999-2026.csv"},{"@id":"https://ei.entryscape.net/store/1/resource/199","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ei.entryscape.net/store/1/resource/198"},"dcat:downloadURL":{"@id":"https://ei.entryscape.net/store/1/resource/198"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-11T10:45:40.975Z"}}],"@id":"urn:source:511d2d2d2761b56323edf0763f03e8b1d76c939caafab71ea93553f0788c51c1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005695","@type":"foaf:Agent","dct:identifier":"2021005695","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:marit.widman@ei.se"},"foaf:name":{"@language":"sv","@value":"Energimarknadsinspektionen"},"foaf:page":{"@id":"https://www.energimarknadsinspektionen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://ei.entryscape.net/store/1/resource/1"}},{"@id":"https://ei.entryscape.net/store/1/resource/11","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik Ei","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:statistik@ei.se"}},{"@id":"https://ei.entryscape.net/store/1/resource/253","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://ei.entryscape.net/store/1/resource/11"},"dcat:distribution":{"@id":"https://ei.entryscape.net/store/