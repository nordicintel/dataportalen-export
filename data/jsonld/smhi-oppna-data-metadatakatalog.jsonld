e":"POINT(18.65 62.06)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/37f42bb3-86ca-4420-a71d-41a2d4ea7457","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30891"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Vågriktning mäts nu med givare monterade på bojar i havet.  Historiskt utfördes mätningarna med hjälp av bottenmonterade ekolod samt vågbojar av typ Waverider. I dagsläget används Waveriderbojar samt havsbojar med accelerometrar som givare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-7.atom"},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/7.json"},{"@id":"https://opendata-view.smhi.se/oc-obs-wavedirectionmean/OF.PointObservation/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Vågriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera havsvågornas riktning och förbättra vågmodeller. Assimilering och validering av modeller.\n\nEnhet: Grader med 1 decimal.\n\nEgenskaper: Vågriktningen definieras som den riktning varifrån vågorna kommer. Mätningen görs från bojar nära kusten och till havs. Medelvågriktning (VDIR) är medelvärdet av vågornas riktning under 30 minuter.\nVågriktning vid Tp (VPED) är riktningen hos vågorna där energin är som störst under 30 minuter. Ett värde per timme erhålls.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: 0-360 grader\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/matning-och-berakning-av-vagor\nhttps://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2010-07-05-vagor-i-svenska-hav"},"dct:identifier":"37f42bb3-86ca-4420-a71d-41a2d4ea7457","dct:issued":{"@type":"xsd:date","@value":"2014-10-16"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Vågriktning, medelvärde"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-7.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-7.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-7.atom"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/7.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/7.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/7.json"},"dct:description":{"@language":"sv","@value":"API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b2n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/oc-obs-wavedirectionmean/OF.PointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs-wavedirectionmean/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs-wavedirectionmean/OF.PointObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9a49e48c6d52d23c5ff7_b3n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7e23f0793433b1e73a3c1514d21e9ebb96211c5b336f9