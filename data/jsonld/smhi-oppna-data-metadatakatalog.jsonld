mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/7ef11fb7-63fa-4926-8532-90da492a0e33","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"20858"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Övervakningen finansieras av länsstyrelsen, kommuner och vattenvårdsförbund. Även data från recipientkontroll som är finansierade av företag ingår i detta dataset.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-phytoplankton-reg"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data samlas in och analyseras enligt HELCOM Guidelines for monitoring of phytoplankton species composition, abundance and biomass. Avvikelser från manualen kan förekomma. Information om programmet och metoderna finns också på svenska på Havs- och vattenmyndighetens webbplats. \n - https://helcom.fi/wp-content/uploads/2020/01/HELCOM-Guidelines-for-monitoring-of-phytoplankton-species-composition-abundance-and-biomass.pdf \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/vaxtplankton.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av svenska universitet och konsultföretag."},"dct:identifier":"7ef11fb7-63fa-4926-8532-90da492a0e33","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:980fbda3f0299e14c4f7a8ceb0599961176334f7ecff81f7dc6336f63e06de18_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:980fbda3f0299e14c4f7a8ceb0599961176334f7ecff81f7dc6336f63e06de18_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Regional marin miljöövervakning, recipientkontroll samt andra övervakningsprojekt av växtplankton i Sverige sedan 1985."}},{"@id":"https://www.gbif.se/ipt/resource?r=smhi-phytoplankton-reg","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-phytoplankton-reg"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-phytoplankton-reg"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:980fbda3f0299e14c4f7a8ceb0599961176334f7ecff81f7dc6336f63e06de18_b1n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:980fbda3f0299e14c4f7a8ceb0599961176334f7ecff81f7dc6336f63e06de18_b2n0"},"http://www.w3.org