@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bbe9d940-cd80-402e-bcc8-ac587d5be230","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30724"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Våghöjd mäts nu med givare monterade på bojar i havet.  Historiskt utfördes mätningarna med hjälp av bottenmonterade ekolod samt vågbojar av typ Waverider. I dagsläget används Waveriderbojar samt havsbojar med accelerometrar som givare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-1.atom"},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/1.json"},{"@id":"https://opendata-view.smhi.se/oc-obs-waveheight/OF.PointObservation/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/waves"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Våghöjd"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera havsvågornas höjd och förbättra vågmodeller. Assimilering och validering av modeller.\n\nEnhet: Meter med 2 decimaler.\n\nEgenskaper: Signifikant våghöjd är medelvärdet av högsta tredjedelen av vågorna under 30 minuter. Mätningarna genomförs från bojar nära kusten och till havs.Ett värde per timme.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: >0\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/matning-och-berakning-av-vagor\nhttps://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2010-07-05-vagor-i-svenska-hav"},"dct:identifier":"bbe9d940-cd80-402e-bcc8-ac587d5be230","dct:issued":{"@type":"xsd:date","@value":"2013-06-03"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:3548f8b5f1f130558c1e9c85b05ee1babca590ddd5aeb2bb2383d747fafe2904_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:3548f8b5f1f130558c1e9c85b05ee1babca590ddd5aeb2bb2383d747fafe2904_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Våghöjd"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-1.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-1.atom"},"dcat:downloadURL":{"@id":"https://open