1e733afe006ac3241b5ed29_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/5318ec28-f1fc-42d2-847b-ff61e05aa2ab","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32621"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Modellens kartläggning av vädret bygger på observationer från vanliga väderstationer, men också från Trafikverkets stationer, data från väderradar och satellit. Som startvärde (första gissning) används vanligtvis en prognos från den numeriska vädermodellen HIRLAM som gäller vid observationstidpunkten. Denna bygger i sin tur på tidigare observationer och modifieras i MESAN för att stämma bättre med de aktuella observationerna.  Metoden som används kallas Optimal Interpolation och bygger på statistiska samband över hur informationsinnehållet i observationer avtar som funktion av avståndet från observationsplatsen. Med hjälp av detta samband kan flera observationer vägas samman till ett medelvärde som gäller för en så kallad gridruta. I MESAN HIRLAM är dessa 11 gånger 11 km.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/4"},{"@id":"https://opendata-view.smhi.se/grid-archive/mesan_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nI denna datamängd finns arkiverade MESAN-data fram till och med dygnet innan uttaget sker.\nData finns t.o.m. maj 2016. Därefter baseras MESAN-analysen på den mer högupplösta prognosmodellen AROME.\nMesan är en meteorologisk analysmodell som beskriver det aktuella väderläget i gridrutor. \nVarje timme under dygnet görs en tvådimensionell kartläggning av vanliga väderparametrar. Vilka dessa är varierar något över dygnet. I huvudsak beskriver de meteorologiska förhållanden som temperatur, nederbörd, moln, sikt, luftfuktighet, vind och snö.\nAnalysen görs över ett område som täcker Skandinavien, brittiska öarna, norra delen av kontinenten och de baltiska staterna. \n\nKOORDINATER\nKoordinater för området ges av hörnen:\nsydvästra\t\t48.5N, 10.5W\nnordvästra\t75.1N, 11.5W\nnordöstra\t\t63.3N, 51.6E\nsydöstra\t\t42.4N, 22.9E\n\nGridrutorna är 11*11 km.\n\nANVÄNDNING\nMesan-data används på SMHI för att göra väderkartor som meteorologen har som underlag i prognosverksamheten. Om observationer saknas kan analyserade värden ibland ersätta dessa. Mesan-data används också som indata till andra modeller t ex för att beräkna avrinningen i våra vattendrag eller för att kartlägga risken för bränder i skog och mark.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"5318ec28-f1fc-42d2-847b-ff61e05aa2ab","dct:issued":{"@type":"xsd:date","@value":"2013-06-03"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk analysmodell MESAN (HIRLAM) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/4"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/4"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafeed"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b1n0"},"dct:title":{"@language":"sv","@value":""},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive/mesan_extent/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesan_extent/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesan_extent/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för MESAN"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b2n0"},"dct:title":{"@language":"sv","@value":""},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29_b5n0"}}],"@id":"urn:source:f582610c2a7aab9ae135cd93a3c037edf8be165da1e733afe006ac3241b5ed29"},{"@graph":[{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,24 69,24 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.69 62.05)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/4a3b003b-f886-4225-b940-a6e498ac2187","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"26630"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Vattenföring beräknas från vattenstånd. Vattenståndet mäts vid en mätstation som kallas pegel. Sambandet mellan vattenstånd och vattenföring kallas avbördningssamband. De första observationerna för vattenföring är från 1800-talet. Först läste en observatör av vattenståndet på en pegelskala (ungefär en stor tumstock) och rapporter skickades in till SMHI en gång i månaden.  För ca 100 år sedan började man använda registerande skrivare, sk vattenståndsdiagram. Först under 1950 talet blev diagram vanligare och de manuella avläsningarna började avveckals. Diagrammen skickades in till SMHI en gång i veckan/månaden. Under 1980 började automater och loggar att användas, dessa skickar data till SMHI dagligen automatiskt. Idag används både diagram och automater.  SMHI får också in data från externa leverantörer Data granskas med hjälp av jämförelser med andra stationer samt kontroll mot nederbörd och temperatur. Därefter sätts kvalitetskoder.åäö","dcat:distribution":[{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/10.json"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischargeMonth"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Vattenföring"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt och historiskt hydrologiskt tillstånd i Sverige.\n\nEnhet: m3/s\n\nEgenskaper: Beskriver den mängd vatten per tidsenhet som rinner fram i ett vattendrag. Tidstämpeln anges i UTC.\n\nNätinformation:\n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data rimlighetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. Fysiska stationer övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Stationerna ingår ej i SMHIs stationsnät men data samlas in och lagras i SMHIs databaser genom avtal med en tredje part.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden"},"dct:identifier":"4a3b003b-f886-4225-b940-a6e498ac2187","dct:issued":{"@type":"xsd:date","@value":"2024-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Hydrologiska observationer - Vattenföring, månadsvärde"}},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/10.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/10.json"},"dcat:downloadURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/10.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischargeMonth","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischargeMonth"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischargeMonth"},"dct:description":{"@language":"sv","@value":"Nedladdning av vattenföring, kvartsvärden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b2n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228_b4n0"}}],"@id":"urn:source:f5a4a8d7bc3791ee4ede766f0aacfb9303aa7ab79845f90653ba40ba4bd9e228"},{"@graph":[{"@id":"_:f603876b9cd56c3444bd9dbb523dc4ae98ae9e54a6585462aff46e9a00915230_b0n0","@type":["dct:Loc