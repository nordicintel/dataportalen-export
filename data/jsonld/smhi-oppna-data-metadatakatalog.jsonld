dc8f4c518c1d2d50436bcad75f1f3042_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bf657f00-2e98-11ed-84f0-5b3e6bab28c1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32534"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Temperaturen mäts automatiskt med Pt100 resistanstermometrar, se https://www.pentronic.se. Före 1995 utfördes nästan alla mätningar manuellt med kvicksilver- eller sprittermometer. Automatiska mätningar görs varje timme medan manuella mätningar genomfördes med olika frekvens vid olika stationer. Tre gånger per dygn eller var tredje timme var vanligast. Ett mindre antal manuella stationer mätte varje timme. Beskrivningar av mätmetoder och mätfrekvenser finns på https://www.smhi.se/kunskapsbanken/meteorologi/temperatur/hur-mats-lufttemperatur I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-19.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_min_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/airTemperatureMinAndMaxOnceEveryDay"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet\n\nEnhet: °C\n\nEgenskaper: Minvärde av lufttemperatur gällande 24 timmar, lagrat 18 UTC. De flesta stationer mäter värden 2 gånger per dygn (06 UTC och 18 UTC) som då gäller 12 timmar och av dessa väljs det lägsta värdet för att få fram dygnsvärden. Kvalitetskoden blir i så fall gul. Mäts endast dygnsvärden blir kvalitetskoden grön.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\nKvalitetskoder: Gult = Aggregerade värden \n\nGränser: -60 till +40 °C\n\nFör mer info se: https://www.smhi.se/data/meteorologi/temperatur"},"dct:identifier":"bf657f00-2e98-11ed-84f0-5b3e6bab28c1","dct:issued":{"@type":"xsd:date","@value":"2022-09-07"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lufttemperatur, minvärde 1 dygn"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-19.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-19.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-19.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av mintemp data via Atomflöde"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av min temperatur"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_min_view/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_min_view/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_min_view/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för temperatur"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4602f77a780495db9cf275a6416c8d87dc8f4c518c1d2d50436bcad75f1f3042_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst för max- och mintemperatur"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/l