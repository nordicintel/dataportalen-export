alAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/392c4720-d4f2-11ec-9bd9-d92812a90f08","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"25989"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Kommer inom kort.","dcat:distribution":{"@id":"https://opendata-download-metanalys.smhi.se/gridclim/"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Snödjup"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Ett klimatologiskt griddat dataset (SMHI Gridded Climatology - SMHIGridClim) har tagits fram för åren 1961 - 2018. Data täcker de nordiska länderna med en horisontell upplösning av 2,5 km. Variablerna som tagits fram är lufttemperatur och relativ luftfuktighet vid 2m höjd med en upplösning av1,3 eller 6 timmar beroende av tidsperiod, samt dygnsupplöst min- och maxtemperatur, nederbörd och snödjup. Datasetet är framtaget med optimal interpolation av stationsdata genom analysverktyget gridpp, som är en öppet tillgänglig programvara från Norska Meteorologiska Institutet.\n\nObservationer till analysen har erhållits från de svenska, norska och finska\nmeteorologiska instituten, samt ECMWF.\n\nFörklaringar av parameternamn (under https://opendata-download-metanalys.smhi.se/gridclim/):\n  - hurs: Relativ luftfuktighet 2 meter över markytan (00-23 UTC)\n  - pr: Nederbörd (06-06 UTC)\n  - snd: Snödjup (06 UTC)\n  - tas: Medelvärde för lufttemperatur 2 meter över markytan (00-23 UTC)\n  - tasmax: Maxvärde för lufttemperatur 2 meter över markytan (18-18 UTC)\n  - tasmin: Minvärde för lufttemperatur 2 meter över markytan (18-18 UTC)\n\nFör mer information se: https://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2021-11-21-smhi-gridded-climatology"},"dct:identifier":"392c4720-d4f2-11ec-9bd9-d92812a90f08","dct:issued":{"@type":"xsd:date","@value":"2022-05-16"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk återanalys SMHIGridClim (UERRA-Harmonie)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metanalys.smhi.se/gridclim/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-metanalys.smhi.se/gridclim/"},"dcat:downloadURL":{"@id":"https://opendata-download-metanalys.smhi.se/gridclim/"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb_b1n0"},"dct:title":{"@language":"sv","@value":"SMHI GridClim"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb_b3n0"}}],"@id":"urn:source:23944686f2073f8999713c3e33614425274a8a4d50d63884f2ea1035df16c4fb"},{"@graph":[{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((4 66,34 66,34 53,4 53,4 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(18.67 59.25)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"ht