rsokningstyper/vegetationskladda-bottnar-ostkust.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/vegetationskladda-bottnar-vastkust.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av svenska universitet och konsultföretag."},"dct:identifier":"14f2105e-e4e0-401a-89f5-cf9296b56bce","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Regional marin miljöövervakning samt andra övervakningsprojekt av vegetationsklädda bottnar i Sverige sedan 1994."}},{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-reg","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-reg"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-reg"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8_b1n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8_b3n0"}}],"@id":"urn:source:b31fbb3c31cd87cb1b3a5fd684548bda2f6af7a962264655fa01fb8f9d93beb8"},{"@graph":[{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5 66,30 66,30 54,5 54,5 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.25 59.95)"},"dcat:endDate":{"@type":"xsd:date","@value":"2025-02-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-01-01"}},{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://currents.soest.hawaii.edu/docs/adcp_doc/index.html","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://currents.soest.hawaii.edu/docs/adcp_doc/index.html"},"dcat:downloadURL":{"@id":"https://currents.soest.hawaii.edu/docs/adcp_doc/index.html"},"dct:description":{"@language":"sv","@value":"Information om bearbetning och kvalitetskontroll"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b0n0"},"dct:title":{"@language":"sv","@value":"Bearbetning och kvalitetskontroll"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/ce89ba58-f397-47a4-8493-8b5c711fd1ab","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"25003"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Övervakningen finansieras av Sveriges meteorologiska och hydrologiska institut.","dcat:distribution":{"@id":"https://currents.soest.hawaii.edu/docs/adcp_doc/index.html"},"dcat:keyword":[{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Strömhastighet"},{"@language":"sv","@value":"Strömriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Skrovmonterad Acoustic Doppler Current Profiler (ADCP) mäter hastighet och riktning på strömmarna på flera djup från fartygets undersida ner till havsbotten. Antalet djupceller bestäms av både frekvensen på ADCP och instrumentets inställningar. En undersökning med skrovmonterad ADCP tar många strömprofiler vid olika punkter längs en rutt. Användare kan sedan se hur strömmarna varierar inte bara med djup, utan också över ett geografiskt område.\n\nI detta dataset hittar du data från R/V Svea i Skagerrak, Kattegatt och Östersjön från år 2022 och framåt.\n\nProvtagning utförs med två separata sensorer, RDI Teledyne Work Horse 600 kHz och RDI Teledyne Ocean Surveyor 150 kHz. Work Horse använder djupceller på 2 meter, som provtas från cirka -8 till -40 meters djup. Ocean Surveyor använder djupceller på 8 meter, som provtas från cirka -12 till -400 meters djup. Det temporala medelvärdet är 120 sekunder för båda sensorerna. Bearbetning och kvalitetskontroll utförs med hjälp av CODAS-programvaran, version focal 20.04: \n - https://currents.soest.hawaii.edu/docs/adcp_doc/index.html.\n\nStrömdata används för att förbättra oceanografiska modeller som används bland annat för ruttoptimering inom sjöfarten, vid sjöräddning, för att följa oljespill med mera. Strömmätningar är en bristvara.\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\n\nÖvervakningen utförs av Sveriges meteorologiska och hydrologiska institut.\n\nData finns tillgängliga på begäran via shark@smhi.se."},"dct:identifier":"ce89ba58-f397-47a4-8493-8b5c711fd1ab","dct:issued":{"@type":"xsd:date","@value":"2025-02-19"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Havsströmsdata insamlad med skeppsmonterad Acoustic Doppler Current Profiler (ADCP) i svenska och angränsande vatten."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923_b3n0"}}],"@id":"urn:source:b5ac79744d830bd467ab31940a7de14af5a7e6858474b56fb1cbe44848c17923"},{"@graph":[{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,24 69,24 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.69 62.05)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913c