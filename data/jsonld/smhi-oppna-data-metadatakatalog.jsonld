e":"xsd:date","@value":"2002-01-12"}},{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://www.gbif.se/ipt/resource?r=shark-picoplankton","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-picoplankton"},"dcat:downloadURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-picoplankton"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b0n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/9d401958-4726-4a0c-b248-5218995f5e9d","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24974"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"http://www.gbif.se/ipt/resource?r=shark-picoplankton"},"dcat:keyword":[{"@language":"sv","@value":"Cyanobakterier"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Plankton"},{"@language":"sv","@value":"Växtplankton"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data samlas in och analyseras enligt riktlinjer från HELCOM och OSPAR: MacIsaac E A and Stockner J G 1993. Enumeration of phototrophic picoplankton by autoflourescence microscopy. In Handbook of methods in aquatic microbial ecology. Kemp P F, Sherr B F, Sherr E B, and Cole J J (eds.) Lewis, Boca Raton. pp. 187-197. Avvikelser från manualen kan förekomma. Information om programmet och metoderna finns på Havs- och vattenmyndighetens webbplats. \n - https://helcom.fi/wp-content/uploads/2020/01/HELCOM-Guidelines-for-monitoring-of-phytoplankton-species-composition-abundance-and-biomass.pdf \n - https://www.ospar.org/documents?d=35398. \n - https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/organisation-och-programomraden/miljoovervakningens-programomrade-kust-och-hav/delprogram-fria-vattenmassan.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Sveriges meteorologiska och hydrologiska institut och Umeå universitet."},"dct:identifier":"9d401958-4726-4a0c-b248-5218995f5e9d","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av picoplankton i Sverige sedan 2002."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6_b3n0"}}],"@id":"urn:source:76b4df8b69e0577b013cc75f27c8d174c91417f85bd8aec296760e6b795c29f6"},{"@graph":[{"@id":"_:76e504b9f0dba9baef0a8310acda0b87f9c3de98cc407126f755191f4e535f75_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5 69,22 69,22 55,5 55,5 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.45 62.19)"},"dcat:endDate":{"@type":"xsd:date","@value":"2016-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2016-01-01"}},