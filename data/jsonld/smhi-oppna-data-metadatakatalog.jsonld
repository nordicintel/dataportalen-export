/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:ed2624952e926fc603ac488bd0986d5801e697073c194ac49ee783a4dfaca577_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:ed2624952e926fc603ac488bd0986d5801e697073c194ac49ee783a4dfaca577_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/ee32d342-c9bd-41ae-8eb7-75b9307cf491","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27804"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SMHI sammanställde 1994 &#x2013; 1995 ett register med information om 5 280 dammar. Registret baserades på en inventering som länsstyrelserna utförde på 1980-talet. Dammarna var lägesbestämda och kunde redovisas som punkter på en karta. Drivkraften till skapandet av detta dammregister var främst behovet av ett underlag för utredningar om dammsäkerhet.\nKartskiktet med dammar som 2013 lades in i databasen SVAR, Svenskt vattenarkiv vid SMHI, anpassades mer till användning för bedömning av påverkan på vattenmiljön. Begreppen dammenheter och dammanläggningar infördes och kopplades till sjöar, vattendrag och flödesnätverk i SVAR. Det nya dammregistret skapades med hjälp av länsstyrelserna och Havs- och Vattenmyndigheten.","dcat:distribution":[{"@id":"https://opendata-download-hydrography.smhi.se/api/version/latest/spec/inspire-hyp/element/dow.json"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DamOrWeir/HY.PhysicalWaters.ManMadeObject/ows?service=WFS&request=GetFeature&typeNames=HY.PhysicalWaters.ManMadeObject&outputFormat=SHAPE-ZIP&srsName=EPSG:3006&format_options=charset:utf-8"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DamOrWeir/HY.PhysicalWaters.ManMadeObject/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DamOrWeir/HY.PhysicalWaters.ManMadeObject/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten består av dammpunkter med unik identitet. En delmängd av dammarna har också namn. Uppgifterna om dammarna har inrapporterats till SMHI av länsstyrelserna.  \n\nDokumentation av produkten : Länk kommer inom kort!\n\nBaserad på  SVAR2013."},"dct:identifier":"ee32d342-c9bd-41ae-8eb7-75b9307cf491","dct:issued":{"@type":"xsd:date","@value":"2017-02-08"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:ed2624952e926fc603ac488bd0986