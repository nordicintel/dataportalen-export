"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9d8a1894-9f6c-4d74-9d2e-d481f8737ced","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"35254"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Prognosmodellen använder fysikaliska lagar, t ex rörelseekvationer, termodynamiska samband, strålnings- och kontinuitetsekvationer för att beräkna vädrets förändring i ett antal tidssteg framåt i tiden.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/5"},{"@id":"https://opendata-view.smhi.se/grid-archive/arome_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/arome"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller historiska modelldata från prognosmodellen Harmonie-Arome. Enbart data från första tidssteget, +0 timmar, har valts ut för respektive modellkörning. Gällandetid för datasetet är samma tid som starttiden för prognoskörningen.\n\nHarmonie-Arome är en numerisk prognosmodell som beräknar vädrets utveckling framåt i tiden i tre dimensioner. Harmonie-Arome utvecklas i ett internationellt samarbete och versionen som SMHI använder bygger på ett samarbete mellan nordiska och baltiska länder.\n\nEn numerisk väderprognos utgår från en analys av utgångsläget, en bästa beskrivning av atmosfären i tre dimenstioner byggd på observationer och tidigare modellkörning. Analysen görs för att på bästa sätt interpolera observationer och tidigare modellkörning till ett tredimensionellt rutnät som modellen kan köra sina fysikaliska beräkningar på. Det rutnät som modellen använder idag har 2.5 x 2.5 km horisontell upplösning och vertikalt finns det 65 modellnivåer av samma horisontella rutnät med lägsta nivå nära markytan. På detta rutnät beräknas fysikaliska parametrar varav en del prognostidssteg skrivs ut som meteorologiska prognoser eller analyser på datafiler. Den meterolologiska modellen körs i sin nuvarande konfiguration varje timme med lite olika inställningar och prognoslängder upp till knappt tre dygn skrivs ut på fil.\n\nI detta flöde finns ett mindre urval av parametrar, främst på eller strax över marknivån, tillgängligt med nya data var 6:e timme. Exempel på parameterar är molnighet, temperatur, nederbördsmängd, marktryck samt vindhastighet och vindriktning. Allt detta har betydelse för vädrets utveckling.\n\nAROME-analysen har gjorts över ett område som täcker Skandinavien, norra delen av kontinenten och de baltiska staterna. Med anledning av att Finland nu går med i MetCoop-samarbetet så kommer området att utökas i östlig och västlig riktning. Dessutom tillkommer ett antal nya parametrar för att möta FMIs behov. Denna förändring gäller från och med den 6 september 2017. \n\nKOORDINATER för nya området ges av hörnen:\nSydvästra 51.85N 0.24E\nNordvästra 71.91N 15.32W\nSydöstra 51.47N 32.18E\nNordöstra 71.16N 49.61E\n\nGridrutorna är 2.5 x 2.5 km\n\nKOORDINATER före den 6 september:\nSydvästra 52.04N 1.64E\nNordvästra 72.30N 12.72W\nSydöstra 52.04N 28.36E\nNordöstra 72.30N 42.72E\n\nANVÄNDNING\nPå SMHI används AROME som underlag för prognoser i radio och TV. Den används också för prognoser till kommersiella kunder som olika tidningar och kommuner. Data från AROME kan även användas som indata till andra modeller. Det gäller såväl meteorologiska som hydrologiska och oceanografiska.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på \nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"9d8a1894-9f6c-4d74-9d2e-d481f8737ced","dct:issued":{"@type":"xsd:date","@value":"2014-03-20"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk prognosmodell (AROME) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/5","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/5"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/5"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafeed"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive/arome_extent/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive/arome_extent/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive/arome_extent/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för AROME"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:10f07d8d413722c20b63fdf24cacbd7f89c47def1bf5529ddab3a47c7362aecb_b2n0"},"dct:title":{"@language":"sv","@value":"Omskrivande rektangel för täckningsområdet"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/arome","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/arome"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/arome"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https:/