kor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9409cb12-20c0-4b39-9131-aded01b7ba85","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29517"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Modellens kartläggning av vädret bygger på observationer från vanliga väderstationer, men också från Trafikverkets stationer, data från väderradar och satellit. Som startvärde (initialtillstånd) används ofta en prognos från en numerisk vädermodell gällande vid observationstidpunkten. Denna bygger i sin tur på tidigare observationer och modifieras i MESAN för att stämma bättre med de aktuella observationerna.  Metoden som används kallas Optimal Interpolation och bygger på statistiska samband över hur informationsinnehållet i observationer avtar som funktion av avståndet från observationsplatsen. Med hjälp av detta samband kan flera observationer vägas samman till ett medelvärde som gäller för en så kallad gridruta. I MESAN är dessa cirka 2.5 gånger 2.5 km.","dcat:distribution":[{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/multipoint/time/20250904T060000Z/parameter/air_temperature/data.json?with-geo=false"},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/point/lon/16/lat/58/data.json"},{"@id":"https://opendata.smhi.se/metanalys/mesan2gv3"}],"dcat:keyword":[{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnhöjd"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Nederbördstyp"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Mesan är en analysmodell som skapas automatiskt en gång i timmen. Modellen består av analysvärden utlagda i ett grid (fält).  Avståndet mellan gridpunkterna är ca 2,5 km.\n\nDenna meteorologiska analysmodell beskriver det aktuella väderläget för gridrutor som täcker Sverige. Varje timme under dygnet görs en tvådimensionell kartläggning av vanliga väderparametrar. Vilka dessa är varierar något över dygnet. I huvudsak beskriver de meteorologiska förhållanden som temperatur, nederbörd, moln, sikt, luftfuktighet, vind och snö.\n \nMESAN-data kan erhållas via två olika frågor mot ett API. Den ena frågan ger MESAN- data för en punkt i taget. I länken kan du ange valfri latitud och longitud inom det geografiska området, se koordinater.\n\nAPIet returnerar data från närmaste gridpunkt inom detta område. Ett exempel på anrop med valda koordinater är:  \nhttps://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/point/lon/16/lat/58/data.json \n\nKOORDINATER:\nKoordinater för SNOW-området ges av hörnen:\nSydvästra\t50.32\t0.28\nNordvästra\t72.76\t-18.12\nNordöstra\t71.58\t54.24\nSydöstra\t49.77\t33.03\n\nGridrutorna är ca 2,5 km.\n\nANVÄNDNING:\nMESAN-data används på SMHI för att göra väderkartor som meteorologen har som underlag i prognosverksamheten. Om observationer saknas kan analyserade värden ibland ersätta dessa. MESAN-data används också som indata till andra modeller, till exempel för att beräkna avrinningen i våra vattendrag eller för att kartlägga risken för bränder i skog och mark.\n\nFORMAT:\nData levereras i JSON-format.\n\nInformation om tjänsten och dess parametrar, inklusive koder för vädersymboler, finns här på https://opendata.smhi.se/metanalys/mesan2gv3."},"dct:identifier":"9409cb12-20c0-4b39-9131-aded01b7ba85","dct:issued":{"@type":"xsd:date","@value":"2025-08-19"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-13"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk analys - API"}},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/multipoint/time/20250904T060000Z/parameter/air_temperature/data.json?with-geo=false","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/multipoint/time/20250904T060000Z/parameter/air_temperature/data.json?with-geo=false"},"dcat:downloadURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/multipoint/time/20250904T060000Z/parameter/air_temperature/data.json?with-geo=false"},"dct:description":{"@language":"sv","@value":"SMHIs analys-API, en parameter för hela Sverige. Tjänsten är ett API som ger ett svar i json-format för en parameter och hela Sverige. Observera att \"time\" måste justeras för att länken ska fungera."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b1n0"},"dct:title":{"@language":"sv","@value":"API, multipoint"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/point/lon/16/lat/58/data.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/point/lon/16/lat/58/data.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/mesan2g/version/3/geotype/point/lon/16/lat/58/data.json"},"dct:description":{"@language":"sv","@value":"SMHIs analys-API, alla parametrar för en punkt. Tjänsten är ett API som ger ett svar i json-format för en geografisk punkt i taget."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8b979fcc944b8cdb422ca16fdb0011468067aa7e4ac05f8fd0354aed5c663ff2_b2n0"},"dct:title":{"@language":"sv","@value":"API, punktdata"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/metanalys/mesan2gv3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/metanalys/mesan2gv3"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/metanalys/mesan2gv3"},"dct:description":{"@language":"