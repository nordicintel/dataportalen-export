al.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2cdaac6d-e9eb-4857-a44f-b07521a18afd","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32957"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Nederbörden mäts automatiskt med givare av märket Geonor se https://www.geonor.no. En hink som samlar nederbörden är upphängd med tre metalltrådar varav en är fäst i givaren. Nederbördens vikt mäts och mängden beräknas. Timvisa mätningar infördes 1995.  Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/regn/hur-mats-nederbord. När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt ca 2 timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.  I SMHIs observationsnät ingår stationer som ägs av Försvarsmakten och står på deras flygplatser. De har en optisk givare som genom mätning av nederbördsintensitet kan beräkna nederbördsmängd.  Denna givare har inte samma mätnoggrannhet som givaren från Geonor.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-7.atom"},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/7.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_momentan_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationHourlySum"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för klimatstudier och prognosverifikation.\n\nEnhet: mm \n\nEgenskaper: Nederbörd uppmätt vid automatiska mätstationer, ackumulerat värde under en timme. Nederbörden mäts i smält form.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: >=0 \n\nFör mer info se: https://www.smhi.se/data/meteorologi/nederbord"},"dct:identifier":"2cdaac6d-e9eb-4857-a44f-b07521a18afd","dct:issued":{"@type":"xsd:date","@value":"2013-09-16"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Nederbörd timvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-7.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-7.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-7.atom"},"dct:description":{"@language":"sv","@value":"Nedladdning av data (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b1n0"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/7.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/7.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/7.json"},"dct:description":{"@language":"sv","@value":"API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b2n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_momentan_view/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_momentan_view/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_momentan_view/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) nederbörd timvärde"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b3n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst nederbörd timvärde"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationHourlySum","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationHourlySum"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationHourlySum"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b4n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning av data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b5n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e_b6n0"}}],"@id":"urn:source:8812030d6ad90682387a241ac1c84d466d8a79c42ac391cda735fba1f6d89f3e"},{"@graph":[{"@id":"_:8abeabae6977995c64f8305f0a50ce98881ca61ab47e8bb5b25bd1f19a8ed5