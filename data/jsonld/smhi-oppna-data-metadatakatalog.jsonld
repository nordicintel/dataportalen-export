":"_:292b26a43c8ad7fdb0ae36e6f90c1f762ea1248833860d0a7864a6dbb3bc711c_b5n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/8cbb2fe0-f755-11ea-ac97-ab810184d520","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28129"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Vattenståndstationer är idag av två typer, dels med givare placerade i en speciell byggnad (mareograf) i en brunn som står i förbindelse med havet via ett rör och dels kajkants-stationer där rör är monterade direkt vid vattnet. Sedan två år tillbaka används radarsensorer (Vega). Tidigare system var analoga, där en flottör ansluten till ett måttband registrerade höjder. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/inspire/meansealevel.xml"},{"@id":"https://opendata-view.smhi.se/SMHI_MeanSeaLevel/OF.MultiPointObservation/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/hfa_coord/BOOS/dbkust/mwreg_MW_2024.pdf"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Årets medelvattenstånd används som referensnivå när vattenstånd anges relativt medelvattenståndet. När medelvattenståndet beräknas filtreras mellanårsvariationer och långsamma trender som global havsnivåförändring och landhöjning bort. Årets medelvattenstånd är inte samma sak som årsmedelvärdet. \n\nFör mer info se: \nhttps://www.smhi.se/kunskapsbanken/oceanografi/vattenstand-i-havet/arets-medelvattenstand\n\nLeverans: Data levereras på två olika sätt\n1. Som en PDF som kan hittas på https://www.smhi.se/data/hav-och-havsmiljo/havsvattenstand.\n2. Via en maskin-maskin-lösning (Atomflöde). Datamängden är här Inspireanpassad."},"dct:identifier":"8cbb2fe0-f755-11ea-ac97-ab810184d520","dct:issued":{"@type":"xsd:date","@value":"2020-09-15"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:292b26a43c8ad7fdb0ae36e6f90c1f762ea1248833860d0a7864a6dbb3bc711c_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:292b26a43c8ad7fdb0ae36e6f90c1f762ea1248833860d0a7864a6dbb3bc711c_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Medelvattenstånd"}},{"@id":"https://opendata-download-ocobs.smhi.se/inspire/meansealevel.xml","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/inspire/meansealevel.xml"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/inspire/meansealevel.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:292b26a43c8ad7fdb0ae36e6f90c1f762ea1248833860d0a7864a6dbb3bc711c_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av inspireanpassad GML"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_MeanSeaLevel/OF.MultiPointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_MeanSeaLevel/OF.MultiPointObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_MeanSeaLevel/OF.MultiPointObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{