.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:98e57f3461bf73482fed66789b7d0151fab92763f1ca2a58631f86620d557ede_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:98e57f3461bf73482fed66789b7d0151fab92763f1ca2a58631f86620d557ede_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2205ecf4-647b-4ca0-b7b4-50e3199932b9","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30686"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Havsvattenstånd mäts nu med givare placerade i mätstationer vid kusten. Historiskt utfördes mätningarna först med hjälp av registrerande peglar med pappersdiagram och senare med så kallade potentiometerpeglar kopplade till automatstationer. I dagsläget används tre olika typer av givare anslutna till en automatstation; vinkelgivare kopplade till flottör och lod i en pegelbrunn, bubbelpegel och radarnivågivare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. För just havsvattenstånd görs dessutom noggrannare kontroller samt ifyllning av luckor. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-6.atom"},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/6.json"},{"@id":"https://opendata-view.smhi.se/oc-obs-seawaterlevelhourvalues/OF.PointObservation/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelrh2000"}],"dcat:keyword":[{"@language":"sv","@value":"Havsvattenstånd"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Analysera trender, landhöjning och havsnivåhöjning.\n\nEnhet: cm\n\nEgenskaper: Havsvattenståndet i höjdsystemet RH2000 (Sveriges nya nationella höjdsystem). Ett momentant mätvärde per timme. Stationer som mäter kan hittas på https://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/stationslista-vattenstand.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: Både >0 och <0.\n\nFör mer info se: https://www.smhi.se/data/oceanografi/havsvattenstand"},"dct:identifier":"2205ecf4-647b-4ca0-b7b4-50e3199932b9","dct:issued":{"@type":"xsd:date","@value":"2012-12-12"},"dct:modified":{"@type":"xsd:date","@value":"2022-08-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:98e57f3461bf73482fed66789b7d0151fab92763f1ca2a58631f86620d557ede_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:98e57f3461bf73482fed66789b7d0151fab92763f1ca2a58631f86620d557ede_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havsvattenstånd RH2000, timvärde"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-6.atom","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-6.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-6.atom"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:98e57f3461bf73482fed66789b7d0151fab92763f1ca2a58631f86620d557ede_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning (ATOM)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/6.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/6.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/6.json"},"dct:description":{"@language":"sv","@v