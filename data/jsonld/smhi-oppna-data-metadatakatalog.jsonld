8774025daa450f2d6bcabb1cd2870ade5a7903dcf85629b365042ba48a1d9d_b8n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/62565a7f-7b2f-44e8-99b6-fc49457fa48a","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"36190"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Prognosmodellen använder fysikaliska lagar, t ex rörelseekvationer, termodynamiska samband, strålnings- och kontinuitetsekvationer för att beräkna vädrets förändring i ett antal tidssteg framåt i tiden.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/10"},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/10.json"},{"@id":"https://opendata-view.smhi.se/grid-archive/meps_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata.smhi.se/gridarchive/index_met"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/meps"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller historiska modelldata från prognosmodellen MEPS. Enbart data från första tidssteget, +0 timmar, har valts ut för respektive modellkörning. Gällandetid för datasetet är samma tid som starttiden för prognoskörningen.\n\nMEPS är en numerisk prognosmodell som beräknar vädrets utveckling framåt i tiden i tre dimensioner. MEPS utvecklas i ett internationellt samarbete och versionen som SMHI använder bygger på ett samarbete mellan nordiska och baltiska länder.\n\nEn numerisk väderprognos utgår från en analys av utgångsläget, en bästa beskrivning av atmosfären i tre dimenstioner byggd på observationer och tidigare modellkörning. Analysen görs för att på bästa sätt interpolera observationer och tidigare modellkörning till ett tredimensionellt rutnät som modellen kan köra sina fysikaliska beräkningar på. Det rutnät som modellen använder idag har 2.5 x 2.5 km horisontell upplösning och vertikalt finns det 65 modellnivåer av samma horisontella rutnät med lägsta nivå nära markytan. På detta rutnät beräknas fysikaliska parametrar varav en del prognostidssteg skrivs ut som meteorologiska prognoser eller analyser på datafiler. Den meterolologiska modellen körs i sin nuvarande konfiguration varje timme med lite olika inställningar och prognoslängder upp till knappt tre dygn skrivs ut på fil.\n\nI detta flöde finns ett mindre urval av parametrar, på eller strax över marknivån, tillgängligt med nya data var 3:e timme. Exempel på parameterar är molnighet, temperatur, nederbördsmängd, marktryck samt vindhastighet och vindriktning. Allt detta har betydelse för vädrets utveckling.\n\nMEPS-analysen har gjorts över ett område som täcker Skandinavien, norra delen av kontinenten och de baltiska staterna.\n\nKOORDINATER för området ges av hörnen:\nSydvästra 51.85N 0.24E\nNordvästra 71.91N 15.32W\nSydöstra 51.47N 32.18E\nNordöstra 71.16N 49.61E\n\nGridrutorna är 2.5 x 2.5 km\n\nANVÄNDNING\nPå SMHI används MEPS som underlag för prognoser i radio och TV. Den används också för prognoser till kommersiella kunder som olika tidningar och kommuner. Data från MEPS kan även användas som indata till andra modeller. Det gäller såväl meteorologiska som hydrologiska och oceanografiska.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på \nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"62565a7f-7b2f-44e8-99b6-fc49457fa48a","dct:issued":{"@type":"xsd:date","@value":"2026-10-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:708774025daa450f2d6bcabb1cd2870ade5a7903dcf85629b365042ba48a1d9d_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:708774025daa450f2d6bcabb1cd2870ade5a7903dcf85629b365042ba48a1d9d_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk prognosmodell (MEPS) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/10","@type":["dcat:Distribution",