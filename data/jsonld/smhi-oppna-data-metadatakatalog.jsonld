opa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Dataserier i Excelformat med normalvärden för olika normalperioder.\n\nFilerna innehåller månads- och årsmedelvärden för varje observationsstation. Stationerna anges med sitt klimatnummer.\n\nFör mer info se https://www.smhi.se/kunskapsbanken/klimat/normaler."},"dct:identifier":"befa8e19-d2dc-4f6c-9c7c-be34e0c413cf","dct:issued":{"@type":"xsd:date","@value":"2015-06-15"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:2c5c19f72475794bc27fc677dfa38aed8802d07758f56a89570469c62bafc405_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:2c5c19f72475794bc27fc677dfa38aed8802d07758f56a89570469c62bafc405_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologiska observationer - Normalvärden"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/dataserier-med-normalvarden-for-perioden-1961-1990","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/dataserier-med-normalvarden-for-perioden-1961-1990"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/dataserier-med-normalvarden-for-perioden-1961-1990"},"dct:description":{"@language":"sv","@value":"1961-1990"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2c5c19f72475794bc27fc677dfa38aed8802d07758f56a89570469c62bafc405_b1n0"},"dct:title":{"@language":"sv","@value":"Dataserier med normalvärden för perioden 1961-1990"},"http: