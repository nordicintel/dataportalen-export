s#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b5n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b7n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/c4e0f85c-6637-488b-8d96-080e6d680d1c","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27713"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Produkten baseras på delavrinningsområden som började skapas 1980. \nVattendelare och områden som täckte hela Sverige fanns digitalt lagrat 1991. Det lagret har byggts på och delats upp i flera områden. \n\nVattendelare har uppdaterats vid behov och med hjälp av bättre information om höjd och flödesriktning.\n\nData lagras sedan 2007 i en geodatabas - SVAR (=Svenskt Vattenarkiv) vid SMHI. \nUnder perioden 2007 till 2016 har antalet delavrinningsområden i databasen ökat från drygt 17 000 till mer än 55 000. \n\nI SVAR version 2010 fanns det drygt 37 000 polygoner i kartskiktet med delavrinningsområden men då ingick inga andra öar i havet än Gotland, Öland, Orust och Tjörn. \n\nTill version 2012_2 inkluderades även mindre öar i havet, vilket innebar att antalet polygoner i kartskiktet ökade till drygt 50000.","dcat:distribution":[{"@id":"https://opendata-download.smhi.se/svar/Avrinningsomraden_2016.zip"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2016/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Huvudavrinningsomraden_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Huvudavrinningsomraden_2016/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Ett avrinningsområde är det område från vilket vatten dräneras uppströms en viss punkt. Avrinningsområdet begränsas av höjdryggar, som delar flödet från regn och smältvatten åt olika håll. Gränsen för avrinningsområdet utgörs av vattendelaren. För ett avrinningsområde kan vattenföringen i utloppsplatsen beräknas med hjälp av information om områdets area, mark, sjöar, vattendragslängder, nederbörd, avdunstning, snömagasinering m.m. \n\nEtt huvudavrinningsområde definieras av att det har sin mynning i havet och att det har en areal som är minst ca 200 km². \n\nMed delavrinningsområden avses oftast den finaste indelningen i avrinningsområden men ordet delavrinningsområde kan i princip betyda en godtycklig del av ett större avrinningsområde.\n\nProdukten huvudavrinningsområden som baserar sig på version SVAR 2016:8, innehåller 232 polygoner som representerar de svenska huvudavrinningsområdena och kustområdena mellan dem, samt delar av de norska huvudavrinningsområdena.\n\nProdukten delavrinningsområden som baserar sig på version SVAR 2016:8, innehåller 53538 polygoner som representerar svenska delavrinningsområden och svenska öar i havet.\n\nEn delmängd av de norska och finska delavrinningsområdena finns också med i produkten.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2016_8.pdf"},"dct:identifier":"c4e0f85c-6637-488b-8d96-080e6d680d1c","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2024-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b0n0"},"dct:title":{"@language":"sv","@value":"Huvud- och delavrinningsområden (SVAR2016)"}},{"@id":"https://opendata-download.smhi.se/svar/Avrinningsomraden_2016.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/Avrinningsomraden_2016.zip"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/Avrinningsomraden_2016.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdning, huvud- och delavrinningsområden, SHAPE-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2016/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2016/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2016/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, delavrinningsområden (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:03ae1140d732e11413b9c0fe160fc5758b4fe5e83fbd810ee3b6664893dffe85_b2n0"},"dct:title":{"@language":"sv","@value":"Nedladdnin