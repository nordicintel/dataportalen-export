://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bb79c7e0-b14d-11ea-8f8b-197eadf2f6fe","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29735"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Data representerar en visuell tolkning av rådande isläge baserat på vid analystillfället tillgängligt underlag. Osäkerheten i datamängden beror således på underlagets kvalitet och omfattning och kan inte kvantifieras.","dcat:distribution":[{"@id":"https://opendata-download-icemap.smhi.se/api"},{"@id":"https://opendata-download-icemap.smhi.se/inspire.xml"},{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/seaice/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata.smhi.se/icemaps/api"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Is"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Denna produkt är skapad med hjälp av data från EU Copernicus Marine Services.\n\nDatamängden innehåller karta över isläget i Östersjön. Analysen är baserad på satellitdata och in-situ observationer, och är manuellt producerad i en GIS-programvara.\nDataformat är ESRI shapefil med följande attributuppsättning:\n\niceact (iskoncentration i tiondelar)\n01 - Open Water (<1/10)\n10 - 1/10\n20 - 2/10\n30 - 3/10\n40 - 4/10\n50 - 5/10\n60 - 6/10\n70 - 7/10\n80 - 8/10\n90 - 9/10\n91 - 9+/10\n92 - 10/10\n98 - Ice Free\n\nicetck (medeltjocklek i cm) \nicemax (maximal tjocklek i cm)\nicemin (minimumtjocklek i cm)\n\ntype (istyp enligt WMO standard)\n0 - Ice Free\n1 - Open Water\n2 - Very Open Ice\n3 - Open Ice\n4 - Close Ice\n5 - Very Close Ice\n6 - Consolidated Ice\n7 - Level Ice\n8 - Fast Ice\n9 - New Ice\n10 - Rotten Ice\n\ndeformatio (deformationsgrad)\n0 - No Deformation\n1 - Rafted Ice\n2 - Slightly Ridged Ice\n3 - Moderately Ridged Ice\n4 - Heavily Ridged Ice\n5 - Brash Ice Barrier\n\n\npublicatio (publikationsdatum YYYY-MM-DD hh:mm:ss, UTC)\n\nchartdate (kartans gällandedatum, YYYY-MM-DD)"},"dct:identifier":"bb79c7e0-b14d-11ea-8f8b-197eadf2f6fe","dct:issued":{"@type":"xsd:date","@value":"2018-01-12"},"dct:modified":{"@type":"xsd:date","@value":"2020-09-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:871fbaa6d8f22675b75680b39967899571c33c026ceb8189dd38cb0fd4112396_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:871fbaa6d8f22675b75680b39967899571c33c026ceb8189dd38cb0fd4112396_b0n0"},"dct:title":{"@language":"sv","@value":"SE.SR Analyskarta havsis"}},{"@id":"https://opendata-download-icemap.smhi.se/api","@type":["dcat:Distribution","http://entryscape.