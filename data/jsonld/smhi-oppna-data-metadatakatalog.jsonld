a.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9b3f5763-88b7-4bcc-8818-c4ea120ecfd7","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30565"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SVAR 2022 baserar sig på ett helt nytt underlag: Hydrografi nedladdning i skala 1:10 000, Markhöjdmodell Nedladdning konverterad till 10 m upplösning, framtaget av Lantmäteriet samt Nationell djupmodell i 10m upplösning, framtagen av SGU.\nUtifrån grundprinciperna: sjöar med en area > 0,5 km2 samt vattendrag med tillrinningsområde > 10 km2 har förslag till vattenförekomsterna tagits fram för inlandsvatten. För kustvatten har samma indelning som tidigare cykler varit målet men med nya gränser baserat på detaljerad djupinformation.\nDessa har, tillsammans med länsstyrelserna, granskats och korrigerats i omgångar under perioden 2021 till 2023. Vattenförekomsternas utlopp, tillsammans med mätstationer i SMHI:s grundnät samt ett ytterligare urval av mätstationer och dammar, har sedan legat till grund för framtagning av delavrinningsområden. Dessa har aggregerats till huvudavrinningsområden.","dcat:distribution":[{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/rb"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata.smhi.se/hydrography/api"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"River basin districts (Water Framework Directive)"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten SE.HY Huvudavrinningsområden består av polygoner som representerar de huvudavrinningsområden som mynnar i Sverige.\n\nEtt huvudavrinningsområdes ursprungliga definition bestod av områden som har sin mynning i havet och uppmäter en areal av minst 200 km². Det nya underlaget uppfyller inte alltid det ursprungliga storlekskriteriet, men eftersom indelningen av huvudavrinningsområden är allmänt vedertagen så har den bibehållits, fast med uppdaterade gränser.\n\nProdukten SE.HY Huvudavrinningsområden baseras på version SVAR 2022:1.2 och innehåller polygoner som representerar de svenska huvudavrinningsområdena.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2022_1_2.pdf\n\nMer information om hur du använder nedladdningstjänsten hittar du på https://opendata.smhi.se/hydrography/api.\n\nWFS-tjänsten kan i ett GIS-verktyg sparas ner i annat filformat genom att ta in WFS-lagret i ett projekt eller en arbetsyta och från lagret använda funktionen exportera eller motsvarande."},"dct:identifier":"9b3f5763-88b7-4bcc-8818-c4ea120ecfd7","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b0n0"},"dct:title":{"@language":"sv","@value":"SE.HY Huvudavrinningsområden (SVAR2022)"}},{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/rb","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/rb"},"dcat:downloadURL":{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/rb"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, ATOM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning, ATOM"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wfs?service=wfs&request=getcapabilities","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, WFS"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b2n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning, WFS"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten_RiverBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Huvudavrinningsområden visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:77c07d1d6f2d494fb5bdc639fe389c072c6ce454f7ad68231d1cde5542f95e9e_b3n0"},"dct:title":{"@language":"sv","@value":"Huvudavrinningsområden visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/hydrography/api","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/hydrography/api"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/hydrography/api"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu