d075956650c53e97192aad8c47aedb107_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/7ef0a848-a7c0-4078-9604-da90978cfb87","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"31123"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Havstemperatur mäts nu med givare placerade på bojar i havet, mätstationer vid kusten och färjor som trafikerar Sveriges omgivande hav. Historiskt utfördes mätningarna vid manuella stationer, vid kusten och i fyrkasuner. Havstemperatur mättes med kvicksilvertermometer under hela  mätperioden 1860-1972. Vid kassunfyrar och äldre bojar (1978-2004)  användes en PT100-givare. För modernare bojar (2001-) har ett  CTD (Conductivity Temperature Depth) instrument använts. I dagsläget används olika typer av elektriska sensorer som pt100, pt1000, termistorer etc. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-5.atom"},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/5.json"},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaTemperature/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/seatemperature"}],"dcat:keyword":[{"@language":"sv","@value":"Havstemperatur"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera havets temperatur, förbättra havscirkulationsmodeller och stöd inom istjänsten.\n\nEnhet: °C.\n\nEgenskaper: Vattnets temperatur, insamlat från fartyg (ferrybox-system), havspeglar vid kusten eller bojar. Mätning en gång per timme.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: Ungefär mellan -3 och +30 grader C.\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/oceanografi/haven-runt-sverige/temperatur-i-havet"},"dct:identifier":"7ef0a848-a7c0-4078-9604-da90978cfb87","dct:issued":{"@type":"xsd:date","@value":"2012-12-12"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havstemperatur"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-5.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-5.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-5.atom"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b1n0"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/5.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/5.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/5.json"},"dct:description":{"@language":"sv","@value":"API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b2n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaTemperature/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaTemperature/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaTemperature/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:dd28c0deeda2b4fc4d144a01576512fd075956650c53e97192aad8c47aedb107_b3n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst (WMS)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/seatem