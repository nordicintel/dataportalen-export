illkor-for-anvandning"}},{"@id":"_:2b1ad4593c692d016d2a2b7eb703bb5ab85fb8cc3eeac7b5dce206aeef85063b_b9n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/90a1b29c-5a9f-4bc4-b26a-3d08611c0940","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"38401"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SVAR 2022 baserar sig på ett helt nytt underlag: Hydrografi nedladdning i skala 1:10 000, Markhöjdmodell Nedladdning konverterad till 10 m upplösning, framtaget av Lantmäteriet samt Nationell djupmodell i 10m upplösning, framtagen av SGU.\nUtifrån grundprinciperna: sjöar med en area > 0,5 km2 samt vattendrag med tillrinningsområde > 10 km2 har förslag till vattenförekomsterna tagits fram för inlandsvatten. För kustvatten har samma indelning som tidigare cykler varit målet men med nya gränser baserat på detaljerad djupinformation.\nDessa har, tillsammans med länsstyrelserna, granskats och korrigerats i omgångar under perioden 2021 till 2023. Vattenförekomsternas utlopp, tillsammans med mätstationer i SMHIs grundnät samt ett ytterligare urval av mätstationer och dammar, har sedan legat till grund för framtagning av delavrinningsområden.","dcat:distribution":[{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/db"},{"@id":"https://opendata-download.smhi.se/svar/SVAR2022_delavrinningsomraden.zip"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_NO_FI/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_SE1_INT/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_SE2_INT/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_SE3/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_SE4/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Delavrinningsomraden_2022_SE5_INT/wfs?request=getcapabilities&service=wfs"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten_DrainageBasin/HY.PhysicalWaters.Catchments/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"River basin districts sub-units (Water Framework Directive)"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten SE.HY Delavrinningsområden består av polygoner som representerar avrinningsområden på land och i hav.\n\nDelavrinningsområdena är genererade för alla vattenförekomster, mätstationer i SMHI:s grundnät samt ett ytterligare urval av mätstationer och dammar vilka är viktiga för den hydrologiska modell som används på SMHI, S-HYPE. Genereringen är baserad på en höjdmodell med 10 m upplösning.\n\nNorska och finska delavrinningsområden är hämtade från Norges vassdrags- og energidirektorat (NVE) samt Finlands miljöcentral (Syke) och är till viss del hopslagna för att bättre harmonisera med de svenska. Längs landsgränsen är utländska avrinningsområdena geometriskt justerade efter de svenska delavrinningsområdena.\n\nAlla delavrinningsområden ingår i det logiska nätverket som kopplar delavrinningsområden till varandra efter hur vattnet rinner i naturen.\n\nProdukten delavrinningsområden, som baserar sig på version SVAR 2022:1.2, innehåller polygoner som representerar svenska och delar av norska och finska delavrinningsområden. Tjänsten nedladdning ATOM innehåller endast delavrinningsområden som rinner till eller befinner sig inom Sverige.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2022_1_2.pdf\n\nMer information om hur du använder nedladdningstjänsten hittar du här på https://opendata.smhi.se/hydrography/api."},"dct:identifier":"90a1b29c-5a9f-4bc4-b26a-3d08611c0940","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:2b1ad4593c692d016d2a2b7eb703bb5ab85fb8cc3eeac7b5dce206aeef85063b_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:2b1ad4593c692d016d2a2b7eb703bb5ab85fb8cc3eeac7b5dce206aeef85063b_b0n0"},"dct:title":{"@language":"sv","@value":"SE.HY Delavrinningsområden (SVAR2022)"}},{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/db","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/db"},"dcat:downloadURL":{"@id":"https://opendata-download-hydrography.smhi.se/api/version/2.0/spec/inspire-hyp/element/db"},"dct:description":{"@language":"sv","@value":"Delavrinningsområden. Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2b1ad4593c692d016d2a2b7eb703bb5ab85fb8cc3eeac7b5dce206aeef85063b_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst, ATOM"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download.smhi.se/svar/SVAR2022_delavrinningsomraden.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/SVAR2022_delavrinningsomraden.zip"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/SVAR2022_delavrinningsomraden.zip"},"dct:description":{"@language":"sv","@value":"Delavrinningsområden, Nedladdningstjänst (Geopackage, ZIP)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2b1ad4593c692d016d2a2b7eb703bb