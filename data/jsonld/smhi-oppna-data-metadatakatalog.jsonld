ng"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:8cd3bd5bb0110ebbda8623469910f119444abe49042df97f8429ae9db9a3981c_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:8cd3bd5bb0110ebbda8623469910f119444abe49042df97f8429ae9db9a3981c_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/ca50a382-b50b-4c8e-b3cc-805e3e13ac92","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"33368"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Prognosmodellen använder fysikaliska lagar, t ex rörelseekvationer, termodynamiska samband, strålnings- och kontinuitetsekvationer för att beräkna vädrets förändring i ett antal tidssteg framåt i tiden. De data som presenteras här är vind (horisontellt och vertikalt), temperatur och höjden till s.k. tryckytor i atmosfären. Dessa används för att ge en översiktlig bild av vädret på olika höjd i atmosfären. Lufttrycket vid en viss nivå är lika med tyngden av en lodrät luftpelare, som sträcker sig från nivån upp till atmosfärens övre gräns. Ju högre upp man kommer desto lägre blir lufttrycket. Detta beror alltså på att den ovanliggande luftmängden blir mindre. En låg höjd till en tryckyta kan bero på kallt väder (tung luft gör att trycket minskar snabbt med höjden) men också på en djup cyklon (luften finns någon annanstans).","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/3"},{"@id":"https://opendata-view.smhi.se/grid-archive/hirlam_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/hirlam"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller historiska analysdata från prognosmodellen HIRLAM. Det innebär att endast data för det första tidssteget (nulägesbeskrivningen) har valts ut för respektive tidpunkt. Prognosdata ingår inte.\nData finns t o m 2014-03-18. Därefter ersätts HIRLAM-modellen med den mer högupplösta modellen AROME.\n\nHIRLAM är en numerisk prognosmodell som beskriver vädrets utveckling i tid och rum. \nModellen har utvecklats inom ett internationellt samarbete där de nordiska länderna ingår och dessutom Irland, Nederländerna, Spanien och Litauen.\nPrognosen utgår från hur vädret ser ut vid en viss tidpunkt, det s.k. initialtillståndet. För att kartlägga detta görs en analys av väderläget. Därvid modifieras en tidigare prognos för att stämma bättre med aktuella observationer. Detta görs med en variationell metod.  Därmed kan värdet av de olika prognosparametrar bestämmas i ett rutnät. För närvarande är dessa rutor 11 x 11 km i horisontell utsträckning och atmosfären har delats in i 60 vertikala nivåer. \n\nFyra prognoser görs per dygn och varje prognos sträcker sig upp till 3 dygn framåt i tiden. Var 6:e timme under dygnet görs en tredimensionell kartläggning av olika väderparametrar. Kartläggningen görs för att bestämma förhållanden i marken men inte minst för att beskriva hur det ser ut i atmosfären. Det kan gälla temperatur, fuktighet, vind, lufttryck, molnighet och nederbörd men också av t ex strålningsförhållanden, havsisens utbredning eller vatteninnehållet i snö. Kort sagt, allt som har betydelse för vädrets utveckling.\nDe data som presenteras här har dock begränsats till vind (horisontellt och vertikalt), temperatur, relativ luftfuktighet och höjden till olika s.k. tryckytor i atmosfären. I övrigt hänvisas till data från MESAN.\nAnalysen görs över ett område som täcker Skandinavien, brittiska öarna, norra delen av kontinenten och de baltiska staterna.\n\nKOORDINATER\nKoordinater för området ges av hörnen:\nSydvästra\t\t48.48N, 12.07W\nnordvästra\t77.0N, 15.1W\nnordöstra\t\t64.56N, 55.24E\nsydöstra\t\t42.6N, 22.7E\n\nGridrutorna är 11*11 km.\n\nANVÄNDNING\nPå SMHI används HIRLAM som underlag för prognoser i radio och TV.  Den används också för prognoser till kommersiella kunder som olika tidningar och kommuner. Data från HIRLAM kan även användas som indata till andra modeller. Det gäller såväl meteorologiska som  hydrologiska och oceanografiska.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"ca50a382-b50b-4c8e-b3cc-805e3e13ac92","dct:issued":{"@type":"xsd:date","@value":"2013-03-18"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:8cd3bd5bb0110ebbda8623469910f119444abe49042df97f8429ae9db9a3981c_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:8cd3bd5bb0110ebbda8623469910f119444abe49042df97f8429ae9db9a3981c_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk prognosmodell (HIRLAM E11) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/3","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/3"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/3"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafeed"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8cd3bd5bb0110ebbda8623469910f119444abe49042df97f8429ae9db9a3981c_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive/hirlam_extent/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive/hirlam_extent/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@i