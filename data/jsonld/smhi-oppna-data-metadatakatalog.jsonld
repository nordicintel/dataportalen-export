:rights":{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b3n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst nederbörd summa 1 månad"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationMonthlySum","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationMonthlySum"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationMonthlySum"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b4n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b5n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b6n0"}}],"@id":"urn:source:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79"},{"@graph":[{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,24 69,24 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.69 62.05)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/hydrology/observation/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/hydrology/observation/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/hydrology/observation/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b0n0"},"dct:title":{"@language":"sv","@value":"Nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/b3880dff-5b0e-4606-91ea-19c70fdcf773","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24293"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Vattenföring beräknas från vattenstånd. Vattenståndet mäts vid en mätstation som kallas pegel. Sambandet mellan vattenstånd och vattenföring kallas avbördningssamband. De första observationerna för vattenföring är från 1800-talet. Först läste en observatör av vattenståndet på en pegelskala (ungefär en stor tumstock) och rapporter skickades in till SMHI en gång i månaden. För ca 100 år sedan började man använda registerande skrivare, sk vattenståndsdiagram. Först under 1950-talet blev diagram vanligare och de manuella avläsningarna började avveckals. Diagrammen skickades in till SMHI en gång i veckan/månaden. Under 1980 började automater och loggar att användas, dessa skickar data till SMHI dagligen automatiskt. Idag används både diagram och automater. SMHI får också in data från externa leverantörer. Data granskas med hjälp av jämförelser med andra stationer samt kontroll mot nederbörd och temperatur. Därefter sätts kvalitetskoder.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/hydrology/observation/"},"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Vattenföring"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller observerad vattenföring, dygnsvärden, från alla stationer inom SMHIs grundnät för de senaste 30 dagarna. Dygnsvärdet är ett medelvärde över perioden 06:00 till 06:00. \nObservationsdata har hämtats från SMHIs observationsdatabas.\nNya filer skapas 5 ggr/d. Data för innevarande dygn fylls på successivt.\n\nParametrar som ingår i filen är:\nq: Observerad vattenföring, enhet m³/s\n\nSom identitet i datamängden har stationens stationsnummer använts.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nGEOGRAFISK INFORMATION\nFör stationernas namn och geografiska plats, se kopplingstabellen (csv) som nås via nedladdningstjänsten. Där finns även en readme-fil som beskriver hur filerna ska användas.\n\nANVÄNDNING\nPå SMHI används hydrologisk observationsdata för den hydrologiska varningstjänsten, prognoser, klimatstudier samt för scenarier för infrastruktur, näringstransporter och översvämningskartering m m.\n\nFORMAT\nData levereras i NetCDF4-format som delvis följer CF conventions CF-1.6 för punktdata. Beskrivning av konventionen finns på \nhttps://cf-pcmdi.llnl.gov/documents/cf-conventions/1.6/cf-conventions.html"},"dct:identifier":"b3880dff-5b0e-4606-91ea-19c70fdcf773","dct:issued":{"@type":"xsd:date","@value":"2014-01-28"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b1n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b1n0"},"dct:title":{"@language":"sv","@value":"Hydrologiska observationer - Vattenföring dygnsvärde realtid"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1_b3n0"}}],"@id":"urn:source:154fd1a61fb8df608624eef53b61a0cbf69738fe9ba16170283c97f14a1900c1"},{"@graph":[{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((3 66,30 66,30 51,3 51,3 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(16.85 58.65)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1987-11-01"}},{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/e1faa8e1-77ad-4716-8266-e3c359e043eb","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"22735"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/ice_smhi.se"},"dcat:dataQuality":"Bedömningen av isförhållandena i farlederna har tidigare huvudsakligen gjorts av isobservatörer (fyrpersonal e dyl) och observationerna har därefter sammanställts av SMHI. I takt med att de lokala observatörernas antal minskat har bedömningen numera nästan helt övergått till att göras av SMHI i samband med den dagliga produktionen av iskartor och israpporter. Utgångsmaterialet är därför högupplöst satellitdata kompletterat med observationer från isbrytare.","dcat:distribution":{"@id":"https://opendata-download.smhi.se/isdata/"},"dcat:keyword":[{"@language":"sv","@value":"Is"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Östersjökoden används för att kortfattat beskriva isförhållandena i farleder, hamnområden och för sjöfarten viktiga passager. Denna datamängd innehåller data för svenska farvatten från och med säsongen 1987/1988 och framåt. Östersjökoden används som tillägg till iskartor och klartextrapporter för att informera sjöfarten om isförhållandena mer i detalj. Östersjökoden är uppbyggd av fyra siffror som representerar iskoncentration, istjocklek, topografi och seglationsförhållanden.\n\nEnhet: Fyrsiffrig kod, se kodtabell i länk nedan.\n\nEgenskaper: Beskriver iskoncentration, istjocklek, topografi och seglationsförhållanden\n\nUtformning: Station (Farled), BSIC (kodsiffran), Datum, Position\n                                                       \nGränser: Se kodtabell\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/oceanografi/is-till-havs/ostersjokoden-for-havsis"},"dct:identifier":"e1faa8e1-77ad-4716-8266-e3c359e043eb","dct:issued":{"@type":"xsd:date","@value":"2015-06-30"},"dct:modified":{"@type":"xsd:date","@value":"2020-05-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b0n0"},"dct:title":{"@language":"sv","@value":"Oceanografiska observationer - Östersjökoden för havsis"}},{"@id":"https://opendata-download.smhi.se/isdata/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/isdata/"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/isdata/"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafiler"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b1n0"},"dct:title":{"@language":"sv","@value":""},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/ice_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ice@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f_b3n0"}}],"@id":"urn:source:182956b59bc4c615b1ceb34e52c87bf8af44bcb6691c42335cac95156590b79f"},{"@graph":[{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 63,19 63,19 56,11 56,11 63))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(14.97 59.46)"},"dcat:endDate":{"@type":"xsd:date","@value":"2022-10-08"},"dcat:startDate":{"@type":"xsd:date","@value":"1992-09-09"}},{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/0c0f6ee9-dd2a-4ec4-a7a2-39806d18995a","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"20963"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-nat"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Information om programmet och metoderna finns på svenska på Havs- och vattenmyndighetens webbplats. \n - Delprogrammet för vegetationsklädda bottnar: https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/organisation-och-programomraden/miljoovervakningens-programomrade-kust-och-hav/delprogram-vegetationskladda-bottnar.html \n - Östkusten: https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/vegetationskladda-bottnar-ostkust.html \n - Västkusten: https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/vegetationskladda-bottnar-vastkust.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Stockholms universitet, Göteborgs universitet och Linn&#xE9;universitetet."},"dct:identifier":"0c0f6ee9-dd2a-4ec4-a7a2-39806d18995a","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av vegetationsklädda bottnar sedan 1992."}},{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-nat"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-epibenthos-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b1n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf_b3n0"}}],"@id":"urn:source:18a4b0b7e994bbd760b3409b83b1f01e7032cb4f78d61b21d2369ae3d74281bf"},{"@graph":[{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/7208622e-70ad-4d30-b972-41e3d254da75","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30194"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Vid manuella stationer bedöms sikten med hjälp av avståndet till olika byggnader eller tydliga formationer i terrängen (t ex höjder). Vid automatiska stationer mäts sikten med en optisk givare som kan mäta ljusets spridning. En begränsning med denna mätmetod är att den mäter i en mycket begränsad luftvolym (någon dm3). Det finns ingen separat beskrivning av mätmetoder och mätfrekvenser för sikt men lite allmän information finns på: https://www.smhi.se/kunskapsbanken/meteorologi/meteorologiska-matningar. I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår.","dcat:distribution":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/12.json"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet.\n\nEnhet: Meter\n\nEgenskaper: Sikten uppmätt eller manuellt bedömd på stationerna. Vid manuell bedömning är det minsta värdet på sikten som anges, om sikten varierar i olika riktningar. Automatiska mätningar ger ett värde för sikten vid stationen.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: >= 0 \n\nFör mer info se: https://www.smhi.se/kunskapsbanken/meteorologi/dimma-och-fuktdis/sikt"},"dct:identifier":"7208622e-70ad-4d30-b972-41e3d254da75","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Sikt, timvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/12.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/12.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/12.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:1ba16b65f6e07376d16b6190e8be5eec404245a13a992ed2ca51eee375320173_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id"