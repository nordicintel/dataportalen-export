er":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bc770960-e8c2-11ec-832f-911b23582b4f","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29571"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Syre är en av de viktigaste gaserna i havet, då den är nödvändig för allt högre liv. Syre kommer till vattnet från luften och genom algers fotosyntes. Syre förbrukas vid nedbrytningsprocesser och i Östersjön och på flera andra ställen råder konstant eller tidvis syrebrist på bottnen och även längre upp i vattenmassan, vilket har en stor påverkan på ekosystemet. Syrgasmätningar i haven runt Sverige har utförts på flera platser och under lång tid, för att undersöka hur halten förändras på kort och lång sikt. Syrgashalten kan mätas på olika sätt. Sedan 1902 har syrgasmätningarna utförts med i princip samma metod, så kallad Winklertitrering på vattenprover. På senare tid har automatmätinstrument utvecklats där syresonder sänks ned genom vattnet, eller monteras på stationär boj för att erhålla tidsserier eller djupprofiler av syrgashalten. Automatmätsystemen servas enligt kvalitetssäkrade metoder och intervall för att säkerställa kvalit&#xE9;, samt verifieras med hjälp av referensjämförelser med prover utförda med Winklertitrering.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/15.json"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/oxygen"}],"dcat:keyword":[{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Syrehalt"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera syrehalten i havet för att få en bättre förståelse av oceanografiska processer, utbredningen av syrefria bottnar samt för att övervaka förändringar över lång tid. Data ska vara tillgängligt för validering och assimilering av interna SMHI-modeller samt tillgängliga för analyser och utredningar internt och externt.\n\nEnhet: Syrehalten utrycks i ml löst syre per liter vatten, ml/l.\n\nEgenskaper: Mått på koncentrationen av syre från olika typer av mätsystem såsom bojar, bottenmätsystem och fartyg (ferrybox). Mätning en gång per timme. Vissa stationer levererar data från flera nivåer under havsytan. För en del stationer kan mer högupplöst data finnas att tillgå men den måste i så fall begäras ut.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: 0 - 10 ml/l\n\nFör mer info:\nhttps://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2013-01-09-syreforhallanden-i-svenska-hav\nhttps://www.smhi.se/kunskapsbanken/oceanografi/havsmiljo/syreforhallanden-i-havet\nhttps://www.smhi.se/kunskapsbanken/oceanografi/havsmiljo/infloden-till-ostersjon"},"dct:identifier":"bc770960-e8c2-11ec-832f-911b23582b4f","dct:issued":{"@type":"xsd:date","@value":"2013-06-03"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Syrehalt"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/15.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/15.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/15.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/oxygen","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/oxygen"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/oxygen"},"dct:description":{"@language":"sv","@value":"Användargränssnitt för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:58665dfee06cdc0d1ae9677aeedcef830337dbb9dd060358f0429c3aa4145801_b2n0"},"dct:title":{"@language":"s