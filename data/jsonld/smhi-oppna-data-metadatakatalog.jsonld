entifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/29d2c7e0-b47e-11ea-8f8b-197eadf2f6fe","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24923"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Kust- och havsområden för hela Sverige publicerades för först gången i rapporten Havsområdesregister 1993, Torbjörn Lindkvist, 1994. \nI rapporten Djupdata för havsområden 2003, Torbjörn Lindkvist et. al., 2003 kompletterades havsområdesindelning ytterligare och djup adderades i form av hypsografer och tvärsnitt mellan havsområdena. Från version 2012_1 har sammanslagningar av bassänger gjorts längs svensk-norska gränsen. Sedan version 2012_2 har vissa förändringar gjorts i samband med att havsbassänger lades in i SVAR enligt havsmiljödirektivet Därefter har havsområdena uppdateras kontinuerligt.","dcat:distribution":[{"@id":"https://opendata-download.smhi.se/svar/Havsomraden_2016.zip"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Havsomraden_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Havsomraden_2016/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"De havsbassängers vattenytor i Östersjön, Öresund, Skagerrak och Kattegatt som representerar områden från strandlinjen ut till 12 nm utanför baslinje utgör kustvatten- och utsjövattenförekomster.\n\nProdukten, som baseras på version SVAR 2016:8, innehåller 681 polygoner som representerar havsytor.\n\nLeveransbeskrivning av havsområden: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2016_8.pdf"},"dct:identifier":"29d2c7e0-b47e-11ea-8f8b-197eadf2f6fe","dct:issued":{"@type":"xsd:date","@value":"2020-06-22"},"dct:modified":{"@type":"xsd:date","@value":"2024-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:85ba040a06f9dd1f3bc2ac5888b94562ba926107efa27a853e16c4df51984935_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:85ba040a06f9dd1f3bc2ac5888b94562ba926107efa27a853e16c4df51984935_b0n0"},"dct:title":{"@language":"sv","@value":"Havsområden (SVAR2016)"}},{"@id":"https://opendata-download.smhi.se/svar/Havsomraden_2016.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/Havsomraden_2016.zip"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/Havsomraden_2016.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:85ba040a06f9dd1f3bc2ac5888b94562ba926107efa27a853e16c4df51984935_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu