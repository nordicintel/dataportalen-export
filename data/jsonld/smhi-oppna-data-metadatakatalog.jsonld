i.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/25076d38-25e6-4ad6-9cb9-878708728f93","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"31135"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Strömriktning mäts nu med givare monterade på bojar i havet. Historiskt utfördes mätningarna vid manuella stationer, vid kusten och i fyrkasuner. Då uppskattades ytström optiskt eller genom in situ mätningar m h a olika handinstrument, t.ex. ett strömkort. I dagsläget används olika typer av enpunktsströmmätare och acoustic doppler current profiler, ADCP-mätare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-2.atom"},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/2.json"},{"@id":"https://opendata-view.smhi.se/oc-obs-currentdirection/OF.PointObservation/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Strömriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera strömmar i havet och förbättra havscirkulationsmodeller. Assimilera och validera modeller som används inom SMHI:s verksamhet t.ex. havscirkulationsmodellen NEMO-Nordic.\n\nEnhet: Grader\n\nEgenskaper: Mått på vattnets riktning från havsbojar. En gång per timme. Vissa stationer levererar data från flera nivåer under havsytan. Noll grader avser att vattnet strömmar mot norr, 90 grader mot öst o s v. Mätdjupet 0 meter representerar ytström.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: 0-360 grader\n\nFör mer info se: https://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2011-09-12-strommar-i-svenska-hav"},"dct:identifier":"25076d38-25e6-4ad6-9cb9-878708728f93","dct:issued":{"@type":"xsd:date","@value":"2012-10-23"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Strömriktning"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-2.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-2.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/inspire/ocobs-2.atom"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst - Inspire"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/2.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/2.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/2.json"},"dct:description":{"@language":"sv","@value":"API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a75d90bfbc50418162c819e2979663c082d7a3071d41076c17df26048a77655f_b2n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/oc-obs-currentdirection/OF.PointObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":