0176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:57d54d25b805487ed45484332565bade6a3ef4a8c49da326e0038bf88da57214_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9c6a50fb-d491-48d2-b94e-d9b43f29470d","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32769"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Temperaturen mäts automatiskt med Pt100 resistanstermometrar, se https://www.pentronic.se. Före 1995 utfördes nästan alla mätningar manuellt med kvicksilver- eller sprittermometer. Automatiska mätningar görs varje timme medan manuella mätningar genomfördes med olika frekvens vid olika stationer. Tre gånger per dygn eller var tredje timme var vanligast. Ett mindre antal manuella stationer mätte varje timme. Beskrivningar av mätmetoder och mätfrekvenser finns på https://www.smhi.se/kunskapsbanken/meteorologi/temperatur/hur-mats-lufttemperatur I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-22.atom"},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/22.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_manad_medel_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/airTemperatureMeanMonth"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver klimatet.\n\nEnhet: °C\n\nEgenskaper: Medelvärde över en månad baserat på dygnsvisa medelvärden. Dygnsmedelvärdet beräknas från mätstationens uppmätta temperaturvärden, med den metod som beskrivs på https://www.smhi.se/kunskapsbanken/klimat/normaler/hur-beraknas-medeltemperatur. Kl. 00 den 1:e varje månad registreras mätvärdet som avser månaden innan. \n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Gult = Aggregerade värden \n\nGränser: -60 till +40 °C\n\nFör mer info se: https://www.smhi.se/data/meteorologi/temperatur"},"dct:identifier":"9c6a50fb-d491-48d2-b94e-d9b43f29470d","dct:issued":{"@type":"xsd:date","@value":"2015-09-02"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:57d54d25b805487ed45484332565bade6a3ef4a8c49da326e0038bf88da57214_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:57d54d25b805487ed45484332565bade6a3ef4a8c49da326e0038bf88da57214_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lufttemperatur, medelvärde 1 månad"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-22.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-22.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-22.atom"},"dct:description":{"@language":"sv","@value":"Nedladdning av data (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:57d54d25b805487ed45484332565bade6a3ef4a8c49da326e0038bf88da57214_b1n0"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/22.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi