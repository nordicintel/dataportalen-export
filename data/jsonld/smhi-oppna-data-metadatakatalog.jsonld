dning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9a81f7579f817c0ed53dea21295fa0f8413ba5681f755048f374349d5a7b015a_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:9a81f7579f817c0ed53dea21295fa0f8413ba5681f755048f374349d5a7b015a_b5n0"}}],"@id":"urn:source:9a81f7579f817c0ed53dea21295fa0f8413ba5681f755048f374349d5a7b015a"},{"@graph":[{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-01-01"}},{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9e3c0b20-cdb2-11eb-9269-d991226864d8","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23347"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Blixtsensordata levereras ofiltrerat från källan. Dessa data innehåller viss osäkerhet och bör därför användas med försiktighet för statistisk bearbetning, då sensornätet för blixtinformationen fortlöpande förändras.","dcat:distribution":{"@id":"https://opendata.smhi.se/lightning/sensordata"},"dcat:keyword":[{"@language":"sv","@value":"Blixt"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Tjänsten levererar information om blixturladdningar i Sverige. När en blixturladdning skett och informationen har nått SMHI, levereras informationen vidare med push-teknik via web-sockets tills de som använder tjänsten.\nFör att tolka det råa sensordatat behöver konsumenten en s.k. \"Total Lightning Processor, TLP\".\n\nTjänstens URL, wss://data-push.smhi.se/mqtt, är ej tillgänglig via webbläsare. Se API-dokumentationen för instruktioner för hur uppkopplingen går till.\n\nLEVERANS: Push-tjänsten för blixtdata nås via webtjänst mot leveransavgift. Data ska sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER: Data levereras för blixtsensorer inom Sverige.\n\nANVÄNDNING: På SMHI används blixtdata inom varningstjänsten och utredningar.\n\nFORMAT: Data levereras i binärformat."},"dct:identifier":"9e3c0b20-cdb2-11eb-9269-d991226864d8","dct:issued":{"@type":"xsd:date","@value":"2021-06-15"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b0n0"},"dct:title":{"@language":"sv","@value":"Blixtsensordata - realtid"}},{"@id":"https://opendata.smhi.se/lightning/sensordata","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/lightning/sensordata"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/lightning/sensordata"},"dct:description":{"@language":"sv","@value":"API-dokumentation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b1n0"},"dct:title":{"@language":"sv","@value":"Blixtsensordata - realtid, API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c_b3n0"}}],"@id":"urn:source:9b120b6c9feb315b85d2c0ef6409b1e05dfc1c03ae0e7a5029f3a90752cf013c"},{"@graph":[{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 66,24 66,24 55,11 55,11 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.28 60.43)"},"dcat:endDate":{"@type":"xsd:date","@value":"2023-12-16"},"dcat:startDate":{"@type":"xsd:date","@value":"1983-02-09"}},{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/76698d34-f686-4d7c-b5f2-e69cba9105ba","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"20836"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-phytoplankton-nat"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data samlas in och analyseras enligt HELCOM Monitoring Guidelines of phytoplankton species composition, abundance and biomass. Avvikelser från manualen kan förekomma. Information om programmet och metoderna finns också på svenska på Havs- och vattenmyndighetens webbplats \n - https://helcom.fi/wp-content/uploads/2020/01/HELCOM-Guidelines-for-monitoring-of-phytoplankton-species-composition-abundance-and-biomass.pdf). \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/vaxtplankton.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Stockholms universitet, Sveriges Meteorologiska och hydrologiska institut, Göteborgs universitet och Umeå universitet."},"dct:identifier":"76698d34-f686-4d7c-b5f2-e69cba9105ba","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:9f2c86b20165fd5b0b9151d6d2fde0b0e75da528bce650fe22a70a5b8ddcf70a_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Natio