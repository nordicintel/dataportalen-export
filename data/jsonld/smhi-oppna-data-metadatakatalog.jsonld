anisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:c3cbbb6baa5d917ba21774124d3a5fe4673d87b6b9fec05f8df2092dd5925de5_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:c3cbbb6baa5d917ba21774124d3a5fe4673d87b6b9fec05f8df2092dd5925de5_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:c3cbbb6baa5d917ba21774124d3a5fe4673d87b6b9fec05f8df2092dd5925de5_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/04f2e2c0-b488-11ea-8f8b-197eadf2f6fe","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24349"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Produkten baseras på delavrinningsområden som började skapas 1980. \nVattendelare och områden som täckte hela Sverige fanns digitalt lagrat 1991. \n\nDet lagret har byggts på och delats upp i flera områden. \nVattendelare har uppdaterats vid behov och med hjälp av bättre information om höjd och flödesriktning. \n\nData lagras sedan 2007 i en geodatabas - SVAR (=Svenskt Vattenarkiv) vid SMHI. \nUnder perioden 2007 till 2016 har antalet delavrinningsområden i databasen ökat från drygt 17 000 till mer än 55 000. \nI SVAR version 2010 fanns det drygt 37 000 polygoner i kartskiktet med delavrinningsområden men då ingick inga andra öar i havet än Gotland, Öland, Orust och Tjörn. \n\nTill version 2012_2 inkluderades även mindre öar i havet, vilket innebar att antalet polygoner i kartskiktet ökade till drygt 50000.","dcat:distribution":[{"@id":"https://opendata-download.smhi.se/svar/SVARO_2016.zip"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_2016/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Ett avrinningsområde avgränsas ytterst av en ytvattendelare och omfattar både markytan och ytan av det avgränsade områdets sjöar. All ytavrinning från området har ett gemensamt utlopp vid en given punkt i ett vattendrag. Avrinningsområdet definieras av uppströmsområdet till denna punkt. \n\nProdukten, som baseras på version SVAR 2016:8, innehåller 53 538 polygoner som representerar avrinningsområden för alla 53538 delavrinningsområdens utloppspunkter.\n\nPolygonerna inom ett huvudavrinningsområde är överlappande. Alla delavrinningsområden uppströms en utloppspunkt är sammanslagna till en polygon så att all avrinning till den utloppspunkten kommer med. \n\nLeveransbeskrivning av uppströmsområden: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2016_8.pdf"},"dct:identifier":"04f2e2c0-b488-11ea-8f8b-197eadf2f6fe","dct:issued":{"@type":"xsd:date","@value":"2020-06-22"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:c3cbbb6baa5d917ba21774124d3a5fe4673d87b6b9fec05f8df2092dd5925de5_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:c3cbbb6baa5d917ba21774124d3a5fe4673d87b6b9fec05f8df2092dd5925de5_b0n0"},"dct:title":{"@language":"sv","@value":"Ackumulerade uppströmsområden (SVAR2016)"}},{"@id":"https://opendata-download.smhi.se/svar/SVARO_2016.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/SVARO_2016.zip"},"dcat:downloadURL":{"@id":"http