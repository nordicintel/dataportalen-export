/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/762376b4-1f11-4d40-a4c6-865c98ae3765","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"33485"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Nederbördsslag observeras visuellt och rapporteras endast från manuella mätstationer. När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt ca 2 timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/17.json"},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/18.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_flaggtabell_12_timmar_view/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_flaggtabell_dygn_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationType12Hours"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationType24Hours"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Nederbördstyp"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet.\n\nEnhet: Kodvärden översatta till textbeskrivning.\n\nEgenskaper: Observerade nederbördstyper de senaste 12 eller 24 timmarna, beroende på stationstyp. Manuella synopstationer rapporterar nederbördstyp kl 18 UTC som gäller 24 timmar. De flesta klimatstationer rapporterar kl 06 UTC där nederbördstyp också gäller 24 timmar. Det finns dock en del stationer som anger nederbördstyp gällande för 12 timmar och dessa rapporterar då både kl 06 UTC och kl 18 UTC. \n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim)."},"dct:identifier":"762376b4-1f11-4d40-a4c6-865c98ae3765","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:de9b3164474183444899536fbb63611db51b9830893e85fb61d283c387069eb8_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:de9b3164474183444899536fbb63611db51b9830893e85fb61d283c387069eb8_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Nederbördstyp 12- eller 24-timmarsvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/17.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/17.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/17.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data. Nedladdning av nederbördstyp, 12-timmarsvärden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:de9b3164474183444899536fbb63611db51b9830893e85fb61d283c387069eb8_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning, 12-timmarsvärden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/18.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/18.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/18.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data. Nedladdning av nederbördstyp, dygnsvärde"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:de9b3164474183444899536fbb63611db51b9830893e85fb61d283c387069eb8_b2n0"},"dct:title":{"@language":"sv","@value":"API för ned