at:startDate":{"@type":"xsd:date","@value":"1972-12-19"}},{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/d6dec663-7223-4bcd-94e7-959cc4d90c42","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"21227"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Övervakningen finansieras av länsstyrelsen, kommuner och vattenvårdsförbund. Även data från recipientkontroll som är finansierade av företag ingår i detta dataset.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-zoobenthos-reg"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data samlas in och analyseras enligt Metodbeskrivning för provtagning och analys av mjukbottenlevande makroevertebrater i marin miljö Leonardsson K. (2004) Umeå universitet, Institutionen för ekologi och geovetenskap, 26 s. Avvikelser från manualen kan förekomma. Information om programmet och metoderna finns på svenska på och Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/download/18.1690613b166605675de898f4/1539942622449/rapport-umu-metodbeskrivning-provtagning-analys-mjukbottenlevande-makroevertebrater-i-marin-miljo.pdf \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/mjukbottenlevande-makrofauna-trend--och-omradesovervakning.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/sediment---basundersokning.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av svenska universitet och konsultföretag."},"dct:identifier":"d6dec663-7223-4bcd-94e7-959cc4d90c42","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Regional marin miljöövervakning, recipientkontroll samt andra övervakningsprojekt av mjukbottenfauna i Sverige sedan 1972."}},{"@id":"https://www.gbif.se/ipt/resource?r=smhi-zoobenthos-reg","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-zoobenthos-reg"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-zoobenthos-reg"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb6604e0f878_b1n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:541db6f7abaa325da4bef6a7720c30c39672f4aeeca3578bdcf9cb66