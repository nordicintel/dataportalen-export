tps://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/a35bacb5-4eab-4707-be37-9366e0408cd3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28576"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Havsvattenstånd mäts nu med givare placerade i mätstationer vid kusten. Historiskt utfördes mätningarna först med hjälp av registrerande peglar med pappersdiagram och senare med så kallade potentiometerpeglar kopplade till automatstationer. I dagsläget används tre olika typer av givare anslutna till en automatstation; vinkelgivare kopplade till flottör och lod i en pegelbrunn, bubbelpegel och radarnivågivare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. För just havsvattenstånd görs dessutom noggrannare kontroller samt ifyllning av luckor. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/12.json"},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWHourValues/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelrw"}],"dcat:keyword":[{"@language":"sv","@value":"Havsvattenstånd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Assimilera och validera modeller och analysera extremer.\n\nEnhet: cm\n\nEgenskaper: Havsvattenståndet relativt respektive års medelvattenstånd. Ett momentant mätvärde per timme.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: Både >0 och <0.\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/stationslista-vattenstand\n\nÅrets medelvattenstånd avser en beräknad/teoretisk nivå baserad på observerade årsmedelvärden sedan mätstart:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/vattenstand-i-havet/arets-medelvattenstand"},"dct:identifier":"a35bacb5-4eab-4707-be37-9366e0408cd3","dct:issued":{"@type":"xsd:date","@value":"2016-11-25"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havsvattenstånd RW, timvärde"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/12.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/12.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/12.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWHourValues/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWHourValues/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWHourValues/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), stationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelrw","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelrw"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelrw"},"dct:description":{"@language":"sv","@value":"Användargränssnitt för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oceanograf@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5_b5n0"}}],"@id":"urn:source:51fe1c27ebc2bb6810d639da1d1ccab2abdd6b231663b88e2fffa566f0d2d9e5"},{"@graph":[{"@id":"_:5344a1d87f79d6c1680bf9a26d7ace547aee2e79d9a3ff72928d12abf0ccf44c_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,26 69,26 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(18.65 62.06)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:5344a1d87f79d6c1680bf9a26d7ace547aee2e79d9a3ff72928d12abf0ccf44c_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyright