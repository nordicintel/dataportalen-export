hority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://doi.org/10.17044/scilifelab.25883455","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://doi.org/10.17044/scilifelab.25883455"},"dcat:downloadURL":{"@id":"http://doi.org/10.17044/scilifelab.25883455"},"dct:description":{"@language":"sv","@value":"Science for Life Laboratory i samarbete med Figshare. Här finns samtliga manuellt annoterade bilder."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b0n0"},"dct:title":{"@language":"sv","@value":"SciLifeLab Data Repository"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/14392","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/14392"},"dcat:downloadURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/14392"},"dct:description":{"@language":"sv","@value":"Här finns alla manuellt annoterade bilder från Kattegat och Skagerrak"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b1n0"},"dct:title":{"@language":"sv","@value":"EcoTaxa"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/822","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/822"},"dcat:downloadURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/822"},"dct:description":{"@language":"sv","@value":"Här finns alla manuellt annoterade bilder från Östersjön"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b2n0"},"dct:title":{"@language":"sv","@value":"EcoTaxa"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/899","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/899"},"dcat:downloadURL":{"@id":"https://ecotaxa.obs-vlfr.fr/prj/899"},"dct:description":{"@language":"sv","@value":"Här finns alla manuellt annoterade bilder från Tångesund"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b3n0"},"dct:title":{"@language":"sv","@value":"EcoTaxa"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/8acc6d5e-f05e-4d18-b764-e7fe8d310ebf","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29742"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Övervakningen finansieras av Sveriges meteorologiska och hydrologiska institut.","dcat:distribution":[{"@id":"http://doi.org/10.17044/scilifelab.25883455"},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/14392"},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/822"},{"@id":"https://ecotaxa.obs-vlfr.fr/prj/899"},{"@id":"https://www.gbif.se/ipt/resource?r=shark-planktonimaging"}],"dcat:keyword":[{"@language":"sv","@value":"Cyanobakterier"},{"@language":"sv","@value":"Djurplankton"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Plankton"},{"@language":"sv","@value":"Växtplankton"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Provtagning sker antingen med hjälp av genomflödessystem på fartyg (t.ex. FerryBox) där Imaging Flowcytobot (IFCB) använder en del av flödet, eller på specifika platser in-situ där IFCB sänks ner i vattnet. Fler provtagningsmetoder är möjliga. \n\nIFCB använder teknologi från flödescytometri samt högupplöst foto för att detektera partiklar i ett vattenprov. Partiklars former i bilderna identifieras till så noggrann taxonomisk nivå som möjligt (släkte- eller artnivå) med hjälp av AI, samt dess storlek och volym räknas ut med hjälp av mjukvara för bildanalys. \n\nAnalyser av biomassa, abundans och artsammansättning av växt- och mikrodjurplankton görs av följande anledningar:\n - För att beskriva tidsmässiga trender samt förekomst av blomningar och dess intensitet\n - För att beskriva arters rumsliga utbredning\n - För att identifiera nyckelarter (t.ex. dominerande, skadliga, potentiellt främmande och/eller invasiva arter, samt indikatorarter)\n - För att tillhandahålla grundläggande data för ekosystemanalyser, näringsvävsstudier, modellering, samt för åtaganden inom havsmiljödirektivet och vattendirektivet\n \nAnalysen följer dessa metoder:\n - Maskininlärning: Sosik, H. M. and Olson, R. J. (2007), Automated taxonomic classification of phytoplankton sampled with imaging-in-flow cytometry. Limnol. Oceanogr: Methods 5, 204-216. http://github.com/hsosik/ifcb-analysis \n - Kvalitetskontroll: Hayashi, K., Walton, J., Lie, A., Smith, J. and Kudela M. Using particle size distribution (PSD) to automate imaging flow cytobot (IFCB) data quality in coastal California, USA. In prep. http://github.com/kudelalab/PSD \n - Dataprocessering: Anders Torstensson (2024). I 'R' FlowCytobot (iRfcb): Tools for Analyzing and Processing Data from the IFCB. R package version 0.3.10. https://doi.org/10.5281/zenodo.12533225. http://github.com/EuropeanIFCBGroup/iRfcb \n\n \n\nData är insamlad från Tångesund oceanografiska plattform vid Orust på svenska kusten år 2016 (IFCB110), och från R/V Svea (https://vocab.nerc.ac.uk/collection/C17/current/77SE/) från år 2022 och framåt (IFCB134). Fler provtagningsplattformar är möjliga.\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Sveriges meteorologiska och hydrologiska institut."},"dct:identifier":"8acc6d5e-f05e-4d18-b764-e7fe8d310ebf","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b4n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b4n0"},"dct:title":{"@language":"sv","@value":"SHARK - Växt- och mikrodjurplanktondata insamlad med Imaging FlowCytobots (IFCB) i svenska och närliggande vatten."}},{"@id":"https://www.gbif.se/ipt/resource?r=shark-planktonimaging","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=shark-planktonimaging"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=shark-planktonimaging"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b5n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b6n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac_b7n0"}}],"@id":"urn:source:40852ee0269703d007373765214a7cad3013e73b0c7e3a764426e067eda954ac"},{"@graph":[{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((8 70,38 70,38 52,8 52,8 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(22.91 61.37)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-02-01"}},{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attribution