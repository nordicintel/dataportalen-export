kweb.smhi.se/"},{"@id":"https://www.gbif.se/ipt/resource?r=shark-zooplankton-nat"}],"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data samlas in och analyseras enligt HELCOM Guidelines for Monitoring of Mesozooplankton. Avvikelser från manualen kan förekomma. Information om programmet och metoderna finns också på svenska på Havs- och vattenmyndighetens webbplats. \n - https://helcom.fi/wp-content/uploads/2020/01/HELCOM-Guidelines-for-monitoring-of-phytoplankton-species-composition-abundance-and-biomass.pdf. \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/djurplankton-trend--och-omradesovervakning.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Stockholms universitet, Umeå universitet, Sveriges meteorologiska och hydrologiska institut och Göteborgs universitet."},"dct:identifier":"e19d5237-286c-499e-94aa-b3d9c5d27c5e","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2023-09-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av djurplankton i Sverige sedan 1979."}},{"@id":"https://sharkweb.smhi.se/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sharkweb.smhi.se/"},"dcat:downloadURL":{"@id":"https://sharkweb.smhi.se/"},"dct:description":{"@language":"sv","@value":"SHARKweb är Svenskt HavsARKivs webbplats för nedladdning av data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b1n0"},"dct:title":{"@language":"sv","@value":"SHARKweb"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.gbif.se/ipt/resource?r=shark-zooplankton-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=shark-zooplankton-nat"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=shark-zooplankton-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b2n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5072a4f28c94cc69d23ec775019f4263546aa49d23642f9d22e0c6c349206a9b_b4n0