rl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2ef48b70-7d1f-11ed-a51b-432755aaeed3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23623"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"-","dcat:distribution":[{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/3.json"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterLevel"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Vattenstånd"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt och historiskt hydrologiskt tillstånd i Sverige.\n\nEnhet: cm\n\nEgenskaper: Daglig uppgift om vattenstånd i några stora sjöar i Sverige. Dygnsvärdena uppmäts oftast kl. 08.00 (svensk sommartid).\n\nNätinformation:\n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data rimlighetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. Fysiska stationer övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Stationerna ingår ej i SMHIs stationsnät men data samlas in och lagras i SMHIs databaser genom avtal med en tredje part.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden"},"dct:identifier":"2ef48b70-7d1f-11ed-a51b-432755aaeed3","dct:issued":{"@type":"xsd:date","@value":"2022-12-16"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:8190b259966fe1f23c7cf33cd51a2858fe4850c9e064ac8455e94bd0f559aca9_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:8190b259966fe1f23c7cf33cd51a2858fe4850c9e064ac8455e94bd0f559aca9_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Hydrologiska observationer - Vattenstånd"}},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/3.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/3.json"},"dcat:downloadURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/3.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8190b259966fe1f23c7cf33cd51a2858fe4850c9e064ac8455e94bd0f559aca9_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-