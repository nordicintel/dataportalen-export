-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9f6f7850-fb42-4910-a4d6-15d8004e15df","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"31452"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Modellens kartläggning av vädret bygger på observationer från vanliga väderstationer, men också från Trafikverkets stationer, data från väderradar och satellit. Som startvärde (första gissning) används vanligtvis en prognos från den numeriska vädermodellen GRIDPP som gäller vid observationstidpunkten. Denna bygger i sin tur på tidigare observationer och modifieras i MESAN  för att stämma bättre med de aktuella observationerna.  Metoden som används kallas Optimal Interpolation och bygger på statistiska samband över hur informationsinnehållet i observationer avtar som funktion av avståndet från observationsplatsen. Med hjälp av detta samband kan flera observationer vägas samman till ett medelvärde som gäller för en så kallad gridruta. I MESAN är dessa cirka 2.5 gånger 2.5 km.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/9"},{"@id":"https://opendata-view.smhi.se/grid-archive/mesanG_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-g"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nI denna datamängd finns arkiverade MESAN-data fram till och med dygnet innan uttaget sker. \nData finns fr.o.m. februari 2024. Dessförinnan levererades motsvarande data av MESAN (AROME) och MESAN (HIRLAM).\nMesan är en meteorologisk analysmodell som beskriver det aktuella väderläget i gridrutor. \nVarje timme under dygnet görs en tvådimensionell kartläggning av vanliga väderparametrar. Vilka dessa är varierar något över dygnet. I huvudsak beskriver de meteorologiska förhållanden som temperatur, nederbörd, moln, sikt, luftfuktighet, vind och snö.\nAnalysen görs över ett område som täcker Skandinavien, norra delen av kontinenten och de baltiska staterna. \n\nKOORDINATER\nKoordinater för området ges av hörnen:\nsydvästra\t52.30N,  2.15E\nnordvästra\t70.39N,  8.32W\nnordöstra\t70.44N,  37.50E\nsydöstra\t\t52.33N,  27.21E \n\nGridrutorna är 2.5*2.5 km.\n\nANVÄNDNING\nMesan-data används på SMHI för att göra väderkartor som meteorologen har som underlag i prognosverksamheten. Om observationer saknas kan analyserade värden ibland ersätta dessa. Mesan-data används också som indata till andra modeller t ex för att beräkna avrinningen i våra vattendrag eller för att kartlägga risken för bränder i skog och mark.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"9f6f7850-fb42-4910-a4d6-15d8004e15df","dct:issued":{"@type":"xsd:date","@value":"2024-01-08"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk analysmodell MESAN (GRIDPP) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/9","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/9"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/9"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafeed"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive/mesanG_extent/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesanG_extent/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesanG_extent/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för MESAN (GRIDPP)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:40a8ba23243c26e8402c0e29e5a7b51685eaef82f9bba389e167bc84c851d53b_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst för täckningsområde"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-g","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-g"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/tempe