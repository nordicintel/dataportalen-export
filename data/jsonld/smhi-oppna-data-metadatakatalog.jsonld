lAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://www.gbif.se/ipt/resource?r=shark-jellyfish-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-jellyfish-nat"},"dcat:downloadURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-jellyfish-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:8abeabae6977995c64f8305f0a50ce98881ca61ab47e8bb5b25bd1f19a8ed59f_b0n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/6b131990-5f11-4142-9539-59b59f891925","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24625"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"http://www.gbif.se/ipt/resource?r=shark-jellyfish-nat"},"dcat:keyword":[{"@language":"sv","@value":"Djurplankton"},{"@language":"sv","@value":"Geléplankton"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Plankton"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Prover samlas in genom att ett planktonnät dras vertikalt genom vattnet. Information om programmet och metoderna finns på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/organisation-och-programomraden/miljoovervakningens-programomrade-kust-och-hav/delprogram-fria-vattenmassan.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/geleplankton.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Göteborgs universitet."},"dct:identifier":"6b131990-5f11-4142-9539-59b59f891925","dct:issued":{"@type":"xsd:date","@value":"2023-07-03"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:8abeabae6977995c64f8305f0a50ce98881ca61ab47e8bb5b25bd1f19a8ed59f_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:8abeabae6977995c64f8305f0a50ce98881ca61ab47e8bb5b25bd1f19a8ed59f_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av geléplankton i Sverige sedan 2007."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vca