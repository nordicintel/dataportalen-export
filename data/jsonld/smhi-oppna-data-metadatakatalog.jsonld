bc7dac7b143efd15243372e7bf71df68_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9c95eda0-89ec-11ea-a966-bfa48b38ccc2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28581"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Havsvattenstånd mäts nu med givare placerade i mätstationer vid kusten. Historiskt utfördes mätningarna först med hjälp av registrerande peglar med pappersdiagram och senare med så kallade potentiometerpeglar kopplade till automatstationer. I dagsläget används tre olika typer av givare anslutna till en automatstation; vinkelgivare kopplade till flottör och lod i en pegelbrunn, bubbelpegel och radarnivågivare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. För just havsvattenstånd görs dessutom noggrannare kontroller samt ifyllning av luckor. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/14.json"},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWMinuteValues/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelMinutesRW"}],"dcat:keyword":[{"@language":"sv","@value":"Havsvattenstånd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Assimilera och validera modeller och analysera extremer.\n\nEnhet: cm \n\nEgenskaper: Havsvattenståndet relativt respektive års medelvattenstånd. Ett momentant mätvärde per minut.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: Både >0 och <0.\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/stationslista-vattenstand\n\nÅrets medelvattenstånd avser en beräknad/teoretisk nivå baserad på observerade årsmedelvärden sedan mätstart:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/vattenstand-i-havet/arets-medelvattenstand"},"dct:identifier":"9c95eda0-89ec-11ea-a966-bfa48b38ccc2","dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Havsvattenstånd RW, minutvärde"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/14.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/14.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/14.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWMinuteValues/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWMinuteValues/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.SeaWaterLevelRWMinuteValues/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst för stationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelMinutesRW","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelMinutesRW"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-havet/sealevelMinutesRW"},"dct:description":{"@language":"sv","@value":"Användargränssnitt för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oceanograf@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68_b5n0"}}],"@id":"urn:source:2eb9781fa77b9239dae2ed3cb68a3892bc7dac7b143efd15243372e7bf71df68"},{"@graph":[{"@id":"_:30437fd35e5db18f115b8708cd521474f57412df62560cff36610d31db7eb88f_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((21 66,25 66,25 63,21 63,21 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(22.98 64.45)"},"dcat:endDate":{"@type":"xsd:date","@value":"2020-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"1995-04-01"}},{"@id":"_:30437fd35e5db18f115b8708cd521474f57412df62560cff36610d31db7eb88f_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:30437fd35e5db18f115b8708cd521474f57412df62560cff36610d31db7eb88f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:30437fd35e5db18f115b8708cd521474f57412df62560cff36610d31db7eb88f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/c4a67335-ad22-4d79-9175-62d54d55409f","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"20507"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-ringedseal-nat"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Information om programmet och metoderna finns på svenska på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/hav/samordning--fakta/miljoovervakning/miljoovervakningens-programomrade-kust-och-hav/delprogram-sal-och-havsorn.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/bestand-av-knubbsal-och-vikaresal.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Naturhistoriska riksmuseet."},"dct:identifier":"c4a67335-ad22-4d79-9175-62d54d55409f","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:30437fd35e5db18f115b8708cd521474f57412df62560cff36610d31db7eb88f_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"d