/villkor-for-anvandning"}},{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b5n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b7n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/d64c3388-6be6-48e4-84ef-c0586016869f","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30634"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Kartorna grundar sig huvudsakligen på automatisk klassificering av optiska satellitdata, kompletterad med manuell tolkning och editering. Blomningar kan bara markeras där satellitens sikt inte skyms av moln.","dcat:distribution":[{"@id":"https://opendata-download-algae.smhi.se/api"},{"@id":"https://opendata-download-algae.smhi.se/inspire.xml"},{"@id":"https://opendata-view.smhi.se/algae/SR.SeaSurfaceArea/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/algae/SR.SeaSurfaceArea/wms?service=wms&request=getcapabilities"},{"@id":"https://opendata.smhi.se/algaemaps/api"}],"dcat:keyword":[{"@language":"sv","@value":"Alger"},{"@language":"sv","@value":"Cyanobakterier"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Plankton"},{"@language":"sv","@value":"Växtplankton"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nKartorna visar blomning av cyanobakterier detekterade från satellitdata. Blomningen kan detekteras från satellit när den finns på eller nära havsytan. \nEn blomning som är otydlig eller svår att se på grund av att den befinner sig under ytan definieras som \"Risk för ytansamling\", medan en \"Ytansamling\" definierar de områden där blomningen har koncentrerats på ytan. Områden där moln skymmer sikten visas med grå färg, och områden där satellitdata saknas betecknas med svart. OBS! Kartor från 2002 - 2009 har annan beteckning för algblomningarna. Se legend i aktuell karta.\n\nEftersom satelliten inte kan se blomningarna genom moln finns också en sammanställning av de senaste 7 dagarna. Den bilden visar antalet dagar som blomning observerats under de senaste 7 dagarna, vilket kan vara till stor nytta då en algblomning pågått en tid och området därefter blir molntäckt. Chansen är då stor att algblomningen finns under molntäcket men att den inte kan detekteras från satellit.\n\n\nLEVERANS\nDagliga kartor (png) med tillhörande texter (json), alternativt veckosammanställningar (png) kan laddas ner för ett år i taget.\n\n\nKOORDINATER\nKoordinater för området ges av hörnen\nSydvästra 53.33N, 6.89E\nNordvästra 65.82N, 3.62E\nNordöstra 64.90N, 33.73E\nSydöstra 52.69N, 27.68E\n\nFORMAT\nDagliga kartor (png) med tillhörande texter (json), alternativt veckosammanställningar (png) kan laddas ner för ett år i taget."},"dct:identifier":"d64c3388-6be6-48e4-84ef-c0586016869f","dct:issued":{"@type":"xsd:date","@value":"2017-05-31"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b0n0"},"dct:title":{"@language":"sv","@value":"SE.SR Ytansamling av alger"}},{"@id":"https://opendata-download-algae.smhi.se/api","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-algae.smhi.se/api"},"dcat:downloadURL":{"@id":"https://opendata-download-algae.smhi.se/api"},"dct:description":{"@language":"sv","@value":"API för nedladdning (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:289fd30e4211caf921086c056449f5c0a428ff837e79ec435b18e811d80116a2_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av PNG-bilder"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-algae.smhi.se/inspire.xml","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-algae.smhi.se/inspire.xml"},"dcat:downloadURL":{"@id":"https://opendata-download-algae.smhi.se/inspire.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:289fd30e4211caf921086c056449