0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:46ac0943ce6737ccf0224e3224d095e5518b878c706afe45bee844e9e8b45d19_b7n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:46ac0943ce6737ccf0224e3224d095e5518b878c706afe45bee844e9e8b45d19_b8n0"}}],"@id":"urn:source:46ac0943ce6737ccf0224e3224d095e5518b878c706afe45bee844e9e8b45d19"},{"@graph":[{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/b451cab6-2a8f-4b14-a125-fe0c49a6c9aa","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30531"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Vid bemannade mätstationer observeras vädret manuellt och rapporteras i form av en kodsiffra. På automatiska mätstationer används data från två separata instrument för att beräkna en väderkod. Koder från en automatstation är inte lika säkra som motsvarande från en manuell station, men instrumenten har utvecklats successivt och blivit alltmer tillförlitliga. Det finns ingen separat beskrivning av mätmetoder och mätfrekvenser för rådande väder men lite allmän information finns på: https://www.smhi.se/kunskapsbanken/meteorologi/meteorologiska-matningar. I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/13.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.radande_vader_momentan_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/presentWeather"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Väderkod"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet.\n\nEnhet: Kodvärden.\n\nEgenskaper: Rådande väder observerat var tredje timme på manuella mätstationer. Vid automatiska stationer sker mätningen varje kvart. Värdet för senaste kvarten rapporteras varje timme. Om flera väderfenomen observeras samtidigt så ska det mest signifikanta vädret rapporteras. Koderna är utformade så att högre kodsiffror innebär mer signifikant väder med ett undantag för manuella stationer där kod 17 (Åska utan nederbörd) är mer signifikant än koderna 20-49. Koderna finns förklarade på https://opendata.smhi.se/metobs/codes.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: Kodvärden 0 till 511."},"dct:identifier":"b451cab6-2a8f-4b14-a125-fe0c49a6c9aa","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Rådande väder, kvartsvärden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/13.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/13.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/13.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.radande_vader_momentan_view/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.radande_vader_momentan_view/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.radande_vader_momentan_view/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst(WMS), rådande väder, mätstationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, rådande väder, mätstationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/presentWeather","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/presentWeather"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/presentWeather"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324_b5n0"}}],"@id":"urn:source:47a5c6ee80cedc29d7aa6559030ac876dda089ea4d77b10c58ff4a900c0bf324"},{"@graph":[{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,24 69,24 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.69 62.05)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/9108ebf8-7972-4885-a951-f8b5d924ea64","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24241"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Vattenföring beräknas från vattenstånd. Vattenståndet mäts vid en mätstation som kallas pegel. Sambandet mellan vattenstånd och vattenföring kallas avbördningssamband. De första observationerna för vattenföring är från 1800-talet. Först läste en observatör av vattenståndet på en pegelskala (ungefär en stor tumstock) och rapporter skickades in till SMHI en gång i månaden. För ca 100 år sedan började man använda registerande skrivare, sk vattenståndsdiagram. Först under 1950-talet blev diagram vanligare och de manuella avläsningarna började avveckals. Diagrammen skickades in till SMHI en gång i veckan/månaden. Under 1980 började automater och loggar att användas, dessa skickar data till SMHI dagligen automatiskt. Idag används både diagram och automater. SMHI får också in data från externa leverantörer. Data granskas med hjälp av jämförelser med andra stationer samt kontroll mot nederbörd och temperatur. Därefter sätts kvalitetskoder.","dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Vattenföring"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller observerad vattenföring, timvärden, från alla stationer inom SMHIs grundnät för de senaste 30 dagarna. Observationsdata har hämtats från SMHIs hydrologiska observationsdatabas.\nNya filer skapas 5 ggr/d. Data för innevarande dygn fylls på successivt.\n\nParametrar som ingår i filen är:\nq - Observerad vattenföring, enhet m3/s\n\nSom identitet i datamängden har stationens stationsnummer använts.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nGEOGRAFISK INFORMATION\nFör stationernas namn och geografiska plats, se kopplingstabellen (csv)  som nås via nedladdningstjänsten. Där finns även en readme-fil som beskriver hur filerna ska användas.\n\nANVÄNDNING\nPå SMHI används hydrologisk observationsdata för den hydrologiska varningstjänsten, prognoser, klimatstudier samt för scenarier för infrastruktur, näringstransporter och översvämningskartering m m.\n \nFORMAT\nData levereras i NetCDF4-format som delvis följer CF conventions CF-1.6 för punktdata. Beskrivning av konventionen finns på \nhttps://cf-pcmdi.llnl.gov/documents/cf-conventions/1.6/cf-conventions.html"},"dct:identifier":"9108ebf8-7972-4885-a951-f8b5d924ea64","dct:issued":{"@type":"xsd:date","@value":"2014-01-28"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b0n0"},"dct:title":{"@language":"sv","@value":"Hydrologiska observationer - Vattenföring timvärde realtid"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03_b2n0"}}],"@id":"urn:source:4c532a33f4dbaaa5a79158e7eb33cacbd752d5d29545ee9d447f2abd8dac0b03"},{"@graph":[{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((-9 72,40 72,40 52,-9 52,-9 72))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(15.10 61.90)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2015-08-01"}},{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/70c69e3f-22b0-4d4f-9976-a4479428de24","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"33018"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Modellens kartläggning av vädret bygger på observationer från vanliga väderstationer, men också från Trafikverkets stationer, data från väderradar och satellit. Som startvärde (första gissning) används vanligtvis en prognos från den numeriska vädermodellen AROME som gäller vid observationstidpunkten. Denna bygger i sin tur på tidigare observationer och modifieras i MESAN  för att stämma bättre med de aktuella observationerna.  Metoden som används kallas Optimal Interpolation och bygger på statistiska samband över hur informationsinnehållet i observationer avtar som funktion av avståndet från observationsplatsen. Med hjälp av detta samband kan flera observationer vägas samman till ett medelvärde som gäller för en så kallad gridruta. I MESAN AROME är dessa 2.5 gånger 2.5 km.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/6"},{"@id":"https://opendata-view.smhi.se/grid-archive/mesanA_extent/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-a"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nI denna datamängd finns arkiverade MESAN-data fram till och med dygnet innan uttaget sker. \nData finns fr.o.m. december 2014. Dessförinnan levererades motsvarande data av MESAN (HIRLAM).\nMesan är en meteorologisk analysmodell som beskriver det aktuella väderläget i gridrutor. \nVarje timme under dygnet görs en tvådimensionell kartläggning av vanliga väderparametrar. Vilka dessa är varierar något över dygnet. I huvudsak beskriver de meteorologiska förhållanden som temperatur, nederbörd, moln, sikt, luftfuktighet, vind och snö.\nAnalysen görs över ett område som täcker Skandinavien, norra delen av kontinenten och de baltiska staterna. \n\nKOORDINATER\nKoordinater för området ges av hörnen:\nsydvästra\t\t52.4N, 2.0W\nnordvästra\t71.5N, 9.5W\nnordöstra\t\t71.2N, 39,7E\nsydöstra\t\t52.3N, 27.8E\n\nGridrutorna är 2.5*2.5 km.\n\nANVÄNDNING\nMesan-data används på SMHI för att göra väderkartor som meteorologen har som underlag i prognosverksamheten. Om observationer saknas kan analyserade värden ibland ersätta dessa. Mesan-data används också som indata till andra modeller t ex för att beräkna avrinningen i våra vattendrag eller för att kartlägga risken för bränder i skog och mark.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"70c69e3f-22b0-4d4f-9976-a4479428de24","dct:issued":{"@type":"xsd:date","@value":"2016-05-24"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk analysmodell MESAN (AROME) - historiska analysdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/6"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/6"},"dct:description":{"@language":"sv","@value":"Nedladdning av datafeed"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive/mesanA_extent/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesanA_extent/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive/mesanA_extent/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för MESAN (AROME)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, WMS"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-a"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/mesan-a"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:4c97dba205c4e3b841a3b113d8cc82447d60c11ff8e68a216ec199b307ba2387_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www