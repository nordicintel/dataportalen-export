.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/545f7280-7d15-11ed-a51b-432755aaeed3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27035"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Vattenföring beräknas från vattenstånd. Vattenståndet mäts vid en mätstation som kallas pegel. Sambandet mellan vattenstånd och vattenföring kallas avbördningssamband. De första observationerna för vattenföring är från 1800-talet. Först läste en observatör av vattenståndet på en pegelskala (ungefär en stor tumstock) och rapporter skickades in till SMHI en gång i månaden.  För ca 100 år sedan började man använda registerande skrivare, sk vattenståndsdiagram. Först under 1950 talet blev diagram vanligare och de manuella avläsningarna började avveckals. Diagrammen skickades in till SMHI en gång i veckan/månaden. Under 1980 började automater och loggar att användas, dessa skickar data till SMHI dagligen automatiskt. Idag används både diagram och automater.  SMHI får också in data från externa leverantörer Data granskas med hjälp av jämförelser med andra stationer samt kontroll mot nederbörd och temperatur. Därefter sätts kvalitetskoder.åäö","dcat:distribution":[{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/2.json"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischarge15min"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Vattenföring"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt och historiskt hydrologiskt tillstånd i Sverige.\n\nEnhet: m3/s\n\nEgenskaper: Beskriver den mängd vatten per tidsenhet som rinner fram i ett vattendrag. Tidstämpeln anges i UTC.\n\nNätinformation:\n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data rimlighetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. Fysiska stationer övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Stationerna ingår ej i SMHIs stationsnät men data samlas in och lagras i SMHIs databaser genom avtal med en tredje part.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden"},"dct:identifier":"545f7280-7d15-11ed-a51b-432755aaeed3","dct:issued":{"@type":"xsd:date","@value":"2022-12-16"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Hydrologiska observationer - Vattenföring, kvartsvärde"}},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/2.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/2.json"},"dcat:downloadURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/2.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischarge15min","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischarge15min"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/waterdischarge15min"},"dct:description":{"@language":"sv","@value":"Nedladdning av vattenföring, kvartsvärden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:423a81b5d2bf788afc8bb66f93bfbef493115c9ffaf92e5e63b0bd8cb4087e07_b2n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns