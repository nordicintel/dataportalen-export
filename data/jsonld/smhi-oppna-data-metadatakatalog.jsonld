w.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/976ce831-f136-4ace-9b2e-826f1bce9625","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27019"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Urladdningsdata har beräknats av en beräkningsserver för blixtinformation baserat på observationer gjorda av automatsiska sensorer för blixtlokalisering. Dessa data innehåller viss osäkerhet och bör därför användas med försiktighet för statistisk bearbetning, då blixtlokaliseringssystemet fortlöpande förändras och förbättras. Till exempel kan sensorer uppgraderas eller systemkonfigurationen ändras.\n\nÅr 2014 bytte SMHI beräkningsserver i blixtlokaliseringssystemet. Arkiverade urladdningsdata är baserade på beräkningar med den föregående beräkningsservern (LP2000) fram till och med 2014-06-18 kl 06:59:59 UTC. Därefter baseras data på den nuvarande beräkningsservern (TLP). Detta medför att data från och med denna tidpunkt inte är direkt jämförbara med äldre data.\n\nUrladdningar med \"chi square\" >= 10.0 har av kvalitetsskäl exkluderats ur datamängden.\n\nPositioneringen av urladdningarna är inte exakt. Vid normal drift skall medianen för positioneringsfelet vara mindre än 500 meter, men beroende på till exempel urladdningens styrka och dess position i förhållande till sensorerna kan avvikelsen vara betydligt större. För varje registrerad urladdning beräknar systemet en konfidensellips som representerar medianen av positioneringsfelet.\n\nSystemet förmår inte att registrera alla urladdningar. Enligt tillverkaren skall det vid normal drift kunna registrera minst 90% av blixtarna mellan moln och mark, förutsatt att dessa har en strömstyrka på minst 5000 ampere. För de enskilda urladdningar som blixten består av är detekteringsgraden lägre.\n\nDet kan förekomma felaktiga registreringar. Tekniska störningar kan uppstå, till exempel kan sensorer gå sönder eller kommunikationen med sensorer brytas, vilket ger ökad osäkerhet.","dcat:distribution":[{"@id":"https://opendata-download-lightning.smhi.se/api/version/latest.atom"},{"@id":"https://opendata.smhi.se/lightning/archive"}],"dcat:keyword":[{"@language":"sv","@value":"Blixt"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Tjänsten levererar information om blixturladdningar i Sverige.\nUrladdningsdata har beräknats av en beräkningsserver för blixtinformation baserat på observationer gjorda av automatsiska sensorer för blixtlokalisering.\nBlixtlokaliseringssystemet registrerar separata urladdningar (eng. \"stroke\"). Det vi människor uppfattar som en blixt (eng. \"flash\") kan bestå av flera urladdningar.\nUrladdningar med \"chi square\" >= 10.0 har av kvalitetsskäl exkluderats ur datamängden.\nNotera att dessa data innehåller viss osäkerhet och bör därför användas med försiktighet för statistisk bearbetning. Data är inte homogena över tid eftersom blixtlokaliseringssystemet fortlöpande förändras och förbättras. Till exempel kan sensorer uppgraderas eller systemkonfigurationen ändras.\nÅr 2014 bytte SMHI beräkningsserver i blixtlokaliseringssystemet. Arkiverade urladdningsdata är baserade på beräkningar med den föregående beräkningsservern (LP2000) fram till och med 2014-03-25, därefter baseras data på den nuvarande beräkningsservern (TLP). Detta medför att data från och med denna tidpunkt inte är direkt jämförbara med äldre data.\nInformationen som levereras baseras på det så kallade UALF-formatet (Universal ASCII Lightning Format).\nDe 25 fält som levereras för varje urladdning beskrivs i tabellform i API-dokumentationen här:\nhttps://opendata.smhi.se/lightning/archive/metadata#parameters"},"dct:identifier":"976ce831-f136-4ace-9b2e-826f1bce9625","dct:issued":{"@type":"xsd:date","@value":"2019-01-16"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b0n0"},"dct:title":{"@language":"sv","@value":"Blixtdata - historiska arkivdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-lightning.smhi.se/api/version/latest.atom","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-lightning.smhi.se/api/version/latest.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-lightning.smhi.se/api/version/latest.atom"},"dct:description":{"@language":"sv","@value":"Nedladdning av data via Atomflöde"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b1n0"},"dct:title":{"@language":"sv","@value":"API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/lightning/archive","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/lightning/archive"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/lightning/archive"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b2n0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd_b4n0"}}],"@id":"urn:source:a9da4e1ba1593a8e497f340aec7d6adf353ded3b78642a6569e54fe40e268bbd"},{"@graph":[{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((2 71,38 71,38 53,2 53,2 71))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(20.05 61.62)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/meteorology/snow/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/meteorology/snow/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/meteorology/snow/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. LEVERANS Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b0n0"},"dct:title":{"@language":"sv","@value":"Nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/2d236bdc-9ba7-4296-bb96-bb5a2665bfff","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"31312"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/spmkund_smhi.se"},"dcat:dataQuality":"SNOW är en prognosdatabas som skapas genom att meteorologen väljer in data från ett antal prognosmodeller samt använder metoder för efterbearbetning.\n\nSlutprodukten, SNOWs datamängd, innehåller prognosdata för minst 240 upp till 251 timmar för att täcka tio dygn. SNOW uppdateras 4 gånger per timme.\n\nSNOW är en vidareutveckling av PMP som har funnits sedan år 2000. SNOW möjliggör snabbare tillförsel av nya datamängder för att skapa en mer tillförlitlig prognos på kort sikt.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/meteorology/snow/"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnhöjd"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsintensitet"},{"@language":"sv","@value":"Nederbördstyp"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Åska"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"I denna datamängd finns prognosdata i realtid från de två senaste körningarna av SNOW, Swedish National Operational Weather forecast.\n\nSNOW, Swedish National Operational Weather forecast, är en prognosdatabas som är kvalitetskontrollerad av en meteorolog. Databasen består av prognosvärden utlagda i ett grid (fält). Varje parameter har ett värde i varje gridpunkt och vid varje specifik tidpunkt. Avståndet mellan gridpunkterna är ca 2,5 km.\n\nTidsupplösningen på informationen i SNOW glesas ut efterhand. För de första dygnen finns data för varje timme, därefter finns data för var tredje timme, därefter var sjätte timme och för de sista dygnen i databasen är tidsupplösningen 12 timmar.\n\nSNOW skapas genom att meteorologen väljer in data från ett antal prognosmodeller samt använder metoder för efterbearbetning. Slutprodukten, SNOWs datamängd, innehåller prognosdata för minst 240 och upp till 251 timmar för att alltid täcka tio dygn.\n\nSNOW uppdateras var 15:e minut.\n\nVia denna nedladdningstjänst får du filer som innehåller alla parametrar för hela det geografiska området och alla höjder, för det aktuella tidssteget.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER:\nKoordinater för området ges av hörnen:\nSydvästra\t50.32\t0.28\nNordvästra \t72.76 \t-18.12\nNordöstra \t71.58\t54.24\nSydöstra\t\t49.77\t33.03\t  \n\nGridrutorna är ca 2,5 km.\n\nANVÄNDNING:\nPå SMHI används SNOW som underlag för prognoser till såväl allmänhet som kommersiella kunder. Väderprognoserna på smhi.se och appen smhi väder baseras på information från SNOW.\n\nFORMAT:\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"2d236bdc-9ba7-4296-bb96-bb5a2665bfff","dct:issued":{"@type":"xsd:date","@value":"2025-09-22"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-30"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b1n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk modell SNOW - Prognosdata realtid"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/spmkund_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:spmkund@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883_b3n0"}}],"@id":"urn:source:abbf5e05109d0c485c51f7a2b573a5bf473674b0ae55cb55132fda38a18f8883"},{"@graph":[{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9 66,30 66,30 54,9 54,9 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(19.81 59.77)"},"dcat:endDate":{"@type":"xsd:date","@value":"2017-03-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2008-06-01"}},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bcde7478-5562-49e4-bb7d-2b89bc39e8d3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"34640"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Modellen simulerar de fysikaliska lagarna i havet med hjälp av rörelseekvationer och termodynamiska lagar. Liksom i den meteorologiska prognosmodellen stegar man modellen framåt i tiden med små tidssteg och simulerar tillståndet och processerna i gridrutor i 3 dimensioner. Luftrycket påverkar havsytan och får den att sjunka vid högt tryck och stiga vid lågt tryck. Tidvattnet påverkar vattenståndet på västkusten. Luftens temperatur påverkar ytans temperatur och vinden blandar om den översta delen av havet m.h.a. turbulens. Vindar påverkar även vattenståndet genom s.k. vindstuvning. Avrinning från floder lägger sig ovanpå havsvattnet och blandas ned m.h.a. vinden och gör havsvattnet mindre salt. Vid stormiga tillfällen trycks ibland stora mängder högsalint havsvatten in genom Öresund och bältsunden in i Östersjön. På vintern simulerar modellen istillväxt, isdrift och isavsmältning.","dcat:distribution":[{"@id":"https://opendata-download-grid-archive.smhi.se/feed/2"},{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/hiromb"}],"dcat:keyword":[{"@language":"sv","@value":"Havstemperatur"},{"@language":"sv","@value":"Havsvattenstånd"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Salthalt"},{"@language":"sv","@value":"Strömhastighet"},{"@language":"sv","@value":"Strömriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller historiska analysdata från prognosmodellen HIROMB. Det innebär att endast data för första tidssteget har valts ut för respektive tidpunkt. Prognosdata ingår inte.\nHIROMB BS01 är en oceanografisk prognosmodell som beskriver tillståndet i havet för ett antal fysikaliska parametrar.\nVar 6:e timme körs en 60-timmars prognos som bygger på dataassimilation av tillgängliga observationer. Som indata används meteorologiska prognosmodellen HIRLAM (C11) och floddata från HBV-modellen. Prognos görs för bl.a. temperatur, salthalt, strömmar, vattenstånd och is.\n\nOmrådet som täcks av HIROMB BS01 är hela Östersjön och Sveriges västkust (Kattegatt och Skagerrak). Den västliga gränsen går strax väster om Jyllands nordspets. \n\nKOORDINATER\nKoordinaterna för området ges av hörnen:\n\nsydvästra\t\t53.7N,     9.38 E\nnordvästra\t65.9N,     9.38 E\nnordöstra\t\t65.9N,   30.23 E\nsydöstra\t                53.7N,   39.23 E\n\nGridrutorna är 1 nautisk mil (ca 2*2 km)\n\nANVÄNDNING\nPå SMHI används data från HIROMB till vattenståndsvarningar, isprognoser, utredningar för byggnationer till havs och försäkringsärenden. HIROMB-data används även som indata till oljespillsmodellering i SeatrackWeb.\n\nExterna användare använder HIROMB som indata till egna oceanografiska modeller via det internationella HIROMB-samarbetet. Försvaret, Räddningsverket, vädertjänsterna i Storbritannien, Danmark och Norge samt några kommuner och kärnkraftverk använder HIROMB-data.\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"bcde7478-5562-49e4-bb7d-2b89bc39e8d3","dct:issued":{"@type":"xsd:date","@value":"2013-03-18"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografisk prognosmodell, HIROMB BS01 - Historiska analysdata"}},{"@id":"https://opendata-download-grid-archive.smhi.se/feed/2","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/2"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/feed/2"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},"dcat:downloadURL":{"@id":"https://opendata-download-grid-archive.smhi.se/inspire/2"},"dct:description":{"@language":"sv","@value":"Inspireanpassad nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b2n0"},"dct:title":{"@language":"sv","@value":"Inspireanpassad nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/grid-archive-hirombbs01/OF.GridSeriesObservation/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningtjänst HIROMB (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b3n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, HIROMB"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/hiromb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/hiromb"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/hiromb"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b4n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a96dbf64807437fea11a06d6822_b5n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oceanograf@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ad3dd38ce0fddd886f5bbf2fa770c9dabf966a9