or-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b5n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b6n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b7n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b8n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/b3522310-8883-11eb-b179-d785eca52194","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"33465"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Beräkningar av brandrisk (prognos och analys) har sedan 1999 producerats av SMHI på uppdrag av Myndigheten för civilt försvar, tidigare Myndigheten för samhällsskydd och beredskap. Beräkningarna har under åren genomgått mindre uppdateringar.\n\nInför 2021 genomgick brandriskberäkningarna en större uppdatering och utveckling som bestod av bland annat:\n\n- högre geografisk upplösning på cirka 2.5 km x 2.5 km från tidigare cirka 11 km x 11 km.\n- FWI-modellen på dygnsbasis kompletterades med FWI-modellen på timbasis.\n- Bränsleuttorkningen har ersatt den tidigare HBV-skog modellen.\n- Ny gräsbrandsmodell per timme.\n\nUnder 2022 har en gräsbrandsmodell dygn tagits fram samt att risknivåerna har uppdaterats i både timmodellen och den nya dygnsmodellen för gräs.\n\nUnder mars 2024 uppdaterades snötäcket i gräsbrandsmodellen per timme till att visa snötäcket för varje timme för aktuell timme samt prognos för kommande 48 timmarna. Det innebär att snötäcket får en dygnsvariation om det tex faller snö eller om snön smälter bort under dygnet.\n\nUnder maj 2024 infördes också tätare körningar av dygnsmodellen samt att indata till brandriskanalyserna uppdaterades. Samtidigt infördes också en förbättring för att på bästa sätt utnyttja data till brandriskanalyserna vilket också medför att brandriskprognoserna förbättras då brandrisken har ett väderminne. Det påverkar APIet för brandriskanalyser genom att data finns tillgängligt för ett dygn mindre, samt att APIet för brandriskprognoser förlängs bakåt i tiden med ett dygn.","dcat:distribution":[{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/daily/approvedtime.json"},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/daily/geotype/point/lon/16/lat/58/data.json"},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/hourly/approvedtime.json"},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/hourly/geotype/point/lon/16/lat/58/data.json"},{"@id":"https://opendata.smhi.se/metanalys/fwia"},{"@id":"https://www.smhi.se/data/temperatur-och-vind/temperatur/brandriskdata-historisk"}],"dcat:keyword":[{"@language":"sv","@value":"Brandrisk"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Via dessa tjänster erhålls brandriskanalyser för innevarande säsong per dygn och timme i realtid. APIet för dygn representerar brandrisken på eftermiddagen då brandrisken oftast är som högst. APIet per timme beskriver brandrisken timme för timme och visar därmed variationen av brandrisken under dygnet. I APIerna för brandriskprognoser finns motsvarande beräkningar framåt i tiden, då brandrisken aktuell dag även beror på hur vädret var innan, speciellt med avseende på nederbörden.\n\nSMHIs arbete med brandriskberäkningar (prognos och analyser) sker på uppdrag av Myndigheten för civilt försvar, tidigare Myndigheten för samhällsskydd och beredskap.\n\nBeräkningar av brandrisk (prognos och analys) görs endast över land och insjöar i Sverige. I både APIet för dygn och timme finns den kanadensiska Fire Weather Index(FWI)-modellen* som är en väl använd modell både i och utanför Europa. FWI-modellen ingår också i ett större modellsystem för bedömning av brandrisk och brandbeteende kallat Canadian Forest Fire Danger Rating System (CFFDRS)**.\n\nPå SMHI infördes dygnsvarianten av FWI-modellen år 1999. FWI-modellen beskriver bland annat brandbeteende, spridningshastighet och mängden tillgängligt bränsle för branden i olika variabler. Indata för dygnsvarianten av FWI-modellen är väderparametrarna temperatur, relativ luftfuktighet samt vind 12 UTC och nederbörd 18-18 UTC, från MESAN. Indata för timvarianten av FWI-modellen är istället temperatur, relativ luftfuktighet och nederbörd för varje timme från MESAN. Skillnaderna mellan dygns- och timvarianten av FWI-modellen: \n- Timvarianten använder indata från dygnsvarianten för (DMC, DC, BUI) då dessa variabler inte varierar nämnvärt under dygnet.\n- I timvarianten är uppfuktnings/upptorknings hastigheterna snabbare jämfört med i dygnsvarianten. I dygnsvarianten bortser man från de första 0.5 mm men i timvarianten ingår all nederbörd.\n- Då modelluppsättning och indata till dygns- och timvarianten inte är samma så kommer de olika FWI-modellerna få olika värden även för tidpunkten 12 UTC.\n\nAPIet för timme innehåller förutom FWI-modellens variabler även:\n- gräsbrandsbrandsrisk i det gamla fjolårsgräset\n- potentiell spridningshastighet för en för en fullt utvecklad gräsbrand i oklippt och obetat fjolårsgräs (m/min) (Rn)\n- globalstrålning i W/m2  (GLirr)\n- bränsleuttorkningen, som anger hur uttorkat det blivit både i bränslet och i de markskikt som har störst betydelse vid skogsbrand***\n\nAPIet för dygn innehåller förutom FWI-modellens variabler även:\n- bränsleuttorkningen som anger hur uttorkat det blivit både i bränslet och i de markskikt som har störst betydelse vid skogsbrand.\n- gräsbrandsbrandsrisk i det gamla fjolårsgräset enligt gräsbrandsmodellen på dygnsbasis\n- potentiell spridningshastighet för en fullt utvecklad gräsbrand i oklippt och obetat fjolårsgräs (m/min) (Rn) enligt gräsbrandsmodellen på dygnsbasis.\n\nDygnsmodellen**** för gräs utgår från timmodellen***** och använder temperatur, nederbörd, relativ luftfuktighet, vind och globalstrålning (solstrålning) som indata. Dygnsmodellen representerar den högsta gräsbrandsrisken under dygnet till skillnad från timmodellen som istället beskriver gräsbrandsrisken för varje timme. \n\n* Development and structure of the Canadian Forest Fire Weather Index System. 1987. Van Wagner, C.E. Canadian Forestry Service, Headquarters, Ottawa. Forestry Technical Report 35. 35 p. https://cfs.nrcan.gc.ca/publications?id=19927\n** https://cwfis.cfs.nrcan.gc.ca/background/summary/fdr\n*** Bränsleuttorkning - ersättare till HBV-skog (2022) Jansson, A\nhttps://www.mcf.se/sv/publikationer/bransleuttorkning--ersattare-till-hbv-skog/\n**** Utveckling av modell för gräsbrandsfara avseende prognos för dygn och timma (2022) Sjöström, J och Granström, A\nhttps://www.mcf.se/sv/publikationer/utveckling-av-modell-for-grasbrandsfara-avseende-prognos-for-dygn-och-timma/\nsamt\nSnötäcke i gräsbrandsmodellen - Utvärdering och implementation (2022) Jansson, A och Böhlin, J\nhttps://www.mcf.se/sv/publikationer/snotacke-i-grasbrandsmodellen--utvardering-och-implementation/\n***** En ny modell för gräsbrandsfara (2021) Sjöström, J., Granström, A, Jansson, A och Böhlin, J\nhttps://www.mcf.se/sv/publikationer/en-ny-modell-for-grasbrandsfara-i-sverige/"},"dct:identifier":"b3522310-8883-11eb-b179-d785eca52194","dct:issued":{"@type":"xsd:date","@value":"2021-03-19"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b0n0"},"dct:title":{"@language":"sv","@value":"Brandriskanalyser per dygn och timme - API"}},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/daily/approvedtime.json","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/daily/approvedtime.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/fwia1g/version/1/daily/approvedtime.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av senaste tid (UTC) för godkännande av fwia1gv1 punktprognoser. Även körningens referenstid (UTC) levereras."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7e5481d451fd7cc4917a96b03d4e39f5ad376c561ef2d431bee299293e652039_b1n0"},"dct:title":{"@language":"sv","@value":"Dygnsdata, senaste uppdateringstid"},