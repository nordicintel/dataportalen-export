,"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/87c2f9ed-beea-411d-87b7-68cb421fdaba","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32509"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Lägsta molnbas bedöms på manuella stationer och mäts med ett laserinstrument på automatiska stationer. Begränsningen med laserinstrumentet är att det tittar rakt upp och inte över hela himlen. Vissa stationer hade tidigare givare av en äldre modell. Dessa hade en maximal mäthöjd på 3800 m och missade moln på högre höjder, vilket gav ett osäkert mätvärde generellt (kvalitetskod satt till röd). Successivt har dessa givare bytts ut till nya med dubblerad mäthöjd. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/moln/hur-mats-molnighet I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/37.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lagsta_molnbas_15min_min/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/lowestCloudBase15MinutesMin"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognosverifikation\n\nEnhet: Åttondelar för molnmängd och meter för molnbas.\n\nEgenskaper:\nI det officiella nätet av observationer i Sverige finns ett flertal stationer som rapporterar molnmängd och molnbas med en timmes intervall. Dessa stationer är utrustade med molnhöjdsmätare vilka mäter höjden till molnens undersida. Molnmängden bestäms av en avancerad algoritm i mätinstrumentet.\n\nDe flesta av mätstationerna skickar helt automatiskt framställda rapporter och när det gäller moln så rapporteras alla molnlager som instrumentet detekterar. Upp till 4 molnlager kan rapporteras.\nFör manuella stationer som då främst utgörs av historiska observationer gäller:\n - Lägsta förekommande molnskikt oberoende av dess molnmängd, som minst rapporteras 1/8.\n - Därnäst högre molnskikt som sammanlagt täcker 3/8 eller mer av himlen.\n - Därnäst högre molnskikt som sammanlagt täcker 5/8 eller mer av himlen.\n - Cumulonimbusmoln som ej rapporteras enl. punkt 1, 2 eller 3 rapporteras alltid i en särskild grupp oavsett molnmängd. Detta gäller främst historiska manuella observationer. Dagens mätinstrument kan inte särskilja sådana moln.\n - Molnbasen till ovanstående molnskikt rapporteras också. Exempelvis kan en station rapportera 1/8 med molnbas 300 m, 3/8 med molnbas 500 m och 5/8 med molnbas 1000 m.\n - Alla molnskikt rapporteras inte alltid eftersom regelverket ovan måste vara uppfyllt.\n\nEnhet för molnmängd är åttondelar där 0/8 är molnfritt, 8/8 är helmulet. 9/8 betyder att molnhimlen ej kan observeras pga. dimma eller högt snödrev. Vid 9/8 används istället begreppet vertikalsikt vilket anger hur långt vertikalt det är möjligt att se.\n\nEnhet för molnbas och vertikalsikt är meter.\n\nMolnmängd\n - Data finns med värde 0 till 9. \n - Värde 10 till 15 är till för data som inkommer i form av flygplatsobservationer (METAR), sådana data ingår inte i detta dataset. Dessa värden kommer att vara tomma och kan därmed inte användas.\n - Värde 0 till 8 betyder 0 till 8 åttondelar. \n - Värde 9 betyder att molnhimlen ej kan observeras pga. dimma eller högt snödrev. Istället för molnbas anges då vertikalsikt. \n\nMolnbas\n - Med molnbas avses det lodräta avståndet från marken till molnens undersida. Enhet meter.\n\nParameter 37\nLägsta observerade molnbas under de senaste 15 min.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Gröna värden (G) innebär godkänd kvalitet. Gula värden (Y) innebär data som kan vara misstänkt felaktigt. Det kan också vara ett aggregerat värde baserat på andra mätvärden.\n\nGränser: 0 till 7500 m (molnbas)\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/meteorologi/moln/molnighet"},"dct:identifier":"87c2f9ed-beea-411d-87b7-68cb421fdaba","dct:issued":{"@type":"xsd:date","@value":"2018-06-19"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lägsta molnbas, 15 minuters minimum, timvärden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/37.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/37.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/37.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lagsta_molnbas_15min_min/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lagsta_molnbas_15min_min/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lagsta_molnbas_15min_min/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS), lägsta molnbas, mätstationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:31eb43713de225671a7ed4345ac74d52be8a5c65debf9284db2844e9becd3bfb_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, lägsta molnbas, mätstationer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}