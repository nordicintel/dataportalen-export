":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b2n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12 69,25 69,25 55,12 55,12 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(18.45 62.10)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dcat:downloadURL":{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b0n0"},"dct:title":{"@language":"sv","@value":"CF-Conventions"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://data-download.smhi.se/data/hydrology/s-hype2022/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/hydrology/s-hype2022/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/hydrology/s-hype2022/"},"dct:description":{"@language":"sv","@value":"Filerna s-hype2022_analysis_[date].nc för analys och s-hype2022_forecast_[date].nc för prognos."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b1n0"},"dct:title":{"@language":"sv","@value":"S-HYPE: Prognos- och analysdata, realtid"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/7fd6f87d-6332-4803-a42e-6edf0e377d31","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"25967"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"S-HYPE är en hydrologisk modell som beskriver vattenföringens och andra hydrologiska parametrars utveckling i tid och rum. Den realtidsuppdaterade analysen drivs med nederbörd och temperatur från PTHBV-databasen fram till sista dagen två månader tillbaka. Därefter används realtids-PTHBV, vilket är ett griddat och interpolerat nederbörds- och temperaturfält med realtidsrapporterande nederbörds- och temperaturstationer som grund.  I båda fallen får varje modelldelområde en viktad nederbörd och temperatur baserat på de gridrutor som finns inom modelldelområdet. Modellen körs ungefär en gång per dag på förmiddagen. Uppdateringar och justeringar av modellerna kan göras med kort varsel.","dcat:distribution":[{"@id":"https://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},{"@id":"https://data-download.smhi.se/data/hydrology/s-hype2022/"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Vattenföring"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nProdukten innehåller två datamängder från den hydrologiska modellen S-HYPE:\n\n- Historisk analys: Data för de senaste 30 dagarna gällande tidsteget 00-00. \n- Prognos: Data för 10 dygn framåt, gällande tidsteget 00-00.\n\nFör drivning av modellen fram till igår har nederbörd och temperatur från SMHIs PTHBV-databas använts.\nFör drivning av modellens prognosdygn har nederbörd och temperatur från SMHIs meteorologiska prognosmodell PMP använts.\n\nParameterar som ingår, för ca 40000 delområden är:\n- cout: Total vattenföring (m³/s)\n- snow: Snöns vatteninnehåll lokalt (mm)\n- smdf: Markvattenunderskott till fältkapacitet (mm)\n- cloc: Lokal vattenföring (m³/s)\n\nS-HYPE är en hydrologisk modell som beskriver vattenföringens och andra hydrologiska parametrars utveckling i tid och rum.\n\nHYPE är en hydrologisk modell för integrerad simulering av flöden samt omsättning av vatten och näringsämnen. Den ger möjlighet att beräkna faktorer knutna till vattenresurser och vattenkvalitet, men också annan hydrologisk information med hög geografisk detaljeringsgrad. \n\nS-HYPE är en uppsättning av HYPE-modellen för Sverige med en delområdesindelning som bygger på SVAR.\n\nMer information om S-HYPE och HYPE-modellen finns på https://www.smhi.se/data/sjoar-och-vattendrag/vattenwebb.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nSkicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER\nGeografisk identitet som används är subid, vilket är det interna delområdesnamnet för S-HYPE. Kopplingstabell (csv) och kartfil (shape) för kopplingen mellan subid och delområde, nås via nedladdningstjänsten. Där finns även en readme-fil som beskriver hur filerna ska användas.\n\nANVÄNDNING\nPå SMHI används S-HYPE som underlag för hydrologiska prognoser för den hydrologiska varningstjänsten. Modellen används också för att simulera vattenföring och vattenkvalitet åt den Svenska vattenförvaltningen, samt som hydrologisk modell för klimatscenarier och inom fler forskningsprojekt.\n\nFORMAT\nData levereras i NetCDF4-format som delvis följer CF conventions CF-1.6 för punktdata. Beskrivning av konventionen finns på \nhttps://cfconventions.org/Data/cf-conventions/cf-conventions-1.6/build/cf-conventions.html"},"dct:identifier":"7fd6f87d-6332-4803-a42e-6edf0e377d31","dct:issued":{"@type":"xsd:date","@value":"2014-01-28"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b2n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b2n0"},"dct:title":{"@language":"sv","@value":"Hydrologisk modell, S-HYPE: Prognos- och analysdata, realtid"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319_b4n0"}}],"@id":"urn:source:d5ae628a9601109f0ccc9140ee21cb96ca97821c0b1fbae31eb872cf04484319"},{"@graph":[{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12 75,52 75,52 42,12 42,12 75))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(31.55 58.75)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/38cd8070-ef36-455b-bdfe-5b39c152e4a1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27913"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Med hjälp av beräkning av solens position på himlen, samt information om atmosfärsvariabler såsom molnighet, vattenångehalt och ozon som ges av andra modeller, görs beräkningar av en rad strålningsparametrar i gridpunkt för gridpunkt. I grunden används spektrala beräkningar av solstrålning vid klart väder. Olika molneffektfunktioner för de olika parametrarna appliceras på klarvädersberäkningarna för att ge en uppskattning av de verkliga förhållandena.     Molninformationen som hämtas från analysmodellen MESAN är i sin tur baserad på markobservationer, väderradar- och satellitmätningar. Atmosfärens vattenångeinnehåll och markytans albedo beräknas av prognosmodellen HIRLAM. Det för UV-strålningen viktiga ozonet beräknas av den globala prognosmodellen vid ECMWF, baserat på mätningar från satellit eller så tas ozonmängden direkt från satellitdataprodukt (TOMS). Strålningsobservationsdata användes vid utvecklingen av modellen och fortlöpande vid modellvalideringen.","dcat:distribution":[{"@id":"https://opendata-download-metanalys.smhi.se/api/category/strang1g/version/1/geotype/point/lon/16/lat/58/parameter/116/data.json"},{"@id":"https://opendata.smhi.se/metanalys/strang"},{"@id":"https://strang.smhi.se/extraction/index.php"}],"dcat:keyword":[{"@language":"sv","@value":"Globalstrålning"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Solskenstid"},{"@language":"sv","@value":"Solstrålning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nModellsystemet gör beräkningar av en rad strålningsparametrar vid markytan i ett rutnät över nordvästra Europa för varje timme. \nVarje ruta representerar en yta på 11x11 km (Före 2006-06-01 var upplösningen 22*22 km). På så sätt får vi information om strålningen både över land och ute till havs. \nBeräkningarna baserar sig på kännedom om bl a molnens, vattenångans, ozonets och markytans albedos geografiska fördelning.    \nBeräkningarna görs en gång per dygn för det föregående dygnet. Data, fält och kartor finns från och med 1999. \nModellberäknade data och kartor finns för: CIE-viktad UV-strålning, Globalstrålning, Direktstrålning, Solskenstid och Fotosyntetiskt aktiv strålning (PAR). \nResultaten visar förhållandena vid varje hel timme (minut 00) dygnet runt. För att beräkna de olika parametrarna behöver STRÅNG meteorologiska data från en rad andra modeller som finns på bl.a. SMHI. Dessa modeller är MESAN, HIRLAM och HIROMB. Ozoninformation hämtas från ECMWF eller satellitinstrumentet TOMS.\nFör mer info se: https://strang.smhi.se\n\nKOORDINATER\nKoordinater för området ges av hörnen:\nsydvästra\t48.5N, 10.5W\nnordvästra\t75.1N, 11.5W\nnordöstra\t63.3N, 51.6E\nsydöstra\t\t42.4N, 22.9E\n\nGridrutorna är 11*11 km.\n\nModellen är dock utvecklad och validerad enbart för Sverige.\n\nANVÄNDNING\nSTRÅNG-data används för att få en uppfattning om hur solstrålningsförhållandena varit under en viss tid, på en viss plats där det saknas observationer eller över ett större område. Användningsområden kan var inom meteorologi, solenergi, biologi, medicin, m.fl. \n\nFORMAT\nData levereras i ASCII-format."},"dct:identifier":"38cd8070-ef36-455b-bdfe-5b39c152e4a1","dct:issued":{"@type":"xsd:date","@value":"2015-02-03"},"dct:modified":{"@type":"xsd:date","@value":"2019-03-13"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b0n0"},"dct:title":{"@language":"sv","@value":"Yttäckande modell för solstrålning - STRÅNG"}},{"@id":"https://opendata-download-metanalys.smhi.se/api/category/strang1g/version/1/geotype/point/lon/16/lat/58/parameter/116/data.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/strang1g/version/1/geotype/point/lon/16/lat/58/parameter/116/data.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metanalys.smhi.se/api/category/strang1g/version/1/geotype/point/lon/16/lat/58/parameter/116/data.json"},"dct:description":{"@language":"sv","@value":"API för nedladdning. Tjänsten ger ett svar i json-format för en geografisk punkt och en parameter i taget. Ersätt lon/16/lat/58 med önskad punkt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b1n0"},"dct:title":{"@language":"sv","@value":"API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/metanalys/strang","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/metanalys/strang"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/metanalys/strang"},"dct:description":{"@language":"sv","@value":"Information till utvecklare angående API'et."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b2n0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://strang.smhi.se/extraction/index.php","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://strang.smhi.se/extraction/index.php"},"dcat:downloadURL":{"@id":"https://strang.smhi.se/extraction/index.php"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b3n0"},"dct:title":{"@language":"sv","@value":"Grafiskt användargränsnitt för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88_b5n0"}}],"@id":"urn:source:d62dccab87696f7d6d89e6e0e76936ca4b161251fa330eae4603e16a3445ab88"},{"@graph":[{"@id":"_:d7f7420fce1be1111e953a10d53f5c5cc43d1e8c6e854d376109703ac320ee5c_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5 69,22 69,22 55,5 55,5 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.45 62.19)"},"dcat:endDate":{"@type":"xsd:date","@value":"2022-08-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-08-01"}},{"@id":"_:d7f7420fce1be1111e953a10d53f5c5cc43d1e8c6e854d376109703ac320ee5c_b10n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:d7f7420fce1be1111e953a10d53