","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/59f7b7a0-b488-11ea-8f8b-197eadf2f6fe","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"26117"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Produkten baseras på delavrinningsområden som började skapas 1980. \nVattendelare och områden som täckte hela Sverige fanns digitalt lagrat 1991. \nDet lagret har byggts på och delats upp i flera områden. \nVattendelare har uppdaterats vid behov och med hjälp av bättre information om höjd och flödesriktning. \n\nData lagras sedan 2007 i en geodatabas - SVAR (=Svenskt Vattenarkiv) vid SMHI. \nUnder perioden 2007 till 2016 har antalet delavrinningsområden i databasen ökat från drygt 17 000 till mer än 55 000. \n\nI SVAR version 2010 fanns det drygt 37 000 polygoner i kartskiktet med delavrinningsområden men då ingick inga andra öar i havet än Gotland, Öland, Orust och Tjörn. \n\nTill version 2012_2 inkluderades även mindre öar i havet, vilket innebar att antalet polygoner i kartskiktet ökade till drygt 50000.","dcat:distribution":[{"@id":"https://opendata-download.smhi.se/svar/VARO_2016.zip"},{"@id":"https://opendata-download.smhi.se/svar/VARO_2016_8.xlsx"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Ett avrinningsområde avgränsas ytterst av en ytvattendelare och omfattar både markytan och ytan av det avgränsade områdets sjöar. All ytavrinning från området har ett gemensamt utlopp vid en given punkt i ett vattendrag. Avrinningsområdet definieras av uppströmsområdet till denna punkt. \n\nProdukten, som baseras på version SVAR 2016:8, innehåller 23 795 polygoner som representerar avrinnings- och tillrinningsområden för alla utloppspunkter för svenska vattenförekomster av typen RW, LW och CW (vattendrag-, sjö- och kustvattenförekomster). För varje vattenförekomst har en sammanslagning gjorts av de ingående havs- och/eller delavrinningsområdena uppströms fram till utloppspunkten för nästa vattenförekomst. \n\nProdukten innefattar också en exceltabell över vattenförekomsternas rinnordning och de ingående delavrinnings- och havsområdena.\n\nLeveransbeskrivning av uppströmsområden per vattenförekomst: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2016_8.pdf"},"dct:identifier":"59f7b7a0-b488-11ea-8f8b-197eadf2f6fe","dct:issued":{"@type":"xsd:date","@value":"2020-06-22"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b0n0"},"dct:title":{"@language":"sv","@value":"Ackumulerade uppströmsområden per vattenförekomst (SVAR2016)"}},{"@id":"https://opendata-download.smhi.se/svar/VARO_2016.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/VARO_2016.zip"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/VARO_2016.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download.smhi.se/svar/VARO_2016_8.xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/VARO_2016_8.xlsx"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/VARO_2016_8.xlsx"},"dct:description":{"@language":"sv","@value":"Nedladdning av excelfil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b2n0"},"dct:title":{"@language":"sv","@value":"Excelfil över vattenförekomsternas rinnordning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, WFS"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b3n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Ackumulerade_uppstromsomraden_per_vattenforekomst_2016/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b4n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b5n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3_b6n0"}}],"@id":"urn:source:7c63b7a68a07580afe260b7f25e4de40642d2cafcb48de83300e17934a7313e3"},{"@graph":[{"@id":"_:7c8da66cdefa4f42c585a2c850aa7e67d3a8408e499b2bb28af52f86a133e467_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((-4 66,30 66,30 49,-4 49,-4 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.05 57.20)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-11-06"}},{"@id":"_:7c8da66cdefa4f42c585a2c850aa7e67d3a8408e499b2bb28af52f86a133e467_b1n0","@type":"http://schema.t