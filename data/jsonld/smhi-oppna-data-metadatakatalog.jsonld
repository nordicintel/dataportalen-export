on":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/aca69a20-b47e-11ea-8f8b-197eadf2f6fe","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24653"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"Under början av 2000-talet tog SMHI hem sjöar och vattendrag från den produkt hos \nLantmäteriet som då kallades Röda kartan, skala 1:250 000. \nRepresentationen av vattenförekomsterna i SVAR publicerades första gången 2005. \nDärefter har vattenförekomster och dess utbredning kontinuerligt uppdaterats","dcat:distribution":[{"@id":"https://opendata-download.smhi.se/svar/Vattenytor_2016.zip"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"En sjö är en mer eller mindre permanent större ansamling av vatten utan signifikant strömhastighet i en sänka i jordytan. En sjö har i regel ett utlopp, men det förekommer sjöar med fler utlopp och de som helt saknar utlopp. Alla sjöar i sjöregistret finns inte representerade som vattenytor. Ett vattendrag av tillräcklig storlek representeras av polygon i stället för enbart linje.\n\nProdukten, som baseras på version SVAR 2016:8, innehåller 42 178 polygoner som representerar sjö- och vattendragsytor.\n\nLeveransbeskrivning av sjöytor: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2016_8.pdf"},"dct:identifier":"aca69a20-b47e-11ea-8f8b-197eadf2f6fe","dct:issued":{"@type":"xsd:date","@value":"2020-06-22"},"dct:modified":{"@type":"xsd:date","@value":"2024-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b0n0"},"dct:title":{"@language":"sv","@value":"Vattenytor (SVAR2016)"}},{"@id":"https://opendata-download.smhi.se/svar/Vattenytor_2016.zip","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download.smhi.se/svar/Vattenytor_2016.zip"},"dcat:downloadURL":{"@id":"https://opendata-download.smhi.se/svar/Vattenytor_2016.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdning av SHAPE-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:414ca9191cfeec11c4e2f2d4a5f43331c427d5a13201d54849e77bf0fc1ab5aa_b2n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattenytor_2016/wms?servi