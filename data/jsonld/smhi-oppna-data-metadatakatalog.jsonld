d":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/bd148aa7-3381-4644-a46c-2c55aacd4383","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23432"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SVAR 2022 baserar sig på ett helt nytt underlag: Hydrografi nedladdning i skala 1:10 000, Markhöjdmodell Nedladdning konverterad till 10 m upplösning, framtaget av Lantmäteriet samt Nationell djupmodell i 10m upplösning, framtagen av SGU.\nUtifrån grundprinciperna: sjöar med en area > 0,5 km2 samt vattendrag med tillrinningsområde > 10 km2 har förslag till vattenförekomsterna tagits fram för inlandsvatten. För kustvatten har samma indelning som tidigare cykler varit målet men med nya gränser baserat på detaljerad djupinformation.\nDessa har, tillsammans med länsstyrelserna, granskats och korrigerats i omgångar under perioden 2021 till 2023. Vattenförekomsternas utlopp tillsammans med mätstationer i SMHIs grundnät samt ett ytterligare urval av mätstationer och dammar, har sedan legat till grund för framtagning av delavrinningsområden.","dcat:distribution":[{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten Utloppspunkter visar var utloppspunkterna ligger för de delavrinningsområden som ingår i SVAR2022.\n\nUtloppspunkterna används vid genereringen av avrinningsområden och representerar avrinningsområdets utlopp. All nederbörd som faller inom ett avrinningsområde passerar, i teorin, förr eller senare ut ur avrinningsområdet vid utloppspunkten.\n\nProdukten utloppspunkter baserar sig på version SVAR 2022:1.2.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2022_1_2.pdf"},"dct:identifier":"bd148aa7-3381-4644-a46c-2c55aacd4383","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b0n0"},"dct:title":{"@language":"sv","@value":"Utloppspunkter (SVAR2022)"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, Utloppspunkter (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst, Utloppspunkter"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Utloppspunkter_2022/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst, Utloppspunkter (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, Utloppspunkter"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5_b4n0"}}],"@id":"urn:source:433a9db0aefa578959ccf2d21360a621687217e6926099022a6db0270662e8e5"},{"@graph":[{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 69,26 69,26 55,11 55,11 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(18.65 62.06)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2fb207f0-8a1e-11ea-a966-bfa48b38ccc2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28214"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Vågperiod mäts nu med givare monterade på bojar i havet eller med bottenplacerade instrument.  Historiskt utfördes mätningarna med hjälp av bottenmonterade ekolod samt vågbojar av typ Waverider. I dagsläget används Waveriderbojar samt havsbojar med accelerometrar som givare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/9.json"},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.WavePeriodPeak/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Vågperiod"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera havsvågornas period och förbättra vågmodeller. Assimilering och validering av modeller. \n\nEnhet: Sekunder med 2 decimaler.\n\nEgenskaper: Vågperioden definieras som tidsintervallet mellan två på varandra följande vågtoppar. Peak period (VTPK) är perioden där vågornas energi är som störst under 30 minuter. Mätningen görs från bojar nära kusten och till havs och ger 1 värde per timme.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: >0\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/matning-och-berakning-av-vagor\nhttps://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2010-07-05-vagor-i-svenska-hav"},"dct:identifier":"2fb207f0-8a1e-11ea-a966-bfa48b38ccc2","dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:44eb5dbb6d155867f7e99c910504b491bdafbce55f7dbddc05c9600ff6fc058b_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Vågperiod, peakvärde"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/9.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/9.json"},"dcat:downloadURL":{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/9.json"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:44eb5dbb6d15