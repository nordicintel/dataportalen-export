:{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://www.gbif.se/ipt/resource?r=shark-sealpathology","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-sealpathology"},"dcat:downloadURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-sealpathology"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:36d827ac97e1c7bf8f8dbaec87f420c9606c95c0d4d0d0a415d89d44245b6011_b0n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/9e79d199-0fe1-4ffb-a70d-2a06f1dc6a8c","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24303"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"http://www.gbif.se/ipt/resource?r=shark-sealpathology"},"dcat:keyword":[{"@language":"sv","@value":"Däggdjur"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Obduktionsfynd och histopatologiska fynd från döda sälar. Om den exakta fyndplatsen inte är känd kommer positionen att anges i residensstaden (enligt Naturvårdsverkets riktlinjer). Information om programmet och metoderna finns på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/overvakningsmanualer-for-miljoovervakning/overvakningsmanualer/patologi-hos-grasal-vikaresal-och-knubbsal.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Naturhistoriska riksmuseet."},"dct:identifier":"9e79d199-0fe1-4ffb-a70d-2a06f1dc6a8c","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:36d827ac97e1c7bf8f8dbaec87f420c9606c95c0d4d0d0a415d89d44245b6011_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:36d827ac97e1c7bf8f8dbaec87f420c9606c95c0d4d0d0a415d89d44245b6011_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av patologi hos säl i Sverige."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:36d827ac97e1c7bf8f8dbaec87f420c9606c95c0d4d0d0a415d89d44245b6011_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:36d827ac97e1c7bf8f8dbaec87f420c9606c95c0d4d0d0a415d89d44245b6011_b3n0"}}],"@id":"urn:source:36d827ac97e1c7bf8