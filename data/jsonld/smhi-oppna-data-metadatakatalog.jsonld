":"_:81d613cd0eb23b79ecad020b81f878085091f8e8638dbdb641a3884f915d9543_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/b79cb060-8a1f-11ea-a966-bfa48b38ccc2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28181"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Vågperiod mäts nu med givare monterade på bojar i havet eller med bottenplacerade instrument.  Historiskt utfördes mätningarna med hjälp av bottenmonterade ekolod samt vågbojar av typ Waverider. I dagsläget används Waveriderbojar samt havsbojar med accelerometrar som givare. Efter mätningen sker enkla automatiska kontroller av data innan de lagras i databasen. Grova fel rättas till. Därefter sker ibland rättelser av felaktiga eller misstänkta data vid påpekande från användarna. Kvalitetskontrollerna förbättras och automatiseras successivt.","dcat:distribution":[{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/8.json"},{"@id":"https://opendata-view.smhi.se/oc-obs/OF.PointObservation.WaveDirectionTPEnergyMax/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Vågriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Observera havsvågornas riktning och förbättra vågmodeller. Assimilering och validering av modeller.  \n\nEnhet: Sekunder med 2 decimaler.\n\nEgenskaper: Vågriktning definieras som riktningen för vågorna. Medelvågriktningen är medelvärdet av vågornas riktning under 30 minuter. Mätningen görs från bojar och med bottenplacerade instrument nära kusten och till havs.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden\n\nGränser: >0\n\nFör mer info se:\nhttps://www.smhi.se/kunskapsbanken/oceanografi/matningar-i-havet/matning-och-berakning-av-vagor\nhttps://www.smhi.se/publikationer-fran-smhi/sok-publikationer/2010-07-05-vagor-i-svenska-hav"},"dct:identifier":"b79cb060-8a1f-11ea-a966-bfa48b38ccc2","dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:81d613cd0eb23b79ecad020b81f878085091f8e8638dbdb641a3884f915d9543_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:81d613cd0eb23b79ecad020b81f878085091f8e8638dbdb641a3884f915d9543_b0n0"},"dct:title":{"@language":"sv","@value":"SE.OF Oceanografiska observationer - Vågriktning, vid tp energimax"}},{"@id":"https://opendata-download-ocobs.smhi.se/api/version/latest/parameter/8.json","@type":["dcat:Distribution","