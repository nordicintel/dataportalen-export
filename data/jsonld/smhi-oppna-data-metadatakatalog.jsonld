ema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a775607012e6774a7_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a775607012e6774a7_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a775607012e6774a7_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/e9ee6972-ffda-4fe9-ac8f-74dd3b254e15","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30898"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Total molnmängd bedöms på manuella stationer och mäts med ett laserinstrument på automatiska stationer. Lasern mäter under en halvtimme antalet molnträffar och utifrån det kan en molnmängd beräknas, där de senaste tio minuternas molnträffar viktas högre. Begränsningen med laserinstrumentet är att det tittar rakt upp och beroende på molnens rörelse och läge kan metoden både överskatta och underskatta molnmängden. Vissa stationer hade tidigare givare av en äldre modell. Dessa hade en maximal mäthöjd på 3800 m och missade moln på högre höjder, vilket gav ett osäkert mätvärde generellt (kvalitetskod satt till röd). Successivt har dessa givare bytts ut till nya med dubblerad mäthöjd. Den manuella metoden bygger på att uppskatta hur många åttondelar av himlen som täcks av moln. Då motsvarar 0 åttondelar 0 % och klart medan 8 åttondelar är 100 % och heltäckt. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/moln/hur-mats-molnighet. I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/16.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.total_molnmangd_momentan_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/totalCloudCover"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognosverifikation.\n\nEnhet: % \n\nEgenskaper: Den totala molnmängden uppmätt varje timme på automatiska stationer eller bedömd var tredje timme på manuella stationer. Om molnmängden inte går att avgöra på grund av dimma, nederbörd eller andra siktnedsättande fenomen så sätts värdet till 113%.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Rött (R) = Misstänkta/felaktiga data eller data som kommer från en givare med max mäthöjd 3800 m. Den missar moln på högre höjd, vilket ger ett osäkert mätvärde generellt.\n\nGränser: 0 till 100 % samt 113 %\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/meteorologi/moln/molnighet"},"dct:identifier":"e9ee6972-ffda-4fe9-ac8f-74dd3b254e15","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a775607012e6774a7_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a775607012e6774a7_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Total molnmängd timvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/16.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/16.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/16.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:2d388acea280a3176ccc5947020502e5a8d34f93c52f7f6a7756