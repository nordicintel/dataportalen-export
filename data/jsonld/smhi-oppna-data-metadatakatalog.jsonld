2/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://www.gbif.se/ipt/resource?r=shark-harbour-porpoise-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-harbour-porpoise-nat"},"dcat:downloadURL":{"@id":"http://www.gbif.se/ipt/resource?r=shark-harbour-porpoise-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08_b0n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/c54c0621-0a0f-42bc-8855-4e25f63fbd57","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24114"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"http://www.gbif.se/ipt/resource?r=shark-harbour-porpoise-nat"},"dcat:keyword":[{"@language":"sv","@value":"Däggdjur"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Förekomst och utbredning av tumlare övervakas genom att spela in klickljud med klickdetektorer. Information om programmet och metoderna finns på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/overvakning-och-uppfoljning/miljoovervakning/marin-miljoovervakning/tumlare.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Naturhistoriska riksmuseet."},"dct:identifier":"c54c0621-0a0f-42bc-8855-4e25f63fbd57","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-09"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av tumlare i Sverige."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08_b3n0"}}],"@id":"urn:source:e0b92531d8e633a252b589ce89385e1afcbb4c6ce8d7a2c312d916719bc46b08"},{"@graph":[{"@id":"_:e202a5d284930d1a4f09dc193bbbeb6a23565f394fb3f4339de706642674440d_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://w