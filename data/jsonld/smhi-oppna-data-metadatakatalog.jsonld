-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((2 72,43 72,43 52,2 52,2 72))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(22.15 62.15)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/meteorology/cmepss_mbr000_surface/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/meteorology/cmepss_mbr000_surface/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/meteorology/cmepss_mbr000_surface/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b0n0"},"dct:title":{"@language":"sv","@value":"Nedladdning av filer"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/bbaf9e24-aea4-471f-afeb-9ab94d63bf96","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29616"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Prognosmodellen använder fysikaliska lagar, t ex rörelseekvationer, termodynamiska samband, strålnings- och kontinuitetsekvationer för att beräkna vädrets förändring i ett antal tidssteg framåt i tiden.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/meteorology/cmepss_mbr000_surface/"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nI denna datamängd finns markparametrar för analys- och prognosdata i realtid från de två senaste körningarna av prognosmodellen CMEPSS, medlem 0. Filerna surfaceParameters_CMEPSS_MBR000* innehåller postprocessade så kallade mark-fält som anges för en viss höjd över marken.\n\nModellen körs var tredje timme. Första filen är analysfilen och sedan följer 60 prognosfiler, en för varje tidssteg.\n\nCMEPSS är en numerisk prognosmodell som beskriver vädrets utveckling i tid och rum. Modellen har utvecklats inom ett internationellt samarbete där ett stort antal europeiska länder ingår.\n\nPrognosen utgår från hur vädret ser ut vid en viss tidpunkt, det s.k. initialtillståndet. För att kartlägga detta görs en analys av väderläget. Därvid modifieras en tidigare prognos för att stämma bättre med aktuella observationer. Detta görs med en variationell metod. Därmed kan värdet av de olika prognosparametrarna bestämmas i ett rutnät. I modellen är för närvarande dessa rutor 2.5 x 2.5 km i horisontell utsträckning och atmosfären har delats in i 65 nivåer i vertikal led.\n\nCMEPSS-analysen görs över ett område som täcker Skandinavien, norra delen av kontinenten och de baltiska staterna.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning.\nSkicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER\nKoordinater för området ges av hörnen\nSydvästra 52.04N, 1.64W\nNordvästra 72.30N, 12.65W\nNordöstra 72.30N, 42.73E\nSydöstra 52.04N, 28.38E\n\nANVÄNDNING\nPå SMHI används CMEPSS som underlag för prognoser i radio och TV. Den används också för prognoser till kommersiella kunder som olika tidningar och kommuner. Data från CMEPSS kan även användas som indata till andra modeller. Det gäller såväl meteorologiska som hydrologiska och oceanografiska\n\nFORMAT\nData levereras i GRIB-format, version 2.\nInformation som underlättar användningen finns på\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"bbaf9e24-aea4-471f-afeb-9ab94d63bf96","dct:issued":{"@type":"xsd:date","@value":"2026-01-29"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b1n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk modell (CMEPSS, medlem 0) - markparametrar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab_b3n0"}}],"@id":"urn:source:758d78c9be6eb256f6ea3d291b0b7ffb8a7d058e43e92543a31a8d3d21fb90ab"},{"@graph":[{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5 69,22 69,22 55,5 55,5 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.45 62.19)"},"dcat:endDate":{"@type":"xsd:date","@value":"2022-08-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-08-01"}},{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/e6dfee1c-1b3a-4da0-962d-ea9d4696d558","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23678"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SVAR 2022 baserar sig på ett helt nytt underlag: Hydrografi nedladdning i skala 1:10 000, Markhöjdmodell Nedladdning konverterad till 10 m upplösning, framtaget av Lantmäteriet samt Nationell djupmodell i 10m upplösning, framtagen av SGU.\nUtifrån grundprinciperna: sjöar med en area > 0,5 km2 samt vattendrag med tillrinningsområde > 10 km2 har förslag till vattenförekomsterna tagits fram för inlandsvatten. För kustvatten har samma indelning som tidigare cykler varit målet men med nya gränser baserat på detaljerad djupinformation.\nDessa har, tillsammans med länsstyrelserna, granskats och korrigerats i omgångar under perioden 2021 till 2023. Vattenförekomsternas utlopp tillsammans med mätstationer i SMHI:s grundnät samt ett ytterligare urval av mätstationer och dammar, har sedan legat till grund för framtagning av delavrinningsområden. Dessa har aggregerats till vattendistrikt.\n\nDe avrinningsområdena som avvattnar mot Norge eller Finland var i SVAR 2016 kategoriserade som egna internationella distrikt. I SVAR 2022 inkluderas de istället i något av de 5 svenska Vattendistrikten.","dcat:distribution":[{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten Vattendistrikt representerar Sveriges vattendistrikt som SMHI förvaltar åt vattenmyndigheterna. Gränserna för distrikten är inte administrativa utan baserar sig på hur vattnet rinner. Det innebär att gränserna utgörs av vattendelare och därmed även att ytorna för distrikten är en sammanslagning av avrinningsområden.\n\nDenna produkt, som baseras på version SVAR 2022:1.2, består av 5 polygoner.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2022_1_2.pdf"},"dct:identifier":"e6dfee1c-1b3a-4da0-962d-ea9d4696d558","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-29"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b0n0"},"dct:title":{"@language":"sv","@value":"Vattendistrikt (SVAR2022)"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, Vattendistrikt (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst, Vattendistrikt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/Vattendistrikt_2022/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst, Vattendistrikt (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:7595e0708b6c5afc0063e2679b9e35bd58ef60d238e17069f34e82ad705c7c7f_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, Vattendistrikt"},"