{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-push.smhi.se/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-push.smhi.se/"},"dcat:downloadURL":{"@id":"https://data-push.smhi.se/"},"dct:description":{"@language":"sv","@value":"Pushtjänst med inloggning. Tjänsten levererar information om blixturladdningar i Sverige. Detta sker med \"push-teknik\" via web-sockets."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b0n0"},"dct:title":{"@language":"sv","@value":"Blixturladdningar i Sverige"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/2462f23e-b3b9-4f2c-ad37-ba52472cc6ca","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"25844"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Blixturladdningarna har beräknats i beräkningsserver för blixtinformation med hjälp av observationer gjorda i automatiska sensorer för blixtlokalisering. Presenterade urladdningarna har godkänts av systemets egen kvalitetskontroll. Dessa data innehåller viss osäkerhet och bör därför användas med försiktighet för statistisk bearbetning, då sensornätet för blixtinformationen fortlöpande förändras.","dcat:distribution":[{"@id":"https://data-push.smhi.se/"},{"@id":"https://opendata.smhi.se/lightning/strikes"}],"dcat:keyword":[{"@language":"sv","@value":"Blixt"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Tjänsten levererar information om blixturladdningar i Sverige. När en blixturladdning skett och informationen har nått SMHI, levereras informationen vidare med \"push-teknik\" via web-sockets tills de som använder tjänsten. Det tar cirka 20 sekunder innan informationen blir tillgänglig.\nInformationen omfattar: Tidpunkt (UTC-tid), landskod, position, referenssystem (EPSG:4326), peakCurrent och cloudIndicator.\nFör att säkerställa att tjänsten är igång genereras tomgångstrafik i form av en testpost med samma utseende men med landskoden ZZ.\nUrladdningarna har beräknats i beräkningsserver för blixtinformation med hjälp av observationer gjorda i automatiska sensorer för blixtlokalisering.\n\nLEVERANS: Push-tjänsten för blixtdata nås via webtjänst mot leveransavgift. Data ska sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER: Data levereras för Sverige.\n\nANVÄNDNING: På SMHI används blixtdata inom varningstjänsten och utredningar.\n\nFORMAT: Data levereras i JSON format."},"dct:identifier":"2462f23e-b3b9-4f2c-ad37-ba52472cc6ca","dct:issued":{"@type":"xsd:date","@value":"2019-01-24"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b1n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b1n0"},"dct:title":{"@language":"sv","@value":"Blixtdata - realtid"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata.smhi.se/lightning/strikes","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/lightning/strikes"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/lightning/strikes"},"dct:description":{"@language":"sv","@value":"API-dokumentation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b2n0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12_b4n0"}}],"@id":"urn:source:01aa177ff2d5f4daa56f5c09ba7b73c103974856239200579aacfeb4a8e0fa12"},{"@graph":[{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/7108499d-23de-4d05-baa4-e45020d32bcc","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30067"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Idag görs mätningar av lufttrycket med elektroniska lufttryckssensorer. Historiskt har det vanligaste instrumentet varit kvicksilverbarometer. Mekaniska givare har också förekommit. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/lufttryck/hur-mats-lufttryck När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt cirka två timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/44.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lufttryck_momentan_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/airPressure"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognoser och klimatstudier.\n\nEnhet: Pascal \n\nEgenskaper: Stationerna mäter lufttryck. Momentanvärde varje minut. Eftersom trycket bland annat beror på höjden över havet, räknas det om till ett värde som representerar trycket vid havsytans nivå, för att värdena från olika stationer ska kunna jämföras. \n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: 80000 till 107000 pascal \n\nFör mer info se: https://www.smhi.se/data/meteorologi/lufttryck"},"dct:identifier":"7108499d-23de-4d05-baa4-e45020d32bcc","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lufttryck vid havsytan, minutvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/44.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/44.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/44.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:02e0755f59d4d383121bb8f5abdaab1027107d1424deb4ca409b37ba9cfcf799_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.lufttryck_momentan_view/wms?service=wms&request=getcapabilities","@type":"dcat:Distribu