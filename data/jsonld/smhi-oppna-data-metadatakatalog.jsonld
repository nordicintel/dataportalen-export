"@type":"xsd:date","@value":"2024-08-24"},"dcat:startDate":{"@type":"xsd:date","@value":"1988-08-22"}},{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"http://www.gbif.se/ipt/resource?r=smhi-harbourseal-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.gbif.se/ipt/resource?r=smhi-harbourseal-nat"},"dcat:downloadURL":{"@id":"http://www.gbif.se/ipt/resource?r=smhi-harbourseal-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b0n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/596630b2-5fc2-4a12-8beb-e82d72836317","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24259"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"http://www.gbif.se/ipt/resource?r=smhi-harbourseal-nat"},"dcat:keyword":[{"@language":"sv","@value":"Däggdjur"},{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Marinbiologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Information om programmet och metoderna finns på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/hav/samordning--fakta/miljoovervakning/miljoovervakningens-programomrade-kust-och-hav/delprogram-sal-och-havsorn.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/bestand-av-knubbsal-och-vikaresal.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Naturhistoriska riksmuseet."},"dct:identifier":"596630b2-5fc2-4a12-8beb-e82d72836317","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b1n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av knubbsäl i Sverige sedan 1988."}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723_b3n0"}}],"@id":"urn:source:a201e99b1590d78790c7ed7c7900a8da75df92ce5c6f4b5bb94b28efa26a6723"},{"@graph":[{"@id":"_:a3bf1f4742236026c4ee5f3de75857952d15328a6beed1ab42727e0da7e9e0f3_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:a3bf1f4742236026c4ee5f3de75857952d15328a6beed1ab42727e0da7e9e0f3_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE20210