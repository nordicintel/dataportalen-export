7efcb"},{"@graph":[{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((5 69,22 69,22 55,5 55,5 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.45 62.19)"},"dcat:endDate":{"@type":"xsd:date","@value":"2022-08-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-08-01"}},{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/e7c05e67-a237-43bd-aa32-84b539a6852f","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24054"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"SVAR 2022 baserar sig på ett helt nytt underlag: Hydrografi nedladdning i skala 1:10 000, Markhöjdmodell Nedladdning konverterad till 10 m upplösning, framtaget av Lantmäteriet samt Nationell djupmodell i 10m upplösning, framtagen av SGU.\nUtifrån grundprinciperna: sjöar med en area > 0,5 km2 samt vattendrag med tillrinningsområde > 10 km2 har förslag till vattenförekomsterna tagits fram för inlandsvatten. För kustvatten har samma indelning som tidigare cykler varit målet men med nya gränser baserat på detaljerad djupinformation.\nDessa har, tillsammans med länsstyrelserna, granskats och korrigerats i omgångar under perioden 2021 till 2023. Vattenförekomsternas utlopp tillsammans med mätstationer i SMHI:s grundnät samt ett ytterligare urval av mätstationer och dammar, har sedan legat till grund för framtagning av delavrinningsområden. Dessa har aggregerats till BARO-områden.","dcat:distribution":[{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wfs?service=wfs&request=getcapabilities"},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrografi"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Produkten BARO-områden består av ett urval större områden som tillsammans täcker alla Sveriges huvudavrinningsområden.\n\nEtt BARO-område är ett lagom stort delavrinningsområde som har ett begripligt omfång för betraktaren och ett namn som beskriver området väl. För varje BARO-område har en sammanslagning gjorts av de ingående delavrinningsområdena uppströms fram till utloppspunkten för nästa BARO-område. Indelningarna har beslutats av hydrologer på SMHI så att BARO-indelningen ska vara relevant för både allmänhet och för varnings- och prognostjänsten på SMHI.\n\nEn väsentlig del av Sveriges markområden längs kusterna ingår inte i definitionen av huvudavrinningsområden utan befinner sig mellan huvudavrinningsområdenas utloppspunkter eller på öar i havet. De områdena kallas för kustområden. Kustområdena har delats in efter delavrinningsområdesgränser längs Sveriges länsgränser och tillsammans med BARO utgör de hela Sverige.\n\nDenna produkt baseras på version SVAR 2022:1.2.\n\nLeveransbeskrivning: https://opendata-download.smhi.se/svar/SVAR_Basprodukter_2022_1_2.pdf"},"dct:identifier":"e7c05e67-a237-43bd-aa32-84b539a6852f","dct:issued":{"@type":"xsd:date","@value":"2023-09-25"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b0n0"},"dct:title":{"@language":"sv","@value":"BARO-områden (SVAR2022)"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wfs?service=wfs&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wfs?service=wfs&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wfs?service=wfs&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst, BARO-områden (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst, BARO-områden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/SMHI_vatten/BARO_2022/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst, BARO-områden (WMS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst, BARO-områden"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hydrolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55_b4n0"}}],"@id":"urn:source:fc3c7c92b8d7b2be8aad44e59a62d8e88b6095f222a2a6a827fdd486862b5b55"}]}
