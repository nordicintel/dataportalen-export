data_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2b84284b-4e01-48ee-8f40-5792c42579f2","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32535"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Temperaturen mäts automatiskt med Pt100 resistanstermometrar, se https://www.pentronic.se. Före 1995 utfördes nästan alla mätningar manuellt med kvicksilver- eller sprittermometer. Automatiska mätningar görs varje timme medan manuella mätningar genomfördes med olika frekvens vid olika stationer. Tre gånger per dygn eller var tredje timme var vanligast. Ett mindre antal manuella stationer mätte varje timme. Beskrivningar av mätmetoder och mätfrekvenser finns på https://www.smhi.se/kunskapsbanken/meteorologi/temperatur/hur-mats-lufttemperatur I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/20.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_max_view/wms?service=wms&request=getcapabilities"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet\n\nEnhet: °C\n\nEgenskaper: Maxvärde av lufttemperatur gällande 24 timmar, lagrat 18 UTC. De flesta stationer mäter värden 2 gånger per dygn (06 UTC och 18 UTC) som då gäller 12 timmar och av dessa väljs det högsta värdet för att få fram dygnsvärden. Kvalitetskoden blir i så fall gul. Mäts endast dygnsvärden blir kvalitetskoden grön.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\nKvalitetskoder: Gult = Aggregerade värden \n\nGränser: -60 till +40 °C\n\nFör mer info se: https://www.smhi.se/data/meteorologi/temperatur"},"dct:identifier":"2b84284b-4e01-48ee-8f40-5792c42579f2","dct:issued":{"@type":"xsd:date","@value":"2015-01-09"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lufttemperatur, maxvärde 1 dygn"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/20.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/20.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/20.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av tempmax data via Atomflöde"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ATOM"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av max temperatur"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_max_view/wms?service=wms&request=getcapabilities","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_max_view/wms?service=wms&request=getcapabilities"},"dcat:downloadURL":{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.temperatur_dygn_max_view/wms?service=wms&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för temperatur"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b2n0"},"dct:title":{"@language":"sv","@value":"Visningstjänst för maxtemperatur"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492_b4n0"}}],"@id":"urn:source:11611b4f40f70b42a1b74e865852930b3a976f0ed8be94d99e14a831848a8492"},{"@graph":[{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((-10 71,26 71,26 52,-10 52,-10 71))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(8.15 61.80)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1893-01-01"}},{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Västra Frölunda","http://www.w3.org/2006/vcard/ns#postal-code":"42671","http://www.w3.org/2006/vcard/ns#street-address":"Sven Källfelts Gata 15"},{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46317518975"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/6bf55411-6851-4b20-bf84-f34a6787c297","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"25245"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/shark_smhi.se"},"dcat:dataQuality":"Data samlas vanligtvis in från fartyg och med varierande mätutrustning. För mätning av fysikaliska kemiska parametrar används vattenhämtare och mätutrustning som t ex CTD. Marinbiologiska parametrar mäts på olika sätt beroende på vad det är som ska observeras. Exempel på mätmetoder är planktonnät, dykare som simmar längs speciella mönster och noterar vad de ser, sedimentprovtagare från farttyg och sälobserverationer från helikopter eller båt. Mer information om dessa mätningar finns på https://sharkweb.smhi.se/hamta-data/.\n\nKvalitetssäkring av data innefattar alla aspekter av provtagning och analys framtagna av Naturvårdsverket. Till exempel sker förbehandling av prover före analys på lämpligt sätt för att förhindra kontamination och minskning av halterna i proven.  Laboratorier som utför analys av data skall ha ett kvalitetssäkrings- och kontrollsystem som följer kraven i EN ISO/IEC 17025. Efter analys sker en kvalitetskontroll av data där samtliga parametrar genomgår en jämförelse med normalvärden från område och aktuell årstid. Om datas kvalitet är osäker kan en flaggning införas som beskriver värdets/analysmetodens karaktär.\n\nLäs mer om kvalitetssäkring av data på https://www.havochvatten.se/hav/vagledning--lagar/vagledningar/miljoovervakningens-metoder-och-undersokningstyper-inom-programomrade-kust-och-hav.html.","dcat:distribution":{"@id":"https://sharkweb.smhi.se/hamta-data/"},"dcat:keyword":[{"@language":"sv","@value":"Havsmiljö"},{"@language":"sv","@value":"Havstemperatur"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Salthalt"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Data består av havsmiljödata från marin miljööverakning och finns tillgängligt från 1893 och framåt. Data tas fram inom ramen för Samordnad Svensk Miljöövervakning som finansieras av Havs- och vattenmyndigheten.\n\nFöljande fysikaliska och kemiska parametrar kan erhållas: Temperatur, salthalt, densitet, pH, alkalinitet, syrgashalt, syremättnad, svavelväte, fosfat, totalfosfor, nitrit, nitrat, ammonium, totalkväve, kisel, partikulärt organiskt kväve (PON), partikulärt organiskt kol (POC), löst organiskt kol (DOC), totalt organiskt Kol (TOC), humus, strömriktning, strömhastighet, lignin, gulämne (CDOM), aluminium, urea, klorofyll-a (diskreta prov), siktdjup samt lågupplöst CTD-data.\n\nFöljande marinbiologiska parametrar kan erhållas: Mjukbottenfauna (zoobenthos), Vegetationsklädda bottnar (epibenthos, där makrofyter ingår), djur-, växt- och bakterieplankton, klorofyllhalt (integrerat prov), primärproduktion, sedimentation, förekomst av vikaresäl (ringed seal), gråsäl och knubbsäl (harbour seal), samt sälpatologi.\n\nFör mer information se https://sharkweb.smhi.se/hamta-data/."},"dct:identifier":"6bf55411-6851-4b20-bf84-f34a6787c297","dct:issued":{"@type":"xsd:date","@value":"2015-09-02"},"dct:modified":{"@type":"xsd:date","@value":"2021-11-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b0n0"},"dct:title":{"@language":"sv","@value":"Oceanografiska observationer - Havsmiljödata"}},{"@id":"https://sharkweb.smhi.se/hamta-data/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sharkweb.smhi.se/hamta-data/"},"dcat:downloadURL":{"@id":"https://sharkweb.smhi.se/hamta-data/"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b1n0"},"dct:title":{"@language":"sv","@value":"Nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/shark_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI Göteborg","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:shark@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a_b3n0"}}],"@id":"urn:source:1232ad2c790a756fcd1848c6b7447fca8ced95b2981f19aee68c82b5334cd55a"},{"@graph":[{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/e2140ebe-3719-444a-95f1-74ff0c7264be","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32944"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Nederbörden mäts automatiskt med givare av märket Geonor se https://www.geonor.no. En hink som samlar nederbörden är upphängd med tre metalltrådar varav en är fäst i givaren. Nederbördens vikt mäts och mängden beräknas. Timvisa mätningar infördes 1995.  Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/regn/hur-mats-nederbord. När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt ca 2 timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.  I SMHIs observationsnät ingår stationer som ägs av Försvarsmakten och står på deras flygplatser. De har en optisk givare som genom mätning av nederbördsintensitet kan beräkna nederbördsmängd.  Denna givare har inte samma mätnoggrannhet som givaren från Geonor.\n\nTemporal utsträckning:\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår löpande.","dcat:distribution":[{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-23.atom"},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/23.json"},{"@id":"https://opendata-view.smhi.se/met-obs/ACMF.nederbord_manadssumma_view/wms?service=wms&request=getcapabilities"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-vaderobservationer/precipitationMonthlySum"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver klimatet. Underlag för klimatstudier och prognosverifikation.\n\nEnhet: mm \n\nEgenskaper: Nederbörd uppmätt vid automatiska mätstationer. Summa över en månad baserat på dygnsvisa mätningar. Nederbörden mäts i smält form. Kl. 06 den 1:e varje månad registreras mätvärdet som avser månaden innan.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Aggregerade värden.\n\nGränser: >=0 \n\nFör mer info se: https://www.smhi.se/data/meteorologi/nederbord"},"dct:identifier":"e2140ebe-3719-444a-95f1-74ff0c7264be","dct:issued":{"@type":"xsd:date","@value":"2015-10-01"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:15149e9e7bab954f69b567d72c02534b044dd42338405071f0b4c629e3ffef79_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Nederbörd, summa 1 månad"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-23.atom","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-23.atom"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/inspire/metobs-23.atom"},"dct:descriptio