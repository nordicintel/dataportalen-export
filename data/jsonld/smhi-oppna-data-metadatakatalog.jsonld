https://opendata-catalog.smhi.se/md/81074210-7d22-11ed-a51b-432755aaeed3","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"24732"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/hydrolog_smhi.se"},"dcat:dataQuality":"-","dcat:distribution":[{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/8.json"},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/9.json"},{"@id":"https://www.smhi.se/data/hitta-data-for-en-plats/ladda-ner-observationer-fran-sjoar-och-vattendrag/snowDensity"}],"dcat:keyword":[{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Snö"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt och historiskt hydrologiskt tillstånd i Sverige.\n\nEnhet: g/cm3 samt mm\n\nEgenskaper: Uppgift om snöns densitet samt snöns vatteninnehåll i Sverige.\n\nNätinformation:\n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data rimlighetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. Fysiska stationer övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Stationerna ingår ej i SMHIs stationsnät men data samlas in och lagras i SMHIs databaser genom avtal med en tredje part.\n\nKvalitetskoder: Grön (G) = Kontrollerade och godkända värden. Gul (Y) = Grovt kontrollerade värden, misstänkta eller aggregerade värden. Orange (O) = Okontrollerade värden"},"dct:identifier":"81074210-7d22-11ed-a51b-432755aaeed3","dct:issued":{"@type":"xsd:date","@value":"2022-12-16"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Hydrologiska observationer - Snödensitet"}},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/8.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/8.json"},"dcat:downloadURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/8.json"},"dct:description":{"@language":"sv","@value":"API för nedladdning av snödensitet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:b80fb9bdd798641d25cd4d7e05a2cfe15097d4725913cb7089b11f3557cb2c86_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning av snödensitet"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/9.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/9.json"},"dcat:downloadURL":{"@id":"https://opendata-download-hydroobs.smhi.se/api/version/latest/parameter/9.json"},"dct:description":{"@language":"sv","@value":"API för nedladdning av vatteninnehåll i snö"},"dct:format":{"@id":"http://public