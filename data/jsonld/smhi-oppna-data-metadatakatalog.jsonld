idelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/0f0138d0-30cd-11ec-8216-93597db8ce1c","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27900"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Det som ligger till grund för att en varning utfärdas är den aktuella väderprognosen. Om väderprognosen indikerar att vissa tröskelvärden kan uppnås görs en bedömning av vilka konsekvenser vädret kan medföra. I denna bedömning vägs regionala förutsättningar och förhållanden in. SMHI samverkar i de allra flest fall med berörda samhällsaktörer innan beslut om varning fattas. Varningen följs sedan upp kontinuerligt utifrån senast tillgängliga underlag, fram tills dess att händelsen är över. Justeringar av varningen kan göras om nya prognoser till exempel visar att området som omfattas bedöms ändrat, eller att högre eller lägre varningsnivå bör gälla.","dcat:distribution":[{"@id":"https://opendata-download-warnings.smhi.se/ibww/api/version/1"},{"@id":"https://opendata.smhi.se/warnings/"}],"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Hydrologi"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Molnhöjd"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsintensitet"},{"@language":"sv","@value":"Nederbördstyp"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Sikt"},{"@language":"sv","@value":"Varningar"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Åska"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"SMHIs prognos- och varningstjänst ger information för skydd av liv och egendom. Arbetet bedrivs dygnet runt och SMHI har ständig beredskap för akuta insatser. SMHI utfärdar varningar när vädret väntas medföra konsekvenser eller störningar i samhället. Det finns tre varningsnivåer; gul varning, orange varning och röd varning. Röd varning är den allvarligaste nivån. Varningsnivån berättar hur allvarliga konsekvenser som väntas. \n\nSMHI utfärdar också meddelande om brandrisk, risk för vattenbrist och höga temperaturer.\n\nLäs mer om varningar och meddelanden i SMHIs kunskapsbank, https://www.smhi.se/kunskapsbanken/meteorologi/varningar-och-meddelanden."},"dct:identifier":"0f0138d0-30cd-11ec-8216-93597db8ce1c","dct:issued":{"@type":"xsd:date","@value":"2021-10-26"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b0n0"},"dct:title":{"@language":"sv","@value":"Konsekvensbaserade vädervarningar - API"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-warnings.smhi.se/ibww/api/version/1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-warnings.smhi.se/ibww/api/version/1"},"dcat:downloadURL":{"@id":"https://opendata-download-warnings.smhi.se/ibww/api/version/1"},"dct:description":{"@language":"sv","@value":"API för hämtning av varningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"dct:rights":{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b1n0"},"dct:title":{"@language":"sv","@value":"Konsekvensbaserad vädervarningar - API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/warnings/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/warnings/"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/warnings/"},"dct:description":{"@language":"sv","@value":"API-dokumentation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"dct:rights":{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b2n0"},"dct:title":{"@language":"sv","@value":"Konsekvensbaserade vädervarningar - API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f_b4n0"}}],"@id":"urn:source:5c06c0f65fe95106d158fa962e6cddb925a6655fbcf62e082d305dd5fdfb052f"},{"@graph":[{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/33b5d295-c9e7-4c1d-b890-fcd86d4f7573","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30827"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Total molnmängd bedöms på manuella stationer och mäts med ett laserinstrument på automatiska stationer. Lasern mäter under en halvtimme antalet molnträffar och utifrån det kan en molnmängd beräknas, där de senaste tio minuternas molnträffar viktas högre. Begränsningen med laserinstrumentet är att det tittar rakt upp och beroende på molnens rörelse och läge kan metoden både överskatta och underskatta molnmängden. Vissa stationer hade tidigare givare av en äldre modell. Dessa hade en maximal mäthöjd på 3800 m och missade moln på högre höjder, vilket gav ett osäkert mätvärde generellt (kvalitetskod satt till röd). Successivt har dessa givare bytts ut till nya med dubblerad mäthöjd. Den manuella metoden bygger på att uppskatta hur många åttondelar av himlen som täcks av moln. Då motsvarar 0 åttondelar 0 % och klart medan 8 åttondelar är 100 % och heltäckt. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/moln/hur-mats-molnighet. I samband med att data lagras till databasen körs automatiska kontroller som sätter en kvalitetskod. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.\n\nTemporal utsträckning\nI huvudsak komplett sedan 1961. Laddning av äldre historiska data pågår.","dcat:distribution":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/50.json"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognosverifikation.\n\nEnhet: % \n\nEgenskaper: Den totala molnmängden uppmätt var femte minut. Om molnmängden inte går att avgöra på grund av dimma, nederbörd eller andra siktnedsättande fenomen så sätts värdet till 113%.\n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Rött (R) = Misstänkta/felaktiga data eller data som kommer från en givare med max mäthöjd 3800 m. Den missar moln på högre höjd, vilket ger ett osäkert mätvärde generellt.\n\nGränser: 0 till 100 % samt 113 %\n\nFör mer info se: https://www.smhi.se/kunskapsbanken/meteorologi/moln/molnighet"},"dct:identifier":"33b5d295-c9e7-4c1d-b890-fcd86d4f7573","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Total molnmängd, var 5:e minut"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/50.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/50.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/50.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46_b3n0"}}],"@id":"urn:source:5ce351dff29c4557b13df308a72266d92891aa10428b7af66a3a45d137090c46"},{"@graph":[{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((2 72,43 72,43 52,2 52,2 72))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(22.15 62.15)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/meteorology/cmeps/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/meteorology/cmeps/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/meteorology/cmeps/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b0n0"},"dct:title":{"@language":"sv","@value":""},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/d7568ec4-d9e0-4f8f-bf01-e9f672a79198","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"29985"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Modellen skapar prognoser över väderutvecklingen genom att simulera väderutvecklingen utifrån en uppskattning av initialtillståndet. Detta initialtillstånd estimeras genom att inkludera information från ett stort antal olika observationer från väderstationer, flygplan, radar och vädersatelliter mm.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/meteorology/cmeps/"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Molnmängd"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Relativ luftfuktighet"},{"@language":"sv","@value":"Vindhastighet"},{"@language":"sv","@value":"Vindriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING: Datafilerna innehåller analys- och prognosdata från prognosmodellen MEPS.  MEPS är ett ensembleprognossystem med totalt 15 medlemmar under en tretimmarsperiod. Detta innebär att MEPS producerar 15 olika prognoser för varje prognostillfälle där de olika medlemmarna har lika initialtillstånd baserat på randvärden från utvald ensembleperturbation från Europeiska vädercentersmodell. Genom att använda informationen i samtliga ensemble-medlemmar kan olika sannolikheter beräknas, t ex hur osäker prognosen är. Om man endast är intresserad en deterministisk prognos används MEPS medlem 0. Varje modellmedlem körs var 3:e timme med prognoser 66 timmar framåt i tiden för medlem. Samtliga medelmarsdata genereras i grib2 format, där hämtas endast ett begränsat antal parametrar från medlemmarna för varje tidpunkt de genererats. För medlem 0 och 1 så hämtas alla parametrar i grib1 format för var sjätte timme, 00, 06, 12 och 18 UTC.\n\nPrognosen görs över ett område som täcker Skandinavien, Finland, Danmark, Baltikum, Nordsjön och delar av nordöstra Europa. Området är uppdelat i gridrutor med 2.5km upplösning och 65 vertikala nivåer. Det finns ett stort antal parametrar som beskriver temperatur, nederbörd, vind, luftfuktighet, molnighet mm.\n\nANVÄNDNING: På SMHI används data från MEPS som underlag för väderprognoser samt som indata till andra modeller inom t ex hydrologi och oceanografi.\n\nFORMAT: Data är i GRIB-format."},"dct:identifier":"d7568ec4-d9e0-4f8f-bf01-e9f672a79198","dct:issued":{"@type":"xsd:date","@value":"2018-06-28"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b1n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk modell (MEPS) - Prognosdata realtid"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af_b3n0"}}],"@id":"urn:source:5cebf5eb8e3236552f1c1512836dc3ba687215f280aadc9591a88e58e72dd1af"},{"@graph":[{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((-4 66,30 66,30 49,-4 49,-4 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(13.05 57.20)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-11-06"}},{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/oceanography/nemo-nsbs01-short/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/oceanography/nemo-nsbs01-short/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/oceanography/nemo-nsbs01-short/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. Filerna med realtidsdata nås via webtjänst mot leveransavgift. Måste laddas ned och sparas innan vidare användning. Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b0n0"},"dct:title":{"@language":"sv","@value":"Nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/2d1e3c28-0b79-4051-bc31-cf72075411dd","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28542"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se"},"dcat:dataQuality":"Modellen simulerar de fysikaliska lagarna i havet med hjälp av rörelseekvationer och termodynamiska lagar. Modellen stegas framåt i tiden med små tidssteg och simulerar de oceanografiska processerna i gridrutor i 3 dimensioner. Lufttrycket påverkar havsytan och får den att sjunka vid högt tryck och stiga vid lågt tryck. Tidvattnet påverkar vattenståndet på västkusten. Luftens temperatur påverkar ytvattnets temperatur och vinden blandar om den översta delen av havet m.h.a. turbulens. Vindar påverkar även vattenståndet genom s.k. vindstuvning. Avrinning från floder lägger sig ovanpå havsvattnet och blandas ned m.h.a. vinden och gör havsvattnet mindre salt. Vid stormiga väderlägen trycks ibland stora mängder högsalint havsvatten genom Öresund och Bältsunden in i Östersjön. På vintern simulerar modellen istillväxt, isdrift och isavsmältning.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/oceanography/nemo-nsbs01-short/"},"dcat:keyword":[{"@language":"sv","@value":"Havstemperatur"},{"@language":"sv","@value":"Havsvattenstånd"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Oceanografi"},{"@language":"sv","@value":"Salthalt"},{"@language":"sv","@value":"Strömhastighet"},{"@language":"sv","@value":"Strömriktning"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"BESKRIVNING\nDatamängden innehåller prognosdata från prognosmodellen NEMO-Nordic. Första filen slutar på +000H00M och sedan följer prognosfiler för varje timme upp till +060H00M.\nNEMO-Nordic är en oceanografisk prognosmodell som beskriver tillståndet i havet för ett antal fysikaliska parametrar. Var 6:e timme körs en 60-timmars prognos som bygger på dataassimilation av tillgängliga   observationer. Som indata används meteorologiska prognosmodellen Arome och prognosmodellen från ECMWF samt floddata från den hydrologiska modellen HYPE.\nPrognos görs för bl.a. temperatur, salthalt, strömmar, vattenstånd och is. Området som täcks av NEMO-Nordic är hela Östersjön, Sveriges västkust (Kattegatt och Skagerrak), Nordsjön och Engelska kanalen.\n\nVid användning av vattenståndsdata ska data offsetkorrigeras eftersom modellens nollnivå inte är samma som vattennivån för området. Offsetkorrigeringen görs utifrån observationer. Korrigeringen ska utföras löpande för varje station, eftersom de har olika referensnivåer.  \nEn metod för offsetkorrigering är att använda ett löpande medelvärde för några dagar bakåt i tiden. Det räknas ut varje timme utifrån de senaste observationerna.\n\nLEVERANS\nI denna tjänst kan du ladda ned filer med realtidsdata via web-tjänst mot leveransavgift.\nFilerna ska sparas innan vidare användning. \nSkicka mail till kundtjanst@smhi.se för beställning.\n\nKOORDINATER\nKoordinaterna för området ges av hörnen:\nsydvästra \tlat: 48.5,\tlon: -4.1\nnordvästra \tlat: 65.9, \tlon: -4.1 \nnordöstra\tlat: 65.9,\tlon: 30.2\nsydöstra \tlat: 48.5,\tlon: 30.2\nGridrutorna är 1 nautisk mil (ca 2*2 km).\nObservera att området norr om Nordsjön (ca 59.3 grader) inte ingår i gridet.\t\n\nPARAMETRAR\ndslm         - Vattenstånd\nDTKE        - Dissipation av turbulens(turbulent kinetic energy)\nicec          - Iskoncentration\nicetk         - Istjocklek\ns               - Salthalt\nt                - Temperatur\nTKE           - turbulens\nu                - ström i östlig riktning (3D fält)\nucur          - ström i östlig riktning på ytan\nuice          - isrörelse i östlig riktning\nv               - ström i nordlig riktning\nvcur          - ström i nordlig riktning på ytan\nvice          - isrörelse i nordlig riktning\nwcur_ge  - uppåtgående ström\n\nANVÄNDNING\n\nPå SMHI används data från NEMO-Nordic till bland annat vattenståndsvarningar, isprognoser och utredningar. NEMO-Nordic data används även som indata till andra modeller, ett exempel är oljespillsmodellen SeatrackWeb.\nExterna användare använder NEMO-Nordic som indata till egna oceanografiska modeller via det internationella BOOS-samarbetet. Försvarsmakten och ett par kommuner använder också NEMO-Nordic data.\n\n\nFORMAT\nData levereras i GRIB-format. Information som underlättar användningen finns på:\nhttps://www.smhi.se/data/temperatur-och-vind/temperatur/historisk-data-i-grib-format/sa-fungerar-grib-format"},"dct:identifier":"2d1e3c28-0b79-4051-bc31-cf72075411dd","dct:issued":{"@type":"xsd:date","@value":"2016-10-26"},"dct:modified":{"@type":"xsd:date","@value":"2021-03-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b1n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b1n0"},"dct:title":{"@language":"sv","@value":"Oceanografisk prognosmodell (NEMO-Nordic) - 60 TIM realtid"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/oceanograf_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oceanograf@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845_b3n0"}}],"@id":"urn:source:5d841e1b2f0c1e2a22801e0905651144ac09946d6f94ecdfed60030878f68845"},{"@graph":[{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10 70,25 70,25 55,10 55,10 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.50 62.50)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2c789229-7fb2-485b-ad6e-505e4081d667","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"30036"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Idag görs mätningar av lufttrycket med elektroniska lufttryckssensorer. Historiskt har det vanligaste instrumentet varit kvicksilverbarometer. Mekaniska givare har också förekommit. Beskrivningar av mätmetoder och mätfrekvenser finns på: https://www.smhi.se/kunskapsbanken/meteorologi/lufttryck/hur-mats-lufttryck När data lagrats i databasen körs automatiska kontroller som sätter en kvalitetskod. Detta tar normalt cirka två timmar. Värden som inte godkänns av kontrollerna granskas sedan manuellt. Antingen godkänns eller rättas de, vilket ger en ny kvalitetskod. Rättelser av felaktiga eller misstänkta värden sker även vid påpekande från användarna.","dcat:distribution":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/9.json"},"dcat:keyword":[{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Lufttryck"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Syfte: Beskriver aktuellt väder och med tiden klimatet. Underlag för prognoser och klimatstudier.\n\nEnhet: Pascal \n\nEgenskaper: Stationerna mäter lufttryck. Eftersom trycket bland annat beror på höjden över havet, räknas det om till ett värde som representerar trycket vid havsytans nivå, för att värdena från olika stationer ska kunna jämföras. \n\nNätinformation: \n- SMHIs stationsnät: Data samlas in och lagras i SMHIs databaser. Data kvalitetskontrolleras vilket innebär att felaktiga data korrigeras och att databortfall kompletteras utifrån expertbedömning där det är möjligt. De flesta av stationerna övervakas, inspekteras och underhålls löpande av SMHI.\n- Övriga stationer: Data samlas in och lagras i SMHIs databaser. Datakvaliteten är för SMHI okänd då SMHI varken utför kvalitetskontroll på data eller inspektioner på stationerna.\n\nKvalitetskoder: Grönt = Kontrollerade och godkända värden. Gult = Misstänkta värden, aggregerade värden, grovt kontrollerade arkivdata och okontrollerade realtidsdata (senaste 2 tim). \n\nGränser: 80000 till 107000 pascal \n\nFör mer info se: https://www.smhi.se/data/meteorologi/lufttryck"},"dct:identifier":"2c789229-7fb2-485b-ad6e-505e4081d667","dct:issued":{"@type":"xsd:date","@value":"2014-09-30"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b0n0"},"dct:title":{"@language":"sv","@value":"SE.ACMF Meteorologiska observationer - Lufttryck vid havsytan, timvärde"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/9.json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/9.json"},"dcat:downloadURL":{"@id":"https://opendata-download-metobs.smhi.se/api/version/latest/parameter/9.json"},"dct:description":{"@language":"sv","@value":"Nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatolog@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7_b3n0"}}],"@id":"urn:source:636bbec041908dee2514d08a10d31953428b9ef30227e49435d078a91d1681b7"},{"@graph":[{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b1n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((27 71,38 71,38 53,27 53,27 71))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(32.66 61.62)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://data-download.smhi.se/data/meteorology/knep/","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-download.smhi.se/data/meteorology/knep/"},"dcat:downloadURL":{"@id":"https://data-download.smhi.se/data/meteorology/knep/"},"dct:description":{"@language":"sv","@value":"Nedladdning av filer. LEVERANSFilerna med realtidsdata nås via webtjänst mot leveransavgift.Måste laddas ned och sparas innan vidare användning.Skicka mail till kundtjanst@smhi.se för beställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b0n0"},"dct:title":{"@language":"sv","@value":""},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata-catalog.smhi.se/md/be9d3f7b-2fbc-4dca-92f9-baee027a3f89","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23499"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Modellen försöker skapa en med verkligheten bättre överensstämmande nederbördsprognos för dom första prognostidsstegen genom att använda radarobservationer av nederbörden. Nederbördens troliga rörelse beräknas med hjälp av vindhastighet och vindriktning från meteorologisk prognosmodell. Med hjälp av temperatur görs en beräkning av andelen av nederbörden som kommer i fast form.","dcat:distribution":{"@id":"https://data-download.smhi.se/data/meteorology/knep/"},"dcat:keyword":[{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"ODD"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Meteorologisk modell (KNEP) - kort nederbördsprognos\n\nBESKRIVNING:\nI denna datamängd finns prognosdata från prognosmodellen KNEP. Knep är en kort prognos för nederbörd med 1-6 timmars prognoslängder. Prognosen utgår från nederbördsmängd beräknad utifrån radardata som under 6 prognostidssteg med justerad viktning övergår i antingen MEPS eller ECMWF meteorologiska prognosmodell. Modellen körs varje timme.\n\nPrognosen täcker ett område över Skandinavien och har rumslig upplösning på ca 2.5 km.\n\nANVÄNDNING:\nPå SMHI används vidarebearbetad data från KNEP som en möjlig delmängd i prognosmodellen PMP_P.\n\nFORMAT:\nData är i format GRIB edition 1.\n\nTILLKOMSTHISTORIK/REDOGÖRELSE:\nModellen försöker skapa en med verkligheten bättre överensstämmande nederbördsprognos för dom första prognostidsstegen genom att använda radarobservationer av nederbörden. Nederbördens troliga rörelse beräknas med hjälp av vindhastighet och vindriktning från meteorologisk prognosmodell. Med hjälp av temperatur görs en beräkning av andelen av nederbörden som kommer i fast form."},"dct:identifier":"be9d3f7b-2fbc-4dca-92f9-baee027a3f89","dct:issued":{"@type":"xsd:date","@value":"2018-06-28"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b1n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b1n0"},"dct:title":{"@language":"sv","@value":"Meteorologisk modell KNEP (ca 2,5 km upplösning) - Prognosdata realtid"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce_b3n0"}}],"@id":"urn:source:6a831120296f63c708d393f7a01537d423c1aa32b8d659a6599b18097410cbce"},{"@graph":[{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9 69,30 69,30 54,9 54,9 69))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(19.56 61.64)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1970-01-01"}},{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b3n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/7d396a18-2a22-44e8-9d07-cf1d24dcec69","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32580"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se"},"dcat:dataQuality":"Mätmetod\nMed radarteknik är det möjligt att upptäcka föremål och bestämma dess position. En väderradar detekterar bland annat nederbörd och gör det med hög upplösning i både tid och rum. Radarinformation insamlas och bearbetas i olika steg för att bilda produkter. Vissa av produkterna används för att bilda andra sammansatta produkter, så kallade kompositer. En väderradar avsöker (sveper) normalt horisonten och insamlar ekon från nederbörd. Detta görs ett varv i taget med olika elevationsvinklar. En sådan avsökning kallas för svep. En volym innehåller ett eller flera svep. Både svep och volymer används för att bilda produkter med de uppmätta parametrarna. Produkterna är i huvudsak i kartesiskt format(raster).  \n\nKvalitetskontroller\nDen höjdbaserade produkten är korrigerad för topografisk blockering och anomalier, i den kvalitetsbaserade produkten ingår ej topografisk blockering. Dock ingår andra kontroller som ersätter denna. Den kvalitetsbaserade produkten innehåller även kontroller som medför att en förbättrad filtrering kan göras med avseende på anomalier och olika typer av artefakter. Kvalitetskontrollerna förbättras löpande. \n\nKompositprodukt\nKvalitetsinformation förekommer i separata uppsättningar till respektive uppsättning av reflektivetsvärden. Utformningen är samma som reflektivitetsvärdena. Kvalitetsinformationen består av värden från 0 till 1, där värde 0 motsvarar sämst kvalitet ochvärde 1 motsvarar bäst kvalitet. Kvalitetsinformationen är applicerad på reflektivitetsvärdena.\n\nropo - Anomalikontroll\nbeamb - Topografisk blockering\ndistance - Distans pixel till täckande radar\nqi_total - Kvalitetsindex\nRadar-index - Mappning mellan radar och WMO nummer\nVarje kvalitetsdataset har ett ’gain’ och en ’offset’ som skall appliceras.\n\nVolymer\nKvalitetskontroller (applicerade på kvantiteten DBZH):\nropo - Anomalikontroll\nbeamb - Topografisk blockering\nqi_total - Kvalitetsindex\nVarje kvalitetskontroll har ett ’gain’ och en ’offset’ som skall appliceras","dcat:distribution":[{"@id":"https://opendata-download-radar.smhi.se/api"},{"@id":"https://opendata.smhi.se/radar/api"},{"@id":"https://www.smhi.se/data/meteorologi/radararkiv"}],"dcat:keyword":[{"@language":"sv","@value":"Blixt"},{"@language":"sv","@value":"HVD"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Nederbördsintensitet"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Observation"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Via denna tjänst erhålls en kvalitetskontrollerad kompositprodukt med radarinformation från de 12 svenska väderradaranläggningarna samt kvalitetskontrollerade individuella radarvolymer.\n\nNytt från och med 2023-05-03 är att metoden att kompositera data från de 12 anläggningarna har ändrats. Före 2023-05-03 användes enbart så kallad höjdbaserad kompositering vilket innebär att i geografiska punkter som täcks av flera radaranläggningar används data som är närmast havsnivån.\n\nEfter 2023-05-03 används även så kallad kvalitetsbaserad kompositering vilket innebär att för geografiska punkter som täcks av flera radaranläggningar så används data från den radaranläggning som uppvisar högst kvalitet (givet vissa kvalitetsindikatorer). Kvalitetsbaserad kompositering medger att man kan eliminera, eller i varje fall minimera, artefakter som ofta finns när höjdbaserad kompositering används.\n\nVäderradar är ett värdefullt hjälpmedel när man gör meteorologiska och hydrologiska prognoser.\n\nRadarprodukterna finns tillgängliga som PNG, GeoTIF (komposit) och hdf5 (komposit och enskilda radarvolymer).\n\nPNG och GEOTIF (kompositprodukt)\nNy produkt genereras var 5:e minut. Radarbilder från oktober 2008 fram till nu tillhandahålls. Bilder efter 2023-05-03 är gjorda från den kvalitetsbaserade kompositen. Bilderna levereras dels via ett gränssnitt (GUI) och dels via ett programmerbart gränssnitt (API). I gränssnittet visas enskilda bilder från valt dygn och helt dygn kan laddas ned. I Api kan enskild bild och helt dygn laddas ned. Ett helt dygn laddas i båda fallen ned som ett zip-arkiv.\nStorhet: Reflektivitet, styrka på radarekon.\nEnhet: dBZ\nEgenskaper: Reflektivitet kan översättas till nederbördsintensitet. Reflektivitetsvärdena är representativa för marknivå.\nUtformning: 2-dimensionell array (matris) med reflektivitetsvärden, rad för rad från nord till syd, från vänster (väst) till höger (öst).\nGränser: Värden mellan -30 och +72 dBZ. Reflektivitetsvärden >5 dBZ räknas som nederbörd. Skalan är logaritmisk, vilket innebär att negativa värden representerar mycket svaga ekon som detekteras nära väderradaranläggningen.\n\nHDF5 - (kompositprodukt och enskilda radarvolymer)\nRadarfilerna levereras via ett programmerbart gränssnitt (API). Där kan enskild radarfil och helt dygn laddas ned. Ett helt dygn laddas i båda fallen ned som ett zip-arkiv. Ny produkt genereras var 5.e minut.\n\nBeskrivning av kompositprodukt\nReflektivitetskomposit sammansatt av enskilda radarsvep med elevation 0.5° från upp till 12 väderradar i Sverige,\nKompositmetod: Höjdbaserad kompositering vilket innebär att i geografiska punkter som täcks av flera radaranläggningar används data som är närmast havsnivån.\nSpatial upplösning: 2000 m x 2000 m, 458 pixlar x 881 pixlar\nTemporal upplösning:var 5:e minut med start, nominellt, hh:00. \nProjektion: Polärstereografisk\nProjektionsdefinition: projdef = +proj=stere +ellps=bessel +lat_0=90 +lon_0=14 +lat_ts=60 +towgs84=0,0,0\nReferenssystem: WGS 84, EPSG 4326\nStorhet: Reflektivitet, styrka på radarekon.\nUtformning: 2-dimensionell array med reflektivitetsvärden,rad för rad från nord till syd, från vänster (väst) till höger (öst).\nGränser: Värden mellan -30 och +72 dBZ. Skalan är logaritmisk, vilket innebär att negativa värden representerar mycket svaga ekon som detekteras nära väderradaranläggningen d.v.s på tämligen låg höjd.\nEnhet för reflektivitet: dBZ (som ges via applikation av respektive reflektivitetsdatasets \"gain\" och \"offset\")\nEgenskaper: Reflektivitet kan översättas till nederbördsintensitet. I HDF5-filerna finns två uppsättningar reflektivitetsvärden, den ena uppsättningen består av de  intensitetsvärden som uppmätts, den andra uppsättningen är intensitetsvärden justerade mot nederbördsgivare, således representativ för marknivå.\n\nKvantiteter:\nDBZH - Reflektivitet\nBRDR - Radargränser\nDBZH_CORR - Reflektivitet justerad mot nederbördsgivare\nVarje kvantitetsdataset har ett \"gain\" och en \"offset\" som skall appliceras.\n\nBeskrivning av radarvolym\nIndividuell radarvolym från de 12 svenska radaranläggningarna innehållande kvalitetskontrollerade radarsvep med olika elevationsvinklar.\nFormat: HDF5-fil med sfäriska koordinater (radie, bäring, elevation)\nElevationsvinklar: normalt 0.5°, 1.0°, 1.5°, 2.0°, 2.5°, 4.0°, 8.0°, 14.0°, 24.0°, 40.0°, men kan vara färre beroende på om radarsystemet bedömt att någon defekt finns i något/några svep.\nSpatial upplösning: varierar som funktion av elevationsvinkel\nTemporal upplösning: var 5:e minut med start, nominellt, hh:00\n\nKvantiteter \nDBZH - Reflektivitet, horisontell polarisation\nLDR - Linjärt depolarisationsindex\nUSNRH - Okorrigerat och normaliserat signal-brus förhållande\nWRADH - Spektralvidd radiell hastighet, horisontell polarisation\nSQIH - Signalkvalitetsindex, horisontell polarisation\nCCORH - Klutterkorrektion, horisontell polarisation\nVRADH - Radiell hastighet, horisontell polarisation\nTH - Okorrigerad reflektivitet, horisontell polarisation\nVarje kvantitet har ett \"gain\" och en \"offset\" som skall appliceras\n\nMer information om hdf5-formatet: https://www.eumetnet.eu/wp-content/uploads/2017/01/OPERA_hdf_description_2014.pdf\n\nMer informationom radar: https://www.smhi.se/kunskapsbanken/meteorologi/radar"},"dct:identifier":"7d396a18-2a22-44e8-9d07-cf1d24dcec69","dct:issued":{"@type":"xsd:date","@value":"2015-06-01"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b0n0"},"dct:title":{"@language":"sv","@value":"Meteorologiska observationer - Radar: Sverigekomposit och enskilda volymer"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_164e0bf5"}},{"@id":"https://opendata-download-radar.smhi.se/api","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata-download-radar.smhi.se/api"},"dcat:downloadURL":{"@id":"https://opendata-download-radar.smhi.se/api"},"dct:description":{"@language":"sv","@value":"API för hämtning av hdf5, PNG och GeoTif"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b1n0"},"dct:title":{"@language":"sv","@value":"API för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://opendata.smhi.se/radar/api","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/radar/api"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/radar/api"},"dct:description":{"@language":"sv","@value":"Information till utvecklare"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b2n0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/meteorologi/radararkiv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/meteorologi/radararkiv"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/meteorologi/radararkiv"},"dct:description":{"@language":"sv","@value":"Webbplats för nedladdning ab PNG och GeoTif"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b3n0"},"dct:title":{"@language":"sv","@value":"GUI för nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/kundtjanst_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b4n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kundtjanst@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be_b5n0"}}],"@id":"urn:source:6c51f5c617a7ada09d574b43a459036138a62d0347dde22aa6f8ea9c7d2f85be"},{"@graph":[{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b0n0","@type":["dct:Location","dct:PeriodOfTime"],"dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11 66,24 66,24 55,11 55,11 66))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.58 60.54)"},"dcat:endDate":{"@type":"xsd:date","@value":"2023-06-06"},"dcat:startDate":{"@type":"xsd:date","@value":"1989-01-01"}},{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/2124a8b6-2f07-415c-ba55-fb16afc5f1fc","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"20525"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se"},"dcat:dataQuality":"Det nationella övervakningsprogrammet initierades av Naturvårdsverket och finansieras nu av Havs- och vattenmyndigheten.","dcat:distribution":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-greyseal-nat"},"dcat:keyword":{"@language":"sv","@value":"Öppna data"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"Information om programmet och metoderna finns på svenska på Havs- och vattenmyndighetens webbplats. \n - https://www.havochvatten.se/hav/samordning--fakta/miljoovervakning/miljoovervakningens-programomrade-kust-och-hav/delprogram-sal-och-havsorn.html \n - https://www.havochvatten.se/vagledning-foreskrifter-och-lagar/vagledningar/ovriga-vagledningar/undersokningstyper-for-miljoovervakning/undersokningstyper/grasalsbestand.html\n\nData lagras i Svenskt HavsARKiv (SHARK) av Sveriges meteorologiska och hydrologiska institut (SMHI).\nÖvervakningen utförs av Naturhistoriska riksmuseet."},"dct:identifier":"2124a8b6-2f07-415c-ba55-fb16afc5f1fc","dct:issued":{"@type":"xsd:date","@value":"2022-09-10"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b0n0"},{"@id":"https://www.geonames.org/6255148"}],"dct:temporal":{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b0n0"},"dct:title":{"@language":"sv","@value":"SHARK - Nationell marin miljöövervakning av gråsäl i Sverige sedan 1989."}},{"@id":"https://www.gbif.se/ipt/resource?r=smhi-greyseal-nat","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-greyseal-nat"},"dcat:downloadURL":{"@id":"https://www.gbif.se/ipt/resource?r=smhi-greyseal-nat"},"dct:description":{"@language":"sv","@value":"Global Biodiversity Information Facility GBIF-Sweden, portalen för fri tillgång till data om biologisk mångfald."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b1n0"},"dct:title":{"@language":"sv","@value":"GBIF ipt"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/dataleveranser_smhi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SMHI","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:dataleveranser@smhi.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f_b3n0"}}],"@id":"urn:source:6d42ebd3c6cbb2fffcb871aed414a1144068bbee0114e8e041cce8bf8b049e0f"},{"@graph":[{"@id":"_:708774025daa450f2d6bcabb