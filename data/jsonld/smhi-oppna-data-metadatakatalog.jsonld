dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((6 70,29 70,29 54,6 54,6 70))"},"dcat:centroid":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.05 61.87)"},"dcat:endDate":{"@type":"xsd:date","@value":"2026-10-17"},"dcat:startDate":{"@type":"xsd:date","@value":"1961-01-01"}},{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b1n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#attributionURL":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2021000696"},"http://schema.theodi.org/odrs#copyrightStatement":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#jurisdiction":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"},"http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://www.smhi.se/data/om-smhis-data/villkor-for-anvandning"}},{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Norrköping","http://www.w3.org/2006/vcard/ns#postal-code":"60176","http://www.w3.org/2006/vcard/ns#street-address":"Folkborgsvägen 17"},{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46114958000"}},{"@id":"http://dataportal.se/organisation/SE2021000696","@type":"foaf:Agent","dct:identifier":"2021000696","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:opendata-support@smhi.se"},"foaf:name":{"@language":"sv","@value":"Sveriges meteorologiska och hydrologiska institut"},"foaf:page":{"@id":"https://www.smhi.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/6"},{"@id":"https://metadata.havochvatten.se/store/1/resource/382"},{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/opendata_support_smhi.se"}]},{"@id":"https://opendata-catalog.smhi.se/md/d8ec2980-752c-11ed-a51b-432755aaeed3","@type":"dcat:Dataset","dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27855"},"dcat:contactPoint":{"@id":"https://www.smhi.se/data/utforskaren-oppna-data/klimatolog_smhi.se"},"dcat:dataQuality":"Data från SMHIs meteorologiska stationer har interpolerats till databasens gridrutor med hjälp av en geostatistisk interpolationsmetod som benämns optimal interpolation.","dcat:distribution":[{"@id":"https://opendata.smhi.se/pthbv/api"},{"@id":"https://www.smhi.se/data/nederbord-och-fuktighet/nederbord/griddad-nederbord--och-temperaturdata"}],"dcat:keyword":[{"@language":"sv","@value":"Lufttemperatur"},{"@language":"sv","@value":"Meteorologi"},{"@language":"sv","@value":"Modelldata"},{"@language":"sv","@value":"Nederbördsmängd"},{"@language":"sv","@value":"Öppna data"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.w3.org/TR/vocab-dcat/"},"dct:description":{"@language":"sv","@value":"PTHBV är en klimatdatabas som byggts upp med särskild inriktning för hydrologiska modellberäkningar. Databasen innehåller dygnsvärden för nederbörd och temperatur, vilka framförallt används som indata vid beräkningar med hydrologiska modeller, exempelvis S-Hype- och HBV-modellen. Klimatdata från 1961 och framåt finns i PTHBV lagrade i ett rikstäckande rutnät med upplösningen 4x4 km. PTHBV är en förkortning av Precipitation Temperature Hydrologiska Byråns Vattenmodell.\n\nData från SMHIs meteorologiska stationer har interpolerats till databasens gridrutor med hjälp av en geostatistisk interpolationsmetod som benämns optimal interpolation. Metoden innebär bland annat att hänsyn tas både till stationernas avstånd från beräkningsrutan och till deras inbördes korrelation. För att beskriva den rumsliga variationen används information om topografi, typisk vindriktning och vindstyrka i olika delar av landet.\n\nI databasen har den observerade nederbörden även korrigerats för mätförluster, som framför allt orsakas av att en del av nederbörden blåser förbi nederbördsmätaren. Mätförlusterna har beräknats enligt metoder som anges av Alexandersson (2003). Dessa metoder tar hänsyn till hur vindutsatt mätstationen är och om nederbörden faller som snö eller regn, vilket avgörs utifrån temperaturen.\n\nPTHBV-databasen bygger främst på observationer från de svenska meteorologiska stationer som ingår i SMHIs stationsnät. I gränstrakterna mot Norge nyttjas även ett antal stationer i Meteorologisk institutts stationsnät i Norge. En gång per år, i april, görs en genomgång av förändringar i stationsnätet. Efter denna genomgång uppdateras databasen med de omräknade värdena för föregående år, samt för perioden januari till februari under innevarande år. Nedläggning eller nystart av stationer kan i vissa fall orsaka homogenitetsbrott i databasens tidsserier."},"dct:identifier":"d8ec2980-752c-11ed-a51b-432755aaeed3","dct:issued":{"@type":"xsd:date","@value":"2022-12-06"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-24"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021000696"},"dct:spatial":[{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b0n0"},{"@id":"https://www.geonames.org/2661886"}],"dct:temporal":{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b0n0"},"dct:title":{"@language":"sv","@value":"PTHBV. Griddade dygnsvärden av temperatur och nederbörd över Sverige sedan år 1961"}},{"@id":"https://opendata.smhi.se/pthbv/api","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.smhi.se/pthbv/api"},"dcat:downloadURL":{"@id":"https://opendata.smhi.se/pthbv/api"},"dct:description":{"@language":"sv","@value":"API-dokumentation"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"https://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:e7278c6a70ef65cea078d2aed221554e1861daf75a13d65043a16f166636848f_b1n0"},"dct:title":{"@language":"sv","@value":"API-dokumentation"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://www.smhi.se/data/nederbord-och-fuktighet/nederbord/griddad-nederbord--och-temperaturdata","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/data/nederbord-och-fuktighet/nederbord/griddad-nederbord--och-temperaturdata"},"dcat:downloadURL":{"@id":"https://www.smhi.se/data/nederbord-och-fuktighet/neder