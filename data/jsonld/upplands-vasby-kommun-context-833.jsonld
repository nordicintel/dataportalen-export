50a01d-geojson"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-geopackage"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-wfs"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-wms"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-wms-legend"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-wmts"}],"dcat:keyword":["Upplands Väsby kommun","grill","grillplats","grillplatser","grills"],"dcat:landingPage":{"@id":"https://geodirekt-kat.upplandsvasby.se/dataset/grillplatser"},"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"0.001"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":"Specifikation för grillplatser: https://lankadedata.se/spec/grillplatser/","dct:creator":{"@id":"http://upplandsvasby.se/gataparkenheten"},"dct:description":"Kommunala grillplatser.\n\nKommunen erbjuder grillplatser i flera parker och vid sjöar för att allmänheten ska kunna njuta av naturen, umgås och dela måltider i en avslappnad och naturskön miljö. Platserna är bruka utrustade med fasta grillar, sittbänkar och bord.\n\nTillgänglighet är viktigt, och många platser har gångvägar och vissa har även ramper för rullstolsburna samt närliggande parkeringsplatser. Kommunen underhåller grillplatserna regelbundet för att de ska vara rena och säkra att använda.\n\nBesökare uppmanas att följa reglerna och hålla områdena rena...","dct:identifier":"037756b0-61e5-4bc1-96f2-f6926d770fa5","dct:issued":{"@type":"xsd:date","@value":"2024-04-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000019"},"dct:spatial":[{"@id":"_:d7f215e191848dcfcaf7cd7ec92c8b5917fb703db703fa9ab45633ca72ec6599_b0n0"},{"@id":"https://www.geonames.org/2666237/"}],"dct:title":"Grillplatser","http://data.europa.eu/r5r/hvdCategory":"None"},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.upplandsvasby.se/maps/Gataparkenheten/Grillplats/data.csv"},"dct:description":"Data i textfil med kommaseparerade värden (CSV). Koordinater i koordinatsystem SWEREF 99 TM. För koordinater i annat koordinatsystem, lägg till parameter crs med EPSG kod till URL. Exempel: ?crs=EPSG:4326","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-11-28T12:17:01.380274"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-14T00:26:46.830060"},"dct:title":"CSV","http://data.europa.eu/r5r/availability":{"@id":"http://publications.europa.eu/resource/authority/planned-availability/AVAILABLE"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata.upplandsvasby.se/dataset/af169c2f-96e0-44b9-a621-093ad2a44c03/resource/5a658945-7fa9-408a-988a-11261950a01d-excel","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.upplandsvasby.se/maps/Gataparkenheten/Grillplats/data.xlsx"},"dct:description":"Data i Excel format med koordinater i koordi