/dataset/10bfd37a-fcca-4954-ab49-5c04f61ded2a/resource/10bfd37a-fcca-4954-ab49-5c04f61ded2a-wfs"},{"@id":"https://opendata.upplandsvasby.se/dataset/10bfd37a-fcca-4954-ab49-5c04f61ded2a/resource/10bfd37a-fcca-4954-ab49-5c04f61ded2a-wms"},{"@id":"https://opendata.upplandsvasby.se/dataset/10bfd37a-fcca-4954-ab49-5c04f61ded2a/resource/10bfd37a-fcca-4954-ab49-5c04f61ded2a-wms-legend"},{"@id":"https://opendata.upplandsvasby.se/dataset/10bfd37a-fcca-4954-ab49-5c04f61ded2a/resource/10bfd37a-fcca-4954-ab49-5c04f61ded2a-wmts"}],"dcat:keyword":["Upplands Väsby kommun","höjd","stompunkter"],"dcat:landingPage":{"@id":"https://opendata.upplandsvasby.se/dataset/-stompunkter"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://upplandsvasby.se/geodataenheten"},"dct:description":"Stompunkter är fasta referenspunkter i marken med exakt bestämda koordinater som används för kartläggning och mätning. De hjälper till att säkerställa att geografisk information är korrekt och konsekvent. Dessa punkter är viktiga för att skapa och uppdatera kartor, planera byggprojekt och övervaka förändringar i landskapet. Varje stompunkts position mäts noggrant och dokumenteras så att den kan användas som en pålitlig referenspunkt för olika tekniska och geografiska applikationer.","dct:identifier":"975d9dce-01fa-4f17-9043-b4c2fdb9f59c","dct:issued":{"@type":"xsd:date","@value":"2025-02-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-06"},"dct:provenance":{"@id":"_:b07a819721c65c1c75311b14b67ebf56194b6e05c89a641f666ddc24354f8adc_b0n0"},"dct:publisher":{"@id":"http://dataporta