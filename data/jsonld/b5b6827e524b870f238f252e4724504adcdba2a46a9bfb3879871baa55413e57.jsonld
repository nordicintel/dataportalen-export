urce/16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.calameo.com/read/005835921dcbc0e346407"},"dct:description":[{"@language":"en","@value":"The marine plan shows the way for how the coastal and marine area should be used."},{"@language":"sv","@value":"Havsplanen visar vägen för hur kust- och havsområdet ska användas."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Marine Plan for Simrishamn Municipality"},{"@language":"sv","@value":"Havsplanen för Simrishamns kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/17","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.calameo.com/read/005835921bc207048afc8"},"dct:description":[{"@language":"en","@value":"Review statement for Marine plan and coastal zone analysis, deepening of the overview plan for Simrishamn municipality's marine area."},{"@language":"sv","@value":"Granskningsyttrande för Havsplan och kustzonsanalys, fördjupning av översiktsplanen för Simrishamns kommuns havsområde."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"The County Administrative Board's review statement"},{"@language":"sv","@value":"Länsstyrelsens granskningsyttrande"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:6387089f4afd3d4aa6e936dbcff2dc22ad4b18b6380bd670bdce79114d5c6243"},{"@graph":[{"@id":"_:7a17b043c50762a0b748b9c3af43dca56585682266a177f25cfd9d2f72e0682e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.042151488168138 55.77400446258585,14.749532908495086 55.77400446258585,14.749532908495086 55.39084575967837,14.042151488168138 55.39084575967837,14.042151488168138 55.77400446258585))"}},{"@id":"_:7a17b043c50762a0b748b9c3af43dca56585682266a177f25cfd9d2f72e0682e_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2023-03-27"}},{"@id":"http://dataportal.se/organisation/SE2120000969","@type":"foaf:Agent","dct:identifier":"2120000969","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@simrishamn.se"},"foaf:name":{"@language":"sv","@value":"Simrishamns kommun"},"foaf:page":{"@id":"https://www.simrishamn.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.simrishamn.se/store/4/resource/1"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontakt Simrishamn","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontakt@simrishamn.se"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/20","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.simrishamn.se/store/1/resource/13"},"dcat:distribution":[{"@id":"https://metadata.simrishamn.se/store/1/resource/21"},{"@id":"https://metadata.simrishamn.se/store/1/resource/22"},{"@id":"https://metadata.simrishamn.se/store/1/resource/23"}],"dcat:keyword":[{"@language":"en","@value":"Architecture"},{"@language":"en","@value":"Boundaries"},{"@language":"en","@value":"Master plan"},{"@language":"en","@value":"cultural environment"},{"@language":"en","@value":"cultural"},{"@language":"en","@value":"historical"},{"@language":"sv","@value":"Antagen"},{"@language":"sv","@value":"Arkitektur"},{"@language":"sv","@value":"Gränser"},{"@language":"sv","@value":"Gällande"},{"@language":"sv","@value":"Plangränser"},{"@language":"sv","@value":"historiskt"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"kulturmiljö"},{"@language":"sv","@value":"ÖP"},{"@language":"sv","@value":"Översiktsplan"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"What is an architecture and cultural environment program? \nSimrishamn municipality's architecture and cultural environment program makes visible valuable architectural and cultural environments in the municipality that must be taken into account when the municipality develops and when new buildings are built. \n  \nA total of 35 villages and the city of Simrishamn have been inventoried to create the basis for the program which is completely digital, created with GIS technology and presented on its own website. \n  \nThe content resulting from the inventories is presented with images, text and interactive maps. As a visitor, you can see which significant buildings, places and cultural environments were identified during the inventories that took place. Here you can also read Simrishamn municipality's Architecture Strategy, which is part of the Architecture and Cultural Environment Program.\n\nWith the help of the historical development, we can understand the rise of the town and why it looks the way it does today. Understanding the place you live in can increase the quality of life by feeling pride and anchoring to the place. High awareness of the place's history and character also strengthens the place's identity and attractiveness for both residents and visitors. \n  \nThe Architecture and Cultural Environment Program describes a selection of the public buildings and environments that are judged to be of particular cultural-historical value or architecturally interesting. \n  \nA cultural environment can be defined as an environment that has been affected by human activity. For example, it could be about a place such as a harbor or a square, but it could also be one or more buildings that in their context are culturally and historically interesting. Sometimes clear traces remain and sometimes not. \n  \nWhy is an architecture and cultural environment program needed? \nThe purpose of the program is for it to be an inspirational and advisory addition to our master plan that clarifies the municipality's direction in architecture and design issues. The program must be used as a knowledge basis for making well-founded decisions in planning and construction processes, so that qualities that make the municipality unique are preserved and that development takes place with consideration and care for the unique."},{"@language":"sv","@value":"Vad är ett arkitektur- och kulturmiljöprogram? \nSimrishamns kommuns arkitektur- och kulturmiljöprogram synliggör värdefulla arkitektur- och kulturmiljöer i kommunen som det ska tas hänsyn till när kommunen utvecklas och det byggs nytt. \n  \nTotalt har 35 byar och Simrishamns stad inventerats för att skapa underlag till programmet som är helt digitalt, skapat med GIS-teknik och presenteras på en egen webbsida. \n  \nInnehållet som är ett resultat av inventeringarna presenteras med bilder, text och interaktiva kartor. Som besökare kan du se vilka betydelsefulla byggnader, platser och kulturmiljöer som identifierats under de inventeringar som ägt rum. Du kan här också läsa Simrishamns kommuns Arkitekturstrategi som ingår i Arkitektur- och kulturmiljöprogrammet. \n  \nMed hjälp av den historiska utvecklingen kan vi förstå ortens framväxt och varför den ser ut som den gör idag. Att förstå den plats du lever på kan öka livskvalitén genom att du känner stolthet och förankring till platsen. Hög medvetenhet om platsens historia och karaktär stärker också ortens identitet och attraktivitet för både bosatta och besökare. \n  \nI Arkitektur- och kulturmiljöprogrammet beskrivs ett urval av de offentliga byggnader och miljöer som bedöms vara särskilt kulturhistoriskt värdefulla eller arkitektoniskt intressanta. \n  \nEn kulturmiljö kan förklaras som en miljö som påverkats av mänsklig aktivitet. Det kan exempelvis handla om en plats som en hamn eller ett torg men det kan också vara en eller flera byggnader som i sitt sammanhang är kulturhistoriskt intressant. Ibland finns tydliga spår kvar och ibland inte. \n  \nVarför behövs ett arkitektur- och kulturmiljöprogram? \nSyftet med programmet är att det ska bli ett inspirationsrikt och rådgivande tillägg till vår översiktsplan som tydliggör kommunens inriktning i arkitektur- och gestaltningsfrågor. Programmet ska användas som kunskapsunderlag för att ta välgrundade beslut i plan- och byggprocesser, så att kvaliteter som gör kommunen unik bevaras och att utveckling sker med hänsyn och omsorg till det unika."}],"dct:issued":{"@type":"xsd:date","@value":"2023-05-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000969"},"dct:spatial":[{"@id":"_:7a17b043c50762a0b748b9c3af43dca56585682266a177f25cfd9d2f72e0682e_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:temporal":{"@id":"_:7a17b043c50762a0b748b9c3af43dca56585682266a177f25cfd9d2f72e0682e_b1n0"},"dct:title":[{"@language":"en","@value":"Master Plan - Architecture and cultural environment program"},{"@language":"sv","@value":"Översiktsplan - Arkitektur- och kulturmiljöprogram"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/25"},"http://schema.org/diagram":{"@id":"https://metadata.simrishamn.se/store/1/resource/24"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/21","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_OP_AKP_EXT?token=03a052c0fc4741e298b39a02d99d5143"},"dct:description":[{"@language":"en","@value":"Simrishamn Municipality open data - Master plan - Architecture and Cultural Environment Program data - OGC Web Mapping Service (WMS)"},{"@language":"sv","@value":"Simrishamn kommun öppen data - Översiktsplan - Arkitektur- och kulturmiljöprogrammet (AKP) - data - OGC Web Mapping Service (WMS)"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Open data - Master Plan - AKP EXT - WMS"},{"@language":"sv","@value":"Öppna data - ÖP - AKP EXT - WMS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/22","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_OP_AKP_EXT?token=03a052c0fc4741e298b39a02d99d5143"},"dct:description":[{"@language":"en","@value":"Simrishamn Municipality open data - Master plan - Architecture and Cultural Environment Program data - OGC Web Feature Service (WFS)"},{"@language":"sv","@value":"Simrishamn kommun öppen data - Översiktsplan - Arkitektur- och kulturmiljöprogrammet (AKP) - data - OGC Web Feature Service (WFS)"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Open data - Master Plan - AKP EXT - WFS"},{"@language":"sv","@value":"Öppna data - ÖP - AKP EXT - WFS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/23","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://storymaps.arcgis.com/collections/9c30a8c859404b63ae5be19790192448"},"dct:description":{"@language":"sv","@value":"Simrishamn kommun öppen data - Översiktsplan - Arkitektur- och kulturmiljöprogrammet (AKP) StoryMap - ArcGIS Online (AGOL)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Öppna data - ÖP - AKP EXT - AGOL StoryMap"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:7a17b043c50762a0b748b9c3af43dca56585682266a177f25cfd9d2f72e0682e"},{"@graph":[{"@id":"https://metadata.simrishamn.se/store/5/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://metadata.simrishamn.se/store/1/resource/12"},{"@id":"https://metadata.simrishamn.se/store/1/resource/20"},{"@id":"https://metadata.simrishamn.se/store/1/resource/30"},{"@id":"https://metadata.simrishamn.se/store/1/resource/7"}],"dct:description":[{"@language":"en","@value":"Metadata catalog from Simrishamn municipality with metadata for open data and shared data."},{"@language":"sv","@value":"Metadatakatalog från Simrishamns kommun med metadata för öppna data och delade data."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000969"},"dct:title":[{"@language":"en","@value":"Simrishamn municipality"},{"@language":"sv","@value":"Simrishamns kommun"}],"foaf:homepage":{"@id":"https://www.simrishamn.se/"}}],"@id":"urn:source:a2c75d6ca3efc35be75a7c9b1fe252e4bf57cf5ac1bd0e8589f12731b863f358"},{"@graph":[{"@id":"_:e70007f2ae0b3b4c67784bc7a2847d0ca515247e572bcc451a9a4051a769efa9_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.042151488168138 55.77400446258585,14.749532908495086 55.77400446258585,14.749532908495086 55.39084575967837,14.042151488168138 55.39084575967837,14.042151488168138 55.77400446258585))"}},{"@id":"_:e70007f2ae0b3b4c67784bc7a2847d0ca515247e572bcc451a9a4051a769efa9_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2011-12-19"}},{"@id":"http://dataportal.se/organisation/SE2120000969","@type":"foaf:Agent","dct:identifier":"2120000969","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@simrishamn.se"},"foaf:name":{"@language":"sv","@value":"Simrishamns kommun"},"foaf:page":{"@id":"https://www.simrishamn.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.simrishamn.se/store/4/resource/1"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/11","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.calameo.com/read/005835921e79b6f36bf27"},"dct:description":[{"@language":"en","@value":"The Wind Power Plan 19 December 2011"},{"@language":"sv","@value":"Vindkraftsplanen 19 december 2011"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"The Wind Power Plan 19 December 2011"},{"@language":"sv","@value":"Vindkraftsplanen 19 december 2011"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontakt Simrishamn","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontakt@simrishamn.se"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.simrishamn.se/store/1/resource/13"},"dcat:distribution":[{"@id":"https://metadata.simrishamn.se/store/1/resource/11"},{"@id":"https://metadata.simrishamn.se/store/1/resource/8"},{"@id":"https://metadata.simrishamn.se/store/1/resource/9"}],"dcat:keyword":[{"@language":"en","@value":"Boundaries"},{"@language":"en","@value":"Master plan"},{"@language":"en","@value":"Renewable energy"},{"@language":"en","@value":"Wind power plan"},{"@language":"sv","@value":"Antagen"},{"@language":"sv","@value":"Förnybar energi"},{"@language":"sv","@value":"Gränser"},{"@language":"sv","@value":"Gällande"},{"@language":"sv","@value":"Plangränser"},{"@language":"sv","@value":"Vindkraftsplanen"},{"@language":"sv","@value":"ÖP"},{"@language":"sv","@value":"Översiktsplan"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"The wind power plan is a thematic addition to the Master plan. The wind power plan forms a planning basis for the establishment of wind turbines in the municipality. The municipal council adopted the wind power plan on 19 December 2011."},{"@language":"sv","@value":"Gällande översiktsplaner i Simrishamn kommun. \n\nVindkraftsplanen är ett tematiskt tillägg till översiktsplanen. Vindkraftsplanen utgör ett planeringsunderlag för etablering av vindkraftverk i kommunen. Kommunfullmäktige antog vindkraftsplanen den 19 december 2011."}],"dct:issued":{"@type":"xsd:date","@value":"2024-12-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000969"},"dct:spatial":[{"@id":"_:e70007f2ae0b3b4c67784bc7a2847d0ca515247e572bcc451a9a4051a769efa9_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:temporal":{"@id":"_:e70007f2ae0b3b4c67784bc7a2847d0ca515247e572bcc451a9a4051a769efa9_b1n0"},"dct:title":[{"@language":"en","@value":"Master Plan - Wind Power Plan"},{"@language":"sv","@value":"Översiktsplan - Vindkraftsplan"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/25"},"http://schema.org/diagram":{"@id":"https://metadata.simrishamn.se/store/1/resource/10"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_OP_Vindkraft_EXT?token=32f00c2176b749e6829d5f257c6334d0&SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities"},"dct:description":[{"@language":"en","@value":"Simrishamn Municipality open data - Master plan - Wind power GIS data - Web Mapping Service (WMS)"},{"@language":"sv","@value":"Simrishamn Kommun öppen data - Översiktsplan - Vindkraft GIS-data - OGC Web Mapping Service (WMS)"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Open data - Master plan - Wind power EXT - WMS"},{"@language":"sv","@value":"Öppna data - ÖP - Vindkraft EXT - WMS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_OP_Vindkraft_EXT?token=32f00c2176b749e6829d5f257c6334d0&SERVICE=WFS&VERSION=2.0.0&REQUEST=GetCapabilities"},"dct:description":[{"@language":"en","@value":"Simrishamn Municipality open data - Master plan - Wind power GIS data - OGC Web Feature Service (WFS)"},{"@language":"sv","@value":"Simrishamn Kommun öppen data - Översiktsplan - Vindkraft GIS-data - OGC Web Feature Service (WFS)"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Open data - Master Plan - Wind power - WFS"},{"@language":"sv","@value":"Öppna data - Översiktsplan - Vindkraft - WFS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:e70007f2ae0b3b4c67784bc7a2847d0ca515247e572bcc451a9a4051a769efa9"}]}
