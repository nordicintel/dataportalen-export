{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:58151b02c9158e592102af041159f106bf3e4306e449f3907c97ad61c9c95a1e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.002142542545108 55.74483714763653,14.50954679433827 55.74483714763653,14.50954679433827 55.35860721034908,14.002142542545108 55.35860721034908,14.002142542545108 55.74483714763653))"}},{"@id":"_:58151b02c9158e592102af041159f106bf3e4306e449f3907c97ad61c9c95a1e_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2026-06-10"}},{"@id":"http://dataportal.se/organisation/SE2120000969","@type":"foaf:Agent","dct:identifier":"2120000969","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@simrishamn.se"},"foaf:name":{"@language":"sv","@value":"Simrishamns kommun"},"foaf:page":{"@id":"https://www.simrishamn.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.simrishamn.se/store/4/resource/1"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontakt Simrishamn","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontakt@simrishamn.se"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/30","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.simrishamn.se/store/1/resource/13"},"dcat:distribution":[{"@id":"https://metadata.simrishamn.se/store/1/resource/31"},{"@id":"https://metadata.simrishamn.se/store/1/resource/32"}],"dcat:keyword":[{"@language":"en","@value":"parking"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"parkering"},{"@language":"sv","@value":"trafik"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Traffic and parking data for Simrishamn municipality"},{"@language":"sv","@value":"Trafik- och parkeringsdata för Simrishamns kommun"}],"dct:issued":{"@type":"xsd:date","@value":"2026-06-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000969"},"dct:spatial":[{"@id":"_:58151b02c9158e592102af041159f106bf3e4306e449f3907c97ad61c9c95a1e_b0n0"},{"@id":"https://sws.geonames.org/2679106"}],"dct:temporal":{"@id":"_:58151b02c9158e592102af041159f106bf3e4306e449f3907c97ad61c9c95a1e_b1n0"},"dct:title":[{"@language":"en","@value":"Traffic and parking"},{"@language":"sv","@value":"Trafik och parkering"}],"http://schema.org/diagram":{"@id":"https://metadata.simrishamn.se/store/1/resource/33"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/31","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_Trafik_EXT?Token=2b1bed063866434fa3b0923b32bceef6&SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities"},"dct:description":[{"@language":"en","@value":"Simrishamn Open data - Traffic and parking OGC WMS"},{"@language":"sv","@value":"Simrishamn Öppna data - Trafik och parkering OGC WMS"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Simrishamn Open data - Traffic WMS"},{"@language":"sv","@value":"Simrishamn Öppna data - Trafik WMS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/32","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodirekt.simrishamn.se/public-maps/kartpaket/OpenData/OppnaData_Trafik_EXT?Token=2b1bed063866434fa3b0923b32bceef6"},"dct:description":[{"@language":"en","@value":"Simrishamn Open data - Traffic and parking OGC WFS"},{"@language":"sv","@value":"Simrishamn Öppna data - Trafik och parkering OGC WFS"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"Simrishamn Open data - Traffic WFS"},{"@language":"en","@value":"Simrishamn Öppna data - Trafik WFS"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:58151b02c9158e592102af041159f106bf3e4306e449f3907c97ad61c9c95a1e"},{"@graph":[{"@id":"_:6387089f4afd3d4aa6e936dbcff2dc22ad4b18b6380bd670bdce79114d5c6243_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.042151488168138 55.77400446258585,14.749532908495086 55.77400446258585,14.749532908495086 55.39084575967837,14.042151488168138 55.39084575967837,14.042151488168138 55.77400446258585))"}},{"@id":"_:6387089f4afd3d4aa6e936dbcff2dc22ad4b18b6380bd670bdce79114d5c6243_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2010-10-26"}},{"@id":"http://dataportal.se/organisation/SE2120000969","@type":"foaf:Agent","dct:identifier":"2120000969","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@simrishamn.se"},"foaf:name":{"@language":"sv","@value":"Simrishamns kommun"},"foaf:page":{"@id":"https://www.simrishamn.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.simrishamn.se/store/4/resource/1"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/12","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.simrishamn.se/store/1/resource/13"},"dcat:distribution":[{"@id":"https://metadata.simrishamn.se/store/1/resource/14"},{"@id":"https://metadata.simrishamn.se/store/1/resource/15"},{"@id":"https://metadata.simrishamn.se/store/1/resource/16"},{"@id":"https://metadata.simrishamn.se/store/1/resource/17"}],"dcat:keyword":[{"@language":"en","@value":"Boundaries"},{"@language":"en","@value":"Coastal analysis"},{"@language":"en","@value":"Marine plan"},{"@language":"en","@value":"Master plan"},{"@language":"sv","@value":"Antagen"},{"@language":"sv","@value":"Gränser"},{"@language":"sv","@value":"Gällande"},{"@language":"sv","@value":"Havsplan"},{"@language":"sv","@value":"Plangränser"},{"@language":"sv","@value":"kustzonsanalys"},{"@language":"sv","@value":"ÖP"},{"@language":"sv","@value":"Översiktsplan"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"Marine plan with associated coastal zone analysis is an addition to the master plan for Simrishamn municipality.\n\nThe marine plan shows the way for how the coastal and marine area should be used: \nThe adopted marine plan is part of Simrishamn municipality's master plan.   \nThe Hansplanen deals with marine environmental and coastal issues with a focus on sustainable development. The purpose of the marine plan is to clarify how the municipality's marine area is to be used in the coming years.\nThe work to develop the plan is in line with the goal of the UN's goal of conserving oceans and marine resources.\n\nÖsterlen and the municipality of Simrishamn are widely known for these values ​​and will continue to be so. Creating a sustainable society where the municipality's long coastal stretch is managed and can be developed in harmony with the citizens of the municipality and taking into account nature, the environment and the ecosystems as well as the new challenges they face is an important aspect. The municipality's continued environmental profile and commitment to these issues will be an important part of the future work to develop the municipality into an even more attractive place to live and live, says Carl-Göran Svensson (C), chairman of the community planning board. \nThere are many interests that converge along our coast and in the sea, which creates a need for long-term planning and selection. \nThe Baltic Sea is one of the world's most polluted seas. We need to work together around coastal and ocean issues to reverse the negative development. The marine plan therefore contains clear guidelines and priorities. \nThe marine plan also provides guidance for where the development of new land is suitable, taking into account the risk of flooding and erosion. \nThe marine plan has a guiding role in our planning work. It is a strategic document that is used in decisions and in weighing up these issues."},{"@language":"sv","@value":"Havsplan med tillhörande kustzonsanalys är ett tillägg till översiktsplanen för Simrishamns kommun.\n\nHavsplanen visar vägen för hur kust- och havsområdet ska användas: \nDen antagna havsplanen är en del av Simrishamns kommuns översiktsplan.   \nHansplanen behandlar havsmiljö- och kustfrågor med fokus på en hållbar utveckling. Havsplanens syfte är att klargöra hur kommunens havsområde ska användas under kommande år.\nArbetet med att ta fram planen är i linje med det mål i FN:s mål om att bevara hav och marina resurser. \n\nÖsterlen och Simrishamns kommun är vida känt för de här värdena och ska fortsätta att vara det. Att skapa ett hållbart samhälle där kommunens långa kuststräcka förvaltas och kan utvecklas i samklang med medborgarna i kommunen och med hänsyn tagen till naturen, miljön och ekosystemen samt de nya utmaningarna dessa står inför är en viktig aspekt. Kommunens fortsatta miljöprofil och engagemanget kring de här frågorna blir en viktig del i det framtida arbetet med att utveckla kommunen till en ännu mer attraktiv plats att bo och leva på, säger samhällsplaneringsnämndens ordförande Carl-Göran Svensson (C). \nDet är många intressen som samsas längs vår kust och i havet, vilket ger ett behov av en långsiktig planering och förvalning. \nÖstersjön är ett av världens mest förorenade hav. Vi behöver samspela kring kust- och havsfrågor för att vända den negativa utvecklingen. Havsplanen innehåller därför tydliga riktlinjer och prioriteringar. \nHavsplanen är ger också en vägledning för var bebyggelse av ny mark är lämplg med hänsyn till risken för översvämning och erosion. \nHavsplanen har en vägledande roll i vårt planeringsarbete. Det är ett strategiskt dokument som används vid beslut och i avvägningar kring de här frågorna."}],"dct:issued":{"@type":"xsd:date","@value":"2020-10-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000969"},"dct:spatial":[{"@id":"_:6387089f4afd3d4aa6e936dbcff2dc22ad4b18b6380bd670bdce79114d5c6243_b0n0"},{"@id":"https://sws.geonames.org/2679106"},{"@id":"https://sws.geonames.org/3337385"}],"dct:temporal":{"@id":"_:6387089f4afd3d4aa6e936dbcff2dc22ad4b18b6380bd670bdce79114d5c6243_b1n0"},"dct:title":[{"@language":"en","@value":"Master Plan - Coastal Plan and Coastal Analysis"},{"@language":"sv","@value":"Översiktsplan - Havsplan och kustzonsanalys"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/25"},"http://schema.org/diagram":{"@id":"https://metadata.simrishamn.se/store/1/resource/18"}},{"@id":"https://metadata.simrishamn.se/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontakt Simrishamn","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontakt@simrishamn.se"}},{"@id":"htt