"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":"Titel och information om SBU:s pågående utvärderingsprojekt.\n","dct:issued":{"@type":"xsd:date","@value":"2016-04-14"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-19"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/127/resource/437d3c86e3261ed5da3473cd0620acf4"},"dct:title":"SBU:s pågående projekt"},{"@id":"http://sbu.se/datasets/dcat/distribution/33f33cb767b04ad78b35698f107c502a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sbu.se/sv/pagaende-projekt/"},"dct:description":"Information om SBU:s nu pågående projekt kan laddas ner via den gula knappen \"Exportera pågående projekt till Excel\" på sidan www.sbu.se/projekt\n","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"SBU:s pågående projekt"},{"@id":"https://admin.dataportal.se/store/127/resource/437d3c86e3261ed5da3473cd0620acf4","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":"SBU. Statens beredning för medicinsk och social utvärdering"},{"@id":"https://admin.dataportal.se/store/127/resource/c4031243cceb6fdb129cf7eb2b5caefa","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SBU. Statens beredning för medicinsk och social utvärdering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ba4af9b82992623296fee64415e0ba09ecd97c4b8d1d1b73f09ca323aa9f5497_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@sbu.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ba4af9b82992623296fee64415e0ba09ecd97c4b8d1d1b73f09ca323aa9f5497_b1n0"}}],"@id":"urn:source:ba4af9b82992623296fee64415e0ba09ecd97c4b8d1d1b73f09ca323aa9f5497"},{"@graph":[{"@id":"_:ce80995b9332c82ff5f5e461a05231d0eca2c2089cb1a10a12e60a3dc7606906_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"113 43","http://www.w3.org/2006/vcard/ns#street-address":"Sankt Eriksgatan 117"},{"@id":"_:ce80995b9332c82ff5f5e461a05231d0eca2c2089cb1a10a12e60a3dc7606906_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Telephone","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4684123200"}},{"@id":"http://sbu.se/datasets/dcat/dataset/a929a55df54b4ae7b16032bfe122fbc9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/127/resource/c4031243cceb6fdb129cf7eb2b5caefa"},"dcat:distribution":{"@id":"http://sbu.se/datasets/dcat/distribution/a929a55df54b4ae7b16032bfe122fbc9"},"dcat:keyword":["NHS Evidence","forskningsbehov","vetenskapliga kunskapsluckor"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},"dct:description":"DUETs, The UK Database of Uncertainties about the Effects of Treatments, är en brittisk databas för vetenskapliga kunskapsluckor inom medicinsk, odontologisk och social forskning som SBU har övertagit och tillhandahåller som arkiv­databas. Materialet är i Excelformat där man kan söka efter tidigare identifierade kliniska kunskapsluckor (totalt cirka 11 000 kunskapsluckor inom olika områden, registrerade åren 2005–2016).\n","dct:issued":{"@type":"xsd:date","@value":"2005-09-12"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-10"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/127/resource/b039c590b8f8dae0d623fcd8c70f8be4"},"dct:title":"Vetenskapliga kunskapsluckor från DUETs"},{"@id":"http://sbu.se/datasets/dcat/distribution/a929a55df54b4ae7b16032bfe122fbc9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sbu.se/sv/publikationer/kunskapsluckor/vetenskapliga-kunskapsluckor-fran-duets--the-uk-database-of-uncertainties-about-the-effects-of-treatments/"},"dct:description":"Databasen kan laddas ner som Excel-dokument via länk på sidan www.sbu.se/DUETs\n","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"DUETs arkivdatabas"},{"@id":"https://admin.dataportal.se/store/127/resource/b039c590b8f8dae0d623fcd8c70f8be4","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":"NHS Evidence"},{"@id":"https://admin.dataportal.se/store/127/resource/c4031243cceb6fdb129cf7eb2b5caefa","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SBU. Statens beredning för medicinsk och social utvärdering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ce80995b9332c82ff5f5e461a05231d0eca2c2089cb1a10a12e60a3dc7606906_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@sbu.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ce80995b9332c82ff5f5e461a05231d0eca2c2089cb1a10a12e60a3dc7606906_b1n0"}}],"@id":"urn:source:ce80995b9332c82ff5f5e461a05231d0eca2c2089cb1a10a12e60a3dc7606906"},{"@graph":[{"@id":"http://sbu.se/datasets/dcat/catalog/68764b938e094ab9b9e159a9fe0f337d","@type":"dcat:Catalog","dcat:dataset":[{"@id":"http://sbu.se/datasets/dcat/dataset/26a2ead0263c434383c63de5ae4689b4"},{"@id":"http://sbu.se/datasets/dcat/dataset/33f33cb767b04ad78b35698f107c502a"},{"@id":"http://sbu.se/datasets/dcat/dataset/a929a55df54b4ae7b16032bfe122fbc9"},{"@id":"http://sbu.se/datasets/dcat/dataset/b1e9f7cabaa04bbebba0f0a3c989eb70"}],"dcat:themeTaxonomy":{"@id":"http://publications.europa.eu/resource/authority/data-theme"},"dct:description":"Sedan 2010 har Sverige en lag om vidareutnyttjande av handlingar från den offentliga förvaltningen (PSI-lagen). Lagen bygger på ett EU-direktiv och ska underlätta för enskilda individer att använda handlingar som tillhandahålls av offentliga organisationer. SBU:s datasamlingar för vidareutnyttjande omfattar SBU:s publikationer, pågående projekt och vetenskapliga kunskapsluckor.\r\n","dct:issued":{"@type":"xsd:date","@value":"2018-05-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-09-25"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/127/resource/437d3c86e3261ed5da3473cd0620acf4"},"dct:title":"PSI-data (information tillgänglig för vidareutnyttjande)","foaf:homepage":{"@id":"https://www.sbu.se/sv/datasets/"}}],"@id":"urn:source:ee3f85f155787096e25f5f3baa5117cb69a844a1d5b1c248aace390d505eeeef"}]}
