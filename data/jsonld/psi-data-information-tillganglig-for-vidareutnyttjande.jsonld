{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:967afd42b5c1e78a1e6013fb53666bf56623fa59da8a9f3509642faf82eabaa5_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"113 43","http://www.w3.org/2006/vcard/ns#street-address":"Sankt Eriksgatan 117"},{"@id":"_:967afd42b5c1e78a1e6013fb53666bf56623fa59da8a9f3509642faf82eabaa5_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Telephone","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4684123200"}},{"@id":"http://sbu.se/datasets/dcat/dataset/26a2ead0263c434383c63de5ae4689b4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/127/resource/c4031243cceb6fdb129cf7eb2b5caefa"},"dcat:distribution":{"@id":"http://sbu.se/datasets/dcat/distribution/26a2ead0263c434383c63de5ae4689b4"},"dcat:keyword":["SBU. Statens beredning för medicinsk och social utvärdering","forskningsbehov"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":"SBU samlar vetenskapliga kunskapsluckor inom områdena hälso- och sjukvård, tandvård, socialtjänst, funktionstillstånd och funktionshinder samt arbetsmiljö för att visa var det behövs ny forskning. Med hjälp av vår databas med kunskaps­luckor samverkar vi bland annat med forsknings­finansiärer. Målet är att den framtida forskningen ska riktas mot forsknings­projekt som i slutändan gör nytta i vardagen för brukare, patienter och närstående.\n","dct:issued":{"@type":"xsd:date","@value":"2010-11-02"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-15"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/127/resource/437d3c86e3261ed5da3473cd0620acf4"},"dct:title":"Vetenskapliga kunskapsluckor"},{"@id":"http://sbu.se/datasets/dcat/distribution/26a2ead0263c434383c63de5ae4689b4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sbu.se/sv/kunskapsluckor-sok/"},"dct:description":"Sökresultatet kan laddas ner via de gula knapparna under rubriken \"Exportera till Excel\" på sidan www.sbu.se/vkl\n","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"Vetenskapliga kunskapsluckor, SBU"},{"@id":"https://admin.dataportal.se/store/127/resource/437d3c86e3261ed5da3473cd0620acf4","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":"SBU. Statens beredning för medicinsk och social utvärdering"},{"@id":"https://admin.dataportal.se/store/127/resource/c4031243cceb6fdb129cf7eb2b5caefa","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"SBU. Statens beredning för medicinsk och social utvärdering","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:967afd42b5c1e78a1e6013fb53666bf56623fa59da8a9f3509642faf82eabaa5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@sbu.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:967afd42b5c1e78a1e6013fb53666bf56623fa59da8a9f3509642faf82eabaa5_b1n0"}}],"@id":"urn:source:967afd42b5c1e78a1e6013fb53666bf56623fa59da8a9f3509642faf82eabaa5"},{"@graph":[{"@id":"_:a4715a153d7721c4fd3a59ecc488505096079506d6d1a1533919c9b85b750a22_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"113 43","http://www.w3.org/2006/vcard/ns#street-address":"Sankt Eriksgatan 117"},{"@id":"_:a