a8d41a0a9808de","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.kb.se/dataset/crcrp2nz979j3ws5"},"dct:conformsTo":{"@id":"https://data.kb.se/openapi.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}},{"@id":"https://data.kb.se/dataset/crcrp2nz979j3ws5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/d20ba89d9cca24fdf8a8d41a0a9808de"},"dcat:keyword":["Kungliga biblioteket","bibliotek","forskning","historia","kulturarv"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":"Omfattar \"Svenskt tryck före 1700\" samt verken  \"Gesta danorum\" av Saxo Grammaticus och \"Descriptionis Ptolemaicæ avgmentvm siue Occidentis notitia breui commentario illustrata\".  -- \"Svenskt tryck före 1700\" var ett pilotprojekt som hade flera syften. Det övergripande syftet var att söka lämpliga metoder för beskrivning och digitalisering av äldre material ur Kungl. bibliotekets samlingar. Materialet tillgängliggjordes via Kungl. bibliotekets webb 2002. Detta dataset innehåller bildfilerna till respektive verk. --  Digitaliserad version av förstautgåvan av Saxo Grammaticus verk Gesta danorum (”Danernas bedrifter”) tryckt i Paris 1514. Detta exemplar innehåller omfattande marginalanteckningar på latin av bröderna Olaus och Johannes Magnus, samt Olaus Magnus handskrivna ögonvittnesskildring av Stockholms blodbad 1520. Signum: KB HS D 461b. -- Digitaliserad version av \"Descriptionis Ptolemaicæ avgmentvm siue Occidentis notitia breui commentario illustrata","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/crcrp2nz979j3ws5#it"},"dct:title":"Tryckta böcker","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:e62c53445cf1981d058e09e2ef630b5c3c1cadcd8c8688deebdf7aae88bca1b4"},{"@graph":[{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.kb.se/"},"foaf:mbox":{"@id":"mailto:info@kb.se"},"foaf:name":"Kungliga biblioteket"},{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kungliga biblioteket","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@kb.se"}},{"@id":"https://admin.dataportal.se/store/254/resource/9793183f554d7311bbf05a10eb78b12c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.kb.se/dataset/8nqsrrqn6c52dmzk"},"dct:conformsTo":{"@id":"https://data.kb.se/openapi.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}},{"@id":"https://data.kb.se/dataset/8nqsrrqn6c52dmzk","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/9793183f554d7311bbf05a10eb78b12c"},"dcat:keyword":["Kungliga biblioteket","bibliotek","forskning","historia","kulturarv"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":"Kostnadsdata för vad svenska lärosäten betalar för vetenskaplig publicering. Här ingår kostnader för prenumerationer, publicering och transformativa avtal (avtal som avser att sammanföra kostnader för att både läsa och publicera). Kostnaderna anges i svenska kronor (SEK), och är uppdelade på lärosäte och på förlag. Data är insamlade via Bibsamkonsortiet och enskilda lärosäten. Observera att data inte är fullständigt, KB har sedan 2018 ett regeringsuppdrag att samla in dessa kostnader och avser att successivt förbättra täckningsgraden i framtida arbete.","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/8nqsrrqn6c52dmzk#it"},"dct:title":"Utgifter för vetenskaplig publicering på svenska lärosäten 2017-2020","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:e6ad858ecd6198eddf51b704ff1a35bbbcee8ea64a9ddea9e31cab6bbcdeb106"},{"@graph":[{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.kb.se/"},"foaf:mbox":{"@id":"mailto:info@kb.se"},"foaf:name":"Kungliga biblioteket"},{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kungliga biblioteket","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@kb.se"}},{"@id":"https://admin.dataportal.se/store/254/resource/f4821009c7f846749a3368756bbed473","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.kb.se/dataset/kz30z57kht9gmjs1"},"dct:conformsTo":{"@id":"https://data.kb.se/openapi.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}},{"@id":"https://data.kb.se/dataset/kz30z57kht9gmjs1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/f4821009c7f846749a3368756bbed473"},"dcat:keyword":["Kungliga biblioteket","bibliotek","forskning","historia","kulturarv"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":"I Kungliga bibliotekets utländska samling finns drygt 1200 nummer av 11 holländska dagstidningar från perioden 1610-1809. Merparten (cirka 1100) av dessa är från 1600-talet och drygt 800 från tiden före 1650. De flesta saknas på holländska bibliotek och de digitaliserades för det holländska nationalbibliotekets räkning 2010. De är tillgängliga i den holländska söktjänsten Delpher https://www.delpher.nl/nl/kranten. Enligt Folke Dahl, den främste kännaren av dessa tidningar, har de förmodligen bifogats de nyhetsbrev som svenska representanter i Holland hade i uppgift att skicka till kungens kansli. De har sedan hamnat på Riksarkivet och senare överförts till Kungliga biblioteket (se Lychnos 1938, s. 58-59). Följande titlar finns med: Amsterdamse courant, Courante uyt Italien, Duytslandt &c., Europische donderdaeghs/saterdaeghs courant, Gazette de Rotterdam, La gazette d'Amsterdam, Oprechte Haerlemse courant, Ordinaris dingsdaeghse courante, Ordinaris middel-weeckse courante, Tijdinghen uyt verscheyde quartieren, Utrechtse courant, Weeckelycke courante van Europa","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/kz30z57kht9gmjs1#it"},"dct:title":"Holländska dagstidningar","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:ece1b4d2600096ad09d03b5170e9e95226f66eeb27bd16d1ba4396be8bd95c60"}]}
