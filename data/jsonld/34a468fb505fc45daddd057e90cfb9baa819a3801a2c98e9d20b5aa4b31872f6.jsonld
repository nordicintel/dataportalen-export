sta 1600-talets Sverige hade av palats, städer och fornlämningar. Här kan du ladda ned högupplösta digitaliseringar av teckningar, förlagor och gravyrer som relaterar till verket (tiff/pdf). Se utförlig information via https://suecia.kb.se","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/1fjdz8jnzxkc3qmw#it"},"dct:title":"Suecia antiqua et hodierna (Erik Dahlbergh)","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:5b9add1bc62aa54e3909150f7c7216fab3da32c50a31868eed86e5992874cd5f"},{"@graph":[{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.kb.se/"},"foaf:mbox":{"@id":"mailto:info@kb.se"},"foaf:name":"Kungliga biblioteket"},{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kungliga biblioteket","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@kb.se"}},{"@id":"https://admin.dataportal.se/store/254/resource/f9ec836b9bdf2ce921fde1db2a8c82b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.kb.se/dataset/jxkmbknkg2p8mgld"},"dct:conformsTo":{"@id":"https://data.kb.se/openapi.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}},{"@id":"https://data.kb.se/dataset/jxkmbknkg2p8mgld","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/f9ec836b9bdf2ce921fde1db2a8c82b0"},"dcat:keyword":["Kungliga biblioteket","bibli