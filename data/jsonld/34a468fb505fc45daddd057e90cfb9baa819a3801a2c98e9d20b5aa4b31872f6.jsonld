//admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/a37ede548222a231e8f1c19405e1bc2d"},"dcat:keyword":["Kungliga biblioteket","bibliotek","forskning","historia","kulturarv"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":"Digitaliserad version av Dagens Nyheter. Digitaliseringen är gjord från KB:s pappersförlagor och genomfördes 2013-2014. Specifikationer: https://www.kb.se/namespace/digark/deliveryspecification/agreement/dig_tidn/index.html","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/6ld76n1p44s12ht1#it"},"dct:title":"Dagens nyheter","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:7933f30abc3cffa9df752e1da2d7c3638ccd5adbbea12da78fcd5ff288e35940"},{"@graph":[{"@id":"https://admin.dataportal.se/store/254/resource/6fe7983a352046eb6e3d627693c09220","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.kb.se/dataset/hwjb1l34fgzl1202"},"dct:conformsTo":{"@id":"https://data.kb.se/openapi.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}},{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.kb.se/"},"foaf:mbox":{"@id":"mailto:info@kb.se"},"foaf:name":"Kungliga biblioteket"},{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kungliga biblioteket","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info@kb.se"}},{"@id":"https://data.kb.se/dataset/hwjb1l34fgzl1202","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/254/resource/810b171fbd119f4781d6d7fcce5a006e"},"dcat:distribution":{"@id":"https://admin.dataportal.se/store/254/resource/6fe7983a352046eb6e3d627693c09220"},"dcat:keyword":["Kungliga biblioteket","bibliotek","forskning","historia","kulturarv"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":"Dessa kistebrev ingår i Kungl. bibliotekets samling av Kistebrev, vilken innehåller cirka 900 kistebrev och cirka 200 i nytryck. Kistebrev är enkla handkolorerade ettbladstryck, främst träsnitt, som ofta klistrades in i kistlock, ursprungligen möjligen i skyddande, senare enbart i dekorativt syfte. Kistebreven trycktes under 1700-talet och fram till mitten av 1800-talet i Sverige bland annat i Lund, Växjö, Jönköping, Karlskrona, Karlshamn och Varberg. Motiven var till större delen bibliska och moraliska, men även historiska och folkloristiska motiv förekom, liksom porträtt av kungar och drottningar.","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/254/resource/7d89e5afd68a0ce5b25d3329c869e619"},"dct:relation":{"@id":"https://libris.kb.se/hwjb1l34fgzl1202#it"},"dct:title":"Kistebrev (1700-1800-tal)","https://schema.org/publishingPrinciples":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"}}],"@id":"urn:source:79dc7973073e50b363c33268db1ea1c2bb48a938307400ab37b5515255145fa9"},{"@graph":[{"@id":"https://admin.dataportal.se/store/254/resource/4f7f5