nt in the data."},{"@language":"sv","@value":"Detta projekt samlar data från olika myndighetsregister och tillgängliggör dem i ett standardiserat format. Det försöker också att sammanfoga registren. OBS: Projektet är oberoende och det kan förekomma ouppdaterade eller felaktiga uppgifter."}],"dct:issued":{"@type":"xsd:date","@value":"2024-04-22"},"dct:publisher":{"@id":"https://civictech.se"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:ec75116bf75deb65d29631aa20d207502f4c7358622b789f80fb4ebad81fe45d_b1n0"},"dct:title":[{"@language":"en","@value":"Myndighetsdata"},{"@language":"sv","@value":"Myndighetsdata"}],"foaf:page":{"@id":"https://github.com/civictechsweden/myndighetsdata"}},{"@id":"https://raw.githubusercontent.com/civictechsweden/myndighetsdata/refs/heads/master/data/merged.json","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://raw.githubusercontent.com/civictechsweden/myndighetsdata/refs/heads/master/data/merged.json"},"dcat:downloadURL":{"@id":"https://raw.githubusercontent.com/civictechsweden/myndighetsdata/refs/heads/master/data/merged.json"},"dct:description":[{"@language":"en","@value":"Merged list of government agencies from SCB, Statskontoret, ESV, Arbetsgivarverket, Wikidata and Handlingar.se"},{"@language":"sv","@value":"Sammanslagning av myndighetsinformation från SCB, Statskontoret, ESV, Arbetsgivarverket, Wikidata och Handlingar.se"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Merged dataset"},{"@language":"sv","@value":"Sammanslaget data"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}}],"@id":"urn:source:ec75116bf75deb65d29631aa20d207502f4c7358622b789f80fb4ebad81fe45d"}]}
