aph":[{"@id":"_:430228030566edd422c8b16fdbc8be84ee8c481a3d7977892ec02b73858c450a_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-09-01"}},{"@id":"_:430228030566edd422c8b16fdbc8be84ee8c481a3d7977892ec02b73858c450a_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":[{"@type":"xsd:date","@value":"2022-10-24"},{"@type":"xsd:date","@value":"2024-04-21"},{"@type":"xsd:date","@value":"2024-04-22"}]},{"@id":"https://civictech.se","@type":"foaf:Agent","dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:430228030566edd422c8b16fdbc8be84ee8c481a3d7977892ec02b73858c450a_b0n0"},"dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:name":"Civic Tech Sweden"},{"@id":"https://github.com/civictechsweden/oppna-atervinningsdata","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/services.csv"},{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/stations.csv"},{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/stations.json"},{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/stations_with_services.json"}],"dcat:keyword":["Civic Tech Sweden",{"@language":"en","@value":"Recycling"},{"@language":"en","@value":"Waste"},{"@language":"sv","@value":"Avfall"},{"@language":"sv","@value":"Återvinning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"This project collects data on Swedish recycling stations using Avfall Sverige's open APIs, making them available as JSON and CSV.WARNING: The data is fetched daily so the information can be inaccurate or out of date. Avfall Sverige are in no way involved in the publication of the dataset."},{"@language":"sv","@value":"Detta projekt samlar data om svenska återvinningsstationer (återvinningsstationer) med hjälp av Avfall Sveriges öppna API:er. Datat konverteras till CSV och JSON. OBS: Uppgifterna samlas en gång per dag och kan vara felaktiga eller ouppdaterade. Avfall Sverige är inte involverat med publiceringen."}],"dct:issued":{"@type":"xsd:date","@value":"2022-10-24"},"dct:publisher":{"@id":"https://civictech.se"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:430228030566edd422c8b16fdbc8be84ee8c481a3d7977892ec02b73858c450a_b1n0"},"dct:title":[{"@language":"en","@value":"Swedish recycling stations"},{"@language":"sv","@value":"Sveriges återvinningsstationer"}],"foaf:page":{"@id":"https://github.com/civictechsweden/oppna-atervinningsdata"}},{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/services.csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/services.csv"},"dcat:downloadURL":{"@id":"https://raw.githubusercontent.com/civictechsweden/oppna-atervinningsdata/refs/heads/master/data/services.csv"},"dct:description":[{"@language":"en","@value":"Recycling station services in CSV"},{"@language":"sv","@value":"Tjänster vid återvinningsstationer på CSV"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Recycling station services"},{"@language":"sv","@value":"Tjänster vid återvinningsstationer"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experi