eu/resource/authority/distribution-status/COMPLETED"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/673/v%C3%A4gledning-om-att-publicera-data-om-badplatser?_=1694690489432"},{"@id":"https://editera.dataportal.se/store/86/resource/9"},{"@id":"https://gitlab.com/lankadedata/spec/badplatser"},{"@id":"https://gitlab.com/lankadedata/spec/badplatser/-/raw/main/dataset-example.ods?inline=false"},{"@id":"https://gitlab.com/lankadedata/spec/badplatser/-/raw/main/dataset-example.xlsx?inline=false"},{"@id":"https://lankadedata.se/spec/badplatser"},{"@id":"https://lankadedata.se/spec/badplatser/schema.json"}],"http://www.w3.org/ns/dx/prof/hasToken":"badplatser"},{"@id":"https://editera.dataportal.se/store/86/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:58c29fb107c7ef7b1c3cbad56ecf36ef26d3f009c5ab2fee10c1230c0e017bc7_b5n0"},{"@id":"_:58c29fb107c7ef7b1c3cbad56ecf36ef26d3f009c5ab2fee10c1230c0e017bc7_b6n0"},{"@id":"_:58c29fb107c7ef7b1c3cbad56ecf36ef26d3f009c5ab2fee10c1230c0e017bc7_b7n0"}]}],"@id":"urn:source:58c29fb107c7ef7b1c3cbad56ecf36ef26d3f009c5ab2fee10c1230c0e017bc7"},{"@graph":[{"@id":"_:99d980c19a646d63a09b83f6dcc403988658d5bc47674888968571ca8a317d13_b0n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#copyrightHolder":{"@id":"http://dataportal.se/organisation/SE2120001637"}},{"@id":"_:99d980c19a646d63a09b83f6dcc403988658d5bc47674888968571ca8a317d13_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"SE","http://www.w3.org/2006/vcard/ns#locality":"Töreboda","http://www.w3.org/2006/vcard/ns#postal-code":"545 83","http://www.w3.org/2006/vcard/ns#street-address":"Drottninggatan 4, Box 83"},{"@id":"_:99d980c19a646d63a09b83f6dcc403988658d5bc47674888968571ca8a317d13_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4650618000"}},{"@id":"http://dataportal.se/organisation/SE2120001637","@type":"foaf:Agent","dct:identifier":"2120001637","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:info@gullspang.se"},"foaf:name":{"@language":"sv","@value":"Gullspångs kommun"},"foaf:page":{"@id":"https://gullspang.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.gullspang.se/store/1/resource/1"}},{"@id":"https://catalog.gullspang.se/store/1/resource/14","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gullspang.se/store/1/resource/35"},"dcat:distribution":{"@id":"https://catalog.gullspang.se/store/1/resource/15"},"dcat:keyword":[{"@language":"en","@value":"menu, restaurant, lunch, school lunch"},{"@language":"sv","@value":"meny, restaurang, skolmat, matsedel"}],"dcat:landingPage":{"@id":"https://skolmaten.se/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"School restaurant menus are presented in a web interface with RSS capabilities per school for the schools in the municipality. By having each school sharing the menu in the service provided by Skolmaten.se, the information is shown in the app developed by this said service. The app Skolmaten is available on all popular mobile platforms.\n\nMenus are presented as an RSS flow and can therefore be modified or reused in apps for smartphones and or tablets or other platforms and services capable of handling RSS and show the menus as an overlay on calendar apps etc. This way both the children and their parents can access the menus easily for their own school the way most convenient for them.\n\nThe service is provaided by a cooperation between the schools and the service provider Skolmaten, and it is each school that is sharing the information, which ensures high data quality - the data is shared close to the unit that runs each shool restaurant.\n\nFor more information about the service Skolmaten\", visit their website at. http://www.dinskolmat.se/"},{"@language":"sv","@value":"Skolmatsmenyer presenteras i ett webbaserat gränssnitt med RSS-funktionalitet per skola, för skolorna i kommunen. Genom att skolornas matbespisningar delar informationen till tjänsten Skolmaten.se, hamnar den i den app som utvecklats till den tjänsten. Skolmaten finns att ladda ned som app för alla mobilplattformar. \n\nMaten per skola presenteras som ett RSS-flöde och kan därför anpassas och läggas till i appar i smartphones och tablets eller andra plattformar och tjänster som stödjer RSS för att skapa en meny som presenteras i en exempelvis en kalender. På så vis kan både barn och föräldrar enkelt ta del av skolmatsedeln för sin skola på det vis de själva önskar, dag för dag. \n\nTjänsten tillhandahålls genom avtal mellan kommunen och Skolmaten.se och det är respektive skola som själva lägger ut informationen vilket borgar för hög kvalitet - informationen delas nära källan och ofta av den funktion som förestår skolbespisningen på varje skolenhet.\n\nLäs gärna mer om tjänsten \"Skolmaten\" på deras egen webb: http://www.dinskolmat.se/"}],"dct:issued":{"@type":"xsd:date","@value":"2020-11-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@language":"sv","@value":"https://skolmaten.se/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001637"},"dct:spatial":{"@id":"http://sws.geonames.org/2709910"},"dct:title":[{"@language":"en","@value":"School restaurant menu for the municipality of Gullspång"},{"@language":"sv","@value":"Skolmatsmenyer för Gullspång kommuns skolor"}]},{"@id":"https://catalog.gullspang.se/store/1/resource/15","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skolmaten.se/d/gullspang-kommun/"},"dct:description":[{"@language":"en","@value":"Start page for school restaurant menus for each respective school. The schools names are presented in the form av clickable link. On each link there is an opportunity to access and partly modify an RSS-flow, allowing the data consumer to build a calendar overlay or collection of menus."},{"@language":"sv","@value":"Startsida för skolmatsedel för respektive skola. Skolorna presenteras med namn i form av klickbar länkar. På varje unik skola finns möjlighet att komma åt ett RSS-flöde med vissa inställningar för varje skola, att t.ex. lägga till en kalender eller bygga en egen sammanställning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2020-11-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"_:99d980c19a646d63a09b83f6dcc403988658d5bc47674888968571ca8a317d13_b0n0"},"dct:title":[{"@language":"en","@value":"School lunch menu for schools in Gullspång municipality"},{"@language":"sv","@value":"Skolmatsedel för skolor i Gullspång"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gullspang.se/store/1/resource/35","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"MTG Öppna Data","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:99d980c19a646d63a09b83f6dcc403988658d5bc47674888968571ca8a317d13_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalutveckling@toreboda.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:99d980c19a646d63a09b83