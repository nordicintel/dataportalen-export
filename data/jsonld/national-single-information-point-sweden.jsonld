72,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:Nedladdning:data/7"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/1"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/3"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/4"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/5"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/6"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Tjänst för åtkomst till karta"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=34fc8b07-1d73-4461-8a32-a5e3236bb6cd"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Skyfall är intensiva regn som kan leda till att marken mättas och att dagvattensystemet överbelastas. Detta kan i sin tur orsaka översvämningar och medföra störningar och skador som påverkar både individer och viktiga samhällsfunktioner. Trafikkontoret i Stockholms stad tog under 2024 fram en ny skyfallsmodell som visar hur vatten rinner över ytan samt var vatten kan samlas vid kraftig nederbörd. Modellen har tagits fram för att ge stöd i planeringen av en mer motståndskraftig stad. Resultaten för tre olika nederbördsscenarier presenteras: ett 100-årsregn och ett 500-årsregn, båda anpassade för klimatförändringar genom en klimatfaktor på 1,40 och baserade på regional regnstatistik (\"Stockholmsregn\"), samt det så kallade Gävleregnet som föll över Gävle 2021 - den mest omfattande nederbörden i närtid i närheten av Stockholm.Tillgängliga metadata redovisar bland annat vilken höjdmodell som använts (inklusive identifierade lågpunkter), vilken karteringsmetod och upplösning som tillämpats. Det gör det möjligt att bedöma underlagets tillförlitlighet och genomföra enklare kvalitetskontroller av resultaten."},"dct:identifier":"3e07467b-22fb-4c70-bbab-33922584d021","dct:issued":{"@type":"xsd:date","@value":"2025-06-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:56cd0bf3e4310669966d45701b28db03bf7d64ad22af5af108c08e77ad7fd27a_b0n0"},"dct:title":{"@language":"sv","@value":"Stockholms Skyfallsmodell 2024 (TK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:Nedladdning:data/7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/downloads/skyfall/Skyfall%202024%20100-%C3%A5rsregn.zip"},"dct:description":"Nedladdningsbar Geotiff-fil","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Skyfall 2024 100-årsregn"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_100_framkomlighetskarta"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn framkomlighetskarta, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_100_framkomlighetskarta"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_100_maxdjup"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn maxdjup, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_100_maxdjup"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:SKYfall_2024_100_maxflode"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn maxflöde,OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@i