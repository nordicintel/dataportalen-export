c","@value":"Aplinkos apsaugos administracijos atvirųjų duomenų centras"},{"@language":"lv-t-sv-t0-mtec","@value":"Vides pārvaldes atvērto datu centrs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ċentru tad-data miftuħa tal-amministrazzjoni ambjentali"},{"@language":"nl-t-sv-t0-mtec","@value":"Open data hub van de milieuadministratie"},{"@language":"pl-t-sv-t0-mtec","@value":"Otwarte centrum danych administracji środowiskowej"},{"@language":"pt-t-sv-t0-mtec","@value":"Centro de dados abertos da administração ambiental"},{"@language":"ro-t-sv-t0-mtec","@value":"Centrul de date deschise al administrației de mediu"},{"@language":"sk-t-sv-t0-mtec","@value":"Centrum otvorených dát environmentálnej správy"},{"@language":"sl-t-sv-t0-mtec","@value":"Vozlišče odprtih podatkov okoljske uprave"},{"@language":"uk-t-sv-t0-mtec","@value":"Центр відкритих даних екологічної адміністрації"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/9883209b-ed92-4974-bd6e-dc0335de1134"}},{"@id":"http://data.europa.eu/88u/record/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/48a2a634-9160-4a11-b0de-7dcc4811b402"},{"@id":"http://data.europa.eu/88u/distribution/9883209b-ed92-4974-bd6e-dc0335de1134"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:50a4b0bd61ebecc438bdbd1d2bad7a0735682136b89e0a2fa7efca6d789ea047_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:50a4b0bd61ebecc438bdbd1d2bad7a0735682136b89e0a2fa7efca6d789ea047"},{"@graph":[{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"}},{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16bee1c293014c0b841a52a49ea77e8b9c"},{"@id":"http://data.europa.eu/88u/dataset/097af499-5a1d-4e17-9341-c71176eb18c4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37"},{"@id":"http://data.europa.eu/88u/distribution/a4698b79-e435-4067-858c-60dba7613b05"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6acef71a-7573-4dc8-a4f7-32df59c39399"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"Kommunerna har ett viktigt ansvar för att Sveriges vatten ska uppnå miljökvalitetsnormerna enligt EU:s vattendirektiv. Därför tar Stockholms stad fram lokala åtgärdsprogram för stadens vattenförekomster. Syftet med åtgärdsprogrammen är att beskriva lokala påverkanskällor, vilket förbättringsbehov som finns samt vilka åtgärder som behöver genomföras för att uppnå normerna. Den geografiska avgränsningen är vattenförekomstens avrinningsområde. De lokala åtgärdsprogrammen är inte rättsligt bindande, så som Vattenmyndighetens åtgärdsprogram är. Vattenmyndighetens åtgärdsprogram avhandlar generella åtgärder inom vattendistriktet medan de lokala åtgärdsprogrammen förtydligar vad som behöver göras inom respektive avrinningsområde. De lokala åtgärdsprogrammen är tänkta att användas som ett stöd i kommunernas egen planering, samt för att visa vilken miljökvalitet som behöver uppnås och vad som krävs för att nå dit."},"dct:format":"text/html","dct:identifier":"097af499-5a1d-4e17-9341-c71176eb18c4","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b0n0"},"dct:title":{"@language":"sv","@value":"Åtgärdsdata - Lokala åtgärdsprogram - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/atgarder/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:Information/1","dct:title":"MiljödataStockholm","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37"}},{"@id":"http://data.europa.eu/88u/distribution/a4698b79-e435-4067-858c-60dba7613b05","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/516c6abdf69341eb8eec98f20f60b450/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:ESRI+Portal-URL/2","dct:title":"Nedladdning","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/a4698b79-e435-4067-858c-60dba7613b05"}},{"@id":"http://data.europa.eu/88u/record/097af499-5a1d-4e17-9341-c71176eb18c4","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37"},{"@id":"http://data.europa.eu/88u/distribution/a4698b79-e435-4067-858c-60dba7613b05"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"097af499-5a1d-4e17-9341-c71176eb18c4","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:24Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:01Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/097af499-5a1d-4e17-9341-c71176eb18c4"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/097af499-5a1d-4e17-9341-c71176eb18c4"},"https://piveau.eu/ns/voc#originalId":"097af499-5a1d-4e17-9341-c71176eb18c4","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe"},{"@graph":[{"@id":"_:52fcca39a497ec092f6e65b01b2794fd5e6a50a27ffb01b9a525471a4e78e60f_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"10ba69f05a238074453647390c881cf724"},{"@id":"_:52fcca39a497ec092f6e65b01b2794fd5e6a50a27ffb01b9a525471a4e78e60f_b1n0","dct:identifier":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/bilforman/2.0.3/%2523distribution","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/7acd1a55-b46d-4dfc-bd65-88d92e5f3461"}},{"@id":"http://data.europa.eu/88u/dataset/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-bilforman-2-0-3-2523dataset~~1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7acd1a55-b46d-4dfc-bd65-88d92e5f3461"},"dcat:keyword":[{"@language":"sv","@value":" avdrag"},{"@language":"sv","@value":" löner"},{"@language":"sv","@value":" trafik"},{"@language":"sv","@value":"bil"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"2.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Bilförmån gör det möjligt för programvaruföretag att ta fram tjänster där slutanvändare kan räkna ut förmånsvärdet på sin företagsbil. API:et finns tillgängligt som komplett testtjänst och driftsatt tjänst."},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2022-05-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Bilförmån"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/bilforman/2.0.3/swagger.json%2523accessService"}},{"@id"