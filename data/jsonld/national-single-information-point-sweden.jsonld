l.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"1aa0bb19-edd0-464b-b941-5c855b820f48","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/1aa0bb19-edd0-464b-b941-5c855b820f48"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:08d7297a4632fe65b21e15b9f2463dceb7890a94e86039d43b440196aeed0d66"},{"@graph":[{"@id":"_:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4436,18.2011 59.4436,18.2011 59.2272,17.7605 59.2272,17.7605 59.4436))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4436,18.2011 59.4436,18.2011 59.2272,17.7605 59.2272,17.7605 59.4436))"}},{"@id":"_:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"14dce917796f7be38f11540f0ba2785763"},{"@id":"http://data.europa.eu/88u/dataset/56ce79ba-fc02-4e23-a43d-8aa9426eef89","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69"},{"@id":"http://data.europa.eu/88u/distribution/c6985ff1-fbee-42e5-8e24-6059a1cd323f"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=55bd8a0a-1ed9-4e7b-8b2d-74277702635d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"För att följa klimatförändringar krävs tillgång till långa tidsserier med väderdata för flera decennier. Stockholms klimat- och väderstatistik baseras främst på data från SMHI:s mätstation vid Observatorielunden. Den hydrologiska statistiken (vatten) hämtas från olika mätstationer i Mälaren och Saltsjön. Med hjälp av de långa mätserierna går det att uppskatta trender och naturlig variation."},"dct:format":"text/html","dct:identifier":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Klimat - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:ESRI+Portal-URL/2","dct:title":"Miljöförvaltningens öppna data-hub","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69"}},{"@id":"http://data.europa.eu/88u/distribution/c6985ff1-fbee-42e5-8e24-6059a1cd323f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/klimat/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:Information/1","dct:title":"MiljödataStockholm","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/c6985ff1-fbee-42e5-8e24-6059a1cd323f"}},{"@id":"http://data.europa.eu/88u/record/56ce79ba-fc02-4e23-a43d-8aa9426eef89","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69"},{"@id":"http://data.europa.eu/88u/distribution/c6985ff1-fbee-42e5-8e24-6059a1cd323f"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:26Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:03Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/56ce79ba-fc02-4e23-a43d-8aa9426eef89"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/56ce79ba-fc02-4e23-a43d-8aa9426eef89"},"https://piveau.eu/ns/voc#originalId":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf"},{"@graph":[{"@id":"_:0959359d421fb8cb17512063f63344fb414b91c2bfb7ba372536121e8512157f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id