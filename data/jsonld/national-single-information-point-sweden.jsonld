et/Punktmoln.las"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0#HTTP:Nedladdning:data/3","dct:title":["Testdata LAS-format",{"@language":"bg-t-sv-t0-mtec","@value":"Формат на LAS за данните от изпитването"},{"@language":"cs-t-sv-t0-mtec","@value":"Formát LAS zkušebních údajů"},{"@language":"da-t-sv-t0-mtec","@value":"Prøvningsdata — SVL-format"},{"@language":"de-t-sv-t0-mtec","@value":"Testdaten LAS-Format"},{"@language":"el-t-sv-t0-mtec","@value":"Μορφότυπος LAS δεδομένων δοκιμής"},{"@language":"en-t-sv-t0-mtec","@value":"Test data LAS format"},{"@language":"es-t-sv-t0-mtec","@value":"Formato de LAS de los datos de prueba"},{"@language":"et-t-sv-t0-mtec","@value":"Õiguspärasuse tagamise süsteemi katseandmete vorming"},{"@language":"fi-t-sv-t0-mtec","@value":"Testitiedot LAS-muodossa"},{"@language":"fr-t-sv-t0-mtec","@value":"Format LAS des données d'essai"},{"@language":"ga-t-sv-t0-mtec","@value":"Formáid LAS sonraí tástála"},{"@language":"hr-t-sv-t0-mtec","@value":"Format LAS-a za podatke o ispitivanju"},{"@language":"hu-t-sv-t0-mtec","@value":"A vizsgálati adatok LAS-formátuma"},{"@language":"it-t-sv-t0-mtec","@value":"Dati di prova in formato LAS"},{"@language":"lt-t-sv-t0-mtec","@value":"Bandymų duomenų TUS formatas"},{"@language":"lv-t-sv-t0-mtec","@value":"Testa datu LAS formāts"},{"@language":"mt-t-sv-t0-mtec","@value":"Format tal-LAS tad-data tat-test"},{"@language":"nl-t-sv-t0-mtec","@value":"Testgegevens LAS-formaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Dane z badań w formacie systemu zapewnienia legalności"},{"@language":"pt-t-sv-t0-mtec","@value":"Formato LAS dos dados de ensaio"},{"@language":"ro-t-sv-t0-mtec","@value":"Formatul LAS al datelor de încercare"},{"@language":"sk-t-sv-t0-mtec","@value":"Formát testovacích údajov systému overovania legálnosti"},{"@language":"sl-t-sv-t0-mtec","@value":"Oblika LAS preskusnih podatkov"},{"@language":"uk-t-sv-t0-mtec","@value":"Формат тестових даних LAS"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f1b9dbd0-1e99-4a9f-8da4-e0d3acad6324"}},{"@id":"http://data.europa.eu/88u/record/c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1b79a9c4-37cc-4779-b0ba-fdd411be7a2e"},{"@id":"http://data.europa.eu/88u/distribution/30185976-4c3a-4c40-9349-d86bb568dd85"},{"@id":"http://data.europa.eu/88u/distribution/f1b9dbd0-1e99-4a9f-8da4-e0d3acad6324"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:05Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:5c89fc86b639b41d8bcbabede44d1bf8699fae89cfff0b5920133f398e62f2ac_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:05Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/c5a65f72-3b80-4d38-b2f2-851b8a4ea2b0"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5c89fc86b639b41d8bcbabede44d1bf8699fae89cfff0b5920133f398e62f2ac"},{"@graph":[{"@id":"_:5d3f8f97b9275762e210809ab8e0c92be30da1db8fa616d6c5be9ac4ef423ef9_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5d3f8f97b9275762e210809ab8e0c92be30da1db8fa616d6c5be9ac4ef423ef9_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"19b847b095177bd289c124a5121a1e8018"},{"@id":"http://data.europa.eu/88u/dataset/c2c5f260-2da1-45ff-98ce-29b621e09242","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/3821d4a0-868b-4223-8b7b-24fd60b5f22e"},{"@id":"http://data.europa.eu/88u/distribution/723be1cc-2f2c-4278-8649-038280b865b5"},{"@id":"http://data.europa.eu/88u/distribution/fc04602e-151d-41df-9fa2-da92f2ef51be"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=68dbb479-b007-4c1c-8bad-c9f3cdb4bf71"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2026-02-03"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Лазерни точкови облаци от полет 2025. Обхваща цялата община Стокхолм, вкл. буферната зона наоколо. Формат на файла: LAS и POD. Надморска височина на полета: Плътност на пунктуацията: 16 pkt/m² Дата на полета: 1—3 април 2025 г. Референтна система в план: Sweref 991800, на височина: RH2000 г. Точността на височината е 9 см или по-добра за твърди повърхности и 15 см или по-добра за други повърхности. В самолетите точността е 15 см или по-добра. Класификацията на земята се контролира ръчно, докато класификацията на сградите е напълно автоматична и може да бъде с различно качество. Класификацията на лазерните данни е разделена на следните класове: 1 (некласифицирани); 2 (маркиране); 6 (Сграда); 7 (високи и ниски точки, т.нар. шум); 9 (вода); 17 (Броар). Точковият облак е оцветен с ортофотография 2025, което означава, че на всяка точка е присвоена RGB стойност от съответния пиксел в ортофотографията. (Фотографска дата на ортофотоснимката: 20 и 31 май, 15 юни и 1 юли 2025 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"Mraky laserových bodů z letu 2025. Zahrnuje celou obec Stockholm včetně nárazníkové zóny v okolí. Formát souboru: LAS a POD. Nadmořská výška letu: Hustota interpunkce: 16 pkt/m² Datum letu: a 3. dubna 2025. Referenční systém v plánu: Sweref 991800, na výšku: RH2000. Přesnost ve výšce je 9 cm nebo lepší pro tvrdé povrchy a 15 cm nebo lepší pro jiné povrchy. V rovinách je přesnost 15 cm nebo lepší. Klasifikace pozemků je řízena ručně, zatímco klasifikace budov je plně automatická a může mít různou kvalitu. Klasifikace laserových dat je rozdělena do následujících tříd: 1 (neutajované); 2 (značka); 6 (budova); 7 (vysoké a nízké body, tzv. hluk); 9 (voda); 17 (křik). Bodový mrak byl zbarven pomocí ortofotosnímku 2025, což znamená, že každému bodu byla přiřazena hodnota RGB z odpovídajícího pixelu na ortofotosnímku. (Datum pořízení ortofotosnímku: a 31. května, 15. června a 1. července 2025)"},{"@language":"da-t-sv-t0-mtec","@value":"Laserpunktskyer fra flyvning 2025. Dækker hele Stockholm kommune inkl. stødpudezone omkring. Filformat: LAS og POD. Flyvehøjde: Tegnsætningstæthed: 16 pkt./m² Flyvedato: 1.-3. april 2025. Referencesystem i planen: Sweref 991800, i højden: RH2000. Nøjagtigheden i højden er 9 cm eller bedre for hårde overflader og 15 cm eller bedre for andre overflader. I fly er nøjagtigheden 15 cm eller bedre. Landklassifikationen styres manuelt, mens bygningsklassifikationen er fuldautomatisk og kan være af varierende kvalitet. Klassificeringen af laserdata er opdelt i følgende klasser: 1 (ikke klassificeret) 2 (mærke) 6 (Bygning) 7 (høje og lave punkter, såkaldt støj) 9 (vand) 17 (Broar). Punktskyen er blevet farvet ved hjælp af 2025-ortofotoet, hvilket betyder, at hvert punkt er blevet tildelt en RGB-værdi fra den tilsvarende pixel i ortofotoet. (Fotografidato for ortofotoet: den 20. og 31. maj, den 15. juni og den 1. juli 2025)"},{"@language":"de-t-sv-t0-mtec","@value":"Laserpunktwolken ab Flug 2025. Bedeckt die gesamte Gemeinde Stockholm inklusive Pufferzone. Dateiformat: LAS und POD. Flughöhe: Satzdichte: 16 pkt/m² Flugdatum: 1.-3. April 2025. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000. Die Genauigkeit in der Höhe beträgt 9 cm oder besser für harte Oberflächen und 15 cm oder besser für andere Oberflächen. In Flugzeugen beträgt die Genauigkeit 15 cm oder besser. Die Landklassifizierung wird manuell gesteuert, während die Gebäudeklassifizierung vollautomatisch ist und von unterschiedlicher Qualität sein kann. Die Klassifizierung von Laserdaten gliedert sich in folgende Klassen: 1 (nicht klassifiziert); 2 (Mark); 6 (Gebäude); 7 (hohe und niedrige Punkte, sogenanntes Rauschen); 9 (Wasser); 17 (Brauen). Die Punktwolke wurde mit dem Orthofoto 2025 eingefärbt, was bedeutet, dass jedem Punkt ein RGB-Wert aus dem entsprechenden Pixel im Orthofoto zugewiesen wurde. (Fotodatum des Orthofotos: 20. und 31. Mai, 15. Juni und 1. Juli 2025)"},{"@language":"el-t-sv-t0-mtec","@value":"Σύννεφα σημείου λέιζερ από την πτήση 2025. Καλύπτει ολόκληρο τον δήμο της Στοκχόλμης, συμπεριλαμβανομένης της νεκρής ζώνης. Μορφή αρχείου: LAS και POD. Υψόμετρο πτήσης: Πυκνότητα στίξης: 16 pkt/m² Ημερομηνία πτήσης: 1-3 Απριλίου 2025. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: RH2000. Η ακρίβεια στο ύψος είναι 9 cm ή καλύτερη για σκληρές επιφάνειες και 15 cm ή καλύτερη για άλλες επιφάνειες. Στα αεροπλάνα, η ακρίβεια είναι 15 cm ή καλύτερη. Η ταξινόμηση της γης ελέγχεται χειροκίνητα, ενώ η ταξινόμηση του κτιρίου είναι πλήρως αυτόματη και μπορεί να είναι διαφορετικής ποιότητας. Η ταξινόμηση των δεδομένων λέιζερ χωρίζεται στις ακόλουθες κατηγορίες: 1 (Μη διαβαθμισμένο)· 2 (Σήμα)· 6 (κτίριο)· 7 (Υψηλά και Χαμηλά Σημεία, ο λεγόμενος θόρυβος). 9 (νερό)· 17 (Broar). Το νέφος σημείων έχει χρωματιστεί με τη χρήση της ορθοφωτογραφίας 2025, πράγμα που σημαίνει ότι σε κάθε σημείο έχει αποδοθεί μια τιμή RGB από το αντίστοιχο εικονοστοιχείο στην ορθοφωτογραφία. (Ημερομηνία φωτογράφισης της ορθοφωτογραφίας: 20 και 31 Μαΐου, 15 Ιουνίου και 1 Ιουλίου 2025)"},{"@language":"en-t-sv-t0-mtec","@value":"Laser point clouds from flight 2025. Covers the entire municipality of Stockholm incl buffer zone around. File format: LAS and POD. Flight altitude: Punctuation density: 16 pkt/m² Flight date: 1-3 April 2025. Reference system in plan: Sweref 991800, in height: RH2000. The accuracy in height is 9 cm or better for hard surfaces and 15 cm or better for other surfaces. In planes, the accuracy is 15 cm or better. The land classification is manually controlled while the building classification is fully automatic and can be of varying quality. The classification of laser data is divided into the following classes: 1 (Unclassified); 2 (Mark); 6 (Building); 7 (High and Low points so-called noise); 9 (Water); 17 (Broar). The point cloud has been coloured using the 2025 orthophoto, which means that each point has been assigned an RGB value from the corresponding pixel in the orthophoto. (Photography date of the orthophoto: 20 and 31 May, 15 June and 1 July 2025)"},{"@language":"es-t-sv-t0-mtec","@value":"Nubes de puntos láser del vuelo 2025. Cubre todo el municipio de Estocolmo, incluida la zona tampón alrededor. Formato de archivo: LAS y POD. Altitud de vuelo: Densidad de puntuacion: 16 pkt/m² Fecha de vuelo: 1-3 de abril de 2025. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000. La precisión en altura es de 9 cm o mejor para superficies duras y 15 cm o mejor para otras superficies. En los planos, la precisión es de 15 cm o mejor. La clasificación del terreno se controla manualmente, mientras que la clasificación del edificio es totalmente automática y puede ser de calidad variable. La clasificación de los datos láser se divide en las siguientes clases: 1 (sin clasificar); 2 (Marca); 6 (edificio); 7 (puntos altos y bajos llamados ruido); 9 (Agua); 17 (Broar). La nube de puntos se ha coloreado utilizando la ortofoto 2025, lo que significa que a cada punto se le ha asignado un valor RGB del píxel correspondiente en la ortofoto. (Fecha de la fotografía de la ortofoto: 20 y 31 de mayo, 15 de junio y 1 de julio de 2025)"},{"@language":"et-t-sv-t0-mtec","@value":"Laserpunktpilved alates lennust 2025. Hõlmab kogu Stockholmi omavalitsust, sh ümberringi asuvat puhvertsooni. Faili vorming: LAS ja POD. Lennukõrgus: Täpsustihedus: 16 pkt/m² Lennu kuupäev: 1.–3. aprill 2025. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000. Kõrguse täpsus on 9 cm või parem kõvadel pindadel ja 15 cm või parem muudel pindadel. Lennukites on täpsus 15 cm või parem. Maa klassifitseerimist kontrollitakse käsitsi, samas kui hoonete klassifitseerimine on täisautomaatne ja võib olla erineva kvaliteediga. Laserandmete klassifikatsioon on jagatud järgmistesse klassidesse: 1 (liigitamata); 2 (märgis); 6 (ehitustööd); 7 (kõrged ja madalad punktid, nn müra); 9 (vesi); 17 (Broar). Punktipilv on värvitud 2025. aasta ortofotoga, mis tähendab, et igale punktile on määratud RGB väärtus ortofoto vastavast pikslist. (Ortofoto foto kuupäev: ja 31. mai, 15. juuni ja 1. juuli 2025)"},{"@language":"fi-t-sv-t0-mtec","@value":"Laserpistepilviä lennolta 2025. Kattaa koko Tukholman kunnan sisältäen puskurivyöhykkeen. Tiedostomuoto: LAS ja POD. Lentokorkeus: Välimerkkitiheys: 16 pkt/m² Lennon päivämäärä: huhtikuuta 2025. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000. Korkeustarkkuus on 9 cm tai parempi kovilla pinnoilla ja 15 cm tai parempi muilla pinnoilla. Lentokoneissa tarkkuus on 15 cm tai parempi. Maaluokitusta ohjataan manuaalisesti, kun taas rakennusluokitus on täysin automaattinen ja voi olla laadultaan vaihteleva. Laserdatan luokitus on jaettu seuraaviin luokkiin: 1 (luokittelematon); 2 (merkintä); 6 (rakentaminen); 7 (korkeat ja matalat pisteet, ns. melu); 9 (Vesi); 17 (Broar) (viittaukset muokkaa) Pistepilvi on väritetty vuoden 2025 ortokuvalla, mikä tarkoittaa, että jokaiselle pisteelle on määritetty RGB-arvo ortokuvan vastaavasta pikselistä. (Ortokuvan kuvauspäivä: 20. ja 31. toukokuuta, 15. kesäkuuta ja 1. heinäkuuta 2025)"},{"@language":"fr-t-sv-t0-mtec","@value":"Nuages de point laser du vol 2025. Couvre l'ensemble de la municipalité de Stockholm, y compris la zone tampon autour. Format du fichier: LAS et POD. Altitude de vol: Densité de ponctuation: 16 pkt/m² Date de vol: du 1er au 3 avril 2025. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000. La précision en hauteur est de 9 cm ou mieux pour les surfaces dures et de 15 cm ou mieux pour les autres surfaces. Dans les avions, la précision est de 15 cm ou mieux. La classification des terrains est contrôlée manuellement tandis que la classification des bâtiments est entièrement automatique et peut être de qualité variable. La classification des données laser est divisée en classes suivantes: 1 (non classifié); 2 (marque); 6 (bâtiment); 7 (Points haut et bas dits «bruit»); 9 (Eau); 17 (Broar). Le nuage de points a été coloré à l'aide de l'orthophoto 2025, ce qui signifie que chaque point a reçu une valeur RVB à partir du pixel correspondant dans l'orthophoto. (Date de photographie de l'orthophoto: 20 et 31 mai, 15 juin et 1er juillet 2025)"},{"@language":"ga-t-sv-t0-mtec","@value":"Néalta pointe léasair ó eitilt 2025. Cumhdaítear leis sin bardas iomlán Stócólm, lena n-áirítear crios maolánach timpeall air. Formáid an chomhaid: LAS agus POD. Airde eitilte: Dlús poncaíochta: 16 pkt / m² Dáta Eitilte: 1-3 Aibreán 2025. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000. Tá an cruinneas ar airde 9 cm nó níos fearr do dhromchlaí crua agus 15 cm nó níos fearr do dhromchlaí eile. I bplánaí, tá an cruinneas 15 cm nó níos fearr. Déantar an t-aicmiú talún a rialú de láimh agus tá an t-aicmiú foirgnimh go hiomlán uathoibríoch agus is féidir leis a bheith de cháilíocht éagsúil. Tá aicmiú sonraí léasair roinnte sna haicmí seo a leanas: 1 (Neamhaicmithe); 2 (Marcáil); 6 (Foirgníocht); 7 (Torann ard agus ísealphointí mar a thugtar air); 9 (Uisce); 17 (Broar). Rinneadh an néalphointe a dhathú trí úsáid a bhaint as orthophoto 2025, rud a chiallaíonn gur sannadh luach RGB do gach pointe ón bpicteilín comhfhreagrach san orthophoto. (Dáta fótagrafaíochta an ortaphoto: 20 agus 31 Bealtaine, 15 Meitheamh agus 1 Iúil 2025)"},{"@language":"hr-t-sv-t0-mtec","@value":"Oblaci laserskih točaka od leta 2025. Obuhvaća cijelu općinu Stockholm, uključujući tampon zonu oko nje. Format datoteke: LAS i POD. Visina leta: Gustoća interpunkcije: 16 pkt/m² Datum leta: 3. travnja 2025. Referentni sustav u planu: Sweref 991800, u visini: RH2000. Točnost u visini je 9 cm ili bolje za tvrde površine i 15 cm ili bolje za druge površine. U ravninama, točnost je 15 cm ili bolja. Klasifikacija zemljišta ručno se kontrolira, dok je klasifikacija zgrade potpuno automatska i može biti različite kvalitete. Klasifikacija laserskih podataka podijeljena je u sljedeće razrede: 1 (neklasificirano); 2 (oznaka); 6 (zgrada); 7 (takozvana buka visokih i niskih točaka); 9 (voda); 17 (smijeh). Oblak točke obojen je ortofotografom za 2025., što znači da je svakoj točki dodijeljena RGB vrijednost iz odgovarajućeg piksela u ortofotografu. (Datum fotografije ortofotografije: i 31. svibnja, 15. lipnja i 1. srpnja 2025.)"},{"@language":"hu-t-sv-t0-mtec","@value":"Laser point clouds from flight 2025 (Lézerpontfelhők a 2025-ös repülésből). Stockholm teljes települését lefedi, beleértve a körülvevő pufferzónát is. Fájlformátum: LAS és POD. Repülési magasság: Pontozási sűrűség: 16 pkt/m² Járat dátuma: 2025. április 1–3. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000. sz. különjelentés. A magasság pontossága kemény felületek esetében 9 cm vagy jobb, más felületek esetében pedig 15 cm vagy jobb. Repülőgépeken a pontosság 15 cm vagy annál jobb. A telekbesorolás manuálisan vezérelhető, míg az épületbesorolás teljesen automatikus és változó minőségű lehet. A lézeradatok osztályozása a következő osztályokra oszlik: 1 (nem minősített); 2 (jelölés); 6 (épület); 7 (Magas és alacsony pontok, úgynevezett zaj); 9 (víz); 17 (Broar) (angol nyelven). A pontfelhőt a 2025-ös ortofotóval színezték, ami azt jelenti, hogy minden ponthoz hozzárendeltek egy RGB értéket az ortofotó megfelelő képpontjából. (Az ortofotó fényképezési dátuma: 2025. május 20. és 31., június 15. és július 1.)"},{"@language":"it-t-sv-t0-mtec","@value":"Nuvole di punti laser dal volo 2025. Copre l'intero comune di Stoccolma, compresa la zona cuscinetto intorno. Formato del file: LAS e POD. Altitudine di volo: Densità di punteggiatura: 16 pkt/m ² Data del volo: 1-3 aprile 2025. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000. La precisione in altezza è di 9 cm o migliore per le superfici dure e 15 cm o migliore per altre superfici. Negli aerei, la precisione è di 15 cm o superiore. La classificazione del terreno è controllata manualmente mentre la classificazione dell'edificio è completamente automatica e può essere di qualità variabile. La classificazione dei dati laser è suddivisa nelle seguenti classi: 1 (non classificato); 2 (marchio); 6 (Edilizia); 7 (punti alti e bassi cosiddetto rumore); 9 (Acqua); 17 (Broar). La nuvola di punti è stata colorata utilizzando l'ortofoto 2025, il che significa che a ciascun punto è stato assegnato un valore RGB dal pixel corrispondente nell'ortofoto. (Data della fotografia dell'ortofoto: 20 e 31 maggio, 15 giugno e 1o luglio 2025)"},{"@language":"lt-t-sv-t0-mtec","@value":"Lazeriniai taškiniai debesys nuo skrydžio 2025 m. Apima visą Stokholmo savivaldybę, įskaitant buferinę zoną aplink ją. Rinkmenos formatas: LAS ir POD. Skrydžio aukštis: skyrybos tankis: 16 pkt/m² Skrydžio data: 2025 m. balandžio 1–3 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000. Kietų paviršių aukščio tikslumas yra 9 cm arba didesnis, o kitų paviršių - 15 cm arba didesnis. Plokštėse tikslumas yra 15 cm arba didesnis. Žemės klasifikacija kontroliuojama rankiniu būdu, o pastatų klasifikacija yra visiškai automatinė ir gali būti įvairios kokybės. Lazerių duomenų klasifikacija skirstoma į šias klases: 1 (neįslaptinta); 2 (žymėjimas); 6 (statyba); 7 (aukštų ir žemų taškų vadinamasis triukšmas); 9 (Vanduo); 17 (Broaras). Taškų debesis nuspalvintas naudojant 2025 m. ortofotografiją, o tai reiškia, kad kiekvienam taškui priskirta RGB vertė iš atitinkamo ortofotografijoje esančio pikselio. (Ortofotografijos data: 2025 m. gegužės 20 ir 31 d., birželio 15 d. ir liepos 1 d.)"},{"@language":"lv-t-sv-t0-mtec","@value":"Lāzera punktu mākoņi no 2025. gada lidojuma. Aptver visu Stokholmas pašvaldību, tostarp apkārt esošo buferzonu. Datnes formāts: LAS un POD. Lidojuma absolūtais augstums: Pieturzīmju blīvums: 16 pkt/m² Lidojuma datums: 2025. gada 1.–3. aprīlis. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000. Augstuma precizitāte ir 9 cm vai labāka cietām virsmām un 15 cm vai labāka citām virsmām. Lidmašīnās precizitāte ir 15 cm vai labāka. Zemes klasifikācija tiek kontrolēta manuāli, savukārt ēku klasifikācija ir pilnībā automātiska un var būt dažādas kvalitātes. Lāzera datu klasifikācija ir sadalīta šādās klasēs: 1 (neklasificēts); 2 (Marka); 6 (Ēka); 7 (Augsts un zems punkts, tā sauktais troksnis); 9 (Ūdens); 17 (Broar). Punktu mākonis ir krāsots, izmantojot 2025. gada ortofoto, kas nozīmē, ka katram punktam ir piešķirta RGB vērtība no atbilstošā pikseļa ortofoto. (Ortofotoattēla uzņemšanas datums: 2025. gada 20. un 31. maijā, 15. jūnijā un 1. jūlijā)"},{"@language":"mt-t-sv-t0-mtec","@value":"Sħubiji ta’ punti tal-laser mit-titjira 2025. Tkopri l-muniċipalità kollha ta’ Stokkolma inkluża ż-żona ta’ lqugħ madwarha. Format tal-fajl: il-LAS u l-POD. L-altitudni tat-titjira: Densità tal-punteġġjatura: 16 pkt/m² Data tat-titjira: l-1 u t-3 ta’ April 2025. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000. L-akkuratezza fl-għoli hija 9 cm jew aħjar għal uċuħ ibsin u 15 cm jew aħjar għal uċuħ oħra. Fil-pjan, il-preċiżjoni hija 15 cm jew aħjar. Il-klassifikazzjoni tal-art hija kkontrollata manwalment filwaqt li l-klassifikazzjoni tal-bini hija kompletament awtomatika u tista’ tkun ta’ kwalità li tvarja. Il-klassifikazzjoni tad-data tal-laser hija maqsuma fil-klassijiet li ġejjin: 1 (Mhux klassifikat); 2 (Mark); 6 (Bini); 7 (L-hekk imsejjaħ storbju b’punti għoljin u baxxi); 9 (Ilma); 17 (Broar). Is-sħaba tal-punt ġiet ikkulurita bl-użu tal-ortofoto tal-2025, li jfisser li kull punt ġie assenjat valur RGB mill-pixel korrispondenti fl-ortofoto. (Data tal-fotografija tal-ortofoto: l-20 u l-31 ta’ Mejju, il-15 ta’ Ġunju u l-1 ta’ Lulju 2025)"},{"@language":"nl-t-sv-t0-mtec","@value":"Laserpuntwolken vanaf vlucht 2025. Dekt de hele gemeente Stockholm incl bufferzone rond. Bestandsformaat: LAS en POD. Vlieghoogte: Punctuatiedichtheid: 16 pkt/m² Vluchtdatum: 1-3 april 2025. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000. De nauwkeurigheid in hoogte is 9 cm of beter voor harde oppervlakken en 15 cm of beter voor andere oppervlakken. In vliegtuigen is de nauwkeurigheid 15 cm of beter. De indeling van de grond wordt handmatig geregeld, terwijl de indeling van het gebouw volledig automatisch is en van verschillende kwaliteit kan zijn. De classificatie van lasergegevens is onderverdeeld in de volgende klassen: 1 (niet-geclassificeerd); 2 (Markt); 6 (Gebouw); 7 (Hoge en lage punten zogenaamde ruis); 9 (water); 17 (Broar). De puntenwolk is gekleurd met behulp van de orthofoto 2025, wat betekent dat elk punt een RGB-waarde heeft gekregen van de overeenkomstige pixel in de orthofoto. (Fotografie datum van de orthofoto: 20 en 31 mei, 15 juni en 1 juli 2025)"},{"@language":"pl-t-sv-t0-mtec","@value":"Laserowe chmury punktów z lotu 2025. Obejmuje całą gminę Sztokholm, w tym strefę buforową wokół. Format pliku: LAS i POD. Wysokość bezwzględna lotu: Gęstość interpunkcyjna: 16 pkt/m² Data lotu: 1–3 kwietnia 2025 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000. Dokładność wysokości wynosi 9 cm lub lepiej dla twardych powierzchni i 15 cm lub lepiej dla innych powierzchni. W samolotach dokładność wynosi 15 cm lub więcej. Klasyfikacja gruntów jest kontrolowana ręcznie, podczas gdy klasyfikacja budynków jest w pełni automatyczna i może mieć różną jakość. Klasyfikacja danych laserowych podzielona jest na następujące klasy: 1 (bez klauzuli tajności); 2 (znak); 6 (Budynek); 7 (punkty wysokie i niskie, tzw. hałas); 9 (woda); 17 (Broar) (ang.). Chmura punktów została zabarwiona za pomocą ortofotomapy 2025, co oznacza, że każdemu punktowi przypisano wartość RGB z odpowiedniego piksela na ortofotomapie. (Data zdjęcia ortofotomapy: 20 i 31 maja, 15 czerwca i 1 lipca 2025 r.)"},{"@language":"pt-t-sv-t0-mtec","@value":"Nuvens de ponto laser do voo 2025. Abrange todo o município de Estocolmo, incluindo a zona tampão circundante. Formato do ficheiro: LAS e POD. Altitude de voo: Densidade de pontuação: 16 pkt/m² Data do voo: 1-3 de abril de 2025. Sistema de referência no plano: Sweref 991800, em altura: RH2000 (em inglês). A precisão na altura é 9 cm ou melhor para superfícies duras e 15 cm ou melhor para outras superfícies. Em aviões, a precisão é de 15 cm ou melhor. A classificação do terreno é controlada manualmente, enquanto a classificação do edifício é totalmente automática e pode ser de qualidade variável. A classificação dos dados a laser é dividida nas seguintes classes: 1 (Não classificado); 2 (Marca); 6 (Edifício); 7 (pontos altos e baixos, denominados ruídos); 9 (Água); 17 (Broar) (em inglês). A nuvem de pontos foi colorida usando a ortofotografia 2025, o que significa que a cada ponto foi atribuído um valor RGB a partir do pixel correspondente na ortofotografia. (Data da fotografia da ortofotografia: 20 e 31 de maio, 15 de junho e 1 de julho de 2025)"},{"@language":"ro-t-sv-t0-mtec","@value":"Nori de puncte laser de la zborul 2025. Acoperă întreaga municipalitate Stockholm, inclusiv zona tampon din jur. Formatul fișierului: LAS și POD. Altitudinea de zbor: Densitatea de punctuație: 16 pkt/m² Data zborului: 1-3 aprilie 2025. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000. Precizia în înălțime este de 9 cm sau mai bună pentru suprafețele dure și de 15 cm sau mai bună pentru alte suprafețe. În avioane, precizia este de 15 cm sau mai bună. Clasificarea terenului este controlată manual, în timp ce clasificarea clădirii este complet automată și poate fi de calitate diferită. Clasificarea datelor laser este împărțită în următoarele clase: 1 (neclasificată); 2 (marcă); 6 (clădire); 7 (puncte înalte și joase, așa-numitele zgomote); 9 (Apă); 17 (Groar). Norul de puncte a fost colorat folosind ortofoto 2025, ceea ce înseamnă că fiecărui punct i s-a atribuit o valoare RGB de la pixelul corespunzător din ortofoto. (Data fotografiei ortofoto: 20 și 31 mai, 15 iunie și 1 iulie 2025)"},{"@language":"sk-t-sv-t0-mtec","@value":"Laserové bodové oblaky z letu 2025. Zahŕňa celú obec Štokholm vrátane nárazníkovej zóny v okolí. Formát súboru: LAS a POD. Letová nadmorská výška: Hustota prerušovania: 16 pkt/m² Dátum letu: 3. apríla 2025. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000. Presnosť výšky je 9 cm alebo lepšia pre tvrdé povrchy a 15 cm alebo lepšia pre iné povrchy. V lietadlách je presnosť 15 cm alebo lepšia. Klasifikácia pozemkov sa kontroluje manuálne, zatiaľ čo klasifikácia budov je plne automatická a môže mať rôznu kvalitu. Klasifikácia laserových dát je rozdelená do nasledujúcich tried: 1 (neutajované); 2 (Mark); 6 (budova); 7 (vysoké a nízke body, tzv. hluk); 9 (voda); 17 (Broar). Bodový oblak bol zafarbený pomocou ortofotografie 2025, čo znamená, že každému bodu bola priradená hodnota RGB zo zodpovedajúceho pixelu v ortofotografii. (Dátum ortofotografie: a 31. mája, 15. júna a 1. júla 2025)"},{"@language":"sl-t-sv-t0-mtec","@value":"Laserski oblaki točk iz leta 2025. Zajema celotno občino Stockholm, vključno z varovalnim pasom. Oblika datoteke: LAS in POD. nadmorska višina leta: Gostota ločil: 16 pkt/m² Datum leta: in 3. aprila 2025. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000. Natančnost višine je 9 cm ali boljša za trde površine in 15 cm ali boljša za druge površine. V ravninah je natančnost 15 cm ali boljša. Klasifikacija zemljišč se upravlja ročno, medtem ko je klasifikacija stavb popolnoma samodejna in je lahko različne kakovosti. Klasifikacija laserskih podatkov je razdeljena na naslednje razrede: 1 (nerazvrščeno); 2 (oznaka); 6 (Gradnja); 7 (visoke in nizke točke, tako imenovani hrup); 9 (voda); 17 (Broar) (angleščina). Oblak točk je bil obarvan z ortofoto posnetkom 2025, kar pomeni, da je bila vsaki točki dodeljena vrednost RGB iz ustrezne slikovne pike v ortofoto posnetku. (Fotografski datum ortofoto posnetka: in 31. maja, 15. junija in 1. julija 2025)"},{"@language":"sv","@value":"Laserpunktmoln från flygning 2025. Täcker hela Stockholms kommun inkl buffertzon runt. Filformat: LAS och POD. Flyghöjd: Punkttäthet: 16 pkt/m² Flygdatum: 1-3 april 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000. Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre. Markklassificeringen är manuellt kontrollerad medan byggnadsklassningen är helt automatiskt utförd och kan vara av varierande kvalitet. Klassning av laserdata delas upp i följande klasser: 1 (Oklassificerat); 2 (Mark); 6 (Byggnad); 7 (Hög- och Lågpunkter sk. brus); 9 (Vatten); 17 (Broar). Punktmolnet har färgsatts med hjälp av ortofotot från 2025, vilket innebär att varje punkt har tilldelats ett RGB-värde från motsvarande pixel i ortofotot. (Fotograferingsdatum för ortofotot: 20 och 31 maj, 15 juni och 1 juli 2025)"},{"@language":"uk-t-sv-t0-mtec","@value":"Лазерна точкова хмара з польоту 2025 року. Охоплює весь муніципалітет Стокгольма, включаючи буферну зону навколо. Формат файлу: LAS і POD. Висота польоту: Щільність пунктуації: * 16 pkt/m² Дата польоту: 1-3 квітня 2025 року. Референтна система в плані: Свереф 991800, по висоті: RH2000 (англ.). Точність по висоті становить 9 см або краще для твердих поверхонь і 15 см або краще для інших поверхонь. У площинах точність становить 15 см або краще. Класифікація земель контролюється вручну, а класифікація будівель повністю автоматична і може бути різної якості. Класифікація лазерних даних поділяється на наступні класи: 1 (некласифікований); 2 (марка); 6 (будівництво); 7 (високі і низькі точки так званого шуму); 9 (вода); 17 (заборонений). Хмара точок була забарвлена за допомогою ортофотоплану 2025 року, що означає, що кожній точці було присвоєно значення RGB з відповідного пікселя ортофотоплану. (Дата фотозйомки ортофотоплану: 20 та 31 травня, 15 червня та 1 липня 2025 року)"}],"dct:format":"text/html","dct:identifier":"c2c5f260-2da1-45ff-98ce-29b621e09242","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5d3f8f97b9275762e210809ab8e0c92be30da1db8fa616d6c5be9ac4ef423ef9_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Point Cloud - Лазерно сканиране във въздуха (2025 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Point Cloud - Letecké laserové skenování (2025)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Point Cloud - luftbåren laserscanning (2025)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Point Cloud - Luftgestütztes Laserscanning (2025)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Point Cloud - Αερομεταφερόμενη σάρωση με λέιζερ (2025)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2025)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Point Cloud - Escaneo láser aerotransportado (2025)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Point Cloud - Õhus olev laserskaneerimine (2025)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2025)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Point Cloud - Numérisation laser aéroportée (2025)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Point Cloud - Scanadh Léasair Aerbheirthe (2025)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Point Cloud - Zrakoplovno lasersko skeniranje (2025.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne lézeres szkennelés (2025)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Point Cloud - Scansione laser aviotrasportata (2025)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Point Cloud - Lazerinis skenavimas ore (2025 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Point Cloud - Lāzerskenēšana no gaisa (2025)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Punt Cloud - Skannjar tal-Laser tal-Ajru (2025)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Point Cloud - Laserscannen in de lucht (2025)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Point Cloud - Skanowanie laserowe w powietrzu (2025)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Point Cloud - Varredura a laser no ar (2025)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Point Cloud - Scanare cu laser în aer (2025)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Point Cloud - letecké laserové skenovanie (2025)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Point Cloud - lasersko skeniranje v zraku (2025)"},{"@language":"sv","@value":"SBK Punktmoln - flygburen laserskanning (2025)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Point Cloud - Повітряне лазерне сканування (2025)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/3821d4a0-868b-4223-8b7b-24fd60b5f22e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_Punktmoln.pdf"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Information:Produktspecfikation/2","dct:title":["Produktspecifikation",{"@language":"bg-t-sv-t0-mtec","@value":"Спецификация на продукта"},{"@languag