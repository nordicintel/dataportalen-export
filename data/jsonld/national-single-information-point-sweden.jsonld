ckholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/10"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/3"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/4"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/5"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/9"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=453cca6f-29bd-4556-aa64-4dd12abc77a1"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Stockholmskartorna är en blandning av översiktskartorna Stadskartan (skala 1:4000) och Tätortskartan (skala 1:15000) där innehållet har anpassats så att man bekvämt kan zooma i kartan i ett stort skalintervall. Den nedtonade färgsättningen gör Stockholmskartorna lämpliga som bakgrund när annan information ska presenteras med mer framträdande färgsättning.Stockholmskartorna innehåller t ex bebyggelseområden, byggnader, anläggningar, vägar, vägnamn, GC-vägar, spårnät och grönområden.Gällande WMS-tjänsterna: applikationer som implementerar WMS Tiling Client Recommendation rekommenderas att använda den tilade WMS-tjänsten."},"dct:identifier":"d5120658-cada-4216-8af2-c82bad8ab91f","dct:issued":{"@type":"xsd:date","@value":"2014-03-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:69cef053c28e0e710444412d2a3aa534668af992b3e485952d28e5d766fc3b4d_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Stockholmskarta (flera varianter) (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/10","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se:80/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_SVART?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta (grå/svart)"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_FORENKLAD?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta (grå förenklad - Tilad)"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_FORENKLAD_RASTER?"},"dct:description":"WMS","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta (grå förenklad - Ej tiled)"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_FORENKLAD_NT"},"dct:description":"WMS - Tiled","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta  (grå förenklad nedtonad - tiled)"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_FORENKLAD_NT_RASTER"},"dct:description":"WMS - Ej Tiled","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta (grå förenklad nedtonad - ej tilad)"},{"@id":"https://resources.stockholm.se/data/d5120658-cada-4216-8af2-c82bad8ab91f#HTTP:OGC:WMS/9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_STOCKHOLMSKARTA_GRA_FORENKLAD?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Stockholmskarta (grå förenklad - Tilad)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":