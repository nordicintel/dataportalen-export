 tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b3n0"},{"@id":"_:d9a2f7ebf6edc39fc67d824341aa599c51a7cb212f33b1a6755e1b9e89bb9aad_b4n0"}],"http://www.w3.org/2