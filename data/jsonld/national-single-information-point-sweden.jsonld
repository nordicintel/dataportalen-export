pe":"xsd:date","@value":"2021-12-31"},"dct:description":{"@language":"sv","@value":"Punktskikt med bilpoolsstationer från 2021-2024. Fasta parkeringsplatser för stationära bilpooler (och i den mån friflytande bilpooler även har fasta parkeringsplatser). Visar adress och bilpoolsoperatör som har en eller flera bilar på aktuell plats. Underlaget bygger på uppgifter från bilpoolsoperatörerna själva. Sammanställt av Sweco på uppdrag av miljöförvaltningen."},"dct:identifier":"1e2d37d6-1bbe-4c51-b182-f03854c13a9c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f055d72725890c0c6d021655da9aad62bc28f6ef97be663260202b03d737730d_b0n0"},"dct:title":{"@language":"sv","@value":"Bilpooler 2021-2024"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/f9b5d141c1694ceb827cf335be9bedd0_9/explore"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens Öppna data-hub"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockhol