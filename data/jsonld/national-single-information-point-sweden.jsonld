ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/3038c227-c37e-4f2f-bbd9-2521cf75e697"}},{"@id":"http://data.europa.eu/88u/distribution/e3f03584-c965-4864-b862-d12fc2df2558","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2016"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/5","dct:title":["WMS-tjänst Ortofoto 2016",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2016"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2016"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2016"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2016"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2016"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2016"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2016"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2016"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2016"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2016"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2016"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2016"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2016"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2016"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2016"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2016"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2016"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS service Ortofoto 2016"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2016"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2016"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2016"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2016"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2016"},{"@language":"uk-t-sv-t0-mtec","@value":"WMS сервіс Ortofoto 2016"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/e3f03584-c965-4864-b862-d12fc2df2558"}},{"@id":"http://data.europa.eu/88u/record/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1301cb35-2201-4273-83ce-915fb64a453c"},{"@id":"http://data.europa.eu/88u/distribution/3038c227-c37e-4f2f-bbd9-2521cf75e697"},{"@id":"http://data.europa.eu/88u/distribution/e3f03584-c965-4864-b862-d12fc2df2558"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:04Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:48Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:48Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c"},{"@graph":[{"@id":"_:11a20c0f7feced42acdd95de23074d9e89cfbb0666ad3d990f78ad3878404a77_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:11a20c0f7feced42acdd95de23074d9e89cfbb0666ad3d990f78ad3878404a77_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"f1ec46c2bf60c7c056b192db177eba9cc"},{"@id":"http://data.europa.eu/88u/dataset/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/ff7c56b4-b97c-4a9b-bd9f-14f5b19eb34b"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5261a2f3-f2f7-4bce-a384-aa7c1e290d21"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-12-28"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Съдържа GeoTIFF прекъсва височината на абсолютната височина на короната на дървото (метри над морското равнище) в рамките на град Стокхолм. Файловете се създават от лазерни точкови облачни данни с помощта на софтуер Terrascan. Различни скриптове са изпълнявани на лазерни точки 1. точковите облачни данни са класифицирани според това дали принадлежат към земя, сгради / мостове и други 2. След това, с помощта на различни скриптове, са избрани обекти, които приличат на дървета. 3. Износ на 50 см разтворен растерен модел с максимална височина в рамките на 50 см пиксел. Група 0 показва стойността на височината на пиксела, закръглена до най-близкия метър (m) в системата за височина RH2000 без десетични знаци. Използваните лазерни данни са от 2022 г."},{"@language":"cs-t-sv-t0-mtec","@value":"GeoTIFF přerušuje absolutní výšku koruny stromu (metry nad hladinou moře) ve městě Stockholm. Soubory jsou vytvářeny z laserových cloudových dat pomocí softwaru Terrascan. Na laserových bodech byly spuštěny různé skripty 1. Data z bodového oblaku byla klasifikována podle toho, zda patří k pozemkům, budovám/mostům a dalším 2. Poté pomocí různých skriptů vyberte objekty, které se podobají stromům. 3. Export 50cm rozpuštěného rastrového modelu s maximální výškou v rámci 50cm pixelu. Pásmo 0 označuje hodnotu výšky pixelu zaokrouhlenou na nejbližší metr (m) ve výškovém systému RH2000 bez desetinných míst. Použitá laserová data jsou z roku 2022."},{"@language":"da-t-sv-t0-mtec","@value":"Indeholder GeoTIFF bryder højden af trækronen absolut højde (meter over havets overflade) i Stockholm. Filer oprettes ud fra laserpunktskydata ved hjælp af Terrascan-software. Forskellige scripts er blevet kørt på laserpunkter 1. punkt cloud data er blevet klassificeret efter, om de tilhører jord, bygninger / broer og andre 2. Derefter, ved hjælp af forskellige scripts, har valgt objekter, der ligner træer. 3. Eksport af 50cm opløst raster model med maksimal højde inden for 50cm pixel. Bånd 0 angiver pixelens højdeværdi afrundet til nærmeste meter (m) i højdesystemet RH2000 uden decimaler. De anvendte laserdata er fra 2022."},{"@language":"de-t-sv-t0-mtec","@value":"GeoTIFF bricht die absolute Höhe der Baumkrone (Meter über dem Meeresspiegel) innerhalb der Stadt Stockholm. Dateien werden aus Laserpunktwolkendaten mit der Terrascan-Software erstellt. Auf Laserpunkten wurden verschiedene Skripte ausgeführt 1. Punktwolkendaten wurden klassifiziert, je nachdem, ob sie zu Land, Gebäuden/Brücken und anderen gehören. Dann haben Sie mit Hilfe verschiedener Skripte Objekte ausgewählt, die Bäumen ähneln. 3. Export von 50cm aufgelöstem Rastermodell mit maximaler Höhe innerhalb des 50cm Pixels. Band 0 gibt den Höhenwert des auf den nächsten Meter (m) gerundeten Pixels im Höhensystem RH2000 ohne Dezimalstellen an. Die verwendeten Laserdaten stammen aus dem Jahr 2022."},{"@language":"el-t-sv-t0-mtec","@value":"Περιέχει GeoTIFF σπάει το ύψος του δέντρου στέμμα απόλυτο ύψος (μέτρα πάνω από τη στάθμη της θάλασσας) εντός της πόλης της Στοκχόλμης. Τα αρχεία δημιουργούνται από δεδομένα cloud σημείου λέιζερ χρησιμοποιώντας το λογισμικό Terrascan. Διαφορετικές δέσμες ενεργειών έχουν εκτελεστεί σε σημεία λέιζερ 1. Τα δεδομένα υπολογιστικού νέφους σημείου έχουν ταξινομηθεί ανάλογα με το αν ανήκουν σε γη, κτίρια/γέφυρες και άλλα 2. Στη συνέχεια, με τη βοήθεια διαφόρων σεναρίων, έχουν επιλέξει αντικείμενα που μοιάζουν με δέντρα. 3. Εξαγωγή διαλυμένου μοντέλου ράστερ 50cm με μέγιστο ύψος εντός του εικονοστοιχείου 50cm. Η ζώνη 0 δηλώνει την τιμή ύψους του εικονοστοιχείου στρογγυλοποιημένη στον πλησιέστερο μετρητή (m) στο σύστημα ύψους RH2000 χωρίς δεκαδικά ψηφία. Τα δεδομένα λέιζερ που χρησιμοποιούνται είναι από το 2022."},{"@language":"en-t-sv-t0-mtec","@value":"Contains GeoTIFF breaks the height of the tree crown absolute height (meters above sea level) within the City of Stockholm. Files are created from laser point cloud data using Terrascan software. Different scripts have been run on laser points 1. point cloud data has been classified according to whether they belong to land, buildings/bridges and other 2. Then, with the help of various scripts, have selected objects that resemble trees. 3. Export of 50cm dissolved raster model with maximum height within the 50cm pixel. Band 0 indicates the height value of the pixel rounded to the nearest meter (m) in the height system RH2000 without decimals. The laser data used is from 2022."},{"@language":"es-t-sv-t0-mtec","@value":"GeoTIFF rompe la altura absoluta de la copa del árbol (metros sobre el nivel del mar) dentro de la ciudad de Estocolmo. Los archivos se crean a partir de datos de nube de puntos láser utilizando el software Terrascan. Se han ejecutado diferentes scripts en los puntos láser 1. Los datos de nube de puntos se han clasificado según si pertenecen a terrenos, edificios / puentes y otros 2. Luego, con la ayuda de varios scripts, ha seleccionado objetos que se asemejan a árboles. 3. Exportación de modelo rasterizado disuelto de 50cm con altura máxima dentro del píxel de 50cm. La banda 0 indica el valor de altura del píxel redondeado al metro más cercano (m) en el sistema de altura RH2000 sin decimales. Los datos láser utilizados son de 2022."},{"@language":"et-t-sv-t0-mtec","@value":"Sisaldab GeoTIFFi, mis purustab puuvõra absoluutse kõrguse (meetrites merepinnast) Stockholmi linnas. Failid luuakse laserpunktpilve andmetest Terrascani tarkvara abil. Laserpunktides on kasutatud erinevaid skripte 1. punktpilve andmed on klassifitseeritud vastavalt sellele, kas need kuuluvad maale, hoonetele/sildadele ja muudele 2. Seejärel on erinevate skriptide abil valitud objektid, mis meenutavad puid. 3. 50 cm lahustunud rastermudeli eksport maksimaalse kõrgusega 50 cm piksli piires. Rida 0 näitab kõrgusesüsteemis RH2000 piksli kõrguse väärtust ilma kümnendkohtadeta, ümardatuna lähima meetrini (m). Kasutatavad laserandmed pärinevad 2022. aastast."},{"@language":"fi-t-sv-t0-mtec","@value":"GeoTIFF rikkoo puun latvuksen absoluuttisen korkeuden (metriä merenpinnan yläpuolella) Tukholman kaupungissa. Tiedostot luodaan laserpistepilvidatasta Terrascan-ohjelmistolla. Laserpisteille on ajettu erilaisia komentosarjoja 1. pistepilvitiedot on luokiteltu sen mukaan, kuuluvatko ne maahan, rakennuksiin / siltoihin ja muihin 2. Sitten, avulla eri käsikirjoituksia, on valittu esineitä, jotka muistuttavat puita. 3. Vie 50 cm liuennutta rasterimallia, jonka enimmäiskorkeus on 50 cm pikselin sisällä. Luokka 0 ilmaisee RH2000-korkeusjärjestelmän pikselin korkeusarvon pyöristettynä lähimpään metriin (m) ilman desimaaleja. Käytetyt lasertiedot ovat vuodelta 2022."},{"@language":"fr-t-sv-t0-mtec","@value":"Contient GeoTIFF brise la hauteur absolue de la cime des arbres (mètres au-dessus du niveau de la mer) dans la ville de Stockholm. Les fichiers sont créés à partir de données de nuage de points laser à l'aide du logiciel Terrascan. Différents scripts ont été exécutés sur des points laser 1. les données de nuages de points ont été classées selon qu'elles appartiennent à des terrains, à des bâtiments/ponts et à d'autres 2. Ensuite, à l'aide de différents scripts, sélectionnez des objets qui ressemblent à des arbres. 3. Exportation du modèle de raster dissous de 50cm avec une hauteur maximale dans le pixel de 50cm. La bande 0 indique la valeur de hauteur du pixel arrondi au mètre le plus proche (m) dans le système de hauteur RH2000 sans décimales. Les données laser utilisées datent de 2022."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá GeoTIFF bhriseann an airde an airde an choróin crann airde absalóideach (méadair os cionn leibhéal na farraige) laistigh de Chathair Stócólm. Cruthaítear comhaid ó shonraí scamall pointe léasair ag baint úsáide as bogearraí Terrascan. Tá scripteanna éagsúla á reáchtáil ar phointí léasair 1. Tá sonraí scamall pointe aicmithe de réir cibé an mbaineann siad le talamh, foirgnimh / droichid agus eile 2. Ansin, le cabhair ó scripteanna éagsúla, roghnaigh rudaí atá cosúil le crainn. 3. Easpórtáil múnla raster tuaslagtha 50cm le airde uasta laistigh den picteilín 50cm. Léiríonn banda 0 luach airde an phicteilín arna shlánú go dtí an méadar (m) is gaire sa chóras airde RH2000 gan deachúlacha. Is ó 2022 a úsáideadh na sonraí léasair."},{"@language":"hr-t-sv-t0-mtec","@value":"Sadrži GeoTIFF koji razbija visinu krošnje stabla apsolutne visine (metara iznad razine mora) unutar grada Stockholma. Datoteke se stvaraju iz podataka u oblaku laserske točke pomoću Terrascan softvera. Različiti skripte su pokrenuti na laserskim točkama 1. točka oblak podaci su klasificirani prema tome pripadaju li zemljište, zgrade / mostovi i druge 2. Zatim, uz pomoć različitih skripti, odabrali su objekte koji nalikuju drveću. 3. Izvoz modela rastera otopljenog na 50 cm s maksimalnom visinom unutar piksela od 50 cm. Raspon 0 označava vrijednost visine piksela zaokruženu na najbliži metar (m) u sustavu visine RH2000 bez decimala. Upotrijebljeni laserski podaci su iz 2022. godine."},{"@language":"hu-t-sv-t0-mtec","@value":"Tartalmazza GeoTIFF megtöri a magassága a fa korona abszolút magassága (méter tengerszint feletti) a város Stockholm. A fájlok lézerpontos felhőadatokból készülnek a Terrascan szoftver segítségével. A lézerpontokon különböző szkriptek futtak 1. a pontfelhő adatokat aszerint osztályozták, hogy földhöz, épületekhez/hidakhoz és egyéb 2. Ezután különböző szkriptek segítségével kiválasztottak olyan objektumokat, amelyek hasonlítanak a fákra. 3. 50 cm-es oldott raszteres modell exportálása, melynek maximális magassága az 50 cm-es pixelen belül van. A 0 sáv az RH2000 magasságrendszerben a képpont magasságának a legközelebbi méterre (m) kerekített értékét jelöli tizedesjegyek nélkül. A felhasznált lézeradatok 2022-ből származnak."},{"@language":"it-t-sv-t0-mtec","@value":"Contiene GeoTIFF rompe l'altezza della corona dell'albero altezza assoluta (metri sul livello del mare) all'interno della città di Stoccolma. I file vengono creati dai dati della nuvola di punti laser utilizzando il software Terrascan. Sono stati eseguiti diversi script su punti laser 1. I dati delle nuvole di punti sono stati classificati in base al fatto che appartengano a terreni, edifici / ponti e altri 2. Quindi, con l'aiuto di vari script, hanno selezionato oggetti che assomigliano ad alberi. 3. Esportazione del modello raster disciolto da 50 cm con altezza massima all'interno del pixel da 50 cm. La banda 0 indica il valore in altezza del pixel arrotondato al metro (m) più vicino nel sistema di altezza RH2000 senza decimali. I dati laser utilizzati sono del 2022."},{"@language":"lt-t-sv-t0-mtec","@value":"Sudėtyje yra GeoTIFF pertraukia medžio lajos absoliutų aukštį (metrai virš jūros lygio) Stokholmo mieste. Failai yra sukurti iš lazerio taško debesies duomenų, naudojant \"Terrascan\" programinę įrangą. Įvairūs scenarijai buvo paleisti lazerio taškuose 1. Taškų debesies duomenys buvo klasifikuojami pagal tai, ar jie priklauso žemei, pastatams / tiltams ir kitiems 2. Tada, naudodami įvairius scenarijus, pasirinko objektus, panašius į medžius. 3. Eksportuojamas 50 cm ištirpusio rastro modelis, kurio didžiausias aukštis neviršija 50 cm pikselių. 0 juosta rodo pikselio aukščio vertę, suapvalintą iki artimiausio metro (m), aukščio sistemoje RH2000 be dešimtainių skaičių. Naudojami 2022 m. lazeriniai duomenys."},{"@language":"lv-t-sv-t0-mtec","@value":"Satur GeoTIFF pārtrauc koka vainaga absolūto augstumu (metrus virs jūras līmeņa) Stokholmas pilsētā. Faili tiek izveidoti no lāzera punktu mākoņa datiem, izmantojot Terrascan programmatūru. Lāzera punktos ir darbināti dažādi skripti 1. punkta mākoņdatošanas dati ir klasificēti atkarībā no tā, vai tie pieder zemei, ēkām/tiltiem un citiem 2. Tad, izmantojot dažādus skriptus, ir izvēlējušies objektus, kas atgādina kokus. 3. 50 cm izšķīdušā rastra modeļa eksports ar maksimālo augstumu 50 cm pikseļa robežās. Josla 0 norāda pikseļa augstuma vērtību, kas noapaļota līdz tuvākajam metram (m) augstuma sistēmā RH2000 bez decimāldaļām. Izmantotie lāzera dati ir no 2022. gada."},{"@language":"mt-t-sv-t0-mtec","@value":"Fih GeoTIFF jikser l-għoli tal-quċċata tas-siġra għoli assolut (metri 'l fuq mil-livell tal-baħar) fil-Belt ta' Stokkolma. Il-fajls huma maħluqa minn data sħaba punt laser bl-użu ta' softwer Terrascan. Tħaddmu skripts differenti fuq punti tal-laser 1. punt tad-data sħaba ġiet ikklassifikata skont jekk jappartjenux għal art, bini/pontijiet u oħrajn 2. Imbagħad, bl-għajnuna ta 'diversi skripts, għażlu oġġetti li jixbhu s-siġar. 3. Esportazzjoni ta’ mudell ta’ raster maħlul ta’ 50 cm b’għoli massimu fi ħdan il-pixel ta’ 50 cm. Il-banda 0 tindika l-valur tal-għoli tal-pixel imqarreb għall-eqreb metru (m) fis-sistema tal-għoli RH2000 mingħajr deċimali. Id-data tal-laser użata hija mill-2022."},{"@language":"nl-t-sv-t0-mtec","@value":"Bevat GeoTIFF breekt de hoogte van de boomkroon absolute hoogte (meters boven zeeniveau) binnen de stad Stockholm. Bestanden worden gemaakt van laserpoint cloud data met behulp van Terrascan software. Verschillende scripts zijn uitgevoerd op laserpunten 1. puntwolkgegevens zijn geclassificeerd op basis van of ze behoren tot grond, gebouwen / bruggen en andere 2. Vervolgens hebben we met behulp van verschillende scripts objecten geselecteerd die op bomen lijken. 3. Export van 50cm opgelost rastermodel met maximale hoogte binnen de 50cm pixel. Band 0 geeft de hoogtewaarde van de pixel aan, afgerond op de dichtstbijzijnde meter (m) in het hoogtesysteem RH2000 zonder decimalen. De gebruikte lasergegevens zijn afkomstig uit 2022."},{"@language":"pl-t-sv-t0-mtec","@value":"Zawiera GeoTIFF łamie wysokość korony drzewa bezwzględną wysokość (metry nad poziomem morza) w mieście Sztokholm. Pliki są tworzone z danych chmury punktów laserowych za pomocą oprogramowania Terrascan. Różne skrypty zostały uruchomione na punktach laserowych 1. dane chmury punktów zostały sklasyfikowane w zależności od tego, czy należą do gruntów, budynków / mostów i innych 2. Następnie, za pomocą różnych skryptów, wybrano obiekty, które przypominają drzewa. 3. Eksport 50cm rozpuszczonego modelu rastrowego o maksymalnej wysokości w obrębie 50cm piksela. Pasmo 0 oznacza wartość wysokości piksela zaokrągloną do najbliższego metra (m) w systemie wysokości RH2000 bez miejsc po przecinku. Wykorzystane dane laserowe pochodzą z 2022 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Contém GeoTIFF quebra a altura absoluta da copa da árvore (metros acima do nível do mar) dentro da cidade de Estocolmo. Os arquivos são criados a partir de dados de nuvem de ponto laser usando o software Terrascan. Foram executados diferentes scripts em pontos laser 1. Os dados da nuvem de pontos foram classificados de acordo com se pertencem a terrenos, edifícios/pontes e outros 2. Depois, com a ajuda de vários scripts, selecionaram objetos que se assemelham a árvores. 3. Exportação de modelo raster dissolvido de 50cm com altura máxima dentro do pixel de 50cm. Banda 0 indica o valor de altura do pixel arredondado para o metro mais próximo (m) no sistema de altura RH2000 sem decimais. Os dados a laser utilizados são de 2022."},{"@language":"ro-t-sv-t0-mtec","@value":"Conține GeoTIFF rupe înălțimea absolută a coroanei copacului (metri deasupra nivelului mării) în orașul Stockholm. Fișierele sunt create din date laser point cloud folosind software-ul Terrascan. Diferite scripturi au fost rulate pe puncte laser 1. date punct cloud a fost clasificat în funcție de faptul dacă acestea aparțin teren, clădiri / poduri și alte 2. Apoi, cu ajutorul diferitelor scripturi, au selectat obiecte care seamănă cu copacii. 3. Exportul modelului de raster dizolvat de 50 cm cu înălțimea maximă în pixelul de 50 cm. Banda 0 indică valoarea înălțimii pixelului rotunjită la cel mai apropiat metru (m) în sistemul de înălțime RH2000 fără zecimale. Datele laser utilizate sunt din 2022."},{"@language":"sk-t-sv-t0-mtec","@value":"Obsahuje GeoTIFF, ktorý prelomí absolútnu výšku koruny stromu (v metroch nad morom) v rámci mesta Štokholm. Súbory sa vytvárajú z cloudových dát laserového bodu pomocou softvéru Terrascan. Na laserových bodoch boli spustené rôzne skripty 1. Bodové cloudové dáta boli klasifikované podľa toho, či patria k pôde, budovám / mostom a iným 2. Potom pomocou rôznych skriptov vybrali objekty, ktoré sa podobajú stromom. 3. Export 50cm rozpusteného rastrového modelu s maximálnou výškou v rámci 50cm pixelu. Pásmo 0 označuje výškovú hodnotu pixelu zaokrúhlenú na najbližší meter (m) vo výškovom systéme RH2000 bez desatinných miest. Použité laserové údaje sú z roku 2022."},{"@language":"sl-t-sv-t0-mtec","@value":"Vsebuje GeoTIFF zlomi višino absolutne višine drevesne krošnje (v metrih nad morsko gladino) v mestu Stockholm. Datoteke so ustvarjene iz podatkov v oblaku laserskih točk s programsko opremo Terrascan. Na laserskih točkah so bili uporabljeni različni skripti 1. podatki v oblaku točk so bili razvrščeni glede na to, ali pripadajo zemljišču, stavbam/mostovom in drugim 2. Nato so s pomočjo različnih skript izbrali predmete, ki so podobni drevesom. 3. Izvoz 50 cm raztopljenega rastrskega modela z največjo višino znotraj 50 cm slikovne pike. Razpon 0 označuje vrednost višine slikovne pike, zaokrožene na najbližji meter (m) v sistemu višine RH2000 brez decimalk. Uporabljeni laserski podatki so iz leta 2022."},{"@language":"sv","@value":"Innehåller GeoTIFF raster höjden av trädkrona absolut höjd (meter över havet) inom Stockholms stad. Filer är framtagen från laserpunktmolnsdata med hjälp av mjukvaran Terrascan. Olika skript har körts på laserpunkter 1. punktmolnsdata har klassats efter om de tillhör mark, byggnader/broar och övrigt 2. Sedan har med hjälp av olika skript valt ut objekt som liknar träd. 3. Export av 50cm upplöste raster modell med högsta höjd inom den 50cm pixel. Band 0 anger höjdvärdet av pixeln avrundat till närmaste meter (m) i höjdsystemet RH2000 utan decimaler. Laserdata som användes är från 2022."},{"@language":"uk-t-sv-t0-mtec","@value":"Містить GeoTIFF порушує висоту крони дерева абсолютної висоти (метрів над рівнем моря) в межах міста Стокгольм. Файли створюються з даних хмари лазерної точки за допомогою програмного забезпечення Terrascan. Різні сценарії були запущені на лазерних точках 1. дані хмари точок були класифіковані відповідно до того, чи належать вони до землі, будівель / мостів та інших 2. Потім за допомогою різних скриптів виділили об'єкти, що нагадують дерева. 3. Експорт розпущеної растрової моделі 50 см з максимальною висотою в межах пікселя 50 см. Діапазон 0 позначає значення висоти пікселя, округленого до найближчого метра (м) в системі висоти RH2000 без десяткових знаків. Використовувані лазерні дані - з 2022 року."}],"dct:format":"text/html","dct:identifier":"b72ebce9-fbd7-4f80-9f8a-31efb8de0e43","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:11a20c0f7feced42acdd95de23074d9e89cfbb0666ad3d990f78ad3878404a77_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Дърво — Височина на короната на дървото — абсолютна височина 2022 г. (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Tree - Výška koruny stromu - absolutní výška 2022 (vnitřní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Træ - Trækronehøjde - absolut højde 2022 (intern SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Baum - Baumkronenhöhe - absolute Höhe 2022 (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Tree - Ύψος κορώνας δέντρου - απόλυτο ύψος 2022 (εσωτερικό SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Tree - Tree crown height - absolute height 2022 (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Tree - Altura de la copa del árbol - altura absoluta 2022 (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Tree - Puuvõra kõrgus - absoluutne kõrgus 2022 (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Tree - Puun latvuskorkeus - absoluuttinen korkeus 2022 (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Tree - Hauteur de la couronne de l'arbre - hauteur absolue 2022 (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Crann - Airde choróin na gcrann - dearbhairde 2022 (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Tree - Visina krošnje stabla - apsolutna visina 2022 (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Fa - Fa korona magassága - abszolút magasság 2022 (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"Albero SBK - Altezza corona albero - altezza assoluta 2022 (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Medis - Medžio karūnos aukštis - absoliutus aukštis 2022 (vidinis SBK)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Tree - Tree vainaga augstums - absolūtais augstums 2022 (iekšējais SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Siġra - Għoli tal-kuruna tas-siġra - għoli assolut 2022 (SBK intern)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Boom - Boomkroonhoogte - absolute hoogte 2022 (intern SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Tree - Wysokość korony drzewa - wysokość bezwzględna 2022 (wewnętrzna SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Tree - Altura da copa da árvore - altura absoluta 2022 (SBK interno)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Tree - Înălțimea coroanei copacilor - înălțimea absolută 2022 (SBK intern)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Tree - Výška koruny stromu - absolútna výška 2022 (vnútorná SBK)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Drevo - Višina drevesne krošnje - absolutna višina 2022 (notranja SBK)"},{"@language":"sv","@value":"SBK Träd - Trädkronehöjd - absolut höjd 2022 (internt SBK)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Tree - Висота крони дерева - абсолютна висота 2022 (внутрішня SBK)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/ff7c56b4-b97c-4a9b-bd9f-14f5b19eb34b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ff7c56b4-b97c-4a9b-bd9f-14f5b19eb34b"}},{"@id":"http://data.europa.eu/88u/record/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/ff7c56b4-b97c-4a9b-bd9f-14f5b19eb34b"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"b72ebce9-fbd7-4f80-9f8a-31efb8de0e43","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:28Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:53Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:11a20c0f7feced42acdd95de23074d9e89cfbb0666ad3d990f78ad3878404a77_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:53Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:11a20c0f7feced42acdd95de23074d9e89cfbb0666ad3d990f78ad3878404a77"},{"@graph":[{"@id":"_:11f0e0a07ec6c6f6de6624134296cf1a7ada7d71b3d9c07a295c98d7de6dc06f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:11f0e0a07ec6c6f6de6624134296cf1a7ada7d71b3d9c07a295c98d7de6dc06f_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a618751a027022da1a268c3fba8e94617"},{"@id":"http://data.europa.eu/88u/dataset/67d71b7f-b7fc-47ec-ad32-110df631a632","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5bdf0e2e-a21c-4de8-a35d-623c2094f8d8"},{"@id":"http://data.europa.eu/88u/distribution/c07ad620-01a5-432c-b282-7ac0c0becb48"},{"@id":"http://data.europa.eu/88u/distribution/cde2a4d0-314f-4458-8359-58c4b3aa0709"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=add986f7-9934-48ff-b3fc-b3d5b074aec8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1995-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени съвместно с други картови продукти.Резолюция: 16 см/пиксел в ортофото. Дата на снимката: април—май 1995 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 16 cm/pixel v ortofotosnímku. Datum pořízení fotografie: duben–květen 1995"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter.Resolution: 16 cm/pixel i ortofoto. Fotografiets dato: April-maj 1995"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie eignen sich auch zum Drucken und können zusammen mit anderen Kartenprodukten präsentiert werden.Auflösung: 16 cm/Pixel im Orthofoto. Fotodatum: April-Mai 1995"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών.Ψήφισμα: 16 cm/pixel σε ορθοφωτογραφία. Ημερομηνία φωτογραφίας: Απρίλιος-Μάιος 1995"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products.Resolution: 16 cm/pixel in orthophoto. Date of photograph: April-May 1995"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para imprimir y se pueden copresentar con otros productos de mapas.Resolución: 16 cm/píxel en ortofoto. Fecha de la fotografía: Abril-mayo de 1995"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega.Resolutsioon: 16 cm/piksel ortofotos. Foto kuupäev: Aprill–mai 1995"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen, ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa.Resolution: 16 cm/pikseli ortokuvassa. Valokuvauksen päivämäärä: Huhti-toukokuu 1995"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques.Résolution: 16 cm/pixel en orthophoto. Date de la photographie: Avril-mai 1995"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile.Réiteach: 16 cm/picteilín in orthophoto. Dáta an ghrianghraif: Aibreán-Bealtaine 1995"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim proizvodima na karti.Rezolucija: 16 cm/piksel u ortofotografiji. Datum fotografije: Travanj – svibanj 1995."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók.Felbontás: 16 cm/pixel ortofotóban. Fénykép dátuma: 1995. április–május"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono anche adatti per la stampa e possono essere co-presentati con altri prodotti cartografici.Risoluzione: 16 cm/pixel in ortofoto. Data della fotografia: aprile-maggio 1995"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais.Rezoliucija: 16 cm/pikselis ortofotografijoje. Fotografavimo data: 1995 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem.Rezolūcija: 16 cm/pikselis ortofoto. Fotogrāfijas datums: 1995. gada aprīlis–maijs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa.Riżoluzzjoni: 16 cm/pixel fl-ortofoto. Data tar-ritratt: April-Mejju 1995"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd.Resolutie: 16 cm/pixel in orthofoto. Datum van de foto: april-mei 1995"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być prezentowany razem z innymi produktami mapowymi. 16 cm/piksel w ortofotomapie. Data zdjęcia: kwiecień–maj 1995 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. São igualmente apropriados para a impressão e podem ser co-apresentados com outros produtos do mapa.Resolução: 16 cm/pixel em ortofotografia. Data da fotografia: Abril-Maio de 1995"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi prezentate împreună cu alte produse cartografice.Rezoluție: 16 cm/pixel în ortofotografie. Data fotografiei: aprilie-mai 1995"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 16 cm/pixel v ortofotografii. Dátum fotografie: apríl – máj 1995"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in jih je mogoče predstaviti skupaj z drugimi izdelki za zemljevide.Resolucija: 16 cm/piksel v ortofotu. Datum fotografiranja: april–maj 1995"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Upplösning: 16 cm/pixel i ortofoto. Fotograferingsdatum: april-maj 1995"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 16 см/піксель в ортофотоплані. Дата фотографії: Квітень-травень 1995 року"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"67d71b7f-b7fc-47ec-ad32-110df631a632","dct:issued":{"@type":"xsd:date","@value":"1996-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:11f0e0a07ec6c6f6de6624134296cf1a7ada7d71b3d9c07a295c98d7de6dc06f_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"СБК Ортофото (1995)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (1995) (hudební videoklip)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορθοφύτου (1995)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (1995.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (1995 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (1995) Sistēmas Prasības"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (1995) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (1995)"},{"@language":"sv","@value":"SBK Ortofoto (1995)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (SBK Orthofoto) (1995)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/5bdf0e2e-a21c-4de8-a35d-623c2094f8d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_1995"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst Ortofoto (1995)",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto (1995)"},{"@language":"cs-t-sv-t0-mtec","@value":"WMS služba Ortofoto (1995)"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjenesten Ortofoto (1995)"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto (1995)"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία Ορτοφότο (1995)"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto (1995)"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto (1995)"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto (1995)"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto (1995)"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto (1995)"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto (1995)"},{"@language":"hr-t-sv-t0-mtec","@value":"Usluga WMS-a Ortofoto (1995.)"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto (1995)"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto (1995)"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto (1995 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto (1995)"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tal-WMS Ortofoto (1995)"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS-dienst Ortofoto (1995)"},{"@language":"pl-t-sv-t0-mtec","@value":"Usługa WMS Ortofoto (1995)"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto (1995)"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto (1995)"},{"@language":"sk-t-sv-t0-mtec","@value":"WMS služba Ortofoto (1995)"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto (1995)"},{"@language":"uk-t-sv-t0-mtec","@value":"Сервіс WMS Ortofoto (1995)"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5bdf0e2e-a21c-4de8-a35d-623c2094f8d8"}},{"@id":"http://data.europa.eu/88u/distribution/c07ad620-01a5-432c-b282-7ac0c0becb48","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_1995"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/5","dct:title":["WMS-tjänst Ortofoto (1995)",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto (1995)"},{"@language":"cs-t-sv-t0-mtec","@value":"WMS služba Ortofoto (1995)"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjenesten Ortofoto (1995)"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto (1995)"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία Ορτοφότο (1995)"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto (1995)"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto (1995)"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto (1995)"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto (1995)"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto (1995)"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto (1995)"},{"@language":"hr-t-sv-t0-mtec","@value":"Usluga WMS-a Ortofoto (1995.)"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto (1995)"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto (1995)"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto (1995 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto (1995)"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tal-WMS Ortofoto (1995)"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS-dienst Ortofoto (1995)"},{"@language":"pl-t-sv-t0-mtec","@value":"Usługa WMS Ortofoto (1995)"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto (1995)"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto (1995)"},{"@language":"sk-t-sv-t0-mtec","@value":"WMS služba Ortofoto (1995)"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto (1995)"},{"@language":"uk-t-sv-t0-mtec","@value":"Сервіс WMS Ortofoto (1995)"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/c07ad620-01a5-432c-b282-7ac0c0becb48"}},{"@id":"http://data.europa.eu/88u/distribution/cde2a4d0-314f-4458-8359-58c4b3aa0709","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/cde2a4d0-314f-4458-8359-58c4b3aa0709"}},{"@id":"http://data.europa.eu/88u/record/67d71b7f-b7fc-47ec-ad32-110df631a632","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5bdf0e2e-a21c-4de8-a35d-623c2094f8d8"},{"@id":"http://data.europa.eu/88u/distribution/c07ad620-01a5-432c-b282-7ac0c0becb48"},{"@id":"http://data.europa.eu/88u/distribution/cde2a4d0-314f-4458-8359-58c4b3aa0709"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"67d71b7f-b7fc-47ec-ad32-110df631a632","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:03Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:48Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/67d71b7f-b7fc-47ec-ad32-110df631a632"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:11f0e0a07ec6c6f6de6624134296cf1a7ada7d71b3d9c07a295c98d7de6dc06f_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/67d71b7f-b7fc-47ec-ad32-110df631a632"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:02Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:48Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"67d71b7f-b7fc-47ec-ad32-110df631a632","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:11f0e0a07ec6c6f6de6624134296cf1a7ada7d71b3d9c07a295c98d7de6dc06f"},{"@graph":[{"@id":"_:1246f5adc0e7801db6f2baa45985ce79a04e70611e081a085eb940d4ca2ca7e9_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1246f5adc0e7801db6f2baa45985ce79a04e70611e081a085eb940d4ca2ca7e9_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"13191619b61f5a3355e8d2693e0b247244"},{"@id":"http://data.europa.eu/88u/dataset/9b134b5d-e20d-400c-96ec-5eb7b6612083","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/9ee313a6-4d8c-43d8-9142-c2eff868f948"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e29e30c2-ad2a-4d8e-a74b-d2e6ecd70274"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Картата на фокусните точки показва основните точки на Стокхолм в равнина и височина на фона на картата на Стокхолм Grey Gradient Down. Общо има около 25 000 основни точки в самолетите и 5000 на височина. Базовите точки се състоят от точки на свързване и полезни точки и те са показани с различни символи на картата. За точките на плана има и насочени удари, които показват кои точки са измерени и изравнени заедно. Базата данни с основни точки съдържа и вид точки, наречени природни СПИН. Те се използват само за подпомагане на блоковата триангулация на въздушни изображения и подобни приложения и не са равнопоставени с другите основни точки. Те са видими само в dpMap, а не във външни картографски продукти, за да не се рискува клиентите да ги използват като основни точки. Картата на фокусните точки се използва както вътрешно от администрациите на град Стокхолм, така и от външни клиенти, като строителни компании, проектанти и консултанти по измервания. Картата е достъпна в интернет, където потребителите също имат достъп до координирана информация и точкови скици. Като вътрешен потребител или клиент по договор, това се извършва чрез вход и като външен клиент срещу плащане с карта. Основните точки се измерват съгласно стандарта HMK (Handbook in Measurement and Map Questions, published by Lantmäteriet). В равнините е използвано измерване на партиди с обща станция и фино претегляне на височина за точки на свързване и общо балансиране за комунални точки. На разположение са и малък брой комбинирани точки. Те първо се измерват като работни точки в равнини и след това се уравновесяват, така че да имат същото състояние като работните точки по височина. Равнинните координати в основните точки на височина са приблизителни. Често тези точки не са измерени в равнини, а са поставени само на картата, така че могат да възникнат големи грешки. През 2016 г. и 2017 г. се полагат усилия за повишаване на качеството, за да се гарантира, че координатите на равнината в основните точки на височина не са повече от около половин метър, така че да е възможно да се намерят в полето дори без скица на точките."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa ohniska zobrazuje základní body Stockholmu v rovině a výšce na pozadí stockholmské mapy Grey Gradient Down. Celkem je v letadlech asi 25 000 bodů jádra a 5 000 bodů na výšku. Základní body se skládají ze spojovacích bodů a bodů užitkovosti, které jsou na mapě zobrazeny různými symboly. U bodů plánu jsou také směrové tahy, které ukazují, které body byly měřeny a vyrovnány dohromady. Databáze základních bodů obsahuje také typ bodů nazvaný přírodní pomůcky. Používají se pouze k podpoře blokové triangulace leteckých snímků a podobných aplikací a nejsou na stejné úrovni jako ostatní body jádra. Ty jsou viditelné pouze v dpMap, nikoli v externích mapových produktech, aby zákazníci neriskovali jejich použití jako hlavních bodů. Mapa kontaktních míst je využívána jak interně správními orgány města Stockholmu, tak externími zákazníky, jako jsou stavební společnosti, projektanti a konzultanti měření. Mapa je k dispozici na internetu, kde mají uživatelé také přístup ke koordinačním informacím a náčrtům bodů. Jako interní uživatel nebo smluvní zákazník se tak děje prostřednictvím přihlášení a jako externí zákazník proti platbě kartou. Body jádra jsou měřeny podle normy HMK (Handbook in Measurement and Map Questions, vydané společností Lantmäteriet). V rovinách bylo použito dávkové měření s celkovou stanicí a ve výškách jemné vážení pro přípojná místa a společné vyvažování pro přípojná místa. K dispozici je také malý počet kombinovaných bodů. Ty byly nejprve měřeny jako servisní body v rovinách a poté vyváženy tak, aby měly stejný stav jako servisní body na výšku. Souřadnice roviny ve výškových bodech jádra jsou přibližné. Často tyto body nebyly měřeny v rovinách, ale pouze umístěny na mapě, takže může dojít k velkým chybám. V letech 2016 a 2017 probíhá úsilí o zvýšení kvality, aby se zajistilo, že souřadnice roviny ve výškových bodech jádra nejsou větší než asi půl metru, takže by mělo být možné je najít v terénu i bez náčrtu bodu."},{"@language":"da-t-sv-t0-mtec","@value":"Fokuspunktskortet viser Stockholms kernepunkter i plan og højde på baggrund af Stockholmskortet Grey Gradient Down. I alt er der omkring 25.000 kernepunkter i fly og 5.000 i højden. Basispunkterne består af forbindelsespunkter og nyttepunkter, og disse vises med forskellige symboler på kortet. For planpunkterne er der også retningsbestemte streger, der viser, hvilke punkter der er blevet målt og udjævnet sammen. Den centrale punktdatabase indeholder også en type punkter kaldet Natural Aids. Disse må kun anvendes til at understøtte bloktriangulering af luftbilleder og lignende applikationer og er ikke på lige fod med de andre kernepunkter. Disse er kun synlige i dpMap, ikke i eksterne kortprodukter, for ikke at risikere kunder, der bruger dem som kernepunkter. Omdrejningspunktet kortet bruges både internt af Stockholms Kommunes administrationer og af eksterne kunder, såsom byggefirmaer, planlæggere og målekonsulenter. Kortet er tilgængeligt på internettet, hvor brugerne også har adgang til at koordinere oplysninger og punkt skitser. Som intern bruger eller kontraktkunde sker dette via login og som ekstern kunde mod kortbetaling. Kernepunkterne måles efter HMK's (Handbook in Measurement and Map Questions, udgivet af Lantmäteriet) standard. I fly er der anvendt batchmåling med totalstation og i højde finvejning for tilslutningspunkter og fælles afbalancering for nyttepunkter. Et lille antal kombinerede punkter er også tilgængelige. Disse er først blevet målt som servicepunkter i fly og derefter afbalanceret, så de også har samme status som servicepunkter i højden. Plan koordinater på centrale punkter i højden er omtrentlige. Ofte er disse punkter ikke blevet målt i fly, men kun placeret på kortet, så der kan opstå store fejl. En kvalitetsforbedrende indsats er i gang i 2016 og 2017 for at sikre, at flykoordinater på kernepunkter i højden ikke er mere fejl end omkring en halv meter, så det skulle være muligt at finde disse i marken selv uden en punktskits."},{"@language":"de-t-sv-t0-mtec","@value":"Die Fokuspunktkarte zeigt Stockholms Kernpunkte in Ebene und Höhe vor dem Hintergrund der Stockholmer Karte Grey Gradient Down. Insgesamt gibt es etwa 25.000 Kernpunkte in Flugzeugen und 5.000 in der Höhe. Die Basispunkte bestehen aus Verbindungspunkten und Nutzpunkten, die in der Karte mit unterschiedlichen Symbolen dargestellt werden. Für die Planpunkte gibt es auch Richtungsstriche, die zeigen, welche Punkte zusammen gemessen und geebnet wurden. Die Kernpunktdatenbank enthält auch eine Art von Punkten namens Natural Aids. Diese dürfen nur zur Unterstützung der Blocktriangulation von Luftbildern und ähnlichen Anwendungen verwendet werden und sind nicht den anderen Kernpunkten gleichgestellt. Diese sind nur in dpMap sichtbar, nicht in externen Kartenprodukten, um nicht zu riskieren, dass Kunden sie als Kernpunkte verwenden. Die Schwerpunktkarte wird sowohl intern von den Verwaltungen der Stadt Stockholm als auch von externen Kunden wie Bauunternehmen, Planern und Messberatern verwendet. Die Karte ist im Internet verfügbar, wo Benutzer auch Zugang zu Koordinateninformationen und Punktskizzen haben. Als interner Nutzer oder Vertragskunde erfolgt dies per Login und als externer Kunde gegen Kartenzahlung. Die Kernpunkte werden nach dem HMK-Standard (Handbook in Measurement and Map Questions, herausgegeben von Lantmäteriet) gemessen. In Flugzeugen wurde Chargenmessung mit Totalstation und in der Höhe Feinwägung für Anschlusspunkte und gemeinsames Auswuchten für Versorgungspunkte verwendet. Eine kleine Anzahl von kombinierten Punkten ist ebenfalls verfügbar. Diese wurden zunächst als Servicepunkte in Flugzeugen gemessen und dann so ausbalanciert, dass sie auch den gleichen Status wie Servicepunkte in der Höhe haben. Flugzeugkoordinaten an Kernpunkten in der Höhe sind ungefähre Werte. Oft wurden diese Punkte nicht in Ebenen gemessen, sondern nur auf der Karte platziert, so dass größere Fehler auftreten können. In den Jahren 2016 und 2017 werden qualitätssteigernde Anstrengungen unternommen, um sicherzustellen, dass Flugzeugkoordinaten an Kernpunkten in der Höhe nicht mehr als etwa einen halben Meter fehlerfrei sind, damit diese auch ohne Punktskizze im Feld gefunden werden können."},{"@language":"el-t-sv-t0-mtec","@value":"Ο χάρτης σημείων εστίασης δείχνει τα βασικά σημεία της Στοκχόλμης σε επίπεδο και ύψος στο φόντο του χάρτη της Στοκχόλμης Grey Gradient Down. Συνολικά, υπάρχουν περίπου 25.000 βασικά σημεία σε αεροπλάνα και 5.000 σε ύψος. Τα σημεία βάσης αποτελούνται από σημεία σύνδεσης και σημεία χρησιμότητας και αυτά εμφανίζονται με διαφορετικά σύμβολα στο χάρτη. Για τα σημεία του σχεδίου υπάρχουν επίσης κατευθυντικές κινήσεις που δείχνουν ποια σημεία έχουν μετρηθεί και ισοπεδωθεί μαζί. Η βάση δεδομένων βασικών σημείων περιέχει επίσης ένα είδος σημείων που ονομάζονται φυσικά βοηθήματα. Αυτά χρησιμοποιούνται μόνο για την υποστήριξη του τριγωνισμού των τεμαχίων των εναέριων εικόνων και παρόμοιων εφαρμογών και δεν είναι επί ίσοις όροις με τα άλλα βασικά σημεία. Αυτά είναι ορατά μόνο σε dpMap, όχι σε προϊόντα εξωτερικού χάρτη, έτσι ώστε να μην διακινδυνεύσουν οι πελάτες να τα χρησιμοποιήσουν ως βασικά σημεία. Ο χάρτης εστιακών σημείων χρησιμοποιείται τόσο εσωτερικά από τις διοικήσεις του δήμου της Στοκχόλμης όσο και από εξωτερικούς πελάτες, όπως κατασκευαστικές εταιρείες, σχεδιαστές και συμβούλους μέτρησης. Ο χάρτης είναι διαθέσιμος στο διαδίκτυο, όπου οι χρήστες έχουν επίσης πρόσβαση στον συντονισμό πληροφοριών και σημειακών σχεδίων. Ως εσωτερικός χρήστης ή συμβεβλημένος πελάτης, αυτό γίνεται μέσω σύνδεσης και ως εξωτερικός πελάτης έναντι πληρωμής με κάρτα. Τα βασικά σημεία μετρώνται σύμφωνα με το πρότυπο HMK (Handbook in Measurement and Map Questions, που δημοσιεύθηκε από το Lantmäteriet). Στα αεροπλάνα, έχει χρησιμοποιηθεί μέτρηση παρτίδας με συνολικό σταθμό και σε ύψος λεπτή ζύγιση για σημεία σύνδεσης και κοινή εξισορρόπηση για σημεία χρησιμότητας. Ένας μικρός αριθμός συνδυασμένων σημείων είναι επίσης διαθέσιμος. Αυτά πρώτα μετρήθηκαν ως σημεία εξυπηρέτησης σε αεροπλάνα και στη συνέχεια ισορροπήθηκαν έτσι ώστε να έχουν επίσης την ίδια κατάσταση με τα σημεία εξυπηρέτησης σε ύψος. Οι συντεταγμένες του αεροπλάνου στα κεντρικά σημεία σε ύψος είναι κατά προσέγγιση. Συχνά αυτά τα σημεία δεν έχουν μετρηθεί σε επίπεδα, αλλά έχουν τοποθετηθεί μόνο στο χάρτη, έτσι μπορεί να προκύψουν σημαντικά σφάλματα. Μια προσπάθεια βελτίωσης της ποιότητας βρίσκεται σε εξέλιξη το 2016 και το 2017 για να διασφαλιστεί ότι οι συντεταγμένες του αεροπλάνου στα κεντρικά σημεία σε ύψος δεν είναι περισσότερο σφάλμα από περίπου μισό μέτρο, έτσι ώστε να είναι δυνατόν να βρεθούν στο πεδίο ακόμη και χωρίς ένα σημειακό σκίτσο."},{"@language":"en-t-sv-t0-mtec","@value":"The focal point map shows Stockholm's core points in plane and height against the background of the Stockholm map Grey Gradient Down. In total, there are about 25,000 core points in planes and 5,000 in height. The base points consist of connection points and utility points and these are shown with different symbols in the map. For the plan points there are also directional strokes that show which points have been measured and leveled together. The core point database also contains a type of points called Natural Aids. These shall only be used to support block triangulation of aerial images and similar applications and are not on an equal footing with the other core points. These are only visible in dpMap, not in external map products, so as not to risk customers using them as core points. The focal point map is used both internally by the City of Stockholm's administrations and by external customers, such as construction companies, planners and measurement consultants. The map is available on the internet where users also have access to coordinate information and point sketches. As an internal user or contract customer, this is done via login and as an external customer against card payment. The core points are measured according to HMK's (Handbook in Measurement and Map Questions, published by Lantmäteriet) standard. In planes, batch measurement with total station has been used and in height fine weighing for connection points and common balancing for utility points. A small number of combined points are also available. These have first been measured as service points in planes and then balanced so that they also have the same status as service points in height. Plane coordinates at core points in height are approximate. Often these points have not been measured in planes but only placed on the map, so major errors can occur. A quality-enhancing effort is underway in 2016 and 2017 to ensure that plane coordinates at core points in height are no more error than about half a meter so that it should be possible to find these in the field even without a point sketch."},{"@language":"es-t-sv-t0-mtec","@value":"El mapa de puntos focales muestra los puntos centrales de Estocolmo en plano y altura contra el fondo del mapa de Estocolmo Grey Gradient Down. En total, hay alrededor de 25,000 puntos centrales en aviones y 5,000 en altura. Los puntos base consisten en puntos de conexión y puntos de utilidad y estos se muestran con diferentes símbolos en el mapa. Para los puntos del plan también hay trazos direccionales que muestran qué puntos se han medido y nivelado juntos. La base de datos de puntos centrales también contiene un tipo de puntos llamados Ayudas Naturales. Estos solo se utilizarán para apoyar la triangulación en bloque de imágenes aéreas y aplicaciones similares y no estarán en pie de igualdad con los demás puntos centrales. Estos solo son visibles en dpMap, no en productos de mapas externos, para no arriesgar a los clientes a usarlos como puntos centrales. El mapa de puntos focales es utilizado tanto internamente por las administraciones de la ciudad de Estocolmo como por clientes externos, como empresas de construcción, planificadores y consultores de medición. El mapa está disponible en Internet, donde los usuarios también tienen acceso para coordinar la información y los bocetos de puntos. Como usuario interno o cliente contractual, esto se hace a través de inicio de sesión y como cliente externo contra pago con tarjeta. Los puntos centrales se miden de acuerdo con el estándar HMK (Handbook in Measurement and Map Questions, publicado por Lantmäteriet). En los planos, se ha utilizado la medición por lotes con estación total y el pesaje fino en altura para los puntos de conexión y el balanceo común para los puntos de servicio. Un pequeño número de puntos combinados también están disponibles. Estos se han medido primero como puntos de servicio en aviones y luego se han equilibrado para que también tengan el mismo estado que los puntos de servicio en altura. Las coordenadas planas en los puntos centrales de altura son aproximadas. A menudo, estos puntos no se han medido en planos, sino que solo se han colocado en el mapa, por lo que pueden producirse errores importantes. Un esfuerzo de mejora de la calidad está en marcha en 2016 y 2017 para garantizar que las coordenadas del avión en los puntos centrales de altura no sean más de medio metro de error, por lo que debería ser posible encontrarlas en el campo incluso sin un boceto de puntos."},{"@language":"et-t-sv-t0-mtec","@value":"Fookuspunktide kaardil on kujutatud Stockholmi põhipunktid tasapinnal ja kõrgusel Stockholmi kaardi taustal Grey Gradient Down. Kokku on lennukites umbes 25 000 tuumapunkti ja 5000 kõrgust. Baaspunktid koosnevad ühenduspunktidest ja utiliitpunktidest ning need on kaardil näidatud erinevate sümbolitega. Plaanipunktide puhul on olemas ka suunalised käigud, mis näitavad, milliseid punkte on mõõdetud ja tasandatud. Põhipunktide andmebaas sisaldab ka teatud tüüpi punkte, mida nimetatakse looduslikeks abivahenditeks. Neid kasutatakse üksnes aerofotode ja sarnaste rakenduste plokktriangulatsiooni toetamiseks ning need ei ole teiste põhipunktidega võrdsetel alustel. Need on nähtavad ainult dpMapis, mitte välistes kaarditoodetes, et mitte riskida klientidega, kes kasutavad neid põhipunktidena. Kontaktpunktide kaarti kasutavad nii Stockholmi linnavalitsused kui ka väliskliendid, näiteks ehitusettevõtted, planeerijad ja mõõtmiskonsultandid. Kaart on kättesaadav internetis, kus kasutajatel on juurdepääs ka koordineerivale teabele ja punktide visanditele. Sisekasutaja või lepingulise kliendina toimub see sisselogimise kaudu ja välise kliendina kaardimakse vastu. Põhipunkte mõõdetakse vastavalt HMK (Handbook in Measurement and Map Questions, avaldatud Lantmäterieti poolt) standardile. Tasanditel on kasutatud partii mõõtmist kogu jaamaga ning ühenduspunktide kõrguse peenkaalumist ja kommunaalpunktide ühist tasakaalustamist. Saadaval on ka väike arv kombineeritud punkte. Neid on kõigepealt mõõdetud teeninduspunktidena lennukites ja seejärel tasakaalustatud, nii et neil on ka sama staatus kui teeninduspunktidel kõrgusel. Lennuki koordinaadid kõrguste põhipunktides on ligikaudsed. Sageli ei ole neid punkte lennukites mõõdetud, vaid ainult kaardile paigutatud, mistõttu võivad tekkida suured vead. 2016. ja 2017. aastal tehakse jõupingutusi kvaliteedi parandamiseks, et tagada, et tasapinnalised koordinaadid kõrguse põhipunktides ei oleks rohkem viga kui umbes pool meetrit, nii et neid peaks olema võimalik leida ka ilma punktijooniseta."},{"@language":"fi-t-sv-t0-mtec","@value":"Fokuspistekartta näyttää Tukholman ydinpisteet lentokoneessa ja korkeudessa Tukholman kartan taustaa vasten Grey Gradient Down. Lentokoneissa on yhteensä noin 25 000 ydinpistettä ja 5 000 korkeuspistettä. Peruspisteet koostuvat liityntäpisteistä ja hyödyllisyyspisteistä, jotka näkyvät kartalla erilaisilla symboleilla. Suunnitelmapisteitä varten on myös suuntaviivoja, jotka osoittavat, mitkä pisteet on mitattu ja tasattu yhteen. Ydinpistetietokanta sisältää myös erään tyyppisiä pisteitä nimeltä Natural Aids. Niitä saa käyttää ainoastaan ilmakuvien ja vastaavien sovellusten lohkotriangulaation tukemiseen, eivätkä ne ole tasavertaisessa asemassa muiden ydinpisteiden kanssa. Nämä näkyvät vain dpMapissa, ei ulkoisissa karttatuotteissa, jotta asiakkaat eivät vaaranna niiden käyttöä ydinpisteinä. Fokuspistekarttaa käyttävät sekä Tukholman kaupungin hallinto että ulkopuoliset asiakkaat, kuten rakennusliikkeet, suunnittelijat ja mittauskonsultit. Kartta on saatavilla internetissä, jossa käyttäjät pääsevät myös koordinoimaan tietoja ja pistepiirustuksia. Sisäisenä käyttäjänä tai sopimusasiakkaana tämä tapahtuu kirjautumalla sisään ja ulkoisena asiakkaana korttimaksua vastaan. Ydinpisteet mitataan HMK:n (Handbook in Measurement and Map Questions, Lantmäteriet) standardin mukaisesti. Lentokoneissa on käytetty erämittausta kokonaisasemalla ja korkeuden hieno punnitusta liitäntäpisteille ja yleistä tasapainotusta hyötypisteille. Saatavilla on myös pieni määrä yhdistettyjä pisteitä. Ne on ensin mitattu lentokoneiden huoltopisteinä ja sitten tasapainotettu siten, että niillä on sama asema kuin korkeilla huoltopisteillä. Lentokonekoordinaatit ovat korkeuden ydinpisteissä likimääräisiä. Usein näitä pisteitä ei ole mitattu lentokoneissa, vaan ne on sijoitettu vain kartalle, joten suuria virheitä voi tapahtua. Vuosina 2016 ja 2017 toteutetaan laatua parantavia toimia sen varmistamiseksi, että korkeuden ydinpisteiden tasokoordinaatit eivät ole enempää virheitä kuin noin puoli metriä, jotta ne olisi mahdollista löytää kentältä myös ilman pisteluonnosta."},{"@language":"fr-t-sv-t0-mtec","@value":"La carte des points focaux montre les points centraux de Stockholm en plan et en hauteur sur le fond de la carte de Stockholm Grey Gradient Down. Au total, il y a environ 25 000 points de base dans les avions et 5 000 en hauteur. Les points de base se composent de points de connexion et de points d'utilité et ceux-ci sont affichés avec différents symboles sur la carte. Pour les points du plan, il y a aussi des traits directionnels qui montrent quels points ont été mesurés et nivelés ensemble. La base de données de points de base contient également un type de points appelé Aides naturelles. Ceux-ci ne doivent être utilisés que pour soutenir la triangulation en bloc d'images aériennes et d'applications similaires et ne sont pas sur un pied d'égalité avec les autres points essentiels. Ceux-ci ne sont visibles que dans dpMap, pas dans les produits cartographiques externes, afin de ne pas risquer que les clients les utilisent comme points de base. La carte des points focaux est utilisée à la fois en interne par les administrations de la ville de Stockholm et par des clients externes, tels que des entreprises de construction, des planificateurs et des consultants en mesure. La carte est disponible sur Internet où les utilisateurs ont également accès à des informations coordonnées et à des croquis ponctuels. En tant qu'utilisateur interne ou client contractuel, cela se fait via login et en tant que client externe contre paiement par carte. Les points de base sont mesurés selon la norme HMK (Handbook in Measurement and Map Questions, publié par Lantmäteriet). Dans les avions, la mesure par lots avec la station totale a été utilisée et dans le pesage fin en hauteur pour les points de connexion et l'équilibrage commun pour les points de service. Un petit nombre de points combinés sont également disponibles. Ceux-ci ont d'abord été mesurés en tant que points de service dans les avions, puis équilibrés afin qu'ils aient également le même statut que les points de service en hauteur. Les coordonnées du plan aux points centraux en hauteur sont approximatives. Souvent, ces points n'ont pas été mesurés dans des plans, mais seulement placés sur la carte, de sorte que des erreurs majeures peuvent se produire. Un effort d'amélioration de la qualité est en cours en 2016 et 2017 pour s'assurer que les coordonnées du plan aux points centraux en hauteur ne sont pas plus d'erreur qu'environ un demi-mètre afin qu'il soit possible de les trouver sur le terrain même sans esquisse de point."},{"@language":"ga-t-sv-t0-mtec","@value":"Taispeánann an léarscáil pointe fócasach lárphointí Stócólm i eitleán agus airde i gcoinne chúlra an léarscáil Stócólm Grey Gradient Down. San iomlán, tá thart ar 25,000 croíphointe i bplánaí agus 5,000 ar airde. Is éard atá sna bunphointí pointí ceangail agus pointí fóntais agus taispeántar iad seo le siombailí éagsúla ar an léarscáil. Maidir leis na pointí plean tá strócanna treorach ann freisin a thaispeánann cé na pointí a tomhaiseadh agus a leibhéalaíodh le chéile. Tá cineál pointí ar a dtugtar Áiseanna Nádúrtha sa bhunachar sonraí croíphointí freisin. Ní úsáidfear iad sin ach amháin chun tacú le bloc-thriantánú aeríomhánna agus feidhmeanna comhchosúla agus níl siad ar comhchéim leis na croíphointí eile. Níl siad seo le feiceáil ach i dpMap, ní i dtáirgí léarscáile seachtracha, ionas nach gcuirfidh siad custaiméirí i mbaol agus iad á n-úsáid mar chroíphointí. Úsáideann riaracháin Chathair Stócólm agus custaiméirí seachtracha, amhail cuideachtaí tógála, pleanálaithe agus comhairleoirí tomhais, an léarscáil pointe fócasaigh go hinmheánach. Tá an léarscáil ar fáil ar an idirlíon áit a bhfuil rochtain ag úsáideoirí freisin chun faisnéis agus sceitsí pointí a chomhordú. Mar úsáideoir inmheánach nó mar chustaiméir conartha, déantar é seo trí logáil isteach agus mar chustaiméir seachtrach in aghaidh íocaíochta cárta. Tomhaistear na croíphointí de réir chaighdeán HMK (Handbook in Measurement and Map Questions, arna fhoilsiú ag Lantmäteriet). I bplánaí, baineadh úsáid as tomhas baisce le stáisiún iomlán agus meáchan mín ar airde le haghaidh pointí nasctha agus cothromú coiteann le haghaidh pointí fóntais. Tá líon beag pointí comhcheangailte ar fáil freisin. Rinneadh iad seo a thomhas ar dtús mar phointí seirbhíse i bplánaí agus ansin cothromaíodh iad ionas go mbeidh an stádas céanna acu agus atá ag pointí seirbhíse ar airde. Tá na comhordanáidí plánaí ag na croíphointí ar airde neas. Is minic nach ndearnadh na pointí seo a thomhas i bplánaí ach a chur ar an léarscáil, agus mar sin is féidir earráidí móra a dhéanamh. Tá iarracht chun cáilíocht a fheabhsú ar siúl in 2016 agus 2017 chun a chinntiú nach bhfuil comhordanáidí eitleáin ag croíphointí ar airde níos mó ná thart ar leath mhéadar ionas gur féidir iad seo a aimsiú sa réimse fiú gan sceitse pointe."},{"@language":"hr-t-sv-t0-mtec","@value":"Karta žarišne točke prikazuje glavne točke Stockholma u ravnini i visini u odnosu na pozadinu karte Stockholm Grey Gradient Down. Ukupno ima oko 25.000 osnovnih točaka u zrakoplovima i 5.000 u visini. Osnovne točke sastoje se od priključnih točaka i točaka korisnosti, a one su prikazane s različitim simbolima na karti. Za točke plana postoje i smjerni hodovi koji pokazuju koje su točke izmjerene i izravnane zajedno. Baza podataka o ključnim točkama također sadrži vrstu točaka koje se nazivaju prirodna pomagala. Oni se upotrebljavaju samo za podupiranje blok triangulacije zračnih snimaka i sličnih primjena te nisu ravnopravni s drugim ključnim točkama. Oni su vidljivi samo u dpMapu, a ne u proizvodima vanjske karte, kako ne bi riskirali kupce koji ih koriste kao osnovne točke. Kartu žarišne točke interno upotrebljavaju uprave grada Stockholma i vanjski korisnici, kao što su građevinska poduzeća, projektanti i savjetnici za mjerenje. Karta je dostupna na internetu gdje korisnici također imaju pristup koordiniranim informacijama i skicama točaka. Kao interni korisnik ili ugovorni kupac, to se obavlja putem prijave i kao vanjski kupac uz plaćanje karticom. Osnovne točke mjere se prema HMK-ovom standardu (Handbook in Measurement and Map Questions, koji je objavio Lantmäteriet). U ravninama je korišteno skupno mjerenje s ukupnom stanicom, a u visini fino vaganje za priključna mjesta i zajedničko balansiranje za komunalna mjesta. Dostupan je i mali broj kombiniranih točaka. Oni su prvo izmjereni kao servisne točke u ravninama, a zatim uravnoteženi tako da imaju isti status kao i servisne točke u visini. Koordinate ravnine na središnjim točkama visine su približne. Često ove točke nisu mjerene u ravninama, već samo postavljene na kartu, tako da se mogu pojaviti velike pogreške. U 2016. i 2017. u tijeku je rad na poboljšanju kvalitete kako bi se osiguralo da koordinate ravnine na središnjim točkama visine ne budu više od pola metra pogreške, tako da bi ih trebalo biti moguće pronaći u polju čak i bez skice točke."},{"@language":"hu-t-sv-t0-mtec","@value":"A fókuszpont-térkép Stockholm fő pontjait mutatja síkban és magasságban a stockholmi szürke színátmenetes térkép hátterében. Összesen mintegy 25 000 fő pont van a repülőgépeken és 5000 magasságban. Az alappontok kapcsolódási pontokból és használati pontokból állnak, és ezek különböző szimbólumokkal jelennek meg a térképen. A tervpontok esetében vannak irányított löketek is, amelyek megmutatják, hogy mely pontokat mérték és kiegyenlítették együtt. A központi pont adatbázis tartalmaz egy olyan típusú pontot is, amelyet Natural Aids-nek neveznek. Ezek csak a légi felvételek és hasonló alkalmazások blokkolt háromszögelésének támogatására használhatók, és nem egyenrangúak a többi alapvető ponttal. Ezek csak a dpMap-ben láthatók, nem pedig a külső térképtermékekben, hogy ne kockáztassák az ügyfeleket, hogy azokat alappontként használják. A fókuszpont-térképet Stockholm város közigazgatási szervei és külső ügyfelek, például építőipari vállalatok, tervezők és mérési tanácsadók egyaránt használják. A térkép elérhető az interneten, ahol a felhasználók is hozzáférhetnek a koordináta-információkhoz és a pontrajzokhoz. Belső felhasználóként vagy szerződéses ügyfélként ez bejelentkezéssel és külső ügyfélként történik kártyás fizetés ellenében. Az alappontokat a HMK (Handbook in Measurement and Map Questions, a Lantmäteriet által kiadott) szabványa szerint mérik. A síkokban szakaszos mérést alkalmaztak a teljes állomással, és a csatlakozási pontok magassági finommérését és a közüzemi pontok közös kiegyensúlyozását. Kis számú kombinált pont is rendelkezésre áll. Ezeket először síkban szervizpontokként mérték, majd kiegyensúlyozták, hogy ugyanolyan státusszal rendelkezzenek, mint a magassági szervizpontok. A sík koordinátái a mag magassági pontjain hozzávetőlegesek. Ezeket a pontokat gyakran nem síkban mérik, hanem csak a térképen helyezik el, így nagyobb hibák fordulhatnak elő. 2016-ban és 2017-ben minőségjavító erőfeszítések folynak annak biztosítása érdekében, hogy a magassági magpontok síkkoordinátái ne legyenek nagyobbak, mint körülbelül fél méter, hogy ezeket a terepen még pontvázlat nélkül is meg lehessen találni."},{"@language":"it-t-sv-t0-mtec","@value":"La mappa dei punti focali mostra i punti centrali di Stoccolma in piano e in altezza sullo sfondo della mappa di Stoccolma Grey Gradient Down. In totale, ci sono circa 25.000 punti centrali negli aerei e 5.000 in altezza. I punti base sono costituiti da punti di connessione e punti di utilità e questi sono mostrati con diversi simboli nella mappa. Per i punti del piano ci sono anche tratti direzionali che mostrano quali punti sono stati misurati e livellati insieme. Il database dei punti di base contiene anche un tipo di punti chiamati Natural Aids. Questi devono essere utilizzati solo per sostenere la triangolazione a blocchi di immagini aeree e applicazioni simili e non sono su un piano di parità con gli altri punti fondamentali. Questi sono visibili solo in dpMap, non nei prodotti cartografici esterni, in modo da non rischiare che i clienti li utilizzino come punti chiave. La mappa del punto focale è utilizzata sia internamente dalle amministrazioni della città di Stoccolma che da clienti esterni, come imprese di costruzione, pianificatori e consulenti di misurazione. La mappa è disponibile su Internet, dove gli utenti hanno anche accesso a informazioni coordinate e schizzi di punti. Come utente interno o cliente contrattuale, ciò avviene tramite login e come cliente esterno contro pagamento con carta. I punti fondamentali sono misurati secondo lo standard HMK (Handbook in Measurement and Map Questions, pubblicato da Lantmäteriet). Negli aerei è stata utilizzata la misurazione del lotto con stazione totale e la pesatura fine in altezza per i punti di connessione e il bilanciamento comune per i punti di utilità. Sono disponibili anche un piccolo numero di punti combinati. Questi sono stati prima misurati come punti di servizio in piani e poi bilanciati in modo che abbiano anche lo stesso stato dei punti di servizio in altezza. Le coordinate del piano nei punti centrali in altezza sono approssimative. Spesso questi punti non sono stati misurati in piani ma solo posizionati sulla mappa, quindi possono verificarsi errori importanti. Uno sforzo di miglioramento della qualità è in corso nel 2016 e nel 2017 per garantire che le coordinate aeree nei punti centrali in altezza non siano più errori di circa mezzo metro in modo che sia possibile trovarle sul campo anche senza uno schizzo di punto."},{"@language":"lt-t-sv-t0-mtec","@value":"Židinio taškų žemėlapyje pavaizduoti Stokholmo pagrindiniai taškai plokštumoje ir aukštyje Stokholmo žemėlapio \"Grey Gradient Down\" fone. Iš viso lėktuvuose yra apie 25 000 pagrindinių taškų ir 5 000 aukščio. Pagrindiniai taškai susideda iš prijungimo taškų ir naudingumo taškų, kurie žemėlapyje rodomi skirtingais simboliais. Plano taškams taip pat yra kryptinių posūkių, rodančių, kurie taškai buvo išmatuoti ir išlyginti kartu. Pagrindinėje taškų duomenų bazėje taip pat yra taškų tipas, vadinamas \"Natural Aids\". Jie naudojami tik siekiant palaikyti aerofotografijų trianguliaciją ir panašias programas ir nėra vienodoje padėtyje su kitais pagrindiniais taškais. Jie matomi tik dpMap, o ne išorinio žemėlapio produktuose, kad nerizikuotų klientais, kurie juos naudoja kaip pagrindinius taškus. Pagrindinį žemėlapį naudoja tiek Stokholmo miesto administracijos, tiek išorės klientai, pavyzdžiui, statybos bendrovės, planuotojai ir matavimo konsultantai. Žemėlapis yra prieinamas internete, kur vartotojai taip pat turi prieigą prie koordinačių informacijos ir taškų eskizų. Kaip vidinis vartotojas ar sutarties klientas, tai daroma prisijungus ir kaip išorinis klientas už mokėjimą kortele. Pagrindiniai taškai matuojami pagal HMK (Handbook in Measurement and Map Questions, išleistas Lantmäteriet) standartą. Lėktuvuose buvo naudojamas partijos matavimas su visa stotimi ir aukštos kokybės svėrimas prijungimo taškams ir bendras balansavimas naudingumo taškams. Taip pat yra keletas kombinuotų taškų. Iš pradžių jie buvo išmatuoti kaip aptarnavimo taškai lėktuvuose, o tada subalansuoti taip, kad jie taip pat turėtų tokį patį statusą kaip ir aptarnavimo taškai aukštyje. Plokštumos koordinatės pagrindiniuose aukščio taškuose yra apytikslės. Dažnai šie taškai nebuvo matuojami plokštumose, o tik žemėlapyje, todėl gali atsirasti didelių klaidų. 2016 ir 2017 m. dedamos kokybės gerinimo pastangos siekiant užtikrinti, kad plokštumos koordinatės pagrindiniuose aukščio taškuose nebūtų didesnės nei maždaug pusės metro paklaidos, kad jas būtų galima rasti lauke net ir be taškų eskizo."},{"@language":"lv-t-sv-t0-mtec","@value":"Fokusa punkta kartē redzami Stokholmas galvenie punkti plaknē un augstumā pret Stokholmas kartes Grey Gradient Down fonu. Kopumā ir aptuveni 25 000 pamatpunktu lidmašīnās un 5000 augstumā. Bāzes punkti sastāv no savienojuma punktiem un lietderības punktiem, un kartē tie ir parādīti ar dažādiem simboliem. Plāna punktiem ir arī virziena insulti, kas parāda, kuri punkti ir izmērīti un izlīdzināti kopā. Pamata punktu datubāzē ir arī punktu veids, ko sauc par Natural Aids. Tos izmanto tikai, lai atbalstītu aerofotouzņēmumu un līdzīgu lietojumu bloku triangulāciju, un tie nav vienlīdzīgā stāvoklī ar citiem pamatpunktiem. Tie ir redzami tikai dpMap, nevis ārējo karšu produktos, lai neapdraudētu klientus, kas tos izmanto kā galvenos punktus. Kontaktpunktu karti izmanto gan Stokholmas pilsētas pārvaldes iestādes, gan ārēji klienti, piemēram, būvniecības uzņēmumi, plānotāji un mērījumu konsultanti. Karte ir pieejama internetā, kur lietotājiem ir pieejama arī koordinēta informācija un punktu skices. Kā iekšējais lietotājs vai līgumklients tas tiek darīts, izmantojot pieteikumvārdu, un kā ārējais klients pret maksājumu ar karti. Galvenie punkti tiek mērīti saskaņā ar HMK (Handbook in Measurement and Map Questions, publicēts Lantmäteriet) standartu. Lidmašīnās ir izmantota partijas mērīšana ar kopējo staciju un augstuma smalkā svēršana savienojuma punktiem un kopīga balansēšana komunālo pakalpojumu punktiem. Ir pieejams arī neliels skaits kombinēto punktu. Tos vispirms mēra kā apkopes punktus lidmašīnās un pēc tam izlīdzina tā, lai tiem būtu tāds pats statuss kā apkopes punktiem augstumā. Lidmašīnas koordinātas pamatpunktos augstumā ir aptuvenas. Bieži vien šie punkti nav mērīti plaknēs, bet tikai novietoti kartē, tāpēc var rasties būtiskas kļūdas. 2016. un 2017. gadā tiek veikti kvalitātes uzlabošanas pasākumi, lai nodrošinātu, ka plaknes koordinātas pamatpunktos augstumā nepārsniedz aptuveni pusmetru, lai tās būtu iespējams atrast uz lauka pat bez punktu skices."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-mappa tal-punt fokali turi l-punti ewlenin ta 'Stokkolma fl-ajruplan u l-għoli fl-isfond tal-mappa ta' Stokkolma Grey Gradient Down. B'kollox, hemm madwar 25,000 punt ewlieni fl-ajruplani u 5,000 fl-għoli. Il-punti bażi jikkonsistu f’punti ta’ konnessjoni u punti ta’ utilità u dawn jintwerew b’simboli differenti fil-mappa. Għall-punti tal-pjan hemm ukoll puplesiji direzzjonali li juru liema punti tkejlu u ġew livellati flimkien. Il-bażi tad-data tal-punti ewlenin fiha wkoll tip ta’ punti msejħa Għajnuniet Naturali. Dawn għandhom jintużaw biss biex isostnu t-triangolazzjoni tal-blokok ta’ immaġnijiet mill-ajru u applikazzjonijiet simili u mhumiex fuq l-istess livell mal-punti ewlenin l-oħra. Dawn huma viżibbli biss fid-dpMap, mhux fil-prodotti tal-mapep esterni, sabiex ma jkunx hemm riskju li l-klijenti jużawhom bħala punti ewlenin. Il-mappa tal-punt fokali tintuża kemm internament mill-amministrazzjonijiet tal-Belt ta’ Stokkolma kif ukoll minn klijenti esterni, bħal kumpaniji tal-kostruzzjoni, pjanifikaturi u konsulenti tal-kejl. Il-mappa hija disponibbli fuq l-internet fejn l-utenti għandhom ukoll aċċess biex jikkoordinaw l-informazzjoni u l-iskeċċijiet tal-punti. Bħala utent intern jew klijent kuntrattwali, dan isir permezz ta’ login u bħala klijent estern bi ħlas bil-kard. Il-punti ewlenin jitkejlu skont l-istandard tal-HMK (Handbook in Measurement and Map Questions, ippubblikat minn Lantmäteriet). Fil-pjani, intuża kejl tal-lott bl-istazzjon totali u fl-għoli ntuża użin fin għall-punti ta’ konnessjoni u bbilanċjar komuni għall-punti ta’ utilità. Għadd żgħir ta’ punti kkombinati huma disponibbli wkoll. Dawn l-ewwel tkejlu bħala punti ta’ servizz fil-pjani u mbagħad ġew ibbilanċjati sabiex ikollhom ukoll l-istess status bħall-punti ta’ servizz fl-għoli. Il-koordinati tal-pjan fil-punti ewlenin fl-għoli huma approssimattivi. Ħafna drabi dawn il-punti ma tkejlux fi pjani iżda tpoġġew biss fuq il-mappa, u għalhekk jistgħu jseħħu żbalji kbar. Bħalissa għaddej sforz li jtejjeb il-kwalità fl-2016 u l-2017 biex jiġi żgurat li l-koordinati tal-pjan fil-punti ewlenin fl-għoli ma jkunux aktar minn madwar nofs metru sabiex ikun possibbli li jinstabu dawn fil-qasam anke mingħajr skizz tal-punt."},{"@language":"nl-t-sv-t0-mtec","@value":"De focal point map toont de kernpunten van Stockholm in vlak en hoogte tegen de achtergrond van de Stockholm map Grey Gradient Down. In totaal zijn er ongeveer 25.000 kernpunten in vliegtuigen en 5.000 in hoogte. De basispunten bestaan uit verbindingspunten en gebruikspunten en deze worden weergegeven met verschillende symbolen op de kaart. Voor de planpunten zijn er ook richtingslagen die laten zien welke punten bij elkaar zijn gemeten en geëgaliseerd. De kernpuntendatabase bevat ook een type punten dat Natural Aids wordt genoemd. Deze mogen alleen worden gebruikt ter ondersteuning van bloktriangulatie van luchtfoto's en soortgelijke toepassingen en staan niet op gelijke voet met de andere kernpunten. Deze zijn alleen zichtbaar in dpMap, niet in externe kaartproducten, om niet te riskeren dat klanten ze als kernpunten gebruiken. De focal point map wordt zowel intern gebruikt door de administraties van de stad Stockholm als door externe klanten, zoals bouwbedrijven, planners en meetconsultants. De kaart is beschikbaar op het internet, waar gebruikers ook toegang hebben tot informatie en puntschetsen te coördineren. Als interne gebruiker of contractklant gebeurt dit via login en als externe klant tegen kaartbetaling. De kernpunten worden gemeten volgens de standaard van HMK (Handbook in Measurement and Map Questions, gepubliceerd door Lantmäteriet). In vliegtuigen is batchmeting met total station gebruikt en in hoogte fijnweging voor aansluitpunten en gemeenschappelijke balancering voor nutspunten. Er is ook een klein aantal gecombineerde punten beschikbaar. Deze zijn eerst gemeten als servicepunten in vliegtuigen en vervolgens gebalanceerd zodat ze ook dezelfde status hebben als servicepunten in hoogte. Vliegtuigcoördinaten op kernpunten in hoogte zijn bij benadering. Vaak zijn deze punten niet gemeten in vlakken maar alleen op de kaart geplaatst, waardoor er grote fouten kunnen optreden. In 2016 en 2017 wordt gewerkt aan kwaliteitsverbetering om ervoor te zorgen dat vliegtuigcoördinaten op kernpunten in hoogte niet meer fout zijn dan ongeveer een halve meter, zodat het mogelijk moet zijn om deze in het veld te vinden, zelfs zonder een puntschets."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa punktu centralnego pokazuje główne punkty Sztokholmu w płaszczyźnie i wysokości na tle mapy sztokholmskiej Grey Gradient Down. W sumie w samolotach znajduje się około 25 000 głównych punktów i 5000 wysokości. Punkty bazowe składają się z punktów połączenia i punktów użyteczności, które są pokazane z różnymi symbolami na mapie. Dla punktów planu istnieją również pociągnięcia kierunkowe, które pokazują, które punkty zostały zmierzone i wyrównane razem. Podstawowa baza danych punktów zawiera również rodzaj punktów zwanych Natural Aids. Wykorzystuje się je wyłącznie do wspomagania triangulacji blokowej obrazów lotniczych i podobnych zastosowań i nie są one na równi z innymi punktami rdzenia. Są one widoczne tylko w dpMap, a nie w zewnętrznych produktach mapowych, aby nie ryzykować, że klienci wykorzystają je jako podstawowe punkty. Mapa punktów kontaktowych jest wykorzystywana zarówno wewnętrznie przez administracje miasta Sztokholm, jak i przez klientów zewnętrznych, takich jak firmy budowlane, planiści i konsultanci pomiarowi. Mapa jest dostępna w Internecie, gdzie użytkownicy mają również dostęp do informacji koordynacyjnych i szkiców punktów. Jako użytkownik wewnętrzny lub klient kontraktowy odbywa się to za pomocą loginu i jako klient zewnętrzny w zamian za płatność kartą. Punkty podstawowe są mierzone zgodnie ze standardem HMK (Handbook in Measurement and Map Questions, opublikowanym przez Lantmäteriet). W samolotach zastosowano pomiar wsadowy z całkowitą stacją, a w przypadku punktów przyłączeniowych i wspólnego wyważania punktów użytkowych zastosowano dokładne ważenie wysokości. Dostępna jest również niewielka liczba połączonych punktów. Zostały one najpierw zmierzone jako punkty serwisowe w samolotach, a następnie zbalansowane, tak aby miały taki sam status jak punkty serwisowe na wysokości. Współrzędne płaszczyzny w głównych punktach wysokości są przybliżone. Często punkty te nie były mierzone w samolotach, a jedynie umieszczane na mapie, więc mogą wystąpić poważne błędy. W latach 2016 i 2017 trwają prace nad poprawą jakości w celu zapewnienia, aby współrzędne płaszczyzny w głównych punktach wysokości nie były większe niż około pół metra, tak aby można je było znaleźć w terenie nawet bez szkicu punktu."},{"@language":"pt-t-sv-t0-mtec","@value":"O mapa do ponto focal mostra os pontos centrais de Estocolmo em plano e altura contra o fundo do mapa de Estocolmo Grey Gradient Down. No total, existem cerca de 25.000 pontos centrais em aviões e 5.000 em altura. Os pontos de base consistem em pontos de ligação e pontos de utilidade e estes são mostrados com símbolos diferentes no mapa. Para os pontos do plano há também cursos direcionais que mostram que pontos foram medidos e nivelados em conjunto. A base de dados de pontos centrais também contém um tipo de pontos chamados \"Auxílios Naturais\". Estes só devem ser utilizados para apoiar a triangulação em bloco de imagens aéreas e aplicações semelhantes e não estão em pé de igualdade com os outros pontos centrais. Estes só são visíveis no dpMap, não em produtos de mapas externos, de modo a não arriscar que os clientes os utilizem como pontos centrais. O mapa dos pontos focais é utilizado tanto internamente pelas administrações da cidade de Estocolmo como por clientes externos, tais como empresas de construção, planificadores e consultores de medição. O mapa está disponível na Internet, onde os utilizadores também têm acesso a informações coordenadas e esboços pontuais. Como utilizador interno ou cliente contratado, isto é feito através de login e como cliente externo contra pagamento com cartão. Os pontos centrais são medidos de acordo com o padrão HMK (Handbook in Measurement and Map Questions, publicado pela Lantmäteriet). Nos aviões, foi utilizada a medição por lotes com estação total e em altura a pesagem fina para pontos de ligação e o equilíbrio comum para pontos de utilidade. Um pequeno número de pontos combinados também estão disponíveis. Estes foram medidos primeiro como pontos de serviço em aviões e depois equilibrados para que eles também tenham o mesmo status que os pontos de serviço em altura. As coordenadas do plano nos pontos centrais em altura são aproximadas. Muitas vezes, estes pontos não foram medidos em aviões, mas apenas colocados no mapa, de modo que grandes erros podem ocorrer. Um esforço de melhoria da qualidade está em andamento em 2016 e 2017 para garantir que as coordenadas do plano nos pontos centrais em altura não sejam mais de erro do que cerca de meio metro, de modo que seja possível encontrá-las no campo mesmo sem um esboço de ponto."},{"@language":"ro-t-sv-t0-mtec","@value":"Harta punctelor focale arată punctele centrale ale Stockholmului în plan și înălțime pe fundalul hărții Stockholm Grey Gradient Down. În total, există aproximativ 25.000 de puncte de bază în avioane și 5.000 în înălțime. Punctele de bază constau din puncte de conexiune și puncte de utilitate, iar acestea sunt afișate cu diferite simboluri pe hartă. Pentru punctele de plan există, de asemenea, curse direcționale care arată care puncte au fost măsurate și nivelate împreună. Baza de date a punctelor de bază conține, de asemenea, un tip de puncte numite SIDA naturale. Acestea se utilizează numai pentru a sprijini triangularea în bloc a imaginilor aeriene și aplicații similare și nu se află pe picior de egalitate cu celelalte puncte centrale. Acestea sunt vizibile doar în dpMap, nu și în produsele hărților externe, pentru a nu risca clienții care le folosesc ca puncte de bază. Harta punctelor focale este utilizată atât la nivel intern de administrațiile orașului Stockholm, cât și de clienții externi, cum ar fi societățile de construcții, planificatorii și consultanții de măsurare. Harta este disponibilă pe internet, unde utilizatorii au, de asemenea, acces la coordonarea informațiilor și a schițelor de puncte. În calitate de utilizator intern sau client contractual, acest lucru se face prin conectare și în calitate de client extern împotriva plății cu cardul. Punctele de bază sunt măsurate în conformitate cu standardul HMK (Handbook in Measurement and Map Questions, publicat de Lantmäteriet). În avioane, a fost utilizată măsurarea lotului cu stația totală și cântărirea fină în înălțime pentru punctele de conectare și echilibrarea comună pentru punctele de utilitate. Un număr mic de puncte combinate sunt, de asemenea, disponibile. Acestea au fost mai întâi măsurate ca puncte de serviciu în avioane și apoi echilibrate, astfel încât să aibă același statut ca și punctele de serviciu în înălțime. Coordonatele avionului la punctele centrale în înălțime sunt aproximative. Adesea, aceste puncte nu au fost măsurate în planuri, ci doar plasate pe hartă, astfel încât pot apărea erori majore. Un efort de îmbunătățire a calității este în curs de desfășurare în 2016 și 2017 pentru a se asigura că coordonatele plane la punctele de bază în înălțime nu sunt mai mult de o jumătate de metru eroare, astfel încât ar trebui să fie posibil să se găsească acestea în teren, chiar și fără o schiță punct."},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa ohniska zobrazuje hlavné body Štokholmu v rovine a výške na pozadí Štokholmskej mapy Grey Gradient Down. Celkovo je v lietadlách asi 25 000 základných bodov a 5 000 bodov na výšku. Základné body pozostávajú z bodov pripojenia a bodov užitočnosti, ktoré sú na mape zobrazené rôznymi symbolmi. Pre body plánu sú tiež smerové ťahy, ktoré ukazujú, ktoré body boli merané a vyrovnané spolu. Databáza základných bodov obsahuje aj typ bodov nazývaných prírodné pomôcky. Používajú sa len na podporu blokovej triangulácie leteckých snímok a podobných aplikácií a nie sú na rovnakej úrovni s ostatnými hlavnými bodmi. Tie sú viditeľné len v dpMap, nie v externých mapových produktoch, aby neriskovali zákazníkov, ktorí ich používajú ako hlavné body. Mapu kontaktných miest používajú interne správne orgány mesta Štokholm, ako aj externí zákazníci, ako sú stavebné spoločnosti, projektanti a konzultanti v oblasti merania. Mapa je k dispozícii na internete, kde majú používatelia prístup aj k koordinovaným informáciám a bodovým náčrtom. Ako interný používateľ alebo zmluvný zákazník sa to uskutočňuje prostredníctvom prihlásenia a ako externý zákazník proti platbe kartou. Jadrové body sa merajú podľa normy HMK (Handbook in Measurement and Map Questions, publikovanej spoločnosťou Lantmäteriet). V lietadlách sa používa dávkové meranie s celkovou stanicou a vo výške jemné váženie pre prípojné body a spoločné vyvažovanie pre úžitkové body. K dispozícii je aj niekoľko kombinovaných bodov. Najprv sa merali ako servisné body v lietadlách a potom sa vyvážili tak, aby mali rovnaký stav ako servisné body na výšku. Súradnice roviny v hlavných bodoch výšky sú približné. Často tieto body neboli merané v rovinách, ale len umiestnené na mape, takže sa môžu vyskytnúť veľké chyby. V rokoch 2016 a 2017 prebieha úsilie o zvýšenie kvality, aby sa zabezpečilo, že súradnice lietadiel v hlavných bodoch na výšku nie sú viac ako pol metra, takže by malo byť možné ich nájsť v teréne aj bez bodového náčrtu."},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid žariščnih točk prikazuje osrednje točke Stockholma v ravnini in višini na ozadju stockholmskega zemljevida Grey Gradient Down. Skupno je v letalih približno 25.000 osrednjih točk in 5.000 v višino. Osnovne točke so sestavljene iz priključnih točk in uporabnih točk, ki so na zemljevidu prikazane z različnimi simboli. Za točke načrta obstajajo tudi smerni gibi, ki kažejo, katere točke so bile izmerjene in izravnane skupaj. Podatkovna baza osnovnih točk vsebuje tudi vrsto točk, imenovanih Natural Aids. Ti se uporabljajo samo za podporo blokovne triangulacije posnetkov iz zraka in podobnih aplikacij ter niso enakovredni drugim osrednjim točkam. Te so vidne samo v dpMap, ne pa v zunanjih kartografskih produktih, da ne bi tvegali strank, ki jih uporabljajo kot osrednje točke. Zemljevid kontaktnih točk uporabljajo uprave mesta Stockholm in zunanji kupci, kot so gradbena podjetja, načrtovalci in svetovalci za meritve. Zemljevid je na voljo na internetu, kjer imajo uporabniki tudi dostop do koordinatnih informacij in skic točk. Kot notranji uporabnik ali pogodbena stranka se to opravi prek prijave in kot zunanja stranka proti plačilu s kartico. Ključne točke se merijo v skladu s standardom HMK (Handbook in Measurement and Map Questions, ki ga izdaja Lantmäteriet). V ravninah je bila uporabljena šaržna meritev s skupno postajo in po višini fino tehtanje za priključne točke in skupno uravnoteženje za priključne točke. Na voljo je tudi manjše število kombiniranih točk. Ti so bili najprej izmerjeni kot servisne točke v ravninah in nato uravnoteženi, tako da imajo tudi enak status kot servisne točke v višini. Koordinate letal na osrednjih točkah višine so približne. Pogosto te točke niso bile izmerjene v ravninah, ampak le na zemljevidu, zato lahko pride do večjih napak. V letih 2016 in 2017 potekajo prizadevanja za izboljšanje kakovosti, da bi zagotovili, da ravninske koordinate na osrednjih točkah višine niso več napake kot približno pol metra, tako da bi jih bilo mogoče najti na terenu tudi brez skice točke."},{"@language":"sv","@value":"Stompunktskartan visar Stockholms stompunkter i plan och höjd mot bakgrund av Stockholmskarta Grå Nedtonad. Totalt finns ca 25 000 stompunkter i plan och 5 000 i höjd. Stompunkterna består av anslutningspunkter och brukspunkter och dessa visas med olika symboler i kartan. För planpunkterna finns även riktningsstreck som visar vilka punkter som har mätts och utjämnats tillsammans. Stompunktsdatabasen innehåller även en typ av punkter som kallas Naturliga stöd. Dessa ska endast användas som stöd vid blocktriangulering av flygbilder och liknande tillämpningar och är inte jämställda med övriga stompunkter. Dessa syns bara i dpMap, inte i externa kartprodukter, för att inte riskera att kunder använder dem som stompunkter. Stompunktskartan används dels internt av Stockholms stads förvaltningar och dels av externa kunder, såsom byggbolag, projektörer och mätkonsulter. Kartan finns tillgänglig på internet där användarna även får åtkomst till koordinatinformation och punktskisser. Som intern användare eller avtalskund sker detta via inloggning och som extern kund mot kortbetalning. Stompunkterna är mätta enligt HMK:s (Handbok i Mät- och Kartfrågor, utgiven av Lantmäteriet) standard. I plan har satsmätning med totalstation använts och i höjd finavvägning för anslutningspunkter och vanlig avvägning för brukspunkter. Ett mindre antal kombinerade punkter finns också. Dessa har först mätts som brukspunkter i plan och därefter avvägts så att de också har samma status som brukspunkter i höjd. Plankoordinaterna på stompunkter i höjd är ungefärliga. Ofta har dessa punkter inte mätts in i plan utan endast placerats ut på kartan, varför stora fel kan förekomma. En kvalitetshöjande insats pågår under 2016 och 2017 för att säkerställa att plankoordinater på stompunkter i höjd inte är mer fel än ca en halvmeter så att det ska vara möjligt att hitta dessa i fält även utan en punktskiss."},{"@language":"uk-t-sv-t0-mtec","@value":"Карта фокусних точок показує основні точки Стокгольма в площині та висоті на тлі стокгольмської карти Grey Gradient Down. Всього в літаках налічується близько 25 000 основних точок і 5000 у висоту. Базові точки складаються з точок з'єднання та допоміжних точок, і вони відображаються різними символами на карті. Для точок плану є також спрямовані штрихи, які показують, які точки були виміряні і вирівняні разом. База даних основних точок також містить тип точок, який називається природними засобами. Вони повинні використовуватися лише для підтримки блокової тріангуляції аерофотознімків та подібних застосувань і не знаходяться на рівних з іншими основними точками. Вони видимі лише в dpMap, а не в зовнішніх картографічних продуктах, щоб не ризикувати клієнтами, використовуючи їх як основні точки. Карта координаційного центру використовується як внутрішньо адміністраціями міста Стокгольма, так і зовнішніми клієнтами, такими як будівельні компанії, планувальники та консультанти з вимірювань. Карта доступна в Інтернеті, де користувачі також мають доступ до координатної інформації та точкових ескізів. Як внутрішній користувач або клієнт контракту, це робиться через логін і як зовнішній клієнт проти оплати карткою. Основні точки вимірюються відповідно до стандарту HMK (Handbook in Measurement and Map Questions, опублікованого Lantmäteriet). У літаках використовується пакетне вимірювання із загальною станцією та тонке зважування по висоті для точок з'єднання та загальне балансування для комунальних пунктів. Також доступна невелика кількість комбінованих точок. Вони спочатку були виміряні як сервісні точки в літаках, а потім збалансовані так, що вони також мають такий же статус, як сервісні точки по висоті. Координати площини в центральних точках по висоті є приблизними. Часто ці точки не були виміряні в площинах, а лише розміщені на карті, тому можуть виникнути серйозні помилки. У 2016 і 2017 роках ведеться робота з підвищення якості, щоб гарантувати, що координати площини в центральних точках по висоті не більше похибки, ніж близько півметра, щоб можна було знайти їх у полі навіть без точкового ескізу."}],"dct:format":"text/html","dct:identifier":"9b134b5d-e20d-400c-96ec-5eb7b6612083","dct:issued":{"@type":"xsd:date","@value":"2017-04-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-12-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1246f5adc0e7801db6f2baa45985ce79a04e70611e081a085eb940d4ca2ca7e9_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Основни точки на SBK (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Core Points (vnitřní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK-kernepunkter (internt SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK-Kernpunkte (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"Κεντρικά σημεία SBK (εσωτερικά SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Core Points (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"Puntos Básicos SBK (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK põhipunktid (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK-ydinpisteet (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"Points de base SBK (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"Croíphointí SBK (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovne točke SBK-a (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Core Pontok (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"Punti chiave SBK (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK pagrindiniai taškai (vidaus SBK)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK pamatpunkti (iekšējie SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"Punti Ewlenin tal-SBK (SBK intern)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK-kernpunten (interne SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"Punkty podstawowe SBK (wewnętrzne SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"Pontos Principais SBK (SBK interno)"},{"@language":"ro-t-sv-t0-mtec","@value":"Puncte de bază SBK (SBK interne)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Core Points (vnútorné SBK)"},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovne točke SBK (notranje SBK)"},{"@language":"sv","@value":"SBK Stompunkter (internt SBK)"},{"@language":"uk-t-sv-t0-mtec","@value":"Основні бали SBK (внутрішні SBK)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/9ee313a6-4d8c-43d8-9142-c2eff868f948","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://etjanster.stockholm.se/Geodatabutiken/produkter/stompunkter"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/9b134b5d-e20d-400c-96ec-5eb7b6612083#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/9ee313a6-4d8c-43d8-9142-c2eff868f948"}},{"@id":"http://data.europa.eu/88u/record/9b134b5d-e20d-400c-96ec-5eb7b6612083","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/9ee313a6-4d8c-43d8-9142-c2eff868f948"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"9b134b5d-e20d-400c-96ec-5eb7b6612083","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:37Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:46Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/9b134b5d-e20d-400c-96ec-5eb7b6612083"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:1246f5adc0e7801db6f2baa45985ce79a04e70611e081a085eb940d4ca2ca7e9_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/9b134b5d-e20d-400c-96ec-5eb7b6612083"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:46Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1246f5adc0e7801db6f2baa45985ce79a04e70611e081a085eb940d4ca2ca7e9"},{"@graph":[{"@id":"_:131c9c21c0295d1ab26a41001ca23d71c18d89303dff21308451cf812e8d0ecf_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:131c9c21c0295d1ab26a41001ca23d71c18d89303dff21308451cf812e8d0ecf_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2014-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2014-04-05"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2014-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2014-04-05"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e25aa720-517c-465b-88d8-afcb5eee923c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2014-04-05"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1300 mUpplösning: 8 cm/pixel Fotograferingsdatum: 5 och 20 april 2014. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"1b96d73d-af16-46f7-b6ee-9b14e4f2007b","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:131c9c21c0295d1ab26a41001ca23d71c18d89303dff21308451cf812e8d0ecf_b0n0"},"dct:temporal":{"@id":"_:131c9c21c0295d1ab26a41001ca23d71c18d89303dff21308451cf812e8d0ecf_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2014)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2014"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2014"},{"@id":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2014"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2014"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:131c9c21c0295d1ab26a41001ca23d71c18d89303dff21308451cf812e8d0ecf"},{"@graph":[{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a9f1a78febef8cf650ef1cf3cf376d17a"},{"@id":"http://data.europa.eu/88u/dataset/a0f9b145-f0ba-49f6-9191-2995f3c8a32e","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/8b3ef976-b51e-43db-a7d7-d312c5fa630e"},{"@id":"http://data.europa.eu/88u/distribution/992f3cf0-fa1c-4f17-86af-3170fde98d1a"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2b68204e-ced2-4bcd-a72f-95f948a17808"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2024-01-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Лазерни точкови облаци от полет 2023 г. Обхваща цялата община Стокхолм, вкл. буферната зона наоколо. Формат на файла: LAS и POD. Височина на полета: плътност на пробиване: 16 pkt/m² Дата на полета: . Референтна система в план: Sweref 991800, на височина: RH2000 Лазерни данни, точкови облаци 2023Точковият облак идва от въздушно лазерно сканиране, извършено от Field Group над град Стокхолм през периода 22 април ? 7 май 2023 г. Контролът на покритието на лазерните данни се извършва визуално и със софтуер Terrascan. Плътността на точките за този проект е > 16pkt/m2Наземната класификация се контролира ръчно, докато класификацията на сградата е напълно автоматична и може да бъде с различно качество.Класирането на лазерни данни е разделено на следните класове: ? 1 (Некласифицирани) ? 2 (Марк) ? 6 (Сграда) ? 7 (високи и ниски точки, т.нар. шум) ? 9 (Вода) ? Точността на височината е 9 см или по-добра за твърди повърхности и 15 см или по-добра за други повърхности. В самолетите точността е 15 см или по-добра. Точковият облак е оцветен с ортофотографията от 2023 г., което означава, че на всяка точка е присвоена стойност RGB от съответния пиксел в ортофотографията. (Фотографска дата на ортофотоснимката: 20.4.2023 г. и 7.5.2023 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"Laserové mraky bodů z letu 2023. Zahrnuje celou obec Stockholm včetně nárazníkové zóny v okolí. Formát souboru: LAS a POD. Výška letu: Hustota propíchnutí: 16 pkt/m² Datum letu: . Referenční systém v plánu: Sweref 991800, na výšku: RH2000 Laserová data, mračna bodů 2023Mrak bodů pochází z leteckého laserového skenování, které provedla skupina Field Group nad městem Stockholm v období od 22. dubna ? května 2023. Kontrola pokrytí laserových dat byla provedena vizuálně a pomocí softwaru Terrascan. Bodová hustota pro tento projekt je > 16pkt/m2Klasifikace terénu je ručně řízena, zatímco klasifikace budov je plně automatická a může mít různou kvalitu.Klasifikace laserových dat je rozdělena do následujících tříd: ? 1 (neutajované) ? 2 (značka) ? 6 (Stavba) ? 7 (Vysoké a nízké body, tzv. hluk) ? 9 (voda) ? Přesnost ve výšce je 9 cm nebo lepší pro tvrdé povrchy a 15 cm nebo lepší pro jiné povrchy. V rovinách je přesnost 15 cm nebo lepší. Bodový mrak byl zbarven pomocí ortofotosnímku 2023, což znamená, že každému bodu byla přiřazena hodnota RGB z odpovídajícího pixelu na ortofotosnímku. (Datum pořízení ortofotosnímku: dubna a 7. května 2023)"},{"@language":"da-t-sv-t0-mtec","@value":"Laserpunktskyer fra flyvning 2023. Dækker hele Stockholm kommune inkl. stødpudezone omkring. Filformat: LAS og POD. Flyvehøjde:Punkttæthed: 16 pkt./m² Flyvedato: . Referencesystem i planen: Sweref 991800, i højden: RH2000 Laserdata, punktskyer 2023Punktskyen kommer fra luftbåren laserscanning, udført af Field Group, over Stockholm i perioden 22. april ? 7. maj 2023. Dækningskontrol af laserdata blev udført visuelt og med Terrascan-software. Punkttætheden for dette projekt er > 16pkt/m2Grundklassificeringen styres manuelt, mens bygningsklassificeringen er fuldautomatisk og kan være af varierende kvalitet.Klassificering af laserdata er opdelt i følgende klasser: ? 1 (ikke klassificeret) ? 2 (Mark) ? (flertydig) 6 (Bygning) ? 7 (høje og lave punkter såkaldt støj) ? 9 (Vand) ? Nøjagtigheden i højden er 9 cm eller bedre for hårde overflader og 15 cm eller bedre for andre overflader. I fly er nøjagtigheden 15 cm eller bedre. Punktskyen er blevet farvet ved hjælp af 2023-ortofotoet, hvilket betyder, at hvert punkt er blevet tildelt en RGB-værdi fra den tilsvarende pixel i ortofotoet. (Fotografidato for ortofotoet: 20/4 og 7/5 2023)"},{"@language":"de-t-sv-t0-mtec","@value":"Laserpunktwolken ab Flug 2023. Bedeckt die gesamte Gemeinde Stockholm inklusive Pufferzone. Dateiformat: LAS und POD. Flughöhe:Puncture Dichte: 16 pkt/m² Flugdatum: . Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000 Laserdaten, Punktwolken 2023Die Punktwolke stammt vom luftgestützten Laserscanning, durchgeführt von der Field Group, über der Stadt Stockholm im Zeitraum vom 22. April ? 7. Mai 2023. Die Abdeckungssteuerung der Laserdaten wurde visuell und mit Terrascan-Software durchgeführt. Die Punktdichte für dieses Projekt beträgt > 16pkt/m2Die Bodenklassifizierung wird manuell gesteuert, während die Gebäudeklassifizierung vollautomatisch ist und von unterschiedlicher Qualität sein kann.Die Klassifizierung von Laserdaten ist in die folgenden Klassen unterteilt: ? 1 (Nicht klassifiziert) ? 2 (Mark) ? 6 (Gebäude) ? 7 (Hoch- und Tiefpunkte, sogenanntes Rauschen) ? 9 (Wasser) ? Die Genauigkeit in der Höhe beträgt 9 cm oder besser für harte Oberflächen und 15 cm oder besser für andere Oberflächen. In Flugzeugen beträgt die Genauigkeit 15 cm oder besser. Die Punktwolke wurde mit dem Orthofoto 2023 eingefärbt, was bedeutet, dass jedem Punkt ein RGB-Wert aus dem entsprechenden Pixel im Orthofoto zugewiesen wurde. (Fotodatum des Orthofotos: 20/4 und 7/5 2023)"},{"@language":"el-t-sv-t0-mtec","@value":"Σύννεφα σημείου λέιζερ από την πτήση 2023. Καλύπτει ολόκληρο τον δήμο της Στοκχόλμης, συμπεριλαμβανομένης της νεκρής ζώνης. Μορφή αρχείου: LAS και POD. Ύψος πτήσης: Πυκνότητα οπής: 16 pkt/m² Ημερομηνία πτήσης: . Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: RH2000 Δεδομένα λέιζερ, νέφη σημείων 2023Το νέφος σημείων προέρχεται από αερομεταφερόμενη σάρωση λέιζερ, που πραγματοποιήθηκε από την Field Group, πάνω από την πόλη της Στοκχόλμης κατά την περίοδο 22 Απριλίου ? 7 Μαΐου 2023. Ο έλεγχος της κάλυψης των δεδομένων λέιζερ πραγματοποιήθηκε οπτικά και με το λογισμικό Terrascan. Η σημειακή πυκνότητα για αυτό το έργο είναι > 16Η ταξινόμηση του εδάφους ελέγχεται χειροκίνητα, ενώ η ταξινόμηση του κτιρίου είναι πλήρως αυτόματη και μπορεί να είναι ποικίλης ποιότητας.Η ταξινόμηση των δεδομένων λέιζερ χωρίζεται στις ακόλουθες κατηγορίες: ? 1 (Αταξινόμητο) ? 2 (Μάρκο) ? 6 (Κτίριο) ? 7 (Υψηλά και Χαμηλά σημεία αποκαλούμενος θόρυβος) ? 9 (Νερό) ? Η ακρίβεια στο ύψος είναι 9 cm ή καλύτερη για σκληρές επιφάνειες και 15 cm ή καλύτερη για άλλες επιφάνειες. Στα αεροπλάνα, η ακρίβεια είναι 15 cm ή καλύτερη. Το νέφος σημείων έχει χρωματιστεί με τη χρήση της ορθοφωτογραφίας 2023, πράγμα που σημαίνει ότι σε κάθε σημείο έχει αποδοθεί μια τιμή RGB από το αντίστοιχο εικονοστοιχείο στην ορθοφωτογραφία. (Ημερομηνία φωτογράφισης της ορθοφωτογραφίας: 20/4 και 7/5 2023)"},{"@language":"en-t-sv-t0-mtec","@value":"Laser point clouds from flight 2023. Covers the entire municipality of Stockholm incl buffer zone around. File format: LAS and POD. Flight height:Puncture density: 16 pkt/m² Flight date: . Reference system in plan: Sweref 991800, in height: RH2000 Laser data, point clouds 2023The point cloud comes from airborne laser scanning, performed by Field Group, over the City of Stockholm during the period 22 April ? 7 May 2023. Coverage control of laser data was performed visually and with Terrascan software. The point density for this project is > 16pkt/m2The ground classification is manually controlled while the building classification is fully automatic and can be of varying quality.Classing of laser data is divided into the following classes: ? 1 (Unclassified) ? 2 (Mark) ? 6 (Building) ? 7 (High and Low points so-called noise) ? 9 (Water) ? The accuracy in height is 9 cm or better for hard surfaces and 15 cm or better for other surfaces. In planes, the accuracy is 15 cm or better. The point cloud has been coloured using the 2023 orthophoto, meaning that each point has been assigned an RGB value from the corresponding pixel in the orthophoto. (Photography date of the orthophoto: 20/4 and 7/5 2023)"},{"@language":"es-t-sv-t0-mtec","@value":"Nubes de puntos láser del vuelo 2023. Cubre todo el municipio de Estocolmo, incluida la zona tampón alrededor. Formato de archivo: LAS y POD. Altura de vuelo: Densidad de perforación: 16 pkt/m² Fecha de vuelo: . Sistema de referencia en el plan: Sweref 991800, en altura: RH2000 Datos láser, nubes de puntos 2023La nube de puntos proviene del escaneo láser aerotransportado, realizado por Field Group, sobre la ciudad de Estocolmo durante el período 22 abril ? 7 de mayo de 2023. El control de cobertura de los datos láser se realizó visualmente y con el software Terrascan. La densidad de puntos para este proyecto es > 16pkt/m2La clasificación del suelo se controla manualmente mientras que la clasificación del edificio es totalmente automática y puede ser de calidad variable. ? 1 (sin clasificar) ? 2 (Marca) ? 6 (Edificio) ? 7 (Puntos altos y bajos llamados ruido) ? 9 (Agua) ? La precisión en altura es de 9 cm o mejor para superficies duras y 15 cm o mejor para otras superficies. En los planos, la precisión es de 15 cm o mejor. La nube de puntos se ha coloreado utilizando la ortofoto de 2023, lo que significa que a cada punto se le ha asignado un valor RGB del píxel correspondiente en la ortofoto. (Fecha de la fotografía de la ortofoto: 20 de abril y 7 de mayo de 2023)"},{"@language":"et-t-sv-t0-mtec","@value":"Laserpunktpilved alates 2023. aasta lennust. Hõlmab kogu Stockholmi omavalitsust, sh ümberringi asuvat puhvertsooni. Faili vorming: LAS ja POD. Lennu kõrgus: Löögitihedus: 16 pkt/m² Lennu kuupäev: . Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000 Laserandmed, punktpilved 2023Punktpilv pärineb õhus olevast laserskaneerimisest, mida teostas Field Group Stockholmi linna kohal perioodil 22. aprill ? 7. mai 2023. Laserandmete katvuse kontroll teostati visuaalselt ja Terrascani tarkvara abil. Selle projekti punkttihedus on > 16pkt/m2Maapinna klassifikatsioon on käsitsi kontrollitud, samas kui hoone klassifikatsioon on täisautomaatne ja võib olla erineva kvaliteediga.Laserandmete klassifitseerimine on jagatud järgmistesse klassidesse: ? 1 (liigitamata) ? 2 (Märkus) ? 6 (ehitus) ? 7 (kõrge ja madal punkt nn müra) ? 9 (vesi) ? Kõrguse täpsus on 9 cm või parem kõvadel pindadel ja 15 cm või parem muudel pindadel. Lennukites on täpsus 15 cm või parem. Punktipilv on värvitud 2023. aasta ortofoto abil, mis tähendab, et igale punktile on määratud RGB väärtus ortofoto vastavast pikslist. (Ortofoto foto kuupäev: 20/4 ja 7/5 2023)"},{"@language":"fi-t-sv-t0-mtec","@value":"Laserpistepilviä lennolta 2023. Kattaa koko Tukholman kunnan sisältäen puskurivyöhykkeen. Tiedostomuoto: LAS ja POD. Lennon korkeus:Punkture tiheys: 16 pkt/m² Lennon päivämäärä: . Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000 Laserdata, pistepilvet 2023Pistepilvi tulee Field Groupin suorittamasta laserkeilauksesta Tukholman kaupungin yllä 22.4. ? toukokuuta 2023. Laserdatan kattavuusohjaus suoritettiin visuaalisesti ja Terrascan-ohjelmistolla. Tämän projektin pistetiheys on > 16pkt/m2Maaluokitusta ohjataan manuaalisesti, kun taas rakennuksen luokitus on täysin automaattinen ja voi olla laadultaan vaihteleva.Laserdatan luokitus on jaettu seuraaviin luokkiin: ? 1 (Luokittelematon) ? 2 (merkki) ? 6 (Rakentaminen) ? 7 (korkeat ja matalat pisteet ns. melu) ? 9 (Vesi) ? Korkeustarkkuus on 9 cm tai parempi kovilla pinnoilla ja 15 cm tai parempi muilla pinnoilla. Lentokoneissa tarkkuus on 15 cm tai parempi. Pistepilvi on väritetty vuoden 2023 ortokuvalla, mikä tarkoittaa, että jokaiselle pisteelle on määritetty RGB-arvo ortokuvan vastaavasta pikselistä. (Ortokuvan kuvauspäivä: 20.4. ja 7.5.2023)"},{"@language":"fr-t-sv-t0-mtec","@value":"Nuages de point laser du vol 2023. Couvre l'ensemble de la municipalité de Stockholm, y compris la zone tampon autour. Format du fichier: LAS et POD. Hauteur de vol: Densité de perforation: 16 pkt/m² Date de vol: . Système de référence dans le plan: Sweref 991800, en hauteur: RH2000 Données laser, nuages de points 2023Le nuage de points provient du balayage laser aéroporté, effectué par Field Group, au-dessus de la ville de Stockholm au cours de la période du 22 avril? 7 mai 2023. Le contrôle de la couverture des données laser a été effectué visuellement et avec le logiciel Terrascan. La densité de points pour ce projet est > 16pkt/m2La classification du sol est contrôlée manuellement tandis que la classification du bâtiment est entièrement automatique et peut être de qualité variable. ? 1 (non classifié) ? 2 (marque) ? 6 (Bâtiment) ? 7 (Points haut et bas dits bruit) ? 9 (Eau) ? La précision en hauteur est de 9 cm ou mieux pour les surfaces dures et de 15 cm ou mieux pour les autres surfaces. Dans les avions, la précision est de 15 cm ou mieux. Le nuage de points a été coloré à l'aide de l'orthophoto 2023, ce qui signifie que chaque point a reçu une valeur RVB à partir du pixel correspondant dans l'orthophoto. (Date de photographie de l'orthophoto: 20/4 et 7/5 2023)"},{"@language":"ga-t-sv-t0-mtec","@value":"Néalta pointe léasair ó eitilt 2023. Cumhdaítear leis sin bardas iomlán Stócólm, lena n-áirítear crios maolánach timpeall air. Formáid an chomhaid: LAS agus POD. Airde eitilte: Dlús puncture: 16 pkt / m² Dáta Eitilte: . Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000 Sonraí léasair, scamaill phointe 2023Tagann an scamall pointe ó scanadh léasair aerbheirthe, arna dhéanamh ag Field Group, thar Chathair Stócólm le linn na tréimhse 22 Aibreán ? 7 Bealtaine 2023. Rinneadh rialú clúdaigh ar shonraí léasair ó amharc agus le bogearraí Terrascan. Tá dlús pointe an tionscadail seo > 16pkt / m2Déantar an t-aicmiú talún a rialú de láimh agus tá an t-aicmiú foirgnimh go hiomlán uathoibríoch agus is féidir leis a bheith de cháilíocht éagsúil. ? 1 (Neamhaicmithe) ? 2 (Marcáil) ? 6 (Foirgníocht) ? 7 (Pointí arda agus ísle mar a thugtar air torann) ? 9 (Uisce) ? Tá an cruinneas ar airde 9 cm nó níos fearr do dhromchlaí crua agus 15 cm nó níos fearr do dhromchlaí eile. I bplánaí, tá an cruinneas 15 cm nó níos fearr. Rinneadh an néalphointe a dhathú trí úsáid a bhaint as orta-ghrianghraf 2023, rud a chiallaíonn gur sannadh luach RGB do gach pointe ón bpicteilín comhfhreagrach san orta-ghrianghraf. (Dáta fótagrafaíochta an ortaphoto: 20/4 agus 7/5 2023)"},{"@language":"hr-t-sv-t0-mtec","@value":"Oblaci laserskih točaka iz leta 2023. Obuhvaća cijelu općinu Stockholm, uključujući tampon zonu oko nje. Format datoteke: LAS i POD. Visina leta: Gustoća vlaka: 16 pkt/m² Datum leta: . Referentni sustav u planu: Sweref 991800, u visini: RH2000 Laserski podaci, točkasti oblaci 2023.Točkasti oblak dolazi od laserskog skeniranja u zraku, koje je obavila Field Group, iznad grada Stockholma u razdoblju od 22. travnja ? 7. svibnja 2023. Kontrola pokrivenosti laserskim podacima provedena je vizualno i pomoću Terrascan softvera. Gustoća točke za ovaj projekt je > 16pkt/m2Klasifikacija tla ručno se kontrolira, dok je klasifikacija zgrade potpuno automatska i može biti različite kvalitete.Klasifikacija laserskih podataka podijeljena je u sljedeće razrede: ? 1 (Neklasificirano) ? 2 (Mark) ? 6 (zgrada) ? 7 (visoke i niske točke takozvane buke) ? 9 (Voda) ? Točnost u visini je 9 cm ili bolje za tvrde površine i 15 cm ili bolje za druge površine. U ravninama, točnost je 15 cm ili bolja. Oblak točke obojen je ortofotom iz 2023., što znači da je svakoj točki dodijeljena RGB vrijednost iz odgovarajućeg piksela u ortofotografiji. (Datum fotografije ortofotografije: i 7. svibnja 2023.)"},{"@language":"hu-t-sv-t0-mtec","@value":"Laser point clouds from flight 2023 (Lézerpontfelhők a 2023-as járatról). Stockholm teljes települését lefedi, beleértve a körülvevő pufferzónát is. Fájlformátum: LAS és POD. Repülési magasság: Nyitási sűrűség: 16 pkt/m² Járat dátuma: . Referenciarendszer a tervben: Sweref 991800, magassága: RH2000 Lézeradatok, pontfelhők 2023A pontfelhők légi lézerszkennelésből származnak, amelyet a Field Group végzett Stockholm városa felett április 22-én ? 2023. május 7. A lézeradatok lefedettségének ellenőrzését vizuálisan és Terrascan szoftverrel végeztük. Ennek a projektnek a pontsűrűsége > 16pkt/m2Az alaposztályozás manuálisan vezérelhető, míg az épületosztályozás teljesen automatikus és változó minőségű lehet.A lézeradatok osztályozása a következő osztályokra oszlik: ? - Igen. 1 (besorolatlan) ? 2 (Márk) ? 6 (épület) ? 7 (Magas és alacsony pontok, úgynevezett zaj) ? 9 (Víz) ? A magasság pontossága kemény felületek esetében 9 cm vagy jobb, más felületek esetében pedig 15 cm vagy jobb. Repülőgépeken a pontosság 15 cm vagy annál jobb. A pontfelhőt a 2023-as ortofotóval színezték, ami azt jelenti, hogy minden ponthoz hozzárendeltek egy RGB értéket az ortofotó megfelelő képpontjából. (Az ortofotó fényképezési dátuma: 2023. április 20. és május 7.)"},{"@language":"it-t-sv-t0-mtec","@value":"Nuvole di punti laser dal volo 2023. Copre l'intero comune di Stoccolma, compresa la zona cuscinetto intorno. Formato del file: LAS e POD. Altezza di volo: Densità di foratura: 16 pkt/m ² Data del volo: . Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000 Dati laser, nuvole di punti 2023La nuvola di punti proviene dalla scansione laser aerea, eseguita da Field Group, sulla città di Stoccolma nel periodo 22 aprile ? 7 maggio 2023. Il controllo della copertura dei dati laser è stato eseguito visivamente e con il software Terrascan. La densità del punto per questo progetto è > 16pkt/m2La classificazione del terreno è controllata manualmente mentre la classificazione dell'edificio è completamente automatica e può essere di qualità variabile.La classificazione dei dati laser è divisa nelle seguenti classi: ? 1 (non classificato) ? 2 (Marco) ? 6 (Edilizia) ? 7 (punti alti e bassi cosiddetto rumore) ? 9 (Acqua) ? La precisione in altezza è di 9 cm o migliore per le superfici dure e 15 cm o migliore per altre superfici. Negli aerei, la precisione è di 15 cm o superiore. La nuvola di punti è stata colorata utilizzando l'ortofoto 2023, il che significa che a ciascun punto è stato assegnato un valore RGB dal pixel corrispondente nell'ortofoto. (Data della fotografia dell'ortofoto: 20/4 e 7/5 2023)"},{"@language":"lt-t-sv-t0-mtec","@value":"2023 m. skrydžio lazerinių taškų debesys. Apima visą Stokholmo savivaldybę, įskaitant buferinę zoną aplink ją. Rinkmenos formatas: LAS ir POD. Skrydžio aukštis: punkcijos tankis: 16 pkt/m² Skrydžio data: . Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000 Lazeriniai duomenys, taškiniai debesys 2023Tiesioginiai debesys gaunami iš \"Field Group\" atlikto lazerinio skenavimo virš Stokholmo miesto per balandžio 22 d. \"?\" 2023 m. gegužės 7 d. Lazerių duomenų aprėpties kontrolė buvo atliekama vizualiai ir naudojant \"Terrascan\" programinę įrangą. Šio projekto taškų tankis yra > 16pkt/m2Žemės klasifikacija valdoma rankiniu būdu, o pastato klasifikacija yra visiškai automatinė ir gali būti įvairios kokybės.Lazerių duomenų klasifikavimas suskirstytas į šias klases: ? 1 (Neklasifikuotas) ? 2 (Žymėti) ? 6 (Statyba) ? 7 (aukšti ir žemi taškai, vadinamasis triukšmas) ? 9 (Vanduo) ? Kietų paviršių aukščio tikslumas yra 9 cm arba didesnis, o kitų paviršių - 15 cm arba didesnis. Plokštėse tikslumas yra 15 cm arba didesnis. Taškų debesis nuspalvintas naudojant 2023 m. ortofotografiją, o tai reiškia, kad kiekvienam taškui priskirta RGB vertė iš atitinkamo ortofotografijoje esančio pikselio. (Ortofotografijos data: 2023 m. balandžio 20 d. ir gegužės 7 d.)"},{"@language":"lv-t-sv-t0-mtec","@value":"Lāzera punktu mākoņi no 2023. gada lidojuma. Aptver visu Stokholmas pašvaldību, tostarp apkārt esošo buferzonu. Datnes formāts: LAS un POD. Lidojuma augstums: Punktu blīvums: 16 pkt/m² Lidojuma datums: . Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000 Lāzera dati, punktu mākoņi 2023Punktu mākonis nāk no lidaparāta lāzera skenēšanas, ko veica Field Group Stokholmas pilsētā laika posmā no 22. aprīļa ? 2023. gada 7. maijs. Lāzera datu pārklājuma kontrole tika veikta vizuāli un ar Terrascan programmatūru. Punktu blīvums šim projektam ir > 16pkt/m2Zemes klasifikācija tiek kontrolēta manuāli, bet ēku klasifikācija ir pilnībā automātiska un var būt dažādas kvalitātes.Lāzera datu klasifikācija ir sadalīta šādās klasēs: ? 1 (neklasificēts) ? 2 (Mark) ? 6 (Building) ? 7 (Augsts un zems punktu tā sauktais troksnis) ? 9 (Ūdens) ? Augstuma precizitāte ir 9 cm vai labāka cietām virsmām un 15 cm vai labāka citām virsmām. Lidmašīnās precizitāte ir 15 cm vai labāka. Punktu mākonis ir krāsots, izmantojot 2023. gada ortofoto, kas nozīmē, ka katram punktam ir piešķirta RGB vērtība no atbilstošā pikseļa ortofoto. (Ortofotoattēla uzņemšanas datums: (2023. gada 20./4. un 7./5.)"},{"@language":"mt-t-sv-t0-mtec","@value":"Sħubiji ta’ punti tal-laser mit-titjira 2023. Tkopri l-muniċipalità kollha ta’ Stokkolma inkluża ż-żona ta’ lqugħ madwarha. Format tal-fajl: il-LAS u l-POD. Għoli tat-titjira:Densità tat-titjira: 16 pkt/m² Data tat-titjira: . Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000 Data tal-laser, sħab tal-punt 2023Is-sħab tal-punt ġej minn skennjar bil-laser fl-ajru, imwettaq minn Field Group, fuq il-Belt ta' Stokkolma matul il-perjodu tat-22 ta' April ? 7 ta’ Mejju 2023. Il-kontroll tal-kopertura tad-data tal-laser twettaq viżwalment u bis-software Terrascan. Id-densità tal-punt għal dan il-proġett hija > 16pkt/m2Il-klassifikazzjoni tal-art hija kkontrollata manwalment filwaqt li l-klassifikazzjoni tal-bini hija kompletament awtomatika u tista’ tkun ta’ kwalità li tvarja.Il-klassifikazzjoni tad-data tal-laser hija maqsuma fil-klassijiet li ġejjin: ? 1 (Mhux klassifikat) ? 2 (Mark) ? 6 (Bini) ? 7 (Punti għoljin u baxxi hekk imsejħa storbju) ? 9 (Ilma) ? L-akkuratezza fl-għoli hija 9 cm jew aħjar għal uċuħ ibsin u 15 cm jew aħjar għal uċuħ oħra. Fil-pjan, il-preċiżjoni hija 15 cm jew aħjar. Is-sħaba tal-punt ġiet ikkulurita bl-użu tal-ortofoto tal-2023, li jfisser li kull punt ġie assenjat valur RGB mill-pixel korrispondenti fl-ortofoto. (Data tal-fotografija tal-ortofoto: 20/4 u 7/5 2023)"},{"@language":"nl-t-sv-t0-mtec","@value":"Laserpuntwolken vanaf vlucht 2023. Dekt de hele gemeente Stockholm incl bufferzone rond. Bestandsformaat: LAS en POD. Vluchthoogte: Punctuurdichtheid: 16 pkt/m² Vluchtdatum: . Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000 Lasergegevens, puntwolken 2023De puntwolk is afkomstig van laserscanning in de lucht, uitgevoerd door Field Group, boven de stad Stockholm tijdens de periode 22 april ? 7 mei 2023. Dekkingscontrole van lasergegevens werd visueel en met Terrascan-software uitgevoerd. De puntdichtheid voor dit project is > 16pkt/m2De grondclassificatie wordt handmatig geregeld terwijl de gebouwclassificatie volledig automatisch is en van verschillende kwaliteit kan zijn. ? 1 (Niet geclassificeerd) ? 2 (Mark) ? 6 (gebouw) ? 7 (Hoge en lage punten zogenaamde ruis) ? 9 (Water) ? De nauwkeurigheid in hoogte is 9 cm of beter voor harde oppervlakken en 15 cm of beter voor andere oppervlakken. In vliegtuigen is de nauwkeurigheid 15 cm of beter. De puntenwolk is gekleurd met de orthofoto van 2023, wat betekent dat elk punt een RGB-waarde heeft gekregen van de overeenkomstige pixel in de orthofoto. (Fotografie datum van de orthofoto: 20/4 en 7/5 2023)"},{"@language":"pl-t-sv-t0-mtec","@value":"Laserowe chmury punktów z lotu 2023. Obejmuje całą gminę Sztokholm, w tym strefę buforową wokół. Format pliku: LAS i POD. Wysokość lotu: Gęstość otworów: 16 pkt/m² Data lotu: . System odniesienia w planie: Sweref 991800, wysokość: Dane laserowe RH2000, chmury punktów 2023Chmura punktów pochodzi z lotniczego skanowania laserowego przeprowadzonego przez Field Group nad miastem Sztokholm w okresie 22 kwietnia ? 7 maja 2023 r. Kontrola pokrycia danych laserowych została przeprowadzona wizualnie i za pomocą oprogramowania Terrascan. Gęstość punktów dla tego projektu wynosi > 16pkt / m2Klasyfikacja podłoża jest sterowana ręcznie, podczas gdy klasyfikacja budynku jest w pełni automatyczna i może mieć różną jakość.Klasyfikacja danych laserowych jest podzielona na następujące klasy: ? 1 (Niesklasyfikowany) ? 2 (znak) ? 6 (Budynek) ? 7 (Wysokie i Niskie punkty tzw. noise) ? 9 (woda) ? Dokładność wysokości wynosi 9 cm lub lepiej dla twardych powierzchni i 15 cm lub lepiej dla innych powierzchni. W samolotach dokładność wynosi 15 cm lub więcej. Chmura punktów została zabarwiona za pomocą ortofotomapy 2023, co oznacza, że każdemu punktowi przypisano wartość RGB z odpowiedniego piksela na ortofotomapie. (Data zdjęcia ortofotomapy: 20 kwietnia i 7 maja 2023 r.)"},{"@language":"pt-t-sv-t0-mtec","@value":"Nuvens de ponto laser do voo 2023. Abrange todo o município de Estocolmo, incluindo a zona tampão circundante. Formato do ficheiro: LAS e POD. Altura de voo: Densidade da punção: 16 pkt/m² Data do voo: . Sistema de referência no plano: Sweref 991800, em altura: RH2000 Dados laser, nuvens de pontos 2023A nuvem de pontos vem da varredura a laser no ar, realizada pelo Field Group, sobre a cidade de Estocolmo durante o período 22 de abril ? 7 de maio de 2023. O controlo da cobertura dos dados a laser foi realizado visualmente e com o software Terrascan. A densidade de ponto para este projeto é > 16pkt/m2A classificação do solo é controlada manualmente, enquanto a classificação do edifício é totalmente automática e pode ser de qualidade variável.Classificação de dados a laser é dividida nas seguintes classes: ? 1 (não classificado) ? 2 (Marca) ? 6 (Edifício) ? 7 (Pontos altos e baixos chamados ruído) ? 9 (Água) ? A precisão na altura é 9 cm ou melhor para superfícies duras e 15 cm ou melhor para outras superfícies. Em aviões, a precisão é de 15 cm ou melhor. A nuvem de pontos foi colorida utilizando a ortofotografia de 2023, o que significa que a cada ponto foi atribuído um valor RGB a partir do pixel correspondente na ortofotografia. (Data da fotografia da ortofotografia: 20/4 e 7/5 2023)"},{"@language":"ro-t-sv-t0-mtec","@value":"Nori de puncte laser de la zborul 2023. Acoperă întreaga municipalitate Stockholm, inclusiv zona tampon din jur. Formatul fișierului: LAS și POD. Înălțimea de zbor: Densitatea puncturii: 16 pkt/m² Data zborului: . Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000 Date laser, nori de puncte 2023Norul de puncte provine din scanarea cu laser în aer, efectuată de Field Group, deasupra orașului Stockholm în perioada 22 aprilie ? 7 mai 2023. Controlul acoperirii datelor laser a fost efectuat vizual și cu software-ul Terrascan. Densitatea punctului pentru acest proiect este > 16pkt / m2Clasificarea la sol este controlată manual, în timp ce clasificarea clădirii este complet automată și poate fi de calitate variabilă.Clasificarea datelor laser este împărțită în următoarele clase: ? 1 (neclasificată) ? 2 (Mark) ? 6 (Clădire) ? 7 (Puncte înalte și joase, așa-numitul zgomot) ? 9 (Apă) ? Precizia în înălțime este de 9 cm sau mai bună pentru suprafețele dure și de 15 cm sau mai bună pentru alte suprafețe. În avioane, precizia este de 15 cm sau mai bună. Norul de puncte a fost colorat utilizând ortofoto 2023, ceea ce înseamnă că fiecărui punct i s-a atribuit o valoare RGB de la pixelul corespunzător din ortofoto. (Data fotografiei ortofoto: 20/4 și 7/5 2023)"},{"@language":"sk-t-sv-t0-mtec","@value":"Laserové bodové oblaky z letu 2023. Zahŕňa celú obec Štokholm vrátane nárazníkovej zóny v okolí. Formát súboru: LAS a POD. Výška letu: Hustota prieniku: 16 pkt/m² Dátum letu: . Referenčný systém v pláne: Sweref 991800, na výšku: RH2000 Laserové dáta, bodové oblaky 2023 Bodový oblak pochádza z leteckého laserového skenovania, ktoré vykonala Field Group nad mestom Štokholm v období od 22. apríla ? 7. mája 2023. Kontrola pokrytia laserových dát bola vykonaná vizuálne a so softvérom Terrascan. Bodová hustota pre tento projekt je > 16pkt/m2Klasifikácia terénu je manuálne riadená, zatiaľ čo klasifikácia budov je plne automatická a môže mať rôznu kvalitu.Klasifikácia laserových údajov je rozdelená do nasledujúcich tried: ? 1 (neklasifikované) ? 2 (Mark) ? 6 (budova) ? 7 (vysoké a nízke body, tzv. hluk) ? 9 (voda) ? Presnosť výšky je 9 cm alebo lepšia pre tvrdé povrchy a 15 cm alebo lepšia pre iné povrchy. V lietadlách je presnosť 15 cm alebo lepšia. Bodový oblak bol zafarbený pomocou ortofotografie 2023, čo znamená, že každému bodu bola priradená hodnota RGB zo zodpovedajúceho pixelu v ortofotografii. (Dátum ortofotografie: a 7. mája 2023)"},{"@language":"sl-t-sv-t0-mtec","@value":"Laserski oblaki točk iz leta 2023. Zajema celotno občino Stockholm, vključno z varovalnim pasom. Oblika datoteke: LAS in POD. Višina leta: gostota priključka: 16 pkt/m² Datum leta: . Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000 Laserski podatki, oblaki točk 2023Oblak točk prihaja iz laserskega skeniranja v zraku, ki ga je izvedla Field Group nad mestom Stockholm v obdobju 22. aprila ? 7. maj 2023. Nadzor pokritosti laserskih podatkov je bil opravljen vizualno in s programsko opremo Terrascan. Gostota točk za ta projekt je > 16pkt/m2Klasifikacija tal je ročno nadzorovana, klasifikacija stavb pa je popolnoma avtomatska in je lahko različne kakovosti.Razvrščanje laserskih podatkov je razdeljeno na naslednje razrede: ? 1 (nerazvrščeno) ? 2 (oznaka) ? 6 (Gradnja) ? 7 (Visoke in nizke točke, tako imenovani hrup) ? 9 (Voda) ? Natančnost višine je 9 cm ali boljša za trde površine in 15 cm ali boljša za druge površine. V ravninah je natančnost 15 cm ali boljša. Oblak točk je bil obarvan z ortofoto posnetkom za leto 2023, kar pomeni, da je bila vsaki točki dodeljena vrednost RGB iz ustrezne slikovne pike v ortofoto posnetku. (Fotografski datum ortofoto posnetka: in 7. maj 2023)"},{"@language":"sv","@value":"Laserpunktmoln från flygning 2023. Täcker hela Stockholms kommun inkl buffertzon runt. Filformat: LAS och POD. Flyghöjd:Punkttäthet: 16 pkt/m² Flygdatum: . Referenssytem i plan: Sweref 991800, i höjd: RH2000 Laserdata, punktmoln 2023Punktmolnet kommer från flygburen laserskanning, utförd av Field Group, över Stockholms stad under perioden 22 april ? 7 maj 2023. Täckningskontroll av laserdata utfördes visuellt och med programvaran Terrascan. Punkttätheten för detta projekt är > 16pkt/m2Markklassificeringen är manuellt kontrollerad medan byggnadsklassningen är helt automatiskt utförd och kan vara av varierande kvalitet.Klassning av laserdata delas upp i följande klasser: ? 1 (Oklassificerat) ? 2 (Mark) ? 6 (Byggnad) ? 7 (Hög- och Lågpunkter sk. brus) ? 9 (Vatten) ? 17 (Broar)Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre. Punktmolnet har färgsatts med hjälp av ortofotot från 2023, vilket innebär att varje punkt har tilldelats ett RGB-värde från motsvarande pixel i ortofotot. (Fotograferingsdatum för ortofotot: 20/4 och 7/5 2023)"},{"@language":"uk-t-sv-t0-mtec","@value":"Лазерні точкові хмари з польоту 2023 року. Охоплює весь муніципалітет Стокгольма, включаючи буферну зону навколо. Формат файлу: LAS і POD. Висота польоту:Щільність проколу: * 16 pkt/m² Дата польоту: . Референтна система в плані: Свереф 991800, по висоті: * Дані RH2000 Laser, хмари точок 2023 Хмара точок походить від повітряного лазерного сканування, проведеного Field Group, над містом Стокгольм у період 22 квітня ? 7 травня 2023 року. Управління покриттям лазерних даних здійснювалося візуально та за допомогою програмного забезпечення Terrascan. Точкова щільність для цього проекту > 16пкт/м2Класифікація заземлення контролюється вручну, тоді як класифікація будівлі повністю автоматична і може бути різної якості.Класизація лазерних даних поділяється на наступні класи: ? * 1 (некласифікований) ? * 2 (позначити) ? * 6 (Будівництво) ? 7 (Високі та низькі точки так званого шуму) ? * 9 (Вода) ? Точність по висоті становить 9 см або краще для твердих поверхонь і 15 см або краще для інших поверхонь. У площинах точність становить 15 см або краще. Хмара точок була забарвлена за допомогою ортофотоплану 2023 року, що означає, що кожній точці було присвоєно значення RGB з відповідного пікселя ортофотоплану. (Дата фотозйомки ортофотоплану: 20/4 та 7/5 2023)"}],"dct:format":"text/html","dct:identifier":"a0f9b145-f0ba-49f6-9191-2995f3c8a32e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b0n0"},"dct:temporal":{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Point Cloud — Въздушно лазерно сканиране (2023 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Point Cloud - letecké laserové skenování (2023)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Point Cloud - luftbåren laserscanning (2023)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Point Cloud - Luftgestütztes Laserscanning (2023)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Point Cloud - Αερομεταφερόμενη σάρωση με λέιζερ (2023)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Point Cloud - Escaneo láser aerotransportado (2023)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Point Cloud – õhus toimuv laserskaneerimine (2023)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"fr-t-sv-t0-mtec","@