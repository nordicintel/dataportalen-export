tion":{"@id":"http://data.europa.eu/88u/distribution/eea03b11-29f6-450a-a859-658373508287"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"16fa6998-8dbb-4c3f-a7cc-bfac23f63a03","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:14Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/16fa6998-8dbb-4c3f-a7cc-bfac23f63a03"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:41f20cdc19739431ce77670aa80635920d9805114636edd0816c04b0015a70b6_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/16fa6998-8dbb-4c3f-a7cc-bfac23f63a03"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:14Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"16fa6998-8dbb-4c3f-a7cc-bfac23f63a03","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/16fa6998-8dbb-4c3f-a7cc-bfac23f63a03"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:41f20cdc19739431ce77670aa80635920d9805114636edd0816c04b0015a70b6"},{"@graph":[{"@id":"_:42ac077bc0410a8c631bfb70919a83aef79d67be8bac5777241d85b030bf8842_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Information:Produktspecfikation/2"},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Nedladdning:data/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=269cb7f1-fdb3-43de-aed0-db3ed047162b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":{"@language":"sv","@value":"Baskartan är ett storskaligt och tredimensionellt digitalt kartverk med hög noggrannhet som redovisar de grundläggande geografiska och administrativa förhållandena i Stockholms stad. Kartans information lagras i plan med x, y koordinater och i höjd med z-värden. Kartan redovisar bland annat byggnader, vägar, träd, samt höjdinformation. Kartan används främst i skalområdet från 1:400 till 1:2000. I många kommuner kallas Baskartan också för Primärkartan.Baskartan används i många olika sammanhang som bakgrundskarta, där verksamhetsspecifik information läggs till för att skapa en för syftet anpassad karta. Det kan röra sig om grundkartor, nybyggnadskartor, bygglovskartor, stompunktskartor, förrättningskartor, inventeringskartor etc. Insamlingen av information till Baskartan har pågått under många år och med olika metoder. Det innebär att kvaliteten varierar, men det sker en succesiv kvalitetsförbättring över tid. All information kvalitetsmärks med ursprung, tidpunkt och insamlingsmetod vid lagringen i databasen. Det finns flera olika kartprodukter som kan exporteras ur Baskartan och levereras till kunder. Flera av kartprodukterna innehåller fastighetsinformation. Fastighetsinformationen tillhör egentligen Registerkartan. Det gäller också för stompunkter som också är nära relaterade till Baskartan men som utgör ett eget dataset. Stadsbyggnadskontoret använder olika klientprogramvaror (ex dpMap, MicroStation, StockholmExport) för att extrahera, exportera och leverera information från Baskartan till kunder.Kartinformationen publiceras också via ett antal karttjänster, s.k. WMS tjänster.."},"dct:identifier":"f9710b3f-401b-4c88-8138-2cd57408b104","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:42ac077bc0410a8c631bfb70919a83aef79d67be8bac5777241d85b030bf8842_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta (1:400 - 1:2000)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Information:Produktspecfikation/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_Baskarta_DWG.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Produktspecifikation"},{"@id":"https://resources.stockholm.se/data/f9710b3f-401b-4c88-8138-2cd57408b104#HTTP:Nedladdning:data/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Baskarta_DWG.dgn"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Testdata DWG-format"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:42ac077bc0410a8c631bfb70919a83aef79d67be8bac5777241d85b030bf8842"},{"@graph":[{"@id":"_:4331f06ae5baf7d09189a12a3c6b2a1ddead88bc4891e74649ab52452db4e9fa_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:4331f06ae5baf7d09189a12a3c6b2a1ddead88bc4891e74649ab52452db4e9fa_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2012-05-08"},"dcat:startDate":{"@type":"xsd:date","@value":"2012-05-01"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2012-05-08"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2012-05-01"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/799d13f9-68ae-4b9d-927a-b0b022bdc7a3","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/799d13f9-68ae-4b9d-927a-b0b022bdc7a3#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/799d13f9-68ae-4b9d-927a-b0b022bdc7a3#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/799d13f9-68ae-4b9d-927a-b0b022bdc7a3#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=86fe674c-8a50-4ece-8b5b-b6e8a09d1e57"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2012-05-08"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1300 mUpplösning: 8 cm/pixel. Fotograferingsdatum: 1,2 och 8 maj 2012. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"799d13f9-68ae-4b9d-927a-b0b022bdc7a3","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:4331f06ae5baf7d09189a12a3c6b2a1ddead88bc4891e74649ab52452db4e9fa_b0n0"},"dct:temporal":{"@id":"_:4331f06ae5baf7d09189a12a3c6b