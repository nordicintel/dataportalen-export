8.2011 59.4403,18.2011 59.2272,17.7605 59.2272,17.7605 59.4403))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4403,18.2011 59.4403,18.2011 59.2272,17.7605 59.2272,17.7605 59.4403))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":[{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Naturinventeringar"},{"@language":"sv","@value":"Stadsmiljö"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=Miljodata0001"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2019-12-31"},"dct:description":{"@language":"sv","@value":"Biotopdatabasen från 2019. Biotopkarteringen är både en metodik och en biotopdatabas som visar naturens egenskaper och markanvändning. Syftet är att underlaget ska användas för analyser av natur, ekosystemtjänster och gröna infrastruktur. Bygger på en hybridmetod i flera steg, omfattande bl a semiautomatiska klassningar från fjärranalys och nationella data samt flygbildstolkning av IR-bilder. Karteringen är utförd av Stockholms Universitet (Institutionen för naturgeografi) samt Calluna AB."},"dct:identifier":"f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:86715edf8cb61c45d0d890ef56a71907d94c47c958b15d3a4b947982fa2ccc42_b0n0"},"dct:title":{"@language":"sv","@value":"Biotopdatabasen 2019"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/b89445e6ffab414bb1fca76b1a361496_49"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens Öppna data-hub"},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:86715edf8cb61c45d0d890ef56a71907d94c47c958b15d3a4b947982fa2ccc42"},{"@graph":[{"@id":"_:89aaa98594f1f318e356abe3ea32efca6af0123ad4fa10074efbc4008eb46279_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:89aaa98594f1f318e356abe3ea32efca6af0123ad4fa10074efbc4008eb46279_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1656354f9a194a518e71290d8f5ace2346"},{"@id":"http://data.europa.eu/88u/dataset/340a9ec7-290e-48bb-8e89-2615959f26df","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/04d9d022-dbc1-456f-a596-ba9059961499"},{"@id":"http://data.europa.eu/88u/distribution/42fdf909-c074-4c1f-9f5f-60201bfeb202"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=69c8b476-f401-417a-970c-59812266af9b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2021-02-11"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Съдържа следи от стъпки до дървесни корони в рамките на град Стокхолм. Файлът е създаден от лазерна точка облак данни с помощта на TerraScan софтуер. Различни скриптове са изпълнявани на лазерни точки 1. точковите облачни данни са класифицирани според това дали принадлежат към земя, сгради / мостове и други2. След това, използвайки различни скриптове, избрани обекти, подобни на дърво 3. След това групира тези точки в отделни дървета 4. След това създава многоъгълник за всяко дърво, представляващ отпечатъка на дървото върху земята 5. Данните са прегледани ръчно, като е използвана ортофотоснимка от 2022 г., за да се отстранят неправилно идентифицираните дървесни полигони. Изчерпателно количество данни в целия град Стокхолм. Ограничения: Използваните лазерни данни са от 2022 г. Като цяло наборът от данни съдържа само дървета, които са с площ над 3 кв.м и височина най-малко 2,0 метра. Известни аномалии: Качеството е по-високо за иглолистните дървета, отколкото за широколистните, тъй като лазерното сканиране се извършва преди пукнатината и в широколистните дървета има по-малко лазерно отразяваща биомаса. Новозасадените широколистни дървета и дърветата с твърда култура понякога не са включени в точковия облак и следователно нямат отпечатък. Широколистните дървета понякога могат да бъдат разделени на няколко стъпки."},{"@language":"cs-t-sv-t0-mtec","@value":"Obsahuje stopy na korunách stromů ve Stockholmu. Soubor je vytvořen z laserových cloudových dat pomocí softwaru TerraScan. Na laserových bodech byly spuštěny různé skripty 1. Data z bodového oblaku byla klasifikována podle toho, zda patří k pozemkům, budovám/mostům a dalším2. Poté pomocí různých skriptů vybrali objekty podobné stromu 3. pak seskupili tyto body do jednotlivých stromů 4. pak vytvořili polygon pro každý strom reprezentující stopu stromu na zemi 5. Údaje byly ručně přezkoumány pomocí ortofotosnímku z roku 2022 s cílem odstranit nesprávně identifikované stromové polygony. Komplexní množství dat po celém městě Stockholm. Omezení: Použitá laserová data jsou z roku 2022. Soubor dat obecně obsahuje pouze stromy, které jsou větší než 3 m2 a alespoň 2,0 metru vysoké. Známé anomálie: Kvalita je vyšší u jehličnanů než u listnatých stromů, protože laserové skenování se provádí před prasklinou a v listnatých stromech je méně biomasy odrážející laser. Nově vysázené listnaté stromy a stromy s tvrdými plodinami nejsou někdy zahrnuty do bodového oblaku, a proto nemají stopu. Opadavé stromy mohou být někdy rozděleny do několika stop."},{"@language":"da-t-sv-t0-mtec","@value":"Indeholder fodspor til trækroner i Stockholm. Filen oprettes ud fra laserpunktskydata ved hjælp af TerraScan-software. Forskellige scripts er blevet kørt på laserpunkter 1. punkt cloud data er blevet klassificeret efter, om de tilhører jord, bygninger / broer og andre2. Derefter ved hjælp af forskellige scripts, valgte objekter svarende til træ 3. derefter grupperet disse punkter i individuelle træer 4. derefter skabt en polygon for hvert træ repræsenterer træets fodaftryk på jorden 5. Dataene blev gennemgået manuelt ved hjælp af 2022-ortofoto for at fjerne ukorrekt identificerede træpolygoner. Omfattende datamængde på tværs af byen Stockholm. Begrænsninger: De anvendte laserdata er fra 2022. Generelt indeholder datasættet kun træer, der er mere end 3 kvm og mindst 2,0 meter høje. Kendte uregelmæssigheder: Kvaliteten er højere for nåletræer end for løvtræer, fordi laserscanning udføres før revnen, og der er mindre laserreflekterende biomasse i løvtræerne. Nyplantede løvtræer og træer med hårde afgrøder er nogle gange ikke inkluderet i punktskyen og har derfor ikke et fodaftryk. Løvfældende træer kan undertiden opdeles i flere fodspor."},{"@language":"de-t-sv-t0-mtec","@value":"Enthält Fußspuren zu Baumkronen innerhalb der Stadt Stockholm. Die Datei wird aus Laserpunktwolkendaten mit der TerraScan-Software erstellt. Verschiedene Skripte wurden auf Laserpunkten ausgeführt 1. Punktwolkendaten wurden danach klassifiziert, ob sie zu Land, Gebäuden/Brücken und anderen gehören2. Mit verschiedenen Skripten wurden dann Objekte ausgewählt, die Baum 3 ähneln, und diese Punkte in einzelne Bäume gruppiert 4. Dann wurde für jeden Baum ein Polygon erstellt, das den Fußabdruck des Baumes auf dem Boden darstellt 5. Die Daten wurden manuell mit Orthofoto 2022 überprüft, um falsch identifizierte Baumpolygone zu entfernen. Umfassende Datenmenge über die Stadt Stockholm. Einschränkungen: Die verwendeten Laserdaten stammen aus dem Jahr 2022. Im Allgemeinen enthält der Datensatz nur Bäume, die mehr als 3 qm groß und mindestens 2,0 Meter hoch sind. Bekannte Anomalien: Die Qualität ist bei Nadelbäumen höher als bei Laubbäumen, da Laserscans vor der Fissur durchgeführt werden und weniger laserreflektierende Biomasse in den Laubbäumen vorhanden ist. Neu gepflanzte Laubbäume und Hartkulturbäume sind manchmal nicht in der Punktwolke enthalten und haben daher keinen Fußabdruck. Laubbäume können manchmal in mehrere Fußspuren unterteilt werden."},{"@language":"el-t-sv-t0-mtec","@value":"Περιέχει πατημασιές σε κορώνες δέντρων εντός της πόλης της Στοκχόλμης. Το αρχείο δημιουργείται από δεδομένα cloud σημείου λέιζερ χρησιμοποιώντας το λογισμικό TerraScan. Διαφορετικές δέσμες ενεργειών έχουν εκτελεστεί σε σημεία λέιζερ 1. Τα δεδομένα υπολογιστικού νέφους σημείου έχουν ταξινομηθεί ανάλογα με το αν ανήκουν σε γη, κτίρια/γέφυρες και άλλα2. Στη συνέχεια, χρησιμοποιώντας διάφορα σενάρια, επιλεγμένα αντικείμενα παρόμοια με το δέντρο 3. Στη συνέχεια ομαδοποιήθηκαν αυτά τα σημεία σε μεμονωμένα δέντρα 4. Στη συνέχεια, δημιουργήθηκε ένα πολύγωνο για κάθε δέντρο που αντιπροσωπεύει το αποτύπωμα του δέντρου στο έδαφος 5. Τα δεδομένα εξετάστηκαν χειροκίνητα με τη χρήση ορθοφωτογραφιών του 2022 για την αφαίρεση εσφαλμένα ταυτοποιημένων πολυγώνων δένδρων. Συνολικός όγκος δεδομένων σε ολόκληρη την πόλη της Στοκχόλμης. Περιορισμοί: Τα δεδομένα λέιζερ που χρησιμοποιούνται είναι από το 2022. Γενικά, το σύνολο δεδομένων περιέχει μόνο δέντρα που είναι πάνω από 3 τμ και τουλάχιστον 2,0 μέτρα ύψος. Γνωστές ανωμαλίες: Η ποιότητα είναι υψηλότερη για τα κωνοφόρα από ό, τι για τα φυλλοβόλα δέντρα, επειδή η σάρωση με λέιζερ πραγματοποιείται πριν από τη σχισμή και υπάρχει λιγότερη βιομάζα που αντανακλά το λέιζερ στα φυλλοβόλα δέντρα. Τα νεοφυτεμένα φυλλοβόλα δέντρα και τα δέντρα σκληρής καλλιέργειας μερικές φορές δεν περιλαμβάνονται στο σύννεφο σημείων και, ως εκ τούτου, δεν έχουν αποτύπωμα. Τα φυλλοβόλα δέντρα μπορούν μερικές φορές να χωριστούν σε διάφορα αποτυπώματα."},{"@language":"en-t-sv-t0-mtec","@value":"Contains footprints to tree crowns within the City of Stockholm. The file is created from laser point cloud data using TerraScan software. Different scripts have been run on laser points 1. point cloud data has been classified according to whether they belong to land, buildings/bridges and others2. Then, using various scripts, selected objects similar to tree 3. then grouped these points into individual trees 4. then created a polygon for each tree representing the tree's footprint on the ground 5. Data were manually reviewed using 2022 orthophoto to remove incorrectly identified tree polygons. Comprehensive data amount across the city of Stockholm. Limitations: The laser data used is from 2022. Generally, the data set contains only trees that are more than a 3 sqm and at least 2.0 meters high. Known anomalies: The quality is higher for conifers than for deciduous trees because laser scanning is carried out before the fissure and there is less laser-reflecting biomass in the deciduous trees. Newly planted deciduous trees and hard-crop trees are sometimes not included in the point cloud and therefore do not have a footprint. Deciduous trees can sometimes be divided into several footprints."},{"@language":"es-t-sv-t0-mtec","@value":"Contiene huellas de coronas de árboles dentro de la ciudad de Estocolmo. El archivo se crea a partir de datos de nube de puntos láser utilizando el software TerraScan. Se han ejecutado diferentes scripts en los puntos láser 1. Los datos de nubes de puntos se han clasificado según si pertenecen a terrenos, edificios / puentes y otros2. Luego, utilizando varios scripts, se seleccionaron objetos similares al árbol 3. luego se agruparon estos puntos en árboles individuales 4. luego se creó un polígono para cada árbol que representa la huella del árbol en el suelo 5. Los datos se revisaron manualmente utilizando la ortofoto de 2022 para eliminar polígonos de árboles identificados incorrectamente. Cantidad de datos completa en toda la ciudad de Estocolmo. Limitaciones: Los datos láser utilizados son de 2022. En general, el conjunto de datos contiene solo árboles de más de 3 metros cuadrados y al menos 2,0 metros de altura. Anomalías conocidas: La calidad es mayor para las coníferas que para los árboles caducifolios porque el escaneo láser se lleva a cabo antes de la fisura y hay menos biomasa que refleja el láser en los árboles caducifolios. Los árboles caducifolios recién plantados y los árboles de cultivos duros a veces no se incluyen en la nube de puntos y, por lo tanto, no tienen huella. Los árboles caducifolios a veces se pueden dividir en varias huellas."},{"@language":"et-t-sv-t0-mtec","@value":"Sisaldab jalajälgi puukroonidele Stockholmi linnas. Fail luuakse TerraScani tarkvara abil laserpunktpilve andmetest. Laserpunktides on kasutatud erinevaid skripte 1. punktpilve andmed on klassifitseeritud vastavalt sellele, kas need kuuluvad maale, hoonetele/sildadele ja teistele2. Siis, kasutades erinevaid skripte, valitud objektid sarnane puu 3 siis rühmitatud need punktid üksikute puud 4. siis loodud hulknurk iga puu esindab puu jalajälg maapinnal 5. Andmed vaadati käsitsi läbi, kasutades 2022. aasta ortofotot, et eemaldada valesti identifitseeritud puu hulknurgad. Põhjalik andmete hulk kogu Stockholmi linnas. Piirangud: Kasutatavad laserandmed pärinevad 2022. aastast. Üldiselt sisaldab andmekogum ainult puid, mis on üle 3 m2 ja vähemalt 2,0 meetri kõrgused. Teadaolevad kõrvalekalded: Okaspuude kvaliteet on kõrgem kui lehtpuudel, sest laserskaneerimine toimub enne lõhenemist ja lehtpuudes on vähem laserpeegeldavat biomassi. Äsja istutatud lehtpuud ja kõvakultuurilised puud ei kuulu mõnikord punktpilve ja seetõttu ei ole neil jalajälge. Heitlehised puud võib mõnikord jagada mitmeks jalajäljeks."},{"@language":"fi-t-sv-t0-mtec","@value":"Sisältää jalanjälkiä puukruunuihin Tukholman kaupungin sisällä. Tiedosto luodaan laserpistepilvidatasta TerraScan-ohjelmistolla. Laserpisteille on ajettu erilaisia komentosarjoja 1. pistepilvitiedot on luokiteltu sen mukaan, kuuluvatko ne maahan, rakennuksiin/siltoihin ja muihin2. Sitten eri skriptejä käyttäen valitut puun 3 kaltaiset kohteet ryhmittelivät nämä pisteet yksittäisiksi puiksi 4. sitten loivat monikulmion jokaiselle puulle, joka edustaa puun jalanjälkeä maassa 5. Tiedot tarkistettiin manuaalisesti käyttämällä vuoden 2022 ortokuvaa virheellisesti tunnistettujen puun polygonien poistamiseksi. Kattava tietomäärä koko Tukholman kaupungissa. Rajoitukset: Käytetyt lasertiedot ovat vuodelta 2022. Yleensä tietojoukko sisältää vain puita, jotka ovat yli 3 neliömetriä ja vähintään 2,0 metriä korkeita. Tunnetut poikkeamat: Havupuiden laatu on korkeampi kuin lehtipuiden, koska laserkeilaus suoritetaan ennen halkeamaa ja lehtipuissa on vähemmän laseria heijastavaa biomassaa. Hiljattain istutetut lehtipuut ja kovat puut eivät aina sisälly pistepilveen, joten niillä ei ole jalanjälkeä. Lehtipuut voidaan joskus jakaa useisiin jalanjälkiin."},{"@language":"fr-t-sv-t0-mtec","@value":"Contient des empreintes de pas sur les couronnes d'arbres dans la ville de Stockholm. Le fichier est créé à partir de données de nuage de points laser à l'aide du logiciel TerraScan. Différents scripts ont été exécutés sur des points laser 1. Les données de nuages de points ont été classées selon qu'elles appartiennent à des terrains, à des bâtiments/ponts et à d'autres2. Ensuite, en utilisant divers scripts, des objets sélectionnés similaires à l'arbre 3. puis regroupés ces points dans des arbres individuels 4. puis créé un polygone pour chaque arbre représentant l'empreinte de l'arbre sur le sol 5. Les données ont été examinées manuellement à l'aide de l'orthophoto de 2022 pour éliminer les polygones d'arbres mal identifiés. Quantité de données complète à travers la ville de Stockholm. Limitations : Les données laser utilisées datent de 2022. Généralement, l'ensemble de données ne contient que des arbres de plus de 3 m2 et d'au moins 2,0 mètres de haut. Anomalies connues: La qualité est plus élevée pour les conifères que pour les arbres à feuilles caduques, car le balayage laser est effectué avant la fissure et il y a moins de biomasse réfléchissante au laser dans les arbres à feuilles caduques. Les arbres à feuilles caduques nouvellement plantés et les arbres à cultures dures ne sont parfois pas inclus dans le nuage de points et n'ont donc pas d'empreinte. Les arbres caducs peuvent parfois être divisés en plusieurs empreintes de pas."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá loirg ar choróin na gcrann laistigh de Chathair Stócólm. Cruthaítear an comhad ó shonraí scamall pointe léasair ag baint úsáide as bogearraí TerraScan. Tá scripteanna éagsúla á reáchtáil ar phointí léasair 1. Tá sonraí scamall pointe aicmithe de réir cibé an mbaineann siad le talamh, foirgnimh / droichid agus daoine eile2. Ansin, ag baint úsáide as scripteanna éagsúla, rudaí roghnaithe cosúil le crann 3. ansin grúpáil na pointí seo i gcrainn aonair 4. ansin chruthaigh sé polagán do gach crann a léiríonn lorg an chrainn ar an talamh 5. Rinneadh athbhreithniú de láimh ar shonraí trí úsáid a bhaint as ortaphoto 2022 chun polagáin crann a sainaithníodh go mícheart a bhaint. Méid cuimsitheach sonraí ar fud chathair Stócólm. Teorainneacha: Is ó 2022 a úsáideadh na sonraí léasair. Go ginearálta, níl sa tacar sonraí ach crainn atá níos mó ná 3 mhéadar cearnach agus 2.0 méadar ar airde ar a laghad. Aimhrialtachtaí aitheanta: Tá an caighdeán níos airde do bhuaircínigh ná do chrainn dhuillsilteacha toisc go ndéantar scanadh léasair roimh an eamhnú agus go bhfuil níos lú bithmhaise a léiríonn léasair sna crainn dhuillsilteacha. Uaireanta ní áirítear crainn dhuillsilteacha nuaphlandaithe agus crainn barr crua sa scamall pointe agus dá bhrí sin níl lorg acu. Uaireanta is féidir crainn dhuillsilteacha a roinnt ina loirg éagsúla."},{"@language":"hr-t-sv-t0-mtec","@value":"Sadrži otiske stopala na krošnjama drveća u gradu Stockholmu. Datoteka je stvorena iz podataka u oblaku laserske točke pomoću TerraScan softvera. Različiti skripte su pokrenuti na laserskim točkama 1. točka oblak podaci su klasificirani prema tome pripadaju li zemljište, zgrade / mostovi i drugi2. Zatim, koristeći razne skripte, odabrani objekti slični stablu 3. zatim grupiraju ove točke u pojedinačna stabla 4. zatim stvaraju poligon za svako stablo koji predstavlja otisak stabla na tlu 5. Podaci su ručno pregledani pomoću ortofotografije iz 2022. kako bi se uklonili netočno identificirani poligoni drveća. Sveobuhvatna količina podataka diljem grada Stockholma. Ograničenja: Upotrijebljeni laserski podaci su iz 2022. godine. Općenito, skup podataka sadrži samo stabla koja su veća od 3 m2 i visoka najmanje 2,0 metra. Poznate anomalije: Kvaliteta je veća za četinjača nego za listopadna stabla jer se lasersko skeniranje provodi prije pukotine i u listopadnim stablima ima manje laserske reflektirajuće biomase. Novozasađena listopadna stabla i stabla tvrdog usjeva ponekad nisu uključena u točkasti oblak i stoga nemaju otisak. Listopadna stabla ponekad se mogu podijeliti na nekoliko otisaka stopala."},{"@language":"hu-t-sv-t0-mtec","@value":"Lábnyomokat tartalmaz a fák koronájához Stockholm városán belül. A fájl lézerpontos felhőadatokból készül TerraScan szoftverrel. A lézerpontokon különböző szkriptek futnak 1. A pontfelhő-adatokat aszerint osztályozzuk, hogy földhöz, épületekhez/hidakhoz és másokhoz tartoznak-e2. Ezután különböző szkriptek segítségével kiválasztottuk a 3. fához hasonló objektumokat, majd ezeket a pontokat egyes fákba csoportosítottuk 4. majd létrehoztunk egy sokszöget minden fához, amely a fa lábnyomát reprezentálja a földön 5. Az adatokat 2022-es ortofotó segítségével manuálisan felülvizsgálták a helytelenül azonosított fa-sokszögek eltávolítása érdekében. Átfogó adatmennyiség Stockholm városában. Korlátozások: A felhasznált lézeradatok 2022-ből származnak. Általában az adatkészlet csak olyan fákat tartalmaz, amelyek 3 m2-nél nagyobbak és legalább 2,0 méter magasak. Ismert anomáliák: A minőség magasabb a tűlevelű fáknál, mint a lombhullató fáknál, mivel a lézeres szkennelés a hasadás előtt történik, és a lombhullató fákban kevesebb lézervisszaverő biomassza van. Az újonnan ültetett lombhullató fák és a kemény termésű fák néha nem szerepelnek a pontfelhőben, ezért nincs lábnyomuk. A lombhullató fák néha több lábnyomra oszthatók."},{"@language":"it-t-sv-t0-mtec","@value":"Contiene impronte di corone di alberi all'interno della città di Stoccolma. Il file viene creato dai dati della nuvola di punti laser utilizzando il software TerraScan. Sono stati eseguiti diversi script su punti laser 1. I dati delle nuvole di punti sono stati classificati in base al fatto che appartengano a terreni, edifici / ponti e altri2. Quindi, utilizzando vari script, ha selezionato oggetti simili all'albero 3, quindi ha raggruppato questi punti in singoli alberi 4, quindi ha creato un poligono per ogni albero che rappresenta l'impronta dell'albero sul terreno 5. I dati sono stati esaminati manualmente utilizzando l'ortofoto 2022 per rimuovere i poligoni degli alberi identificati in modo errato. Quantità completa di dati in tutta la città di Stoccolma. Limitazioni: I dati laser utilizzati sono del 2022. Generalmente, il set di dati contiene solo alberi che sono più di 3 mq e alti almeno 2,0 metri. Anomalie note: La qualità è superiore per le conifere che per gli alberi decidui perché la scansione laser viene effettuata prima della fessura e c'è meno biomassa riflettente laser negli alberi decidui. Gli alberi decidui appena piantati e gli alberi a coltura dura a volte non sono inclusi nella nuvola di punti e quindi non hanno un'impronta. Gli alberi decidui a volte possono essere divisi in diverse impronte."},{"@language":"lt-t-sv-t0-mtec","@value":"Sudėtyje yra pėdsakų į medžių vainikus Stokholmo mieste. Failas sukurtas iš lazerio taško debesies duomenų, naudojant \"TerraScan\" programinę įrangą. 1. Taškinių debesų duomenys buvo klasifikuojami pagal tai, ar jie priklauso žemei, pastatams / tiltams ir kitiems2. Tada, naudojant įvairius scenarijus, atrinkti objektai, panašūs į medį 3. tada sugrupuoti šiuos taškus į atskirus medžius 4. tada sukūrė kiekvieno medžio daugiakampį, atstovaujantį medžio pėdsaką ant žemės 5. Duomenys buvo peržiūrėti rankiniu būdu, naudojant 2022 m. ortofotografiją, kad būtų pašalinti neteisingai identifikuoti medžių daugiakampiai. Visapusiškas duomenų kiekis visame Stokholmo mieste. Apribojimai: Naudojami 2022 m. lazeriniai duomenys. Paprastai duomenų rinkinyje yra tik medžiai, kurių aukštis yra didesnis nei 3 kv.m. ir ne mažesnis kaip 2,0 m. Žinomos anomalijos: Spygliuočių kokybė yra aukštesnė nei lapuočių medžių, nes lazerinis skenavimas atliekamas prieš plyšimą ir lapuočių medžiuose yra mažiau lazerį atspindinčios biomasės. Naujai pasodinti lapuočiai medžiai ir kietmedžiai kartais neįtraukiami į taškinį debesį, todėl neturi pėdsako. Lapuočių medžiai kartais gali būti suskirstyti į keletą pėdsakų."},{"@language":"lv-t-sv-t0-mtec","@value":"Ietver pēdas uz koku vainagiem Stokholmas pilsētā. Fails ir izveidots no lāzera punktu mākoņa datiem, izmantojot TerraScan programmatūru. Lāzera punktos ir darbināti dažādi skripti 1. punkta mākoņdatošanas dati ir klasificēti atkarībā no tā, vai tie pieder zemei, ēkām/tiltiem un citiem2. Pēc tam, izmantojot dažādus skriptus, izvēlētie objekti līdzīgi kokam 3. pēc tam sagrupēja šos punktus atsevišķos kokos 4. pēc tam katram kokam izveidoja daudzstūri, kas attēlo koka pēdu uz zemes 5. Dati tika manuāli pārskatīti, izmantojot 2022. gada ortofoto, lai noņemtu nepareizi identificētus koku daudzstūrus. Visaptverošs datu apjoms visā Stokholmas pilsētā. Ierobežojumi: Izmantotie lāzera dati ir no 2022. gada. Parasti datu kopā ir tikai koki, kas ir vairāk nekā 3 kv.m un vismaz 2,0 metrus augsti. Zināmas anomālijas: Skujkokiem kvalitāte ir augstāka nekā lapu kokiem, jo lāzera skenēšanu veic pirms plaisas un lapu kokos ir mazāk lāzera atstarojošas biomasas. Nesen iestādīti lapu koki un cietaugļu koki dažkārt netiek iekļauti punktveida mākonī, un tāpēc tiem nav pēdas nospieduma. Lapu kokus dažreiz var iedalīt vairākās pēdās."},{"@language":"mt-t-sv-t0-mtec","@value":"Fih impronti għal kuruni tas-siġar fil-Belt ta 'Stokkolma. Il-fajl huwa maħluq minn data sħaba punt laser bl-użu ta 'softwer TerraScan. Tħaddmu skripts differenti fuq punti tal-laser 1. punt tad-data sħaba ġiet ikklassifikata skont jekk jappartjenux għal art, bini/pontijiet u oħrajn2. Imbagħad, bl-użu ta 'diversi skripts, oġġetti magħżula simili għas-siġra 3. imbagħad ġabru dawn il-punti f'siġar individwali 4. imbagħad ħolqu poligonu għal kull siġra li tirrappreżenta l-impronta tas-siġra fuq l-art 5. Id-data ġiet rieżaminata manwalment bl-użu tal-ortofoto tal-2022 biex jitneħħew il-poligoni tas-siġar identifikati b’mod skorrett. Ammont komprensiv ta’ data madwar il-belt ta’ Stokkolma. Limitazzjonijiet: Id-data tal-laser użata hija mill-2022. Ġeneralment, is-sett tad-dejta fih biss siġar li huma aktar minn 3 sqm u għoljin mill-inqas 2.0 metri. Anomaliji magħrufa: Il-kwalità hija ogħla għall-koniferi milli għas-siġar li jwaqqgħu l-weraq minħabba li l-iskennjar bil-laser jitwettaq qabel il-fissura u hemm inqas bijomassa li tirrifletti l-laser fis-siġar li jwaqqgħu l-weraq. Siġar li għadhom kif tħawlu li jwaqqgħu l-weraq u siġar tal-għelejjel ibsin xi drabi mhumiex inklużi fil-punt sħab u għalhekk ma għandhomx impronta. Siġar li jwaqqgħu l-weraq kultant jistgħu jinqasmu f'diversi impronti."},{"@language":"nl-t-sv-t0-mtec","@value":"Bevat voetafdrukken naar boomkronen in de stad Stockholm. Het bestand is gemaakt van laserpoint cloud-gegevens met behulp van TerraScan-software. Er zijn verschillende scripts uitgevoerd op laserpunten 1. puntwolkgegevens zijn geclassificeerd op basis van de vraag of ze behoren tot grond, gebouwen / bruggen en andere2. Vervolgens, met behulp van verschillende scripts, geselecteerde objecten vergelijkbaar met boom 3. vervolgens gegroepeerd deze punten in individuele bomen 4. vervolgens creëerde een polygoon voor elke boom die de voetafdruk van de boom op de grond 5. De gegevens werden handmatig beoordeeld met behulp van de orthofoto van 2022 om onjuist geïdentificeerde boompolygonen te verwijderen. Uitgebreide hoeveelheid gegevens over de stad Stockholm. Beperkingen: De gebruikte lasergegevens zijn afkomstig uit 2022. Over het algemeen bevat de dataset alleen bomen van meer dan 3 m2 en minimaal 2,0 meter hoog. Bekende anomalieën: De kwaliteit is hoger voor naaldbomen dan voor loofbomen, omdat laserscanning wordt uitgevoerd vóór de spleet en er minder laserreflecterende biomassa in de loofbomen zit. Nieuw geplante loofbomen en hardgewasbomen zijn soms niet opgenomen in de puntwolk en hebben daarom geen voetafdruk. Bladverliezende bomen kunnen soms worden onderverdeeld in verschillende voetafdrukken."},{"@language":"pl-t-sv-t0-mtec","@value":"Zawiera ślady stóp do koron drzew w mieście Sztokholm. Plik jest tworzony z danych chmury punktów laserowych za pomocą oprogramowania TerraScan. Różne skrypty zostały uruchomione na punktach laserowych 1. dane chmury punktów zostały sklasyfikowane w zależności od tego, czy należą do gruntów, budynków / mostów i innych2. Następnie, używając różnych skryptów, wybrane obiekty podobne do drzewa 3. pogrupowały te punkty w pojedyncze drzewa 4. następnie utworzyły wielokąt dla każdego drzewa reprezentujący ślad drzewa na ziemi 5. Dane zostały ręcznie zweryfikowane za pomocą ortofotomapy 2022 w celu usunięcia nieprawidłowo zidentyfikowanych wielokątów drzew. Kompleksowa ilość danych w całym Sztokholmie. Ograniczenia: Wykorzystane dane laserowe pochodzą z 2022 r. Ogólnie rzecz biorąc, zbiór danych zawiera tylko drzewa, które mają więcej niż 3 m2 i co najmniej 2,0 m wysokości. Znane anomalie: Jakość jest wyższa w przypadku drzew iglastych niż drzew liściastych, ponieważ skanowanie laserowe odbywa się przed szczeliną, a biomasa odbijająca laser jest mniejsza w drzewach liściastych. Nowo posadzone drzewa liściaste i twarde drzewa uprawne czasami nie są zawarte w chmurze punktów, a zatem nie mają śladu. Drzewa liściaste można czasami podzielić na kilka odcisków stóp."},{"@language":"pt-t-sv-t0-mtec","@value":"Contém pegadas para coroas de árvores dentro da cidade de Estocolmo. O arquivo é criado a partir de dados de nuvem de ponto laser usando o software TerraScan. Foram executados diferentes scripts em pontos laser 1. Os dados da nuvem de pontos foram classificados de acordo com o facto de pertencerem a terrenos, edifícios/pontes e outros2. Depois, usando vários scripts, selecionou objetos semelhantes à árvore 3. depois agrupou estes pontos em árvores individuais 4. depois criou um polígono para cada árvore que representa a pegada da árvore no solo 5. Os dados foram revistos manualmente utilizando ortofotografia de 2022 para remover polígonos de árvores incorretamente identificados. Quantidade de dados abrangentes em toda a cidade de Estocolmo. Limitações: Os dados a laser utilizados são de 2022. Geralmente, o conjunto de dados contém apenas árvores com mais de 3 metros quadrados e pelo menos 2,0 metros de altura. Anomalias conhecidas: A qualidade é maior para as coníferas do que para as árvores caducifólias, porque a varredura a laser é realizada antes da fissura e há menos biomassa que reflete o laser nas árvores caducifólias. Árvores caducifólias recém-plantadas e árvores de culturas duras às vezes não estão incluídas na nuvem pontual e, portanto, não têm pegada. Árvores caducifólias às vezes podem ser divididas em várias pegadas."},{"@language":"ro-t-sv-t0-mtec","@value":"Conține urme de pași pe coroanele copacilor din orașul Stockholm. Fișierul este creat din date laser point cloud folosind software-ul TerraScan. S-au rulat diferite scripturi pe puncte laser 1. datele din nori punctiformi au fost clasificate în funcție de apartenența lor la terenuri, clădiri/poduri și altele2. Apoi, folosind diferite scripturi, a selectat obiecte similare cu copacul 3. apoi a grupat aceste puncte în copaci individuali 4. apoi a creat un poligon pentru fiecare copac reprezentând amprenta copacului pe sol 5. Datele au fost revizuite manual utilizând ortofoto 2022 pentru a elimina poligoanele arborilor identificate incorect. Cuprinzătoare cantitate de date în orașul Stockholm. Limitări: Datele laser utilizate sunt din 2022. În general, setul de date conține doar copaci care au o suprafață mai mare de 3 mp și o înălțime de cel puțin 2,0 metri. Anomalii cunoscute: Calitatea este mai mare pentru conifere decât pentru foioase, deoarece scanarea cu laser se efectuează înainte de fisură și există mai puțină biomasă care reflectă laserul în copacii foioase. Copacii de foioase nou plantați și arborii cu culturi dure nu sunt uneori incluși în norul punctual și, prin urmare, nu au o amprentă. Copacii foioși pot fi uneori împărțiți în mai multe urme de pași."},{"@language":"sk-t-sv-t0-mtec","@value":"Obsahuje stopy po korunách stromov v meste Štokholm. Súbor je vytvorený z cloudových dát laserového bodu pomocou softvéru TerraScan. Na laserových bodoch boli spustené rôzne skripty 1. Bodové cloudové dáta boli klasifikované podľa toho, či patria k pôde, budovám/mostom a iným2. Potom pomocou rôznych skriptov vybrané objekty podobné stromu 3. potom zoskupili tieto body do jednotlivých stromov 4. potom vytvorili mnohouholník pre každý strom predstavujúci stopu stromu na zemi 5. Údaje boli manuálne preskúmané pomocou ortofotografie 2022 s cieľom odstrániť nesprávne identifikované polygóny stromov. Komplexné údaje o celom meste Štokholm. Obmedzenia: Použité laserové údaje sú z roku 2022. Všeobecne platí, že súbor údajov obsahuje iba stromy, ktoré sú väčšie ako 3 m2 a aspoň 2,0 metra vysoké. Známe anomálie: Kvalita je vyššia v prípade ihličnanov ako v prípade listnatých stromov, pretože laserové skenovanie sa vykonáva pred prasknutím a v listnatých stromoch je menej biomasy odrážajúcej laser. Novovysadené listnaté stromy a stromy s tvrdou plodinou niekedy nie sú zahrnuté do bodového oblaku, a preto nemajú stopu. Listnaté stromy možno niekedy rozdeliť na niekoľko stôp."},{"@language":"sl-t-sv-t0-mtec","@value":"Vsebuje odtise drevesnih krošenj v mestu Stockholm. Datoteka je ustvarjena iz podatkov v oblaku laserske točke z uporabo programske opreme TerraScan. Na laserskih točkah so bili uporabljeni različni skripti 1. podatki v oblaku točk so bili razvrščeni glede na to, ali pripadajo zemljišču, stavbam/mostovom in drugim2. Nato so z različnimi skripti izbrali predmete, podobne drevesu 3. Nato so te točke združili v posamezna drevesa 4. Nato so ustvarili poligon za vsako drevo, ki predstavlja odtis drevesa na tleh 5. Podatki so bili ročno pregledani z ortofoto posnetkom za leto 2022, da bi se odstranili nepravilno identificirani drevesni poligoni. Izčrpna količina podatkov po mestu Stockholm. Omejitve: Uporabljeni laserski podatki so iz leta 2022. Na splošno nabor podatkov vsebuje le drevesa, ki so višja od 3 m2 in visoka vsaj 2,0 metra. Znane anomalije: Kakovost je višja pri iglavcih kot pri listavcih, saj se lasersko skeniranje izvaja pred razpoko, v listavcih pa je manj lasersko odbojne biomase. Novo zasajena listopadna drevesa in trda drevesa včasih niso vključena v oblak točk in zato nimajo odtisa. Listopadna drevesa lahko včasih razdelimo na več stopinj."},{"@language":"sv","@value":"Innehåller fotavtryck till trädkronor inom Stockholms stad. Filen är framtagen från laserpunktmolnsdata med hjälp av mjukvaran TerraScan. Olika skript har körts på laserpunkter 1. punktmolnsdata har klassats efter om de tillhör mark, byggnader/broar och övrigt2. Sedan har med hjälp av olika skript valt ut objekt som liknar träd 3. sedan grupperades dessa punkter till individuella träd 4. sedan skapades en polygon för varje träd som representerar trädets fotavtryck på marken 5. Data granskades manuellt med hjälp av år 2022 ortofoto för att få bort felaktig identifierade trädpolygoner. Heltäckande data mängd över Stockholms stad. Begränsningar: Laserdata som användes är från 2022. Generellt innehåller datamängden bara träd som är mer en 3 kvm och minst 2.0 meter hög. Kända anomalier: Kvaliteten är högre för barrträd än för lövträd eftersom laserskanningen utförs innan lövspricknigen och det finns mindre laserreflekterande biomassa hos lövträden. Nyplanterade lövträd och hård beskurna träd finns ibland inte med i punktmolnet och därför inte heller får ett fotavtryck. Lövträd kan ibland har delats upp i flera fotavtryck."},{"@language":"uk-t-sv-t0-mtec","@value":"Містить сліди на кронах дерев у місті Стокгольм. Файл створюється з даних хмари лазерної точки за допомогою програмного забезпечення TerraScan. Різні сценарії були запущені на лазерних точках 1. дані хмари точок були класифіковані відповідно до того, чи належать вони до землі, будівель / мостів та інших2. Потім, використовуючи різні скрипти, вибрані об'єкти, схожі на дерево 3. потім згрупували ці точки в окремі дерева 4. потім створили багатокутник для кожного дерева, що представляє слід дерева на землі 5. Дані були переглянуті вручну за допомогою ортофотоплану 2022 року, щоб видалити неправильно ідентифіковані багатокутники дерев. Всеосяжний обсяг даних по всьому місту Стокгольм. Обмеження: Використовувані лазерні дані - з 2022 року. Як правило, набір даних містить лише дерева, які мають висоту понад 3 кв. м і принаймні 2,0 метра. Відомі аномалії: Якість для хвойних дерев вища, ніж для листяних дерев, оскільки лазерне сканування проводиться до тріщини, і в листяних деревах менше біомаси, що відображає лазер. Нововисаджені листяні дерева і твердорослі дерева іноді не входять в точкову хмару і тому не мають сліду. Листяні дерева іноді можна розділити на кілька слідів."}],"dct:format":"text/html","dct:identifier":"340a9ec7-290e-48bb-8e89-2615959f26df","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:89aaa98594f1f318e356abe3ea32efca6af0123ad4fa10074efbc4008eb46279_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Trees — Footprint Crowns 2022 (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (vnitřní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Trees – Footprint Crowns 2022 (internt SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (εσωτερική SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Puud - Jalajälje Kroonid 2022 (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"Arbres SBK - Couronnes d'empreinte 2022 (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"Crainn SBK - Coróin Loirg 2022 (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK stabla – krunice za otiske stopala 2022. (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"Alberi SBK - Corone dell'impronta 2022 (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (vidaus SBK) (liet. „SBK medžiai. 2022 m. pėdsakų karūnos“)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (iekšējais SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (SBK intern)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (intern SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Trees – Footprint Crowns 2022 (wewnętrzna SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Trees - Footprint Crowns 2022 (SBK interno)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Trees – Footprint Crowns 2022 (SBK internă)"},{"@language":"sk-t-sv-t0-mtec","@value":"Stromy SBK – koruny stopy 2022 (vnútorné SBK)"},{"@language":"sl-t-sv-t0-mtec","@value":"Drevesa SBK – krone odtisa 2022 (notranji SBK)"},{"@language":"sv","@value":"SBK Träd - fotavtryck trädkronor 2022 (internt SBK)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Trees - Коронки для слідів 2022 (внутрішні SBK)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/04d9d022-dbc1-456f-a596-ba9059961499","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών κα