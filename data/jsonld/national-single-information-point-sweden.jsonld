/api/fastighetstaxering-taxeringsuppgifter/2.9.0/%2523dataset","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-taxeringsuppgifter/2.9.0/%2523distribution"},"dcat:keyword":{"@language":"sv","@value":"deklaration"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"2.9","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Fastightetstaxering - taxeringsuppgifter riktar sig till myndigheter och kreditupplysningsföretag. Med hjälp av operationerna i API:et kan du utveckla funktioner som gör det möjligt att hämta taxeringsuppgifter direkt i den egna programvaran."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Fastighetstaxering - taxeringsuppgifter"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/fastighetstaxering-taxeringsuppgifter/2.9.0/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-taxeringsuppgifter/2.9.0/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/fastighetstaxering-taxeringsuppgifter/2.9.0/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-taxeringsuppgifter/2.9.0/%C3%96v