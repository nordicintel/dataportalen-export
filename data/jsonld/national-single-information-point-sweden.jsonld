":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1d72088f17bcdb4818a2cbf7b98c4e0e94ad493cc6dd2a951959c26e1eb164b3"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/26","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/48"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/27"},"dcat:hasVersion":{"@id":"https://metadata.boverket.se/store/1/resource/44"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Syftet med detta API är att ge avtalsbundna företag möjlighet att göra löpande uppslag i energideklarationssystemet för att få \ntillgång till basuppgifterna. Bland basuppgifterna finns bland annat energiklass och energiprestanda."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"API för Energideklarationer"},"foaf:page":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"}},{"@id":"https://metadata.boverket.se/store/1/resource/27","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/#h-3"},"dct:description":{"@language":"sv","@value":"API för energideklarationer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://vismaaddo.net/Forms/#/view?token=5c319ece-0837-4366-8615-87aa3dad726d"},"dct:title":{"@language":"sv","@value":"API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://metadata.boverket.se/store/1/resource/48","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Boverkets publika API","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Dokumentation av API för Energideklaration"}}],"@id":"urn:source:1d8b49e014053b92385d452302a18f11dbfeb1b897b657853a4a66b753679b3a"},{"@graph":[{"@id":"_:1e263e18fe87ac08d2e00ce3cad1274e99d27fcaaab0266ad17e7ddc67776864_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1e263e18fe87ac08d2e00ce3cad1274e99d27fcaaab0266ad17e7ddc67776864_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"135f147e9769f04c591912b5237b445859"},{"@id":"http://data.europa.eu/88u/dataset/cdcc9fe2-0bf6-4a84-96fa-a27df063521f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/104d94c4-4ce7-4de1-952f-96179d6a26d0"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f778a958-45cb-47c8-89ff-acd1d9d639d3"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"Hemsida med fotografier, föremål, konstverk, texter och dokumentation från Stadsmuseet."},"dct:format":"text/html","dct:identifier":"cdcc9fe2-0bf6-4a84-96fa-a27df063521f","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1e263e18fe87ac08d2e00ce3cad1274e99d27fcaaab0266ad17e7ddc67776864_b0n0"},"dct:title":{"@language":"sv","@value":"Digitala stadsmuseet"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/104d94c4-4ce7-4de1-952f-96179d6a26d0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://digitalastadsmuseet.stockholm.se"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/cdcc9fe2-0bf6-4a84-96fa-a27df063521f#HTTP:Information/1","dct:title":"Webbplats med sökfunktion","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/104d94c4-4ce7-4de1-952f-96179d6a26d0"}},{"@id":"http://data.europa.eu/88u/record/cdcc9fe2-0bf6-4a84-96fa-a27df063521f","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/104d94c4-4ce7-4de1-952f-96179d6a26d0"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"cdcc9fe2-0bf6-4a84-96fa-a27df063521f","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:25Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:02Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/cdcc9fe2-0bf6-4a84-96fa-a27df063521f"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:1e263e18fe87ac08d2e00ce3cad1274e99d27fcaaab0266ad17e7ddc67776864_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/cdcc9fe2-0bf6-4a84-96fa-a27df063521f"},"https://piveau.eu/ns/voc#originalId":"cdcc9fe2-0bf6-4a84-96fa-a27df063521f","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/cdcc9fe2-0bf6-4a84-96fa-a27df063521f"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Kulturförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info.stadsmuseum@stockholm.se"}}],"@id":"urn:source:1e263e18fe87ac08d2e00ce3cad1274e99d27fcaaab0266ad17e7ddc67776864"},{"@graph":[{"@id":"_:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2019-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2019-04-17"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2019-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2019-04-17"}},{"@id":"_:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"19b0b68f149c4cffae490a6ed63f5d652c"},{"@id":"http://data.europa.eu/88u/dataset/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1920b7c3-b794-458f-9f3c-515e28aabe96"},{"@id":"http://data.europa.eu/88u/distribution/d775ed1e-b667-4e09-bddf-093df6ffa06b"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=aae9efd7-aba9-413a-8775-f410b069c5e4"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2020-04-22"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: На около 1900 метра над земята. Разделителна способност: 8 cm на земята на пиксел. Дата на снимката: 6—22 април 2020 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: asi 1900 metrů nad zemí. Usnesení: 8 cm na zem na pixel. Datum pořízení fotografie: a 22. dubna 2020. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: omkring 1900 meter over jorden. Beslutning: 8 cm på jorden pr. pixel. Fotografiets dato: Den 6.-22. april 2020. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: ca. 1900 Meter über dem Boden. Entschließung: 8 cm auf dem Boden pro Pixel. Fotodatum: 6. bis 22. April 2020. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: περίπου 1900 μέτρα πάνω από το έδαφος. Ψήφισμα: 8 cm στο έδαφος ανά pixel. Ημερομηνία φωτογραφίας: 6-22 Απριλίου 2020. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: about 1900 meters above the ground. Resolution: 8 cm on the ground per pixel. Date of photograph: 6-22 April 2020. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: a unos 1900 metros sobre el suelo. Resolución: 8 cm en el suelo por píxel. Fecha de la fotografía: 6-22 de abril de 2020. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: Umbes 1900 meetrit maapinnast. Resolutsioon: 8 cm maapinnal piksli kohta. Foto kuupäev: 6.–22. aprill 2020. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: Noin 1900 metriä maanpinnan yläpuolella. Päätöslauselma: 8 cm pikseliä kohti. Valokuvauksen päivämäärä: 6.–22. huhtikuuta 2020. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: environ 1900 mètres au-dessus du sol. Résolution : 8 cm au sol par pixel. Date de la photographie: du 6 au 22 avril 2020. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: Timpeall 1900 méadar os cionn na talún. Rún: 8 cm ar an talamh in aghaidh an phicteilín. Dáta an ghrianghraif: 6-22 Aibreán 2020. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: Oko 1900 metara iznad tla. Rezolucija: 8 cm na tlu po pikselu. Datum fotografije: i 22. travnja 2020. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: 1900 méterrel a föld felett. Állásfoglalás: 8 cm a földön pixelenként. Fénykép dátuma: 2020. április 6–22. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: a circa 1900 metri dal suolo. Risoluzione: 8 cm a terra per pixel. Data della fotografia: 6-22 aprile 2020. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: apie 1900 metrų virš žemės. Rezoliucija 8 cm ant žemės vienam pikseliui. Fotografavimo data: 2020 m. balandžio 6–22 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: Apmēram 1900 metrus virs zemes. Izšķirtspēja: 8 cm uz zemes uz pikseli. Fotogrāfijas datums: 2020. gada 6.–22. aprīlī. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: madwar 1900 metru 'l fuq mill-art. Riżoluzzjoni: 8 cm fuq l-art għal kull pixel. Data tar-ritratt: 6-22 ta' April 2020. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: Ongeveer 1900 meter boven de grond. Resolutie: 8 cm op de grond per pixel. Datum van de foto: 6-22 april 2020. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: Około 1900 metrów nad ziemią. Rozdzielczość: 8 cm na ziemi na piksel. Data zdjęcia: 6–22 kwietnia 2020 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: cerca de 1900 metros acima do solo. Resolução: 8 cm no chão por pixel. Data da fotografia: 6-22 de abril de 2020. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: aproximativ 1900 de metri deasupra solului. Rezoluție: 8 cm pe sol per pixel. Data fotografiei: 6-22 aprilie 2020. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: Približne 1900 metrov nad zemou. Uznesenie: 8 cm na zem na pixel. Dátum fotografie: 22. apríla 2020. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: približno 1900 metrov nad tlemi. Resolucija: 8 cm na tleh na slikovno piko. Datum fotografiranja: in 22. aprila 2020. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 6-22 april 2020. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: близько 1900 метрів над землею. Роздільна здатність: 8 см на землі на піксель. Дата фотографії: 6-22 квітня 2020 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd","dct:issued":{"@type":"xsd:date","@value":"2023-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4_b0n0"},"dct:temporal":{"@id":"_:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Ortofoto (2020 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ortofoto (2020) (στα Αγγλικά)."},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2020.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2020 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Ortofoto (2020)"},{"@languag