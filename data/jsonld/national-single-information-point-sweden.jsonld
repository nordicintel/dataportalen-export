rkartan"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:c054351fe67db3ee8b13320bc1df15b4442d0b265590124560d8f52e99c985a4"},{"@graph":[{"@id":"_:c0f9d61d014b6ca0d7e99db224aa149bcd852e48b168f29f5879c2cb79c228d4_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1047610dd55e781819df1820042f68d563"},{"@id":"_:c0f9d61d014b6ca0d7e99db224aa149bcd852e48b168f29f5879c2cb79c228d4_b1n0","dct:identifier":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/meddela-felaktig-folkbokforingsadress/1.0.5/%2523distribution","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5fb8a0e1-a37b-4001-a3a7-1f58bb7415e0"}},{"@id":"http://data.europa.eu/88u/dataset/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-meddela-felaktig-folkbokforingsadress-1-0-5-2523dataset~~1","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/5fb8a0e1-a37b-4001-a3a7-1f58bb7415e0"},"dcat:keyword":{"@language":"sv","@value":"folkbokföring"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et riktar sig endast mot svenska myndigheter och gör det möjligt att skicka in uppgifter om felaktig folkbokföringsadress till Skatteverket och folkbokföringen."},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2022-05-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Meddela felaktig folkbokföringsadress"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/meddela-felaktig-folkbokforingsadress/1.0.5/swagger.json%2523accessService"}},{"@id":"http://data.europa.eu/88u/distribution/5fb8a0e1-a37b-4001-a3a7-1f58bb7415e0","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/meddela-felaktig-folkbokforingsadress/1.0.5/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/meddela-felaktig-folkbokforingsadress/1.0.5/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/meddela-felaktig-folkbokforingsadress/1.0.5/swagger.json"},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2022-05-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомяване за неправилен регистриран адрес"},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámit nesprávnou registrovanou adresu"},{"@language":"da-t-sv-t0-mtec","@value":"Underret forkert registreret adresse"},{"@language":"de-t-sv-t0-mtec","@value":"Falsche registrierte Adresse benachrichtigen"},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποίηση εσφαλμένης καταχωρισμένης