ckholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570"},{"@graph":[{"@id":"_:7e255cc8e9343719fd7a42f7184603b448cdbcd13c08fdf66b1df2056f6b7273_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4403,18.2011 59.4403,18.2011 59.2272,17.7605 59.2272,17.7605 59.4403))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4403,18.2011 59.4403,18.2011 59.2272,17.7605 59.2272,17.7605 59.4403))"}},{"@id":"_:7e255cc8e9343719fd7a42f7184603b448cdbcd13c08fdf66b1df2056f6b7273_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"143ba6dbba4a8744809d1e736ba81b1a02"},{"@id":"http://data.europa.eu/88u/dataset/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/a4a83f84-1a2f-4a80-9c05-709fb27847e1"},{"@id":"http://data.europa.eu/88u/distribution/d8d89280-19ff-4731-a071-4d6c911170df"}],"dcat:keyword":[{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Naturinventeringar"},{"@language":"sv","@value":"Stadsmiljö"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=Miljodata0001"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2019-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Биотопна база данни от 2019 г. Картографирането на биотопи е както методология, така и база данни за биотопи, която показва характеристиките на природата и използването на земята. Целта е данните да се използват за анализи на природата, екосистемните услуги и зелената инфраструктура. Въз основа на хибриден метод в няколко стъпки, включително полуавтоматични оценки от дистанционно наблюдение и национални данни, както и интерпретация на изображения от въздуха на IR изображения. Проучването е проведено от Стокхолмския университет (Катедра по физическа география) и Calluna AB."},{"@language":"cs-t-sv-t0-mtec","@value":"Databáze biotopů z roku 2019. Mapování biotopů je metodika a databáze biotopů, která ukazuje vlastnosti přírody a využití půdy. Účelem je, aby údaje byly použity pro analýzy přírody, ekosystémových služeb a zelené infrastruktury. Založeno na hybridní metodě v několika krocích, včetně poloautomatických hodnocení z dálkového průzkumu Země a národních dat, jakož i letecké interpretace IR snímků. Průzkum provedly Stockholmská univerzita (Katedra fyzické geografie) a Calluna AB."},{"@language":"da-t-sv-t0-mtec","@value":"Biotopdatabase fra 2019. Biotopkortlægningen er både en metode og en biotopdatabase, der viser naturens karakteristika og arealanvendelse. Formålet er, at dataene skal bruges til analyser af natur, økosystemtjenester og grøn infrastruktur. Baseret på en hybrid metode i flere trin, herunder halvautomatiske vurderinger fra telemåling og nationale data samt luftbilledfortolkning af IR-billeder. Undersøgelsen er foretaget af Stockholms Universitet (Department of Physical Geography) og Calluna AB."},{"@language":"de-t-sv-t0-mtec","@value":"Biotopdatenbank ab 2019. Die Biotopkartierung ist sowohl eine Methodik als auch eine Biotopdatenbank, die die Eigenschaften der Natur und die Landnutzung zeigt. Der Zweck besteht darin, die Daten für Analysen der Natur, der Ökosystemleistungen und der grünen Infrastruktur zu verwenden. Basierend auf einer hybriden Methode in mehreren Schritten, einschließlich halbautomatischer Bewertungen aus Fernerkundung und nationalen Daten sowie Luftbildinterpretation von IR-Bildern. Die Studie wurde von der Stockholm University (Department of Physical Geography) und Calluna AB durchgeführt."},{"@language":"el-t-sv-t0-mtec","@value":"Βάση δεδομένων για τους βιότοπους από το 2019. Η χαρτογράφηση των βιοτόπων είναι τόσο μια μεθοδολογία όσο και μια βάση δεδομένων βιοτόπων που δείχνει τα χαρακτηριστικά της φύσης και τη χρήση της γης. Σκοπός είναι τα δεδομένα να χρησιμοποιούνται για αναλύσεις της φύσης, των οικοσυστημικών υπηρεσιών και των πράσινων υποδομών. Βασίζεται σε υβριδική μέθοδο σε διάφορα στάδια, συμπεριλαμβανομένων ημιαυτόματων αξιολογήσεων από τηλεπισκόπηση και εθνικά δεδομένα, καθώς και ερμηνείας εικόνων υπέρυθρης ακτινοβολίας από αέρος. Η έρευνα διεξήχθη από το Πανεπιστήμιο της Στοκχόλμης (Τμήμα Φυσικής Γεωγραφίας) και την Calluna AB."},{"@language":"en-t-sv-t0-mtec","@value":"Biotope database from 2019. The biotope mapping is both a methodology and a biotope database that shows nature's characteristics and land use. The purpose is for the data to be used for analyses of nature, ecosystem services and green infrastructure. Based on a hybrid method in several steps, including semi-automatic ratings from remote sensing and national data as well as aerial image interpretation of IR images. The survey was conducted by Stockholm University (Department of Physical Geography) and Calluna AB."},{"@language":"es-t-sv-t0-mtec","@value":"Base de datos de biotopos de 2019. El mapeo de biotopos es tanto una metodología como una base de datos de biotopos que muestra las características de la naturaleza y el uso del suelo. El objetivo es que los datos se utilicen para analizar la naturaleza, los servicios ecosistémicos y la infraestructura verde. Basado en un método híbrido en varias etapas, incluidas las clasificaciones semiautomáticas de la teledetección y los datos nacionales, así como la interpretación de imágenes aéreas de imágenes IR. La encuesta fue realizada por la Universidad de Estocolmo (Departamento de Geografía Física) y Calluna AB."},{"@language":"et-t-sv-t0-mtec","@value":"Biotoopide andmebaas aastast 2019. Biotoopide kaardistamine on nii metoodika kui ka biotoopide andmebaas, mis näitab looduse omadusi ja maakasutust. Eesmärk on kasutada andmeid looduse, ökosüsteemi teenuste ja rohelise taristu analüüsimiseks. Põhineb hübriidmeetodil mitmes etapis, sealhulgas poolautomaatsed hinnangud kaugseirest ja riiklikest andmetest ning infrapunapiltide tõlgendamine õhust. Uuringu viisid läbi Stockholmi Ülikool (füüsilise geograafia osakond) ja Calluna AB."},{"@language":"fi-t-sv-t0-mtec","@value":"Biotope-tietokanta vuodelta 2019. Biotooppikartoitus on sekä metodologia että biotooppitietokanta, joka näyttää luonnon ominaisuudet ja maankäytön. Tarkoituksena on, että tietoja käytetään luonnon, ekosysteemipalvelujen ja vihreän infrastruktuurin analysointiin. Perustuu hybridimenetelmään useissa vaiheissa, mukaan lukien puoliautomaattiset luokitukset kaukokartoituksesta ja kansallisista tiedoista sekä infrapunakuvien ilmakuvan tulkinta. Kyselyn toteuttivat Tukholman yliopisto (fyysisen maantieteen laitos) ja Calluna AB."},{"@language":"fr-t-sv-t0-mtec","@value":"Base de données Biotope à partir de 2019. La cartographie des biotopes est à la fois une méthodologie et une base de données sur les biotopes qui montre les caractéristiques de la nature et l'utilisation des terres. Le but est que les données soient utilisées pour des analyses de la nature, des services écosystémiques et des infrastructures vertes. Basé sur une méthode hybride en plusieurs étapes, y compris les évaluations semi-automatiques à partir de la télédétection et des données nationales ainsi que l'interprétation d'images aériennes d'images IR. L'enquête a été menée par l'Université de Stockholm (Département de géographie physique) et Calluna AB."},{"@language":"ga-t-sv-t0-mtec","@value":"Bunachar sonraí Biotope ó 2019. Is modheolaíocht agus bunachar sonraí biotóp í an mhapáil biotóp a léiríonn saintréithe an dúlra agus úsáid talún. Is é an cuspóir atá leis na sonraí a úsáid le haghaidh anailísí ar an dúlra, ar sheirbhísí éiceachórais agus ar bhonneagar glas. Bunaithe ar mhodh hibrideach i roinnt céimeanna, lena n-áirítear rátálacha leath-uathoibríocha ó chianbhraiteacht agus sonraí náisiúnta chomh maith le léirmhíniú aeríomhánna ar íomhánna IR. Rinne Ollscoil Stócólm (An Roinn Tíreolaíochta Fisicí) agus Calluna AB an suirbhé."},{"@language":"hr-t-sv-t0-mtec","@value":"Baza podataka Biotope iz 2019. Mapiranje biotopa je metodologija i baza podataka o biotopima koja pokazuje karakteristike prirode i korištenje zemljišta. Svrha je da se podaci upotrebljavaju za analize prirode, usluga ekosustava i zelene infrastrukture. Na temelju hibridne metode u nekoliko koraka, uključujući poluautomatske ocjene iz daljinskog istraživanja i nacionalnih podataka, kao i tumačenje slika IR iz zraka. Istraživanje su proveli Sveučilište u Stockholmu (Odjel za fizičku geografiju) i Calluna AB."},{"@language":"hu-t-sv-t0-mtec","@value":"Biotóp adatbázis 2019-ből. A biotóp-térképezés egyszerre módszertan és biotóp-adatbázis, amely bemutatja a természet jellemzőit és a földhasználatot. A cél a természet, az ökoszisztéma-szolgáltatások és a zöld infrastruktúra elemzéséhez felhasználandó adatok. Hibrid módszer alapján több lépésben, beleértve a távérzékelésből és a nemzeti adatokból származó félautomata minősítéseket, valamint az infravörös képek légi képértelmezését. A felmérést a Stockholmi Egyetem (Fizikai Földrajz Tanszék) és a Calluna AB végezte."},{"@language":"it-t-sv-t0-mtec","@value":"Banca dati dei biotopi del 2019. La mappatura dei biotopi è sia una metodologia che un database di biotopi che mostra le caratteristiche della natura e l'uso del suolo. Lo scopo è quello di utilizzare i dati per l'analisi della natura, dei servizi ecosistemici e delle infrastrutture verdi. Basato su un metodo ibrido in diverse fasi, tra cui valutazioni semiautomatiche da telerilevamento e dati nazionali, nonché l'interpretazione aerea delle immagini IR. L'indagine è stata condotta dall'Università di Stoccolma (Dipartimento di Geografia Fisica) e da Calluna AB."},{"@language":"lt-t-sv-t0-mtec","@value":"2019 m. biotopų duomenų bazė. Biotopų kartografavimas yra ir metodika, ir biotopų duomenų bazė, parodanti gamtos savybes ir žemės naudojimą. Siekiama, kad duomenys būtų naudojami gamtos, ekosisteminių paslaugų ir žaliosios infrastruktūros analizei. Remiantis mišriu kelių etapų metodu, įskaitant pusiau automatinius nuotolinio stebėjimo ir nacionalinių duomenų reitingus, taip pat IR vaizdų interpretavimą iš oro. Apklausą atliko Stokholmo universitetas (Fizinės geografijos departamentas) ir AB \"Calluna\"."},{"@language":"lv-t-sv-t0-mtec","@value":"Biotope datubāze no 2019. gada. Biotopu kartēšana ir gan metodoloģija, gan biotopu datubāze, kas parāda dabas īpašības un zemes izmantojumu. Mērķis ir datus izmantot dabas, ekosistēmu pakalpojumu un zaļās infrastruktūras analīzei. Pamatojoties uz hibrīdmetodi vairākos posmos, ieskaitot pusautomātiskos vērtējumus no tālizpētes un valstu datiem, kā arī IR attēlu interpretāciju no gaisa. Aptauju veica Stokholmas Universitāte (Fiziskās ģeogrāfijas departaments) un Calluna AB."},{"@language":"mt-t-sv-t0-mtec","@value":"Bażi tad-data Biotope mill-2019. L-immappjar tal-bijotopi huwa kemm metodoloġija kif ukoll bażi tad-data tal-bijotopi li turi l-karatteristiċi tan-natura u l-użu tal-art. L-għan huwa li d-data tintuża għall-analiżijiet tan-natura, tas-servizzi tal-ekosistema u tal-infrastruttura ekoloġika. Abbażi ta’ metodu ibridu f’diversi stadji, inklużi klassifikazzjonijiet semiawtomatiċi mit-telerilevament u d-data nazzjonali kif ukoll l-interpretazzjoni tal-immaġnijiet mill-ajru tal-immaġnijiet IR. L-istħarriġ sar mill-Università ta' Stokkolma (Dipartiment tal-Ġeografija Fiżika) u Calluna AB."},{"@language":"nl-t-sv-t0-mtec","@value":"Biotope database uit 2019. Het in kaart brengen van biotopen is zowel een methodologie als een biotoopdatabase die de kenmerken van de natuur en het landgebruik laat zien. Het doel is om de gegevens te gebruiken voor analyses van natuur, ecosysteemdiensten en groene infrastructuur. Gebaseerd op een hybride methode in verschillende stappen, waaronder semi-automatische beoordelingen van teledetectie en nationale gegevens, evenals luchtfoto-interpretatie van IR-beelden. Het onderzoek werd uitgevoerd door de Universiteit van Stockholm (Departement Fysische Geografie) en Calluna AB."},{"@language":"pl-t-sv-t0-mtec","@value":"Baza danych biotopów z 2019 r. Mapowanie biotopów jest zarówno metodologią, jak i bazą danych biotopów, która pokazuje cechy przyrody i użytkowanie gruntów. Celem jest wykorzystanie danych do analizy przyrody, usług ekosystemowych i zielonej infrastruktury. Oparty na metodzie hybrydowej w kilku etapach, w tym półautomatycznych ocenach z teledetekcji i danych krajowych, a także lotniczej interpretacji obrazów IR. Badanie zostało przeprowadzone przez Stockholm University (Departament Geografii Fizycznej) i Calluna AB."},{"@language":"pt-t-sv-t0-mtec","@value":"Base de dados de biótopos de 2019. O mapeamento de biótopos é tanto uma metodologia como uma base de dados de biótopos que mostra as características da natureza e o uso do solo. O objetivo é que os dados sejam utilizados para análises da natureza, dos serviços ecossistémicos e das infraestruturas verdes. Com base num método híbrido em várias etapas, incluindo classificações semiautomáticas a partir de teledeteção e dados nacionais, bem como interpretação de imagens aéreas de imagens de infravermelhos. A pesquisa foi conduzida pela Universidade de Estocolmo (Departamento de Geografia Física) e Calluna AB."},{"@language":"ro-t-sv-t0-mtec","@value":"Baza de date biotop din 2019. Cartografierea biotopului este atât o metodologie, cât și o bază de date a biotopului care arată caracteristicile naturii și utilizarea terenurilor. Scopul este ca datele să fie utilizate pentru analize ale naturii, ale serviciilor ecosistemice și ale infrastructurii verzi. Pe baza unei metode hibride în mai multe etape, inclusiv evaluări semiautomate obținute prin teledetecție și date naționale, precum și interpretarea imaginilor aeriene ale imaginilor IR. Studiul a fost realizat de Universitatea din Stockholm (Departamentul de Geografie Fizică) și Calluna AB."},{"@language":"sk-t-sv-t0-mtec","@value":"Databáza biotopov z roku 2019. Mapovanie biotopov je metodikou aj databázou biotopov, ktorá zobrazuje vlastnosti prírody a využívanie pôdy. Účelom je, aby sa údaje použili na analýzu prírody, ekosystémových služieb a zelenej infraštruktúry. Na základe hybridnej metódy v niekoľkých krokoch vrátane poloautomatických hodnotení z diaľkového snímania a národných údajov, ako aj leteckej interpretácie infračervených snímok. Prieskum uskutočnili štokholmská univerzita (oddelenie fyzickej geografie) a Calluna AB."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovna zbirka Biotope iz leta 2019. Kartiranje biotopov je metodologija in podatkovna zbirka biotopov, ki prikazuje značilnosti narave in rabo zemljišč. Namen je, da se podatki uporabljajo za analize narave, ekosistemskih storitev in zelene infrastrukture. Na podlagi hibridne metode v več korakih, vključno s polavtomatskimi ocenami iz daljinskega zaznavanja in nacionalnih podatkov ter interpretacijo slik IR iz zraka. Raziskavo sta izvedla Univerza v Stockholmu (Oddelek za fizično geografijo) in Calluna AB."},{"@language":"sv","@value":"Biotopdatabasen från 2019. Biotopkarteringen är både en metodik och en biotopdatabas som visar naturens egenskaper och markanvändning. Syftet är att underlaget ska användas för analyser av natur, ekosystemtjänster och gröna infrastruktur. Bygger på en hybridmetod i flera steg, omfattande bl a semiautomatiska klassningar från fjärranalys och nationella data samt flygbildstolkning av IR-bilder. Karteringen är utförd av Stockholms Universitet (Institutionen för naturgeografi) samt Calluna AB."},{"@language":"uk-t-sv-t0-mtec","@value":"База даних Biotope з 2019 року. Біотопне картографування є як методологією, так і базою даних біотопів, яка показує характеристики природи та землекористування. Метою є використання даних для аналізу природи, екосистемних послуг та зеленої інфраструктури. На основі гібридного методу в кілька етапів, включаючи напівавтоматичні рейтинги з дистанційного зондування та національних даних, а також інтерпретацію аерофотознімків ІЧ-зображень. Опитування проводилося Стокгольмським університетом (кафедра фізичної географії) і Calluna AB."}],"dct:format":"text/html","dct:identifier":"f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7e255cc8e9343719fd7a42f7184603b448cdbcd13c08fdf66b1df2056f6b7273_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Биотопна база данни 2019"},{"@language":"cs-t-sv-t0-mtec","@value":"Databáze biotopů 2019"},{"@language":"da-t-sv-t0-mtec","@value":"Biotopdatabase 2019"},{"@language":"de-t-sv-t0-mtec","@value":"Biotopdatenbank 2019"},{"@language":"el-t-sv-t0-mtec","@value":"Βάση δεδομένων για τους βιότοπους 2019"},{"@language":"en-t-sv-t0-mtec","@value":"Biotope database 2019"},{"@language":"es-t-sv-t0-mtec","@value":"Base de datos de biotopos 2019"},{"@language":"et-t-sv-t0-mtec","@value":"Biotoopide andmebaas 2019"},{"@language":"fi-t-sv-t0-mtec","@value":"Biotooppitietokanta 2019"},{"@language":"fr-t-sv-t0-mtec","@value":"Base de données Biotope 2019"},{"@language":"ga-t-sv-t0-mtec","@value":"Bunachar sonraí Biotope 2019"},{"@language":"hr-t-sv-t0-mtec","@value":"Baza podataka o biotopima 2019."},{"@language":"hu-t-sv-t0-mtec","@value":"Biotóp-adatbázis 2019"},{"@language":"it-t-sv-t0-mtec","@value":"Banca dati dei biotopi 2019"},{"@language":"lt-t-sv-t0-mtec","@value":"Biotopų duomenų bazė, 2019 m."},{"@language":"lv-t-sv-t0-mtec","@value":"Biotope datubāze 2019"},{"@language":"mt-t-sv-t0-mtec","@value":"Bażi tad-data dwar il-bijotopi 2019"},{"@language":"nl-t-sv-t0-mtec","@value":"Biotopendatabank 2019"},{"@language":"pl-t-sv-t0-mtec","@value":"Baza danych biotopów 2019"},{"@language":"pt-t-sv-t0-mtec","@value":"Base de dados de biótopos 2019"},{"@language":"ro-t-sv-t0-mtec","@value":"Baza de date biotop 2019"},{"@language":"sk-t-sv-t0-mtec","@value":"Databáza biotopov 2019"},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovna zbirka Biotope 2019"},{"@language":"sv","@value":"Biotopdatabasen 2019"},{"@language":"uk-t-sv-t0-mtec","@value":"База даних біотопів 2019"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/a4a83f84-1a2f-4a80-9c05-709fb27847e1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/b89445e6ffab414bb1fca76b1a361496_49"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/1","dct:title":["Miljöförvaltningens Öppna data-hub",{"@language":"bg-t-sv-t0-mtec","@value":"Център за отворени данни за управ