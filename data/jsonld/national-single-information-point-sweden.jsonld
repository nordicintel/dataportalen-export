er-och-oppna-data-utvecklarportalen-api-beskattningsunderlag-tjansteinkomster-proxy-1-1-0-2523dataset~~1","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"_:158c5aebdf22105f84050e81c38688e98c3df3c9f04e3e8ce5060db9a4b61603_b1n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-08T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T04:48:09Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-beskattningsunderlag-tjansteinkomster-proxy-1-1-0-2523dataset~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:158c5aebdf22105f84050e81c38688e98c3df3c9f04e3e8ce5060db9a4b61603_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-beskattningsunderlag-tjansteinkomster-proxy-1-1-0-2523dataset~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-10-09T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-10-11T04:48:09Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/%2523dataset","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/%2523dataset"}},{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]}],"@id":"urn:source:158c5aebdf22105f84050e81c38688e98c3df3c9f04e3e8ce5060db9a4b61603"},{"@graph":[{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1297adda9dc83e90fbc968572d7166fded"},{"@id":"http://data.europa.eu/88u/dataset/6d551505-3721-4f2e-8ff6-0968aa9b647e","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=74fb37e4-a07a-45bb-809f-f85e2d812134"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1998-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: 3000 m, разделителна способност: 16 см/пиксел в ортофото. Липсват несертифицирани изображения. Не изглежда да има WMS услуга с тази ортофото. Дата на снимката: април-май 1998 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: 3000 m, rozlišení: 16 cm/pixel v ortofotosnímku. Chybí neověřené obrázky. Zdá se, že s tímto ortofotosnímkem není služba WMS. Datum pořízení fotografie: duben–květen 1998."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: 3000 m, opløsning: 16 cm/pixel i ortofoto. Ucertificerede billeder mangler. Der ser ikke ud til at være en WMS-tjeneste med dette ortofoto. Fotografiets dato: april-maj 1998."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: 3000 m, Auflösung: 16 cm/Pixel im Orthofoto. Unzertifizierte Bilder fehlen. Es scheint keinen WMS-Service mit diesem Orthofoto zu geben. Fotodatum: April-Mai 1998."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: 3000 m, ανάλυση: 16 cm/pixel σε ορθοφωτογραφία. Λείπουν μη πιστοποιημένες εικόνες. Δεν φαίνεται να υπάρχει υπηρεσία WMS με αυτή την ορθοφωτογραφία. Ημερομηνία φωτογραφίας: Απρίλιος-Μάιος 1998."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: 3000 m, resolution: 16 cm/pixel in orthophoto. Uncertified images are missing. There doesn't seem to be a WMS service with this orthophoto. Date of photograph: April-May 1998."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: 3000 m, resolución: 16 cm/píxel en ortofoto. Faltan imágenes no certificadas. No parece haber un servicio de WMS con esta ortofoto. Fecha de la fotografía: Abril-mayo de 1998."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: 3000 m, eraldusvõime: 16 cm/piksel ortofotos. Sertifitseerimata pildid puuduvad. Tundub, et selle ortofotoga pole WMS-i teenust. Foto kuupäev: Aprill–mai 1998."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: 3000 m, resoluutio: 16 cm/pikseli ortokuvassa. Varmentamattomat kuvat puuttuvat. Tällä ortokuvalla ei näytä olevan WMS-palvelua. Valokuvauksen päivämäärä: Huhti-toukokuu 1998."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: 3000 m, résolution: 16 cm/pixel en orthophoto. Il manque des images non certifiées. Il ne semble pas y avoir de service WMS avec cette orthophoto. Date de la photographie: Avril-mai 1998."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: 3000 m, taifeach: 16 cm/picteilín in orthophoto. Tá íomhánna neamhdheimhnithe ar iarraidh. Ní cosúil go bhfuil seirbhís WMS leis an orthophoto seo. Dáta an ghrianghraif: Aibreán-Bealtaine 1998."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: 3000 m, razlučivost: 16 cm/piksel u ortofotografiji. Nedostaju necertificirane slike. Čini se da ne postoji WMS usluga s ovom ortofotografijom. Datum fotografije: Travanj-svibanj 1998."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: 3000 m, felbontás: 16 cm/pixel ortofotóban. A nem hitelesített képek hiányoznak. Úgy tűnik, nincs WMS szolgáltatás ezzel az ortofotóval. Fénykép dátuma: 1998. április-május."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: 3000 m, risoluzione: 16 cm/pixel in ortofoto. Mancano immagini non certificate. Non sembra esserci un servizio WMS con questa ortofoto. Data della fotografia: aprile-maggio 1998."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: 3000 m, skiriamoji geba: 16 cm/pikselis ortofotografijoje. Trūksta nesertifikuotų vaizdų. Atrodo, kad nėra WMS paslaugos su šia ortofotografija. Fotografavimo data: 1998 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: 3000 m, izšķirtspēja: 16 cm/pikselis ortofoto. Trūkst neapliecinātu attēlu. Šķiet, ka ar šo ortofoto nav WMS pakalpojuma. Fotogrāfijas datums: 1998. gada aprīlis–maijs."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: 3000 m, riżoluzzjoni: 16 cm/pixel fl-ortofoto. L-immaġnijiet mhux iċċertifikati huma neqsin. Ma jidhirx li hemm servizz ta 'WMS b'dan l-ortofoto. Data tar-ritratt: April-Mejju 1998."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: 3000 m, resolutie: 16 cm/pixel in orthofoto. Ongecertificeerde foto's ontbreken. Er lijkt geen WMS-service te zijn met deze orthofoto. Datum van de foto: april-mei 1998."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: 3000 m, rozdzielczość: 16 cm/piksel w ortofotomapie. Brakuje niecertyfikowanych zdjęć. Wydaje się, że nie ma usługi WMS z tym ortofotomapą. Data zdjęcia: kwiecień-maj 1998 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: 3000 m, resolução: 16 cm/pixel em ortofotografia. Faltam imagens não certificadas. Não parece haver um serviço WMS com esta ortofotografia. Data da fotografia: Abril-Maio de 1998."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: 3000 m, rezoluție: 16 cm/pixel în ortofotografie. Imaginile necertificate lipsesc. Nu pare să existe un serviciu WMS cu această ortofotografie. Data fotografiei: aprilie-mai 1998."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: 3000 m, rozlíšenie: 16 cm/pixel v ortofotografii. Chýbajú neoverené obrázky. S touto ortofotografiou sa nezdá, že by existovala služba WMS. Dátum fotografie: apríl – máj 1998."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: 3000 m, ločljivost: 16 cm/piksel v ortofotu. Manjkajo nepreverjene slike. Zdi se, da ni storitve WMS s tem ortofoto. Datum fotografiranja: Od aprila do maja 1998."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 3000 m, upplösning: 16 cm/pixel i ortofoto. Orektifierade bilderna försvunna. Det verkar inte finnas en WMS-tjänst med detta ortofoto. Fotograferingsdatum: april-maj 1998."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: 3000 м, роздільна здатність: 16 см/піксель в ортофотоплані. Несертифіковані зображення відсутні. Здається, немає служби WMS з цим ортофотопланом. Дата фотографії: Квітень-травень 1998 року."}],"dct:format":"text/html","dct:identifier":"6d551505-3721-4f2e-8ff6-0968aa9b647e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофото (1998)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) (hudební videoklip)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορθοφύτου (1998)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (1998.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) Sistēmas Prasības"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sv","@value":"SBK Ortofoto (1998)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (SBK Orthofoto) (1998)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/6d551505-3721-4f2e-8ff6-0968aa9b647e#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3"}},{"@id":"http://data.europa.eu/88u/record/6d551505-3721-4f2e-8ff6-0968aa9b647e","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"6d551505-3721-4f2e-8ff6-0968aa9b647e","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:00Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:37:41Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/6d551505-3721-4f2e-8ff6-0968aa9b647e"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/6d551505-3721-4f2e-8ff6-0968aa9b647e"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:00Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:37:41Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"6d551505-3721-4f2e-8ff6-0968aa9b647e","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/6d551505-3721-4f2e-8ff6-0968aa9b647e"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a"},{"@graph":[{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a1c7d47b26debe0e13f68b0f16482c7ab"},{"@id":"http://data.europa.eu/88u/dataset/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/6395ee02-4f4d-4e96-8b79-62894b2a76b0"},{"@id":"http://data.europa.eu/88u/distribution/6697183c-68d3-4415-b48e-31f7782acd8f"},{"@id":"http://data.europa.eu/88u/distribution/b1600728-3fd0-4481-82d6-fa92ad1cfe9e"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"SBK Planeringsunderlag"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3c463b5f-2b62-4b62-b131-a3eefcad2515"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Координираните и повишени точки във файла с координатната мрежа се основават на данни от въздушно лазерно сканиране над град Стокхолм в периода 9 април — 7 май 2024 г. Плътността на точките в първоначалния точков облак е най-малко 16 точки/m2 на земята. Елементите не се актуализират след създаването им. Данните се интерполират в координатна мрежа с разделителна способност 1 m. Това означава, че за райони, в които почвата се е променила след сканирането, координатите на точките не съвпадат. Точките в слоя \"Скрита земя\" показват интерполираната височина на земята под съществуващите сгради. Точките в слоя \"Dolt Water\" показват интерполираната височина на водата под съществуващите мостове. Известните височини са наситени около мостовете. Мрежовите точки за вода се основават на височините и разпределението на водните повърхности в базовата карта."},{"@language":"cs-t-sv-t0-mtec","@value":"Koordinované a zvýšené body v souboru mřížky jsou založeny na údajích z leteckého laserového skenování nad městem Stockholm v období od 9. dubna do 7. května 2024. Hustota bodů v původním bodovém oblaku je nejméně 16 bodů/m2 na zemi. Položky se po vytvoření neaktualizují. Data se interpolují do mřížky s rozlišením 1 m. To znamená, že v oblastech, kde se půda od skenování změnila, se souřadnice bodů neshodují. Body ve vrstvě \"Skrytá země\" ukazují interpolovanou výšku země pod stávajícími budovami. Body ve vrstvě \"Dolt Water\" ukazují interpolovanou výšku vody pod stávajícími mosty. Známé výšky jsou nasyceny kolem mostů. Mřížkové body pro vodu jsou založeny na výškách a rozložení vodních ploch v základní mapě."},{"@language":"da-t-sv-t0-mtec","@value":"De koordinerede og forhøjede punkter i netfilen er baseret på data fra luftbåren laserscanning over Stockholm by i perioden 9. april-7. maj 2024. Punkttætheden i den oprindelige punktsky er mindst 16 punkter/m2 på jorden. Elementer opdateres ikke, når de er oprettet. Dataene interpoleres til et gitter med en opløsning på 1 m. Det betyder, at for områder, hvor jorden har ændret sig siden scanningen, stemmer punkternes koordinater ikke overens. Punkterne i laget \"Skjult jord\" viser den interpolerede jordhøjde under eksisterende bygninger. Punkterne i \"Dolt Water\" laget viser den interpolerede højde af vand under eksisterende broer. De kendte højder er mættet omkring broerne. Gitterpunkter for vand er baseret på højder og fordeling af vandoverflader i basiskortet."},{"@language":"de-t-sv-t0-mtec","@value":"Die koordinierten und erhöhten Punkte in der Rasterdatei basieren auf Daten aus dem luftgestützten Laserscanning über der Stadt Stockholm im Zeitraum vom 9. April bis 7. Mai 2024. Die Punktdichte in der ursprünglichen Punktwolke beträgt mindestens 16 Punkte/m2 am Boden. Elemente werden nicht aktualisiert, nachdem sie erstellt wurden. Die Daten werden auf ein Raster mit einer Auflösung von 1 m interpoliert, was bedeutet, dass für Bereiche, in denen sich der Boden seit dem Scan verändert hat, die Koordinaten der Punkte nicht übereinstimmen. Die Punkte in der Ebene \"Versteckter Boden\" zeigen die interpolierte Bodenhöhe unter Bestandsgebäuden. Die Punkte in der Schicht \"Dolt Water\" zeigen die interpolierte Höhe des Wassers unter bestehenden Brücken. Die bekannten Höhen sind rund um die Brücken gesättigt. Gitterpunkte für Wasser basieren auf den Höhen und der Verteilung der Wasseroberflächen in der Grundkarte."},{"@language":"el-t-sv-t0-mtec","@value":"Τα συντονισμένα και υπερυψωμένα σημεία στο αρχείο πλέγματος βασίζονται σε δεδομένα από αερομεταφερόμενη σάρωση με λέιζερ πάνω από τον δήμο της Στοκχόλμης κατά την περίοδο 9 Απριλίου - 7 Μαΐου 2024. Η πυκνότητα των σημείων στο αρχικό νέφος σημείων είναι τουλάχιστον 16 σημεία/m2 στο έδαφος. Τα στοιχεία δεν ενημερώνονται μετά τη δημιουργία τους. Τα δεδομένα παρεμβάλλονται σε πλέγμα με ανάλυση 1 m. Αυτό σημαίνει ότι για περιοχές όπου το έδαφος έχει αλλάξει μετά τη σάρωση, οι συντεταγμένες των σημείων δεν ταιριάζουν. Τα σημεία στο στρώμα \"Κρυφό έδαφος\" δείχνουν το παρεμβαλλόμενο ύψος του εδάφους κάτω από τα υπάρχοντα κτίρια. Τα σημεία στο στρώμα \"Dolt Water\" δείχνουν το παρεμβαλλόμενο ύψος του νερού κάτω από τις υπάρχουσες γέφυρες. Τα γνωστά ύψη είναι κορεσμένα γύρω από τις γέφυρες. Τα σημεία πλέγματος για το νερό βασίζονται στα ύψη και την κατανομή των επιφανειών νερού στον βασικό χάρτη."},{"@language":"en-t-sv-t0-mtec","@value":"The coordinated and elevated points in the grid file are based on data from airborne laser scanning over the City of Stockholm during the period 9 April - 7 May 2024. The point density in the original point cloud is at least 16 points/m2 on the ground. Items are not updated after they are created. The data is interpolated to a grid with a resolution of 1 m. This means that for areas where the soil has changed since the scan, the coordinates of the points do not match. The points in the layer \"Hidden ground\" show the interpolated ground height under existing buildings. The points in the \"Dolt Water\" layer show the interpolated height of water under existing bridges. The known heights are saturated around the bridges. Grid points for water are based on the heights and distribution of water surfaces in the base map."},{"@language":"es-t-sv-t0-mtec","@value":"Los puntos coordinados y elevados en el archivo de cuadrícula se basan en datos del escaneo láser aerotransportado sobre la ciudad de Estocolmo durante el período comprendido entre el 9 de abril y el 7 de mayo de 2024. La densidad de puntos en la nube de puntos original es de al menos 16 puntos/m2 en el suelo. Los elementos no se actualizan después de su creación. Los datos se interpolan a una cuadrícula con una resolución de 1 m. Esto significa que para las áreas donde el suelo ha cambiado desde el escaneo, las coordenadas de los puntos no coinciden. Los puntos de la capa \"Tierra oculta\" muestran la altura interpolada del suelo debajo de los edificios existentes. Los puntos en la capa \"Dolt Water\" muestran la altura interpolada del agua debajo de los puentes existentes. Las alturas conocidas están saturadas alrededor de los puentes. Los puntos de rejilla para el agua se basan en las alturas y la distribución de las superficies de agua en el mapa base."},{"@language":"et-t-sv-t0-mtec","@value":"Võrgufailis olevad koordineeritud ja kõrgemad punktid põhinevad ajavahemikul 9. aprillist kuni 7. maini 2024 Stockholmi linna kohal õhus tehtud laserskaneerimise andmetel. Algse punktpilve punkttihedus on maapinnal vähemalt 16 punkti/m2. Esemeid ei värskendata pärast nende loomist. Andmed interpoleeritakse 1 m eraldusvõimega ruutvõrku. See tähendab, et alade puhul, kus muld on pärast skaneerimist muutunud, ei lange punktide koordinaadid kokku. Kihi \"Peidetud maa\" punktid näitavad interpoleeritud maapinna kõrgust olemasolevate hoonete all. \"Dolt Water\" kihi punktid näitavad vee interpoleeritud kõrgust olemasolevate sildade all. Teadaolevad kõrgused on sillade ümber küllastunud. Vee võrgupunktid põhinevad aluskaardil olevate veepindade kõrgusel ja jaotusel."},{"@language":"fi-t-sv-t0-mtec","@value":"Koordinoidut ja korotetut pisteet ruudukkotiedostossa perustuvat Tukholman kaupungin yllä 9.4.–7.5.2024 tehdystä laserkeilauksesta saatuihin tietoihin. Pistetiheys alkuperäisessä pistepilvessä on vähintään 16 pistettä/m2 maassa. Kohteita ei päivitetä niiden luomisen jälkeen. Tiedot interpoloidaan ruudukkoon, jonka resoluutio on 1 m. Tämä tarkoittaa, että alueilla, joilla maaperä on muuttunut skannauksen jälkeen, pisteiden koordinaatit eivät vastaa toisiaan. Kerroksen \"Piilotettu maa\" pisteet osoittavat interpoloidun maan korkeuden olemassa olevien rakennusten alla. \"Dolt Water\" -kerroksen pisteet osoittavat veden interpoloidun korkeuden olemassa olevien siltojen alla. Tunnetut korkeudet ovat kyllästettyjä siltojen ympärillä. Veden ruudukkopisteet perustuvat pohjakartan vedenpinnan korkeuteen ja jakautumiseen."},{"@language":"fr-t-sv-t0-mtec","@value":"Les points coordonnés et élevés dans le fichier de grille sont basés sur les données du balayage laser aérien au-dessus de la ville de Stockholm au cours de la période allant du 9 avril au 7 mai 2024. La densité de points dans le nuage de points d'origine est d'au moins 16 points/m2 au sol. Les éléments ne sont pas mis à jour après leur création. Les données sont interpolées sur une grille avec une résolution de 1 m. Cela signifie que pour les zones où le sol a changé depuis le balayage, les coordonnées des points ne correspondent pas. Les points de la couche \"terrain caché\" montrent la hauteur interpolée du sol sous les bâtiments existants. Les points de la couche \"Dolt Water\" montrent la hauteur interpolée de l'eau sous les ponts existants. Les hauteurs connues sont saturées autour des ponts. Les points de grille pour l'eau sont basés sur les hauteurs et la répartition des surfaces d'eau dans la carte de base."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá na pointí comhordaithe agus ardaithe sa chomhad greille bunaithe ar shonraí ó scanadh léasair aerbheirthe thar Chathair Stócólm le linn na tréimhse ón 9 Aibreán go dtí an 7 Bealtaine 2024. Tá an dlús pointe sa scamall pointe bunaidh 16 pointe / m2 ar a laghad ar an talamh. Ní dhéantar na míreanna a nuashonrú tar éis iad a chruthú. Déantar na sonraí a idirshuí le greille ag a bhfuil taifeach 1 m. Ciallaíonn sé sin, i gcás limistéir ina bhfuil athrú tagtha ar an ithir ó rinneadh an scanadh, nach bhfuil comhordanáidí na bpointí ag teacht le chéile. Léiríonn na pointí sa tsraith ‘Talamh folaithe’ an airde talún idirshuite faoi fhoirgnimh atá ann cheana. Taispeánann na pointí sa chiseal \"Uisce Dolt\" airde idirshuite an uisce faoi dhroichid atá ann cheana. Tá na hairdí aitheanta sáithithe timpeall na ndroichead. Tá pointí eangaí le haghaidh uisce bunaithe ar airde agus dáileadh dromchlaí uisce sa bhunmhapa."},{"@language":"hr-t-sv-t0-mtec","@value":"Koordinirane i povišene točke u datoteci mreže temelje se na podacima iz laserskog skeniranja u zraku iznad grada Stockholma u razdoblju od 9. travnja do 7. svibnja 2024. Gustoća točke u izvornom oblaku točke iznosi najmanje 16 točaka/m2 na tlu. Stavke se ne ažuriraju nakon što su stvorene. Podaci se interpoliraju u mrežu razlučivosti 1 m. To znači da se za područja na kojima se tlo promijenilo nakon skeniranja koordinate točaka ne podudaraju. Točke u sloju \"Skriveno tlo\" pokazuju interpoliranu visinu tla ispod postojećih zgrada. Točke u sloju \"Dolt Water\" pokazuju interpoliranu visinu vode ispod postojećih mostova. Poznate visine su zasićene oko mostova. Mrežne točke za vodu temelje se na visinama i raspodjeli vodenih površina na osnovnoj karti."},{"@language":"hu-t-sv-t0-mtec","@value":"A hálózati fájl összehangolt és emelt pontjai a Stockholm városa felett a 2024. április 9. és május 7. közötti időszakban végzett, levegőben végzett lézerszkennelésből származó adatokon alapulnak. Az eredeti pontfelhőben a pontsűrűség legalább 16 pont/m2 a földön. Az elemek a létrehozásuk után nem frissülnek. Az adatokat 1 m felbontású rácsra interpolálják. Ez azt jelenti, hogy azokon a területeken, ahol a szkennelés óta megváltozott a talaj, a pontok koordinátái nem egyeznek meg. A \"Rejtett talaj\" réteg pontjai a meglévő épületek alatti interpolált talajmagasságot mutatják. A \"Dolt víz\" réteg pontjai a meglévő hidak alatti víz interpolált magasságát mutatják. Az ismert magasságok telítettek a hidak körül. A vízhálózati pontok az alaptérképen szereplő vízfelületek magasságán és eloszlásán alapulnak."},{"@language":"it-t-sv-t0-mtec","@value":"I punti coordinati ed elevati nel file della griglia si basano sui dati della scansione laser in volo sulla città di Stoccolma nel periodo dal 9 aprile al 7 maggio 2024. La densità del punto nella nuvola di punti originale è di almeno 16 punti / m2 sul terreno. Gli elementi non vengono aggiornati dopo la loro creazione. I dati vengono interpolati su una griglia con una risoluzione di 1 m. Ciò significa che per le aree in cui il terreno è cambiato dopo la scansione, le coordinate dei punti non corrispondono. I punti nello strato \"Terra nascosta\" mostrano l'altezza interpolata del terreno sotto gli edifici esistenti. I punti dello strato \"Dolt Water\" mostrano l'altezza interpolata dell'acqua sotto i ponti esistenti. Le altezze conosciute sono sature intorno ai ponti. I punti di griglia per l'acqua si basano sulle altezze e sulla distribuzione delle superfici dell'acqua nella mappa di base."},{"@language":"lt-t-sv-t0-mtec","@value":"Koordinuoti ir padidinti tinklelio rinkmenos taškai grindžiami 2024 m. balandžio 9 d. – gegužės 7 d. Stokholmo miesto lazerinio skenavimo ore duomenimis. Taškų tankis pradiniame taškų debesyje yra ne mažesnis kaip 16 taškų/m2 ant žemės. Elementai nėra atnaujinami po to, kai jie yra sukurti. Duomenys interpoliuojami į 1 m skiriamosios gebos tinklelį. Tai reiškia, kad plotuose, kuriuose po skenavimo pasikeitė dirvožemis, taškų koordinatės nesutampa. Sluoksnio \"Paslėpta žemė\" taškai rodo interpoliuotą žemės aukštį po esamais pastatais. \"Dolto vandens\" sluoksnio taškai rodo interpoliuotą vandens aukštį po esamais tiltais. Žinomos aukštumos yra prisotintos aplink tiltus. Vandens tinklelio taškai yra pagrįsti vandens paviršių aukščiu ir pasiskirstymu pagrindiniame žemėlapyje."},{"@language":"lv-t-sv-t0-mtec","@value":"Koordinētie un paaugstinātie punkti režģa datnē ir balstīti uz datiem no lāzerskenēšanas gaisā Stokholmas pilsētā laikposmā no 2024. gada 9. aprīļa līdz 7. maijam. Punktu blīvums sākotnējā punktu mākonī ir vismaz 16 punkti/m2 uz zemes. Pēc izveides vienumi netiek atjaunināti. Datus interpolē uz koordinātu tīklu ar izšķirtspēju 1 m. Tas nozīmē, ka vietās, kur augsne kopš skenēšanas ir mainījusies, punktu koordinātas nesakrīt. Punkti slānī \"Slēpta zeme\" parāda interpolēto zemes augstumu zem esošajām ēkām. Punkti \"Dolt Water\" slānī parāda ūdens interpolēto augstumu zem esošajiem tiltiem. Zināmie augstumi ir piesātināti ap tiltiem. Režģa punkti ūdenim ir balstīti uz ūdens virsmu augstumu un sadalījumu bāzes kartē."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-punti kkoordinati u elevati fil-fajl tal-grilja huma bbażati fuq data minn skennjar bil-laser fl-ajru fuq il-Belt ta' Stokkolma matul il-perjodu 9 ta' April - 7 ta' Mejju 2024. Id-densità tal-punt fis-sħaba tal-punt oriġinali hija mill-inqas 16-il punt/m2 fuq l-art. L-oġġetti ma jiġux aġġornati wara li jinħolqu. Id-data tiġi interpolata ma’ grilja b’riżoluzzjoni ta’ 1 m. Dan ifisser li għal żoni fejn il-ħamrija nbidlet mill-iskan, il-koordinati tal-punti ma jaqblux. Il-punti fis-saff “Art moħbija” juru l-għoli tal-art interpolat taħt bini eżistenti. Il-punti fis-saff \"Dolt Water\" juru l-għoli interpolat tal-ilma taħt il-pontijiet eżistenti. L-għoli magħruf huwa saturat madwar il-pontijiet. Il-punti tal-grilja għall-ilma huma bbażati fuq l-għoli u d-distribuzzjoni tal-uċuħ tal-ilma fil-mappa bażi."},{"@language":"nl-t-sv-t0-mtec","@value":"De gecoördineerde en verhoogde punten in het rasterbestand zijn gebaseerd op gegevens van laserscanning in de lucht boven de stad Stockholm in de periode van 9 april tot en met 7 mei 2024. De puntdichtheid in de oorspronkelijke puntwolk bedraagt ten minste 16 punten/m2 op de grond. Items worden niet bijgewerkt nadat ze zijn gemaakt. De gegevens worden geïnterpoleerd naar een raster met een resolutie van 1 m. Dit betekent dat voor gebieden waar de bodem sinds de scan is veranderd, de coördinaten van de punten niet overeenkomen. De punten in de laag \"Verborgen grond\" tonen de geïnterpoleerde grondhoogte onder bestaande gebouwen. De punten in de laag \"Dolt Water\" tonen de geïnterpoleerde hoogte van het water onder bestaande bruggen. De bekende hoogtes zijn verzadigd rond de bruggen. Netpunten voor water zijn gebaseerd op de hoogte en verdeling van wateroppervlakken in de basiskaart."},{"@language":"pl-t-sv-t0-mtec","@value":"Skoordynowane i podwyższone punkty w pliku siatki opierają się na danych z lotniczego skanowania laserowego nad miastem Sztokholm w okresie od 9 kwietnia do 7 maja 2024 r. Gęstość punktów w pierwotnej chmurze punktów wynosi co najmniej 16 punktów/m2 na ziemi. Elementy nie są aktualizowane po ich utworzeniu. Dane są interpolowane do siatki o rozdzielczości 1 m. Oznacza to, że w przypadku obszarów, w których gleba zmieniła się od czasu skanowania, współrzędne punktów nie są zgodne. Punkty w warstwie \"Ukryte podłoże\" pokazują interpolowaną wysokość podłoża pod istniejącymi budynkami. Punkty w warstwie \"Dolt Water\" pokazują interpolowaną wysokość wody pod istniejącymi mostami. Znane wysokości są nasycone wokół mostów. Punkty siatki dla wody są oparte na wysokościach i rozmieszczeniu powierzchni wody na mapie bazowej."},{"@language":"pt-t-sv-t0-mtec","@value":"Os pontos coordenados e elevados no ficheiro da grelha baseiam-se em dados de varrimento a laser aéreo sobre a cidade de Estocolmo durante o período de 9 de abril a 7 de maio de 2024. A densidade de pontos na nuvem de pontos original é de pelo menos 16 pontos/m2 no solo. Os itens não são atualizados depois de serem criados. Os dados são interpolados para uma grelha com uma resolução de 1 m. Isto significa que, para áreas onde o solo mudou desde a varredura, as coordenadas dos pontos não coincidem. Os pontos na camada \"Terra oculta\" mostram a altura do solo interpolada sob os edifícios existentes. Os pontos na camada \"Dolt Water\" mostram a altura interpolada da água sob as pontes existentes. As alturas conhecidas estão saturadas em torno das pontes. Os pontos de grelha para a água baseiam-se nas alturas e na distribuição das superfícies de água no mapa de base."},{"@language":"ro-t-sv-t0-mtec","@value":"Punctele coordonate și ridicate din fișierul de rețea se bazează pe datele obținute prin scanarea cu laser în aer deasupra orașului Stockholm în perioada 9 aprilie-7 mai 2024. Densitatea punctului în norul de puncte original este de cel puțin 16 puncte/m2 pe sol. Elementele nu sunt actualizate după ce au fost create. Datele sunt interpolate într-o rețea cu o rezoluție de 1 m. Aceasta înseamnă că, pentru zonele în care solul s-a schimbat de la scanare, coordonatele punctelor nu se potrivesc. Punctele din stratul \"Teren ascuns\" arată înălțimea interpolată a solului sub clădirile existente. Punctele din stratul \"Dolt Water\" arată înălțimea interpolată a apei sub podurile existente. Înălțimile cunoscute sunt saturate în jurul podurilor. Punctele de rețea pentru apă se bazează pe înălțimile și distribuția suprafețelor de apă din harta de bază."},{"@language":"sk-t-sv-t0-mtec","@value":"Koordinované a zvýšené body v súbore mriežky sú založené na údajoch z leteckého laserového skenovania nad mestom Štokholm v období od 9. apríla do 7. mája 2024. Hustota bodu v pôvodnom bodovom oblaku je najmenej 16 bodov/m2 na zemi. Položky sa po vytvorení neaktualizujú. Údaje sa interpolujú do mriežky s rozlíšením 1 m. To znamená, že v oblastiach, kde sa pôda od skenovania zmenila, sa súradnice bodov nezhodujú. Body vo vrstve \"Skrytá zem\" zobrazujú interpolovanú výšku zeme pod existujúcimi budovami. Body vo vrstve \"Dolt Water\" ukazujú interpolovanú výšku vody pod existujúcimi mostami. Známe výšky sú nasýtené okolo mostov. Mriežkové body pre vodu sú založené na výškach a rozložení vodných plôch v základnej mape."},{"@language":"sl-t-sv-t0-mtec","@value":"Usklajene in povišane točke v mrežni datoteki temeljijo na podatkih iz laserskega skeniranja v zraku nad mestom Stockholm v obdobju od 9. aprila do 7. maja 2024. Gostota točk v prvotnem oblaku točk je najmanj 16 točk/m2 na tleh. Elementi se ne posodabljajo, ko so ustvarjeni. Podatki se interpolirajo v mrežo z ločljivostjo 1 m. To pomeni, da se na območjih, kjer so se tla od skeniranja spremenila, koordinate točk ne ujemajo. Točke v sloju \"Skrita tla\" prikazujejo interpolirano višino tal pod obstoječimi stavbami. Točke v sloju \"Dolt Water\" prikazujejo interpolirano višino vode pod obstoječimi mostovi. Znane višine so nasičene okoli mostov. Omrežne točke za vodo temeljijo na višini in porazdelitvi vodnih površin na osnovnem zemljevidu."},{"@language":"sv","@value":"De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 9 april7 maj 2024. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna ajourförs inte sedan de skapas. Datat är interpolerat till ett grid med upplösning 1 m. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. De kända höjderna är mätta runtom byggnaden.Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},{"@language":"uk-t-sv-t0-mtec","@value":"Координовані та підвищені точки у файлі сітки базуються на даних повітряного лазерного сканування над містом Стокгольм у період з 9 квітня по 7 травня 2024 року. Щільність точок у початковій хмарі точок становить щонайменше 16 точок/м2 на землі. Елементи не оновлюються після їх створення. Дані інтерполюються в сітку з роздільною здатністю 1 м. Точки в шарі «Прихована земля» показують інтерпольовану висоту землі під існуючими будівлями. Точки в шарі «Долтова вода» показують інтерпольовану висоту води під існуючими мостами. Відомі висоти насичені навколо мостів. Точки сітки для води базуються на висоті та розподілі водних поверхонь на базовій карті."}],"dct:format":"text/html","dct:identifier":"ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b0n0"},"dct:temporal":{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Höggrid (2024 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Höggridová (2024)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Höggrid (2024) (στα αγγλικά)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Höggrid (2024.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Höggrid (2024 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sv","@value":"SBK Höjdgrid (2024)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/met