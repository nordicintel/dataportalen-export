net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]}],"@id":"urn:source:2d393eb7e9be4d81b6b659ef1a19f479494a13be8dd8468dbc2d52c32c114c4c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:OGC:WMS/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=59b72fb2-0588-4fda-88af-53d7772055bc"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"Stockholms stadsmuseum ansvarar för att peka ut och definiera kulturhistoriskt värdefull bebyggelse i Stockholms stad. Klassificeringen grundas på de inventeringar Stadsmuseet kontinuerligt gjort sedan 1970-talet och omfattar bebyggelse uppförd före 1960 eller 1990. Ställningstagandet om stadens kulturhistoriska klassificering fattas av Stadsmuseets chef, stadsantikvarien, på delegation av kommunfullmäktige. Klassificering av stadens bebyggelse är ett pågående arbete och nya klassificeringar förs in på den digitala kartan."},"dct:identifier":"2a64e957-9133-41b1-a101-05196d12df33","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@value":"Stadsmuseets kulturhistoriska klassifcieringskarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/dpwebmap/cust_sth/kul/klassificering/DPWebMap.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation (DP/webmap) -Stockholms stadsmuseums kulturhistoriska klassificeringskarta"},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/dpmap/cust_sth/kul/web/WMS_KUL_KLASSIFICERING_DPWEBMAP?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"Kulturhistorisk klassificering (WMS)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Kulturförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info.stadsmuseum@stockholm.se"}}],"@id":"urn:source:2f20dbce97019e63662ce25e1fe490d3fb4fda782ccd85b5bc8a1724e8d9d8e3"},{"@graph":[{"@id":"_:2f80a108b54a212f3ebed6d3fe29fff37afbaa359a8cac0234fa900f9ff68b06_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4436,18.2011 59.4436,18.2011 59.2272,17.7605 59.2272,17.7605 59.4436))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4436,18.2011 59.4436,18.2011 59.2272,17.7605 59.2272,17.7605 59.4436))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:ESRI+Portal-URL/2"},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:Information/1"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=55bd8a0a-1ed9-4e7b-8b2d-74277702635d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"För att följa klimatförändringar krävs tillgång till långa tidsserier med väderdata för flera decennier. Stockholms klimat- och väderstatistik baseras främst på data från SMHI:s mätstation vid Observatorielunden. Den hydrologiska statistiken (vatten) hämtas från olika mätstationer i Mälaren och Saltsjön. Med hjälp av de långa mätserierna går det att uppskatta trender och naturlig variation."},"dct:identifier":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2f80a108b54a212f3ebed6d3fe29fff37afbaa359a8cac0234fa900f9ff68b06_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Klimat - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/klimat/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"MiljödataStockholm"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:2f80a108b54a212f3ebed6d3fe29fff37afbaa359a8cac0234fa900f9ff68b06"},{"@graph":[{"@id":"_:300eeb5b57598b97450df2a16d77e1f114cbe3f16fb76291e60ee1acdad105aa_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"f25295fd319ec3b8fc8583dd0b094a5e6"},{"@id":"http://data.europa.eu/88u/dataset/52deadb7-819f-4f84-af19-149474eb4706","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Exploateringsn%C3%A4mnd/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/8ef9cb6e-0570-4f04-8ba3-da3feea3dd53"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Geovetenskap"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=74366fbb-6fc5-4462-8229-3a4fbbe6a299"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2013-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"В геоархива е събрана информация за гео-характер. Материалът е наличен както в аналогов, така и в цифров формат, но голяма част от материала е прехвърлен в цифров формат. Геоархивът съдържа: •Геотехнически сонди (приблизително 600 000). •Геотехнически сонди (планирани). •Геотехнически разследвания (около 3000). •Геологични карти (скали 1:2000 и 1:10 000). •Карти на фондации на къщи (скала 1:2000). •Основни водни нива (около 600 активни тръби за подземни води и около 1000 завършени). •Определяне на баланси от сгради (около 250 сгради, от които около 100 в Стария град). •Установяване на баланс на земята (приблизително 60 огледала за определяне на земята)."},{"@language":"cs-t-sv-t0-mtec","@value":"V geoarchivu byly shromážděny informace o geocharakteru. Materiál je k dispozici v analogovém i digitálním formátu, ale většina materiálu byla převedena do digitálního formátu. Geoarchiv obsahuje: Geotechnické sondy (přibližně 600 000). Geotechnické sondy (plánované). Geotechnická šetření (přibližně 3000). •Geologické mapy (stupnice 1:2000 a 1:10 000). •Základní mapy domu (stupnice 1:2000). •Základní vodní stavy (asi 600 aktivních potrubí podzemních vod a asi 1000 dokončených). •Nastavení zůstatků z budov (asi 250 budov, z toho asi 100 na Starém Městě). •Vyvážení půdy (přibližně 60 zrcadel pro pozemní nastavení)."},{"@language":"da-t-sv-t0-mtec","@value":"I geoarkivet er der indsamlet oplysninger om et geotegn. Materialet er tilgængeligt i både analogt og digitalt format, men meget af materialet er blevet overført til digitalt format. Geoarkivet indeholder: •Geotekniske sonder (ca. 600.000). •Geotekniske sonder (planlagt). •Geotekniske undersøgelser (ca. 3000). •Geologiske kort (skala 1:2000 og 1:10 000). •Hjemfundamentskort (skala 1:2000). •Grundvandsniveauer (ca. 600 aktive grundvandsrør og ca. 1 000 færdiggjorte). •Indstilling af saldi fra bygninger (ca. 250 bygninger, heraf ca. 100 i den gamle bydel). •Setting-balancering af jordarealer (ca. 60 jordbaserede spejle)."},{"@language":"de-t-sv-t0-mtec","@value":"Im Geo-Archiv wurden Informationen über einen Geo-Charakter gesammelt. Das Material ist sowohl im analogen als auch im digitalen Format erhältlich, aber ein Großteil des Materials wurde in das digitale Format übertragen. Das Geo-Archiv enthält: •Geotechnische Sonden (ca. 600.000). •Geotechnische Sonden (geplant). •Geotechnische Untersuchungen (ca. 3000). •Geologische Karten (Maßstäbe 1:2000 und 1:10 000). •Hausfundamentkarten (Maßstab 1:2000). •Grundwasserstände (ca. 600 aktive Grundwasserleitungen und ca. 1000 abgeschlossen). •Balancen von Gebäuden einrichten (ca. 250 Gebäude, davon ca. 100 in der Altstadt). •Setting-Balancing von Grundstücken (ca. 60 Bodenspiegel)."},{"@language":"el-t-sv-t0-mtec","@value":"Στο Γεωαρχείο έχουν συλλεχθεί πληροφορίες ενός γεω-χαρακτήρα. Το υλικό είναι διαθέσιμο τόσο σε αναλογική όσο και σε ψηφιακή μορφή, αλλά μεγάλο μέρος του υλικού έχει μεταφερθεί σε ψηφιακή μορφή. Το Γεωαρχείο περιέχει: •Γεωτεχνικοί ανιχνευτές (περίπου 600.000). •Γεωτεχνικοί ανιχνευτές (προγραμματισμένοι). •Γεωτεχνικές έρευνες (περίπου 3000). •Γεωλογικοί χάρτες (κλίμακες 1:2000 και 1:10 000). •Χάρτες θεμελίωσης οικιών (κλίμακα 1:2000). •Βασική στάθμη των υδάτων (περίπου 600 ενεργοί σωλήνες υπόγειων υδάτων και περίπου 1000 ολοκληρωμένοι). •Ρύθμιση ισοζυγίων από κτίρια (περίπου 250 κτίρια, εκ των οποίων περίπου 100 στην Παλιά Πόλη). •Ρύθμιση-εξισορρόπηση της γης (περίπου 60 κάτοπτρα διαμόρφωσης εδάφους)."},{"@language":"en-t-sv-t0-mtec","@value":"In the Geo-archive, information of a geo-character has been collected. The material is available in both analogue and digital format, but much of the material has been transferred to digital format. The Geo-archive contains: •Geotechnical probes (approx. 600,000). •Geotechnical probes (planned). •Geotechnical investigations (about 3000). •Geological maps (scales 1:2000 and 1:10 000). •House foundation maps (scale 1:2000). •Basic water levels (about 600 active groundwater pipes and about 1000 completed). •Setting balances from buildings (about 250 buildings of which about 100 in the Old Town). •Setting-balancing of land (approx. 60 ground-setting mirrors)."},{"@language":"es-t-sv-t0-mtec","@value":"En el Geoarchivo, se ha recopilado información de un geo-carácter. El material está disponible tanto en formato analógico como digital, pero gran parte del material se ha transferido a formato digital. El Geoarchivo contiene: •Sondas geotécnicas (aproximadamente 600.000). •Sondas geotécnicas (previstas). •Investigaciones geotécnicas (alrededor de 3000). •Mapas geológicos (escalas 1:2000 y 1:10 000). •Mapas de fundación de la casa (escala 1:2000). •Niveles básicos de agua (alrededor de 600 tuberías de agua subterránea activas y alrededor de 1000 terminadas). •Configuración de los saldos de los edificios (alrededor de 250 edificios, de los cuales unos 100 en el casco antiguo). •Equilibrio de la tierra (aproximadamente 60 espejos de puesta a tierra)."},{"@language":"et-t-sv-t0-mtec","@value":"Geoarhiivis on kogutud geograafilisi tunnuseid. Materjal on saadaval nii analoog- kui ka digitaalvormingus, kuid suur osa materjalist on üle kantud digitaalsesse vormingusse. Geoarhiiv sisaldab: •Geotehnilised sondid (umbes 600 000). •Geotehnilised sondid (planeeritud). •Geotehnilised uuringud (umbes 3000). •Geoloogilised kaardid (skaalad 1:2000 ja 1:10 000). •House Foundationi kaardid (skaalal 1:2000). •Põhivee tase (ligikaudu 600 aktiivset põhjaveetorustikku ja ligikaudu 1000 valminud torustikku). •Hoonete saldode seadmine (umbes 250 hoonet, millest umbes 100 vanalinnas). •Maa tasakaalustamine (ligikaudu 60 maapinnale paigaldatavat peeglit)."},{"@language":"fi-t-sv-t0-mtec","@value":"Geo-arkistossa on kerätty tietoa geo-merkistä. Materiaali on saatavilla sekä analogisessa että digitaalisessa muodossa, mutta suuri osa materiaalista on siirretty digitaaliseen muotoon. Geo-arkisto sisältää: •Geotekniset luotaimet (noin 600 000). •Geotekniset anturit (suunniteltu). •Geotekniset tutkimukset (noin 3000). •Geologiset kartat (asteikot 1:2000 ja 1:10 000). •Talokartat (mittakaava 1:2000). •Perusvedenkorkeus (noin 600 aktiivista pohjavesiputkea ja noin 1 000 valmis). •Tasapainon asettaminen rakennuksista (noin 250 rakennusta, joista noin 100 vanhassa kaupungissa). •Maan tasapainottaminen (noin 60 maanpäällistä peiliä)."},{"@language":"fr-t-sv-t0-mtec","@value":"Dans la Geo-archive, les informations d'un géo-caractère ont été collectées. Le matériel est disponible en format analogique et numérique, mais une grande partie du matériel a été transférée au format numérique. La Géo-archive contient: •Sondes géotechniques (environ 600 000). •Sondes géotechniques (prévues). •Enquêtes géotechniques (environ 3000). •Cartes géologiques (échelles 1:2000 et 1:10 000). •Cartes des fondations de la maison (échelle 1:2000). •niveaux d’eau de base (environ 600 conduites d’eau souterraine actives et environ 1 000 conduites achevées). •Réglage des soldes des bâtiments (environ 250 bâtiments, dont une centaine dans la vieille ville). •Réglage-équilibrage des terrains (environ 60 rétroviseurs au sol)."},{"@language":"ga-t-sv-t0-mtec","@value":"Sa Gheo-ailtireacht, bailíodh faisnéis faoi gheo-charachtar. Tá an t-ábhar ar fáil i bhformáid analógach agus dhigiteach araon, ach aistríodh cuid mhaith den ábhar go formáid dhigiteach. Tá an méid seo a leanas sa gheo-ailtireacht: •Tóireadóirí geoiteicniúla (thart ar 600,000). •Tóireadóirí geoiteicniúla (beartaithe). •Imscrúduithe geoiteicniúla (thart ar 3000). •Léarscáileanna geolaíocha (scálaí 1:2000 agus 1:10 000). •Léarscáileanna fondúireachta tí (scála 1:2000). •Leibhéil bhunúsacha uisce (thart ar 600 píobán screamhuisce gníomhach agus thart ar 1000 díobh curtha i gcrích). •Iarmhéideanna a shocrú ó fhoirgnimh (thart ar 250 foirgneamh a bhfuil thart ar 100 díobh sa Seanbhaile). •Talamh a chothromú (thart ar 60 scáthán socraithe talún)."},{"@language":"hr-t-sv-t0-mtec","@value":"U geoarhiviji su prikupljene informacije o geokarakteru. Materijal je dostupan i u analognom i u digitalnom obliku, ali velik dio materijala prenesen je u digitalni format. Geoarhiv sadržava: •Geotehničke sonde (otprilike 600 000). •Geotehničke sonde (planirane). •Geotehničke istrage (oko 3000). •geološke karte (skale 1:2000 i 1:10 000). •Kuća temelj karte (skala 1:2000). •Temeljne razine vode (oko 600 aktivnih cijevi podzemnih voda i oko 1000 dovršenih). •Postavljanje salda iz zgrada (oko 250 zgrada od čega oko 100 u Starom gradu). •Uravnoteženje zemljišta (približno 60 zrcala za postavljanje tla)."},{"@language":"hu-t-sv-t0-mtec","@value":"A Geo-archívumban egy geo-karakter információit gyűjtötték össze. Az anyag analóg és digitális formátumban is elérhető, de az anyag nagy része digitális formátumba került. A Geo-archívum tartalma: •Geotechnikai szondák (kb. 600 000). •Geotechnikai szondák (tervezett). •Geotechnikai vizsgálatok (körülbelül 3000). •Földtani térképek (1:2000 és 1:10 000 méretarány). • Házalapítási térképek (1:2000 méretarány). •Alapvízszintek (körülbelül 600 aktív felszín alatti vízvezeték és körülbelül 1000 befejezett). •Egyenlegek rendezése épületekből (kb. 250 épület, ebből kb. 100 az óvárosban). •A földterület egyensúlyba hozása (kb. 60 földbeálló tükör)."},{"@language":"it-t-sv-t0-mtec","@value":"Nel Geo-archivio sono state raccolte le informazioni di un geo-carattere. Il materiale è disponibile sia in formato analogico che digitale, ma gran parte del materiale è stato trasferito in formato digitale. Il Geo-archivio contiene: •Sonda geotecnica (circa 600.000). •Sonde geotecniche (pianificate). •Indagini geotecniche (circa 3000). •Mappe geologiche (scale 1:2000 e 1:10 000). •Mappe delle fondazioni domestiche (scala 1:2000). •Livelli idrici di base (circa 600 condutture attive delle acque sotterranee e circa 1000 completate). •Impostazione di saldi da edifici (circa 250 edifici di cui circa 100 nel centro storico). •Equilibrio del terreno (circa 60 specchi per l'assetto del terreno)."},{"@language":"lt-t-sv-t0-mtec","@value":"Geoarchyve surinkta informacija apie geografinį simbolį. Medžiaga yra prieinama tiek analoginiu, tiek skaitmeniniu formatu, tačiau didelė dalis medžiagos buvo perkelta į skaitmeninį formatą. Geoarchyvą sudaro: •Geotechniniai zondai (apie 600 000). •Geotechniniai zondai (planuojami). •Geotechniniai tyrimai (apie 3000). •Geologiniai žemėlapiai (1:2000 ir 1:10 000 masteliai). •Namų pamatų žemėlapiai (1:2000 mastelis). •Pagrindinis vandens lygis (apie 600 aktyvių požeminio vandens vamzdžių ir apie 1000 užbaigtų). •balansų nustatymas iš pastatų (apie 250 pastatų, iš kurių apie 100 yra senamiestyje). •Žemės nustatymas-balansavimas (apie 60 žemės nustatymo veidrodžių)."},{"@language":"lv-t-sv-t0-mtec","@value":"Ģeoarhīvā ir apkopota informācija par ģeoraksturojumu. Materiāls ir pieejams gan analogā, gan digitālā formātā, bet liela daļa materiāla ir pārnesta uz digitālo formātu. Ģeoarhīva satur: •Ģeotehniskās zondes (aptuveni 600 000). •Ģeotehniskās zondes (plānotas). •Ģeotehniskie izmeklējumi (aptuveni 3000). •Ģeoloģiskās kartes (mērogi 1:2000 un 1:10 000). •Mājas pamatu kartes (mērogs 1:2000). •Pamata ūdens līmenis (apmēram 600 aktīvo gruntsūdeņu cauruļvadu un aptuveni 1000 pabeigti). •Atlikumu veidošana no ēkām (aptuveni 250 ēkas, no kurām aptuveni 100 atrodas Vecrīgā). •Zemes līdzsvarošana (apmēram 60 zemes nostādināšanas spoguļi)."},{"@language":"mt-t-sv-t0-mtec","@value":"Fil-ġeo-arkivju, inġabret informazzjoni ta 'ġeo-karattru. Il-materjal huwa disponibbli kemm f'format analogu kif ukoll diġitali, iżda ħafna mill-materjal ġie trasferit f'format diġitali. Il-ġeo-arkivju fih: •Sensuri ġeotekniċi (madwar 600,000). •Sensuri ġeotekniċi (ippjanati). •Investigazzjonijiet ġeotekniċi (madwar 3000). •Mapep ġeoloġiċi (skali 1:2000 u 1:10 000). •Mapep tal-fondazzjoni tad-dar (skala 1:2000). •Livelli bażiċi tal-ilma (madwar 600 pajpijiet attivi tal-ilma ta’ taħt l-art u madwar 1000 mitmuma). •L-istabbiliment ta’ bilanċi mill-bini (madwar 250 binja li minnhom madwar 100 jinsabu fil-Belt il-Qadima). •L-istabbiliment tal-ibbilanċjar tal-art (madwar 60 mirja li jistabbilixxu l-art)."},{"@language":"nl-t-sv-t0-mtec","@value":"In het Geo-archief is informatie van een geo-karakter verzameld. Het materiaal is beschikbaar in zowel analoog als digitaal formaat, maar een groot deel van het materiaal is overgebracht naar digitaal formaat. Het Geo-archief bevat: •Geotechnische sondes (ongeveer 600.000). •Geotechnische sondes (gepland). •Geotechnisch onderzoek (ongeveer 3000). •Geologische kaarten (schalen 1:2000 en 1:10 000). •Huisfunderingskaarten (schaal 1:2000). •Basiswaterstanden (ongeveer 600 actieve grondwaterleidingen en ongeveer 1000 voltooid). •Saldo's van gebouwen (ongeveer 250 gebouwen, waarvan ongeveer 100 in de oude binnenstad). •Setting-balancering van de grond (ongeveer 60 grond-setting spiegels)."},{"@language":"pl-t-sv-t0-mtec","@value":"W Geo-archiwum zebrano informacje o geo-znaku. Materiał jest dostępny zarówno w formacie analogowym, jak i cyfrowym, ale znaczna część materiału została przeniesiona do formatu cyfrowego. Geo-archiwum zawiera: •sondy geotechniczne (ok. 600 000). •sondy geotechniczne (planowane). •Dochodzenia geotechniczne (około 3000). •mapy geologiczne (skale 1:2000 i 1:10 000). •Mapy fundamentów domów (skala 1:2000). •Podstawowy poziom wody (około 600 czynnych rur wód podziemnych i około 1000 ukończonych). •Ustalanie sald z budynków (około 250 budynków, z czego około 100 na Starym Mieście). •Równoważenie gruntów (ok. 60 lusterek naziemnych)."},{"@language":"pt-t-sv-t0-mtec","@value":"No Geo-arquivo, informações de um geo-caráter foram coletadas. O material está disponível em formato analógico e digital, mas grande parte do material foi transferido para o formato digital. O geoarquivo contém: • Sondas geotécnicas (aproximadamente 600 000). • Sondas geotécnicas (planeadas). •Investigações geotécnicas (cerca de 3000). •Mapas geológicos (escalas 1:2000 e 1:10 000). •Mapas de fundação da casa (escala 1:2000). •Níveis básicos de água (cerca de 600 condutas de águas subterrâneas ativas e cerca de 1000 concluídas). •Definir saldos de edifícios (cerca de 250 edifícios, dos quais cerca de 100 na Cidade Velha). •Estabelecimento do equilíbrio do terreno (aproximadamente 60 espelhos de regulação do solo)."},{"@language":"ro-t-sv-t0-mtec","@value":"În geoarhivă, au fost colectate informații despre un geocaracter. Materialul este disponibil atât în format analogic, cât și digital, dar o mare parte din material a fost transferat în format digital. Geoarhiva conține: •sonde geotehnice (aproximativ 600.000). •sonde geotehnice (planificate). •Investigații geotehnice (aproximativ 3000). •Hărți geologice (scările 1:2000 și 1:10 000). •Hărțile fundației casei (scara 1:2000). •Nivelurile de bază ale apei (aproximativ 600 de conducte active de apă subterană și aproximativ 1000 finalizate). •stabilirea soldurilor din clădiri (aproximativ 250 de clădiri, din care aproximativ 100 în orașul vechi). •Echilibrarea terenului (aproximativ 60 de oglinzi retrovizoare)."},{"@language":"sk-t-sv-t0-mtec","@value":"V geoarchíve boli zhromaždené informácie o geocharakte. Materiál je dostupný v analógovom aj digitálnom formáte, ale veľká časť materiálu bola prenesená do digitálneho formátu. Geoarchív obsahuje: •Geotechnické sondy (približne 600 000). •Geotechnické sondy (plánované). •Geotechnické vyšetrovanie (približne 3000). •Geologické mapy (stupnice 1:2000 a 1:10 000). •Mapy základov domu (stupnica 1:2000). •Základné hladiny vody (približne 600 aktívnych potrubí podzemnej vody a približne 1000 dokončených). •Nastavenie rovnováhy z budov (približne 250 budov, z toho asi 100 v Starom Meste). •Vyvažovanie pôdy (približne 60 zrkadiel na nastavenie terénu)."},{"@language":"sl-t-sv-t0-mtec","@value":"V geoarhivu so zbrane informacije o geoznaku. Gradivo je na voljo v analogni in digitalni obliki, vendar je bil velik del gradiva prenesen v digitalno obliko. Geo-arhiv vsebuje: •Geotehnične sonde (približno 600.000). •Geotehnične sonde (načrtovane). •Geotehnične preiskave (približno 3000). •Geološke karte (merili 1:2000 in 1:10 000). •Zemljevidi hišnih temeljev (lestvica 1:2000). •Osnovni vodostaj (približno 600 aktivnih cevi podzemne vode in približno 1000 dokončanih). •Nastavitev bilanc iz stavb (približno 250 stavb, od tega približno 100 v starem mestnem jedru). •Uravnavanje zemljišč (približno 60 pritličnih ogledal)."},{"@language":"sv","@value":"I Geoarkivet har information av geokaraktär samlats. Materialet finns både i analogt och i digitalt format men stor del av materialet har förts över till digitalt format. I Geoarkivet finns: •Geotekniska sonderingar (ca 600 000 st). •Geotekniska sonderingar (planredovisade). •Geotekniska utredningar (ca 3000 st). •Geologiska kartor (skala 1:2000 och 1:10 000). •Husgrundläggningskartor (skala 1:2000). •Grundvattennivåer (ca 600 aktiva grundvattenrör och ca 1000 avslutade). •Sättningsavvägningar från byggnader (ca 250 byggnader varav ca 100 st i Gamla Stan). •Sättningsavvägning av mark (ca 60 st marksättningspeglar)."},{"@language":"uk-t-sv-t0-mtec","@value":"У Геоархіві зібрана інформація геосимволу. Матеріал доступний як в аналоговому, так і в цифровому форматі, але більша частина матеріалу була перенесена в цифровий формат. Геоархів містить: Геотехнічні зонди (приблизно 600 000). Геотехнічні зонди (заплановані). Геотехнічні дослідження (близько 3000). Геологічні карти (масштаби 1:2000 і 1:10 000). Карти фондів будинків (масштаб 1:2000). Базові рівні води (близько 600 активних труб підземних вод і близько 1000 завершених). Встановлення балансів від будівель (близько 250 будівель, з яких близько 100 у Старому місті). Розстановка-балансування земельної ділянки (прибл. 60 заземлюючих дзеркал)."}],"dct:format":"text/html","dct:identifier":"52deadb7-819f-4f84-af19-149474eb4706","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Геоархив"},{"@language":"cs-t-sv-t0-mtec","@value":"Geoarchiv"},{"@language":"da-t-sv-t0-mtec","@value":"Geoarkiv"},{"@language":"de-t-sv-t0-mtec","@value":"Geoarchiv"},{"@language":"el-t-sv-t0-mtec","@value":"Γεωαρχείο"},{"@language":"en-t-sv-t0-mtec","@value":"Geo-archive"},{"@language":"es-t-sv-t0-mtec","@value":"Geoarchivo"},{"@language":"et-t-sv-t0-mtec","@value":"Geoarhiiv"},{"@language":"fi-t-sv-t0-mtec","@value":"Geoarkisto"},{"@language":"fr-t-sv-t0-mtec","@value":"Géo-archives"},{"@language":"ga-t-sv-t0-mtec","@value":"Geo-cartlann"},{"@language":"hr-t-sv-t0-mtec","@value":"Geoarhiv"},{"@language":"hu-t-sv-t0-mtec","@value":"Geoarchívum"},{"@language":"it-t-sv-t0-mtec","@value":"Geo-archivio"},{"@language":"lt-t-sv-t0-mtec","@value":"Geografinis archyvas"},{"@language":"lv-t-sv-t0-mtec","@value":"Ģeoarhīvs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ġeo-arkivjali"},{"@language":"nl-t-sv-t0-mtec","@value":"Geo-archief"},{"@language":"pl-t-sv-t0-mtec","@value":"Geoarchiwum"},{"@language":"pt-t-sv-t0-mtec","@value":"Geoarquivo"},{"@language":"ro-t-sv-t0-mtec","@value":"Geoarhivă"},{"@language":"sk-t-sv-t0-mtec","@value":"Geoarchív"},{"@language":"sl-t-sv-t0-mtec","@value":"Geoarhiv"},{"@language":"sv","@value":"Geoarkivet"},{"@language":"uk-t-sv-t0-mtec","@value":"Геоархів"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/8ef9cb6e-0570-4f04-8ba3-da3feea3dd53","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.stockholm.se/geoarkivet"},"dct:description":"Geoarkivet är en e-tjänst där det finns funktioner för att söka efter och ladda ned data.","dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/74366fbb-6fc5-4462-8229-3a4fbbe6a299#HTTP:Information/1","dct:title":"Geoarkivet","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/8ef9cb6e-0570-4f04-8ba3-da3feea3dd53"}},{"@id":"http://data.europa.eu/88u/record/52deadb7-819f-4f84-af19-149474eb4706","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/8ef9cb6e-0570-4f04-8ba3-da3feea3dd53"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"52deadb7-819f-4f84-af19-149474eb4706","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:18Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/52deadb7-819f-4f84-af19-149474eb4706"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:300eeb5b57598b97450df2a16d77e1f114cbe3f16fb76291e60ee1acdad105aa_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/52deadb7-819f-4f84-af19-149474eb4706"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-13T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Exploateringsn%C3%A4mnd/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Exploateringsnämnd"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mats.dunkars@stockholm.se"}}],"@id":"urn:source:300eeb5b57598b97450df2a16d77e1f114cbe3f16fb76291e60ee1acdad105aa"},{"@graph":[{"@id":"_:303ea61cdf475cf1d4126a46dc7222a406398ddd694e2ed2d8ab3dd14241829c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:303ea61cdf475cf1d4126a46dc7222a406398ddd694e2ed2d8ab3dd14241829c_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"10f27a798a0034fe024284451259fa7bbc"},{"@id":"http://data.europa.eu/88u/dataset/dd2dc73c-d5ef-47be-8b4a-e74e657f1815","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/ef409742-7ff5-4745-afe1-f3fbb60eb215"},"dcat:keyword":[{"@language":"sv","@value":"Administrativa gränser"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fastigheter och fysisk planering"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=8ca185f7-cd86-416f-8d59-958998009a11"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"SBKWebservice е уеб услуга (SOAP), която предоставя данни от информационния регистър за недвижими имоти (FIR). Услугата предоставя информация за имоти, сгради, планове, адреси и др."},{"@language":"cs-t-sv-t0-mtec","@value":"SBKWebservice je webová služba (SOAP), která poskytuje údaje z registru informací o nemovitostech (FIR). Služba poskytuje informace o nemovitostech, budovách, plánech, adresách atd. Pro další informace, jako je přístup k popisným dokumentům o SBKWebservice, kontaktujte níže uvedený kontakt na zdroje."},{"@language":"da-t-sv-t0-mtec","@value":"SBKWebservice er en webtjeneste (SOAP), der leverer data fra ejendomsregistret (FIR).Tjenesten giver oplysninger om ejendomme, bygninger, planer, adresser mv Kontakt ressourcekontakten nedenfor for yderligere oplysninger, såsom adgang til beskrivende dokumenter om SBKWebservice."},{"@language":"de-t-sv-t0-mtec","@value":"SBKWebservice ist ein Webservice (SOAP), der Daten aus dem Immobilieninformationsregister (FIR) bereitstellt.Der Service bietet Informationen über Immobilien, Gebäude, Pläne, Adressen, etc. Kontaktieren Sie den unten aufgeführten Ressourcenkontakt für weitere Informationen, wie zum Beispiel den Zugang zu beschreibenden Dokumenten über SBKWebservice."},{"@language":"el-t-sv-t0-mtec","@value":"Η SBKWebservice είναι μια διαδικτυακή υπηρεσία (SOAP) που παρέχει δεδομένα από το μητρώο πληροφοριών ακινήτων (FIR). Η υπηρεσία παρέχει πληροφορίες σχετικά με ακίνητα, κτίρια, σχέδια, διευθύνσεις κ.λπ. Επικοινωνήστε με την επαφή πόρων που αναφέρεται παρακάτω για περαιτέρω πληροφορίες, όπως πρόσβαση σε περιγραφικά έγγραφα σχετικά με την SBKWebservice."},{"@language":"en-t-sv-t0-mtec","@value":"SBKWebservice is a web service (SOAP) that provides data from the real estate information register (FIR).The service provides information about properties, buildings, plans, addresses, etc. Contact the resource contact listed below for further information, such as access to descriptive documents about SBKWebservice."},{"@language":"es-t-sv-t0-mtec","@value":"SBKWebservice es un servicio web (SOAP) que proporciona datos del registro de información inmobiliaria (FIR). El servicio proporciona información sobre propiedades, edificios, planos, direcciones, etc. Póngase en contacto con el contacto de recursos que figura a continuación para obtener más información, como el acceso a documentos descriptivos sobre SBKWebservice."},{"@language":"et-t-sv-t0-mtec","@value":"SBKWebservice on veebiteenus (SOAP), mis pakub andmeid kinnisvarateabe registrist (FIR). Teenus pakub teavet kinnisvara, hoonete, plaanide, aadresside jms kohta. Lisateabe saamiseks võtke ühendust allpool loetletud ressursikontaktiga, näiteks juurdepääs SBKWebservice'i kirjeldavatele dokumentidele."},{"@language":"fi-t-sv-t0-mtec","@value":"SBKWebservice on verkkopalvelu (SOAP), joka tarjoaa tietoja kiinteistötietorekisteristä (FIR). Palvelu tarjoaa tietoa kiinteistöistä, rakennuksista, suunnitelmista, osoitteista jne."},{"@language":"fr-t-sv-t0-mtec","@value":"SBKWebservice est un service Web (SOAP) qui fournit des données à partir du registre d'informations immobilières (FIR). Le service fournit des informations sur les propriétés, les bâtiments, les plans, les adresses, etc. Contactez le contact de ressource ci-dessous pour plus d'informations, telles que l'accès aux documents descriptifs sur SBKWebservice."},{"@language":"ga-t-sv-t0-mtec","@value":"Is seirbhís gréasáin (SOAP) é SBKWebservice a sholáthraíonn sonraí ón gclár faisnéise eastáit réadaigh (FIR).Soláthraíonn an tseirbhís faisnéis faoi airíonna, foirgnimh, pleananna, seoltaí, etc. Déan teagmháil leis an teagmhálaí acmhainní atá liostaithe thíos chun tuilleadh faisnéise a fháil, mar shampla rochtain ar dhoiciméid thuairisciúla faoi SBKWebservice."},{"@language":"hr-t-sv-t0-mtec","@value":"SBKWebservice je web servis (SOAP) koji pruža podatke iz registra informacija o nekretninama (FIR).Usluga pruža informacije o nekretninama, zgradama, planovima, adresama itd."},{"@language":"hu-t-sv-t0-mtec","@value":"Az SBKWebservice egy webes szolgáltatás (SOAP), amely adatokat szolgáltat az ingatlaninformációs nyilvántartásból (FIR). A szolgáltatás információkat nyújt az ingatlanokról, épületekről, tervekről, címekről stb."},{"@language":"it-t-sv-t0-mtec","@value":"SBKWebservice è un servizio web (SOAP) che fornisce dati dal registro delle informazioni immobiliari (FIR).Il servizio fornisce informazioni su proprietà, edifici, piani, indirizzi, ecc."},{"@language":"lt-t-sv-t0-mtec","@value":"SBKWebservice yra interneto paslauga (SOAP), kuri teikia duomenis iš nekilnojamojo turto informacijos registro (FIR).Paslauga teikia informaciją apie turtą, pastatus, planus, adresus ir kt."},{"@language":"lv-t-sv-t0-mtec","@value":"SBKWebservice ir tīmekļa pakalpojums (SOAP), kas sniedz datus no nekustamā īpašuma informācijas reģistra (FIR).Pakalpojums sniedz informāciju par īpašumiem, ēkām, plāniem, adresēm utt."},{"@language":"mt-t-sv-t0-mtec","@value":"SBKWebservice huwa servizz web (SOAP) li jipprovdi data mir-reġistru ta’ informazzjoni dwar il-proprjetà immobbli (FIR). Is-servizz jipprovdi informazzjoni dwar proprjetajiet, bini, pjanijiet, indirizzi, eċċ. Ikkuntattja l-kuntatt tar-riżorsi elenkat hawn taħt għal aktar informazzjoni, bħall-aċċess għal dokumenti deskrittivi dwar SBKWebservice."},{"@language":"nl-t-sv-t0-mtec","@value":"SBKWebservice is een webservice (SOAP) die gegevens verstrekt uit het vastgoedinformatieregister (FIR). De service biedt informatie over eigendommen, gebouwen, plannen, adressen, enz. Neem contact op met de hieronder vermelde contactpersoon voor meer informatie, zoals toegang tot beschrijvende documenten over SBKWebservice."},{"@language":"pl-t-sv-t0-mtec","@value":"SBKWebservice to usługa sieciowa (SOAP), która dostarcza danych z rejestru informacji o nieruchomościach (FIR). Usługa dostarcza informacji o nieruchomościach, budynkach, planach, adresach itp."},{"@language":"pt-t-sv-t0-mtec","@value":"O SBKWebservice é um serviço Web (SOAP) que fornece dados do registo de informações imobiliárias (FIR). O serviço fornece informações sobre imóveis, edifícios, planos, endereços, etc. Contacte o contacto de recursos listado abaixo para obter mais informações, como acesso a documentos descritivos sobre o SBKWebservice."},{"@language":"ro-t-sv-t0-mtec","@value":"SBKWebservice este un serviciu web (SOAP) care furnizează date din registrul de informații imobiliare (FIR). Serviciul oferă informații despre proprietăți, clădiri, planuri, adrese etc. Contactați contactul de resurse listat mai jos pentru informații suplimentare, cum ar fi accesul la documente descriptive despre SBKWebservice."},{"@language":"sk-t-sv-t0-mtec","@value":"SBKWebservice je webová služba (SOAP), ktorá poskytuje údaje z registra informácií o nehnuteľnostiach (FIR). Služba poskytuje informácie o nehnuteľnostiach, budovách, plánoch, adresách atď."},{"@language":"sl-t-sv-t0-mtec","@value":"SBKWebservice je spletna storitev (SOAP), ki zagotavlja podatke iz registra informacij o nepremičninah (FIR).Storitev zagotavlja informacije o nepremičninah, stavbah, načrtih, naslovih itd."},{"@language":"sv","@value":"SBKWebservice är en webbtjänst (SOAP) som tillhandahåller data från fastighetsinformationsregistret (FIR).Tjänsten tillhandahåller information om fastigheter, byggnader, planer, adresser m.m.Kontakta nedan angivna resurskontakt för att få ytterligare information, tex tillgång till beskrivande dokument om SBKWebservice."},{"@language":"uk-t-sv-t0-mtec","@value":"SBKWebservice - це веб-сервіс (SOAP), який надає дані з реєстру інформації про нерухомість (FIR). Сервіс надає інформацію про об'єкти нерухомості, будівлі, плани, адреси тощо."}],"dct:format":"text/html","dct:identifier":"dd2dc73c-d5ef-47be-8b4a-e74e657f1815","dct:issued":{"@type":"xsd:date","@value":"2017-12-11"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-12-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:303ea61cdf475cf1d4126a46dc7222a406398ddd694e2ed2d8ab3dd14241829c_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Webservice - Уеб услуга за информационния регистър за недвижими имоти (FIR)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Webservice - Webová služba pro registr informací o nemovitostech (FIR)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Webservice - Webservice til ejendomsregistret (FIR)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Webservice - Webservice für das Immobilieninformationsregister (FIR)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Webservice - Διαδικτυακή υπηρεσία για το μητρώο πληροφοριών ακινήτων (FIR)"},{"@language":"