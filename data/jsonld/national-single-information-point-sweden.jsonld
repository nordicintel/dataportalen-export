inalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/8e6fdfb3-a774-4414-bf66-0915fd813dc1"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Stadsledningskontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:anders.broberg@stockholm.se"},{"@id":"mailto:kommunstyrelsen@stockholm.se"}]}],"@id":"urn:source:28192c24bc41dfedc82f11143e3fcf09cef3e9106f59bbf802d8617d4c5ddecc"},{"@graph":[{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/36"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b3n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/resourceProvider"},"http://www.w3.org/ns/prov#agent":{"@id":"https://metadata.bolagsverket.se/store/2/resource/37"}},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b4n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#reuserGuidelines":{"@id":"https://bolagsverket.se/download/18.256daf8e18f42a9d4d069/1783063508704/regelverk-ssbtgo.pdf"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sammansatta bastjänsten för grunddata om organisationer (SSBTGO)","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ssbt@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b1n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/29","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/28"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/44"},"dcat:keyword":[{"@language":"en","@value":"Basic Data"},{"@language":"en","@value":"Company data"},{"@language":"en","@value":"Organisation data"},{"@language":"en","@value":"Organisation information"},{"@language":"sv","@value":"Företagsdata"},{"@language":"sv","@value":"Företagsinformation"},{"@language":"sv","@value":"Grunddata"},{"@language":"sv","@value":"Grundläggande uppgifter"},{"@language":"sv","@value":"Organisationsdata"},{"@language":"sv","@value":"Organisationsinformation"},{"@language":"sv","@value":"SSBTGO"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":{"@language":"sv","@value":"Grunddata om organisationer. Informationen kan hämtas av offentliga aktörer på två sätt. Indirekt återanvändning där informationen lämnas ut till företagaren som sedan lämnar vidare till en offentlig aktör. Tjänsten är även källa för information på Mina sidor på Verksamt.se (genom s.k. indirekt återanvändning). Tjänsten tillhandahåller också direkt återanvändning där en offentlig aktör ber om att få informationen direkt till ett verksamhetssystem utan att företagaren är inblandad. Användningen regleras genom avtal. Informationen hämtas från Bolagsverket, Skatteverket och SCB i realtid."},"dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Grunddata om organisationer"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},"http://www.w3.org/ns/prov#qualifiedAttribution":[{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b2n0"},{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b3n0"}]},{"@id":"https://metadata.bolagsverket.se/store/2/resource/36","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":{"@language":"sv","@value":"Statistikmyndigheten SCB"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/37","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:name":{"@language":"sv","@value":"Skatteverket"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/44","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/48"},"dcat:accessURL":{"@id":"https://www.bolagsverket.se/om/oss/utveckling-av-digitala-tjanster/sammansatt-bastjanst"},"dct:description":[{"@language":"en","@value":"Basic Data about organisations in JSON-format which can be fetched by a public actor via an API. The information is fetched in real time from the Swedish Companies Registration Office, the Swedish Tax Agency and Statistics Sweden, depending on the data element and type of legal entity."},{"@language":"sv","@value":"Grunddata om organisationer i JSON-format som kan hämtas av en offentlig aktör via ett API. Informationen hämtas i realtid och beroende på uppgift och juridisk form från Bolagsverket, Skatteverket eller Statistikmyndigheten SCB."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-05-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-16"},"dct:rights":{"@id":"_:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3_b4n0"},"dct:title":[{"@language":"en","@value":"Basic data about organisations in JSON-format"},{"@language":"sv","@value":"Grunddata om organisationer i JSON-format"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/48","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/28"},"dcat:endpointDescription":{"@id":"https://bolagsverket.se/omoss/utvecklingavdigitalatjanster/densammansattabastjanstenforgrundlaggandeuppgifteromforetag.2227.html"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/ssbtgo/v1"},"dcat:keyword":[{"@language":"en","@value":"Company Information"},{"@language":"en","@value":"Company data"},{"@language":"en","@value":"Core Data"},{"@language":"en","@value":"Organisation Information"},{"@language":"en","@value":"Organisation data"},{"@language":"en","@value":"SSBTGO"},{"@language":"sv","@value":"Företagsinformation"},{"@language":"sv","@value":"Grunddata"},{"@language":"sv","@value":"Grundläggande uppgifter"},{"@language":"sv","@value":"Organisationsdata"},{"@language":"sv","@value":"Organisationsinformation"},{"@language":"sv","@value":"SSBTGO"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/om/oss/utveckling-av-digitala-tjanster/sammansatt-bastjanst"},"dcat:servesDataset":{"@id":"https://metadata.bolagsverket.se/store/2/resource/29"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:title":[{"@language":"en","@value":"Core data about organisations - SSBTGO"},{"@language":"sv","@value":"API för att hämta grunddata om organisationer – SSBTGO"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:28cedd9d68915e1990a68be6af23cbe2b7bc49e6f8c6f699776fb6dc0a054fd3"},{"@graph":[{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"2034bf308d1e6f18636ba0ea083dbcb62f"},{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b1n0","dct:identifier":"https://metadata.boverket.se/store/1/resource/27","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/19ab6396-5e66-441b-9211-24c2bfa1e8ba"}},{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b2n0","dct:identifier":"https://metadata.boverket.se/store/1/resource/45","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f1ef62f5-7ea6-447b-a14e-ba71746eabc4"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-44~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/25"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/f1ef62f5-7ea6-447b-a14e-ba71746eabc4"},"dcat:isVersionOf":{"@id":"https://metadata.boverket.se/store/1/resource/26"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://sokenergideklaration.boverket.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Тази електронна услуга ви позволява да търсите енергийно декларирани сгради. Основната информация от енергийната декларация е достъпна директно в електронната услуга. Можете също така да поръчате енергийната декларация в нейната цялост в електронната услуга.\nАко сте собственик на сграда или имате пълномощно (представител), винаги можете да потърсите и изтеглите енергийната декларация в нейната цялост за сградите, за които притежавате или имате пълномощно (представител)."},{"@language":"cs-t-sv-t0-mtec","@value":"Tato elektronická služba vám umožňuje vyhledávat energeticky deklarované budovy. Základní informace z energetického prohlášení jsou dostupné přímo v e-službě. V e-službě si můžete také objednat energetické prohlášení v plném rozsahu.\nPokud jste vlastníkem budovy nebo máte plnou moc (zástupce), můžete vždy vyhledat a stáhnout energetické prohlášení v plném rozsahu pro budovy, pro které vlastníte nebo máte plnou moc (zástupce)."},{"@language":"da-t-sv-t0-mtec","@value":"Denne e-tjeneste giver dig mulighed for at søge efter energianmeldte bygninger. De grundlæggende oplysninger fra energierklæringen kan tilgås direkte i e-tjenesten. Du kan også bestille energideklarationen i sin helhed i e-tjenesten.\nHvis du er bygningsejer eller har en fuldmagt (repræsentant), kan du altid søge efter og downloade energierklæringen i sin helhed for de bygninger, som du ejer eller har en fuldmagt (repræsentant)."},{"@language":"de-t-sv-t0-mtec","@value":"Mit diesem E-Service können Sie nach energiedeklarierten Gebäuden suchen. Die Basisinformationen aus der Energiedeklaration sind direkt im E-Service abrufbar. Sie können die Energiedeklaration auch vollständig im E-Service bestellen.\nWenn Sie Gebäudeeigentümer sind oder über eine Vollmacht (Vertreter) verfügen, können Sie die Energieerklärung für die Gebäude, für die Sie eine Vollmacht (Vertreter) besitzen oder besitzen, jederzeit vollständig suchen und herunterladen."},{"@language":"el-t-sv-t0-mtec","@value":"Αυτή η ηλεκτρονική υπηρεσία σας επιτρέπει να αναζητήσετε ενεργειακά δηλωμένα κτίρια. Οι βασικές πληροφορίες από την ενεργειακή δήλωση είναι προσβάσιμες απευθείας στην ηλεκτρονική υπηρεσία. Μπορείτε επίσης να παραγγείλετε την ενεργειακή δήλωση στο σύνολό της στην ηλεκτρονική υπηρεσία.\nΕάν είστε ιδιοκτήτης κτιρίου ή έχετε πληρεξούσιο (εκπρόσωπος), μπορείτε πάντα να αναζητήσετε και να τηλεφορτώσετε την ενεργειακή δήλωση στο σύνολό της για τα κτίρια για τα οποία είστε ιδιοκτήτης ή έχετε πληρεξούσιο (εκπρόσωπος)."},{"@language":"en-t-sv-t0-mtec","@value":"This e-service allows you to search for energy-declared buildings. The basic information from the energy declaration can be accessed directly in the e-service. You can also order the energy declaration in its entirety in the e-service.\nIf you are a building owner or have a power of attorney (representative), you can always search for and download the energy declaration in its entirety for the buildings for which you own or have a power of attorney (representative)."},{"@language":"es-t-sv-t0-mtec","@value":"Este servicio electrónico le permite buscar edificios declarados energéticamente. La información básica de la declaración energética se puede acceder directamente en el servicio electrónico. También puede solicitar la declaración energética en su totalidad en el servicio electrónico.\nSi usted es propietario de un edificio o tiene un poder notarial (representante), siempre puede buscar y descargar la declaración energética en su totalidad para los edificios de los que es propietario o tiene un poder notarial (representante)."},{"@language":"et-t-sv-t0-mtec","@value":"See e-teenus võimaldab otsida energiadeklaratsiooniga hooneid. Energiadeklaratsiooni põhiteave on kättesaadav otse e-teeninduses. Energiadeklaratsiooni saab tervikuna tellida ka e-teenindusest.\nKui olete hoone omanik või teil on volikiri (esindaja), saate alati otsida ja alla laadida kogu energiadeklaratsiooni hoonete kohta, mille jaoks teil on või on volikiri (esindaja)."},{"@language":"fi-t-sv-t0-mtec","@value":"Sähköisen asiointipalvelun avulla voit hakea energiailmoitettuja rakennuksia. Energiailmoituksen perustiedot ovat suoraan saatavilla sähköisessä asiointipalvelussa. Sähköisessä asiointipalvelussa voit myös tilata energiailmoituksen kokonaisuudessaan.\nJos olet rakennuksen omistaja tai sinulla on valtakirja (edustaja), voit aina hakea ja ladata energiailmoituksen kokonaisuudessaan rakennuksista, joiden omistat tai joilla on valtakirja (edustaja)."},{"@language":"fr-t-sv-t0-mtec","@value":"Ce service en ligne vous permet de rechercher des bâtiments déclarés énergétiques. Les informations de base de la déclaration énergétique sont accessibles directement dans le service en ligne. Vous pouvez également commander la déclaration énergétique dans son intégralité dans le service en ligne.\nSi vous êtes propriétaire d'un bâtiment ou avez une procuration (représentant), vous pouvez toujours rechercher et télécharger la déclaration énergétique dans son intégralité pour les bâtiments pour lesquels vous êtes propriétaire ou avez une procuration (représentant)."},{"@language":"ga-t-sv-t0-mtec","@value":"Ligeann an ríomhsheirbhís seo duit foirgnimh atá dearbhaithe ó thaobh fuinnimh de a chuardach. Is féidir rochtain dhíreach a fháil ar an bhfaisnéis bhunúsach ón dearbhú fuinnimh sa ríomhsheirbhís. Is féidir leat an dearbhú fuinnimh ina iomláine a ordú sa ríomhsheirbhís freisin.\nMás úinéir foirgnimh thú nó má tá cumhacht aturnae (ionadaí) agat, is féidir leat an dearbhú fuinnimh a chuardach agus a íoslódáil ina iomláine i gcás na bhfoirgneamh ar leat iad nó a bhfuil cumhacht aturnae (ionadaí) agat ina leith."},{"@language":"hr-t-sv-t0-mtec","@value":"Ova e-usluga omogućuje vam pretraživanje energetski prijavljenih zgrada. Osnovnim informacijama iz energetske deklaracije može se pristupiti izravno u e-usluzi. Energetsku deklaraciju u cijelosti možete naručiti i u e-usluzi.\nAko ste vlasnik zgrade ili imate punomoć (predstavnik), uvijek možete tražiti i preuzeti energetsku deklaraciju u cijelosti za zgrade za koje posjedujete ili imate punomoć (predstavnik)."},{"@language":"hu-t-sv-t0-mtec","@value":"Ez az e-szolgáltatás lehetővé teszi az energiaigényes épületek keresését. Az energianyilatkozatban szereplő alapvető információk közvetlenül az e-szolgáltatásban érhetők el. Az energianyilatkozatot teljes egészében megrendelheti az e-szolgáltatásban is.\nHa Ön épülettulajdonos vagy meghatalmazással (képviselő) rendelkezik, mindig megkeresheti és letöltheti a teljes energianyilatkozatot azon épületekre vonatkozóan, amelyek tulajdonosa vagy meghatalmazásával (képviselő) rendelkezik."},{"@language":"it-t-sv-t0-mtec","@value":"Questo servizio elettronico ti consente di cercare edifici dichiarati energetici. Le informazioni di base della dichiarazione energetica sono accessibili direttamente nell'e-service. È inoltre possibile ordinare la dichiarazione energetica nella sua interezza nell'e-service.\nSe sei proprietario di un edificio o hai una procura (rappresentante), puoi sempre cercare e scaricare la dichiarazione energetica nella sua interezza per gli edifici di cui possiedi o hai una procura (rappresentante)."},{"@language":"lt-t-sv-t0-mtec","@value":"Ši e. paslauga suteikia galimybę ieškoti energetiškai deklaruotų pastatų. Pagrindinę informaciją iš energijos deklaracijos galima rasti tiesiogiai e. paslaugoje. Elektroninėje paslaugoje taip pat galite užsisakyti visą energijos deklaraciją.\nJei esate pastato savininkas arba turite įgaliojimą (atstovą), visada galite ieškoti ir atsisiųsti visą pastatų, kuriems turite arba turite įgaliojimą (atstovą), energijos deklaraciją."},{"@language":"lv-t-sv-t0-mtec","@value":"Šis e-pakalpojums ļauj meklēt ēkas ar deklarētu energopatēriņu. Pamatinformācijai no enerģijas deklarācijas var piekļūt tieši e-pakalpojumā. E-pakalpojumā varat pasūtīt arī visu enerģijas deklarāciju.\nJa esat ēkas īpašnieks vai jums ir pilnvara (pārstāvis), jūs vienmēr varat meklēt un lejupielādēt visu enerģijas deklarāciju par ēkām, par kurām jums pieder vai ir pilnvara (pārstāvis)."},{"@language":"mt-t-sv-t0-mtec","@value":"Dan is-servizz elettroniku jippermettilek tfittex bini ddikjarat fl-enerġija. L-informazzjoni bażika mid-dikjarazzjoni tal-enerġija tista’ tiġi aċċessata direttament fis-servizz elettroniku. Tista’ tordna wkoll id-dikjarazzjoni tal-enerġija fl-intier tagħha fis-servizz elettroniku.\nJekk inti sid ta’ bini jew għandek prokura (rappreżentant), dejjem tista’ tfittex u tniżżel id-dikjarazzjoni tal-enerġija fl-intier tagħha għall-bini li għalih inti sid jew għandek prokura (rappreżentant)."},{"@language":"nl-t-sv-t0-mtec","@value":"Met deze e-service kunt u zoeken naar energiegedeclareerde gebouwen. De basisinformatie uit de energieverklaring is rechtstreeks toegankelijk in de e-dienst. U kunt de energieverklaring ook in zijn geheel bestellen in de e-service.\nAls u eigenaar van een gebouw bent of een volmacht hebt (vertegenwoordiger), kunt u altijd de energieverklaring in zijn geheel zoeken en downloaden voor de gebouwen waarvan u eigenaar bent of een volmacht hebt (vertegenwoordiger)."},{"@language":"pl-t-sv-t0-mtec","@value":"Ta e-usługa umożliwia wyszukiwanie budynków deklarowanych pod względem energetycznym. Podstawowe informacje z deklaracji energetycznej można uzyskać bezpośrednio w e-usługi. Możesz również zamówić deklarację energetyczną w całości w e-usługi.\nJeśli jesteś właścicielem budynku lub masz pełnomocnictwo (przedstawiciel), zawsze możesz wyszukać i pobrać deklarację energetyczną w całości dla budynków, dla których jesteś właścicielem lub masz pełnomocnictwo (przedstawiciel)."},{"@language":"pt-t-sv-t0-mtec","@value":"Este serviço eletrónico permite-lhe procurar edifícios declarados energeticamente. As informações básicas da declaração energética podem ser consultadas diretamente no serviço eletrónico. Também pode encomendar a declaração energética na sua totalidade no serviço eletrónico.\nSe é proprietário de um edifício ou tem uma procuração (representante), pode sempre pesquisar e descarregar a declaração energética na sua totalidade para os edifícios de que é proprietário ou tem uma procuração (representante)."},{"@language":"ro-t-sv-t0-mtec","@value":"Acest serviciu electronic vă permite să căutați clădiri declarate energetic. Informațiile de bază din declarația privind energia pot fi accesate direct în serviciul electronic. De asemenea, puteți comanda declarația privind energia în întregime în cadrul serviciului electronic.\nDacă sunteți proprietar de clădire sau aveți o procură (reprezentant), puteți căuta și descărca întotdeauna declarația energetică în întregime pentru clădirile pentru care dețineți sau aveți o procură (reprezentant)."},{"@language":"sk-t-sv-t0-mtec","@value":"Táto elektronická služba vám umožňuje vyhľadávať energeticky deklarované budovy. Základné informácie z energetického vyhlásenia sú dostupné priamo v elektronickej službe. Energetické vyhlásenie v celom rozsahu si môžete objednať aj v rámci e-služby.\nAk ste vlastníkom budovy alebo máte splnomocnenie (zástupca), môžete vždy vyhľadať a stiahnuť energetické vyhlásenie v celom rozsahu pre budovy, pre ktoré vlastníte alebo máte splnomocnenie (zástupca)."},{"@language":"sl-t-sv-t0-mtec","@value":"Ta e-storitev vam omogoča iskanje energijsko prijavljenih stavb. Do osnovnih informacij iz energijske deklaracije je mogoče dostopati neposredno v e-storitvi. Energijsko deklaracijo v celoti lahko naročite tudi v e-storitvi.\nČe ste lastnik stavbe ali imate pooblastilo (predstavnik), lahko vedno poiščete in prenesete energetsko deklaracijo v celoti za stavbe, za katere imate v lasti ali imate pooblastilo (predstavnik)."},{"@language":"sv","@value":"Denna e-tjänst ger dig möjlighet att söka efter energideklarerade byggnader. Basuppgifterna från energideklarationen kan du direkt ta del av i e-tjänsten. Du kan även beställa energideklarationen i sin helhet i e-tjänsten.\nÄr du byggnadsägare eller har en fullmakt (ombud) kan du alltid söka fram och ladda ned energideklarationen i sin helhet för de byggnader som du äger eller har en fullmakt (ombud) för."},{"@language":"uk-t-sv-t0-mtec","@value":"Ця електронна послуга дозволяє шукати енергодекларовані будівлі. Базову інформацію з енергетичної декларації можна отримати безпосередньо в електронному сервісі. Ви також можете замовити енергетичну декларацію в повному обсязі в електронному сервісі.\nЯкщо ви є власником будівлі або маєте довіреність (представника), ви завжди можете знайти та завантажити енергетичну декларацію в повному обсязі на будівлі, якими ви володієте або маєте довіреність (представника)."}],"dct:format":"application/pdf","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Електронна услуга за енергийни декларации"},{"@language":"cs-t-sv-t0-mtec","@value":"Elektronická služba pro energetická prohlášení"},{"@language":"da-t-sv-t0-mtec","@value":"E-tjeneste for energierklæringer"},{"@language":"de-t-sv-t0-mtec","@value":"E-Service für Energiedeklarationen"},{"@language":"el-t-sv-t0-mtec","@value":"Ηλεκτρονική Υπηρεσία Ενεργειακών Δηλώσεων"},{"@language":"en-t-sv-t0-mtec","@value":"E-service for Energy declarations"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio electrónico para declaraciones de energía"},{"@language":"et-t-sv-t0-mtec","@value":"Energiadeklaratsioonide e-teenus"},{"@language":"fi-t-sv-t0-mtec","@value":"Energiailmoitusten sähköinen asiointipalvelu"},{"@language":"fr-t-sv-t0-mtec","@value":"Service en ligne pour les déclarations énergétiques"},{"@language":"ga-t-sv-t0-mtec","@value":"Ríomhsheirbhís le haghaidh dearbhuithe fuinnimh"},{"@language":"hr-t-sv-t0-mtec","@value":"E-usluga za deklaracije o energiji"},{"@language":"hu-t-sv-t0-mtec","@value":"E-szolgáltatás az energianyilatkozatokhoz"},{"@language":"it-t-sv-t0-mtec","@value":"E-service per le dichiarazioni energetiche"},{"@language":"lt-t-sv-t0-mtec","@value":"Energijos deklaracijų teikimo e. paslauga"},{"@language":"lv-t-sv-t0-mtec","@value":"E-pakalpojums enerģijas deklarācijām"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz elettroniku għad-dikjarazzjonijiet tal-Enerġija"},{"@language":"nl-t-sv-t0-mtec","@value":"E-dienst voor energieverklaringen"},{"@language":"pl-t-sv-t0-mtec","@value":"E-usługa w zakresie deklaracji energetycznych"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço eletrónico para declarações energéticas"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul electronic pentru declarațiile privind energia"},{"@language":"sk-t-sv-t0-mtec","@value":"Elektronická služba pre energetické vyhlásenia"},{"@language":"sl-t-sv-t0-mtec","@value":"E-storitev za energetske deklaracije"},{"@language":"sv","@value":"E-tjänst för Energideklarationer"},{"@language":"uk-t-sv-t0-mtec","@value":"Електронний сервіс для енергетичних декларацій"}]},{"@id":"http://data.europa.eu/88u/distribution/19ab6396-5e66-441b-9211-24c2bfa1e8ba","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/#h-3"},"dct:description":{"@language":"sv","@value":"API för energideklarationer"},"dct:format":"application/json","dct:license":{"@id":"https://vismaaddo.net/Forms/#/view?token=5c319ece-0837-4366-8615-87aa3dad726d"},"dct:title":{"@language":"sv","@value":"API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"http://data.europa.eu/88u/distribution/f1ef62f5-7ea6-447b-a14e-ba71746eabc4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sokenergideklaration.boverket.se/search"},"dct:format":"application/pdf","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Електронна услуга за PDF"},{"@language":"cs-t-sv-t0-mtec","@value":"Elektronická služba pro PDF"},{"@language":"da-t-sv-t0-mtec","@value":"E-tjeneste til PDF"},{"@language":"de-t-sv-t0-mtec","@value":"E-Service für PDF"},{"@language":"el-t-sv-t0-mtec","@value":"Ηλεκτρονική υπηρεσία για PDF"},{"@language":"en-t-sv-t0-mtec","@value":"E-service for PDF"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio electrónico para PDF"},{"@language":"et-t-sv-t0-mtec","@value":"PDF-failide e-teenus"},{"@language":"fi-t-sv-t0-mtec","@value":"Sähköinen asiointipalvelu PDF-tiedostoille"},{"@language":"fr-t-sv-t0-mtec","@value":"Service en ligne pour PDF"},{"@language":"ga-t-sv-t0-mtec","@value":"Ríomhsheirbhís le haghaidh PDF"},{"@language":"hr-t-sv-t0-mtec","@value":"E-usluga za PDF"},{"@language":"hu-t-sv-t0-mtec","@value":"E-szolgáltatás PDF-hez"},{"@language":"it-t-sv-t0-mtec","@value":"E-service per PDF"},{"@language":"lt-t-sv-t0-mtec","@value":"E-paslauga PDF formatu"},{"@language":"lv-t-sv-t0-mtec","@value":"E-pakalpojums PDF formātā"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz elettroniku għal PDF"},{"@language":"nl-t-sv-t0-mtec","@value":"E-service voor PDF"},{"@language":"pl-t-sv-t0-mtec","@value":"E-usługa dla PDF"},{"@language":"pt-t-sv-t0-mtec","@value":"E-service para PDF"},{"@language":"ro-t-sv-t0-mtec","@value":"E-service pentru PDF"},{"@language":"sk-t-sv-t0-mtec","@value":"Elektronická služba pre PDF"},{"@language":"sl-t-sv-t0-mtec","@value":"E-storitev za PDF"},{"@language":"sv","@value":"E-tjänst för PDF"},{"@language":"uk-t-sv-t0-mtec","@value":"Електронний сервіс для PDF"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-boverket-se-store-1-resource-44~~1","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b1n0"},{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b2n0"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.boverket.se/store/1/resource/44","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:38Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-44~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-boverket-se-store-1-resource-44~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Energideklarationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://metadata.boverket.se/store/1/resource/26","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/48"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/19ab6396-5e66-441b-9211-24c2bfa1e8ba"},"dcat:hasVersion":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-44~~1"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Syftet med detta API är att ge avtalsbundna företag möjlighet att göra löpande uppslag i energideklarationssystemet för att få \ntillgång till basuppgifterna. Bland basuppgifterna finns bland annat energiklass och energiprestanda."},"dct:format":"application/json","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"API för Energideklarationer"},"foaf:page":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"}},{"@id":"https://metadata.boverket.se/store/1/resource/48","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Boverkets publika API","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Dokumentation av API för Energideklaration"}}],"@id":"urn:source:28dc8cde5bc2bc8344b63240146fab93cb0a6be073c56cc300629616853d2d3a"},{"@graph":[{"@id":"_:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0cfd1cea-c419-4652-989d-a88a545c5de9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2005-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: ? m, upplösning: 20 cm/pixel i ortofoto. Orektifierade bilderna försvunna. Detta ortofoto finns bara tillgängligt som rasterpyramid i dpMap. Innehåller geometriska fel och ska ej mätas i. Fotograferingsdatum: april-maj 2005."},"dct:identifier":"6869eaa1-e69c-412e-987e-0a147725047c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2005)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6"},{"@graph":[{"@id":"_:2b16c83e32ebbeb519d959a81277e394d4da4d8c5c71702cb5f97ebd4045a625_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent",