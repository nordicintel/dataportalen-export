id":"http://data.europa.eu/88u/distribution/70db833f-da79-4ae6-84b1-f64856bc63e6"}},{"@id":"http://data.europa.eu/88u/record/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/3bbdcff1-7d23-4cd3-bd3b-3e40a7ba909c"},{"@id":"http://data.europa.eu/88u/distribution/62cd8fe0-6aa5-4df2-8d70-c3901710f247"},{"@id":"http://data.europa.eu/88u/distribution/70db833f-da79-4ae6-84b1-f64856bc63e6"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:07Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:46:10Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:530b23ac9048db5df46b4669207573fc3625d7599fe00ad6fe15e40fbfb2f0c9_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:46:10Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:530b23ac9048db5df46b4669207573fc3625d7599fe00ad6fe15e40fbfb2f0c9"},{"@graph":[{"@id":"_:560402d8b7a37e0921935f5f5912f774902b8b342c5eae3130571206b2f9e9f7_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:560402d8b7a37e0921935f5f5912f774902b8b342c5eae3130571206b2f9e9f7_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"14e986f1200148169a4e7b8107abe1b445"},{"@id":"http://data.europa.eu/88u/dataset/e499670c-6f53-4901-852f-0a902a179d54","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/19e0706f-08bd-44aa-a089-fff22aedb7a5"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=a2c7e8ce-3361-4659-8231-eba777623935"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта на града - Височините се състоят от следните подтипове (подтипове) при информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Карта на града): Висока крива RH0010, 0,5 m, модифицирана, активна20, дори, модифицирана, активна30, странна, модифицирана, модифицирана, активна40, 5 m, модифицирана, активна50, 10 m, модифицирана, активна60, опасна, модифицирана, активнаВисока крива uuuh 2012 (uuuuh = без прикриване за сгради и т.н.)10, 0,5 m, модифицирана, активна20, дори, модифицирана, активна30, странна, модифицирана, активна40, 5 m, модифицирана, активна50, 10 m, модифицирана, активна. Добавени са нови криви на височината: Изчерпателни криви на височината, 10 m — Картографски криви на височината в 2D (без атрибути) с еднакво разстояние от 10 m. Дори — Картографски криви на височината в 2D (без атрибути) с еднакво разстояние от 2 m."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa města - Výšky sestávaly z následujících podtypů (podtypů) v informační klasifikaci 2020 (aktuální seznam viz Obecná specifikace produktu Mapa města):Vysoká křivka RH0010, 0.5 m, modifikovatelná, active20, Sudá, modifikovatelná, active30, Lichá, modifikovatelná, active40, 5 m, modifikovatelná, active50, 10 m, modifikovatelná, active60, Nebezpečná, modifikovatelná, activeVysoká křivka uuh 2012 (uuuh = bez zakrytí pro budovy, atd.)10, 0.5 m, modifikovatelná, active20, Sudá, modifikovatelná, active30, Odd, modifikovatelná, active40, 5 m, modifikovatelná, active50, 10 m, modifikovatelná, aktivní. Přidány nové výškové křivky: Křivky nadmořské výšky komplexní, 10 m - kartografické výškové křivky ve 2D (bez atributů) s rovnoměrnou vzdáleností 10 m. Dokonce - kartografické výškové křivky ve 2D (bez atributů) s rovnoměrnou vzdáleností 2 m."},{"@language":"da-t-sv-t0-mtec","@value":"Bykort — Højder bestod af følgende undertyper (undertyper) i klassificeringen af oplysninger for 2020 (for den nuværende liste henvises til den generelle varespecifikation Bykort):Høj kurve RH0010, 0,5 m, modificerbar, aktiv20, Selv, modificerbar, aktiv30, Ulige, modificerbar, aktiv40, 5 m, modificerbar, aktiv50, 10 m, modificerbar, aktiv60, Usikker, modificerbar, aktivHøj kurve uuh 2012 (uuuh = uden fortielse for bygninger osv.)10, 0,5 m, modificerbar, aktiv20, Selv, modificerbar, aktiv30, Ulige, modificerbar, aktiv40, 5 m, modificerbar, aktiv50, 10 m, modificerbar, aktiv. Nye højdekurver tilføjet: Højdekurver omfattende, 10 m - Kartografiske højdekurver i 2D (uden attributter) med en ækvidistant på 10 m. Selv - Kartografiske højdekurver i 2D (uden attributter) med en ækvidistant på 2 m."},{"@language":"de-t-sv-t0-mtec","@value":"Stadtplan - Höhen bestanden aus folgenden Subtypen (Subtypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Stadtplan):Hohe Kurve RH0010, 0,5 m, veränderbar, active20, Gerade, veränderbar, active30, Odd, veränderbar, active40, 5 m, veränderbar, active50, 10 m, veränderbar, active60, Unsicher, veränderbar, active30, veränderbar, active40, 5 m, veränderbar, active50, 10 m, veränderbar, active20, Gerade, veränderbar, active30, Odd, veränderbar, active40, 5 m, veränderbar, active50, 10 m, veränderbar, aktiv. Neue Höhenkurven hinzugefügt: Höhenkurven umfassend, 10 m - Kartographische Höhenkurven in 2D (ohne Attribute) mit äquidistant von 10 m. Gerade - Kartographische Höhenkurven in 2D (ohne Attribute) mit äquidistant von 2 m."},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης πόλης - Τα ύψη αποτελούνταν από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης πόλης):Υψηλή καμπύλη RH0010, 0,5 m, τροποποιήσιμη, ενεργό20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active60, Unsafe, modifiable, activeΥψηλή καμπύλη uuh 2012 (uuuh = χωρίς απόκρυψη για κτίρια κ.λπ.)10, 0.5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modable, active. Προστέθηκαν νέες καμπύλες ύψους: Καμπύλες ύψους πλήρεις, 10 m - Χαρτογραφικές καμπύλες ύψους σε 2D (χωρίς χαρακτηριστικά) με ίση απόσταση 10 m. Ομοιόμορφες - Χαρτογραφικές καμπύλες ύψους σε 2D (χωρίς χαρακτηριστικά) με ίση απόσταση 2 m."},{"@language":"en-t-sv-t0-mtec","@value":"City map - Heights consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification City map):High curve RH0010, 0.5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active60, Unsafe, modifiable, activeHigh curve uuh 2012 (uuuh = without concealment for buildings, etc.)10, 0.5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active. New height curves added: Altitude curves comprehensive, 10 m - Cartographic height curves in 2D (without attributes) with equidistant of 10 m. Even - Cartographic height curves in 2D (without attributes) with equidistant of 2 m."},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de la ciudad - Alturas consistió en los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual véase la especificación general del producto Mapa de la ciudad):Alta curva RH0010, 0.5 m, modificable, active20, Even, modificable, active30, Odd, modificable, active40, 5 m, modificable, active50, 10 m, modificable, active60, Inseguro, modificable, activeHigh curve uuh 2012 (uuuh = sin ocultación para edificios, etc.)10, 0.5 m, modificable, active20, Even, modificable, active30, Odd, modificable, active40, 5 m, modificable, active50, 10 m, modificable, active. Nuevas curvas de altura añadidas: Curvas de altitud completas, 10 m - Curvas de altura cartográficas en 2D (sin atributos) con equidistante de 10 m. Incluso - Curvas de altura cartográficas en 2D (sin atributos) con equidistante de 2 m."},{"@language":"et-t-sv-t0-mtec","@value":"Linnakaart - Kõrgused koosnesid järgmistest alatüüpidest (alatüübid) 2020. aasta teabeklassifikatsioonis (praeguse loetelu kohta vt üldine tootespetsifikaat Linnakaart):Kõrge kõver RH0010, 0,5 m, muudetav, aktiivne20, isegi, muudetav, aktiivne30, mitmekordne, muudetav, aktiivne40, 5 m, muudetav, aktiivne50, 10 m, muudetav, aktiivne60, ohtlik, muudetav, aktiivneKõrge kõver uuh 2012 (uuuuh = hoonete varjamiseta jne)10, 0,5 m, muudetav, aktiivne20, ühtlane, muudetav, aktiivne30, mitmekordne, muudetav, aktiivne40, 5 m, muudetav, aktiivne50, 10 m, muudetav, aktiivne. Lisatud on uued kõrguskõverad: Kõrguskõverad terviklikud, 10 m - kartograafilised kõrguskõverad 2D-s (ilma atribuutideta) võrdse kaugusega 10 m. Isegi - kartograafilised kõrguskõverad 2D-s (ilma atribuutideta) võrdse kaugusega 2 m."},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupungin kartta - Korkeudet koostuivat seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleiset tuote-eritelmät Kaupungin kartta):Korkea käyrä RH0010, 0,5 m, muokattavissa, aktiivinen20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active60, Unsafe, modifiable, activeHigh curve uuh 2012 (uuuuh = ilman salausta rakennuksille jne.)10, 0,5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active. Uudet korkeuskäyrät lisätty: Korkeuskäyrät kattavat, 10 m - Kartografiset korkeuskäyrät 2D:nä (ilman attribuutteja) tasavälein 10 m. Jopa - Kartografiset korkeuskäyrät 2D:nä (ilman attribuutteja) tasavälein 2 m."},{"@language":"fr-t-sv-t0-mtec","@value":"Carte de ville - Les hauteurs se composaient des sous-types suivants (sous-types) à la classification d’information 2020 (pour la liste actuelle, voir le cahier des charges général du produit Carte de ville): Haute courbe RH0010, 0,5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active60, Unsafe, modifiable, activeHaute courbe uuh 2012 (uuuh = sans dissimulation pour les bâtiments, etc.)10, 0,5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active. Nouvelles courbes de hauteur ajoutées: Courbes d'altitude complètes, 10 m - Courbes de hauteur cartographiques en 2D (sans attributs) avec équidistante de 10 m. Même - Courbes de hauteur cartographiques en 2D (sans attributs) avec équidistante de 2 m."},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil na cathrach - Bhí na fochineálacha (fochineálacha) seo a leanas i gceist le hairde ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach Sonraíocht táirge Ghinearálta Léarscáil na Cathrach): Ardchuar RH0010, 0.5 m, inmhodhnaithe, gníomhach20, Fiú, inmhodhnaithe, gníomhach30, Odd, inmhodhnaithe, gníomhach40, 5 m, inmhodhnaithe, gníomhach50, 10 m, inmhodhnaithe, gníomhach60, Neamhshábháilte, inmhodhnaithe, gníomhachArdchuar uuh 2012 (uuuh = gan ceilt le haghaidh foirgneamh, etc.)10, 0.5 m, inmhodhnaithe, gníomhach20, Fiú, inmhodhnaithe, gníomhach30, Odd, inmhodhnaithe, gníomhach40, 5 m, inmhodhnaithe, gníomhach50, 10 m, inmhodhnaithe, gníomhach. Cuireadh cuair airde nua leis: Cuar airde cuimsitheach, 10 m - Cuar airde cartagrafacha in 2D (gan tréithe) le comhfhad 10 m. Fiú - Cuar airde cartagrafacha in 2D (gan tréithe) le comhfhad 2 m."},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada - Visoke visine sastojale su se od sljedećih podtipova (podtipova) u informacijskoj klasifikaciji 2020 (za trenutni popis vidjeti Opće specifikacije proizvoda Karta grada):Visoka krivulja RH0010, 0,5 m, promjenjiva, aktivna20, čak, promjenjiva, aktivna30, Odd, promjenjiva, aktivna40, 5 m, promjenjiva, aktivna50, 10 m, promjenjiva, aktivna60, nesigurna, promjenjiva, aktivnaVisoka krivulja uuh 2012 (uuuuuh = bez prikrivanja za zgrade itd.)10, 0,5 m, promjenjiva, aktivna20, Even, promjenjiva, aktivna30, Odd, promjenjiva, aktivna40, 5 m, promjenjiva, aktivna50, 10 m, promjenjiva, aktivna. Dodane nove krivulje visine: Sveobuhvatne visinske krivulje, 10 m - Kartografske visinske krivulje u 2D (bez atributa) s jednakim razmakom od 10 m. Čak i - Kartografske visinske krivulje u 2D (bez atributa) s jednakim razmakom od 2 m."},{"@language":"hu-t-sv-t0-mtec","@value":"Várostérkép - A magasságok a következő altípusokból (altípusokból) álltak a 2020-as információs osztályozásnál (az aktuális listát lásd Általános termékleírás Várostérkép): Magas görbe RH0010, 0,5 m, módosítható, aktív20, Páros, módosítható, aktív30, Páratlan, módosítható, aktív40, 5 m, módosítható, aktív50, 10 m, módosítható, aktív60, Nem biztonságos, módosítható, aktívNagy görbe uuh 2012 (uuuh = épületek elrejtése nélkül, stb.)10, 0,5 m, módosítható, aktív20, Páros, módosítható, aktív30, Páratlan, módosítható, aktív40, 5 m, módosítható, aktív50, 10 m, módosítható, aktív. Új magassági görbék hozzáadva: Magassági görbék átfogó, 10 m – 2D-s térképészeti magassággörbék (attribútumok nélkül) 10 m-es egyenlő távolsággal. Még – 2D-s térképészeti magassággörbék (attribútumok nélkül) 2 m-es egyenlő távolsággal."},{"@language":"it-t-sv-t0-mtec","@value":"Mappa della città - Altezze consisteva dei seguenti sottotipi (sottotipi) alla classificazione delle informazioni 2020 (per l'elenco corrente vedere Specifiche generali del prodotto Mappa della città):Alta curva RH0010, 0,5 m, modificabile, attivo20, Even, modificabile, attivo30, Odd, modificabile, attivo40, 5 m, modificabile, attivo50, 10 m, modificabile, attivo60, Non sicuro, modificabile, attivoAlta curva uuh 2012 (uuuh = senza occultamento per edifici, ecc.)10, 0,5 m, modificabile, attivo20, Even, modificabile, attivo30, Odd, modificabile, attivo40, 5 m, modificabile, attivo50, 10 m, modificabile, attivo. Aggiunte nuove curve di altezza: Curve di altitudine complete, 10 m - Curve cartografiche di altezza in 2D (senza attributi) con equidistante di 10 m. Anche - Curve cartografiche di altezza in 2D (senza attributi) con equidistante di 2 m."},{"@language":"lt-t-sv-t0-mtec","@value":"Miesto žemėlapis - Aukštis 2020 m. informacijos klasifikacijoje sudarė šie potipiai (potipiai) (dabartinį sąrašą žr. Bendrojoje produkto specifikacijoje Miesto žemėlapis):High curve RH0010, 0.5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active60, Unsafe, modifiable, activeHigh curve uuh 2012 (uuuh = be slėpimo pastatams ir kt.)10, 0.5 m, modifiable, active20, Even, modifiable, active30, Odd, modifiable, active40, 5 m, modifiable, active50, 10 m, modifiable, active, active50, 10 m, modifiable, active. Pridėtos naujos aukščio kreivės: Altitudės kreivės išsamios, 10 m - Kartografinės aukščio kreivės 2D (be atributų) su vienodu 10 m atstumu. Lygiai - Kartografinės aukščio kreivės 2D (be atributų) su vienodu 2 m atstumu."},{"@language":"lv-t-sv-t0-mtec","@value":"Pilsētas karte - Augstumi sastāvēja no šādiem apakštipiem (apakštipiem) informācijas klasifikācijā 2020 (pašreizējam sarakstam skatīt vispārējo produkta specifikāciju Pilsētas karte):Augsta līkne RH0010, 0,5 m, modificējams, aktīvs20, Even, modificējams, aktīvs30, Odd, modificējams, aktīvs40, 5 m, modificējams, aktīvs50, 10 m, modificējams, aktīvs60, Nedrošs, modificējams, aktīvsAugsts līkne uuh 2012 (uuuuh = bez ēku slēpšanas utt.)10, 0,5 m, modificējams, aktīvs20, Even, modificējams, aktīvs30, Odd, modificējams, aktīvs40, 5 m, modificējams, aktīvs50, 10 m, modificējams, aktīvs. Pievienotas jaunas augstuma līknes: Augstuma līknes visaptverošas, 10 m - Kartogrāfiskās augstuma līknes 2D formātā (bez atribūtiem) ar vienādu attālumu 10 m. Pat Kartogrāfiskās augstuma līknes 2D formātā (bez atribūtiem) ar vienādu attālumu 2 m."},{"@language":"mt-t-sv-t0-mtec","@value":"- Heights tal-mappa tal-belt kienu jikkonsistu mis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-Ispeċifikazzjoni Ġenerali tal-Prodott Mappa tal-Belt): High curve RH0010, 0.5 m, modifikabbli, attivi20, Even, modifikabbli, attivi30, Odd, modifikabbli, attivi40, 5 m, modifikabbli, attivi50, 10 m, modifikabbli, attivi60, Mhux sikuri, modifikabbli, attiviHigh curve uuh 2012 (uuuh = mingħajr ħabi għall-bini, eċċ.)10, 0.5 m, modifikabbli, attivi20, Even, modifikabbli, attivi30, Odd, modifikabbligabbli, attivi40, 5 m, modifikabbli, attivi50, 10 m, modifikabbli, attivi. Żid kurvi ġodda tal-għoli: Kurvi tal-altitudni komprensivi, 10 m - Kurvi tal-għoli kartografika f'2D (mingħajr attributi) b'ekwidi 'l bogħod minn 10 m. Anki - Kurvi tal-għoli kartografika f'2D (mingħajr attributi) b'ekwidi 'l bogħod minn 2 m."},{"@language":"nl-t-sv-t0-mtec","@value":"Stadskaart - Hoogten bestond uit de volgende subtypen (subtypen) bij de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Stadskaart):Hoge curve RH0010, 0,5 m, aanpasbaar, actief20, Even, aanpasbaar, active30, Odd, aanpasbaar, active40, 5 m, aanpasbaar, actief50, 10 m, aanpasbaar, active60, Onveilig, aanpasbaar, actiefHoge curve uuh 2012 (uuuh = zonder verhulling voor gebouwen, enz.)10, 0,5 m, aanpasbaar, actief20, Even, aanpasbaar, active30, Odd, aanpasbaar, actief40, 5 m, aanpasbaar, active50, 10 m, aanpasbaar, actief. Nieuwe hoogtecurven toegevoegd: Hoogtecurven uitgebreid, 10 m - Cartografische hoogtecurven in 2D (zonder attributen) met een gelijke afstand van 10 m. Even - Cartografische hoogtecurven in 2D (zonder attributen) met een gelijke afstand van 2 m."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa miasta - Wzgórza składały się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualna lista patrz Ogólna specyfikacja produktu Mapa miasta):Wysoka krzywa RH0010, 0,5 m, modyfikowalna, aktywna20, parzysta, modyfikowalna, aktywna30, nieparzysta, modyfikowalna, aktywna40, 5 m, modyfikowalna, aktywna50, 10 m, modyfikowalna, aktywna60, Niebezpieczna, modyfikowalna, aktywnaWysoka krzywa uuh 2012 (uuuuh = bez ukrywania dla budynków itp.)10, 0,5 m, modyfikowalna, aktywna20, parzysta, modyfikowalna, aktywna30, nieparzysta, modyfikowalna, aktywna40, 5 m, modyfikowalna, aktywna50, 10 m, modyfikowalna, aktywna. Dodano nowe krzywe wysokości: Krzywe wysokości kompleksowe, 10 m - Kartograficzne krzywe wysokości w 2D (bez atrybutów) z równą odległością 10 m. Nawet - Kartograficzne krzywe wysokości w 2D (bez atrybutów) z równą odległością 2 m."},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa da cidade - As alturas consistiram nos seguintes subtipos (subtipos) na classificação da informação 2020 (para a lista atual ver especificação geral do produto Mapa da cidade): Curva alta RH0010, 0.5 m, modificável, active20, Even, modificável, active30, Odd, modificável, active40, 5 m, modificável, active50, 10 m, modificável, active60, Inseguro, modificável, activeHigh curve uuh 2012 (uuuh = sem ocultação para edifícios, etc.)10, 0.5 m, modificável, active20, Even, modificável, active30, Odd, modificável, active40, 5 m, modificável, active50, 10 m, modificável, active. Novas curvas de altura adicionadas: Curvas de altura abrangentes, 10 m - Curvas de altura cartográficas em 2D (sem atributos) com equidistante de 10 m. Mesmo - Curvas de altura cartográficas em 2D (sem atributos) com equidistante de 2 m."},{"@language":"ro-t-sv-t0-mtec","@value":"Harta orașului - Înălțimi a constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor 2020 (pentru lista actuală a se vedea Specificația generală a produsului Harta orașului):Curba înaltă RH0010, 0,5 m, modificabilă, activă20, Even, modificabilă, activă30, Odd, modificabilă, activă40, 5 m, modificabilă, activă50, 10 m, modificabilă, activă60, nesigură, modificabilă, activăCurba înaltă uuh 2012 (uuuh = fără ascundere pentru clădiri etc.)10, 0,5 m, modificabilă, activă20, Even, modificabilă, activă30, Odd, modificabilă, activă40, 5 m, modificabilă, activă50, 10 m, modificabilă, activă. Au fost adăugate noi curbe de înălțime: Curbe de altitudine cuprinzătoare, 10 m - Curbe cartografice de înălțime în 2D (fără atribute) cu echidistanță de 10 m. Chiar - Curbe cartografice de înălțime în 2D (fără atribute) cu echidistanță de 2 m."},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa mesta - výšiny pozostávala z týchto podtypov (podtypov) v informačnej klasifikácii 2020 (pre aktuálny zoznam pozri všeobecnú špecifikáciu výrobku Mapa mesta):Vysoká krivka RH0010, 0,5 m, modifikovateľná, aktívna20, Even, modifikovateľná, aktívna30, Odd, modifikovateľná, aktívna40, 5 m, modifikovateľná, aktívna50, 10 m, modifikovateľná, aktívna60, Nebezpečná, modifikovateľná, aktívnaVysoká krivka uuh 2012 (uuuh = bez utajenia pre budovy atď.)10, 0,5 m, modifikovateľná, aktívna20, Even, modifikovateľná, aktívna30, Odd, modifikovateľná, aktívna40, 5 m, modifikovateľná, aktívna50, 10 m, modifikovateľná, aktívna. Doplnené nové výškové krivky: Výškové krivky sú komplexné, 10 m - kartografické výškové krivky v 2D (bez atribútov) s rovnakou vzdialenosťou 10 m. Rovnaké - kartografické výškové krivky v 2D (bez atribútov) s rovnakou vzdialenosťou 2 m."},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid mesta - Višina je bila sestavljena iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej splošno specifikacijo proizvoda Zemljevid mesta): Visoka krivulja RH0010, 0,5 m, spremenljiva, aktivna20, Enakomerna, spremenljiva, aktivna30, Odd, spremenljiva, aktivna40, 5 m, spremenljiva, aktivna50, 10 m, spremenljiva, aktivna60, Nevarna, spremenljiva, aktivnaVisoka krivulja uuh 2012 (uuuh = brez skrivanja za stavbe itd.)10, 0,5 m, spremenljiva, aktivna20, Enakomerna, spremenljiva, aktivna30, Odd, spremenljiva, aktivna40, 5 m, spremenljiva, aktivna50, 10 m, spremenljiva, aktivna. Dodane so nove višinske krivulje: Višinske krivulje celovito, 10 m – Kartografske višinske krivulje v 2D (brez atributov) z enako oddaljenostjo 10 m. Tudi – Kartografske višinske krivulje v 2D (brez atributov) z enako oddaljenostjo 2 m."},{"@language":"sv","@value":"Stadskarta - Höjder bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :Höjdkurva RH0010, 0.5 m, modifierbar, aktiv20, Jämn, modifierbar, aktiv30, Udda, modifierbar, aktiv40, 5 m, modifierbar, aktiv50, 10 m, modifierbar, aktiv60, Osäker, modifierbar, aktivHöjdkurva uuh 2012 (uuh = utan undanhållning för byggnader mm)10, 0.5 m, modifierbar, aktiv20, Jämn, modifierbar, aktiv30, Udda, modifierbar, aktiv40, 5 m, modifierbar, aktiv50, 10 m, modifierbar, aktiv. Nya höjdkurvor tillkommit: Höjdkurvor heltäckande, 10 m - Kartografiska höjdkurvor i 2D (utan attribut) med ekvidistans på 10 m. Jämn - Kartografiska höjdkurvor i 2D (utan attribut) med ekvidistans på 2 m."},{"@language":"uk-t-sv-t0-mtec","@value":"Карта міста - Висоти складалися з наступних підтипів (підтипів) в інформаційній класифікації 2020 (для поточного списку див. загальну специфікацію продукту Карта міста):Висока крива RH0010, 0.5 м, що модифікується, active20, Even, що модифікується, active30, Odd, що модифікується, active40, 5 м, що модифікується, active50, 10 м, що модифікується, active60, Небезпечна, що модифікується, activeHigh curve uh 2012 (uuuuh = без приховування для будівель тощо)10, 0.5 м, що модифікується, active20, Even, що модифікується, active30, Oddd, що модифікується, active40, 5 м, що модифікується, active50, 10 м, що модифікується, активна. Нові криві висоти додані: Криві висоти всеосяжні, 10 м - Картографічні криві висоти в 2D (без атрибутів) з рівновіддаленістю 10 м."}],"dct:format":"text/html","dct:identifier":"e499670c-6f53-4901-852f-0a902a179d54","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:560402d8b7a37e0921935f5f5912f774902b8b342c5eae3130571206b2f9e9f7_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK картата на града - Височини"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Mapa města - Heights"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Bykort - Højder"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stadtplan - Heights"},{"@language":"el-t-sv-t0-mtec","@value":"SBK χάρτης της πόλης - Heights"},{"@language":"en-t-sv-t0-mtec","@value":"SBK City map - Heights"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa de la ciudad - Heights"},{"@language":"et-t-sv-t0-mtec","@value":"SBK linna kaart - Kõrgused"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Kaupungin kartta - Korkeudet"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de la ville - Heights"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Chathair SBK - Airde"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Karta grada - Visina"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Várostérkép - Heights"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa della città - Heights"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Miesto žemėlapis - Aukštys"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK City karte - Augstums"},{"@language":"mt-t-sv-t0-mtec","@value":"Mappa tal-Belt ta' l-SBK - Għoli"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Stadsplattegrond - Heights"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Mapa miasta - Heights"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Mapa da cidade - Alturas"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Harta orașului - Înălțimi"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK City mapu - výšiny"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Zemljevid mesta - Višine"},{"@language":"sv","@value":"SBK Stadskarta - Höjder"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК карта міста - Висоти"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/19e0706f-08bd-44aa-a089-fff22aedb7a5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=464514632_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/e499670c-6f53-4901-852f-0a902a179d54#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Stadskarta",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продукта Карта на града"},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktu Mapa města"},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktet Bykort"},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Stadtplan enthalten"},{"@language":"el-t-sv-t0-mtec","@value":"Το σύνολο δεδομένων περιλαμβάνεται στο προϊόν Χάρτης πόλης"},{"@language":"en-t-sv-t0-mtec","@value":"The data set is included in the product City map"},{"@language":"es-t-sv-t0-mtec","@value":"El conjunto de datos se incluye en el producto Mapa de la ciudad"},{"@language":"et-t-sv-t0-mtec","@value":"Andmekogum sisaldub tootes City map"},{"@language":"fi-t-sv-t0-mtec","@value":"Aineisto sisältyy tuotteeseen Kaupunkikartta"},{"@language":"fr-t-sv-t0-mtec","@value":"L'ensemble de données est inclus dans le produit Carte de ville"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an tacar sonraí san áireamh sa táirge Léarscáil na Cathrach"},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka uključen je u proizvod Karta grada"},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatkészlet szerepel a termékben Várostérkép"},{"@language":"it-t-sv-t0-mtec","@value":"Il set di dati è incluso nella mappa della città del prodotto"},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rinkinys yra įtrauktas į produkto Miesto žemėlapis"},{"@language":"lv-t-sv-t0-mtec","@value":"Datu kopa ir iekļauta produkta pilsētas kartē"},{"@language":"mt-t-sv-t0-mtec","@value":"Is-sett tad-data huwa inkluż fil-mappa tal-Belt tal-prodott"},{"@language":"nl-t-sv-t0-mtec","@value":"De dataset is opgenomen in het product Stadskaart"},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się w produkcie Mapa miasta"},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no produto Mapa da cidade"},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în produs Harta orașului"},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor údajov je súčasťou produktu Mapa mesta"},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni niz je vključen v produkt Zemljevid mesta"},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних включений в продукт Карта міста"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/19e0706f-08bd-44aa-a089-fff22aedb7a5"}},{"@id":"http://data.europa.eu/88u/record/e499670c-6f53-4901-852f-0a902a179d54","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/19e0706f-08bd-44aa-a089-fff22aedb7a5"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"e499670c-6f53-4901-852f-0a902a179d54","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:12Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:57Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/e499670c-6f53-4901-852f-0a902a179d54"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:560402d8b7a