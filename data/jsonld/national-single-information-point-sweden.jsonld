v","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/1aa0bb19-edd0-464b-b941-5c855b820f48","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=220f8cb5-043b-43e3-a07d-6ca694285b8d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":{"@language":"sv","@value":"Höjddata, 1 meters grid. De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 22 april - 7 maj 2023 och interpolerat till ett grid med upplösning 1 m. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna har inte ajourförts sedan de skapades. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna.Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom byggnaden. Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},"dct:identifier":"1aa0bb19-edd0-464b-b941-5c855b820f48","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b0n0"},"dct:temporal":{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Höjdgrid (2023)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%2523dataset","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%2523distribution"},"dcat:keyword":{"@language":"sv","@value":"deklaration"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"2.3","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Fastighetstaxering - innehav gör det möjligt för myndigheter att hämta uppgifter om fastigheters innehav direkt i den egna programvaran."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Fastighetstaxering - innehav"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/fastighetstaxering-innehav/2.3.0/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/fastighetstaxering-innehav/2.3.0/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/fastighetstaxering-innehav/2.3.0/swagger.json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-06-0