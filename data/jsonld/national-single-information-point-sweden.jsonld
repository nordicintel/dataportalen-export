.eu/88u/distribution/7b7fa2c7-bd5c-451b-83a2-1a54f46c7618"}},{"@id":"http://data.europa.eu/88u/distribution/ed23b171-80b4-489b-9df5-db8cc033432d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/8447f7af7135442f82182c8001ad78b6_0/explore"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/76f2c008-1d71-473b-bd24-7a499293d711#HTTP:ESRI+Portal-URL/2","dct:title":["Miljöförvaltningens öppna data-hub",{"@language":"bg-t-sv-t0-mtec","@value":"Център за отворени данни на администрацията по околна среда"},{"@language":"cs-t-sv-t0-mtec","@value":"Rozbočovač otevřených dat správy životního prostředí"},{"@language":"da-t-sv-t0-mtec","@value":"Miljøstyrelsens åbne datahub"},{"@language":"de-t-sv-t0-mtec","@value":"Open Data Hub der Umweltverwaltung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόμβος ανοικτών δεδομένων της περιβαλλοντικής διοίκησης"},{"@language":"en-t-sv-t0-mtec","@value":"Environmental administration's open data hub"},{"@language":"es-t-sv-t0-mtec","@value":"Centro de datos abiertos de la administración ambiental"},{"@language":"et-t-sv-t0-mtec","@value":"Keskkonnaameti avatud andmete keskus"},{"@language":"fi-t-sv-t0-mtec","@value":"Ympäristöhallinnon avoimen datan keskus"},{"@language":"fr-t-sv-t0-mtec","@value":"Pôle de données ouvertes de l'administration environnementale"},{"@language":"ga-t-sv-t0-mtec","@value":"Mol sonraí oscailte an riaracháin comhshaoil"},{"@language":"hr-t-sv-t0-mtec","@value":"Centar otvorenih podataka uprave za okoliš"},{"@language":"hu-t-sv-t0-mtec","@value":"A környezetvédelmi igazgatás nyílt adatközpontja"},{"@language":"it-t-sv-t0-mtec","@value":"L'hub open data dell'amministrazione ambientale"},{"@language":"lt-t-sv-t0-mtec","@value":"Aplinkos apsaugos administracijos atvirųjų duomenų centras"},{"@language":"lv-t-sv-t0-mtec","@value":"Vides pārvaldes atvērto datu centrs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ċentru tad-data miftuħa tal-amministrazzjoni ambjentali"},{"@language":"nl-t-sv-t0-mtec","@value":"Open data hub van de milieuadministratie"},{"@language":"pl-t-sv-t0-mtec","@value":"Otwarte centrum danych administracji środowiskowej"},{"@language":"pt-t-sv-t0-mtec","@value":"Centro de dados abertos da administração ambiental"},{"@language":"ro-t-sv-t0-mtec","@value":"Centrul de date deschise al administrației de mediu"},{"@language":"sk-t-sv-t0-mtec","@value":"Centrum otvorených dát environmentálnej správy"},{"@language":"sl-t-sv-t0-mtec","@value":"Vozlišče odprtih podatkov okoljske uprave"},{"@language":"uk-t-sv-t0-mtec","@value":"Центр відкритих даних екологічної адміністрації"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ed23b171-80b4-489b-9df5-db8cc033432d"}},{"@id":"http://data.europa.eu/88u/record/76f2c008-1d71-473b-bd24-7a499293d711","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1910be9f-e78d-4050-8574-8e739a04b1d2"},{"@id":"http://data.europa.eu/88u/distribution/7b7fa2c7-bd5c-451b-83a2-1a54f46c7618"},{"@id":"http://data.europa.eu/88u/distribution/ed23b171-80b4-489b-9df5-db8cc033432d"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"76f2c008-1d71-473b-bd24-7a499293d711","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:50Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/76f2c008-1d71-473b-bd24-7a499293d711"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:4be49fbd3e4f2fcb9f01a317be34d891678c2cd2b1d1d50edd745c6a3df8ecbf_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/76f2c008-1d71-473b-bd24-7a499293d711"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:50Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"76f2c008-1d71-473b-bd24-7a499293d711","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/76f2c008-1d71-473b-bd24-7a499293d711"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:4be49fbd3e4f2fcb9f01a317be34d891678c2cd2b1d1d50edd745c6a3df8ecbf"},{"@graph":[{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.4117 59.4516,18.2011 59.4516,18.2011 59.0444,17.4117 59.0444,17.4117 59.4516))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.4117 59.4516,18.2011 59.4516,18.2011 59.0444,17.4117 59.0444,17.4117 59.4516))"}},{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2050-09-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-09-20"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2050-09-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2024-09-20"}},{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"10512fffedc97d768a5abe1e58dff8f388"},{"@id":"http://data.europa.eu/88u/dataset/f4287985-702e-4603-99ba-5bfa6f852c70","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/"},"dcat:keyword":["Stockholm Vatten och Avfall",{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=d09816e4-ea3c-475a-9615-6b80400bf4b9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2020-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Показва бъдещите основни водопроводи, които се очаква да бъдат изградени до 2050 г. Инвентарният опис съдържа информация за приблизителното време за изпълнение на всеки проект, точният обхват и подробностите могат да варират в зависимост от етапа на проекта. Наборът от данни съдържа командни линии, които се предлагат, планират и изпълняват. Съхранението е поверително; Изисква се споразумение за неразкриване на информация, споразумение за неразкриване на информация или личен ангажимент за неразкриване на информация. Наборът от данни НЕ съдържа съществуващи линии, а само допълнителни линии за бъдещи основни водопроводи."},{"@language":"cs-t-sv-t0-mtec","@value":"Ukazuje budoucí hlavní vodovody, které by měly být zavedeny do roku 2050. Inventář obsahuje informace o přibližné době realizace každého projektu, přesný rozsah a podrobnosti se mohou lišit v závislosti na fázi projektu. Datová sada obsahuje příkazové řádky, které jsou navrhovány, plánovány a implementovány. Uchovávání je důvěrné; Je vyžadována dohoda o mlčenlivosti, dohoda o mlčenlivosti nebo osobní závazek k mlčenlivosti. Soubor dat neobsahuje stávající vedení, ale pouze další vedení pro budoucí hlavní vodovodní potrubí."},{"@language":"da-t-sv-t0-mtec","@value":"Viser de fremtidige hovedvandledninger, der forventes at være på plads i 2050. Fortegnelsen indeholder oplysninger om den omtrentlige gennemførelsestid for hvert projekt, det nøjagtige omfang og detaljer kan variere afhængigt af projektfasen. Datasættet indeholder kommandolinjer, der foreslås, planlægges og implementeres. Opbevaringen er fortrolig. Der kræves hemmeligholdelsesaftale, hemmeligholdelsesaftale eller personligt hemmeligholdelsestilsagn. Datasættet indeholder IKKE eksisterende ledninger, men kun ekstra ledninger til fremtidige hovedvandledninger."},{"@language":"de-t-sv-t0-mtec","@value":"Zeigt die zukünftigen Hauptwasserleitungen, die bis 2050 vorhanden sein sollen. Das Inventar enthält Informationen über die ungefähre Umsetzungszeit für jedes Projekt, der genaue Umfang und die Details können je nach Projektphase variieren. Der Datensatz enthält Befehlszeilen, die vorgeschlagen, geplant und implementiert werden. Die Speicherung ist vertraulich; Geheimhaltungsvereinbarung, Geheimhaltungsvereinbarung oder persönliche Geheimhaltungsverpflichtung ist erforderlich. Der Datensatz enthält KEINE vorhandenen Leitungen, sondern nur zusätzliche Leitungen für zukünftige Hauptwasserleitungen."},{"@language":"el-t-sv-t0-mtec","@value":"Δείχνει τους μελλοντικούς κύριους αγωγούς νερού που υποτίθεται ότι θα έχουν τεθεί σε λειτουργία έως το 2050. Ο κατάλογος περιέχει πληροφορίες σχετικά με τον κατά προσέγγιση χρόνο υλοποίησης για κάθε έργο, το ακριβές πεδίο εφαρμογής και οι λεπτομέρειες ενδέχεται να διαφέρουν ανάλογα με τη φάση του έργου. Το σύνολο δεδομένων περιέχει γραμμές εντολών που προτείνονται, σχεδιάζονται και υλοποιούνται. Η αποθήκευση είναι εμπιστευτική· Απαιτείται συμφωνία τήρησης του απορρήτου, συμφωνία τήρησης του απορρήτου ή προσωπική δέσμευση τήρησης του απορρήτου. Το σύνολο δεδομένων ΔΕΝ περιέχει υφιστάμενες γραμμές, αλλά μόνο πρόσθετες γραμμές για μελλοντικούς κύριους σωλήνες νερού."},{"@language":"en-t-sv-t0-mtec","@value":"Shows the future main water pipelines that are supposed to be in place by 2050. The inventory contains information about the approximate implementation time for each project, the exact scope and details may vary depending on the project phase. The data set contains lines of command that are proposed, planned and implemented. The storage is confidential; Non-disclosure agreement, non-disclosure agreement or personal non-disclosure commitment is required. The data set does NOT contain existing lines but only additional lines for future main water pipes."},{"@language":"es-t-sv-t0-mtec","@value":"Muestra las futuras tuberías principales de agua que se supone que estarán en funcionamiento para 2050. El inventario contiene información sobre el tiempo aproximado de ejecución de cada proyecto, el alcance exacto y los detalles pueden variar dependiendo de la fase del proyecto. El conjunto de datos contiene líneas de comando que se proponen, planifican e implementan. El almacenamiento es confidencial; Se requiere un acuerdo de no divulgación, un acuerdo de no divulgación o un compromiso personal de no divulgación. El conjunto de datos NO contiene líneas existentes, sino solo líneas adicionales para futuras tuberías principales de agua."},{"@language":"et-t-sv-t0-mtec","@value":"Näitab tulevasi peamisi veetorustikke, mis peaksid valmima 2050. aastaks. Inventuur sisaldab teavet iga projekti rakendamise ligikaudse aja, täpse ulatuse ja üksikasjade kohta, mis võivad projekti etapist sõltuvalt erineda. Andmekogum sisaldab kavandatud, kavandatud ja rakendatud käsuliine. ladustamine on konfidentsiaalne; Nõutav on mitteavalikustamise kokkulepe, mitteavalikustamise kokkulepe või isiklik mitteavalikustamise kohustus. Andmekogum EI sisalda olemasolevaid liine, vaid ainult lisaliine tulevaste peamiste veetorustike jaoks."},{"@language":"fi-t-sv-t0-mtec","@value":"Näyttää tulevaisuuden tärkeimmät vesiputkistot, jotka on tarkoitus ottaa käyttöön vuoteen 2050 mennessä. Luettelo sisältää tietoja kunkin hankkeen arvioidusta toteutusajasta, tarkka laajuus ja yksityiskohdat voivat vaihdella hankkeen vaiheesta riippuen. Tietojoukko sisältää komentorivejä, joita ehdotetaan, suunnitellaan ja toteutetaan. Säilytys on luottamuksellinen; Vaatimuksena on salassapitosopimus, salassapitosopimus tai henkilökohtainen salassapitositoumus. Tietokokonaisuus EI sisällä olemassa olevia linjoja, vaan ainoastaan lisälinjoja tulevia päävesiputkia varten."},{"@language":"fr-t-sv-t0-mtec","@value":"Montre les futurs principaux pipelines d'eau qui sont censés être en place d'ici 2050. L'inventaire contient des informations sur le délai approximatif de mise en œuvre de chaque projet, la portée exacte et les détails peuvent varier en fonction de la phase du projet. L'ensemble de données contient des lignes de commande qui sont proposées, planifiées et mises en œuvre. Le stockage est confidentiel; Un accord de non-divulgation, un accord de non-divulgation ou un engagement personnel de non-divulgation est requis. L'ensemble de données ne contient PAS de lignes existantes, mais seulement des lignes supplémentaires pour les futures conduites d'eau principales."},{"@language":"ga-t-sv-t0-mtec","@value":"Taispeánann sé na príomhphíblínte uisce amach anseo atá ceaptha a bheith i bhfeidhm faoi 2050. Tá faisnéis san fhardal maidir leis an neas-am cur chun feidhme le haghaidh gach tionscadail, d’fhéadfadh an raon feidhme beacht agus na sonraí a bheith éagsúil ag brath ar chéim an tionscadail. Tá línte ceannais sa tacar sonraí a mholtar, a phleanáiltear agus a chuirtear chun feidhme. Tá an stóráil faoi rún; Tá gá le comhaontú neamhnochta, comhaontú neamhnochta nó gealltanas pearsanta neamhnochta. NÍL línte atá ann cheana sa tacar sonraí ach níl ann ach línte breise le haghaidh príomhphíopaí uisce amach anseo."},{"@language":"hr-t-sv-t0-mtec","@value":"Prikazuje buduće glavne vodovodne cjevovode koji bi trebali biti uspostavljeni do 2050. godine. Popis sadržava informacije o približnom vremenu provedbe za svaki projekt, točan opseg i pojedinosti mogu se razlikovati ovisno o fazi projekta. Skup podataka sadrži naredbene linije koje se predlažu, planiraju i provode. Pohrana je povjerljiva; Potreban je ugovor o povjerljivosti podataka, ugovor o povjerljivosti podataka ili osobna obveza neotkrivanja podataka. Skup podataka NE sadrži postojeće vodove, već samo dodatne vodove za buduće glavne vodovodne cijevi."},{"@language":"hu-t-sv-t0-mtec","@value":"Megmutatja azokat a jövőbeli fő vízvezetékeket, amelyeknek 2050-re kellene működniük. A leltár információkat tartalmaz az egyes projektek hozzávetőleges végrehajtási idejéről, a pontos hatókör és a részletek a projektszakasztól függően változhatnak. Az adatkészlet olyan parancssorokat tartalmaz, amelyek javasoltak, tervezettek és végrehajtottak. A tárolás bizalmas; Titoktartási megállapodás, titoktartási megállapodás vagy személyes titoktartási kötelezettség szükséges. Az adatkészlet NEM tartalmaz meglévő vezetékeket, csak további vezetékeket a jövőbeli fő vízvezetékekhez."},{"@language":"it-t-sv-t0-mtec","@value":"Mostra le future principali condutture idriche che dovrebbero essere in atto entro il 2050. L'inventario contiene informazioni sul tempo di attuazione approssimativo per ciascun progetto, l'ambito esatto e i dettagli possono variare a seconda della fase del progetto. Il set di dati contiene linee di comando che vengono proposte, pianificate e implementate. L'archiviazione è confidenziale; È richiesto un accordo di non divulgazione, un accordo di non divulgazione o un impegno personale di non divulgazione. Il set di dati NON contiene linee esistenti, ma solo linee aggiuntive per i futuri tubi principali dell'acqua."},{"@language":"lt-t-sv-t0-mtec","@value":"Parodomi būsimi pagrindiniai vandens vamzdynai, kurie turėtų būti įrengti iki 2050 m. Apraše pateikiama informacija apie apytikslį kiekvieno projekto įgyvendinimo laiką, tiksli apimtis ir duomenys gali skirtis priklausomai nuo projekto etapo. Duomenų rinkinyje yra siūlomos, planuojamos ir įgyvendinamos komandų eilutės. Sandėliavimas yra konfidencialus; Reikalingas informacijos neatskleidimo susitarimas, informacijos neatskleidimo susitarimas arba asmeninis įsipareigojimas neatskleisti informacijos. Duomenų rinkinyje NĖRA esamų linijų, o tik papildomos linijos būsimiems pagrindiniams vandens vamzdžiams."},{"@language":"lv-t-sv-t0-mtec","@value":"Parāda topošos galvenos ūdens cauruļvadus, kurus paredzēts ierīkot līdz 2050. gadam. Inventarizācija satur informāciju par aptuveno katra projekta īstenošanas laiku, precīzu darbības jomu un sīkāku informāciju, kas var atšķirties atkarībā no projekta posma. Datu kopā ir piedāvātās, plānotās un īstenotās komandrindas. glabāšana ir konfidenciāla; Ir nepieciešams informācijas neizpaušanas līgums, informācijas neizpaušanas līgums vai personiskas informācijas neizpaušanas saistības. Datu kopā NAV iekļautas esošās līnijas, bet tikai papildu līnijas nākotnes galvenajām ūdens caurulēm."},{"@language":"mt-t-sv-t0-mtec","@value":"Juri l-pipelines tal-ilma ewlenin futuri li suppost se jkunu fis-seħħ sal-2050. L-inventarju fih informazzjoni dwar iż-żmien approssimattiv tal-implimentazzjoni għal kull proġett, l-ambitu u d-dettalji eżatti jistgħu jvarjaw skont il-fażi tal-proġett. Is-sett ta’ data fih linji ta’ kmand li huma proposti, ippjanati u implimentati. Il-ħażna hija kunfidenzjali; Huwa meħtieġ ftehim ta’ nuqqas ta’ divulgazzjoni, ftehim ta’ nuqqas ta’ divulgazzjoni jew impenn ta’ nuqqas ta’ divulgazzjoni personali. Is-sett tad-data MA fihx linji eżistenti iżda biss linji addizzjonali għal pajpijiet tal-ilma ewlenin futuri."},{"@language":"nl-t-sv-t0-mtec","@value":"Toont de toekomstige hoofdwaterleidingen die tegen 2050 zouden moeten zijn aangelegd. De inventaris bevat informatie over de geschatte uitvoeringstijd voor elk project, de exacte reikwijdte en details kunnen variëren afhankelijk van de projectfase. De dataset bevat commandolijnen die worden voorgesteld, gepland en geïmplementeerd. De opslag is vertrouwelijk; Niet-openbaarmakingsovereenkomst, niet-openbaarmakingsovereenkomst of persoonlijke niet-openbaarmakingsverbintenis is vereist. De dataset bevat GEEN bestaande leidingen maar alleen extra leidingen voor toekomstige hoofdwaterleidingen."},{"@language":"pl-t-sv-t0-mtec","@value":"Przedstawia przyszłe główne rurociągi wodne, które mają zostać uruchomione do 2050 r. Inwentaryzacja zawiera informacje o przybliżonym czasie realizacji każdego projektu, dokładny zakres i szczegóły mogą się różnić w zależności od fazy projektu. Zbiór danych zawiera linie poleceń, które są proponowane, planowane i wdrażane. Przechowywanie jest poufne; Wymagana jest umowa o nieujawnianiu, umowa o nieujawnianiu lub osobiste zobowiązanie do nieujawniania. Zbiór danych NIE zawiera istniejących linii, a jedynie dodatkowe linie dla przyszłych głównych rur wodociągowych."},{"@language":"pt-t-sv-t0-mtec","@value":"Mostra os futuros principais dutos de água que devem estar em vigor até 2050. O inventário contém informações sobre o tempo aproximado de execução de cada projeto, o âmbito exato e os pormenores podem variar em função da fase do projeto. O conjunto de dados contém linhas de comando que são propostas, planeadas e implementadas. O armazenamento é confidencial; É necessário um acordo de não divulgação, um acordo de não divulgação ou um compromisso pessoal de não divulgação. O conjunto de dados NÃO contém linhas existentes, mas apenas linhas adicionais para futuros tubos de água principais."},{"@language":"ro-t-sv-t0-mtec","@value":"Prezintă viitoarele conducte principale de apă care ar trebui să fie instalate până în 2050. Inventarul conține informații despre timpul aproximativ de implementare pentru fiecare proiect, domeniul de aplicare exact și detaliile pot varia în funcție de faza proiectului. Setul de date conține linii de comandă care sunt propuse, planificate și implementate. Stocarea este confidențială; Este necesar un acord de nedivulgare, un acord de nedivulgare sau un angajament personal de nedivulgare. Setul de date NU conține linii existente, ci doar linii suplimentare pentru viitoarele conducte principale de apă."},{"@language":"sk-t-sv-t0-mtec","@value":"Predstavuje budúce hlavné vodovodné potrubia, ktoré by mali byť zavedené do roku 2050. Zoznam obsahuje informácie o približnom čase realizácie každého projektu, presný rozsah a podrobnosti sa môžu líšiť v závislosti od fázy projektu. Súbor údajov obsahuje príkazové riadky, ktoré sa navrhujú, plánujú a realizujú. Uchovávanie je dôverné; Vyžaduje sa dohoda o nezverejňovaní informácií, dohoda o nezverejňovaní informácií alebo záväzok týkajúci sa osobného nezverejňovania informácií. Súbor údajov neobsahuje existujúce vedenia, ale len ďalšie vedenia pre budúce hlavné vodovodné potrubia."},{"@language":"sl-t-sv-t0-mtec","@value":"Prikazuje prihodnje glavne vodne cevovode, ki naj bi bili vzpostavljeni do leta 2050. Popis vsebuje informacije o približnem času izvajanja za vsak projekt, natančen obseg in podrobnosti pa se lahko razlikujejo glede na fazo projekta. Podatkovni niz vsebuje ukazne vrstice, ki so predlagane, načrtovane in izvedene. hramba je zaupna; Zahteva se sporazum o nerazkritju, sporazum o nerazkritju ali osebna zaveza o nerazkritju. Podatkovni niz NE vsebuje obstoječih vodov, temveč le dodatne vode za prihodnje glavne vodovodne cevi."},{"@language":"sv","@value":"Visar de framtida huvudvattenledningarna som är tänkta att vara på plats till år 2050. Lagret innehåller information om ungefärlig genomförandetid för respektive projekt, exakt omfattning och detaljer kan variera beroende på projektets fas. Datamängden innehåller ledningssträckor som är föreslagna, planerade och genomförda. Lagret är sekretessbelagt; sekretessavtal, sekretessöverenskommelse eller personlig sekretessförbindelse krävs. Datamängden innehåller INTE befintliga ledningar utan endast tillkommande ledningsstråk för framtida huvudvattenledningar."},{"@language":"uk-t-sv-t0-mtec","@value":"Показує майбутні магістральні водопроводи, які повинні бути введені в дію до 2050 року. Інвентаризація містить інформацію про приблизний час реалізації для кожного проекту, точний обсяг і деталі можуть змінюватися в залежності від етапу проекту. Набір даних містить рядки команд, які пропонуються, плануються та реалізуються. Зберігання є конфіденційним; Потрібна угода про нерозголошення, угода про нерозголошення або особисте зобов'язання про нерозголошення. Набір даних НЕ містить існуючих ліній, а лише додаткові лінії для майбутніх магістральних водопроводів."}],"dct:identifier":"f4287985-702e-4603-99ba-5bfa6f852c70","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/"},"dct:spatial":{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b0n0"},"dct:temporal":{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Мрежова вода Бъдещи основни водопроводни тръби"},{"@language":"cs-t-sv-t0-mtec","@value":"Síťová voda Budoucí hlavní vodovodní potrubí"},{"@language":"da-t-sv-t0-mtec","@value":"Netværk vand Fremtidige hovedvandrør"},{"@language":"de-t-sv-t0-mtec","@value":"Netzwerk Wasser Zukünftige Hauptwasserleitungen"},{"@language":"el-t-sv-t0-mtec","@value":"Νερό δικτύου Μελλοντικοί κύριοι σωλήνες νερού"},{"@language":"en-t-sv-t0-mtec","@value":"Network water Future main water pipes"},{"@language":"es-t-sv-t0-mtec","@value":"Red de agua Futuras tuberías principales de agua"},{"@language":"et-t-sv-t0-mtec","@value":"Võrguvesi Tulevased peamised veetorud"},{"@language":"fi-t-sv-t0-mtec","@value":"Verkkovesi Tulevaisuuden päävesiputket"},{"@language":"fr-t-sv-t0-mtec","@value":"Eau de réseau Futurs conduites d'eau principales"},{"@language":"ga-t-sv-t0-mtec","@value":"Uisce Líonra Príomhphíopaí uisce sa todhchaí"},{"@language":"hr-t-sv-t0-mtec","@value":"Mrežna voda Buduće glavne vodovodne cijevi"},{"@language":"hu-t-sv-t0-mtec","@value":"Hálózati víz Jövőbeli fő vízvezetékek"},{"@language":"it-t-sv-t0-mtec","@value":"Future condutture principali dell'acqua"},{"@language":"lt-t-sv-t0-mtec","@value":"Tinklo vanduo Ateities pagrindiniai vandens vamzdžiai"},{"@language":"lv-t-sv-t0-mtec","@value":"Tīkla ūdens Nākotnes galvenās ūdens caurules"},{"@language":"mt-t-sv-t0-mtec","@value":"Pajpijiet ewlenin tal-ilma ta’ Network water Future"},{"@language":"nl-t-sv-t0-mtec","@value":"Netwerkwater Toekomstige hoofdwaterleidingen"},{"@language":"pl-t-sv-t0-mtec","@value":"Sieć wodna Przyszłe główne rury wodociągowe"},{"@language":"pt-t-sv-t0-mtec","@value":"Rede de água Futuras condutas de água principais"},{"@language":"ro-t-sv-t0-mtec","@value":"Rețea de apă Viitoarele conducte principale de apă"},{"@language":"sk-t-sv-t0-mtec","@value":"Sieťová voda Budúce hlavné vodovodné potrubia"},{"@language":"sl-t-sv-t0-mtec","@value":"Omrežna voda Prihodnje glavne cevi za vodo"},{"@language":"sv","@value":"Ledningsnät vatten Framtida huvudvattenledningar"},{"@language":"uk-t-sv-t0-mtec","@value":"Мережева вода Майбутні магістральні водопровідні труби"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/record/f4287985-702e-4603-99ba-5bfa6f852c70","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"f4287985-702e-4603-99ba-5bfa6f852c70","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:08Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/f4287985-702e-4603-99ba-5bfa6f852c70"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/f4287985-702e-4603-99ba-5bfa6f852c70"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-13T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis@svoa.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-52212000"}}],"@id":"urn:source:4d721dcfa08b697dff2adc8b7c3be8c99ce8e343d70e0aaad5878c237fa5d41a"},{"@graph":[{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"8c7958ab201c277fe213017620517ca385"},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b10n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2523","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f5d47d76-5a45-46fe-9fa3-5fa2b3cc4851"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b11n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2525","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/40999c64-435a-457f-8e45-757a79284e46"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b12n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2531","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/1ca436d0-aff2-4ea3-b817-50c66c78d6d9"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b13n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2533","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/adf4e9d9-53f4-4f2d-905e-13d4110fa425"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b14n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2539","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f6af0108-09c8-4e9b-9db5-0c3a9bee7c3f"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b15n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2541","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/d696770f-d5de-421e-a034-94da4cabad21"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b16n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2570","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/bf73e5a1-df84-497b-8aee-1b05ba1b854e"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b17n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2572","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/feaf837e-4e32-4c50-af02-b9c6ffb7faa5"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e