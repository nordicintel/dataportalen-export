7b_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/0fce396f-8e43-410e-a6cd-db037605d456"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:00Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:42Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"0fce396f-8e43-410e-a6cd-db037605d456","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/0fce396f-8e43-410e-a6cd-db037605d456"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:34aa11a69df7b6f7b1caacb4d2423a46922c1a3e68ac452f5c64ab6f0455547b"},{"@graph":[{"@id":"_:3527383d76fb653b740a3fba8c473eb8b1008545ccaff32360ec0baa0402f1aa_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:3527383d76fb653b740a3fba8c473eb8b1008545ccaff32360ec0baa0402f1aa_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2015-06-05"},"dcat:startDate":{"@type":"xsd:date","@value":"2015-05-16"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2015-06-05"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2015-05-16"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e1007629-6720-4434-8a4e-c3d7f529a845"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2015-06-05"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1300 mUpplösning: 8 cm/pixel. Fotograferingsdatum: 16, 24 maj, 4-5 juni 2015. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","dct:issued":{"@type":"xsd:date","@value":"2016-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:3527383d76fb653b740a3fba8c473eb8b1008545ccaff32360ec0baa0402f1aa_b0n0"},"dct:temporal":{"@id":"_:3527383d76fb653b740a3fba8c473eb8b1008545ccaff32360ec0baa0402f1aa_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2015)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2015"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2015"},{"@id":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2015"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2015"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:3527383d76fb653b740a3fba8c473eb8b1008545ccaff32360ec0baa0402f1aa"},{"@graph":[{"@id":"_:3531d7e484a118fbc8683b02fb7bcb529c5e25828297641bb965d59d277cab5e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:3531d7e484a118fbc8683b02fb7bcb529c5e25828297641bb965d59d277cab5e_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"126b9b87321e300d56435217a0d0fc33c6"},{"@id":"http://data.europa.eu/88u/dataset/33d715bc-4603-4a14-b941-aaa3eb715894","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/b8fa8ce3-39bd-4695-a92d-0149d872ea9e"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f2476861-b549-48f8-a362-d98db11d595e"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2004-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Тел модели на сгради с подробни покривни конструкции. 3D сгради (LOD2) се използват за планиране и визуализации и са на разположение за вътрешния град и за избрани области на външните предели.Височините на земята, сградите и растителността се определят с помощта на фотограметрия и лазерно сканиране."},{"@language":"cs-t-sv-t0-mtec","@value":"Drátěné modely budov s detailními střešními konstrukcemi. 3D budovy (LOD2) se používají pro plánování a vizualizace a jsou k dispozici pro vnitřní město a pro vybrané oblasti vnějších dosahů.Výšky pozemků, budov a vegetace jsou určeny pomocí fotogrammetrie a laserového skenování."},{"@language":"da-t-sv-t0-mtec","@value":"Wire modeller af bygninger med detaljerede tagkonstruktioner. 3D bygninger (LOD2) bruges til planlægning og visualiseringer og er tilgængelige for den indre by og for udvalgte områder af de ydre reach.The højder af jord, bygninger og vegetation bestemmes ved hjælp af fotogrammetri og laser scanning."},{"@language":"de-t-sv-t0-mtec","@value":"Drahtmodelle von Gebäuden mit detaillierten Dachkonstruktionen. 3D-Gebäude (LOD2) werden für die Planung und Visualisierung verwendet und stehen für die Innenstadt und für ausgewählte Bereiche der Aussenbereiche zur Verfügung.Die Höhen von Land, Gebäuden und Vegetation werden mittels Photogrammetrie und Laserscanning ermittelt."},{"@language":"el-t-sv-t0-mtec","@value":"Συρμάτινα μοντέλα κτιρίων με λεπτομερείς δομές οροφής. Τα τρισδιάστατα κτίρια (LOD2) χρησιμοποιούνται για το σχεδιασμό και τις απεικονίσεις και είναι διαθέσιμα για το κέντρο της πόλης και για επιλεγμένες περιοχές των εξωτερικών περιοχών.Τα ύψη της γης, των κτιρίων και της βλάστησης καθορίζονται με τη χρήση φωτογραμμετρίας και σάρωσης με λέιζερ."},{"@language":"en-t-sv-t0-mtec","@value":"Wire models of buildings with detailed roof structures. 3D buildings (LOD2) are used for planning and visualizations and are available for the inner city and for selected areas of the outer reaches.The heights of land, buildings and vegetation are determined using photogrammetry and laser scanning."},{"@language":"es-t-sv-t0-mtec","@value":"Modelos de alambre de edificios con estructuras de techo detalladas. Los edificios 3D (LOD2) se utilizan para la planificación y las visualizaciones y están disponibles para el centro de la ciudad y para áreas seleccionadas de los alcances exteriores."},{"@language":"et-t-sv-t0-mtec","@value":"Detailsete katusekonstruktsioonidega hoonete traadimudelid. 3D-hooneid (LOD2) kasutatakse planeerimiseks ja visualiseerimiseks ning need on kättesaadavad siselinnale ja valitud välispiirkondadele.Maa, hoonete ja taimestiku kõrgused määratakse fotogramm-meetria ja laserskaneerimise abil."},{"@language":"fi-t-sv-t0-mtec","@value":"Rakennusten lankamallit, joissa on yksityiskohtaiset kattorakenteet. 3D-rakennuksia (LOD2) käytetään suunnittelussa ja visualisoinneissa, ja ne ovat käytettävissä sisäkaupungissa ja valituilla ulkoalueiden alueilla.Maan, rakennusten ja kasvillisuuden korkeudet määritetään fotogrammetrialla ja laserkeilauksella."},{"@language":"fr-t-sv-t0-mtec","@value":"Modèles de fils de bâtiments avec des structures de toit détaillées. Les bâtiments 3D (LOD2) sont utilisés pour la planification et les visualisations et sont disponibles pour le centre-ville et pour certaines zones des tronçons extérieurs.Les hauteurs des terres, des bâtiments et de la végétation sont déterminées à l'aide de la photogrammétrie et du balayage laser."},{"@language":"ga-t-sv-t0-mtec","@value":"Samhlacha sreang d'fhoirgnimh le struchtúir dín mionsonraithe. Úsáidtear foirgnimh 3D (LOD2) le haghaidh pleanála agus léirshamhlaithe agus tá siad ar fáil don chathair istigh agus do cheantair roghnaithe na sroicheann seachtracha."},{"@language":"hr-t-sv-t0-mtec","@value":"Žičani modeli zgrada s detaljnim krovnim konstrukcijama. 3D zgrade (LOD2) se koriste za planiranje i vizualizaciju i dostupne su za unutarnji grad i za odabrana područja vanjskih dosega.Visine zemljišta, zgrada i vegetacije određuju se fotogrametrijom i laserskim skeniranjem."},{"@language":"hu-t-sv-t0-mtec","@value":"Épületek huzalmodelljei részletes tetőszerkezetekkel. A 3D-s épületeket (LOD2) a tervezéshez és a vizualizációhoz használják, és a belváros és a külső területek kiválasztott területei számára állnak rendelkezésre."},{"@language":"it-t-sv-t0-mtec","@value":"Modelli del cavo degli edifici con le strutture dettagliate del tetto. Gli edifici 3D (LOD2) sono utilizzati per la pianificazione e la visualizzazione e sono disponibili per il centro città e per aree selezionate delle aree esterne.Le altezze del terreno, degli edifici e della vegetazione sono determinate utilizzando la fotogrammetria e la scansione laser."},{"@language":"lt-t-sv-t0-mtec","@value":"Vieliniai pastatų modeliai su detaliomis stogo konstrukcijomis. 3D pastatai (LOD2) yra naudojami planavimui ir vizualizacijoms ir yra prieinami vidiniam miestui ir pasirinktoms išorinio pasiekiamumo sritims."},{"@language":"lv-t-sv-t0-mtec","@value":"Stiepļu modeļi ēkām ar detalizētām jumta konstrukcijām. 3D ēkas (LOD2) tiek izmantotas plānošanai un vizualizācijai un ir pieejamas iekšpilsētai un izvēlētām ārējām teritorijām."},{"@language":"mt-t-sv-t0-mtec","@value":"Mudelli tal-wajer ta’ bini bi strutturi tas-saqaf dettaljati. Il-bini 3D (LOD2) jintuża għall-ippjanar u l-viżwalizzazzjonijiet u huwa disponibbli għall-belt ta 'ġewwa u għal żoni magħżula tal-wesgħat ta' barra. L-għoli tal-art, il-bini u l-veġetazzjoni huma ddeterminati bl-użu ta 'fotogrammetrija u skennjar bil-lejżer."},{"@language":"nl-t-sv-t0-mtec","@value":"Draadmodellen van gebouwen met gedetailleerde dakconstructies. 3D-gebouwen (LOD2) worden gebruikt voor planning en visualisaties en zijn beschikbaar voor de binnenstad en voor geselecteerde gebieden van de buitenste bereiken.De hoogten van land, gebouwen en vegetatie worden bepaald met behulp van fotogrammetrie en laserscanning."},{"@language":"pl-t-sv-t0-mtec","@value":"Modele drutowe budynków ze szczegółowymi konstrukcjami dachowymi. Budynki 3D (LOD2) służą do planowania i wizualizacji i są dostępne dla śródmieścia i wybranych obszarów zewnętrznych.Wysokości gruntów, budynków i roślinności są określane za pomocą fotogrametrii i skanowania laserowego."},{"@language":"pt-t-sv-t0-mtec","@value":"Modelos de arame de edifícios com estruturas de telhado detalhadas. Os edifícios 3D (LOD2) são utilizados para planeamento e visualização e estão disponíveis para o centro da cidade e para áreas selecionadas dos confins exteriores."},{"@language":"ro-t-sv-t0-mtec","@value":"Modele de sârmă de clădiri cu structuri detaliate de acoperiș. Clădirile 3D (LOD2) sunt utilizate pentru planificare și vizualizare și sunt disponibile pentru orașul interior și pentru zonele selectate din zonele exterioare."},{"@language":"sk-t-sv-t0-mtec","@value":"Drôtené modely budov s detailnými strešnými konštrukciami. 3D budovy (LOD2) sa používajú na plánovanie a vizualizácie a sú k dispozícii pre vnútorné mesto a pre vybrané oblasti vonkajších dosahov.Výšky pozemkov, budov a vegetácie sa určujú pomocou fotogrametrie a laserového skenovania."},{"@language":"sl-t-sv-t0-mtec","@value":"Žični modeli stavb s podrobnimi strešnimi konstrukcijami. 3D stavbe (LOD2) se uporabljajo za načrtovanje in vizualizacijo ter so na voljo za notranje mesto in za izbrana območja zunanjih območij.Višine zemljišč, stavb in vegetacije se določajo s fotogrametrijo in laserskim skeniranjem."},{"@language":"sv","@value":"Trådmodeller av byggnader med detaljerade takkonstruktioner. 3D-byggnader (LOD2) används för planering och visualiseringar och finns för innerstaden och för utvalda områden i ytterstadenHöjderna på mark, byggnader och vegetation bestäms med hjälp av fotogrammetri och laserskanning."},{"@language":"uk-t-sv-t0-mtec","@value":"Провідні моделі будівель з деталізованими покрівельними конструкціями. 3D-будівлі (LOD2) використовуються для планування та візуалізації і доступні для внутрішнього міста та для окремих ділянок зовнішньої течії.Висоти землі, будівель та рослинності визначаються за допомогою фотограмметрії та лазерного сканування."}],"dct:format":"text/html","dct:identifier":"33d715bc-4603-4a14-b941-aaa3eb715894","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:3531d7e484a118fbc8683b02fb7bcb529c5e25828297641bb965d59d277cab5e_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Сгради SBK 3D (LOD2) (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK 3D budovy (LOD2) (interní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK 3D-bygninger (LOD2) (intern SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK 3D Gebäude (LOD2) (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"Κτίρια SBK 3D (LOD2) (εσωτερικά SBK)"},{"@language":"en-t-sv-t0-