02,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:fc2affa7d5edcbdbbea3707073bfb8cb4c6e7a67f7b1f4179c9a7ba919c7934f_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"165b37a1a796d44fbb14c73a154848c5d5"},{"@id":"http://data.europa.eu/88u/dataset/9a7ec133-14ae-4398-b1e2-7a23c4b769aa","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/25b88565-e6c4-4ac7-84a8-5333f84e5bfc"},{"@id":"http://data.europa.eu/88u/distribution/7f7f501a-0d28-4d00-919f-6e7729ac267d"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=a7b641e1-1310-4ca6-9b32-87b9482262db"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта на града - Градските части се състоят от следните подтипове (подтипове) в информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Карта на града) :450180, Градска част Подтипове10, Градска част, модифицирана, активна."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa města - Části města se skládaly z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa města) :450180, Část města Podtypy10, Část města, modifikovatelná, aktivní."},{"@language":"da-t-sv-t0-mtec","@value":"Bykort — Bydele bestod af følgende undertyper (undertyper) i klassificeringen af oplysninger for 2020 (for den nuværende liste henvises til den generelle varespecifikation Bykort):450180, Bydel Undertype10, Bydel, modificerbar, aktiv."},{"@language":"de-t-sv-t0-mtec","@value":"Stadtplan - Stadtteile bestanden aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Stadtplan) :450180, Stadtteil Untertypen10, Stadtteil, veränderbar, aktiv."},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης πόλης - Τα τμήματα πόλης αποτελούνταν από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης πόλης): 450180, Υποτύποι μερών πόλης10, Τμήμα πόλης, τροποποιήσιμο, ενεργό."},{"@language":"en-t-sv-t0-mtec","@value":"City map - City parts consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification City map) :450180, City part Subtypes10, City part, modifiable, active."},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de la ciudad - Las partes de la ciudad consistieron en los siguientes subtipos (subtipos) en la clasificación de la información 2020 (para la lista actual, véase la especificación general del producto Mapa de la ciudad): 450180, Subtipos de la parte de la ciudad10, Parte de la ciudad, modificable, activa."},{"@language":"et-t-sv-t0-mtec","@value":"Linnakaart – linnaosad koosnesid 2020. aasta teabeliigituses järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldine tootespetsifikaat „Linnakaart“): 450180, linnaosa alatüübid 10, linnaosa, muudetav, aktiivne."},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupungin kartta - Kaupunginosat koostuivat seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleistä tuote-eritelmästä Kaupungin kartta) :450180, Kaupunginosan alatyypit10, Kaupunginosa, muokattavissa, aktiivinen."},{"@language":"fr-t-sv-t0-mtec","@value":"Carte de la ville - Les parties de la ville se composaient des sous-types suivants (sous-types) à la classification d'information 2020 (pour la liste actuelle, voir la spécification générale du produit Carte de la ville) :450180, Partie de la ville Sous-types10, Partie de la ville, modifiable, actif."},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil chathrach - Is éard a bhí i gcodanna cathrach na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach Sonraíocht táirge Ginearálta Léarscáil chathrach) :450180, Cuid chathrach Fochineálacha10, Cuid chathrach, inmhodhnaithe, gníomhach."},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada – Dijelovi grada sastojali su se od sljedećih podtipova (podtipova) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Karta grada): 450180, Podtipovi dijela grada10, Dio grada, promjenjiv, aktivan."},{"@language":"hu-t-sv-t0-mtec","@value":"Várostérkép - A városrészek a következő altípusokból (altípusokból) álltak a 2020. évi információs osztályozásban (az aktuális listát lásd az Általános termékleírásban Várostérkép) :450180, Városrész altípusok10, Városrész, módosítható, aktív."},{"@language":"it-t-sv-t0-mtec","@value":"Mappa della città - Le parti della città erano costituite dai seguenti sottotipi (sottotipi) nella classificazione delle informazioni 2020 (per l'elenco corrente vedere Specifiche generali del prodotto Mappa della città): 450180, Sottotipi della parte della città10, Parte della città, modificabile, attiva."},{"@language":"lt-t-sv-t0-mtec","@value":"Miesto žemėlapis. Miesto dalys pagal 2020 m. informacijos klasifikaciją (dabartinį sąrašą žr. Bendroji produkto specifikacija. Miesto žemėlapis) buvo sudarytos iš šių potipių (potipių):450180, Miesto dalies 10 potipiai, Miesto dalis, modifikuojama, aktyvi."},{"@language":"lv-t-sv-t0-mtec","@value":"Pilsētas karte — pilsētas daļas sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu skatīt vispārējā produkta specifikācijā “Pilsētas karte”): 450180, pilsētas daļas apakštipi10, pilsētas daļa, modificējama, aktīva."},{"@language":"mt-t-sv-t0-mtec","@value":"- City Parts kienu jikkonsistu mis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-Ispeċifikazzjoni Ġenerali tal-Prodott City map) :450180, City part Subtypes10, City part, modifikabbli, attiva."},{"@language":"nl-t-sv-t0-mtec","@value":"Stadskaart - Stadsdelen bestonden uit de volgende subtypen (subtypen) bij de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Stadskaart):450180, Stadsdeel Subtypen10, Stadsdeel, aanpasbaar, actief."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa miasta - części miasta składały się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualna lista znajduje się w ogólnej specyfikacji produktu Mapa miasta) :450180, część miasta Podtypy10, część miasta, modyfikowalna, aktywna."},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa da cidade — As partes da cidade consistiam nos seguintes subtipos (subtipos) na classificação da informação de 2020 (para a lista atual, ver especificação geral do produto Mapa da cidade):450180, Parte da cidade Subtipos10, Parte da cidade, modificável, ativa."},{"@language":"ro-t-sv-t0-mtec","@value":"Harta orașului - Părțile orașului au constat în următoarele subtipuri (subtipuri) la clasificarea informațiilor din 2020 (pentru lista actuală, a se vedea caietul de sarcini general al produsului Harta orașului): 450180, Partea orașului Subtipuri10, Partea orașului, modificabilă, activă."},{"@language":"sk-t-sv-t0-mtec","@value":"Mestská mapa - Mestské časti pozostávali z nasledujúcich podtypov (podtypov) v informačnej klasifikácii 2020 (pre aktuálny zoznam pozri všeobecnú špecifikáciu výrobku Mestská mapa) :450180, Mestská časť Podtypy10, Mestská časť, modifikovateľná, aktívna."},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid mesta - Mestni deli so bili sestavljeni iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Splošno specifikacijo proizvoda Zemljevid mesta) :450180, Podtipi mestnega dela10, Mestni del, spremenljiv, aktiven."},{"@language":"sv","@value":"Stadskarta - Stadsdelar bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :450180, StadsdelUndertyper10, Stadsdel, modifierbar, aktiv."},{"@language":"uk-t-sv-t0-mtec","@value":"Карта міста - Частини міста складалися з наступних підтипів (підтипів) при інформаційній класифікації 2020 (за поточним списком див."}],"dct:format":"text/html","dct:identifier":"9a7ec133-14ae-4398-b1e2-7a23c4b769aa","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:fc2affa7d5edcbdbbea3707073bfb8cb4c6e7a67f7b1f4179c9a7ba919c7934f_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK картата на града - картата на града"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Mapa města - Mapa města"},{"@language":"da-t-sv-t0-mtec","@value":"SBK By kort - By kort"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stadtplan - Stadtplan"},{"@language":"el-t-sv-t0-mtec","@value":"SBK χάρτης της πόλης - χάρτης της πόλης"},{"@language":"en-t-sv-t0-mtec","@value":"SBK City map - City map"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa de la ciudad - Mapa de la ciudad"},{"@language":"et-t-sv-t0-mtec","@value":"SBK linna kaart - linna kaart"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Kaupungin kartta - Kaupungin kartta"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Plan de la ville - Plan de la ville"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil na Cathrach SBK - Léarscáil na Cathrach"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Karta grada - Karta grada"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Várostérkép - Várostérkép"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa della città - Mappa della città"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Miesto žemėlapis - Miesto žemėlapis"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Pilsētas karte - Pilsētas karte"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Mappa tal-Belt - Mappa tal-Belt"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Stadsplattegrond - Stadsplattegrond"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Mapa miasta - Mapa miasta"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Mapa da cidade - Mapa da cidade"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Harta orașului - Harta orașului"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK City mapa - Mapa mesta"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Zemljevid mesta - Zemljevid mesta"},{"@language":"sv","@value":"SBK Stadskarta - Stadsdelar"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК карта міста - Карта міста"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/25b88565-e6c4-4ac7-84a8-5333f84e5bfc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Stadsdelar.zip"},"dct:description":["Stadsdelsgränser är fastställda av Lantmäteriet och har sin gränslinje ofta i mitten av gatan eller i vatten. De kan inte ändras utan att konsultera LM men är inte juridiska. Själva de administrativa besluten kring småjusteringarna fattas av stadsbyggnadsnämnden efter behandling av dess namnberedning.Stadsdelsnämndsgränser ligger oftast på ena eller andra sidan av en gata pga. juridiken där det är viktigt att veta vilken nämnd som ansvarar för hela gatan. Här vill man inte dela & göra det otydligt mellan nämnderna.",{"@language":"bg-t-sv-t0-mtec","@value":"Границите на окръга се определят от Lantmäteriet и често имат гранична линия в средата на улицата или във вода. Те не могат да бъдат променяни без консултация с LM, но не са законни. Действителните административни решения относно малки корекции се правят от Съвета за градско планиране след разглеждане на подготовката на името му.Границите на градския районен съвет обикновено се намират от едната или от другата страна на улицата поради закона, където е важно да се знае кой съвет е отговорен за цялата улица. Вие не искате да се разделят и да го направи неясно между дъските."},{"@language":"cs-t-sv-t0-mtec","@value":"Okresní hranice jsou stanoveny Lantmäteriet a mají svou hranici často uprostřed ulice nebo ve vodě. Nelze je změnit bez konzultace s LM, ale nejsou legální. Skutečná správní rozhodnutí týkající se malých úprav provádí rada pro územní plánování po zvážení její přípravy názvu.Hranice městské obvodní rady se obvykle nacházejí na jedné nebo druhé straně ulice z důvodu zákona, kde je důležité vědět, která rada je zodpovědná za celou ulici. Nechcete se dělit a dělat to nejasné mezi deskami."},{"@language":"da-t-sv-t0-mtec","@value":"Distriktsgrænser er fastsat af Lantmäteriet og har deres grænselinje ofte midt på gaden eller i vand. De kan ikke ændres uden at konsultere LM, men er ikke lovlige. De faktiske administrative beslutninger vedrørende små justeringer foretages af byplanlægningsrådet efter overvejelse af dets navnforberedelse.Bydistriktets grænser er normalt placeret på den ene eller den anden side af en gade på grund af loven, hvor det er vigtigt at vide, hvilken bestyrelse der er ansvarlig for hele gaden. Du ønsker ikke at dele og gøre det uklart mellem bestyrelserne."},{"@language":"de-t-sv-t0-mtec","@value":"Bezirksgrenzen werden von Lantmäteriet festgelegt und haben ihre Grenzlinie oft in der Mitte der Straße oder im Wasser. Sie können nicht ohne Rücksprache mit LM geändert werden, sind aber nicht legal. Die eigentlichen Verwaltungsentscheidungen in Bezug auf kleine Anpassungen werden vom Stadtplanungsausschuss nach Berücksichtigung seiner Namensvorbereitung getroffen.Die Stadtbezirksgrenzen befinden sich aufgrund des Gesetzes in der Regel auf der einen oder anderen Seite einer Straße, wo es wichtig ist zu wissen, welcher Vorstand für die gesamte Straße verantwortlich ist. Sie wollen sich nicht aufteilen und es zwischen den Boards unklar machen."},{"@language":"el-t-sv-t0-mtec","@value":"Τα όρια της περιοχής καθορίζονται από το Lantmäteriet και έχουν τη συνοριακή γραμμή τους συχνά στη μέση του δρόμου ή στο νερό. Δεν μπορούν να αλλάξουν χωρίς διαβούλευση με την LM, αλλά δεν είναι νόμιμες. Οι πραγματικές διοικητικές αποφάσεις σχετικά με μικρές προσαρμογές γίνονται από το πολεοδομικό συμβούλιο μετά από εξέταση της προετοιμασίας του ονόματος.Τα όρια του δημοτικού συμβουλίου βρίσκονται συνήθως στη μία ή την άλλη πλευρά ενός δρόμου λόγω του νόμου όπου είναι σημαντικό να γνωρίζουμε ποιο συμβούλιο είναι υπεύθυνο για ολόκληρο το δρόμο. Δεν θέλετε να χωρίσετε και να το κάνετε ασαφές μεταξύ των διοικητικών συμβουλίων."},{"@language":"en-t-sv-t0-mtec","@value":"District boundaries are set by Lantmäteriet and have their boundary line often in the middle of the street or in water. They cannot be changed without consulting LM but are not legal. The actual administrative decisions regarding small adjustments are made by the City Planning Board after consideration of its name preparation.City district board boundaries are usually located on one or the other side of a street due to the law where it is important to know which board is responsible for the entire street. You don't want to split and make it unclear between the boards."},{"@language":"es-t-sv-t0-mtec","@value":"Los límites del distrito son establecidos por Lantmäteriet y tienen su límite a menudo en el medio de la calle o en el agua. No se pueden cambiar sin consultar a LM, pero no son legales. Las decisiones administrativas reales con respecto a pequeños ajustes son hechas por la Junta de Planificación de la Ciudad después de considerar la preparación de su nombre.Los límites de la junta de distrito de la ciudad generalmente se encuentran en uno u otro lado de una calle debido a la ley donde es importante saber qué junta es responsable de toda la calle. Usted no quiere dividir y hacer que no esté claro entre los tableros."},{"@language":"et-t-sv-t0-mtec","@value":"Piirkonna piirid määrab Lantmäteriet ja nende piirjoon on sageli keset tänavat või vees. Neid ei saa muuta ilma LM-iga konsulteerimata, kuid need ei ole seaduslikud. Tegelikud haldusotsused väikeste kohanduste kohta teeb linnaplaneerimisamet pärast oma nime ettevalmistamise kaalumist.Linnapiirkonna juhatuse piirid asuvad tavaliselt ühel või teisel pool tänavat tulenevalt seadusest, kus on oluline teada, milline juhatus vastutab kogu tänava eest. Sa ei taha jagada ja teha seda juhatuse vahel ebaselgeks."},{"@language":"fi-t-sv-t0-mtec","@value":"Aluerajat ovat Lantmäterietin asettamia ja niiden rajaviivat ovat usein keskellä katua tai vedessä. Niitä ei voi muuttaa ilman LM: n kuulemista, mutta ne eivät ole laillisia. Varsinaiset pieniä muutoksia koskevat hallinnolliset päätökset tekee kaupungin kaavoituslautakunta nimenvalmistelun jälkeen.Kaupunkihallituksen rajat sijaitsevat yleensä kadun toisella puolella lain vuoksi, jolloin on tärkeää tietää, mikä lautakunta on vastuussa koko kadusta. Et halua jakaa ja tehdä siitä epäselvää taulujen välillä."},{"@language":"fr-t-sv-t0-mtec","@value":"Les limites du district sont fixées par Lantmäteriet et ont leur ligne de démarcation souvent au milieu de la rue ou dans l'eau. Ils ne peuvent pas être modifiés sans consulter LM mais ne sont pas légaux. Les décisions administratives concernant les petits ajustements sont prises par le conseil d'urbanisme après examen de la préparation de son nom.Les limites du conseil de district de la ville sont généralement situées de l'un ou l'autre côté d'une rue en raison de la loi où il est important de savoir quel conseil est responsable de l'ensemble de la rue. Vous ne voulez pas vous séparer et faire en sorte qu'il ne soit pas clair entre les conseils d'administration."},{"@language":"ga-t-sv-t0-mtec","@value":"Lantmäteriet a shocraíonn teorainneacha ceantair agus is minic a bhíonn a líne teorann i lár na sráide nó in uisce. Ní féidir iad a athrú gan dul i gcomhairle le LM ach níl siad dlíthiúil. Is é an Bord Pleanála Cathrach a dhéanann na cinntí riaracháin iarbhír maidir le coigeartuithe beaga tar éis dó a ainm a bhreithniú.Is gnách go mbíonn teorainneacha boird ceantair cathrach suite ar thaobh amháin nó ar an taobh eile de shráid mar gheall ar an dlí ina bhfuil sé tábhachtach go mbeadh a fhios cén bord atá freagrach as an tsráid ar fad. Níl tú ag iarraidh a roinnt agus é a dhéanamh soiléir idir na boird."},{"@language":"hr-t-sv-t0-mtec","@value":"Granice okruga postavljaju Lantmäteriet i imaju svoju graničnu liniju često u sredini ulice ili u vodi. Ne mogu se mijenjati bez savjetovanja s LM-om, ali nisu zakonite. Stvarne administrativne odluke o malim prilagodbama donosi Gradski odbor za planiranje nakon razmatranja pripreme naziva.Gradske granice okružnog odbora obično se nalaze na jednoj ili drugoj strani ulice zbog zakona u kojem je važno znati koja je uprava odgovorna za cijelu ulicu. Ne želite se razdvojiti i učiniti ga nejasnim među odborima."},{"@language":"hu-t-sv-t0-mtec","@value":"A kerületi határokat Lantmäteriet határozza meg, és határvonaluk gyakran az utca közepén vagy a vízben van. Ezek nem módosíthatók LM megkérdezése nélkül, de nem jogszerűek. A kis kiigazításokra vonatkozó tényleges adminisztratív döntéseket a Városi Tervezési Testület hozza meg a név előkészítésének mérlegelése után.A városi kerületi testület határai általában az utca egyik vagy másik oldalán helyezkednek el a törvény miatt, ahol fontos tudni, hogy melyik testület felelős az egész utcáért. Nem akarsz szétválni és tisztázni a táblák között."},{"@language":"it-t-sv-t0-mtec","@value":"I confini distrettuali sono stabiliti da Lantmäteriet e hanno la loro linea di confine spesso in mezzo alla strada o in acqua. Non possono essere cambiati senza consultare LM ma non sono legali. Le decisioni amministrative effettive per quanto riguarda piccoli aggiustamenti sono fatte dal Consiglio di pianificazione della città dopo aver preso in considerazione la sua preparazione del nome.I confini del consiglio distrettuale della città si trovano di solito su un lato o sull'altro di una strada a causa della legge in cui è importante sapere quale consiglio è responsabile per l'intera strada. Non si vuole dividere e rendere poco chiaro tra le schede."},{"@language":"lt-t-sv-t0-mtec","@value":"Rajono ribas nustato Lantmäteriet ir jų ribos dažnai yra gatvės viduryje arba vandenyje. Jie negali būti keičiami nepasitarus su LM, bet nėra teisėti. Faktinius administracinius sprendimus dėl nedidelių koregavimų atlieka Miesto planavimo valdyba, apsvarsčiusi savo pavadinimo paruošimą.Miesto rajono valdybos ribos paprastai yra vienoje ar kitoje gatvės pusėje dėl įstatymo, kai svarbu žinoti, kuri valdyba yra atsakinga už visą gatvę. Jūs nenorite suskaidyti ir padaryti neaišku tarp lentų."},{"@language":"lv-t-sv-t0-mtec","@value":"Apgabala robežas nosaka Lantmäteriet, un to robežlīnija bieži atrodas ielas vidū vai ūdenī. Tos nevar mainīt, neapspriežoties ar LM, bet tie nav likumīgi. Faktiskos administratīvos lēmumus par nelielām korekcijām pieņem Pilsētas plānošanas pārvalde pēc tam, kad ir apsvērta tās nosaukuma sagatavošana.Pilsētas rajona valdes robežas parasti atrodas vienā vai otrā ielas pusē, pateicoties likumam, kurā ir svarīgi zināt, kura valde ir atbildīga par visu ielu. Jūs nevēlaties sadalīt un padarīt to neskaidru starp dēļiem."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-konfini distrettwali huma stabbiliti minn Lantmäteriet u għandhom il-linja tal-konfini tagħhom spiss fin-nofs tat-triq jew fl-ilma. Ma jistgħux jinbidlu mingħajr ma jiġi kkonsultat LM iżda mhumiex legali. Id-deċiżjonijiet amministrattivi attwali dwar aġġustamenti żgħar isiru mill-Bord tal-Ippjanar tal-Belt wara kunsiderazzjoni tal-preparazzjoni tal-isem tiegħu.Il-konfini tal-bord tad-distrett tal-Belt normalment jinsabu fuq naħa waħda jew l-oħra ta 'triq minħabba l-liġi fejn huwa importanti li tkun taf liema bord huwa responsabbli għat-triq kollha. Ma tridx taqsam u tagħmilha mhux ċara bejn il-bordijiet."},{"@language":"nl-t-sv-t0-mtec","@value":"Districtsgrenzen worden bepaald door Lantmäteriet en hebben hun grenslijn vaak in het midden van de straat of in het water. Ze kunnen niet worden gewijzigd zonder LM te raadplegen, maar zijn niet legaal. De feitelijke administratieve beslissingen met betrekking tot kleine aanpassingen worden genomen door het stadsplanningsbestuur na overweging van de naamvoorbereiding.De grenzen van het stadsdistrictsbestuur bevinden zich meestal aan de ene of de andere kant van een straat vanwege de wet waarbij het belangrijk is om te weten welk bestuur verantwoordelijk is voor de hele straat. Je wilt niet splitsen en het onduidelijk maken tussen de borden."},{"@language":"pl-t-sv-t0-mtec","@value":"Granice dzielnic są wyznaczane przez Lantmäteriet i mają swoją linię graniczną często na środku ulicy lub w wodzie. Nie można ich zmienić bez konsultacji z LM, ale nie są one legalne. Rzeczywiste decyzje administracyjne dotyczące drobnych korekt są podejmowane przez Zarząd Planowania Miasta po rozważeniu jego przygotowania nazwy.Granice zarządu dzielnicy miasta są zwykle zlokalizowane po jednej lub drugiej stronie ulicy ze względu na prawo, w którym ważne jest, aby wiedzieć, która rada jest odpowiedzialna za całą ulicę. Nie chcesz się dzielić i sprawiać, że będzie to niejasne między planszami."},{"@language":"pt-t-sv-t0-mtec","@value":"Os limites distritais são definidos por Lantmäteriet e têm sua linha de fronteira muitas vezes no meio da rua ou na água. Não podem ser alterados sem consultar a LM, mas não são legais. As decisões administrativas reais relativas a pequenos ajustes são feitas pelo Conselho de Planejamento da Cidade após a consideração de sua preparação do nome.Os limites do conselho distrital da cidade geralmente estão localizados em um ou outro lado de uma rua devido à lei onde é importante saber qual conselho é responsável por toda a rua. Não queres dividir-te e deixar claro entre as tábuas."},{"@language":"ro-t-sv-t0-mtec","@value":"Limitele districtului sunt stabilite de Lantmäteriet și au linia de demarcație adesea în mijlocul străzii sau în apă. Acestea nu pot fi modificate fără consultarea LM, dar nu sunt legale. Deciziile administrative efective privind ajustările mici sunt făcute de Consiliul de planificare urbană după luarea în considerare a pregătirii numelui său.Limitele consiliului districtual al orașului sunt de obicei situate pe una sau pe cealaltă parte a unei străzi din cauza legii în care este important să se știe care consiliu este responsabil pentru întreaga stradă. Nu vrei să separe și să facă neclar între plăci."},{"@language":"sk-t-sv-t0-mtec","@value":"Okresné hranice sú stanovené Lantmäteriet a majú svoju hraničnú líniu často uprostred ulice alebo vo vode. Nemôžu byť zmenené bez konzultácie s LM, ale nie sú legálne. Samotné administratívne rozhodnutia týkajúce sa malých úprav vykonáva Mestský úrad pre plánovanie po zvážení jeho prípravy názvu.Hranice obvodného úradu mesta sa zvyčajne nachádzajú na jednej alebo druhej strane ulice kvôli zákonu, kde je dôležité vedieť, ktorá rada je zodpovedná za celú ulicu. Nechcete sa rozdeľovať a robiť to nejasné medzi doskami."},{"@language":"sl-t-sv-t0-mtec","@value":"Okrajne meje določa Lantmäteriet in imajo svojo mejno črto pogosto sredi ulice ali v vodi. Ni jih mogoče spremeniti brez posvetovanja z LM, vendar niso zakonite. Dejanske upravne odločitve v zvezi z majhnimi prilagoditvami sprejme mestni odbor za načrtovanje po preučitvi njegove priprave imena.Meje mestnih okrožij se običajno nahajajo na eni ali drugi strani ulice zaradi zakona, kjer je pomembno vedeti, kateri odbor je odgovoren za celotno ulico. Ne želite, da se razdelijo in da je nejasno med odbori."},{"@language":"uk-t-sv-t0-mtec","@value":"Межі району встановлюються Lantmäteriet і мають свою межову лінію часто посеред вулиці або у воді. Вони не можуть бути змінені без консультацій LM, але не є законними. Фактичні адміністративні рішення щодо невеликих коригувань приймаються містобудівною радою після розгляду підготовки її назви.Межі районної ради міста, як правило, розташовані на тій чи іншій стороні вулиці відповідно до закону, де важливо знати, яка рада відповідає за всю вулицю. Ви не хочете, щоб розділити і зробити його незрозумілим між дошками."}],"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/9a7ec133-14ae-4398-b1e2-7a23c4b769aa#HTTP:Nedladdning:data/2","dct:title":["Stadsdelar (117 stycken) i Esri Shape-format",{"@language":"bg-t-sv-t0-mtec","@value":"Квартали (117 броя) във формат Esri Shape"},{"@language":"cs-t-sv-t0-mtec","@value":"Okresy (117 kusů) ve formátu Esri Shape"},{"@language":"da-t-sv-t0-mtec","@value":"Distrikter (117 stykker) i Esri Shape-format"},{"@language":"de-t-sv-t0-mtec","@value":"Distrikte (117 Stück) im Esri Shape Format"},{"@language":"el-t-sv-t0-mtec","@value":"Επαρχίες (117 τεμάχια) σε μορφή Esri Shape"},{"@language":"en-t-sv-t0-mtec","@value":"Districts (117 pieces) in Esri Shape format"},{"@language":"es-t-sv-t0-mtec","@value":"Distritos (117 piezas) en formato Esri Shape"},{"@language":"et-t-sv-t0-mtec","@value":"Piirkonnad (117 tükki) Esri kuju formaadis"},{"@language":"fi-t-sv-t0-mtec","@value":"Piirit (117 kpl) Esri Shape -muodossa"},{"@language":"fr-t-sv-t0-mtec","@value":"Districts (117 pièces) au format Esri Shape"},{"@language":"ga-t-sv-t0-mtec","@value":"Ceantair (117 píosaí) i bhformáid Cruth Esri"},{"@language":"hr-t-sv-t0-mtec","@value":"Distrikti (117 dijelova) u formatu Esri Shape"},{"@language":"hu-t-sv-t0-mtec","@value":"Körzetek (117 darab) Esri alakzatban"},{"@language":"it-t-sv-t0-mtec","@value":"Distretti (117 pezzi) in formato Esri Shape"},{"@language":"lt-t-sv-t0-mtec","@value":"Rajonai (117 vienetų) Esri formos formatu"},{"@language":"lv-t-sv-t0-mtec","@value":"Rajoni (117 gabali) Esri Shape formātā"},{"@language":"mt-t-sv-t0-mtec","@value":"Distretti (117-il biċċa) fil-format Esri Forma"},{"@language":"nl-t-sv-t0-mtec","@value":"Districten (117 stuks) in Esri Shape formaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Dzielnice (117 sztuk) w formacie Esri Shape"},{"@language":"pt-t-sv-t0-mtec","@value":"Distritos (117 peças) em formato Esri Shape"},{"@language":"ro-t-sv-t0-mtec","@value":"Districte (117 bucăți) în format Esri Formă"},{"@language":"sk-t-sv-t0-mtec","@value":"Okresy (117 kusov) vo formáte Esri Shape"},{"@language":"sl-t-sv-t0-mtec","@value":"Okrožja (117 kosov) v formatu Esri Shape"},{"@language":"uk-t-sv-t0-mtec","@value":"Райони (117 штук) у форматі Esri Shape"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/25b88565-e6c4-4ac7-84a8-5333f84e5bfc"}},{"@id":"http://data.europa.eu/88u/distribution/7f7f501a-0d28-4d00-919f-6e7729ac267d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=464514632_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/9a7ec133-14ae-4398-b1e2-7a23c4b769aa#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Stadskarta",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продукта Карта на града"},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktu Mapa města"},{"@