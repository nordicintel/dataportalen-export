dx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"13d358135044926d25c35d0278e85420bf"},{"@id":"http://data.europa.eu/88u/dataset/1a7e82e6-d505-41c4-9e8f-26d598c1e30f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/de71b626-d150-4bdb-b974-f942a945dbe6"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=9a44ea61-072a-4a54-a2f1-5cee44e52ff6"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Сградната геометрия се състои от следните обекти и подтипове (за текущия списък вижте Обща продуктова спецификация Базова карта): Жилищна сграда: 10, Многофамилни жилищни сгради; 20, Еднофамилна къща. Сграда на общността: 10, сграда на общината. Промишлена сграда: 10, Индустриална сграда; 20, Индустриална сграда Ospec. Сграда за обслужване: 10, трансформатор; 20, Водни кули; 30, навес за мобилни технологии; 50, телефонна кабина; 60, дъждовно покритие; 70, обществена тоалетна. Изграждане на социални функции: 10, Обща сграда; 30, сграда „Здравеопазване“; 60, спортна сграда. Неуточнена сграда: 10, сграда Ospec. Нерегистрирана; 20, сграда Ospec. Регистрирана. Бизнес сграда: 10, Търговска сграда; 20, Офис сграда; 30, паркомясто; 40, хотелска сграда; 50, операционна сграда Ospec. Други сгради: 10, Икономична сграда; 20, Допълваща сграда; 30, вилата на колонията."},{"@language":"cs-t-sv-t0-mtec","@value":"Geometrie budovy se skládá z následujících objektů a podtypů (aktuální seznam viz Základní mapa obecných specifikací): Obytná budova: 10, Vícebytové budovy; 20, rodinný dům. Budování společenství: 10, Ospec. komunitní budova. Průmyslová budova: 10, Průmyslová budova; 20, Ospec. průmyslová budova. Budova služeb: 10, transformátor; 20, Vodárenské věže; 30, Mobilní technologie přístřešek; 50, telefonní budka; 60, Dešťová pokrývka; 70, veřejné WC. Budování sociálních funkcí: 10, Obecná budova; 30, budova zdravotní péče; 60, Sportovní budova. Nespecifikovaná budova: 10, Ospec. budova neregistrovaná; 20, Ospec. budova Registrováno. Budova podniku: 10, Obchodní budova; 20, kancelářská budova; 30, parkovací garáž; 40, budova hotelu; 50, Ospec. provozní budova. Jiná budova: 10, Ekonomická budova; 20, Doplňková budova; 30, koloniální chalupa."},{"@language":"da-t-sv-t0-mtec","@value":"Bygningsgeometri består af følgende objekt- og undertyper (den aktuelle liste findes i basiskortet over generelle produktspecifikationer): Beboelsesejendom: 10, flerfamiliehuse 20, Enfamiliehus. Fællesskabsbygning: 10, Ospec. fællesskabsbygning. Industribygning: 10, Industribygning; 20, Ospec. industribygning. Servicebygning: 10, Transformer, 20, Vandtårne; 30, Mobile Technology Shed, 50, telefonboks; 60, Regnslag; 70, offentligt toilet. Opbygning af sociale funktioner: 10, Almindelig bygning; 30, Sundhedsbyggeri; 60, Idrætsbygningen. Uspecificeret bygning: 10, Ospec. bygning Uregistreret; 20, Ospec. bygning registreret. Virksomhedsopbygning: 10, Erhvervsbygning; 20, kontorbygning 30, Parkeringsplads; 40, Hotelbygning; 50, Ospec. driftsbygning. Anden bygning: 10, Økonomibygning; 20, Supplerende bygning; 30, Kolonihytte."},{"@language":"de-t-sv-t0-mtec","@value":"Die Gebäudegeometrie besteht aus folgenden Objekten und Untertypen (für die aktuelle Liste siehe Allgemeine Produktspezifikations-Basiskarte): Wohngebäude: 10, Mehrfamilienhäuser; 20, Einfamilienhaus. Gemeinschaftsgebäude: 10, Ospec. Gemeindegebäude. Industriegebäude: 10, Industriegebäude; 20, Ospec. Industriegebäude. Dienstleistungsgebäude: 10, Transformator; 20, Wassertürme; 30, mobiler Technologieschuppen; 50, Telefonzelle; 60, Regenabdeckung; 70, Öffentliche Toilette. Aufbau sozialer Funktionen: 10, Allgemeines Gebäude; 30, Gebäude des Gesundheitswesens; 60, Sportgebäude. Nicht näher bezeichnetes Gebäude: 10, Ospec. Gebäude Nicht registriert; 20, Ospec. Gebäude Eingetragen. Geschäftsgebäude: 10, Handelsgebäude; 20, Bürogebäude; 30, Parkgarage; 40, Hotelgebäude; 50, Ospec. Betriebsgebäude. Sonstiges Gebäude: 10, Wirtschaftsgebäude; 20, Ergänzendes Gebäude; 30, Colony Hütte."},{"@language":"el-t-sv-t0-mtec","@value":"Η γεωμετρία κτιρίου αποτελείται από το ακόλουθο αντικείμενο και τους ακόλουθους υποτύπους (για τον τρέχοντα κατάλογο βλέπε χάρτη βάσης γενικών προδιαγραφών προϊόντος): Κτίριο κατοικιών: 10, πολυκατοικίες· 20, Μονοκατοικία. Κοινοτικό κτίριο: 10, Ospec. κοινοτικό κτίριο. Βιομηχανικό κτίριο: 10, Βιομηχανικό κτίριο· 20, Ospec. βιομηχανικό κτίριο. Κτίριο υπηρεσιών: 10, μετασχηματιστής· 20, Πύργοι νερού· 30, κινητό υπόστεγο τεχνολογίας 50, τηλεφωνικός θάλαμος· 60, κάλυψη βροχής 70, Δημόσια τουαλέτα. Δημιουργία κοινωνικών λειτουργιών: 10, Γενικό κτίριο· 30, Κτίριο υγειονομικής περίθαλψης· 60, Αθλητικό κτίριο. Απροσδιόριστο κτίριο: 10, κτίριο Ospec. Μη καταχωρισμένο· 20, κτίριο Ospec. Εγγεγραμμένο. Κτίριο επιχειρήσεων: 10, Εμπορικό κτίριο· 20, κτίριο γραφείων· 30, Χώρος στάθμευσης· 40, κτίριο ξενοδοχείου· 50, κτίριο επιχειρήσεων Ospec. Άλλα κτίρια: 10, Οικονομία· 20, Συμπληρωματικό κτίριο· 30, εξοχική αποικία."},{"@language":"en-t-sv-t0-mtec","@value":"Building geometry consists of the following object and subtypes (for the current list see General Product Specification Base Map): Residential building: 10, Multi-dwelling buildings; 20, Single-family house. Community building: 10, Ospec. community building. Industrial building: 10, Industrial building; 20, Ospec. industrial building. Service building: 10, Transformer; 20, Water towers; 30, Mobile Technology Shed; 50, Telephone booth; 60, Rain cover; 70, Public toilet. Social function building: 10, General building; 30, Health care building; 60, Sports building. Unspecified building: 10, Ospec. building Unregistered; 20, Ospec. building Registered. Business building: 10, Commercial building; 20, Office building; 30, Parking garage; 40, Hotel building; 50, Ospec. operational building. Other building: 10, Economy building; 20, Complementary building; 30, Colony cottage."},{"@language":"es-t-sv-t0-mtec","@value":"La geometría del edificio consta de los siguientes objetos y subtipos (para consultar la lista actual, véase el mapa base de las especificaciones generales del producto): Edificio residencial: 10, Edificios de viviendas múltiples; 20, Casa unifamiliar. Edificio de la comunidad: 10, Ospec. edificio de la comunidad. Nave industrial: 10, Edificio industrial; 20, Ospec. edificio industrial. Edificio de servicios: 10, transformador; 20, torres de agua; 30, Cobertizo de tecnología móvil; 50, cabina telefónica; 60, Cubierta de lluvia; 70, baño público. Construcción de la función social: 10, edificio general; 30, Edificio de atención sanitaria; 60, Edificio deportivo. Edificio no especificado: 10, edificio Ospec. No registrado; 20, Ospec. edificio registrado. Creación de empresas: 10, Edificio comercial; 20, edificio de oficinas; 30, Garaje de estacionamiento; 40, edificio del hotel; 50, edificio operativo Ospec. Otro edificio: 10, Edificio económico; 20, Edificio complementario; 30, cabaña de la colonia."},{"@language":"et-t-sv-t0-mtec","@value":"Ehitusgeomeetria koosneb järgmistest objektidest ja alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaart): Elamuehitus: 10, korterelamud; 20, ühepereelamu. Kogukonna ülesehitamine: 10, Ospec. kogukonna hoone. Tööstushoone: 10, tööstushoone; 20, Ospeci tööstushoone. Teenindushoone: 10, trafo; 20, veetornid; 30, mobiilsidetehnoloogia varjupaik; 50, telefonikabiinis; 60, vihmakate; 70, avalik tualett. Sotsiaalse funktsiooni loomine: 10, üldhoone; 30, tervishoiuhoone; 60, spordihoone. Täpsustamata hoone: 10, Ospec. hoone Registreerimata; 20, Ospec. hoone Registreeritud. Ettevõtluse arendamine: 10, ärihoone; 20, büroohoone; 30, parkimismaja; 40, hotellihoone; 50, Ospeci operatiivhoone. Muu hoone: 10, Majandushoone; 20, täiendav hoone; 30, koloonia suvila."},{"@language":"fi-t-sv-t0-mtec","@value":"Rakennuksen geometria koostuu seuraavista kohteista ja alatyypeistä (nykyisestä luettelosta katso yleinen tuote-eritelmän peruskartta): Asuinrakennus: 10, Moniasuntoiset rakennukset; 20, omakotitalo. Yhteisön rakentaminen: 10, Ospec. yhteisön rakentaminen. Teollisuusrakennus: 10, Teollisuusrakennus; 20, Ospec. teollisuusrakennus. Palvelurakennus: 10, muuntaja; 20, Vesitornit; 30, mobiiliteknologiavaja; 50, puhelinkoppi; 60, Sadesuoja; 70, julkinen wc. Sosiaalisen toiminnan kehittäminen: 10, yleinen rakennus; 30, Terveydenhuollon rakentaminen; 60, Urheilutalo. Määrittelemätön rakennus: 10, Ospec.-rakennus rekisteröimätön; 20, Ospec. rakennus Rekisteröity. Liiketoiminnan kehittäminen: 10, liikerakennus; 20, toimistorakennus; 30, Pysäköintihalli; 40, hotellirakennus; 50, Ospec. operatiivinen rakennus. Muu rakennus: 10, Talouden rakentaminen; 20, Täydentävä rakennus; 30, siirtokuntamökki."},{"@language":"fr-t-sv-t0-mtec","@value":"La géométrie du bâtiment se compose des objets et sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): Bâtiment résidentiel: 10, immeubles à logements multiples; 20, Maison unifamiliale. Renforcement de la communauté: 10, Ospec. construction communautaire. Bâtiment industriel: 10, Bâtiment industriel; 20, Ospec. bâtiment industriel. Bâtiment de services: 10, Transformateur; 20, Tours d'eau; 30, remise de technologie mobile; 50, cabine téléphonique; 60, couverture de pluie; 70, Toilettes publiques. Bâtiment de la fonction sociale: 10, Bâtiment général; 30, Bâtiment des soins de santé; 60, Bâtiment des sports. Bâtiment non spécifié: 10, bâtiment Ospec. non enregistré; 20, Ospec. bâtiment Enregistré. Bâtiment d'entreprise: 10, Bâtiment commercial; 20, Immeuble de bureaux; 30, Garage de stationnement; 40, Bâtiment de l'hôtel; 50, Ospec. bâtiment opérationnel. Autre bâtiment: 10, Bâtiment économique; 20, bâtiment complémentaire; 30, maison coloniale."},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard atá sa gheoiméadracht tógála an réad agus na fochineálacha seo a leanas (le haghaidh an liosta reatha féach Bunléarscáil Sonraíochta Táirge Ginearálta): Foirgneamh cónaithe: 10, Foirgnimh ilteaghaise; 20, Teach teaghlaigh aonair. Foirgneamh pobail: 10, Foirgneamh pobail Ospec. Foirgneamh tionsclaíoch: 10, Foirgneamh tionsclaíoch; 20, Foirgneamh tionscail Ospec. Foirgneamh seirbhíse: 10, Trasfhoirmeoir; 20, túir uisce; 30, Seid Teicneolaíochta Soghluaiste; 50, both teileafóin; 60, Clúdach báistí; 70, Leithris phoiblí. Feidhm shóisialta a thógáil: 10, Foirgneamh ginearálta; 30, Foirgneamh cúraim sláinte; 60, Foirgneamh spóirt. Foirgneamh neamhshonraithe: 10, Foirgneamh Ospec. Neamhchláraithe; 20, Foirgneamh Ospec. Cláraithe. Foirgneamh gnó: 10, Foirgneamh tráchtála; 20, Foirgneamh oifige; 30, Garáiste páirceála; 40, Foirgneamh óstáin; 50, Foirgneamh oibríochtúil Ospec. Foirgneamh eile: 10, Geilleagar a thógáil; 20, Foirgneamh comhlántach; 30, Teachín Coilíneachta."},{"@language":"hr-t-sv-t0-mtec","@value":"Geometrija zgrade sastoji se od sljedećih objekata i podvrsta (za trenutačni popis vidjeti Osnovnu kartu opće specifikacije proizvoda): Stambena zgrada: 10, višestambene zgrade; 20, obiteljska kuća. Izgradnja zajednice: 10, Ospec. zgrada zajednice. Industrijska zgrada: 10, Industrijska zgrada; 20, Spec. industrijska zgrada. Servisna zgrada: 10, transformator; 20, Vodeni tornjevi; 30, Mobitel Technology Shed; 50, telefonska kabina; 60, kišni pokrov; 70, javni toalet. Izgradnja društvenih funkcija: 10, Opća zgrada; 30, zgrada zdravstvene zaštite; 60, sportska zgrada. Neodređena zgrada: 10, Spec. zgrada neregistrirana; 20, Ospec. zgrada registrirana. Poslovna zgrada: 10, Poslovna zgrada; 20, Uredska zgrada; 30, garaža za parkiranje; 40, Hotelska zgrada; 50, Spec. operativna zgrada. Ostali objekti: 10, Gospodarska zgrada; 20, Dopunska zgrada; 30, Kolonija vikendica."},{"@language":"hu-t-sv-t0-mtec","@value":"Az épületgeometria a következő objektumokból és altípusokból áll (az aktuális listát lásd az Általános termékspecifikációs alaptérképen): Lakóépület: 10, többlakásos épületek; 20, Családi ház. Közösségi épület: 10, Ospec. közösségépítés. Ipari épület: 10, Ipari épület; 20, Ospec. ipari épület. Szolgáltatási épület: 10, transzformátor; 20, Víztornyok; 30, mobil technológiai fészer; 50, telefonfülke; 60, Esőtakaró; 70, nyilvános vécé. Szociális funkcióépítés: 10, Általános épület; 30, Egészségügyi épület; 60, Sport épület. Meg nem határozott épület: 10, Ospec. épület Nem regisztrált; 20, Ospec. épület Regisztrált. Üzleti épület: 10, Kereskedelmi épület; 20, Irodaház; 30, parkolóház; 40, Szállodaépület; 50, Ospec. operatív épület. Egyéb épület: 10, Gazdasági épület; 20, kiegészítő épület; 30, Kolóniai ház."},{"@language":"it-t-sv-t0-mtec","@value":"La geometria dell'edificio è costituita dai seguenti oggetti e sottotipi (per l'elenco corrente vedere General Product Specification Base Map): Edificio residenziale: 10, Edifici pluriabitativi; 20, Casa unifamiliare. Edilizia comunitaria: 10, costruzione della comunita' di Ospec. Edilizia industriale: 10, Edificio industriale; 20, Ospec. edificio industriale. Edificio di servizio: 10, trasformatore; 20, torri dell'acqua; 30, capannone mobile di tecnologia; 50, cabina telefonica; 60, copertura antipioggia; 70, toilette pubblica. Costruzione di funzioni sociali: 10, Edificio generale; 30, Edificio sanitario; 60, edificio sportivo. Edificio non specificato: 10, edificio Ospec. Non registrato; 20, edificio Ospec. Registrato. Costruzione di imprese: 10, edificio commerciale; 20, edificio per uffici; 30, Parcheggio garage; 40, edificio dell'hotel; 50, edificio operativo dell'Ospec. Altro edificio: 10, edificio per l'economia; 20, edificio complementare; 30, cottage della colonia."},{"@language":"lt-t-sv-t0-mtec","@value":"Pastato geometrija susideda iš šių objektų ir potipių (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): Gyvenamasis pastatas: 10, daugiabučiai pastatai; 20, Vienos šeimos namas. Bendruomenės pastatas: 10, spec. bendruomenės pastatas. Pramoninis pastatas: 10, Pramoninis pastatas; 20, Ospec. pramoninis pastatas. Paslaugų pastatas: 10, transformatorius; 20, Vandens bokštai; 30, Mobiliųjų technologijų pastogė; 50, telefono kabina; 60, Lietaus danga; 70, Viešasis tualetas. Socialinių funkcijų kūrimas: 10, Bendrasis pastatas; 30, Sveikatos priežiūros pastatas; 60, Sporto salė. Nepatikslintas pastatas: 10, Ospec. pastatas Neregistruotas; 20, Ospec. pastatas Registruotas. Verslo pastatas: 10, Komercinis pastatas; 20, biurų pastatas; 30, Automobilių stovėjimo aikštelė; 40, Viešbučio pastatas; 50, Ospec. veikiantis pastatas. Kiti pastatai: 10, „Ekonomikos kūrimas“; 20, Papildomas pastatas; 30, Kotedžas."},{"@language":"lv-t-sv-t0-mtec","@value":"Ēkas ģeometrija sastāv no šādiem objektiem un apakštipiem (pašreizējo sarakstu sk. Vispārējā produkta specifikācijas bāzes kartē): Dzīvojamā ēka: 10, daudzdzīvokļu ēkas; 20, vienģimenes māja. Kopienas veidošana: 10, Ospec. kopienas veidošana. Rūpniecības ēka: 10, Rūpniecības ēka; 20, Ospec. rūpniecības ēka. Pakalpojumu sniegšanas ēka: 10, transformators; 20, Ūdens torņi; 30, mobilo tehnoloģiju nojume; 50, Tālruņa kabīne; 60, lietus pārvalks; 70, Sabiedriskā tualete. Sociālo funkciju veidošana: 10, Vispārējā ēka; 30, Veselības aprūpes ēka; 60, Sporta ēka. Neprecizēta ēka: 10, Ospec. ēka nereģistrēta; 20, Ospec. ēka Reģistrēts. Uzņēmējdarbības veidošana: 10, Tirdzniecības ēka; 20, Biroju ēka; 30, Autostāvvieta garāža; 40, viesnīcas ēka; 50, Ospec. operatīvā ēka. Citas ēkas: 10, Ekonomikas ēka; 20, papildu ēka; 30, kolonijas māja."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-ġeometrija tal-bini tikkonsisti mill-oġġett u s-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): Bini residenzjali: 10, Bini b'ħafna abitazzjonijiet; 20, Dar għal familja waħda. Il-bini tal-Komunità: 10, Ospec. bini tal-komunità. Bini industrijali: 10, Bini industrijali; 20, Ospec. bini industrijali. Bini ta' servizz: 10, Transformer; 20, Torrijiet tal-ilma; 30, Shed tat-Teknoloġija Mobbli; 50, Kabina tat-telefon; 60, Kopertura tax-xita; 70, Tojlit pubbliku. Il-bini ta’ funzjonijiet soċjali: 10, Bini ġenerali; 30, Bini tal-kura tas-saħħa; 60, Bini tal-isports. Bini mhux speċifikat: 10, Bini Ospec. Mhux irreġistrat; 20, Ospec. bini Reġistrat. Bini ta' negozju: 10, Bini kummerċjali; 20, Bini tal-uffiċċji; 30, Garaxx għall-ipparkjar; 40, Bini tal-lukandi; 50, Bini operazzjonali Ospec. Bini ieħor: 10, Bini tal-ekonomija; 20, Bini komplementari; 30, Cottage Kolonja."},{"@language":"nl-t-sv-t0-mtec","@value":"Gebouwgeometrie bestaat uit de volgende objecten en subtypen (zie voor de huidige lijst de basiskaart van de algemene productspecificatie): Woongebouw: 10, Multi-wonende gebouwen; 20, Eengezinswoning. Gemeenschapsgebouw: 10, Ospec. gemeenschapsgebouw. Industrieel gebouw: 10, Industriële bouw; 20, Ospec. industriële bouw. Servicegebouw: 10, Transformator; 20, Watertorens; 30, Mobiele Technologieloods; 50, telefooncel; 60, Regenhoes; 70, Openbaar toilet. Sociale functieopbouw: 10, Algemeen gebouw; 30, Gezondheidszorggebouw; 60, Sportgebouw. Niet-gespecificeerd gebouw: 10, Ospec. gebouw Niet-geregistreerd; 20, Ospec. gebouw Geregistreerd. Bedrijfsgebouw: 10, Commerciële bouw; 20, Kantoorgebouw; 30, Parkeergarage; 40, Hotelgebouw; 50, Ospec. operationeel gebouw. Ander gebouw: 10, Economiegebouw; 20, Aanvullend gebouw; 30, Koloniehuisje."},{"@language":"pl-t-sv-t0-mtec","@value":"Geometria budynku składa się z następujących obiektów i podtypów (aktualna lista znajduje się w mapie podstawowej specyfikacji produktu): Budynek mieszkalny: 10, budynki wielorodzinne; 20, dom jednorodzinny. Budowanie wspólnoty: 10, Ospec. budowanie społeczności. Budynek przemysłowy: 10, budynek przemysłowy; 20, Ospec. budynek przemysłowy. Budynek usługowy: 10, transformator; 20, Wieże wodne; 30, Mobile Technology Shed; 50, budka telefoniczna; 60, Osłona przeciwdeszczowa; 70, publiczna toaleta. Budowanie funkcji społecznych: 10, budynek ogólny; 30, budynek opieki zdrowotnej; 60, budynek sportowy. Nieokreślony budynek: 10, Ospec. budynek niezarejestrowany; 20, budynek Ospec. Zarejestrowany. Budowanie biznesu: 10, budynek komercyjny; 20, budynek biurowy; 30, Parking w garażu; 40, budynek hotelu; 50, budynek operacyjny Ospec. Pozostały budynek: 10, budynek ekonomiczny; 20, budynek uzupełniający; 30, domek kolonialny."},{"@language":"pt-t-sv-t0-mtec","@value":"A geometria do edifício consiste nos seguintes objetos e subtipos (para a lista atual, ver o mapa de base das especificações gerais do produto): Edifício residencial: 10, Edifícios de habitação multifamiliar; 20, Casa unifamiliar. Construção comunitária: 10, Ospec. edifício comunitário. Edifício industrial: 10, Edifício industrial; 20, Ospec. edifício industrial. Edifício de serviços: 10, Transformador; 20, torres de água; 30, galpão de tecnologia móvel; 50, cabina telefónica; 60, Cobertura de chuva; 70, WC público. Criação de funções sociais: 10, Edifício geral; 30, Edifício de cuidados de saúde; 60, edifício desportivo. Edifício não especificado: 10, Ospec. edifício Não registado; 20, Ospec. edifício Registado. Construção de empresas: 10, Edifício comercial; 20, Edifício de escritórios; 30, garagem de estacionamento; 40, edifício do hotel; 50, edifício operacional da Ospec. Outro edifício: 10, edifício «Economia»; 20, Edifício complementar; 30, casa de campo da colónia."},{"@language":"ro-t-sv-t0-mtec","@value":"Geometria clădirii constă în următoarele obiecte și subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): Clădire rezidențială: 10, Clădiri cu mai multe locuințe; 20, casă unifamilială. Construcții comunitare: 10, Ospec. clădire comunitară. Clădiri industriale: 10, Clădire industrială; 20, Ospec. clădire industrială. Clădirea de servicii: 10, transformator; 20, Turnuri de apă; 30, magazie de tehnologie mobilă; 50, cabină telefonică; 60, Acoperire de ploaie; 70, toaletă publică. Consolidarea funcțiilor sociale: 10, clădirea generală; 30, Clădirea de asistență medicală; 60, clădirea sportivă. Clădire nespecificată: 10, clădirea Ospec. neînregistrată; 20, Ospec. clădire înregistrată. Clădire de afaceri: 10, Clădire comercială; 20, Clădirea de birouri; 30, Parcare în garaj; 40, clădirea hotelului; 50, clădirea operațională Ospec. Alte clădiri: 10, Clădirea economică; 20, Clădire complementară; 30, cabană Colony."},{"@language":"sk-t-sv-t0-mtec","@value":"Geometria budovy pozostáva z nasledujúcich objektov a podtypov (pre aktuálny zoznam pozri základnú mapu všeobecných špecifikácií produktu): Obytná budova: 10, viacbytové budovy; 20, Rodinný dom. Budovanie komunity: 10, Ospec. komunitná budova. Priemyselná budova: 10, Priemyselná budova; 20, Ospec. priemyselná budova. Servisná budova: 10, transformátor; 20, Vodné veže; 30, mobilné technológie Shed; 50, telefónna búdka; 60, dažďová pokrývka; 70, verejné WC. Budovanie sociálnych funkcií: 10, Všeobecná budova; 30, Budovanie zdravotnej starostlivosti; 60, športová budova. Nešpecifikovaná budova: 10, budova Ospec. Neregistrovaná; 20, Ospec. budova Registrovaný. Podnikateľská budova: 10, Komerčná budova; 20, kancelárska budova; 30, Parkovacia garáž; 40, budova hotela; 50, operačná budova Ospec. Ostatné budovy: 10, Ekonomická budova; 20, Doplnková budova; 30, Koloniálna chata."},{"@language":"sl-t-sv-t0-mtec","@value":"Geometrija stavbe je sestavljena iz naslednjih predmetov in podtipov (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): Stanovanjska stavba: 10, večstanovanjske stavbe; 20, enodružinska hiša. Gradnja skupnosti: 10, Ospec. skupnostna zgradba. Industrijska gradnja: 10, Industrijska stavba; 20, Ospec. industrijska zgradba. Storitvena gradnja: 10, transformator; 20, Vodni stolpi; 30, skladišče mobilne tehnologije; 50, telefonska kabina; 60, dežna odeja; 70, javno stranišče. Krepitev socialnih funkcij: 10, Splošna stavba; 30, zdravstvena zgradba; 60, športna zgradba. Neopredeljena stavba: 10, Ospec. stavba Neregistrirana; 20, Ospec. stavba registrirana. Poslovna stavba: 10, poslovna stavba; 20, poslovna stavba; 30, parkirna hiša; 40, stavba hotela; 50, Ospec. operativna zgradba. Druge stavbe: 10, krepitev gospodarstva; 20, dopolnilna stavba; 30, Kolonijska koča."},{"@language":"sv","@value":"Byggnader geometri består av följande objekt- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Bostadsbyggnad: 10, Flerbostadshus; 20, Enbostadshus. Samfundsbyggnad: 10, Ospec. samfundsbyggnad. Industribyggnad: 10, Industribyggnad; 20, Ospec. industribyggnad. Servicebyggnad: 10, Transformator; 20, Vattentorn; 30, Mobilteknikbod; 50, Telefonkiosk; 60, Regnskydd; 70, Offentlig toalett. Samhällsfunktionsbyggnad: 10, Allmän byggnad; 30, Vårdbyggnad; 60, Idrottsbyggnad. Ospecificerad byggnad: 10, Ospec. byggnad Oregistrerad; 20, Ospec. byggnad Registrerad. Verksamhetsbyggnad: 10, Handelsbyggnad; 20, Kontorsbyggnad; 30, Parkeringshus; 40, Hotellbyggnad; 50, Ospec. verksamhetsbyggnad. Övrig byggnad: 10, Ekonomibyggnad; 20, Komplementbyggnad; 30, Kolonistuga."},{"@language":"uk-t-sv-t0-mtec","@value":"Геометрія будівлі складається з наступних об'єктів і підтипів (для поточного списку див. Житловий будинок: 10, багатоквартирні будинки; 20, Односімейний будинок. Будівля громади: 10, Ospec. будівля громади. Промислове будівництво: 10, Промислове будівництво; 20, Одеська промислова будівля. Службова будівля: 10, трансформатор; 20, Водонапірні вежі; 30, сарай мобільних технологій; 50, Телефонна будка; 60, Дощовий покрив; 70, Громадський туалет. Побудова соціальної функції: 10, Загальний корпус; 30, будівля охорони здоров'я; 60, Спортивний корпус. Невизначена будівля: 10, м.Оспек. будинок Незареєстрований; 20, Ospec. будівля Зареєстровано. Бізнес-будівництво: 10, Комерційна будівля; 20, Офісна будівля; 30, парковка гараж; 40, готельно-ресторанний комплекс; 50, Спец. оперативний корпус. Інші будівлі: 10, Економічна будівля; 20, додатковий корпус; 30, Котедж \"Колонія\"."}],"dct:format":"text/html","dct:identifier":"1a7e82e6-d505-41c4-9e8f-26d598c1e30f","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:a9d940a54be16fbe2ea22d3bf6caf93192dd852652ef8a51dcca0c4ffb6e06ee_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Геометрия на сградите"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Geometrie budov"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Bygningsgeometri"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Gebäudegeometrie"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Base map - Γεωμετρία κτιρίων"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Buildings geometry"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Geometría de edificios"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Base map - Hoonete geomeetria"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Rakennusgeometria"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base - Géométrie des bâtiments"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil bhunáite SBK - Geoiméadracht foirgneamh"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Bazna karta - Geometrija zgrada"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Épületgeometria"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Base map - Geometria degli edifici"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Pastatų geometrija"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Bāzes karte - Ēku ģeometrija"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Bażi ta' mappa - Bini ġeometrija"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Gebouwengeometrie"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Base map - Geometria budynków"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa de base SBK - Geometria dos edifícios"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Base map - Geometria clădirilor"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Základná mapa - Geometria budov"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Osnovni zemljevid - Geometrija zgradb"},{"@language":"sv","@value":"SBK Baskarta - Byggnader geometri"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Базова карта - Геометрія будівель"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/de71b626-d150-4bdb-b974-f942a945dbe6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/1a7e82e6-d505-41c4-9e8f-26d598c1e30f#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Baskarta (1:400  - 1:2000).",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продуктовата базова карта (1:400 - 1:2000)."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktové Základní mapy (1:400 - 1:2000)."},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktbasen (1:400 - 1:2000)."},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Basiskarte (1:400 - 1:2000) enthalten."},{"@language":"el-t-sv-t0-mtec","@value":"Το σύνολο δεδομένων περιλαμβάνεται στον χάρτη βάσης προϊόντος (1:400 - 1:2000)."},{"@language":"en-t-sv-t0-mtec","@value":"The data set is included in the product Base map (1:400 - 1:2000)."},{"@language":"es-t-sv-t0-mtec","@value":"El conjunto de datos se incluye en el mapa base del producto (1:400 - 1:2000)."},{"@language":"et-t-sv-t0-mtec","@value":"Andmekogum sisaldub toote aluskaardil (1:400 - 1:2000)."},{"@language":"fi-t-sv-t0-mtec","@value":"Aineisto sisältyy tuotteen peruskarttaan (1:400 - 1:2000)."},{"@language":"fr-t-sv-t0-mtec","@value":"L'ensemble de données est inclus dans la carte de base du produit (1:400 - 1:2000)."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an tacar sonraí san áireamh sa bhunléarscáil táirge (1:400 - 1:2000)."},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka uključen je u kartu proizvoda Baza (1:400 - 1:2000)."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatkészlet megtalálható a termék alaptérképén (1:400 - 1:2000)."},{"@language":"it-t-sv-t0-mtec","@value":"Il set di dati è incluso nella mappa di base del prodotto (1:400 - 1:2000)."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rinkinys įtrauktas į gaminio bazinį žemėlapį (1:400 - 1:2000)."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu kopa ir iekļauta produktu bāzes kartē (1:400 - 1:2000)."},{"@language":"mt-t-sv-t0-mtec","@value":"Is-sett tad-data huwa inkluż fil-mappa tal-bażi tal-prodott (1:400 - 1:2000)."},{"@language":"nl-t-sv-t0-mtec","@value":"De gegevensset is opgenomen in de productbasiskaart (1:400 - 1:2000)."},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się na mapie bazowej produktu (1:400 - 1:2000)."},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no mapa de base do produto (1:400 - 1:2000)."},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în harta de bază a produsului (1:400 - 1:2000)."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový súbor je súčasťou produktu Základná mapa (1:400 - 1:2000)."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov je vključen v osnovni zemljevid izdelka (1:400 - 1:2000)."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних входить до базової карти продукту (1:400 - 1:2000)."}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/de71b626-d150-4bdb-b974-f942a945dbe6"}},{"@id":"http://data.europa.eu/88u/record/1a7e82e6-d505-41c4-9e8f-26d598c1e30f","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/de71b626-d150-4bdb-b974-f942a945dbe6"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"1a7e82e6-d505-41c4-9e8f-26d598c1e30f","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:00Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:49Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/1a7e82e6-d505-41c4-9e8f-26d598c1e30f"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:a9d940a54be16fbe2ea22d3bf6caf93192dd852652ef8a51dcca0c4ffb6e06ee_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/1a7e82e6-d505-41c4-9e8f-26d598c1e30f"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:00Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:49Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"1a7e82e6-d505-41c4-9e8f-26d598c1e30f","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/1a7e82e6-d505-41c4-9e8f-26d598c1e30f"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:a9d940a54be16fbe2ea22d3bf6caf93192dd852652ef8a51dcca0c4ffb6e06ee"},{"@graph":[{"@id":"_:ac3bff805786f51165b3f1dabf9f1fe229561700b85e4cf42d6c4228382f0307_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4428,18.2011 59.4428,18.2011 59.2272,17.7605 59.2272,17.7605 59.4428))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4428,18.2011 59.4428,18.2011 59.2272,17.7605 59.2272,17.7605 59.4428))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/90159088-f909-49c9-ba36-a70919e1f331","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=43a97b7a-58a9-480e-9a40-6d91f78e79b6"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2014-03-06"},"dct:description":{"@language":"sv","@value":"Kontinuerlig mätdata över energiproduktionen från Stockholms stads solceller. Upplösning per 10 minuter, timmar och dygn."},"dct:identifier":"90159088-f909-49c9-ba36-a70919e1f331","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:ac3bff805786f51165b3f1dabf9f1fe229561700b85e4cf42d6c4228382f0307_b0n0"},"dct:title":{"@language":"sv","@value":"Soldata"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:ac3bff805786f51165b3f1dabf9f1fe229561700b85e4cf42d6c4228382f0307"},{"@graph":[{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b0n0","@type":"http://schema.org/Offer","http://schema.org/description":{"@language":"sv","@value":"Se webbsidan"},"http://schema.org/mainEntityOfPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/avisering.2009.html"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1cbbd84c4c1f9b51eb696a04c17fec7444"},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b2n0","dct:identifier":"http://data.europa.eu/88u/distribution/9469238c-f507-49b5-bcd9-6c02e1508c14","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/9b0684cb-d75b-4959-b21b-4342b507ba11"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b5n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-bolagsverket-se-store-2-resource-10","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/2a2c8ac2-fb77-4cec-bb3f-44dfa9caec57"},"dcat:keyword":[{"@language":"en","@value":"Company Information"},{"@language":"sv","@value":"Företagsinformation"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/be/sok/avisering"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомяване за промени в регистъра с информация за дружествата на Шведската служба за регистрация на дружествата чрез файлове, създавани ежедневно и предавани чрез SFTP. Моля, имайте предвид, че трябва да сте регистриран като клиент и че има такси за използване на услугата."},{"@language":"cs-t-sv-t0-mtec","@value":"Oznámení o změnách v rejstříku informací o společnostech vedeném švédským úřadem pro registraci společností prostřednictvím souborů vytvořených denně a přenášených prostřednictvím SFTP. Vezměte prosím na vědomí, že musíte být registrováni jako zákazník a že za používání služby jsou účtovány poplatky."},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelse om ændringer i det svenske selskabsregisters register over selskabsoplysninger via filer, der oprettes dagligt og overføres via SFTP. Bemærk, at du skal være registreret som kunde, og at der er gebyrer for at bruge tjenesten."},{"@language":"de-t-sv-t0-mtec","@value":"Benachrichtigung über Änderungen im Register der Unternehmensinformationen des schwedischen Handelsregisteramts über täglich erstellte und über SFTP übermittelte Dateien. Bitte beachten Sie, dass Sie als Kunde registriert sein müssen und dass für die Nutzung des Dienstes Gebühren anfallen."},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποίηση των αλλαγών στο μητρώο εταιρικών στοιχείων του Σουηδικού Γραφείου Μητρώου Εταιρειών μέσω αρχείων που δημιουργούνται καθημερινά και διαβιβάζονται μέσω του SFTP. Παρακαλείστε να σημειώσετε ότι πρέπει να εγγραφείτε ως πελάτης και ότι υπάρχουν χρεώσεις για τη χρήση της υπηρεσίας."},{"@language":"en-t-sv-t0-mtec","@value":"Notification of changes in the Swedish Companies Registration Office's register of company information via files created daily and transmitted via SFTP. Please note that you must be registered as a customer and that there are fees for using the service."},{"@language":"es-t-sv-t0-mtec","@value":"Notificación de cambios en el registro de información societaria de la Oficina Sueca de Registro Mercantil a través de archivos creados diariamente y transmitidos a través de SFTP. Tenga en cuenta que debe estar registrado como cliente y que hay tarifas por usar el servicio."},{"@language":"et-t-sv-t0-mtec","@value":"Rootsi äriregistri andmete registri muudatustest teatamine iga päev loodavate ja SFTP kaudu edastatavate failide kaudu. Pange tähele, et peate olema kliendiks registreeritud ja teenuse kasutamise eest tuleb maksta tasu."},{"@language":"fi-t-sv-t0-mtec","@value":"Muutoksista ilmoittaminen Ruotsin yritysrekisteritoimiston yritystietorekisteriin päivittäin luotujen ja SFTP:n kautta välitettyjen tiedostojen kautta. Huomioithan, että sinun tulee rekisteröityä asiakkaaksi ja että palvelun käytöstä peritään maksu."},{"@language":"fr-t-sv-t0-mtec","@value":"Notification des modifications apportées au registre des sociétés de l'Office suédois de l'enregistrement des sociétés au moyen de fichiers créés quotidiennement et transmis via SFTP. Veuillez noter que vous devez être inscrit en tant que client et qu'il y a des frais pour l'utilisation du service."},{"@language":"ga-t-sv-t0-mtec","@value":"Fógra faoi athruithe ar chlár faisnéise cuideachta Oifig na Sualainne um Chlárú Cuideachtaí trí chomhaid a chruthaítear go laethúil agus a tharchuirtear trí SFTP. Tabhair faoi deara le do thoil go gcaithfidh tú a bheith cláraithe mar chustaiméir agus go bhfuil táillí ann as an tseirbhís a úsáid."},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijest o promjenama u registru podataka o trgovačkim društvima švedskog Ureda za registraciju trgovačkih društava putem datoteka koje se svakodnevno izrađuju i prenose putem SFTP-a. Imajte na umu da morate biti registrirani kao kupac i da postoje naknade za korištenje usluge."},{"@language":"hu-t-sv-t0-mtec","@value":"Értesítés a svéd cégnyilvántartó hivatal céginformációs nyilvántartásában bekövetkezett változásokról a naponta létrehozott és az SFTP-n keresztül továbbított fájlokon keresztül. Kérjük, vegye figyelembe, hogy regisztrált ügyfélnek kell lennie, és a szolgáltatás igénybevételéért díjat kell fizetni."},{"@language":"it-t-sv-t0-mtec","@value":"Notifica delle modifiche apportate al registro delle informazioni societarie dell'Ufficio svedese di registrazione delle imprese tramite file creati quotidianamente e trasmessi tramite SFTP. Si prega di notare che è necessario essere registrati come cliente e che ci sono costi per l'utilizzo del servizio."},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimas apie Švedijos įmonių registracijos tarnybos įmonių informacijos registro pasikeitimus naudojantis kasdien sukurtomis ir per SFTP perduodamomis rinkmenomis. Atkreipkite dėmesį, kad turite būti registruotas kaip klientas ir kad yra mokesčiai už naudojimąsi paslauga."},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojums par izmaiņām Zviedrijas Uzņēmumu reģistrācijas biroja uzņēmumu informācijas reģistrā, izmantojot datnes, kas izveidotas katru dienu un nosūtītas, izmantojot SFTP. Lūdzu, ņemiet vērā, ka jums ir jābūt reģistrētam kā klientam un ka par pakalpojuma izmantošanu ir jāmaksā."},{"@language":"mt-t-sv-t0-mtec","@value":"Notifika ta’ bidliet fir-reġistru tal-informazzjoni dwar il-kumpaniji tal-Uffiċċju tar-Reġistrazzjoni tal-Kumpaniji Żvediż permezz ta’ fajls maħluqa kuljum u trażmessi permezz tal-SFTP. Jekk jogħġbok innota li trid tkun irreġistrat bħala klijent u li hemm tariffi għall-użu tas-servizz."},{"@language":"nl-t-sv-t0-mtec","@value":"Kennisgeving van wijzigingen in het register van bedrijfsinformatie van het Zweedse registratiebureau voor ondernemingen via dagelijks aangemaakte en via SFTP verzonden bestanden. Houd er rekening mee dat u als klant moet worden geregistreerd en dat er kosten zijn voor het gebruik van de service."},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadomienie o zmianach w rejestrze informacji o spółkach prowadzonym przez szwedzki Urząd Rejestracji Spółek za pośrednictwem plików tworzonych codziennie i przekazywanych za pośrednictwem SFTP. Pamiętaj, że musisz być zarejestrowany jako klient i że istnieją opłaty za korzystanie z usługi."},{"@language":"pt-t-sv-t0-mtec","@value":"Notificação de alterações no registo de informações sobre as sociedades do Serviço de Registo Comercial sueco através de ficheiros criados diariamente e transmitidos através do SFTP. Tenha em atenção que tem de estar registado como cliente e que existem taxas pela utilização do serviço."},{"@language":"ro-t-sv-t0-mtec","@value":"Notificarea modificărilor din registrul informațiilor privind societățile comerciale al Oficiului suedez de înregistrare a societăților comerciale prin intermediul fișierelor create zilnic și transmise prin intermediul SFTP. Vă rugăm să rețineți că trebuie să fiți înregistrat ca și client și că există taxe pentru utilizarea serviciului."},{"@language":"sk-t-sv-t0-mtec","@value":"Oznámenie zmien v registri informácií o spoločnostiach švédskeho úradu pre registráciu spoločností prostredníctvom súborov vytvorených denne a prenášaných prostredníctvom SFTP. Upozorňujeme, že musíte byť zaregistrovaný ako zákazník a že za používanie služby sú poplatky."},{"@language":"sl-t-sv-t0-mtec","@value":"Obveščanje o spremembah v registru podatkov o družbah švedskega urada za registracijo družb z datotekami, ki se ustvarijo dnevno in posredujejo prek programa SFTP. Prosimo, upoštevajte, da morate biti registrirani kot stranka in da obstajajo pristojbine za uporabo storitve."},{"@language":"sv","@value":"Avisering om förändringar i Bolagsverkets register för företagsinformation via filer som skapas dagligen och överförs via SFTP. Notera att du måste vara registerad som kund och att det tillkommer avgifter för att använda tjänsten."},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни в реєстрі інформації про компанію Шведського бюро реєстрації компаній за допомогою файлів, створених щодня та переданих через SFTP. Зверніть увагу, що ви повинні бути зареєстровані як клієнт і що за користування послугою стягується плата."}],"dct:format":"text/plain","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Уведомяване за промени в търговските регистри"},{"@language":"cs-t-sv-t0-mtec","@value":"Oznamování změn v obchodních rejstřících"},{"@language":"da-t-sv-t0-mtec","@value":"Meddelelse om ændringer i selskabsregistre"},{"@language":"de-t-sv-t0-mtec","@value":"Meldung von Änderungen in Unternehmensregistern"},{"@language":"el-t-sv-t0-mtec","@value":"Κοινοποίηση αλλαγών στα μητρώα επιχειρήσεων"},{"@language":"en-t-sv-t0-mtec","@value":"Notification of changes in business registers"},{"@language":"es-t-sv-t0-mtec","@value":"Notificación de cambios en los registros mercantiles"},{"@language":"et-t-sv-t0-mtec","@value":"Ettevõtlusregistrite muudatustest teatamine"},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupparekistereiden muutoksista ilmoittaminen"},{"@language":"fr-t-sv-t0-mtec","@value":"Notification des modifications apportées aux registres du commerce"},{"@language":"ga-t-sv-t0-mtec","@value":"Fógra a thabhairt faoi athruithe ar chláir ghnó"},{"@language":"hr-t-sv-t0-mtec","@value":"Obavijest o promjenama u poslovnim registrima"},{"@language":"hu-t-sv-t0-mtec","@value":"A cégnyilvántartások változásainak bejelentése"},{"@language":"it-t-sv-t0-mtec","@value":"Notifica delle modifiche dei registri delle imprese"},{"@language":"lt-t-sv-t0-mtec","@value":"Pranešimas apie verslo registrų pakeitimus"},{"@language":"lv-t-sv-t0-mtec","@value":"Paziņojums par izmaiņām uzņēmējdarbības reģistros"},{"@language":"mt-t-sv-t0-mtec","@value":"Notifika ta' bidliet fir-reġistri kummerċjali"},{"@language":"nl-t-sv-t0-mtec","@value":"Kennisgeving van wijzigingen in ondernemingsregisters"},{"@language":"pl-t-sv-t0-mtec","@value":"Powiadamianie o zmianach w rejestrach przedsiębiorstw"},{"@language":"pt-t-sv-t0-mtec","@value":"Notificação de alterações nos ficheiros de empresas"},{"@language":"ro-t-sv-t0-mtec","@value":"Notificarea modificărilor în registrele comerțului"},{"@language":"sk-t-sv-t0-mtec","@value":"Oznamovanie zmien v obchodných registroch"},{"@language":"sl-t-sv-t0-mtec","@value":"Obveščanje o spremembah v poslovnih registrih"},{"@language":"sv","@value":"Avisering om förändringar i företagsregistren"},{"@language":"uk-t-sv-t0-mtec","@value":"Повідомлення про зміни в реєстрах підприємств"}],"http://schema.org/offers":{"@id":"_:acf22e67e20325488d03ee5c7c2010f795833f89f2f36eee27bc0ac3ea77bef5_b0n0"}},{"@id":"http://data.europa.eu/88u/distribution/2a2c8ac2-fb77-4cec-bb3f-44dfa9caec57","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://bolagsverket.se/be/sok/avisering"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Информация за дружеството, уведомления"},{"@language":"cs-t-sv-t0-mtec","@value":"Informace o společnosti, oznámení"},{"@language":"da-t-sv-t0-mtec","@value":"Virksomhedsoplysninger, Meddelelser"},{"@language":"de-t-sv-t0-mtec","@value":"Unternehmensinformationen, Benachrichtigungen"},{"@language":"el-t-sv-t0-mtec","@value":"Στοιχεία εταιρείας, ειδοποιήσεις"},{"@language":"en-t-sv-t0-mtec","@value":"Company information, Notifications"},{"@language":"es-t-sv-t0-mtec","@value":"Información de la empresa, Notificaciones"},{"@language":"et-t-sv-t0-mtec","@value":"Ettevõtte andmed, teatised"},{"@language":"fi-t-sv-t0-mtec","@value":"Yritystiedo