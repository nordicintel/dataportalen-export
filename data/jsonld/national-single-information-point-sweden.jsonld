228d4_b1n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-08T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T04:47:58Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-meddela-felaktig-folkbokforingsadress-1-0-5-2523dataset~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c0f9d61d014b6ca0d7e99db224aa149bcd852e48b168f29f5879c2cb79c228d4_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-meddela-felaktig-folkbokforingsadress-1-0-5-2523dataset~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-10-09T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-10-11T04:47:58Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/meddela-felaktig-folkbokforingsadress/1.0.5/%2523dataset","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/meddela-felaktig-folkbokforingsadress/1.0.5/%2523dataset"}},{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]}],"@id":"urn:source:c0f9d61d014b6ca0d7e99db224aa149bcd852e48b168f29f5879c2cb79c228d4"},{"@graph":[{"@id":"_:c176424fa5458ac297f9bb42f8b29cf4f30ec706bc65545ee3da19f379bc5458_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:c176424fa5458ac297f9bb42f8b29cf4f30ec706bc65545ee3da19f379bc5458_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"17ddfacdc0de0ed0efdf4638a6db208e91"},{"@id":"http://data.europa.eu/88u/dataset/bb022340-74b0-420c-8114-fa40b957bcc4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/3791a328-232c-4e2c-9504-bb4ee96944d2"},{"@id":"http://data.europa.eu/88u/distribution/c0be578e-78c5-4da9-bee4-216581ec9d3e"},{"@id":"http://data.europa.eu/88u/distribution/cf2da93b-32b2-4006-b368-d260017065f9"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=8b97890f-7c0a-48f6-a414-a72601fcebf5"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2006-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени съвместно с други картови продукти.Резолюция: 20 см/пиксел в ортофото и 10 см/пиксел в оригиналните изображения. Коментар: Обхваща Стокхолм, Дандерид, част от Нака и Екерьо. Има и ортофотоснимки, които покриват голяма част от окръга. Дата на снимката: април—май 2006 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 20 cm/pixel na ortofotosnímku a 10 cm/pixel na původních obrázcích. Komentář: Zahrnuje Stockholm, Danderyd, část Nacka a Ekerö. Existují také ortofotosnímky, které pokrývají velkou část kraje. Datum pořízení fotografie: duben–květen 2006."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter.Resolution: 20 cm/pixel i ortofoto og 10 cm/pixel i de originale billeder. Bemærkning: Omfatter Stockholm, Danderyd, en del af Nacka og Ekerö. Der er også ortofotos, der dækker en stor del af amtet. Fotografiets dato: April-maj 2006."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie eignen sich auch zum Drucken und können zusammen mit anderen Kartenprodukten präsentiert werden.Auflösung: 20 cm/Pixel im Orthofoto und 10 cm/Pixel in den Originalbildern. Anmerkung: Umfasst Stockholm, Danderyd, einen Teil von Nacka und Ekerö. Es gibt auch Orthofotos, die einen großen Teil der Grafschaft abdecken. Fotodatum: April-Mai 2006."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών.Ψήφισμα: 20 cm/pixel στην ορθοφωτογραφία και 10 cm/pixel στις αρχικές εικόνες. Σχόλιο: Καλύπτει τη Στοκχόλμη, το Danderyd, μέρος των Nacka και Ekerö. Υπάρχουν επίσης ορθοφωτογραφίες που καλύπτουν μεγάλο μέρος του νομού. Ημερομηνία φωτογραφίας: Απρίλιος-Μάιος 2006."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products.Resolution: 20 cm/pixel in orthophoto, and 10 cm/pixel in the original images. Comment: Covers Stockholm, Danderyd, part of Nacka and Ekerö. There are also orthophotos that cover a large part of the county. Date of photograph: April-May 2006."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para imprimir y se pueden copresentar con otros productos de mapas.Resolución: 20 cm/píxel en ortofoto, y 10 cm/píxel en las imágenes originales. Comentario: Cubre Estocolmo, Danderyd, parte de Nacka y Ekerö. También hay ortofotos que cubren una gran parte del condado. Fecha de la fotografía: Abril-mayo de 2006."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega.Resolutsioon: 20 cm piksli kohta ortofotol ja 10 cm piksli kohta originaalkujutistel. Märkus: Hõlmab Stockholmi, Danderydi, osa Nackast ja Ekeröst. On ka ortofotosid, mis katavad suure osa maakonnast. Foto kuupäev: Aprill–mai 2006."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen, ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa.Resolution: 20 cm/pikseli ortokuvassa ja 10 cm/pikseli alkuperäisissä kuvissa. Huomautus: Kattaa Tukholman, Danderydin, osan Nackasta ja Ekeröstä. On myös ortokuvia, jotka kattavat suuren osan maakunnasta. Valokuvauksen päivämäärä: huhti-toukokuu 2006."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques.Résolution: 20 cm/pixel en orthophoto, et 10 cm/pixel dans les images originales. Commentaire : Couvre Stockholm, Danderyd, une partie de Nacka et Ekerö. Il existe également des orthophotos qui couvrent une grande partie du comté. Date de la photographie: Avril-mai 2006."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile.Réiteach: 20 cm/picteilín in orthophoto, agus 10 cm/picteilín sna híomhánna bunaidh. Barúil: Clúdaíonn sé Stócólm, Danderyd, cuid de Nacka agus Ekerö. Tá orta-ghrianghraif ann freisin a chlúdaíonn cuid mhór den chontae. Dáta an ghrianghraif: Aibreán-Bealtaine 2006."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim proizvodima na karti.Rezolucija: 20 cm/piksel u ortofotografiji i 10 cm/piksel u originalnim slikama. Primjedba: Obuhvaća Stockholm, Danderyd, dio Nacke i Ekeröa. Postoje i ortofotografije koje pokrivaju veliki dio županije. Datum fotografije: Travanj-svibanj 2006."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók.Felbontás: 20 cm/pixel az ortofotón és 10 cm/pixel az eredeti képeken. Megjegyzés: Ide tartozik Stockholm, Danderyd, Nacka és Ekerö egy része. Vannak olyan ortofotók is, amelyek a megye nagy részét lefedik. Fénykép dátuma: 2006. április–május."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono anche adatti per la stampa e possono essere co-presentati con altri prodotti cartografici.Risoluzione: 20 cm/pixel in ortofoto e 10 cm/pixel nelle immagini originali. Commento: Copre Stoccolma, Danderyd, parte di Nacka e Ekerö. Ci sono anche ortofoto che coprono gran parte della contea. Data della fotografia: aprile-maggio 2006."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais.Rezoliucija: 20 cm / pikselių ortofotografijoje ir 10 cm / pikselių originaliuose vaizduose. Komentaras: Apima Stokholmą, Danderyd, dalį Nacka ir Ekerö. Taip pat yra ortofoto, kurie apima didelę apskrities dalį. Fotografavimo data: 2006 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem.Rezolūcija: 20 cm/pixel ortofoto un 10 cm/pixel oriģinālajos attēlos. Komentārs: Ietver Stokholmu, Danderyd, daļu no Nacka un Ekerö. Ir arī ortofoto, kas aptver lielu daļu no apgabala. Fotogrāfijas datums: 2006. gada aprīlis–maijs."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa.Riżoluzzjoni: 20 cm/pixel fl-ortofoto, u 10 cm/pixel fl-immaġnijiet oriġinali. Kumment: Tkopri Stokkolma, Danderyd, parti minn Nacka u Ekerö. Hemm ukoll ortofotografi li jkopru parti kbira tal-kontea. Data tar-ritratt: April-Mejju 2006."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd.Resolutie: 20 cm/pixel in orthofoto, en 10 cm/pixel in de originele beelden. Opmerking: Omvat Stockholm, Danderyd, onderdeel van Nacka en Ekerö. Er zijn ook orthofoto's die een groot deel van de provincie beslaan. Datum van de foto: april-mei 2006."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być prezentowany razem z innymi produktami mapowymi. 20 cm/piksel w ortofotomapie i 10 cm/piksel w oryginalnych obrazach. Komentarz: Obejmuje Sztokholm, Danderyd, część Nacka i Ekerö. Istnieją również ortofotomapy, które obejmują dużą część hrabstwa. Data zdjęcia: kwiecień-maj 2006 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. São igualmente apropriados para a impressão e podem ser co-apresentados com outros produtos do mapa.Resolução: 20 cm/pixel na ortofotografia e 10 cm/pixel nas imagens originais. Comentário: Abrange Estocolmo, Danderyd, parte de Nacka e Ekerö. Há também ortofotos que cobrem uma grande parte do condado. Data da fotografia: Abril-Maio de 2006."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi prezentate împreună cu alte produse cartografice.Rezoluție: 20 cm/pixel în ortofoto și 10 cm/pixel în imaginile originale. Observație: Acoperă Stockholm, Danderyd, parte din Nacka și Ekerö. Există, de asemenea, ortofotografii care acoperă o mare parte a județului. Data fotografiei: aprilie-mai 2006."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 20 cm/pixel v ortofotografii a 10 cm/pixel v pôvodných obrázkoch. Pripomienka: Zahŕňa Štokholm, Danderyd, časť Nacka a Ekerö. Existujú aj ortofotografie, ktoré pokrývajú veľkú časť kraja. Dátum fotografie: apríl – máj 2006."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in jih je mogoče predstaviti skupaj z drugimi izdelki za zemljevide.Resolucija: 20 cm/slikovno piko na ortofoto posnetkih in 10 cm/slikovno piko na izvirnih slikah. Pripomba: Zajema Stockholm, Danderyd, del Nacke in Ekeröja. Obstajajo tudi ortofoto posnetki, ki pokrivajo velik del okrožja. Datum fotografiranja: april–maj 2006."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Upplösning: 20 cm/pixel i ortofoto, och 10cm/pixel i originalbilderna. Kommentar: Täcker Stockholm, Danderyd, del av Nacka och Ekerö. Det finns även ortofoton som täcker en stor del av länet. Fotograferingsdatum: april-maj 2006."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 20 см/піксель на ортофотоплані та 10 см/піксель на оригінальних зображеннях. Коментар до статті: Охоплює Стокгольм, Дандерид, частину Наки та Екере. Є також ортофотоплани, які охоплюють більшу частину округу. Дата фотографії: Квітень-травень 2006 року."}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"bb022340-74b0-420c-8114-fa40b957bcc4","dct:issued":{"@type":"xsd:date","@value":"2007-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c176424fa5458ac297f9bb42f8b29cf4f30ec706bc65545ee3da19f379bc5458_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Ortofoto / Ортофото (2006)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2006) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Ortofoto (2006) - Wikipedia, den frie encyklopædi"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορτοφότο (2006)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2006.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2006 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2006)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2006) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2006) - Kto od