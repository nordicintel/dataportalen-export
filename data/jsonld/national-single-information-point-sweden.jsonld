,"@value":"Drzewa SBK - Korony śladu 2022 w formacie GPKG, obs około 3,5 GB"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Trees - Footprint crowns 2022 em formato GPKG, obs cerca de 3,5 GB"},{"@language":"ro-t-sv-t0-mtec","@value":"Copaci SBK - Coroane de amprentă 2022 în format GPKG, obs aproximativ 3,5 GB"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Trees - Footprint crowns 2022 vo formáte GPKG, obs asi 3,5 GB"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Drevesa - Krone odtisa 2022 v GPKG formatu, obs približno 3,5 GB"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Trees - Коронки для слідів 2022 у форматі GPKG, близько 3,5 ГБ"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/42fdf909-c074-4c1f-9f5f-60201bfeb202"}},{"@id":"http://data.europa.eu/88u/record/340a9ec7-290e-48bb-8e89-2615959f26df","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/04d9d022-dbc1-456f-a596-ba9059961499"},{"@id":"http://data.europa.eu/88u/distribution/42fdf909-c074-4c1f-9f5f-60201bfeb202"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"340a9ec7-290e-48bb-8e89-2615959f26df","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:09Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:00Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/340a9ec7-290e-48bb-8e89-2615959f26df"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:89aaa98594f1f318e356abe3ea32efca6af0123ad4fa10074efbc4008eb46279_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/340a9ec7-290e-48bb-8e89-2615959f26df"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:00Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#T