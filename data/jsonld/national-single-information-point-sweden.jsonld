t:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e#HTTP:Nedladdning:data/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2b68204e-ced2-4bcd-a72f-95f948a17808"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2024-01-31"},"dct:description":{"@language":"sv","@value":"Laserpunktmoln från flygning 2023. Täcker hela Stockholms kommun inkl buffertzon runt. Filformat: LAS och POD. Flyghöjd:Punkttäthet: 16 pkt/m² Flygdatum: . Referenssytem i plan: Sweref 991800, i höjd: RH2000 Laserdata, punktmoln 2023Punktmolnet kommer från flygburen laserskanning, utförd av Field Group, över Stockholms stad under perioden 22 april ? 7 maj 2023. Täckningskontroll av laserdata utfördes visuellt och med programvaran Terrascan. Punkttätheten för detta projekt är > 16pkt/m2Markklassificeringen är manuellt kontrollerad medan byggnadsklassningen är helt automatiskt utförd och kan vara av varierande kvalitet.Klassning av laserdata delas upp i följande klasser: ? 1 (Oklassificerat) ? 2 (Mark) ? 6 (Byggnad) ? 7 (Hög- och Lågpunkter sk. brus) ? 9 (Vatten) ? 17 (Broar)Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre. Punktmolnet har färgsatts med hjälp av ortofotot från 2023, vilket innebär att varje punkt har tilldelats ett RGB-värde från motsvarande pixel i ortofotot. (Fotograferingsdatum för ortofotot: 20/4 och 7/5 2023)"},"dct:identifier":"a0f9b145-f0ba-49f6-9191-2995f3c8a32e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:685374f8e601dbe40a07f43d2c686759b07d1cabbd3bc9bf52f213ca48bfed03_b0n0"},"dct:temporal":{"@id":"_:685374f8e601dbe40a07f43d2c686759b07d1cabbd3bc9bf52f213ca48bfed03_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Punktmoln - flygburen laserskanning (2023)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e#HTTP:Nedladdning:data/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Punktmoln_2023_testomrade.las"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Testdata LAS-format"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:685374f8e601dbe40a07f43d2c686759b07d1cabbd3bc9bf52f213ca48bfed03"},{"@graph":[{"@id":"_:693b3d06a6b0911dbae9097832bb0f5561dd8918ae555501a5498952e8e6923f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:693b3d06a6b0911dbae9097832bb0f5561dd8918ae555501a5498952e8e6923f_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"128da600caee03f2ee6347c2d1756d942f"},{"@id":"http://data.europa.eu/88u/dataset/18504cad-009e-46b7-97cc-4fdc9a4449b3","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/252130e3-9059-49dd-8ea5-5515cc5aee70"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=ec4316b3-ab47-4be0-b51b-99dab8cefef3"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта