,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/d3bdc7f3-0f53-4f7a-a329-a83c650c6eb4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/d3bdc7f3-0f53-4f7a-a329-a83c650c6eb4#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=d31c98ef-248a-418f-823f-1ab3b95d0141"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":{"@language":"sv","@value":"Registerkarta - Ytor bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450040, EnhetsområdeUndertyper10, Fastighetsområde, modifierbar20, Fastighetsutrymme, modifierbar30, Bihang C, modifierbar40, Samfällighet, modifierbar50, Ägarlägenhetsutrymme, modifierbar450150, KommunUndertyper10, Kommun, modifierbar450180, StadsdelUndertyper10, Stadsdel, modifierbar450210, KvarterUndertyper10, Kvarter enl detaljplan, modifierbar20, Kvarter enl detaljplan-ej namnsatt, modifierbar"},"dct:identifier":"d3bdc7f3-0f53-4f7a-a329-a83c650c6eb4","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:0f0d6d48d414b420ae36014494f05da5f6c4d57cda342eea4d3ab954b0120208_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Registerkarta - Ytor"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/d3bdc7f3-0f53-4f7a-a329-a83c650c6eb4#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=445799076_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Registerkartan"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:0f0d6d48d414b420ae36014494f05da5f6c4d57cda342eea4d3ab954b0120208"},{"@graph":[{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2016-06-05"},"dcat:startDate":{"@type":"xsd:date","@value":"2016-04-21"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2016-06-05"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2016-04-21"}},{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a6ed13a9d444012eece06e72c09b2d793"},{"@id":"http://data.europa.eu/88u/dataset/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1301cb35-2201-4273-83ce-915fb64a453c"},{"@id":"http://data.europa.eu/88u/distribution/3038c227-c37e-4f2f-bbd9-2521cf75e697"},{"@id":"http://data.europa.eu/88u/distribution/e3f03584-c965-4864-b862-d12fc2df2558"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2798052f-108b-461a-a894-0f5da1d024f9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2016-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Снимките са доста зелени. Надморска височина на полета: на около 2700 метра над земята. Разделителна способност: 12 cm на земята на пиксел. Процент на покритие: 60/60. Дата на снимката: 8 май 2016 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Obrázky jsou docela zelené. Nadmořská výška letu: asi 2700 metrů nad zemí. Usnesení: 12 cm na zem na pixel. Pokrytí v %: 60/60. Datum pořízení fotografie: května 2016. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Billederne er ret grønne. Flyvehøjde: omkring 2700 meter over jorden. Beslutning: 12 cm på jorden pr. pixel. Dækningsgrad: 60/60. Fotografiets dato: 8. maj 2016. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Die Bilder sind ziemlich grün. Flughöhe: ca. 2700 Meter über dem Boden. Entschließung: 12 cm auf dem Boden pro Pixel. Abdeckung %: 60/60. Fotodatum: 8. Mai 2016. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Οι εικόνες είναι αρκετά πράσινες. Υψόμετρο πτήσης: περίπου 2700 μέτρα πάνω από το έδαφος. Ψήφισμα: 12 cm στο έδαφος ανά pixel. Κάλυψη %: 60/60. Ημερομηνία φωτογραφίας: 8 Μαΐου 2016. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. The pictures are quite green. Flight altitude: about 2700 meters above the ground. Resolution: 12 cm on the ground per pixel. Coverage %: 60/60. Date of photograph: 8 May 2016. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Las fotos son bastante verdes. Altitud de vuelo: a unos 2700 metros sobre el suelo. Resolución: 12 cm en el suelo por píxel. Porcentaje de cobertura: 60/60. Fecha de la fotografía: 8 de mayo de 2016. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Pildid on üsna rohelised. Lennukõrgus: Umbes 2700 meetrit maapinnast. Resolutsioon: 12 cm maapinnal piksli kohta. Katvus %: 60/60. Foto kuupäev: 8. mai 2016. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Kuvat ovat aika vihreitä. Lentokorkeus: noin 2700 metriä maanpinnan yläpuolella. Päätöslauselma: 12 cm maassa pikseliä kohti. Kattavuus %: 60/60. Valokuvauksen päivämäärä: toukokuuta 2016. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Les photos sont assez vertes. Altitude de vol: environ 2700 mètres au-dessus du sol. Résolution : 12 cm au sol par pixel. Couverture % : 60/60. Date de la photographie: 8 mai 2016. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Tá na pictiúir glas go leor. Airde eitilte: Thart ar 2700 méadar os cionn na talún. Rún: 12 cm ar an talamh in aghaidh an phicteilín. Clúdach %: 60/60. Dáta an ghrianghraif: 8 Bealtaine 2016. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Slike su prilično zelene. Visina leta: Oko 2700 metara iznad tla. Rezolucija: 12 cm na tlu po pikselu. Postotak pokrivenosti: 60/60. Datum fotografije: 8. svibnja 2016. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. A képek elég zöldek. Repülési magasság: 2700 méterrel a föld felett. Állásfoglalás: 12 cm a földön pixelenként. Lefedettség %: 60/60. Fénykép dátuma: 2016. május 8. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Le foto sono abbastanza verdi. Altitudine di volo: a circa 2700 metri dal suolo. Risoluzione: 12 cm a terra per pixel. Copertura %: 60/60. Data della fotografia: 8 maggio 2016. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Nuotraukos yra gana žalios. Skrydžio aukštis: apie 2700 metrų virš žemės. Rezoliucija 12 cm ant žemės vienam pikseliui. Aprėptis %: 60/60. Fotografavimo data: 2016 m. gegužės 8 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Attēli ir diezgan zaļi. Lidojuma absolūtais augstums: Apmēram 2700 metrus virs zemes. Izšķirtspēja: 12 cm uz zemes uz pikseli. Aptvērums %: 60/60. Fotogrāfijas datums: 2016. gada 8. maijs. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. Ir-ritratti huma pjuttost ħodor. L-altitudni tat-titjira: madwar 2700 metru 'l fuq mill-art. Riżoluzzjoni: 12-il cm fuq l-art għal kull pixel. Kopertura %: 60/60. Data tar-ritratt: 8 ta' Mejju 2016. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. De foto's zijn vrij groen. Vlieghoogte: Ongeveer 2700 meter boven de grond. Resolutie: 12 cm op de grond per pixel. Dekking %: 60/60. Datum van de foto: 8 mei 2016. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Zdjęcia są dość zielone. Wysokość bezwzględna lotu: 2700 metrów nad ziemią. Rozdzielczość: 12 cm na ziemi na piksel. Zasięg %: 60/60. Data zdjęcia: 8 maja 2016 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. As imagens são bastante verdes. Altitude de voo: cerca de 2700 metros acima do solo. Resolução: 12 cm no chão por pixel. Cobertura %: 60/60. Data da fotografia: 8 de maio de 2016. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Imaginile sunt destul de verzi. Altitudinea de zbor: aproximativ 2700 de metri deasupra solului. Rezoluție: 12 cm pe sol per pixel. Acoperire %: 60/60. Data fotografiei: 8 mai 2016. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Fotky sú dosť zelené. Letová nadmorská výška: asi 2700 metrov nad zemou. Uznesenie: 12 cm na zem na pixel. Pokrytie %: 60/60. Dátum fotografie: 8. máj 2016. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. Slike so precej zelene. nadmorska višina leta: približno 2700 metrov nad tlemi. Resolucija: 12 cm na tleh na slikovno piko. Pokritost v %: 60/60. Datum fotografiranja: 8. maj 2016. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Bilderna är ganska gröna. Flyghöjd: ca 2700 meter över marken. Upplösning: 12 cm på marken per pixel. Övertäckning %: 60/60. Fotograferingsdatum: 8 maj 2016. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Картинки досить зелені. Висота польоту: близько 2700 метрів над землею. Роздільна здатність: 12 см на землі на піксель. Покриття %: 60/60. Дата фотографії: 8 травня 2016 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b0n0"},"dct:temporal":{"@id":"_:10ca7dc42492a3eab5ef79d70d1f73efd3c3f3d622bece3acaac57469e10332c_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Orthofoto / Ортофото (2016)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (2016) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ορθοφύτο (2016)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (2016.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (2016) - Videó letöltés mp3-ban"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (2016 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (2016) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (2016) - Kto odpowiedział?"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (2016)"},{"@language":"sv","@value":"SBK Ortofoto (2016)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2016)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/1301cb35-2201-4273-83ce-915fb64a453c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2016"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst Ortofoto 2016",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2016"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2016"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2016"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2016"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2016"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2016"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2016"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2016"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2016"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2016"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2016"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2016"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2016"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2016"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2016"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2016"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2016"},{"@language":"nl-t-sv-t0-