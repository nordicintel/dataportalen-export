i-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2009"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2009"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2009"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2009"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2009"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2009"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2009"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2009"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2009"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS service Ortofoto 2009"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2009"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2009"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2009"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2009"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2009"},{"@language":"uk-t-sv-t0-mtec","@value":"Сервіс WMS Ortofoto 2009"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f771fba1-c560-4d1f-a2dd-e6f64e4f7b89"}},{"@id":"http://data.europa.eu/88u/record/a83503d8-bafc-4ce7-8026-1335da28c559","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/a1cb2150-8360-434b-90a3-f8827e175f7f"},{"@id":"http://data.europa.eu/88u/distribution/f580d8ee-9e7b-4357-a843-6e59db2c7ffb"},{"@id":"http://data.europa.eu/88u/distribution/f771fba1-c560-4d1f-a2dd-e6f64e4f7b89"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"a83503d8-bafc-4ce7-8026-1335da28c559","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:00Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:37:49Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/a83503d8-bafc-4ce7-8026-1335da28c559"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/a83503d8-bafc-4ce7-8026-1335da28c559"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:00Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:37:49Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"a83503d8-bafc-4ce7-8026-1335da28c559","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b"},{"@graph":[{"@id":"_:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=4563bcc3-9739-46ad-994e-9479c51fdb9d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1961-01-01"},"dct:description":{"@language":"sv","@value":"En detaljplan reglerar bebyggelsen inom ett visst område eller fastighet. Den anger bland annat var hus får placeras, hur höga de får vara och vad de får användas till. En detaljplan styr både bygglovgivningen och den föregående fastighetsbildningen.Varje detaljplan avgränsas av en planområdesgräns. Planområdesgränsen anger vilket geografiskt område detaljplanen omfattar. Läs mer under https://www.boverket.se/sv/PBL-kunskapsbanken/planering/detaljplan/planbestammelser/gransbeteckningar/Denna datamängd visar planer (detaljplaner, stadsplaner, byggnadsplaner, generalplan, tomtindelningar, fastighetsplaner, ändring av detaljplan och avstyckningsplaner) i Stockholms stad som har vunnit laga kraft samt för områden där ett detaljplanearbete pågår. I varje yta står det planens diarienummer (t ex 7538 eller P2012-13546). Planhandlingar finns i Bygg- och plantjänsten och går att slå upp via diarienumret. Söksida för gällande planer: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Söksida för pågående planarbeten: http://insynsbk.stockholm.se/Byggochplantjansten/Pagaende-planarbete/PagaendePlanarbete/"},"dct:identifier":"7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","dct:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Detaljplaner mm - planområdesgränser för gällande planer och pågående detaljplanearbeten (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_PLANOVERSIKT?layers=PL_Planer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Detaljplaner (planområdesgränser för gällande planer och pågående planarbeten)"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_PLANOVERSIKT?layers=PL_Planer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Detaljplaner (planområdesgränser för gällande planer och pågående planarbeten)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beslutade-skatteuppgifter/1.0.1/%2523dataset","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beslutade-skatteuppgifter/1.0.1/%2523distribution"},"dcat:keyword":[{"@language":"sv","@value":" skatter"},{"@language":"sv","@value":"redovisning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Beslutade skatteuppgifter kan användas för att hämta information (beslutade skatteuppgifter) från inkomstdeklarationer, för både personer och företag och för ett eller flera år. Det krävs lagstöd för att ansluta till API:et."},"dct:issued":{"@type":"xsd:date","@value":"2025-03-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Beslutade skatteuppgifter"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beslutade-skatteuppgifter/1.0.1/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beslutade-skatteuppgifter/1.0.1/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beslutade-skatteuppgifter/1.0.1/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beslutade-skatteuppgifter/1.0.1/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beslutade-skatteuppgifter/1.0.1/swagger.json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2025-03-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Beslutade skatteuppgifter"}}],"@id":"urn:source:d173c0ad2072f3d86e57511b5ac7ddbb92c9fd6494ef4e34e995898b40f2b15e"},{"@graph":[{"@id":"_:d29f30093fe3ff2ccb8d8a7073112d91ac9b0c89524c71b6b7ee72cd4f2c3ad2_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:d29f30093fe3ff2ccb8d8a7073112d91ac9b0c89524c71b6b7ee72cd4f2c3ad2_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"25d7ea4e4712ec563eb980a302e2774a6b"},{"@id":"http://data.europa.eu/88u/dataset/d5120658-cada-4216-8af2-c82bad8ab91f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5e1b54a8-32aa-4d8d-b322-5e179d9c6c5f"},{"@id":"http://data.europa.eu/88u/distribution/5e2e0fd7-247d-4833-baea-2143ce9fca2e"},{"@id":"http://data.europa.eu/88u/distribution/a3dc32ee-332d-4f33-a758-88d109e4c1e3"},{"@id":"http://data.europa.eu/88u/distribution/be375861-5bd9-42e4-8c82-cce8e0b762e6"},{"@id":"http://data.europa.eu/88u/distribution/c609d81a-4436-47ad-8748-bc13799d985e"},{"@id":"http://data.europa.eu/88u/distribution/cd56d944-dc66-4096-bbd4-f665e8ce1c4b"},{"@id":"http://data.europa.eu/88u/distribution/db730351-d17a-4b1a-a736-6b05003b1b89"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=453cca6f-29bd-4556-aa64-4dd12abc77a1"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Стокхолмските карти са комбинация от картите за преглед на картата на града (скала 1:4000) и градската карта (скала 1:15000), където съдържанието е адаптирано, така че да можете удобно да увеличите картата в голям диапазон от мащаби. Затъмнената цветова схема прави картите от Стокхолм подходящи като фон, когато друга информация трябва да бъде представена с по-видима цветова схема. Картите от Стокхолм съдържат например застроени райони, сгради, съоръжения, пътища, имена на пътища, GC пътища, железопътни мрежи и зелени площи. Препоръчва се приложенията, изпълняващи препоръките на WMS Tiling Client, да използват допълнителната услуга WMS."},{"@language":"cs-t-sv-t0-mtec","@value":"Stockholmské mapy jsou kombinací přehledových map města (měřítko 1:4000) a městské mapy (měřítko 1:15000), kde byl obsah upraven tak, abyste mohli mapu pohodlně přiblížit ve velkém rozsahu měřítek. Díky tlumenému barevnému schématu jsou stockholmské mapy vhodné jako pozadí, pokud mají být další informace prezentovány s výraznějším barevným schématem.Stockholmské mapy obsahují například zastavěné oblasti, budovy, zařízení, silnice, názvy silnic, silnice GC, železniční sítě a zelené plochy. Doporučuje se, aby aplikace implementující doporučení klienta WMS Tiling používaly přidanou službu WMS."},{"@language":"da-t-sv-t0-mtec","@value":"Stockholm-kortene er en blanding af bykortoversigtskortene (skala 1:4000) og bykortet (skala 1:15000), hvor indholdet er blevet tilpasset, så du nemt kan zoome ind på kortet i en lang række skalaer. Det dæmpede farveskema gør Stockholmkortene egnede som baggrund, når andre oplysninger skal præsenteres med et mere fremtrædende farveskema. Stockholmkortene indeholder f.eks. bebyggede områder, bygninger, faciliteter, veje, vejnavne, GC-veje, jernbanenet og grønne områder. programmer, der implementerer WMS Tiling Client Recommendation, anbefales at bruge den tilføjede WMS-tjeneste."},{"@language":"de-t-sv-t0-mtec","@value":"Die Stockholmer Karten sind eine Mischung aus den Stadtkarten-Übersichtskarten (Maßstab 1:4000) und der Stadtkarte (Maßstab 1:15000), bei der der Inhalt so angepasst wurde, dass Sie die Karte bequem in einer großen Skala vergrößern können. Durch die gedimmte Farbgebung eignen sich die Stockholmer Karten als Hintergrund, wenn andere Informationen mit einer markanteren Farbgebung dargestellt werden sollen.Die Stockholmer Karten enthalten beispielsweise bebaute Gebiete, Gebäude, Einrichtungen, Straßen, Straßennamen, GC-Straßen, Schienennetze und Grünflächen. Anwendungen, die die WMS Tiling Client-Empfehlung implementieren, wird empfohlen, den hinzugefügten WMS-Dienst zu verwenden."},{"@language":"el-t-sv-t0-mtec","@value":"Οι χάρτες της Στοκχόλμης είναι ένας συνδυασμός των χαρτών επισκόπησης του χάρτη της πόλης (κλίμακα 1:4000) και του αστικού χάρτη (κλίμακα 1:15000) όπου το περιεχόμενο έχει προσαρμοστεί έτσι ώστε να μπορείτε να ζουμάρετε άνετα στο χάρτη σε ένα μεγάλο εύρος κλιμάκων. Οι χάρτες της Στοκχόλμης περιλαμβάνουν, για παράδειγμα, κατοικημένες περιοχές, κτίρια, εγκαταστάσεις, οδούς, ονομασίες οδών, οδούς GC, σιδηροδρομικά δίκτυα και χώρους πρασίνου. οι εφαρμογές που υλοποιούν τη σύσταση πελάτη πλακιδίων WMS συνιστώνται να χρησιμοποιούν την πρόσθετη υπηρεσία WMS."},{"@language":"en-t-sv-t0-mtec","@value":"The Stockholm maps are a mix of the city map overview maps (scale 1:4000) and the urban map (scale 1:15000) where the content has been adapted so that you can comfortably zoom in the map in a large range of scales. The dimmed colour scheme makes the Stockholm maps suitable as a background when other information is to be presented with a more prominent colour scheme.The Stockholm maps contain, for example, built-up areas, buildings, facilities, roads, road names, GC roads, rail networks and green areas. applications implementing the WMS Tiling Client Recommendation are recommended to use the added WMS service."},{"@language":"es-t-sv-t0-mtec","@value":"Los mapas de Estocolmo son una mezcla de los mapas de visión general del mapa de la ciudad (escala 1:4000) y el mapa urbano (escala 1:15000) donde el contenido se ha adaptado para que pueda ampliar cómodamente el mapa en una amplia gama de escalas. El esquema de colores atenuados hace que los mapas de Estocolmo sean adecuados como fondo cuando se va a presentar otra información con un esquema de colores más prominente. Los mapas de Estocolmo contienen, por ejemplo, zonas urbanizadas, edificios, instalaciones, carreteras, nombres de carreteras, carreteras GC, redes ferroviarias y zonas verdes. Se recomienda que las aplicaciones que implementen la recomendación del cliente de WMS Tiling utilicen el servicio WMS agregado."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi kaardid on segu linnakaardi ülevaatlikest kaartidest (skaalal 1:4000) ja linnakaardist (skaalal 1:15000), mille sisu on kohandatud nii, et saate kaardil mugavalt suuremõõtmeliselt suumida. Hämardatud värvilahendus muudab Stockholmi kaardid taustaks, kui muud teavet esitatakse silmapaistvama värvilahendusega.Stockholmi kaardid sisaldavad näiteks hoonestatud alasid, hooneid, rajatisi, teid, teenimesid, GC maanteid, raudteevõrke ja haljasalasid. WMS Tiling Client soovitust rakendavatel rakendustel soovitatakse kasutada lisatud WMS-teenust."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman kartat ovat sekoitus kaupungin kartan yleiskarttoja (mittakaava 1:4000) ja kaupungin karttaa (mittakaava 1:15000), jossa sisältöä on mukautettu niin, että voit mukavasti zoomata karttaa laajalla mittakaavalla. Himmeän värimaailman ansiosta Tukholman kartat soveltuvat taustaksi, kun muita tietoja esitetään näkyvämmin värimaailmalla.Tukholman kartat sisältävät esimerkiksi rakennettuja alueita, rakennuksia, tiloja, teitä, teiden nimiä, GC-teitä, rautatieverkkoja ja viheralueita. WMS Tiling Client -suosituksen täytäntöönpanevia sovelluksia suositellaan käyttämään lisättyä WMS-palvelua."},{"@language":"fr-t-sv-t0-mtec","@value":"Les cartes de Stockholm sont un mélange des cartes de vue d'ensemble de la carte de la ville (échelle 1:4000) et de la carte urbaine (échelle 1:15000) où le contenu a été adapté afin que vous puissiez zoomer confortablement sur la carte dans une large gamme d'échelles. Les cartes de Stockholm contiennent, par exemple, des zones bâties, des bâtiments, des installations, des routes, des noms de routes, des routes du GC, des réseaux ferroviaires et des espaces verts. Il est recommandé aux applications mettant en œuvre la recommandation WMS Tiling Client d'utiliser le service WMS ajouté."},{"@language":"ga-t-sv-t0-mtec","@value":"Is meascán iad léarscáileanna Stócólm de léarscáileanna forbhreathnaithe léarscáil na cathrach (scála 1:4000) agus an léarscáil uirbeach (scála 1:15000) inar cuireadh an t-ábhar in oiriúint ionas gur féidir leat súmáil isteach go compordach ar an léarscáil i raon mór scálaí. Fágann an scéim dathanna dimmed go bhfuil léarscáileanna Stócólm oiriúnach mar chúlra nuair atá faisnéis eile le cur i láthair le scéim dathanna níos suntasaí.Tá, mar shampla, limistéir fhoirgnithe, foirgnimh, saoráidí, bóithre, ainmneacha bóithre, bóithre GC, gréasáin iarnróid agus limistéir ghlasa i léarscáileanna Stócólm. moltar d’fheidhmchláir lena gcuirtear Moladh Cliant Teilgin WMS chun feidhme an tseirbhís WMS bhreise a úsáid."},{"@language":"hr-t-sv-t0-mtec","@value":"Stockholmske karte mješavina su karata s pregledom karte grada (skala 1:4000) i urbane karte (skala 1:15000) na kojoj je sadržaj prilagođen tako da možete udobno zumirati kartu u velikom broju skala. Zbog prigušene sheme boja karte u Stockholmu prikladne su kao pozadina za prikaz drugih informacija s istaknutijom shemom boja. Stockholmske karte sadržavaju, na primjer, izgrađena područja, zgrade, objekte, ceste, nazive cesta, zelene ceste, željezničke mreže i zelene površine. aplikacijama za provedbu preporuke klijenta za povezivanje WMS-a preporučuje se korištenje dodane usluge WMS-a."},{"@language":"hu-t-sv-t0-mtec","@value":"A stockholmi térképek a várostérkép-áttekintő térképek (1:4000) és a városi térkép (1:15000) keveréke, ahol a tartalmat úgy alakították ki, hogy kényelmesen nagyíthassa a térképet a skálák széles skáláján. A tompított színösszeállítás alkalmassá teszi a stockholmi térképeket háttérként arra az esetre, ha más információkat feltűnőbb színösszeállítással kell bemutatni. A stockholmi térképek például beépített területeket, épületeket, létesítményeket, utakat, útneveket, GC utakat, vasúthálózatokat és zöldterületeket tartalmaznak. A WMS Tiling Client Ajánlást megvalósító alkalmazások számára ajánlott a hozzáadott WMS szolgáltatás használata."},{"@language":"it-t-sv-t0-mtec","@value":"Le mappe di Stoccolma sono un mix delle mappe panoramiche della mappa della città (scala 1:4000) e della mappa urbana (scala 1:15000) in cui il contenuto è stato adattato in modo da poter comodamente ingrandire la mappa in una vasta gamma di scale. Lo schema di colori sfumati rende le mappe di Stoccolma adatte come sfondo quando altre informazioni devono essere presentate con uno schema di colori più prominente.Le mappe di Stoccolma contengono, ad esempio, aree edificate, edifici, strutture, strade, nomi di strade, strade GC, reti ferroviarie e aree verdi. Si raccomanda alle applicazioni che implementano la WMS Tiling Client Recommendation di utilizzare il servizio WMS aggiunto."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo žemėlapiai yra miesto žemėlapio apžvalgos žemėlapių (1:4000 mastelio) ir miesto žemėlapio (1:15000 mastelio) derinys, kuriame turinys buvo pritaikytas taip, kad galėtumėte patogiai priartinti žemėlapį dideliu masteliu. Pritemdytų spalvų schema leidžia Stokholmo žemėlapius naudoti kaip foną, kai kita informacija turi būti pateikiama su ryškesne spalvų schema. Stokholmo žemėlapiuose yra, pavyzdžiui, užstatytos teritorijos, pastatai, įrenginiai, keliai, kelių pavadinimai, GC keliai, geležinkelių tinklai ir žaliosios zonos. programoms, įgyvendinančioms WMS Tiling Client rekomendaciją, rekomenduojama naudotis pridėta WMS paslauga."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas kartes ir pilsētas kartes pārskata karšu (mērogs 1:4000) un pilsētas kartes (mērogs 1:15000) kombinācija, kur saturs ir pielāgots, lai jūs varētu ērti tuvināt karti plašā mērogā. Aptumšotā krāsu shēma padara Stokholmas kartes piemērotas kā fons, kad cita informācija ir jāsniedz ar redzamāku krāsu shēmu.Stokholmas kartes ietver, piemēram, apbūvētas teritorijas, ēkas, iekārtas, ceļus, ceļu nosaukumus, GC ceļus, dzelzceļa tīklus un zaļās zonas. lietojumprogrammām, kas īsteno WMS Flīzēšanas klienta ieteikumu, ieteicams izmantot pievienoto WMS pakalpojumu."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-mapep ta’ Stokkolma huma taħlita tal-mapep ta’ ħarsa ġenerali tal-mappa tal-belt (skala 1:4000) u l-mappa urbana (skala 1:15000) fejn il-kontenut ġie adattat sabiex tkun tista’ tiżżumja b’mod komdu fil-mappa f’firxa kbira ta’ skali. L-iskema tal-kuluri dimmed tagħmel il-mapep ta’ Stokkolma xierqa bħala sfond meta informazzjoni oħra għandha tiġi ppreżentata bi skema tal-kuluri aktar prominenti. Il-mapep ta’ Stokkolma fihom, pereżempju, żoni mibnija, bini, faċilitajiet, toroq, ismijiet tat-toroq, toroq GC, networks ferrovjarji u żoni ekoloġiċi. l-applikazzjonijiet li jimplimentaw ir-Rakkomandazzjoni tal-Klijent tal-WMS Tiling huma rrakkomandati li jużaw is-servizz miżjud tad-WMS."},{"@language":"nl-t-sv-t0-mtec","@value":"De kaarten van Stockholm zijn een mix van de plattegronden van de stad (schaal 1:4000) en de plattegrond van de stad (schaal 1:15000) waar de inhoud is aangepast, zodat u comfortabel op de kaart kunt inzoomen op een groot aantal schalen. Het gedimde kleurenschema maakt de Stockholm-kaarten geschikt als achtergrond wanneer andere informatie moet worden gepresenteerd met een prominenter kleurenschema.De Stockholm-kaarten bevatten bijvoorbeeld bebouwde gebieden, gebouwen, voorzieningen, wegen, wegnamen, GC-wegen, spoorwegnetten en groene gebieden. Toepassingen die de WMS Tiling Client Recommendation implementeren, worden aanbevolen om de toegevoegde WMS-service te gebruiken."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapy sztokholmskie są połączeniem map przeglądowych mapy miasta (skala 1:4000) i mapy miejskiej (skala 1:15000), gdzie zawartość została dostosowana tak, aby można było wygodnie powiększać mapę w szerokim zakresie skal. Przyciemniona kolorystyka sprawia, że mapy sztokholmskie nadają się jako tło, gdy inne informacje mają być prezentowane w bardziej widocznym schemacie kolorystycznym. Mapy sztokholmskie zawierają na przykład obszary zabudowane, budynki, obiekty, drogi, nazwy dróg, drogi GC, sieci kolejowe i tereny zielone. Aplikacje wdrażające Rekomendację Klienta WMS Tiling polecane są do korzystania z dodanej usługi WMS."},{"@language":"pt-t-sv-t0-mtec","@value":"Os mapas de Estocolmo são uma mistura dos mapas gerais do mapa da cidade (escala 1:4000) e do mapa urbano (escala 1:15000), onde o conteúdo foi adaptado para que possa ampliar confortavelmente o mapa numa grande variedade de escalas. O esquema de cores escurecido torna os mapas de Estocolmo adequados como pano de fundo quando outras informações devem ser apresentadas com um esquema de cores mais proeminente. Os mapas de Estocolmo contêm, por exemplo, áreas construídas, edifícios, instalações, estradas, designações de estradas, estradas GC, redes ferroviárias e zonas verdes. Recomenda-se que as aplicações que implementam a Recomendação do Cliente WMS Tiling utilizem o serviço WMS adicionado."},{"@language":"ro-t-sv-t0-mtec","@value":"Hărțile Stockholm sunt o combinație între hărțile de ansamblu ale hărților orașului (scala 1:4000) și harta urbană (scala 1:15000), unde conținutul a fost adaptat astfel încât să puteți mări confortabil harta într-o gamă largă de scări. Schema de culori estompate face ca hărțile Stockholm să fie adecvate ca fundal atunci când alte informații urmează să fie prezentate cu o schemă de culori mai proeminentă.Hărțile Stockholm conțin, de exemplu, zone construite, clădiri, facilități, drumuri, denumiri de drumuri, drumuri GC, rețele feroviare și zone verzi. Aplicațiile care implementează recomandarea WMS Tiling Client sunt recomandate să utilizeze serviciul WMS adăugat."},{"@language":"sk-t-sv-t0-mtec","@value":"Štokholmské mapy sú kombináciou máp s prehľadom miest (mierka 1:4000) a mestskej mapy (mierka 1:15000), kde bol obsah upravený tak, aby ste mohli pohodlne priblížiť mapu vo veľkom rozsahu mierok. Štokholmské mapy obsahujú napríklad zastavané oblasti, budovy, zariadenia, cesty, názvy ciest, cesty GC, železničné siete a zelené plochy. Aplikácie implementujúce odporúčanie klienta WMS Tiling sa odporúčajú používať pridanú službu WMS."},{"@language":"sl-t-sv-t0-mtec","@value":"Stockholmski zemljevidi so mešanica zemljevidov pregleda mestnih zemljevidov (lestvica 1:4000) in urbanega zemljevida (lestvica 1:15000), kjer je bila vsebina prilagojena tako, da lahko udobno povečate zemljevid v velikem razponu lestvic. Zaradi zatemnjene barvne sheme so stockholmski zemljevidi primerni kot ozadje, kadar je treba druge informacije predstaviti z vidnejšo barvno shemo. Stockholmski zemljevidi vsebujejo na primer pozidana območja, stavbe, objekte, ceste, imena cest, ceste GC, železniška omrežja in zelene površine. aplikacijam, ki izvajajo priporočilo odjemalca za tlakovanje WMS, se priporoča uporaba dodane storitve WMS."},{"@language":"sv","@value":"Stockholmskartorna är en blandning av översiktskartorna Stadskartan (skala 1:4000) och Tätortskartan (skala 1:15000) där innehållet har anpassats så att man bekvämt kan zooma i kartan i ett stort skalintervall. Den nedtonade färgsättningen gör Stockholmskartorna lämpliga som bakgrund när annan information ska presenteras med mer framträdande färgsättning.Stockholmskartorna innehåller t ex bebyggelseområden, byggnader, anläggningar, vägar, vägnamn, GC-vägar, spårnät och grönområden.Gällande WMS-tjänsterna: applikationer som implementerar WMS Tiling Client Recommendation rekommenderas att använda den tilade WMS-tjänsten."},{"@language":"uk-t-sv-t0-mtec","@value":"Карти Стокгольма - це суміш карт огляду карти міста (масштаб 1:4000) та міської карти (масштаб 1:15000), де вміст було адаптовано, щоб ви могли зручно збільшувати карту у великому діапазоні масштабів. Затемнена колірна схема робить карти Стокгольма придатними в якості фону, коли інша інформація повинна бути представлена з більш помітною колірною схемою. додатків, що реалізують рекомендацію WMS Tiling Client Recommendation, рекомендується використовувати доданий сервіс WMS."}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"d5120658-cada-4216-8af2-c82bad8ab91f","dct:issued":{"@type":"xsd:date","@value":"2014-03-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:d29f30093fe3ff2ccb8d8a7073112d91ac9b0c89524c71b6b7ee72cd4f2c3ad2_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Стокхолм карта (няколко варианта) (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Stockholm mapa (několik variant) (interní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Stockholm kort (flere varianter) (intern SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stockholm Karte (mehrere Varianten) (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Stockholm map (διάφορες παραλλαγές) (εσωτερικό SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Stockholm map (several variants) (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa de Estocolmo (varias variantes) (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Stockholm kaart (mitu varianti) (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Tukholman kartta (useita muunnelmia) (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte SBK Stockholm (plusieurs variantes) (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Stócólm SBK (roinnt leaganacha) (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Stockholm karta (nekoliko varijanti) (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Stockholm térkép (több változat) (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa SBK di Stoccolma (diverse varianti) (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Stokholmo žemėlapis (keli variantai) (vidinis SBK)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Stokholmas karte (vairāki varianti) (iekšējā SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"Mappa ta’ Stokkolma tal-SBK (diversi varjanti) (SBK interna)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Stockholm kaart (verschillende varianten) (interne SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Sztokholm mapa (kilka wariantów) (wewnętrzny SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Mapa de Estocolmo (várias variantes) (SBK interno)"},{"@languag