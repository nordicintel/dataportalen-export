://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"119f5c3193b61976c6dc470dcea8cc75e7"},{"@id":"http://data.europa.eu/88u/dataset/2a64e957-9133-41b1-a101-05196d12df33","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64"},{"@id":"http://data.europa.eu/88u/distribution/a5bac006-a23e-4ec7-8e5d-75e84024ce51"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=59b72fb2-0588-4fda-88af-53d7772055bc"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"Stockholms stadsmuseum ansvarar för att peka ut och definiera kulturhistoriskt värdefull bebyggelse i Stockholms stad. Klassificeringen grundas på de inventeringar Stadsmuseet kontinuerligt gjort sedan 1970-talet och omfattar bebyggelse uppförd före 1960 eller 1990. Ställningstagandet om stadens kulturhistoriska klassificering fattas av Stadsmuseets chef, stadsantikvarien, på delegation av kommunfullmäktige. Klassificering av stadens bebyggelse är ett pågående arbete och nya klassificeringar förs in på den digitala kartan."},"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"2a64e957-9133-41b1-a101-05196d12df33","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@value":"Stadsmuseets kulturhistoriska klassifcieringskarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/dpwebmap/cust_sth/kul/klassificering/DPWebMap.html"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:Information/1","dct:title":"Kartapplikation (DP/webmap) -Stockholms stadsmuseums kulturhistoriska klassificeringskarta","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64"}},{"@id":"http://data.europa.eu/88u/distribution/a5bac006-a23e-4ec7-8e5d-75e84024ce51","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/dpmap/cust_sth/kul/web/WMS_KUL_KLASSIFICERING_DPWEBMAP?"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:OGC:WMS/2","dct:title":"Kulturhistorisk klassificering (WMS)","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/a5bac006-a23e-4ec7-8e5d-75e84024ce51"}},{"@id":"http://data.europa.eu/88u/record/2a64e957-9133-41b1-a101-05196d12df33","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64"},{"@id":"http://data.europa.eu/88u/distribution/a5bac006-a23e-4ec7-8e5d-75e84024ce51"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"2a64e957-9133-41b1-a101-05196d12df33","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:24Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:01Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/2a64e957-9133-41b1-a101-05196d12df33"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:39d2c9767f76599d87c8f0f6efbb41a6e302935c53b26a4161c8a2d3a64a1df5_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/2a64e957-9133-41b1-a101-05196d12df33"},"https://piveau.eu/ns/voc#originalId":"2a64e957-9133-41b1-a101-05196d12df33","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Kulturförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:info.stadsmuseum@stockholm.se"}}],"@id":"urn:source:39d2c9767f76599d87c8f0f6efbb41a6e302935c53b26a4161c8a2d3a64a1df5"},{"@graph":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:39f8506790