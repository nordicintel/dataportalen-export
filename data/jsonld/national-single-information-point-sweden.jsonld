service@stockholm.se"}}],"@id":"urn:source:1a3e9db58f9894dc47cddcc5e6d66e09b5a6010fbb93e56964f93737f154f858"},{"@graph":[{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-20"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-20"}},{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"17b71cd433e7910d355431d6e99f32ad4f"},{"@id":"http://data.europa.eu/88u/dataset/dc08c358-e3a9-45a2-bc84-e36b10ce66b7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f53645a8-ea71-4fa0-bd8c-6524fee7f379"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000\""},"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b0n0"},"dct:temporal":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant (2025)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_Ortofoto_2025.pdf"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information:Produktspecfikation/3","dct:title":"Produktspecifikation","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"}},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2025"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:OGC:WMS/2","dct:title":"Ortofoto 2025","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"}},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information/1","dct:title":"Beställ kartor och geodata","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}},{"@id":"http://data.europa.eu/88u/record/dc08c358-e3a9-45a2-bc84-e36b10ce66b7","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:25Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:03Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/dc08c358-e3a9-45a2-bc84-e36b10ce66b7"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/dc08c358-e3a9-45a2-bc84-e36b10ce66b7"},"https://piveau.eu/ns/voc#originalId":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1"},{"@graph":[{"@id":"_:1d72088f17bcdb4818a2cbf7b98c4e0e94ad493cc6dd2a951959c26e1eb164b3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1d72088f17bcdb4818a2cbf7b98c4e0e94ad493cc6dd2a951959c26e1eb164b3_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1291263b3f72f5c7084719787aea059b6f"},{"@id":"http://data.europa.eu/88u/dataset/2f52d6da-6bcd-4181-a826-da5344de2d2f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/3df4c080-abc4-43ad-ab15-e8e1046e2925"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6edc5518-fac5-493c-bc6c-f6e7b1d9b992"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта на града — Други съоръжения се състоят от следните подтипове (подтипове) при информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Карта на града): 450660, Други съоръженияПодтипове10, Ospec. съоръжение, модифицирано, активно"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa města - Další zařízení sestávala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa města):450660, Další zařízeníSubtypes10, Ospec. zařízení, modifikovatelné, aktivní"},{"@language":"da-t-sv-t0-mtec","@value":"Bykort - Andre faciliteter bestod af følgende undertyper (undertyper) i klassificeringen af oplysninger for 2020 (se den nuværende liste i den generelle varespecifikation Bykort):450660, Andre faciliteterUndertype10, Ospec.-facilitet, modificerbar, aktiv"},{"@language":"de-t-sv-t0-mtec","@value":"Stadtplan - Weitere Einrichtungen bestanden aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Stadtplan):450660, Sonstige EinrichtungenSubtypen10, Ospec."},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης πόλης - Άλλες εγκαταστάσεις αποτελούνταν από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης πόλης):450660, Άλλες εγκαταστάσειςΥπότυποι10, εγκατάσταση Ospec., τροποποιήσιμη, ενεργή"},{"@language":"en-t-sv-t0-mtec","@value":"City map - Other facilities consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification City map):450660, Other facilitiesSubtypes10, Ospec. facility, modifiable, active"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de la ciudad - Otras instalaciones consistieron en los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual, véase la especificación general del producto Mapa de la ciudad):450660, Otras instalacionesSubtipos10, Instalación Ospec., modificable, activa"},{"@language":"et-t-sv-t0-mtec","@value":"Linnakaart – muud rajatised koosnesid 2020. aasta teabeklassifikatsiooni järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldine tootespetsifikaat Linnakaart):450660, Muud rajatisedAlltüübid10, Ospec. rajatis, muudetav, aktiivne"},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupungin kartta - Muut tilat koostuivat seuraavista alatyypeistä (alatyypit) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleistä tuote-eritelmästä Kaupungin kartta):450660, Muut tilatAlatyypit10, Ospec. facility, modifiable, active"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte de la ville - Autres installations se composait des sous-types suivants (sous-types) à la classification d'information 2020 (pour la liste actuelle voir Spécification générale du produit Carte de la ville):450660, Autres installationsSous-types10, Ospec. installation, modifiable, actif"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil chathrach - Is éard a bhí i saoráidí eile na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta atá ann faoi láthair féach Sonraíocht táirge ghinearálta Léarscáil chathrach):450660, Saoráidí eileFochineálacha10, Saoráid Ospec., inmhodhnaithe, gníomhach"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada – Ostala postrojenja sastojala su se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Karta grada): 450660, Ostala postrojenjaPodtipovi10, Vrsta postrojenja, promjenjivo, aktivno"},{"@language":"hu-t-sv-t0-mtec","@value":"Várostérkép - Az egyéb létesítmények a következő altípusokból (altípusokból) álltak a 2020. évi információs osztályozás szerint (az aktuális listát lásd az Általános termékleírásban) Várostérkép: 450660, Egyéb létesítmények10 altípus, Ospec. létesítmény, módosítható, aktív"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa della città - Altre strutture erano costituite dai seguenti sottotipi (sottotipi) nella classificazione delle informazioni 2020 (per l'elenco attuale vedere Specifiche generali del prodotto Mappa della città):450660, Altre struttureSottotipi10, Struttura Ospec., modificabile, attiva"},{"@language":"lt-t-sv-t0-mtec","@value":"Miesto žemėlapis. Kiti įrenginiai 2020 m. informacijos klasifikatoriuje (dabartinį sąrašą žr. Bendrojoje produkto specifikacijoje) buvo sudaryti iš šių potipių (potipių):450660, Kiti įrenginiai10 potipiai, Ospec. įrenginys, modifikuojamas, aktyvus"},{"@language":"lv-t-sv-t0-mtec","@value":"Pilsētas karte. Citas iekārtas sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu sk. vispārīgajā produkta specifikācijā “Pilsētas karte”): 450660, Citas iekārtasApakštipi10, Ospec. iekārta, modificējama, aktīva"},{"@language":"mt-t-sv-t0-mtec","@value":"- Faċilitajiet oħra kienu jikkonsistu mis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-Ispeċifikazzjoni ġenerali tal-prodott Mappa tal-belt): 450660, Faċilitajiet oħraSottotipi10, Faċilità Ospec., modifikabbli, attiva"},{"@language":"nl-t-sv-t0-mtec","@value":"Stadskaart - Andere faciliteiten bestonden uit de volgende subtypes (subtypes) bij de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Stadskaart):450660, Andere faciliteitenSubtypes10, Ospec. faciliteit, aanpasbaar, actief"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa miasta – Inne obiekty składające się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualny wykaz znajduje się w ogólnej specyfikacji produktu Mapa miasta):450660, Inne obiektyPodtypy10, Ospec. obiekt, modyfikowalny, aktywny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa da cidade - Outras instalações consistiam nos seguintes subtipos (subtipos) na classificação da informação de 2020 (para a lista atual, ver especificação geral do produto Mapa da cidade):450660, Outras instalaçõesSubtipos10, Ospec. instalação, modificável, ativo"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta orașului - Alte facilități au constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor 2020 (pentru lista actuală a se vedea Specificația generală a produsului Harta orașului):450660, Alte facilitățiSubtipuri10, Ospec. facilitate, modificabilă, activă"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa mesta - Ďalšie zariadenia pozostávali z týchto podtypov (podtypov) v klasifikácii informácií 2020 (pre aktuálny zoznam pozri všeobecnú špecifikáciu výrobku Mapa mesta):450660, Iné zariadeniaPodtypy10, Ospec. zariadenie, modifikovateľné, aktívne"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid mesta - Drugi objekti so bili v klasifikaciji informacij 2020 sestavljeni iz naslednjih podtipov (podtipov) (za trenutni seznam glej Splošno specifikacijo proizvoda Zemljevid mesta):450660, Drugi objektiPodtipi10, Ospec. objekt, spremenljiv, aktiven"},{"@language":"sv","@value":"Stadskarta - Övriga anläggningar bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :450660, Övrig anläggningUndertyper10, Ospec. anläggning, modifierbar, aktiv"},{"@language":"uk-t-sv-t0-mtec","@value":"Карта міста - Інші об'єкти складалися з наступних підтипів (підтипів) за інформаційною класифікацією 2020 (за поточним списком див."}],"dct:format":"text/html","dct:identifier":"2f52d6da-6bcd-4181-a826-da5344de2d2f","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1d72088f17bcdb4818a2cbf7b98c4e0e94ad493cc6dd2a951959c26e1eb164b3_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Карта на града - Други съоръжения"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Mapa města - Další zařízení"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Bykort - Andre faciliteter"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stadtplan - Sonstige Einrichtungen"},{"@language":"el-t-sv-t0-mtec"