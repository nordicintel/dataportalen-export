@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":{"@language":"sv","@value":"Registerkarta - Stadsdelsnämnder bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450170, StadsdelsnämndsområdeUndertyper10, Stadsdelsnämndsområde, modifierbar"},"dct:identifier":"f4e9ed75-3137-4a82-9f90-79907be0b3dd","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f45439c324010be6a65f305606a4a5b817417bb46d0d220112fcb61200489b8c_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Registerkarta - Stadsdelsnämnder"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f4e9ed75-3137-4a82-9f90-79907be0b3dd#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=445799076_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Registerkartan"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:f45439c324010be6a65f305606a4a5b817417bb46d0d220112fcb61200489b8c"},{"@graph":[{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n3"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n0"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b4n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"697d28215a6c3fce651a1f14a6de378981"},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b5n0","dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2428","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/179e95b7-cfc4-4a96-85f8-1a736a302ee2"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b6n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b6n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b6n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor."}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b7n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b7n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b7n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten beskriver permanent monterat hinder i form av vägräcken längs vägnätet. Den beskrivs som en sidouppdelad sträckutbredning på vägnätet. Dataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet  Identifiering av dataproduktspecifikationen/ Relaterad dataprodukt­specifikation."}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n0"},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. I de fall där de två körriktningarna separeras med ett vägräcke, sk. mittseparering till hinder mot mötande trafik och där de två körriktningarna generaliseras med två körbanor enligt generaliseringsreglerna för NVDBs vägnät, ska dataprodukten Vägräcke anges för båda körbanorna med markeringen Ja på attributet Gemensamt mitträcke."}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling har skett genom konvertering från företeelser av typen Vägräcke från Regionala företeelsedatabasen som endast har ajourhållits för vissa av Vägverkets regioner sedan 2006-01-01. Dessutom har konvertering genomförts från företeelser av dåvarande typen Mittbarriär som har ajourhållits sedan 2006-01-\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n1"},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n4"}]},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n0"},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n5"}]},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b8n5"},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b9n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b9n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b9n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-trafikverket-se-store-1-resource-2427","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/179e95b7-cfc4-4a96-85f8-1a736a302ee2"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=2427&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Guard rail"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1060V%C3%A4gr%C3%A4cke.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-05-04"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Продуктът за данни се отнася до постоянно монтирани пътни парапети с цел смекчаване на последиците от повреда на движещи се превозни средства или насрещно движение, както и на техните водачи и пътници."},{"@language":"cs-t-sv-t0-mtec","@value":"Datovým produktem se rozumí trvale instalované silniční zábradlí za účelem zmírnění následků škod na řízení vozidel nebo protijedoucích dopravních prostředcích, jakož i na řidičích a cestujících."},{"@language":"da-t-sv-t0-mtec","@value":"Dataproduktet henviser til permanent monterede rækværk med det formål at afbøde konsekvenserne af skader på køretøjer eller modkørende trafik samt dets førere og passagerer."},{"@language":"de-t-sv-t0-mtec","@value":"Das Datenprodukt bezieht sich auf fest installierte Straßengeländer mit dem Ziel, die Folgen von Schäden an fahrenden Fahrzeugen oder Gegenverkehr sowie deren Fahrern und Fahrgästen abzumildern."},{"@language":"el-t-sv-t0-mtec","@value":"Το προϊόν δεδομένων αναφέρεται σε μόνιμα εγκατεστημένα οδικά κιγκλιδώματα με σκοπό τον μετριασμό των συνεπειών των ζημιών στην οδήγηση οχημάτων ή στην εισερχόμενη κυκλοφορία, καθώς και στους οδηγούς και τους επιβάτες τους."},{"@language":"en-t-sv-t0-mtec","@value":"The data product refers to permanently installed road railings with the purpose of mitigating the consequences of damage to driving vehicles or oncoming traffic, as well as its drivers and passengers."},{"@language":"es-t-sv-t0-mtec","@value":"El producto de datos se refiere a barandillas de carretera instaladas permanentemente con el fin de mitigar las consecuencias de los daños a la conducción de vehículos o al tráfico en sentido contrario, así como a sus conductores y pasajeros."},{"@language":"et-t-sv-t0-mtec","@value":"Andmetoode viitab püsivalt paigaldatud maanteepiiretele, mille eesmärk on leevendada sõidukite juhtimisele või vastutulevale liiklusele, samuti selle juhtidele ja reisijatele tekitatud kahju tagajärgi."},{"@language":"fi-t-sv-t0-mtec","@value":"Tietotuotteella tarkoitetaan kiinteästi asennettuja kaiteita, joiden tarkoituksena on lieventää ajoneuvojen kuljettamiselle tai vastaantulevalle liikenteelle sekä sen kuljettajille ja matkustajille aiheutuvien vahinkojen seurauksia."},{"@language":"fr-t-sv-t0-mtec","@value":"Le produit de données fait référence aux garde-corps routiers installés en permanence dans le but d'atténuer les conséquences des dommages causés à la conduite des véhicules ou à la circulation en sens inverse, ainsi qu'à ses conducteurs et à ses passagers."},{"@language":"ga-t-sv-t0-mtec","@value":"Tagraíonn an táirge sonraí do ráillí bóthair atá suiteáilte go buan chun na hiarmhairtí a bhaineann le damáiste d’fheithiclí tiomána nó do thrácht atá ag teacht chun cinn, chomh maith lena thiománaithe agus a phaisinéirí, a mhaolú."},{"@language":"hr-t-sv-t0-mtec","@value":"Podatkovni proizvod odnosi se na trajno postavljene cestovne ograde u svrhu ublažavanja posljedica oštećenja vozila ili nadolazećeg prometa, kao i njegovih vozača i putnika."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adattermék a tartósan felszerelt közúti korlátokra vonatkozik, amelyek célja a járművek vezetésében vagy a szembejövő forgalomban, valamint a járművezetőkben és az utasokban okozott károk következményeinek enyhítése."},{"@language":"it-t-sv-t0-mtec","@value":"Il prodotto dati si riferisce a ringhiere stradali installate in modo permanente allo scopo di mitigare le conseguenze dei danni alla guida di veicoli o al traffico in arrivo, nonché ai suoi conducenti e passeggeri."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų produktas – tai stacionariai įrengti kelių turėklai, kurių paskirtis – sušvelninti žalą vairuojančioms transporto priemonėms arba artėjančiam eismui, taip pat jų vairuotojams ir keleiviams."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu produkts attiecas uz pastāvīgi uzstādītām ceļa margām, kuru mērķis ir mazināt transportlīdzekļu vadīšanas vai pretimbraucošās satiksmes, kā arī tās vadītāju un pasažieru bojājumu sekas."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-prodott tad-data jirreferi għal linji ferrovjarji tat-triq installati b’mod permanenti bl-għan li jittaffew il-konsegwenzi tal-ħsara li ssir lis-sewqan tal-vetturi jew lit-traffiku li jkun ġej, kif ukoll lis-sewwieqa u lill-passiġġieri tagħhom."},{"@language":"nl-t-sv-t0-mtec","@value":"Het gegevensproduct verwijst naar permanent geïnstalleerde wegleuningen met als doel de gevolgen van schade aan rijdende voertuigen of tegemoetkomend verkeer, evenals de bestuurders en passagiers ervan, te beperken."},{"@language":"pl-t-sv-t0-mtec","@value":"Produkt danych odnosi się do trwale zainstalowanych barier drogowych w celu złagodzenia skutków uszkodzenia pojazdów prowadzących lub nadjeżdżających, a także ich kierowców i pasażerów."},{"@language":"pt-t-sv-t0-mtec","@value":"O produto de dados refere-se a grades rodoviárias instaladas permanentemente com o objetivo de atenuar as consequências dos danos causados à condução de veículos ou ao tráfego em sentido contrário, bem como aos seus condutores e passageiros."},{"@language":"ro-t-sv-t0-mtec","@value":"Produsul de date se referă la balustradele rutiere instalate permanent cu scopul de a atenua consecințele deteriorării vehiculelor de conducere sau a traficului din sens opus, precum și a conducătorilor auto și a pasagerilor."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový produkt sa vzťahuje na trvalo namontované cestné zábradlia s cieľom zmierniť dôsledky poškodenia riadenia vozidiel alebo protiidúcej dopravy, ako aj jeho vodičov a cestujúcich."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni produkt se nanaša na trajno nameščene cestne ograje z namenom ublažitve posledic poškodb voznih vozil ali nasproti vozečega prometa, pa tudi njihovih voznikov in potnikov."},{"@language":"sv","@value":"Dataprodukten avser permanent monterat vägräcke med syfte att mildra skadeföljden för avkörande fordon eller mötande trafik samt dess förare och passagerare."},{"@language":"uk-t-sv-t0-mtec","@value":"Даний продукт відноситься до постійно встановлених дорожніх перил з метою пом'якшення наслідків пошкодження ведучих транспортних засобів або зустрічного руху, а також його водіїв і пасажирів."}],"dct:format":"application/vnd.ogc.wms_xml","dct:issued":{"@type":"xsd:date","@value":"2026-08-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-18"},"dct:provenance":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b2n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Пътен парапет"},{"@language":"cs-t-sv-t0-mtec","@value":"Silniční zábradlí"},{"@language":"da-t-sv-t0-mtec","@value":"Rækværk"},{"@language":"de-t-sv-t0-mtec","@value":"Straßenleitplanke"},{"@language":"el-t-sv-t0-mtec","@value":"Οδικό προστατευτικό κιγκλίδωμα"},{"@language":"en-t-sv-t0-mtec","@value":"Road guardrail"},{"@language":"es-t-sv-t0-mtec","@value":"Barandilla de carretera"},{"@language":"et-t-sv-t0-mtec","@value":"Maanteepiire"},{"@language":"fi-t-sv-t0-mtec","@value":"Katujen suojakaiteet"},{"@language":"fr-t-sv-t0-mtec","@value":"Garde-corps routier"},{"@language":"ga-t-sv-t0-mtec","@value":"Ráillí cosanta bóthair"},{"@language":"hr-t-sv-t0-mtec","@value":"Cestovna zaštitara"},{"@language":"hu-t-sv-t0-mtec","@value":"Közúti védőkorlát"},{"@language":"it-t-sv-t0-mtec","@value":"guardrail stradale"},{"@language":"lt-t-sv-t0-mtec","@value":"Kelio apsauginiai turėklai"},{"@language":"lv-t-sv-t0-mtec","@value":"Ceļu aizsargdzelzceļš"},{"@language":"mt-t-sv-t0-mtec","@value":"Sistema ta' lqugħ tat-toroq"},{"@language":"nl-t-sv-t0-mtec","@value":"Vangrail op de weg"},{"@language":"pl-t-sv-t0-mtec","@value":"Poręcz drogowa"},{"@language":"pt-t-sv-t0-mtec","@value":"Guarda-rodoviária"},{"@language":"ro-t-sv-t0-mtec","@value":"Bară de protecție rutieră"},{"@language":"sk-t-sv-t0-mtec","@value":"Cestné zábradlie"},{"@language":"sl-t-sv-t0-mtec","@value":"Cestno varovalno ograjo"},{"@language":"sv","@value":"Vägräcke"},{"@language":"uk-t-sv-t0-mtec","@value":"Дорожня огорожа"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},"http://entryscape.org/terms/metadataIdentifier":"842e819d-7a63-43b1-a2a3-54638ea2225d","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Levereras vid beställning. Licens krävs."},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/RoadAuthority/term2"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/C"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"http://data.europa.eu/88u/distribution/179e95b7-cfc4-4a96-85f8-1a736a302ee2","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},"dcat:accessURL":{"@id":"http://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo?layers=V%C3%A4gr%C3%A4cke"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"NB: За достъп/изглед поставете връзката за адрес за достъп в съответния софтуер. След това изберете слоя, който съответства на набора от данни."},{"@language":"cs-t-sv-t0-mtec","@value":"Pozn.: Pro přístup/zobrazení vložte odkaz na přístupovou adresu do příslušného softwaru. Poté vyberte vrstvu, která odpovídá datové sadě."},{"@language":"da-t-sv-t0-mtec","@value":"NB: For adgang/visning skal du indsætte adgangsadresselinket i den relevante software. Vælg derefter det lag, der svarer til datasættet."},{"@language":"de-t-sv-t0-mtec","@value":"NB: Fügen Sie für den Zugriff/die Ansicht den Link zur Zugriffsadresse in die entsprechende Software ein. Wählen Sie dann die Ebene aus, die dem Datensatz entspricht."},{"@language":"el-t-sv-t0-mtec","@value":"ΣΗΜ.: Για πρόσβαση/προβολή, επικολλήστε τον σύνδεσμο διεύθυνσης πρόσβασης στο κατάλληλο λογισμικό. Στη συνέχεια, επιλέξτε το επίπεδο που αντιστοιχεί στο σύνολο δεδομένων."},{"@language":"en-t-sv-t0-mtec","@value":"N.B.: For access/view, paste the access address link into the appropriate software. Then select the layer that corresponds to the data set."},{"@language":"es-t-sv-t0-mtec","@value":"N.B.: Para acceder/ver, pegue el enlace de la dirección de acceso en el software apropiado. A continuación, seleccione la capa que corresponde al conjunto de datos."},{"@language":"et-t-sv-t0-mtec","@value":"NB! Juurdepääsuks/vaatamiseks kleebi juurdepääsu aadressi link vastavasse tarkvarasse. Seejärel valige andmekogumile vastav kiht."},{"@language":"fi-t-sv-t0-mtec","@value":"Huom. Jos haluat käyttää / tarkastella, liitä käyttöoikeusosoitelinkki asianmukaiseen ohjelmistoon. Valitse sitten tietojoukkoa vastaava taso."},{"@language":"fr-t-sv-t0-mtec","@value":"N.B.: Pour accéder/voir, collez le lien d'adresse d'accès dans le logiciel approprié. Sélectionnez ensuite la couche qui correspond à l'ensemble de données."},{"@language":"ga-t-sv-t0-mtec","@value":"N.B.: Chun rochtain/amharc a fháil, greamaigh an nasc seoladh rochtana isteach sna bogearraí iomchuí. Ansin roghnaigh an ciseal a fhreagraíonn don tacar sonraí."},{"@language":"hr-t-sv-t0-mtec","@value":"Napomena: Za pristup/pregled zalijepite poveznicu za pristupnu adresu u odgovarajući softver. Zatim odaberite sloj koji odgovara skupu podataka."},{"@language":"hu-t-sv-t0-mtec","@value":"Megjegyzés: A hozzáféréshez/megtekintéshez illessze be a hozzáférési cím hivatkozását a megfelelő szoftverbe. Ezután válassza ki az adatkészletnek megfelelő réteget."},{"@language":"it-t-sv-t0-mtec","@value":"N.B.: Per accedere/visualizzare, incollare il link dell'indirizzo di accesso nel software appropriato. Quindi selezionare il livello corrispondente al set di dati."},{"@language":"lt-t-sv-t0-mtec","@value":"N.B.: Norėdami pasiekti / peržiūrėti, įklijuokite prieigos adreso nuorodą į atitinkamą programinę įrangą. Tada pasirinkite duomenų rinkinį atitinkantį sluoksnį."},{"@language":"lv-t-sv-t0-mtec","@value":"NB! Lai piekļūtu/skatītu, ielīmējiet piekļuves adreses saiti attiecīgajā programmatūrā. Pēc tam atlasiet slāni, kas atbilst datu kopai."},{"@language":"mt-t-sv-t0-mtec","@value":"N.B.: Għal aċċess/dehra, ippejstja l-link tal-indirizz tal-aċċess fis-software xieraq. Imbagħad agħżel is-saff li jikkorrispondi għas-sett tad-data."},{"@language":"nl-t-sv-t0-mtec","@value":"N.B.: Voor toegang/weergave plakt u de link naar het toegangsadres in de juiste software. Selecteer vervolgens de laag die overeenkomt met de gegevensset."},{"@language":"pl-t-sv-t0-mtec","@value":"Uwaga: Aby uzyskać dostęp/widok, wklej link adresu dostępu do odpowiedniego oprogramowania. Następnie wybierz warstwę odpowiadającą zestawowi danych."},{"@language":"pt-t-sv-t0-mtec","@value":"N.B.: Para aceder/visualizar, cole a ligação do endereço de acesso no software adequado. Em seguida, selecione a camada que corresponde ao conjunto de dados."},{"@language":"ro-t-sv-t0-mtec","@value":"N.B.: Pentru acces/vizualizare, lipiți linkul adresei de acces în software-ul corespunzător. Apoi selectați stratul care corespunde setului de date."},{"@language":"sk-t-sv-t0-mtec","@value":"Pozn.: Pre prístup/zobrazenie vložte odkaz na prístupovú adresu do príslušného softvéru. Potom vyberte vrstvu, ktorá zodpovedá množine údajov."},{"@language":"sl-t-sv-t0-mtec","@value":"Opomba: Za dostop/ogled prilepite povezavo do naslova za dostop v ustrezno programsko opremo. Nato izberite plast, ki ustreza naboru podatkov."},{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},{"@language":"uk-t-sv-t0-mtec","@value":"Н.Б.: Для доступу/перегляду вставте посилання адреси доступу у відповідне програмне забезпечення. Потім виберіть шар, який відповідає набору даних."}],"dct:format":"application/vnd.ogc.wms_xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"NVDB Railing - показване в NetInfo"},{"@language":"cs-t-sv-t0-mtec","@value":"NVDB Railing - zobrazení v NetInfo"},{"@language":"da-t-sv-t0-mtec","@value":"NVDB Railing - display i NetInfo"},{"@language":"de-t-sv-t0-mtec","@value":"NVDB Geländer - Anzeige in NetInfo"},{"@language":"el-t-sv-t0-mtec","@value":"NVDB Railing - εμφάνιση στο NetInfo"},{"@language":"en-t-sv-t0-mtec","@value":"NVDB Railing - display in NetInfo"},{"@language":"es-t-sv-t0-mtec","@value":"NVDB Railing - visualización en NetInfo"},{"@language":"et-t-sv-t0-mtec","@value":"NVDB Piirded - kuvamine NetInfos"},{"@language":"fi-t-sv-t0-mtec","@value":"NVDB-kaide - näyttö NetInfossa"},{"@language":"fr-t-sv-t0-mtec","@value":"NVDB Railing - affichage dans NetInfo"},{"@language":"ga-t-sv-t0-mtec","@value":"NVDB Railing - taispeáint i NetInfo"},{"@language":"hr-t-sv-t0-mtec","@value":"NVDB Ograda - prikaz u NetInfo"},{"@language":"hu-t-sv-t0-mtec","@value":"NVDB korlát - kijelző a NetInfo-ban"},{"@language":"it-t-sv-t0-mtec","@value":"Ringhiera NVDB - visualizzazione in NetInfo"},{"@language":"lt-t-sv-t0-mtec","@value":"NVDB turėklai - ekranas NetInfo"},{"@language":"lv-t-sv-t0-mtec","@value":"NVDB margas - displejs NetInfo"},{"@language":"mt-t-sv-t0-mtec","@value":"NVDB Railing - display fil-NetInfo"},{"@language":"nl-t-sv-t0-mtec","@value":"NVDB Railing - weergave in NetInfo"},{"@language":"pl-t-sv-t0-mtec","@value":"Railing NVDB - wyświetlacz w NetInfo"},{"@language":"pt-t-sv-t0-mtec","@value":"NVDB Railing - exibição no NetInfo"},{"@language":"ro-t-sv-t0-mtec","@value":"Balustradă NVDB - afișare în NetInfo"},{"@language":"sk-t-sv-t0-mtec","@value":"NVDB Railing - zobrazenie v NetInfo"},{"@language":"sl-t-sv-t0-mtec","@value":"NVDB Ograja - prikaz v NetInfo"},{"@language":"sv","@value":"NVDB Vägräcke - visning i NetInfo"},{"@language":"uk-t-sv-t0-mtec","@value":"NVDB Railing - відображення в NetInfo"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-trafikverket-