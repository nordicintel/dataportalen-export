cations.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et kan användas för att lämna Inkomstdeklaration 1. Med API:et kan du bland annat hämta och visa upp förifyllda deklarationsuppgifter direkt i programvaran."},"dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Inkomstdeklaration 1"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/inkomstdeklaration1/1.0.4/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/inkomstdeklaration1/1.0.4/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/inkomstdeklaration1/1.0.4/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/inkomstdeklaration1/1.0.4/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/inkomstdeklaration1/1.0.4/swagger.json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Inkomstdeklaration 1"}}],"@id":"urn:source:7bad5ce16ce9226cd5742af75ce30cdebab2362daacea575deb03b7ff442035e"},{"@graph":[{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor."}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n0"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n1"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n10"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n6"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n4"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n5"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n0"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n1"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n10"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n4"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n5"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n7"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n8"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n9"}]},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n7"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n8"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n9"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/de