:"http://data.europa.eu/88u/distribution/b401cce7-267f-4589-9807-493cca2f8847"}},{"@id":"http://data.europa.eu/88u/distribution/babe36d5-8079-4454-ad27-be859b2bf5d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/babe36d5-8079-4454-ad27-be859b2bf5d1"}},{"@id":"http://data.europa.eu/88u/record/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/22c8c41c-0531-47ec-951f-ba86c2fb2eba"},{"@id":"http://data.europa.eu/88u/distribution/b401cce7-267f-4589-9807-493cca2f8847"},{"@id":"http://data.europa.eu/88u/distribution/babe36d5-8079-4454-ad27-be859b2bf5d1"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:53Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:d5184a351f2de179beee9dd4eadcc998ee430efe64567806236f6a7829460bf9_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:53Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthori