distribution/b0e859f6-cd36-491e-8e0d-b6876787c6c3"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b5n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2496","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/64aa8eca-2eef-45ad-be33-d23055716953"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b6n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2507","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0b4be5f8-23fa-42a5-bb0f-66246aacd764"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b7n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2509","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/cbd924d8-12e1-491e-aa19-c16897ed01b0"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b8n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2515","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/65a85efc-d827-4385-8b9c-f78a94ae5c3e"}},{"@id":"_:4dfc32551518ad1944ce53e3b41eccb3374c1c397cf4087642b67c8cd412e0ec_b9n0","dct:identifier":"https://skatteverket.entryscape.net/store/9/resource/2517","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/36f30857-47a5-48f1-8577-e6ac9a8fbaf1"}},{"@id":"http://data.europa.eu/88u/dataset/https-skatteverket-entryscape-net-store-9-resource-2453~~1","@type":"dcat:Dataset","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/00086b20-1adb-4c03-b37b-46779a3b8e7f"},{"@id":"http://data.europa.eu/88u/distribution/036af9ed-bee7-48ca-99f4-5e29fbc43320"},{"@id":"http://data.europa.eu/88u/distribution/0b4be5f8-23fa-42a5-bb0f-66246aacd764"},{"@id":"http://data.europa.eu/88u/distribution/0cf3ac4a-553d-4522-af19-440c6e35bfe5"},{"@id":"http://data.europa.eu/88u/distribution/1ca436d0-aff2-4ea3-b817-50c66c78d6d9"},{"@id":"http://data.europa.eu/88u/distribution/36f30857-47a5-48f1-8577-e6ac9a8fbaf1"},{"@id":"http://data.europa.eu/88u/distribution/40999c64-435a-457f-8e45-757a79284e46"},{"@id":"http://data.europa.eu/88u/distribution/64aa8eca-2eef-45ad-be33-d23055716953"},{"@id":"http://data.europa.eu/88u/distribution/65a85efc-d827-4385-8b9c-f78a94ae5c3e"},{"@id":"http://data.europa.eu/88u/distribution/6f184fa4-9a72-4dd2-ba4b-762a33ca6ce3"},{"@id":"http://data.europa.eu/88u/distribution/9e0cea62-6af5-4098-ba03-5430fcf33293"},{"@id":"http://data.europa.eu/88u/distribution/adf4e9d9-53f4-4f2d-905e-13d4110fa425"},{"@id":"http://data.europa.eu/88u/distribution/b0e859f6-cd36-491e-8e0d-b6876787c6c3"},{"@id":"http://data.europa.eu/88u/distribution/b9fa21a1-3b5d-4265-9742-5881053b6360"},{"@id":"http://data.europa.eu/88u/distribution/bf73e5a1-df84-497b-8aee-1b05ba1b854e"},{"@id":"http://data.europa.eu/88u/distribution/cbd924d8-12e1-491e-aa19-c16897ed01b0"},{"@id":"http://data.europa.eu/88u/distribution/d696770f-d5de-421e-a034-94da4cabad21"},{"@id":"http://data.europa.eu/88u/distribution/f5d47d76-5a45-46fe-9fa3-5fa2b3cc4851"},{"@id":"http://data.europa.eu/88u/distribution/f6af0108-09c8-4e9b-9db5-0c3a9bee7c3f"},{"@id":"http://data.europa.eu/88u/distribution/f8d06b7e-1118-4599-a017-4804b2d5f125"},{"@id":"http://data.europa.eu/88u/distribution/feaf837e-4e32-4c50-af02-b9c6ffb7faa5"}],"dcat:keyword":[{"@language":"sv","@value":"Avgifter"},{"@language":"sv","@value":"Deklaration"},{"@language":"sv","@value":"Skatter"},{"@language":"sv","@value":"Statistik"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Данъчният резултат (предишният резултат от данъчната оценка) съдържа информация за облагаемия с общински данък доход на физическите лица. Данните за цялото кралство са представени тук. Можете да видите данните, разбити по област и община."},{"@language":"cs-t-sv-t0-mtec","@value":"Daňový výsledek (dříve výsledek vyměření daně) obsahuje informace o obecně zdanitelných příjmech fyzických osob z výdělečné činnosti. Zde jsou uvedeny údaje za celé království. Můžete vidět údaje rozčleněné podle krajů a obcí."},{"@language":"da-t-sv-t0-mtec","@value":"Skatteresultatet (tidligere skatteansættelsesresultatet) indeholder oplysninger om fysiske personers kommunalt skattepligtige indkomst. Data for hele riget præsenteres her. Du kan se data opdelt efter amt og kommune."},{"@language":"de-t-sv-t0-mtec","@value":"Das Steuerergebnis (früher das Steuerfestsetzungsergebnis) enthält Informationen über das kommunal steuerpflichtige Erwerbseinkommen natürlicher Personen. Daten für das gesamte Königreich werden hier vorgestellt. Sie können die Daten nach Landkreis und Gemeinde aufgeschlüsselt sehen."},{"@language":"el-t-sv-t0-mtec","@value":"Το φορολογικό αποτέλεσμα (προηγουμένως το αποτέλεσμα της πράξης επιβολής φόρου) περιέχει πληροφορίες σχετικά με το δημοτικά φορολογητέο εισόδημα φυσικών προσώπων. Τα στοιχεία για ολόκληρο το βασίλειο παρουσιάζονται εδώ. Μπορείτε να δείτε τα δεδομένα κατανεμημένα ανά νομό και δήμο."},{"@language":"en-t-sv-t0-mtec","@value":"The tax outcome (previously the tax assessment outcome) contains information on the municipally taxable earned income of natural persons. Data for the entire kingdom are presented here. You can see the data broken down by county and municipality."},{"@language":"es-t-sv-t0-mtec","@value":"El resultado fiscal (anteriormente, el resultado de la evaluación fiscal) contiene información sobre los rendimientos del trabajo sujetos a impuestos municipales de las personas físicas. Los datos de todo el reino se presentan aquí. Puede ver los datos desglosados por condado y municipio."},{"@language":"et-t-sv-t0-mtec","@value":"Maksustamise tulemus (varem maksuotsuse tulemus) sisaldab teavet füüsiliste isikute kohalikul tasandil maksustatava teenitud tulu kohta. Siin on esitatud andmed kogu kuningriigi kohta. Näete andmeid maakonna ja omavalitsuse kaupa."},{"@language":"fi-t-sv-t0-mtec","@value":"Verotuksellinen tulos (aiemmin verotuksellinen tulos) sisältää tietoja luonnollisten henkilöiden kunnallisesti verotettavista ansiotuloista. Koko valtakunnan tiedot on esitetty tässä. Näet tiedot maakunnittain ja kunnittain eriteltyinä."},{"@language":"fr-t-sv-t0-mtec","@value":"Le résultat fiscal (précédemment le résultat de l’évaluation fiscale) contient des informations sur les revenus professionnels imposables des personnes physiques au niveau municipal. Les données pour l'ensemble du royaume sont présentées ici. Vous pouvez voir les données ventilées par comté et municipalité."},{"@language":"ga-t-sv-t0-mtec","@value":"Sa toradh cánach (toradh an mheasúnaithe cánach roimhe seo) tá faisnéis maidir le hioncam tuillte daoine nádúrtha atá inchánach go bardasach. Cuirtear sonraí maidir leis an ríocht ar fad i láthair anseo. Is féidir leat na sonraí a fheiceáil briste síos de réir contae agus bardais."},{"@language":"hr-t-sv-t0-mtec","@value":"Porezni ishod (prethodno porezni ishod) sadržava informacije o ostvarenom općinskom oporezivom dohotku fizičkih osoba. Podaci za cijelo kraljevstvo prikazani su ovdje. Možete vidjeti podatke raščlanjene po županijama i općinama."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adóeredmény (korábban az adómegállapítási eredmény) a természetes személyek önkormányzatilag adóköteles jövedelmére vonatkozó információkat tartalmaz. Az egész királyságra vonatkozó adatok itt találhatók. Az adatok megyei és települési bontásban is megtekinthetők."},{"@language":"it-t-sv-t0-mtec","@value":"L'esito fiscale (precedentemente l'esito dell'accertamento fiscale) contiene informazioni sul reddito da lavoro imponibile a livello comunale delle persone fisiche. I dati per l'intero regno sono presentati qui. Puoi vedere i dati disaggregati per contea e comune."},{"@language":"lt-t-sv-t0-mtec","@value":"Mokestinis rezultatas (anksčiau – mokestinio vertinimo rezultatas) apima informaciją apie fizinių asmenų savivaldybės apmokestinamąsias uždirbtas pajamas. Čia pateikiami visos karalystės duomenys. Galite matyti duomenis, suskirstytus pagal apskritis ir savivaldybes."},{"@language":"lv-t-sv-t0-mtec","@value":"Nodokļa iznākumā (iepriekš – nodokļa aprēķina iznākumā) ir ietverta informācija par fizisko personu ar pašvaldību nodokli apliekamajiem ienākumiem. Šeit ir sniegti dati par visu karaļvalsti. Jūs varat redzēt datus, kas sadalīti pa apgabaliem un pašvaldībām."},{"@language":"mt-t-sv-t0-mtec","@value":"L-eżitu tat-taxxa (li qabel kien l-eżitu tal-valutazzjoni tat-taxxa) fih informazzjoni dwar l-introjtu gwadanjat taxxabbli muniċipali ta’ persuni fiżiċi. Id-data għar-renju kollu hija ppreżentata hawn. Tista’ tara d-data mqassma skont il-kontea u l-muniċipalità."},{"@language":"nl-t-sv-t0-mtec","@value":"Het fiscaal resultaat (voorheen het fiscaal resultaat) bevat informatie over het gemeentelijk belastbaar inkomen uit arbeid van natuurlijke personen. Gegevens voor het hele koninkrijk worden hier gepresenteerd. U kunt de gegevens per provincie en gemeente bekijken."},{"@language":"pl-t-sv-t0-mtec","@value":"Wynik podatkowy (wcześniej wynik wymiaru podatku) zawiera informacje na temat dochodu osób fizycznych podlegającego opodatkowaniu komunalnemu. Dane dla całego królestwa są przedstawione tutaj. Możesz zobaczyć dane w podziale na powiaty i gminy."},{"@language":"pt-t-sv-t0-mtec","@value":"O resultado fiscal (anteriormente o resultado da liquidação do imposto) contém informações sobre os rendimentos do trabalho das pessoas singulares tributáveis a nível municipal. Os dados para todo o reino são apresentados aqui. Pode ver os dados discriminados por concelho e município."},{"@language":"ro-t-sv-t0-mtec","@value":"Rezultatul fiscal (anterior rezultatul evaluării fiscale) conține informații privind veniturile obținute de persoanele fizice impozabile la nivel municipal. Datele pentru întregul regat sunt prezentate aici. Puteți vedea datele defalcate în funcție de județ și municipalitate."},{"@language":"sk-t-sv-t0-mtec","@value":"Daňový výsledok (predtým výsledok daňového výmeru) obsahuje informácie o príjmoch fyzických osôb podliehajúcich obecnej dani. Uvádzajú sa tu údaje za celé kráľovstvo. Môžete vidieť údaje rozdelené podľa kraja a obce."},{"@language":"sl-t-sv-t0-mtec","@value":"Davčni rezultat (prej rezultat odmere davka) vsebuje informacije o občinsko obdavčljivem zasluženem dohodku fizičnih oseb. Tukaj so predstavljeni podatki za celotno kraljestvo. Podatke si lahko ogledate po okrožjih in občinah."},{"@language":"sv","@value":"Beskattningsutfallet (tidigare taxeringsutfallet) innehåller uppgifter om kommunalt beskattningsbar förvärvsinkomst för fysiska personer. Här redovisas uppgifter för hela riket. Du kan se uppgifterna fördelade på län och kommun."},{"@language":"uk-t-sv-t0-mtec","@value":"Податковий результат (раніше результат податкової оцінки) містить інформацію про муніципальний оподатковуваний зароблений дохід фізичних осіб. Дані по всьому королівству представлені тут. Ви можете побачити дані, розбиті по округах і муніципалітетах."}],"dct:format":["application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","text/csv","text/plain"],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Данъчен резултат за данъчната 2024 година"},{"@language":"cs-t-sv-t0-mtec","@value":"Daňový výsledek za příjmový rok 2024"},{"@language":"da-t-sv-t0-mtec","@value":"Skatteresultatet for indkomståret 2024"},{"@language":"de-t-sv-t0-mtec","@value":"Steuerergebnis für das Einkommensjahr 2024"},{"@language":"el-t-sv-t0-mtec","@value":"Αποτέλεσμα φόρου εισοδήματος έτους 2024"},{"@language":"en-t-sv-t0-mtec","@value":"Tax outturn for income year 2024"},{"@language":"es-t-sv-t0-mtec","@value":"Resultado fiscal del ejercicio 2024"},{"@language":"et-t-sv-t0-mtec","@value":"Tuluaasta 2024 maksutulem"},{"@language":"fi-t-sv-t0-mtec","@value":"Tulovuoden 2024 verotuksellinen toteutuma"},{"@language":"fr-t-sv-t0-mtec","@value":"Résultat fiscal pour l’exercice 2024"},{"@language":"ga-t-sv-t0-mtec","@value":"Toradh cánach le haghaidh na bliana ioncaim 2024"},{"@language":"hr-t-sv-t0-mtec","@value":"Porezni rezultat za dohodovnu godinu 2024."},{"@language":"hu-t-sv-t0-mtec","@value":"Adóeredmény a 2024-es jövedelmi évben"},{"@language":"it-t-sv-t0-mtec","@value":"Risultato fiscale per l'anno di reddito 2024"},{"@language":"lt-t-sv-t0-mtec","@value":"2024 pajamų metų mokestinis rezultatas"},{"@language":"lv-t-sv-t0-mtec","@value":"Nodokļu izlietojums 2024. ienākumu gadā"},{"@language":"mt-t-sv-t0-mtec","@value":"Riżultat tat-taxxa għas-sena tal-introjtu 2024"},{"@language":"nl-t-sv-t0-mtec","@value":"Resultaat van de belasting over het inkomstenjaar 2024"},{"@language":"pl-t-sv-t0-mtec","@value":"Wynik podatkowy za rok dochodowy 2024"},{"@language":"pt-t-sv-t0-mtec","@value":"Resultado da execução fiscal do exercício de 2024"},{"@language":"ro-t-sv-t0-mtec","@value":"Rezultatul fiscal pentru anul de venit 2024"},{"@language":"sk-t-sv-t0-mtec","@value":"Výsledná daň za príjmový rok 2024"},{"@language":"sl-t-sv-t0-mtec","@value":"Izid davka za dohodkovno leto 2024"},{"@language":"sv","@value":"Beskattningsutfall för inkomstår 2024"},{"@language":"uk-t-sv-t0-mtec","@value":"Податковий вихід за рік доходу 2024"}],"foaf:page":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2452"}},{"@id":"http://data.europa.eu/88u/distribution/00086b20-1adb-4c03-b37b-46779a3b8e7f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2598"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2598"},"dct:format":"text/csv","dct:issued":{"@type":"xsd:date","@value":"2025-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"CSV файл — Окончателен резултат"},{"@language":"cs-t-sv-t0-mtec","@value":"Soubor CSV – Konečný výsledek"},{"@language":"da-t-sv-t0-mtec","@value":"CSV-fil - Endeligt resultat"},{"@language":"de-t-sv-t0-mtec","@value":"CSV-Datei - Endgültiges Ergebnis"},{"@language":"el-t-sv-t0-mtec","@value":"Αρχείο CSV - Τελικό αποτέλεσμα"},{"@language":"en-t-sv-t0-mtec","@value":"CSV file - Final outcome"},{"@language":"es-t-sv-t0-mtec","@value":"Archivo CSV - Resultado final"},{"@language":"et-t-sv-t0-mtec","@value":"CSV-fail – lõpptulemus"},{"@language":"fi-t-sv-t0-mtec","@value":"CSV-tiedosto - Lopullinen tulos"},{"@language":"fr-t-sv-t0-mtec","@value":"Fichier CSV - Résultat final"},{"@language":"ga-t-sv-t0-mtec","@value":"Comhad CSV - Toradh deiridh"},{"@language":"hr-t-sv-t0-mtec","@value":"Datoteka o CSV-u – konačni ishod"},{"@language":"hu-t-sv-t0-mtec","@value":"CSV-fájl – Végső eredmény"},{"@language":"it-t-sv-t0-mtec","@value":"File CSV - Risultato finale"},{"@language":"lt-t-sv-t0-mtec","@value":"CSV rinkmena. Galutinis rezultatas"},{"@language":"lv-t-sv-t0-mtec","@value":"CSV datne – galīgais iznākums"},{"@language":"mt-t-sv-t0-mtec","@value":"Eżitu finali tal-fajl CSV -"},{"@language":"nl-t-sv-t0-mtec","@value":"CSV-bestand - Eindresultaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Plik CSV – Wynik końcowy"},{"@language":"pt-t-sv-t0-mtec","@value":"Ficheiro CSV – Resultado final"},{"@language":"ro-t-sv-t0-mtec","@value":"Fișier CSV - Rezultatul final"},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor CSV – konečný výsledok"},{"@language":"sl-t-sv-t0-mtec","@value":"Datoteka CSV – končni izid"},{"@language":"sv","@value":"CSV fil - Slutligt utfall"},{"@language":"uk-t-sv-t0-mtec","@value":"CSV файл - Остаточний результат"}]},{"@id":"http://data.europa.eu/88u/distribution/036af9ed-bee7-48ca-99f4-5e29fbc43320","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2600"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2600"},"dct:format":"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","dct:issued":{"@type":"xsd:date","@value":"2025-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"XLSX файл - Окончателен резултат"},{"@language":"cs-t-sv-t0-mtec","@value":"XLSX soubor - Konečný výsledek"},{"@language":"da-t-sv-t0-mtec","@value":"XLSX-fil - Endeligt resultat"},{"@language":"de-t-sv-t0-mtec","@value":"XLSX-Datei - Endgültiges Ergebnis"},{"@language":"el-t-sv-t0-mtec","@value":"Αρχείο XLSX - Τελικό αποτέλεσμα"},{"@language":"en-t-sv-t0-mtec","@value":"XLSX file - Final outcome"},{"@language":"es-t-sv-t0-mtec","@value":"Archivo XLSX - Resultado final"},{"@language":"et-t-sv-t0-mtec","@value":"XLSX-fail - lõpptulemus"},{"@language":"fi-t-sv-t0-mtec","@value":"XLSX-tiedosto - Lopullinen tulos"},{"@language":"fr-t-sv-t0-mtec","@value":"Fichier XLSX - Résultat final"},{"@language":"ga-t-sv-t0-mtec","@value":"Comhad XLSX - Toradh deiridh"},{"@language":"hr-t-sv-t0-mtec","@value":"XLSX datoteka – konačni ishod"},{"@language":"hu-t-sv-t0-mtec","@value":"XLSX fájl – Végső eredmény"},{"@language":"it-t-sv-t0-mtec","@value":"File XLSX - Risultato finale"},{"@language":"lt-t-sv-t0-mtec","@value":"XLSX failas. Galutinis rezultatas"},{"@language":"lv-t-sv-t0-mtec","@value":"XLSX fails - Galīgais rezultāts"},{"@language":"mt-t-sv-t0-mtec","@value":"Eżitu finali tal-fajl XLSX -"},{"@language":"nl-t-sv-t0-mtec","@value":"XLSX-bestand - Eindresultaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Plik XLSX - Wynik końcowy"},{"@language":"pt-t-sv-t0-mtec","@value":"Ficheiro XLSX - Resultado final"},{"@language":"ro-t-sv-t0-mtec","@value":"Fișierul XLSX - Rezultatul final"},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor XLSX – konečný výsledok"},{"@language":"sl-t-sv-t0-mtec","@value":"Datoteka XLSX – končni izid"},{"@language":"sv","@value":"XLSX fil - Slutligt utfall"},{"@language":"uk-t-sv-t0-mtec","@value":"XLSX файл - Остаточний результат"}]},{"@id":"http://data.europa.eu/88u/distribution/0b4be5f8-23fa-42a5-bb0f-66246aacd764","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2506"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2506"},"dct:format":"text/csv","dct:issued":{"@type":"xsd:date","@value":"2025-06-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"CSV файл — Прогноза 3"},{"@language":"cs-t-sv-t0-mtec","@value":"Soubor CSV - Předpověď 3"},{"@language":"da-t-sv-t0-mtec","@value":"CSV-fil - Prognose 3"},{"@language":"de-t-sv-t0-mtec","@value":"CSV-Datei - Prognose 3"},{"@language":"el-t-sv-t0-mtec","@value":"Αρχείο CSV - Πρόγνωση 3"},{"@language":"en-t-sv-t0-mtec","@value":"CSV file - Forecast 3"},{"@language":"es-t-sv-t0-mtec","@value":"Archivo CSV - Pronóstico 3"},{"@language":"et-t-sv-t0-mtec","@value":"CSV-fail – prognoos 3"},{"@language":"fi-t-sv-t0-mtec","@value":"CSV-tiedosto - Ennuste 3"},{"@language":"fr-t-sv-t0-mtec","@value":"Fichier CSV - Forecast 3"},{"@language":"ga-t-sv-t0-mtec","@value":"Comhad CSV - Réamhaisnéis 3"},{"@language":"hr-t-sv-t0-mtec","@value":"Datoteka o CSV-u – 3. prognoza"},{"@language":"hu-t-sv-t0-mtec","@value":"CSV fájl - Előrejelzés 3"},{"@language":"it-t-sv-t0-mtec","@value":"File CSV - Previsioni 3"},{"@language":"lt-t-sv-t0-mtec","@value":"CSV rinkmena. 3 prognozė"},{"@language":"lv-t-sv-t0-mtec","@value":"CSV fails - 3. prognoze"},{"@language":"mt-t-sv-t0-mtec","@value":"- Forecast 3 tal-fajl CSV"},{"@language":"nl-t-sv-t0-mtec","@value":"CSV-bestand - Prognose 3"},{"@language":"pl-t-sv-t0-mtec","@value":"Plik CSV - Prognoza 3"},{"@language":"pt-t-sv-t0-mtec","@value":"Ficheiro CSV - Previsão 3"},{"@language":"ro-t-sv-t0-mtec","@value":"Fișier CSV - Prognoza 3"},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor CSV – prognóza 3"},{"@language":"sl-t-sv-t0-mtec","@value":"Datoteka CSV - Napoved 3"},{"@language":"sv","@value":"CSV fil - Prognos 3"},{"@language":"uk-t-sv-t0-mtec","@value":"CSV файл - Прогноз 3"}]},{"@id":"http://data.europa.eu/88u/distribution/0cf3ac4a-553d-4522-af19-440c6e35bfe5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2454"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2454"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Предварителен данъчен резултат\nПланира се предварителният данъчен резултат за данъчната 2024 година (деклариран през 2025 г.) да бъде достъпен на уебсайта на следните дати:\n•\tПрогноза 1 към 10 април 2025 г.\n•\tПрогноза 2 към 8 май 2025 г.\n•\tПрогноза 3 към 5 юни 2025 г.\n•\tПрогноза 4 към 3 юли 2025 г.\n•\tПрогноза 5 към 7 август 2025 г.\n•\tПрогноза 6 към 4 септември 2025 г.\n•\tПрогноза 7 към 2 октомври 2025 г.\n•\tПрогноза 8 към 23 октомври 2025 г.\n•\tПрогноза 9 20 ноември 2025 г.\nОкончателен данъчен резултат\nОкончателният данъчен резултат за данъчната 2024 година (деклариран през 2025 г.) е достъпен от 14,00 ч. на 8 декември 2025 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Předběžný daňový výsledek\nPředběžný daňový výsledek za příjmový rok 2024 (vyhlášený v roce 2025) má být k dispozici na internetových stránkách v těchto datech:\n•\tPrognóza č. 1 k 10. dubnu 2025\n•\tPrognóza č. 2 ze dne 8. května 2025\n•\tPrognóza č. 3 ze dne 5. června 2025\n•\tPrognóza č. 4 ze dne 3. července 2025\n•\tPředpověď č. 5 ze dne 7. srpna 2025\n•\tPrognóza č. 6 ze dne 4. září 2025\n•\tPrognóza 7 ke dni 2. října 2025\n•\tPrognóza č. 8 ze dne 23. října 2025\n•\tPrognóza 9. a 20. listopadu 2025\nKonečný daňový výsledek\nKonečný daňový výsledek za příjmový rok 2024 (vyhlášený v roce 2025) je k dispozici od 14:00 dne 8. prosince 2025."},{"@language":"da-t-sv-t0-mtec","@value":"Foreløbigt skatteresultat\nDet foreløbige skatteresultat for indkomståret 2024 (angivet i 2025) forventes at være tilgængeligt på webstedet på følgende datoer:\n•\tPrognose 1 pr. 10. april 2025\n•\tPrognose 2 den 8. maj 2025\n•\tPrognose 3 af 5. juni 2025\n•\tPrognose 4 af 3. juli 2025\n•\tPrognose 5 af 7. august 2025\n•\tPrognose 6 af 4. september 2025\n•\tPrognose 7 pr. 2. oktober 2025\n•\tPrognose 8 af 23. oktober 2025\n•\tPrognose 9.-20. november 2025\nEndeligt skatteresultat\nDet endelige skatteresultat for indkomståret 2024 (angivet i 2025) foreligger fra den 8. december 2025 kl. 14.00."},{"@language":"de-t-sv-t0-mtec","@value":"Vorläufiges Steuerergebnis\nDas vorläufige Steuerergebnis für das Einkommensjahr 2024 (deklariert 2025) soll zu folgenden Terminen auf der Website abrufbar sein:\n•\tPrognose 1 zum 10. April 2025\n•\tPrognose 2 am 8. Mai 2025\n•\tPrognose 3 am 5. Juni 2025\n•\tPrognose 4 am 3. Juli 2025\n•\tPrognose 5 am 7. August 2025\n•\tPrognose 6 am 4. September 2025\n•\tPrognose 7 zum 2. Oktober 2025\n•\tPrognose 8 am 23. Oktober 2025\n•\tPrognose 9 vom 20. November 2025\nEndgültiges Steuerergebnis\nDas endgültige Steuerergebnis für das (im Jahr 2025 angemeldete) Einkommensjahr 2024 liegt am 8. Dezember 2025 ab 14.00 Uhr vor."},{"@language":"el-t-sv-t0-mtec","@value":"Προκαταρκτικό φορολογικό αποτέλεσμα\nΤο προκαταρκτικό φορολογικό αποτέλεσμα για το οικονομικό έτος 2024 (που δηλώθηκε το 2025) προβλέπεται να είναι διαθέσιμο στον ιστότοπο στις ακόλουθες ημερομηνίες:\n•\tΠρόβλεψη 1 στις 10 Απριλίου 2025\n•\tΠρόβλεψη 2 στις 8 Μαΐου 2025\n•\tΠρόβλεψη 3 στις 5 Ιουνίου 2025\n•\tΠρόβλεψη 4 στις 3 Ιουλίου 2025\n•\tΠρόβλεψη 5 στις 7 Αυγούστου 2025\n•\tΠρόβλεψη 6 στις 4 Σεπτεμβρίου 2025\n•\tΠρόβλεψη 7 από τις 2 Οκτωβρίου 2025\n•\tΠρόβλεψη 8 στις 23 Οκτωβρίου 2025\n•\tΠρόβλεψη 9 20 Νοεμβρίου 2025\nΤελικό φορολογικό αποτέλεσμα\nΤο τελικό φορολογικό αποτέλεσμα για το εισοδηματικό έτος 2024 (που δηλώθηκε το 2025) είναι διαθέσιμο από τις 8 Δεκεμβρίου 2025 και ώρα 14:00."},{"@language":"en-t-sv-t0-mtec","@value":"Preliminary tax outcome\nThe preliminary tax outcome for income year 2024 (declared in 2025) is planned to be available on the website on the following dates:\n•\tForecast 1 as of 10 April 2025\n•\tForecast 2 on 8 May 2025\n•\tForecast 3 on 5 June 2025\n•\tForecast 4 on 3 July 2025\n•\tForecast 5 on 7 August 2025\n•\tForecast 6 on 4 September 2025\n•\tForecast 7 as of 2 October 2025\n•\tForecast 8 on 23 October 2025\n•\tForecast 9 20 November 2025\nFinal tax outcome\nThe final tax outcome for the income year 2024 (declared in 2025) is available from 14:00 on 8 December 2025."},{"@language":"es-t-sv-t0-mtec","@value":"Resultado fiscal preliminar\nEstá previsto que el resultado fiscal preliminar para el ejercicio 2024 (declarado en 2025) esté disponible en el sitio web en las siguientes fechas:\n•\tPrevisión 1 a 10 de abril de 2025\n•\tPrevisión 2 a 8 de mayo de 2025\n•\tPrevisión 3 a 5 de junio de 2025\n•\tPrevisión 4 a 3 de julio de 2025\n•\tPrevisión 5 a 7 de agosto de 2025\n•\tPrevisión 6 a 4 de septiembre de 2025\n•\tPrevisión 7 a partir del 2 de octubre de 2025\n•\tPrevisión 8 a 23 de octubre de 2025\n•\tPrevisiones 9 20 de noviembre de 2025\nResultado fiscal final\nEl resultado fiscal final para el ejercicio 2024 (declarado en 2025) está disponible a partir de las 14.00 horas del 8 de diciembre de 2025."},{"@language":"et-t-sv-t0-mtec","@value":"Maksustamise esialgne tulemus\nEsialgne maksustamistulemus 2024. tuluaasta kohta (deklareeritud 2025. aastal) on kavas teha veebisaidil kättesaadavaks järgmistel kuupäevadel:\n•\tprognoos 10. aprilli 2025. aasta seisuga\n•\tprognoos 8. mai 2025. aasta seisuga\n•\tprognoos 5. juuni 2025. aasta seisuga\n•\tprognoos 3. juuli 2025. aasta seisuga\n•\tprognoos 7. augusti 2025. aasta seisuga\n•\tprognoos 4. septembri 2025. aasta seisuga\n•\tprognoos 2. oktoobri 2025. aasta seisuga\n•\t23. oktoobri 2025. aasta prognoos nr 8\n•\t20. novembri 2025. aasta prognoos\nLõplik maksutulemus\n2024. tuluaasta (deklareeritud 2025. aastal) lõplik maksutulemus on kättesaadav alates 8. detsembrist 2025 kell 14.00."},{"@language":"fi-t-sv-t0-mtec","@value":"Alustava verotuksellinen tulos\nTulovuoden 2024 (ilmoitettu vuonna 2025) alustavan verotuloksen on tarkoitus olla saatavilla verkkosivustolla seuraavina päivinä:\n•\tEnnuste 1, 10. huhtikuuta 2025\n•\tEnnuste 2 8. toukokuuta 2025\n•\tEnnuste 3, 5. kesäkuuta 2025\n•\tEnnuste 4, 3. heinäkuuta 2025\n•\tEnnuste 5 7. elokuuta 2025\n•\tEnnuste 6, 4. syyskuuta 2025\n•\tEnnuste 7 2. lokakuuta 2025\n•\tEnnuste 8 23. lokakuuta 2025\n•\tEnnuste 9 20. marraskuuta 2025\nLopullinen verotuksellinen tulos\nTulovuoden 2024 (ilmoitettu vuonna 2025) lopullinen verotuksellinen tulos on saatavilla 8. joulukuuta 2025 klo 14.00 alkaen."},{"@language":"fr-t-sv-t0-mtec","@value":"Résultat fiscal préliminaire\nLe résultat fiscal préliminaire pour l’exercice 2024 (déclaré en 2025) devrait être disponible sur le site web aux dates suivantes:\n•\tPrévision 1 au 10 avril 2025\n•\tPrévisions 2 du 8 mai 2025\n•\tPrévisions 3 au 5 juin 2025\n•\tPrévisions 4 au 3 juillet 2025\n•\tPrévisions 5 au 7 août 2025\n•\tPrévisions 6 au 4 septembre 2025\n•\tPrévisions 7 au 2 octobre 2025\n•\tPrévision 8 au 23 octobre 2025\n•\tPrévisions 9 20 novembre 2025\nRésultat fiscal final\nLe résultat fiscal final pour l’année de revenus 2024 (déclaré en 2025) est disponible à partir de 14 heures le 8 décembre 2025."},{"@language":"ga-t-sv-t0-mtec","@value":"Réamhthoradh cánach\nTá sé beartaithe go mbeidh an réamhthoradh cánach don bhliain ioncaim 2024 (a dhearbhaítear in 2025) ar fáil ar an suíomh gréasáin ar na dátaí seo a leanas:\n•\tRéamhaisnéis 1 ón 10 Aibreán 2025\n•\tRéamhaisnéis 2 an 8 Bealtaine 2025\n•\tRéamhaisnéis 3 an 5 Meitheamh 2025\n•\tRéamhaisnéis 4 an 3 Iúil 2025\n•\tRéamhaisnéis 5 an 7 Lúnasa 2025\n•\tRéamhaisnéis 6 an 4 Meán Fómhair 2025\n•\tRéamhaisnéis 7 ón 2 Deireadh Fómhair 2025\n•\tRéamhaisnéis 8 an 23 Deireadh Fómhair 2025\n•\tRéamhaisnéis an 9 Samhain 2025\nToradh cánach deiridh\nTá an toradh cánach deiridh don bhliain ioncaim 2024 (arna dhearbhú in 2025) ar fáil ó 14:00 an 8 Nollaig 2025."},{"@language":"hr-t-sv-t0-mtec","@value":"Preliminarni porezni ishod\nPlanira se da će preliminarni porezni ishod za dohodovnu godinu 2024. (prijavljen 2025.) biti dostupan na internetskim stranicama na sljedeće datume:\n•\tPredviđanje 1. od 10. travnja 2025.\n•\tPredviđanje br. 2 od 8. svibnja 2025.\n•\tPredviđanje br. 3 od 5. lipnja 2025.\n•\tPredviđanje br. 4 od 3. srpnja 2025.\n•\tPredviđanje br. 5 od 7. kolovoza 2025.\n•\tPredviđanje br. 6 od 4. rujna 2025.\n•\tPredviđanje 7. od 2. listopada 2025.\n•\tPredviđanje br. 8 od 23. listopada 2025.\n•\tPredviđanje 9. 20. studenoga 2025.\nKonačni porezni ishod\nKonačni porezni ishod za dohodovnu godinu 2024. (prijavljen 2025.) dostupan je od 8. prosinca 2025. u 14:00 sati."},{"@language":"hu-t-sv-t0-mtec","@value":"Előzetes adóeredmény\nA 2024-es jövedelmi évre vonatkozó (2025-ben bejelentett) előzetes adóeredmény a tervek szerint a következő időpontokban lesz elérhető a honlapon:\n•\tElőrejelzés 2025. április 10-től\n•\t2025. május 8-i 2. előrejelzés\n•\tElőrejelzés 2025. június 5-én\n•\tElőrejelzés: 2025. július 3.\n•\tElőrejelzés: 2025. augusztus 7.\n•\tElőrejelzés: 2025. szeptember 4.\n•\tElőrejelzés: 2025. október 2-tól\n•\tElőrejelzés: 2025. október 23.\n•\tElőrejelzés 2025. november 20.\nVégleges adóeredmény\nA 2024-es jövedelmi évre vonatkozó (a 2025-ben bejelentett) végleges adóeredmény 2025. december 8-án 14 órától áll rendelkezésre."},{"@language":"it-t-sv-t0-mtec","@value":"Risultato fiscale preliminare\nL'esito fiscale preliminare per l'esercizio 2024 (dichiarato nel 2025) dovrebbe essere disponibile sul sito web alle seguenti date:\n•\tPrevisioni 1 al 10 aprile 2025\n•\tPrevisioni 2 dell'8 maggio 2025\n•\tPrevisioni 3 del 5 giugno 2025\n•\tPrevisioni 4 del 3 luglio 2025\n•\tPrevisioni 5 del 7 agosto 2025\n•\tPrevisioni 6 del 4 settembre 2025\n•\tPrevisione 7 al 2 ottobre 2025\n•\tPrevisioni 8 del 23 ottobre 2025\n•\tPrevisioni 9 20 novembre 2025\nRisultato fiscale finale\nIl risultato fiscale finale per l'anno di reddito 2024 (dichiarato nel 2025) è disponibile dalle ore 14:00 dell'8 dicembre 2025."},{"@language":"lt-t-sv-t0-mtec","@value":"Preliminarus mokestinis rezultatas\nPlanuojama, kad 2024 pajamų metų preliminarus mokestinis rezultatas (deklaruotas 2025 m.) bus paskelbtas interneto svetainėje šiomis dienomis:\n•\t1 prognozė 2025 m. balandžio 10 d.\n•\t2 prognozė 2025 m. gegužės 8 d.\n•\t3 prognozė 2025 m. birželio 5 d.\n•\t4 prognozė 2025 m. liepos 3 d.\n•\t5 prognozė, 2025 m. rugpjūčio 7 d.\n•\t6 prognozė – 2025 m. rugsėjo 4 d.\n•\t7 prognozė 2025 m. spalio 2 d.\n•\t8 prognozė – 2025 m. spalio 23 d.\n•\tPrognozė Nr. 9 2025 m. lapkričio 20 d.\nGalutinis mokesčių rezultatas\nGalutinis 2024 pajamų metų mokesčių rezultatas (deklaruotas 2025 m.) pateikiamas nuo 2025 m. gruodžio 8 d. 14.00 val."},{"@language":"lv-t-sv-t0-mtec","@value":"Provizoriskais nodokļu iznākums\nPlānots, ka provizoriskais nodokļu iznākums par 2024. ienākumu gadu (deklarēts 2025. gadā) būs pieejams tīmekļa vietnē šādos datumos:\n•\tprognoze 2025. gada 10. aprīlī\n•\tPrognoze Nr. 2 2025. gada 8. maijā\n•\tPrognoze Nr. 3 2025. gada 5. jūnijā\n•\tPrognoze 4 2025. gada 3. jūlijā\n•\tPrognoze Nr. 5 2025. gada 7. augustā\n•\tprognoze 2025. gada 4. septembrī\n•\tprognoze 2025. gada 2. oktobrī\n•\tPrognoze Nr. 8 2025. gada 23. oktobrī\n•\tPrognoze 2025. gada 9. un 20. novembrī\nGalīgais nodokļu iznākums\nGalīgais nodokļu rezultāts par 2024. ienākumu gadu (deklarēts 2025. gadā) ir pieejams 2025. gada 8. decembrī no plkst. 14.00."},{"@language":"mt-t-sv-t0-mtec","@value":"Riżultat preliminari tat-taxxa\nL-eżitu preliminari tat-taxxa għas-sena tal-introjtu 2024 (iddikjarat fl-2025) huwa ppjanat li jkun disponibbli fuq is-sit web fid-dati li ġejjin:\n•\tPreviżjoni 1 mill-10 ta’ April 2025\n•\tPreviżjoni 2 fit-8 ta’ Mejju 2025\n•\tPreviżjoni 3 fil-5 ta’ Ġunju 2025\n•\tPreviżjoni 4 fit-3 ta’ Lulju 2025\n•\tPreviżjoni 5 fis-7 ta’ Awwissu 2025\n•\tPreviżjoni 6 fl-4 ta’ Settembru 2025\n•\tPreviżjoni 7 mit-2 ta’ Ottubru 2025\n•\tPreviżjoni 8 fit-23 ta’ Ottubru 2025\n•\tPreviżjoni 9 20 ta' Novembru 2025\nRiżultat finali tat-taxxa\nL-eżitu finali tat-taxxa għas-sena tal-introjtu 2024 (iddikjarat fl-2025) huwa disponibbli mis-14:00 fit-8 ta’ Diċembru 2025."},{"@language":"nl-t-sv-t0-mtec","@value":"Voorlopig fiscaal resultaat\nHet voorlopige belastingresultaat voor inkomstenjaar 2024 (aangegeven in 2025) zal naar verwachting op de volgende data beschikbaar zijn op de website:\n•\tPrognose 1 per 10 april 2025\n•\tPrognose 2 op 8 mei 2025\n•\tPrognose 3 op 5 juni 2025\n•\tPrognose 4 op 3 juli 2025\n•\tPrognose 5 op 7 augustus 2025\n•\tPrognose 6 op 4 september 2025\n•\tPrognose 7 per 2 oktober 2025\n•\tPrognose 8 op 23 oktober 2025\n•\tPrognose 9 20 november 2025\nDefinitief fiscaal resultaat\nHet definitieve belastingresultaat voor het inkomstenjaar 2024 (aangegeven in 2025) is beschikbaar vanaf 14.00 uur op 8 december 2025."},{"@language":"pl-t-sv-t0-mtec","@value":"Wstępny wynik podatkowy\nPlanuje się, że wstępny wynik podatkowy za rok dochodowy 2024 (zadeklarowany w 2025 r.) będzie dostępny na stronie internetowej w następujących terminach:\n•\tPrognoza 1 na dzień 10 kwietnia 2025 r.\n•\tPrognoza nr 2 z dnia 8 maja 2025 r.\n•\tPrognoza nr 3 z dnia 5 czerwca 2025 r.\n•\tPrognoza 4 z dnia 3 lipca 2025 r.\n•\tPrognoza nr 5 z dnia 7 sierpnia 2025 r.\n•\tPrognoza 6 z dnia 4 września 2025 r.\n•\tPrognoza 7 na dzień 2 października 2025 r.\n•\tPrognoza 8 z dnia 23 października 2025 r.\n•\tPrognoza 9 20 listopada 2025 r.\nOstateczny wynik podatkowy\nOstateczny wynik podatkowy za rok dochodowy 2024 (zadeklarowany w 2025 r.) jest dostępny od godz. 14:00 w dniu 8 grudnia 2025 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Resultado fiscal preliminar\nO resultado fiscal preliminar para o ano de rendimento de 2024 (declarado em 2025) deverá estar disponível no sítio Web nas seguintes datas:\n•\tPrevisão 1 a partir de 10 de abril de 2025\n•\tPrevisão 2 de 8 de maio de 2025\n•\tPrevisão 3 em 5 de junho de 2025\n•\tPrevisão 4 de 3 de julho de 2025\n•\tPrevisão 5 em 7 de agosto de 2025\n•\tPrevisão 6 de 4 de setembro de 2025\n•\tPrevisão 7 a partir de 2 de outubro de 2025\n•\tPrevisão 8 de 23 de outubro de 2025\n•\tPrevisão 9 20 de novembro de 2025\nResultado fiscal final\nO resultado fiscal final para o ano de rendimento de 2024 (declarado em 2025) está disponível a partir das 14h00 de 8 de dezembro de 2025."},{"@language":"ro-t-sv-t0-mtec","@value":"Rezultatul fiscal preliminar\nRezultatul fiscal preliminar pentru anul de venit 2024 (declarat în 2025) este planificat să fie disponibil pe site la următoarele date:\n•\tPreviziuni 1 la 10 aprilie 2025\n•\tPrognoza 2 din 8 mai 2025\n•\tPrognoza 3 din 5 iunie 2025\n•\tPrognoza 4 din 3 iulie 2025\n•\tPrognoza 5 din 7 august 2025\n•\tPrognoza 6 din 4 septembrie 2025\n•\tPrognoza 7 începând cu 2 octombrie 2025\n•\tPrognoza 8 din 23 octombrie 2025\n•\tPreviziuni 9 20 noiembrie 2025\nRezultatul fiscal final\nRezultatul fiscal final pentru anul de venit 2024 (declarat în 2025) este disponibil începând cu 8 decembrie 2025, ora 14:00."},{"@language":"sk-t-sv-t0-mtec","@value":"Predbežný daňový výsledok\nPredbežný daňový výsledok za príjmový rok 2024 (deklarovaný v roku 2025) má byť k dispozícii na webovom sídle v týchto dátumoch:\n•\tOdhad č. 1 k 10. aprílu 2025\n•\tPrognóza č. 2 z 8. mája 2025\n•\tPredpoveď č. 3 z 5. júna 2025\n•\tPrognóza č. 4 z 3. júla 2025\n•\tPredpoveď č. 5 zo 7. augusta 2025\n•\tPredpoveď č. 6 zo 4. septembra 2025\n•\tOdhad č. 7 k 2. októbru 2025\n•\tPrognóza č. 8 z 23. októbra 2025\n•\tPrognóza 9. 20. novembra 2025\nKonečný daňový výsledok\nKonečný daňový výsledok za príjmový rok 2024 (deklarovaný v roku 2025) je k dispozícii 8. decembra 2025 od 14.00 hod."},{"@language":"sl-t-sv-t0-mtec","@value":"Predhodni davčni izid\nPredhodni davčni izid za dohodninsko leto 2024 (prijavljen leta 2025) naj bi bil na spletišču na voljo na naslednje datume:\n•\tNapoved 1 z dne 10. aprila 2025\n•\tNapoved št. 2 z dne 8. maja 2025\n•\tNapoved 3 z dne 5. junija 2025\n•\tNapoved št. 4 z dne 3. julija 2025\n•\tNapoved št. 5 z dne 7. avgusta 2025\n•\tNapoved št. 6 z dne 4. septembra 2025\n•\tNapoved 7 z dne 2. oktobra 2025\n•\tNapoved št. 8 z dne 23. oktobra 2025\n•\tNapoved z dne 9. in 20. novembra 2025\nKončni davčni izid\nKončni davčni izid za dohodkovno leto 2024 (prijavljen leta 2025) je na voljo 8. decembra 2025 od 14.00."},{"@language":"sv","@value":"Preliminärt beskattningsutfall\nDet preliminära beskattningsutfallet för inkomstår 2024 (som deklareras 2025) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 10 april 2025\n•\tPrognos 2 den 8 maj 2025\n•\tPrognos 3 den 5 juni 2025\n•\tPrognos 4 den 3 juli 2025\n•\tPrognos 5 den 7 augusti 2025\n•\tPrognos 6 den 4 september 2025\n•\tPrognos 7 den 2 oktober 2025\n•\tPrognos 8 den 23 oktober 2025\n•\tPrognos 9 den 20 november 2025\nSlutligt beskattningsutfall\nDet slutliga beskattningsutfallet för inkomstår 2024 (som deklareras 2025) är tillgängligt från klockan 14:00 den 8 december 2025."},{"@language":"uk-t-sv-t0-mtec","@value":"Попередній податковий результат\nПопередній результат оподаткування за 2024 рік доходу (задекларований у 2025 році) планується оприлюднити на сайті у такі дати:\n• • Протипоказ\tПрогноз 1 станом на 10 квітня 2025 року\n• • Протипоказ\tПрогноз 2 на 8 травня 2025\n• • Протипоказ\tПрогноз 3 на 5 червня 2025 року\n• • Протипоказ\tПрогноз 4 на 3 липня 2025\n• • Протипоказ\tПрогноз 5 на 7 серпня 2025\n• • Протипоказ\tПрогноз 6 на 4 вересня 2025 року\n• • Протипоказ\tПрогноз 7 станом на 2 жовтня 2025 року\n• • Протипоказ\tПрогноз 8 на 23 жовтня 2025\n• • Протипоказ\tПрогноз 9 20 листопада 2025\nОстаточний податковий результат\nОстаточний податковий результат за рік доходу 2024 (задекларований у 2025 році) доступний з 14:00 8 грудня 2025 року."}],"dct:format":"text/plain","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Дата на публикуване Данъчен резултат за данъчната 2024 година"},{"@language":"cs-t-sv-t0-mtec","@value":"Datum zveřejnění Daňový výsledek za zdaňovací období 2024"},{"@language":"da-t-sv-t0-mtec","@value":"Offentliggørelsesdato Skatteresultat for indkomståret 2024"},{"@language":"de-t-sv-t0-mtec","@value":"Datum der Veröffentlichung Steuerergebnis für das Einkommensjahr 2024"},{"@language":"el-t-sv-t0-mtec","@value":"Ημερομηνία δημοσίευσης Φορολογικό αποτέλεσμα για το οικονομικό έτος 2024"},{"@language":"en-t-sv-t0-mtec","@value":"Date of publication Tax outcome for income year 2024"},{"@language":"es-t-sv-t0-mtec","@value":"Fecha de publicación Resultado fiscal del ejercicio 2024"},{"@language":"et-t-sv-t0-mtec","@value":"Avaldamise kuupäev 2024. majandusaasta maksustamistulemus"},{"@language":"fi-t-sv-t0-mtec","@value":"Julkaisupäivä Tulovuoden 2024 verotuksellinen tulos"},{"@language":"fr-t-sv-t0-mtec","@value":"Date de publication Résultat fiscal pour l'exercice 2024"},{"@language":"ga-t-sv-t0-mtec","@value":"Dáta foilsithe Toradh cánach le haghaidh na bliana ioncaim 2024"},{"@language":"hr-t-sv-t0-mtec","@value":"Datum objave Ishod oporezivanja za dohodovnu godinu 2024."},{"@language":"hu-t-sv-t0-mtec","@value":"Közzététel időpontja Adóeredmény a 2024. jövedelmi évre vonatkozóan"},{"@language":"it-t-sv-t0-mtec","@value":"Data di pubblicazione Risultato fiscale per l'anno di reddito 2024"},{"@language":"lt-t-sv-t0-mtec","@value":"Paskelbimo data 2024 pajamų metų mokestinis rezultatas"},{"@language":"lv-t-sv-t0-mtec","@value":"Publicēšanas datums Nodokļu rezultāti 2024. ienākumu gadā"},{"@language":"mt-t-sv-t0-mtec","@value":"Data tal-pubblikazzjoni Eżitu tat-taxxa għas-sena tal-introjtu 2024"},{"@language":"nl-t-sv-t0-mtec","@value":"Datum publicatie Fiscaal resultaat inkomstenjaar 2024"},{"@language":"pl-t-sv-t0-mtec","@value":"Data publikacji Wynik podatkowy za rok dochodowy 2024"},{"@language":"pt-t-sv-t0-mtec","@value":"Data de publicação Resultado fiscal do exercício de 2024"},{"@language":"ro-t-sv-t0-mtec","@value":"Data publicării Rezultatul fiscal pentru anul de venit 2024"},{"@language":"sk-t-sv-t0-mtec","@value":"Dátum zverejnenia Daňový výsledok za príjmový rok 2024"},{"@language":"sl-t-sv-t0-mtec","@value":"Datum objave Davčni izid za dohodkovno leto 2024"},{"@language":"sv","@value":"Datum för publicering beskattningsutfall för inkomstår 2024"},{"@language":"uk-t-sv-t0-mtec","@value":"Дата публікації Податковий результат за рік доходу 2024"}]},{"@id":"http://data.europa.eu/88u/distribution/1ca436d0-aff2-4ea3-b817-50c66c78d6d9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2530"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2530"},"dct:format":"text/csv","dct:issued":{"@type":"xsd:date","@value":"2025-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"CSV файл — прогноза 6"},{"@language":"cs-t-sv-t0-mtec","@value":"Soubor CSV - Předpověď 6"},{"@language":"da-t-sv-t0-mtec","@value":"CSV-fil - Prognose 6"},{"@language":"de-t-sv-t0-mtec","@value":"CSV-Datei - Prognose 6"},{"@language":"el-t-sv-t0-mtec","@value":"Αρχείο CSV - Πρόγνωση 6"},{"@language":"en-t-sv-t0-mtec","@value":"CSV file - Forecast 6"},{"@language":"es-t-sv-t0-mtec","@value":"Archivo CSV - Pronóstico 6"},{"@language":"et-t-sv-t0-mtec","@value":"CSV-fail – 6. prognoos"},{"@language":"fi-t-sv-t0-mtec","@value":"CSV-tiedosto - Ennuste 