04-b2116250c76a#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=137fc1a0-59ad-4e23-9712-8d81205ad75d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2019-04-20"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1828 - 1890 meter över marken. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 17-19 april 2019. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"ac02c6f4-6172-43e5-8604-b2116250c76a","dct:issued":{"@type":"xsd:date","@value":"2020-04-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b0n0"},"dct:temporal":{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2019)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2019"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2019"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76"},{"@graph":[{"@id":"_:66e8fe276589b0f8d4f67c7b9f5ee95ebe7d0062014d7eee71de611b3ba5f6e4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:66e8fe276589b0f8d4f67c7b9f5ee95ebe7d0062014d7eee71de611b3ba5f6e4_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1053e34d6adc3d12292e39a6013c8f378f"},{"@id":"http://data.europa.eu/88u/dataset/5239c543-3582-435f-80b5-4cd91f152162","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/f59661b7-89b8-4bda-abcb-aa5ce7e6b0dc"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=4fc0bb69-46bc-43f7-8e34-e2de2d014f99"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта - Правата се състоят от следните подтипове (подтипове) по информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Регистрационна карта) :450050, Права подтипове10, Officialservitut, modifiable20, Contract seritut, modifiable30, Официални права за използване, modifiable40, Права за използване на договора, modifier50, Права за управление, modifier60, Пътни права, modifiable"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registru - Práva se skládala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa registru) :450050, Podtypy práv10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort - Rettigheder bestod af følgende undertyper (undertyper) i informationsklassifikationen 2020 (for den nuværende liste se Generel produktspecifikation Registerkort) :450050, Rettigheder Undertype10, Officialservitut, modifiable20, Kontrakt seritut, modifiable30, Officielle udnyttelsesrettigheder, modifiable40, Kontraktudnyttelsesrettigheder, modifier50, Forvaltningsrettigheder, modifier60, Vejrettigheder, modificerbare"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte - Rechte bestanden aus den folgenden Subtypen (Subtypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Registerkarte) :450050, Rechte Subtypen10, Amtlicher Dienst, modifizierbar20, Vertrag seritut, modifizierbar30, Amtliche Nutzungsrechte, modifizierbar40, Vertragsnutzungsrechte, Modifizierer50, Managementrechte, Modifizierer60, Straßenrechte, modifizierbar"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Τα δικαιώματα αποτελούνταν από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης μητρώου) :450050, Υποτύποι δικαιωμάτων10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"en-t-sv-t0-mtec","@value":"Register map - Rights consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification Register map) :450050, Rights Subtypes10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de registro: los derechos consistían en los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual, véase la especificación general del producto, mapa de registro): 450050, Subtipos de derechos10, Servicio oficial, modificable20, Servicio del contrato, modificable30, Derechos de utilización oficial, modificable40, Derechos de utilización del contrato, modificador50, Derechos de gestión, modificador60, Derechos de carretera, modificable"},{"@language":"et-t-sv-t0-mtec","@value":"Registrikaart – 2020. aasta teabeliigituse õigused koosnesid järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldise tootespetsifikaadi registrikaart):450050, õiguste alatüübid10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta - Oikeudet muodostuivat seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleiset tuote-eritelmät Rekisterikartta) :450050, Oikeuksien alatyypit10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte du registre - Les droits se composaient des sous-types suivants (sous-types) à la classification d'information 2020 (pour la liste actuelle voir le cahier des charges général du produit Carte du registre) :450050, Droits Sous-types10, Officialservitut, modifiable20, Contrat seritut, modifiable30, Droits d'utilisation officiels, modifiable40, Droits d'utilisation contractuels, modifiable50, Droits de gestion, modifiable60, Droits routiers, modifiable"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil an chláir - Is éard a bhí sna cearta na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach an tsonraíocht táirge Ghinearálta Léarscáil an Chláir) :450050, Cearta Fochineálacha10, Seirbhís oifigiúil, inmhodhnaithe20, Seirbhís chonartha, inmhodhnaithe30, Cearta úsáide oifigiúla, inmhodhnaithe40, Cearta úsáide conartha, modhnú50, Cearta bainistíochta, modhnú60, Cearta bóthair, inmhodhnaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta registra - Prava su se sastojala od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020 (za trenutni popis vidi Opće specifikacije proizvoda Karta registra) :450050, Prava podvrste10, Službeni poslužitelj, modifikacija20, Ugovorni seritut, modifikacija30, Službena prava korištenja, modifikacija40, Prava korištenja ugovora, modifikator50, Prava upravljanja, modifikator60, Prava na cestama, modifikacija"},{"@language":"hu-t-sv-t0-mtec","@value":"Regisztrációs térkép - A jogok a következő altípusokból (altípusokból) álltak a 2020-as információs osztályozásnál (az aktuális listát lásd az Általános termékleírás nyilvántartási térképén) :450050, Jogok altípusok10, Hivatalos szervitut, módosítható20, Szerződéses seritut, módosítható30, Hivatalos felhasználási jogok, módosítható40, Szerződéses felhasználási jogok, módosító50, Kezelési jogok, módosító60, Közúti jogok, módosítható"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa del registro - I diritti consistevano dei seguenti sottotipi (sottotipi) alla classificazione delle informazioni 2020 (per l'elenco attuale vedere la mappa del registro delle specifiche generali del prodotto): 450050, Sottotipi dei diritti10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official utilization rights, modifiable40, Contract utilization rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"lt-t-sv-t0-mtec","@value":"Registro žemėlapis - teises sudarė šie potipiai (potipiai) pagal 2020 m. informacijos klasifikaciją (dabartinį sąrašą žr. Bendrosios produkto specifikacijos Registro žemėlapis):450050, Teisių potipiai10, Oficialus servisas, modifikuojamas20, Sutarčių seritutas, modifikuojamas30, Oficialios naudojimo teisės, modifikuojamos40, Sutarčių naudojimo teisės, modifier50, Valdymo teisės, modifier60, Kelių teisės, modifikuojamos"},{"@language":"lv-t-sv-t0-mtec","@value":"Reģistra karte - Tiesības sastāvēja no šādiem apakštipiem (apakštipiem) informācijas klasifikācijā 2020 (pašreizējo sarakstu sk. Vispārējā produkta specifikācija Reģistra karte) :450050, Tiesību apakštipi10, Oficiālais servitūts, modificējams20, Līguma servitūts, modificējams30, Oficiālās izmantošanas tiesības, modificējams40, Līguma izmantošanas tiesības, modifikators50, Pārvaldības tiesības, modifikators60, Ceļu tiesības, modificējams"},{"@language":"mt-t-sv-t0-mtec","@value":"- Rights kien jikkonsisti fis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-mappa tar-Reġistru tal-Ispeċifikazzjoni Ġenerali tal-Prodott) :450050, Sottotipi tad-Drittijiet10, Uffiċjalservitut, modifikabbli20, Seritut tal-kuntratt, modifikabbli30, Drittijiet ta' użu uffiċjali, modifikabbli40, Drittijiet ta' użu tal-kuntratt, modifikatur50, Drittijiet ta' ġestjoni, modifikatur60, Drittijiet tat-triq, modifikabbli40"},{"@language":"nl-t-sv-t0-mtec","@value":"Registerkaart - Rechten bestonden uit de volgende subtypes (subtypes) bij de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Registerkaart) :450050, Rechten Subtypes10, Officialservitut, modifiable20, Contract seritut, modifiable30, Officiële gebruiksrechten, modifiable40, Contract gebruiksrechten, modifier50, Beheersrechten, modifier60, Wegrechten, modifiable"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa rejestracji - Prawa składały się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualna lista znajduje się w Ogólnej specyfikacji produktu Mapa rejestracji) :450050, Prawa podtypy10, Officialservitut, modifiable20, Seritut umowy, modifiable30, Oficjalne prawa użytkowania, modifiable40, Prawa użytkowania umowy, modifier50, Prawa zarządcze, modifier60, Prawa drogowe, modifiable"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa de registro - Os direitos consistiam dos seguintes subtipos (subtipos) na classificação de informações 2020 (para a lista atual ver especificação geral do produto Mapa de registro) :450050, Subtipos de direitos10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official usetion rights, modifiable40, Contract usetion rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta registrului - Drepturile au constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor 2020 (pentru lista actuală a se vedea Caietul de sarcini general al produsului Harta registrului): 450050, Drepturi subtipuri10, Serviciu oficial, modificabil20, Contract seritut, modificabil30, Drepturi oficiale de utilizare, modificabil40, Drepturi de utilizare a contractului, modificator50, Drepturi de gestionare, modificator60, Drepturi rutiere, modificabil"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa registra - práva pozostávali z nasledujúcich podtypov (podtypov) v klasifikácii informácií 2020 (pre aktuálny zoznam pozri všeobecnú špecifikáciu výrobku Mapa registra) :450050, subtypy práv10, Officialservitut, modifiable20, Contract seritut, modifiable30, Official use rights, modifiable40, Contract use use rights, modifier50, Management rights, modifier60, Road rights, modifiable"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid registra - pravice so bile sestavljene iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej zemljevid registra splošnih specifikacij proizvoda):450050, podtipi pravic10, Officialservitut, spremenljivi20, Contract seritut, spremenljivi30, Uradne pravice uporabe, spremenljive40, Pravice uporabe pogodbe, modifikator50, Upravljavske pravice, modifikator60, Cestne pravice, spremenljive"},{"@language":"sv","@value":"Registerkarta - Rättigheter bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450050, RättighetUndertyper10, Officialservitut, modifierbar20, Avtalsservitut, modifierbar30, Officialnyttjanderätt, modifierbar40, Avtalsnyttjanderätt, modifierbar50, Ledningsrätt, modifierbar60, Vägrätt, modifierbar"},{"@language":"uk-t-sv-t0-mtec","@value":"Карта регістру - Права складалися з таких підтипів (підтипів) при класифікації інформації 2020 (для поточного списку див."}],"dct:format":"text/html","dct:identifier":"5239c543-3582-435f-80b5-4cd91f152162","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:66e8fe276589b0f8d4f67c7b9f5ee95ebe7d0062014d7eee71de611b3ba5f6e4_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Регистрационна карта - Права"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registrů SBK - Práva"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Registrer kort - Rettigheder"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Registerkarte - Rechte"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου SBK - Δικαιώματα"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Register Map - Rights"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de Registro de SBK - Derechos"},{"@language":"et-t-sv-t0-mtec","@value":"SBK registri kaart - õigused"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Rekisterikartta - Oikeudet"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte d'enregistrement SBK - Droits"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Chláraithe SBK - Cearta"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Registar Karta - Prava"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Regisztrációs térkép - Jogok"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa del Registro