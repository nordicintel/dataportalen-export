//purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:d69ae65cd66ab157e1858c74c99bea7a1e99fcff2f115aad7de003aba7b815b5"},{"@graph":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n3"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n0"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b4n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"6bc5e32ffe4144d050f92972ced2a34ca6"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b5n0","dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2430","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0cf2985e-0bc4-49ea-9ec8-893c52fecac7"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Ajourhållning: Kontinuerligt."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten beskriver permanent monterade vägräckesavslutningar i början eller i slutet av vägräcken längs vägnätet.  \n\nVägräckesavslutning har en sidouppdelad punktutbredning placerad där avslutningen ansluter till räcket. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n0"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För exempel på vägräckesavslutningar se referens #100."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling har skett genom konvertering från företeelser av typen Vägräckesavslutning från Regionala företeelsedatabasen som endast har ajourhållits för vissa av dåvarande Vägverkets regioner från och med 2006-01-01. \n\nFör regioner som inte har ajourhållit data i den Regionala företeelsedatabasen sker inventering inom processen för drift- och underhållsupphandling. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n1"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n4"}]},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n0"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-trafikverket-se-store-1-resource-2429","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/0cf2985e-0bc4-49ea-9ec8-893c52fecac7"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=2429&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Guard rail terminal"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1065V%C3%A4gr%C3%A4ckesavslutning.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-05-04"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Продуктът с данни показва как започва и завършва пътният участък по пътя."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový produkt ukazuje, jak silniční úsek podél silnice začíná a končí."},{"@language":"da-t-sv-t0-mtec","@value":"Dataproduktet viser, hvordan vejstrækningen langs vejen begynder og slutter."},{"@language":"de-t-sv-t0-mtec","@value":"Das Datenprodukt zeigt, wie der Straßenabschnitt entlang der Straße beginnt und endet."},{"@language":"el-t-sv-t0-mtec","@value":"Το προϊόν δεδομένων δείχνει πώς αρχίζει και τελειώνει το οδικό τμήμα κατά μήκος του δρόμου."},{"@language":"en-t-sv-t0-mtec","@value":"The data product shows how the road section along the road begins and ends."},{"@language":"es-t-sv-t0-mtec","@value":"El producto de datos muestra cómo comienza y termina la sección de la carretera a lo largo de la carretera."},{"@language":"et-t-sv-t0-mtec","@value":"Andmetoode näitab, kuidas teelõik tee ääres algab ja lõpeb."},{"@language":"fi-t-sv-t0-mtec","@value":"Datatuote näyttää, miten tien varrella oleva tieosuus alkaa ja päättyy."},{"@language":"fr-t-sv-t0-mtec","@value":"Le produit de données montre comment le tronçon de route le long de la route commence et se termine."},{"@language":"ga-t-sv-t0-mtec","@value":"Taispeánann an táirge sonraí conas a thosaíonn agus a chríochnaíonn an chuid bóthair feadh an bhóthair."},{"@language":"hr-t-sv-t0-mtec","@value":"Podatkovni proizvod pokazuje kako cestovna dionica uz cestu počinje i završava."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adattermék megmutatja, hogyan kezdődik és végződik az útszakasz az út mentén."},{"@language":"it-t-sv-t0-mtec","@value":"Il prodotto dati mostra come inizia e finisce il tratto stradale lungo la strada."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų produktas parodo, kaip prasideda ir baigiasi kelio atkarpa palei kelią."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu produkts parāda, kā ceļa posms gar ceļu sākas un beidzas."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-prodott tad-data juri kif is-sezzjoni tat-triq matul it-triq tibda u tispiċċa."},{"@language":"nl-t-sv-t0-mtec","@value":"Het dataproduct laat zien hoe het weggedeelte langs de weg begint en eindigt."},{"@language":"pl-t-sv-t0-mtec","@value":"Produkt danych pokazuje, jak zaczyna się i kończy odcinek drogi wzdłuż drogi."},{"@language":"pt-t-sv-t0-mtec","@value":"O produto de dados mostra como a secção da estrada ao longo da estrada começa e termina."},{"@language":"ro-t-sv-t0-mtec","@value":"Produsul de date arată modul în care porțiunea de drum de-a lungul drumului începe și se termină."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový produkt ukazuje, ako sa začína a končí úsek cesty pozdĺž cesty."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni izdelek prikazuje, kako se cestni odsek ob cesti začne in konča."},{"@language":"sv","@value":"Dataprodukten redovisar hur vägräcket utefter vägen börjar respektive avslutas."},{"@language":"uk-t-sv-t0-mtec","@value":"Продукт даних показує, як починається і закінчується ділянка дороги вздовж дороги."}],"dct:format":"application/vnd.ogc.wms_xml","dct:issued":{"@type":"xsd:date","@value":"2026-08-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-18"},"dct:provenance":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b2n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Край на пътното платно"},{"@language":"cs-t-sv-t0-mtec","@value":"Konec vozovky"},{"@language":"da-t-sv-t0-mtec","@value":"Afslutning af kørebane"},{"@language":"de-t-sv-t0-mtec","@value":"Ende der Fahrbahn"},{"@language":"el-t-sv-t0-mtec","@value":"Τέλος οδοστρώματος"},{"@language":"en-t-sv-t0-mtec","@value":"End of roadway"},{"@language":"es-t-sv-t0-mtec","@value":"Fin de la carretera"},{"@language":"et-t-sv-t0-mtec","@value":"Tee lõpp"},{"@language":"fi-t-sv-t0-mtec","@value":"Tien pää"},{"@language":"fr-t-sv-t0-mtec","@value":"Fin de la chaussée"},{"@language":"ga-t-sv-t0-mtec","@value":"Deireadh an bhóthair"},{"@language":"hr-t-sv-t0-mtec","@value":"Kraj ceste"},{"@language":"hu-t-sv-t0-mtec","@value":"Az út vége"},{"@language":"it-t-sv-t0-mtec","@value":"Fine della carreggiata"},{"@language":"lt-t-sv-t0-mtec","@value":"Kelio pabaiga"},{"@language":"lv-t-sv-t0-mtec","@value":"Ceļa beigas"},{"@language":"mt-t-sv-t0-mtec","@value":"Tmiem it-triq"},{"@language":"nl-t-sv-t0-mtec","@value":"Einde van de rijbaan"},{"@language":"pl-t-sv-t0-mtec","@value":"Koniec drogi"},{"@language":"pt-t-sv-t0-mtec","@value":"Fim da estrada"},{"@language":"ro-t-sv-t0-mtec","@value":"Sfârșitul drumului"},{"@language":"sk-t-sv-t0-mtec","@value":"Koniec vozovky"},{"@language":"sl-t-sv-t0-mtec","@value":"Konec cestišča"},{"@language":"sv","@value":"Vägräckesavslutning"},{"@language":"uk-t-sv-t0-mtec","@value":"Кінець проїжджої частини"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},"http://entryscape.org/terms/metadataIdentifier":"769c3971-8c6a-4486-997b-4bf37570e189","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Levereras vid beställning. Licens krävs."},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/RoadAuthority/term2"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/C"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"http://data.europa.eu/88u/distribution/0cf2985e-0bc4-49ea-9ec8-893c52fecac7","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},"dcat:accessURL":{"@id":"http://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo?layers=V%C3%A4gr%C3%A4ckesavslutning"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"NB: За достъп/изглед поставете връзката за адрес за достъп в съответния софтуер. След това изберете слоя, който съответства на набора от данни."},{"@language":"cs-t-sv-t0-mtec","@value":"Pozn.: Pro přístup/zobrazení vložte odkaz na přístupovou adresu do příslušného softwaru. Poté vyberte vrstvu, která odpovídá datové sadě."},{"@language":"da-t-sv-t0-mtec","@value":"NB: For adgang/visning skal du indsætte adgangsadresselinket i den relevante software. Vælg derefter det lag, der svarer til datasættet."},{"@language":"de-t-sv-t0-mtec","@value":"NB: Fügen Sie für den Zugriff/die Ansicht den Link zur Zugriffsadresse in die entsprechende Software ein. Wählen Sie dann die Ebene aus, die dem Datensatz entspricht."},{"@language":"el-t-sv-t0-mtec","@value":"ΣΗΜ.: Για πρόσβαση/προβολή, επικολλήστε τον σύνδεσμο διεύθυνσης πρόσβασης στο κατάλληλο λογισμικό. Στη συνέχεια, επιλέξτε το επίπεδο που αντιστοιχεί στο σύνολο δεδομένων."},{"@language":"en-t-sv-t0-mtec","@value":"N.B.: For access/view, paste the access address link into the appropriate software. Then select the layer that corresponds to the data set."},{"@language":"es-t-sv-t0-mtec","@value":"N.B.: Para acceder/ver, pegue el enlace de la dirección de acceso en el software apropiado. A continuación, seleccione la capa que corresponde al conjunto de datos."},{"@language":"et-t-sv-t0-mtec","@value":"NB! Juurdepääsuks/vaatamiseks kleebi juurdepääsu aadressi link vastavasse tarkvarasse. Seejärel valige andmekogumile vastav kiht."},{"@language":"fi-t-sv-t0-mtec","@value":"Huom. Jos haluat käyttää / tarkastella, liitä käyttöoikeusosoitelinkki asianmukaiseen ohjelmistoon. Valitse sitten tietojoukkoa vastaava taso."},{"@language":"fr-t-sv-t0-mtec","@value":"N.B.: Pour accéder/voir, collez le lien d'adresse d'accès dans le logiciel approprié. Sélectionnez ensuite la couche qui correspond à l'ensemble de données."},{"@language":"ga-t-sv-t0-mtec","@value":"N.B.: Chun rochtain/amharc a fháil, greamaigh an nasc seoladh rochtana isteach sna bogearraí iomchuí. Ansin roghnaigh an ciseal a fhreagraíonn don tacar sonraí."},{"@language":"hr-t-sv-t0-mtec","@value":"Napomena: Za pristup/pregled zalijepite poveznicu za pristupnu adresu u odgovarajući softver. Zatim odaberite sloj koji odgovara skupu podataka."},{"@language":"hu-t-sv-t0-mtec","@value":"Megjegyzés: A hozzáféréshez/megtekintéshez illessze be a hozzáférési cím hivatkozását a megfelelő szoftverbe. Ezután válassza ki az adatkészletnek megfelelő réteget."},{"@language":"it-t-sv-t0-mtec","@value":"N.B.: Per accedere/visualizzare, incollare il link dell'indirizzo di accesso nel software appropriato. Quindi selezionare il livello corrispondente al set di dati."},{"@language":"lt-t-sv-t0-mtec","@value":"N.B.: Norėdami pasiekti / peržiūrėti, įklijuokite prieigos adreso nuorodą į atitinkamą programinę įrangą. Tada pasirinkite duomenų rinkinį atitinkantį sluoksnį."},{"@language":"lv-t-sv-t0-mtec","@value":"NB! Lai piekļūtu/skatītu, ielīmējiet piekļuves adreses saiti attiecīgajā programmatūrā. Pēc tam atlasiet slāni, kas atbilst datu kopai."},{"@language":"mt-t-sv-t0-mtec","@value":"N.B.: Għal aċċess/dehra, ippejstja l-link tal-indirizz tal-aċċess fis-software xieraq. Imbagħad agħżel is-saff li jikkorrispondi għas-sett tad-data."},{"@language":"nl-t-sv-t0-mtec","@value":"N.B.: Voor toegang/weergave plakt u de link naar het toegangsadres in de juiste software. Selecteer vervolgens de laag die overeenkomt met de gegevensset."},{"@language":"pl-t-sv-t0-mtec","@value":"Uwaga: Aby uzyskać dostęp/widok, wklej link adresu dostępu do odpowiedniego oprogramowania. Następnie wybierz warstwę odpowiadającą zestawowi danych."},{"@language":"pt-t-sv-t0-mtec","@value":"N.B.: Para aceder/visualizar, cole a ligação do endereço de acesso no software adequado. Em seguida, selecione a camada que corresponde ao conjunto de dados."},{"@language":"ro-t-sv-t0-mtec","@value":"N.B.: Pentru acces/vizualizare, lipiți linkul adresei de acces în software-ul corespunzător. Apoi selectați stratul care corespunde setului de date."},{"@language":"sk-t-sv-t0-mtec","@value":"Pozn.: Pre prístup/zobrazenie vložte odkaz na prístupovú adresu do príslušného softvéru. Potom vyberte vrstvu, ktorá zodpovedá množine údajov."},{"@language":"sl-t-sv-t0-mtec","@value":"Opomba: Za dostop/ogled prilepite povezavo do naslova za dostop v ustrezno programsko opremo. Nato izberite plast, ki ustreza naboru podatkov."},{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},{"@language":"uk-t-sv-t0-mtec","@value":"Н.Б.: Для доступу/перегляду вставте посилання адреси доступу у відповідне програмне забезпечення. Потім виберіть шар, який відповідає набору даних."}],"dct:format":"application/vnd.ogc.wms_xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"NVDB Прекратяване на пътното движение - показване в NetInfo"},{"@language":"cs-t-sv-t0-mtec","@value":"NVDB Ukončení silničního provozu - zobrazení v NetInfo"},{"@language":"da-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - visning i NetInfo"},{"@language":"de-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - Anzeige in NetInfo"},{"@language":"el-t-sv-t0-mtec","@value":"NVDB Τερματισμός Οδικής Κυκλοφορίας - εμφάνιση στο NetInfo"},{"@language":"en-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - display in NetInfo"},{"@language":"es-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - mostrar en NetInfo"},{"@language":"et-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - kuvamine NetInfos"},{"@language":"fi-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - Näytön NetInfo"},{"@language":"fr-t-sv-t0-mtec","@value":"NVDB Road Traffic Termination - affichage dans NetInfo"},{"@language":"ga-t-sv-t0-mtec","@value":"Foirceannadh Tráchta Bóthair NVDB - tais