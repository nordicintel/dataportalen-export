402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Information:Produktspecfikation/2"},{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Nedladdning:data/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=68dbb479-b007-4c1c-8bad-c9f3cdb4bf71"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2026-02-03"},"dct:description":{"@language":"sv","@value":"Laserpunktmoln från flygning 2025. Täcker hela Stockholms kommun inkl buffertzon runt. Filformat: LAS och POD. Flyghöjd: Punkttäthet: 16 pkt/m² Flygdatum: 1-3 april 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000. Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre. Markklassificeringen är manuellt kontrollerad medan byggnadsklassningen är helt automatiskt utförd och kan vara av varierande kvalitet. Klassning av laserdata delas upp i följande klasser: 1 (Oklassificerat); 2 (Mark); 6 (Byggnad); 7 (Hög- och Lågpunkter sk. brus); 9 (Vatten); 17 (Broar). Punktmolnet har färgsatts med hjälp av ortofotot från 2025, vilket innebär att varje punkt har tilldelats ett RGB-värde från motsvarande pixel i ortofotot. (Fotograferingsdatum för ortofotot: 20 och 31 maj, 15 juni och 1 juli 2025)"},"dct:identifier":"c2c5f260-2da1-45ff-98ce-29b621e09242","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:4856b6ece1af2739f35f9fa6f5b7ab8deca7c0ff44edb693c1414e5846f109a3_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Punktmoln - flygburen laserskanning (2025)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242#HTTP:Information:Produkt