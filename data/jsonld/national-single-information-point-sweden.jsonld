n in het product Stadskaart"},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się w produkcie Mapa miasta"},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no produto Mapa da cidade"},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în produs Harta orașului"},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor údajov je súčasťou produktu Mapa mesta"},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni niz je vključen v produkt Zemljevid mesta"},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних включений в продукт Карта міста"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/251efe63-2466-47aa-8191-fc75c1718506"}},{"@id":"http://data.europa.eu/88u/record/9289b578-bb07-40de-99da-0530c5e4e220","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/251efe63-2466-47aa-8191-fc75c1718506"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"9289b578-bb07-40de-99da-0530c5e4e220","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:10Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:20Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/9289b578-bb07-40de-99da-0530c5e4e220"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:f77609b691ba3255e0c6ea1155b44471b64616926b4fb1a582740f3890f78eb6_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/9289b578-bb07-40de-99da-0530c5e4e220"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:20Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id