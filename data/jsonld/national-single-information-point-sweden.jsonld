adata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:693b3d06a6b0911dbae9097832bb0f5561dd8918ae555501a5498952e8e6923f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Energideklarationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://metadata.boverket.se/store/1/resource/44","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/25"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/45"},"dcat:isVersionOf":{"@id":"https://metadata.boverket.se/store/1/resource/26"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://sokenergideklaration.boverket.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Denna e-tjänst ger dig möjlighet att söka efter energideklarerade byggnader. Basuppgifterna från energideklarationen kan du direkt ta del av i e-tjänsten. Du kan även beställa energideklarationen i sin helhet i e-tjänsten.\nÄr du byggnadsägare eller har en fullmakt (ombud) kan du alltid söka fram och ladda ned energideklarationen i sin helhet för de byggnader som du äger eller har en fullmakt (ombud) för."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"E-tjänst för Energideklarationer"}},{"@id":"https://metadata.boverket.se/store/1/resource/45","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sokenergideklaration.boverket.se/search"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"E-tjänst för PDF"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:696a3e27ade123b0aca48918c72d1104f9eb66effd72f060acf6431e8eecd520"},{"@graph":[{"@id":"_:697dc9d50e59b68a4dd18f2ba987db3f2b5e34f04e88f765fbc82ed37fb73f39_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4421,18.2011 59.4421,18.2011 59.2272,17.7605 59.2272,17.7605 59.4421))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4421,18.2011 59.4421,18.2011 59.2272,17.7605 59.2272,17.7605 59.4421))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5#HTTP:ESRI+Portal-URL/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5b421110-87a5-4425-8fef-61ed0ddf7ca0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-12-31"},"dct:description":{"@language":"sv","@value":"Provtagning 2022. Provtagning med peristaltisk pump ur nivårör eller miljörör efter 3 volymers omsättning, eller från källa/brunn/vattendrag direkt till provtagningskärl för hand. Syftet med genomförda undersökningar har framför allt varit att översiktligt undersöka grundvattenkvaliteten i staden för att bevaka vilken kemisk påverkan staden har på mark och vatten samt följa hur påverkan förändras över tid."},"dct:identifier":"4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:697dc9d50e59b68a4dd18f2ba987db3f2b5e34f04e88f765fbc82ed37fb73f39_b0n0"},"dct:title":{"@language":"sv","@value":"Grundvattenkvalitet 2022"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/5726f51da122400babfa3a181c07bdd7_15/explore"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:697dc9d50e59b68a4dd18f2ba987db3f2b5e34f04e88f765fbc82ed37fb73f39"},{"@graph":[{"@id":"_:69aed889602cb3a244d0c761f95b72df69182c8f175ef755cfbe649101a28e4c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:69aed889602cb3a244d0c761f95b72df69182c8f175ef755cfbe649101a28e4c_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-20"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-20"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information:Produktspecfikation/3"},{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:OGC:WMS/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f53645a8-ea71-4fa0-bd8c-6524fee7f379"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000\""},"dct:identifier":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:69aed889602cb3a244d0c761f95b72df69182c8f175ef755cfbe649101a28e4c_b0n0"},"dct:temporal":{"@id":"_:69aed889602cb3a244d0c761f95b72df69182c8f175ef755cfbe649101a28e4c_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant (2025)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information:Produktspecfikation/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dat