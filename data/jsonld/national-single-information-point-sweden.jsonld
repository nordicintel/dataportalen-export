ce:2b16c83e32ebbeb519d959a81277e394d4da4d8c5c71702cb5f97ebd4045a625"},{"@graph":[{"@id":"_:2b76ca4ee4d1190ff2d5ff22a9c97efced9b0256d8a4bc0eed443d86b7f00b44_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:OGC:WMS/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2e0a1e12-0d10-45af-9cb0-9ae6cc095c66"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000\""},"dct:identifier":"c697ef48-613a-4a48-a554-a46633977896","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2b76ca4ee4d1190ff2d5ff22a9c97efced9b0256d8a4bc0eed443d86b7f00b44_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant (2023)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2023"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"Ortofoto 2023"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:2b76ca4ee4d1190ff2d5ff22a9c97efced9b0256d8a4bc0eed443d86b7f00b44"},{"@graph":[{"@id":"_:2c5e284bb4d5c78b34c5134c84a95eeed85eb3b22fdc0f11ee45d6d43656114e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:2c5e284bb4d5c78b34c5134c84a95eeed85eb3b22fdc0f11ee45d6d43656114e_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2017-05-04"},"dcat:startDate":{"@type":"xsd:date","@value":"2017-04-21"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2017-05-04"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2017-04-21"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"