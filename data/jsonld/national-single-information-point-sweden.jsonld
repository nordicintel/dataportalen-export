ata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=13439fb8-7368-4c97-a599-19af9ece0bd8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"1949-06-01"},"dct:description":{"@language":"sv","@value":"Flygbilder för framställning av stereobilder för fotogrametriskt mätning. Bilderna togs i varierande omfattning mellan åren 1949 och 1981. För att få en uppfattning var man flög och när hänvisas till flygstråksöversikterna. Bilderna ligger som papperskopior och/eller negativ i stadsbyggnadskontorets arkiv."},"dct:identifier":"584dc6de-3231-4efe-9d6a-aa12f97e03e0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:00ab6bfe1ab8cdd99a41be4da0286fa851743e1f466523a5400c22060688a091_b0n0"},"dct:temporal":{"@id":"_:00ab6bfe1ab8cdd99a41be4da0286fa851743e1f466523a5400c22060688a091_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Historiska flygbilder (1949 - 1981)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/584dc6de-3231-4efe-9d6a-aa12f97e03e0#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@