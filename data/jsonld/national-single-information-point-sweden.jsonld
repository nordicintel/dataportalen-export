e","dct:title":"INFO beskutfall 2024.docx"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2455","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2454"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2454"},"dct:description":{"@language":"sv","@value":"Preliminärt beskattningsutfall\nDet preliminära beskattningsutfallet för inkomstår 2024 (som deklareras 2025) planeras vara tillgängligt på webbplatsen följande datum:\n•\tPrognos 1 den 10 april 2025\n•\tPrognos 2 den 8 maj 2025\n•\tPrognos 3 den 5 juni 2025\n•\tPrognos 4 den 3 juli 2025\n•\tPrognos 5 den 7 augusti 2025\n•\tPrognos 6 den 4 september 2025\n•\tPrognos 7 den 2 oktober 2025\n•\tPrognos 8 den 23 oktober 2025\n•\tPrognos 9 den 20 november 2025\nSlutligt beskattningsutfall\nDet slutliga beskattningsutfallet för inkomstår 2024 (som deklareras 2025) är tillgängligt från klockan 14:00 den 8 december 2025."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/TXT"},"dct:title":{"@language":"sv","@value":"Datum för publicering beskattningsutfall för inkomstår 2024"}},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2477","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"tyrb920x1_0089.csv"},{"@id":"https://skatteverket.entryscape.net/store/9/resource/2478","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2477"},"dcat:downloadURL":{"@id":"https://skatteverket.entryscape.net/store/9/resource/2477"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2025-04-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-08T04:49:07.197Z"},"dct:title":{"@languag