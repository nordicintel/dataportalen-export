 даних включений в продукт Карта міста"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/fd87910f-6fac-45fa-8fcd-dfbbbca1796b"}},{"@id":"http://data.europa.eu/88u/record/77e5ef4d-bf7a-4cb4-95bb-f5f6a9f368c2","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/fd87910f-6fac-45fa-8fcd-dfbbbca1796b"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"77e5ef4d-bf7a-4cb4-95bb-f5f6a9f368c2","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:18Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:14Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/77e5ef4d-bf7a-4cb4-95bb-f5f6a9f368c2"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:b80bb985421974277399632f4c305e68decbaba580ec7e2e51c4b2948e888307_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/77e5ef4d-bf7a-4cb4-95bb-f5f6a9f368c2"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:14Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/v