data-theme/ECON"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Med hjälp av API:et Beskattningsunderlag Fastighet får du underlag för fastighetsavgift och fastighetsskatt vid en förutbestämd tidpunkt per fastighetsägare."},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2023-07-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Beskattningsunderlag fastighet"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-fastighet/1.0.4/swagger.json%2523accessService"}},{"@id":"http://data.europa.eu/88u/distribution/85d54470-4426-4427-b7e4-797f971adc1a","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-fastighet/1.0.4/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beskattningsunderlag-fastighet/1.0.4/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-fastighet/1.0.4/swagger.json"},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2023-07-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Облагаема стойност на недвижим имот"},{"@language":"cs-t-sv-t0-mtec","@value":"Zdanitelná čás