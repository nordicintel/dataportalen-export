0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-fastighetstaxering-innehav-2-3-0-2523dataset~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-10-09T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-10-11T04:47:50Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%2523dataset","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/fastighetstaxering-innehav/2.3.0/%2523dataset"}},{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]}],"@id":"urn:source:315050721384e2c15521e3da619d7b1ad8c3ed7fbe2121e46f1ee7e893357add"},{"@graph":[{"@id":"_:33586d288fad4439e402c7593a52802841b8459c7bfdc97ca8fe8801e5ec92b8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4431,18.2011 59.4431,18.2011 59.2272,17.7605 59.2272,17.7605 59.4431))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4431,18.2011 59.4431,18.2011 59.2272,17.7605 59.2272,17.7605 59.4431))"}},{"@id":"_:33586d288fad4439e402c7593a52802841b8459c7bfdc97ca8fe8801e5ec92b8_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1528aa5d1d32e5ee24b6c242b7285f43a0"},{"@id":"_:33586d288fad4439e402c7593a52802841b8459c7bfdc97ca8fe8801e5ec92b8_b2n0","dct:identifier":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/2","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/72e1126f-b672-4304-a97f-531e9b9d9af8"}},{"@id":"http://data.europa.eu/88u/dataset/115430a9-87a9-467a-8d64-138a020ff63f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/0d76ce7c-2d82-49db-9142-02408ddda797"},{"@id":"http://data.europa.eu/88u/distribution/72e1126f-b672-4304-a97f-531e9b9d9af8"},{"@id":"http://data.europa.eu/88u/distribution/77f53acf-7abe-4f4e-9c3f-6ec813247d79"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3ae518bf-a7c4-4dd4-bea4-b14766d5e7c9"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2014-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"показва, че картографирането на радиационната температура на земната повърхност е взето от спътника на САЩ Landsat 8 за периода юни 2013 г. — септември 2021 г. Появява се като прекъсвания, топлинни острови, където температурата надвишава 35 градуса, и като температурни криви. За повече информация вж. https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"cs-t-sv-t0-mtec","@value":"mapování radiační teploty na zemském povrchu je převzato z americké družice Landsat 8 za období od června 2013 do září 2021. Objevuje se jako přestávky, tepelné ostrovy, kde teplota přesahuje 35 stupňů, a jako teplotní křivky. Více informací viz https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"da-t-sv-t0-mtec","@value":"viser kortlægningen af strålingstemperaturen ved jordoverfladen er taget fra den amerikanske satellit Landsat 8 for perioden juni 2013 til september 2021. Vises som pauser, varme øer, hvor temperaturen overstiger 35 grader, og som temperaturkurver. For mere information, se https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"de-t-sv-t0-mtec","@value":"zeigt die Kartierung der Strahlungstemperatur an der Bodenoberfläche vom US-Satelliten Landsat 8 für den Zeitraum Juni 2013 bis September 2021. Erscheint als Pausen, Hitzeinseln, auf denen die Temperatur 35 Grad überschreitet, und als Temperaturkurven. Weitere Informationen finden Sie unter https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"el-t-sv-t0-mtec","@value":"δείχνει ότι η χαρτογράφηση της θερμοκρασίας ακτινοβολίας στην επιφάνεια του εδάφους λαμβάνεται από τον αμερικανικό δορυφόρο Landsat 8 για την περίοδο από τον Ιούνιο του 2013 έως τον Σεπτέμβριο του 2021. Εμφανίζεται ως διαλείμματα, θερμικές νησίδες όπου η θερμοκρασία υπερβαίνει τους 35 βαθμούς και ως καμπύλες θερμοκρασίας. Για περισσότερες πληροφορίες, βλ. https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"en-t-sv-t0-mtec","@value":"shows the mapping of radiation temperature at the ground surface is taken from the US satellite Landsat 8 for the period June 2013 to September 2021. Appears as breaks, heat islands where the temperature exceeds 35 degrees, and as temperature curves. For more information, see https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"es-t-sv-t0-mtec","@value":"muestra que la cartografía de la temperatura de la radiación en la superficie del suelo se ha tomado del satélite estadounidense Landsat 8 para el período comprendido entre junio de 2013 y septiembre de 2021. Aparece como roturas, islas de calor donde la temperatura supera los 35 grados, y como curvas de temperatura. Para obtener más información, consulte https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"et-t-sv-t0-mtec","@value":"näitab, et maapinna kiirgustemperatuuri kaardistamine on võetud USA satelliidilt Landsat 8 ajavahemiku kohta 2013. aasta juunist 2021. aasta septembrini. Ilmub vaheaegadena, soojussaartena, kus temperatuur ületab 35 kraadi, ja temperatuurikõveratena. Lisateabe saamiseks vt https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"fi-t-sv-t0-mtec","@value":"osoittaa, että maanpinnan säteilylämpötilan kartoitus on otettu yhdysvaltalaisesta Landsat 8 -satelliitista kesäkuun 2013 ja syyskuun 2021 väliseltä ajalta. Esiintyy taukoina, lämpösaarekkeina, joissa lämpötila ylittää 35 astetta, ja lämpötilakäyrinä. Lisätietoja: https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"fr-t-sv-t0-mtec","@value":"montre que la cartographie de la température de rayonnement à la surface du sol est tirée du satellite américain Landsat 8 pour la période allant de juin 2013 à septembre 2021. Apparaît comme des pauses, des îlots de chaleur où la température dépasse 35 degrés, et comme des courbes de température. Pour plus d'informations, voir https://miljobarometern.stockholm.se/content/docs/theme/climat/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"ga-t-sv-t0-mtec","@value":"léiríonn sé go dtógtar mapáil na teochta radaíochta ag dromchla na talún ó shatailít na Stát Aontaithe Landsat 8 don tréimhse ó Mheitheamh 2013 go Meán Fómhair 2021. Dealraíonn sé mar shosanna, oileáin teasa ina bhfuil an teocht níos mó ná 35 céim, agus mar chuair teochta. Chun tuilleadh eolais a fháil, féach https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"hr-t-sv-t0-mtec","@value":"prikazuje mapiranje temperature zračenja na površini tla preuzeto je s američkog satelita Landsat 8 za razdoblje od lipnja 2013. do rujna 2021. Pojavljuje se kao lomovi, toplinski otoci gdje temperatura prelazi 35 stupnjeva i kao temperaturne krivulje. Za više informacija vidjeti https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"hu-t-sv-t0-mtec","@value":"megmutatja a földfelszín sugárzási hőmérsékletének térképét az amerikai Landsat 8 műholdról a 2013 júniusa és 2021 szeptembere közötti időszakra vonatkozóan. Úgy jelenik meg, mint szünetek, hőszigetek, ahol a hőmérséklet meghaladja a 35 fokot, és a hőmérsékleti görbék. További információkért lásd: https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"it-t-sv-t0-mtec","@value":"mostra che la mappatura della temperatura delle radiazioni sulla superficie del suolo è ripresa dal satellite statunitense Landsat 8 per il periodo giugno 2013-settembre 2021. Appare come pause, isole di calore dove la temperatura supera i 35 gradi e come curve di temperatura. Per ulteriori informazioni, vedere https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"lt-t-sv-t0-mtec","@value":"rodo, kad nuo 2013 m. birželio mėn. iki 2021 m. rugsėjo mėn. iš JAV palydovo „Landsat 8“ sudarytas radiacijos temperatūros žemės paviršiuje žemėlapis. Pasirodo kaip pertraukos, šilumos salos, kuriose temperatūra viršija 35 laipsnius, ir kaip temperatūros kreivės. Daugiau informacijos rasite https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"lv-t-sv-t0-mtec","@value":"parāda, ka radiācijas temperatūras kartējums uz zemes virsmas ir ņemts no ASV satelīta Landsat 8 laikposmā no 2013. gada jūnija līdz 2021. gada septembrim. Parādās kā pārtraukumi, siltuma salas, kur temperatūra pārsniedz 35 grādus, un kā temperatūras līknes. Plašāku informāciju sk. https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"mt-t-sv-t0-mtec","@value":"turi li l-immappjar tat-temperatura tar-radjazzjoni fil-wiċċ tal-art jittieħed mis-satellita tal-Istati Uniti Landsat 8 għall-perjodu minn Ġunju 2013 sa Settembru 2021. Jidher bħala pawżi, gżejjer tas-sħana fejn it-temperatura taqbeż il-35 grad, u bħala kurvi tat-temperatura. Għal aktar informazzjoni, ara https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"nl-t-sv-t0-mtec","@value":"toont aan dat de kaart van de stralingstemperatuur op het grondoppervlak is genomen van de Amerikaanse satelliet Landsat 8 voor de periode juni 2013 tot september 2021. Verschijnt als pauzes, warmte-eilanden waar de temperatuur hoger is dan 35 graden, en als temperatuurkrommen. Zie voor meer informatie https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"pl-t-sv-t0-mtec","@value":"pokazuje odwzorowanie temperatury promieniowania na powierzchni ziemi pobrane z amerykańskiego satelity Landsat 8 za okres od czerwca 2013 r. do września 2021 r. Pojawia się jako przerwy, wyspy ciepła, w których temperatura przekracza 35 stopni, oraz jako krzywe temperatury. Więcej informacji można znaleźć na stronie https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"pt-t-sv-t0-mtec","@value":"mostra que o mapeamento da temperatura da radiação à superfície do solo é retirado do satélite norte-americano Landsat 8 para o período de junho de 2013 a setembro de 2021. Aparece como quebras, ilhas de calor onde a temperatura excede 35 graus, e como curvas de temperatura. Para mais informações, ver https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satélite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"ro-t-sv-t0-mtec","@value":"arată cartografierea temperaturii radiațiilor la suprafața solului este luată de la satelitul american Landsat 8 pentru perioada iunie 2013-septembrie 2021. Apare ca pauze, insule de căldură în cazul în care temperatura depășește 35 de grade, și ca curbe de temperatură. Pentru mai multe informații, a se vedea https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analyses-fr%C3%A5n-satelit-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"sk-t-sv-t0-mtec","@value":"ukazuje mapovanie teploty žiarenia na zemskom povrchu je prevzatý z amerického satelitu Landsat 8 za obdobie od júna 2013 do septembra 2021. Objavuje sa ako prestávky, tepelné ostrovy, kde teplota presahuje 35 stupňov, a ako teplotné krivky. Viac informácií nájdete na https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"sl-t-sv-t0-mtec","@value":"Prikazuje kartiranje temperature sevanja na površini tal iz ameriškega satelita Landsat 8 za obdobje od junija 2013 do septembra 2021. Pojavi se kot prelomi, toplotni otoki, kjer temperatura presega 35 stopinj, in kot temperaturne krivulje. Za več informacij glej https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysis-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"sv","@value":"visar kartering av strålningstemperatur vid markytan är hämtade från den amerikanska satelliten Landsat 8 för perionden juni 2013 till september 2021. Visas som raster, värmeöar där temperaturen överstiger 35 grader, och som temperaturkurvor. För mer information, se https://miljobarometern.stockholm.se/content/docs/tema/klimat/varme/Temperaturanalyser-fr%C3%A5n-satellit-%C3%B6ver-Stockholms-stad.pdf"},{"@language":"uk-t-sv-t0-mtec","@value":"показує відображення температури випромінювання на поверхні землі взято з американського супутника Landsat 8 за період з червня 2013 року по вересень 2021 року. З'являється у вигляді розривів, теплових островів, де температура перевищує 35 градусів, і у вигляді температурних кривих. Для отримання додаткової інформації дивіться https://miljobarometern.stockholm.se/content/docs/theme/climate/heat/Temperature analysiss-fr%C3%A5n-satellite-%C3%B6ver-Stockholms-stad.pdf"}],"dct:format":"text/html","dct:identifier":"115430a9-87a9-467a-8d64-138a020ff63f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:33586d288fad4439e402c7593a52802841b8459c7bfdc97ca8fe8801e5ec92b8_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Картографиране на температурата за периода 2013—2021 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapování teploty 2013–2021"},{"@language":"da-t-sv-t0-mtec","@value":"Kortlægning af temperatur 2013-2021"},{"@language":"de-t-sv-t0-mtec","@value":"Temperaturkartierung 2013-2021"},{"@language":"el-t-sv-t0-mtec","@value":"Χαρτογράφηση θερμοκρασίας 2013-2021"},{"@language":"en-t-sv-t0-mtec","@value":"Temperature mapping 2013-2021"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de temperatura 2013-2021"},{"@language":"et-t-sv-t0-mtec","@value":"Temperatuuri kaardistamine 2013–2021"},{"@language":"fi-t-sv-t0-mtec","@value":"Lämpötilakartoitus 2013-2021"},{"@language":"fr-t-sv-t0-mtec","@value":"Cartographie des températures 2013-2021"},{"@language":"ga-t-sv-t0-mtec","@value":"Mapáil teochta 2013-2021"},{"@language":"hr-t-sv-t0-mtec","@value":"Mapiranje temperature 2013.–2021."},{"@language":"hu-t-sv-t0-mtec","@value":"Hőmérséklet-térképezés 2013–2021 között"},{"@language":"it-t-sv-t0-mtec","@value":"Mappatura della temperatura 2013-2021"},{"@language":"lt-t-sv-t0-mtec","@value":"2013–2021 m. temperatūros nustatymas"},{"@language":"lv-t-sv-t0-mtec","@value":"Temperatūras kartēšana 2013.–2021. gadā"},{"@language":"mt-t-sv-t0-mtec","@value":"Immappjar tat-temperatura 2013-2021"},{"@language":"nl-t-sv-t0-mtec","@value":"Temperatuurmapping 2013-2021"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapowanie temperatury 2013–2021"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapeamento da temperatura 2013-2021"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta temperaturilor 2013-2021"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapovanie teploty v rokoch 2013 – 2021"},{"@language":"sl-t-sv-t0-mtec","@value":"Kartiranje temperature v obdobju 2013–2021"},{"@language":"sv","@value":"Temperaturkartering 2013-2021"},{"@language":"uk-t-sv-t0-mtec","@value":"Температурне картографування 2013-2021"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/0d76ce7c-2d82-49db-9142-02408ddda797","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/content/114e80ab8ea24ea4b4c38f95c5921f42/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/1","dct:title":["Maximal strålningstemperatur",{"@language":"bg-t-sv-t0-mtec","@value":"Максимална температура на излъчване"},{"@language":"cs-t-sv-t0-mtec","@value":"Maximální teplota záření"},{"@language":"da-t-sv-t0-mtec","@value":"Maksimal strålingstemperatur"},{"@language":"de-t-sv-t0-mtec","@value":"Maximale Strahlungstemperatur"},{"@language":"el-t-sv-t0-mtec","@value":"Μέγιστη θερμοκρασία ακτινοβολίας"},{"@language":"en-t-sv-t0-mtec","@value":"Maximum radiant temperature"},{"@language":"es-t-sv-t0-mtec","@value":"Temperatura radiante máxima"},{"@language":"et-t-sv-t0-mtec","@value":"Maksimaalne kiirgustemperatuur"},{"@language":"fi-t-sv-t0-mtec","@value":"Säteilyn enimmäislämpötila"},{"@language":"fr-t-sv-t0-mtec","@value":"Température rayonnante maximale"},{"@language":"ga-t-sv-t0-mtec","@value":"Uasteocht radanta"},{"@language":"hr-t-sv-t0-mtec","@value":"Najveća temperatura zračenja"},{"@language":"hu-t-sv-t0-mtec","@value":"Maximális sugárzási hőmérséklet"},{"@language":"it-t-sv-t0-mtec","@value":"Temperatura radiante massima"},{"@language":"lt-t-sv-t0-mtec","@value":"Didžiausia spinduliavimo temperatūra"},{"@language":"lv-t-sv-t0-mtec","@value":"Maksimālā starojuma temperatūra"},{"@language":"mt-t-sv-t0-mtec","@value":"Temperatura radjanti massima"},{"@language":"nl-t-sv-t0-mtec","@value":"Maximale stralingstemperatuur"},{"@language":"pl-t-sv-t0-mtec","@value":"Maksymalna temperatura promieniowania"},{"@language":"pt-t-sv-t0-mtec","@value":"Temperatura radiante máxima"},{"@language":"ro-t-sv-t0-mtec","@value":"Temperatura radiantă maximă"},{"@language":"sk-t-sv-t0-mtec","@value":"Maximálna teplota sálavého žiarenia"},{"@language":"sl-t-sv-t0-mtec","@value":"Najvišja temperatura sevanja"},{"@language":"uk-t-sv-t0-mtec","@value":"Максимальна промениста температура"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0d76ce7c-2d82-49db-9142-02408ddda797"}},{"@id":"http://data.europa.eu/88u/distribution/72e1126f-b672-4304-a97f-531e9b9d9af8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/b6407ffc9c6e4b219e7de542d8cf9b18/about"},"dct:format":"text/html","dct:title":"Temperaturkurvor & värmeöar"},{"@id":"http://data.europa.eu/88u/distribution/77f53acf-7abe-4f4e-9c3f-6ec813247d79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/3","dct:title":["Kartapplikation",{"@language":"bg-t-sv-t0-mtec","@value":"Температурни криви и топлинни острови"},{"@language":"cs-t-sv-t0-mtec","@value":"Teplotní křivky & tepelné ostrovy"},{"@language":"da-t-sv-t0-mtec","@value":"Temperaturkurver og varmeøer"},{"@language":"de-t-sv-t0-mtec","@value":"Temperaturkurven & Wärmeinseln"},{"@language":"el-t-sv-t0-mtec","@value":"Καμπύλες θερμοκρασίας & νησίδες θερμότητας"},{"@language":"en-t-sv-t0-mtec","@value":"Temperature curves & heat islands"},{"@language":"es-t-sv-t0-mtec","@value":"Curvas de temperatura e islas de calor"},{"@language":"et-t-sv-t0-mtec","@value":"Temperatuurikõverad ja soojussaared"},{"@language":"fi-t-sv-t0-mtec","@value":"Lämpötilakäyrät & lämpösaarekkeet"},{"@language":"fr-t-sv-t0-mtec","@value":"Courbes de température & îlots de chaleur"},{"@language":"ga-t-sv-t0-mtec","@value":"Cuair teochta agus oileáin teasa"},{"@language":"hr-t-sv-t0-mtec","@value":"Temperaturne krivulje i toplinski otoci"},{"@language":"hu-t-sv-t0-mtec","@value":"Hőmérsékleti görbék és hőszigetek"},{"@language":"it-t-sv-t0-mtec","@value":"Curve di temperatura & isole di calore"},{"@language":"lt-t-sv-t0-mtec","@value":"Temperatūros kreivės ir šilumos salos"},{"@language":"lv-t-sv-t0-mtec","@value":"Temperatūras līknes un siltuma salas"},{"@language":"mt-t-sv-t0-mtec","@value":"Kurvi tat-temperatura u gżejjer tas-sħana"},{"@language":"nl-t-sv-t0-mtec","@value":"Temperatuurcurves & warmte-eilanden"},{"@language":"pl-t-sv-t0-mtec","@value":"Krzywe temperatury i wyspy ciepła"},{"@language":"pt-t-sv-t0-mtec","@value":"Curvas de temperatura & ilhas de calor"},{"@language":"ro-t-sv-t0-mtec","@value":"Curbe de temperatură și insule de căldură"},{"@language":"sk-t-sv-t0-mtec","@value":"Teplotné krivky a tepelné ostrovy"},{"@language":"sl-t-sv-t0-mtec","@value":"Temperaturne krivulje in toplotni otoki"},{"@language":"uk-t-sv-t0-mtec","@value":"Температурні криві та теплові острови"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/77f53acf-7abe-4f4e-9c3f-6ec813247d79"}},{"@id":"http://data.europa.eu/88u/distribution/cc9c98bd-95a9-477b-88b3-f5862f9dd114","dct:identifier":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/4","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Приложение за карта"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapová aplikace"},{"@language":"da-t-sv-t0-mtec","@value":"Kortansøgning"},{"@language":"de-t-sv-t0-mtec","@value":"Kartenantrag"},{"@language":"el-t-sv-t0-mtec","@value":"Εφαρμογή χάρτη"},{"@language":"en-t-sv-t0-mtec","@value":"Map application"},{"@language":"es-t-sv-t0-mtec","@value":"Aplicación de mapas"},{"@language":"et-t-sv-t0-mtec","@value":"Kaardirakendus"},{"@language":"fi-t-sv-t0-mtec","@value":"Karttasovellus"},{"@language":"fr-t-sv-t0-mtec","@value":"Application de la carte"},{"@language":"