n cases"},{"@language":"sv","@value":"Registreringsärenden"},{"@language":"sv","@value":"Stadgar"},{"@language":"sv","@value":"Säte"},{"@language":"sv","@value":"Verksamhetsbeskrivning"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation.5841.html"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:description":[{"@language":"en","@value":"Registered information on companies and organisations"},{"@language":"sv","@value":"Registrerad information om företag och organisationer"}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Information on companies and associations"},{"@language":"sv","@value":"Information om företag och organisationer"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/49"},"http://schema.org/offers":{"@id":"_:4ffad85795c903a40347d2e9ddf779b344d14ec106f44cfe1a58b412145635ef_b0n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:4ffad85795c903a40347d2e9ddf779b344d14ec106f44cfe1a58b412145635ef_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:4ffad85795c903a40347d2e9ddf779b344d14ec106f44cfe1a58b412145635ef_b2n0"},{"@id":"_:4ffad85795c903a40347d2e9ddf779b344d14ec106f44cfe1a58b412145635ef_b3n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/23","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.bolagsverket.se/store/2/resource/49"},"dcat:accessURL":{"@id":"https://www.bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation.3988.html"},"dct:description":[{"@language":"en","@value":"API requests presents structured JSON formatted data in response."},{"@language":"sv","@value":"API-förfrågningar ger strukturerad data i JSON-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"en","@value":"Information on companies and associations in JSON"},{"@language":"sv","@value":"Information om företag och organisationer i JSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/49","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:endpointDescription":{"@id":"https://portal.api.bolagsverket.se/devportal/apis/8ff6b16c-2d02-43bb-9a8e-f5afe4c768c3/overview"},"dcat:endpointURL":{"@id":"https://gw.api.bolagsverket.se/foretagsinformation/v3"},"dcat:keyword":{"@language":"sv","@value":"Bolagsverket"},"dcat:servesDataset":{"@id":"https://metadata.bolagsverket.se/store/2/resource/14"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API-förfrågningar ger strukturerad data i JSON-format."},"dct:title":[{"@language":"en","@value":"Business Information API"},{"@language":"sv","@value":"API för att hämta företagsinformation"}],"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"}}],"@id":"urn:source:4ffad85795c903a40347d2e9ddf779b344d14ec106f44cfe1a58b412145635ef"},{"@graph":[{"@id":"_:50a4b0bd61ebecc438bdbd1d2bad7a0735682136b89e0a2fa7efca6d789ea047_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4421,18.2011 59.4421,18.2011 59.2272,17.7605 59.2272,17.7605 59.4421))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4421,18.2011 59.4421,18.2011 59.2272,17.7605 59.2272,17.7605 59.4421))"}},{"@id":"_:50a4b0bd61ebecc438bdbd1d2bad7a0735682136b89e0a2fa7efca6d789ea047_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"123d30c5a4b281644859aa9b391d50a441"},{"@id":"http://data.europa.eu/88u/dataset/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/48a2a634-9160-4a11-b0de-7dcc4811b402"},{"@id":"http://data.europa.eu/88u/distribution/9883209b-ed92-4974-bd6e-dc0335de1134"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5b421110-87a5-4425-8fef-61ed0ddf7ca0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Вземане на проби през 2022 г. Вземане на проби с перисталтична помпа от ниво тръба или околната среда тръба след 3 обема оборот, или от кладенец/ямка/река директно до съда за вземане на проби на ръка. Целта на проведените проучвания е преди всичко да се проучи качеството на подземните води в града, за да се наблюдава химическото въздействие на града върху почвата и водата и да се наблюдава как въздействието се променя с течение на времето."},{"@language":"cs-t-sv-t0-mtec","@value":"Odběr vzorků v roce 2022. Odběr vzorků peristaltickým čerpadlem z hladinového potrubí nebo environmentálního potrubí po tříobjemovém obratu nebo z vrtu/jamky/řeky přímo do odběrné nádoby ručně. Účelem provedených studií byl především průzkum kvality podzemních vod ve městě za účelem monitorování chemického dopadu města na půdu a vodu a sledování toho, jak se dopad v průběhu času mění."},{"@language":"da-t-sv-t0-mtec","@value":"Prøveudtagning i 2022. Prøveudtagning med peristaltisk pumpe fra vandret rør eller miljørør efter omsætning på 3 volumener eller fra brønd/brønd/flod direkte til prøvetagningsbeholder i hånden. Formålet med de gennemførte undersøgelser har primært været at kortlægge grundvandskvaliteten i byen med henblik på at overvåge byens kemiske påvirkning af jord og vand og overvåge, hvordan påvirkningen ændrer sig over tid."},{"@language":"de-t-sv-t0-mtec","@value":"Probenahme im Jahr 2022. Probenahme mit Peristaltikpumpe vom Füllrohr oder Umweltrohr nach 3-Volumen-Umschlag oder vom Brunnen/Brunnen/Fluss direkt zum Probenahmegefäß von Hand. Der Zweck der durchgeführten Studien bestand in erster Linie darin, die Grundwasserqualität in der Stadt zu untersuchen, um die chemischen Auswirkungen der Stadt auf Boden und Wasser zu überwachen und zu überwachen, wie sich die Auswirkungen im Laufe der Zeit ändern."},{"@language":"el-t-sv-t0-mtec","@value":"Δειγματοληψία το 2022. Δειγματοληψία με περισταλτική αντλία από επίπεδο σωλήνα ή περιβαλλοντικό σωλήνα μετά από κύκλο εργασιών 3 όγκων ή από φρεάτιο/ φρεάτιο/ποταμό απευθείας στο δοχείο δειγματοληψίας με το χέρι. Σκοπός των μελετών που εκπονήθηκαν ήταν κυρίως η επισκόπηση της ποιότητας των υπόγειων υδάτων στην πόλη, προκειμένου να παρακολουθείται ο χημικός αντίκτυπος της πόλης στο έδαφος και το νερό και να παρακολουθείται ο τρόπος με τον οποίο μεταβάλλονται οι επιπτώσεις με την πάροδο του χρόνου."},{"@language":"en-t-sv-t0-mtec","@value":"Sampling in 2022. Sampling with peristaltic pump from level pipe or environmental pipe after 3 volumes turnover, or from well/well/river directly to sampling vessel by hand. The purpose of the studies carried out has primarily been to survey groundwater quality in the city in order to monitor the chemical impact of the city on soil and water and to monitor how the impact changes over time."},{"@language":"es-t-sv-t0-mtec","@value":"Muestreo en 2022. Muestreo con bomba peristáltica desde tubería nivelada o tubería ambiental después de 3 volúmenes de rotación, o desde pozo/pozo/río directamente al recipiente de muestreo a mano. El propósito de los estudios realizados ha sido principalmente inspeccionar la calidad de las aguas subterráneas en la ciudad con el fin de monitorear el impacto químico de la ciudad en el suelo y el agua y monitorear cómo cambia el impacto con el tiempo."},{"@language":"et-t-sv-t0-mtec","@value":"Väljavõtteline uuring 2022. aastal. Proovide võtmine peristaltilise pumbaga tasapinnalisest torust või keskkonnatorust pärast kolmemahulist käivet või puuraugust/kaevust/jõest otse käsitsi proovivõtuanumasse. Läbiviidud uuringute peamine eesmärk on olnud uurida linna põhjavee kvaliteeti, et jälgida linna keemilist mõju pinnasele ja veele ning jälgida, kuidas mõju aja jooksul muutub."},{"@language":"fi-t-sv-t0-mtec","@value":"Näytteenotto vuonna 2022. Näytteenotto peristalttisella pumpulla tasaputkesta tai ympäristöputkesta kolmen volyymin vaihtumisen jälkeen tai kaivosta/kaivosta/joelta suoraan näytteenottoastiaan käsin. Tutkimusten ensisijaisena tarkoituksena on ollut kartoittaa pohjaveden laatua kaupungissa, jotta voidaan seurata kaupungin kemiallisia vaikutuksia maaperään ja veteen sekä sitä, miten vaikutukset muuttuvat ajan mittaan."},{"@language":"fr-t-sv-t0-mtec","@value":"Échantillonnage en 2022. Échantillonnage à l'aide d'une pompe péristaltique à partir d'un tuyau de niveau ou d'un tuyau environnemental après 3 volumes de renouvellement, ou directement du puits/puits/rivière au récipient d'échantillonnage à la main. Le but des études réalisées a été principalement d'étudier la qualité des eaux souterraines dans la ville afin de surveiller l'impact chimique de la ville sur le sol et l'eau et de surveiller l'évolution de l'impact au fil du temps."},{"@language":"ga-t-sv-t0-mtec","@value":"Sampláil in 2022. Sampláil le caidéal peristaltach ó phíopa leibhéal nó píopa comhshaoil tar éis 3 toirt láimhdeachas, nó ó tobar / tobar / abhainn go díreach chuig soitheach samplála de láimh. Is é cuspóir na staidéar a rinneadh go príomha ná suirbhé a dhéanamh ar cháilíocht screamhuisce sa chathair chun monatóireacht a dhéanamh ar thionchar ceimiceach na cathrach ar ithir agus ar uisce agus chun monatóireacht a dhéanamh ar an gcaoi a n-athraíonn an tionchar le himeacht ama."},{"@language":"hr-t-sv-t0-mtec","@value":"Uzorkovanje 2022. Uzorkovanje s peristaltičkom pumpom iz vodoravne cijevi ili cijevi za zaštitu okoliša nakon prometa od 3 volumena ili iz bušotine/jažice/rijeke izravno u posudu za uzorkovanje rukom. Svrha provedenih studija prvenstveno je bila ispitati kvalitetu podzemnih voda u gradu kako bi se pratio kemijski utjecaj grada na tlo i vodu te kako se utjecaj mijenja tijekom vremena."},{"@language":"hu-t-sv-t0-mtec","@value":"Mintavétel 2022-ben. Mintavétel perisztaltikus szivattyúval vízszintes csőből vagy környezeti csőből 3 térfogat-forgalom után, vagy kútból/kútból/folyóból közvetlenül a mintavevő edénybe kézzel. Az elvégzett tanulmányok célja elsősorban az volt, hogy felmérjék a város felszín alatti vizeinek minőségét annak érdekében, hogy nyomon kövessék a város talajra és vízre gyakorolt kémiai hatását, és nyomon kövessék, hogy a hatás hogyan változik az idő múlásával."},{"@language":"it-t-sv-t0-mtec","@value":"Campionamento nel 2022. Campionamento con pompa peristaltica da tubo di livello o tubo ambientale dopo 3 volumi di turnover, o da pozzo/pozzo/fiume direttamente al recipiente di campionamento a mano. Lo scopo degli studi effettuati è stato principalmente quello di rilevare la qualità delle acque sotterranee in città al fine di monitorare l'impatto chimico della città sul suolo e sull'acqua e di monitorare come l'impatto cambia nel tempo."},{"@language":"lt-t-sv-t0-mtec","@value":"Atranka 2022 m. Ėminių ėmimas naudojant peristaltinį siurblį iš lygaus vamzdžio arba aplinkos vamzdžio, kai apyvartoje yra 3 tūriai, arba iš gręžinio / šulinio / upės tiesiai į ėminių ėmimo indą rankiniu būdu. Atliktų tyrimų tikslas visų pirma buvo ištirti požeminio vandens kokybę mieste, kad būtų galima stebėti miesto cheminį poveikį dirvožemiui ir vandeniui ir stebėti, kaip ilgainiui keičiasi poveikis."},{"@language":"lv-t-sv-t0-mtec","@value":"Izlases veidošana 2022. gadā. Paraugu ņemšana ar peristaltisko sūkni no līdzenas caurules vai vides caurules pēc 3 tilpumu apgrozījuma vai no urbuma/iedobes/upes tieši uz paraugu ņemšanas trauku ar rokām. Veikto pētījumu mērķis galvenokārt bija izpētīt gruntsūdeņu kvalitāti pilsētā, lai uzraudzītu pilsētas ķīmisko ietekmi uz augsni un ūdeni un to, kā šī ietekme laika gaitā mainās."},{"@language":"mt-t-sv-t0-mtec","@value":"It-teħid ta’ kampjuni fl-2022. Kampjunar b’pompa peristaltika minn pajp tal-livell jew pajp ambjentali wara fatturat ta’ 3 volumi, jew minn bir/bir/xmara direttament għal reċipjent tal-kampjunar bl-idejn. L-għan tal-istudji mwettqa kien primarjament li tiġi mistħarrġa l-kwalità tal-ilma ta’ taħt l-art fil-belt sabiex jiġi mmonitorjat l-impatt kimiku tal-belt fuq il-ħamrija u l-ilma u biex jiġi mmonitorjat kif l-impatt jinbidel maż-żmien."},{"@language":"nl-t-sv-t0-mtec","@value":"Bemonstering in 2022. Bemonstering met peristaltische pomp van niveaupijp of milieupijp na 3 volumesomzet, of van put/put/rivier rechtstreeks naar bemonsteringsvat met de hand. Het doel van de uitgevoerde studies was voornamelijk om de grondwaterkwaliteit in de stad te onderzoeken om de chemische impact van de stad op bodem en water te monitoren en om te monitoren hoe de impact in de loop van de tijd verandert."},{"@language":"pl-t-sv-t0-mtec","@value":"Dobór próby w 2022 r. Pobieranie próbek za pomocą pompy perystaltycznej z rury poziomej lub rury środowiskowej po 3 obrotach objętościowych lub z odwiertu / studni / rzeki bezpośrednio do naczynia do pobierania próbek ręcznie. Celem przeprowadzonych badań było przede wszystkim zbadanie jakości wód podziemnych w mieście w celu monitorowania chemicznego wpływu miasta na glebę i wodę oraz monitorowania, jak wpływ ten zmienia się w czasie."},{"@language":"pt-t-sv-t0-mtec","@value":"Amostragem em 2022. Amostragem com bomba peristáltica do tubo nivelado ou do tubo ambiental após 3 volumes de volume de negócios, ou do poço/poço/rio diretamente para o recipiente de amostragem à mão. O principal objetivo dos estudos realizados foi o levantamento da qualidade das águas subterrâneas na cidade, a fim de monitorizar o impacto químico da cidade no solo e na água e de monitorizar a forma como o impacto muda ao longo do tempo."},{"@language":"ro-t-sv-t0-mtec","@value":"Eșantionarea în 2022. Eșantionarea cu pompă peristaltică de la țeava de nivel sau de la țeava de mediu după o rotație de 3 volume sau de la sondă/godeu/râu direct la vasul de eșantionare manual. Scopul studiilor efectuate a fost, în primul rând, de a supraveghea calitatea apelor subterane din oraș pentru a monitoriza impactul chimic al orașului asupra solului și a apei și pentru a monitoriza modul în care impactul se modifică în timp."},{"@language":"sk-t-sv-t0-mtec","@value":"Odber vzoriek v roku 2022. Odber vzoriek peristaltickým čerpadlom z vodorovného potrubia alebo environmentálneho potrubia po 3 objemoch obratu alebo z vrtu/jamky/rieky priamo do nádoby na odber vzoriek ručne. Účelom uskutočnených štúdií bolo v prvom rade preskúmať kvalitu podzemnej vody v meste s cieľom monitorovať chemický vplyv mesta na pôdu a vodu a monitorovať, ako sa vplyv mení v priebehu času."},{"@language":"sl-t-sv-t0-mtec","@value":"Vzorčenje leta 2022. Vzorčenje s peristaltično črpalko iz vodoravne ali okoljske cevi po 3 volumskih premikih ali iz vrtine/vodnjaka/reke neposredno v posodo za vzorčenje z roko. Namen opravljenih študij je bil predvsem preučiti kakovost podzemne vode v mestu, da bi spremljali kemični vpliv mesta na tla in vodo ter spremljali, kako se vpliv sčasoma spreminja."},{"@language":"sv","@value":"Provtagning 2022. Provtagning med peristaltisk pump ur nivårör eller miljörör efter 3 volymers omsättning, eller från källa/brunn/vattendrag direkt till provtagningskärl för hand. Syftet med genomförda undersökningar har framför allt varit att översiktligt undersöka grundvattenkvaliteten i staden för att bevaka vilken kemisk påverkan staden har på mark och vatten samt följa hur påverkan förändras över tid."},{"@language":"uk-t-sv-t0-mtec","@value":"Відбір проб у 2022 році. Відбір проб перистальтичним насосом з труби рівня або екологічної труби після 3 обсягів обороту, або від свердловини / свердловини / річки безпосередньо до судна для відбору проб вручну. Метою проведених досліджень було, перш за все, обстеження якості підземних вод у місті з метою моніторингу хімічного впливу міста на ґрунт і воду та моніторингу того, як вплив змінюється з плином часу."}],"dct:format":"text/html","dct:identifier":"4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:50a4b0bd61ebecc438bdbd1d2bad7a0735682136b89e0a2fa7efca6d789ea047_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Качество на подземните води през 2022 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Kvalita podzemních vod 2022"},{"@language":"da-t-sv-t0-mtec","@value":"Grundvandskvalitet 2022"},{"@language":"de-t-sv-t0-mtec","@value":"Grundwasserqualität 2022"},{"@language":"el-t-sv-t0-mtec","@value":"Ποιότητα υπόγειων υδάτων 2022"},{"@language":"en-t-sv-t0-mtec","@value":"Groundwater quality 2022"},{"@language":"es-t-sv-t0-mtec","@value":"Calidad de las aguas subterráneas 2022"},{"@language":"et-t-sv-t0-mtec","@value":"Põhjavee kvaliteet 2022"},{"@language":"fi-t-sv-t0-mtec","@value":"Pohjaveden laatu 2022"},{"@language":"fr-t-sv-t0-mtec","@value":"Qualité des eaux souterraines 2022"},{"@language":"ga-t-sv-t0-mtec","@value":"Cáilíocht an screamhuisce 2022"},{"@language":"hr-t-sv-t0-mtec","@value":"Kvaliteta podzemnih voda 2022."},{"@language":"hu-t-sv-t0-mtec","@value":"A felszín alatti vizek minősége 2022"},{"@language":"it-t-sv-t0-mtec","@value":"Qualità delle acque sotterranee 2022"},{"@language":"lt-t-sv-t0-mtec","@value":"Požeminio vandens kokybė 2022 m."},{"@language":"lv-t-sv-t0-mtec","@value":"Gruntsūdeņu kvalitāte 2022. gadā"},{"@language":"mt-t-sv-t0-mtec","@value":"Kwalità tal-ilma ta’ taħt l-art 2022"},{"@language":"nl-t-sv-t0-mtec","@value":"Grondwaterkwaliteit 2022"},{"@language":"pl-t-sv-t0-mtec","@value":"Jakość wód podziemnych w 2022 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Qualidade das águas subterrâneas 2022"},{"@language":"ro-t-sv-t0-mtec","@value":"Calitatea apelor subterane 2022"},{"@language":"sk-t-sv-t0-mtec","@value":"Kvalita podzemných vôd 2022"},{"@language":"sl-t-sv-t0-mtec","@value":"Kakovost podzemne vode 2022"},{"@language":"sv","@value":"Grundvattenkvalitet 2022"},{"@language":"uk-t-sv-t0-mtec","@value":"Якість підземних вод 2022"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/48a2a634-9160-4a11-b0de-7dcc4811b402","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/4dbd8a1b-0f8b-4691-a55b-04ba8965a8e5#HTTP:ESRI+Portal-URL/3","dct:title":["Kartapplikation",{"@language":"bg-t-sv-t0-mtec","@value":"Приложение за карта"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapová aplikace"},{"@language":"da-t-sv-t0-mtec","@value":"Kortansøgning"},{"@language":"de-t-sv-t0-mtec","@value":"Kartenantrag"},{"@language":"el-t-sv-t0-mtec","@value":"Εφαρμογή χάρτη"},{"@language":"en-t-sv-t0-mtec","@value":"Map application"},{"@language":"es-t-sv-t0-mtec","@value":"Aplicación de mapas"},{"@language":"et-t-sv-t0-mtec","@value":"Kaardirakendus"},{"@language":"fi-t-sv-t0-mtec","@value":"Karttasovellus"},{"@language":"fr-t-sv-t0-mtec","@value":"Application de la carte"},{"@language":"ga-t-sv-t0-mtec","@value":"Feidhmchlár léarscáile"},{"@language":"hr-t-sv-t0-mtec","@value":"Aplikacija zemljovida"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképes alkalmazás"},{"@language":"it-t-sv-t0-mtec","@value":"Applicazione della mappa"},{"@language":"lt-t-sv-t0-mtec","@value":"Žemėlapio taikomoji programa"},{"@language":"lv-t-sv-t0-mtec","@value":"Kartes pieteikums"},{"@language":"mt-t-sv-t0-mtec","@value":"Applikazzjoni tal-mappa"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarttoepassing"},{"@language":"pl-t-sv-t0-mtec","@value":"Aplikacja mapowa"},{"@language":"pt-t-sv-t0-mtec","@value":"Aplicação de mapas"},{"@language":"ro-t-sv-t0-mtec","@value":"Aplicație pentru hărți"},{"@la