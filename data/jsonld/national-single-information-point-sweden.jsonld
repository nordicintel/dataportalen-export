,"@value":"2026-07-03T08:45:47Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"fddcb042-f88f-4501-9671-9714714dbe97","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/fddcb042-f88f-4501-9671-9714714dbe97"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505"},{"@graph":[{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"1981-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"1949-01-01"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"1981-12-31"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"1949-01-01"}},{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"12716a00a7556bbcdea4ee3ea37dd96aa2"},{"@id":"http://data.europa.eu/88u/dataset/584dc6de-3231-4efe-9d6a-aa12f97e03e0","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/1d51f6aa-d442-48b7-8555-6c5feefe2c7e"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=13439fb8-7368-4c97-a599-19af9ece0bd8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"1949-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"въздушни изображения за производство на стереоскопични изображения за фотограметрично измерване; Снимките са правени в различна степен между 1949 и 1981 година. За да получите представа къде и кога сте летели, вижте прегледите на траекторията на полета. Снимките са в хартиени копия и/или негативи в архивите на Градоустройствената служба."},{"@language":"cs-t-sv-t0-mtec","@value":"letecké snímky pro výrobu stereoskopických snímků pro fotogrammetrické měření; Fotografie byly pořízeny v různé míře mezi lety 1949 a 1981. Chcete-li získat představu o tom, kde a kdy jste letěli, podívejte se na přehledy letové dráhy. Fotografie jsou v tištěné podobě a/nebo negativy v archivu Městského úřadu pro územní plánování."},{"@language":"da-t-sv-t0-mtec","@value":"luftbilleder til fremstilling af stereoskopiske billeder til fotogrammetrisk måling Billederne blev taget i varierende grad mellem 1949 og 1981. For at få en idé om, hvor du fløj og hvornår, henvises der til oversigterne over flyruter. Billederne er i papirudgaver og/eller negativer i byplanlægningskontorets arkiver."},{"@language":"de-t-sv-t0-mtec","@value":"Luftbilder zur Herstellung stereoskopischer Bilder zur photogrammetrischen Messung; Die Fotografien wurden zwischen 1949 und 1981 in unterschiedlichem Maße aufgenommen. Um eine Vorstellung davon zu bekommen, wo und wann Sie geflogen sind, lesen Sie die Flugbahnübersichten. Die Bilder befinden sich in Papierform und/oder Negativen im Archiv des Stadtplanungsamtes."},{"@language":"el-t-sv-t0-mtec","@value":"εναέριες εικόνες για την παραγωγή στερεοσκοπικών εικόνων για φωτογραμμετρικές μετρήσεις· Οι φωτογραφίες τραβήχτηκαν σε διάφορους βαθμούς μεταξύ 1949 και 1981. Για να πάρετε μια ιδέα για το πού πετάξατε και πότε, ανατρέξτε στις επισκοπήσεις της διαδρομής πτήσης. Οι εικόνες είναι σε έντυπη ή/και αρνητική μορφή στα αρχεία του Γραφείου Πολεοδομίας."},{"@language":"en-t-sv-t0-mtec","@value":"aerial images for the production of stereoscopic images for photogrammetric measurement; The photographs were taken to varying degrees between 1949 and 1981. To get an idea where you flew and when, refer to the flight path overviews. The pictures are in hard copies and/or negatives in the archives of the City Planning Office."},{"@language":"es-t-sv-t0-mtec","@value":"imágenes aéreas para la producción de imágenes estereoscópicas para la medición fotogramétrica; Las fotografías fueron tomadas en diversos grados entre 1949 y 1981. Para tener una idea de dónde voló y cuándo, consulte las vistas generales de la ruta de vuelo. Las imágenes están en copias impresas y / o negativos en los archivos de la Oficina de Planificación de la Ciudad."},{"@language":"et-t-sv-t0-mtec","@value":"aerofotod stereoskoopiliste kujutiste tootmiseks fotogramm-meetriliste mõõtmiste jaoks; Fotod on tehtud erineval määral aastatel 1949-1981. Et saada aimu, kuhu ja millal lendasite, vaadake lennutrajektoori ülevaateid. Pildid on linnaplaneerimisameti arhiivis paberkandjal ja/või negatiivis."},{"@language":"fi-t-sv-t0-mtec","@value":"ilmakuvat stereoskooppisten kuvien tuottamiseksi fotogrammetristä mittausta varten; Valokuvat on otettu vaihtelevassa määrin vuosina 1949-1981. Saadaksesi käsityksen siitä, missä lensit ja milloin, katso lentoradan yleiskatsaukset. Kuvat ovat paperikopioina ja/tai negatiivina kaupunkisuunnittelutoimiston arkistossa."},{"@language":"fr-t-sv-t0-mtec","@value":"images aériennes pour la production d'images stéréoscopiques pour la mesure photogrammétrique; Les photographies ont été prises à des degrés divers entre 1949 et 1981. Pour avoir une idée de l'endroit où vous avez volé et du moment où vous l'avez fait, reportez-vous aux aperçus des trajectoires de vol. Les images sont en copie papier et/ou en négatif dans les archives du bureau d'urbanisme."},{"@language":"ga-t-sv-t0-mtec","@value":"aeríomhánna chun íomhánna steiréascópacha a tháirgeadh chun fótagramiméadracht a thomhas; Tógadh na grianghraif go céimeanna éagsúla idir 1949 agus 1981. Chun smaoineamh a fháil ar an áit ar eitil tú agus cathain, déan tagairt do na forbhreathnuithe ar an gconair eitilte. Tá na pictiúir i gcóipeanna crua agus/nó i gclaonchlónna i gcartlann na hOifige Pleanála Cathrach."},{"@language":"hr-t-sv-t0-mtec","@value":"zračne snimke za izradu stereoskopskih slika za fotogrametrijsko mjerenje; Fotografije su snimljene u različitim stupnjevima između 1949. i 1981. godine. Da biste dobili ideju gdje ste letjeli i kada, pogledajte pregled putanje leta. Slike su u tiskanim primjercima i/ili negativima u arhivu Gradskog ureda za planiranje."},{"@language":"hu-t-sv-t0-mtec","@value":"légi felvételek sztereoszkopikus képek készítésére fotogrammetriai méréshez; A fényképek különböző mértékben készültek 1949 és 1981 között. Ha szeretné megtudni, hogy hol és mikor repült, olvassa el a repülési útvonal áttekintését. A képek nyomtatott és/vagy negatív formában a Várostervezési Hivatal archívumában találhatók."},{"@language":"it-t-sv-t0-mtec","@value":"immagini aeree per la produzione di immagini stereoscopiche per la misurazione fotogrammetrica; Le fotografie sono state scattate a vari livelli tra il 1949 e il 1981. Per avere un'idea di dove hai volato e quando, fai riferimento alle panoramiche della traiettoria di volo. Le immagini sono in copie cartacee e/o negative negli archivi dell'Ufficio Pianificazione Comunale."},{"@language":"lt-t-sv-t0-mtec","@value":"aerofotografiniai vaizdai stereoskopiniams vaizdams, skirtiems fotogrametriniams matavimams, gauti; Nuo 1949 m. iki 1981 m. nuotraukos buvo daromos įvairiais laipsniais. Norėdami sužinoti, kur ir kada skridote, peržiūrėkite skrydžio trajektorijos apžvalgas. Paveikslėliai spausdinti ir (arba) negatyvai saugomi Miesto planavimo biuro archyvuose."},{"@language":"lv-t-sv-t0-mtec","@value":"aeroattēli stereoskopisku attēlu radīšanai fotogrammetriskiem mērījumiem; Fotogrāfijas dažādās pakāpēs tika uzņemtas laikā no 1949. līdz 1981. gadam. Lai iegūtu priekšstatu par to, kur un kad lidojāt, skatiet lidojuma trajektorijas pārskatus. Attēli ir cietos eksemplāros un/vai negatīvi pilsētas plānošanas biroja arhīvos."},{"@language":"mt-t-sv-t0-mtec","@value":"immaġnijiet mill-ajru għall-produzzjoni ta’ immaġnijiet sterjoskopiċi għall-kejl fotogrammetriku; Ir-ritratti ttieħdu fi gradi differenti bejn l-1949 u l-1981. Biex tikseb idea fejn ttir u meta, irreferi għall-ħarsiet ġenerali tar-rotta tat-titjira. L-istampi huma f'kopji stampati u / jew negattivi fl-arkivji tal-Uffiċċju tal-Ippjanar tal-Belt."},{"@language":"nl-t-sv-t0-mtec","@value":"luchtbeelden voor de productie van stereoscopische beelden voor fotogrammetrische meting; De foto's zijn in verschillende mate genomen tussen 1949 en 1981. Om een idee te krijgen waar je bent gevlogen en wanneer, raadpleeg je de vluchtpadoverzichten. De foto's staan op papier en/of negatief in de archieven van het Stadsplanningsbureau."},{"@language":"pl-t-sv-t0-mtec","@value":"obrazy lotnicze do produkcji obrazów stereoskopowych do pomiarów fotogrametrycznych; Zdjęcia zostały wykonane w różnym stopniu w latach 1949-1981. Aby dowiedzieć się, gdzie i kiedy leciałeś, zapoznaj się z przeglądami torów lotu. Zdjęcia znajdują się w kopiach papierowych i/lub negatywach w archiwach Urzędu Planowania Miejskiego."},{"@language":"pt-t-sv-t0-mtec","@value":"Imagens aéreas para a produção de imagens estereoscópicas para medição fotogramétrica; As fotografias foram tiradas em diferentes graus entre 1949 e 1981. Para ter uma ideia de onde voou e quando, consulte as panorâmicas da trajetória de voo. As imagens estão em cópias impressas e/ou negativas nos arquivos do Gabinete de Planeamento da Cidade."},{"@language":"ro-t-sv-t0-mtec","@value":"imagini aeriene pentru producerea de imagini stereoscopice pentru măsurători fotogrammetrice; Fotografiile au fost realizate în grade diferite între 1949 și 1981. Pentru a vă face o idee unde ați zburat și când, consultați prezentările generale ale traiectoriilor de zbor. Imaginile sunt în exemplare tipărite și/sau negative în arhivele Biroului de urbanism."},{"@language":"sk-t-sv-t0-mtec","@value":"letecké snímky na výrobu stereoskopických snímok na fotogrammetrické meranie; Fotografie boli zhotovené v rôznych stupňoch medzi rokmi 1949 a 1981. Ak chcete získať predstavu o tom, kam a kedy ste leteli, pozrite si prehľady dráhy letu. Fotografie sú vyhotovené v tlačenej podobe a/alebo v negatívoch v archívoch Mestského úradu."},{"@language":"sl-t-sv-t0-mtec","@value":"slike iz zraka za izdelavo stereoskopskih slik za fotogrametrično merjenje; Fotografije so bile posnete v različnem obsegu med letoma 1949 in 1981. Če želite dobiti idejo, kje ste leteli in kdaj, si oglejte preglede poti leta. Slike so v tiskanih izvodih in/ali negativih v arhivu urada za prostorsko načrtovanje."},{"@language":"sv","@value":"Flygbilder för framställning av stereobilder för fotogrametriskt mätning. Bilderna togs i varierande omfattning mellan åren 1949 och 1981. För att få en uppfattning var man flög och när hänvisas till flygstråksöversikterna. Bilderna ligger som papperskopior och/eller negativ i stadsbyggnadskontorets arkiv."},{"@language":"uk-t-sv-t0-mtec","@value":"аерофотознімки для виготовлення стереоскопічних знімків для фотограмметричних вимірювань; Фотографії були зроблені в різній мірі між 1949 і 1981 роками. Щоб отримати уявлення про те, куди і коли ви летіли, зверніться до оглядів траєкторії польоту. Фотографії зберігаються на паперових носіях та/або в негативі в архівах Містобудівного управління."}],"dct:format":"text/html","dct:identifier":"584dc6de-3231-4efe-9d6a-aa12f97e03e0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b0n0"},"dct:temporal":{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Исторически въздушни снимки (1949 - 1981)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Historické letecké fotografie (1949 - 1981)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Historiske luftfotos (1949 - 1981)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Historische Luftaufnahmen (1949 - 1981)"},{"@language":"el-t-sv-t0-mtec","@value":"Ιστορικές αεροφωτογραφίες (1949 - 1981)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Historical aerial photographs (1949 - 1981)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Fotografías aéreas históricas (1949 - 1981)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ajaloolised aerofotod (1949-1981)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Historialliset ilmakuvat (1949 - 1981)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Photographies aériennes historiques (1949 - 1981)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Aerghrianghraif Stairiúla (1949 - 1981)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Povijesne zračne fotografije (1949. - 1981.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Történelmi légi felvételek (1949-1981)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Fotografie aeree storiche (1949 - 1981)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Istorinės aeronuotraukos (1949 - 1981)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Vēsturiskās aerofotogrāfijas (1949 - 1981)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ritratti storiċi mill-ajru (1949 - 1981)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Historische luchtfoto's (1949 - 1981)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Historyczne zdjęcia lotnicze (1949 - 1981)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Fotografias aéreas históricas (1949 - 1981)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Fotografii aeriene istorice (1949 - 1981)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Historické letecké fotografie (1949 - 1981)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Zgodovinske aerofotografije (1949-1981)"},{"@language":"sv","@value":"SBK Historiska flygbilder (1949 - 1981)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Історичні аерофотознімки (1949 - 1981)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/1d51f6aa-d442-48b7-8555-6c5feefe2c7e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/584dc6de-3231-4efe-9d6a-aa12f97e03e0#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/1d51f6aa-d442-48b7-8555-6c5feefe2c7e"}},{"@id":"http://data.europa.eu/88u/record/584dc6de-3231-4efe-9d6a-aa12f97e03e0","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/1d51f6aa-d442-48b7-8555-6c5feefe2c7e"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"584dc6de-3231-4efe-9d6a-aa12f97e03e0","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:03Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:09Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/584dc6de-3231-4efe-9d6a-aa12f97e03e0"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/584dc6de-3231-4efe-9d6a-aa12f97e03e0"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:09Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"584dc6de-3231-4efe-9d6a-aa12f97e03e0","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/584dc6de-3231-4efe-9d6a-aa12f97e03e0"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e"},{"@graph":[{"@id":"_:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4437,18.2011 59.4437,18.2011 59.2272,17.7605 59.2272,17.7605 59.4437))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4437,18.2011 59.4437,18.2011 59.2272,17.7605 59.2272,17.7605 59.4437))"}},{"@id":"_:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"141416c2e403be5c5124e7d74f9eacbd9b"},{"@id":"http://data.europa.eu/88u/dataset/b899f057-8d17-4018-96eb-3de4e5de93f2","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74"},{"@id":"http://data.europa.eu/88u/distribution/d6429cc3-8f08-4214-9c48-62cec731420c"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=001fda16-2064-4184-ad20-16b3973ac870"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"Att övervaka biologisk mångfald är avgörande för att skydda livsviktiga ekosystemtjänster, förstå miljöförändringar och fatta hållbara beslut. Utan övervakning riskerar vi att förlora arter och funktioner som är grundläggande för människor, djur och växters överlevnad."},"dct:format":"text/html","dct:identifier":"b899f057-8d17-4018-96eb-3de4e5de93f2","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Natur - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2#HTTP:ESRI+Portal-URL/2","dct:title":"Miljöförvaltningens öppna data-hub","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74"}},{"@id":"http://data.europa.eu/88u/distribution/d6429cc3-8f08-4214-9c48-62cec731420c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/natur/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2#HTTP:Information/1","dct:title":"MiljödataStockholm","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/d6429cc3-8f08-4214-9c48-62cec731420c"}},{"@id":"http://data.europa.eu/88u/record/b899f057-8d17-4018-96eb-3de4e5de93f2","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74"},{"@id":"http://data.europa.eu/88u/distribution/d6429cc3-8f08-4214-9c48-62cec731420c"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"b899f057-8d17-4018-96eb-3de4e5de93f2","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:25Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:02Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/b899f057-8d17-4018-96eb-3de4e5de93f2"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/b899f057-8d17-4018-96eb-3de4e5de93f2"},"https://piveau.eu/ns/voc#originalId":"b899f057-8d17-4018-96eb-3de4e5de93f2","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3"},{"@graph":[{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"13a9bc55b135ea0716d6e1d5a789de58d9"},{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b2n0","dct:identifier":"https://resources.stockholm.se/data/ab659a75-5515-4b75-b7b3-ccb15487af08#HTTP:Information/1","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/610dfca8-14a1-4838-b14f-d834ff3ed6fa"}},{"@id":"http://data.europa.eu/88u/dataset/ab659a75-5515-4b75-b7b3-ccb15487af08","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/610dfca8-14a1-4838-b14f-d834ff3ed6fa"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=a21b1113-0c72-4a29-97c9-9c7af9950298"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Общинският кодекс съдържа някои решения, взети от Градския съвет на Стокхолм. Това може да включва например наредби за управителни съвети, устав за общински дружества и тарифи за общински услуги."},{"@language":"cs-t-sv-t0-mtec","@value":"Městský zákoník obsahuje některá rozhodnutí přijatá městskou radou Stockholmu. To může zahrnovat například předpisy pro správní rady, stanovy pro obecní společnosti a sazby za obecní služby."},{"@language":"da-t-sv-t0-mtec","@value":"Kommuneloven indeholder visse afgørelser truffet af Stockholms byråd. Dette kan f.eks. omfatte regler for bestyrelser, vedtægter for kommunale virksomheder og takster for kommunale tjenester."},{"@language":"de-t-sv-t0-mtec","@value":"Das Gemeindegesetzbuch enthält bestimmte Beschlüsse des Stockholmer Stadtrates. Dies kann beispielsweise Regelungen für Vorstände, Satzungen für kommunale Unternehmen und Tarife für kommunale Dienstleistungen umfassen."},{"@language":"el-t-sv-t0-mtec","@value":"Ο δημοτικός κώδικας περιέχει ορισμένες αποφάσεις που λαμβάνονται από το δημοτικό συμβούλιο της Στοκχόλμης. Αυτό μπορεί να περιλαμβάνει, για παράδειγμα, κανονισμούς για διοικητικά συμβούλια, καταστατικό για δημοτικές εταιρείες και τιμολόγια για δημοτικές υπηρεσίες."},{"@language":"en-t-sv-t0-mtec","@value":"The Municipal Code contains certain decisions taken by the Stockholm City Council. This may include, for example, regulations for boards, articles of association for municipal companies and tariffs for municipal services."},{"@language":"es-t-sv-t0-mtec","@value":"El Código Municipal contiene algunas decisiones adoptadas por el Ayuntamiento de Estocolmo. Esto puede incluir, por ejemplo, reglamentos para los consejos de administración, estatutos para las empresas municipales y tarifas para los servicios municipales."},{"@language":"et-t-sv-t0-mtec","@value":"Munitsipaalseadustik sisaldab teatavaid Stockholmi linnavolikogu otsuseid. See võib hõlmata näiteks juhatuse eeskirju, munitsipaalettevõtete põhikirja ja munitsipaalteenuste tariife."},{"@language":"fi-t-sv-t0-mtec","@value":"Kunnallislaki sisältää tiettyjä Tukholman kaupunginvaltuuston tekemiä päätöksiä. Tällaisia voivat olla esimerkiksi hallituksia koskevat määräykset, kunnallisten yritysten yhtiöjärjestys ja kunnallisten palvelujen tariffit."},{"@language":"fr-t-sv-t0-mtec","@value":"Le code municipal contient certaines décisions prises par le conseil municipal de Stockholm. Il peut s'agir, par exemple, de règlements pour les conseils d'administration, de statuts pour les entreprises municipales et de tarifs pour les services municipaux."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá cinntí áirithe a ghlac Comhairle Cathrach Stócólm sa Chód Bardasach. D’fhéadfaí a áireamh leis sin, mar shampla, rialacháin le haghaidh bord, airteagail chomhlachais le haghaidh cuideachtaí bardasacha agus taraifí le haghaidh seirbhísí bardasacha."},{"@language":"hr-t-sv-t0-mtec","@value":"Općinski zakonik sadržava određene odluke koje je donijelo Gradsko vijeće Stockholma. To može uključivati, na primjer, propise o upravnim odborima, statut općinskih poduzeća i tarife za komunalne usluge."},{"@language":"hu-t-sv-t0-mtec","@value":"A városi törvénykönyv a stockholmi városi tanács által hozott bizonyos határozatokat tartalmaz. Ez magában foglalhatja például az igazgatótanácsokra vonatkozó szabályokat, az önkormányzati vállalatok alapszabályát és az önkormányzati szolgáltatások díjait."},{"@language":"it-t-sv-t0-mtec","@value":"Il codice comunale contiene alcune decisioni adottate dal consiglio comunale di Stoccolma. Ciò può includere, ad esempio, regolamenti per i consigli di amministrazione, statuti per le società comunali e tariffe per i servizi comunali."},{"@language":"lt-t-sv-t0-mtec","@value":"Savivaldybės kodekse yra tam tikrų Stokholmo miesto tarybos priimtų sprendimų. Tai gali būti, pavyzdžiui, valdybų nuostatai, savivaldybių įmonių įstatai ir savivaldybių paslaugų tarifai."},{"@language":"lv-t-sv-t0-mtec","@value":"Pašvaldības kodeksā ir ietverti daži Stokholmas pilsētas domes pieņemtie lēmumi. Tas var ietvert, piemēram, noteikumus par padomēm, pašvaldību uzņēmumu statūtus un pašvaldību pakalpojumu tarifus."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-Kodiċi Muniċipali fih ċerti deċiżjonijiet meħuda mill-Kunsill tal-Belt ta’ Stokkolma. Dan jista’ jinkludi, pereżempju, regolamenti għall-bordijiet, artikoli ta’ assoċjazzjoni għall-kumpaniji muniċipali u tariffi għas-servizzi muniċipali."},{"@language":"nl-t-sv-t0-mtec","@value":"Het gemeentelijk wetboek bevat bepaalde besluiten van de gemeenteraad van Stockholm. Het kan bijvoorbeeld gaan om reglementen voor besturen, statuten voor gemeentelijke bedrijven en tarieven voor gemeentelijke diensten."},{"@language":"pl-t-sv-t0-mtec","@value":"Kodeks miejski zawiera pewne decyzje podjęte przez Radę Miasta Sztokholm. Może to obejmować na przykład regulaminy zarządów, statuty spółek komunalnych i taryfy za usługi komunalne."},{"@language":"pt-t-sv-t0-mtec","@value":"O Código Municipal contém determinadas decisões tomadas pelo Conselho Municipal de Estocolmo. Tal pode incluir, por exemplo, a regulamentação dos conselhos de administração, os estatutos das empresas municipais e as tarifas dos serviços municipais."},{"@language":"ro-t-sv-t0-mtec","@value":"Codul municipal conține anumite decizii luate de Consiliul municipal al orașului Stockholm. Acestea pot include, de exemplu, reglementări pentru consiliile de administrație, statute pentru societățile municipale și tarife pentru serviciile municipale."},{"@language":"sk-t-sv-t0-mtec","@value":"Mestský zákonník obsahuje určité rozhodnutia, ktoré prijala mestská rada v Štokholme. Môže ísť napríklad o predpisy týkajúce sa správnych rád, stanovy obecných spoločností a tarify za komunálne služby."},{"@language":"sl-t-sv-t0-mtec","@value":"Občinski zakonik vsebuje nekatere odločitve, ki jih je sprejel mestni svet Stockholma. To lahko na primer vključuje predpise za upravne odbore, statute občinskih podjetij in tarife za občinske storitve."},{"@language":"sv","@value":"I den kommunala författningssamlingen finns vissa beslut som fattats av Stockholms kommunfullmäktige. Det kan handla om till exempel om reglemente för nämnder, bolagsordningar för kommunala bolag och taxor för kommunala tjänster."},{"@language":"uk-t-sv-t0-mtec","@value":"Муніципальний кодекс містить певні рішення, прийняті Стокгольмською міською радою. Це може включати, наприклад, положення про правління, статут муніципальних компаній та тарифи на комунальні послуги."}],"dct:format":"text/html","dct:identifier":"ab659a75-5515-4b75-b7b3-ccb15487af08","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Кодекс на устава на град Стокхолм"},{"@language":"cs-t-sv-t0-mtec","@value":"Statutární řád města Stockholm"},{"@language":"da-t-sv-t0-mtec","@value":"Stockholms vedtægtskodeks"},{"@language":"de-t-sv-t0-mtec","@value":"Der Statutenkodex der Stadt Stockholm"},{"@language":"el-t-sv-t0-mtec","@value":"Ο Κώδικας Καταστατικού της Πόλης της Στοκχόλμης"},{"@language":"en-t-sv-t0-mtec","@value":"The City of Stockholm Code of Statutes"},{"@language":"es-t-sv-t0-mtec","@value":"Código de Estatutos de la Ciudad de Estocolmo"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi linna põhikiri"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman kaupungin yhtiöjärjestys"},{"@language":"fr-t-sv-t0-mtec","@value":"Le code des statuts de la ville de Stockholm"},{"@language":"ga-t-sv-t0-mtec","@value":"Cód Reachtanna Chathair Stócólm"},{"@language":"hr-t-sv-t0-mtec","@value":"Zakonik o Statutu grada Stockholma"},{"@language":"hu-t-sv-t0-mtec","@value":"Stockholm város statútuma"},{"@language":"it-t-sv-t0-mtec","@value":"Il Codice di Statuti della Città di Stoccolma"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo miesto įstatų kodeksas"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas pilsētas statūtu kodekss"},{"@language":"mt-t-sv-t0-mtec","@value":"Il-Kodiċi tal-Istatuti tal-Belt ta’ Stokkolma"},{"@language":"nl-t-sv-t0-mtec","@value":"Statuten van de stad Stockholm"},{"@language":"pl-t-sv-t0-mtec","@value":"Sztokholmski Kodeks Statutowy"},{"@language":"pt-t-sv-t0-mtec","@value":"Código dos Estatutos da Cidade de Estocolmo"},{"@language":"ro-t-sv-t0-mtec","@value":"Codul de Statut al orașului Stockholm"},{"@language":"sk-t-sv-t0-mtec","@value":"Štatutárny poriadok mesta Štokholm"},{"@language":"sl-t-sv-t0-mtec","@value":"Stockholmski statut mesta"},{"@language":"sv","@value":"Stockholms stads författningssamling"},{"@language":"uk-t-sv-t0-mtec","@value":"Стокгольмський кодекс статутів"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/610dfca8-14a1-4838-b14f-d834ff3ed6fa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.stockholm.se/OmStockholm/Politik-och-demokrati/Stadsovergripande-styrdokument/Kommunal-forfattningssamling/"},"dct:format":"text/html","dct:title":["Webbplats med mer information",{"@language":"bg-t-sv-t0-mtec","@value":"Уебсайт с повече информация"},{"@language":"cs-t-sv-t0-mtec","@value":"Webové stránky s více informacemi"},{"@language":"da-t-sv-t0-mtec","@value":"Hjemmeside med mere information"},{"@language":"de-t-sv-t0-mtec","@value":"Website mit weiteren Informationen"},{"@language":"el-t-sv-t0-mtec","@value":"Ιστοσελίδα με περισσότερες πληροφορίες"},{"@language":"en-t-sv-t0-mtec","@value":"Website with more information"},{"@language":"es-t-sv-t0-mtec","@value":"Sitio web con más información"},{"@language":"et-t-sv-t0-mtec","@value":"Rohkem teavet sisaldav veebisait"},{"@language":"fi-t-sv-t0-mtec","@value":"Verkkosivusto, jossa on lisätietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Site web avec plus d'informations"},{"@language":"ga-t-sv-t0-mtec","@value":"Suíomh gréasáin le tuilleadh eolais"},{"@language":"hr-t-sv-t0-mtec","@value":"Web stranica s više informacija"},{"@language":"hu-t-sv-t0-mtec","@value":"Weboldal további információkkal"},{"@language":"it-t-sv-t0-mtec","@value":"Sito web con maggiori informazioni"},{"@language":"lt-t-sv-t0-mtec","@value":"Interneto svetainė, kurioje pateikiama daugiau informacijos"},{"@language":"lv-t-sv-t0-mtec","@value":"Tīmekļa vietne ar plašāku informāciju"},{"@language":"mt-t-sv-t0-mtec","@value":"Sit web b’aktar informazzjoni"},{"@language":"nl-t-sv-t0-mtec","@value":"Website met meer informatie"},{"@language":"pl-t-sv-t0-mtec","@value":"Strona internetowa zawierająca więcej informacji"},{"@language":"pt-t-sv-t0-mtec","@value":"Sítio Web com mais informações"},{"@language":"ro-t-sv-t0-mtec","@value":"Site cu mai multe informații"},{"@language":"sk-t-sv-t0-mtec","@value":"Webová stránka s ďalšími informáciami"},{"@language":"sl-t-sv-t0-mtec","@value":"Spletna stran z več informacijami"},{"@language":"uk-t-sv-t0-mtec","@value":"Веб-сайт з додатковою інформацією"}]},{"@id":"http://data.europa.eu/88u/record/ab659a75-5515-4b75-b7b3-ccb15487af08","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b2n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"ab659a75-5515-4b75-b7b3-ccb15487af08","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:13Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-05T07:15:34Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/ab659a75-5515-4b75-b7b3-ccb15487af08"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/ab659a75-5515-4b75-b7b3-ccb15487af08"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-09-02T11:15:02Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-09-05T07:15:34Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Stadsledningskontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:anders.broberg@stockholm.se"},{"@id":"mailto:kommunstyrelsen@stockholm.se"}]}],"@id":"urn:source:85d80880c36a85166831f0a5aa53f79c238b8a86c8563c476b66be7560d0a63c"},{"@graph":[{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information/2"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information:Produktspecfikation/1"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Nedladdning:data/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"SBK Planeringsunderlag"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3c463b5f-2b62-4b62-b131-a3eefcad2515"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":{"@language":"sv","@value":"De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 9 april7 maj 2024. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna ajourförs inte sedan de skapas. Datat är interpolerat till ett grid med upplösning 1 m. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. De kända höjderna är mätta runtom byggnaden.Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},"dct:identifier":"ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b0n0"},"dct:temporal":{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Höjdgrid (2024)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information:Produktspecfikation/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_H%C3%B6jdgrid.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Produktspecifikation"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Nedladdning:data/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/H%C3%B6jdgrid.dwg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Testdata DWG-format"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c"},{"@graph":[{"@id":"_:8623cfbdac3ac5589e81dd22e964b6abefa7eb40ac141e09201e73b638f92ff4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:8623cfbdac3ac5589e81dd22e964b6abefa7eb40ac141e09201e73b638f92ff4_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1101edaa4afbb7058f2971157264053142"},{"@id":"http://data.europa.eu/88u/dataset/0d843f7b-c6ca-46c3-9bf5-31bb17a8be57","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/d901df4a-dfc7-499e-a1cb-4d9ba1fb8f8a"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=232a7e04-2865-4838-a522-0b2a903a4c29"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта - Единичната площ се състои от следните подтипове (подтипове) при информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Регистрационна карта) :450040, Единична площ Подтипове10, Площ на имота, модифицирана20, Пространство на имота, модифицирана30, Притурка В, модифицирана40, Общност, модифицирана50, Пространство на имота, модифицирана"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registru - Jednotková oblast sestávala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa registru) :450040, Jednotková oblast Podtypy10, Oblast vlastnictví, modifikovatelná20, Oblast vlastnictví, modifikovatelná30, Příloha C, modifikovatelná40, Komunita, modifikovatelná50, Oblast vlastnictví, modifikovatelná"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort — Enhedsområde bestod af følgende undertyper (undertyper) i klassificeringen af oplysninger 2020 (for den nuværende liste henvises til den generelle varespecifikation Registerkort) :450040, Enhedsområde Undertyper10, Ejendomsområde, modificerbar20, Ejendomsområde, modificerbar30, Tillæg C, modificerbar40, Fællesskab, modificerbar50, Ejendomsområde, modificerbar"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte - Gebiet der Einheit bestand aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Registerkarte) :450040, Gebiet der Einheit Untertypen10, Gebiet der Immobilie, veränderbar20, Grundstücksfläche, veränderbar30, Anlage C, veränderbar40, Gemeinschaft, veränderbar50, Grundstücksfläche, veränderbar"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Περιοχή μονάδας αποτελούμενη από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης μητρώου) :450040, Περιοχή μονάδας Υποτύποι10, Περιοχή ακινήτου, τροποποιήσιμη20, Χώρος ακινήτου, τροποποιήσιμη30, Συνημμένο Γ, τροποποιήσιμη40, Κοινότητα, τροποποιήσιμη50, Χώρος ακινήτου, τροποποιήσιμη"},{"@language":"en-t-sv-t0-mtec","@value":"Register map - Unit area consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification Register map) :450040, Unit area Subtypes10, Property area, modifiable20, Property space, modifiable30, Attachment C, modifiable40, Community, modifiable50, Property space, modifiable"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa del registro - El área de la unidad constaba de los siguientes subtipos (subtipos) en la clasificación de la información 2020 (para la lista actual, véase la especificación general del producto Mapa del registro): 450040, Área de la unidad Subtipos10, Área de la propiedad, modificable20, Espacio de la propiedad, modificable30, Adjunto C, modificable40, Comunidad, modificable50, Espacio de la propiedad, modificable"},{"@language":"et-t-sv-t0-mtec","@value":"Registrikaart – 2020. aasta teabeklassifikatsiooni üksuse pindala koosnes järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldise tootespetsifikaadi registrikaart):450040, üksuse pindala alatüübid10, kinnisvarapind, muudetav20, kinnisvarapind, muudetav30, liide C, muudetav40, kogukond, muudetav50, kinnisvarapind, muudetav"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta - Yksikköalue koostui seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleiset tuote-eritelmät Rekisterikartta) :450040, Yksikköalue Alatyypit10, Kiinteistöalue, modifiable20, Kiinteistötila, modifiable30, Liite C, modifiable40, Yhteisö, modifiable50, Kiinteistötila, modifiable"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte du registre - La surface unitaire se composait des sous-types suivants (sous-types) à la classification d’information 2020 (pour la liste actuelle, voir le cahier des charges général du produit Carte du registre) :450040, Surface unitaire Sous-types10, Surface de propriété, modifiable20, Espace de propriété, modifiable30, Pièce jointe C, modifiable40, Communauté, modifiable50, Espace de propriété, modifiable"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil an chláir - Is éard a bhí sa limistéar aonaid na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach an tsonraíocht táirge Ghinearálta Léarscáil an Chláir) :450040, Limistéar aonaid Fochineálacha10, Limistéar maoine, inmhodhnaithe20, Spás maoine, inmhodhnaithe30, Ceangaltán C, inmhodhnaithe40, Pobal, inmhodhnaithe50, Spás maoine, inmhodhnaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta registra – Područje jedinice sastojalo se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Karta registra) :450040, Podvrste područja jedinice10, Područje nekretnina, promjenjivo20, Prostor nekretnina, promjenjivo30, Dodatak C, promjenjivo40, Zajednica, promjenjivo50, Prostor nekretnina, promjenjivo"},{"@language":"hu-t-sv-t0-mtec","@value":"Nyilvántartási térkép – Az egység területe a következő altípusokból (altípusokból) állt a 2020. évi információs osztályozási rendszerben (az aktuális listát lásd az általános termékleírásban) :450040, az egység területe 10. altípus, az ingatlan területe, módosítható20, az ingatlan területe, módosítható30, a C. függelék, módosítható40, közösségi, módosítható50, az ingatlan területe, módosítható"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa del registro - L'area dell'unità era costituita dai seguenti sottotipi (sottotipi) alla classificazione delle informazioni 2020 (per l'elenco attuale vedere il disciplinare generale Mappa del registro) :450040, Sottotipi dell'area dell'unità10, Area dell'immobile, modificabile20, Spazio dell'immobile, modificabile30, Allegato C, modificabile40, Comunità, modificabile50, Spazio dell'immobile, modificabile"},{"@language":"lt-t-sv-t0-mtec","@value":"Registro žemėlapis - Vieneto plotą sudarė šie potipiai (potipiai) 2020 m. informacijos klasifikacijoje (dabartinį sąrašą žr. Bendrosios produkto specifikacijos Registro žemėlapis):450040, Vieneto ploto potipiai10, Nekilnojamojo turto plotas, modifikuojamas20, Nekilnojamojo turto plotas, modifikuojamas30, Priedas C, modifikuojamas40, Bendruomenė, modifikuojamas50, Nekilnojamojo turto plotas, modifikuojamas"},{"@language":"lv-t-sv-t0-mtec","@value":"Reģistra karte – vienības platība sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu sk. Vispārīgajā produkta specifikācijā Reģistra karte) :450040, vienības platība apakštipi10, Īpašuma platība, modificējama20, Īpašuma platība, modificējama30, C papildinājums, modificējama40, Kopiena, modificējama50, Īpašuma platība, modificējama"},{"@language":"mt-t-sv-t0-mtec","@value":"- Unit area tal-mappa tar-reġistru kienet tikkonsisti fis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-mappa tar-Reġistru tal-Ispeċifikazzjoni Ġenerali tal-Prodott) :450040, Unit area Subtypes10, Property area, modificationifiable20, Property space, modificationifiable30, Hemża C, modificationifiable40, Community, modificationifiable50, Property space, modificationifiable30 (Żona tal-unità tas-sottotipi10, Żona tal-proprjetà, modifikabbli20, Spazju tal-proprjetà, modifikabbli30, Hemża C, modifikabbli40, Komunitarja, modifikabbli50, Spazju tal-proprjetà, modifikabbli)"},{"@language":"nl-t-sv-t0-mtec","@value":"Registerkaart - Eenheidsgebied bestond uit de volgende subtypen (subtypen) in de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Registerkaart) :450040, Eenheidsgebied Subtypen10, Eigendomsgebied, aanpasbaar20, Eigendomsruimte, aanpasbaar30, Aanhangsel C, aanpasbaar40, Gemeenschap, aanpasbaar50, Eigendomsruimte, aanpasbaar"},{"@language":"pl-t-sv-t0-mtec","@value":"Zarejestruj mapę - Obszar jednostki składał się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualny wykaz patrz Ogólna specyfikacja produktu Zarejestruj mapę) :450040, Obszar jednostki podtypy10, Obszar nieruchomości, modyfikowalny20, Przestrzeń nieruchomości, modyfikowalny30, Załącznik C, modyfikowalny40, Wspólnota, modyfikowalny50, Przestrzeń nieruchomości, modyfikowalny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa do registo - Área unitária constituída pelos seguintes subtipos (subtipos) na classificação da informação 2020 (para a lista atual ver especificação geral do produto Mapa do registo):450040, Área unitária Subtipos10, Área da propriedade, modificável20, Espaço da propriedade, modificável30, Apêndice C, modificável40, Comunidade, modificável50, Espaço da propriedade, modificável"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta registrului - Suprafața unității a constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor din 2020 (pentru lista actuală, a se vedea caietul de sarcini general al produsului Harta registrului): 450040, Suprafața unității subtipuri10, Suprafața proprietății, modificabilă20, Suprafața proprietății, modificabilă30, Anexa C, modificabilă40, Comunitate, modificabilă50, Suprafața proprietății, modificabilă"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa registra - Plocha jednotky pozostávala z nasledujúcich podtypov (podtypov) pri klasifikácii informácií 2020 (pre aktuálny zoznam pozri Všeobecnú špecifikáciu výrobku Mapa registra) :450040, Plocha jednotky Podtypy10, Plocha nehnuteľnosti, modifikovateľná20, Priestor nehnuteľnosti, modifikovateľný30, Príloha C, modifikovateľná40, Komunita, modifikovateľná50, Priestor nehnuteľnosti, modifikovateľný"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid registra - Območje enote je bilo sestavljeno iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Splošne specifikacije proizvoda Zemljevid registra) :450040, Območje enote Podtipi10, Območje nepremičnine, ki ga je mogoče spremeniti20, Prostor nepremičnine, ki ga je mogoče spremeniti30, Priloga C, ki ga je mogoče spremeniti40, Skupnost, ki ga je mogoče spremeniti50, Prostor nepremičnine, ki ga je mogoče spremeniti"},{"@language":"sv","@value":"Registerkarta - Enhetsområde bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450040, EnhetsområdeUndertyper10, Fastighetsområde, modifierbar20, Fastighetsutrymme, modifierbar30, Bihang C, modifierbar40, Samfällighet, modifierbar50, Ägarlägenhetsutrymme, modifierbar"},{"@language":"uk-t-sv-t0-mtec","@value":"Область одиниць складалася з таких підтипів (підтипів) при класифікації інформації 2020 (для поточного списку див."}],"dct:format":"text/html","dct:identifier":"0d843f7b-c6ca-46c3-9bf5-31bb17a8be5