"@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2016-06-05"},"dcat:startDate":{"@type":"xsd:date","@value":"2016-04-21"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2016-06-05"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2016-04-21"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2798052f-108b-461a-a894-0f5da1d024f9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2016-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Bilderna är ganska gröna. Flyghöjd: ca 2700 meter över marken. Upplösning: 12 cm på marken per pixel. Övertäckning %: 60/60. Fotograferingsdatum: 8 maj 2016. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258_b0n0"},"dct:temporal":{"@id":"_:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2016)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dca