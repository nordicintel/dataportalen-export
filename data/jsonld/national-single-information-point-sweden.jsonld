grader, och som temperaturkurvor. För mer information, se https://miljobarometern.stockholm.se/content/docs/tema/klimat/varme/Temperaturanalyser-fr%C3%A5n-satellit-%C3%B6ver-Stockholms-stad.pdf"},"dct:identifier":"115430a9-87a9-467a-8d64-138a020ff63f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f978b6a34048678a03a2a2d374c051ecc514c93ccdbc8a5bfb1a8e09f0b62de2_b0n0"},"dct:title":{"@language":"sv","@value":"Temperaturkartering 2013-2021"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/content/114e80ab8ea24ea4b4c38f95c5921f42/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Maximal strålningstemperatur"},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/b6407ffc9c6e4b219e7de542d8cf9b18/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Temperaturkurvor & värmeöar"},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:f978b6a34048678a03a2a2d374c051ecc514c93ccdbc8a5bfb1a8e09f0b62de2"},{"@graph":[{"@id":"_:face1d59627f66e82c9db4360f5d682a2a44d312f1757d8211987af9a76a05ff_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:ESRI+Portal-URL/2"},{"@id":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:Information/1"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6acef71a-7573-4dc8-a4f7-32df59c39399"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"Kommunerna har ett viktigt ansvar för att Sveriges vatten ska uppnå miljökvalitetsnormerna enligt EU:s vattendirektiv. Därför tar Stockholms stad fram lokala åtgärdsprogram för stadens vattenförekomster. Syftet med åtgärdsprogrammen är att beskriva lokala påverkanskällor, vilket förbättringsbehov som finns samt vilka åtgärder som behöver genomföras för att uppnå normerna. Den geografiska avgränsningen är vattenförekomstens avrinningsområde. De lokala åtgärdsprogrammen är inte rättsligt bindande, så som Vattenmyndighetens åtgärdsprogram är. Vattenmyndighetens åtgärdsprogram avhandlar generella åtgärder inom vattendistriktet medan de lokala åtgärdsprogrammen förtydligar vad som behöver göras inom respektive avrinningsområde. De lokala åtgärdsprogrammen är tänkta att användas som ett stöd i kommunernas egen planering, samt för att visa vilken miljökvalitet som behöver uppnås och vad som krävs för att nå dit."},"dct:identifier":"097af499-5a1d-4e17-9341-c71176eb18c4","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:face1d59627f66e82c9db4360f5d682a2a44d312f1757d8211987af9a76a05ff_b0n0"},"dct:title":{"@language":"sv","@value":"Åtgärdsdata - Lokala åtgärdsprogram - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/516c6abdf69341eb8eec98f20f60b450/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Nedladdning"},{"@id":"https://resources.stockholm.se/data/097af499-5a1d-4e17-9341-c71176eb18c4#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/atgarder/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"MiljödataStockholm"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:face1d59627f66e82c9db4360f5d682a2a44d312f1757d8211987af9a76a05ff"},{"@graph":[{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b0n0","@type":"http://schema.org/Offer","http://schema.org/description":{"@language":"sv","@value":"Se webbsidan"},"http://schema.org/mainEntityOfPage":{"@id":"https://bolagsverket.se/apierochoppnadata/hamtaforetagsinformation/avisering.2009.html"}},{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Sundsvall","http://www.w3.org/2006/vcard/ns#postal-code":"851 81","http://www.w3.org/2006/vcard/ns#street-address":"Stuvarvägen 21"},{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b3n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46771670670"}},{"@id":"http://dataportal.se/organisation/SE2021005489","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Bolagsverket tillgängliggör datamängder som API:er och XML-paket för företagsinformation och avisering. Avgifter tas ut genom anslutningsavgift och löpande månads- eller årsavgift, beroende på tjänst och transaktioner. Avgiftens storlek varierar, men exempel är: t.ex. 5 000 kr i anslutningsavgift för XML-paket och en transaktionsbaserad löpande avgift; vissa tjänster är kostnadsfria för myndigheter, 250 kr/år för kommuner och regioner."},"dct:identifier":"2021005489","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://bolagsverket.se/"},"foaf:mbox":{"@id":"mailto:ssbt@bolagsverket.se"},"foaf:name":{"@language":"sv","@value":"Bolagsverket"},"foaf:page":{"@id":"https://www.bolagsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://bolagsverket.se/apierochoppnadata/apiforatthamtaforetagsinformation/dataset#creator"},{"@id":"https://bolagsverket.se/catalog#publisher"},{"@id":"https://bolagsverket.se/ssbtgo/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-api/dataset#creator"},{"@id":"https://bolagsverket.se/vardefulla-datamangder-bulkfil/dataset#creator"},{"@id":"https://bolagsverket.se/xmlpaket/dataset#creator"},{"@id":"https://metadata.bolagsverket.se/store/36/resource/1"},{"@id":"https://minaombud.se/dataset#creator"},{"@id":"https://www.bolagsverket.se/ssbt/dataset#creator"}],"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/10","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.bolagsverket.se/store/2/resource/20"},"dcat:distribution":{"@id":"https://metadata.bolagsverket.se/store/2/resource/25"},"dcat:keyword":[{"@language":"en","@value":"Company Information"},{"@language":"sv","@value":"Företagsinformation"}],"dcat:landingPage":{"@id":"https://bolagsverket.se/be/sok/avisering"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Avisering om förändringar i Bolagsverkets register för företagsinformation via filer som skapas dagligen och överförs via SFTP. Notera att du måste vara registerad som kund och att det tillkommer avgifter för att använda tjänsten."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005489"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Avisering om förändringar i företagsregistren"},"http://schema.org/offers":{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b0n0"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"API Bolagsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:api@bolagsverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b2n0"},{"@id":"_:fb76a45e0a925d9230db757acfc0054deaeb3ac37c9941e1fe30ce58d1c24214_b3n0"}],"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://bolagsverket.se/apierochoppnadata/driftochsupport/kontaktaossomapierochoppnadata.3996.html"}},{"@id":"https://metadata.bolagsverket.se/store/2/resource/25","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://bolagsverket.se/be/sok/avisering"},"dct:description":{"@language":"sv","@value":"Företagsinformation, Aviseringar"},"dct:format":{"@id":