ana"},{"@language":"mt-t-sv-t0-mtec","@value":"Investigazzjoni tal-paternità"},{"@language":"nl-t-sv-t0-mtec","@value":"Vaderschapsonderzoek"},{"@language":"pl-t-sv-t0-mtec","@value":"Dochodzenie w sprawie ojcostwa"},{"@language":"pt-t-sv-t0-mtec","@value":"Investigação de paternidade"},{"@language":"ro-t-sv-t0-mtec","@value":"Investigarea paternității"},{"@language":"sk-t-sv-t0-mtec","@value":"Vyšetrovanie otcovstva"},{"@language":"sl-t-sv-t0-mtec","@value":"Preiskava očetovstva"},{"@language":"sv","@value":"Faderskapsutredning"},{"@language":"uk-t-sv-t0-mtec","@value":"Розслідування батьківства"}]},{"@id":"http://data.europa.eu/88u/record/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-faderskapsutredning-1-0-0-2523dataset~~1","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"_:7863a18153f06c5e14e5471871f86ff6f328cf72a91c7fc6426f8a53531dc470_b1n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-08T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T04:47:57Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-faderskapsutredning-1-0-0-2523dataset~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7863a18153f06c5e14e5471871f86ff6f328cf72a91c7fc6426f8a53531dc470_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-www7-skatteverket-se-portal-apier-och-oppna-data-utvecklarportalen-api-faderskapsutredning-1-0-0-2523dataset~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-10-09T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-10-11T04:47:57Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/faderskapsutredning/1.0.0/%2523dataset","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/faderskapsutredning/1.0.0/%2523dataset"}},{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]}],"@id":"urn:source:7863a18153f06c5e14e5471871f86ff6f328cf72a91c7fc6426f8a53531dc470"},{"@graph":[{"@id":"_:79c0fbd0139c2ee406378142b100fd43dcbc2ed6f129e3b57e00fae212fe8d9f_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"cbe6818327ad61ae190aa5644fb58d822"},{"@id":"http://data.europa.eu/88u/dataset/9b22e337-8e37-4fc2-a7a0-57a26a1d311d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Exploateringsn%C3%A4mnd/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7219416f-2ac5-4eee-bc7c-af7bc84049a7"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fastigheter och fysisk planering"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=eafeb1e1-4cca-4ddc-b7a0-6fda6287b27a"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта, показваща коя земя е собственост на град Стокхолм, дали земята се управлява от администрациите или дружествата на града и коя земя се отдава под аренда с аренда."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapová služba zobrazující, které pozemky město Stockholm vlastní, zda jsou spravovány městskými správami nebo společnostmi a které pozemky jsou pronajímány s nájemcem."},{"@language":"da-t-sv-t0-mtec","@value":"Korttjeneste, der viser, hvilken jord byen Stockholm ejer, om jorden forvaltes af byens forvaltninger eller virksomheder, og hvilken jord der lejes med forpagtning."},{"@language":"de-t-sv-t0-mtec","@value":"Kartendienst, der zeigt, welches Land die Stadt Stockholm besitzt, ob das Land von den Verwaltungen oder Unternehmen der Stadt verwaltet wird und welches Land mit einem Pachtbesitz verpachtet wird."},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία χαρτών που δείχνει ποια γη κατέχει ο δήμος της Στοκχόλμης, εάν η γη τελεί υπό τη διαχείριση των διοικήσεων ή των εταιρειών του δήμου και ποια γη μισθώνεται με μίσθωση."},{"@language":"en-t-sv-t0-mtec","@value":"Map service showing which land the City of Stockholm owns, whether the land is managed by the City's administrations or companies and which land is leased with a leasehold."},{"@language":"es-t-sv-t0-mtec","@value":"Servicio de mapas que muestra qué terreno posee la Ciudad de Estocolmo, si el terreno es administrado por las administraciones o empresas de la Ciudad y qué terreno se arrienda con un arrendamiento."},{"@language":"et-t-sv-t0-mtec","@value":"Kaarditeenus, mis näitab, millist maad Stockholmi linn omab, kas maad haldavad linnavalitsused või ettevõtted ning millist maad renditakse rendile."},{"@language":"fi-t-sv-t0-mtec","@value":"Karttapalvelu, josta käy ilmi, mikä maa-alue on Tukholman kaupungin omistuksessa, hallinnoivatko kaupungin viranomaiset vai yritykset maata ja mikä maa-alue on vuokrattu vuokrasopimuksella."},{"@language":"fr-t-sv-t0-mtec","@value":"Service de carte indiquant quels terrains appartiennent à la ville de Stockholm, si les terrains sont gérés par les administrations ou les entreprises de la ville et quels terrains sont loués à bail."},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís léarscáile a thaispeánann cén talamh atá faoi úinéireacht Chathair Stócólm, cibé acu atá nó nach bhfuil an talamh á bhainistiú ag riaracháin nó ag cuideachtaí na Cathrach agus cén talamh atá léasaithe le léasacht."},{"@language":"hr-t-sv-t0-mtec","@value":"Usluga kartiranja koja prikazuje koje je zemljište u vlasništvu Grada Stockholma, upravlja li zemljištem uprava ili poduzeća Grada i koje je zemljište zakupljeno u zakupu."},{"@language":"hu-t-sv-t0-mtec","@value":"Térképes szolgáltatás, amely megmutatja, hogy Stockholm városa milyen földterülettel rendelkezik, hogy a földterületet a város közigazgatási szervei vagy vállalatai kezelik-e, és hogy mely földterületet lízingelik."},{"@language":"it-t-sv-t0-mtec","@value":"Servizio cartografico che mostra quale terreno possiede la città di Stoccolma, se il terreno è gestito dalle amministrazioni o dalle società della città e quale terreno è affittato con un contratto di locazione."},{"@language":"lt-t-sv-t0-mtec","@value":"Žemėlapio paslauga, rodanti, kokia žemė priklauso Stokholmo miestui, ar žemę valdo miesto administracijos, ar įmonės, ir kuri žemė nuomojama išperkamosios nuomos būdu."},{"@language":"lv-t-sv-t0-mtec","@value":"Kartes pakalpojums, kurā parādīts, kura zeme pieder Stokholmas pilsētai, vai to pārvalda pilsētas pārvaldes iestādes vai uzņēmumi un kura zeme tiek iznomāta ar nomas līgumu."},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz ta’ mappa li juri liema art hija s-sid tal-Belt ta’ Stokkolma, jekk l-art hijiex ġestita mill-amministrazzjonijiet jew mill-kumpaniji tal-Belt u liema art hija mikrija b’kirja."},{"@language":"nl-t-sv-t0-mtec","@value":"Kaartdienst die laat zien welke grond de stad Stockholm bezit, of de grond wordt beheerd door de administraties of bedrijven van de stad en welke grond wordt geleased met een erfpacht."},{"@language":"pl-t-sv-t0-mtec","@value":"Usługa mapowania pokazująca, które grunty są własnością miasta Sztokholm, czy grunty są zarządzane przez administrację miasta lub przedsiębiorstwa, a które grunty są dzierżawione z dzierżawą."},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço de mapas que indica quais os terrenos de que a cidade de Estocolmo é proprietária, se os terrenos são geridos pelas administrações ou empresas da cidade e quais os terrenos arrendados com um arrendatário."},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciu de cartografiere care arată ce teren deține orașul Stockholm, dacă terenul este gestionat de administrațiile sau întreprinderile orașului și ce teren este închiriat cu un drept de arendă."},{"@language":"sk-t-sv-t0-mtec","@value":"Mapová služba znázorňujúca, ktorý pozemok mesto Štokholm vlastní, či je pozemok spravovaný správami mesta alebo spoločnosťami mesta a ktorý pozemok je prenajatý s prenájmom."},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev zemljevida, ki prikazuje, katero zemljišče je v lasti mesta Stockholm, ali zemljišče upravljajo mestne uprave ali podjetja in katero zemljišče je zakupljeno z zakupno pravico."},{"@language":"sv","@value":"Karttjänst som visar vilken mark Stockholms stad äger, om marken förvaltas av stadens förvaltningar eller bolag samt vilken mark som är upplåten med tomträtt."},{"@language":"uk-t-sv-t0-mtec","@value":"Карта показує, якою землею володіє місто Стокгольм, чи управляється земля адміністраціями міста або компаніями, і яка земля здається в оренду з орендою."}],"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"9b22e337-8e37-4fc2-a7a0-57a26a1d311d","dct:issued":{"@type":"xsd:date","@value":"2017-07-03"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Имоти, които са общинска собственост"},{"@language":"cs-t-sv-t0-mtec","@value":"Nemovitosti v obecním vlastnictví"},{"@language":"da-t-sv-t0-mtec","@value":"Kommunalt ejede ejendomme"},{"@language":"de-t-sv-t0-mtec","@value":"Kommunalbesitz"},{"@language":"el-t-sv-t0-mtec","@value":"Ακίνητα δημοτικής ιδιοκτησίας"},{"@language":"en-t-sv-t0-mtec","@value":"Municipally owned properties"},{"@language":"es-t-sv-t0-mtec","@value":"Propiedades de propiedad municipal"},{"@language":"et-t-sv-t0-mtec","@value":"Omavalitsuse omandis olevad kinnistud"},{"@language":"fi-t-sv-t0-mtec","@value":"Kunnalliset kiinteistöt"},{"@language":"fr-t-sv-t0-mtec","@value":"Propriétés appartenant à la municipalité"},{"@language":"ga-t-sv-t0-mtec","@value":"Maoin atá faoi úinéireacht bhardasach"},{"@language":"hr-t-sv-t0-mtec","@value":"Nekretnine u općinskom vlasništvu"},{"@language":"hu-t-sv-t0-mtec","@value":"Önkormányzati tulajdonban lévő ingatlanok"},{"@language":"it-t-sv-t0-mtec","@value":"Proprietà di proprietà comunale"},{"@language":"lt-t-sv-t0-mtec","@value":"Savivaldybės nuosavybė"},{"@language":"lv-t-sv-t0-mtec","@value":"Pašvaldībai piederoši īpašumi"},{"@language":"mt-t-sv-t0-mtec","@value":"Proprjetajiet ta' proprjetà muniċipali"},{"@language":"nl-t-sv-t0-mtec","@value":"Gemeentelijk eigendom"},{"@language":"pl-t-sv-t0-mtec","@value":"Nieruchomości komunalne"},{"@language":"pt-t-sv-t0-mtec","@value":"Propriedades de propriedade municipal"},{"@language":"ro-t-sv-t0-mtec","@value":"Proprietăți aflate în proprietatea municipalității"},{"@language":"sk-t-sv-t0-mtec","@value":"Nehnuteľnosti v obecnom vlastníctve"},{"@language":"sl-t-sv-t0-mtec","@value":"Nepremičnine v občinski lasti"},{"@language":"sv","@value":"Kommunägda fastigheter"},{"@language":"uk-t-sv-t0-mtec","@value":"Муніципальна власність"}],"dct:type":{"@id":"http://