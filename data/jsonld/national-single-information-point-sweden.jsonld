/88u/metrics/f972cca1-a5c9-4b02-889b-508651e11cb0"},"https://piveau.eu/ns/voc#originalId":"f972cca1-a5c9-4b02-889b-508651e11cb0","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xsd:anyURI","@value":"https://resources.stockholm.se/data/f972cca1-a5c9-4b02-889b-508651e11cb0"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:3e74587003b197fb643dadce617e827cc9f90f7b78191e63014beeb4bfc6064f"},{"@graph":[{"@id":"_:3f0f200ab0823059c80d1a26438ac7fcaa93f7a24926550f4aa8f3f77c6e29a3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:3f0f200ab0823059c80d1a26438ac7fcaa93f7a24926550f4aa8f3f77c6e29a3_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"240b5c56ec7a9febb59773029fdcc4e98e"},{"@id":"http://data.europa.eu/88u/dataset/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/32d5e5a0-313b-4c55-a073-e825f2f27e0e"},{"@id":"http://data.europa.eu/88u/distribution/68d7abb7-b3c8-4ef1-9677-1e314ea45a32"},{"@id":"http://data.europa.eu/88u/distribution/706c6ba6-63b2-452e-8894-ebdb5a898123"},{"@id":"http://data.europa.eu/88u/distribution/775bf935-591a-42fd-ac8e-aab9ae1fedfc"},{"@id":"http://data.europa.eu/88u/distribution/cb0db74d-fd6f-4005-9cfb-323a28681c63"},{"@id":"http://data.europa.eu/88u/distribution/d3d8a633-4daf-48f4-aa4c-68a359eee51a"},{"@id":"http://data.europa.eu/88u/distribution/d646114f-059f-4021-b3ed-bc89a922759f"},{"@id":"http://data.europa.eu/88u/distribution/fd7cdf80-6fd8-4a03-8a54-488dd94921da"}],"dcat:keyword":[{"@language":"sv","@value":"Bakgrundskarta"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0eed76ad-7a89-4da1-9766-e9fcf7b31789"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Картата на града е обзорна карта, адаптирана за обхвата на скалата от 1:4 000 до 1:8 000. Топлата и нежна цветова схема, съчетана с подробното съдържание, прави картата на града лесна за четене и подходяща за използване както в печатни, така и в уеб-адаптирани версии. Обобщеното съдържание на картата на града означава, че картата е ясна, дори когато трябва да се показват по-големи географски райони, и следователно може да се използва като основна карта, когато трябва да се изясни специфична за дейността информация. Използва се и като собствена информационна карта. Съдържанието включва например административни граници, блокове, имоти, всички сгради, улици, адресни номера, природни зони, криви на кота 2 метра и релсови мрежи. Действащи услуги във връзка с WMS: приложения за изпълнение на WMS Tiling Client Recommendation се препоръчва да се използва добавената услуга WMS.Наборът от данни в регистъра не включва версията с отворени данни на картата на града."},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa města je přehledová mapa upravená pro měřítko 1:4 000 až 1:8 000. Teplé a jemné barevné schéma v kombinaci s podrobným obsahem činí mapu města snadno čitelnou a vhodnou pro použití v tištěné i webové verzi. Zobecněný obsah mapy města znamená, že mapa je jasná i v případě, že mají být zobrazeny větší zeměpisné oblasti, a proto ji lze použít jako mapu pozadí, pokud mají být vyjasněny informace specifické pro danou činnost. Používá se také jako vlastní informační mapa. Obsah zahrnuje například administrativní hranice, bloky, vlastnosti, všechny budovy, ulice, čísla adres, přírodní oblasti, dvoumetrové výškové křivky a kolejové sítě. Platné služby WMS: Doporučuje se, aby aplikace implementující doporučení klienta WMS Tiling používaly přidanou službu WMS. Soubor dat registru neobsahuje otevřenou datovou verzi Mapy města."},{"@language":"da-t-sv-t0-mtec","@value":"Bykortet er et oversigtskort, der er tilpasset skalaen 1:4 000 til 1:8 000. Det varme og blide farveskema kombineret med det detaljerede indhold gør bykortet let at læse og velegnet til brug i både trykte og webtilpassede versioner. Bykortets generelle indhold betyder, at kortet er klart, selv når større geografiske områder skal vises, og det kan således bruges som baggrundskort, når aktivitetsspecifikke oplysninger skal afklares. Det bruges også som sit eget informationsbærende kort. Indhold omfatter for eksempel administrative grænser, blokke, ejendomme, alle bygninger, gader, adressenumre, naturområder, 2 meter højdekurver og spornetværk. Gældende WMS-tjenester: applikationer, der implementerer WMS Tiling Client Recommendation, anbefales at bruge den tilføjede WMS-tjeneste.Registreringsdatasættet indeholder ikke den åbne dataversion af bykortet."},{"@language":"de-t-sv-t0-mtec","@value":"Der Stadtplan ist eine für den Maßstabsbereich 1:4 000 bis 1:8 000 angepasste Übersichtskarte. Die warme und sanfte Farbgebung in Verbindung mit dem detaillierten Inhalt macht den Stadtplan gut lesbar und eignet sich sowohl für Print- als auch für webangepasste Versionen. Durch den verallgemeinerten Inhalt der Stadtkarte ist die Karte auch dann übersichtlich, wenn größere geographische Gebiete angezeigt werden sollen und kann somit als Hintergrundkarte genutzt werden, wenn tätigkeitsspezifische Informationen geklärt werden sollen. Es wird auch als eigene informationstragende Karte verwendet. Zu den Inhalten gehören beispielsweise Verwaltungsgrenzen, Blöcke, Grundstücke, alle Gebäude, Straßen, Adressnummern, Naturgebiete, 2-Meter-Höhenkurven und Gleisnetze. In Kraft befindliche WMS-Dienste: Anwendungen, die die WMS Tiling Client-Empfehlung implementieren, werden empfohlen, den hinzugefügten WMS-Dienst zu verwenden.Der Registrierungsdatensatz enthält nicht die offene Datenversion der Stadtkarte."},{"@language":"el-t-sv-t0-mtec","@value":"Ο χάρτης της πόλης είναι ένας χάρτης επισκόπησης προσαρμοσμένος για το εύρος κλίμακας 1:4 000 έως 1:8 000. Ο ζεστός και απαλός χρωματικός συνδυασμός σε συνδυασμό με το λεπτομερές περιεχόμενο καθιστά τον χάρτη της πόλης εύκολο στην ανάγνωση και κατάλληλο για χρήση τόσο σε έντυπη όσο και σε προσαρμοσμένη στο διαδίκτυο έκδοση. Το γενικευμένο περιεχόμενο του χάρτη της πόλης σημαίνει ότι ο χάρτης είναι σαφής ακόμη και όταν πρόκειται να εμφανιστούν μεγαλύτερες γεωγραφικές περιοχές και, ως εκ τούτου, μπορεί να χρησιμοποιηθεί ως χάρτης φόντου όταν πρέπει να αποσαφηνιστούν συγκεκριμένες πληροφορίες για συγκεκριμένες δραστηριότητες. Χρησιμοποιείται επίσης ως ο δικός του χάρτης που περιέχει πληροφορίες. Το περιεχόμενο περιλαμβάνει, για παράδειγμα, διοικητικά όρια, οικοδομικά τετράγωνα, ακίνητα, όλα τα κτίρια, δρόμους, αριθμούς διευθύνσεων, φυσικές περιοχές, καμπύλες υψομέτρου 2 μέτρων και δίκτυα τροχιάς. Ισχύουσες υπηρεσίες WMS: οι εφαρμογές που υλοποιούν τη σύσταση πελάτη πλακιδίων WMS συνιστώνται να χρησιμοποιούν την προστιθέμενη υπηρεσία WMS. Το σύνολο δεδομένων μητρώου δεν περιλαμβάνει την έκδοση ανοικτών δεδομένων του χάρτη πόλης."},{"@language":"en-t-sv-t0-mtec","@value":"The city map is an overview map adapted for the scale range 1:4 000 to 1:8 000. The warm and gentle colour scheme combined with the detailed content makes the city map easy to read and suitable for use in both print and web-adapted versions. The generalized content of the city map means that the map is clear even when larger geographical areas are to be displayed and it can thus be used as a background map when activity-specific information is to be clarified. It is also used as its own information-bearing map. Content includes, for example, administrative boundaries, blocks, properties, all buildings, streets, address numbers, natural areas, 2-meter elevation curves and track networks. WMS services in force: applications implementing the WMS Tiling Client Recommendation are recommended to use the added WMS service.The registry data set does not include the open data version of the City Map."},{"@language":"es-t-sv-t0-mtec","@value":"El mapa de la ciudad es un mapa general adaptado para el rango de escala 1:4 000 a 1:8 000. El esquema de color cálido y suave combinado con el contenido detallado hace que el mapa de la ciudad sea fácil de leer y adecuado para su uso en versiones impresas y adaptadas a la web. El contenido generalizado del mapa de la ciudad significa que el mapa es claro incluso cuando se deben mostrar áreas geográficas más grandes y, por lo tanto, se puede usar como mapa de fondo cuando se debe aclarar información específica de la actividad. También se utiliza como su propio mapa portador de información. El contenido incluye, por ejemplo, límites administrativos, bloques, propiedades, todos los edificios, calles, números de direcciones, áreas naturales, curvas de elevación de 2 metros y redes de vías. Servicios WMS en vigor: Se recomienda que las aplicaciones que implementen la recomendación del cliente de WMS Tiling usen el servicio WMS agregado."},{"@language":"et-t-sv-t0-mtec","@value":"Linnakaart on ülevaatlik kaart, mis on kohandatud skaalale 1:4 000 kuni 1:8 000. Soe ja õrn värvilahendus koos üksikasjaliku sisuga muudab linnakaardi kergesti loetavaks ja sobivaks kasutamiseks nii trüki- kui ka veebipõhistes versioonides. Linnakaardi üldistatud sisu tähendab, et kaart on selge isegi siis, kui näidatakse suuremaid geograafilisi piirkondi, ning seega saab seda kasutada taustakaardina tegevuspõhise teabe täpsustamisel. Seda kasutatakse ka oma informatsiooni kandva kaardina. Sisu hõlmab näiteks halduspiire, plokke, omadusi, kõiki hooneid, tänavaid, aadressinumbreid, looduslikke alasid, 2-meetriseid kõrguskõveraid ja rööbaste võrgustikke. Kehtivad WMS-teenused: WMS Tiling Client soovitust rakendavatel rakendustel soovitatakse kasutada lisatud WMS teenust.Registreerimisandmekogum ei sisalda linnakaardi avaandmete versiooni."},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupungin kartta on yleiskartta, joka on mukautettu asteikolle 1:4 000 - 1:8 000. Lämmin ja lempeä värimaailma yhdistettynä yksityiskohtaiseen sisältöön tekee kaupungin kartasta helposti luettavan ja sopii käytettäväksi sekä painetuissa että web-sovitetuissa versioissa. Kaupunginkartan yleistetty sisältö tarkoittaa, että kartta on selkeä myös silloin, kun on tarkoitus näyttää suurempia maantieteellisiä alueita, ja sitä voidaan siten käyttää taustakarttana, kun toimintokohtaisia tietoja on selvennettävä. Sitä käytetään myös omana informaatiokartanaan. Sisältö sisältää esimerkiksi hallinnolliset rajat, lohkot, kiinteistöt, kaikki rakennukset, kadut, osoitenumerot, luonnonalueet, 2 metrin korkeuskäyrät ja rataverkot. Voimassa olevat WMS-palvelut: WMS Tiling Client -suosituksen täytäntöönpanevia sovelluksia suositellaan käyttämään lisättyä WMS-palvelua.Rekisterin datajoukko ei sisällä kaupunkikartan avoimen datan versiota."},{"@language":"fr-t-sv-t0-mtec","@value":"La carte de la ville est une carte d'ensemble adaptée à l'échelle de 1:4 000 à 1:8 000. La palette de couleurs chaudes et douces combinée au contenu détaillé rend la carte de la ville facile à lire et adaptée à une utilisation dans les versions imprimées et web-adaptées. Le contenu généralisé de la carte de la ville signifie que la carte est claire même lorsque de plus grandes zones géographiques doivent être affichées et qu'elle peut donc être utilisée comme carte de fond lorsque des informations spécifiques à une activité doivent être clarifiées. Il est également utilisé comme sa propre carte porteuse d'informations. Le contenu comprend, par exemple, les limites administratives, les blocs, les propriétés, tous les bâtiments, les rues, les numéros d'adresse, les zones naturelles, les courbes d'altitude de 2 mètres et les réseaux de voies. Services WMS en vigueur: Il est recommandé aux applications implémentant la recommandation WMS Tiling Client d'utiliser le service WMS ajouté.L'ensemble de données du registre n'inclut pas la version de données ouvertes de la carte de la ville."},{"@language":"ga-t-sv-t0-mtec","@value":"Is léarscáil forléargais é léarscáil na cathrach atá curtha in oiriúint don raon scála 1:4 000 go 1:8 000. Fágann an scéim dathanna te agus séimh mar aon leis an ábhar mionsonraithe go bhfuil léarscáil na cathrach éasca le léamh agus oiriúnach le húsáid i leaganacha clóite agus i leaganacha atá oiriúnaithe don ghréasán araon. Ciallaíonn ábhar ginearálaithe léarscáil na cathrach go bhfuil an léarscáil soiléir fiú nuair atá limistéir gheografacha níos mó le taispeáint agus dá bhrí sin is féidir í a úsáid mar léarscáil chúlra nuair atá faisnéis a bhaineann go sonrach le gníomhaíocht le soiléiriú. Úsáidtear é freisin mar a léarscáil faisnéise féin. Áirítear ar an ábhar, mar shampla, teorainneacha riaracháin, bloic, airíonna, gach foirgneamh, sráideanna, uimhreacha seoltaí, limistéir nádúrtha, cuair airde 2 mhéadar agus líonraí rianta. Seirbhísí WMS atá i bhfeidhm: moltar d'fheidhmchláir a chuireann Moladh Cliant um Theagmháil WMS chun feidhme an tseirbhís bhreise WMS a úsáid."},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada je pregledna karta prilagođena rasponu ljestvice od 1:4 000 do 1:8 000. Topla i nježna shema boja u kombinaciji s detaljnim sadržajem čini gradsku kartu jednostavnom za čitanje i prikladnom za upotrebu u tiskanim verzijama i verzijama prilagođenima webu. Opći sadržaj karte grada znači da je karta jasna čak i kada će se prikazivati veća zemljopisna područja te se stoga može koristiti kao pozadinska karta pri razjašnjavanju informacija specifičnih za određenu aktivnost. Također se koristi kao vlastita karta s informacijama. Sadržaj uključuje, na primjer, administrativne granice, blokove, svojstva, sve zgrade, ulice, brojeve adresa, prirodna područja, krivulje nadmorske visine od 2 metra i mreže kolosijeka. Usluge WMS-a koje su na snazi: aplikacije za provedbu preporuke klijenta WMS Tiling preporučuju se za korištenje dodane usluge WMS. Skup podataka registra ne uključuje verziju otvorenih podataka gradske karte."},{"@language":"hu-t-sv-t0-mtec","@value":"A várostérkép az 1:4 000 és 1:8 000 közötti skálatartományhoz igazított áttekintő térkép. A meleg és gyengéd színösszeállítás a részletes tartalommal kombinálva könnyen olvashatóvá teszi a várostérképet, és mind nyomtatott, mind webes változatban használható. A várostérkép általános tartalma azt jelenti, hogy a térkép akkor is egyértelmű, ha nagyobb földrajzi területeket kell megjeleníteni, és így háttértérképként használható a tevékenységspecifikus információk tisztázásakor. Saját információhordozó térképként is használják. A tartalom magában foglalja például a közigazgatási határokat, blokkokat, ingatlanokat, minden épületet, utcát, címszámot, természetes területeket, 2 méteres magassági görbéket és pályahálózatokat. Hatályos WMS-szolgáltatások: A WMS Tiling Client Ajánlást megvalósító alkalmazások számára ajánlott a hozzáadott WMS szolgáltatás használata."},{"@language":"it-t-sv-t0-mtec","@value":"La mappa della città è una mappa panoramica adattata per la scala da 1:4 000 a 1:8 000. Lo schema di colori caldo e delicato combinato con il contenuto dettagliato rende la mappa della città facile da leggere e adatta per l'uso in entrambe le versioni stampate e adattate al web. Il contenuto generalizzato della mappa della città significa che la mappa è chiara anche quando devono essere visualizzate aree geografiche più grandi e può quindi essere utilizzata come mappa di sfondo quando devono essere chiarite informazioni specifiche per attività. È anche usato come propria mappa portante di informazioni. Il contenuto include, ad esempio, confini amministrativi, blocchi, proprietà, tutti gli edifici, le strade, i numeri di indirizzo, le aree naturali, le curve di elevazione di 2 metri e le reti di binari. Servizi WMS in vigore: Si raccomanda alle applicazioni che implementano la WMS Tiling Client Recommendation di utilizzare il servizio WMS aggiunto."},{"@language":"lt-t-sv-t0-mtec","@value":"Miesto žemėlapis yra apžvalgos žemėlapis, pritaikytas masteliui nuo 1:4 000 iki 1:8 000. Šilta ir švelni spalvų schema kartu su detaliu turiniu leidžia lengvai perskaityti miesto žemėlapį ir jį naudoti tiek spausdintinėje, tiek prie interneto pritaikytoje versijoje. Bendras miesto žemėlapio turinys reiškia, kad žemėlapis yra aiškus net tada, kai turi būti rodomos didesnės geografinės teritorijos, todėl jis gali būti naudojamas kaip foninis žemėlapis, kai turi būti paaiškinta su konkrečia veikla susijusi informacija. Jis taip pat naudojamas kaip savo informacijos turintis žemėlapis. Turinys apima, pavyzdžiui, administracines ribas, blokus, savybes, visus pastatus, gatves, adresų numerius, natūralias vietoves, 2 metrų aukščio kreives ir bėgių tinklus. Galiojančios WMS paslaugos: programoms, įgyvendinančioms WMS Tiling Client rekomendaciją, rekomenduojama naudoti pridėtą WMS paslaugą.Registro duomenų rinkinyje nėra miesto žemėlapio atvirųjų duomenų versijos."},{"@language":"lv-t-sv-t0-mtec","@value":"Pilsētas karte ir pārskata karte, kas pielāgota mērogam no 1:4 000 līdz 1:8 000. Siltā un maigā krāsu shēma apvienojumā ar detalizēto saturu padara pilsētas karti viegli lasāmu un piemērotu izmantošanai gan drukātā, gan tīmekļa versijās. Pilsētas kartes vispārējais saturs nozīmē, ka karte ir skaidra pat tad, ja ir jāattēlo lielāki ģeogrāfiskie apgabali, un tādējādi to var izmantot kā fona karti, kad ir jāprecizē ar darbību saistītā informācija. To izmanto arī kā savu informācijas nesēju karti. Saturs ietver, piemēram, administratīvās robežas, blokus, īpašumus, visas ēkas, ielas, adrešu numurus, dabas teritorijas, 2 metru augstuma līknes un sliežu ceļu tīklus. Spēkā esošie WMS pakalpojumi: lietojumprogrammām, kas īsteno WMS Flīzēšanas klienta ieteikumu, ieteicams izmantot pievienoto WMS pakalpojumu. Reģistra datu kopa neietver pilsētas kartes atvērto datu versiju."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-mappa tal-belt hija mappa ta’ ħarsa ġenerali adattata għall-iskala ta’ bejn 1:4 000 u 1:8 000. L-iskema ta’ kuluri sħan u ġentili flimkien mal-kontenut dettaljat tagħmel il-mappa tal-belt faċli biex tinqara u adattata għall-użu kemm fil-verżjonijiet stampati kif ukoll f’dawk adattati għall-web. Il-kontenut ġeneralizzat tal-mappa tal-belt ifisser li l-mappa hija ċara anke meta jridu jintwerew żoni ġeografiċi akbar u għalhekk tista’ tintuża bħala mappa tal-isfond meta trid tiġi ċċarata informazzjoni speċifika għall-attività. Jintuża wkoll bħala l-mappa tiegħu stess li ġġorr l-informazzjoni. Il-kontenut jinkludi, pereżempju, il-konfini amministrattivi, il-blokok, il-proprjetajiet, il-bini kollu, it-toroq, in-numri tal-indirizzi, iż-żoni naturali, il-kurvi ta’ elevazzjoni ta’ 2 metri u n-networks tal-binarji. Is-servizzi tad-WMS fis-seħħ: l-applikazzjonijiet li jimplimentaw ir-Rakkomandazzjoni tal-Klijent tal-WMS Tiling huma rrakkomandati li jużaw is-servizz miżjud tad-WMS. Is-sett tad-data tar-reġistru ma jinkludix il-verżjoni tad-data miftuħa tal-Mappa tal-Belt."},{"@language":"nl-t-sv-t0-mtec","@value":"De stadskaart is een overzichtskaart aangepast aan het schaalbereik 1:4 000 tot 1:8 000. Het warme en zachte kleurenschema in combinatie met de gedetailleerde inhoud maakt de stadsplattegrond gemakkelijk te lezen en geschikt voor gebruik in zowel print- als web-aangepaste versies. De algemene inhoud van de stadskaart betekent dat de kaart duidelijk is, zelfs wanneer grotere geografische gebieden moeten worden weergegeven en het kan dus worden gebruikt als achtergrondkaart wanneer activiteitsspecifieke informatie moet worden verduidelijkt. Het wordt ook gebruikt als een eigen informatie-dragende kaart. Inhoud omvat bijvoorbeeld administratieve grenzen, blokken, eigendommen, alle gebouwen, straten, adresnummers, natuurgebieden, 2 meter hoogtecurves en spoornetwerken. Geldende WMS-diensten: Toepassingen die de WMS Tiling Client Recommendation implementeren, worden aanbevolen om de toegevoegde WMS-service te gebruiken."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa miasta jest mapą przeglądową dostosowaną do skali od 1:4 000 do 1:8 000. Ciepła i delikatna kolorystyka w połączeniu ze szczegółową zawartością sprawia, że mapa miasta jest łatwa do odczytania i nadaje się do użycia zarówno w wersji drukowanej, jak i internetowej. Uogólniona treść mapy miasta oznacza, że mapa jest jasna nawet wtedy, gdy mają być wyświetlane większe obszary geograficzne, a zatem może być wykorzystywana jako mapa tła, gdy mają zostać wyjaśnione informacje dotyczące konkretnych działań. Jest również używany jako własna mapa informacyjna. Treści obejmują na przykład granice administracyjne, bloki, nieruchomości, wszystkie budynki, ulice, numery adresowe, obszary naturalne, 2-metrowe krzywe elewacji i sieci torowe. Obowiązujące usługi WMS: Zaleca się, aby aplikacje wdrażające Rekomendację klienta WMS Tiling korzystały z dodanej usługi WMS.Zestaw danych rejestru nie zawiera otwartej wersji danych Mapy Miasta."},{"@language":"pt-t-sv-t0-mtec","@value":"O mapa da cidade é um mapa geral adaptado para a escala de 1:4 000 a 1:8 000. O esquema de cores quentes e suaves combinado com o conteúdo detalhado torna o mapa da cidade fácil de ler e adequado para utilização em versões impressas e adaptadas à Web. O conteúdo generalizado do mapa da cidade significa que o mapa é claro mesmo quando se pretende apresentar áreas geográficas mais vastas e, por conseguinte, pode ser utilizado como mapa de fundo quando se pretende clarificar informações específicas da atividade. Também é usado como seu próprio mapa de informações. O conteúdo inclui, por exemplo, limites administrativos, blocos, propriedades, todos os edifícios, ruas, números de endereços, áreas naturais, curvas de elevação de 2 metros e redes de vias. Serviços WMS em vigor: Recomenda-se que as aplicações que implementam a Recomendação WMS Tiling Client utilizem o serviço WMS adicionado.O conjunto de dados de registo não inclui a versão de dados abertos do Mapa da Cidade."},{"@language":"ro-t-sv-t0-mtec","@value":"Harta orașului este o hartă generală adaptată pentru scara de la 1:4 000 la 1:8 000. Schema cromatică caldă și delicată, combinată cu conținutul detaliat, face ca harta orașului să fie ușor de citit și potrivită pentru utilizare atât în versiunile de imprimare, cât și în cele adaptate pentru web. Conținutul generalizat al hărții orașelor înseamnă că harta este clară chiar și atunci când urmează să fie afișate zone geografice mai mari și, prin urmare, poate fi utilizată ca hartă de fond atunci când trebuie clarificate informații specifice activității. Este, de asemenea, folosit ca propria hartă purtătoare de informații. Conținutul include, de exemplu, limite administrative, blocuri, proprietăți, toate clădirile, străzile, numerele de adrese, zonele naturale, curbele de altitudine de 2 metri și rețelele de cale ferată. Servicii WMS în vigoare: Aplicațiile care implementează recomandarea WMS Tiling Client sunt recomandate să utilizeze serviciul WMS adăugat."},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa mesta je prehľadná mapa prispôsobená rozsahu mierky 1:4 000 až 1:8 000. Vďaka teplej a jemnej farebnej schéme v kombinácii s podrobným obsahom je mapa mesta ľahko čitateľná a vhodná na použitie v tlačenej aj webovej verzii. Zovšeobecnený obsah mapy mesta znamená, že mapa je jasná aj vtedy, keď sa majú zobraziť väčšie geografické oblasti, a preto sa môže použiť ako pozaďová mapa, keď sa majú objasniť informácie špecifické pre jednotlivé činnosti. Používa sa aj ako vlastná informačná mapa. Obsah zahŕňa napríklad administratívne hranice, bloky, nehnuteľnosti, všetky budovy, ulice, čísla adries, prírodné oblasti, 2-metrové výškové krivky a traťové siete. Platné služby WMS: Odporúča sa, aby aplikácie implementujúce odporúčanie klienta WMS Tiling používali pridanú službu WMS. Súbor údajov registra nezahŕňa verziu otvorených údajov mapy mesta."},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid mesta je pregledni zemljevid, prilagojen razponu od 1:4 000 do 1:8 000. Topla in nežna barvna shema v kombinaciji s podrobno vsebino naredi zemljevid mesta enostaven za branje in primeren za uporabo v tiskanih in spletnih različicah. Splošna vsebina zemljevida mesta pomeni, da je zemljevid jasen tudi, kadar je treba prikazati večja geografska območja, zato se lahko uporabi kot zemljevid ozadja, kadar je treba pojasniti informacije, specifične za dejavnost. Uporablja se tudi kot lasten informacijski zemljevid. Vsebina vključuje na primer upravne meje, bloke, nepremičnine, vse stavbe, ulice, številke naslovov, naravna območja, 2-metrske višinske krivulje in omrežja tirov. Veljavne storitve WMS: aplikacijam, ki izvajajo priporočilo odjemalca za tlakovanje WMS, se priporoča uporaba dodane storitve WMS. Nabor podatkov registra ne vključuje različice zemljevida mesta z odprtimi podatki."},{"@language":"sv","@value":"Stadskartan är en översiktskarta anpassad för skalintervallet 1:4 000 till 1:8 000. Den varma och milda färgsättningen i kombination med det detaljerade innehållet gör stadskartan lättläst och lämplig att användas både i tryck och webbanpassade versioner. Stadskartans generaliserade innehåll gör att kartan är tydlig även när större geografiska områden ska visas och den kan därmed användas som bakgrundskarta när verksamhetsspecifik information ska tydliggöras. Den används även som en egen informationsbärande karta. Innehållet inkluderar t ex administrativa gränser, kvarter, fastigheter, alla byggnader, gator, adressnummer, naturområden, 2-meters höjdkurvor och spårnät. Gällande WMS-tjänsterna: applikationer som implementerar WMS Tiling Client Recommendation rekommenderas att använda den tilade WMS-tjänsten.Datamängden registerenhet ingår inte den öppna data versionen av Stadskartan."},{"@language":"uk-t-sv-t0-mtec","@value":"Карта міста - це оглядова карта, адаптована для діапазону масштабів від 1:4 000 до 1:8 000. Тепла та ніжна колірна гамма у поєднанні з детальним вмістом робить карту міста легкою для читання та придатною для використання як у друкованій, так і в веб-адаптованій версії. Узагальнений зміст карти міста означає, що карта є чіткою навіть тоді, коли мають бути відображені більші географічні райони, і, таким чином, вона може бути використана як фонова карта, коли має бути уточнена інформація про конкретну діяльність. Він також використовується як власна інформаційна карта. Контент включає, наприклад, адміністративні межі, блоки, об'єкти нерухомості, всі будівлі, вулиці, номери адрес, природні зони, 2-метрові криві висот і мережі колій. Діючі послуги WMS: додатки, що реалізують рекомендацію клієнта WMS Tiling, рекомендується використовувати доданий сервіс WMS.Набір даних реєстру не включає версію відкритих даних карти міста."}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"33d41dcd-fcf4-4e5e-9a43-616b5e9fee58","dct:issued":{"@type":"xsd:date","@value":"2026-02-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:3f0f200ab0823059c80d1a26438ac7fcaa93f7a24926550f4aa8f3f77c6e29a3_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK карта на града (1:4000 - 1:8000)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Mapa města (1:4000 - 1:8000)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Bykort (1:4000 - 1:8000)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stadtplan (1:4000 - 1:8000)"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης της πόλης (1:4000 - 1:8000)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK City map (1:4000 - 1:8000)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa de la ciudad (1:4000 - 1:8000)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK linna kaart (1:4000 - 1:8000)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Kaupungin kartta (1:4000 - 1:8000)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de la ville (1:4000 - 1:8000)"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Chathair SBK (1:4000 - 1:8000)"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada SBK (1:4000 - 1:8000)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Várostérkép (1:4000 - 1:8000)"},{"@language":"it-t-sv-t0-mtec","@valu