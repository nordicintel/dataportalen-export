concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/881","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=881&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Road Data - View Service - NetInfo"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-11-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En WMS-tjänst (visningstjänst) som innehåller nätanknutna nationella (NVDB) och statliga vägdata. Tjänsten används bl.a. av webbapplikationen Sveriges vägar på karta/NVDB på webb. NetInfo visar företeelser på alla typer av vägnät. För att se ingående lager hänvisar vi till tjänstebeskrivningen för NetInfo, vilken innehåller en komplett lista för respektive tjänst. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för vägdata - NetInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"1ef16f56-348f-471d-8469-d5b212e9f690","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b23n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/963","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://vtf.trafikverket.se/SeTrafikinformation"},"dcat:keyword":[{"@language":"en","@value":"map service"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=963&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En applikation där det finns information om fordonsflödet på statliga vägnätet. Här presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation.\nObservera att det finns två flikar i kartan, flik TFK och flik TIKK."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b24n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Vägtrafikflödeskartan (TIKK/TFK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"80e6bb4f-9d2e-416b-ad22-c57942520795","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b25n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b26n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b27n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe_b28n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:a3830d162214bbe29d93e377c24f47bcc9bec9b2a99e93f024d062cc20fb26fe"},{"@graph":[{"@id":"_:a3a14e696f244605b01d37eca4763968ac0a24a3e1f354cb79adc63d9f0a2313_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/9d8828c2-19ec-48bb-81c8-5496826b2695","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/9d8828c2-19ec-48bb-81c8-5496826b2695#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=00535831-5e41-4aab-a765-0a79f6c8e694"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":{"@language":"sv","@value":"Övriga anläggningar består av följande objekt- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Övrig anläggning: 10, Ospec. Anläggning."},"dct:identifier":"9d8828c2-19ec-48bb-81c8-5496826b2695","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:a3a14e696f244605b01d37eca4763968ac0a24a3e1f354cb79adc63d9f0a2313_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta - Övriga anläggningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/9d8828c2-19ec-48bb-81c8-5496826b2695#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Baskarta (1:400  - 1:2000)."},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:a3a14e696f244605b01d37eca4763968ac0a24a3e1f354cb79adc63d9f0a2313"},{"@graph":[{"@id":"_:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"115ae1307d76cabe549171819cf41b4659"},{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-42~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:keyword":[{"@language":"sv","@value":"DRG"},{"@language":"sv","@value":"kostnad per patient"},{"@language":"sv","@value":"psykiatri"},{"@language":"sv","@value":"slutenvård"},{"@language":"sv","@value":"vårdhändelse"},{"@language":"sv","@value":"vårdtillfälle"},{"@language":"sv","@value":"öppenvård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи и други статистически данни за специализирани психиатрични амбулаторни и болнични грижи за единадесетте региона, докладващи психиатрията в базата данни KPP на SKR. 3-годишни данни, обобщени за DRG/MDC или диагностична категория.\n\nРезултатите не се съобщават от болницата или региона в отворени данни. Всеки, който работи в някой от участващите региони, може да получи идентификационни данни за вход и достъп до повече данни."},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady a další statistiky na specializovanou psychiatrickou ambulantní a lůžkovou péči pro jedenáct regionů, které hlásí psychiatrii do databáze SKR KPP. 3leté údaje agregované o DRG/MDC nebo diagnostické kategorii.\n\nVýsledky nejsou hlášeny nemocnicí nebo regionem v otevřených datech. Každý, kdo pracuje v některém ze zúčastněných regionů, může získat přihlašovací údaje a přístup k dalším údajům."},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger og anden statistik for specialiseret psykiatrisk ambulant og indlagt behandling for de elleve regioner, der indberetter psykiatri til SKR's KPP-database. 3-årige data aggregeret på DRG/MDC eller diagnostisk kategori.\n\nResultaterne indberettes ikke af hospital eller region i åbne data. Alle, der arbejder i en af de deltagende regioner, kan få loginoplysninger og adgang til flere data."},{"@language":"de-t-sv-t0-mtec","@value":"Kosten und andere Statistiken für die spezialisierte psychiatrische ambulante und stationäre Versorgung für die elf Regionen, die die Psychiatrie an die KPP-Datenbank des SKR melden. 3-Jahres-Daten aggregiert auf DRG / MDC oder Diagnosekategorie.\n\nDie Ergebnisse werden nicht von Krankenhäusern oder Regionen in offenen Daten gemeldet. Jeder, der in einer der teilnehmenden Regionen arbeitet, kann Anmeldeinformationen und Zugriff auf weitere Daten erhalten."},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος και άλλα στατιστικά στοιχεία για εξειδικευμένη ψυχιατρική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη για τις έντεκα περιφέρειες που αναφέρουν ψυχιατρική στη βάση δεδομένων KPP της SKR. Τριετή συγκεντρωτικά δεδομένα για την DRG/MDC ή τη διαγνωστική κατηγορία.\n\nΤα αποτελέσματα δεν αναφέρονται από το νοσοκομείο ή την περιοχή στα ανοικτά δεδομένα. Οποιοσδήποτε εργάζεται σε οποιαδήποτε από τις συμμετέχουσες περιφέρειες μπορεί να λάβει διαπιστευτήρια σύνδεσης και πρόσβαση σε περισσότερα δεδομένα."},{"@language":"en-t-sv-t0-mtec","@value":"Costs and other statistics for specialised psychiatric outpatient and inpatient care for the eleven regions reporting psychiatry to SKR's KPP database. 3-year data aggregated on DRG/MDC or diagnostic category.\n\nThe results are not reported by hospital or region in open data. Anyone working in any of the participating regions can get login credentials and access to more data."},{"@language":"es-t-sv-t0-mtec","@value":"Costos y otras estadísticas para la atención psiquiátrica especializada ambulatoria y hospitalaria para las once regiones que informan de psiquiatría a la base de datos KPP de SKR. Datos a 3 años agregados en DRG/MDC o categoría diagnóstica.\n\nLos resultados no son reportados por hospital o región en datos abiertos. Cualquier persona que trabaje en cualquiera de las regiones participantes puede obtener credenciales de inicio de sesión y acceso a más datos."},{"@language":"et-t-sv-t0-mtec","@value":"Psühhiaatrilise ambulatoorse ja statsionaarse eriravi kulud ja muu statistika üheteistkümnes piirkonnas, mis teatavad psühhiaatriast SKRi KPP andmebaasis. kolme aasta koondandmed DRG/MDC või diagnostilise kategooria kohta.\n\nAvatud andmetes ei esitata tulemusi haiglate ega piirkondade kaupa. Igaüks, kes töötab mis tahes osalevas piirkonnas, saab sisselogimisandmed ja juurdepääsu rohkematele andmetele."},{"@language":"fi-t-sv-t0-mtec","@value":"Psykiatrisen avo- ja laitoshoidon kustannukset ja muut tilastot niillä 11 alueella, jotka raportoivat psykiatriasta SKR:n KPP-tietokantaan. DRG/MDC:stä tai diagnostisesta luokasta kootut kolmen vuoden tiedot.\n\nAvoimissa tiedoissa tuloksia ei raportoida sairaala- tai aluekohtaisesti. Kuka tahansa, joka työskentelee millä tahansa osallistuvalla alueella, voi saada kirjautumistiedot ja pääsyn muihin tietoihin."},{"@language":"fr-t-sv-t0-mtec","@value":"Coûts et autres statistiques pour les soins psychiatriques ambulatoires et hospitaliers spécialisés pour les onze régions déclarant la psychiatrie à la base de données KPP de SKR. Données triennales agrégées sur DRG/MDC ou catégorie diagnostique.\n\nLes résultats ne sont pas rapportés par l'hôpital ou la région dans les données ouvertes. Toute personne travaillant dans l'une des régions participantes peut obtenir des identifiants de connexion et accéder à plus de données."},{"@language":"ga-t-sv-t0-mtec","@value":"Costais agus staitisticí eile maidir le sainchúram síciatrach othar seachtrach agus othar cónaitheach don aon réigiún déag a thuairiscíonn síciatracht do bhunachar sonraí KPP SKR. Sonraí 3 bliana comhiomlánaithe maidir le DRG/MDC nó catagóir dhiagnóiseach.\n\nNí thuairiscíonn an t-ospidéal ná an réigiún na torthaí i sonraí oscailte. Is féidir le duine ar bith atá ag obair in aon cheann de na réigiúin rannpháirteacha dintiúir logála isteach agus rochtain a fháil ar níos mó sonraí."},{"@language":"hr-t-sv-t0-mtec","@value":"Troškovi i druge statistike za specijaliziranu psihijatrijsku ambulantnu i bolničku skrb za jedanaest regija koje prijavljuju psihijatriju u SKR-ovu bazu podataka KPP. Trogodišnji agregirani podaci o DRG-u/MDC-u ili dijagnostičkoj kategoriji.\n\nRezultati nisu prijavljeni po bolnicama ili regijama u otvorenim podacima. Svatko tko radi u bilo kojoj od regija sudionica može dobiti vjerodajnice za prijavu i pristup većem broju podataka."},{"@language":"hu-t-sv-t0-mtec","@value":"A speciális pszichiátriai járóbeteg- és fekvőbeteg-ellátás költségei és egyéb statisztikái a pszichiátriát az SKR KPP adatbázisába jelentő tizenegy régióban. DRG/MDC vagy diagnosztikai kategória alapján összesített hároméves adatok.\n\nAz eredményeket a nyílt hozzáférésű adatokban sem a kórházak, sem a régiók nem jelentik. Bárki, aki a részt vevő régiók bármelyikében dolgozik, bejelentkezési hitelesítő adatokat kaphat, és több adathoz férhet hozzá."},{"@language":"it-t-sv-t0-mtec","@value":"Costi e altre statistiche per l'assistenza psichiatrica specialistica ambulatoriale e ospedaliera per le undici regioni che segnalano la psichiatria alla banca dati KPP di SKR. Dati triennali aggregati su DRG/MDC o categoria diagnostica.\n\nI risultati non sono riportati dall'ospedale o dalla regione in dati aperti. Chiunque lavori in una delle regioni partecipanti può ottenere le credenziali di accesso e l'accesso a più dati."},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos ir kiti statistiniai duomenys, susiję su specializuota psichiatrine ambulatorine ir stacionarine priežiūra vienuolikoje regionų, pranešančių apie psichiatriją SKR KPP duomenų bazėje. 3 metų suvestiniai DRG/MDC arba diagnostikos kategorijos duomenys.\n\nApie rezultatus ligoninėse ar regionuose nepateikiama atvirųjų duomenų. Kiekvienas, dirbantis bet kuriame iš dalyvaujančių regionų, gali gauti prisijungimo duomenis ir prieigą prie daugiau duomenų."},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas un cita statistika par specializēto psihiatrisko ambulatoro un stacionāro aprūpi vienpadsmit reģionos, kas ziņo par psihiatriju SKR KPP datubāzē. 3 gadu dati, kas apkopoti par DRG/MDC vai diagnostikas kategoriju.\n\nRezultātus neziņo pēc slimnīcas vai reģiona atklātajos datos. Ikviens, kas strādā kādā no iesaistītajiem reģioniem, var saņemt pieteikšanās datus un piekļuvi papildu datiem."},{"@language":"mt-t-sv-t0-mtec","@value":"Spejjeż u statistika oħra għall-kura psikjatrika speċjalizzata outpatient u inpatient għall-ħdax-il reġjun li jirrapportaw il-psikjatrija fil-bażi tad-data tal-KPP ta’ SKR. Data ta’ 3 snin aggregata dwar id-DRG/MDC jew il-kategorija dijanjostika.\n\nIr-riżultati ma jiġux irrappurtati mill-isptar jew mir-reġjun f’data miftuħa. Kull min jaħdem fi kwalunkwe wieħed mir-reġjuni parteċipanti jista’ jikseb kredenzjali ta’ login u aċċess għal aktar data."},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten en andere statistieken voor gespecialiseerde psychiatrische poliklinische en intramurale zorg voor de elf regio's die psychiatrie rapporteren aan de KPP-database van SKR. Geaggregeerde gegevens over drie jaar over DRG/MDC of diagnostische categorie.\n\nDe resultaten worden niet gerapporteerd door het ziekenhuis of de regio in open data. Iedereen die in een van de deelnemende regio's werkt, kan inloggegevens en toegang tot meer gegevens krijgen."},{"@language":"pl-t-sv-t0-mtec","@value":"Koszty i inne statystyki dotyczące specjalistycznej ambulatoryjnej i szpitalnej opieki psychiatrycznej w jedenastu regionach zgłaszających psychiatrę do bazy danych KPP SKR. 3-letnie dane zagregowane dotyczące DRG/MDC lub kategorii diagnostycznej.\n\nWyniki nie są zgłaszane przez szpital lub region w otwartych danych. Każdy, kto pracuje w dowolnym z uczestniczących regionów, może uzyskać dane logowania i dostęp do większej ilości danych."},{"@language":"pt-t-sv-t0-mtec","@value":"Custos e outras estatísticas para cuidados psiquiátricos especializados em ambulatório e internamento para as onze regiões que comunicam a psiquiatria à base de dados KPP da SKR. Dados de 3 anos agregados em DRG/MDC ou categoria de diagnóstico.\n\nOs resultados não são relatados pelo hospital ou região em dados abertos. Qualquer pessoa que trabalhe em qualquer uma das regiões participantes pode obter credenciais de login e acesso a mais dados."},{"@language":"ro-t-sv-t0-mtec","@value":"Costuri și alte statistici pentru asistența psihiatrică specializată în ambulatoriu și spitalizare pentru cele unsprezece regiuni care raportează psihiatria către baza de date KPP a SKR. date pe 3 ani agregate privind DRG/MDC sau categoria de diagnostic.\n\nRezultatele nu sunt raportate de spital sau regiune în date deschise. Oricine lucrează în oricare dintre regiunile participante poate obține acreditări de conectare și acces la mai multe date."},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady a iné štatistiky pre špecializovanú psychiatrickú ambulantnú a ústavnú starostlivosť pre jedenásť regiónov, ktoré hlásia psychiatriu do databázy KPP SKR. 3-ročné súhrnné údaje o DRG/MDC alebo diagnostickej kategórii.\n\nVýsledky nie sú hlásené nemocnicou alebo regiónom v otvorených dátach. Ktokoľvek, kto pracuje v ktorejkoľvek zo zúčastnených oblastí, môže získať prihlasovacie údaje a prístup k ďalším údajom."},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški in drugi statistični podatki za specializirano psihiatrično ambulantno in bolnišnično oskrbo za enajst regij, ki poročajo o psihiatriji v podatkovni zbirki KPP SKR. triletni podatki, združeni za DRG/MDC ali diagnostično kategorijo.\n\nBolnišnica ali regija ne poroča o rezultatih v odprtih podatkih. Vsi, ki delajo v kateri koli od sodelujočih regij, lahko dobijo poverilnice za prijavo in dostop do več podatkov."},{"@language":"sv","@value":"Kostnader och annan statistik för specialiserad psykiatrisk öppen- och slutenvård för de elva regioner som rapporterar psykiatri till SKR:s KPP-databas. Treårsdata aggregerat på DRG/MDC eller diagnoskategori.\n\nResultaten redovisas inte uppdelat på sjukhus eller region i öppna data. Den som arbetar i någon av de regioner som deltar kan få inloggningsuppgifter och tillgång till mer data."},{"@language":"uk-t-sv-t0-mtec","@value":"Витрати та інша статистика спеціалізованої психіатричної амбулаторної та стаціонарної допомоги для одинадцяти регіонів, які повідомляють про психіатрію, до бази даних KPP SKR. 3-річні дані, агреговані за DRG/MDC або діагностичною категорією.\n\nРезультати не повідомляються лікарнею або регіоном у відкритих даних. Будь-хто, хто працює в будь-якому з регіонів-учасниць, може отримати облікові дані для входу та доступ до більшої кількості даних."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) — специализирани психиатрични амбулаторни и стационарни грижи"},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) - specializovaná psychiatrická ambulantní a lůžková péče"},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) – specialiseret psykiatrisk ambulant behandling og indlæggelse"},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) - spezialisierte psychiatrische ambulante und stationäre Versorgung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) - εξειδικευμένη ψυχιατρική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη"},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) - specialised psychiatric outpatient and inpatient care"},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP): atención psiquiátrica especializada ambulatoria y hospitalaria"},{"@language":"et-t-sv-t0-mtec","@value":"Kulu patsiendi kohta (KPP) – spetsiaalne psühhiaatriline ambulatoorne ja statsionaarne ravi"},{"@language":"fi-t-sv-t0-mtec","@value":"Kustannukset potilasta kohti - erikoistunut psykiatrinen avo- ja laitoshoito"},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) - soins psychiatriques ambulatoires et hospitaliers spécialisés"},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) - sainchúram síciatrach othar seachtrach agus othar cónaitheach"},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) – specijalizirana psihijatrijska ambulantna i bolnička skrb"},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) – speciális pszichiátriai járóbeteg- és fekvőbeteg-ellátás"},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) - cure psichiatriche specialistiche ambulatoriali e ospedaliere"},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos vienam pacientui (KPP) – specializuota psichiatrinė ambulatorinė ir stacionarinė priežiūra"},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz pacientu (KPP) – specializēta psihiatriskā ambulatorā un stacionārā aprūpe"},{"@language":"mt-t-sv-t0-mtec","@value":"Kost għal kull pazjent (KPP) - kura psikjatrika speċjalizzata outpatient u inpatient"},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) - gespecialiseerde psychiatrische poliklinische en intramurale zorg"},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) – specjalistyczna ambulatoryjna i szpitalna opieka psychiatryczna"},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) - cuidados psiquiátricos especializados em ambulatório e internamento"},{"@language":"ro-t-sv-t0-mtec","@value":"Cost per pacient (KPP) - asistență psihiatrică specializată ambulatorie și spitalizare"},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) – špecializovaná psychiatrická ambulantná a ústavná starostlivosť"},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) – specializirana psihiatrična ambulantna in bolnišnična oskrba"},{"@language":"sv","@value":"Kostnad per patient (KPP) - specialiserad psykiatrisk öppen- och slutenvård"},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість за пацієнта (KPP) - спеціалізована психіатрична амбулаторна та стаціонарна допомога"}]},{"@id":"http://data.europa.eu/88u/record/https-catalog-skl-se-store-1-resource-42~~1","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://catalog.skl.se/store/1/resource/42","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:08Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:50Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-42~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-catalog-skl-se-store-1-resource-42~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-23T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:50Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]}],"@id":"urn:source:a5548d80c95fd86752613e449fb4b9455cef3124492b4e6cda119441b5a1d91d"},{"@graph":[{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n0"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n1"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n10"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n6"}},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n4"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n5"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n0"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n1"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n10"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n4"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n5"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n7"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n8"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n9"}]},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n7"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n8"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b10n9"},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:a588199ad3122529e7c1cf37dd382f7660c4878b50b9a93995141caf1dda75b7_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.