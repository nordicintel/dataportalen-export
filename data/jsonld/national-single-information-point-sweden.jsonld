tec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/fc04602e-151d-41df-9fa2-da92f2ef51be"}},{"@id":"http://data.europa.eu/88u/record/c2c5f260-2da1-45ff-98ce-29b621e09242","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/3821d4a0-868b-4223-8b7b-24fd60b5f22e"},{"@id":"http://data.europa.eu/88u/distribution/723be1cc-2f2c-4278-8649-038280b865b5"},{"@id":"http://data.europa.eu/88u/distribution/fc04602e-151d-41df-9fa2-da92f2ef51be"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"c2c5f260-2da1-45ff-98ce-29b621e09242","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:22Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/c2c5f260-2da1-45ff-98ce-29b621e09242"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:5d3f8f97b9275762e210809ab8e0c92be30da1db8fa616d6c5be9ac4ef423ef9_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/c2c5f260-2da1-45ff-98ce-29b621e09242"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:22Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"c2c5f260-2da1-45ff-98ce-29b621e09242","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/c2c5f260-2da1-45ff-98ce-29b621e09242"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5d3f8f97b9275762e210809ab8e0c92be30da1db8fa616d6c5be9ac4ef423ef9"},{"@graph":[{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2009-04-12"},"dcat:startDate":{"@type":"xsd:date","@value":"2009-04-11"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2009-04-12"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2009-04-11"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=1e946ed6-9ca0-4916-8592-aa23aab96bca"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2009-04-12"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 900 mUpplösning: 8 cm/pixelOrtofotot är inte så bra eftersom det inte har tillräckligt bra övertäckning, vilket resulterar i många lutande hus. Fotograferingsdatum: 11-12 april 2009."},"dct:identifier":"a83503d8-bafc-4ce7-8026-1335da28c559","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b0n0"},"dct:temporal":{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2009)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2009"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2009"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2009"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2009"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb"},{"@graph":[{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2018-05-12"},"dcat:startDate":{"@type":"xsd:date","@value":"2018-04-12"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2018-05-12"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2018-04-12"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=64bab5c1-b720-4935-bf07-57bbffb98fea"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2018-05-12"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1830 - 1890m. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 5 maj 2018. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","dct:issued":{"@type":"xsd:date","@value":"2019-02-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b0n0"},"dct:temporal":{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2018)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2018?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2018"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2018?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2018"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a"},{"@graph":[{"@id":"_:5e5570d0af1bdbd6355e3a8f7ade35b21303d79ec114e3d2e6234fff1b85227b_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"f3712d7fddc8567bf91b086c1c143a978"},{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-39~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.skl.se/store/1/resource/46"},"dcat:keyword":[{"@language":"sv","@value":"DRG"},{"@language":"sv","@value":"kostnad per patient"},{"@language":"sv","@value":"slutenvård"},{"@language":"sv","@value":"somatik"},{"@language":"sv","@value":"vårdhändelse"},{"@language":"sv","@value":"vårdtillfälle"},{"@language":"sv","@value":"öppenvård"}],"dcat:landingPage":{"@id":"https://skr.se/skr/halsasjukvard/ekonomiavgifter/kostnadperpatientkpp.1076.html"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) в специализирана соматична амбулаторна и болнична помощ. 3-годишни данни на ниво събитие за полагане на грижи. Резултатите не се съобщават от болницата или региона в отворени данни. Всеки, който работи в някой от участващите региони, може да получи идентификационни данни за вход и достъп до повече данни. "},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) ve specializované somatické ambulantní a lůžkové péči. Údaje za 3 roky na úrovni pečovatelské akce. Výsledky nejsou hlášeny nemocnicí nebo regionem v otevřených datech. Každý, kdo pracuje v některém ze zúčastněných regionů, může získat přihlašovací údaje a přístup k dalším údajům. "},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) ved specialiseret somatisk ambulant behandling og indlæggelse. 3-års data på plejebegivenhedsniveau. Resultaterne indberettes ikke af hospital eller region i åbne data. Alle, der arbejder i en af de deltagende regioner, kan få loginoplysninger og adgang til flere data. "},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) in der spezialisierten somatischen ambulanten und stationären Versorgung. 3-Jahres-Daten auf Pflege-Ereignis-Ebene. Die Ergebnisse werden nicht von Krankenhäusern oder Regionen in offenen Daten gemeldet. Jeder, der in einer der teilnehmenden Regionen arbeitet, kann Anmeldeinformationen und Zugriff auf weitere Daten erhalten. "},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) στην εξειδικευμένη σωματική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη. Τριετή δεδομένα σε επίπεδο εκδήλωσης φροντίδας. Τα αποτελέσματα δεν αναφέρονται από το νοσοκομείο ή την περιοχή στα ανοικτά δεδομένα. Οποιοσδήποτε εργάζεται σε οποιαδήποτε από τις συμμετέχουσες περιφέρειες μπορεί να λάβει διαπιστευτήρια σύνδεσης και πρόσβαση σε περισσότερα δεδομένα. "},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) in specialised somatic outpatient and inpatient care. 3-year data at care event level. The results are not reported by hospital or region in open data. Anyone working in any of the participating regions can get login credentials and access to more data. "},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP) en atención somática especializada ambulatoria y hospitalaria. Datos de 3 años a nivel de evento de atención. Los resultados no son reportados por hospital o región en datos abiertos. Cualquier persona que trabaje en cualquiera de las regiones participantes puede obtener credenciales de inicio de sesión y acceso a más datos. "},{"@language":"et-t-sv-t0-mtec","@value":"Somaatilise ambulatoorse ja statsionaarse eriravi kulud patsiendi kohta. 3-aastased andmed hooldussündmuse tasandil. Avatud andmetes ei esitata tulemusi haiglate ega piirkondade kaupa. Igaüks, kes töötab mis tahes osalevas piirkonnas, saab sisselogimisandmed ja juurdepääsu rohkematele andmetele. "},{"@language":"fi-t-sv-t0-mtec","@value":"Somaattisen avo- ja laitoshoidon kustannukset potilasta kohti. 3 vuoden tiedot hoitotapahtumatasolla. Avoimissa tiedoissa tuloksia ei raportoida sairaala- tai aluekohtaisesti. Kuka tahansa, joka työskentelee millä tahansa osallistuvalla alueella, voi saada kirjautumistiedot ja pääsyn muihin tietoihin. "},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) dans les soins somatiques ambulatoires et hospitaliers spécialisés. Données sur 3 ans au niveau de l'événement de soins. Les résultats ne sont pas rapportés par l'hôpital ou la région dans les données ouvertes. Toute personne travaillant dans l'une des régions participantes peut obtenir des identifiants de connexion et accéder à plus de données. "},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) i sainchúram othar seachtrach sómach agus othar cónaitheach. Sonraí 3 bliana ar leibhéal an imeachta cúraim. Ní thuairiscíonn an t-ospidéal ná an réigiún na torthaí i sonraí oscailte. Is féidir le duine ar bith atá ag obair in aon cheann de na réigiúin rannpháirteacha dintiúir logála isteach agus rochtain a fháil ar níos mó sonraí. "},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) u specijaliziranoj somatskoj ambulantnoj i bolničkoj skrbi. Trogodišnji podaci na razini događaja povezanih sa skrbi. Rezultati nisu prijavljeni po bolnicama ili regijama u otvorenim podacima. Svatko tko radi u bilo kojoj od regija sudionica može dobiti vjerodajnice za prijavu i pristup većem broju podataka. "},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) a speciális szomatikus járóbeteg- és fekvőbeteg-ellátásban. 3 éves adatok az ápolási esemény szintjén. Az eredményeket a nyílt hozzáférésű adatokban sem a kórházak, sem a régiók nem jelentik. Bárki, aki a részt vevő régiók bármelyikében dolgozik, bejelentkezési hitelesítő adatokat kaphat, és több adathoz férhet hozzá. "},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) nell'assistenza somatica specialistica ambulatoriale e ospedaliera. Dati triennali a livello di evento assistenziale. I risultati non sono riportati dall'ospedale o dalla regione in dati aperti. Chiunque lavori in una delle regioni partecipanti può ottenere le credenziali di accesso e l'accesso a più dati. "},{"@language":"lt-t-sv-t0-mtec","@value":"Specializuotos somatinės ambulatorinės ir stacionarinės priežiūros išlaidos vienam pacientui (KPP). 3 metų duomenys priežiūros įvykio lygmeniu. Apie rezultatus ligoninėse ar regionuose nepateikiama atvirųjų duomenų. Kiekvienas, dirbantis bet kuriame iš dalyvaujančių regionų, gali gauti prisijungimo duomenis ir prieigą prie daugiau duomenų. "},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz vienu pacientu specializētajā somatiskajā ambulatorajā un stacionārajā aprūpē. 3 gadu dati aprūpes pasākumu līmenī. Rezultātus neziņo pēc slimnīcas vai reģiona atklātajos datos. Ikviens, kas strādā kādā no iesaistītajiem reģioniem, var saņemt pieteikšanās datus un piekļuvi papildu datiem. "},{"@language":"mt-t-sv-t0-mtec","@value":"Spiża għal kull pazjent (KPP) f’kura speċjalizzata somatika outpatient u inpatient. Data ta’ 3 snin fil-livell ta’ avveniment ta’ kura. Ir-riżultati ma jiġux irrappurtati mill-isptar jew mir-reġjun f’data miftuħa. Kull min jaħdem fi kwalunkwe wieħed mir-reġjuni parteċipanti jista’ jikseb kredenzjali ta’ login u aċċess għal aktar data. "},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) in gespecialiseerde somatische poliklinische en intramurale zorg. Gegevens over 3 jaar op het niveau van zorgevenementen. De resultaten worden niet gerapporteerd door het ziekenhuis of de regio in open data. Iedereen die in een van de deelnemende regio's werkt, kan inloggegevens en toegang tot meer gegevens krijgen. "},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) w specjalistycznej ambulatoryjnej i szpitalnej opiece somatycznej. 3-letnie dane na poziomie wydarzenia związanego z opieką. Wyniki nie są zgłaszane przez szpital lub region w otwartych danych. Każdy, kto pracuje w dowolnym z uczestniczących regionów, może uzyskać dane logowania i dostęp do większej ilości danych. "},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) em cuidados ambulatórios somáticos especializados e em regime de internamento. Dados de 3 anos a nível do evento de prestação de cuidados. Os resultados não são relatados pelo hospital ou região em dados abertos. Qualquer pessoa que trabalhe em qualquer uma das regiões participantes pode obter credenciais de login e acesso a mais dados. "},{"@language":"ro-t-sv-t0-mtec","@value":"Costul per pacient (KPP) în asistența medicală somatică ambulatorie și spitalicească specializată. Date pe 3 ani la nivel de eveniment de îngrijire. Rezultatele nu sunt raportate de spital sau regiune în date deschise. Oricine lucrează în oricare dintre regiunile participante poate obține acreditări de conectare și acces la mai multe date. "},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) v špecializovanej somatickej ambulantnej a ústavnej starostlivosti. 3-ročné údaje na úrovni udalosti týkajúcej sa starostlivosti. Výsledky nie sú hlásené nemocnicou alebo regiónom v otvorených dátach. Ktokoľvek, kto pracuje v ktorejkoľvek zo zúčastnených oblastí, môže získať prihlasovacie údaje a prístup k ďalším údajom. "},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) v specializirani somatski ambulantni in bolnišnični oskrbi. 3-letni podatki na ravni dogodka oskrbe. Bolnišnica ali regija ne poroča o rezultatih v odprtih podatkih. Vsi, ki delajo v kateri koli od sodelujočih regij, lahko dobijo poverilnice za prijavo in dostop do več podatkov. "},{"@language":"sv","@value":"Kostnad per patient (KPP) inom specialiserad somatisk öppen- och slutenvård. Treårsdata på vårdhändelsenivå. Resultaten redovisas inte uppdelat på sjukhus eller region i öppna data. Den som arbetar i någon av de regioner som deltar kan få inloggningsuppgifter och tillgång till mer data. "},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість на одного пацієнта (KPP) у спеціалізованій соматичній амбулаторній та стаціонарній допомозі. 3-річні дані на рівні подій догляду. Результати не повідомляються лікарнею або регіоном у відкритих даних. Будь-хто, хто працює в будь-якому з регіонів-учасниць, може отримати облікові дані для входу та доступ до більшої кількості даних. "}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/2220000315"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Разходи за пациент (KPP) — специализирани соматични амбулаторни и болнични грижи"},{"@language":"cs-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) - specializovaná somatická ambulantní a lůžková péče"},{"@language":"da-t-sv-t0-mtec","@value":"Omkostninger pr. patient (KPP) – specialiseret somatisk ambulant behandling og indlæggelse"},{"@language":"de-t-sv-t0-mtec","@value":"Kosten pro Patient (KPP) - spezialisierte somatische ambulante und stationäre Versorgung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόστος ανά ασθενή (KPP) - εξειδικευμένη σωματική εξωνοσοκομειακή και ενδονοσοκομειακή περίθαλψη"},{"@language":"en-t-sv-t0-mtec","@value":"Cost per patient (KPP) - specialised somatic outpatient and inpatient care"},{"@language":"es-t-sv-t0-mtec","@value":"Coste por paciente (KPP): atención somática especializada ambulatoria y hospitalaria"},{"@language":"et-t-sv-t0-mtec","@value":"Kulu patsiendi kohta (KPP) – spetsiaalne somaatiline ambulatoorne ja statsionaarne ravi"},{"@language":"fi-t-sv-t0-mtec","@value":"Kustannukset potilasta kohti - erikoistunut somaattinen avo- ja laitoshoito"},{"@language":"fr-t-sv-t0-mtec","@value":"Coût par patient (KPP) - soins somatiques ambulatoires et hospitaliers spécialisés"},{"@language":"ga-t-sv-t0-mtec","@value":"Costas in aghaidh an othair (KPP) - sainchúram othar seachtrach sómach agus othar cónaitheach"},{"@language":"hr-t-sv-t0-mtec","@value":"Trošak po pacijentu (KPP) – specijalizirana somatska ambulantna i bolnička skrb"},{"@language":"hu-t-sv-t0-mtec","@value":"Betegenkénti költség (KPP) - speciális szomatikus járóbeteg- és fekvőbeteg-ellátás"},{"@language":"it-t-sv-t0-mtec","@value":"Costo per paziente (KPP) - assistenza somatica specialistica ambulatoriale e ospedaliera"},{"@language":"lt-t-sv-t0-mtec","@value":"Išlaidos vienam pacientui (KPP) – specializuota somatinė ambulatorinė ir stacionarinė priežiūra"},{"@language":"lv-t-sv-t0-mtec","@value":"Izmaksas uz pacientu (KPP) – specializētā somatiskā ambulatorā un stacionārā aprūpe"},{"@language":"mt-t-sv-t0-mtec","@value":"Kost għal kull pazjent (KPP) - kura speċjalizzata somatika outpatient u inpatient"},{"@language":"nl-t-sv-t0-mtec","@value":"Kosten per patiënt (KPP) - gespecialiseerde somatische poliklinische en intramurale zorg"},{"@language":"pl-t-sv-t0-mtec","@value":"Koszt na pacjenta (KPP) - specjalistyczna somatyczna opieka ambulatoryjna i szpitalna"},{"@language":"pt-t-sv-t0-mtec","@value":"Custo por doente (KPP) - cuidados somáticos especializados em ambulatório e em regime de internamento"},{"@language":"ro-t-sv-t0-mtec","@value":"Cost per pacient (KPP) - asistență somatică specializată ambulatorie și spitalizare"},{"@language":"sk-t-sv-t0-mtec","@value":"Náklady na pacienta (KPP) – špecializovaná somatická ambulantná a ústavná starostlivosť"},{"@language":"sl-t-sv-t0-mtec","@value":"Stroški na pacienta (KPP) – specializirana somatska ambulantna in bolnišnična oskrba"},{"@language":"sv","@value":"Kostnad per patient (KPP) - specialiserad somatisk öppen- och slutenvård"},{"@language":"uk-t-sv-t0-mtec","@value":"Вартість на одного пацієнта (KPP) - спеціалізована соматична амбулаторна та стаціонарна допомога"}]},{"@id":"http://data.europa.eu/88u/record/https-catalog-skl-se-store-1-resource-39~~1","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://catalog.skl.se/store/1/resource/39","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:08Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:49Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-catalog-skl-se-store-1-resource-39~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:5e5570d0af1bdbd6355e3a8f7ade35b21303d79ec114e3d2e6234fff1b85227b_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-catalog-skl-se-store-1-resource-39~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-23T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-07T17:18:49Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/2220000315","@type":"foaf:Agent","dct:identifier":"2220000315","dct:type":{"@id":"http://purl.org/adms/publishertype/NonProfitOrganisation"},"foaf:homepage":{"@id":"https://skr.se/"},"foaf:mbox":{"@id":"mailto:info@skr.se"},"foaf:name":{"@language":"sv","@value":"Sveriges Kommuner och Regioner (SKR)"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.lomma.se/store/1/resource/179"},{"@id":"https://catalog.skl.se/store/1/resource/1"}]}],"@id":"urn:source:5e5570d0af1bdbd6355e3a8f7ade35b21303d79ec114e3d2e6234fff1b85227b"},{"@graph":[{"@id":"_:5ea0fe2e1a6a0e7554e5b52b9d90997b6679a86ff99cb6cea1e166a619282ab8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5ea0fe2e1a6a0e7554e5b52b9d90997b6679a86ff99cb6cea1e166a619282ab8_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16faa71dd110a99def0fde87d88d99eef9"},{"@id":"http://data.europa.eu/88u/dataset/7e8fa6d6-5a1e-48db-b7b7-44a3a5d44b9f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/75bac501-dcbd-4992-8ee3-df133fcbc2dd"},{"@id":"http://data.europa.eu/88u/distribution/9d41f20d-6162-407c-8ab9-bbcc34f65403"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=719b8823-a3f2-41a1-9b32-0259e60afda7"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта на града - Районите на областните съвети (районите) се състоят от следните подтипове (подтипове) по информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Карта на града) :450170, Район на областния съвет Подтипове10, Район на областния съвет, модифициран, активен"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa města - Oblasti okresních zastupitelstev (oblasti okresních zastupitelstev) se skládaly z následujících podtypů (subtypů) v informační klasifikaci 2020 (aktuální seznam viz Obecná specifikace produktu Mapa města) :450170, Oblast okresních zastupitelstev Podtypy10, Oblast okresních zastupitelstev, upravitelná, aktivní"},{"@language":"da-t-sv-t0-mtec","@value":"Bykort — Distriktsrådsområder (distriktsområder) bestod af følgende undertyper (undertyper) i informationsklassificeringen for 2020 (for den nuværende liste henvises til den generelle varespecifikation Bykort):450170, Distriktsrådsområde Undertype10, Distriktsrådsområde, modificerbart, aktivt"},{"@language":"de-t-sv-t0-mtec","@value":"Stadtplan - Bezirksgebiete (Bezirksgebiete) bestanden bei der Informationsklassifizierung 2020 aus folgenden Untertypen (Untertypen) (für die aktuelle Liste siehe Allgemeine Produktspezifikation Stadtplan) :450170, Bezirksgebiet Subtypen10, Bezirksgebiet, veränderbar, aktiv"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης πόλεων - Περιοχές επαρχιακών συμβουλίων (περιοχές επαρχιακών συμβουλίων) που αποτελούνται από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης πόλεων): 450170, περιοχή επαρχιακών συμβουλίων Υποτύποι10, περιοχή επαρχιακών συμβουλίων, τροποποιήσιμη, ενεργός"},{"@language":"en-t-sv-t0-mtec","@value":"City map - District council areas (district areas) consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification City map) :450170, District council area Subtypes10, District council area, modifiable, active"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de la ciudad - Las áreas del consejo de distrito (áreas de distrito) consistieron en los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual, véase la especificación general del producto Mapa de la ciudad): 450170, Área del consejo de distrito Subtipos10, Área del consejo de distrito, modificable, activa"},{"@language":"et-t-sv-t0-mtec","@value":"Linnakaart - Piirkonnavolikogu alad (piirkonnapiirkonnad) koosnesid 2020. aasta teabeklassifikatsiooni järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldine tootespetsifikaat Linnakaart):450170, Piirkonnavolikogu alatüübid10, Piirkonnavolikogu ala, muudetav, aktiivne"},{"@language":"fi-t-sv-t0-mtec","@value":"Kaupungin kartta - Piirikunnan alue (piirikunta-alueet) koostui seuraavista alatyypeistä (alatyypit) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleistä tuote-eritelmää Kaupungin kartta) :450170, Piirikunnan alue Alatyypit10, Piirikunnan alue, muokattavissa, aktiivinen"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte de la ville - Zones du conseil de district (zones du district) composées des sous-types suivants (sous-types) à la classification d'information 2020 (pour la liste actuelle, voir le cahier des charges général du produit Carte de la ville) :450170, Zone du conseil de district Sous-types10, Zone du conseil de district, modifiable, actif"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil na cathrach - Is éard a bhí i limistéir na comhairle ceantair (limistéir cheantair) na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach Sonraíocht táirge Ginearálta Léarscáil na cathrach) :450170, Limistéar na comhairle ceantair Fochineálacha10, Limistéar na comhairle ceantair, inmhodhnaithe, gníomhach"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta grada - Područja okružnog vijeća (područja okruga) sastojala su se od sljedećih podtipova (podtipova) u informacijskoj klasifikaciji 2020 (za trenutni popis vidjeti Opće specifikacije proizvoda Karta grada) :450170, Podtipovi područja okružnog vijeća10, Područje okružnog vijeća, promjenjivo, aktivno"},{"@language":"hu-t-sv-t0-mtec","@value":"Várostérkép - A kerületi önkormányzati területek (körzeti területek) a következő altípusokból (altípusokból) álltak a 2020. évi információs osztályozásban (az aktuális listát lásd az általános termékleírásban Várostérkép) :450170, kerületi önkormányzati terület 10. altípus, kerületi önkormányzati terület, módosítható, aktív"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa della città - Le aree del consiglio distrettuale (aree distrettuali) erano costituite dai seguenti sottotipi (sottotipi) nella classificazione delle informazioni 2020 (per l'elenco attuale vedere il disciplinare generale Mappa della città) :450170, Sottotipi dell'area del consiglio distrettuale10, Area del consiglio distrettuale, modificabile, attiva"},{"@language":"lt-t-sv-t0-mtec","@value":"Miesto žemėlapis. Rajonų tarybos teritorijos (rajonų teritorijos) pagal 2020 m. informacijos klasifikaciją (dabartinį sąrašą žr. „Bendroji produkto specifikacija. Miesto žemėlapis“) buvo sudarytos iš šių potipių (potipių):450170, Rajonų tarybos teritorijos 10 potipiai, Rajonų tarybos teritorija, modifikuojama, aktyvi"},{"@language":"lv-t-sv-t0-mtec","@value":"Pilsētas karte – rajona padomes apgabali (rajona apgabali) sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu skatīt vispārējā produkta specifikācijā “Pilsētas karte”): 450170, rajona padomes apgabala apakštipi10, rajona padomes apgabals, maināms, aktīvs"},{"@language":"mt-t-sv-t0-mtec","@value":"* Mappa tal-belt - Żoni tal-kunsill distrettwali (żoni distrettwali) kienu jikkonsistu mis-sottotipi li ġejjin (sottotipi) fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-Ispeċifikazzjoni ġenerali tal-prodott Mappa tal-belt): 450170, Żona tal-kunsill distrettwali Sottotipi10, Żona tal-kunsill distrettwali, modifikabbli, attiva"},{"@language":"nl-t-sv-t0-mtec","@value":"Stadskaart - Districtsgebieden (districtsgebieden) bestonden uit de volgende subtypen (subtypen) bij de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Stadskaart):450170, Districtsgemeentegebied Subtypen10, Districtsgemeentegebied, aanpasbaar, actief"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa miasta - Obszary rady dystryktu (obszary dystryktu) składały się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualna lista patrz Ogólna specyfikacja produktu Mapa miasta) :450170, Obszar rady dystryktu Podtypy10, Obszar rady dystryktu, modyfikowalny, aktywny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa da cidade - As áreas dos conselhos distritais (áreas distritais) consistiam nos seguintes subtipos (subtipos) na classificação de informações de 2020 (para a lista atual, ver especificação geral do produto Mapa da cidade):450170, área dos conselhos distritais Subtipos10, área dos conselhos distritais, modificável, ativo"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta orașului - Zonele consiliului districtual (zonele districtuale) au constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor 2020 (pentru lista actuală, a se vedea caietul de sarcini general al produsului Harta orașului): 450170, zona consiliului districtual Subtipuri10, zona consiliului districtual, modificabilă, activă"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa mesta - Oblasti Okresného zastupiteľstva (okresné oblasti) pozostávali z nasledujúcich podtypov (podtypov) v informačnej klasifikácii 2020 (pre aktuálny zoznam pozri Všeobecnú špecifikáciu výrobku Mestská mapa) :450170, Oblasti Okresného zastupiteľstva Podtypy10, Oblasti Okresného zastupiteľstva, modifikovateľné, aktívne"},{"@language":"sl-t-sv-t0-mtec","@value":"Mestna karta - Območja okrožnega sveta (območja okrožij) so bila sestavljena iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Splošno specifikacijo proizvoda Mestna karta) :450170, Območje okrožnega sveta Podtipi10, Območje okrožnega sveta, spremenljivo, aktivno"},{"@language":"sv","@value":"Stadskarta - Stadsdelsnämndsområden (stadsdelsområden) bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :450170, StadsdelsnämndsområdeUndertyper10, Stadsdelsnämndsområde, modifierbar, aktiv"},{"@language":"uk-t-sv-t0-mtec","@value":"Карта міста - Районні районні ради (райони) складалися з таких підтипів (підтипів) за інформаційною класифікацією 2020 (для поточного переліку див."}],"dct:format":"text/html","dct:identifier":"7e8fa6d6-5a1e-48db-b7b7-44a3a5d44b9f","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5ea0fe2e1a6a0e7554e5b52b9d90997b6679a86ff99cb6cea1e166a619282ab8_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Карта на града - Областни управителни райони"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Mapa města - Oblasti okresní rady"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Bykort - Områder med distriktsbestyrelse"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Stadtplan - Bezirksvorstandsbereiche"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης πόλης SBK - Περιοχές Επαρχιακού Συμβουλίου"},{"@language":"en-t-sv-t0-mtec","@value":"SBK City Map - District Board Areas"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de la ciudad de SBK - Áreas de la Junta de Distrito"},{"@language":"et-t-sv-t0-mtec","@value":"SBK City kaart - Piirkondlik juhatus Piirkonnad"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK kaupungin kartta - Piirikunta-alueet"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte de la ville de SBK - District Board Areas"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil na Cathrach SBK - Ceantair an Bhoird Ceantair"},{"@lan