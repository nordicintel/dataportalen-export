-t0-mtec","@value":"Service WMS Ortofoto 2010"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2010"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2010"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2010"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2010"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2010"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2010"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2010"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS service Ortofoto 2010"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2010"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2010"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2010"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2010"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2010"},{"@language":"uk-t-sv-t0-mtec","@value":"Сервіс WMS Ortofoto 2010"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/7f3d79ae-f913-4eff-9f12-129ea8b32683"}},{"@id":"http://data.europa.eu/88u/distribution/dd01d81c-95e8-4fcc-bcba-aa894e04c92d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/dd01d81c-95e8-4fcc-bcba-aa894e04c92d"}},{"@id":"http://data.europa.eu/88u/record/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/392123be-bff1-4aaa-8ea3-fed9445766e4"},{"@id":"http://data.europa.eu/88u/distribution/7f3d79ae-f913-4eff-9f12-129ea8b32683"},{"@id":"http://data.europa.eu/88u/distribution/dd01d81c-95e8-4fcc-bcba-aa894e04c92d"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"bdeffb12-10a8-4366-8f4e-4c4cc999f1ea","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:03Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:59Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:0d44c534dcb70e38b6b879b142616fae13d83ccfb6db4783681be3adcd9e3667_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:59Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"bdeffb12-10a8-4366-8f4e-4c4cc999f1ea","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:0d44c534dcb70e38b6b879b142616fae13d83ccfb6db4783681be3adcd9e3667"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/skatteregistrera-utomlands-bosatta/1.0.15/%2523dataset","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/skatteregistrera-utomlands-bosatta/1.0.15/%2523distribution"},"dcat:keyword":[{"@language":"sv","@value":" avgifter"},{"@language":"sv","@value":"skatter"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Skatteregistrera privatpersoner bosatta utomlands riktar sig till de som ska ansöka om särskild inkomstskatt (SINK). API:et möjliggör för arbetsgivare och revisionsbyråer att skicka ansökningar direkt från ekonomi- eller lönesystemet."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Skatteregistrera utomlands bosatta"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/skatteregistrera-utomlands-bosatta/1.0.15/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/skatteregistrera-utomlands-bosatta/1.0.15/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/skatteregistrera-utomlands-bosatta/1.0.15/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/skatteregistrera-utomlands-bosatta/1.0.15/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/skatteregistrera-utomlands-bosatta/1.0.15/swagger.json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-06-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Skatteregistrera utomlands bosatta"}}],"@id":"urn:source:0d5b375fac6c3dc2bcee54b6f8cc95bbe8126727521859bdd9eea3ca41cd8083"},{"@graph":[{"@id":"_:0e35206bcb1248c2810e8aa9ece7a12a63bf46b64e19737b3abd22dc1f21222b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.1415,17.7605 59.1415,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.1415,17.7605 59.1415,17.7605 59.4402))"}},{"@id":"_:0e35206bcb1248c2810e8aa9ece7a12a63bf46b64e19737b3abd22dc1f21222b_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"174d2e84e136e2a01653ae26f7dc60dd00"},{"@id":"http://data.europa.eu/88u/dataset/cc65f634-2817-41e7-a021-eee803e6b448","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/54bb93c6-ffd0-4507-b540-96a5357b6591"},{"@id":"http://data.europa.eu/88u/distribution/a327149e-ee2a-428d-a2bb-954c6e638f1d"},{"@id":"http://data.europa.eu/88u/distribution/a6db43c2-9a18-410e-9752-5908dffbe068"},{"@id":"http://data.europa.eu/88u/distribution/c8083810-a61c-47d1-96ca-4c03f4612f22"}],"dcat:keyword":["Stockholm Vatten och Avfall",{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=d979a984-c57a-4be5-afb2-a06f86f69866"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Тук сме измислили фиктивни писти. Те се основават единствено на прост ГИС анализ. Това означава, че всички затворени зони са запълнени, така че водата да може да тече по-нататък и да се създаде съгласувана писта за излитане и кацане. Не е сигурно, че това се случва в действителност, тъй като размерът на дъжда влияе върху това дали ниската точка се запълва или не."},{"@language":"cs-t-sv-t0-mtec","@value":"Tady jsme přišli na fiktivní přistávací dráhy. Ty jsou založeny výhradně na jednoduché analýze GIS. To znamená, že všechny uzavřené prostory jsou naplněny tak, aby voda mohla proudit dále a vytvořit koherentní dráhu. Není jisté, že se to děje ve skutečnosti, protože velikost deště ovlivňuje, zda se nízký bod zaplní nebo ne."},{"@language":"da-t-sv-t0-mtec","@value":"Her har vi fundet ud af fiktive landingsbaner. Disse er udelukkende baseret på en simpel GIS-analyse. Det betyder, at alle lukkede områder fyldes op, så vandet kan flyde videre og skabe en sammenhængende bane. Det er ikke sikkert, at dette sker i virkeligheden, da regnens størrelse påvirker, om lavpunktet bliver fyldt eller ej."},{"@language":"de-t-sv-t0-mtec","@value":"Hier haben wir fiktive Start- und Landebahnen gefunden. Diese basieren ausschließlich auf einer einfachen GIS-Analyse. Das bedeutet, dass alle geschlossenen Bereiche aufgefüllt werden, damit das Wasser weiter fließen kann und eine zusammenhängende Start- und Landebahn entsteht. Es ist nicht sicher, dass dies in der Realität geschieht, da die Größe des Regens beeinflusst, ob der Tiefpunkt gefüllt wird oder nicht."},{"@language":"el-t-sv-t0-mtec","@value":"Εδώ έχουμε βρει φανταστικούς διαδρόμους. Αυτά βασίζονται αποκλειστικά σε μια απλή ανάλυση GIS. Αυτό σημαίνει ότι όλες οι κλειστές περιοχές γεμίζονται έτσι ώστε το νερό να μπορεί να ρέει περαιτέρω και να δημιουργεί έναν συνεκτικό διάδρομο προσγείωσης/απογείωσης. Δεν είναι βέβαιο ότι αυτό συμβαίνει στην πραγματικότητα, καθώς το μέγεθος της βροχής επηρεάζει το αν το χαμηλό σημείο γεμίσει ή όχι."},{"@language":"en-t-sv-t0-mtec","@value":"Here we have figured out fictitious runways. These are based solely on a simple GIS analysis. This means that all enclosed areas are filled up so that water can flow further and create a coherent runway. It is not certain that this happens in reality as the size of the rain affects whether the low point becomes filled or not."},{"@language":"es-t-sv-t0-mtec","@value":"Aquí hemos descubierto pistas ficticias. Estos se basan únicamente en un simple análisis SIG. Esto significa que todas las áreas cerradas se llenan para que el agua pueda fluir más y crear una pista coherente. No es seguro que esto suceda en realidad, ya que el tamaño de la lluvia afecta si el punto bajo se llena o no."},{"@language":"et-t-sv-t0-mtec","@value":"Siin oleme välja mõelnud fiktiivsed rajad. Need põhinevad üksnes lihtsal GIS-analüüsil. See tähendab, et kõik suletud alad täidetakse, et vesi saaks edasi voolata ja luua ühtse raja. Ei ole kindel, et see juhtub tegelikkuses, kuna vihma suurus mõjutab seda, kas madal punkt täitub või mitte."},{"@language":"fi-t-sv-t0-mtec","@value":"Tässä olemme keksineet kuvitteellisia kiitoteitä. Ne perustuvat pelkästään yksinkertaiseen GIS-analyysiin. Tämä tarkoittaa, että kaikki suljetut alueet täytetään niin, että vesi voi virrata edelleen ja luoda yhtenäisen kiitotien. Ei ole varmaa, että tämä tapahtuu todellisuudessa, koska sateen koko vaikuttaa siihen, täyttyykö matala kohta vai ei."},{"@language":"fr-t-sv-t0-mtec","@value":"Ici, nous avons trouvé des pistes fictives. Celles-ci sont basées uniquement sur une simple analyse SIG. Cela signifie que toutes les zones fermées sont remplies afin que l'eau puisse s'écouler plus loin et créer une piste cohérente. Il n'est pas certain que cela se produise en réalité car la taille de la pluie affecte si le point bas devient rempli ou non."},{"@language":"ga-t-sv-t0-mtec","@value":"Anseo táimid tar éis rúidbhealaí samhailteacha a dhéanamh amach. Tá siad seo bunaithe ar anailís GIS simplí amháin. Ciallaíonn sé seo go líontar gach limistéar iata ionas gur féidir le huisce sreabhadh níos faide agus rúidbhealach comhleanúnach a chruthú. Níl sé cinnte go dtarlaíonn sé seo i ndáiríre de réir mar a théann méid na báistí i bhfeidhm ar cibé an ndéantar an pointe íseal a líonadh nó nach bhfuil."},{"@language":"hr-t-sv-t0-mtec","@value":"Ovdje smo shvatili fiktivne piste. Temelje se isključivo na jednostavnoj GIS analizi. To znači da su sva zatvorena područja napunjena kako bi voda mogla dalje teći i stvoriti koherentnu uzletno-sletnu stazu. Nije sigurno da se to događa u stvarnosti jer veličina kiše utječe na to hoće li se niska točka napuniti ili ne."},{"@language":"hu-t-sv-t0-mtec","@value":"Itt kitaláltunk egy fiktív kifutópályát. Ezek kizárólag egy egyszerű GIS-elemzésen alapulnak. Ez azt jelenti, hogy minden zárt terület fel van töltve, hogy a víz tovább áramolhasson, és koherens kifutópályát hozzon létre. Nem biztos, hogy ez a valóságban megtörténik, mivel az eső mérete befolyásolja, hogy az alacsony pont megtelik-e vagy sem."},{"@language":"it-t-sv-t0-mtec","@value":"Qui abbiamo trovato piste fittizie. Questi si basano esclusivamente su una semplice analisi GIS. Ciò significa che tutte le aree chiuse sono riempite in modo che l'acqua possa scorrere ulteriormente e creare una pista coerente. Non è certo che questo accada in realtà poiché la dimensione della pioggia influisce sul fatto che il punto basso si riempia o meno."},{"@language":"lt-t-sv-t0-mtec","@value":"Čia mes išsiaiškinome išgalvotus kilimo ir tūpimo takus. Jie grindžiami tik paprasta GIS analize. Tai reiškia, kad visos uždaros zonos užpildomos taip, kad vanduo galėtų toliau tekėti ir sukurti vientisą kilimo ir tūpimo taką. Neaišku, ar tai vyksta iš tikrųjų, nes lietaus dydis įtakoja tai, ar žemas taškas tampa užpildytas, ar ne."},{"@language":"lv-t-sv-t0-mtec","@value":"Šeit mēs esam sapratuši fiktīvus skrejceļus. To pamatā ir tikai vienkārša ĢIS analīze. Tas nozīmē, ka visas slēgtās zonas ir piepildītas, lai ūdens varētu plūst tālāk un izveidot saskaņotu skrejceļu. Nav skaidrs, vai tas notiek realitātē, jo lietus lielums ietekmē to, vai zemais punkts piepildās vai nē."},{"@language":"mt-t-sv-t0-mtec","@value":"Hawnhekk sibna runways fittizji. Dawn huma bbażati biss fuq analiżi SIG sempliċi. Dan ifisser li ż-żoni magħluqa kollha jimtlew sabiex l-ilma jkun jista’ jiċċirkola aktar u tinħoloq runway koerenti. Mhuwiex ċert li dan iseħħ fir-realtà peress li d-daqs tax-xita jaffettwa jekk il-punt baxx jimteliex jew le."},{"@language":"nl-t-sv-t0-mtec","@value":"Hier hebben we fictieve start- en landingsbanen uitgezocht. Deze zijn uitsluitend gebaseerd op een eenvoudige GIS-analyse. Dit betekent dat alle afgesloten gebieden worden opgevuld zodat het water verder kan stromen en een samenhangende start- en landingsbaan kan creëren. Het is niet zeker dat dit in werkelijkheid gebeurt, omdat de grootte van de regen van invloed is op de vraag of het dieptepunt wordt gevuld of niet."},{"@language":"pl-t-sv-t0-mtec","@value":"Tutaj mamy wymyślone pasy startowe. Opierają się one wyłącznie na prostej analizie GIS. Oznacza to, że wszystkie zamknięte obszary są wypełnione, aby woda mogła płynąć dalej i tworzyć spójny pas startowy. Nie jest pewne, czy dzieje się tak w rzeczywistości, ponieważ wielkość deszczu wpływa na to, czy niski punkt zostanie wypełniony, czy nie."},{"@language":"pt-t-sv-t0-mtec","@value":"Aqui descobrimos pistas fictícias. Estes baseiam-se apenas numa simples análise SIG. Isto significa que todas as áreas fechadas são preenchidas para que a água possa fluir ainda mais e criar uma pista coerente. Não é certo que isso aconteça na realidade, já que o tamanho da chuva afeta se o ponto baixo fica cheio ou não."},{"@language":"ro-t-sv-t0-mtec","@value":"Aici ne-am dat seama de piste fictive. Acestea se bazează exclusiv pe o simplă analiză GIS. Aceasta înseamnă că toate zonele închise sunt umplute astfel încât apa să poată curge mai departe și să creeze o pistă coerentă. Nu este sigur că acest lucru se întâmplă în realitate, deoarece dimensiunea ploii afectează dacă punctul scăzut devine umplut sau nu."},{"@language":"sk-t-sv-t0-mtec","@value":"Tu sme vymysleli fiktívne dráhy. Tie sú založené výlučne na jednoduchej analýze GIS. To znamená, že všetky uzavreté priestory sú naplnené tak, aby voda mohla ďalej prúdiť a vytvoriť súvislú vzletovú a pristávaciu dráhu. Nie je isté, či sa to stane v skutočnosti, pretože veľkosť dažďa ovplyvňuje, či sa nízky bod naplní alebo nie."},{"@language":"sl-t-sv-t0-mtec","@value":"Tukaj smo ugotovili izmišljene vzletno-pristajalne steze. Ti temeljijo izključno na preprosti analizi GIS. To pomeni, da so vsa zaprta območja napolnjena tako, da lahko voda teče naprej in ustvari skladno vzletno-pristajalno stezo. Ni gotovo, da se to zgodi v resnici, saj velikost dežja vpliva na to, ali se nizka točka napolni ali ne."},{"@language":"sv","@value":"Här har vi räknat ut fiktiva rinnvägar. Dessa är enbart baserade på en enkel GIS-analys. Det innebär alla instängda områden fyllts upp så att vatten kan rinna vidare och skapa en sammanhängande rinnväg. Det är inte säkert att detta händer i verkligheten då regnets storlek påverkar om lågpunkten blir fylld eller inte."},{"@language":"uk-t-sv-t0-mtec","@value":"Тут ми розібралися з фіктивними злітно-посадковими смугами. Вони засновані виключно на простому ГІС-аналізі. Це означає, що всі закриті ділянки заповнюються таким чином, щоб вода могла текти далі і створити зв'язну злітно-посадкову смугу. Не впевнений, що це відбувається насправді, оскільки розмір дощу впливає на те, заповнюється низька точка чи ні."}],"dct:format":["application/vnd.ogc.wfs_xml","application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"cc65f634-2817-41e7-a021-eee803e6b448","dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/"},"dct:spatial":{"@id":"_:0e35206bcb1248c2810e8aa9ece7a12a63bf46b64e19737b3abd22dc1f21222b_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Измислени маршрути - свободно достъпни данни"},{"@language":"cs-t-sv-t0-mtec","@value":"Fiktivní trasy - otevřená data"},{"@language":"da-t-sv-t0-mtec","@value":"Fiktive ruter - åbne data"},{"@language":"de-t-sv-t0-mtec","@value":"Fiktive Wege - Open Data"},{"@language":"el-t-sv-t0-mtec","@value":"Φανταστικές Διαδρομές - Ανοιχτά Δεδομένα"},{"@language":"en-t-sv-t0-mtec","@value":"Fictional Routes - Open Data"},{"@language":"es-t-sv-t0-mtec","@value":"Rutas ficticias - Datos abiertos"},{"@language":"et-t-sv-t0-mtec","@value":"Väljamõeldud marsruudid - avatud andmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Kuvitteelliset reitit - Avoin data"},{"@language":"fr-t-sv-t0-mtec","@value":"Routes de fiction - Open Data"},{"@language":"ga-t-sv-t0-mtec","@value":"Bealaí Ficseanúla - Sonraí Oscailte"},{"@language":"hr-t-sv-t0-mtec","@value":"Fictional Routes - Otvoreni podaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Fiktív útvonalak - nyílt hozzáférésű adatok"},{"@language":"it-t-sv-t0-mtec","@value":"Itinerari immaginari - Open Data"},{"@language":"lt-t-sv-t0-mtec","@value":"Fictional Maršrutai - Atvirieji duomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Fictional Routes - Atvērtie dati"},{"@language":"mt-t-sv-t0-mtec","@value":"* Rotot fittizji - Data Miftuħa"},{"@language":"nl-t-sv-t0-mtec","@value":"Fictieve routes - Open Data"},{"@language":"pl-t-sv-t0-mtec","@value":"Szlaki fikcyjne - otwarte dane"},{"@language":"pt-t-sv-t0-mtec","@value":"Rotas Fictícias - Dados Abertos"},{"@language":"ro-t-sv-t0-mtec","@value":"Rute fictive - Date deschise"},{"@language":"sk-t-sv-t0-mtec","@value":"Fiktívne trasy - otvorené dáta"},{"@language":"sl-t-sv-t0-mtec","@value":"Izmišljene poti - odprti podatki"},{"@language":"sv","@value":"Fiktiva Rinnvägar - Öppna Data"},{"@language":"uk-t-sv-t0-mtec","@value":"Вигадані маршрути - відкриті дані"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/54bb93c6-ffd0-4507-b540-96a5357b6591","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-svoa2.hub.arcgis.com/maps/890963d1ac2647b6ae72afb512360f82"},"dct:description":"Fiktiva rinnvägar","dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/cc65f634-2817-41e7-a021-eee803e6b448#HTTP:Information/4","dct:title":"Stockholm Vatten och Avfall - Öppna data","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/54bb93c6-ffd0-4507-b540-96a5357b6591"}},{"@id":"http://data.europa.eu/88u/distribut