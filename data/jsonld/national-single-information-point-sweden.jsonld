,"dct:description":{"@language":"sv","@value":"API:et riktar sig till svenska myndigheter och andra verksamheter som har rättsligt stöd att ta del av sammanställda underlag för beskattning av inkomstslaget tjänst."},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2024-09-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Beskattningsunderlag tjänsteinkomster"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/swagger.json%2523accessService"}},{"@id":"http://data.europa.eu/88u/distribution/236391a3-4b44-46c4-a21f-d37d359cab76","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/beskattningsunderlag-tjansteinkomster-proxy/1.1.0/swagger.json"},"dct:format":"application/json","dct:issued":{"@type":"xsd:date","@value":"2024-09-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Облагаема сума на доходите от услуги"},{"@language":"cs-t-sv-t0-mtec","@value":"Zdanitelná částka příjmů ze služeb"},{"@language":"da-t-sv-t0-mtec","@value":"Skattep