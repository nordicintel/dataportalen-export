.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b27n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b28n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021005448","@type":"foaf:Agent","dct:identifier":"2021005448","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://skatteverket.se"},"foaf:mbox":{"@id":"mailto:robin.mangs@skatteverket.se"},"foaf:name":{"@language":"sv","@value":"Skatteverket"},"foaf:page":{"@id":"https://www.skatteverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://skatteverket.entryscape.net/store/29/resource/1"},{"@id":"https://skatteverket.se"}]},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/bilforman/2.0.3/%2523dataset","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/bilforman/2.0.3/%2523distribution"},"dcat:keyword":[{"@language":"sv","@value":" avdrag"},{"@language":"sv","@value":" löner"},{"@language":"sv","@value":" trafik"},{"@language":"sv","@value":"bil"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dcat:version":"2.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"API:et Bilförmån gör det möjligt för programvaruföretag att ta fram tjänster där slutanvändare kan räkna ut förmånsvärdet på sin företagsbil. API:et finns tillgängligt som komplett testtjänst och driftsatt tjänst."},"dct:issued":{"@type":"xsd:date","@value":"2022-05-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021005448"},"dct:title":{"@language":"sv","@value":"Bilförmån"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/bilforman/2.0.3/swagger.json%2523accessService"}},{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/bilforman/2.0.3/%2523distribution","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/bilforman/2.0.3/swagger.json%2523accessService"},"dcat:accessURL":{"@id":"https://www7.skatteverket.se/portal/apier-och-oppna-data/utvecklarportalen/api/bilforman/2.0.3/%C3%96versikt"},"dct:conformsTo":{"@id":"https://www7.skatteverket.se/portal-wapi/open/apier-och-oppna-data/utvecklarportalen/v1/oas-for-api/bilforman/2.0.3/swagger.json"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-05-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Bilförmån"}}],"@id":"urn:source:7d86e6b677cc728722c8589b01679b5b53d6ef296e4239aa326e3cfd27227d21"},{"@graph":[{"@id":"_:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2014-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2014-04-05"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2014-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2014-04-05"}},{"@id":"_:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1b240a801594fac1bef8897fb8266cbb58"},{"@id":"http://data.europa.eu/88u/dataset/1b96d73d-af16-46f7-b6ee-9b14e4f2007b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5e5e4ba5-b29f-4837-b369-b6a1d1c04016"},{"@id":"http://data.europa.eu/88u/distribution/692971f4-3517-471c-a855-b0d92b850855"},{"@id":"http://data.europa.eu/88u/distribution/72e35cde-11ad-4852-989f-16b7b1eca681"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e25aa720-517c-465b-88d8-afcb5eee923c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2014-04-05"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. 1300 mРезолюция: 8 см/пиксел Дата на заснемане: 5 и 20 април 2014 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 1300 mRozlišení: 8 cm/pixel Datum natáčení: a 20. dubna 2014. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. 1300 mBeslutning: 8 cm/pixel Optagelsesdato: og 20. april 2014. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. 1300 mAuflösung: 8 cm/Pixel Aufnahmedatum: 5. und 20. April 2014. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. 1300 mΨήφισμα: 8 Ημερομηνία λήψης: 5 και 20 Απριλίου 2014. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. 1300 mResolution: 8 cm/pixel Shooting date: 5 and 20 April 2014. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. 1300 mResolución: 8 cm/píxel Fecha de disparo: 5 y 20 de abril de 2014. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. 1300 mLahendus: 8 cm/piksel Pildistamise kuupäev: ja 20. aprill 2014. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. 1300 mResoluutio: 8 cm/pikseli Kuvauspäivä: ja 20. huhtikuuta 2014. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. 1300 mRésolution: 8 cm/pixel Date de prise de vue: 5 et 20 avril 2014. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. 1300 mRéiteach: 8 cm/picteilín Dáta Lámhach: 5 agus 20 Aibreán 2014. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. 1300 mRezolucija: 8 cm / piksela Datum snimanja: i 20. travnja 2014. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. 1300 mFelbontás: 8 cm/pixel A fényképezés időpontja: 2014. április 5–20. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. 1300 mRisoluzione: 8 cm/pixel Data di ripresa: 5 e 20 aprile 2014. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. 1300 mRezoliucija: 8 cm/pikselis Fotografavimo data: 2014 m. balandžio 5–20 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. 1300 mIzšķirtspēja: 8 cm/pixel Uzņemšanas datums: 2014. gada 5. un 20. aprīlī. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. 1300 mRiżoluzzjoni: 8 ċm/pixel Data ta' l-isparar: il-5 u l-20 ta' April 2014. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. 1300 mResolutie: 8 cm/pixel Opnamedatum: 5 en 20 april 2014. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. 1300 mRozdzielczość: 8 cm/piksel Data strzelectwa: 5 i 20 kwietnia 2014 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. 1300 mResolução: 8 cm/pixel Data do disparo: 5 e 20 de abril de 2014. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. 1300 mRezoluție: 8 cm/pixel Data filmării: 5 și 20 aprilie 2014. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 1300 mRozlíšenie: 8 cm/pixel Dátum streľby: a 20. apríla 2014. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. 1300 mResolucija: 8 cm/piksel Datum fotografiranja: in 20. aprila 2014. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1300 mUpplösning: 8 cm/pixel Fotograferingsdatum: 5 och 20 april 2014. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 1300 мРезолюція: 8 см/піксель Дата зйомки: 5 та 20 квітня 2014 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"1b96d73d-af16-46f7-b6ee-9b14e4f2007b","dct:issued":{"@type":"xsd:date","@value":"2015-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570_b0n0"},"dct:temporal":{"@id":"_:7de1468496a050c6f6e7af51e0fff9a72eee2fa051924dd8dfdfb28f7f88b570_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"СБК Ортофото (2014)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (2014) | Filmy online ke shlédnutí zdarma"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (flertydig)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ορθοφύτο (2014)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (2014.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (2014) - Videó letöltés mp3-ban"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (2014) ONLINE"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (2014) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (2014)"},{"@language":"sv","@value":"SBK Ortofoto (2014)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2014)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/5e5e4ba5-b29f-4837-b369-b6a1d1c04016","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5e5e4ba5-b29f-4837-b369-b6a1d1c04016"}},{"@id":"http://data.europa.eu/88u/distribution/692971f4-3517-471c-a855-b0d92b850855","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2014"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/1b96d73d-af16-46f7-b6ee-9b14e4f2007b#HTTP:OGC:WMS/5","dct:title":["WMS-tjänst Ortofoto 2014",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ортофото 2014"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2014"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjenesten Ortofoto 2014"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2014"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2014"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2014"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2014"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2014"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2014"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2014"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2014"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2014"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2014"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2014"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2014"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2014"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2014"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS service Ortofoto 2014"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2014"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2014"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2014"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2014"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2014"},{"@language":"uk-t-sv-t0-mtec","@value":"WMS сервіс Ortofoto 2014"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/692971f4-3517-471c-a855-b0d92b850855"}},{"@id":"http://data.europa.eu/88u/distribution/72e35cde-11ad-4852-989f-16b7b1eca681","@type":"dcat:Distribution","dcat:accessURL":{"@id":"htt