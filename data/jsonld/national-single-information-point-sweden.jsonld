int":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=4347a029-13ae-4e26-a5eb-1ca8bced2bba"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2010-05-11"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Upplösning: 8 cm/pixel Flyghöjd: 1100m. Upplösning: 8 cm på marken per pixel. Övertäckning 60/30, centrala delen 60/60. Fotograferingsdatum: mellan 26 april och 11 maj 2010."},"dct:identifier":"bdeffb12-10a8-4366-8f4e-4c4cc999f1ea","dct:issued":{"@type":"xsd:date","@value":"2011-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:9ac358121d3c019a44c31f6fded56d8bb08167b4a902a4ddf913f45e9af3fcc5_b0n0"},"dct:temporal":{"@id":"_:9ac358121d3c019a44c31f6fded56d8bb08167b4a902a4ddf913f45e9af3fcc5_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2010)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2010"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2010"},{"@id":"https://resources.stockholm.se/data/bdeffb12-10a8-4366-8f4e-4c4cc999f1ea#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2010"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2010"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:9ac358121d3c019a44c31f6fded56d8bb08167b4a902a4ddf913f45e9af3fcc5