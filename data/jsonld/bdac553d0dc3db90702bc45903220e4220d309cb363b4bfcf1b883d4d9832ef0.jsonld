{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:16f3d9aeda0c39aef4218a2eff2b0ab9cca346271013e4b016104e971e4876d8_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2025"}},{"@id":"http://dataportal.se/organisation/SE2021004359","@type":"foaf:Agent","dct:identifier":"2021004359","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:it@pts.se"},"foaf:name":{"@language":"sv","@value":"Post- och telestyrelsen"},"foaf:page":{"@id":"https://www.pts.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://pts.entryscape.net/store/1/resource/1"}},{"@id":"https://pts.entryscape.net/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Mobiltäcknings och bredbandskartläggningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ptsbredband@pts.se"}},{"@id":"https://pts.entryscape.net/store/1/resource/37","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://pts.entryscape.net/store/1/resource/25"},"dcat:distribution":{"@id":"https://pts.entryscape.net/store/1/resource/38"},"dcat:inSeries":{"@id":"https://pts.entryscape.net/store/1/resource/35"},"dcat:keyword":[{"@language":"sv","@value":"Bredband"},{"@language":"sv","@value":"Digitalisering"},{"@language":"sv","@value":"Fiber"},{"@language":"sv","@value":"Mobiltäckning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"sv","@value":"Mobiltäcknings och bredbandskartläggning är en geografisk kartläggning över tillgången till fast och mobil bredbandsinfrastruktur samt mobila tjänster. Kartläggningen beskriver var Sverige årligen befinner sig i förhållande till mål som fastställts i Sveriges digitaliseringsstrategi. Kartläggningen försöker fånga befintlig, beslutad framtida och potential till infrastruktur. Kartläggningen sammanställer information om teknikerna fiber, docsis, fast radio, satellit och mobil."},{"@language":"sv","@value":"Statistik sammanställt på kommun, län och Sverige nivå"},{"@language":"sv","@value":"Tabellbilagorna beskriver hur stor andel hushåll eller företag som har eller är i närhet av  infrastruktur med olika bredbandshastigheter eller bredbandsteknik."}],"dct:issued":{"@type":"xsd:gYear","@value":"2026"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004359"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:16f3d9aeda0c39aef4218a2eff2b0ab9cca346271013e4b016104e971e4876d8_b0n0"},"dct:title":{"@language":"sv","@value":"WFS hastighet och teknik"}},{"@id":"https://pts.entryscape.net/store/1/resource/38","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://hajk-bredbandskartan.pts.se/geoserver/w_i_table/wfs"},"dct:description":{"@language":"sv","@value":"WFS länk till tabellbilaga hastighet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Tabellbilaga hastighet (WFS)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}}],"@id":"urn:source:16f3d9aeda0c39aef4218a2eff2b0ab9cca346271013e4b016104e971e4876d8"},{"@graph":[{"@id":"_:302bce436da209b320ad54d05de2ab15e5c379c21fdc71f589b50ea0a6589866_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11531","http://www.w3.org/2006/vcard/ns#street-address":"Valhallavägen 117 A"},{"@id":"_:302bce436da209b320ad54d05de2ab15e5c379c21fdc71f589b50ea0a6589866_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4686785500"}},{"@id":"http://dataportal.se/organisation/SE2021004359","@type":"foaf:Agent","dct:identifier":"2021004359","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:it@pts.se"},"foaf:name":{"@language":"sv","@value":"Post- och telestyrelsen"},"foaf:page":{"@id":"https://www.pts.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://pts.entryscape.net/store/1/resource/1"}},{"@id":"https://pts.entryscape.net/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Post- och telestyrelsen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:302bce436da209b320ad54d05de2ab15e5c379c21fdc71f589b50ea0a6589866_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:pts@pts.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:302bce436da209b320ad54d05de2ab15e5c379c21fdc71f589b50ea0a6589866_b1n0"}},{"@id":"https://pts.entryscape.net/store/1/resource/24","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://pts.entryscape.net/store/1/resource/13"},"dcat:endpointURL":{"@id":"https://data.pts.se/v1/operator/8/6785500"},"dcat:keyword":[{"@language":"sv","@value":"PTS"},{"@language":"sv","@value":"Sök operatör"},{"@language":"sv","@value":"Telefonnummer"}],"dct:description":{"@language":"sv","@value":"PTS ansvarar för förvaltningen och utvecklingen av den svenska telefoninummerplanen samt av ett antal tekniska planer. PTS tilldelar nummerkapacitet till tillhandahållare av elektroniska kommunikationstjänster. E-tjänsten ”Sök operatör” används för att se till vilken tillhandahållare ett specifikt telefonnummer är tilldelat. Man kan fråga efter ett enskilt nummer eller en lista. Notera att om en mobiloperatör har flera bolag i samma koncern eller ett separat varumärke kan söktjänsten visa moderbolaget trots att abonnemanget finns hos ett bolag eller varumärke med ett annat namn. Exempelvis visas Telia Sverige AB även om abonnemanget finns hos Halebop."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004359"},"dct:title":{"@language":"sv","@value":"Sök operatör"},"foaf:page":{"@id":"https://catalog.pts.se/dokumentation/operator.html"}}],"@id":"urn:source:302bce436da209b320ad54d05de2ab15e5c379c21fdc71f589b50ea0a6589866"},{"@graph":[{"@id":"_:41cf30511ff977837401e5048726b0787b0c9e53d993938b038845295c584227_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2025"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2025"}},{"@id":"http://dataportal.se/organisation/SE2021004359","@type":"foaf:Agent","dct:identifier":"2021004359","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:it@pts.se"},"foaf:name":{"@language":"sv","@value":"Post- och telestyrelsen"},"foaf:page":{"@id":"https://www.pts.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://pts.entryscape.net/store/1/resource/1"}},{"@id":"https://pts.entryscape.net/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Mobiltäcknings och bredbandskartläggningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ptsbredband@pts.se"}},{"@id":"https://pts.entryscape.net/store/1/resource/26","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://pts.entryscape.net/store/1/resource/25"},"dcat:distribution":{"@id":"https://pts.entryscape.net/store/1/resource/27"},"dcat:inSeries":{"@id":"https://pts.entryscape.net/store/1/resource/35"},"dcat:keyword":[{"@language":"sv","@value":"Bredband"},{"@language":"sv","@value":"Digitalisering"},{"@language":"sv","@value":"Fiber"},{"@language":"sv","@value":"Mobiltäckning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"ht