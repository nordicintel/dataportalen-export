ty"},"foaf:mbox":{"@id":"mailto:it@pts.se"},"foaf:name":{"@language":"sv","@value":"Post- och telestyrelsen"},"foaf:page":{"@id":"https://www.pts.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://pts.entryscape.net/store/1/resource/1"}},{"@id":"https://pts.entryscape.net/store/1/resource/13","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Post- och telestyrelsen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:653401eadc55c3407b1abf7fd0b0e19c0ab4bc30a8ea6f5253a9db1ca717c57c_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:pts@pts.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:653401eadc55c3407b1abf7fd0b0e19c0ab4bc30a8ea6f5253a9db1ca717c57c_b1n0"}},{"@id":"https://pts.entryscape.net/store/1/resource/23","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://pts.entryscape.net/store/1/resource/13"},"dcat:endpointURL":{"@id":"https://data.pts.se/v1/wirelessaudio?q=59.324837968012396,18.072319725772864&indoor=false&freq=558"},"dcat:keyword":[{"@language":"sv","@value":"PTS"},{"@language":"sv","@value":"Radio"},{"@language":"sv","@value":"Trådlös ljudöverföring"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:description":{"@language":"sv","@value":"PTS e-tjänst ”Trådlös ljudöverföring” kan användas för att se vilka lediga kanaler som finns i ett viss geografiskt område. Med hjälp av tjänsten kan du söka tillgängliga frekvenser för tillståndspliktig trådlös ljudöverföring inom frekvensområdet 470-694 MHz. Detta API används för att fråga tillgängliga frekvenser i Sverige för användning med trådlösa överföringsenheter för ljud (t.ex. mikrofoner)."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004359"},"dct:title":{"@language":"sv","@value":"Trådlös ljudöverföring"},"foaf:page":{"@id":"https://catalog.pts.se/dokumentation/wirelessaudio.html"}}],"@id":"urn: