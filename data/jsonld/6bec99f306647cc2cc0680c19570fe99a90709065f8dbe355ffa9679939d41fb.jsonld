:keyword":[{"@language":"sv","@value":"Barn"},{"@language":"sv","@value":"Children"},{"@language":"sv","@value":"Lek"},{"@language":"sv","@value":"Lekplatser"},{"@language":"sv","@value":"Playground"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"https://dataportal.se/en/specifications/lekplatser/1.0"},"dct:description":[{"@language":"en","@value":"Data containing Playgrounds in Kungälv municipality.\nNames of the playgrounds, municipal area, website and coordinates in WGS84 format."},{"@language":"sv","@value":"Data innehållandes Lekplatser i Kungälvs kommun.\nNamn på lekplatserna, kommunområde, webbsida samt koordinater i WGS84-format."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001371"},"dct:title":[{"@language":"en","@value":"Playgrounds"},{"@language":"sv","@value":"Lekplatser i Kungälv"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/101"}}],"@id":"urn:source:e9f45278d5b0f1806518a78fcb055abdfdc6d14249fde37b94f899f3c6b15ad2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001371","@type":"foaf:Agent","dct:identifier":"2120001371","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.gustafsson@kungalv.se"},"foaf:name":{"@language":"sv","@value":"Kungälvs kommun"},"foaf:page":{"@id":"https://www.kungalv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.kungalv.se/store/1/resource/1"}},{"@id":"https://catalog.kungalv.se/store/1/resource/25","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":[{"@id":"https://catalog.kungalv.se/store/1/resource/27"},{"@id":"https://catalog.kungalv.se/store/1/resource/29"}],"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"barbecue areas"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:conformsTo":{"@id":"https://dataportal.se/specifications/grillplatser/1.0"},"dct:description":[{"@language":"en","@value":"The dataset includes barbecue areas in public places outdoors that are free to use for the public, usually all year round and free of charge. At the barbecue area there is often benches, wind guard and other equipment for a pleasant experience. The dataset contains information about e.g. name, location, contact information and more. There may also be additional information about which characteristics that are available at the barbecue area. Water for putting out the fire or something else."},{"@language":"sv","@value":"Datamängden grillplatser (barbecue areas på engelska) omfattar grillplatser på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Vid grillplatserna finns oftast bänkar, vindskydd och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid grillplatsen. Exempelvis vatten för att släcka en eld."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001371"},"dct:title":[{"@language":"en","@value":"Barbecue areas in Kungälv municipality"},{"@language":"sv","@value":"Grillplatser i Kungälv"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/143"}},{"@id":"https://catalog.kungalv.se/store/1/resource/26","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"grillplats.csv"},{"@id":"https://catalog.kungalv.se/store/1/resource/27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.kungalv.se/store/1/resource/26"},"dcat:downloadURL":{"@id":"https://catalog.kungalv.se/store/1/resource/26"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-15T13:45:22.376Z"},"dct:title":{"@language":"sv","@value":"CSV för grillplatser"}},{"@id":"https://catalog.kungalv.se/store/1/resource/29","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.kungalv.se/rowstore/dataset/44eddc84-70fe-4f5f-947b-fa665329f8fe"},"dct:conformsTo":{"@id":"https://catalog.kungalv.se/rowstore/dataset/44eddc84-70fe-4f5f-947b-fa665329f8fe/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://catalog.kungalv.se/store/1/resource/27"},"dct:title":{"@language":"sv","@value":"JSON för grillplatser"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.kungalv.se/rowstore/dataset/44eddc84-70fe-4f5f-947b-fa665329f8fe/swagger"}},{"@id":"https://dataportal.se/specifications/grillplatser/1.0","@type":"dct:Standard","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/130/resource/1"},"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dct:description":{"@language":"sv","@value":"Med grillplats menas en särskilt anlagd eller skött allmän plats där man kan göra upp eld och/eller grilla i en särskilt anlagd härd.\n\nDenna specifikation definierar en enkel tabulär informationsmodell för grillplatser. Specifikationen innefattar också en beskrivning av hur informationen uttrycks i formatet CSV och JSON. Som grund förutsätts CSV kunna levereras då det är praktiskt format och skapar förutsägbarhet för mottagare av informationen. Det är också ett format som gör sammanställningen av datamängden enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}}],"@id":"urn:source:ea831707557c43082accc7675646928c0a3a50b7f81d1fa21fe940a264151bd0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001371","@type":"foaf:Agent","dct:identifier":"2120001371","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.gustafsson@kungalv.se"},"foaf:name":{"@language":"sv","@value":"Kungälvs kommun"},"foaf:page":{"@id":"https://www.kungalv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.kungalv.se/store/1/resource/1"}},{"@id":"https://catalog.kungalv.se/store/1/resource/74","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://catalog.kungalv.se/store/1/resource/76"},"dcat:keyword":[{"@language":"en","@value":"Waste container for recycling"},{"@language":"sv","@value":"Avfallsbehållare för återvinning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/QUARTERLY"},"dct:description":[{"@language":"en","@value":"Waste containers for recycling in Kungälvs kommun. Points and types.\n \nThe Municipality of Kungälv disclaims all responsibility for any errors or changes in open data that has been supplied by Kungälv Municipality to the consumer. The Municipality of Kungälv disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Avfallsbehållare för återvinning i Kungälvs kommun. Punkter och typer.\n \nKungälvs kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Kungälvs kommun till konsumenten. Kungälvs kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001371"},"dct:title":[{"@language":"en","@value":"Waste containers for recycling in Kungälv"},{"@language":"sv","@value":"Avfallsbehållare för återvinning i Kungälv"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/4"}},{"@id":"https://catalog.kungalv.se/store/1/resource/76","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.kungalv.se/store/1/resource/77"},"dcat:downloadURL":{"@id":"https://catalog.kungalv.se/store/1/resource/77"},"dct:description":{"@language":"sv","@value":"Avfallsbehållare för återvinning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-02T14:09:48.782Z"},"dct:title":{"@language":"sv","@value":"Avfallsbehållare för återvinning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.kungalv.se/store/1/resource/77","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Avfallsbehållare för återvinning"}}],"@id":"urn:source:fdcbb2054a929805f58c7dda4976370de33258da99cb54832a3b80599ec94e24"}]}
