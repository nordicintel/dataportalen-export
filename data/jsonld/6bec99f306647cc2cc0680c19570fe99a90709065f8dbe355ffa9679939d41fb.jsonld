/catalog.kungalv.se/store/1/resource/50"},{"@id":"https://catalog.kungalv.se/store/1/resource/52"}],"dcat:keyword":[{"@language":"sv","@value":"Farligt avfall"},{"@language":"sv","@value":"Samlaren"},{"@language":"sv","@value":"Återvinning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/QUARTERLY"},"dct:description":{"@language":"sv","@value":"Glödlampor, lågenergilampor, batterier och småelektronik räknas som farligt avfall eftersom de kan sprida gifter om de hamnar i naturen. För att underlätta insamling finns den så kallade Samlaren i flera butiker i Kungälvs kommun där du kan slänga dina förbrukade produkter.\n\nKungälvs kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Kungälvs kommun till konsumenten. Kungälvs kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001371"},"dct:title":{"@language":"sv","@value":"Samlaren i Kungälv"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/69"}},{"@id":"https://catalog.kungalv.se/store/1/resource/49","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"samlaren.csv"},{"@id":"https://catalog.kungalv.se/store/1/resource/50","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.kungalv.se/store/1/resource/49"},"dcat:downloadURL":{"@id":"https://catalog.kungalv.se/store/1/resource/49"},"dct:format":{"@id":"http://publications.europa.eu/resource/autho