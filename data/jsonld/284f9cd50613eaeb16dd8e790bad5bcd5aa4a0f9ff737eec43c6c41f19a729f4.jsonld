t:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001561"},"dct:description":{"@language":"sv","@value":"Årsvis mätning av skräp i områdena Norrby och Hässleholmen. Skräpet räknas inom en area av en cirkel med 2 meter i radie från de 280 punkter som slumpats ut, 140 per område. Områdena är begränsade till en specifik yta och omätbara ytor har tagits bort innan slumpningen. Det kan exempelvis vara byggnader eller vatten där punkter inte kan mätas. Antal skräp som räknas är sedan indelade efter olika kategorier av skräp. Exempelvis plast och papp."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001561"},"dct:spatial":[{"@id":"_:51e6208626d6d9af9d563116c7cad1f21af3b6968e6361db42ebc38c81997cbb_b0n0"},{"@id":"_:51e6208626d6d9af9d563116c7cad1f21af3b6968e6361db42ebc38c81997cbb_b1n0"},{"@id":"https://sws.geonames.org/2720496"}],"dct:temporal":{"@id":"_:51e6208626d6d9af9d563116c7cad1f21af3b6968e6361db42ebc38c81997cbb_b2n0"},"dct:title":[{"@language":"en","@value":"Litter measure"},{"@language":"sv","@value":"Skräpmätning"}]},{"@id":"https://catalog.boras.se/store/1/resource/120","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"skrapmatning.csv"},{"@id":"https://catalog.boras.se/store/1/resource/121","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.boras.se/store/1/resource/120"},"dcat:downloadURL":{"@id":"https://catalog.boras.se/store/1/resource/120"},"dct:description":{"@language":"sv","@value":"Skräpmätning i CSV-format med koordinater i WGS84"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modifie