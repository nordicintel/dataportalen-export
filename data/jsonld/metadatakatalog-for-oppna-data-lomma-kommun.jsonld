75527386068711,13.133692774373003 55.75527386068711,13.133692774373003 55.63910095829041,12.974724724410944 55.63910095829041,12.974724724410944 55.75527386068711))"}},{"@id":"_:6a37ae055dff4097c26de6a8e1928a4b1db0c63a59237e8db0b75c880321d52c_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2023-01-01"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/182","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://catalog.lomma.se/store/1/resource/14"},{"@id":"https://catalog.lomma.se/store/1/resource/184"}],"dcat:distribution":[{"@id":"https://catalog.lomma.se/store/1/resource/186"},{"@id":"https://catalog.lomma.se/store/1/resource/188"},{"@id":"https://catalog.lomma.se/store/1/resource/234"}],"dcat:keyword":[{"@language":"en","@value":"Building Permits"},{"@language":"en","@value":"Planning permission"},{"@language":"sv","@value":"bygglov"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:description":[{"@language":"en","@value":"Statistics over recieved building cases  for Lomma municipality. Cases refer to applications for building permits, demolition permits, land permits, and preliminary decisions, as well as notifications for  measures that do not require permits. The type of case is indicated by field \"ärendemeningen\". Whether the case concerns a building or solely land permit is indicated by the field \"ärendetyp\"."},{"@language":"sv","@value":"Statistik över inkomna byggärenden på Lomma kommun. Med byggärenden avses här ansökningar om bygglov, rivningslov, marklov och förhandsbesked samt anmälan för byggåtgärder som inte kräver lov. Vad det är för typ av ärende framgår av ärendemeningen och vad det är för typ av byggnad eller om det enbart är marklov framgår av ärendetypen."}],"dct:issued":{"@type":"xsd:date","@value":"2024-02-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:spatial":{"@id":"_:6a37ae055dff4097c26de6a8e1928a4b1db0c63a59237e8db0b75c880321d52c_b0n0"},"dct:temporal":{"@id":"_:6a37ae055dff4097c26de6a8e1928a4b1db0c63a59237e8db0b75c880321d52c_b1n0"},"dct:title":[{"@language":"en","@value":"Building Permits - Received applications"},{"@language":"sv","@value":"Bygglov - Inkomna ärenden"}]},{"@id":"https://catalog.lomma.se/store/1/resource/184","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljö-byggnadsnämnd","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo-byggnadsnamnd@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/185","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Inkomna ärenden.csv"},{"@id":"https://catalog.lomma.se/store/1/resource/186","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/185"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/185"},"dct:description":[{"@language":"en","@value":"Statistics over recieved building cases  for Lomma municipality for 2023. Cases refer to applications for building permits, demolition permits, land permits, and preliminary decisions, as well as notifications for  measures that do not require permits. The type of case is indicated by field \"ärendemeningen\". Whether the case concerns a building or solely land permit is indicated by the field \"ärendetyp\"."},{"@language":"sv","@value":"Statistik över inkomna byggärenden på Lomma kommun för 2023. Med byggärenden avses här ansökningar om bygglov, rivningslov, marklov och förhandsbesked samt anmälan för byggåtgärder som inte kräver lov. Vad det är för typ av ärende framgår av ärendemeningen och vad det är för typ av byggnad eller om det enbart är marklov framgår av ärendetypen."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Building Permits - Received applications 2023"},{"@language":"sv","@value":"Bygglov - Inkomna ärenden 2023"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/187","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Inkomna ärenden.csv"},{"@id":"https://catalog.lomma.se/store/1/resource/188","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/187"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/187"},"dct:description":{"@language":"sv","@value":"uppdateras månadsvis"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-02-05T15:10:42.048Z"},"dct:title":{"@language":"sv","@value":"Bygglov 2024"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/233","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"inkomna ärenden.csv"},{"@id":"https://catalog.lomma.se/store/1/resource/234","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/233"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/233"},"dct:description":{"@language":"sv","@value":"Uppdateras månadsvis"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01T09:18:21.834Z"},"dct:title":{"@language":"sv","@value":"Bygglov 2025"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:6a37ae055dff4097c26de6a8e1928a4b1db0c63a59237e8db0b75c880321d52c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/230","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lomma.se/store/1/resource/14"},"dcat:distribution":{"@id":"https://catalog.lomma.se/store/1/resource/232"},"dcat:keyword":[{"@language":"en","@value":"Litter"},{"@language":"sv","@value":"Skräp"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Results from litter observations on the beach by Långa Bryggan for 2023. The observation area is 2000 square meters (100m x 20m). The results contain the type of litter, the category of litter and the number of pieces observed. Observations follow Håll Sverige Rents metods. For more information and report see https://studios.statisticon.se/skrapstatistik/#metod"},{"@language":"sv","@value":"Resultat från skräpmätning på en begränsad på Lomma stranden vid Långa Bryggan. Ytan som mäts är ca 2000 kvm (100m x 20m). Resultat innehåller typ av skräp, kategori and antal som har mätts under perioden. Mätningen görs enligt metoder från Håll Sverige Rent. Mer information och rapport finns här https://studios.statisticon.se/skrapstatistik/#metod"}],"dct:issued":{"@type":"xsd:date","@value":"2023-08-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:title":[{"@language":"en","@value":"Litter observations Långa Bryggan Lomma municipality"},{"@language":"sv","@value":"Skräpmätningar Långa Bryggan i Lomma kommun"}]},{"@id":"https://catalog.lomma.se/store/1/resource/231","@type":"http://entryscape.com/terms/File","dct:title":"Skräpmätning Långa Bryggan 2023.xlsx"},{"@id":"https://catalog.lomma.se/store/1/resource/232","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/231"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/231"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Litter observations Långa Bryggan 2023"},{"@language":"sv","@value":"Skräpmätningar Långa Bryggan 2023"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:6e6ca0e5c4041f51a4a568e43f0d04e99eb9721f243dda583546d24a1d77240b"},{"@graph":[{"@id":"_:70bef0b648ee99fbcd4be09f26332495923c496dc9a5c816f6bcedd827a82a93_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.976090028909738 55.73873198067557,13.114570620610166 55.73873198067557,13.114570620610166 55.64262555249127,12.976090028909738 55.64262555249127,12.976090028909738 55.73873198067557))"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/159","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lomma.se/store/1/resource/14"},"dcat:distribution":[{"@id":"https://catalog.lomma.se/store/1/resource/165"},{"@id":"https://catalog.lomma.se/store/1/resource/167"}],"dcat:keyword":{"@language":"sv","@value":"Översiktsplan"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:description":{"@language":"sv","@value":"Plan- och bygglagen (PBL) reglerar hur svenska kommuner ska arbeta med fysisk planering. Enligt PBL 3 kap 1 § ska varje kommun ha en aktuell översiktsplan som omfattar hela kommunen. Översiktsplanen är ett övergripande och strategiskt dokument som ska redogöra för kommunens långsiktiga utveckling, det vill säga hur kommunen vill använda, utveckla och bevara den fysiska miljön. Översiktsplanen är inte bindande men är ett betydelsefullt underlag för att skapa en god och hållbar samhällsutveckling.\n\nI översiktsplanen för Lomma kommun finns två markanvändningskartor. Den ena kallas Plankarta 2030 och visar det som är tänkt att genomföras fram till 2030. Den andra kartan kallas Långsiktig utvecklingsstrategi. Plankartan visar på en förändrad markanvändning jämfört med nuläget maj 2021.\n\nKartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. \nMer information om Översiktsplan 2020 för Lomma kommun finns här\nhttps://lomma.se/bygga-bo-och-miljo/oversiktsplan-och-detaljplaner/oversiktsplan/samtliga-dokument-till-oversiktsplan-2020.html"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:spatial":{"@id":"_:70bef0b648ee99fbcd4be09f26332495923c496dc9a5c816f6bcedd827a82a93_b0n0"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020  - Plankarta 2030"}},{"@id":"https://catalog.lomma.se/store/1/resource/164","@type":"http://entryscape.com/terms/File","dct:title":"op2020_plankarta_lomma.gpkg"},{"@id":"https://catalog.lomma.se/store/1/resource/165","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/164"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/164"},"dct:description":{"@language":"sv","@value":"Plankartan visar på en förändrad markanvändning jämfört med nuläget maj 2021. Kartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. I koordinatsystem Sweref 99 1330."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2023-03-15T11:57:52.968Z"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020 - Plankarta 2030"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/166","@type":"http://entryscape.com/terms/File","dct:title":"op2020_plankarta_lomma.zip"},{"@id":"https://catalog.lomma.se/store/1/resource/167","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/166"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/166"},"dct:description":{"@language":"sv","@value":"Plankartan visar på en förändrad markanvändning jämfört med nuläget maj 2021. Kartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. I koordinatsystem Sweref 99 1330. Shapefiler i en zippad mapp. Attributinformation begränsad till 254 tecken på grund av filformatets begränsningar."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020 - Plankarta 2030"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:70bef0b648ee99fbcd4be09f26332495923c496dc9a5c816f6bcedd827a82a93"},{"@graph":[{"@id":"_:70fa9ae770ac3b76f6b7a8a644e2784be63826fbcd779b56c9b3aebea9d4b012_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.007380277854768 55.7382797461061,13.10086524111996 55.7382797461061,13.10086524111996 55.65585481935169,13.007380277854768 55.65585481935169,13.007380277854768 55.7382797461061))"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/240","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lomma.se/store/1/resource/14"},"dcat:distribution":{"@id":"https://catalog.lomma.se/store/1/resource/242"},"dcat:keyword":[{"@language":"en","@value":"Cycling statistics"},{"@language":"sv","@value":"Cykelstatistik"}],"dct:description":[{"@language":"en","@value":"Three bicycle counters have been placed around the municipality to record passing cyclists. Data collection began in January 2025, and the statistics are calculated per day based on 24-hour intervals."},{"@language":"sv","@value":"Tre cykelmätare har placerats ut runt om i kommunen för att räkna passerande cyklister. Datainsamlingen startade i januari 2025 och statistiken beräknas per dygn, baserat på 24-timmarsintervall."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:spatial":{"@id":"_:70fa9ae770ac3b76f6b7a8a644e2784be63826fbcd779b56c9b3aebea9d4b012_b0n0"},"dct:title":[{"@language":"en","@value":"Cycling statistics for Lomma Municipality"},{"@language":"sv","@value":"Cykelstatistik över Lomma Kommun"}]},{"@id":"https://catalog.lomma.se/store/1/resource/242","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.lomma.se/store/1/resource/243"},{"@id":"https://catalog.lomma.se/store/1/resource/245"},{"@id":"https://catalog.lomma.se/store/1/resource/246"}],"dcat:downloadURL":[{"@id":"https://catalog.lomma.se/store/1/resource/243"},{"@id":"https://catalog.lomma.se/store/1/resource/245"},{"@id":"https://catalog.lomma.se/store/1/resource/246"}],"dct:description":[{"@language":"en","@value":"Three bicycle counters have been placed around the municipality to record passing cyclists. Data collection began in January 2024, and the statistics are calculated per day based on 24-hour intervals."},{"@language":"sv","@value":"Tre cykelmätare har placerats ut runt om i kommunen för att räkna passerande cyklister. Datainsamlingen startade i januari 2024 och statistiken beräknas per dygn, baserat på 24-timmarsintervall."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-01T08:39:49.112Z"},"dct:title":[{"@language":"en","@value":"Bicycle statistics for Lomma Municipality"},{"@language":"sv","@value":"Cykelstatistik över Lomma Kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/243","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":[{"@language":"en","@value":"Bicycle Statistics 2025"},{"@language":"sv","@value":"Cykelstatistik 2025"}]},{"@id":"https://catalog.lomma.se/store/1/resource/245","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":[{"@language":"en","@value":"Bicycle Statistic 2024"},{"@language":"sv","@value":"Cykelstatistik 2024"}]},{"@id":"https://catalog.lomma.se/store/1/resource/246","@type":"http://entryscape.com/terms/File","dct:title":[{"@language":"en","@value":"Bicycle Statistic 2026"},{"@language":"sv","@value":"Cykelstatistik 2026"}]}],"@id":"urn:source:70fa9ae770ac3b76f6b7a8a644e2784be63826fbcd779b56c9b3aebea9d4b012"},{"@graph":[{"@id":"_:729f36d73085137042f2ac425f8164817f34d7da9b747fc3bdbbd9ce0286f89a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.998587793286145 55.7389743463373,13.108570103009903 55.7389743463373,13.108570103009903 55.64221547306584,12.998587793286145 55.64221547306584,12.998587793286145 55.7389743463373))"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id"