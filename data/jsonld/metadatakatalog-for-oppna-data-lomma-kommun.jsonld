,"dct:modified":{"@type":"xsd:date","@value":"2022-10-10T06:53:39.483Z"},"dct:title":[{"@language":"en","@value":"Barbeque areas"},{"@language":"sv","@value":"Grillplatser"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://dataportal.se/specifications/grillplatser/1.0","@type":"dct:Standard","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/130/resource/1"},"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dct:description":{"@language":"sv","@value":"Med grillplats menas en särskilt anlagd eller skött allmän plats där man kan göra upp eld och/eller grilla i en särskilt anlagd härd.\n\nDenna specifikation definierar en enkel tabulär informationsmodell för grillplatser. Specifikationen innefattar också en beskrivning av hur informationen uttrycks i formatet CSV och JSON. Som grund förutsätts CSV kunna levereras då det är praktiskt format och skapar förutsägbarhet för mottagare av informationen. Det är också ett format som gör sammanställningen av datamängden enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}}],"@id":"urn:source:3fdff1398b6576eee9588d1c667f7e1b77c97feb61a7f87e40fc50271e3b3912"},{"@graph":[{"@id":"_:43251c38ac06ca9b96d539a0e6c756c369c9c413e9f3659766ae7e332c0191a4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.05825099009992 55.677314264601854,13.058594742937196 55.677314264601854,13.058594742937196 55.67638263245283,13.05825099009992 55.67638263245283,13.05825099009992 55.677314264601854))"}},{"@id":"_:43251c38ac06ca9b96d539a0e6c756c369c9c413e9f3659766ae7e332c0191a4_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2020-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/86","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://catalog.lomma.se/store/1/resource/88"},{"@id":"https://catalog.lomma.se/store/1/resource/90"},{"@id":"https://catalog.lomma.se/store/1/resource/92"}],"dcat:keyword":[{"@language":"en","@value":"litter"},{"@language":"sv","@value":"skräp"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Results from yearly litter observations on Lomma Beach from 2020 onwards. The observation area is 2000 square meters (100m x 20m). The results contain the type of litter, the category of litter and the number of pieces observed. Observations follow Håll Sverige Rents metods. For more information and report see https://studios.statisticon.se/skrapstatistik/#metod"},{"@language":"sv","@value":"Årlig resultat från skräpmätning på en begränsad yta på Lomma Beach sedan 2020. Ytan som mäts är ca 2000 kvm (100m x 20m). Resultat innehåller typ av skräp, kategori and antal som har mätts under perioden. Mätningen görs enligt metoder från Håll Sverige Rent. Mer information och rapport finns här https://studios.statisticon.se/skrapstatistik/#metod"}],"dct:issued":{"@type":"xsd:date","@value":"2022-11-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:spatial":{"@id":"_:43251c38ac06ca9b96d539a0e6c756c369c9c413e9f3659766ae7e332c0191a4_b0n0"},"dct:temporal":{"@id":"_:43251c38ac06ca9b96d539a0e6c756c369c9c413e9f3659766ae7e332c0191a4_b1n0"},"dct:title":[{"@language":"en","@value":"Litter oberservation Lomma Beach"},{"@language":"sv","@value":"Skräpmätning Lomma Beach"}]},{"@id":"https://catalog.lomma.se/store/1/resource/87","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Skräpmätning Lomma Beach 2020.csv"},{"@id":"https://catalog.lomma.se/store/1/resource/88","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/87"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/87"},"dct:description":[{"@language":"en","@value":"Type of area: Sand/stone\nNumber of observations: 37\nPeriod: 1st July - 14 August 2020\nNumber of days under observation: 45\nSize of observation area: 100 x 20 m, 2000 square meters"},{"@language":"sv","@value":"Typ av mätyta: Sand/sten\nAntal mättillfällen: 37\nPeriod: 1 juli - 14 aug 2020\nAntal dagar under perioden: 45\nStorlek på yta: Ca 100 x 20 m, 2000 kvm"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-23T13:09:21.840Z"},"dct:title":[{"@language":"en","@value":"Litter observations Lomma Beach 2020"},{"@language":"sv","@value":"Skräpmätning Lomma Beach 2