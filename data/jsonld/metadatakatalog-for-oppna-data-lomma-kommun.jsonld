","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"hundlatrin.csv"},{"@id":"https://catalog.lomma.se/store/1/resource/136","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/135"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/135"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-12-20T11:56:42.509Z"},"dct:title":[{"@language":"en","@value":"Dog waste bins"},{"@language":"sv","@value":"Hundlatriner"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}}],"@id":"urn:source:82f5131280624f1a8c1b41dbdaa1cb35718f9a363fee16e69c840f52684047ab"},{"@graph":[{"@id":"_:8ba17f1e21199e757046121e087c77142c1c044268c7cc3df29a3ec42fc04260_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.971057666282672 55.735551067001666,13.122525035403426 55.735551067001666,13.122525035403426 55.63949519081348,12.971057666282672 55.63949519081348,12.971057666282672 55.735551067001666))"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/161","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lomma.se/store/1/resource/14"},"dcat:distribution":[{"@id":"https://catalog.lomma.se/store/1/resource/171"},{"@id":"https://catalog.lomma.se/store/1/resource/173"}],"dcat:keyword":{"@language":"sv","@value":"översiktsplan"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Plan- och bygglagen (PBL) reglerar hur svenska kommuner ska arbeta med fysisk planering. Enligt PBL 3 kap 1 § ska varje kommun ha en aktuell översiktsplan som omfattar hela kommunen. Översiktsplanen är ett övergripande och strategiskt dokument som ska redogöra för kommunens långsiktiga utveckling, det vill säga hur kommunen vill använda, utveckla och bevara den fysiska miljön. Översiktsplanen är inte bindande men är ett betydelsefullt underlag för att skapa en god och hållbar samhällsutveckling.\n\nI översiktsplanen för Lomma kommun finns två markanvändningskartor. Den ena kallas Plankarta 2030 och visar det som är tänkt att genomföras fram till 2030. Den andra kartan kallas Långsiktig utvecklingsstrategi. Kartan Långsiktig utvecklingsstrategi visar schematiskt på den utveckling som Lomma kommun på lång sikt, det vill säga efter 2030, önskar för bebyggelse, infrastruktur och naturvärden.\nKartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. \n\nMer information om Översiktsplan 2020 för Lomma kommun finns här\n\nhttps://lomma.se/bygga-bo-och-miljo/oversiktsplan-och-detaljplaner/oversiktsplan/samtliga-dokument-till-oversiktsplan-2020.html"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001066"},"dct:spatial":{"@id":"_:8ba17f1e21199e757046121e087c77142c1c044268c7cc3df29a3ec42fc04260_b0n0"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020 - Långsiktig utvecklingsstrategi"}},{"@id":"https://catalog.lomma.se/store/1/resource/170","@type":"http://entryscape.com/terms/File","dct:title":"op2020_langsiktig_utvecklingsstrategi_lomma.gpkg"},{"@id":"https://catalog.lomma.se/store/1/resource/171","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/170"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/170"},"dct:description":{"@language":"sv","@value":"Kartan Långsiktig utvecklingsstrategi visar schematiskt på den utveckling som Lomma kommun på lång sikt, det vill säga efter 2030, önskar för bebyggelse, infrastruktur och naturvärden. Kartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. I koordinatsystem Sweref 99 1330."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020 - Långsiktig utvecklingsstrategi"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.lomma.se/store/1/resource/172","@type":"http://entryscape.com/terms/File","dct:title":"op2020_langsiktig_utvecklingsstrategi_lomma.zip"},{"@id":"https://catalog.lomma.se/store/1/resource/173","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.lomma.se/store/1/resource/172"},"dcat:downloadURL":{"@id":"https://catalog.lomma.se/store/1/resource/172"},"dct:description":{"@language":"sv","@value":"Kartan Långsiktig utvecklingsstrategi visar schematiskt på den utveckling som Lomma kommun på lång sikt, det vill säga efter 2030, önskar för bebyggelse, infrastruktur och naturvärden. Kartunderlaget är framtaget för att användas i skalor mellan 1:60 000 och 1:15 000. I koordinatsystem Sweref 99 1330. Shapefiler i en zippad mapp. Attributinformation begränsad till 254 tecken på grund av filformatets begränsningar."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Översiktsplan 2020 - Långsiktig utvecklingsstrategi"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:8ba17f1e21199e757046121e087c77142c1c044268c7cc3df29a3ec42fc04260"},{"@graph":[{"@id":"_:8ebb6903e267695b1ba080e5543cdbe401c7a510f1cdc0994c0a9227dfd68248_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.982684775842046 55.757316461101084,13.115730857893066 55.757316461101084,13.115730857893066 55.6405958540895,12.982684775842046 55.6405958540895,12.982684775842046 55.757316461101084))"}},{"@id":"http://dataportal.se/organisation/SE2120001066","@type":"foaf:Agent","dct:identifier":"2120001066","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@lomma.se"},"foaf:name":{"@language":"sv","@value":"Lomma kommun"},"foaf:page":{"@id":"https://lomma.se/"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.lomma.se/store/1/resource/1"}},{"@id":"https://catalog.lomma.se/store/1/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data kontakt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@lomma.se"}},{"@id":"https://catalog.lomma.se/store/1/resource/198","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.lomma.se/store/1/resource/14"},"dcat:distribution":[{"@id":"https://catalog.lomma.se/store/1/resource/200"},{"@id":"https://catalog.lomma.se/store/1/resource/202"}],"dcat:keyword":[{"@language":"en","@value":"Planning"},{"@language":"sv","@value":"Detaljplan"},{"