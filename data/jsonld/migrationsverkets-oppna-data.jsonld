},"dct:modified":{"@type":"xsd:date","@value":"2022-09-16"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002163"},"dct:title":{"@language":"sv","@value":"Beviljade arbetstillstånd"}}],"@id":"urn:source:1a528c828a174febac4cf8ab204c498bdf1f2f144658862513c76d6a4d1146a6"},{"@graph":[{"@id":"https://www.migrationsverket.se/datasets/dcat#migrationsverket","@type":["dcat:Catalog","http://www.w3.org/2006/vcard/ns#Organisation"],"dcat:dataset":[{"@id":"https://www.migrationsverket.se/datasets/dcat#ds1"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds10"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds11"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds12"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds13"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds14"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds15"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds2"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds3"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds4"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds5"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds6"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds7"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds8"},{"@id":"https://www.migrationsverket.se/datasets/dcat#ds9"}],"dcat:keyword":["Arbetstillstånd","Asyl","Migrationsverket","Tillstånd","Uppehållstillstånd"],"dcat:landingPage":{"@id":"https://www.migrationsverket.se/PSIDATA"},"dct:description":"Information som framställs eller samlas in av myndigheter har ofta användningsområden utanför den offentliga förvaltningen. Olika aktörer i samhället kan vidareutnyttja informationen för att skapa kommersiella eller ideella tjänster. På den här sidan hittar du den information som är tillgänglig som Öppna data hos Migrationsverket.\n\t\t\n\t\tJust nu är de öppna data begränsade till den officiella statistik som också publiceras på våra statistiksidor här på webben. Migrationsverket har naturligtvis mer information än detta. Men antingen har den ännu inte klassificerats som möjlig att publicera eller också kan vi inte lämna ut den eftersom den innehåller personuppgifter, sekretessbelagd information, upphovsrättsskyddat material eller skyddas av speciallagstiftning.\n\n\t\tAnsvarig för öppna data på Migrationsverket är enheten för statistik och analys.\n\n\t\tDen här typen av vidareutnyttjande av myndighetsinformation regleras i PSI-lagen. PSI står för Public Sector Information.\n\t\t","dct:issued":{"@type":"xsd:date","@value":"2022-09-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-09-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002163"},"dct:title":{"@language":"sv","@value":"Migrationsverkets öppna data"},"foaf:homepage":{"@id":"http://www.migrationsverket.se/psidata"},"http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Migrationsverket"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:migrationsverket@migrationsverket.se"}}],"@id":"urn:source:23b589d6e27756bd8d5f666341962fd4a3f65e8222a68c3954c569297564ba08"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021002163","@type":"foaf:Agent","dct:identifier":"2021002163","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:migrationsverket@migrationsverket.se"},"foaf:name":{"@language":"sv","@value":"Migrationsverket"},"foaf:page":{"@id":"https://www.migrationsverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.migrationsverket.se/datasets/dcat_foaf#migrationsverket"}},{"@id":"https://www.migrationsverket.se/datasets/dcat#distribution3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.migrationsverket.se/oppna-data/inskrivna-personer-i-mottagningssystemet"},"dct: