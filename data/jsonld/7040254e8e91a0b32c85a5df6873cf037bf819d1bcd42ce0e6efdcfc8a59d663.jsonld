t-sv-t0-mtec","@value":"Εφαρμογή χάρτη"},{"@language":"en-t-sv-t0-mtec","@value":"Map application"},{"@language":"es-t-sv-t0-mtec","@value":"Aplicación de mapas"},{"@language":"et-t-sv-t0-mtec","@value":"Kaardirakendus"},{"@language":"fi-t-sv-t0-mtec","@value":"Karttasovellus"},{"@language":"fr-t-sv-t0-mtec","@value":"Application de la carte"},{"@language":"ga-t-sv-t0-mtec","@value":"Feidhmchlár léarscáile"},{"@language":"hr-t-sv-t0-mtec","@value":"Aplikacija zemljovida"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképes alkalmazás"},{"@language":"it-t-sv-t0-mtec","@value":"Applicazione della mappa"},{"@language":"lt-t-sv-t0-mtec","@value":"Žemėlapio taikomoji programa"},{"@language":"lv-t-sv-t0-mtec","@value":"Kartes pieteikums"},{"@language":"mt-t-sv-t0-mtec","@value":"Applikazzjoni tal-mappa"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarttoepassing"},{"@language":"pl-t-sv-t0-mtec","@value":"Aplikacja mapowa"},{"@language":"pt-t-sv-t0-mtec","@value":"Aplicação de mapas"},{"@language":"ro-t-sv-t0-mtec","@value":"Aplicație pentru hărți"},{"@language":"sk-t-sv-t0-mtec","@value":"Aplikácia máp"},{"@language":"sl-t-sv-t0-mtec","@value":"Aplikacija zemljevida"},{"@language":"uk-t-sv-t0-mtec","@value":"Додаток для мап"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/d8d89280-19ff-4731-a071-4d6c911170df"}},{"@id":"http://data.europa.eu/88u/record/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/a4a83f84-1a2f-4a80-9c05-709fb27847e1"},{"@id":"http://data.europa.eu/88u/distribution/d8d89280-19ff-4731-a071-4d6c911170df"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:04Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:45Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7"},"http://spdx.o