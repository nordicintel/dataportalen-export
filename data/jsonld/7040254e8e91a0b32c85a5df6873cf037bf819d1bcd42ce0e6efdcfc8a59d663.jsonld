ons.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"För att följa klimatförändringar krävs tillgång till långa tidsserier med väderdata för flera decennier. Stockholms klimat- och väderstatistik baseras främst på data från SMHI:s mätstation vid Observatorielunden. Den hydrologiska statistiken (vatten) hämtas från olika mätstationer i Mälaren och Saltsjön. Med hjälp av de långa mätserierna går det att uppskatta trender och naturlig variation."},"dct:identifier":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2f80a108b54a212f3ebed6d3fe29fff37afbaa359a8cac0234fa900f9ff68b06_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Klimat - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/klimat/"},"dct:format":{"@id":"http://publications.europa.eu/resource/autho