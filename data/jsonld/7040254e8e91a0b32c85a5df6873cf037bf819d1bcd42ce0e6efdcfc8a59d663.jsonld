+Avfall/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis@svoa.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-52212000"}}],"@id":"urn:source:45f642248886a39e09aed94592861ca7af15f0659957265d36464ac600d2f1fc"},{"@graph":[{"@id":"_:46acea5bfbbb43c41629e916d1f0adcf5f77777f0082d395193c42740f72ce39_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4407,18.2011 59.4407,18.2011 59.2272,17.7605 59.2272,17.7605 59.4407))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4407,18.2011 59.4407,18.2011 59.2272,17.7605 59.2272,17.7605 59.4407))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/c1aca559-4174-411e-b7d7-433fcfdae554","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/c1aca559-4174-411e-b7d7-433fcfdae554#HTTP:ESRI+Portal-URL/2"},{"@id":"https://resources.stockholm.se/data/c1aca559-4174-411e-b7d7-433fcfdae554#HTTP:ESRI+Portal-URL/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=42eeca58-5864-4c86-b7f2-2333f1614c3a"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2017-12-31"},"dct:description":{"@language":"sv","@value":"Ekområden och punktskiktet ekar från 2006 uppdaterats 2017 med hjälp av nya fältinventeringar och flygbildstolkning utifrån skötselaspekter, samt komplettering med nyfunna jätteekar. Shp-filen Kärnområden är dock densamma som skapades 2007 utifrån inventeringen 2006, eftersom inga nya värdeklassningar har gjorts inom projektet.  Polygonerna visar områden med kluster av ekområden och karterade ekar som bedömts som kärnområden för Stockholm stads Ekmiljöer. Buffertzoner på 250 m gjorda runt alla klass- 1 och 2-ekar från punktskiktet ”Ekar” har legat till grund för den geografiska avgränsningen. Övriga kriterier har varit förekomst minst en klass 1- ekområde i ett kärnområde samt totalt minst 30 grova ekar av klass 1-3, varav minst 10 värdefulla ekar av klass 1-2. Mer information; Data har framställts för projektet ”Stockholms Unika Ekmiljöer” på uppdrag av markkontoret, Stockholms Stad. Beskrivning av metoden finns i Rapporten ”Stockholms unika ekmiljöer – Metodutveckling och litteraturstudie 2006-10-01”. Analysresultat samt mer information finns i slutrapport ”Stockholms unika ekmiljöer – Förekomst, bevarande och utveckling” skriven av Ekologigruppen AB, maj 2007. "},"dct:identifier":"c1aca559-4174-411e-b7d7-433fcfdae554","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:46acea5bfbbb43c41629e916d1f0adcf5f77777f0082d395193c42740f72ce39_b0n0"},"dct:title":{"@language":"sv","@value":"Ekdatabasen 2017"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c1aca559-4174-411e-b7d7-433fcfdae554#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/2cb5abfb66eb4bb1916a9606124c38ed/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/c1aca559-4174-411e-b7d7-433fcfdae554#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:46acea5bfbbb43c41629e916d1f0adcf5f77777f0082d395193c42740f72ce39"},{"@graph":[{"@id":"https://resources.stockholm.se/data/923424fb-f37a-4914-bdf7-bf52e686a45f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/923424fb-f37a-4914-bdf7-bf52e686a45f#HTTP:API/2"},{"@id":"https://resources.stockholm.se/data/923424fb-f37a-4914-bdf7-bf52e686a45f#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/923424fb-f37a-4914-bdf7-bf52e686a45f#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/923424fb-f37a-4914-bdf7-bf52e686a45f#HTTP:OGC:WMS/4"}],"dcat:keyword":["Stockholm Vatten och Avfall",{"@language":"sv","@value":"Extern data