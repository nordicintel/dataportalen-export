 WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/5efb2f6e-53d3-43af-8c11-bafd9972a432#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=NVDB_Vagnummer"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:7a0925c6f72c35cdea3ec5b342c5317362ef72a7b3a51cfc96cbe0bd779d2461"},{"@graph":[{"@id":"_:7a3b3c8fe94cdf54fbebe1a44c139d92a70f3233dba880daa2678593d1637e2f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.9476 59.4055,17.9514 59.4055,17.9514 59.4041,17.9476 59.4041,17.9476 59.4055))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.9476 59.4055,17.9514 59.4055,17.9514 59.4041,17.9476 59.4041,17.9476 59.4055))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/3a49a308-610f-400e-a0e4-7d33af0273bd","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=c6c283d2-d167-4e72-9b6f-d744e12072ce"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"DETTA ÄR EN TILLFÄLLIG METADATAPOST FÖR ATT TESTA HUR MAN KAN DOKUMENTERA IoT-SENSORER. Datamängden innehåller alla koldioxid-sensorerna av typen NDIR av SENSAIR i Stockholms stad (just nu är det dock exakt två testsensorer uppkopplade) Sensorn mäter koldioxid (ppm, eller parts per million) i den omgivande luften."},"dct:identifier":"3a49a308-610f-400e-a0e4-7d33af0273bd","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7a3b3c8fe94cdf54fbebe1a44c139d92a70f3233dba880daa2678593d1637e2f_b0n0"},"dct:title":{"@language":"sv","@value":"SBK IoT Sensor - Luftkvalitetsmätare (test)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:7a3b3c8fe94cdf54fbebe1a44c139d92a70f3233dba880daa2678593d1637e2f"},{"@graph":[{"@id":"_:7a69679f0c1d9ba90610889580aba2954fc985db0a26a6c0175930ef25a11159_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:7a69679f0c1d9ba90610889580aba2954fc985db0a26a6c0175930ef25a11159_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"113960b1516893560a95b5456c83fd17ee"},{"@id":"http://data.europa.eu/88u/dataset/3243b6eb-1355-47f1-a40e-e0ee5bfe2839","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/bdbf608f-b944-4dcc-b59f-60163879befb"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0cfdd37e-ad8c-4994-984e-b46d0a77a3fa"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Съоръженията за опазване на околната среда се състоят от следните обекти и подтипове (за текущия списък вж. базовата карта на общата продуктова спецификация): Съоръжения за опазване на околната среда: 10, Кошче за компост (непълно, неотложено); 20, станция за рециклиране."},{"@language":"cs-t-sv-t0-mtec","@value":"Environmentální zařízení se skládají z následujících objektů a podtypů (aktuální seznam viz základní mapa obecných specifikací produktu): Environmentální zařízení: 10, koš na kompost (neúplný, nepřerušený); 20, Recyklační stanice."},{"@language":"da-t-sv-t0-mtec","@value":"Miljøanlæg består af følgende objekter og undertyper (se basiskortet for generelle produktspecifikationer for den aktuelle liste): Miljømæssige faciliteter: 10, Kompost bin, (ufuldstændig, ikke udsat); 20, genbrugsstation."},{"@language":"de-t-sv-t0-mtec","@value":"Umwelteinrichtungen bestehen aus folgenden Objekten und Untertypen (für die aktuelle Liste siehe Basiskarte der allgemeinen Produktspezifikation): Umwelteinrichtungen: 10, Kompost bin, (unvollständig, nicht vertagt); 20, Recycling-Station."},{"@language":"el-t-sv-t0-mtec","@value":"Οι περιβαλλοντικές εγκαταστάσεις αποτελούνται από τα ακόλουθα αντικείμενα και υποτύπους (για τον τρέχοντα κατάλογο βλέπε χάρτη βάσης γενικών προδιαγραφών προϊόντος): Περιβαλλοντικές εγκαταστάσεις: 10, κάδος κομποστοποίησης, (ελλιπής, δεν έχει αναβληθεί)· 20, Σταθμός ανακύκλωσης."},{"@language":"en-t-sv-t0-mtec","@value":"Environmental facilities consist of the following object and subtypes (for the current list see General Product Specification Base Map): Environmental facilities: 10, Compost bin, (incomplete, not adjourned); 20, Recycling station."},{"@language":"es-t-sv-t0-mtec","@value":"Las instalaciones medioambientales consisten en los siguientes objetos y subtipos (para la lista actual, véase el mapa base de las especificaciones generales del producto): Instalaciones medioambientales: 10, compartimiento de compost, (incompleto, no aplazado); 20, Estación de reciclaje."},{"@language":"et-t-sv-t0-mtec","@value":"Keskkonnarajatised koosnevad järgmistest objektidest ja alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaart): Keskkonnarajatised: 10, Komposti prügikast, (mittetäielik, mitte edasilükatud); 20, ringlussevõtu jaam."},{"@language":"fi-t-sv-t0-mtec","@value":"Ympäristölaitokset koostuvat seuraavista kohteista ja alatyypeistä (nykyisestä luettelosta katso yleinen tuote-eritelmän peruskartta): Ympäristölaitokset: 10, kompostisäiliö (keskeneräinen, ei lykätty); 20, Kierrätysasema."},{"@language":"fr-t-sv-t0-mtec","@value":"Les installations environnementales se composent des objets et sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): Installations environnementales: 10, Compost bin, (incomplet, non ajourné); 20, station de recyclage."},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard atá i saoráidí comhshaoil na réada agus na fochineálacha seo a leanas (le haghaidh an liosta reatha féach Bunléarscáil Sonraíochta Táirge Ginearálta): Saoráidí comhshaoil: 10, Araid mhúirín, (neamhiomlán, gan a bheith curtha ar atráth); 20, Stáisiún athchúrsála."},{"@language":"hr-t-sv-t0-mtec","@value":"Okolišna postrojenja sastoje se od sljedećih objekata i podvrsta (za trenutačni popis vidjeti Osnovnu kartu opće specifikacije proizvoda): Postrojenja za zaštitu okoliša: 10, kantu za kompost (nepotpunu, neodgodivu); 20, stanica za recikliranje."},{"@language":"hu-t-sv-t0-mtec","@value":"A környezetvédelmi létesítmények a következő objektumokból és altípusokból állnak (az aktuális listát lásd az Általános Termékleírási Alaptérképen): Környezetvédelmi létesítmények: 10, Komposztdoboz, (nem teljes, nincs elnapolva); 20, újrahasznosító állomás."},{"@language":"it-t-sv-t0-mtec","@value":"Gli impianti ambientali sono costituiti dai seguenti oggetti e sottotipi (per l'elenco attuale si veda la mappa di base delle specifiche generali del prodotto): Strutture ambientali: 10, Compost bin, (incompleto, non aggiornato); 20, stazione di riciclaggio."},{"@language":"lt-t-sv-t0-mtec","@value":"Aplinkos įrenginius sudaro toliau nurodyti objektai ir potipiai (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): Aplinkosaugos įrenginiai: 10, komposto dėžė, (neužbaigta, nenutraukta); 20, perdirbimo stotis."},{"@language":"lv-t-sv-t0-mtec","@value":"Vides objekti sastāv no šādiem objektiem un apakštipiem (pašreizējo sarakstu sk. vispārējā produkta specifikācijas bāzes kartē): Vides iekārtas: 10, komposta tvertne (nepilnīga, nav pārtraukta); 20, Otrreizējās pārstrādes stacija."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-faċilitajiet ambjentali jikkonsistu mill-oġġett u s-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): Faċilitajiet ambjentali: 10, Compost bin, (mhux komplut, mhux aġġornat); 20, Stazzjon tar-riċiklaġġ."},{"@language":"nl-t-sv-t0-mtec","@value":"Milieufaciliteiten bestaan uit de volgende objecten en subtypen (zie voor de huidige lijst de basiskaart van de algemene productspecificatie): Milieuvoorzieningen: 10, Compost bin, (onvolledig, niet verdaagd); 20, Recycling station."},{"@language":"pl-t-sv-t0-mtec","@value":"Obiekty środowiskowe składają się z następujących obiektów i podtypów (aktualna lista znajduje się na mapie podstawowej specyfikacji produktu): Infrastruktura środowiskowa: 10, pojemnik na kompost (niekompletny, nie odroczony); 20, stacja recyklingu."},{"@language":"pt-t-sv-t0-mtec","@value":"As instalações ambientais consistem nos seguintes objetos e subtipos (para a lista atual, ver o mapa de base das especificações gerais do produto): Instalações ambientais: 10, caixote do lixo, (incompleto, não adiado); 20, Estação de reciclagem."},{"@language":"ro-t-sv-t0-mtec","@value":"Instalațiile de mediu constau în următoarele obiecte și subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): Instalații de mediu: 10, Compost bin, (incomplet, neamânat); 20, stație de reciclare."},{"@language":"sk-t-sv-t0-mtec","@value":"Environmentálne zariadenia pozostávajú z týchto objektov a podtypov (pre aktuálny zoznam pozri základnú mapu všeobecných špecifikácií výrobku): Environmentálne zariadenia: 10, kompostový kôš, (neúplný, neodložený); 20, Recyklačná stanica."},{"@language":"sl-t-sv-t0-mtec","@value":"Okoljske objekte sestavljajo naslednji objekti in podtipi (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): Okoljski objekti: 10, kompostni koš (nepopoln, ni preložen); 20, reciklažna postaja."},{"@language":"sv","@value":"Miljöanläggningar består av följande objekt- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan) : Miljöanläggningar: 10, Kompostfack, (ofullständigt, ajourhålls ej); 20, Återvinningsstation."},{"@language":"uk-t-sv-t0-mtec","@value":"Екологічні об'єкти складаються з наступних об'єктів і підтипів (для поточного списку див. Екологічні об'єкти: 10, Compost bin, (неповний, не відкладений); 20, станція переробки."}],"dct:format":"text/html","dct:identifier":"3243b6eb-1355-47f1-a40e-e0ee5bfe2839","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7a69679f0c1d9ba90610889580aba2954fc985db0a26a6c0175930ef25a11159_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Съоръжения за опазване на околната среда"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Ekologická zařízení"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Miljømæssige faciliteter"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Umweltanlagen"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Base map - Περιβαλλοντικές εγκαταστάσεις"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Environmental facilities"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Instalaciones medioambientales"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Baaskaart - Keskkonnarajatised"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Ympäristötilat"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base - Installations environnementales"},{"@language":"ga-t-sv-t0-mtec","@value":"Bunmhapa SBK - Saoráidí comhshaoil"},{"@language":"hr-t-sv-t0-mtec","@value":"Bazna karta SBK - Okolišni objekti"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Környezeti létesítmények"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa di base - Strutture ambientali"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Aplinkos įrenginiai"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Base map - Vides objekti"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Base map - Faċilitajiet ambjentali"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Milieuvoorzieningen"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Base map - Obiekty ochrony środowiska"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa de base SBK - Instalações ambientais"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta bazei SBK - Facilități de mediu"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Základná mapa - Environmentálne zariadenia"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Osnovni zemljevid - Okoljski objekti"},{"@language":"sv","@value":"SBK Baskarta - Miljöanläggningar"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Базова карта - Екологічні об'єкти"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/bdbf608f-b944-4dcc-b59f-60163879befb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/3243b6eb-1355-47f1-a40e-e0ee5bfe2839#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Baskarta (1:400  - 1:2000).",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продуктовата базова карта (1:400 - 1:2000)."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktové Základní mapy (1:400 - 1:2000)."},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktbasen (1:400 - 1:2000)."},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Basiskarte (1:400 - 1:2000) enthalten."},{"@language":"el-t-sv-t0-mtec","@value":"Το σύνολο δεδομένων περιλαμβάνεται στον χάρτη βάσης προϊόντος (1:400 - 1:2000)."},{"@language":"en-t-sv-t0-mtec","@value":"The data set is included in the product Base map (1:400 - 1:2000)."},{"@language":"es-t-sv-t0-mtec","@value":"El conjunto de datos se incluye en el mapa base del producto (1:400 - 1:2000)."},{"@language":"et-t-sv-t0-mtec","@value":"Andmekogum sisaldub toote aluskaardil (1:400 - 1:2000)."},{"@language":"fi-t-sv-t0-mtec","@value":"Aineisto sisältyy tuotteen peruskarttaan (1:400 - 1:2000)."},{"@language":"fr-t-sv-t0-mtec","@value":"L'ensemble de données est inclus dans la carte de base du produit (1:400 - 1:2000)."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an tacar sonraí san áireamh sa bhunléarscáil táirge (1:400 - 1:2000)."},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka uključen je u kartu proizvoda Baza (1:400 - 1:2000)."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatkészlet megtalálható a termék alaptérképén (1:400 - 1:2000)."},{"@language":"it-t-sv-t0-mtec","@value":"Il set di dati è incluso nella mappa di base del prodotto (1:400 - 1:2000)."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rinkinys įtrauktas į gaminio bazinį žemėlapį (1:400 - 1:2000)."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu kopa ir iekļauta produktu bāzes kartē (1:400 - 1:2000)."},{"@language":"mt-t-sv-t0-mtec","@value":"Is-sett tad-data huwa inkluż fil-mappa tal-bażi tal-prodott (1:400 - 1:2000)."},{"@language":"nl-t-sv-t0-mtec","@value":"De gegevensset is opgenomen in de productbasiskaart (1:400 - 1:2000)."},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się na mapie bazowej produktu (1:400 - 1:2000)."},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no mapa de base do produto (1:400 - 1:2000)."},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în harta de bază a produsului (1:400 - 1:2000)."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový súbor je súčasťou produktu Základná mapa (1:400 - 1:2000)."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov je vključen v osnovni zemljevid izdelka (1:400 - 1:2000)."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних входить до базової карти продукту (1:400 - 1:2000)."}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/bdbf608f-b944-4dcc-b59f-60163879befb"}},{"@id":"http://data.europa.eu/88u/record/3243b6eb-1355-47f1-a40e-e0ee5bfe2839","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/bdbf608f-b944-4dcc-b59f-60163879befb"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"3243b6eb-1355-47f1-a40e-e0ee5bfe2839","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:22Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/3243b6eb-1355-47f1-a40e-e0ee5bfe2839"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7a69679f0c1d9ba90610889580aba2954fc985db0a26a6c0175930ef25a11159_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/3243b6eb-1355-47f1-a40e-e0ee5bfe2839"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:22Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"3243b6eb-1355-47f1-a40e-e0ee5bfe2839","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/3243b6eb-1355-47f1-a40e-e0ee5bfe2839"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:7a69679f0c1d9ba90610889580aba2954fc985db0a26a6c0175930ef25a11159"},{"@graph":[{"@id":"_:7b5a3a4f0428b43f3996b17d137406ded2a6852ef45f780282a37daa43709970_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:7b5a3a4f0428b43f3996b17d137406ded2a6852ef45f780282a37daa43709970_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"ecb3fb9522362aabe4ccec03a70cd9282"},{"@id":"http://data.europa.eu/88u/dataset/815e34df-829f-498b-a358-048c431b3602","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/91861e43-418f-4dc9-96bd-0fcaaa8407a2"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=54fae749-6488-4b9c-a22b-01a2bb71338e"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Парковите съоръжения се състоят от следните обекти и подтипове (за текущия списък вж. основната карта на общата продуктова спецификация): Спортни съоръжения: 280, Футболен гол (непълен, неотложен). Парково съоръжение: 10, паркова пейка (непълна, неотложена); 20, оборудване за възпроизвеждане (непълно, не на повикване); 30, Статуя (непълна, неотложена); 40, Flagpole (непълен, неотложен)."},{"@language":"cs-t-sv-t0-mtec","@value":"Parkovací zařízení se skládají z následujících objektů a podtypů (aktuální seznam viz základní mapa obecné specifikace produktu): Sportovní zařízení: 280, fotbalový gól (neúplný, nepřerušený). Parkovací zařízení: 10, lavička v parku (neúplná, nepřerušená); 20, hrací zařízení (neúplné, ne na vyžádání); 30, Socha (neúplná, nepřerušená); 40, Flagpole (neúplné, nepřerušené)."},{"@language":"da-t-sv-t0-mtec","@value":"Parkfaciliteterne består af følgende objekt- og undertyper (den aktuelle liste findes i basiskortet over generelle produktspecifikationer): Idrætsfaciliteter: 280, Fodbold mål (ufuldstændig, ikke afbrudt). Parkanlæg: 10, Park bænk (ufuldstændig, ikke udsat); 20, Play udstyr (ufuldstændig, ikke på opkald); 30, Statue (ufuldstændig, ikke udsat); 40, Flagstang (ufuldstændig, ikke udsat)."},{"@language":"de-t-sv-t0-mtec","@value":"Parkeinrichtungen bestehen aus folgenden Objekten und Untertypen (für die aktuelle Liste siehe Basiskarte der allgemeinen Produktspezifikation): Sportanlagen: 280, Fußballtor (unvollständig, nicht vertagt). Parkanlage: 10, Parkbank (unvollständig, nicht vertagt); 20, Spielgeräte (unvollständig, nicht auf Abruf); 30, Statue (unvollständig, nicht vertagt); 40, Fahnenmast (unvollständig, nicht vertagt)."},{"@language":"el-t-sv-t0-mtec","@value":"Οι εγκαταστάσεις πάρκων αποτελούνται από το ακόλουθο αντικείμενο και τους υποτύπους (για τον τρέχοντα κατάλογο βλέπε γενικό χάρτη βάσεων προδιαγραφών προϊόντων): Αθλητικές εγκαταστάσεις: 280, Ποδόσφαιρο γκολ (ελλιπές, δεν αναβλήθηκε). Εγκατάσταση πάρκου: 10, παγκάκι πάρκου (ελλιπές, δεν έχει διακοπεί)· 20, εξοπλισμός παιχνιδιού (ελλιπής, όχι εφημερία)· 30, Άγαλμα (ελλιπές, δεν έχει αναβληθεί)· 40, Flagpole (ελλιπές, δεν έχει διακοπεί)."},{"@language":"en-t-sv-t0-mtec","@value":"Park facilities consist of the following object and subtypes(for the current list see General Product Specification Base Map): Sports facilities: 280, Football goal (incomplete, not adjourned). Park facility: 10, Park bench (incomplete, not adjourned); 20, Play equipment (incomplete, not on call); 30, Statue (incomplete, not adjourned); 40, Flagpole (incomplete, not adjourned)."},{"@language":"es-t-sv-t0-mtec","@value":"Las instalaciones del parque consisten en los siguientes objetos y subtipos (para la lista actual, consulte el Mapa Base de Especificaciones Generales del Producto): Instalaciones deportivas: 280, Gol de fútbol (incompleto, no aplazado). Instalaciones del parque: 10, banco del parque (incompleto, no aplazado); 20, Equipo de juego (incompleto, no disponible); 30, Estatua (incompleta, no aplazada); 40, Flagpole (incompleto, no aplazado)."},{"@language":"et-t-sv-t0-mtec","@value":"Parkimisrajatised koosnevad järgmistest objektidest ja alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaarti): Spordirajatised: 280, Jalgpallivärav (mittetäielik, mitte edasilükatud). Parkimiskoht: 10, pargipink (mittetäielik, edasilükkamata); 20, mänguvarustus (mittekomplektne, ei ole valves); 30, kuju (mittetäielik, edasilükkamata); 40, Flagpole (mittetäielik, edasilükkamata)."},{"@language":"fi-t-sv-t0-mtec","@value":"Puistotilat koostuvat seuraavista kohteista ja alatyypeistä (nykyisestä luettelosta katso yleinen tuote-eritelmän peruskartta): Urheilutilat: 280, Jalkapallo maali (epätäydellinen, ei keskeytetty). Puistotilat: 10, Park penkki (epätäydellinen, ei keskeytetty); 20, leikkivälineet (epätäydellinen, ei päivystys); 30, patsas (keskeneräinen, ei lykätty); 40, Flagpole (epätäydellinen, ei lykätty)."},{"@language":"fr-t-sv-t0-mtec","@value":"Les installations du parc se composent des objets et sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): Installations sportives: 280, but de football (incomplet, pas ajourné). Installation du parc: 10, banc du parc (incomplet, non ajourné); 20, Équipement de jeu (incomplet, pas sur appel); 30, Statue (incomplète, non ajournée); 40, Flagpole (incomplet, non ajourné)."},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard atá i saoráidí na páirce an réad agus na fochineálacha seo a leanas (le haghaidh an liosta reatha féach Bunléarscáil Sonraíochta Táirge Ginearálta): Saoráidí spóirt: 280, sprioc peile (neamhiomlán, gan a bheith ar atráth). Saoráid na páirce: 10, Binse na páirce (neamhiomlán, gan a bheith curtha ar atráth); 20, Trealamh súgartha (neamhiomlán, ní ar glao); 30, Dealbh (neamhiomlán, gan a bheith ar atráth); 40, Flagpole (neamhiomlán, gan a bheith ar atráth)."},{"@language":"hr-t-sv-t0-mtec","@value":"Objekti parka sastoje se od sljedećih objekata i podvrsta (za trenutačni popis vidjeti Osnovnu kartu opće specifikacije proizvoda): Sportski sadržaji: 280, Nogometni gol (nepotpun, ne odgođen). Objekt parka: 10, klupa za parkiranje (nepotpuna, neodgodiva); 20, Oprema za igru (nepotpuna, ne na poziv); 30, Kip (nepotpun, neprekidan); 40, Flagpole (nepotpun, ne odgođen)."},{"@language":"hu-t-sv-t0-mtec","@value":"A parklétesítmények a következő objektumokból és altípusokból állnak (az aktuális listát lásd az Általános Termékleírási Alaptérképen): Sportlétesítmények: 280, Labdarúgó gól (nem teljes, nem elnapolt). Parklétesítmény: 10, Park pad (nem teljes, nem elnapolt); 20, Játék felszerelés (nem teljes, nem hívásra); 30, Szobor (nem teljes, nincs elnapolva); 40, Flagpole (nem teljes, nincs elnapolva)."},{"@language":"it-t-sv-t0-mtec","@value":"Le strutture del parco sono costituite dai seguenti oggetti e sottotipi (per l'elenco attuale si veda la mappa di base delle specifiche generali del prodotto): Impianti sportivi: 280, Gol di calcio (incompleto, non aggiornato). Struttura del parco: 10, Banco del parco (incompleto, non aggiornato); 20, Attrezzatura da gioco (incompleta, non a chiamata); 30, Statua (incompleta, non aggiornata); 40, Flagpole (incompleto, non aggiornato)."},{"@language":"lt-t-sv-t0-mtec","@value":"Parko įrenginius sudaro šie objektai ir potipiai (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): Sporto įranga: 280, Futbolo tikslas (neužbaigtas, o ne atidėtas). Parko įranga: 10, Parko suoliukas (neužbaigtas, nenutrauktas); 20, Žaidimų įranga (neužbaigta, ne budėjimo metu); 30, Statula (neužbaigta, neatidėliota); 40, Vėliavos stiebas (neužbaigtas, nesustabdytas)."},{"@language":"lv-t-sv-t0-mtec","@value":"Parka iekārtas sastāv no šādiem objektiem un apakštipiem (pašreizējo sarakstu sk. Vispārējā produkta specifikācijas bāzes kartē): Sporta aprīkojums: 280, futbola mērķis (nepilnīgs, nav atlikts). Parka iekārta: 10, Park sols (nepilnīgs, nav pārtraukta); 20, Play iekārtas (nepilnīgs, ne pēc izsaukuma); 30, statuja (nepilnīga, nav atlikta); 40, karogs (nepilnīgs, nav pārtraukts)."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-faċilitajiet tal-park jikkonsistu mill-oġġett u s-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): Faċilitajiet sportivi: 280, Għan tal-futbol (mhux komplut, mhux aġġornat). Faċilità ta' park: 10, Bank tal-Park (mhux komplut, mhux aġġornat); 20, Tagħmir tal-logħob (mhux komplut, mhux fuq sejħa); 30, Statwa (mhux kompluta, mhux aġġornata); 40, Flagpole (mhux komplut, mhux aġġornat)."},{"@language":"nl-t-sv-t0-mtec","@value":"Parkfaciliteiten bestaan uit de volgende objecten en subtypen (zie voor de huidige lijst de basiskaart van de algemene productspecificatie): Sportfaciliteiten: 280, Voetbaldoel (onvolledig, niet verdaagd). Parkfaciliteit: 10, Parkbank (onvolledig, niet verdaagd); 20, Speeltoestellen (incompleet, niet op afroep); 30, Standbeeld (onvolledig, niet verdaagd); 40, Flagpole (onvolledig, niet verdaagd)."},{"@language":"pl-t-sv-t0-mtec","@value":"Obiekty parkowe składają się z następujących obiektów i podtypów (aktualna lista znajduje się w mapie podstawowej specyfikacji produktu): Obiekty sportowe: 280, bramka w piłce nożnej (niekompletna, nie odroczona). Obiekt parkowy: 10, ławka parkowa (niekompletna, nie odroczona); 20, Sprzęt do zabawy (niekompletny, nie na wezwanie); 30, Posąg (niekompletny, nie odroczony); 40, Flagpole (niekompletne, nie odroczone)."},{"@language":"pt-t-sv-t0-mtec","@value":"As instalações do parque consistem nos seguintes objetos e subtipos (para a lista atual, ver o mapa de base das especificações gerais do produto): Instalações desportivas: 280, golo de futebol (incompleto, não adiado). Instalações do parque: 10, Park bench (incompleto, não adiado); 20, Equipamento de jogo (incompleto, não de plantão); 30, Estátua (incompleta, não suspensa); 40, Flagpole (incompleto, não adiado)."},{"@language":"ro-t-sv-t0-mtec","@value":"Facilitățile parcului constau în următoarele obiecte și subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): Facilități sportive: 280, gol de fotbal (incomplet, nu amânat). Facilitatea parcului: 10, banc de parcare (incomplet, neamânat); 20, Echipament de joc (incomplet, nu de gardă); 30, Statuie (incompletă, neamânată); 40, Flagpole (incomplet, nu amânat)."},{"@language":"sk-t-sv-t0-mtec","@value":"Parkovacie zariadenia pozostávajú z nasledujúcich objektov a podtypov (pre aktuálny zoznam pozri základnú mapu všeobecných špecifikácií produktu): Športové zariadenia: 280, Futbalový gól (neúplný, neodročený). Parkovacie zariadenie: 10, lavica v parku (neúplná, neodročená); 20, Hrať zariadenia (neúplné, nie na volanie); 30, Socha (neúplná, neodročená); 40, Flagpole (neúplné, neodročené)."},{"@language":"sl-t-sv-t0-mtec","@value":"Objekti v parku so sestavljeni iz naslednjih predmetov in podtipov (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): Športni objekti: 280, Nogometni gol (nepopoln, ne preložen). Parkirišče: klop za parkiranje (nepopolna, ni preložena); 20, igralna oprema (nepopolna, ne na klic); 30, Kip (nepopoln, ni preložen); 40, Flagpole (nepopolno, ni preloženo)."},{"@language":"sv","@value":"Parkanläggningar består av följande objekt- och subtyper(för aktuell lista se Allmän produktspecifikation Baskartan): Idrottsanläggning: 280, Fotbollsmål (ofullständigt, ajourhålls ej). Parkanläggning: 10, Parkbänk (ofullständigt, ajourhålls ej); 20, Lekutrustning (ofullständigt, ajourhålls ej); 30, Staty (ofullständigt, ajourhålls ej); 40, Flaggstång (ofullständigt, ajourhålls ej)."},{"@language":"uk-t-sv-t0-mtec","@value":"Паркові об'єкти складаються з наступних об'єктів та підтипів (для поточного списку див. Спортивні споруди: 280, Футбольний м'яч (неповний, не відкладений). Парковий об'єкт: 10, паркова лавка (неповна, не відкладена); 20, Ігрове обладнання (неповне, не за викликом); 30, статуя (неповна, не відкладена); 40, флагшток (неповний, не відкладений)."}],"dct:format":"text/html","dct:identifier":"815e34df-829f-498b-a358-048c431b3602","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7b5a3a4f0428b43f3996b17d137406ded2a6852ef45f780282a37daa43709970_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Паркови съоръжения"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Parkoviště"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Parkanlæg"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Parkeinrichtungen"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Base map - Εγκαταστάσεις πάρκου"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Park facilities"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Instalaciones del parque"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Baaskaart - Parkimisvõimalused"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Puiston tilat"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Plan de base - Installations du parc"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Bhunáite SBK - Saoráidí páirceála"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Bazna karta - Sadržaji parka"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Parkolási lehetőségek"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa di base - Servizi del parco"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Parko įranga"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Base map - Parka iekārtas"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Base map - Park faċilitajiet"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Parkfaciliteiten"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Base map - Wyposażenie parku"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa base da SBK - Instalações do parque"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Base hartă - Facilitățile parcului"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Základná mapa - Vybavenie na parkovanie"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Osnovno karto - Park objektov"},{"@language":"sv","@value":"SBK Baskarta - Parkanläggningar"},{"@language":"uk-t-sv-t0-mtec","@value":"Базова карта СБК - Паркові споруди"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/91861e43-418f-4dc9-96bd-0fcaaa8407a2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/815e34df-829f-498b-a358-048c431b3602#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Baskarta (1:400  - 1:2000).",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продуктовата базова карта (1:400 - 1:2000)."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktové Základní mapy (1:400 - 1:2000)."},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktbasen (1:400 - 1:2000)."},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Basiskarte (1:400 - 1:2000) enthalten."},{"@language":"el-t-sv-t0-mtec","@value":"Το σύνολο δεδομένων περιλαμβάνεται στον χάρτη βάσης προϊόντος (1:400 - 1:2000)."},{"@language":"en-t-sv-t0-mtec","@value":"The data set is included in the product Base map (1:400 - 1:2000)."},{"@language":"es-t-sv-t0-mtec","@value":"El conjunto de datos se incluye en el mapa base del producto (1:400 - 1:2000)."},{"@language":"et-t-sv-t0-mtec","@value":"Andmekogum sisaldub toote aluskaardil (1:400 - 1:2000)."},{"@language":"fi-t-sv-t0-mtec","@value":"Aineisto sisältyy tuotteen peruskarttaan (1:400 - 1:2000)."},{"@language":"fr-t-sv-t0-mtec","@value":"L'ensemble de données est inclus dans la carte de base du produit (1:400 - 1:2000)."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an tacar sonraí san áireamh sa bhunléarscáil táirge (1:400 - 1:2000)."},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka uključen je u kartu proizvoda Baza (1:400 - 1:2000)."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatkészlet megtalálható a termék alaptérképén (1:400 - 1:2000)."},{"@language":"it-t-sv-t0-mtec","@value":"Il set di dati è incluso nella mappa di base del prodotto (1:400 - 1:2000)."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rinkinys įtrauktas į gaminio bazinį žemėlapį (1:400 - 1:2000)."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu kopa ir iekļauta produktu bāzes kartē (1:400 - 1:2000)."},{"@language":"mt-t-sv-t0-mtec","@value":"Is-sett tad-data huwa inkluż fil-mappa tal-bażi tal-prodott (1:400 - 1:2000)."},{"@language":"nl-t-sv-t0-mtec","@value":"De gegevensset is opgenomen in de productbasiskaart (1:400 - 1:2000)."},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się na mapie bazowej produktu (1:400 - 1:2000)."},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no mapa de base do produto (1:400 - 1:2000)."},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în harta de bază a produsului (1:400 - 1:2000)."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový súbor je súčasťou produktu Základná mapa (1:400 - 1:2000)."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov je vključen v osnovni zemljevid izdelka (1:400 - 1:2000)."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних входить до базової карти продукту (1:400 - 1:2000)."}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/91861e43-418f-4dc9-96bd-0fcaaa8407a2"}},{"@id":"http://data.europa.eu/88u/record/815e34df-829f-498b-a358-048c431b3602","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/91861e43-418f-4dc9-96bd-0fcaaa8407a2"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"815e34df-829f-498b-a358-048c431b3602","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:42Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/815e34df-829f-498b-a358-048c431b3602"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7b5a3a4f0428b43f3996b17d137406ded2a6852ef45f780282a37daa43709970_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/815e34df-829f-498b-a358-048c431b3602"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:42Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"815e34df-829f-498b-a358-048c431b3602","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/815e34df-829f-498b-a358-048c431b3602"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockh