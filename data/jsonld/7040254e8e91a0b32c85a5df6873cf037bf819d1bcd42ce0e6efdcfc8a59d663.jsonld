to:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/74366fbb-6fc5-4462-8229-3a4fbbe6a299","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Exploateringsn%C3%A4mnd/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/74366fbb-6fc5-4462-8229-3a4fbbe6a299#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Geovetenskap"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=74366fbb-6fc5-4462-8229-3a4fbbe6a299"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2013-06-01"},"dct:description":{"@language":"sv","@value":"I Geoarkivet har information av geokaraktär samlats. Materialet finns både i analogt och i digitalt format men stor del av materialet har förts över till digitalt format. I Geoarkivet finns: •Geotekniska sonderingar (ca 600 000 st). •Geotekniska sonderingar (planredovisade). •Geotekniska utredningar (ca 3000 st). •Geologiska kartor (skala 1:2000 och 1:10 000). •Husgrundläggningskartor (skala 1:2000). •Grundvattennivåer (ca 600 aktiva grundvattenrör och ca 1000 avslutade). •Sättningsavvägningar från byggnader (ca 250 byggnader varav ca 100 st i Gamla Stan). •Sättningsavvägning av mark (ca 60 st marksättningspeglar)."},"dct:identifier":"52deadb7-819f-4f84-af19-149474eb4706","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@va