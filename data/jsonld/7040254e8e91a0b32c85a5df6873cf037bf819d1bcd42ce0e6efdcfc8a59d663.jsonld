m%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:71685917102def2dc3fe0eccd567a9dc022c76254855339e6966ae02ac80504a"},{"@graph":[{"@id":"_:71abe891db2567004c1156bb6155937cddffeaa291a8456a4ce0794e4ce5c887_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:71abe891db2567004c1156bb6155937cddffeaa291a8456a4ce0794e4ce5c887_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2019-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2019-04-17"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2019-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2019-04-17"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=aae9efd7-aba9-413a-8775-f410b069c5e4"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2020-04-22"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 6-22 april 2020. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd","dct:issued":{"@type":"xsd:date","@value":"2023-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:71abe891db2567004c1156bb6155937cddffeaa291a8456a4ce0794e4ce5c887_b0n0"},"dct:temporal":{"@id":"_:71abe891db2567004c1156bb6155937cddffeaa291a8456a4ce0794e4ce5c887_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2020)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/e1ff84c3-cfa4-4c48-b3d1-e3e12d979bcd#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2020?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2020"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:71abe891db2567004c1156bb6155937cddffeaa291a8456a4ce0794e4ce5c887"},{"@graph":[{"@id":"_:731ba46c8f6fbacf2beefd0ddf1603118afc8a9ded1ec193cab5a354859cb92f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=add986f7-9934-48ff-b3fc-b3d5b074aec8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1995-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Upplösning: 16 cm/pixel i ortofoto. Fotograferingsdatum: april-maj 1995"},"dct:identifier":"67d71b7f-b7fc-47ec-ad32-110df631a632","dct:issued":{"@type":"xsd:date","@value":"1996-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:731ba46c8f6fbacf2beefd0ddf1603118afc8a9ded1ec193cab5a354859cb92f_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (1995)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_1995"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto (1995)"},{"@id":"https://resources.stockholm.se/data/67d71b7f-b7fc-47ec-ad32-110df631a632#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_1995"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto (1995)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:731ba46c8f6fbacf2beefd0ddf1603118afc8a9ded1ec193cab5a354859cb92f"},{"@graph":[{"@id":"_:73804f5fbdf091c7ff6805184e46d670b4a36e24a4a1661a38b5c6c349929f0c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4429,18.2011 59.4429,18.2011 59.2272,17.7605 59.2272,17.7605 59.4429))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4429,18.2011 59.4429,18.2011 59.2272,17.7605 59.2272,17.7605 59.4429))"}},{"@id":"_:73804f5fbdf091c7ff6805184e46d670b4a36e24a4a1661a38b5c6c349929f0c_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"14dc6b4da2245277cbc135be84119b92c0"},{"@id":"http://data.europa.eu/88u/dataset/3e16577d-5a9a-427a-8640-0786bd2dc728","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/ca92d1be-b751-4321-864a-da86bbb2a4dc"},{"@id":"http://data.europa.eu/88u/distribution/fbcccf85-da03-4ed5-af72-8e3e29656839"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=eadf6208-37d6-4e01-9097-456517ca8bed"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2009-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Векторен файл на всеки отделен многоъгълник на покрива, класифициран според количеството падаща слънчева енергия в три категории: <950 kWh/година, 950 ? 1000 kWh/година и > 1000 kWh/година. Данните се основават на данни за височината от общинско лазерно сканиране от 2012 г. и метеорологични данни от SMHI 2000-2009 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"Vektorový soubor každého jednotlivého střešního polygonu klasifikovaný podle množství dopadající sluneční energie ve třech kategoriích: <950 kWh/rok, 950 ? 1000 kWh/rok a > 1000 kWh/rok. Data jsou založena na výškových datech z komunálního laserového skenování z roku 2012 a meteorologických datech z SMHI 2000-2009."},{"@language":"da-t-sv-t0-mtec","@value":"Vektorfil for hver enkelt tagpolygon klassificeret efter mængden af indfaldende solenergi i tre kategorier: <950 kWh/år, 950 ? 1000 kWh/år og >1000 kWh/år. Data er baseret på højdedata fra kommunal laserscanning fra 2012 og meteorologiske data fra SMHI 2000-2009)"},{"@language":"de-t-sv-t0-mtec","@value":"Vektordatei jedes einzelnen Dachpolygons, klassifiziert nach der Menge der einfallenden Sonnenenergie in drei Kategorien: <950 kWh/Jahr, 950 ? 1000 kWh/Jahr und >1000 kWh/Jahr. Die Daten basieren auf Höhendaten des städtischen Laserscannings von 2012 und meteorologischen Daten von SMHI 2000-2009."},{"@language":"el-t-sv-t0-mtec","@value":"Διανυσματικό αρχείο κάθε επιμέρους πολυγώνου οροφής ταξινομημένο σύμφωνα με την ποσότητα προσπίπτουσας ηλιακής ενέργειας σε τρεις κατηγορίες: <950 kWh/έτος, 950 ? 1000 kWh/έτος και >1000 kWh/έτος. Τα δεδομένα βασίζονται σε δεδομένα ύψους από δημοτική σάρωση λέιζερ από το 2012 και μετεωρολογικά δεδομένα από το SMHI 2000-2009)"},{"@language":"en-t-sv-t0-mtec","@value":"Vector file of each individual roof polygon classified according to the amount of incident solar energy in three categories: <950 kWh/year, 950 ? 1000 kWh/year and >1000 kWh/year. Data are based on height data from municipal laser scanning from 2012 and meteorological data from SMHI 2000-2009)"},{"@language":"es-t-sv-t0-mtec","@value":"Archivo vectorial de cada polígono de techo individual clasificado según la cantidad de energía solar incidente en tres categorías: <950 kWh/año, 950 ? 1000 kWh/año y >1000 kWh/año. Los datos se basan en datos de altura del escaneo láser municipal de 2012 y datos meteorológicos de SMHI 2000-2009)"},{"@language":"et-t-sv-t0-mtec","@value":"Iga üksiku katuse hulknurga vektorfail, mis on liigitatud vastavalt langeva päikeseenergia kogusele kolmes kategoorias: <950 kWh aastas, 950 ? 1000 kWh aastas ja > 1000 kWh aastas. Andmed põhinevad munitsipaalse laserskaneerimise kõrgusandmetel aastast 2012 ja meteoroloogilistel andmetel SMHI 2000-2009)"},{"@language":"fi-t-sv-t0-mtec","@value":"Kunkin yksittäisen katon polygonin vektoritiedosto, joka on luokiteltu kohtaavan aurinkoenergian määrän mukaan kolmeen luokkaan: < 950 kWh/vuosi, 950 ? 1000 kWh/vuosi ja >1000 kWh/vuosi. Tiedot perustuvat kunnallisen laserskannauksen korkeustietoihin vuodelta 2012 ja SMHI:n säätietoihin vuosilta 2000-2009)"},{"@language":"fr-t-sv-t0-mtec","@value":"Fichier vectoriel de chaque polygone de toit individuel classé en fonction de la quantité d'énergie solaire incidente en trois catégories: <950 kWh/an, 950 ? 1000 kWh/an et >1000 kWh/an. Les données sont basées sur les données de hauteur du balayage laser municipal de 2012 et les données météorologiques de SMHI 2000-2009)"},{"@language":"ga-t-sv-t0-mtec","@value":"Comhad veicteora gach polagáin dín aonair a aicmítear de réir mhéid an ghrianfhuinnimh teagmhais i dtrí chatagóir: <950 kWh in aghaidh na bliana, 950 ? 1000 kWh/bliain agus >1000 kWh/bliain. Tá na sonraí bunaithe ar shonraí airde ó scanadh léasair bardasach ó 2012 agus ar shonraí meitéareolaíocha ó SMHI 2000-2009)"},{"@language":"hr-t-sv-t0-mtec","@value":"Vektorska datoteka svakog pojedinog krovnog poligona klasificirana prema količini incidentne solarne energije u tri kategorije: <950 kWh/godišnje, 950 ? 1000 kWh/godišnje i > 1000 kWh/godišnje. Podaci se temelje na podacima o visini iz komunalnog laserskog skeniranja iz 2012. i meteorološkim podacima iz SMHI 2000-2009)"},{"@language":"hu-t-sv-t0-mtec","@value":"A beeső napenergia mennyisége szerint három kategóriába besorolt egyes tetős sokszögek vektorfájlja: <950 kWh/év, 950 ? 1000 kWh/év és >1000 kWh/év. Az adatok a 2012-es önkormányzati lézerszkennelésből származó magassági adatokon és a 2000-2009-es SMHI meteorológiai adatokon alapulnak.)"},{"@language":"it-t-sv-t0-mtec","@value":"File vettoriale di ogni singolo poligono del tetto classificato in base alla quantità di energia solare incidente in tre categorie: <950 kWh/anno, 950 ? 1000 kWh/anno e >1000 kWh/anno. I dati si basano sui dati di altezza della scansione laser municipale del 2012 e sui dati meteorologici di SMHI 2000-2009)"},{"@language":"lt-t-sv-t0-mtec","@value":"Kiekvieno atskiro stogo daugiakampio vektorinė rinkmena, suskirstyta pagal krintančios saulės energijos kiekį į tris kategorijas: <950 kWh per metus, 950 ? 1000 kWh per metus ir >1000 kWh per metus. Duomenys pagrįsti 2012 m. savivaldybės lazerinio skenavimo aukščio duomenimis ir 2000–2009 m. SMHI meteorologiniais duomenimis."},{"@language":"lv-t-sv-t0-mtec","@value":"Katra atsevišķa jumta daudzstūra vektoru fails, kas klasificēts atbilstoši krītošās saules enerģijas daudzumam trīs kategorijās: <950 kWh/gadā, 950 ? 1000 kWh/gadā un >1000 kWh/gadā. Dati ir balstīti uz augstuma datiem no pašvaldību lāzerskenēšanas no 2012. gada un meteoroloģiskajiem datiem no SMHI 2000-2009)"},{"@language":"mt-t-sv-t0-mtec","@value":"Fajl tal-vettur ta’ kull poligonu tas-saqaf individwali kklassifikat skont l-ammont ta’ enerġija solari inċidentali fi tliet kategoriji: <950 kWh/sena, 950 ? 1000 kWh/sena u >1000 kWh/sena. Id-data hija bbażata fuq data dwar l-għoli minn skennjar bil-laser muniċipali mill-2012 u data meteoroloġika minn SMHI 2000-2009)"},{"@language":"nl-t-sv-t0-mtec","@value":"Vectorbestand van elke afzonderlijke dakpolygoon ingedeeld volgens de hoeveelheid invallende zonne-energie in drie categorieën: <950 kWh/jaar, 950 ? 1000 kWh/jaar en >1000 kWh/jaar. Gegevens zijn gebaseerd op hoogtegegevens van gemeentelijke laserscanning uit 2012 en meteorologische gegevens van SMHI 2000-2009)"},{"@language":"pl-t-sv-t0-mtec","@value":"Plik wektorowy każdego pojedynczego wielokąta dachowego sklasyfikowany według ilości padającej energii słonecznej w trzech kategoriach: <950 kWh/rok, 950 ? 1000 kWh/rok i > 1000 kWh/rok. Dane oparte są na danych wysokościowych z miejskiego skanowania laserowego z 2012 r. oraz danych meteorologicznych z SMHI 2000-2009)"},{"@language":"pt-t-sv-t0-mtec","@value":"Ficheiro vetorial de cada polígono de cobertura individual classificado de acordo com a quantidade de energia solar incidente em três categorias: <950 kWh/ano, 950 ? 1000 kWh/ano e >1000 kWh/ano. Os dados são baseados em dados de altura da varredura a laser municipal de 2012 e dados meteorológicos da SMHI 2000-2009)"},{"@language":"ro-t-sv-t0-mtec","@value":"Fișier vectorial al fiecărui poligon individual al acoperișului clasificat în funcție de cantitatea de energie solară incidentă în trei categorii: <950 kWh/an, 950 ? 1000 kWh/an și > 1000 kWh/an. Datele se bazează pe datele privind înălțimea provenite din scanarea cu laser municipală din 2012 și pe datele meteorologice din SMHI 2000-2009)."},{"@language":"sk-t-sv-t0-mtec","@value":"Vektorový súbor každého jednotlivého strešného polygónu klasifikovaný podľa množstva dopadajúcej slnečnej energie v troch kategóriách: <950 kWh/rok, 950 ? 1000 kWh/rok a > 1000 kWh/rok. Údaje sú založené na výškových údajoch z obecného laserového skenovania z roku 2012 a meteorologických údajoch zo SMHI 2000-2009)"},{"@language":"sl-t-sv-t0-mtec","@value":"Vektorska datoteka vsakega posameznega strešnega poligona, razvrščenega glede na količino incidentne sončne energije v tri kategorije: <950 kWh/leto, 950 ? 1000 kWh/leto in > 1000 kWh/leto. Podatki temeljijo na podatkih o višini iz občinskega laserskega skeniranja iz leta 2012 in meteoroloških podatkih iz SMHI 2000-2009)"},{"@language":"sv","@value":"Vektorfil över varje enskild takpolygon klassificerad utifrån mängden infallande solenergi inom tre kategorier: <950 kWh/år, 950 ? 1000 kWh/år och >1000 kWh/år. Data baseras på höjddata utifrån kommunal laserskanning från 2012 och meterologiska data från SMHI 2000-2009)"},{"@language":"uk-t-sv-t0-mtec","@value":"Векторний файл кожного окремого багатокутника даху класифікується відповідно до кількості падаючої сонячної енергії в трьох категоріях: <950 кВт-год/рік, 950 ? 1000 кВт-год/рік і >1000 кВт-год/рік. Дані базуються на даних висоти муніципального лазерного сканування 2012 року та метеорологічних даних SMHI 2000-2009)"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"3e16577d-5a9a-427a-8640-0786bd2dc728","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:73804f5fbdf091c7ff6805184e46d670b4a36e24a4a1661a38b5c6c349929f0c_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Слънчева радиация - Сгради"},{"@language":"cs-t-sv-t0-mtec","@value":"Sluneční záření - budovy"},{"@language":"da-t-sv-t0-mtec","@value":"Solstråling - Bygninger"},{"@language":"de-t-sv-t0-mtec","@value":"Sonneneinstrahlung - Gebäude"},{"@language":"el-t-sv-t0-mtec","@value":"Ηλιακή ακτινοβολία - Κτίρια"},{"@language":"en-t-sv-t0-mtec","@value":"Solar radiation - Buildings"},{"@language":"es-t-sv-t0-mtec","@value":"Radiación solar - Edificios"},{"@language":"et-t-sv-t0-mtec","@value":"Päikesekiirgus – hooned"},{"@language":"fi-t-sv-t0-mtec","@value":"Aurinkosäteily - Rakennukset"},{"@language":"fr-t-sv-t0-mtec","@value":"Rayonnement solaire - Bâtiments"},{"@language":"ga-t-sv-t0-mtec","@value":"Radaíocht na gréine - Foirgnimh"},{"@language":"hr-t-sv-t0-mtec","@value":"Sunčevo zračenje - zgrade"},{"@language":"hu-t-sv-t0-mtec","@value":"Napsugárzás - épületek"},{"@language":"it-t-sv-t0-mtec","@value":"Radiazione solare - Edifici"},{"@language":"lt-t-sv-t0-mtec","@value":"Saulės spinduliuotė. Pastatai"},{"@language":"lv-t-sv-t0-mtec","@value":"Saules starojums - ēkas"},{"@language":"mt-t-sv-t0-mtec","@value":"- Bini ta' radjazzjoni solari"},{"@language":"nl-t-sv-t0-mtec","@value":"Zonnestraling - Gebouwen"},{"@language":"pl-t-sv-t0-mtec","@value":"Promieniowanie słoneczne - Budynki"},{"@language":"pt-t-sv-t0-mtec","@value":"Radiação solar - Edifícios"},{"@language":"ro-t-sv-t0-mtec","@value":"Radiații solare - Clădiri"},{"@language":"sk-t-sv-t0-mtec","@value":"Slnečné žiarenie - budovy"},{"@language":"sl-t-sv-t0-mtec","@value":"Sončno sevanje - stavbe"},{"@language":"sv","@value":"Solinstrålning - Byggnader"},{"@language":"uk-t-sv-t0-mtec","@value":"Сонячна радіація - Будівлі"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/ca92d1be-b751-4321-864a-da86bbb2a4dc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.miljo.stockholm.se/server/services/Solinstr%C3%A5lning/MapServer/WMSServer"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/3e16577d-5a9a-427a-8640-0786bd2dc728#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst",{"@language":"bg-t-sv-t0-mtec","@value":"Услуга за WMS"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS"},{"@language":"en-t-sv-t0-mtec","@v