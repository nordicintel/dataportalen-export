8eefb7fc3a3"},{"@graph":[{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2019-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2019-04-17"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2019-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2019-04-17"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=137fc1a0-59ad-4e23-9712-8d81205ad75d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2019-04-20"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1828 - 1890 meter över marken. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 17-19 april 2019. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"ac02c6f4-6172-43e5-8604-b2116250c76a","dct:issued":{"@type":"xsd:date","@value":"2020-04-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b0n0"},"dct:temporal":{"@id":"_:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2019)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2019"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2019"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:65d47487f5e44c58b6cb4a1c1f4274a096877f75de3aec8d6d5ab8ef98699b76"},{"@graph":[{"@id":"_:6646f5b13cb16f5242bf1ab914931b80582ae2ee054e133b03cfff29b54d7105_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/3e04c10