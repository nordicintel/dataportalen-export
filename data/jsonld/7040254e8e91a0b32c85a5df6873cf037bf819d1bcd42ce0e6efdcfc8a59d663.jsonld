apa (1:400 - 1:2000)."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov je vključen v osnovni zemljevid izdelka (1:400 - 1:2000)."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних входить до базової карти продукту (1:400 - 1:2000)."}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/b5fa842f-c180-4c2f-883f-8465b0a780fd"}},{"@id":"http://data.europa.eu/88u/record/8d6e25de-d393-4346-8a68-12750a433f7b","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/b5fa842f-c180-4c2f-883f-8465b0a780fd"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"8d6e25de-d393-4346-8a68-12750a433f7b","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:40:15Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/8d6e25de-d393-4346-8a68-12750a433f7b"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:bec70093bf07ef0b99a21e9d190f0f28541cdf0683736ef28e0e58f3524086b2_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/8d6e25de-d393-4346-8a68-12750a433f7b"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:40:15Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"8d6e25de-d393-4346-8a68-12750a433f7b","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/8d6e25de-d393-4346-8a68-12750a433f7b"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value