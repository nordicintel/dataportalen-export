ssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"300404e0-d3f4-4dfb-8956-f81991413394","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:f6721ab39995047104154ddfedd7a70ef74314a3c1fba08f98a452a2bb645e2b"},{"@graph":[{"@id":"_:f67ceca1abffb61e0f0a3a54ecea13ac58a94194fd3cdc31a3374a037cf85b67_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/9b134b5d-e20d-400c-96ec-5eb7b6612083","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/9b134b5d-e20d-400c-96ec-5eb7b6612083#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e29e30c2-ad2a-4d8e-a74b-d2e6ecd70274"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Stompunktskartan visar Stockholms stompunkter i plan och höjd mot bakgrund av Stockholmskarta Grå Nedtonad. Totalt finns ca 25 000 stompunkter i plan och 5 000 i höjd. Stompunkterna består av anslutningspunkter och brukspunkter och dessa visas med olika symboler i kartan. För planpunkterna finns även riktningsstreck som visar vilka punkter som har mätts och utjämnats tillsammans. Stompunktsdatabasen innehåller även en typ av punkter som kallas Naturliga stöd. Dessa ska endast användas som stöd vid blocktriangulering av flygbilder och liknande tillämpningar och är inte jämställda med övriga stompunkter. Dessa syns bara i dpMap, inte i externa kartprodukter, för att inte riskera att kunder använder dem som stompunkter. Stompunktskartan används dels internt av Stockholms stads förvaltningar och dels av externa kunder, såsom byggbolag, projektörer och mätkonsulter. Kartan finns tillgänglig på internet där användarna även får åtkomst till koordinatinformation och punktskisser. Som intern användare eller avtalskund sker detta via inloggning och som extern kund mot kortbetalning. Stompunkterna är mätta enligt HMK:s (Handbok i Mät- och Kartfrågor, utgiven av Lantmäteriet) standard. I plan har satsmätning med totalstation använts och i höjd finavvägning för anslutningspunkter och vanlig avvägning för brukspunkter. Ett mindre antal kombinerade punkter finns också. Dessa har först mätts som brukspunkter i plan och därefter avvägts så att de också har samma status som brukspunkter i höjd. Plankoordinaterna på stompunkter i höjd är ungefärliga. Ofta har dessa punkter inte mätts in i plan utan endast placerats ut på kartan, varför stora fel kan förekomma. En kvalitetshöjande insats pågår under 2016 och 2017 för att säkerställa att plankoordinater på stompunkter i höjd inte är mer fel än ca en halvmeter så att det ska vara möjligt att hitta dessa i fält även utan en punktskiss."},"dct:identifier":"9b134b5d-e20d-400c-96ec-5eb7b6612083","dct:issued":{"@type":"xsd:date","@value":"2017-04-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-12-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f67ceca1abffb61e0f0a3a54ecea13ac58a94194fd3cdc31a3374a037cf85b67_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Stompunkter (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/9b134b5d-e20d-400c-96ec-5eb7b6612083#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://etjanster.stockholm.se/Geodatabutiken/produkter/stompunkter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:f67ceca1abffb61e0f0a3a54ecea13ac58a94194fd3cdc31a3374a037cf85b67"},{"@graph":[{"@id":"_:f6b6399b2cb2067d436c7e8c877722af66ef4bc9ce3c8c1738cb17ea4baa4082_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/2dce46a4-9785-40cb-973f-9bbe5d402c47","@type":["dcat:Dataset","dcat:dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/"},"dcat:distrib