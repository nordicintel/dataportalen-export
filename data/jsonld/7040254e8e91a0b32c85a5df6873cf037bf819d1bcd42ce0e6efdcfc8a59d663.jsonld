22-08-01"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2024-07-31"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2022-08-01"}},{"@id":"_:28192c24bc41dfedc82f11143e3fcf09cef3e9106f59bbf802d8617d4c5ddecc_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"12dab3b5b2c1ffaaa28d64dc4ccb2f2132"},{"@id":"http://data.europa.eu/88u/dataset/8e6fdfb3-a774-4414-bf66-0915fd813dc1","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=a1c5557a-6b3a-4a4d-8f4c-f73313c31b54"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/4326"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Данни за потока на движение от превозни средства, като тип фордин, местоположение, посока, време, пощенски код на собственика, класификация на екологичната зона и др. Набор от исторически данни. Данни от 1.8.2022 г. до 31.7.2024 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Údaje o dopravním toku z vozidel, jako je typ, umístění, směr, čas, poštovní směrovací číslo majitele, klasifikace environmentální zóny atd. Soubor historických údajů. Údaje od 1. srpna 2022 do 31. července 2024."},{"@language":"da-t-sv-t0-mtec","@value":"Trafikdata fra køretøjer, f.eks. type, placering, retning, tid, ejerens postnummer, klassificering af miljøzone osv. Historisk datasæt. Data fra den 1. august 2022 til den 31. juli 2024."},{"@language":"de-t-sv-t0-mtec","@value":"Verkehrsflussdaten von Fahrzeugen, wie Fordins-Typ, Standort, Richtung, Zeit, Postleitzahl des Besitzers, Umweltzonenklassifizierung usw. Historischer Datensatz. Daten vom 1.8.2022 bis 31.7.2024."},{"@language":"el-t-sv-t0-mtec","@value":"Δεδομένα ροής κυκλοφορίας από οχήματα, όπως τύπος fordins, τοποθεσία, κατεύθυνση, ώρα, ταχυδρομικός κώδικας ιδιοκτήτη, ταξινόμηση περιβαλλοντικής ζώνης κ.λπ. Σύνολο ιστορικών δεδομένων. Στοιχεία από 01/08/2022 έως 31/07/2024."},{"@language":"en-t-sv-t0-mtec","@value":"Traffic flow data from vehicles, such as fordins type, location, direction, time, owner's postcode, environmental zone classification, etc. Historical data set. Data from 01/08/2022 to 31/07/2024."},{"@language":"es-t-sv-t0-mtec","@value":"Datos de flujo de tráfico de vehículos, como tipo de fordins, ubicación, dirección, hora, código postal del propietario, clasificación de zona ambiental, etc. Conjunto de datos históricos. Datos del 01/08/2022 al 31/07/2024."},{"@language":"et-t-sv-t0-mtec","@value":"Sõidukite liiklusvoo andmed, näiteks fordiinide tüüp, asukoht, suund, aeg, omaniku sihtnumber, keskkonnatsooni klassifikatsioon jne. Ajalooline andmekogum. Andmed 1. augustist 2022 kuni 31. juulini 2024."},{"@language":"fi-t-sv-t0-mtec","@value":"Ajoneuvojen liikennevirtatiedot, kuten fordins-tyyppi, sijainti, suunta, aika, omistajan postinumero, ympäristövyöhykeluokitus jne. Historialliset tiedot. Tiedot 1.8.2022–31.7.2024."},{"@language":"fr-t-sv-t0-mtec","@value":"Données sur le flux de trafic des véhicules, telles que le type de fordins, l'emplacement, la direction, l'heure, le code postal du propriétaire, la classification de la zone environnementale, etc. Ensemble de données historiques. Données du 1er août 2022 au 31 juillet 2024."},{"@language":"ga-t-sv-t0-mtec","@value":"Sonraí sreafa tráchta ó fheithiclí, amhail cineál fordins, suíomh, treo, am, postchód an úinéara, aicmiú creasa comhshaoil, etc. Tacar sonraí stairiúla. Sonraí ón 01/08/2022 go dtí an 31/07/2024."},{"@language":"hr-t-sv-t0-mtec","@value":"Podaci o protoku prometa iz vozila, kao što su tip fordina, lokacija, smjer, vrijeme, poštanski broj vlasnika, klasifikacija ekološke zone itd. Povijesni skup podataka. Podaci od 1. kolovoza 2022. do 31. srpnja 2024."},{"@language":"hu-t-sv-t0-mtec","@value":"A járművek forgalmi adatai, például a fordins típusa, helye, iránya, ideje, a tulajdonos irányítószáma, a környezetvédelmi zóna besorolása stb. Történeti adatok. 2022. augusztus 1-jétől 2024. július 31-ig tartó időszakra vonatkozó adatok."},{"@language":"it-t-sv-t0-mtec","@value":"Dati sul flusso di traffico dai veicoli, come il tipo di fordin, la posizione, la direzione, l'ora, il codice postale del proprietario, la classificazione delle zone ambientali, ecc. Insieme di dati storici. Dati dall'1.8.2022 al 31.7.2024."},{"@language":"lt-t-sv-t0-mtec","@value":"Transporto priemonių eismo srautų duomenys, pvz., fordins tipas, vieta, kryptis, laikas, savininko pašto kodas, aplinkos zonų klasifikacija ir kt. Istorinių duomenų rinkinys. 2022 m. rugpjūčio 1 d.–2024 m. liepos 31 d. duomenys."},{"@language":"lv-t-sv-t0-mtec","@value":"Satiksmes plūsmas dati no transportlīdzekļiem, piemēram, fordins tips, atrašanās vieta, virziens, laiks, īpašnieka pasta indekss, vides zonu klasifikācija utt. Vēsturisko datu kopa. Dati par laikposmu no 2022. gada 1. augusta līdz 2024. gada 31. jūlijam."},{"@language":"mt-t-sv-t0-mtec","@value":"Data dwar il-fluss tat-traffiku minn vetturi, bħat-tip ta’ fordini, il-post, id-direzzjoni, il-ħin, il-kodiċi postali tas-sid, il-klassifikazzjoni taż-żona ambjentali, eċċ. Sett ta’ data storika. Data mill-01/08/2022 sal-31/07/2024."},{"@language":"nl-t-sv-t0-mtec","@value":"Verkeersstroomgegevens van voertuigen, zoals type fordins, locatie, richting, tijd, postcode van de eigenaar, classificatie van milieuzones, enz. Historische dataset. Gegevens van 01/08/2022 tot en met 31/07/2024."},{"@language":"pl-t-sv-t0-mtec","@value":"Dane o przepływie ruchu z pojazdów, takie jak typ fordins, lokalizacja, kierunek, czas, kod pocztowy właściciela, klasyfikacja strefy ekologicznej itp. Zbiór danych historycznych. Dane za okres od 1 sierpnia 2022 r. do 31 lipca 2024 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Dados de fluxo de tráfego de veículos, como tipo de fordins, localização, direção, tempo, código postal do proprietário, classificação da zona ambiental, etc. Conjunto de dados históricos. Dados de 1.8.2022 a 31.7.2024."},{"@language":"ro-t-sv-t0-mtec","@value":"Date privind fluxul de trafic de la vehicule, cum ar fi tipul fordins, locația, direcția, ora, codul poștal al proprietarului, clasificarea zonei de mediu etc. Set de date istorice. Date din 1.8.2022 până la 31.7.2024."},{"@language":"sk-t-sv-t0-mtec","@value":"Údaje o dopravných tokoch z vozidiel, ako je typ fordins, poloha, smer, čas, poštové smerovacie číslo majiteľa, klasifikácia environmentálnych zón atď. Súbor historických údajov. Údaje od 1. augusta 2022 do 31. júla 2024."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatki o pretoku prometa iz vozil, kot so tip fordins, lokacija, smer, čas, poštna številka lastnika, razvrstitev okoljskih območij itd. Zgodovinski nabor podatkov. Podatki za obdobje od 1. avgusta 2022 do 31. julija 2024."},{"@language":"sv","@value":"Trafikflödesdata från fordon, exempelvis fordinstyp, plats, riktning, tid, ägarens postnummer, miljözonsklassning mm. Historisk datamängd. Data från 2022-08-01 till 2024-07-31."},{"@language":"uk-t-sv-t0-mtec","@value":"Дані про рух транспортних засобів, такі як тип fordins, місцезнаходження, напрямок, час, поштовий індекс власника, класифікація екологічної зони тощо. Набір історичних даних. Дані з 01.08.2022 по 31.07.2024."}],"dct:identifier":"8e6fdfb3-a774-4414-bf66-0915fd813dc1","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct: