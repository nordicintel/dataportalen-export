source/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/ba2fb65d-9e3f-42a5-8656-b18518c4ea41#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Laddplats_Yta"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:77ec9d484268c23106a9e53b9d51602fb363999d74151bd4e921376b4714d292"},{"@graph":[{"@id":"_:7897988dc3ea84897b9837094cb6be5c3d2edf4cb8c9e275201a2645d16c17b6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df#HTTP:Nedladdning:data/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=69c8b476-f401-417a-970c-59812266af9b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2021-02-11"},"dct:description":{"@language":"sv","@value":"Innehåller fotavtryck till trädkronor inom Stockholms stad. Filen är framtagen från laserpunktmolnsdata med hjälp av mjukvaran TerraScan. Olika skript har körts på laserpunkter 1. punktmolnsdata har klassats efter om de tillhör mark, byggnader/broar och övrigt2. Sedan har med hjälp av olika skript valt ut objekt som liknar träd 3. sedan grupperades dessa punkter till individuella träd 4. sedan skapades en polygon för varje träd som representerar trädets fotavtryck på marken 5. Data granskades manuellt med hjälp av år 2022 ortofoto för att få bort felaktig identifierade trädpolygoner. Heltäckande data mängd över Stockholms stad. Begränsningar: Laserdata som användes är från 2022. Generellt innehåller datamängden bara träd som är mer en 3 kvm och minst 2.0 meter hög. Kända anomalier: Kvaliteten är högre för barrträd än för lövträd eftersom laserskanningen utförs innan lövspricknigen och det finns mindre laserreflekterande biomassa hos lövträden. Nyplanterade lövträd och hård beskurna träd finns ibland inte med i punktmolnet och därför inte heller får ett fotavtryck. Lövträd kan ibland har delats upp i flera fotavtryck."},"dct:identifier":"340a9ec7-290e-48bb-8e89-2615959f26df","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:7897988dc3ea84897b9837094cb6be5c3d2edf4cb8c9e275201a2645d16c17b6_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Träd - fotavtryck trädkronor 2022 (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/340a9ec7-290e-48bb-8e89-2615959f26df#HTTP:Nedladdning:data/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Trad_fotavtryck_tradkronor_Stockholm_2022.gpkg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"SBK Träd - fotavtryck trädkronor 2022 i GPKG-format, obs ca 3,5 GB"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:7