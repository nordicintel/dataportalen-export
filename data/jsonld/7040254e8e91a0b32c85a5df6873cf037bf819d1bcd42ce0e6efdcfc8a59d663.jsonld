holms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Stadsliv"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature19742957"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Ytgeometrier som används för att visa uppställningsytor och parkeringsplatser för elsparkcyklar i staden.Dessa ytor bör hållas fri från möblering och andra upplåtelser för att kunna användas. Påverkan på ytan ska meddelas ansvarig. Polistillstånd krävs för uppställningsplatserna för att använda offentlig plats. Information om uppställningsplatserna finns även hos Polismyndighet, för att underlätta tillståndsgivning.Kartlagret skapades upp under 2022, uppdateras vid behov och har en rutin om en årlig översyn under första kvartalet varje år.Ansvarig för kartlagret: Trafikkontoret, Tillståndsavdelningen, enheten Stadsliv."},"dct:identifier":"822b3154-1f6d-463d-9814-a5b5b1b9c97e","dct:issued":{"@type":"xsd:date","@value":"2022-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-06-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:b232fa33aa6c51a11a6bf13fbf56329f38043bc98e0318eae33f8325ead61433_b0n0"},"dct:title":{"@language":"sv","@value":"Elsparkcykelplats"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetWS.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Elsparkcykelplats_Yta&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:OGC:WFS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Elsparkcykelplats_Yta"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/822b3154-1f6d-463d-9814-a5b5b1b9c97e#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Elsparkcykelplats_Yta"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:b232fa33aa6c51a11a6bf13fbf56329f38043bc98e0318eae33f8325ead61433"},{"@graph":[{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/1aa0bb19-edd0-464b-b941-5c855b820f48","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=220f8cb5-043b-43e3-a07d-6ca694285b8d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":{"@language":"sv","@value":"Höjddata, 1 meters grid. De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 22 april - 7 maj 2023 och interpolerat till ett grid med upplösning 1 m. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna har inte ajourförts sedan de skapades. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna.Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom byggnaden. Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},"dct:identifier":"1aa0bb19-edd0-464b-b941-5c855b820f48","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b0n0"},"dct:temporal":{"@id":"_:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Höjdgrid (2023)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:b2a486802f2b81683c0cf802afcc3c7c715557b40bb6f22d7895f0581d8a03c1"},{"@graph":[{"@id":"_:b4339a5f3b7f27a160f8d9ae594c4303fb5f648c69415f415463fa8143ce3c1d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metada