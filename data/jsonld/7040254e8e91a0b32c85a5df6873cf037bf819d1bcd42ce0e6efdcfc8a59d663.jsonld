/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4382,18.2011 59.4382,18.2011 59.2272,17.7605 59.2272,17.7605 59.4382))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/b6b144d1-6f22-480a-9247-c16688153183","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/b6b144d1-6f22-480a-9247-c16688153183#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/b6b144d1-6f22-480a-9247-c16688153183#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":[{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stadsmiljö"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=297d40f0-5cec-43d9-811c-ed1ab556caa7"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-02-16"},"dct:description":{"@language":"sv","@value":"Miljöförvaltningen har i samverkan med berörda förvaltningar och bolag tagit fram lokal åtgärdsprogram för stadens vattenförekomster. De lokala åtgärdsprogrammen omfattar förslag på åtgärder som behöver genomföras för att förbättra vattenmiljön och nå god vattenstatus enligt gällande miljökvalitetsnormer. Många av åtgärderna för bättre vatten är kopplade till rening av dagvatten, som tar med sig olika föroreningar till våra sjöar och vattendrag. Andra åtgärder syftar till att förbättra miljön för vattenlevande djur, som att skapa fria vandringsvägar och bra uppväxt och lekmiljöer. Målet med åtgärdsarbete är friskare sjöar, som har ett rikt djur- och växtliv under ytan och samtidigt är fria från kemikalier som kan påverka sjöns ekosystem och människors hälsa negativt. Det är ansvariga förvaltningar och bolag som vidare utreder och genomför de föreslagna åtgärderna enligt de lokala åtgärdsprogrammen."},"dct:identifier":"b6b144d1-6f22-480a-9247-c16688153183","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:9194bc27159f2c2bb31c2dfbfb9c33da6ef59cdf8825921f39681ceb2f81f73d_b0n0"},"dct:title":{"@language":"sv","@value":"LÅP-åtgärder"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/b6b144d1-6f22-480a-9247-c16688153183#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/b34ccefcee844f29bc8d8a435053d681/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/b6b144d1-6f22-480a-9247-c16688153183#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"