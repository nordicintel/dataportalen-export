#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:56a3ef77d42c91facd6d42c2b69358cb04b914d1e31a673732928dfc7137e5c2"},{"@graph":[{"@id":"_:56cd0bf3e4310669966d45701b28db03bf7d64ad22af5af108c08e77ad7fd27a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:Nedladdning:data/7"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/1"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/3"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/4"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/5"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/6"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Tjänst för åtkomst till karta"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=34fc8b07-1d73-4461-8a32-a5e3236bb6cd"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Skyfall är intensiva regn som kan leda till att marken mättas och att dagvattensystemet överbelastas. Detta kan i sin tur orsaka översvämningar och medföra störningar och skador som påverkar både individer och viktiga samhällsfunktioner. Trafikkontoret i Stockholms stad tog under 2024 fram en ny skyfallsmodell som visar hur vatten rinner över ytan samt var vatten kan samlas vid kraftig nederbörd. Modellen har tagits fram för att ge stöd i planeringen av en mer motståndskraftig stad. Resultaten för tre olika nederbördsscenarier presenteras: ett 100-årsregn och ett 500-årsregn, båda anpassade för klimatförändringar genom en klimatfaktor på 1,40 och baserade på regional regnstatistik (\"Stockholmsregn\"), samt det så kallade Gävleregnet som föll över Gävle 2021 - den mest omfattande nederbörden i närtid i närheten av Stockholm.Tillgängliga metadata redovisar bland annat vilken höjdmodell som använts (inklusive identifierade lågpunkter), vilken karteringsmetod och upplösning som tillämpats. Det gör det möjligt att bedöma underlagets tillförlitlighet och genomföra enklare kvalitetskontroller av resultaten."},"dct:identifier":"3e07467b-22fb-4c70-bbab-33922584d021","dct:issued":{"@type":"xsd:date","@value":"2025-06-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:56cd0bf3e4310669966d45701b28db03bf7d64ad22af5af108c08e77ad7fd27a_b0n0"},"dct:title":{"@language":"sv","@value":"Stockholms Skyfallsmodell 2024 (TK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:Nedladdning:data/7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/downloads/skyfall/Skyfall%202024%20100-%C3%A5rsregn.zip"},"dct:description":"Nedladdningsbar Geotiff-fil","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Skyfall 2024 100-årsregn"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_100_framkomlighetskarta"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn framkomlighetskarta, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_100_framkomlighetskarta"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_100_maxdjup"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn maxdjup, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_100_maxdjup"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:SKYfall_2024_100_maxflode"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 100-årsregn maxflöde,OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_100_maxflode"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_500_framkomlighetskarta"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 500-årsregn framkomlighetskarta, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_500_framkomlighetskarta"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:Skyfall_2024_500_maxdjup"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 500-årsregn maxdjup, OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_500_maxdjup"},{"@id":"https://resources.stockholm.se/data/3e07467b-22fb-4c70-bbab-33922584d021#HTTP:OGC:WMS/6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=skyfall:SKYfall_2024_500_maxflode"},"dct:description":"TK Open data WMS tjänst, Skyfall 2024 500-årsregn maxflöde","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"skyfall:Skyfall_2024_500_maxflode"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:56cd0bf3e4310669966d45701b28db03bf7d64ad22af5af108c08e77ad7fd27a"},{"@graph":[{"@id":"_:583ed43d46b3dc822a778748692e7e01c09d6248c6ed21f543ef6993f10c262d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"https://resources.stockholm.se/data/2fcc6389-fc29-4e71-ac68-807abfc34c12","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:keyword":["Stockholms stad - Miljöförvaltningen",{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Naturinventeringar"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2d215c76-f915-49d4-8e10-b14ffebacc5c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-05-01"},"dct:description":{"@language":"sv","@value":"Syftet med en naturvärdesinventering (NVI) är att beskriva och värdera naturområden för att identifiera biologisk mångfald i ett avgränsat område. Naturvärdesinventeringar tas ofta fram som underlag till miljökonsekvensbeskrivningar (MKB) för att kunna bedöma påverkan på naturmiljöer vid till exempel en exploatering. Detta är en sammanställning av naturvärdesinventeringar utförda på uppdrag av Stockholms stads förvaltningar. Datamängden innehåller endast de inventeringar som levererats i lämpligt format. Det kan därför finnas fler inventeringar som inte är med i datamängden. Endast naturvärdesklasserna redovisas i samtliga inventeringar, utöver det har attribut tagits med där det gått. Inventeringarna har samlats av exploateringskontoret, stadsbyggnadskontoret, miljöförvaltningen och har sammanställs av miljöförvaltningens GIS-grupp. Tabellstrukturen följer SIS-standarden SIS/TS 199002 som gäller sedan 2023. Utförda inventeringar som inte följer SIS-standard SIS/TS 199002 har tilldelats värden som följer standarden. Attributuppsättningen utgör en delmängd av de attribut som förekommer i den geopackage mall som tillhör SIS/TS 199002 Sammanställningen tillgängliggörs i MGIS och som öppna data av miljöförvaltningen."},"dct:identifier":"2fcc6389-fc29-4e71-ac68-807abfc34c12","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dct:spatial":{"@id":"_:583ed43d46b3dc822a778748692e7e01c09d6248c6ed21f543ef6993f10c262d_b0n0"},"dct:title":{"@language":"sv","@value":"Naturvärdesinventeringar - Naturvärdesklass"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:mgis@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:583ed43d46b3dc822a778748692e7e01c09d6248c6ed21f543ef6993f10c262d"},{"@graph":[{"@id":"_:585dae7b596eee063f25e7a8252f81efbae6577e29c3269310cbe9721e2d0bd2_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/208b981b-84d8-4a76-b140-ab47673ff4c0","@type":["dcat:Dataset","dcat:dataset"],"dcat: