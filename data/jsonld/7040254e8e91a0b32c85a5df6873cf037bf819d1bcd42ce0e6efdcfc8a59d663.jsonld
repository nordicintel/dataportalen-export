e":"xsd:date","@value":"2021-12-31"},"dct:description":{"@language":"sv","@value":"Punktskikt med bilpoolsstationer från 2021-2024. Fasta parkeringsplatser för stationära bilpooler (och i den mån friflytande bilpooler även har fasta parkeringsplatser). Visar adress och bilpoolsoperatör som har en eller flera bilar på aktuell plats. Underlaget bygger på uppgifter från bilpoolsoperatörerna själva. Sammanställt av Sweco på uppdrag av miljöförvaltningen."},"dct:identifier":"1e2d37d6-1bbe-4c51-b182-f03854c13a9c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f055d72725890c0c6d021655da9aad62bc28f6ef97be663260202b03d737730d_b0n0"},"dct:title":{"@language":"sv","@value":"Bilpooler 2021-2024"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/f9b5d141c1694ceb827cf335be9bedd0_9/explore"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens Öppna data-hub"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:f055d72725890c0c6d021655da9aad62bc28f6ef97be663260202b03d737730d"},{"@graph":[{"@id":"_:f23f548508b6788e7a8cbd2010b3af3ab22745767bab0e14632023cfac2ffd43_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/b97a3896-90ba-41cc-bbe9-f8861263a06f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/b97a3896-90ba-41cc-bbe9-f8861263a06f#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=44565cba-5644-4f42-bf41-10e79a8e1d5f"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-05-31"},"dct:description":{"@language":"sv","@value":"Innehåller 2D RGB bilder av höjden av trädkrona ovanför mark nivå inom Stockholms stad. Filer är framtagen från laserpunktmolnsdata med hjälp av mjukvaran Terrascan. Olika skript har körts på laserpunkter 1. punktmolnsdata har klassats efter om de tillhör mark, byggnader/broar och övrigt 2. Sedan har med hjälp av olika skript valt ut objekt som liknar träd. 3.Beräkning av trädpunkt höjd över mark görs. 4. Konvertering av punktmoln till 50cm upplöste raster bild och färgsättning av rasterpixel efter median höjd inom den 50cm pixel. Olika färgkoder representerar avstånd ovanför mark av 50cm pixel. T.ex. gul representerar delar av trädkrona som är mellan 10 - 15m ovanför mark, mörk röd/brun representerar delar av trädkrona som är högre än 30m ovanför mark. Laserdata som användes är från 2022"},"dct:identifier":"b97a3896-90ba-41cc-bbe9-f8861263a06f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f23f548508b6788e7a8cbd2010b3af3ab22745767bab0e14632023cfac2ffd43_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Träd - Trädkronehöjd över mark 2022 (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/b97a3896-90ba-41cc-bbe9-f8861263a06f#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:f23f548508b6788e7a8cbd2010b3af3ab22745767bab0e14632023cfac2ffd43"},{"@graph":[{"@id":"_:f2ca108808e5c81499d9716b0b31acb2aa1b8951469c7076d5a5c5d01269892a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:Nedladdning/3"},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:OGC:WFS/4"},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature4000031"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som representerar data om vägbanans medelbredd, angiven i meter på vägsträcka. För belagda vägar avses avståndet mellan beläggningskanterna eller kantstöden. För övriga vägar avses den del av vägbanan som uppfyller den angivna bärigheten. Tillhör verksamhet NVDB (Trafikverket). Utbredning: Stockholms län"},"dct:identifier":"c1a59523-3153-433e-b8b3-357181a6cea8","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f2ca108808e5c81499d9716b0b31acb2aa1b8951469c7076d5a5c5d01269892a_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - Vägbredd"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/c1a59523-3153-433e-b8b3-357181a6cea8#HTTP:Nedladdning/2","@type":"dcat:Distribution","d