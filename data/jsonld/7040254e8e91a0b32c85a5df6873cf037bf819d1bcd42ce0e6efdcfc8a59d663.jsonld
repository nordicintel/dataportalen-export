rganisation/SE2120000142"},"dct:spatial":{"@id":"_:13252802ea2a0e90a9a581123a005e4fe9938ba6bd019699b59c57c921833274_b0n0"},"dct:title":{"@language":"sv","@value":"Boendestöd (ur Hitta Service API)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c3bbcf0b-8bbd-452f-9940-da3cd9d82db4#HTTP:API/1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://apigw.stockholm.se/api/PublicHittaCMS/api/serviceunits?&filter%5Bservicetype.id%5D=143&page%5Blimit%5D=1500&page%5Boffset%5D=0&sort=name"},"dct:title":"API anrop av servicetype = Boendestöd (JSON)"},{"@id":"https://resources.stockholm.se/data/c3bbcf0b-8bbd-452f-9940-da3cd9d82db4#HTTP:Information:Produktspecfikation/2","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stockholm-VattenOchAvfall/Dokumentation_Hitta_Service_API_(1).pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Dokumentation av API för Hitta Service (pdf)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsledningskontoret - Kommunikations- och omvärldsavdelningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ola.williams@stockholm.se"}}],"@id":"urn:source:13252802ea2a0e90a9a581123a005e4fe9938ba6bd019699b59c57c921833274"},{"@graph":[{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a9f1a78febef8cf650ef1cf3cf376d17a"},{"@id":"http://data.europa.eu/88u/dataset/a0f9b145-f0ba-49f6-9191-2995f3c8a32e","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/8b3ef976-b51e-43db-a7d7-d312c5fa630e"},{"@id":"http://data.europa.eu/88u/distribution/992f3cf0-fa1c-4f17-86af-3170fde98d1a"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2b68204e-ced2-4bcd-a72f-95f948a17808"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2024-01-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Лазерни точкови облаци от полет 2023 г. Обхваща цялата община Стокхолм, вкл. буферната зона наоколо. Формат на файла: LAS и POD. Височина на полета: плътност на пробиване: 16 pkt/m² Дата на полета: . Референтна система в план: Sweref 991800, на височина: RH2000 Лазерни данни, точкови облаци 2023Точковият облак идва от въздушно лазерно сканиране, извършено от Field Group над град Стокхолм през периода 22 април ? 7 май 2023 г. Контролът на покритието на лазерните данни се извършва визуално и със софтуер Terrascan. Плътността на точките за този проект е > 16pkt/m2Наземната класификация се контролира ръчно, докато класификацията на сградата е напълно автоматична и може да бъде с различно качество.Класирането на лазерни данни е разделено на следните класове: ? 1 (Некласифицирани) ? 2 (Марк) ? 6 (Сграда) ? 7 (високи и ниски точки, т.нар. шум) ? 9 (Вода) ? Точността на височината е 9 см или по-добра за твърди повърхности и 15 см или по-добра за други повърхности. В самолетите точността е 15 см или по-добра. Точковият облак е оцветен с ортофотографията от 2023 г., което означава, че на всяка точка е присвоена стойност RGB от съответния пиксел в ортофотографията. (Фотографска дата на ортофотоснимката: 20.4.2023 г. и 7.5.2023 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"Laserové mraky bodů z letu 2023. Zahrnuje celou obec Stockholm včetně nárazníkové zóny v okolí. Formát souboru: LAS a POD. Výška letu: Hustota propíchnutí: 16 pkt/m² Datum letu: . Referenční systém v plánu: Sweref 991800, na výšku: RH2000 Laserová data, mračna bodů 2023Mrak bodů pochází z leteckého laserového skenování, které provedla skupina Field Group nad městem Stockholm v období od 22. dubna ? května 2023. Kontrola pokrytí laserových dat byla provedena vizuálně a pomocí softwaru Terrascan. Bodová hustota pro tento projekt je > 16pkt/m2Klasifikace terénu je ručně řízena, zatímco klasifikace budov je plně automatická a může mít různou kvalitu.Klasifikace laserových dat je rozdělena do následujících tříd: ? 1 (neutajované) ? 2 (značka) ? 6 (Stavba) ? 7 (Vysoké a nízké body, tzv. hluk) ? 9 (voda) ? Přesnost ve výšce je 9 cm nebo lepší pro tvrdé povrchy a 15 cm nebo lepší pro jiné povrchy. V rovinách je přesnost 15 cm nebo lepší. Bodový mrak byl zbarven pomocí ortofotosnímku 2023, což znamená, že každému bodu byla přiřazena hodnota RGB z odpovídajícího pixelu na ortofotosnímku. (Datum pořízení ortofotosnímku: dubna a 7. května 2023)"},{"@language":"da-t-sv-t0-mtec","@value":"Laserpunktskyer fra flyvning 2023. Dækker hele Stockholm kommune inkl. stødpudezone omkring. Filformat: LAS og POD. Flyvehøjde:Punkttæthed: 16 pkt./m² Flyvedato: . Referencesystem i planen: Sweref 991800, i højden: RH2000 Laserdata, punktskyer 2023Punktskyen kommer fra luftbåren laserscanning, udført af Field Group, over Stockholm i perioden 22. april ? 7. maj 2023. Dækningskontrol af laserdata blev udført visuelt og med Terrascan-software. Punkttætheden for dette projekt er > 16pkt/m2Grundklassificeringen styres manuelt, mens bygningsklassificeringen er fuldautomatisk og kan være af varierende kvalitet.Klassificering af laserdata er opdelt i følgende klasser: ? 1 (ikke klassificeret) ? 2 (Mark) ? (flertydig) 6 (Bygning) ? 7 (høje og lave punkter såkaldt støj) ? 9 (Vand) ? Nøjagtigheden i højden er 9 cm eller bedre for hårde overflader og 15 cm eller bedre for andre overflader. I fly er nøjagtigheden 15 cm eller bedre. Punktskyen er blevet farvet ved hjælp af 2023-ortofotoet, hvilket betyder, at hvert punkt er blevet tildelt en RGB-værdi fra den tilsvarende pixel i ortofotoet. (Fotografidato for ortofotoet: 20/4 og 7/5 2023)"},{"@language":"de-t-sv-t0-mtec","@value":"Laserpunktwolken ab Flug 2023. Bedeckt die gesamte Gemeinde Stockholm inklusive Pufferzone. Dateiformat: LAS und POD. Flughöhe:Puncture Dichte: 16 pkt/m² Flugdatum: . Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000 Laserdaten, Punktwolken 2023Die Punktwolke stammt vom luftgestützten Laserscanning, durchgeführt von der Field Group, über der Stadt Stockholm im Zeitraum vom 22. April ? 7. Mai 2023. Die Abdeckungssteuerung der Laserdaten wurde visuell und mit Terrascan-Software durchgeführt. Die Punktdichte für dieses Projekt beträgt > 16pkt/m2Die Bodenklassifizierung wird manuell gesteuert, während die Gebäudeklassifizierung vollautomatisch ist und von unterschiedlicher Qualität sein kann.Die Klassifizierung von Laserdaten ist in die folgenden Klassen unterteilt: ? 1 (Nicht klassifiziert) ? 2 (Mark) ? 6 (Gebäude) ? 7 (Hoch- und Tiefpunkte, sogenanntes Rauschen) ? 9 (Wasser) ? Die Genauigkeit in der Höhe beträgt 9 cm oder besser für harte Oberflächen und 15 cm oder besser für andere Oberflächen. In Flugzeugen beträgt die Genauigkeit 15 cm oder besser. Die Punktwolke wurde mit dem Orthofoto 2023 eingefärbt, was bedeutet, dass jedem Punkt ein RGB-Wert aus dem entsprechenden Pixel im Orthofoto zugewiesen wurde. (Fotodatum des Orthofotos: 20/4 und 7/5 2023)"},{"@language":"el-t-sv-t0-mtec","@value":"Σύννεφα σημείου λέιζερ από την πτήση 2023. Καλύπτει ολόκληρο τον δήμο της Στοκχόλμης, συμπεριλαμβανομένης της νεκρής ζώνης. Μορφή αρχείου: LAS και POD. Ύψος πτήσης: Πυκνότητα οπής: 16 pkt/m² Ημερομηνία πτήσης: . Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: RH2000 Δεδομένα λέιζερ, νέφη σημείων 2023Το νέφος σημείων προέρχεται από αερομεταφερόμενη σάρωση λέιζερ, που πραγματοποιήθηκε από την Field Group, πάνω από την πόλη της Στοκχόλμης κατά την περίοδο 22 Απριλίου ? 7 Μαΐου 2023. Ο έλεγχος της κάλυψης των δεδομένων λέιζερ πραγματοποιήθηκε οπτικά και με το λογισμικό Terrascan. Η σημειακή πυκνότητα για αυτό το έργο είναι > 16Η ταξινόμηση του εδάφους ελέγχεται χειροκίνητα, ενώ η ταξινόμηση του κτιρίου είναι πλήρως αυτόματη και μπορεί να είναι ποικίλης ποιότητας.Η ταξινόμηση των δεδομένων λέιζερ χωρίζεται στις ακόλουθες κατηγορίες: ? 1 (Αταξινόμητο) ? 2 (Μάρκο) ? 6 (Κτίριο) ? 7 (Υψηλά και Χαμηλά σημεία αποκαλούμενος θόρυβος) ? 9 (Νερό) ? Η ακρίβεια στο ύψος είναι 9 cm ή καλύτερη για σκληρές επιφάνειες και 15 cm ή καλύτερη για άλλες επιφάνειες. Στα αεροπλάνα, η ακρίβεια είναι 15 cm ή καλύτερη. Το νέφος σημείων έχει χρωματιστεί με τη χρήση της ορθοφωτογραφίας 2023, πράγμα που σημαίνει ότι σε κάθε σημείο έχει αποδοθεί μια τιμή RGB από το αντίστοιχο εικονοστοιχείο στην ορθοφωτογραφία. (Ημερομηνία φωτογράφισης της ορθοφωτογραφίας: 20/4 και 7/5 2023)"},{"@language":"en-t-sv-t0-mtec","@value":"Laser point clouds from flight 2023. Covers the entire municipality of Stockholm incl buffer zone around. File format: LAS and POD. Flight height:Puncture density: 16 pkt/m² Flight date: . Reference system in plan: Sweref 991800, in height: RH2000 Laser data, point clouds 2023The point cloud comes from airborne laser scanning, performed by Field Group, over the City of Stockholm during the period 22 April ? 7 May 2023. Coverage control of laser data was performed visually and with Terrascan software. The point density for this project is > 16pkt/m2The ground classification is manually controlled while the building classification is fully automatic and can be of varying quality.Classing of laser data is divided into the following classes: ? 1 (Unclassified) ? 2 (Mark) ? 6 (Building) ? 7 (High and Low points so-called noise) ? 9 (Water) ? The accuracy in height is 9 cm or better for hard surfaces and 15 cm or better for other surfaces. In planes, the accuracy is 15 cm or better. The point cloud has been coloured using the 2023 orthophoto, meaning that each point has been assigned an RGB value from the corresponding pixel in the orthophoto. (Photography date of the orthophoto: 20/4 and 7/5 2023)"},{"@language":"es-t-sv-t0-mtec","@value":"Nubes de puntos láser del vuelo 2023. Cubre todo el municipio de Estocolmo, incluida la zona tampón alrededor. Formato de archivo: LAS y POD. Altura de vuelo: Densidad de perforación: 16 pkt/m² Fecha de vuelo: . Sistema de referencia en el plan: Sweref 991800, en altura: RH2000 Datos láser, nubes de puntos 2023La nube de puntos proviene del escaneo láser aerotransportado, realizado por Field Group, sobre la ciudad de Estocolmo durante el período 22 abril ? 7 de mayo de 2023. El control de cobertura de los datos láser se realizó visualmente y con el software Terrascan. La densidad de puntos para este proyecto es > 16pkt/m2La clasificación del suelo se controla manualmente mientras que la clasificación del edificio es totalmente automática y puede ser de calidad variable. ? 1 (sin clasificar) ? 2 (Marca) ? 6 (Edificio) ? 7 (Puntos altos y bajos llamados ruido) ? 9 (Agua) ? La precisión en altura es de 9 cm o mejor para superficies duras y 15 cm o mejor para otras superficies. En los planos, la precisión es de 15 cm o mejor. La nube de puntos se ha coloreado utilizando la ortofoto de 2023, lo que significa que a cada punto se le ha asignado un valor RGB del píxel correspondiente en la ortofoto. (Fecha de la fotografía de la ortofoto: 20 de abril y 7 de mayo de 2023)"},{"@language":"et-t-sv-t0-mtec","@value":"Laserpunktpilved alates 2023. aasta lennust. Hõlmab kogu Stockholmi omavalitsust, sh ümberringi asuvat puhvertsooni. Faili vorming: LAS ja POD. Lennu kõrgus: Löögitihedus: 16 pkt/m² Lennu kuupäev: . Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000 Laserandmed, punktpilved 2023Punktpilv pärineb õhus olevast laserskaneerimisest, mida teostas Field Group Stockholmi linna kohal perioodil 22. aprill ? 7. mai 2023. Laserandmete katvuse kontroll teostati visuaalselt ja Terrascani tarkvara abil. Selle projekti punkttihedus on > 16pkt/m2Maapinna klassifikatsioon on käsitsi kontrollitud, samas kui hoone klassifikatsioon on täisautomaatne ja võib olla erineva kvaliteediga.Laserandmete klassifitseerimine on jagatud järgmistesse klassidesse: ? 1 (liigitamata) ? 2 (Märkus) ? 6 (ehitus) ? 7 (kõrge ja madal punkt nn müra) ? 9 (vesi) ? Kõrguse täpsus on 9 cm või parem kõvadel pindadel ja 15 cm või parem muudel pindadel. Lennukites on täpsus 15 cm või parem. Punktipilv on värvitud 2023. aasta ortofoto abil, mis tähendab, et igale punktile on määratud RGB väärtus ortofoto vastavast pikslist. (Ortofoto foto kuupäev: 20/4 ja 7/5 2023)"},{"@language":"fi-t-sv-t0-mtec","@value":"Laserpistepilviä lennolta 2023. Kattaa koko Tukholman kunnan sisältäen puskurivyöhykkeen. Tiedostomuoto: LAS ja POD. Lennon korkeus:Punkture tiheys: 16 pkt/m² Lennon päivämäärä: . Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000 Laserdata, pistepilvet 2023Pistepilvi tulee Field Groupin suorittamasta laserkeilauksesta Tukholman kaupungin yllä 22.4. ? toukokuuta 2023. Laserdatan kattavuusohjaus suoritettiin visuaalisesti ja Terrascan-ohjelmistolla. Tämän projektin pistetiheys on > 16pkt/m2Maaluokitusta ohjataan manuaalisesti, kun taas rakennuksen luokitus on täysin automaattinen ja voi olla laadultaan vaihteleva.Laserdatan luokitus on jaettu seuraaviin luokkiin: ? 1 (Luokittelematon) ? 2 (merkki) ? 6 (Rakentaminen) ? 7 (korkeat ja matalat pisteet ns. melu) ? 9 (Vesi) ? Korkeustarkkuus on 9 cm tai parempi kovilla pinnoilla ja 15 cm tai parempi muilla pinnoilla. Lentokoneissa tarkkuus on 15 cm tai parempi. Pistepilvi on väritetty vuoden 2023 ortokuvalla, mikä tarkoittaa, että jokaiselle pisteelle on määritetty RGB-arvo ortokuvan vastaavasta pikselistä. (Ortokuvan kuvauspäivä: 20.4. ja 7.5.2023)"},{"@language":"fr-t-sv-t0-mtec","@value":"Nuages de point laser du vol 2023. Couvre l'ensemble de la municipalité de Stockholm, y compris la zone tampon autour. Format du fichier: LAS et POD. Hauteur de vol: Densité de perforation: 16 pkt/m² Date de vol: . Système de référence dans le plan: Sweref 991800, en hauteur: RH2000 Données laser, nuages de points 2023Le nuage de points provient du balayage laser aéroporté, effectué par Field Group, au-dessus de la ville de Stockholm au cours de la période du 22 avril? 7 mai 2023. Le contrôle de la couverture des données laser a été effectué visuellement et avec le logiciel Terrascan. La densité de points pour ce projet est > 16pkt/m2La classification du sol est contrôlée manuellement tandis que la classification du bâtiment est entièrement automatique et peut être de qualité variable. ? 1 (non classifié) ? 2 (marque) ? 6 (Bâtiment) ? 7 (Points haut et bas dits bruit) ? 9 (Eau) ? La précision en hauteur est de 9 cm ou mieux pour les surfaces dures et de 15 cm ou mieux pour les autres surfaces. Dans les avions, la précision est de 15 cm ou mieux. Le nuage de points a été coloré à l'aide de l'orthophoto 2023, ce qui signifie que chaque point a reçu une valeur RVB à partir du pixel correspondant dans l'orthophoto. (Date de photographie de l'orthophoto: 20/4 et 7/5 2023)"},{"@language":"ga-t-sv-t0-mtec","@value":"Néalta pointe léasair ó eitilt 2023. Cumhdaítear leis sin bardas iomlán Stócólm, lena n-áirítear crios maolánach timpeall air. Formáid an chomhaid: LAS agus POD. Airde eitilte: Dlús puncture: 16 pkt / m² Dáta Eitilte: . Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000 Sonraí léasair, scamaill phointe 2023Tagann an scamall pointe ó scanadh léasair aerbheirthe, arna dhéanamh ag Field Group, thar Chathair Stócólm le linn na tréimhse 22 Aibreán ? 7 Bealtaine 2023. Rinneadh rialú clúdaigh ar shonraí léasair ó amharc agus le bogearraí Terrascan. Tá dlús pointe an tionscadail seo > 16pkt / m2Déantar an t-aicmiú talún a rialú de láimh agus tá an t-aicmiú foirgnimh go hiomlán uathoibríoch agus is féidir leis a bheith de cháilíocht éagsúil. ? 1 (Neamhaicmithe) ? 2 (Marcáil) ? 6 (Foirgníocht) ? 7 (Pointí arda agus ísle mar a thugtar air torann) ? 9 (Uisce) ? Tá an cruinneas ar airde 9 cm nó níos fearr do dhromchlaí crua agus 15 cm nó níos fearr do dhromchlaí eile. I bplánaí, tá an cruinneas 15 cm nó níos fearr. Rinneadh an néalphointe a dhathú trí úsáid a bhaint as orta-ghrianghraf 2023, rud a chiallaíonn gur sannadh luach RGB do gach pointe ón bpicteilín comhfhreagrach san orta-ghrianghraf. (Dáta fótagrafaíochta an ortaphoto: 20/4 agus 7/5 2023)"},{"@language":"hr-t-sv-t0-mtec","@value":"Oblaci laserskih točaka iz leta 2023. Obuhvaća cijelu općinu Stockholm, uključujući tampon zonu oko nje. Format datoteke: LAS i POD. Visina leta: Gustoća vlaka: 16 pkt/m² Datum leta: . Referentni sustav u planu: Sweref 991800, u visini: RH2000 Laserski podaci, točkasti oblaci 2023.Točkasti oblak dolazi od laserskog skeniranja u zraku, koje je obavila Field Group, iznad grada Stockholma u razdoblju od 22. travnja ? 7. svibnja 2023. Kontrola pokrivenosti laserskim podacima provedena je vizualno i pomoću Terrascan softvera. Gustoća točke za ovaj projekt je > 16pkt/m2Klasifikacija tla ručno se kontrolira, dok je klasifikacija zgrade potpuno automatska i može biti različite kvalitete.Klasifikacija laserskih podataka podijeljena je u sljedeće razrede: ? 1 (Neklasificirano) ? 2 (Mark) ? 6 (zgrada) ? 7 (visoke i niske točke takozvane buke) ? 9 (Voda) ? Točnost u visini je 9 cm ili bolje za tvrde površine i 15 cm ili bolje za druge površine. U ravninama, točnost je 15 cm ili bolja. Oblak točke obojen je ortofotom iz 2023., što znači da je svakoj točki dodijeljena RGB vrijednost iz odgovarajućeg piksela u ortofotografiji. (Datum fotografije ortofotografije: i 7. svibnja 2023.)"},{"@language":"hu-t-sv-t0-mtec","@value":"Laser point clouds from flight 2023 (Lézerpontfelhők a 2023-as járatról). Stockholm teljes települését lefedi, beleértve a körülvevő pufferzónát is. Fájlformátum: LAS és POD. Repülési magasság: Nyitási sűrűség: 16 pkt/m² Járat dátuma: . Referenciarendszer a tervben: Sweref 991800, magassága: RH2000 Lézeradatok, pontfelhők 2023A pontfelhők légi lézerszkennelésből származnak, amelyet a Field Group végzett Stockholm városa felett április 22-én ? 2023. május 7. A lézeradatok lefedettségének ellenőrzését vizuálisan és Terrascan szoftverrel végeztük. Ennek a projektnek a pontsűrűsége > 16pkt/m2Az alaposztályozás manuálisan vezérelhető, míg az épületosztályozás teljesen automatikus és változó minőségű lehet.A lézeradatok osztályozása a következő osztályokra oszlik: ? - Igen. 1 (besorolatlan) ? 2 (Márk) ? 6 (épület) ? 7 (Magas és alacsony pontok, úgynevezett zaj) ? 9 (Víz) ? A magasság pontossága kemény felületek esetében 9 cm vagy jobb, más felületek esetében pedig 15 cm vagy jobb. Repülőgépeken a pontosság 15 cm vagy annál jobb. A pontfelhőt a 2023-as ortofotóval színezték, ami azt jelenti, hogy minden ponthoz hozzárendeltek egy RGB értéket az ortofotó megfelelő képpontjából. (Az ortofotó fényképezési dátuma: 2023. április 20. és május 7.)"},{"@language":"it-t-sv-t0-mtec","@value":"Nuvole di punti laser dal volo 2023. Copre l'intero comune di Stoccolma, compresa la zona cuscinetto intorno. Formato del file: LAS e POD. Altezza di volo: Densità di foratura: 16 pkt/m ² Data del volo: . Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000 Dati laser, nuvole di punti 2023La nuvola di punti proviene dalla scansione laser aerea, eseguita da Field Group, sulla città di Stoccolma nel periodo 22 aprile ? 7 maggio 2023. Il controllo della copertura dei dati laser è stato eseguito visivamente e con il software Terrascan. La densità del punto per questo progetto è > 16pkt/m2La classificazione del terreno è controllata manualmente mentre la classificazione dell'edificio è completamente automatica e può essere di qualità variabile.La classificazione dei dati laser è divisa nelle seguenti classi: ? 1 (non classificato) ? 2 (Marco) ? 6 (Edilizia) ? 7 (punti alti e bassi cosiddetto rumore) ? 9 (Acqua) ? La precisione in altezza è di 9 cm o migliore per le superfici dure e 15 cm o migliore per altre superfici. Negli aerei, la precisione è di 15 cm o superiore. La nuvola di punti è stata colorata utilizzando l'ortofoto 2023, il che significa che a ciascun punto è stato assegnato un valore RGB dal pixel corrispondente nell'ortofoto. (Data della fotografia dell'ortofoto: 20/4 e 7/5 2023)"},{"@language":"lt-t-sv-t0-mtec","@value":"2023 m. skrydžio lazerinių taškų debesys. Apima visą Stokholmo savivaldybę, įskaitant buferinę zoną aplink ją. Rinkmenos formatas: LAS ir POD. Skrydžio aukštis: punkcijos tankis: 16 pkt/m² Skrydžio data: . Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000 Lazeriniai duomenys, taškiniai debesys 2023Tiesioginiai debesys gaunami iš \"Field Group\" atlikto lazerinio skenavimo virš Stokholmo miesto per balandžio 22 d. \"?\" 2023 m. gegužės 7 d. Lazerių duomenų aprėpties kontrolė buvo atliekama vizualiai ir naudojant \"Terrascan\" programinę įrangą. Šio projekto taškų tankis yra > 16pkt/m2Žemės klasifikacija valdoma rankiniu būdu, o pastato klasifikacija yra visiškai automatinė ir gali būti įvairios kokybės.Lazerių duomenų klasifikavimas suskirstytas į šias klases: ? 1 (Neklasifikuotas) ? 2 (Žymėti) ? 6 (Statyba) ? 7 (aukšti ir žemi taškai, vadinamasis triukšmas) ? 9 (Vanduo) ? Kietų paviršių aukščio tikslumas yra 9 cm arba didesnis, o kitų paviršių - 15 cm arba didesnis. Plokštėse tikslumas yra 15 cm arba didesnis. Taškų debesis nuspalvintas naudojant 2023 m. ortofotografiją, o tai reiškia, kad kiekvienam taškui priskirta RGB vertė iš atitinkamo ortofotografijoje esančio pikselio. (Ortofotografijos data: 2023 m. balandžio 20 d. ir gegužės 7 d.)"},{"@language":"lv-t-sv-t0-mtec","@value":"Lāzera punktu mākoņi no 2023. gada lidojuma. Aptver visu Stokholmas pašvaldību, tostarp apkārt esošo buferzonu. Datnes formāts: LAS un POD. Lidojuma augstums: Punktu blīvums: 16 pkt/m² Lidojuma datums: . Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000 Lāzera dati, punktu mākoņi 2023Punktu mākonis nāk no lidaparāta lāzera skenēšanas, ko veica Field Group Stokholmas pilsētā laika posmā no 22. aprīļa ? 2023. gada 7. maijs. Lāzera datu pārklājuma kontrole tika veikta vizuāli un ar Terrascan programmatūru. Punktu blīvums šim projektam ir > 16pkt/m2Zemes klasifikācija tiek kontrolēta manuāli, bet ēku klasifikācija ir pilnībā automātiska un var būt dažādas kvalitātes.Lāzera datu klasifikācija ir sadalīta šādās klasēs: ? 1 (neklasificēts) ? 2 (Mark) ? 6 (Building) ? 7 (Augsts un zems punktu tā sauktais troksnis) ? 9 (Ūdens) ? Augstuma precizitāte ir 9 cm vai labāka cietām virsmām un 15 cm vai labāka citām virsmām. Lidmašīnās precizitāte ir 15 cm vai labāka. Punktu mākonis ir krāsots, izmantojot 2023. gada ortofoto, kas nozīmē, ka katram punktam ir piešķirta RGB vērtība no atbilstošā pikseļa ortofoto. (Ortofotoattēla uzņemšanas datums: (2023. gada 20./4. un 7./5.)"},{"@language":"mt-t-sv-t0-mtec","@value":"Sħubiji ta’ punti tal-laser mit-titjira 2023. Tkopri l-muniċipalità kollha ta’ Stokkolma inkluża ż-żona ta’ lqugħ madwarha. Format tal-fajl: il-LAS u l-POD. Għoli tat-titjira:Densità tat-titjira: 16 pkt/m² Data tat-titjira: . Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000 Data tal-laser, sħab tal-punt 2023Is-sħab tal-punt ġej minn skennjar bil-laser fl-ajru, imwettaq minn Field Group, fuq il-Belt ta' Stokkolma matul il-perjodu tat-22 ta' April ? 7 ta’ Mejju 2023. Il-kontroll tal-kopertura tad-data tal-laser twettaq viżwalment u bis-software Terrascan. Id-densità tal-punt għal dan il-proġett hija > 16pkt/m2Il-klassifikazzjoni tal-art hija kkontrollata manwalment filwaqt li l-klassifikazzjoni tal-bini hija kompletament awtomatika u tista’ tkun ta’ kwalità li tvarja.Il-klassifikazzjoni tad-data tal-laser hija maqsuma fil-klassijiet li ġejjin: ? 1 (Mhux klassifikat) ? 2 (Mark) ? 6 (Bini) ? 7 (Punti għoljin u baxxi hekk imsejħa storbju) ? 9 (Ilma) ? L-akkuratezza fl-għoli hija 9 cm jew aħjar għal uċuħ ibsin u 15 cm jew aħjar għal uċuħ oħra. Fil-pjan, il-preċiżjoni hija 15 cm jew aħjar. Is-sħaba tal-punt ġiet ikkulurita bl-użu tal-ortofoto tal-2023, li jfisser li kull punt ġie assenjat valur RGB mill-pixel korrispondenti fl-ortofoto. (Data tal-fotografija tal-ortofoto: 20/4 u 7/5 2023)"},{"@language":"nl-t-sv-t0-mtec","@value":"Laserpuntwolken vanaf vlucht 2023. Dekt de hele gemeente Stockholm incl bufferzone rond. Bestandsformaat: LAS en POD. Vluchthoogte: Punctuurdichtheid: 16 pkt/m² Vluchtdatum: . Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000 Lasergegevens, puntwolken 2023De puntwolk is afkomstig van laserscanning in de lucht, uitgevoerd door Field Group, boven de stad Stockholm tijdens de periode 22 april ? 7 mei 2023. Dekkingscontrole van lasergegevens werd visueel en met Terrascan-software uitgevoerd. De puntdichtheid voor dit project is > 16pkt/m2De grondclassificatie wordt handmatig geregeld terwijl de gebouwclassificatie volledig automatisch is en van verschillende kwaliteit kan zijn. ? 1 (Niet geclassificeerd) ? 2 (Mark) ? 6 (gebouw) ? 7 (Hoge en lage punten zogenaamde ruis) ? 9 (Water) ? De nauwkeurigheid in hoogte is 9 cm of beter voor harde oppervlakken en 15 cm of beter voor andere oppervlakken. In vliegtuigen is de nauwkeurigheid 15 cm of beter. De puntenwolk is gekleurd met de orthofoto van 2023, wat betekent dat elk punt een RGB-waarde heeft gekregen van de overeenkomstige pixel in de orthofoto. (Fotografie datum van de orthofoto: 20/4 en 7/5 2023)"},{"@language":"pl-t-sv-t0-mtec","@value":"Laserowe chmury punktów z lotu 2023. Obejmuje całą gminę Sztokholm, w tym strefę buforową wokół. Format pliku: LAS i POD. Wysokość lotu: Gęstość otworów: 16 pkt/m² Data lotu: . System odniesienia w planie: Sweref 991800, wysokość: Dane laserowe RH2000, chmury punktów 2023Chmura punktów pochodzi z lotniczego skanowania laserowego przeprowadzonego przez Field Group nad miastem Sztokholm w okresie 22 kwietnia ? 7 maja 2023 r. Kontrola pokrycia danych laserowych została przeprowadzona wizualnie i za pomocą oprogramowania Terrascan. Gęstość punktów dla tego projektu wynosi > 16pkt / m2Klasyfikacja podłoża jest sterowana ręcznie, podczas gdy klasyfikacja budynku jest w pełni automatyczna i może mieć różną jakość.Klasyfikacja danych laserowych jest podzielona na następujące klasy: ? 1 (Niesklasyfikowany) ? 2 (znak) ? 6 (Budynek) ? 7 (Wysokie i Niskie punkty tzw. noise) ? 9 (woda) ? Dokładność wysokości wynosi 9 cm lub lepiej dla twardych powierzchni i 15 cm lub lepiej dla innych powierzchni. W samolotach dokładność wynosi 15 cm lub więcej. Chmura punktów została zabarwiona za pomocą ortofotomapy 2023, co oznacza, że każdemu punktowi przypisano wartość RGB z odpowiedniego piksela na ortofotomapie. (Data zdjęcia ortofotomapy: 20 kwietnia i 7 maja 2023 r.)"},{"@language":"pt-t-sv-t0-mtec","@value":"Nuvens de ponto laser do voo 2023. Abrange todo o município de Estocolmo, incluindo a zona tampão circundante. Formato do ficheiro: LAS e POD. Altura de voo: Densidade da punção: 16 pkt/m² Data do voo: . Sistema de referência no plano: Sweref 991800, em altura: RH2000 Dados laser, nuvens de pontos 2023A nuvem de pontos vem da varredura a laser no ar, realizada pelo Field Group, sobre a cidade de Estocolmo durante o período 22 de abril ? 7 de maio de 2023. O controlo da cobertura dos dados a laser foi realizado visualmente e com o software Terrascan. A densidade de ponto para este projeto é > 16pkt/m2A classificação do solo é controlada manualmente, enquanto a classificação do edifício é totalmente automática e pode ser de qualidade variável.Classificação de dados a laser é dividida nas seguintes classes: ? 1 (não classificado) ? 2 (Marca) ? 6 (Edifício) ? 7 (Pontos altos e baixos chamados ruído) ? 9 (Água) ? A precisão na altura é 9 cm ou melhor para superfícies duras e 15 cm ou melhor para outras superfícies. Em aviões, a precisão é de 15 cm ou melhor. A nuvem de pontos foi colorida utilizando a ortofotografia de 2023, o que significa que a cada ponto foi atribuído um valor RGB a partir do pixel correspondente na ortofotografia. (Data da fotografia da ortofotografia: 20/4 e 7/5 2023)"},{"@language":"ro-t-sv-t0-mtec","@value":"Nori de puncte laser de la zborul 2023. Acoperă întreaga municipalitate Stockholm, inclusiv zona tampon din jur. Formatul fișierului: LAS și POD. Înălțimea de zbor: Densitatea puncturii: 16 pkt/m² Data zborului: . Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000 Date laser, nori de puncte 2023Norul de puncte provine din scanarea cu laser în aer, efectuată de Field Group, deasupra orașului Stockholm în perioada 22 aprilie ? 7 mai 2023. Controlul acoperirii datelor laser a fost efectuat vizual și cu software-ul Terrascan. Densitatea punctului pentru acest proiect este > 16pkt / m2Clasificarea la sol este controlată manual, în timp ce clasificarea clădirii este complet automată și poate fi de calitate variabilă.Clasificarea datelor laser este împărțită în următoarele clase: ? 1 (neclasificată) ? 2 (Mark) ? 6 (Clădire) ? 7 (Puncte înalte și joase, așa-numitul zgomot) ? 9 (Apă) ? Precizia în înălțime este de 9 cm sau mai bună pentru suprafețele dure și de 15 cm sau mai bună pentru alte suprafețe. În avioane, precizia este de 15 cm sau mai bună. Norul de puncte a fost colorat utilizând ortofoto 2023, ceea ce înseamnă că fiecărui punct i s-a atribuit o valoare RGB de la pixelul corespunzător din ortofoto. (Data fotografiei ortofoto: 20/4 și 7/5 2023)"},{"@language":"sk-t-sv-t0-mtec","@value":"Laserové bodové oblaky z letu 2023. Zahŕňa celú obec Štokholm vrátane nárazníkovej zóny v okolí. Formát súboru: LAS a POD. Výška letu: Hustota prieniku: 16 pkt/m² Dátum letu: . Referenčný systém v pláne: Sweref 991800, na výšku: RH2000 Laserové dáta, bodové oblaky 2023 Bodový oblak pochádza z leteckého laserového skenovania, ktoré vykonala Field Group nad mestom Štokholm v období od 22. apríla ? 7. mája 2023. Kontrola pokrytia laserových dát bola vykonaná vizuálne a so softvérom Terrascan. Bodová hustota pre tento projekt je > 16pkt/m2Klasifikácia terénu je manuálne riadená, zatiaľ čo klasifikácia budov je plne automatická a môže mať rôznu kvalitu.Klasifikácia laserových údajov je rozdelená do nasledujúcich tried: ? 1 (neklasifikované) ? 2 (Mark) ? 6 (budova) ? 7 (vysoké a nízke body, tzv. hluk) ? 9 (voda) ? Presnosť výšky je 9 cm alebo lepšia pre tvrdé povrchy a 15 cm alebo lepšia pre iné povrchy. V lietadlách je presnosť 15 cm alebo lepšia. Bodový oblak bol zafarbený pomocou ortofotografie 2023, čo znamená, že každému bodu bola priradená hodnota RGB zo zodpovedajúceho pixelu v ortofotografii. (Dátum ortofotografie: a 7. mája 2023)"},{"@language":"sl-t-sv-t0-mtec","@value":"Laserski oblaki točk iz leta 2023. Zajema celotno občino Stockholm, vključno z varovalnim pasom. Oblika datoteke: LAS in POD. Višina leta: gostota priključka: 16 pkt/m² Datum leta: . Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000 Laserski podatki, oblaki točk 2023Oblak točk prihaja iz laserskega skeniranja v zraku, ki ga je izvedla Field Group nad mestom Stockholm v obdobju 22. aprila ? 7. maj 2023. Nadzor pokritosti laserskih podatkov je bil opravljen vizualno in s programsko opremo Terrascan. Gostota točk za ta projekt je > 16pkt/m2Klasifikacija tal je ročno nadzorovana, klasifikacija stavb pa je popolnoma avtomatska in je lahko različne kakovosti.Razvrščanje laserskih podatkov je razdeljeno na naslednje razrede: ? 1 (nerazvrščeno) ? 2 (oznaka) ? 6 (Gradnja) ? 7 (Visoke in nizke točke, tako imenovani hrup) ? 9 (Voda) ? Natančnost višine je 9 cm ali boljša za trde površine in 15 cm ali boljša za druge površine. V ravninah je natančnost 15 cm ali boljša. Oblak točk je bil obarvan z ortofoto posnetkom za leto 2023, kar pomeni, da je bila vsaki točki dodeljena vrednost RGB iz ustrezne slikovne pike v ortofoto posnetku. (Fotografski datum ortofoto posnetka: in 7. maj 2023)"},{"@language":"sv","@value":"Laserpunktmoln från flygning 2023. Täcker hela Stockholms kommun inkl buffertzon runt. Filformat: LAS och POD. Flyghöjd:Punkttäthet: 16 pkt/m² Flygdatum: . Referenssytem i plan: Sweref 991800, i höjd: RH2000 Laserdata, punktmoln 2023Punktmolnet kommer från flygburen laserskanning, utförd av Field Group, över Stockholms stad under perioden 22 april ? 7 maj 2023. Täckningskontroll av laserdata utfördes visuellt och med programvaran Terrascan. Punkttätheten för detta projekt är > 16pkt/m2Markklassificeringen är manuellt kontrollerad medan byggnadsklassningen är helt automatiskt utförd och kan vara av varierande kvalitet.Klassning av laserdata delas upp i följande klasser: ? 1 (Oklassificerat) ? 2 (Mark) ? 6 (Byggnad) ? 7 (Hög- och Lågpunkter sk. brus) ? 9 (Vatten) ? 17 (Broar)Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre. Punktmolnet har färgsatts med hjälp av ortofotot från 2023, vilket innebär att varje punkt har tilldelats ett RGB-värde från motsvarande pixel i ortofotot. (Fotograferingsdatum för ortofotot: 20/4 och 7/5 2023)"},{"@language":"uk-t-sv-t0-mtec","@value":"Лазерні точкові хмари з польоту 2023 року. Охоплює весь муніципалітет Стокгольма, включаючи буферну зону навколо. Формат файлу: LAS і POD. Висота польоту:Щільність проколу: * 16 pkt/m² Дата польоту: . Референтна система в плані: Свереф 991800, по висоті: * Дані RH2000 Laser, хмари точок 2023 Хмара точок походить від повітряного лазерного сканування, проведеного Field Group, над містом Стокгольм у період 22 квітня ? 7 травня 2023 року. Управління покриттям лазерних даних здійснювалося візуально та за допомогою програмного забезпечення Terrascan. Точкова щільність для цього проекту > 16пкт/м2Класифікація заземлення контролюється вручну, тоді як класифікація будівлі повністю автоматична і може бути різної якості.Класизація лазерних даних поділяється на наступні класи: ? * 1 (некласифікований) ? * 2 (позначити) ? * 6 (Будівництво) ? 7 (Високі та низькі точки так званого шуму) ? * 9 (Вода) ? Точність по висоті становить 9 см або краще для твердих поверхонь і 15 см або краще для інших поверхонь. У площинах точність становить 15 см або краще. Хмара точок була забарвлена за допомогою ортофотоплану 2023 року, що означає, що кожній точці було присвоєно значення RGB з відповідного пікселя ортофотоплану. (Дата фотозйомки ортофотоплану: 20/4 та 7/5 2023)"}],"dct:format":"text/html","dct:identifier":"a0f9b145-f0ba-49f6-9191-2995f3c8a32e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b0n0"},"dct:temporal":{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Point Cloud — Въздушно лазерно сканиране (2023 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Point Cloud - letecké laserové skenování (2023)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Point Cloud - luftbåren laserscanning (2023)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Point Cloud - Luftgestütztes Laserscanning (2023)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Point Cloud - Αερομεταφερόμενη σάρωση με λέιζερ (2023)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Point Cloud - Escaneo láser aerotransportado (2023)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Point Cloud – õhus toimuv laserskaneerimine (2023)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Point Cloud - Analyse laser aéroportée (2023)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Point Cloud - Scanadh Léasair Aerbheirthe (2023)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Point Cloud – Airborne Laser Scanning (2023.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Point Cloud – Airborne Laser Scanning (2023) (SBK-pontfelhő – légi lézerszkennelés)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Point Cloud - Scansione laser aviotrasportata (2023)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Point Cloud - Lāzerskenēšana no gaisa (2023)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Point Cloud - Laserscanning in de lucht (2023)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Point Cloud – Skanowanie laserowe drogą powietrzną (2023)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (não traduzido para português) (2023)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Point Cloud – Scanarea cu laser aeropurtată (2023)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Point Cloud - Airborne Laser Scanning (2023)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Point Cloud – Airborne Laser Scanning (Oblak za točko SBK – lasersko skeniranje v zraku) (2023)"},{"@language":"sv","@value":"SBK Punktmoln - flygburen laserskanning (2023)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Point Cloud - Повітряне лазерне сканування (2023)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/8b3ef976-b51e-43db-a7d7-d312c5fa630e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-