ge":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature19743009"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Torghandelsplats visar stadens samtliga torghandelsplatser i form av ytor. Kartlagret visar både fasta och tillfälliga torghandelsplatser. De tillfälliga torghandelsplatserna beslutas i kommunfullmäktige, medan de fasta torghandelsplatserma beslutas av Trafikkontoret. Kartlagret används för att visa stadens torghandelsplatser och för att undvika att ytan används för annat än det är tänkt för. Uppdatering sker löpande vid behov. Ansvarig för datat är Trafikkontoret, Tillståndsavdelningen, enheten Stadsliv."},"dct:identifier":"acf1548e-2323-4ba3-a1c3-01311e95376d","dct:issued":{"@type":"xsd:date","@value":"2023-01-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5a0a3ec56429995be63591efdc9a462af95d3eca153b6d81c080472886593f2a_b0n0"},"dct:title":{"@language":"sv","@value":"Torghandelsplats"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/acf1548e-2323-4ba3-a1c3-01311e95376d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetWS.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/acf1548e-2323-4ba3-a1c3-01311e953