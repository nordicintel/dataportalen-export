5f3c8a32e","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:07Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:52Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/a0f9b145-f0ba-49f6-9191-2995f3c8a32e"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/a0f9b145-f0ba-49f6-9191-2995f3c8a32e"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:52Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"a0f9b145-f0ba-49f6-9191-2995f3c8a32e","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/a0f9b145-f0ba-49f6-9191-2995f3c8a32e"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1433c5fd9209b7939cd0c1b3dd714dc460a9937186dd97ac55ec01121f05c5f1"},{"@graph":[{"@id":"_:146b99c1c33024e2270fcd6c182f32c341a230155516bb653ada915a300dffee_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Nedladdning/3"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:OGC:WFS/4"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature4000027"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri"},"dct:identifier":"f39cd9ee-c78e-4de9-9420-ddcddf331b1d","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:146b99c1c33024e2270fcd6c182f32c341a230155516bb653ada915a300dffee_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - GCM-passage"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se/LvWS-2.2/Lv.asmx"},"dct:description":"Beskrivning av LvWS APIs olika metoder.","dct:title":"Tjänsteadress web service"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:Nedladdning/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:NVDB_GCM_passage&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:OGC:WFS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:NVDB_GCM_passage"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/f39cd9ee-c78e-4de9-9420-ddcddf331b1d#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:NVDB_GCM_passage"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:146b99c1c33024e2270fcd6c182f32c341a230155516bb653ada915a300dffee"},{"@graph":[{"@id":"_:15684bf9778fdac4c954f0ace729ad5e9dadb4580d62818289f97f9d71680088_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:15684bf9778fdac4c954f0ace729ad5e9dadb4580d62818289f97f9d71680088_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-05-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-05-11"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2024-05-17"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2024-05-11"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/5eab0b24-3e44-4d2d-90e7-ed8c0d25aea9","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/5eab0b24-3e44-4d2d-90e7-ed8c0d25aea9#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=dac49d10-5450-4bc4-bcda-c266773258b0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Infraröd ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Användningsområden: Infraröda bilder används oftast för att göra analyser på växtlighet. Bilderna gör det till exempel möjligt att se om ett område är fuktigt, vilken vegetation som finns, se vissa trädarter, om våtmarker är utdikade och om det finns stigar eller småvägar i ett skogsparti Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"5eab0b24-3e44-4d2d-90e7-ed8c0d25aea9","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:15684bf9778fdac4c954f0ace729ad5e9dadb4580d62818289f97f9d71680088_b0n0"},"dct:temporal":{"@id":"_:15684bf9778fdac4c954f0ace729ad5e9dadb4580d62818289f97f9d71680088_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant IR (2025)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/5eab0b24-3e44-4d2d-90e7-ed8c0d25aea9#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:15684bf9778fdac4c954f0ace729ad5e9dadb4580d62818289f97f9d71680088"},{"@graph":[{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1297adda9dc83e90fbc968572d7166fded"},{"@id":"http://data.europa.eu/88u/dataset/6d551505-3721-4f2e-8ff6-0968aa9b647e","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=74fb37e4-a07a-45bb-809f-f85e2d812134"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1998-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: 3000 m, разделителна способност: 16 см/пиксел в ортофото. Липсват несертифицирани изображения. Не изглежда да има WMS услуга с тази ортофото. Дата на снимката: април-май 1998 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: 3000 m, rozlišení: 16 cm/pixel v ortofotosnímku. Chybí neověřené obrázky. Zdá se, že s tímto ortofotosnímkem není služba WMS. Datum pořízení fotografie: duben–květen 1998."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: 3000 m, opløsning: 16 cm/pixel i ortofoto. Ucertificerede billeder mangler. Der ser ikke ud til at være en WMS-tjeneste med dette ortofoto. Fotografiets dato: april-maj 1998."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: 3000 m, Auflösung: 16 cm/Pixel im Orthofoto. Unzertifizierte Bilder fehlen. Es scheint keinen WMS-Service mit diesem Orthofoto zu geben. Fotodatum: April-Mai 1998."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: 3000 m, ανάλυση: 16 cm/pixel σε ορθοφωτογραφία. Λείπουν μη πιστοποιημένες εικόνες. Δεν φαίνεται να υπάρχει υπηρεσία WMS με αυτή την ορθοφωτογραφία. Ημερομηνία φωτογραφίας: Απρίλιος-Μάιος 1998."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: 3000 m, resolution: 16 cm/pixel in orthophoto. Uncertified images are missing. There doesn't seem to be a WMS service with this orthophoto. Date of photograph: April-May 1998."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: 3000 m, resolución: 16 cm/píxel en ortofoto. Faltan imágenes no certificadas. No parece haber un servicio de WMS con esta ortofoto. Fecha de la fotografía: Abril-mayo de 1998."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: 3000 m, eraldusvõime: 16 cm/piksel ortofotos. Sertifitseerimata pildid puuduvad. Tundub, et selle ortofotoga pole WMS-i teenust. Foto kuupäev: Aprill–mai 1998."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: 3000 m, resoluutio: 16 cm/pikseli ortokuvassa. Varmentamattomat kuvat puuttuvat. Tällä ortokuvalla ei näytä olevan WMS-palvelua. Valokuvauksen päivämäärä: Huhti-toukokuu 1998."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: 3000 m, résolution: 16 cm/pixel en orthophoto. Il manque des images non certifiées. Il ne semble pas y avoir de service WMS avec cette orthophoto. Date de la photographie: Avril-mai 1998."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: 3000 m, taifeach: 16 cm/picteilín in orthophoto. Tá íomhánna neamhdheimhnithe ar iarraidh. Ní cosúil go bhfuil seirbhís WMS leis an orthophoto seo. Dáta an ghrianghraif: Aibreán-Bealtaine 1998."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: 3000 m, razlučivost: 16 cm/piksel u ortofotografiji. Nedostaju necertificirane slike. Čini se da ne postoji WMS usluga s ovom ortofotografijom. Datum fotografije: Travanj-svibanj 1998."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: 3000 m, felbontás: 16 cm/pixel ortofotóban. A nem hitelesített képek hiányoznak. Úgy tűnik, nincs WMS szolgáltatás ezzel az ortofotóval. Fénykép dátuma: 1998. április-május."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: 3000 m, risoluzione: 16 cm/pixel in ortofoto. Mancano immagini non certificate. Non sembra esserci un servizio WMS con questa ortofoto. Data della fotografia: aprile-maggio 1998."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: 3000 m, skiriamoji geba: 16 cm/pikselis ortofotografijoje. Trūksta nesertifikuotų vaizdų. Atrodo, kad nėra WMS paslaugos su šia ortofotografija. Fotografavimo data: 1998 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: 3000 m, izšķirtspēja: 16 cm/pikselis ortofoto. Trūkst neapliecinātu attēlu. Šķiet, ka ar šo ortofoto nav WMS pakalpojuma. Fotogrāfijas datums: 1998. gada aprīlis–maijs."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: 3000 m, riżoluzzjoni: 16 cm/pixel fl-ortofoto. L-immaġnijiet mhux iċċertifikati huma neqsin. Ma jidhirx li hemm servizz ta 'WMS b'dan l-ortofoto. Data tar-ritratt: April-Mejju 1998."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: 3000 m, resolutie: 16 cm/pixel in orthofoto. Ongecertificeerde foto's ontbreken. Er lijkt geen WMS-service te zijn met deze orthofoto. Datum van de foto: april-mei 1998."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: 3000 m, rozdzielczość: 16 cm/piksel w ortofotomapie. Brakuje niecertyfikowanych zdjęć. Wydaje się, że nie ma usługi WMS z tym ortofotomapą. Data zdjęcia: kwiecień-maj 1998 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: 3000 m, resolução: 16 cm/pixel em ortofotografia. Faltam imagens não certificadas. Não parece haver um serviço WMS com esta ortofotografia. Data da fotografia: Abril-Maio de 1998."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: 3000 m, rezoluție: 16 cm/pixel în ortofotografie. Imaginile necertificate lipsesc. Nu pare să existe un serviciu WMS cu această ortofotografie. Data fotografiei: aprilie-mai 1998."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: 3000 m, rozlíšenie: 16 cm/pixel v ortofotografii. Chýbajú neoverené obrázky. S touto ortofotografiou sa nezdá, že by existovala služba WMS. Dátum fotografie: apríl – máj 1998."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: 3000 m, ločljivost: 16 cm/piksel v ortofotu. Manjkajo nepreverjene slike. Zdi se, da ni storitve WMS s tem ortofoto. Datum fotografiranja: Od aprila do maja 1998."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 3000 m, upplösning: 16 cm/pixel i ortofoto. Orektifierade bilderna försvunna. Det verkar inte finnas en WMS-tjänst med detta ortofoto. Fotograferingsdatum: april-maj 1998."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: 3000 м, роздільна здатність: 16 см/піксель в ортофотоплані. Несертифіковані зображення відсутні. Здається, немає служби WMS з цим ортофотопланом. Дата фотографії: Квітень-травень 1998 року."}],"dct:format":"text/html","dct:identifier":"6d551505-3721-4f2e-8ff6-0968aa9b647e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:15bc474f940649102c5f5359be5bb72a7aea2bbbec8df9bfdb7589b42ea7732a_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофото (1998)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) (hudební videoklip)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορθοφύτου (1998)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (1998.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) Sistēmas Prasības"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (1998)"},{"@language":"sv","@value":"SBK Ortofoto (1998)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (SBK Orthofoto) (1998)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/2dfc7ea4-57bc-4806-99d2-b976a045a1e3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/6d551505-3721-4f2e-8ff6-0968aa9b647e#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value