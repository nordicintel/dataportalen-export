d+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3"},{"@graph":[{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information/2"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information:Produktspecfikation/1"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Nedladdning:data/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"SBK Planeringsunderlag"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3c463b5f-2b62-4b62-b131-a3eefcad2515"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":{"@language":"sv","@value":"De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 9 april7 maj 2024. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna ajourförs inte sedan de skapas. Datat är interpolerat till ett grid med upplösning 1 m. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. De kända höjderna är mätta runtom byggnaden.Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},"dct:identifier":"ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b0n0"},"dct:temporal":{"@id":"_:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0eacfad21c8c197c_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Höjdgrid (2024)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information:Produktspecfikation/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_H%C3%B6jdgrid.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Produktspecifikation"},{"@id":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Nedladdning:data/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/H%C3%B6jdgrid.dwg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Testdata DWG-format"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:85de8da924e558093ecb3b506f2d88ddf6301cc33ef459fe0