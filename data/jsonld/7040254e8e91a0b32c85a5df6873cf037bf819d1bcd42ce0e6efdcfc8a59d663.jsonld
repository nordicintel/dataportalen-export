4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2798052f-108b-461a-a894-0f5da1d024f9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2016-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Bilderna är ganska gröna. Flyghöjd: ca 2700 meter över marken. Upplösning: 12 cm på marken per pixel. Övertäckning %: 60/60. Fotograferingsdatum: 8 maj 2016. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d","dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258_b0n0"},"dct:temporal":{"@id":"_:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2016)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2016"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2016"},{"@id":"https://resources.stockholm.se/data/dcfe4a21-bf6e-4a6b-b547-b9b9c59a7a3d#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2016"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2016"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:8042380cc47045abf2d6a0642f055c2f0a984b92efcf298fa8307b8bc0260258"},{"@graph":[{"@id":"_:80685d6376b04930b19154ebfe3b80b03fd45e15a78dabc9675c1510a7ad7388_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((18.0319 59.3347,18.0333 59.3347,18.0333 59.334,18.0319 59.334,18.0319 59.3347))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((18.0319 59.3347,18.0333 59.3347,18.0333 59.334,18.0319 59.334,18.0319 59.3347))"}},{"@id":"_:80685d6376b04930b19154ebfe3b80b03fd45e15a78dabc9675c1510a7ad7388_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2021-04-30"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-10-15"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2021-04-30"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2020-10-15"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f","@type":["dcat:Dataset","dcat:dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Trafikkontoret+-+Trafikplaneraravdelningen+-+Analys+och+strategi/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:API/2"},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:API/3"},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:Information:Produktspecfikation/1"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=92b237a7-afaf-42d0-944c-0e055e32386b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"2020-11-18"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller information om passager i korsningen St Eriksgatan  Fleminggatan i Stockholms stad och inkluderar information om trafikanttyp, riktning, tidpunkt för passage m.m. Data samlas in i realtid via en multifunktionssensor och uppdateras i nära realitid under hösten 2020 till 30 april 2021. Datamängden publiceras som ett test inom programmet Smart och uppkopplad stad i Stockholms stad samt projektet Ökad användning av öppna data i Stockholmsregionen. Eftersom det är ett test kan datakvaliteten variera. Exempelvis har detektion av bilar högre kvalitet än detektering av cyklar. Generellt går precisionen ner för mer udda trafikanttyper."},"dct:identifier":"698101ee-5239-47f2-ad44-05a3d3b6357f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:80685d6376b04930b19154ebfe3b80b03fd45e15a78dabc9675c1510a7ad7388_b0n0"},"dct:temporal":{"@id":"_:80685d6376b04930b19154ebfe3b80b03fd45e15a78dabc9675c1510a7ad7388_b1n0"},"dct:title":{"@language":"sv","@value":"Pilottest trafikflöde i korsningen St Eriksgatan/Fleminggatan"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:API/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apigw.stockholm.se/api/PublicTrafficFlow/ReceiveTrafficFlowRequest/?fromdate=2020-11-09T11:00:00&todate=2020-11-09T12:00:00&SensorID=1-Vendor2"},"dct:title":"Exempel på trafikdata (9 nov kl 11 - 9 nov kl 12)"},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:API/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://apigw.stockholm.se/api/PublicTrafficFlow/ReceiveTrafficFlowRequest/?fromdate=fromDate&toDate=todate&vehicleType=vehicleType&sensorId=sensorId"},"dct:title":"API-format för att hämta trafikdata (se beskrivning i API-dokumentationen)"},{"@id":"https://resources.stockholm.se/data/698101ee-5239-47f2-ad44-05a3d3b6357f#HTTP:Information:Produktspecfikation/1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Trafikkontoret/API_Dokumentation_for_SensorDatatjansten.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"API Dokumentation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Trafikkontoret+-+Trafikplaneraravdelningen+-+Analys+och+strategi/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Trafikkontoret - Trafikplaneraravdelningen - Analys och strategi"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:trafikdata.tk@stockholm.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-50826656"}}],"@id":"urn:source:80685d6376b04930b19154ebfe3b80b03fd45e15a78dabc9675c1510a7ad7388"},{"@graph":[{"@id":"_:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4426,18.2011 59.4426,18.2011 59.2272,17.7605 59.2272,17.7605 59.4426))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4426,18.2011 59.4426,18.2011 59.2272,17.7605 59.2272,17.7605 59.4426))"}},{"@id":"_:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"154be4beb2754cf61693c8bc23fc698394"},{"@id":"http://data.europa.eu/88u/dataset/fddcb042-f88f-4501-9671-9714714dbe97","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/4582070e-be30-4d46-b307-8d80426ddad6"},{"@id":"http://data.europa.eu/88u/distribution/a5cef749-bb9f-49d8-80bd-e1cb77f988b4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=Miljodata0013"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"1997-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Резултати от проучването на IVL на медни покриви в Стокхолм, Солна и Сундбиберг въз основа на цифрови IR въздушни изображения от 1997 г. Допълнителна информация: Картографиране на медни покриви в Стокхолм, Солна и Сундбиберг с цифрови въздушни изображения. Sam Ekstrand et.al. (Сам Екстранд и др.) Доклад за IVL. Стокхолм, октомври 1997 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Výsledky průzkumu měděných střech IVL ve Stockholmu, Solně a Sundbybergu na základě digitálních IR leteckých snímků z roku 1997. Další informace: Mapování měděných střech ve Stockholmu, Solně a Sundbybergu pomocí digitálních leteckých snímků. Sam Ekstrand a další. Zpráva o IVL. Stockholm, říjen 1997."},{"@language":"da-t-sv-t0-mtec","@value":"Resultater fra IVL's kortlægning af kobbertage i Stockholm, Solna og Sundbyberg baseret på digitale IR-antennebilleder fra 1997. Yderligere oplysninger: Kortlægning af kobbertage i Stockholm, Solna og Sundbyberg med digitale luftfotos. Sam Ekstrand et.al. IVL-rapporten. Stockholm, oktober 1997."},{"@language":"de-t-sv-t0-mtec","@value":"Ergebnisse der IVL-Vermessung von Kupferdächern in Stockholm, Solna und Sundbyberg basierend auf digitalen IR-Luftbildern aus dem Jahr 1997. Zusätzliche Informationen: Kartierung von Kupferdächern in Stockholm, Solna und Sundbyberg mit digitalen Luftbildern. Sam Ekstrand et.al. IVL-Bericht. Stockholm, im Oktober 1997."},{"@language":"el-t-sv-t0-mtec","@value":"Αποτελέσματα από την έρευνα IVL των στεγών χαλκού στη Στοκχόλμη, Solna και Sundbyberg με βάση τις ψηφιακές εναέριες εικόνες IR από το 1997. Συμπληρωματικές πληροφορίες: Χαρτογράφηση των στεγών χαλκού στη Στοκχόλμη, Solna και Sundbyberg με ψηφιακές εναέριες εικόνες. Sam Ekstrand et.al. (στα Αγγλικά). Έκθεση IVL. Στοκχόλμη, Οκτώβριος 1997."},{"@language":"en-t-sv-t0-mtec","@value":"Results from IVL's survey of copper roofs in Stockholm, Solna and Sundbyberg based on digital IR aerial images from 1997. Additional information: Mapping of copper roofs in Stockholm, Solna and Sundbyberg with digital aerial images. Sam Ekstrand et.al. IVL Report. Stockholm, October 1997."},{"@language":"es-t-sv-t0-mtec","@value":"Resultados de la encuesta de IVL de techos de cobre en Estocolmo, Solna y Sundbyberg basada en imágenes aéreas IR digitales de 1997. Información adicional: Mapeo de techos de cobre en Estocolmo, Solna y Sundbyberg con imágenes aéreas digitales. Sam Ekstrand y otros Informe IVL. Estocolmo, octubre de 1997."},{"@language":"et-t-sv-t0-mtec","@value":"IVLi Stockholmi, Solna ja Sundbybergi vaskkatuste uuringu tulemused, mis põhinevad 1997. aasta digitaalsetel IR-antennipiltidel. Lisateave: Vaskkatuste kaardistamine Stockholmis, Solnas ja Sundbybergis digitaalsete aerofotodega. Sam Ekstrand et.al. IVL aruanne. Stockholm, oktoober 1997."},{"@language":"fi-t-sv-t0-mtec","@value":"Tulokset IVL:n kuparikattotutkimuksesta Tukholmassa, Solnassa ja Sundbybergissä perustuen digitaalisiin IR-antennikuviin vuodelta 1997. Lisätietoja: Kuparikattojen kartoitus Tukholmassa, Solnassa ja Sundbybergissä digitaalisilla ilmakuvilla. Sam Ekstrand et.al. IVL-raportti. Tukholma, lokakuu 1997."},{"@language":"fr-t-sv-t0-mtec","@value":"Résultats de l'enquête d'IVL sur les toits en cuivre à Stockholm, Solna et Sundbyberg sur la base d'images aériennes IR numériques de 1997. Informations complémentaires: Cartographie des toits en cuivre à Stockholm, Solna et Sundbyberg avec des images aériennes numériques. Sam Ekstrand et al. Rapport IVL. Stockholm, octobre 1997."},{"@language":"ga-t-sv-t0-mtec","@value":"Torthaí ó shuirbhé IVL ar dhíonta copair i Stócólm, Solna agus Sundbyberg bunaithe ar íomhánna ón aer digiteach IR ó 1997. Faisnéis bhreise: Díonta copair a mhapáil i Stócólm, Solna agus Sundbyberg le haeríomhánna digiteacha. Sam Ekstrand et.al. Tuarascáil IVL. Stócólm, Deireadh Fómhair 1997."},{"@language":"hr-t-sv-t0-mtec","@value":"Rezultati IVL-ovog istraživanja bakrenih krovova u Stockholmu, Solni i Sundbybergu na temelju digitalnih IR zračnih snimaka iz 1997. godine. Dodatne informacije: Mapiranje bakrenih krovova u Stockholmu, Solni i Sundbybergu s digitalnim slikama iz zraka. Sam Ekstrand et.al. Izvješće IVL-a. Stockholm, listopad 1997."},{"@language":"hu-t-sv-t0-mtec","@value":"Az IVL stockholmi, Solna-i és Sundbyberg-i réztetők felmérése az 1997-es digitális IR légi felvételek alapján. További információk: Réztetők feltérképezése Stockholmban, Solnában és Sundbybergben digitális légi felvételekkel. Sam Ekstrand és társai. IVL jelentés. Stockholm, 1997. október."},{"@language":"it-t-sv-t0-mtec","@value":"I risultati dell'indagine di IVL sui tetti in rame a Stoccolma, Solna e Sundbyberg si basano su immagini aeree IR digitali del 1997. Ulteriori informazioni: Mappatura dei tetti in rame a Stoccolma, Solna e Sundbyberg con immagini aeree digitali. Sam Ekstrand et.al. Relazione IVL. Stoccolma, ottobre 1997."},{"@language":"lt-t-sv-t0-mtec","@value":"IVL atliktos varinių stogų Stokholme, Solnoje ir Sundbyberge apklausos, pagrįstos 1997 m. skaitmeniniais IR aeronuotraukomis, rezultatai. Papildoma informacija: Varinių stogų kartografavimas Stokholme, Solnoje ir Sundbyberge su skaitmeniniais vaizdais iš oro. Sam Ekstrand et.al. IVL ataskaita. Stokholmas, 1997 m. spalio mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Rezultāti, kas gūti IVL veiktajā vara jumtu apsekojumā Stokholmā, Solnā un Sundbybergā, pamatojoties uz 1997. gada digitālajiem IR gaisa attēliem. Papildu informācija: Vara jumtu kartēšana Stokholmā, Solnā un Sundbybergā ar digitāliem gaisa attēliem. Sam Ekstrand et.al. IVL ziņojums. Stokholmā, 1997. gada oktobrī."},{"@language":"mt-t-sv-t0-mtec","@value":"Riżultati mill-istħarriġ tal-IVL dwar is-soqfa tar-ram fi Stokkolma, Solna u Sundbyberg ibbażat fuq immaġnijiet diġitali tal-ajru IR mill-1997. Informazzjoni addizzjonali: Immappjar tas-soqfa tar-ram fi Stokkolma, Solna u Sundbyberg b’immaġnijiet diġitali mill-ajru. Sam Ekstrand et.al. Rapport IVL. Stokkolma, Ottubru 1997."},{"@language":"nl-t-sv-t0-mtec","@value":"Resultaten van IVL's onderzoek naar koperen daken in Stockholm, Solna en Sundbyberg op basis van digitale IR-luchtfoto's uit 1997. Aanvullende informatie: Het in kaart brengen van koperen daken in Stockholm, Solna en Sundbyberg met digitale luchtfoto's. Sam Ekstrand et.al. IVL-verslag. Stockholm, oktober 1997."},{"@language":"pl-t-sv-t0-mtec","@value":"Wyniki badania dachów miedzianych przeprowadzonego przez IVL w Sztokholmie, Solnie i Sundbybergu na podstawie cyfrowych zdjęć lotniczych na podczerwień z 1997 r. Dodatkowe informacje: Mapowanie dachów miedzianych w Sztokholmie, Solnie i Sundbybergu za pomocą cyfrowych zdjęć lotniczych. Sam Ekstrand et.al. (ang.). Sprawozdanie IVL. Sztokholm, październik 1997 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Resultados do levantamento da IVL de telhados de cobre em Estocolmo, Solna e Sundbyberg com base em imagens aéreas de infravermelhos digitais de 1997. Informações adicionais: Mapeamento de telhados de cobre em Estocolmo, Solna e Sundbyberg com imagens aéreas digitais. Sam Ekstrand et.al. Relatório IVL. Estocolmo, Outubro de 1997."},{"@language":"ro-t-sv-t0-mtec","@value":"Rezultatele studiului IVL privind acoperișurile din cupru din Stockholm, Solna și Sundbyberg, bazate pe imagini aeriene digitale IR din 1997. Informații suplimentare: Cartografierea acoperișurilor din cupru din Stockholm, Solna și Sundbyberg cu imagini aeriene digitale. Sam Ekstrand și alții. Raportul IVL. Stockholm, octombrie 1997."},{"@language":"sk-t-sv-t0-mtec","@value":"Výsledky prieskumu spoločnosti IVL týkajúceho sa medených striech v Štokholme, Solne a Sundbybergu na základe digitálnych infračervených leteckých snímok z roku 1997. Doplňujúce informácie: Mapovanie medených striech v Štokholme, Solne a Sundbybergu pomocou digitálnych leteckých snímok. Sam Ekstrand et.al. Správa IVL. Štokholm, október 1997."},{"@language":"sl-t-sv-t0-mtec","@value":"Rezultati IVL-ove raziskave bakrenih streh v Stockholmu, Solni in Sundbybergu na podlagi digitalnih IR aerofotografij iz leta 1997. Dodatne informacije: Kartiranje bakrenih streh v Stockholmu, Solni in Sundbybergu z digitalnimi posnetki iz zraka. Sam Ekstrand et.al. Poročilo IVL. Stockholm, oktober 1997."},{"@language":"sv","@value":"Resultat från IVLs kartläggning av koppartak i Stockholm, Solna och Sundbyberg utifrån digitala IR-flygbilder från 1997. Ytterligare information: Kartläggning av koppartak i Stockholm, Solna och Sundbyberg med digitala flygbilder. Sam Ekstrand et.al. IVL-Rapport. Stockholm, oktober 1997."},{"@language":"uk-t-sv-t0-mtec","@value":"Результати обстеження мідних покрівель IVL у Стокгольмі, Солні та Сундбіберзі на основі цифрових інфрачервоних аерофотознімків 1997 року. Додаткова інформація: Картування мідних дахів у Стокгольмі, Солні та Сундбіберзі за допомогою цифрових аерофотознімків. Сем Екстранд та ін. IVL Report (англ.). Стокгольм, жовтень 1997 року."}],"dct:format":"text/html","dct:identifier":"fddcb042-f88f-4501-9671-9714714dbe97","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Коппартак"},{"@language":"cs-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"da-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"de-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"el-t-sv-t0-mtec","@value":"Κοππαρτάκ"},{"@language":"en-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"es-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"et-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"fi-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"fr-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"ga-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"hr-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"hu-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"it-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"lt-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"lv-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"mt-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"nl-t-sv-t0-mtec","@value":"Koppartak"},{"@language":"pl-t-