/publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:8b5b49b67c73123e453de843bc66af38932eeb8f9b045086c0284cec1a76776f"},{"@graph":[{"@id":"_:8b671d8c272978043c880ac823da9bea4e422fda7215d27040fac4624bb9856e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/69f1c091-d83a-4bdc-ad5d-e8a4805d6562","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/69f1c091-d83a-4bdc-ad5d-e8a4805d6562#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e7038d18-4362-49f1-b089-d344c4c09a90"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":{"@language":"sv","@value":"Höjder_ RH2000 består av följande objekt- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Höjdkurva trimmad (Höjdkurvor ska inte gå genom byggnader, vägar, trafikanläggningar eller slänter. När ett sådant objekt läggs in i kartan klipps befintliga höjdkurvor kant i kant med objektet): 10, 0.5 m; 20, Jämn; 30, Udda; 40, 5 m; 50, 10 m. Höjdkurva heltäckande (Heltäckande höjdkurvor som går genom byggnader och vägar, ajourhålles ej): 10, 0.5 m; 20, Jämn; 30, Udda; 40, 5 m; 50, 10 m. Höjdpunkter: 10, Markhöjd (ofullständigt, ajourhålls ej); 20, Gatuhöjd ; 30, Kantstenshöjd (ofullständigt, ajourhålls ej); 40, Sockelhöjd (ofullständigt, ajourhålls ej); 110, Takhöjd (ofullständigt, ajourhålls ej); 120, Takfot (ofullständigt, ajourhålls ej); 130, Taknock (ofullständigt, ajourhålls ej); 140, Taklist (ofullständigt, ajourhålls ej); 150, Golvhöjd (ofullständigt, ajourhålls ej); 160, Murhöjd (ofullständigt, ajourhålls ej); 170, Anläggningshöjd (ofullständigt, ajourhålls ej); 180, Trapphöjd (ofullständigt, ajourhålls ej); 200, Arbetshöjdfix (ofullständigt, ajourhålls ej)."},"dct:identifier":"69f1c091-d83a-4bdc-ad5d-e8a4805d6562","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:8b671d8c272978043c880ac823da9bea4e422fda7215d27040fac4624bb9856e_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta - Höjder"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/69f1c091-d83a-4bdc-ad5d-e8a4805d6562#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Baskarta (1:400  - 1:2000)."},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:8b671d8c272978043c880ac823da9bea4e422fda7215d27040fac4624bb9856e"},{"@graph":[{"@id":"_:8c04bd6d474a04be017bd9c58808a7b645e1ed4f5eb7ba71d581b02c721d39dc_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:8c04bd6d474a04be017bd9c58808a7b645e1ed4f5eb7ba71d581b02c721d39dc_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"14421ce369b5795410b2dc42e59e960349"},{"@id":"http://data.europa.eu/88u/dataset/0b5db68c-e1a0-4482-8f80-8e382e616067","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7d708e86-86e8-4340-a90e-83c5f60bb481"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=590534b4-bb80-4c52-857b-560e3a90481a"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2002-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: 1500 m, разделителна способност: 16 см/пиксел в ортофото. Това ортофото е достъпно само като растерна пирамида в dpMap. Дата на снимката: април-май 2002 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: 1500 m, rozlišení: 16 cm/pixel v ortofotosnímku. Tento ortofoto je k dispozici pouze jako rastrová pyramida v dpMap. Datum pořízení fotografie: duben–květen 2002."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: 1500 m, opløsning: 16 cm/pixel i ortofoto. Dette ortofoto er kun tilgængeligt som rasterpyramide i dpMap. Fotografiets dato: April-maj 2002."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: 1500 m, Auflösung: 16 cm/Pixel im Orthofoto. Dieses Orthofoto ist nur als Rasterpyramide in dpMap verfügbar. Fotodatum: April-Mai 2002."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: 1500 m, ανάλυση: 16 cm/pixel σε ορθοφωτογραφία. Αυτή η ορθοφωτογραφία είναι διαθέσιμη μόνο ως πυραμίδα ράστερ στο dpMap. Ημερομηνία φωτογραφίας: Απρίλιος-Μάιος 2002."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: 1500 m, resolution: 16 cm/pixel in orthophoto. This orthophoto is only available as raster pyramid in dpMap. Date of photograph: April-May 2002."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: 1500 m, resolución: 16 cm/píxel en ortofoto. Esta ortofoto solo está disponible como pirámide rasterizada en dpMap. Fecha de la fotografía: Abril-mayo de 2002."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: 1500 m, resolutsioon: 16 cm/piksel ortofotos. See ortofoto on saadaval ainult rasterpüramiidina dpMapis. Foto kuupäev: Aprill–mai 2002."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: 1500 m, resoluutio: 16 cm/pikseli ortokuvassa. Tämä ortokuva on saatavilla vain rasteripyramidina dpMapissa. Valokuvauksen päivämäärä: huhti-toukokuu 2002."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: 1500 m, résolution: 16 cm/pixel en orthophoto. Cette orthophoto n'est disponible que sous forme de pyramide matricielle dans dpMap. Date de la photographie: Avril-mai 2002."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: 1500 m, taifeach: 16 cm/picteilín in orthophoto. Níl an orthophoto seo ar fáil ach mar phirimid raster i dpMap. Dáta an ghrianghraif: Aibreán-Bealtaine 2002."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: 1500 m, razlučivost: 16 cm/piksel u ortofotografiji. Ovaj ortofoto dostupan je samo kao rasterska piramida u dpMapu. Datum fotografije: Travanj-svibanj 2002."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: 1500 m, felbontás: 16 cm/pixel ortofotóban. Ez az ortofotó csak raszteres piramisként érhető el a dpMap-ben. Fénykép dátuma: 2002. április–május."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: 1500 m, risoluzione: 16 cm/pixel in ortofoto. Questa ortofoto è disponibile solo come piramide raster in dpMap. Data della fotografia: aprile-maggio 2002."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: 1500 m, skiriamoji geba: 16 cm/pikselis ortofotografijoje. Ši ortofotografija yra prieinama tik kaip rastro piramidė dpMap. Fotografavimo data: 2002 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: 1500 m, izšķirtspēja: 16 cm/pikselis ortofoto. Šī ortofoto ir pieejama tikai kā rastra piramīda dpMap. Fotogrāfijas datums: 2002. gada aprīlis–maijs."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: 1500 m, riżoluzzjoni: 16 cm/pixel fl-ortofoto. Dan l-ortofoto huwa disponibbli biss bħala piramida tar-raster f'dpMap. Data tar-ritratt: April-Mejju 2002."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: 1500 m, resolutie: 16 cm/pixel in orthofoto. Deze orthofoto is alleen beschikbaar als rasterpiramide in dpMap. Datum van de foto: april-mei 2002."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: 1500 m, rozdzielczość: 16 cm/piksel w ortofotomapie. To ortofotomapa jest dostępna tylko jako piramida rastrowa w dpMap. Data zdjęcia: kwiecień-maj 2002 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: 1500 m, resolução: 16 cm/pixel em ortofotografia. Esta ortofotografia só está disponível como pirâmide raster no dpMap. Data da fotografia: Abril-Maio de 2002."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: 1500 m, rezoluție: 16 cm/pixel în ortofotografie. Această ortofotografie este disponibilă doar ca piramidă raster în dpMap. Data fotografiei: aprilie-mai 2002."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: 1500 m, rozlíšenie: 16 cm/pixel v ortofotografii. Táto ortofotoaparát je k dispozícii len ako rastrová pyramída v dpMap. Dátum fotografie: apríl – máj 2002."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: 1500 m, ločljivost: 16 cm/piksel v ortofotu. Ta ortofoto je na voljo samo kot rastrska piramida v dpMap. Datum fotografiranja: Od aprila do maja 2002."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1500 m, upplösning: 16 cm/pixel i ortofoto. Detta ortofoto finns bara tillgängligt som rasterpyramid i dpMap. Fotograferingsdatum: april-maj 2002."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: 1500 м, роздільна здатність: 16 см/піксель в ортофотоплані. Цей ортофотоплан доступний лише як растрова піраміда в dpMap. Дата фотографії: Квітень-травень 2002 року."}],"dct:format":"text/html","dct:identifier":"0b5db68c-e1a0-4482-8f80-8e382e616067","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:8c04bd6d474a04be017bd9c58808a7b645e1ed4f5eb7ba71d581b02c721d39dc_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"СБК Ортофото (2002)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2002) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Ortofoto (2002) - Wikipedia, den frie encyklopædi"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορτοφότο (2002)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2002.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2002 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2002) - Kto odpowiedział?"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Ortofoto (2002)"},{"@language":"sv","@value":"SBK Ortofoto (2002)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2002)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/7d708e86-86e8-4340-a90e-83c5f60bb481","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/0b5db68c-e1a0-4482-8f80-8e382e616067#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/7d708e86-86e8-4340-a90e-83c5f60bb481"}},{"@id":"http://data.europa.eu/88u/record/0b5db68c-e1a0-4482-8f80-8e382e616067","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7d708e86-86e8-4340-a90e-83c5f60bb481"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"0b5db68c-e1a0-4482-8f80-8e382e616067","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"