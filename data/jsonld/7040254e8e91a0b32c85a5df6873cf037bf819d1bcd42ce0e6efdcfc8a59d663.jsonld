":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=8490bedc-2d2b-4e95-978f-137a152ca2ea"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2004-01-01"},"dct:description":{"@language":"sv","@value":"En sociotop är en offentligt tillgänglig park, naturområde eller annan obebyggd yta där det känns trevligt att vara. Sociotopkartan visar var områdena finns i Stockholm och vilka kvaliteter de olika områdena har. Sociotopkartan är ett planeringsunderlag som kan användas i stadens fysiska planering (översikts-, områdes- och detaljplanering) för att visa tillgången på kvaliteter i parker och naturområden. Version 2022 är en justering jämfört med tidigare versioner genom att vägytor och privata fastigheter har tagits bort där de har identifierats. Följande sociotoptyper finns: Grön oas (park eller grönområde som är trevligt att vistas i)LekplatsNaturlek (grönområde som fungerar bra att leka i)PromenaderRofylldhetBlomprakt (rik blomning och trädgårdsodling)Bollspel (inhägnad rektangulär yta med grus, gräs eller konstgräs)Bollek (plan yta med grus, gräs eller konstgräs)ParklekPicknick (solbelysta stora gräsplaner eller park- och klippstränder)GrillningPulkaåkningOdling (möjlighet att odla i t.ex. koloniträdgårdar)LöpträningSkogskänslaUtsiktDjurhållningVattenkontaktUtomhusbad (bryggor, sand- eller klippstrand utan båttrafik eller utomhusbassänger)SkridskoåkningNaturupplevelse (våtmarker, gamla skogar, naturstränder)EvenemangFolklivTorghandel"},"dct:identifier":"25a85232-80d7-4e45-aee3-94dabb7c0bb4","dct:issued":{"@type":"xsd:date","@value":"2004-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-12-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:0a93860cbce0e22ed716754e25dc281bc05db59c42ac575e983f82900eeaa423_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Sociotopkartan - kvaliteter i parker, natur och andra offentligt tillgängliga områden (2022) (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/25a85232-80d7-4e45-aee3-94dabb7c0bb4#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:0a93860cbce0e22ed716754e25dc281bc05db59c42ac575e983f82900eeaa423"},{"@graph":[{"@id":"_:0b100c1f4984d7d7789abf1dca1aa2a9d7df3239599d17b32246449fd4a95cad_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/05617c14-52f6-4c6c-999c-837d11688bb6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/05617c14-52f6-4c6c-999c-837d11688bb6#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=d2d9451e-6ece-48e2-930b-a0788930d784"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1999-01-01"},"dct:description":{"@language":"sv","@value":"Stadskarta - Infrastruktur avgränsning bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :Vägavgränsning10, Infart, modifierbar, aktiv20, Refug, modifierbar, aktiv30, Trottoar, modifierbar, aktiv40, VägMittremsa, modifierbar, aktiv"},"dct:identifier":"05617c14-52f6-4c6c-999c-837d11688bb6","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://pu