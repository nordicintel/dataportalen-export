tLiteral","@value":"POLYGON((17.7605 59.4396,18.2011 59.4396,18.2011 59.2272,17.7605 59.2272,17.7605 59.4396))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/eee928cd-fb45-48af-823e-edecb05f180f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/eee928cd-fb45-48af-823e-edecb05f180f#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/eee928cd-fb45-48af-823e-edecb05f180f#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":[{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3e893073-b938-4561-a4ab-828e9d88632f"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-02-16"},"dct:description":{"@language":"sv","@value":"Har skärmdigitaliserats utifrån olika underlag såsom Ortofoto 2019 Stockholms stad, Parkdatabasen Stockholms stad och Tätortskartan Stockholms län. Punktobjekt (vattensamling/damm) från Stockholms Biotopkarta 2009 har tillförts skiktet i form av cirklar med 5 m radie på de platser där objekten inte kunnat ses i ortofoto. Även information från olika groddjursinventeringar (senast 2018 års inventering av miljöförvaltningen) och observationer ur databaserna ArtArken och Artportalen har tillförts, samt kartläggningar av lekvatten för groddjur för vissa områden (Calluna AB). Skiktet har kompletterats med både objekt och attribut utifrån miljöförvaltningens groddjursinventering 2018 och 2023."},"dct:identifier":"eee928cd-fb45-48af-823e-edecb05f180f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:4095416a5a87b3b77926ac20f0dcdc3d1b94034cfac2f5de8c699c8b6050c261_b0n0"},"dct:title":{"@language":"sv","@value":"Lekvattenkartering Groddjur"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/eee928cd-fb45-48af-823e-edecb05f180f#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/48ab38efbd8a417583a5293c8b628a9b_73/explore"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-portal"},{"@id":"https://resources.stockholm.se/data/eee928cd-fb45-48af-823e-edecb05f180f#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:4095416a5a87b3b77926ac20f0dcdc3d1b94034cfac2f5de8c699c8b6050c261"},{"@graph":[{"@id":"_:41405ea14f2aac61b27d666ce29774f21d7ddacfe3f9d6421a20596353850be4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:41405ea14f2aac61b27d666ce29774f21d7ddacfe3f9d6421a20596353850be4_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"10776a3f3a9ecce7fe4ffec7e65479e3f3"},{"@id":"http://data.europa.eu/88u/dataset/6869eaa1-e69c-412e-987e-0a147725047c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7b6132a4-32e6-44d1-8291-ed19e1acf022"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0cfd1cea-c419-4652-989d-a88a545c5de9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2005-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: ? m, разделителна способност: 20 см/пиксел в ортофото. Липсват несертифицирани изображения. Това ортофото е достъпно само като растерна пирамида в dpMap. Съдържа геометрични грешки и не трябва да се измерва. април-май 2005 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: ? m, rozlišení: 20 cm/pixel v ortofotosnímku. Chybí neověřené obrázky. Tento ortofoto je k dispozici pouze jako rastrová pyramida v dpMap. Obsahuje geometrické chyby a neměl by být měřen. duben–květen 2005."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: ? m, opløsning: 20 cm/pixel i ortofoto. Ucertificerede billeder mangler. Dette ortofoto er kun tilgængeligt som rasterpyramide i dpMap. Indeholder geometriske fejl og bør ikke måles i. April-maj 2005."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: ? m, Auflösung: 20 cm/Pixel im Orthofoto. Unzertifizierte Bilder fehlen. Dieses Orthofoto ist nur als Rasterpyramide in dpMap verfügbar. Enthält geometrische Fehler und sollte nicht gemessen werden. April-Mai 2005."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: ? m, ψήφισμα: 20 cm/pixel σε ορθοφωτογραφία. Λείπουν μη πιστοποιημένες εικόνες. Αυτή η ορθοφωτογραφία είναι διαθέσιμη μόνο ως πυραμίδα ράστερ στο dpMap. Περιέχει γεωμετρικά σφάλματα και δεν πρέπει να μετράται. Απρίλιος-Μάιος 2005."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: ? m, resolution: 20 cm/pixel in orthophoto. Uncertified images are missing. This orthophoto is only available as raster pyramid in dpMap. Contains geometric errors and should not be measured in. April-May 2005."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: ? m, resolución: 20 cm/píxel en ortofoto. Faltan imágenes no certificadas. Esta ortofoto solo está disponible como pirámide rasterizada en dpMap. Contiene errores geométricos y no debe medirse. Abril-mayo de 2005."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: ? m, eraldusvõime: 20 cm/piksel ortofotos. Sertifitseerimata pildid puuduvad. See ortofoto on saadaval ainult rasterpüramiidina dpMapis. Sisaldab geomeetrilisi vigu ja neid ei tohiks mõõta. Aprill–mai 2005."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: ? m, resoluutio: 20 cm/pikseli ortokuvassa. Varmentamattomat kuvat puuttuvat. Tämä ortokuva on saatavilla vain rasteripyramidina dpMapissa. Sisältää geometrisia virheitä, eikä niitä tule mitata. Huhti-toukokuu 2005."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: ? m, résolution: 20 cm/pixel en orthophoto. Il manque des images non certifiées. Cette orthophoto n'est disponible que sous forme de pyramide matricielle dans dpMap. Contient des erreurs géométriques et ne doit pas être mesuré. Avril-mai 2005."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: ? m, taifeach: 20 cm/picteilín in orthophoto. Tá íomhánna neamhdheimhnithe ar iarraidh. Níl an orthophoto seo ar fáil ach mar phirimid raster i dpMap. Tá earráidí geoiméadracha ann agus níor cheart iad a thomhas. Aibreán-Bealtaine 2005."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: ? m, razlučivost: 20 cm/piksel u ortofotografiji. Nedostaju necertificirane slike. Ovaj ortofoto dostupan je samo kao rasterska piramida u dpMapu. Sadrži geometrijske pogreške i ne smije se mjeriti. Travanj-svibanj 2005."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: ? m, felbontás: 20 cm/pixel ortofotóban. A nem hitelesített képek hiányoznak. Ez az ortofotó csak raszteres piramisként érhető el a dpMap-ben. Geometriai hibákat tartalmaz, és nem szabad mérni. 2005. április–május."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: ? m, risoluzione: 20 cm/pixel in ortofoto. Mancano immagini non certificate. Questa ortofoto è disponibile solo come piramide raster in dpMap. Contiene errori geometrici e non deve essere misurato in. aprile-maggio 2005."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: ? m, rezoliucija: 20 cm/pikselis ortofotografijoje. Trūksta nesertifikuotų vaizdų. Ši ortofotografija yra prieinama tik kaip rastro piramidė dpMap. Turi geometrinių paklaidų ir neturėtų būti matuojamas. 2005 m. balandžio–gegužės mėn."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: ? m, izšķirtspēja: 20 cm/pikseļa ortofoto. Trūkst neapliecinātu attēlu. Šī ortofoto ir pieejama tikai kā rastra piramīda dpMap. Satur ģeometriskas kļūdas un nav jāmēra. 2005. gada aprīlis–maijs."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: m, riżoluzzjoni: 20 cm/pixel fl-ortofoto. L-immaġnijiet mhux iċċertifikati huma neqsin. Dan l-ortofoto huwa disponibbli biss bħala piramida tar-raster f'dpMap. Fih żbalji ġeometriċi u m'għandux jitkejjel. April-Mejju 2005."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: ? m, resolutie: 20 cm/pixel in orthofoto. Ongecertificeerde foto's ontbreken. Deze orthofoto is alleen beschikbaar als rasterpiramide in dpMap. Bevat geometrische fouten en mag niet worden gemeten in. april-mei 2005."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: ? m, rozdzielczość: 20 cm/piksel w ortofotomapie. Brakuje niecertyfikowanych zdjęć. To ortofotomapa jest dostępna tylko jako piramida rastrowa w dpMap. Zawiera błędy geometryczne i nie powinien być mierzony. kwiecień-maj 2005 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: ? m, resolução: 20 cm/pixel em ortofotografia. Faltam imagens não certificadas. Esta ortofotografia só está disponível como pirâmide raster no dpMap. Contém erros geométricos e não deve ser medido. Abril-Maio de 2005."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: ? m, rezoluție: 20 cm/pixel în ortofotografie. Imaginile necertificate lipsesc. Această ortofotografie este disponibilă doar ca piramidă raster în dpMap. Conține erori geometrice și nu trebuie măsurate. aprilie-mai 2005."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: ? m, rozlíšenie: 20 cm/pixel v ortofotografii. Chýbajú neoverené obrázky. Táto ortofotoaparát je k dispozícii len ako rastrová pyramída v dpMap. Obsahuje geometrické chyby a nemal by byť meraný v. apríl – máj 2005."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: ? m, resolucija: 20 cm/piksel v ortofotu. Manjkajo nepreverjene slike. Ta ortofoto je na voljo samo kot rastrska piramida v dpMap. Vsebuje geometrijske napake in se ne sme meriti. april–maj 2005."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: ? m, upplösning: 20 cm/pixel i ortofoto. Orektifierade bilderna försvunna. Detta ortofoto finns bara tillgängligt som rasterpyramid i dpMap. Innehåller geometriska fel och ska ej mätas i. Fotograferingsdatum: april-maj 2005."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: ? м, роздільна здатність: 20 см/піксель в ортофотоплані. Несертифіковані зображення відсутні. Цей ортофотоплан доступний лише як растрова піраміда в dpMap. Містить геометричні похибки і не повинен вимірюватися. Квітень-травень 2005 року."}],"dct:format":"text/html","dct:identifier":"6869eaa1-e69c-412e-987e-0a147725047c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:41405ea14f2aac61b27d666ce29774f21d7ddacfe3f9d6421a20596353850be4_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Ortofoto / Ортофото (2005)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2005) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"el-t-sv-t0-mtec","@value":"ΣΒΚ Ορτοφότο (2005)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2005.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2005 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2005) - Kto odpowiedział?"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Ortofoto (2005)"},{"@language":"sv","@value":"SBK Ortofoto (2005)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2005)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/7b6132a4-32e6-44d1-8291-ed19e1acf022","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/7b6132a4-32e6-44d1-8291-ed19e1acf022"}},{"@id":"http://data.europa.eu/88u/record/6869eaa1-e69c-412e-987e-0a147725047c","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/7b6132a4-32e6-44d1-8291-ed19e1acf022"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"6869eaa1-e69c-412e-987e-0a147725047c","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:06Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:13Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/6869eaa1-e69c-412e-987e-0a147725047c"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:41405ea14f2aac61b27d666ce29774f21d7ddacfe3f9d6421a20596353850be4_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/6869eaa1-e69c-412e-987e-0a147725047c"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:13Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"6869eaa1-e69c-412e-987e-0a147725047c","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:41405ea14f2aac61b27d666ce29774f21d7ddacfe3f9d6421a20596353850be4"},{"@graph":[{"@id":"_:41982facd6d45d9923343e06a91176a527aff433d108cbc479571681fcd96b05_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/0fd37e77-f4b6-41fd-a0ff-26743c5d142c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5a5f7b7b-6f43-4338-ba03-b2b1e6b1d1c5"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2023-02-23"},"dct:description":{"@language":"sv","@value":"Höjddata, 1 meters grid. De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden XXX - XXX 2022 och interpolerat till ett grid med upplösning 1 m. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna har inte ajourförts sedan de skapades. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Detaljer som byggnader, vattenytor och strandlinjer, kaj och brofästen från baskartan används för att förbättra kvaliteten i gridet.Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom byggnaden. Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan.Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre."},"dct:identifier":"0fd37e77-f4b6-41fd-a0ff-26743c5d142c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:41982facd6d45d9923343e06a91176a527aff433d108cbc479571681fcd96b05_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Höjdgrid (2022)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:41982facd6d45d9923343e06a91176a527aff433d108cbc479571681fcd96b05"},{"@graph":[{"@id":"_:41f20cdc19739431ce77670aa80635920d9805114636edd0816c04b0015a70b6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:41f20cdc19739431ce77670aa80635920d9805114636edd0816c04b0015a70b6_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"10d5390c258c33c6fbab66d43fc4027a9e"},{"@id":"http://data.europa.eu/88u/dataset/16fa6998-8dbb-4c3f-a7cc-bfac23f63a03","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/eea03b11-29f6-450a-a859-658373508287"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=afb02a