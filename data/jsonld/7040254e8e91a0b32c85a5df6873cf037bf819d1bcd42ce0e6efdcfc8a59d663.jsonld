language":"sv","@value":"Belysningsmontage"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ba519d5a-1da3-4940-8b29-bb6a327eda16#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetWS.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/ba519d5a-1da3-4940-8b29-bb6a327eda16#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Belysningsmontage_Punkt&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/ba519d5a-1da3-4940-8b29-bb6a327eda16#HTTP:OGC:WFS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Belysningsmontage_Punkt"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/ba519d5a-1da3-4940-8b29-bb6a327eda16#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Belysningsmontage_Punkt"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:e3f8b523eec3a67261ba1a8493b5c604ae42123d82b4049d447838234e52f3cf"},{"@graph":[{"@id":"_:e4be8517fb078a2ea58eb934bc9fee9f9af982b2f5826d581e6d2523d1931736_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/0b5db68c-e1a0-4482-8f80-8e382e616067","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/0b5db68c-e1a0-4482-8f80-8e382e616067#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=590534b4-bb80-4c52-857b-560e3a90481a"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2002-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1500 m, upplösning: 16 cm/pixel i ortofoto. Detta ortofoto finns bara tillgängligt som rasterpyramid i dpMap. Fotograferingsdatum: april-maj 2002."},"dct:identifier":"0b5db68c-e1a0-4482-8f80-8e382e616067","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:e4be8517fb078a2ea58eb934bc9fee9f9af982b2f5826d581e6d2523d1931736_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2002)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/0b5db68c-e1a0-4482-8f80-8e382e616067#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:e4be8517fb078a2ea58eb934bc9fee9f9af982b2f5826d581e6d2523d1931736"},{"@graph":[{"@id":"_:e65e797df4eb677975d83a0fa427e4633c024541a8feb52e39c9d1e7603f462e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:e65e797df4eb677975d83a0fa427e4633c024541a8feb52e39c9d1e7603f462e_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2012-05-08"},"dcat:startDate":{"@type":"xsd:date","@value":"2012-05-01"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2012-05-08"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2012-05-01"}},{"@id":"_:e65e797df4eb677975d83a0fa427e4633c024541a8feb52e39c9d1e7603f462e_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1c069b1a57a8a83c6ca4d3680c125ff2db"},{"@id":"http://data.europa.eu/88u/dataset/799d13f9-68ae-4b9d-927a-b0b022bdc7a3","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/08665389-5860-40c7-9be6-46a3b36354e4"},{"@id":"http://data.europa.eu/88u/distribution/6116b725-47bf-4bd8-9f9e-71be6b301d2e"},{"@id":"http://data.europa.eu/88u/distribution/f208c4c4-fc77-49ca-9992-ae50c35bab9c"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=86fe674c-8a50-4ece-8b5b-b6e8a09d1e57"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2012-05-08"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. 1300 mРезолюция: 8 см/пиксел. Дата на снимката: 1,2 и 8 май 2012 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 1300 mRozlišení: 8 cm/pixel. Datum pořízení fotografie: a 8. května 2012. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. 1300 mBeslutning: 8 cm/pixel. Fotografiets dato: den 1., 2. og 8. maj 2012. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. 1300 mAuflösung: 8 cm/Pixel. Fotodatum: 1. und 8. Mai 2012. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. 1300 mΨήφισμα: 8 cm/pixel. Ημερομηνία φωτογραφίας: 1,2 και 8 Μαΐου 2012. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. 1300 mResolution: 8 cm/pixel. Date of photograph: 1,2 and 8 May 2012. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. 1300 mResolución: 8 cm/píxel. Fecha de la fotografía: 1,2 y 8 de mayo de 2012. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. 1300 mLahendus: 8 cm/piksel. Foto kuupäev: ja 8. mai 2012. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. 1300 mResoluutio: 8 cm/pikseli. Valokuvauksen päivämäärä: ja 8. toukokuuta 2012. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. 1300 mRésolution: 8 cm/pixel. Date de la photographie: 1,2 et 8 mai 2012. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. 1300 mRéiteach: 8 cm/picteilín. Dáta an ghrianghraif: 1,2 agus 8 Bealtaine 2012. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. 1300 mRezolucija: 8 cm/piksel. Datum fotografije: i 8. svibnja 2012. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. 1300 mFelbontás: 8 cm/pixel. Fénykép dátuma: 2012. május 1,2. és 8. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. 1300 mRisoluzione: 8 cm/pixel. Data della fotografia: 1,2 e 8 maggio 2012. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. 1300 mRezoliucija: 8 cm/pikselis. Fotografavimo data: 2012 m. gegužės 1, 2 ir 8 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. 1300 mIzšķirtspēja: 8 cm/pikselī. Fotogrāfijas datums: 2012. gada 1., 2. un 8. maijā. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. 1300 mRiżoluzzjoni: 8 cm/pixel. Data tar-ritratt: 1,2 u 8 ta' Mejju 2012. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. 1300 mResolutie: 8 cm/pixel. Datum van de foto: 1,2 en 8 mei 2012. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. 1300 mRozdzielczość: 8 cm/piksel. Data zdjęcia: 1,2 i 8 maja 2012 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. 1300 mResolução: 8 cm/píxel. Data da fotografia: 1,2 e 8 de maio de 2012. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. 1300 mRezoluție: 8 cm/pixel. Data fotografiei: 1,2 și 8 mai 2012. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 1300 mRozlíšenie: 8 cm/pixel. Dátum fotografie: a 8. mája 2012. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. 1300 mResolucija: 8 cm/piksel. Datum fotografiranja: in 8. maja 2012. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1300 mUpplösning: 8 cm/pixel. Fotograferingsdatum: 1,2 och 8 maj 2012. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 1300 мРезолюція: 8 см/піксель. Дата фотографії: 1, 2 та 8 травня 2012 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"799d13f9-68ae-4b9d-927a-b0b022bdc7a3","dct:issued":{"@type":"xsd:date","@value":"2013-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:e65e797df4eb677975d83a0fa427e4633c024541a8feb52e39c9d1e7603f462e_b0n0"},"dct:temporal":{"@id":"_:e65e797df4eb677975d83a0fa427e4633c024541a8feb52e39c9d1e7603f462e_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Ortofoto / Ортофото (2012)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2012) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ορτοφότο (2012)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2012.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2012 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2012) - Kto odpowiedział?"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Ortofoto (2012)"},{"@language":"sv","@value":"SBK Ortofoto (2012)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2012)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/08665389-5860-40c7-9be6-46a3b36354e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2012"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/799d13f9-68ae-4b9d-927a-b0b022bdc7a3#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst Ortofoto 2012",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2012"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2012"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjenesten Ortofoto 2012"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2012"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2012"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2012"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2012"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2012"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2012"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2012"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2012"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2012"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2012"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2012"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2012"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2012"},{"@language":"mt-t-sv-t0-mte