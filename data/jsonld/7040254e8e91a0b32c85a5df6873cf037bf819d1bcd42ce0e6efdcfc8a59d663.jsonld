ution":[{"@id":"http://data.europa.eu/88u/distribution/22c8c41c-0531-47ec-951f-ba86c2fb2eba"},{"@id":"http://data.europa.eu/88u/distribution/b401cce7-267f-4589-9807-493cca2f8847"},{"@id":"http://data.europa.eu/88u/distribution/babe36d5-8079-4454-ad27-be859b2bf5d1"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:53Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:d5184a351f2de179beee9dd4eadcc998ee430efe64567806236f6a7829460bf9_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:42:53Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"5dcf3c60-1a3a-4a80-86e4-d729c3cd44de","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/5dcf3c60-1a3a-4a80-86e4-d729c3cd44de"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistr