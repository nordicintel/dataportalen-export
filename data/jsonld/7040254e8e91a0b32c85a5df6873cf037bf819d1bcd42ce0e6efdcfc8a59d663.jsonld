alAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:Nedladdning:data/3"},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:OGC:WFS/1"},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:OGC:WMS/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature9322303"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Det primära vägnätet visar vägar i Stockholms län som är viktiga för den regionala framkomligheten för människor och gods. Kartan används för att koordinera vägarbeten i syfte att ge minsta möjliga påverkan på den totala trafiken i Stockholms län, och det är också på detta vägnät Trafik Stockholm i första hand trafikinformerar.Det primära vägnätet är upprättat av Regionala Trafikgruppen (samverkansgrupp där Trafikverket, Trafikförvaltningen, Trafik Stockholm, Trafikkontoret samt Nacka kommun är representerade). Kartlagret fastställdes av Styrgruppen för Regional Framkomlighet i februari 2022.Detta vägnätet revideras årsvis under hösten."},"dct:identifier":"d2399d19-ef17-47d9-ab2a-0a9b9ff4e720","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-10"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1aa3c785cad6216207b954be26aad0bbb7e63a4615eb0811331def6a79bb77e6_b0n0"},"dct:title":{"@language":"sv","@value":"Primära vägnätet"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:Nedladdning:data/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Primara_vagnatet&outputFormat=GeoPackage"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:OGC:WFS/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Primara_vagnatet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/d2399d19-ef17-47d9-ab2a-0a9b9ff4e720#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Primara_vagnatet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"}