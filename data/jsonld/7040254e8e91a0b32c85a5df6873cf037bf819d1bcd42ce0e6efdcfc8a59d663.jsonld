format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Dokumentation av API för Hitta Service (pdf)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsledningskontoret - Kommunikations- och omvärldsavdelningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ola.williams@stockholm.se"}}],"@id":"urn:source:8874acc4b97ca9974aa0b7a96ac03af5b39e12d4b69a05bcce8c594a0d70a8f7"},{"@graph":[{"@id":"_:890a2c6c699173d92c152c8e48fa7babf5850b31c055927117fb76c0e8331f14_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"https://resources.stockholm.se/data/c81d9ff5-31fe-4ed0-a58c-5f72cca4529f","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/c81d9ff5-31fe-4ed0-a58c-5f72cca4529f#HTTP:ESRI+Portal-URL/1"},"dcat:keyword":["Stockholms stad - Miljöförvaltningen",{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Landskap"},{"@language":"sv","@value":"Stadsmiljö"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3c396f03-a14a-413a-95ee-8935bae9958b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1996-01-01"},"dct:description":{"@language":"sv","@value":"ArtArken har tagits fram av Miljöförvaltningen i Stockholm inom projektet Kartläggning av hotade, skyddsvärda och föroreningskänsliga arter i Stockholms mark- och vattenområden som pågick 1996 - 1999. Samarbete har skett med övriga berörda förvaltningar inom staden samt med andra kommuner, institutioner, föreningar och enskilda personer. Finansiellt bidrag till regional utveckling av projektet har givits av Landstingets miljövårdsfond. Databasen började byggas upp under våren 1996 och aktualiseras fortlöpande. I dagsläget läses artobservationer in från Artdatabankens API:er för de arter som är kopplade till ArtArken. Datamängden uppdateras en gång i veckan. För detaljerad information hänvisas till den tryckta rapporten: Gothnier, M, Hjorth, G. och Östergård, S. 1999: Rapport från ArtArken, Stockholms Artdataarkiv. Miljöförvaltningen, Stockholm."},"dct:identifier":"c81d9ff5-31fe-4ed0-a58c-5f72cca4529f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-04-08"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dct:spatial":{"@id":"_:890a2c6c699173d92c152c8e48fa7babf5850b31c055927117fb76c0e8331f14_b0n0"},"dct:title":{"@language":"sv","@value":"ArtArken - Särskilt skyddsvärda arter i Stockholms stad"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c81d9ff5-31fe-4ed0-a58c-5f72cca4529f#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/sthlm-miljo::artarken-s%C3%A4rskilt-skyddsv%C3%A4rda-arter-i-stockholms-stad/explore?layer=0&location=59.333901%252C17.984940%252C12.40"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:mgis@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:890a2c6c699173d92c152c8e48fa7babf5850b31c055927117fb76c0e8331f14"},{"@graph":[{"@id":"_:8a889b9b80c2ff2c2073b45671b6e7242ecbc024f7c0e418249aaff02ae8a3b3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/815e34df-829f-498b-a358-048c431b3602","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/815e34df-829f-498b-a358-048c431b3602#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=54fae749-6488-4b9c-a22b-01a2bb71338e"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":{"@language":"sv","@value":"Parkanläggningar består av följande objekt- och subtyper(för aktuell lista se Allmän produktspecifikation Baskartan): Idrottsanläggning: 280, Fotbollsmål (ofullständigt, ajourhålls ej). Parkanläggning: 10, Parkbänk (ofullständigt, ajourhålls ej); 20, Lekutrustning (ofullständigt, ajourhålls ej); 30, Staty (ofullständigt, ajourhålls ej); 40, Flaggstång (ofullständigt, ajourhålls ej)."},"dct:identifier":"815e34df-829f-498b-a358-048c431b3602","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:8a889b9b80c2ff2c2073b45671b6e7242ecbc024f7c0e418249aaff02ae8a3b3_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta - Parkanläggningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/815e34df-829f-498b-a358-048c431b3602#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Baskarta (1:400  - 1:2000)."},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:8a889b9b80c2ff2c2073b45671b6e7242ecbc024f7c0e418249aaff02ae8a3b3"},{"@graph":[{"@id":"_:8b5b49b67c73123e453de843bc66af38932eeb8f9b045086c0284cec1a76776f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4406,18.2011 59.4406,18.2011 59.2272,17.7605 59.2272,17.7605 59.4406))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4406,18.2011 59.4406,18.2011 59.2272,17.7605 59.2272,17.7605 59.4406))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/52f41d04-ab24-42f0-9db4-51f1e44eae3b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/52f41d04-ab24-42f0-9db4-51f1e44eae3b#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/52f41d04-ab24-42f0-9db4-51f1e44eae3b#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/52f41d04-ab24-42f0-9db4-51f1e44eae3b#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/52f41d04-ab24-42f0-9db4-51f1e44eae3b#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Stadsliv"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature19743007"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Kartlagret Salutorg visar stadens samtliga salutorg i form av ytor. Kartlagret visar både fasta och tillfälliga torghandelsplatser. Salutorgsytorna beslutas i kommunfullmäktige. Kartlagret används för att visa var torghandel får bedrivas. Uppdatering sker löpande vid behov. Ansvarig för datat är Trafikkontoret, Tillståndsavdelningen, enheten Stadsliv."},"dct:identifier":"52f41d04-ab24-42f0-9db4-51f1e44eae3b","dct:issued":{"@type":"xsd:date","@value":"2023-01-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{