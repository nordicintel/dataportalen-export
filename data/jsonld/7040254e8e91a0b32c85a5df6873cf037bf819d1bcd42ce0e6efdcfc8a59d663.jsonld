cat:distribution":{"@id":"https://resources.stockholm.se/data/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5261a2f3-f2f7-4bce-a384-aa7c1e290d21"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-12-28"},"dct:description":{"@language":"sv","@value":"Innehåller GeoTIFF raster höjden av trädkrona absolut höjd (meter över havet) inom Stockholms stad. Filer är framtagen från laserpunktmolnsdata med hjälp av mjukvaran Terrascan. Olika skript har körts på laserpunkter 1. punktmolnsdata har klassats efter om de tillhör mark, byggnader/broar och övrigt 2. Sedan har med hjälp av olika skript valt ut objekt som liknar träd. 3. Export av 50cm upplöste raster modell med högsta höjd inom den 50cm pixel. Band 0 anger höjdvärdet av pixeln avrundat till närmaste meter (m) i höjdsystemet RH2000 utan decimaler. Laserdata som användes är från 2022."},"dct:identifier":"b72ebce9-fbd7-4f80-9f8a-31efb8de0e43","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:95e3a6d4d55ec5fa10ccb32ddc7e57d2baa417d618ba67cd7a417c8f6d94a19b_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Träd - Trädkronehöjd - absolut höjd 2022 (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/b72ebce9-fbd7-4f80-9f8a-31efb8de0e43#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessU