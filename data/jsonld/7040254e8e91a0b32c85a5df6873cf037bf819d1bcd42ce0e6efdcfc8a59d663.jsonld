011"},"dct:created":{"@type":"xsd:date","@value":"2020-01-01"},"dct:description":{"@language":"sv","@value":"Visar de framtida huvudvattenledningarna som är tänkta att vara på plats till år 2050. Lagret innehåller information om ungefärlig genomförandetid för respektive projekt, exakt omfattning och detaljer kan variera beroende på projektets fas. Datamängden innehåller ledningssträckor som är föreslagna, planerade och genomförda. Lagret är sekretessbelagt; sekretessavtal, sekretessöverenskommelse eller personlig sekretessförbindelse krävs. Datamängden innehåller INTE befintliga ledningar utan endast tillkommande ledningsstråk för framtida huvudvattenledningar."},"dct:identifier":"f4287985-702e-4603-99ba-5bfa6f852c70","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/"},"dct:spatial":{"@id":"_:d69f5273611fa4d655b8f445d0a5d73f11eb929693cc1ce40be050845f800293_b0n0"},"dct:temporal":{"@id":"_:d69f5273611fa4d655b8f445d0a5d73f11eb929693cc1ce40be050845f800293_b1n0"},"dct:title":{"@language":"sv","@value":"Ledningsnät vatten Framtida huvudvattenledningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:gis@svoa.se"},"foaf:name":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"foaf:phone":{"@id":"tel:+08-52212000"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis@svoa.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-52212000"}}],"@id":"urn:source:d69f5273611fa4d655b8f445d0a5d73f11eb929693cc1ce40be050845f800293"},{"@graph":[{"@id":"_:d846f698981f6f498cf4c54c6a2ac3b63de3505e59858211626914f28870c9bd_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4422,18.2011 59.4422,18.2011 59.2272,17.7605 59.2272,17.7605 59.4422))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4422,18.2011 59.4422,18.2011 59.2272,17.7605 59.2272,17.7605 59.4422))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/659be271-808f-49af-901b-2c906646ba55","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/659be271-808f-49af-901b-2c906646ba55#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/659be271-808f-49af-901b-2c906646ba55#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":[{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=02c7c84c-8529-4ec7-94c0-ffc6188230f0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2013-06-25"},"dct:description":{"@language":"sv","@value":"Kartläggning av ekologiskt särskilt betydelsefulla områden inom Stockholms ekologiska infrastruktur. Skiktet utgör en bedömning av vilka områden inom den ekologiska infrastrukturen som är särskilt betydelsefulla som kärnområden, spridningszoner och livsmiljöer för skyddsvärda arter.Övriga delar av den ekologiska infrastrukturen ingår inte i skiktet. Mer information: Dokument med allmän bakgrundsbeskrivning av databasen, bedömningsgrunderna, begreppsdefinitioner och analysunderlag finns på Miljöbarometern."},"dct:identifier":"659be271-808f-49af-901b-2c906646ba55","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2017-09-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:d846f698981f6f498cf4c54c6a2ac3b63de3505e59858211626914f28870c9bd_b0n0"},"dct:title":{"@language":"sv","@value":"ESBO - Ekologiskt särskilt betydelsefulla områden"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/659be271-808f-49af-901b-2c906646ba55#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/f3033da3754248b5b216c3f9f3c0968c_31/explore"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/659be271-808f-49af-901b-2c906646ba55#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Sto