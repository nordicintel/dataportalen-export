pa.eu/88u/dataset/90159088-f909-49c9-ba36-a70919e1f331"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:4936849b8901c89e395e428835c7db55d8de5374ea85a4b8b5f8aa735fd91cd7_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/90159088-f909-49c9-ba36-a70919e1f331"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-13T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"90159088-f909-49c9-ba36-a70919e1f331","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/90159088-f909-49c9-ba36-a70919e1f331"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:4936849b8901c89e395e428835c7db55d8de5374ea85a4b8b5f8aa735fd91cd7"},{"@graph":[{"@id":"_:49b9550c7ff7d82e3db8864856dd41ff0a6be0934970e93783155edfe41470b5_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:49b9550c7ff7d82e3db8864856dd41ff0a6be0934970e93783155edfe41470b5_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16abbe140457b03d8f9932f784c65f676e"},{"@id":"http://data.europa.eu/88u/dataset/25a85232-80d7-4e45-aee3-94dabb7c0bb4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/cc37ab3d-1773-497d-93e3-70f19e998ec2"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=8490bedc-2d2b-4e95-978f-137a152ca2ea"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2004-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Социотопът е обществено достъпен парк, природна зона или друга неразвита област, където се чувства добре да бъде. Картата на социотопите показва къде се намират районите в Стокхолм и какви качества имат различните райони. Картата на социотопите е основа за планиране, която може да се използва в пространственото планиране на града (преглед, планиране на площта и детайлите), за да се покаже наличието на качества в парковете и природните зони. Версия 2022 е корекция в сравнение с предишните версии чрез премахване на пътните настилки и частните имоти, където са били идентифицирани. Съществуват следните видове социотопи: Зелен оазис (парк или зелена площ, в която е хубаво да останете)PlaygroundNature (зелена площ, която работи добре, за да играете в)PromendsRoyaltyFlower (богат цъфтеж и градинарство)Ballspel (оградена правоъгълна повърхност с чакъл, трева или изкуствена трева)Bollek (плоска повърхност с чакъл, трева или изкуствена трева)ParklekPicknick (слънчеви големи тревни площи или паркови и скалисти плажове)GrillingPulkaåkningGoing (възможност за отглеждане например в градини на колонии)TrainingForest feelOutdoor ViewAnimal keepingWater contactOutdoor плувен басейн (мостове, пясъчен или скалист плаж без трафик на лодки или открити басейни)Scrid skiingNature experience (мочувство на открито, стари гори, естествени плажове)Evenemen"},{"@language":"cs-t-sv-t0-mtec","@value":"Sociotop je veřejně přístupný park, přírodní oblast nebo jiná nezastavěná oblast, kde je příjemné být. Sociotopová mapa ukazuje, kde se oblasti ve Stockholmu nacházejí a jaké vlastnosti mají různé oblasti. Sociotopová mapa je plánovací základna, která může být použita v územním plánování města (přehled, oblastní a podrobné plánování) k zobrazení dostupnosti kvalit v parcích a přírodních oblastech. Verze 2022 je ve srovnání s předchozími verzemi úpravou spočívající v odstranění povrchů vozovek a soukromých nemovitostí tam, kde byly identifikovány. Existují následující sociotopy: Zelená oáza (park nebo zelená oblast, která je příjemná k pobytu)HřištěPříroda (zelená oblast, která funguje dobře hrát v)PromendsRoyaltyFlower (bohaté kvetení a zahradnictví)Ballspel (oplocený obdélníkový povrch se štěrkem, trávou nebo umělou trávou)Bollek (plochý povrch se štěrkem, trávou nebo umělou trávou)ParklekPicknick (sluneční velké trávníky nebo park a skalnaté pláže)GrillingPulkaåkningGoing (možnost pěstovat např. v koloniálních zahradách)TrainingForest pocitVenkovní pohledOšetřovatelstvíVodní kontaktVenkovní koupaliště (mostrovní mosty, písčitá nebo skalnatá pláž bez lodní dopravy nebo venkovních bazénů)Skritické lyžováníPřírodní zážitek (mokřady, staré lesy, přírodní pláže)Evenemenen"},{"@language":"da-t-sv-t0-mtec","@value":"En sociotop er en offentligt tilgængelig park, naturområde eller andet uudviklet område, hvor det føles rart at være. Sociotopkortet viser, hvor områderne ligger i Stockholm, og hvilke kvaliteter de forskellige områder har. Sociotopkortet er et planlægningsgrundlag, der kan bruges i byens fysiske planlægning (oversigt, område- og detaljeplanlægning) til at vise tilgængeligheden af kvaliteter i parker og naturområder. Version 2022 er en justering i forhold til tidligere versioner ved at fjerne vejbelægninger og private ejendomme, hvor de er blevet identificeret. Der findes følgende sociotoptyper: Grøn oase (park eller grønt område, der er rart at bo i)PlaygroundNature (grønt område, der fungerer godt at spille i)PromendsRoyaltyFlower (rige blomstrende og havebrug)Ballspel (indhegnet rektangulær overflade med grus, græs eller kunstgræs)Bollek (flade overflade med grus, græs eller kunstgræs)ParklekPicknick (soloplyste store græsplæner eller park og stenede strande)GrillingPulkaåkningGoing (mulighed for at vokse i f.eks kolonihaver)TræningForest følelseUdendørs udsigtAnimalsk holdVandkontaktUdendørs swimmingpool (broer, sandstrand eller stenstrand uden bådtrafik eller udendørs pools)Skriv skiNaturoplevelse (vområder, gamle skove, naturlige strande)Evenemen"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Soziotop ist ein öffentlich zugänglicher Park, ein Naturgebiet oder ein anderes unbebautes Gebiet, in dem es sich schön anfühlt. Die Soziotopkarte zeigt, wo sich die Gebiete in Stockholm befinden und welche Qualitäten die verschiedenen Gebiete haben. Die Soziotopkarte ist eine Planungsgrundlage, die in der Raumplanung der Stadt (Überblick, Flächen- und Detailplanung) genutzt werden kann, um die Verfügbarkeit von Qualitäten in Parks und Naturgebieten aufzuzeigen. Bei der Version 2022 handelt es sich um eine Anpassung im Vergleich zu früheren Versionen, indem Straßenbeläge und Privatgrundstücke, bei denen sie identifiziert wurden, entfernt werden. Es gibt folgende Soziotoptypen: Grüne Oase (Park oder Grünfläche, die schön zum Verweilen ist)SpielplatzNatur (grüne Fläche, die gut zum Spielen geeignet ist)PromendsRoyaltyFlower (reich an Blüte und Gartenbau)Ballspel (eingezäunte rechteckige Fläche mit Kies, Gras oder Kunstrasen)Bollek (flache Oberfläche mit Kies, Gras oder Kunstrasen)ParklekPicknick (sonnige große Rasenflächen oder Park und felsige Strände)GrillingPulkaåkningGoing (Möglichkeit zum Wachsen in z.B. Koloniegärten)TrainingForest FeelingOutdoor-AnsichtTierhaltungWasserkontaktAußenschwimmbad (Brücken, Sandstrand oder felsiger Strand ohne Bootsverkehr oder Freibäder)ScridskiNaturerlebnis (Weide, alte Wälder, Naturstrände)Evenemen"},{"@language":"el-t-sv-t0-mtec","@value":"Ένας κοινωνιότοπος είναι ένα δημόσια προσβάσιμο πάρκο, φυσική περιοχή ή άλλη υπανάπτυκτη περιοχή όπου αισθάνεται ωραίο να είναι. Ο κοινωνιοτοπικός χάρτης δείχνει πού βρίσκονται οι περιοχές στη Στοκχόλμη και ποιες ιδιότητες έχουν οι διάφορες περιοχές. Ο κοινωνιοτοπικός χάρτης είναι μια βάση σχεδιασμού που μπορεί να χρησιμοποιηθεί στον χωροταξικό σχεδιασμό της πόλης (επισκόπηση, χωροταξία και λεπτομερής σχεδιασμός) για να δείξει τη διαθεσιμότητα ποιοτήτων σε πάρκα και φυσικές περιοχές. Η έκδοση 2022 αποτελεί προσαρμογή σε σύγκριση με προηγούμενες εκδόσεις, αφαιρώντας τα οδοστρώματα και τις ιδιωτικές ιδιοκτησίες όπου έχουν εντοπιστεί. Υπάρχουν οι ακόλουθοι τύποι κοινωνιοτόπου: Πράσινη όαση (πάρκο ή καταπράσινη περιοχή που είναι ωραίο να μείνετε)ΠαιχνίδιΦύση (πράσινη περιοχή που λειτουργεί καλά για να παίξει)ΠρόμενςRoyaltyΑνθοδέσμη (πλούσια ανθοφορία και κηπουρική)Ballspel (περίφραξη ορθογώνια επιφάνεια με χαλίκι, γρασίδι ή τεχνητό γρασίδι)Bollek (επίπεδη επιφάνεια με χαλίκι, γρασίδι ή τεχνητό γρασίδι)ParklekPicknick (ηλιόλουστο μεγάλο γκαζόν ή πάρκο και βραχώδεις παραλίες)GrillingPulkaåkningGoing (δυνατότητα ανάπτυξης π.χ. σε κήπους αποικιών)ΕκπαίδευσηΑίσθηση δάσουςΥπαίθρια θέαΔιατήρηση ζώωνΕπαφή με το νερόΥπαίθριες πισίνες (γέφυρες, αμμώδης ή βραχώδης παραλία χωρίς κυκλοφορία σκαφών ή εξωτερικές πισίνες)Σκριδατική εμπειρία σκιΦύση (υγότοποι, παλιά δάση, φυσικές παραλίες)Evenemen"},{"@language":"en-t-sv-t0-mtec","@value":"A sociotope is a publicly accessible park, natural area or other undeveloped area where it feels nice to be. The sociotope map shows where the areas are located in Stockholm and what qualities the different areas have. The sociotope map is a planning basis that can be used in the city's spatial planning (overview, area and detail planning) to show the availability of qualities in parks and natural areas. Version 2022 is an adjustment compared to previous versions by removing road surfaces and private properties where they have been identified. The following sociotope types exist: Green oasis (park or green area that is nice to stay in)PlaygroundNature (green area that works well to play in)PromendsRoyaltyFlower (rich flowering and horticulture)Ballspel (fenced rectangular surface with gravel, grass or artificial grass)Bollek (flat surface with gravel, grass or artificial grass)ParklekPicknick (sunlit large lawns or park and rocky beaches)GrillingPulkaåkningGoing (possibility to grow in e.g. colony gardens)TrainingForest feelingOutdoor viewAnimal keepingWater contactOutdoor swimming pool (bridges, sandy or rocky beach without boat traffic or outdoor pools)Scrid skiingNature experience (wetlands, old forests, natural beaches)Evenemen"},{"@language":"es-t-sv-t0-mtec","@value":"Un sociotopo es un parque de acceso público, área natural u otra área no desarrollada donde se siente bien estar. El mapa de sociotopos muestra dónde se encuentran las áreas en Estocolmo y qué cualidades tienen las diferentes áreas. El mapa de sociotopos es una base de planificación que se puede utilizar en la planificación espacial de la ciudad (visión general, área y planificación detallada) para mostrar la disponibilidad de cualidades en parques y áreas naturales. La versión 2022 es un ajuste en comparación con las versiones anteriores al eliminar las superficies de las carreteras y las propiedades privadas donde se han identificado. Existen los siguientes tipos de sociotopos: Oasis verde (parque o zona verde en la que es agradable alojarse)PlaygroundNature (área verde que funciona bien para jugar)PromendsRoyaltyFlower (floración y horticultura ricas)Ballspel (superficie rectangular vallada con grava, césped o césped artificial)Bollek (superficie plana con grava, césped o césped artificial)ParklekPicknick (gran césped o parque iluminado y playas rocosas)GrillingPulkaåkningGoing (posibilidad de crecer en, por ejemplo, jardines de colonias)FormaciónSensación de los bosques antiguos, playas naturales)Evenemene"},{"@language":"et-t-sv-t0-mtec","@value":"Sotsiotoop on avalikult ligipääsetav park, looduslik ala või muu arenemata ala, kus on hea olla. Sotsiotoopide kaart näitab, kus asuvad Stockholmi piirkonnad ja millised omadused on erinevatel piirkondadel. Sotsiotoopkaart on planeerimisalus, mida saab kasutada linna ruumilises planeerimises (ülevaade, ala ja detailplaneerimine), et näidata omaduste kättesaadavust parkides ja looduslikes piirkondades. 2022. aasta versioon on eelmiste versioonidega võrreldes kohandus, millega eemaldatakse teekatted ja eraomandid seal, kus need on kindlaks tehtud. Olemas on järgmised sotsiotoopide tüübid: Roheline oaas (park või haljasala, kus on hea viibida)MängumaaLoodus (roheline ala, kus on hea mängida)PromendsRoyaltyFlower (rikas õitsemine ja aiandus)Ballspel (tarastatud ristkülikukujuline pind kruusa, rohu või kunstmuruga)Bollek (lam pind kruusa, rohu või kunstmuruga)ParklekPicknick (päikesevalgustatud suured muruplatsid või pargid ja kivised rannad)GrillingPulkaåkningGoing (võimalus kasvada nt koloonia aedades)TrainingForest tunneVälivaadeLoomade pidamineVeekontaktVälibassein (sild, liivane või kivine rand ilma paadiliikluse või välibasseinideta)Scrid skiingLooduse kogemus (märgalad, vanad metsad, looduslikud rannad)Evenemen"},{"@language":"fi-t-sv-t0-mtec","@value":"Sosiotooppi on julkinen puisto, luonnonalue tai muu kehittymätön alue, jossa tuntuu mukavalta olla. Sosiotooppikartta näyttää, missä alueet sijaitsevat Tukholmassa ja mitä ominaisuuksia eri alueilla on. Sosiotooppikartta on suunnitteluperusta, jota voidaan käyttää kaupungin aluesuunnittelussa (yleiskuva, alue- ja yksityiskohtasuunnittelu) osoittamaan puistojen ja luonnonalueiden laatujen käytettävyyttä. Vuoden 2022 versio on aiempiin versioihin verrattuna mukautus, jossa poistetaan tiepinnat ja yksityiset kiinteistöt, jos ne on tunnistettu. Seuraavat sosiotooppityypit ovat olemassa: Vihreä keidas (puisto tai vihreä alue, joka on mukava pysyä)LeikkipaikkaLuonto (vihreä alue, joka toimii hyvin pelata)PromendsRoyaltyFlower (rikas kukinta ja puutarhaviljely)Ballspel (aidattu suorakaiteen muotoinen pinta soralla, ruoholla tai tekonurmella)Bollek (tasainen pinta soralla, ruoholla tai tekonurmella)ParklekPicknick (aurinkoiset suuret nurmikot tai puisto ja kallioiset rannat)GrillingPulkaåkningGoing (mahdollisuus kasvaa esim."},{"@language":"fr-t-sv-t0-mtec","@value":"Un sociotope est un parc accessible au public, une zone naturelle ou une autre zone non développée où il fait bon être. La carte sociotope montre où se trouvent les zones à Stockholm et quelles sont les qualités des différentes zones. La carte sociotope est une base de planification qui peut être utilisée dans la planification spatiale de la ville (vue d'ensemble, planification de la zone et des détails) pour montrer la disponibilité des qualités dans les parcs et les zones naturelles. La version 2022 est un ajustement par rapport aux versions précédentes en supprimant les revêtements routiers et les propriétés privées là où ils ont été identifiés. Les types de sociotopes suivants existent: Oasis de verdure (parc ou espace vert où il fait bon séjourner)PlaygroundNature (espace vert qui fonctionne bien pour jouer)PromendsRoyaltyFlower (riche floraison et horticulture)Ballspel (surface rectangulaire clôturée avec gravier, herbe ou gazon artificiel)Bollek (surface plane avec gravier, herbe ou gazon artificiel)ParklekPicknick (grandes pelouses ensoleillées ou parc et plages rocheuses)GrillingPulkaåkningGoing (possibilité de pousser dans des jardins de colonies, par exemple)FormationSentiment de la forêtSentiment de la forêtVue extérieureMaintien de l'animalContact avec l'eauPiscine extérieure (ponts, plage de sable ou de rochers sans trafic de bateaux ou piscines extérieures)Scrid skiExpérience de la nature (zones humides, forêts anciennes, plages naturelles)Evenemen"},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard is sociotope ann ná páirc atá inrochtana don phobal, limistéar nádúrtha nó limistéar neamhfhorbartha eile ina mothaíonn sé deas a bheith. Taispeánann an léarscáil sociotope cá bhfuil na ceantair suite i Stócólm agus cad iad na cáilíochtaí atá ag na ceantair éagsúla. Is bonn pleanála é an léarscáil sociotope is féidir a úsáid i bpleanáil spásúil na cathrach (forbhreathnú, limistéar agus pleanáil sonraí) chun infhaighteacht cáilíochtaí i bpáirceanna agus i gceantair nádúrtha a thaispeáint. Is coigeartú é Leagan 2022 i gcomparáid le leaganacha roimhe seo trí dhromchlaí bóthair agus airíonna príobháideacha a bhaint i gcás inar sainaithníodh iad. Tá na cineálacha sochóp seo a leanas ann: Oasis glas (páirc nó limistéar glas atá deas le fanacht ann)PlaygroundNature (limistéar glas a oibríonn go maith le himirt ann)PromendsRoyaltyFlower (bláthanna saibhir agus gairneoireacht)Ballspel (dromchla dronuilleogach imfhálaithe le gairbhéal, féar nó féar saorga)Bollek (dromchla cothrom le gairbhéal, féar nó féar saorga)ParklekPicknick (claonadh mór nó páirc mhór agus tránna creagacha)GrillingPulkaåkningGoing (an fhéidearthacht fás i ngairdíní coilíneachta e.g.)TrainingForest feelingOutdoor viewAnimal keepingWater contact linn snámha lasmuigh (droichid, tránna gainimh nó carraigeacha gan trácht báid nó linnte amuigh faoin aer)ScridingNature experience (talaí, seanfhoraoisí, tránna nádúrtha)Evene"},{"@language":"hr-t-sv-t0-mtec","@value":"Sociotop je javno dostupan park, prirodno područje ili drugo nerazvijeno područje gdje se osjeća lijepo. Karta sociotopa prikazuje gdje se nalaze područja u Stockholmu i koje kvalitete imaju različita područja. Sociotop karta je planska osnova koja se može koristiti u gradskom prostornom planiranju (pregled, prostorno planiranje i planiranje detalja) kako bi se prikazala dostupnost kvaliteta u parkovima i prirodnim područjima. Verzija 2022. prilagodba je u usporedbi s prethodnim verzijama uklanjanjem cestovnih površina i privatnih nekretnina ondje gdje su utvrđene. Postoje sljedeće vrste sociotopa: Zelena oaza (park ili zelena površina u kojoj je lijepo boraviti)PlaygroundNature (zelena površina koja dobro funkcionira)PromendsRoyaltyFlower (bogata cvjetnica i hortikultura)Ballspel (ograđena pravokutna površina sa šljunkom, travom ili umjetnom travom)Bollek (ravna površina sa šljunkom, travom ili umjetnom travom)ParklekPicknick (sunčani veliki travnjaci ili park i stjenovite plaže)GrillingPulkaåkningGoing (mogućnost rasta u npr. kolonijalnim vrtovima)TrainingForest feelOutdoor viewAnimal keepingWater contactOutdoor bazen (mostovi, pješčana ili stjenovita plaža bez prometa brodom ili vanjskih bazena)Scrid skidingNature experience (wetlands, stare šume, prirodne plaže)Evenemen"},{"@language":"hu-t-sv-t0-mtec","@value":"A szociotope egy nyilvánosan hozzáférhető park, természeti terület vagy más fejletlen terület, ahol jól érzi magát. A szociotope térkép megmutatja, hol találhatók a területek Stockholmban, és milyen tulajdonságokkal rendelkeznek a különböző területek. A szociotóp térkép olyan tervezési alap, amely felhasználható a város területrendezésében (áttekintés, terület- és részlettervezés), hogy megmutassa a parkok és természeti területek tulajdonságainak elérhetőségét. A 2022. évi változat a korábbi változatokhoz képest kiigazítást jelent azáltal, hogy eltávolítja az útfelületeket és a magántulajdonban lévő ingatlanokat, ahol azokat azonosították. A következő szociotóp típusok léteznek: Zöld oázis (park vagy zöld terület, amely szép maradni)PlaygroundNature (zöld terület, amely jól játszik)PromendsRoyaltyFlower (gazdag virágzás és kertészet)Ballspel (kerített téglalap alakú felület kavics, fű vagy mesterséges fű)Bollek (lapos felület kavics, fű vagy mesterséges fű)ParklekPicknick (nyílt nagy gyep vagy park és sziklás strandok)GrillingPulkaåkningGoing (növekedési lehetőség pl. kolóniakertekben)KépzésErdő érzésKültéri kilátásÁllati tartásVízi kapcsolatKültéri medence (hidak, homokos vagy sziklás strand hajóforgalom vagy szabadtéri medencék nélkül)Scrid skiingNature tapasztalat (wetlands, régi erdők, természetes strandok)Evenemennemen"},{"@language":"it-t-sv-t0-mtec","@value":"Un sociotopo è un parco accessibile al pubblico, un'area naturale o un'altra area non sviluppata in cui ci si sente bene. La mappa sociotopica mostra dove si trovano le aree di Stoccolma e quali sono le qualità delle diverse aree. La mappa sociotopica è una base di pianificazione che può essere utilizzata nella pianificazione territoriale della città (panoramica, pianificazione dell'area e dei dettagli) per mostrare la disponibilità di qualità nei parchi e nelle aree naturali. La versione 2022 è un adeguamento rispetto alle versioni precedenti mediante la rimozione delle superfici stradali e delle proprietà private laddove sono state individuate. Esistono i seguenti tipi di sociotopi: Oasi verde (parco o area verde che è bello stare in)PlaygroundNatura (area verde che funziona bene per giocare in)PromendsRoyaltyFlower (ricca fioritura e orticoltura)Ballspel (superficie rettangolare recintata con ghiaia, erba o erba artificiale)Bollek (superficie pianeggiante con ghiaia, erba o erba artificiale)ParklekPicknick (grandi prati soleggiati o parco e spiagge rocciose)GrillingPulkaåkningGoing (possibilità di crescere ad esempio in giardini di colonie)TrainingForest feelingVisita all'apertoContatto con gli animaliContatto con l'acquaPiscina all'aperto (ponti, spiaggia sabbiosa o rocciosa senza traffico di barche o piscine all'aperto)Scitazione Esperienza di natura (wetlands, vecchi boschi, spiagge naturali)Evenemen"},{"@language":"lt-t-sv-t0-mtec","@value":"Sociotopas yra viešai prieinamas parkas, gamtinė zona ar kita neišvystyta teritorija, kurioje jis jaučiasi malonus būti. Sociotopų žemėlapyje parodyta, kur yra Stokholme esančios vietovės ir kokias savybes turi skirtingos vietovės. Sociotopų žemėlapis yra planavimo pagrindas, kuris gali būti naudojamas miesto erdviniam planavimui (apžvalgos, ploto ir detalių planavimui), siekiant parodyti parkų ir gamtos vietovių savybių prieinamumą. 2022 m. versija yra patikslinimas, palyginti su ankstesnėmis versijomis, pašalinant kelio paviršius ir privačią nuosavybę, kurioje jie buvo nustatyti. Egzistuoja šie sociotopų tipai: Žalioji oazė (parkas arba žalioji zona, kurioje malonu apsistoti)Žaidimų aikštelėGamta (žalioji zona, kurioje gerai tinka žaisti)PromendsRoyaltyFlower (turtingas žydėjimas ir sodininkystė)Ballspel (akmeninis stačiakampis paviršius su žvyru, žole ar dirbtine žole)Bollek (plokščias paviršius su žvyru, žole ar dirbtine žole)ParklekPicknick (saulėtos didelės vejos ar parkas ir uolėti paplūdimiai)GrillingPulkaåkningGoing (galimybė augti, pvz., kolonijų soduose)TrainingForest jausmasLauko vaizdasVandens kontaktasLauko baseinas (tiltai, smėlėtas ar uolėtas paplūdimys be laivų eismo ar lauko baseinų)ScridingNature patirtis (šlapynės, seni miškai, natūralūs paplūdimiai)Venemenai"},{"@language":"lv-t-sv-t0-mtec","@value":"Sociotops ir publiski pieejams parks, dabas teritorija vai cita neattīstīta teritorija, kur tas jūtas jauki būt. Sociotope kartē parādīts, kur atrodas apgabali Stokholmā un kādas ir dažādo apgabalu īpašības. Sociāltopu karte ir plānošanas pamats, ko var izmantot pilsētas telpiskajā plānošanā (pārskats, teritorijas un detālplānojums), lai parādītu parku un dabas teritoriju kvalitātes pieejamību. 2022. gada versija ir korekcija salīdzinājumā ar iepriekšējām versijām, noņemot ceļa segumus un privātos īpašumus, ja tie ir identificēti. Pastāv šādi sociotopu veidi: Zaļā oāze (parks vai zaļā zona, kurā ir patīkami uzturēties)Spēļu laukumsDaba (zaļā zona, kurā labi var spēlēt)PromendsRoyaltyFlower (bagātīga ziedēšana un dārzkopība)Ballspel (nožogota taisnstūra virsma ar granti, zāli vai mākslīgo zāli)Bollek (plakana virsma ar granti, zāli vai mākslīgo zāli)ParklekPicknick (saulaini lieli zālāji vai parks un akmeņainas pludmales)GrillingPulkaåkningGoing (iespēja augt, piemēram, koloniju dārzos)ApmācībaMeža sajūtaĀrtelpu skatsDzīvnieku turēšanaŪdens kontaktsĀrmalu peldbaseins (tilti, smilšaina vai akmeņaina pludmale bez laivu satiksmes vai āra baseiniem)Skrējuma slēpošanaDabas pieredze (mitrāji, veci meži, dabiskas pludmales)Evenemen"},{"@language":"mt-t-sv-t0-mtec","@value":"Soċjotopu huwa park aċċessibbli għall-pubbliku, żona naturali jew żona oħra mhux żviluppata fejn tħossha sabiħa li tkun. Il-mappa soċjotopika turi fejn jinsabu ż-żoni fi Stokkolma u liema kwalitajiet għandhom iż-żoni differenti. Il-mappa soċjotopika hija bażi ta’ ppjanar li tista’ tintuża fl-ippjanar spazjali tal-belt (ħarsa ġenerali, ippjanar taż-żona u tad-dettall) biex tintwera d-disponibbiltà tal-kwalitajiet fil-parks u fiż-żoni naturali. Il-verżjoni 2022 hija aġġustament meta mqabbla mal-verżjonijiet preċedenti billi jitneħħew l-uċuħ tat-toroq u l-proprjetajiet privati fejn ikunu ġew identifikati. Jeżistu t-tipi ta’ soċjotopi li ġejjin: Oasi ħadra (park jew żona ħadra li hija sabiħa li tibqa’ fiha)PlaygroundNature (żona ħadra li taħdem tajjeb biex tilgħab fiha)PromendsRoyaltyFlower (bir-rikkezza tal-fjuri u tal-ortikultura)Ballspel (wiċċ rettangolari delimitat biż-żrar, bil-ħaxix jew bil-ħaxix artifiċjali)Bollek (wiċċ ċatt biż-żrar, bil-ħaxix jew bil-ħaxix artifiċjali)ParklekPicknick (lawns kbar bix-xemx jew bajjiet tal-parks u tal-blat)GrillingPulkaåkningGoing (possibbiltà li tikber eż. f’ġonna tal-kolonji)TrainingForest feelingOutdoor viewAnimal keepingWater contactOutdoor swimming pool (pontijiet, bajja ramlija jew tal-blat mingħajr traffiku tad-dgħajjes jew pixxini fuq barra)Esperjenza tal-iskinarNature (artijiet mistagħdra, foresti antiki, bajjiet naturali)Evenemen"},{"@language":"nl-t-sv-t0-mtec","@value":"Een sociotoop is een openbaar toegankelijk park, natuurgebied of ander onontwikkeld gebied waar het fijn voelt om te zijn. De sociotoopkaart laat zien waar de gebieden zich in Stockholm bevinden en welke kwaliteiten de verschillende gebieden hebben. De sociotoopkaart is een planningsbasis die kan worden gebruikt in de ruimtelijke ordening van de stad (overzichts-, gebieds- en detailplanning) om de beschikbaarheid van kwaliteiten in parken en natuurgebieden aan te tonen. Versie 2022 is een aanpassing ten opzichte van eerdere versies door wegdek en privé-eigendommen te verwijderen waar deze zijn geïdentificeerd. De volgende soorten sociotopen bestaan: Groene oase (park of groen gebied dat leuk is om in te verblijven) SpeeltuinNatuur (groen gebied dat goed werkt om in te spelen)PromendsRoyaltyFlower (rijke bloei en tuinbouw)Ballspel (omheind rechthoekig oppervlak met grind, gras of kunstgras)Bollek (vlak oppervlak met grind, gras of kunstgras)ParklekPicknick (zonnige grote gazons of park en rotsachtige stranden)GrillingPulkaåkningGoing (mogelijkheid om te groeien in bijvoorbeeld kolonietuinen)TrainingForest feelingOutdoor viewDieren houdenWatercontactBuitenzwembad (bruggen, zandstrand of rotsstrand zonder bootverkeer of buitenzwembaden)Scrid skiënNature experience (wetlands, oude bossen, natuurlijke stranden)Evenemen"},{"@language":"pl-t-sv-t0-mtec","@value":"Socjotop jest publicznie dostępnym parkiem, obszarem naturalnym lub innym niezagospodarowanym obszarem, w którym miło jest być. Mapa socjotopowa pokazuje, gdzie znajdują się obszary w Sztokholmie i jakie cechy mają różne obszary. Mapa socjotopowa jest podstawą planowania, która może być wykorzystana w planowaniu przestrzennym miasta (przegląd, planowanie powierzchni i szczegółów), aby pokazać dostępność cech w parkach i obszarach przyrodniczych. Wersja z 2022 r. stanowi korektę w porównaniu z poprzednimi wersjami polegającą na usunięciu nawierzchni dróg i nieruchomości prywatnych, w których zostały one zidentyfikowane. Istnieją następujące typy socjotopów: Zielona oaza (park lub zieleń, w której miło się zatrzymać)Plac zabawNatura (zielony obszar, w którym dobrze się bawi)PromendsRoyaltyFlower (bogaty kwiat i ogrodnictwo)Ballspel (ogrodzona prostokątna powierzchnia ze żwirem, trawą lub sztuczną trawą)Bollek (płaska powierzchnia ze żwirem, trawą lub sztuczną trawą)ParklekPicknick (oświetlone duże trawniki lub park i skaliste plaże)GrillingPulkaåkningGoing (możliwość uprawy np. w ogrodach kolonii)TrainingForest feelingWidok zewnętrznyZachowanie zwierzątKontakt z wodąPływalnia na zewnątrz (mosty, piaszczysta lub skalista plaża bez ruchu łodzią lub baseny zewnętrzne)Scrid skiingDoświadczenie przyrodnicze (grunty, stare lasy, naturalne plaże)Evenemenen"},{"@language":"pt-t-sv-t0-mtec","@value":"Um sociotopo é um parque acessível ao público, área natural ou outra área subdesenvolvida onde é agradável estar. O mapa sociotópica mostra onde as áreas estão localizadas em Estocolmo e que qualidades as diferentes áreas têm. O mapa sociotópico é uma base de planeamento que pode ser utilizada no ordenamento do território da cidade (supervisão, planeamento da área e do detalhe) para mostrar a disponibilidade de qualidades em parques e áreas naturais. A versão de 2022 é um ajustamento em comparação com as versões anteriores, mediante a remoção das superfícies rodoviárias e das propriedades privadas onde foram identificadas. Existem os seguintes tipos de sociotopos: Oásis verde (parque ou área verde que é bom para ficar)PlaygroundNature (área verde que funciona bem para brincar)PromendsRoyaltyFlower (florescência rica e horticultura)Ballspel (superfície retangular vedada com cascalho, grama ou grama artificial)Bollek (superfície plana com cascalho, grama ou grama artificial)ParklekPicknick (grandes gramados iluminados pelo sol ou parque e praias rochosas)GrillingPulkaåkningGoing (possibilidade de crescer, por exemplo, em jardins de colónias)TrainingForest feelingOutdoor viewManutenção de animaisContacto com a água Piscina exterior (pontes, praia arenosa ou rochosa sem tráfego de barcos ou piscinas ao ar livre)Experiência de skiingcridNature (terras, florestas antigas, praias naturais)Evenemen"},{"@language":"ro-t-sv-t0-mtec","@value":"Un sociotop este un parc accesibil publicului, o zonă naturală sau o altă zonă nedezvoltată în care se simte bine să fie. Harta sociotop arată unde sunt situate zonele din Stockholm și ce calități au diferitele zone. Harta sociotopică este o bază de planificare care poate fi utilizată în planificarea spațială a orașului (vedere generală, planificare zonală și detaliată) pentru a arăta disponibilitatea calităților în parcuri și zone naturale. Versiunea 2022 reprezintă o ajustare în comparație cu versiunile anterioare prin eliminarea suprafețelor rutiere și a proprietăților private în cazul în care acestea au fost identificate. Există următoarele tipuri de sociotopi: Oază verde (parc sau zonă verde în care este plăcut să stați)PlaygroundNature (zonă verde care funcționează bine pentru a juca)PromendsRoyaltyFlower (înflorire bogată și horticultură)Ballspel (suprafață dreptunghiulară împrejmuită cu pietriș, iarbă sau iarbă artificială)Bollek (suprafață plană cu pietriș, iarbă sau iarbă artificială)ParklekPicknick (peluze mari luminate de soare sau parc și plaje stâncoase)GrillingPulkaåkningGoing (posibilitatea de a crește, de exemplu, în grădinile coloniilor)TrainingSenzație de pădurePrivire în aer liberContactul cu apaPiscine în aer liber (poduri, plaje nisipoase sau stâncoase fără trafic cu barca sau piscine în aer liber)Scrid skiingExperiență în natură (zone umede, păduri vechi, plaje naturale)Evenemen"},{"@language":"sk-t-sv-t0-mtec","@value":"Sociotop je verejne prístupný park, prírodná oblasť alebo iná nerozvinutá oblasť, kde sa cíti príjemne. Sociálno-topová mapa ukazuje, kde sa nachádzajú oblasti v Štokholme a aké kvality majú rôzne oblasti. Sociálno-topová mapa je plánovacím základom, ktorý možno použiť pri územnom plánovaní mesta (prehľad, územné plánovanie a podrobné plánovanie) na zobrazenie dostupnosti kvalít v parkoch a prírodných oblastiach. Verzia 2022 je úprava v porovnaní s predchádzajúcimi verziami odstránením povrchov ciest a súkromných nehnuteľností, v prípade ktorých boli identifikované. Existujú nasledujúce typy sociotopov: Zelená oáza (park alebo zelená plocha, v ktorej je pekné zostať)PlaygroundNature (zelená plocha, v ktorej sa dobre hrá)PromendsRoyaltyFlower (bohaté kvitnutie a záhradníctvo)Ballspel (oplotený obdĺžnikový povrch so štrkom, trávou alebo umelou trávou)Bollek (plochá plocha so štrkom, trávou alebo umelou trávou)ParklekPicknick (slnečné veľké trávniky alebo park a skalnaté pláže)GrillingPulkaåkningGoing (možnosť rastu napr. v koloniálnych záhradách)TrainingForest feelingOutdoor viewAnimalkeepingWater contactOutdoor swimming pool (bridges, piesčitá alebo skalnatá pláž bez lodnej dopravy alebo vonkajších bazénov)Scrid skiingNature experience (vlhly, staré lesy, prírodné pláže)Evenemen"},{"@language":"sl-t-sv-t0-mtec","@value":"Sociotop je javno dostopen park, naravno območje ali drugo nerazvito območje, kjer se počuti lepo. Zemljevid sociotopov prikazuje, kje se območja nahajajo v Stockholmu in kakšne lastnosti imajo različna območja. Karta sociotopov je osnova za načrtovanje, ki jo je mogoče uporabiti pri prostorskem načrtovanju mesta (pregled, prostorsko in podrobno načrtovanje) za prikaz razpoložljivosti lastnosti v parkih in naravnih območjih. Različica iz leta 2022 je prilagoditev v primerjavi s prejšnjimi različicami, saj so bile odstranjene cestne površine in zasebne nepremičnine, kjer so bile opredeljene. Obstajajo naslednje vrste sociotopov: Zelena oaza (park ali zelena površina, v kateri je lepo ostati)PlaygroundNature (zelena površina, ki dobro deluje, da se igra)PromendsRoyaltyFlower (bogata cvetoča in vrtnarska)Ballspel (ograjena pravokotna površina s prodom, travo ali umetno travo)Bollek (ravna površina s prodom, travo ali umetno travo)ParklekPicknick (sončne velike trate ali park in skalnate plaže)GrillingPulkaåkningGoing (možnost rasti na primer v kolonijskih vrtovih)TrainingForest občutekOutdoor viewAnimal keepWater contactOutdoor plavalni bazen (mostovi, peščena ali skalnata plaža brez prometa z ladjo ali zunanji bazeni)Scrid skiingNature izkušnje (wetlands, stari gozdovi, naravne plaže)Evemenmen"},{"@language":"sv","@value":"En sociotop är en offentligt tillgänglig park, naturområde eller annan obebyggd yta där det känns trevligt att vara. Sociotopkartan visar var områdena finns i Stockholm och vilka kvaliteter de olika områdena har. Sociotopkartan är ett planeringsunderlag som kan användas i stadens fysiska planering (översikts-, områdes- och detaljplanering) för att visa tillgången på kvaliteter i parker och naturområden. Version 2022 är en justering jämfört med tidigare versioner genom att vägytor och privata fastigheter har tagits bort där de har identifierats. Följande sociotoptyper finns: Grön oas (park eller grönområde som är trevligt att vistas i)LekplatsNaturlek (grönområde som fungerar bra att leka i)PromenaderRofylldhetBlomprakt (rik blomning och trädgårdsodling)Bollspel (inhägnad rektangulär yta med grus, gräs eller konstgräs)Bollek (plan yta med grus, gräs eller konstgräs)ParklekPicknick (solbelysta stora gräsplaner eller park- och klippstränder)GrillningPulkaåkningOdling (möjlighet att odla i t.ex. koloniträdgårdar)LöpträningSkogskänslaUtsiktDjurhållningVattenkontaktUtomhusbad (bryggor, sand- eller klippstrand utan båttrafik eller utomhusbassänger)SkridskoåkningNaturupplevelse (våtmarker, gamla skogar, naturstränder)EvenemangFolklivTorghandel"},{"@language":"uk-t-sv-t0-mtec","@value":"Соціотоп - це загальнодоступний парк, природна зона або інша нерозвинена територія, де приємно перебувати. Карта соціотопів показує, де розташовані райони в Стокгольмі і які якості мають різні райони. Карта соціотопу - це планувальна основа, яка може бути використана в просторовому плануванні міста (огляд, площа та детальне планування), щоб показати наявність якостей у парках та природних зонах. Версія 2022 - це коригування порівняно з попередніми версіями шляхом видалення дорожніх покриттів та приватних об'єктів, де вони були ідентифіковані. Існують такі типи соціотопів: Зелений оазис (парк або зелена зона, в якій приємно зупинитися) Дитячий майданчикПрирода (зелена зона, яка добре працює, щоб грати в)PromendsRoyaltyFlower (багате цвітіння та садівництво)Ballspel (огороджена прямокутна поверхня з гравієм, травою або штучною травою)Bollek (плоска поверхня з гравієм, травою або штучною травою)ParklekPick (сонячні великі газони або парк і скелясті пляжі)GrillingPulkaåkningGoing (можливість рости, наприклад, в колоніальних садах)TrainingВідчуття лісуВідкритий видЗберігання тваринКонтакт з водоюВідкритий плавальний басейн (мости, піщаний або кам'янистий пляж без руху човнів або відкритих басейнів)Scrid skiingДосвід природи (болот, старі ліси, природні пляжі)Evenemen"}],"dct:format":"text/html","dct:identifier":"25a85232-80d7-4e45-aee3-94dabb7c0bb4","dct:issued":{"@type":"xsd:date","@value":"2004-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2021-12-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:49b9550c7ff7d82e3db8864856dd41ff0a6be0934970e93783155edfe41470b5_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Sociotope Map - qualities of parks, nature and other public accessible areas (2022 г.) (вътрешна SBK) (Социотопна карта на SBK — качества на парковете, природата и други обществено достъпни зони)"},{"@language":"cs-t-sv-t0-mtec","@value":"Sociotopová mapa SBK - vlastnosti parků, přírody a dalších veřejně přístupných oblastí (2022) (vnitřní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Sociotope Map – kvaliteter af parker, natur og andre offentligt tilgængelige områder (2022) (internt SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Soziotop Karte - Qualitäten von Parks, Natur und anderen öffentlich zugänglichen Bereichen (2022) (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Sociotope Map - quality of parks, nature and other public accessible areas (Κοινωνιοτοπικός χάρτης SBK - ποιότητες πάρκων, φύσης και άλλων δημοσίως προσβάσιμων περιοχών) (2022) (εσωτερική SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Sociotope Map - qualities of parks, nature and other publicly accessible areas (2022) (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa sociotópico de SBK: calidades de los parques, la naturaleza y otras zonas de acceso público (2022) (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Sociotope kaart – parkide, looduse ja muude avalikult juurdepääsetavate alade omadused (2022) (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Sociotope Map - puistojen, luonnon ja muiden julkisten alueiden ominaisuudet (2022) (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte sociotope SBK - qualités des parcs, de la nature et d’autres zones accessibles au public (2022) (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Sochóp SBK - cáilíochtaí páirceanna, an dúlra agus limistéar eile atá inrochtana don phobal (2022) (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"Sociotope karta SBK-a – kvalitete parkova, prirode i drugih javno dostupnih područja (2022.) (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Szociotóp térkép - a parkok, a természet és más nyilvánosan hozzáférhető területek tulajdonságai (2022) (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Sociotope Map - qualità dei parchi, della natura e di altre aree accessibili al pubblico (2022) (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK sociotopų žemėlapis. Parkų, gamtos ir kitų viešai prieinamų vietovių savybės (2022 m.) (vidinis SBK)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Sociotope Karte - parku, dabas un citu publiski pieejamu teritoriju īpašības (2022) (iekšējā SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Sociotope Map - kwalitajiet tal-parks, in-natura u żoni oħra aċċessibbli għall-pubbliku (2022) (SBK intern)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Sociotope Map - kwaliteiten van parken, natuur en andere openbaar toegankelijke gebieden (2022) (interne SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa Socjotopowa SBK - cechy parków, przyrody i innych obszarów ogólnodostępnych (2022) (wewnętrzna SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa Sociotópico da SBK – qualidades dos parques, da natureza e de outras zonas acessíveis ao público (2022) (SBK interno)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Sociotope Map – qualities of parks, nature and other public accessible areas (Harta Sociotopilor SBK – calitățile parcurilor, ale naturii și ale altor zone accesibile publicului) (2022) (SBK internă)"},{"@language":"sk-t-sv-t0-mtec","@value":"Sociotopová mapa SBK - kvalita parkov, prírody a iných verejne prístupných oblastí (2022) (vnútorná SBK)"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid sociotopov SBK – lastnosti parkov, narave in drugih javno dostopnih območij (2022) (notranji SBK)"},{"@language":"sv","@value":"SBK Sociotopkartan - kvaliteter i parker, natur och andra offentligt tillgängliga områden (2022) (internt SBK)"},{"@language":"uk-t-sv-t0-mtec","@value":"Карта СБК Соціотоп - якості парків, природи та інших загальнодоступних територій (2022) (внутрішній СБК)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/cc37ab3d-1773-497d-93e3-70f19e998ec2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/25a85232-80d7-4e45-aee3-94dabb7c0bb4#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/cc37ab3d-1773-497d-93e3-70f19e998ec2"}},{"@id":"http://data.europa.eu/88u/record/25a85232-80d7-4e45-aee3-94dabb7c0bb4","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/cc37ab3d-1773-497d-93e3-70f19e998ec2"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"25a85232-80d7-4e45-aee3-94dabb7c0bb4","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:29Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/25a85232-80d7-4e45-aee3-94dabb7c0bb4"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:49b9550c7ff7d82e3db8864856dd41ff0a6be0934970e93783155edfe41470b5_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/25a85232-80d7-4e45-aee3-94dabb7c0bb4"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:39:29Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"25a85232-80d7-4e45-aee3-94dabb7c0bb4","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/25a85232-80d7-4e45-aee3-94dabb7c0bb4"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:49b9550c7ff7d82e3db8864856dd41ff0a6be0934970e93783155edfe41470b5"},{"@graph":[{"@id":"_:4be49fbd3e4f2fcb9f01a317be34d891678c2cd2b1d1d50edd745c6a3df8ecbf_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4434,18.2011 59.4434,18.2011 59.2272,17.7605 59.2272,17.7605 59.4434))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4434,18.2011 59.4434,18.2011 59.2272,17.7605 59.2272,17.7605 59.4434))"}},{"@id":"_:4be49fbd3e4f2fcb9f01a317be34d891678c2cd2b1d1d50edd745c6a3df8ecbf_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"160d9502dcea1d25a3e8c6e98b4a0fcd66"},{"@id":"http://data.europa.eu/88u/dataset/76f2c008-1d71-473b-bd24-7a499293d711","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/1910be9f-e78d-4050-8574-8e739a04b1d2"},{"@id":"http://data.europa.eu/88u/distribution/7b7fa2c7-bd5c-451b-83a2-1a54f46c7618"},{"@id":"http://data.europa.eu/88u/distribution/ed23b171-80b4-489b-9df5-db8cc033432d"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=003c9649-91fd-4ae0-9958-a335c6b77b13"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:created":{"@type":"xsd:date","@value":"1998-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Надзорни дейности, свързани с надзора на храните, от деловодната система на администрацията по околна среда, ECOS 2. Данните се актуализират ежеседмично."},{"@language":"cs-t-sv-t0-mtec","@value":"Dozorové činnosti související s dozorem nad potravinami ze systému správy případů Ekologické správy, ECOS 2. Data jsou aktualizována každý týden."},{"@language":"da-t-sv-t0-mtec","@value":"Tilsynsaktiviteter i forbindelse med fødevaretilsyn fra Miljøstyrelsens sagsstyringssystem, ECOS 2. Data opdateres ugentligt."},{"@language":"de-t-sv-t0-mtec","@value":"Überwachungstätigkeiten im Zusammenhang mit der Lebensmittelüberwachung aus dem Fallbearbeitungssystem der Umweltverwaltung, ECOS 2. Die Daten werden wöchentlich aktualisiert."},{"@language":"el-t-sv-t0-mtec","@value":"Δραστηριότητες εποπτείας, που σχετίζονται με την εποπτεία των τροφίμων, από το σύστημα διαχείρισης υποθέσεων της Περιβαλλοντικής Διοίκησης, ECOS 2. Τα δεδομένα ενημερώνονται εβδομαδιαίως."},{"@language":"en-t-sv-t0-mtec","@value":"Supervision activities, related to food supervision, from the Environmental Administration's case management system, ECOS 2. Data is updated weekly."},{"@language":"es-t-sv-t0-mtec","@value":"Actividades de supervisión, relacionadas con la supervisión alimentaria, desde el sistema de gestión de casos de la Administración Ambiental, ECOS 2. Los datos se actualizan semanalmente."},{"@language":"et-t-sv-t0-mtec","@value":"Toidujärelevalvega seotud järelevalvetegevus Keskkonnaameti juhtumikorralduse süsteemist ECOS 2. Andmeid uuendatakse iga nädal."},{"@language":"fi-t-sv-t0-mtec","@value":"Elintarvikevalvontaan liittyvät valvontatoimet Ympäristöhallinnon asianhallintajärjestelmästä, ECOS 2. Tiedot päivitetään viikoittain."},{"@language":"fr-t-sv-t0-mtec","@value":"Activités de supervision, liées à la supervision des aliments, du système de gestion des cas de l'Administration de l'environnement, ECOS 2. Les données sont mises à jour chaque semaine."},{"@language":"ga-t-sv-t0-mtec","@value":"Gníomhaíochtaí maoirseachta, a bhaineann le maoirseacht bia, ó chóras bainistithe cásanna an Riaracháin Comhshaoil, ECOS 2. Déantar na sonraí a nuashonrú go seachtainiúil."},{"@language":"hr-t-sv-t0-mtec","@value":"Nadzorne aktivnosti povezane s nadzorom hrane iz sustava vođenja predmeta Uprave za okoliš, ECOS 2. Podaci se ažuriraju svaki tjedan."},{"@language":"hu-t-sv-t0-mtec","@value":"Az élelmiszer-felügyelethez kapcsolódó felügyeleti tevékenységek a Környezetvédelmi Igazgatóság ügyviteli rendszeréből, ECOS 2. Az adatok hetente frissülnek."},{"@language":"it-t-sv-t0-mtec","@value":"Attività di supervisione, relative alla supervisione alimentare, dal sistema di gestione dei casi dell'Amministrazione Ambientale, ECOS 2. I dati vengono aggiornati settimanalmente."},{"@language":"lt-t-sv-t0-mtec","@value":"Priežiūros veikla, susijusi su maisto produktų priežiūra, iš Aplinkos apsaugos administracijos bylų valdymo sistemos, ECOS 2. Duomenys atnaujinami kas savaitę."},{"@language":"lv-t-sv-t0-mtec","@value":"Uzraudzības darbības, kas saistītas ar pārtikas uzraudzību, no Vides pārvaldes lietu pārvaldības sistēmas, ECOS 2. Dati tiek atjaunināti katru nedēļu."},{"@language":"mt-t-sv-t0-mtec","@value":"Attivitajiet ta’ superviżjoni, relatati mas-superviżjoni tal-ikel, mis-sistema ta’ ġestjoni tal-każijiet tal-Amministrazzjoni Ambjentali, ECOS 2. Id-data tiġi aġġornata kull ġimgħa."},{"@language":"nl-t-sv-t0-mtec","@value":"Toezichtactiviteiten, met betrekking tot voedseltoezicht, vanuit het casemanagementsysteem van de Milieuadministratie, ECOS 2. De gegevens worden wekelijks bijgewerkt."},{"@language":"pl-t-sv-t0-mtec","@value":"Działania nadzorcze związane z nadzorem nad żywnością, z systemu zarządzania sprawami Administracji Środowiska, ECOS 2. Dane są aktualizowane co tydzień."},{"@language":"pt-t-sv-t0-mtec","@value":"Atividades de supervisão, relacionadas com a supervisão alimentar, do sistema de gestão de processos da Administração Ambiental, ECOS 2. Os dados são atualizados semanalmente."},{"@language":"ro-t-sv-t0-mtec","@value":"Activități de supraveghere, legate de supravegherea alimentelor, din sistemul de management de caz al Administrației de Mediu, ECOS 2. Datele sunt actualizate săptămânal."},{"@language":"sk-t-sv-t0-mtec","@value":"Dozorné činnosti súvisiace s dohľadom nad potravinami zo systému správy prípadov environmentálnej správy, ECOS 2. Údaje sa aktualizujú týždenne."},{"@language":"sl-t-sv-t0-mtec","@value":"Nadzorne dejavnosti, povezane z nadzorom hrane, iz sistema vodenja zadev Uprave za okolje, ECOS 2. Podatki se posodabljajo tedensko."},{"@language":"sv","@value":"Tillsynverksamheter, rörande livsmedelstillsyn, från miljöförvaltningens ärendehanteringssystem, Ecos 2. Data uppdateras veckovis."},{"@language":"uk-t-sv-t0-mtec","@value":"Нагляд за діяльністю, пов'язаною з наглядом за продуктами харчування, з системи управління справами Управління навколишнього середовища, ECOS 2. Дані оновлюються щотижня."}],"dct:format":"text/html","dct:identifier":"76f2c008-1d71-473b-bd24-7a499293d711","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:4be49fbd3e4f2fcb9f01a317be34d891678c2cd2b1d1d50edd745c6a3df8ecbf_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Надзорна дейност - Хранителни продукти"},{"@language":"cs-t-sv-t0-mtec","@value":"Činnosti v oblasti dohledu – potraviny"},{"@language":"da-t-sv-t0-mtec","@value":"Tilsynsaktiviteter - Fødevarer"},{"@language":"de-t-sv-t0-mtec","@value":"Überwachungstätigkeiten - Lebensmittel"},{"@language":"el-t-sv-t0-mtec","@value":"Δραστηριότητες εποπτείας - Τρόφιμα"},{"@language":"en-t-sv-t0-mtec","@value":"Supervision activities - Foodstuffs"},{"@language":"es-t-sv-t0-mtec","@value":"Actividades de supervisión - Productos alimenticios"},{"@language":"et-t-sv-t0-mtec","@value":"Järelevalvetegevus – toiduained"},{"@language":"fi-t-sv-t0-mtec","@value":"Valvontatoiminta - Elintarvikkeet"},{"@language":"fr-t-sv-t0-mtec","@value":"Activités de surveillance - Denrées alimentaires"},{"@language":"ga-t-sv-t0-mtec","@value":"Gníomhaíochtaí maoirseachta - Earraí bia"},{"@language":"hr-t-sv-t0-mtec","@value":"Nadzorne aktivnosti – prehrambeni proizvodi"},{"@language":"hu-t-sv-t0-mtec","@value":"Felügyeleti tevékenységek – Élelmiszerek"},{"@language":"it-t-sv-t0-mtec","@value":"Attività di supervisione - Prodotti alimentari"},{"@language":"lt-t-sv-t0-mtec","@value":"Maisto produktų priežiūros veikla"},{"@language":"lv-t-sv-t0-mtec","@value":"Uzraudzības darbības – pārtikas produkti"},{"@language":"mt-t-sv-t0-mtec","@value":"1 Attivitajiet ta' superviżjoni - Oġġetti tal-ikel"},{"@language":"nl-t-sv-t0-mtec","@value":"Toezichtactiviteiten - Voedingsmiddelen"},{"@language":"pl-t-sv-t0-mtec","@value":"Działania nadzorcze – środki spożywcze"},{"@language":"pt-t-sv-t0-mtec","@value":"Actividades de supervisão - Géneros alimentícios"},{"@language":"ro-t-sv-t0-mtec","@value":"Activități de supraveghere - Produse alimentare"},{"@language":"sk-t-sv-t0-mtec","@value":"Dozorné činnosti – potraviny"},{"@language":"sl-t-sv-t0-mtec","@value":"Nadzorne dejavnosti – živila"},{"@language":"sv","@value":"Tillsynsverksamheter - Livsmedel"},{"@language":"uk-t-sv-t0-mtec","@value":"Нагляд за діяльністю - Продукти харчування"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/1910be9f-e78d-4050-8574-8e739a04b1d2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kontrollwiki.livsmedelsverket.se/artikel/194/riskklassning-av-livsmedelsanlaggningar-"},"dct:description":["Information om riskklassning av livsmedelsanläggningar och kontrolltid från Livsmedelsverket.",{"@language":"bg-t-sv-t0-mtec","@value":"Информация за класификацията на риска на обектите за храни и времето за контрол от Националната агенция по храните."},{"@language":"cs-t-sv-t0-mtec","@value":"Informace o klasifikaci rizik potravinářských zařízení a době kontroly od Národní agentury pro potraviny."},{"@language":"da-t-sv-t0-mtec","@value":"Oplysninger om risikoklassificering af fødevarevirksomheder og kontroltid fra Fødevarestyrelsen."},{"@language":"de-t-sv-t0-mtec","@value":"Informationen zur Risikoeinstufung von Lebensmittelbetrieben und Kontrollzeit der Nationalen Lebensmittelagentur."},{"@language":"el-t-sv-t0-mtec","@value":"Πληροφορίες σχετικά με την ταξινόμηση κινδύνου των εγκαταστάσεων τροφίμων και τον χρόνο ελέγχου από την Εθνική Υπηρεσία Τροφίμων."},{"@language":"en-t-sv-t0-mtec","@value":"Information on risk classification of food establishments and control time from the National Food Agency."},{"@language":"es-t-sv-t0-mtec","@value":"Información de la Agencia Nacional de Alimentación sobre la clasificación de riesgos de los establecimientos alimentarios y el tiempo de control."},{"@language":"et-t-sv-t0-mtec","@value":"Riiklikult toiduametilt saadud teave toidukäitlemisettevõtete riskiklassifikatsiooni ja kontrolliaja kohta."},{"@language":"fi-t-sv-t0-mtec","@value":"Tiedot elintarvikealan laitosten riskiluokituksesta ja valvonta-ajasta Kansalliselta elintarvikevirastolta."},{"@language":"fr-t-sv-t0-mtec","@value":"Informations sur la classification des risques des établissements alimentaires et le temps de contrôle fournies par l’Agence nationale de l’alimentation."},{"@language":"ga-t-sv-t0-mtec","@value":"Faisnéis maidir le haicmiú riosca bunaíochtaí bia agus am rialaithe ón nGníomhaireacht Náisiúnta Bia."},{"@language":"hr-t-sv-t0-mtec","@value":"Informacije Nacionalne agencije za hranu o klasifikaciji rizika objekata u poslovanju s hranom i vremenu kontrole."},{"@language":"hu-t-sv-t0-mtec","@value":"Az élelmiszer-ipari létesítmények kockázati besorolására és az ellenőrzési időre vonatkozó információk a Nemzeti Élelmiszerügynökségtől."},{"@language":"it-t-sv-t0-mtec","@value":"Informazioni sulla classificazione dei rischi degli stabilimenti alimentari e sul tempo di controllo da parte dell'Agenzia nazionale per gli alimenti."},{"@language":"lt-t-sv-t0-mtec","@value":"Nacionalinės maisto agentūros informacija apie maisto įmonių rizikos klasifikavimą ir kontrolės laiką."},{"@language":"lv-t-sv-t0-mtec","@value":"Valsts pārtikas aģentūras informācija par pārtikas uzņēmumu riska klasifikāciju un kontroles laiku."},{"@language":"mt-t-sv-t0-mtec","@value":"Informazzjoni dwar il-klassifikazzjoni tar-riskju tal-istabbilimenti tal-ikel u l-ħin ta’ kontroll mill-Aġenzija Nazzjonali tal-Ikel."},{"@langu