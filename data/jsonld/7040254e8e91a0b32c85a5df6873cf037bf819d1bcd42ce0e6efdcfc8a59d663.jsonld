f3-f296-4796-a4a2-3eb10f4590b3","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:6499ea42ed483514e92f3315486214f8d08b8f6acdc8e15289cebef61d5aea91_b0n0"},"dct:title":{"@language":"sv","@value":"Luftbrunn"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/22af4cf3-f296-4796-a4a2-3eb10f4590b3#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetWS.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/22af4cf3-f296-4796-a4a2-3eb10f4590b3#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Luftbrunn_Punkt&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/22af4cf3-f296-4796-a4a2-3eb10f4590b3#HTTP:OGC:WFS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Luftbrunn_Punkt"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/22af4cf3-f296-4796-a4a2-3eb10f4590b3#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Luftbrunn_Punkt"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:6499ea42ed483514e92f3315486214f8d08b8f6acdc8e15289cebef61d5aea91"},{"@graph":[{"@id":"_:64c7d6d601b19f6210cb1b5ed643b7d27bf9403e104a39ff4e36bfc2c27c702c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:OGC:WFS/2"},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:OGC:WMS/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Måttlig skada"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFunction1"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som representerar vägars utbredning baserat på svensk standard SS637004 för vägnätsanknytning. Vägnätstypen beskrivs med attributet TRAFFIC_TYPES som är en bitmask där: 1=bilnät, 2=cykelnät, 4=färjeled, 8=gångnät. Indelningen hierarkisk och beskriver väganläggningens design och inte vad som faktiskt gäller juridiskt. De juridiska egenskaperna beskrivs i de Lokala trafikföreskrifterna (LTF). Med hierarkisk indelning menas att Bilvägnätet är överst. Här är design primärt biltrafik, men det kan förkomma både gång och cykel. Därefter följer Cykelvägnät. Här är design primärt cykel, men gång kan förekomma. Dock inte biltrafik. Gångnätet är designat endast för gångtrafik. Det kan ibland vara problem med nedladdning av hela vägnätet då det är mycket data som ska processas (hela Stockholms län). Använd då nerladdningstjänsten TK statisk Shapefil som innehåller fil för-Bilvägnät-Cykelvägnät-Gångnät"},"dct:identifier":"771fed09-93ad-483b-8ec7-39afc305ffd7","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:64c7d6d601b19f6210cb1b5ed643b7d27bf9403e104a39ff4e36bfc2c27c702c_b0n0"},"dct:title":{"@language":"sv","@value":"Vägnät"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:OGC:WFS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=lv:LVD_FUNCTION_OBJECT_VIEW"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Intern staden WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/771fed09-93ad-483b-8ec7-39afc305ffd7#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=lv:LVD_FUNCTION_OBJECT_VIEW"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Intern staden WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:64c7d6d601b19f6210cb1b5ed643b7d27bf9403e104a39ff4e36bfc2c27c702c"},{"@graph":[{"@id":"_:656a8cd9787f36bb37649d5f6d9cf3f85f19550e98d33d34f94748eefb7fc3a3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:656a8cd9787f36bb37649d5f6d9cf3f85f19550e98d33d34f94748eefb7fc3a3_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"120dff20cb3f68d3308d5de7a644017323"},{"@id":"http://data.europa.eu/88u/dataset/981da240-25f7-48b9-bb37-b1ffc3c2f9a2","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/270a89f6-56b4-4746-946a-9701ad3bf7a5"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=d8ac6fac-f603-4354-8b4a-77e6e9892adf"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта - Адрес, град и улица се състоят от следните подтипове (подтипове) при информационната класификация 2020 (за текущия списък вж. Обща продуктова спецификация Регистрационна карта) :450100, Име на улицата Подтипове10, Име на улицата, модифицирано, активно450670, Адресно местоположение Подтипове10, Адресно местоположение, модифицирано, активно450680, Адресно местоположение, което не е FIR Подтипове10, Адресно местоположение, което не е FIR, модифицирано, активно"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registru - Adresa, město a ulice se skládala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa registru) :450100, Název ulice Podtypy10, Název ulice, modifikovatelný, active450670, Umístění adresy Podtypy10, Umístění adresy, modifikovatelné, active450680, Umístění adresy mimo FIR Podtypy10, Umístění adresy mimo FIR, modifikovatelné, aktivní"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort - Adresse, by og gade bestod af følgende undertyper (undertyper) i informationsklassifikationen 2020 (for den aktuelle liste se Generel produktspecifikation Registerkort) :450100, Gadenavn Undertype10, Gadenavn, modificerbar, active450670, Adresseplacering Undertype10, Adresseplacering, modificerbar, active450680, Adresseplacering ikke FIR Undertype10, Adresseplacering ikke FIR, modificerbar, aktiv"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte - Adresse, Stadt und Straße bestand aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Registerkarte) :450100, Straßenname Subtypen10, Straßenname, modifizierbar, active450670, Adressenstandort Subtypen10, Adressenstandort, modifizierbar, active450680, Adressenstandort nicht FIR Subtypen10, Adressenstandort nicht FIR, modifizierbar, aktiv"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Η διεύθυνση, η πόλη και η οδός αποτελούνταν από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης μητρώου) :450100, Υποτύποι ονόματος οδού10, Ονομασία οδού, τροποποιήσιμη, active450670, Τοποθεσία διεύθυνσης Subtypes10, Τοποθεσία διεύθυνσης, τροποποιήσιμη, active450680, Τοποθεσία διεύθυνσης όχι FIR Subtypes10, Τοποθεσία διεύθυνσης όχι FIR, τροποποιήσιμη, ενεργή"},{"@language":"en-t-sv-t0-mtec","@value":"Register map - Address, city and street consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification Register map) :450100, Street name Subtypes10, Street name, modifiable, active450670, Address location Subtypes10, Address location, modifiable, active450680, Address location not FIR Subtypes10, Address location not FIR, modifiable, active"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de registro: dirección, ciudad y calle constaban de los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual, véase la especificación general del producto, mapa de registro): 450100, nombre de la calle, subtipos10, nombre de la calle, modificable, activo450670, ubicación de la dirección, subtipos10, ubicación de la dirección, modificable, activo450680, ubicación de la dirección, no FIR, subtipos10, ubicación de la dirección, no FIR, modificable, activo"},{"@language":"et-t-sv-t0-mtec","@value":"Registrikaart - Aadress, linn ja tänav koosnes järgmistest alatüüpidest (alatüübid) 2020. aasta teabeklassifikatsioonis (praeguse loetelu kohta vt Üldine tootespetsifikaat Registrikaart):450100, Tänava nimi Alatüübid10, Tänava nimi, muudetav, aktiivne450670, Aadressi asukoha alatüübid10, Aadressi asukoht, muudetav, aktiivne450680, Aadressi asukoht, mitte FIR-alatüübid10, Aadressi asukoht, mitte FIR, muudetav, aktiivne"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta - Osoite, kaupunki ja katu koostuivat seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleiset tuote-eritelmät Rekisterikartta) :450100, Kadun nimi Alatyypit10, Kadun nimi, muokattavissa, active450670, Osoitepaikka Alatyypit10, Osoitepaikka, muokattavissa, active450680, Osoitepaikka ei FIR Alatyypit10, Osoitepaikka ei FIR, muokattavissa, aktiivinen"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte du registre - Adresse, ville et rue se composait des sous-types suivants (sous-types) à la classification d'information 2020 (pour la liste actuelle voir Spécification générale du produit Carte du registre) :450100, Nom de la rue Sous-types10, Nom de la rue, modifiable, active450670, Emplacement de l'adresse Sous-types10, Emplacement de l'adresse, modifiable, active450680, Emplacement de l'adresse non FIR Sous-types10, Emplacement de l'adresse non FIR, modifiable, actif"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil an chláir - Is éard a bhí sa seoladh, sa chathair agus sa tsráid na fochineálacha (fochineálacha) seo a leanas ag an aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach an tsonraíocht táirge Ghinearálta Léarscáil an Chláir) :450100, Ainm sráide Fochineálacha10, Ainm sráide, inmhodhnaithe, gníomhach450670, Suíomh an tseolta Fochineálacha10, Suíomh an tseolta, inmhodhnaithe, gníomhach450680, Suíomh an tseolta nach Fochineálacha FIR10 é, Suíomh an tseolta nach FIR é, inmhodhnaithe, gníomhach"},{"@language":"hr-t-sv-t0-mtec","@value":"Registarska karta – adresa, grad i ulica sastojali su se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Registarska karta) :450100, podtipova n