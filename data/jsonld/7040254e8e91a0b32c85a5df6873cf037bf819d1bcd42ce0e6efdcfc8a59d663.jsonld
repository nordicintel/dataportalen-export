id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2014-12-31"},"dct:description":{"@language":"sv","@value":"visar kartering av strålningstemperatur vid markytan är hämtade från den amerikanska satelliten Landsat 8 för perionden juni 2013 till september 2021. Visas som raster, värmeöar där temperaturen överstiger 35 grader, och som temperaturkurvor. För mer information, se https://miljobarometern.stockholm.se/content/docs/tema/klimat/varme/Temperaturanalyser-fr%C3%A5n-satellit-%C3%B6ver-Stockholms-stad.pdf"},"dct:identifier":"115430a9-87a9-467a-8d64-138a020ff63f","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f978b6a34048678a03a2a2d374c051ecc514c93ccdbc8a5bfb1a8e09f0b62de2_b0n0"},"dct:title":{"@language":"sv","@value":"Temperaturkartering 2013-2021"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/content/114e80ab8ea24ea4b4c38f95c5921f42/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Maximal strålningstemperatur"},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/b6407ffc9c6e4b219e7de542d8cf9b18/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Temperaturkurvor & värmeöar"},{"@id":"https://resources.stockholm.se/data/115430a9-87a9-467a-8d64-138a020ff63f#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.c