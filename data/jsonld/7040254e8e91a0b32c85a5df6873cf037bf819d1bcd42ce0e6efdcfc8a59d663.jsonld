"MGIS"},{"@language":"ga-t-sv-t0-mtec","@value":"MGIS"},{"@language":"hr-t-sv-t0-mtec","@value":"MGIS"},{"@language":"hu-t-sv-t0-mtec","@value":"MGIS"},{"@language":"it-t-sv-t0-mtec","@value":"MGIS"},{"@language":"lt-t-sv-t0-mtec","@value":"MGIS"},{"@language":"lv-t-sv-t0-mtec","@value":"MGIS"},{"@language":"mt-t-sv-t0-mtec","@value":"MGIS"},{"@language":"nl-t-sv-t0-mtec","@value":"MGIS"},{"@language":"pl-t-sv-t0-mtec","@value":"MGIS"},{"@language":"pt-t-sv-t0-mtec","@value":"MGIS"},{"@language":"ro-t-sv-t0-mtec","@value":"MGIS"},{"@language":"sk-t-sv-t0-mtec","@value":"MGIS"},{"@language":"sl-t-sv-t0-mtec","@value":"MGIS"},{"@language":"uk-t-sv-t0-mtec","@value":"МГІС"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/fbcccf85-da03-4ed5-af72-8e3e29656839"}},{"@id":"http://data.europa.eu/88u/record/3e16577d-5a9a-427a-8640-0786bd2dc728","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/ca92d1be-b751-4321-864a-da86bbb2a4dc"},{"@id":"http://data.europa.eu/88u/distribution/fbcccf85-da03-4ed5-af72-8e3e29656839"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"3e16577d-5a9a-427a-8640-0786bd2dc728","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:01Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:31Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/3e16577d-5a9a-427a-8640-0786bd2dc728"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:73804f5fbdf091c7ff6805184e46d670b4a36e24a4a1661a38b5c6c349929f0c_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/3e16577d-5a9a-427a-8640-0786bd2dc728"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:01Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:38:31Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"3e16577d-5a9a-427a-8640-0786bd2dc728","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/3e16577d-5a9a-427a-8640-0786bd2dc728"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:73804f5fbdf091c7ff6805184e46d670b4a36e24a4a1661a38b5c6c349929f0c"},{"@graph":[{"@id":"_:73f684e5d8ad7b8a59e1f214ab9b084020d32dde935a6199c636e7e5e6380633_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:73f684e5d8ad7b8a59e1f214ab9b084020d32dde935a6199c636e7e5e6380633_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2017-05-04"},"dcat:startDate":{"@type":"xsd:date","@value":"2017-04-21"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2017-05-04"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2017-04-21"}},{"@id":"_:73f684e5d8ad7b8a59e1f214ab9b084020d32dde935a6199c636e7e5e6380633_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1b482e3eaed72f6d8faeb6ab57d157554f"},{"@id":"http://data.europa.eu/88u/dataset/986857bb-91a0-4e41-95f9-10124046c72e","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/9a7420c3-eafe-4bb4-97a1-96451c4af824"},{"@id":"http://data.europa.eu/88u/distribution/bfa99c33-adcc-4719-8ad9-3fac80799a64"},{"@id":"http://data.europa.eu/88u/distribution/f829ba7d-0a74-4810-af03-1ebde319e858"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=196231ad-8670-464d-853a-d3886477dbfa"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2017-05-04"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. 1800 mРезолюция: 8 см/пиксел. Дата на снимката: 2—5 май 2017 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 1800 mRozlišení: 8 cm/pixel. Datum pořízení fotografie: května 2017. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. 1800 mLøsning: 8 cm/pixel. Fotografiets dato: den 2.-5. maj 2017. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. 1800 mAuflösung: 8 cm/Pixel. Fotodatum: Mai 2017. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. 1800 mΨήφισμα: 8 cm/pixel. Ημερομηνία φωτογραφίας: 2-5 Μαΐου 2017. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. 1800 mResolution: 8 cm/pixel. Date of photograph: 2-5 May 2017. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. 1800 mResolución: 8 cm/píxel. Fecha de la fotografía: 2-5 de mayo de 2017. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. 1800 mResolutsioon: 8 cm/piksel. Foto kuupäev: 5. mai 2017. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. 1800 mResoluutio: 8 cm/pikseli. Valokuvauksen päivämäärä: toukokuuta 2017. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. 1800 mRésolution: 8 cm/pixel. Date de la photographie: du 2 au 5 mai 2017. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. 1800 mRéiteach: 8 cm/picteilín. Dáta an ghrianghraif: 2-5 Bealtaine 2017. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. 1800 mRezolucija: 8 cm/piksel. Datum fotografije: 5. svibnja 2017. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. 1800 mFelbontás: 8 cm/pixel. Fénykép dátuma: 2017. május 2–5. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. 1800 mRisoluzione: 8 cm/pixel. Data della fotografia: 2-5 maggio 2017. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. 1800 mRezoliucija: 8 cm/pikselis. Fotografavimo data: 2017 m. gegužės 2–5 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. 1800 mIzšķirtspēja: 8 cm/pikselī. Fotogrāfijas datums: 2017. gada 2.–5. maijā. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. 1800 mRiżoluzzjoni: 8 cm/pixel. Data tar-ritratt: 2-5 ta' Mejju 2017. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. 1800 mResolutie: 8 cm/pixel. Datum van de foto: 2-5 mei 2017. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. 1800 mRozdzielczość: 8 cm/piksel. Data zdjęcia: 2–5 maja 2017 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. 1800 mResolução: 8 cm/píxel. Data da fotografia: 2-5 de maio de 2017. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. 1800 mRezoluție: 8 cm/pixel. Data fotografiei: 2-5 mai 2017. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 1800 mRozlíšenie: 8 cm/pixel. Dátum fotografie: mája 2017. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. 1800 mResolucija: 8 cm/piksel. Datum fotografiranja: in 5. maja 2017. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 1800 mUpplösning: 8 cm/pixel. Fotograferingsdatum: 2-5 maj 2017. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 1800 mРішення: 8 см/піксель. Дата фотографії: 2-5 травня 2017 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"986857bb-91a0-4e41-95f9-10124046c72e","dct:issued":{"@type":"xsd:date","@value":"2018-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:73f684e5d8ad7b8a59e1f214ab9b084020d32dde935a6199c636e7e5e6380633_b0n0"},"dct:temporal":{"@id":"_:73f684e5d8ad7b8a59e1f214ab9b084020d32dde935a6199c636e7e5e6380633_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Orthofoto / Ортофото (2017)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Orthofoto (2017) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ορθοφύτο (2017)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthofoto (2017.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Orthofoto (2017) - Videó letöltés mp3-ban"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Orthofoto (2017 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthofoto (2017) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthofoto (2017)"},{"@language":"sv","@value":"SBK Ortofoto (2017)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Ортофото (2017)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/9a7420c3-eafe-4bb4-97a1-96451c4af824","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2017?"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/986857bb-91a0-4e41-95f9-10124046c72e#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst Ortofoto 2017",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2017"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2017"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2017"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2017"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2017"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2017"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2017"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2017"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2017"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2017"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2017"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2017"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2017"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2017"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2017"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2017"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2017"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS-service Ortofoto 2017"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2017"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2017"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2017"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2017"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2017"},{"@language":"uk-t-sv-t0-mtec","@value":"WMS сервіс Ortofoto 2017"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/9a7420c3-eafe-4bb4-97a1-96451c4af824"}},{"@id":"http://data.europa.eu/88u/distribution/bfa99c33-adcc-4719-8ad9-3fac80799a64","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2017?"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/986857bb-91a0-4e41-95f9-10124046c72e#HTTP:OGC:WMS/5","dct:title":["WMS-tjänst Ortofoto 2017",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2017"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2017"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2017"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2017"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2017"},{"@language":"en-t-sv-t0-mtec","@value":