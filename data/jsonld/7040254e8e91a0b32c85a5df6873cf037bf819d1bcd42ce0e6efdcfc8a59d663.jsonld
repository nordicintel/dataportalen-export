tions.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"För att följa klimatförändringar krävs tillgång till långa tidsserier med väderdata för flera decennier. Stockholms klimat- och väderstatistik baseras främst på data från SMHI:s mätstation vid Observatorielunden. Den hydrologiska statistiken (vatten) hämtas från olika mätstationer i Mälaren och Saltsjön. Med hjälp av de långa mätserierna går det att uppskatta trender och naturlig variation."},"dct:format":"text/html","dct:identifier":"56ce79ba-fc02-4e23-a43d-8aa9426eef89","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:092d5e7dd97bcf1869889a485b51f13b572b622a42550feb9e0845c2f49182cf_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Klimat - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/56ce79ba-fc02-4e23-a43d-8aa9426eef89#HTTP:ESRI+Portal-URL/2","dct:title":"Miljöförvaltningens öppna data-hub","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0d1de8bf-ecd9-414e-94d7-43471dcb2a69"}},{"@id":"http://data.europa.eu/88u/distribution/c6985ff1-fbee-42e5-8e24-6059a1cd323f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/klimat/"},"dct:format":"text/html","dct:i