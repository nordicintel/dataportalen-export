r":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:c9ce8bb245b029c97b59e70c47cde3e343dad0363998568b0bb1ea27dc24cb65"},{"@graph":[{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2021-05-08"},"dcat:startDate":{"@type":"xsd:date","@value":"2021-04-28"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2021-05-08"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2021-04-28"}},{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"12b0c19e1692e570f10a1f8fd84228b172"},{"@id":"http://data.europa.eu/88u/dataset/73302594-7333-463d-a70d-717c0aa73426","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f66aac00-bf2b-49e6-8a20-10f29d0b88fe"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2022-04-06"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Данни за надморската височина, 1 метър координатна мрежа. Координираните и повишени точки във файла на координатната мрежа се основават на данни от въздушно лазерно сканиране над град Стокхолм в периода 28 април — 8 май 2021 г. и се интерполират в координатна мрежа с разделителна способност 1 m. Плътността на точките в първоначалния точков облак е най-малко 16 точки/m2 на земята. Елементите не са актуализирани, откакто са създадени. Това означава, че за райони, където почвата се е променила след сканирането, координатите на точките не съвпадат. Детайли като сгради, водни повърхности и брегови линии, кейови и мостови стойки от базовата карта се използват за подобряване на качеството на мрежата.Елементите в слоя \"Скрита земя\" показват интерполираната височина на земята под съществуващите сгради. Това, че височините са интерполирани, означава, че те са изчислени височини от околните известни височини. Известните височини са наситени около сградата. Точките в слоя Скрита вода показват интерполираната височина на водата под съществуващите мостове. Това, че височините са интерполирани, означава, че те са изчислени височини от околните известни височини. Известните височини са наситени около мостовете. Точките на мрежата за вода се основават на височини и разпределение на водните повърхности в основната карта.Точността във височина е 9 см или по-добра за твърди повърхности и 15 см или по-добра за други повърхности. В самолетите точността е 15 см или по-добра."},{"@language":"cs-t-sv-t0-mtec","@value":"Údaje o nadmořské výšce, mřížka 1 metr. Koordinované a vyvýšené body v souboru mřížky jsou založeny na údajích z leteckého laserového skenování nad městem Stockholm v období od 28. dubna do 8. května 2021 a interpolovány do mřížky s rozlišením 1 m. Hustota bodů v původním oblaku bodů je nejméně 16 bodů/m2 na zemi. Položky nebyly aktualizovány od doby, kdy byly vytvořeny. To znamená, že v oblastech, kde se půda od skenování změnila, se souřadnice bodů neshodují. Podrobnosti, jako jsou budovy, vodní plochy a pobřeží, nábřeží a mosty z základní mapy se používají ke zlepšení kvality mřížky.Položky ve vrstvě Hidden Ground ukazují interpolovanou výšku země pod stávajícími budovami. To, že jsou výšky interpolovány, znamená, že jsou vypočteny výšky z okolních známých výšek. Známé výšky jsou kolem budovy nasyceny. Body ve vrstvě Skrytá voda ukazují interpolovanou výšku vody pod stávajícími mosty. To, že jsou výšky interpolovány, znamená, že jsou vypočteny výšky z okolních známých výšek. Známé výšky jsou nasyceny kolem mostů. Mřížkové body pro vodu jsou založeny na výškách a rozložení vodních ploch v základní mapě.Přesnost ve výšce je 9 cm nebo lepší pro tvrdé povrchy a 15 cm nebo lepší pro jiné povrchy. V rovinách je přesnost 15 cm nebo lepší."},{"@language":"da-t-sv-t0-mtec","@value":"Højdedata, 1 meter gitter. De koordinerede og forhøjede punkter i netfilen er baseret på data fra luftbåren laserscanning over Stockholm by i perioden 28. april-8. maj 2021 og interpoleret til et net med en opløsning på 1 m. Punkttætheden i den oprindelige punktsky er mindst 16 punkter/m2 på jorden. Emnerne er ikke blevet opdateret, siden de blev oprettet. Det betyder, at for områder, hvor jorden har ændret sig siden scanningen, stemmer punkternes koordinater ikke overens. Detaljer som bygninger, vandoverflader og kystlinjer, kaj- og brobeslag fra basiskortet bruges til at forbedre kvaliteten af nettet.Punkterne i det skjulte jordlag viser den interpolerede jordhøjde under eksisterende bygninger. At højderne er interpoleret betyder, at de er beregnet højder fra omgivende kendte højder. De kendte højder er mættet omkring bygningen. Punkterne i Hidden Water-laget viser den interpolerede vandhøjde under eksisterende broer. At højderne er interpoleret betyder, at de er beregnet højder fra omgivende kendte højder. De kendte højder er mættet omkring broerne. Gitterpunkter for vand er baseret på højder og fordeling af vandoverflader i basiskortet.Nøjagtigheden i højden er 9 cm eller bedre for hårde overflader og 15 cm eller bedre for andre overflader. I fly er nøjagtigheden 15 cm eller bedre."},{"@language":"de-t-sv-t0-mtec","@value":"Höhendaten, 1 Meter Raster. Die koordinierten und erhöhten Punkte in der Rasterdatei basieren auf Daten aus dem luftgestützten Laserscanning über der Stadt Stockholm im Zeitraum vom 28. April bis 8. Mai 2021 und werden auf ein Raster mit einer Auflösung von 1 m interpoliert. Die Punktdichte in der ursprünglichen Punktwolke beträgt mindestens 16 Punkte/m2 am Boden. Die Elemente wurden seit ihrer Erstellung nicht aktualisiert. Das bedeutet, dass für Bereiche, in denen sich der Boden seit dem Scan verändert hat, die Koordinaten der Punkte nicht übereinstimmen. Details wie Gebäude, Wasserflächen und Küstenlinien, Kai- und Brückenberge aus der Basiskarte werden verwendet, um die Qualität des Gitters zu verbessern.Die Elemente in der Hidden Ground-Schicht zeigen die interpolierte Bodenhöhe unter bestehenden Gebäuden. Dass die Höhen interpoliert werden, bedeutet, dass sie aus den umliegenden bekannten Höhen berechnet werden. Die bekannten Höhen sind rund um das Gebäude gesättigt. Die Punkte in der Versteckten Wasserschicht zeigen die interpolierte Wasserhöhe unter bestehenden Brücken. Dass die Höhen interpoliert werden, bedeutet, dass sie aus den umliegenden bekannten Höhen berechnet werden. Die bekannten Höhen sind rund um die Brücken gesättigt. Gitterpunkte für Wasser basieren auf Höhen und Verteilung der Wasseroberflächen in der Grundkarte.Die Genauigkeit in der Höhe beträgt 9 cm oder besser für harte Oberflächen und 15 cm oder besser für andere Oberflächen. In Flugzeugen beträgt die Genauigkeit 15 cm oder besser."},{"@language":"el-t-sv-t0-mtec","@value":"Δεδομένα υψομέτρου, πλέγμα 1 μέτρου. Τα συντονισμένα και υπερυψωμένα σημεία στο αρχείο πλέγματος βασίζονται σε δεδομένα από αερομεταφερόμενη σάρωση με λέιζερ πάνω από την πόλη της Στοκχόλμης κατά την περίοδο 28 Απριλίου - 8 Μαΐου 2021 και παρεμβάλλονται σε πλέγμα με ανάλυση 1 m. Η πυκνότητα των σημείων στο αρχικό νέφος σημείων είναι τουλάχιστον 16 σημεία/m2 στο έδαφος. Τα στοιχεία δεν έχουν επικαιροποιηθεί από τότε που δημιουργήθηκαν. Αυτό σημαίνει ότι για περιοχές όπου το έδαφος έχει αλλάξει από τη σάρωση, οι συντεταγμένες των σημείων δεν ταιριάζουν. Λεπτομέρειες όπως κτίρια, υδάτινες επιφάνειες και ακτογραμμές, βάσεις αποβάθρας και γέφυρας από τον βασικό χάρτη χρησιμοποιούνται για τη βελτίωση της ποιότητας του πλέγματος. Το ότι τα ύψη παρεμβάλλονται σημαίνει ότι είναι υπολογισμένα ύψη από τα γύρω γνωστά ύψη. Τα γνωστά ύψη είναι κορεσμένα γύρω από το κτίριο. Τα σημεία στο στρώμα του Κρυμμένου Νερού δείχνουν το παρεμβαλλόμενο ύψος του νερού κάτω από τις υπάρχουσες γέφυρες. Το ότι τα ύψη παρεμβάλλονται σημαίνει ότι είναι υπολογισμένα ύψη από τα γύρω γνωστά ύψη. Τα γνωστά ύψη είναι κορεσμένα γύρω από τις γέφυρες. Τα σημεία πλέγματος για το νερό βασίζονται στα ύψη και την κατανομή των επιφανειών νερού στο βασικό χάρτη.Η ακρίβεια στο ύψος είναι 9 cm ή καλύτερη για σκληρές επιφάνειες και 15 cm ή καλύτερη για άλλες επιφάνειες. Στα αεροπλάνα, η ακρίβεια είναι 15 cm ή καλύτερη."},{"@language":"en-t-sv-t0-mtec","@value":"Altitude data, 1 meter grid. The coordinated and elevated points in the grid file are based on data from airborne laser scanning over the City of Stockholm during the period 28 April - 8 May 2021 and interpolated to a grid with a resolution of 1 m. The point density in the original point cloud is at least 16 points/m2 on the ground. The items have not been updated since they were created. This means that for areas where the soil has changed since the scan, the coordinates of the points do not match. Details such as buildings, water surfaces and shorelines, quay and bridge mounts from the base map are used to improve the quality of the grid.The items in the Hidden Ground layer show the interpolated ground height under existing buildings. That the heights are interpolated means that they are calculated heights from surrounding known heights. The known heights are saturated around the building. The points in the Hidden Water layer show the interpolated water height under existing bridges. That the heights are interpolated means that they are calculated heights from surrounding known heights. The known heights are saturated around the bridges. Grid points for water are based on heights and distribution of water surfaces in the base map.The accuracy in height is 9 cm or better for hard surfaces and 15 cm or better for other surfaces. In planes, the accuracy is 15 cm or better."},{"@language":"es-t-sv-t0-mtec","@value":"Datos de altitud, cuadrícula de 1 metro. Los puntos coordinados y elevados del archivo de cuadrícula se basan en datos del escaneo láser aéreo sobre la ciudad de Estocolmo durante el período comprendido entre el 28 de abril y el 8 de mayo de 2021 e interpolados a una cuadrícula con una resolución de 1 m. La densidad de puntos en la nube de puntos original es de al menos 16 puntos/m2 en el suelo. Los elementos no se han actualizado desde que se crearon. Esto significa que para las áreas donde el suelo ha cambiado desde el escaneo, las coordenadas de los puntos no coinciden. Detalles como edificios, superficies de agua y costas, muelles y soportes de puentes del mapa base se utilizan para mejorar la calidad de la rejilla.Los elementos de la capa de tierra oculta muestran la altura del suelo interpolado debajo de los edificios existentes. Que las alturas estén interpoladas significa que son alturas calculadas a partir de las alturas conocidas circundantes. Las alturas conocidas están saturadas alrededor del edificio. Los puntos en la capa de agua oculta muestran la altura del agua interpolada debajo de los puentes existentes. Que las alturas estén interpoladas significa que son alturas calculadas a partir de las alturas conocidas circundantes. Las alturas conocidas están saturadas alrededor de los puentes. Los puntos de rejilla para el agua se basan en las alturas y la distribución de las superficies de agua en el mapa base. En los planos, la precisión es de 15 cm o mejor."},{"@language":"et-t-sv-t0-mtec","@value":"Kõrgusandmed, 1 meetrine võrk. Võrgufailis olevad koordineeritud ja kõrgemad punktid põhinevad ajavahemikul 28. aprillist kuni 8. maini 2021 Stockholmi linna kohal õhus tehtud laserskaneerimise andmetel ning on interpoleeritud 1 m eraldusvõimega võrku. Algse punktpilve punkttihedus on maapinnal vähemalt 16 punkti/m2. Esemeid ei ole nende loomisest saadik uuendatud. See tähendab, et piirkondades, kus muld on pärast skaneerimist muutunud, ei vasta punktide koordinaadid. Võrgu kvaliteedi parandamiseks kasutatakse selliseid detaile nagu ehitised, veepinnad ja kaldajooned, kai- ja sillaalused baaskaardilt. See, et kõrgused on interpoleeritud, tähendab, et need arvutatakse ümbritsevate teadaolevate kõrguste põhjal. Teadaolevad kõrgused on hoone ümber küllastunud. Varjatud vee kihi punktid näitavad interpoleeritud vee kõrgust olemasolevate sildade all. See, et kõrgused on interpoleeritud, tähendab, et need arvutatakse ümbritsevate teadaolevate kõrguste põhjal. Teadaolevad kõrgused on sillade ümber küllastunud. Veevõrgu punktid põhinevad aluskaardil olevate veepindade kõrgusel ja jaotusel.Kõrguse täpsus on kõvadel pindadel 9 cm või parem ja muudel pindadel 15 cm või parem. Lennukites on täpsus 15 cm või parem."},{"@language":"fi-t-sv-t0-mtec","@value":"Korkeustiedot, 1 metrin ruudukko. Koordinoidut ja korotetut pisteet ruudukkotiedostossa perustuvat Tukholman kaupungin yllä 28.4.–8.5.2021 tehdystä laserkeilauksesta saatuihin tietoihin, ja ne interpoloidaan ruudukkoon, jonka resoluutio on 1 m. Alkuperäisen pistepilven pistetiheys maassa on vähintään 16 pistettä/m2. Kohteita ei ole päivitetty niiden luomisen jälkeen. Tämä tarkoittaa, että alueilla, joilla maaperä on muuttunut skannauksen jälkeen, pisteiden koordinaatit eivät vastaa toisiaan. Tiedot, kuten rakennukset, vesipinnat ja rantaviivat, laituri- ja siltakiinnikkeet peruskartasta, käytetään parantamaan verkon laatua.Piilotettu maa -kerroksen kohteissa esitetään interpoloitu maankorkeus olemassa olevien rakennusten alla. Se, että korkeudet interpoloidaan, tarkoittaa, että ne lasketaan ympäröivistä tunnetuista korkeuksista. Tunnetut korkeudet ovat kylläisiä rakennuksen ympärillä. Piilotetun veden kerroksen pisteet osoittavat interpoloidun veden korkeuden olemassa olevien siltojen alla. Se, että korkeudet interpoloidaan, tarkoittaa, että ne lasketaan ympäröivistä tunnetuista korkeuksista. Tunnetut korkeudet ovat kyllästettyjä siltojen ympärillä. Veden ruudukkopisteet perustuvat pohjakartan veden pintojen korkeuteen ja jakautumiseen.Kovien pintojen korkeuden tarkkuus on 9 cm tai parempi ja muiden pintojen 15 cm tai parempi. Lentokoneissa tarkkuus on 15 cm tai parempi."},{"@language":"fr-t-sv-t0-mtec","@value":"Données d'altitude, grille de 1 mètre. Les points coordonnés et élevés du fichier de grille sont basés sur les données du balayage laser aérien au-dessus de la ville de Stockholm au cours de la période du 28 avril au 8 mai 2021 et interpolés sur une grille d’une résolution de 1 m. La densité de points dans le nuage de points d’origine est d’au moins 16 points/m2 au sol. Les éléments n'ont pas été mis à jour depuis leur création. Cela signifie que pour les zones où le sol a changé depuis le balayage, les coordonnées des points ne correspondent pas. Des détails tels que les bâtiments, les surfaces d'eau et les rives, les supports de quai et de pont de la carte de base sont utilisés pour améliorer la qualité de la grille.Les éléments de la couche de sol caché montrent la hauteur de sol interpolée sous les bâtiments existants. Le fait que les hauteurs soient interpolées signifie qu'elles sont calculées à partir des hauteurs connues environnantes. Les hauteurs connues sont saturées autour du bâtiment. Les points de la couche d'eau cachée montrent la hauteur d'eau interpolée sous les ponts existants. Le fait que les hauteurs soient interpolées signifie qu'elles sont calculées à partir des hauteurs connues environnantes. Les hauteurs connues sont saturées autour des ponts. Les points de grille pour l'eau sont basés sur les hauteurs et la répartition des surfaces d'eau dans la carte de base.La précision en hauteur est de 9 cm ou mieux pour les surfaces dures et de 15 cm ou mieux pour les autres surfaces. Dans les avions, la précision est de 15 cm ou mieux."},{"@language":"ga-t-sv-t0-mtec","@value":"Sonraí airde, greille 1 mhéadar. Tá na pointí comhordaithe agus ardaithe sa chomhad greille bunaithe ar shonraí ó scanadh léasair aerbheirthe thar Chathair Stócólm le linn na tréimhse 28 Aibreán - 8 Bealtaine 2021 agus idirshuitear iad chuig greille le taifeach 1 m. Tá dlús an phointe sa scamall pointe bunaidh 16 phointe/m2 ar a laghad ar an talamh. Níor nuashonraíodh na míreanna ó cruthaíodh iad. Ciallaíonn sé sin, i gcás limistéir ina bhfuil athrú tagtha ar an ithir ó rinneadh an scanadh, nach bhfuil comhordanáidí na bpointí ag teacht le chéile. Úsáidtear sonraí cosúil le foirgnimh, dromchlaí uisce agus línte cladaigh, feistí cé agus droichid ón mbunmhapa chun cáilíocht na greille a fheabhsú. Ciallaíonn go bhfuil na hairdí idirshuite go ndéantar airde a ríomh ó na hairdí aitheanta máguaird. Tá na hairdí aitheanta sáithithe timpeall an fhoirgnimh. Taispeánann na pointí sa chiseal Uisce Hidden an airde uisce idirshuite faoi dhroichid atá ann cheana. Ciallaíonn go bhfuil na hairdí idirshuite go ndéantar airde a ríomh ó na hairdí aitheanta máguaird. Tá na hairdí aitheanta sáithithe timpeall na ndroichead. Tá pointí eangaí le haghaidh uisce bunaithe ar airde agus dáileadh dromchlaí uisce sa bhunmhapa.Tá cruinneas 9 cm nó níos fearr ar airde do dhromchlaí crua agus 15 cm nó níos fearr do dhromchlaí eile. I bplánaí, tá an cruinneas 15 cm nó níos fearr."},{"@language":"hr-t-sv-t0-mtec","@value":"Podaci o nadmorskoj visini, mreža od 1 metra. Koordinirane i povišene točke u datoteci mreže temelje se na podacima iz laserskog skeniranja u zraku iznad grada Stockholma u razdoblju od 28. travnja do 8. svibnja 2021. i interpoliraju se na mrežu s rezolucijom od 1 m. Gustoća točke u izvornom oblaku točke iznosi najmanje 16 točaka/m2 na tlu. Stavke nisu ažurirane od njihova stvaranja. To znači da se za područja na kojima se tlo promijenilo od skeniranja koordinate točaka ne podudaraju. Pojedinosti kao što su zgrade, vodene površine i obale, pristaništa i nosači mostova s osnovne karte koriste se za poboljšanje kvalitete mreže. Da su visine interpolirane znači da su izračunate visine iz okolnih poznatih visina. Poznate visine su zasićene oko zgrade. Točke u sloju Skrivene vode prikazuju interpoliranu visinu vode ispod postojećih mostova. Da su visine interpolirane znači da su izračunate visine iz okolnih poznatih visina. Poznate visine su zasićene oko mostova. Mrežne točke za vodu temelje se na visinama i raspodjeli vodenih površina u osnovnoj karti.Točnost u visini je 9 cm ili bolje za tvrde površine i 15 cm ili bolje za druge površine. U ravninama, točnost je 15 cm ili bolja."},{"@language":"hu-t-sv-t0-mtec","@value":"Magassági adatok, 1 méteres rács. A hálózati fájl összehangolt és emelt pontjai a Stockholm városa felett 2021. április 28. és május 8. között végzett, levegőben végzett lézeres szkennelésből származó adatokon alapulnak, és 1 m felbontású rácsra interpolálódnak. Az eredeti pontfelhőben a pontsűrűség legalább 16 pont/m2 a földön. Az elemeket létrehozásuk óta nem frissítették. Ez azt jelenti, hogy azokon a területeken, ahol a talaj megváltozott a szkennelés óta, a pontok koordinátái nem egyeznek. Az olyan részletek, mint az épületek, a vízfelületek és a partvonalak, a rakpart és a hídszerkezetek az alaptérképről a rács minőségének javítására szolgálnak. A magasságok interpolációja azt jelenti, hogy a környező ismert magasságokból számított magasságok. Az ismert magasságok telítettek az épület körül. A rejtett vízréteg pontjai a meglévő hidak alatti interpolált vízmagasságot mutatják. A magasságok interpolációja azt jelenti, hogy a környező ismert magasságokból számított magasságok. Az ismert magasságok telítettek a hidak körül. A vízrács pontjai az alaptérképen szereplő vízfelületek magasságán és eloszlásán alapulnak. Repülőgépeken a pontosság 15 cm vagy annál jobb."},{"@language":"it-t-sv-t0-mtec","@value":"Dati di altitudine, griglia di 1 metro. I punti coordinati ed elevati nel file della griglia si basano sui dati della scansione laser in volo sulla città di Stoccolma nel periodo 28 aprile - 8 maggio 2021 e sono interpolati su una griglia con una risoluzione di 1 m. La densità dei punti nella nuvola di punti originale è di almeno 16 punti / m2 a terra. Gli elementi non sono stati aggiornati da quando sono stati creati. Ciò significa che per le aree in cui il terreno è cambiato dopo la scansione, le coordinate dei punti non corrispondono. Dettagli come edifici, superfici d'acqua e litorali, montaggi di banchina e ponte dalla mappa di base vengono utilizzati per migliorare la qualità della griglia. Che le altezze siano interpolate significa che sono altezze calcolate dalle altezze conosciute circostanti. Le altezze conosciute sono sature intorno all'edificio. I punti nello strato di acqua nascosta mostrano l'altezza dell'acqua interpolata sotto i ponti esistenti. Che le altezze siano interpolate significa che sono altezze calcolate dalle altezze conosciute circostanti. Le altezze conosciute sono sature intorno ai ponti. I punti della griglia per l'acqua si basano sulle altezze e sulla distribuzione delle superfici dell'acqua nella mappa di base. Negli aerei, la precisione è di 15 cm o superiore."},{"@language":"lt-t-sv-t0-mtec","@value":"Aukščio duomenys, 1 metro tinklelis. Koordinuoti ir padidinti tinklelio failo taškai grindžiami 2021 m. balandžio 28 d. – gegužės 8 d. Stokholmo miesto lazerinio skenavimo ore duomenimis ir interpoliuojami į 1 m skiriamosios gebos tinklelį. Taškų tankis pradiniame taškiniame debesyje yra bent 16 taškų/m2 ant žemės. Elementai nebuvo atnaujinti nuo tada, kai jie buvo sukurti. Tai reiškia, kad vietovėse, kuriose dirvožemis pasikeitė po nuskaitymo, taškų koordinatės nesutampa. Tinklelio kokybei pagerinti naudojami pagrindinio žemėlapio duomenys, pvz., pastatai, vandens paviršiai ir krantinės, krantinės ir tiltų laikikliai. Paslėpto grunto sluoksnio elementai rodo interpoliuotą žemės aukštį po esamais pastatais. Tai, kad aukščiai yra interpoliuoti, reiškia, kad jie apskaičiuojami pagal aplinkinius žinomus aukščius. Žinomos aukščio yra prisotintos aplink pastatą. Paslėpto vandens sluoksnio taškai rodo interpoliuotą vandens aukštį po esamais tiltais. Tai, kad aukščiai yra interpoliuoti, reiškia, kad jie apskaičiuojami pagal aplinkinius žinomus aukščius. Žinomos aukštumos yra prisotintos aplink tiltus. Vandens tinklelio taškai grindžiami aukščiu ir vandens paviršių pasiskirstymu pagrindiniame žemėlapyje.Aukščio tikslumas kietiems paviršiams yra 9 cm arba didesnis, o kitiems paviršiams - 15 cm arba didesnis. Plokštėse tikslumas yra 15 cm arba didesnis."},{"@language":"lv-t-sv-t0-mtec","@value":"Augstuma dati, 1 metra režģis. Koordinētie un paaugstinātie punkti režģa failā ir balstīti uz datiem no lāzera skenēšanas gaisā Stokholmas pilsētā laikposmā no 2021. gada 28. aprīļa līdz 8. maijam un interpolēti uz režģi ar izšķirtspēju 1 m. Punktu blīvums sākotnējā punktu mākonī ir vismaz 16 punkti/m2 uz zemes. Vienumi nav atjaunināti kopš to izveides. Tas nozīmē, ka apgabalos, kur augsne kopš skenēšanas ir mainījusies, punktu koordinātas nesakrīt. Lai uzlabotu režģa kvalitāti, tiek izmantotas tādas detaļas kā ēkas, ūdens virsmas un krasta līnijas, piestātnes un tiltu stiprinājumi no pamatkartes. Tas, ka augstumi ir interpolēti, nozīmē, ka tos aprēķina no apkārtējiem zināmajiem augstumiem. Zināmie augstumi ir piesātināti ap ēku. Slēptā ūdens slāņa punkti parāda interpolēto ūdens augstumu zem esošajiem tiltiem. Tas, ka augstumi ir interpolēti, nozīmē, ka tos aprēķina no apkārtējiem zināmajiem augstumiem. Zināmie augstumi ir piesātināti ap tiltiem. Ūdens režģa punkti ir balstīti uz ūdens virsmu augstumu un sadalījumu bāzes kartē.Augstuma precizitāte ir 9 cm vai labāka cietām virsmām un 15 cm vai labāka citām virsmām. Lidmašīnās precizitāte ir 15 cm vai labāka."},{"@language":"mt-t-sv-t0-mtec","@value":"Data dwar l-altitudni, grilja ta' metru. Il-punti kkoordinati u elevati fil-fajl tal-grilja huma bbażati fuq data minn skennjar bil-laser fl-ajru fuq il-Belt ta 'Stokkolma matul il-perjodu 28 April - 8 Mejju 2021 u interpolati għal grilja b'riżoluzzjoni ta' 1 m. Id-densità tal-punt fis-sħab tal-punt oriġinali hija mill-inqas 16-il punt / m2 fuq l-art. Il-punti ma ġewx aġġornati minn meta nħolqu. Dan ifisser li għal żoni fejn il-ħamrija nbidlet mill-iskannjar, il-koordinati tal-punti ma jaqblux. Dettalji bħal bini, uċuħ tal-ilma u x-xtut, muntaturi tal-moll u tal-pontijiet mill-mappa bażi jintużaw biex itejbu l-kwalità tal-grilja. L-oġġetti fis-saff tal-Art Moħbija juru l-għoli tal-art interpolat taħt bini eżistenti. Li l-għoli jiġi interpolat ifisser li jiġi kkalkulat l-għoli mill-għoli magħruf tal-madwar. L-għoli magħruf huwa saturat madwar il-bini. Il-punti fis-saff tal-Ilma Moħbija juru l-għoli tal-ilma interpolat taħt il-pontijiet eżistenti. Li l-għoli jiġi interpolat ifisser li jiġi kkalkulat l-għoli mill-għoli magħruf tal-madwar. L-għoli magħruf huwa saturat madwar il-pontijiet. Il-punti tal-grilja għall-ilma huma bbażati fuq l-għoli u d-distribuzzjoni tal-uċuħ tal-ilma fil-mappa bażi. L-akkuratezza fl-għoli hija 9 cm jew aħjar għal uċuħ ibsin u 15 cm jew aħjar għal uċuħ oħra. Fil-pjan, il-preċiżjoni hija 15 cm jew aħjar."},{"@language":"nl-t-sv-t0-mtec","@value":"Hoogtegegevens, 1 meter raster. De gecoördineerde en verhoogde punten in het rasterbestand zijn gebaseerd op gegevens van laserscanning in de lucht boven de stad Stockholm in de periode 28 april - 8 mei 2021 en geïnterpoleerd naar een raster met een resolutie van 1 m. De puntdichtheid in de oorspronkelijke puntwolk bedraagt ten minste 16 punten/m2 op de grond. De items zijn niet bijgewerkt sinds ze zijn gemaakt. Dit betekent dat voor gebieden waar de bodem is veranderd sinds de scan, de coördinaten van de punten niet overeenkomen. Details zoals gebouwen, wateroppervlakken en kustlijnen, kade- en brugsteunen van de basiskaart worden gebruikt om de kwaliteit van het raster te verbeteren.De items in de verborgen grondlaag tonen de geïnterpoleerde grondhoogte onder bestaande gebouwen. Dat de hoogten geïnterpoleerd zijn, betekent dat ze berekend zijn op basis van de omringende bekende hoogten. De bekende hoogtes zijn verzadigd rond het gebouw. De punten in de laag Verborgen Water tonen de geïnterpoleerde waterhoogte onder bestaande bruggen. Dat de hoogten geïnterpoleerd zijn, betekent dat ze berekend zijn op basis van de omringende bekende hoogten. De bekende hoogtes zijn verzadigd rond de bruggen. Netpunten voor water zijn gebaseerd op hoogtes en verdeling van wateroppervlakken in de basiskaart.De nauwkeurigheid in hoogte is 9 cm of beter voor harde oppervlakken en 15 cm of beter voor andere oppervlakken. In vliegtuigen is de nauwkeurigheid 15 cm of beter."},{"@language":"pl-t-sv-t0-mtec","@value":"Dane wysokościowe, siatka 1 metrowa. Skoordynowane i podwyższone punkty w pliku siatki opierają się na danych z lotniczego skanowania laserowego nad miastem Sztokholm w okresie od 28 kwietnia do 8 maja 2021 r. i są interpolowane do siatki o rozdzielczości 1 m. Gęstość punktów w pierwotnej chmurze punktów wynosi co najmniej 16 punktów/m2 na ziemi. Elementy nie były aktualizowane od czasu ich utworzenia. Oznacza to, że w przypadku obszarów, w których gleba zmieniła się od czasu skanowania, współrzędne punktów nie są zgodne. Szczegóły, takie jak budynki, powierzchnie wody i linie brzegowe, nabrzeża i mocowania mostów z mapy bazowej są wykorzystywane do poprawy jakości siatki. To, że wysokości są interpolowane, oznacza, że są one obliczane na podstawie okolicznych znanych wysokości. Znane wysokości są nasycone wokół budynku. Punkty w warstwie ukrytej wody pokazują interpolowaną wysokość wody pod istniejącymi mostami. To, że wysokości są interpolowane, oznacza, że są one obliczane na podstawie okolicznych znanych wysokości. Znane wysokości są nasycone wokół mostów. Punkty siatki dla wody są oparte na wysokościach i rozmieszczeniu powierzchni wody na mapie bazowej.Dokładność wysokości wynosi 9 cm lub lepiej dla twardych powierzchni i 15 cm lub lepiej dla innych powierzchni. W samolotach dokładność wynosi 15 cm lub więcej."},{"@language":"pt-t-sv-t0-mtec","@value":"Dados de altitude, grelha de 1 metro. Os pontos coordenados e elevados no ficheiro da grelha baseiam-se em dados de varrimento a laser aéreo sobre a cidade de Estocolmo durante o período de 28 de abril a 8 de maio de 2021 e são interpolados para uma grelha com uma resolução de 1 m. A densidade de pontos na nuvem de pontos original é de, pelo menos, 16 pontos/m2 no solo. Os itens não foram atualizados desde que foram criados. Isso significa que, para áreas onde o solo mudou desde a varredura, as coordenadas dos pontos não coincidem. Detalhes como edifícios, superfícies de água e linhas de costa, montes de cais e pontes do mapa base são usados para melhorar a qualidade da grade.Os itens na camada de solo oculto mostram a altura do solo interpolada sob os edifícios existentes. Que as alturas são interpoladas significa que são alturas calculadas a partir de alturas conhecidas circundantes. As alturas conhecidas estão saturadas em torno do edifício. Os pontos na camada de Água Oculta mostram a altura interpolada da água sob as pontes existentes. Que as alturas são interpoladas significa que são alturas calculadas a partir de alturas conhecidas circundantes. As alturas conhecidas estão saturadas em torno das pontes. Os pontos de grade para a água são baseados em alturas e distribuição de superfícies de água no mapa base.A precisão na altura é de 9 cm ou melhor para superfícies duras e 15 cm ou melhor para outras superfícies. Em aviões, a precisão é de 15 cm ou melhor."},{"@language":"ro-t-sv-t0-mtec","@value":"Date despre altitudine, grila de 1 metru. Punctele coordonate și ridicate din fișierul grilă se bazează pe datele obținute prin scanarea cu laser în aer deasupra orașului Stockholm în perioada 28 aprilie-8 mai 2021 și sunt interpolate la o grilă cu o rezoluție de 1 m. Densitatea punctelor din norul inițial de puncte este de cel puțin 16 puncte/m2 la sol. Elementele nu au fost actualizate de când au fost create. Aceasta înseamnă că pentru zonele în care solul s-a schimbat de la scanare, coordonatele punctelor nu se potrivesc. Detalii precum clădirile, suprafețele de apă și țărmurile, suporturile pentru cheiuri și poduri de pe harta de bază sunt utilizate pentru a îmbunătăți calitatea rețelei. Faptul că înălțimile sunt interpolate înseamnă că acestea sunt calculate de la înălțimile cunoscute din jur. Înălțimile cunoscute sunt saturate în jurul clădirii. Punctele din stratul de apă ascunsă arată înălțimea interpolată a apei sub podurile existente. Faptul că înălțimile sunt interpolate înseamnă că acestea sunt calculate de la înălțimile cunoscute din jur. Înălțimile cunoscute sunt saturate în jurul podurilor. Punctele de rețea pentru apă se bazează pe înălțimile și distribuția suprafețelor de apă în harta de bază.Acuratețea în înălțime este de 9 cm sau mai bună pentru suprafețele dure și de 15 cm sau mai bună pentru alte suprafețe. În avioane, precizia este de 15 cm sau mai bună."},{"@language":"sk-t-sv-t0-mtec","@value":"Údaje o nadmorskej výške, 1 mriežka. Koordinované a zvýšené body v súbore mriežky sú založené na údajoch z leteckého laserového skenovania nad mestom Štokholm v období od 28. apríla do 8. mája 2021 a interpolované do mriežky s rozlíšením 1 m. Hustota bodu v pôvodnom bodovom oblaku je najmenej 16 bodov/m2 na zemi. Položky neboli aktualizované od ich vytvorenia. To znamená, že v oblastiach, kde sa pôda od skenovania zmenila, sa súradnice bodov nezhodujú. Podrobnosti, ako sú budovy, vodné plochy a pobrežia, prístavné hrádze a mosty zo základnej mapy, sa používajú na zlepšenie kvality mriežky. To, že výšky sú interpolované znamená, že sú vypočítané výšky z okolitých známych výšok. Známe výšky sú nasýtené okolo budovy. Body vo vrstve skrytej vody znázorňujú interpolovanú výšku vody pod existujúcimi mostami. To, že výšky sú interpolované znamená, že sú vypočítané výšky z okolitých známych výšok. Známe výšky sú nasýtené okolo mostov. Mriežkové body pre vodu sú založené na výškach a rozložení vodných plôch v základnej mape.Presnosť výšky je 9 cm alebo lepšia pre tvrdé povrchy a 15 cm alebo lepšia pre iné povrchy. V lietadlách je presnosť 15 cm alebo lepšia."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatki o nadmorski višini, 1-metrska mreža. Usklajene in povišane točke v mrežni datoteki temeljijo na podatkih iz laserskega skeniranja v zraku nad mestom Stockholm v obdobju od 28. aprila do 8. maja 2021 in so interpolirane v mrežo z ločljivostjo 1 m. Gostota točk v prvotnem oblaku točk je vsaj 16 točk/m2 na tleh. Elementi niso bili posodobljeni, odkar so bili ustvarjeni. To pomeni, da se za območja, kjer so se tla od skeniranja spremenila, koordinate točk ne ujemajo. Podrobnosti, kot so stavbe, vodne površine in obale, pomoli in mostni nosilci iz osnovnega zemljevida, se uporabljajo za izboljšanje kakovosti omrežja. To, da so višine interpolirane, pomeni, da so izračunane višine iz okoliških znanih višin. Znane višine so nasičene okoli stavbe. Točke v sloju skrite vode prikazujejo interpolirano višino vode pod obstoječimi mostovi. To, da so višine interpolirane, pomeni, da so izračunane višine iz okoliških znanih višin. Znane višine so nasičene okoli mostov. Omrežne točke za vodo temeljijo na višini in porazdelitvi vodnih površin na osnovnem zemljevidu.Natančnost višine je 9 cm ali boljša za trde površine in 15 cm ali boljša za druge površine. V ravninah je natančnost 15 cm ali boljša."},{"@language":"sv","@value":"Höjddata, 1 meters grid. De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 28 april - 8 maj 2021 och interpolerat till ett grid med upplösning 1 m. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna har inte ajourförts sedan de skapades. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Detaljer som byggnader, vattenytor och strandlinjer, kaj och brofästen från baskartan används för att förbättra kvaliteten i gridet.Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom byggnaden. Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. Att höjderna är interpolerade innebär att de är framräknade höjder från omkringliggande kända höjder. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan.Noggrannheten i höjd är 9 cm eller bättre för hårda ytor och 15 cm eller bättre för övriga ytor. I plan är noggrannheten 15 cm eller bättre."},{"@language":"uk-t-sv-t0-mtec","@value":"Дані про висоту, сітка 1 метр. Координовані та підвищені точки у файлі сітки базуються на даних повітряного лазерного сканування над містом Стокгольм протягом періоду 28 квітня - 8 травня 2021 року та інтерполюються в сітку з роздільною здатністю 1 м. Елементи не оновлювалися з моменту їх створення. Це означає, що для ділянок, де ґрунт змінився з моменту сканування, координати точок не збігаються. Такі деталі, як будівлі, водні поверхні та берегові лінії, набережні та мостові кріплення з базової карти використовуються для покращення якості сітки. Те, що висоти інтерполюються, означає, що вони обчислюються висотами з навколишніх відомих висот. Відомі висоти насичені навколо будівлі. Точки в шарі Прихована вода показують інтерпольовану висоту води під існуючими мостами. Те, що висоти інтерполюються, означає, що вони обчислюються висотами з навколишніх відомих висот. Відомі висоти насичені навколо мостів. Точки сітки для води засновані на висоті і розподілі водних поверхонь в основі map.The точність по висоті 9 см або краще для твердих поверхонь і 15 см або краще для інших поверхонь. У площинах точність становить 15 см або краще."}],"dct:identifier":"73302594-7333-463d-a70d-717c0aa73426","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b0n0"},"dct:temporal":{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Höggrid (2021 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Höggrid (2021) (στα Αγγλικά)."},{"@language":"en-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Höggrid (2021.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Höggrid (2021 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"},{"@language":"sv","@value":"SBK Höjdgrid (2021)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Höggrid (2021)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/record/73302594-7333-463d-a70d-717c0aa73426","@type":"dcat:CatalogRecord","dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"73302594-7333-463d-a70d-717c0aa73426","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:05Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/73302594-7333-463d-a70d-717c0aa73426"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30_b2n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/73302594-7333-463d-a70d-717c0aa73426"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-13T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-06T18:03:00Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"73302594-7333-463d-a70d-717c0aa73426","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/73302594-7333-463d-a70d-717c0aa73426"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cb6d967656d463d14adb35c1f01d186538b3e52215d29a92d9bf01a232ce4d30"},{"@graph":[{"@id":"_:cb7f02e68edd94bc5dfff346b22188567a496125b5