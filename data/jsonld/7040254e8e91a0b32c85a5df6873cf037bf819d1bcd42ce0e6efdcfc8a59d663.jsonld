pe":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:b7d9aaaf9ee1fe7e879fb784b7fa96534e43099cf034b4084071eabc349dc8a0_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2029-04-08"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-04-08"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2029-04-08"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2024-04-08"}},{"@id":"https://resources.stockholm.se/data/6d433a6b-814d-4c93-a1c7-83a08a27cf9b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/6d433a6b-814d-4c93-a1c7-83a08a27cf9b#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/6d433a6b-814d-4c93-a1c7-83a08a27cf9b#HTTP:ESRI+Portal-URL/3"}],"dcat:keyword":["Stockholms stad - Miljöförvaltningen",{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Naturinventeringar"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5f31e00a-b12e-4a7e-91ad-7bb0c52ace27"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2022-06-01"},"dct:description":{"@language":"sv","@value":"Habitatnätverket för groddjur. Stockholms stad har bedrivit miljöövervakning och ekologisk kunskapsuppbyggnad under en längre tid, bland annat genom framtagandet av olika biotopdatabaser och habitatnätverk. Efter att Stockholms första biotopdatabas utvecklades i slutet av 90-talet tog staden, i samarbete med KTH, fram habitatnätverk för tre olika artgrupper: groddjur, barrskogsmesar och eklevande arter. Med tiden har fysiska förändringar uppstått och nya metoder tagits fram. Under 2021 utvecklades en ny biotopdatabas utifrån en modern framtagen metodik baserat på högupplösta data från 2019. Med den nya biotopdatabasen har nya habitatnätverk för de tre artgrupperna tagits fram i kombination med analyser av nätverkens konnektivitet. I stort sett samma fokusarter används i de nya habitatnätverken, men med en skillnad där det tidigare nätverket för eklevande arter nu även kompletterats med andra ädellövträd och ädellövskog. De nya analyserna ersätter de gamla habitatnätverken och möjliggör en effektiv miljöövervakning och en hållbar stadsutveckling."},"dct:identifier":"6d433a6b-814d-4c93-a1c7-83a08a27cf9b","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dct:spatial":{"@id":"_:b7d9aaaf9ee1fe7e879fb784b7fa96534e43099cf034b4084071eabc349dc8a0_b0n0"},"dct:temporal":{"@id":"_:b7d9aaaf9ee1fe7e879fb784b7fa96534e43099cf034b4084071eabc349dc8a0_b1n0"},"dct:title":{"@language":"sv","@value":"Habitatnätverk 2022 - Groddjur"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/6d433a6b-814d-4c93-a1c7-83a08a27cf9b#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/f602059b771441369723da8a442461af/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/6d433a6b-814d-4c93-a1c7-83a08a27cf9b#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:acce