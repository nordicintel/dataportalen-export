,"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64"},{"@id":"http://data.europa.eu/88u/distribution/a5bac006-a23e-4ec7-8e5d-75e84024ce51"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=59b72fb2-0588-4fda-88af-53d7772055bc"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"Stockholms stadsmuseum ansvarar för att peka ut och definiera kulturhistoriskt värdefull bebyggelse i Stockholms stad. Klassificeringen grundas på de inventeringar Stadsmuseet kontinuerligt gjort sedan 1970-talet och omfattar bebyggelse uppförd före 1960 eller 1990. Ställningstagandet om stadens kulturhistoriska klassificering fattas av Stadsmuseets chef, stadsantikvarien, på delegation av kommunfullmäktige. Klassificering av stadens bebyggelse är ett pågående arbete och nya klassificeringar förs in på den digitala kartan."},"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"2a64e957-9133-41b1-a101-05196d12df33","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@value":"Stadsmuseets kulturhistoriska klassifcieringskarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/83601a61-36fa-41c6-aab6-12d41b4e9f64","@type":"dcat:Distribution","dcat:accessURL":{"@