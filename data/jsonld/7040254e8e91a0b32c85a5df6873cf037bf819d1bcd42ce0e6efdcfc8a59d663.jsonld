engis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:8623cfbdac3ac5589e81dd22e964b6abefa7eb40ac141e09201e73b638f92ff4_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1101edaa4afbb7058f2971157264053142"},{"@id":"http://data.europa.eu/88u/dataset/0d843f7b-c6ca-46c3-9bf5-31bb17a8be57","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/d901df4a-dfc7-499e-a1cb-4d9ba1fb8f8a"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=232a7e04-2865-4838-a522-0b2a903a4c29"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта - Единичната площ се състои от следните подтипове (подтипове) при информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Регистрационна карта) :450040, Единична площ Подтипове10, Площ на имота, модифицирана20, Пространство на имота, модифицирана30, Притурка В, модифицирана40, Общност, модифицирана50, Пространство на имота, модифицирана"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registru - Jednotková oblast sestávala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz Obecná specifikace produktu Mapa registru) :450040, Jednotková oblast Podtypy10, Oblast vlastnictví, modifikovatelná20, Oblast vlastnictví, modifikovatelná30, Příloha C, modifikovatelná40, Komunita, modifikovatelná50, Oblast vlastnictví, modifikovatelná"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort — Enhedsområde bestod af følgende undertyper (undertyper) i klassificeringen af oplysninger 2020 (for den nuværende liste henvises til den generelle varespecifikation Registerkort) :450040, Enhedsområde Undertyper10, Ejendomsområde, modificerbar20, Ejendomsområde, modificerbar30, Tillæg C, modificerbar40, Fællesskab, modificerbar50, Ejendomsområde, modificerbar"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte - Gebiet der Einheit bestand aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Registerkarte) :450040, Gebiet der Einheit Untertypen10, Gebiet der Immobilie, veränderbar20, Grundstücksfläche, veränderbar30, Anlage C, veränderbar40, Gemeinschaft, veränderbar50, Grundstücksfläche, veränderbar"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Περιοχή μονάδας αποτελούμενη από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης μητρώου) :450040, Περιοχή μονάδας Υποτύποι10, Περιοχή ακινήτου, τροποποιήσιμη20, Χώρος ακινήτου, τροποποιήσιμη30, Συνημμένο Γ, τροποποιήσιμη40, Κοινότητα, τροποποιήσιμη50, Χώρος ακινήτου, τροποποιήσιμη"},{"@language":"en-t-sv-t0-mtec","@value":"Register map - Unit area consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification Register map) :450040, Unit area Subtypes10, Property area, modifiable20, Property space, modifiable30, Attachment C, modifiable40, Community, modifiable50, Property space, modifiable"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa del registro - El área de la unidad constaba de los siguientes subtipos (subtipos) en la clasificación de la información 2020 (para la lista actual, véase la especificación general del producto Mapa del registro): 450040, Área de la unidad Subtipos10, Área de la propiedad, modificable20, Espacio de la propiedad, modificable30, Adjunto C, modificable40, Comunidad, modificable50, Espacio de la propiedad, modificable"},{"@language":"et-t-sv-t0-mtec","@value":"Registrikaart – 2020. aasta teabeklassifikatsiooni üksuse pindala koosnes järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldise tootespetsifikaadi registrikaart):450040, üksuse pindala alatüübid10, kinnisvarapind, muudetav20, kinnisvarapind, muudetav30, liide C, muudetav40, kogukond, muudetav50, kinnisvarapind, muudetav"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta - Yksikköalue koostui seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyisestä luettelosta katso Yleiset tuote-eritelmät Rekisterikartta) :450040, Yksikköalue Alatyypit10, Kiinteistöalue, modifiable20, Kiinteistötila, modifiable30, Liite C, modifiable40, Yhteisö, modifiable50, Kiinteistötila, modifiable"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte du registre - La surface unitaire se composait des sous-types suivants (sous-types) à la classification d’information 2020 (pour la liste actuelle, voir le cahier des charges général du produit Carte du registre) :450040, Surface unitaire Sous-types10, Surface de propriété, modifiable20, Espace de propriété, modifiable30, Pièce jointe C, modifiable40, Communauté, modifiable50, Espace de propriété, modifiable"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil an chláir - Is éard a bhí sa limistéar aonaid na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach an tsonraíocht táirge Ghinearálta Léarscáil an Chláir) :450040, Limistéar aonaid Fochineálacha10, Limistéar maoine, inmhodhnaithe20, Spás maoine, inmhodhnaithe30, Ceangaltán C, inmhodhnaithe40, Pobal, inmhodhnaithe50, Spás maoine, inmhodhnaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta registra – Područje jedinice sastojalo se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Karta registra) :450040, Podvrste područja jedinice10, Područje nekretnina, promjenjivo20, Prostor nekretnina, promjenjivo30, Dodatak C, promjenjivo40, Zajednica, promjenjivo50, Prostor nekretnina, promjenjivo"},{"@language":"hu-t-sv-t0-mtec","@value":"Nyilvántartási térkép – Az egység területe a következő altípusokból (altípusokból) állt a 2020. évi információs osztályozási rendszerben (az aktuális listát lásd az általános termékleírásban) :450040, az egység területe 10. altípus, az ingatlan területe, módosítható20, az ingatlan területe, módosítható30, a C. függelék, módosítható40, közösségi, módosítható50, az ingatlan területe, módosítható"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa del registro - L'area dell'unità era costituita dai seguenti sottotipi (sottotipi) alla classificazione delle informazioni 2020 (per l'elenco attuale vedere il disciplinare generale Mappa del registro) :450040, Sottotipi dell'area dell'unità10, Area dell'immobile, modificabile20, Spazio dell'immobile, modificabile30, Allegato C, modificabile40, Comunità, modificabile50, Spazio dell'immobile, modificabile"},{"@language":"lt-t-sv-t0-mtec","@value":"Registro žemėlapis - Vieneto plotą sudarė šie potipiai (potipiai) 2020 m. informacijos klasifikacijoje (dabartinį sąrašą žr. Bendrosios produkto specifikacijos Registro žemėlapis):450040, Vieneto ploto potipiai10, Nekilnojamojo turto plotas, modifikuojamas20, Nekilnojamojo turto plotas, modifikuojamas30, Priedas C, modifikuojamas40, Bendruomenė, modifikuojamas50, Nekilnojamojo turto plotas, modifikuojamas"},{"@language":"lv-t-sv-t0-mtec","@value":"Reģistra karte – vienības platība sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu sk. Vispārīgajā produkta specifikācijā Reģistra karte) :450040, vienības platība apakštipi10, Īpašuma platība, modificējama20, Īpašuma platība, modificējama30, C papildinājums, modificējama40, Kopiena, modificējama50, Īpašuma platība, modificējama"},{"@language":"mt-t-sv-t0-mtec","@value":"- Unit area tal-mappa tar-reġistru kienet tikkonsisti fis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-mappa tar-Reġistru tal-Ispeċifikazzjoni Ġenerali tal-Prodott) :450040, Unit area Subtypes10, Property area, modificationifiable20, Property space, modificationifiable30, Hemża C, modificationifiable40, Community, modificationifiable50, Property space, modificationifiable30 (Żona tal-unità tas-sottotipi10, Żona tal-proprjetà, modifikabbli20, Spazju tal-proprjetà, modifikabbli30, Hemża C, modifikabbli40, Komunitarja, modifikabbli50, Spazju tal-proprjetà, modifikabbli)"},{"@language":"nl-t-sv-t0-mtec","@value":"Registerkaart - Eenheidsgebied bestond uit de volgende subtypen (subtypen) in de informatieclassificatie 2020 (voor de huidige lijst zie Algemene productspecificatie Registerkaart) :450040, Eenheidsgebied Subtypen10, Eigendomsgebied, aanpasbaar20, Eigendomsruimte, aanpasbaar30, Aanhangsel C, aanpasbaar40, Gemeenschap, aanpasbaar50, Eigendomsruimte, aanpasbaar"},{"@language":"pl-t-sv-t0-mtec","@value":"Zarejestruj mapę - Obszar jednostki składał się z następujących podtypów (podtypów) w klasyfikacji informacji 2020 (aktualny wykaz patrz Ogólna specyfikacja produktu Zarejestruj mapę) :450040, Obszar jednostki podtypy10, Obszar nieruchomości, modyfikowalny20, Przestrzeń nieruchomości, modyfikowalny30, Załącznik C, modyfikowalny40, Wspólnota, modyfikowalny50, Przestrzeń nieruchomości, modyfikowalny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa do registo - Área unitária constituída pelos seguintes subtipos (subtipos) na classificação da informação 2020 (para a lista atual ver especificação geral do produto Mapa do registo):450040, Área unitária Subtipos10, Área da propriedade, modificável20, Espaço da propriedade, modificável30, Apêndice C, modificável40, Comunidade, modificável50, Espaço da propriedade, modificável"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta registrului - Suprafața unității a constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor din 2020 (pentru lista actuală, a se vedea caietul de sarcini general al produsului Harta registrului): 450040, Suprafața unității subtipuri10, Suprafața proprietății, modificabilă20, Suprafața proprietății, modificabilă30, Anexa C, modificabilă40, Comunitate, modificabilă50, Suprafața proprietății, modificabilă"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa registra - Plocha jednotky pozostávala z nasledujúcich podtypov (podtypov) pri klasifikácii informácií 2020 (pre aktuálny zoznam pozri Všeobecnú špecifikáciu výrobku Mapa registra) :450040, Plocha jednotky Podtypy10, Plocha nehnuteľnosti, modifikovateľná20, Priestor nehnuteľnosti, modifikovateľný30, Príloha C, modifikovateľná40, Komunita, modifikovateľná50, Priestor nehnuteľnosti, modifikovateľný"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid registra - Območje enote je bilo sestavljeno iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Splošne specifikacije proizvoda Zemljevid registra) :450040, Območje enote Podtipi10, Območje nepremičnine, ki ga je mogoče spremeniti20, Prostor nepremičnine, ki ga je mogoče spremeniti30, Priloga C, ki ga je mogoče spremeniti40, Skupnost, ki ga je mogoče spremeniti50, Prostor nepremičnine, ki ga je mogoče spremeniti"},{"@language":"sv","@value":"Registerkarta - Enhetsområde 