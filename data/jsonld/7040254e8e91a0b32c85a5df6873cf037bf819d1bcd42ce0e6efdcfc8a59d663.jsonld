7.7605 59.4402))"}},{"@id":"https://resources.stockholm.se/data/a89cab93-f8f9-4163-aefe-9ad48bfe7305","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/a89cab93-f8f9-4163-aefe-9ad48bfe7305#HTTP:ESRI+Portal-URL/2"},{"@id":"https://resources.stockholm.se/data/a89cab93-f8f9-4163-aefe-9ad48bfe7305#HTTP:ESRI+Portal-URL/3"}],"dcat:keyword":["Stockholms stad - Miljöförvaltningen",{"@language":"sv","@value":"Ekologisk infrastruktur"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Naturinventeringar"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=ce1e9d7e-36f9-4d10-ba4e-74d9f8105c3f"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2010-01-01"},"dct:description":{"@language":"sv","@value":"Inventering av stränder 2008-2010. Rapport: Inventering av stränder i Stockholms stad 2010 naturvärden och tillgänlighet.Strandinventeringen omfattar de allra flesta av stadens strandmiljöer och ger en övergripande bild av tillståndet när det gäller både tillgänglighet och naturvärden. Strandinventeringen ska bidra till ökad uppmärksamhet för betydelsen av att värna och utveckla Stockholms strandområden."},"dct:identifier":"a89cab93-f8f9-4163-aefe-9ad48bfe7305","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Mi