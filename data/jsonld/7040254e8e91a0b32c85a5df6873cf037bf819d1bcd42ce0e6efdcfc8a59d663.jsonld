ted":{"@type":"xsd:date","@value":"2024-02-16"},"dct:description":{"@language":"sv","@value":"Kartlagret visar totalt koldioxidupptag (kg CO2-ekv. per ha och år) i Stockholms stad. I form av koldioxidupptag för olika typer av marker och markanvändning i Stockholms stad. Resultaten syftar till att öka kunskapen om bidraget till växthusgasbalansen inom Stockholms stad och för att skapa underlag som tar hänsyn till koldioxidupptag i skog och mark inom översiktlig planering."},"dct:identifier":"fcfd5d5d-e975-47f8-8f10-fb8109659f54","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5a28a3b16942f69c56d366e9043054d2954907903406fe992117284c0ba58c8d_b0n0"},"dct:title":{"@language":"sv","@value":"Koldioxidupptag 2021, totalt"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/fcfd5d5d-e975-47f8-8f10-fb8109659f54#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sthlm-miljo.maps.arcgis.com/home/item.html?id=b8f951d5990d4201bf66ee0061ea25d1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub - Hämta Tile package"},{"@id":"https://resources.stockholm.se/data/fcfd5d5d-e975-47f8-8f10-fb8109659f54#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/b9abcad2263e4d51a235ec8ced99d930/explore?location=59.334150%252C17.981958%252C12.55"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartvy"},{"@id":"https://resources.stockholm.se/data/fcfd5d5d-e975-47f8-8f10-fb8109659f54#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:for