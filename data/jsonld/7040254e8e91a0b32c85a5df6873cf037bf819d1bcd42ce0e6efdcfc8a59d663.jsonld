/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4393,18.2011 59.4393,18.2011 59.2272,17.7605 59.2272,17.7605 59.4393))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/4dc496ce-e25e-4c03-a927-e73058d496b6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/4dc496ce-e25e-4c03-a927-e73058d496b6#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/4dc496ce-e25e-4c03-a927-e73058d496b6#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=cbe66519-7f15-45f8-8d6b-90f47b329de8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-02-16"},"dct:description":{"@language":"sv","@value":"Ecocom AB har uppdrag av Stockholms stad genomfört en landskapsanalys i syfte att peka ut områden som är särskilt viktiga för fladdermössfaunan och områden som potentiellt kan hysa många arter. Arbetet genomförs utifrån en GIS-modell som har utvecklats av Centrum för biologisk mångfald tillsammans med Calluna AB i samarbete med ett flertal övriga konsulter bl a Ecocom AB och Naturcentrum AB. Tillhandahålls av miljöförvaltningen. För mer information se, https://miljobarometern.stockholm.se/natur/arter-och-artgrupper/daggdjur/fladdermoss/habitatmodellering-for-fladdermoss"},"dct:identifier":"4dc496ce-e25e-4c03-a927-e73058d496b6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2ae483b2a37ee880d1e933cde65a24e53a4abb480b492bd981d2f7cb8cfe4732_b0n0"},"dct:title":{"@language":"sv","@value":"Habitatnätverk 2019 - Fladdermöss"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/4dc496ce-e25e-4c03-a927-e73058d496b6#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/content/721d9425fa3346d6a8f03e35e569dc4f/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/4dc496ce-e25e-4c03-a927-e73058d496b6#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:2ae483b2a37ee880d1e933cde65a24e53a4abb480b492bd981d2f7cb8cfe4732"},{"@graph":[{"@id":"_:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0cfd1cea-c419-4652-989d-a88a545c5de9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2005-06-01"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: ? m, upplösning: 20 cm/pixel i ortofoto. Orektifierade bilderna försvunna. Detta ortofoto finns bara tillgängligt som rasterpyramid i dpMap. Innehåller geometriska fel och ska ej mätas i. Fotograferingsdatum: april-maj 2005."},"dct:identifier":"6869eaa1-e69c-412e-987e-0a147725047c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2005)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/6869eaa1-e69c-412e-987e-0a147725047c#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:2af9c76c0ad4439e714b1b3bfce03d75b907189128398fa2e927bb5afb4828e6"},{"@