kholm.se"}}],"@id":"urn:source:cf519fe99c6660d5996bfc961e611828ed957198688b59387475e87317664abe"},{"@graph":[{"@id":"_:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=4563bcc3-9739-46ad-994e-9479c51fdb9d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1961-01-01"},"dct:description":{"@language":"sv","@value":"En detaljplan reglerar bebyggelsen inom ett visst område eller fastighet. Den anger bland annat var hus får placeras, hur höga de får vara och vad de får användas till. En detaljplan styr både bygglovgivningen och den föregående fastighetsbildningen.Varje detaljplan avgränsas av en planområdesgräns. Planområdesgränsen anger vilket geografiskt område detaljplanen omfattar. Läs mer under https://www.boverket.se/sv/PBL-kunskapsbanken/planering/detaljplan/planbestammelser/gransbeteckningar/Denna datamängd visar planer (detaljplaner, stadsplaner, byggnadsplaner, generalplan, tomtindelningar, fastighetsplaner, ändring av detaljplan och avstyckningsplaner) i Stockholms stad som har vunnit laga kraft samt för områden där ett detaljplanearbete pågår. I varje yta står det planens diarienummer (t ex 7538 eller P2012-13546). Planhandlingar finns i Bygg- och plantjänsten och går att slå upp via diarienumret. Söksida för gällande planer: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Söksida för pågående planarbeten: http://insynsbk.stockholm.se/Byggochplantjansten/Pagaende-planarbete/PagaendePlanarbete/"},"dct:identifier":"7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","dct:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Detaljplaner mm - planområdesgränser för gällande planer och pågående detaljplanearbeten (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_PLANOVERSIKT?layers=PL_Planer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Detaljplaner (planområdesgränser för gällande planer och pågående planarbeten)"},{"@id":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_PLANOVERSIKT?layers=PL_Planer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Detaljplaner (planområdesgränser för gällande planer och pågående planarbeten)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cfc123aab6c58f2a467104a96b6bd4cb03a632f206d3062c9e1cd8c033aa182e"},{"@graph":[{"@id":"_:cfd2b3b2274a5dbe864e030e1a0e60e4fd5ebcca00cda78d444d0afc870ecab4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/c1134ea0-75e1-49d9-912b-7252ad8bd396","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/c1134ea0-75e1-49d9-912b-7252ad8bd396#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fastigheter och fysisk planering"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhälle och kultur"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=c1134ea0-75e1-49d9-912b-7252ad8bd396"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:created":{"@type":"xsd:date","@value":"1900-01-01"},"dct:description":{"@language":"sv","@value":"FB Webb är en webbapplikation för att få tillgång till Lantmäteriets fastigheter, adresser, byggnader, lägenheter och planer (detaljplaner, stadsplaner, generalplaner, byggnadsplaner mm) samt Skatteverkets register över folkbokförda personer."},"dct:identifier":"a9cc6466-f126-49ff-b44b-2f81b26b2425","dct:issued":{"@type":"xsd:date","@value":"1995-01-01"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cfd2b3b2274a5dbe864e030e1a0e60e4fd5ebcca00cda78d444d0afc870ecab4_b0n0"},"dct:title":{"@language":"sv","@value":"SBK FB Webb (webbapplikation för fastighets- och befolkningsdata) (internt SBK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/c1134ea0-75e1-49d9-912b-7252ad8bd396#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cfd2b3b2274a5dbe864e030e1a0e60e4fd5ebcca00cda78d444d0afc870ecab4"},{"@graph":[{"@id":"_:d1c8cb2bfd8ca0b2ae6fd5f7dd8c9b00872501cc81286a160c93ed5912d422b3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature8885279"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Punktgeometri som visar ett urval av stadens cykelparkeringar. Kartlagret bygger på tidigare inventeringar och är inte helt komplett utan saknar vissa cykelparkeringar. Exempel på parkeringar som visas är pollare, framhjulshållare, Stockholmshage, tvåvåningsställ och lastcykel. Kartlagret används för att synliggöra stadens cykelparkeringsbestånd avseende plats och typ. Datat uppdateras löpande vid behov. Ansvarig verksamhet: Trafikkontoret, Trafikplaneringsavdelningen, enheten Investering."},"dct:identifier":"60d0313a-f470-420e-83d5-76a5e5060a6c","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:d1c8cb2bfd8ca0b2ae6fd5f7dd8c9b00872501cc81286a160c93ed5912d422b3_b0n0"},"dct:title":{"@language":"sv","@value":"Cykelparkering"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetWS.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Cykelparkering_Punkt&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/60d0313a-f470-420e-83d5-76a5e5060a6c#HTTP:OGC:WFS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Cykelparkering_Punkt"},"dct:description":"OGC Web Feature Service 1.0.0 o