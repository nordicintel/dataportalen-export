tp://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2009-04-12"},"dcat:startDate":{"@type":"xsd:date","@value":"2009-04-11"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2009-04-12"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2009-04-11"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=1e946ed6-9ca0-4916-8592-aa23aab96bca"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2009-04-12"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 900 mUpplösning: 8 cm/pixelOrtofotot är inte så bra eftersom det inte har tillräckligt bra övertäckning, vilket resulterar i många lutande hus. Fotograferingsdatum: 11-12 april 2009."},"dct:identifier":"a83503d8-bafc-4ce7-8026-1335da28c559","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b0n0"},"dct:temporal":{"@id":"_:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2009)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2009"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2009"},{"@id":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2009"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2009"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5dec151739d8d40f59e86354a25bf0111aef14ee8f3aca4127f4015c90419ecb"},{"@graph":[{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2018-05-12"},"dcat:startDate":{"@type":"xsd:date","@value":"2018-04-12"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2018-05-12"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2018-04-12"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/2"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=64bab5c1-b720-4935-bf07-57bbffb98fea"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2018-05-12"},"dct:description":{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1830 - 1890m. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 5 maj 2018. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},"dct:identifier":"1746cb6d-4f40-4db4-90b4-299c5c9a9d3d","dct:issued":{"@type":"xsd:date","@value":"2019-02-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b0n0"},"dct:temporal":{"@id":"_:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto (2018)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2018?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2018"},{"@id":"https://resources.stockholm.se/data/1746cb6d-4f40-4db4-90b4-299c5c9a9d3d#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2018?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Ortofoto 2018"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5e162a4d85caa4a6461ab07cca519caa5f0d7d456dafd463c7eb19db6828e82a"},{"@graph":[{"@id":"_:5f525fa12fd08526d72df8374d778fb0b969d0ee29ecd3e63bc6b0820f416621_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:5f525fa12fd08526d72df8374d778fb0b969d0ee29ecd3e63bc6b0820f416621_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1b15d9bcf7eda258f86e59a03ed1c8ccde"},{"@id":"http://data.europa.eu/88u/dataset/7e74a7d2-6f7a-4a65-bd32-bfc42cfa222c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/353556f1-e588-4421-a885-9ccb6bdf0413"},{"@id":"http://data.europa.eu/88u/distribution/59e81d24-fe17-4705-8716-62275dd49e2c"},{"@id":"http://data.europa.eu/88u/distribution/abec2884-0e74-439f-98b3-dcbe8d91c280"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=88d3b57c-a914-4922-97a6-a9a76b1e0175"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2005-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"3D-сградите са модели в три измерения на сгради до средната височина на тавана, изчислена въз основа на лазерни данни във въздуха. Като основа за 3D строителни блокове са използвани обобщените 2D строителни повърхности на Градската карта. По-малки сгради като складови помещения и навеси не са включени. 3D-сградите покриват целия град Стокхолм и могат да се използват за планиране и визуализация на по-големи площи."},{"@language":"cs-t-sv-t0-mtec","@value":"3D-Buildings jsou modely ve třech rozměrech budov až do střední výšky stropu vypočítané z leteckých laserových dat. Jako základ pro 3D stavební bloky byly použity zobecněné 2D stavební plochy mapy města. Menší budovy, jako jsou skladovací prostory a přístřešky, nejsou zahrnuty. 3D budovy pokrývají celé město Stockholm a mohou být použity pro plánování a vizualizaci větších ploch."},{"@language":"da-t-sv-t0-mtec","@value":"3D-Bygninger er modeller i tre dimensioner af bygninger op til loftets medianhøjde beregnet ud fra luftbårne laserdata. Som grundlag for 3D-byggesten er de generaliserede 2D-byggeflader på bykortet blevet brugt. Mindre bygninger såsom lagerrum og skure er ikke inkluderet. 3D-Bygninger dækker hele Stockholm og kan bruges til planlægning og visualisering af større områder."},{"@language":"de-t-sv-t0-mtec","@value":"3D-Gebäude sind Modelle in drei Dimensionen von Gebäuden bis zur Medianhöhe der Decke, die aus luftgestützten Laserdaten berechnet werden. Als Basis für 3D-Bausteine wurden die verallgemeinerten 2D-Bauflächen des Stadtplans verwendet. Kleinere Gebäude wie Lagerräume und Schuppen sind nicht enthalten. 3D-Gebäude decken die gesamte Stadt Stockholm ab und können für die Planung und Visualisierung größerer Flächen verwendet werden."},{"@language":"el-t-sv-t0-mtec","@value":"Τα τρισδιάστατα κτίρια είναι μοντέλα σε τρεις διαστάσεις κτιρίων μέχρι το μέσο ύψος της οροφής που υπολογίζεται από αερομεταφερόμενα δεδομένα λέιζερ. Ως βάση για 3D δομικά στοιχεία, έχουν χρησιμοποιηθεί οι γενικευμένες 2D δομικές επιφάνειες του City Map. Μικρότερα κτίρια, όπως αποθηκευτικοί χώροι και υπόστεγα, δεν περιλαμβάνονται. Τα τρισδιάστατα κτίρια καλύπτουν ολόκληρη την πόλη της Στοκχόλμης και μπορούν να χρησιμοποιηθούν για το σχεδιασμό και την απεικόνιση μεγαλύτερων περιοχών."},{"@language":"en-t-sv-t0-mtec","@value":"3D-Buildings are models in three dimensions of buildings up to the ceiling's median height calculated from airborne laser data. As a base for 3D building blocks, the generalized 2D building surfaces of the City Map have been used. Smaller buildings such as storage rooms and sheds are not included. 3D-Buildings cover the entire city of Stockholm and can be used for planning and visualization of larger areas."},{"@language":"es-t-sv-t0-mtec","@value":"Los edificios 3D son modelos en tres dimensiones de edificios hasta la altura media del techo calculada a partir de datos láser aéreos. Como base para bloques de construcción 3D, se han utilizado las superficies de construcción 2D generalizadas del Mapa de la Ciudad. Los edificios más pequeños, como almacenes y cobertizos, no están incluidos. Los edificios 3D cubren toda la ciudad de Estocolmo y se pueden utilizar para la planificación y visualización de áreas más grandes."},{"@language":"et-t-sv-t0-mtec","@value":"3D-hooned on mudelid hoonete kolmes mõõtmes kuni lae keskmise kõrguseni, mis arvutatakse õhus oleva laseri andmete põhjal. 3D-ehitusplokkide alusena on kasutatud linnakaardi üldistatud 2D-ehituspindu. Väiksemad hooned, nagu laoruumid ja kuurid, ei ole hõlmatud. 3D-hooned katavad kogu Stockholmi linna ja neid saab kasutada suuremate alade planeerimiseks ja visualiseerimiseks."},{"@language":"fi-t-sv-t0-mtec","@value":"3D-rakennukset ovat malleja rakennusten kolmessa ulottuvuudessa katon keskikorkeuteen asti laskettuna ilmassa olevasta laserdatasta. 3D-rakennuspalikoiden pohjana on käytetty kaupunginkartan yleistettyjä 2D-rakennuspintoja. Pienemmät rakennukset, kuten varastot ja vajat, eivät sisälly hintaan. 3D-rakennukset kattavat koko Tukholman kaupungin ja niitä voidaan käyttää laajojen alueiden suunnitteluun ja visualisointiin."},{"@language":"fr-t-sv-t0-mtec","@value":"Les bâtiments 3D sont des modèles en trois dimensions de bâtiments jusqu'à la hauteur médiane du plafond calculée à partir de données laser aéroportées. Comme base pour les blocs de construction 3D, les surfaces de construction 2D généralisées de la carte de la ville ont été utilisées. Les petits bâtiments tels que les salles de stockage et les hangars ne sont pas inclus. Les bâtiments 3D couvrent toute la ville de Stockholm et peuvent être utilisés pour la planification et la visualisation de zones plus vastes."},{"@language":"ga-t-sv-t0-mtec","@value":"Is samhlacha iad 3D-Foirgnimh i dtrí thoise d'fhoirgnimh suas le hairde airmheánach na síleála arna ríomh ó shonraí léasair aerbheirthe. Mar bhonn le haghaidh bloic thógála 3D, baineadh úsáid as dromchlaí tógála 2D ginearálaithe Léarscáil na Cathrach. Ní áirítear foirgnimh níos lú amhail seomraí stórála agus seideanna. Clúdaíonn foirgnimh 3D cathair iomlán Stócólm agus is féidir iad a úsáid chun limistéir níos mó a phleanáil agus a léirshamhlú."},{"@language":"hr-t-sv-t0-mtec","@value":"3D-zgrade su modeli u tri dimenzije zgrada do srednje visine stropa izračunate iz laserskih podataka koji se prenose zrakom. Kao baza za 3D građevne blokove korištene su generalizirane 2D građevinske površine Gradske karte. Nisu uključene manje zgrade kao što su spremišta i šupe. 3D-zgrade pokrivaju cijeli grad Stockholm i mogu se koristiti za planiranje i vizualizaciju većih područja."},{"@language":"hu-t-sv-t0-mtec","@value":"A 3D-épületek az épületek három dimenziójának modelljei a mennyezet medián magasságáig, amelyet a levegőben lévő lézeradatokból számítanak ki. A 3D építőelemek alapjaként a Várostérkép általánosított 2D épületfelületeit használtuk. A kisebb épületek, például tárolóhelyiségek és fészerek nem tartoznak ide. A 3D-épületek Stockholm egész városát lefedik, és nagyobb területek tervezésére és megjelenítésére használhatók."},{"@language":"it-t-sv-t0-mtec","@value":"Gli edifici 3D sono modelli in tre dimensioni di edifici fino all'altezza mediana del soffitto calcolata dai dati laser aerotrasportati. Come base per i blocchi di costruzione 3D, sono state utilizzate le superfici di costruzione 2D generalizzate della mappa della città. Edifici più piccoli come magazzini e capannoni non sono inclusi. Gli edifici 3D coprono l'intera città di Stoccolma e possono essere utilizzati per la pianificazione e la visualizzazione di aree più grandi."},{"@language":"lt-t-sv-t0-mtec","@value":"3D pastatai yra trijų matmenų pastatų modeliai iki lubų vidutinio aukščio, apskaičiuoto pagal ore esančių lazerių duomenis. Kaip 3D statybinių blokų pagrindas buvo naudojami miesto žemėlapio apibendrinti 2D statybiniai paviršiai. Mažesni pastatai, pvz., Sandėliavimo patalpos ir pastogės, neįtraukiami. 3D pastatai apima visą Stokholmo miestą ir gali būti naudojami planuojant ir vizualizuojant didesnes teritorijas."},{"@language":"lv-t-sv-t0-mtec","@value":"3D ēkas ir modeļi trīs ēku dimensijās līdz griestu vidējam augstumam, kas aprēķināts no gaisa lāzera datiem. Par pamatu 3D ēkas blokiem ir izmantotas pilsētas kartes vispārinātās 2D ēkas virsmas. Mazākas ēkas, piemēram, noliktavas telpas un nojumes, nav iekļautas. 3D ēkas aptver visu Stokholmas pilsētu, un tās var izmantot lielāku teritoriju plānošanai un vizualizācijai."},{"@language":"mt-t-sv-t0-mtec","@value":"3D-Bini huma mudelli fi tliet dimensjonijiet ta 'bini sal-għoli medjan tas-saqaf ikkalkulat minn dejta tal-laser fl-arja. Bħala bażi għall-blokki tal-bini 3D, intużaw l-uċuħ ġeneralizzati tal-bini 2D tal-Mappa tal-Belt. Bini iżgħar bħal kmamar tal-ħżin u barrakki mhumiex inklużi. Il-bini 3D ikopri l-belt kollha ta 'Stokkolma u jista' jintuża għall-ippjanar u l-viżwalizzazzjoni ta 'żoni akbar."},{"@language":"nl-t-sv-t0-mtec","@value":"3D-gebouwen zijn modellen in drie dimensies van gebouwen tot de mediane hoogte van het plafond, berekend op basis van lasergegevens in de lucht. Als basis voor 3D-bouwstenen zijn de gegeneraliseerde 2D-bouwvlakken van de City Map gebruikt. Kleinere gebouwen zoals opslagruimtes en loodsen zijn niet inbegrepen. 3D-gebouwen bestrijken de hele stad Stockholm en kunnen worden gebruikt voor het plannen en visualiseren van grotere gebieden."},{"@language":"pl-t-sv-t0-mtec","@value":"Budynki 3D to modele w trzech wymiarach budynków do mediany wysokości sufitu obliczonej na podstawie danych laserowych unoszących się w powietrzu. Jako podstawę dla bloków konstrukcyjnych 3D wykorzystano uogólnione 2D powierzchnie budowlane mapy miasta. Mniejsze budynki, takie jak magazyny i szopy, nie są wliczone w cenę. Budynki 3D obejmują całe miasto Sztokholm i mogą być wykorzystywane do planowania i wizualizacji większych obszarów."},{"@language":"pt-t-sv-t0-mtec","@value":"3D-Buildings são modelos em três dimensões de edifícios até a altura mediana do teto calculada a partir de dados a laser no ar. Como base para blocos de construção 3D, foram utilizadas as superfícies de construção 2D generalizadas do Mapa da Cidade. Edifícios menores, como armazéns e galpões, não estão incluídos. Os edifícios 3D cobrem toda a cidade de Estocolmo e podem ser usados para o planeamento e visualização de áreas maiores."},{"@language":"ro-t-sv-t0-mtec","@value":"Clădirile 3D sunt modele în trei dimensiuni ale clădirilor până la înălțimea mediană a tavanului calculată pe baza datelor laser în aer. Ca bază pentru blocurile de construcție 3D, au fost utilizate suprafețele de construcție 2D generalizate ale hărții orașului. Clădirile mai mici, cum ar fi încăperile de depozitare și magazii, nu sunt incluse. Clădirile 3D acoperă întregul oraș Stockholm și pot fi utilizate pentru planificarea și vizualizarea zonelor mai mari."},{"@language":"sk-t-sv-t0-mtec","@value":"3D-stavby sú modely v troch rozmeroch budov až do strednej výšky stropu vypočítanej zo vzdušných laserových dát. Ako základ pre 3D stavebné bloky boli použité zovšeobecnené 2D stavebné povrchy mapy mesta. Menšie budovy, ako sú skladovacie priestory a prístrešky, nie sú zahrnuté. 3D budovy pokrývajú celé mesto Štokholm a môžu byť použité na plánovanie a vizualizáciu väčších oblastí."},{"@language":"sl-t-sv-t0-mtec","@value":"3D-stavbe so modeli v treh dimenzijah stavb do srednje višine stropa, izračunane iz letalskih laserskih podatkov. Kot osnova za 3D gradnike so bile uporabljene posplošene 2D stavbne površine mestnega zemljevida. Manjše stavbe, kot so skladiščni prostori in lope, niso vključene. 3D stavbe pokrivajo celotno mesto Stockholm in se lahko uporabljajo za načrtovanje in vizualizacijo večjih območij."},{"@language":"sv","@value":"3D-Byggnader är modeller i tre dimensioner av byggnader upp till takets medianhöjd beräknad från flygburen laserdata. Som bas för 3D-byggnadsblock har Stadskartans generaliserade 2D-byggnadsytor använts. Mindre byggnader som förråd och friggebodar finns inte med. 3D-Byggnader täcker hela Stockholms stad och kan bland annat användas för planering och visualisering av större områden."},{"@language":"uk-t-sv-t0-mtec","@value":"3D-будівлі - це моделі в трьох вимірах будівель до середньої висоти стелі, розраховані на основі даних повітряного лазера. В якості основи для 3D будівельних блоків були використані узагальнені 2D будівельні поверхні карти міста. Менші будівлі, такі як складські приміщення та навіси, не включені. 3D-будівлі охоплюють все місто Стокгольм і можуть бути використані для планування та візуалізації великих площ."}],"dct:format":"text/html","dct:identifier":"7e74a7d2-6f7a-4a65-bd32-bfc42cfa222c","dct:issued":{"@type":"xsd:date","@value":"2016-06-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2023-01-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5f525fa12fd08526d72df8374d778fb0b969d0ee29ecd3e63bc6b0820f416621_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK 3D сгради (LOD1) Обобщени"},{"@language":"cs-t-sv-t0-mtec","@value":"3D budovy SBK (LOD1) Zobecněné"},{"@language":"da-t-sv-t0-mtec","@value":"SBK 3D-bygninger (LOD1)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK 3D Gebäude (LOD1) Verallgemeinert"},{"@language":"el-t-sv-t0-mtec","@value":"Κτίρια SBK 3D (LOD1) Γενικευμένα"},{"@language":"en-t-sv-t0-mtec","@value":"SBK 3D Buildings (LOD1) Generalized"},{"@language":"es-t-sv-t0-mtec","@value":"Edificios SBK 3D (LOD1) Generalizados"},{"@language":"et-t-sv-t0-mtec","@value":"SBK 3D hooned (LOD1) Üldistatud"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK 3D -rakennukset (LOD1) Yleistetty"},{"@language":"fr-t-sv-t0-mtec","@value":"Bâtiments 3D SBK (LOD1) Généralisés"},{"@language":"ga-t-sv-t0-mtec","@value":"Foirgnimh SBK 3D (LOD1) Ginearálaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK 3D zgrade (LOD1) Općenito"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK 3D épületek (LOD1) Generalizált"},{"@language":"it-t-sv-t0-mtec","@value"