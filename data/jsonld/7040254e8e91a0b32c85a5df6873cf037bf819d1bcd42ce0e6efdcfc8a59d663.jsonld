":"_:9cc3f4e4b5f936defca852771d876eed9edcb5f3c7f12244f5a2fbd0203472d4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"https://resources.stockholm.se/data/d1dbebac-aca0-42b7-aac3-57715a8c1a51","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/d1dbebac-aca0-42b7-aac3-57715a8c1a51#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/d1dbebac-aca0-42b7-aac3-57715a8c1a51#HTTP:ESRI+Portal-URL/2"}],"dcat:keyword":["Stockholms stad - Miljöförvaltningen",{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stadsmiljö"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6354ef8e-1edd-43f4-a01f-c4467029b529"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:date","@value":"2022-01-01"},"dct:description":{"@language":"sv","@value":"Kartlagret visar beräknad ekvivalent ljudnivå, medelvärdesbildad över 24 timmar och inkluderar alla bullerkällor inklusive bakgrundsnivåer. Med alla bullerkällor avses ljud från vägtrafik på det statliga och kommunala vägnätet, flygtrafik, ljud från järnvägslinjerna, tunnelbana, Tvärbanan, Roslagsbanan och övriga spårtrafikslag. Ingående data är baserat på faktiska registrerade trafikflöden under 2019 samt modellberäknade data för vägavsnitt där ingen mätning finns. Redovisade ljudnivåer ska ses som ett indikativt värde för platsen. Tillhandahålls av Miljöförvaltningen. För mer information se, Rapport R01 Bullerkartläggning av Stockholm - Enligt Naturvårdsverkets beräkningsmetoder."},"dct:identifier":"d1dbebac-aca0-42b7-aac3-57715a8c1a51","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dct:spatial":{"@id":"_:9cc3f4e4b5f936defca852771d876eed9edcb5f3c7f12244f5a2fbd0203472d4_b0n0"},"dct:title":{"@language":"sv","@value":"Bullerkartan 2022"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/d1dbebac-aca0-42b7-aac3-57715a8c1a51#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/ce2b61853e594b7fa70de53eed7e9ef2/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/d1dbebac-aca0-42b7-aac3-57715a8c1a51#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:mgis@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"}},{"@id":"ht