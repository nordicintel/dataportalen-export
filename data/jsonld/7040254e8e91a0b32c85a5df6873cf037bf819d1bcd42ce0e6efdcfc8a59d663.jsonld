/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsledningskontoret - Kommunikations- och omvärldsavdelningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ola.williams@stockholm.se"}}],"@id":"urn:source:069c15541ce48145fcee28dc716da80640cb705975b76be7d67996a3b4281793"},{"@graph":[{"@id":"_:06cbb595c1fde23459f2a8ff2561ccaf140fb8fe70437241cfbb6d6b4ede0ca7_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.2449 60.2983,19.991 60.2983,19.991 58.4888,17.2449 58.4888,17.2449 60.2983))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.2449 60.2983,19.991 60.2983,19.991 58.4888,17.2449 58.4888,17.2449 60.2983))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:Information:Produktspecfikation/2"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/3"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/4"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/5"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/8"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=8c57878e-c0a3-4a63-9e24-ef89680ab3a6"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"2013-10-31"},"dct:description":{"@language":"sv","@value":"Tätortskartan är en översiktskarta som täcker hela Stockholms län, den är anpassad för skalintervallet 1:12 000 till 1:18 000. OBS Från och med 1 januari 2021 ajourhålls tätortskartan endast innanför Stockholm stads kommungränser, och informationen utanför kommungränsen kommer på sikt att bli inaktuell. Produkten kommer att utgå och ersättas av annan översiktskarta.Innehållet i Tätortskartan är generaliserat både till form och omfattning och Tätortskartan lämpar sig därmed att visas i vyer över stora områden. Den milda färgsättningen gör att kartan med fördel kan användas som bakgrundskarta. Innehållet inkluderar t ex olika markslag, offentliga byggnader, bebyggelse i tätort och glesbygd, anläggningar, spårnät, vägnät med gatunamn och adressnummer."},"dct:identifier":"300404e0-d3f4-4dfb-8956-f81991413394","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-12-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:06cbb595c1fde23459f2a8ff2561ccaf140fb8fe70437241cfbb6d6b4ede0ca7_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Tätortskarta (Stockholms län) (1:12000 - 1:18000)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:Information:Produktspecfikation/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allman-Produktspecifikation_TK_A88.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Allmän produktspecifikation om Tätortskarta (version 8.8)"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_TATORTSKARTA_GRA?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundskarta Tätortskarta (Grå - skikt-indelad)"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_TATORTSKARTA_RASTER?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"WMS-tjänst Bakgrundkarta Tätortskarta"},{"@id":"https://resources.stockholm.se/data/300404e0-d3f4-4dfb-8956-f81991413394#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/we