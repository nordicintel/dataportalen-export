v30, SJ Smalspår, modifierbar, aktiv40, Pendeltåg, modifierbar, aktiv50, Industrispår, modifierbar, aktiv60, Spårvagnsspår, modifierbar, aktiv451490, ElnätUndertyper10, Högspänningsledning, modifierbar, aktiv20, Kraftledning, stam, modifierbar, aktiv30, Kraftledning, region, modifierbar, aktiv451610, VägnummerUndertyper10, Länsvägsnummer, modifierbar, aktiv20, Europavägsnummer, modifierbar, aktiv30, Övrigt länsvägsnummer, modifierbar, aktiv"},"dct:identifier":"ba06b70b-1afd-4901-9362-14c0438b4420","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-21"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5c0f89f1e05f58413b4d5b36c3568fb2ec7e3d453066b3e94873daeccd32fb82_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Tätortskarta - Infrastruktur förbindelse"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ba06b70b-1afd-4901-9362-14c0438b4420#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=623866857_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Tätortskarta Stockholms län"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:5c0f89f1e05f58413b4d5b36c3568fb2ec7e3d453066b3e94873daeccd32fb82"},{"@graph":[{"@id":"_:5c4401b8fdd1ddfd2fa526a0c61b424814cd