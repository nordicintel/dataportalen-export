kholm.se"}}],"@id":"urn:source:f30bf8dd1e604fcb6e5a084533793b0fb58faddf824909df041cca8a9e73acb7"},{"@graph":[{"@id":"_:f401db96c31ae4f8bf7eaff4b4c77f9cfae29dacc3cf9a8255f732ce2fe4cb7f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:f401db96c31ae4f8bf7eaff4b4c77f9cfae29dacc3cf9a8255f732ce2fe4cb7f_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"141a6799efcc16afd78d002ab0e4cb4e25"},{"@id":"http://data.europa.eu/88u/dataset/124db2a1-44ec-41b9-8889-181b14f4bff0","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/101d9a1e-d737-4f22-8ad4-7302baf3e26d"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f0bb14c9-f7df-451d-b386-2dca98515498"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Разрешителните за строеж се състоят от следните подтипове (за текущия списък вж. Базова карта на общата продуктова спецификация): 10, Разрешителни за строеж; 20, сезиране за издаване на разрешение за строеж; 30, събаряне."},{"@language":"cs-t-sv-t0-mtec","@value":"Stavební povolení se skládají z následujících podtypů (aktuální seznam viz základní mapa obecné specifikace produktu): 10, stavební povolení; 20, žádost o stavební povolení; 30, demolice."},{"@language":"da-t-sv-t0-mtec","@value":"Byggetilladelser består af følgende undertyper (den nuværende liste findes i basiskortet over generelle produktspecifikationer): 10, byggetilladelser 20, henvisning til byggetilladelse 30, Nedrivning."},{"@language":"de-t-sv-t0-mtec","@value":"Baugenehmigungen bestehen aus den folgenden Untertypen (für die aktuelle Liste siehe Basiskarte der allgemeinen Produktspezifikation): 10, Baugenehmigungen; 20, Befassung mit der Baugenehmigung; 30, Abriss."},{"@language":"el-t-sv-t0-mtec","@value":"Οι οικοδομικές άδειες αποτελούνται από τους ακόλουθους υποτύπους (για τον τρέχοντα κατάλογο βλέπε χάρτη βάσης γενικών προδιαγραφών προϊόντος): 10, Οικοδομικές άδειες· 20, Παραπομπή οικοδομικής άδειας· 30, κατεδάφιση."},{"@language":"en-t-sv-t0-mtec","@value":"Building permits consist of the following subtypes (for the current list see General Product Specification Base Map): 10, Building permits; 20, Building permit referral; 30, Demolition."},{"@language":"es-t-sv-t0-mtec","@value":"Los permisos de construcción consisten en los siguientes subtipos (para la lista actual, véase el mapa base de las especificaciones generales del producto): 10, Permisos de construcción; 20, Remisión de permisos de construcción; 30 años, demolición."},{"@language":"et-t-sv-t0-mtec","@value":"Ehitusload koosnevad järgmistest alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaart): 10, ehitusload; 20, ehitusloa taotlus; 30, lammutamine."},{"@language":"fi-t-sv-t0-mtec","@value":"Rakennusluvat koostuvat seuraavista alatyypeistä (nykyisen luettelon osalta katso yleinen tuote-eritelmän peruskartta): 10, rakennusluvat; 20, rakennuslupapyyntö; 30. Purkaminen."},{"@language":"fr-t-sv-t0-mtec","@value":"Les permis de construire se composent des sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): 10, Permis de construire; 20, Saisine du permis de construire; 30, Démolition."},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard atá i gceadanna tógála na fochineálacha seo a leanas (le haghaidh an liosta reatha féach Bunléarscáil Sonraíochta Táirge Ginearálta): 10, Ceadanna tógála; 20, Tarchur ceada tógála; 30, Scartáil."},{"@language":"hr-t-sv-t0-mtec","@value":"Građevinske dozvole sastoje se od sljedećih podvrsta (za trenutačni popis vidjeti osnovnu kartu opće specifikacije proizvoda): 10, građevinska dozvola; 20, upućivanje na građevinsku dozvolu; 30, rušenje."},{"@language":"hu-t-sv-t0-mtec","@value":"Az építési engedélyek a következő altípusokból állnak (az aktuális listát lásd az Általános Termékleírási Alaptérképen): 10, Építési engedélyek; 20, Építési engedély beterjesztése; 30, bontás."},{"@language":"it-t-sv-t0-mtec","@value":"I permessi di costruzione consistono nei seguenti sottotipi (per l'elenco attuale si veda la mappa di base delle specifiche generali di prodotto): 10, Permessi di costruzione; 20, consultazione del permesso di costruzione; 30, Demolizione."},{"@language":"lt-t-sv-t0-mtec","@value":"Statybos leidimus sudaro šie potipiai (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): 10, statybos leidimai; 20, Statybos leidimo persiuntimas; 30, griovimas."},{"@language":"lv-t-sv-t0-mtec","@value":"Būvatļaujas sastāv no šādiem apakštipiem (pašreizējo sarakstu sk. vispārējā produktu specifikācijas bāzes kartē): 10, būvatļaujas; 20, Būvatļaujas nosūtīšana; 30, nojaukšana."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-permessi għall-bini jikkonsistu fis-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): 10, Permessi għall-bini; 20, Konsultazzjoni dwar il-permess tal-bini; 30, Demolizzjoni."},{"@language":"nl-t-sv-t0-mtec","@value":"Bouwvergunningen bestaan uit de volgende subtypes (zie voor de huidige lijst de basiskaart van de algemene productspecificatie): 10, Bouwvergunningen; 20, Verwijzing bouwvergunning; 30, Sloop."},{"@language":"pl-t-sv-t0-mtec","@value":"Pozwolenia na budowę składają się z następujących podtypów (aktualny wykaz znajduje się w mapie podstawowej specyfikacji produktu): 10, Pozwolenia na budowę; 20, Skierowanie pozwolenia na budowę; 30, rozbiórka."},{"@language":"pt-t-sv-t0-mtec","@value":"As licenças de construção consistem nos seguintes subtipos (para a lista atual, ver o mapa de base das especificações gerais dos produtos): 10, Licenças de construção; 20, Remessa de licença de construção; 30, Demolição."},{"@language":"ro-t-sv-t0-mtec","@value":"Autorizațiile de construcție constau în următoarele subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): 10, Autorizații de construire; 20, sesizarea privind autorizația de construcție; 30, demolare."},{"@language":"sk-t-sv-t0-mtec","@value":"Stavebné povolenia pozostávajú z týchto podtypov (pre aktuálny zoznam pozri základnú mapu všeobecných špecifikácií výrobku): 10, stavebné povolenia; 20, žiadosť o stavebné povolenie; 30, demolácia."},{"@language":"sl-t-sv-t0-mtec","@value":"Gradbena dovoljenja so sestavljena iz naslednjih podvrst (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): 10, gradbena dovoljenja; 20, predložitev gradbenega dovoljenja; 30, rušenje."},{"@language":"sv","@value":"Bygglov består av följande subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): 10, Bygglov; 20, Bygglovsremiss; 30, Rivningslov."},{"@language":"uk-t-sv-t0-mtec","@value":"Дозвіл на будівництво складається з наступних підтипів (для поточного списку див. 10, Дозвіл на будівництво; 20, Направлення дозволу на будівництво; 30, Руйнування."}],"dct:format":"text/html","dct:identifier":"124db2a1-44ec-41b9-8889-181b14f4bff0","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f401db96c31ae4f8bf7eaff4b4c77f9cfae29dacc3cf9a8255f732ce2fe4cb7f_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Разрешително за строеж"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Stavební povolení"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Byggetilladelse"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Baugenehmigung"},{"@language":"el-t-sv-t0-mtec","@value":"Βασικός χάρτης SBK - Οικοδομική άδεια"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Building permit"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Permiso de construcción"},{"@language":"et-t-sv-t0-mtec","@value":"SBK aluskaart - Ehitusluba"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Rakennuslupa"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base - Permis de construire"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil bhunáite SBK - Cead tógála"},{"@language":"hr-t-sv-t0-mtec","@value":"Bazna karta SBK-a - građevinska dozvola"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Építési engedély"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa di base - Permesso di costruzione"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Statybos leidimas"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Bāzes karte - Būvatļauja"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Base map - Building Permess għall-bini"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Bouwvergunning"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Base map - Pozwolenie na budowę"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa de base SBK - Licença de construção"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta bazei SBK - Autorizație de construire"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Základná mapa - Stavebné povolenie"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Osnovni zemljevid - Gradbeno dovoljenje"},{"@language":"sv","@value":"SBK Baskarta - Bygglov"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Базова карта - Дозвіл на будівництво"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/101d9a1e-d737-4f22-8ad4-7302baf3e26d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=269cb7f1-fdb3-43de-aed0-db3ed047162b&showmetadataview"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/124db2a1-44ec-41b9-8889-181b14f4bff0#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Baskarta (1:400 - 1:2000).",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продуктовата базова карта (1:400 - 1:2000)."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktové Základní mapy (1:400 - 1:2000)."},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktbasen (1:400 - 1:2000)."},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Basiskarte (1:400 - 1:2000) enthalten."},{"@language":"el-t-sv-t0-mtec","@value":"Το σύνολο δεδομένων περιλαμβάνεται στον χάρτη βάσης προϊόντος (1:400 - 1:2000)."},{"@language":"en-t-sv-t0-mtec","@value":"The data set is included in the product Base map (1:400 - 1:2000)."},{"@language":"es-t-sv-t0-mtec","@value":"El conjunto de datos se incluye en el mapa base del producto (1:400 - 1:2000)."},{"@language":"et-t-sv-t0-mtec","@value":"Andmekogum sisaldub toote aluskaardil (1:400 - 1:2000)."},{"@language":"fi-t-sv-t0-mtec","@value":"Aineisto sisältyy tuotteen peruskarttaan (1:400 - 1:2000)."},{"@language":"fr-t-sv-t0-mtec","@value":"L'ensemble de données est inclus dans la carte de base du produit (1:400 - 1:2000)."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an tacar sonraí san áireamh sa bhunléarscáil táirge (1:400 - 1:2000)."},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka uključen je u kartu proizvoda Baza (1:400 - 1:2000)."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatkészlet megtalálható a termék alaptérképén (1:400 - 1:2000)."},{"@language":"it-t-sv-t0-mtec","@value":"Il set di dati è incluso nella mappa di base del prodotto (1:400 - 1:2000)."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rinkinys įtrauktas į gaminio bazinį žemėlapį (1:400 - 1:2000)."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu kopa ir iekļauta produktu bāzes kartē (1:400 - 1:2000)."},{"@language":"mt-t-sv-t0-mtec","@value":"Is-sett tad-data huwa inkluż fil-mappa tal-bażi tal-prodott (1:400 - 1:2000)."},{"@language":"nl-t-sv-t0-mtec","@value":"De gegevensset is opgenomen in de productbasiskaart (1:400 - 1:2000)."},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych znajduje się na mapie bazowej produktu (1:400 - 1:2000)."},{"@language":"pt-t-sv-t0-mtec","@value":"O conjunto de dados está incluído no mapa de base do produto (1:400 - 1:2000)."},{"@language":"ro-t-sv-t0-mtec","@value":"Setul de date este inclus în harta de bază a produsului (1:400 - 1:2000)."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový súbor je súčasťou produktu Základná mapa (1:400 - 1:2000)."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov je vključen v osnovni zemljevid izdelka (1:400 - 1:2000)."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних входить до базової карти продукту (1:400 - 1:2000)."}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/101d9a1e-d737-4f22-8ad4-7302baf3e26d"}},{"@id":"http://data.europa.eu/88u/record/124db2a1-44ec-4