59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Nedladdning/3"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:OGC:WFS/4"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature4000017"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som representerar utbredning av trafikregel om miljözon, d v s de vägsträckor som i lokala trafikföreskrifter beslutats ska ingå i miljözon. De lokala bestämmelserna är samma för alla städer med miljözon och baseras på reglerna i Trafikförordningen, och gäller tunga dieseldrivna lastbilar och bussar. Det innebär att man utgår från EU:s miljöklassning av fordon för att avgöra vilka som är tillåtna inom miljözonen. Tillhör verksamhet NVDB (Trafikverket). Utbredning: Stockholms län"},"dct:identifier":"2b4ffea4-53a0-4782-9b12-961a36b9419a","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:22fa8912e42edd27e8101292e8c879cf34edbbece1df038f9a81b012425dea8a_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - Miljözon"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se/LvWS-2.2/Lv.asmx"},"dct:description":"Beskrivning av LvWS APIs olika metoder.","dct:title":"Tjänsteadress web service"},{"@id":"https://resources.stockholm.se/data/2b4ffea4-53a0-4782-9b12-961a36b9419a#HTTP:Nedladdning/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:NVDB_Miljozon&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returne