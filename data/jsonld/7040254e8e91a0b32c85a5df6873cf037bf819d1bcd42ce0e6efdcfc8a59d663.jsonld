épes alkalmazás"},{"@language":"it-t-sv-t0-mtec","@value":"Applicazione della mappa"},{"@language":"lt-t-sv-t0-mtec","@value":"Žemėlapio taikomoji programa"},{"@language":"lv-t-sv-t0-mtec","@value":"Kartes pieteikums"},{"@language":"mt-t-sv-t0-mtec","@value":"Applikazzjoni tal-mappa"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarttoepassing"},{"@language":"pl-t-sv-t0-mtec","@value":"Aplikacja mapowa"},{"@language":"pt-t-sv-t0-mtec","@value":"Aplicação de mapas"},{"@language":"ro-t-sv-t0-mtec","@value":"Aplicație pentru hărți"},{"@language":"sk-t-sv-t0-mtec","@value":"Aplikácia máp"},{"@language":"sl-t-sv-t0-mtec","@value":"Aplikacija zemljevida"},{"@language":"uk-t-sv-t0-mtec","@value":"Додаток для мап"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/57bf3f8e-e35e-42f3-a253-021fa99619c4"}},{"@id":"http://data.europa.eu/88u/distribution/f18e9343-f329-47a3-a8fc-5141933c12ac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/96458f2922214cada3f205863f2c1d95/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/c2638d28-809c-4df4-b131-3756f1cedf5f#HTTP:ESRI+Portal-URL/1","dct:title":["Miljöförvaltningens öppna data-hub",{"@language":"bg-t-sv-t0-mtec","@value":"Център за отворени данни на администрацията по околна среда"},{"@language":"cs-t-sv-t0-mtec","@value":"Rozbočovač otevřených dat správy životního prostředí"},{"@language":"da-t-sv-t0-mtec","@value":"Miljøstyrelsens åbne datahub"},{"@language":"de-t-sv-t0-mtec","@value":"Open Data Hub der Umweltverwaltung"},{"@language":"el-t-sv-t0-mtec","@value":"Κόμβος ανοικτών δεδομένων της περιβαλλοντικής διοίκησης"},{"@language":"en-t-sv-t0-mtec","@value":"Environmental administration's open data hub"},{"@language":"es-t-sv-t0-mtec","@value":"Centro de datos abiertos de la administración ambiental"},{"@language":"et-t-sv-t0-mtec","@value":"Keskkonnaameti avatud andmete keskus"},{"@language":"fi-t-sv-t0-mtec","@value":"Ympäristöhallinnon avoimen datan keskus"},{"@language":"fr-t-sv-t0-mtec","@value":"Pôle de données ouvertes de l'administration environnementale"},{"@language":"ga-t-sv-t0-mtec","@value":"Mol sonraí oscailte an riaracháin comhshaoil"},{"@language":"hr-t-sv-t0-mtec","@value":"Centar otvorenih podataka uprave za okoliš"},{"@language":"hu-t-sv-t0-mtec","@value":"A környezetvédelmi igazgatás nyílt adatközpontja"},{"@language":"it-t-sv-t0-mtec","@value":"L'hub open data dell'amministrazione ambientale"},{"@language":"lt-t-sv-t0-mtec","@value":"Aplinkos apsaugos administracijos atvirųjų duomenų centras"},{"@language":"lv-t-sv-t0-mtec","@value":"Vides pārvaldes atvērto datu centrs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ċentru tad-data miftuħa tal-amministrazzjoni ambjentali"},{"@language":"nl-t-sv-t0-mtec","@value":"Open data hub van de milieuadministratie"},{"@language":"pl-t-sv-t0-mtec","@value":"Otwarte centrum danych administracji środowiskowej"},{"@language":"pt-t-sv-t0-mtec","@value":"Centro de dados abertos da administração ambiental"},{"@language":"ro-t-sv-t0-mtec","@value":"Centrul de date deschise al administrației de mediu"},{"@language":"sk-t-sv-t0-mtec","@value":"Centrum otvorených dát environmentálnej správy"},{"@language":"sl-t-sv-t0-mtec","@value":"Vozlišče odprtih podatkov okoljske uprave"},{"@language":"uk-t-sv-t0-mtec","@value":"Центр відкритих даних екологічної адміністрації"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/f18e9343-f329-47a3-a8fc-5141933c12ac"}},{"@id":"http://data.europa.eu/88u/record/c2638d28-809c-4df4-b131-3756f1cedf5f","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/57bf3f8e-e35e-42f3-a253-021fa99619c4"},{"@id":"http://data.europa.eu/88u/distribution/f18e9343-f329-47a3-a8fc-5141933c12ac"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"c2638d28-809c-4df4-b131-3756f1cedf5f","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:09Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/c2638d28-809c-4df4-b131-3756f1cedf5f"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c8c3acf63d0a79c6b9f76e2738f43d40b194fd5456a0138aa8359b8e828c3300_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/c2638d28-809c-4df4-b131-3756f1cedf5f"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:02Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:41:09Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"c2638d28-809c-4df4-b131-3756f1cedf5f","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/c2638d28-809c-4df4-b131-3756f1cedf5f"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:c8c3acf63d0a79c6b9f76e2738f43d40b194fd5456a0138aa8359b8e828c3300"},{"@graph":[{"@id":"_:c98569c032e2553318ca537e498e36ab65e43b84331f4162450e783e5ba5c545_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:c98569c032e2553318ca537e498e36ab65e43b84331f4162450e783e5ba5c545_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"197058c25b50ab96da33513a6bd152d687"},{"@id":"http://data.europa.eu/88u/dataset/1e2d37d6-1bbe-4c51-b182-f03854c13a9c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/456a7679-6a1b-47f8-8b1e-6ffe06be1c8c"},{"@id":"http://data.europa.eu/88u/distribution/92926852-c6d9-4ec5-accb-3049c015624d"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=daae225a-fd3d-4a00-b6bd-b81b4a9f83d1"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2021-12-31"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Точков слой с бензиностанции за автомобили от 2021 до 2024 г. Фиксирани паркоместа за стационарни басейни за автомобили (и доколкото безплатните плаващи басейни за автомобили също имат фиксирани паркоместа). Показва адреса и оператора на споделено пътуване, който има един или повече автомобили на текущото местоположение. Доказателствата се основават на данни, предоставени от самите оператори на автомобилни пулове. Съставена от Sweco от името на администрацията по околната среда."},{"@language":"cs-t-sv-t0-mtec","@value":"Bodová vrstva se stanicemi u bazénu v letech 2021–2024. Pevná parkovací místa pro stacionární bazény pro automobily (a v rozsahu bezplatné plovoucí bazény pro automobily mají také pevná parkovací místa). Zobrazí adresu a operátor spolujízdy, který má jedno nebo více aut v aktuálním umístění. Důkazy vycházejí z údajů poskytnutých samotnými provozovateli sdružení automobilů. Sestavila společnost Sweco jménem správy životního prostředí."},{"@language":"da-t-sv-t0-mtec","@value":"Punktlag med bilpoolstationer fra 2021-2024. Faste parkeringspladser til stationære bilpuljer (og i det omfang gratis flydende bilpuljer også har faste parkeringspladser). Viser den adresse og samkørselsoperatør, der har en eller flere biler på den aktuelle placering. Dokumentationen er baseret på data fra bilpooloperatørerne selv. Udarbejdet af Sweco på vegne af miljøforvaltningen."},{"@language":"de-t-sv-t0-mtec","@value":"Punktebene mit Autopoolstationen von 2021-2024. Feste Parkplätze für stationäre Auto-Pools (und soweit kostenlos schwimmende Auto-Pools haben auch feste Parkplätze). Zeigt die Adresse und den Fahrgemeinschaftsbetreiber an, der ein oder mehrere Autos am aktuellen Standort hat. Der Nachweis stützt sich auf Daten, die von den Betreibern der Fahrgemeinschaften selbst vorgelegt wurden. Erstellt von Sweco im Auftrag der Umweltverwaltung."},{"@language":"el-t-sv-t0-mtec","@value":"Επίπεδο σημείου με σταθμούς συγκέντρωσης αυτοκινήτων από το 2021 έως το 2024. Σταθερές θέσεις στάθμευσης για σταθερές πισίνες αυτοκινήτων (και στο βαθμό που οι ελεύθερες πλωτές πισίνες αυτοκινήτων διαθέτουν επίσης σταθερές θέσεις στάθμευσης). Εμφανίζει τη διεύθυνση και τον χειριστή του carpool που έχει ένα ή περισσότερα αυτοκίνητα στην τρέχουσα τοποθεσία. Τα αποδεικτικά στοιχεία βασίζονται σε δεδομένα που παρέχονται από τους ίδιους τους φορείς εκμετάλλευσης της δεξαμενής αυτοκινήτων. Εκπονήθηκε από τη Sweco για λογαριασμό της περιβαλλοντικής διοίκησης."},{"@language":"en-t-sv-t0-mtec","@value":"Point layer with car pool stations from 2021-2024. Fixed parking spaces for stationary car pools (and to the extent free floating car pools also have fixed parking spaces). Displays the address and carpool operator that has one or more cars in the current location. The evidence is based on data provided by the car pool operators themselves. Compiled by Sweco on behalf of the environmental administration."},{"@language":"es-t-sv-t0-mtec","@value":"Capa de puntos con estaciones de coche compartido de 2021-2024. Plazas de aparcamiento fijas para piscinas de coches estacionarias (y en la medida en que las piscinas de coches flotantes libres también tienen plazas de aparcamiento fijas). Muestra la dirección y el operador de carpool que tiene uno o más coches en la ubicación actual. Las pruebas se basan en los datos facilitados por los propios operadores de la agrupación de vehículos. Compilado por Sweco en nombre de la administración ambiental."},{"@language":"et-t-sv-t0-mtec","@value":"Punktikiht koos autobasseinijaamadega aastatel 2021–2024. Paiksed parkimiskohad statsionaarsetele autoparklatele (ja vabadel ujuvatel autoparklatel on ka fikseeritud parkimiskohad). Kuvab aadressi ja autopargi operaatori, kellel on praeguses asukohas üks või mitu autot. Tõendid põhinevad autoparkide käitajate endi esitatud andmetel. Koostanud Sweco keskkonnaameti nimel."},{"@language":"fi-t-sv-t0-mtec","@value":"Pistekerros, jossa on auton allasasemat vuosina 2021–2024. Kiinteät pysäköintipaikat pysäköidyille autoaltaille (ja siltä osin kuin vapaasti kelluvilla autoaltailla on myös kiinteät pysäköintipaikat). Näyttää osoitteen ja carpool-operaattorin, jolla on yksi tai useampi auto nykyisessä sijainnissa. Näyttö perustuu autonvalmistajien itsensä toimittamiin tietoihin. Swecon ympäristöhallinnon puolesta laatima."},{"@language":"fr-t-sv-t0-mtec","@value":"Couche de points avec stations de covoiturage de 2021 à 2024. Places de stationnement fixes pour les parkings fixes (et dans la mesure où les parkings flottants gratuits disposent également de places de stationnement fixes). Affiche l'adresse et l'opérateur de covoiturage qui a une ou plusieurs voitures à l'emplacement actuel. Les éléments de preuve sont fondés sur les données fournies par les exploitants de parcs automobiles eux-mêmes. Compilé par Sweco pour le compte de l'administration de l'environnement."},{"@language":"ga-t-sv-t0-mtec","@value":"Ciseal pointe le stáisiúin linnte gluaisteán ó 2021-2024. Spásanna páirceála seasta le haghaidh linnte gluaisteán ina stad (agus a mhéid atá spásanna páirceála seasta ag linnte gluaisteán ar snámh saor in aisce freisin). Taispeánann sé an seoladh agus an t-oibreoir gluaisteán a bhfuil carr amháin nó níos mó aige sa suíomh reatha. Tá an fhianaise bunaithe ar shonraí arna soláthar ag oibreoirí na linne gluaisteán iad féin. Arna thiomsú ag Sweco thar ceann an riaracháin comhshaoil."},{"@language":"hr-t-sv-t0-mtec","@value":"Točkasti sloj s postajama s bazenom za automobile od 2021. do 2024. Fiksna parkirna mjesta za stacionarne bazene za automobile (i u mjeri u kojoj besplatni plutajući bazeni za automobile također imaju fiksna parkirna mjesta). Prikazuje adresu i carpool operatora koji ima jedan ili više automobila na trenutnoj lokaciji. Dokazi se temelje na podacima koje su dostavili sami operatori udruženja automobila. Sastavio Sweco u ime uprave za zaštitu okoliša."},{"@language":"hu-t-sv-t0-mtec","@value":"Pontréteg autóparkoló állomásokkal 2021–2024-től. Helyhez kötött parkolóhelyek a helyhez kötött autómedencék számára (és amennyiben a szabad úszó autómedencék is rendelkeznek helyhez kötött parkolóhelyekkel). Megjeleníti azt a címet és telekocsi-üzemeltetőt, amelynek egy vagy több autója van az aktuális helyen. A bizonyítékok maguk az autópark-üzemeltetők által szolgáltatott adatokon alapulnak. A Sweco állította össze a környezetvédelmi hatóság nevében."},{"@language":"it-t-sv-t0-mtec","@value":"Livello a punti con stazioni di car pooling dal 2021 al 2024. Posti auto fissi per piscine di auto stazionarie (e nella misura in cui le piscine di auto galleggianti gratuite hanno anche posti auto fissi). Visualizza l'indirizzo e l'operatore di carpool che ha una o più auto nella posizione corrente. Le prove si basano sui dati forniti dagli stessi gestori di car pool. Compilato da Sweco per conto dell'amministrazione ambientale."},{"@language":"lt-t-sv-t0-mtec","@value":"Taškinis lygmuo su automobilių baseinų stotimis 2021–2024 m. stacionarios automobilių stovėjimo vietos stacionariems automobilių baseinams (ir, kiek tai susiję su laisvais plūduriuojančiais automobilių baseinais, taip pat yra stacionarios automobilių stovėjimo vietos). Rodo adresą ir Carpool operatorius, kuris turi vieną ar daugiau automobilių dabartinėje vietoje. Įrodymai grindžiami pačių automobilių susivienijimo operatorių pateiktais duomenimis. Parengė „Sweco“ aplinkos apsaugos administracijos vardu."},{"@language":"lv-t-sv-t0-mtec","@value":"Punktu slānis ar automašīnu baseinu stacijām no 2021. līdz 2024. gadam. Stacionāras stāvvietas stacionāriem automašīnu baseiniem (un, ciktāl bezmaksas peldošiem automašīnu baseiniem ir arī stacionāras stāvvietas). Parāda adresi un carpool operatoru, kam ir viena vai vairākas automašīnas pašreizējā atrašanās vietā. Pierādījumi ir balstīti uz datiem, ko snieguši paši automobiļu kopfonda operatori. Sagatavojis Sweco vides pārvaldes vārdā."},{"@language":"mt-t-sv-t0-mtec","@value":"Saff ta’ punti bi stazzjonijiet tal-pools tal-karozzi mill-2021-2024. L-ispazji fissi tal-parkeġġ għall-pixxini tal-karozzi stazzjonarji (u sal-punt li l-pixxini tal-karozzi li jżommu f’wiċċ l-ilma mingħajr ħlas ikollhom ukoll spazji fissi tal-parkeġġ). Juri l-indirizz u l-operatur tal-carpool li għandu karozza waħda jew aktar fil-post attwali. L-evidenza hija bbażata fuq data pprovduta mill-operaturi tal-pools tal-karozzi nfushom. Ikkompilat minn Sweco f'isem l-amministrazzjoni ambjentali."},{"@language":"nl-t-sv-t0-mtec","@value":"Puntenlaag met carpoolstations van 2021-2024. Vaste parkeerplaatsen voor stilstaande autopools (en voor zover gratis drijvende autopools ook vaste parkeerplaatsen hebben). Geeft het adres en de carpooloperator weer die een of meer auto's op de huidige locatie heeft. Het bewijsmateriaal is gebaseerd op gegevens die door de exploitanten van de carpool zelf zijn verstrekt. Samengesteld door Sweco namens de milieuadministratie."},{"@language":"pl-t-sv-t0-mtec","@value":"Warstwa punktowa ze stacjami basenów samochodowych w latach 2021–2024. Stałe miejsca parkingowe dla nieruchomych basenów samochodowych (oraz w zakresie, w jakim wolne pływające baseny samochodowe mają również stałe miejsca parkingowe). Wyświetla adres i operatora carpool, który ma jeden lub więcej samochodów w bieżącej lokalizacji. Dowody opierają się na danych dostarczonych przez samych operatorów basenów samochodowych. Opracowany przez Sweco w imieniu administracji ds. ochrony środowiska."},{"@language":"pt-t-sv-t0-mtec","@value":"Camada de pontos com estações de reserva de automóveis entre 2021 e 2024. Lugares de estacionamento fixos para piscinas de automóveis estacionárias (e, na medida em que as piscinas de automóveis flutuantes também dispõem de lugares de estacionamento fixos). Exibe o endereço e o operador de carpool que tem um ou mais carros no local atual. Os elementos de prova baseiam-se em dados fornecidos pelos próprios operadores de parques de estacionamento. Compilado pela Sweco em nome da administração ambiental."},{"@language":"ro-t-sv-t0-mtec","@value":"Strat punct cu stații de parcare în perioada 2021-2024. Locuri de parcare fixe pentru piscinele auto staționare (și, în măsura în care piscinele auto plutitoare gratuite au, de asemenea, locuri de parcare fixe). Afișează adresa și operatorul carpool care are una sau mai multe mașini în locația curentă. Dovezile se bazează pe datele furnizate chiar de operatorii grupului de autoturisme. Compilată de Sweco în numele administrației de mediu."},{"@language":"sk-t-sv-t0-mtec","@value":"Bodová vrstva so stanicami automobilového bazéna v rokoch 2021 – 2024. Pevné parkovacie miesta pre stacionárne bazény s automobilmi (a v rozsahu, v akom voľné plávajúce bazény s automobilmi majú aj pevné parkovacie miesta). Zobrazí adresu a carpool operátora, ktorý má jedno alebo viac áut v aktuálnom mieste. Dôkazy vychádzajú z údajov, ktoré poskytli samotní prevádzkovatelia združení automobilov. Vypracovala spoločnosť Sweco v mene environmentálnej správy."},{"@language":"sl-t-sv-t0-mtec","@value":"Točkovni sloj s postajami za avtomobilske bazene v obdobju 2021–2024. Fiksna parkirna mesta za stacionarne bazene za avtomobile (in v obsegu prostih plavajočih bazenov za avtomobile imajo tudi fiksna parkirna mesta). Prikaže naslov in operaterja carpool, ki ima enega ali več avtomobilov na trenutni lokaciji. Dokazi temeljijo na podatkih, ki so jih predložili sami upravljavci skupin vozil. Pripravil Sweco v imenu okoljske uprave."},{"@language":"sv","@value":"Punktskikt med bilpoolsstationer från 2021-2024. Fasta parkeringsplatser för stationära bilpooler (och i den mån friflytande bilpooler även har fasta parkeringsplatser). Visar adress och bilpoolsoperatör som har en eller flera bilar på aktuell plats. Underlaget bygger på uppgifter från bilpoolsoperatörerna själva. Sammanställt av Sweco på uppdrag av miljöförvaltningen."},{"@language":"uk-t-sv-t0-mtec","@value":"Точковий шар зі станціями автомобільного басейну з 2021-2024 рр. Фіксовані паркувальні місця для стаціонарних автомобільних басейнів (і до такої міри вільні плавучі автомобільні басейни також мають стаціонарні паркувальні місця). Відображає адресу та оператора автомобільного басейну, який має один або кілька автомобілів у поточному розташуванні. Докази засновані на даних, наданих самими операторами автомобільного пулу. Складений Sweco від імені екологічної адміністрації."}],"dct:format":"text/html","dct:identifier":"1e2d37d6-1bbe-4c51-b182-f03854c13a9c","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c98569c032e2553318ca537e498e36ab65e43b84331f4162450e783e5ba5c545_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Резерви от автомобили за периода 2021—2024 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Bazény automobilů na období 2021–2024"},{"@language":"da-t-sv-t0-mtec","@value":"Bilpuljer 2021-2024"},{"@language":"de-t-sv-t0-mtec","@value":"Autopools 2021-2024"},{"@language":"el-t-sv-t0-mtec","@value":"Δεξαμενές αυτοκινήτων 2021-2024"},{"@language":"en-t-sv-t0-mtec","@value":"Car pools 2021-2024"},{"@language":"es-t-sv-t0-mtec","@value":"Piscinas de coches 2021-2024"},{"@language":"et-t-sv-t0-mtec","@value":"Autopargid 2021–2024"},{"@language":"fi-t-sv-t0-mtec","@value":"Autopoolit 2021–2024"},{"@language":"fr-t-sv-t0-mtec","@value":"Parkings collectifs 2021-2024"},{"@language":"ga-t-sv-t0-mtec","@value":"Comhthiomsuithe gluaisteán 2021-2024"},{"@language":"hr-t-sv-t0-mtec","@value":"Bazeni automobila za razdoblje 2021. 2024."},{"@language":"hu-t-sv-t0-mtec","@value":"Autóparkok (2021–2024)"},{"@language":"it-t-sv-t0-mtec","@value":"Car pools 2021-2024"},{"@language":"lt-t-sv-t0-mtec","@value":"Automobilių baseinai 2021–2024 m."},{"@language":"lv-t-sv-t0-mtec","@value":"Automobiļu kopfondi 2021.–2024. gadā"},{"@language":"mt-t-sv-t0-mtec","@value":"Raggruppamenti ta’ karozzi 2021-2024"},{"@language":"nl-t-sv-t0-mtec","@value":"Autopools 2021-2024"},{"@language":"pl-t-sv-t0-mtec","@value":"Baseny samochodowe 2021–2024"},{"@language":"pt-t-sv-t0-mtec","@value":"Reservas de automóveis 2021-2024"},{"@language":"ro-t-sv-t0-mtec","@value":"Piscine auto 2021-2024"},{"@language":"sk-t-sv-t0-mtec","@value":"Bazény pre autá na roky 2021 – 2024"},{"@language":"sl-t-sv-t0-mtec","@value":"Združenja avtomobilov v obdobju 2021–2024"},{"@language":"sv","@value":"Bilpooler 2021-2024"},{"@language":"uk-t-sv-t0-mtec","@value":"Автомобільні басейни 2021-2024"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/456a7679-6a1b-47f8-8b1e-6ffe06be1c8c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/f9b5d141c1694ceb827cf335be9bedd0_9/explore"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c#HTTP:ESRI+Portal-URL/2","dct:title":["Miljöförvaltningens Öppna data-hub",{"@language":"bg-t-sv-t0-mtec","@value":"Център за отворени данни за управление на околната среда"},{"@language":"cs-t-sv-t0-mtec","@value":"Centrum otevřených dat environmentálního managementu"},{"@language":"da-t-sv-t0-mtec","@value":"Miljøledelsens åbne datacenter"},{"@language":"de-t-sv-t0-mtec","@value":"Open Data Hub des Umweltmanagements"},{"@language":"el-t-sv-t0-mtec","@value":"Open Data Hub Περιβαλλοντικής Διαχείρισης"},{"@language":"en-t-sv-t0-mtec","@value":"Environmental Management's Open Data Hub"},{"@language":"es-t-sv-t0-mtec","@value":"Centro de Datos Abiertos de Gestión Ambiental"},{"@language":"et-t-sv-t0-mtec","@value":"Keskkonnajuhtimise avatud andmekeskus"},{"@language":"fi-t-sv-t0-mtec","@value":"Ympäristöjohtamisen avoimen datan keskus"},{"@language":"fr-t-sv-t0-mtec","@value":"Hub de données ouvertes de la gestion environnementale"},{"@language":"ga-t-sv-t0-mtec","@value":"Mol Sonraí Oscailte na Bainistíochta C