lue":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6db010bf-8047-425d-b71b-535cd959baaf"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Platser där åtgärder ska göras för att förbättra vattenkvaliteten inom det Lokala Åtgärdsprogrammet. Områdena har tagits fram av Utredningsenheten på Ledningnät i samarbete med berörda kommuner."},"dct:identifier":"3908b733-6e24-4aeb-8a66-b4da5b584290","dct:issued":{"@type":"xsd:date","@value":"2023-05-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-02-03"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/"},"dct:spatial":{"@id":"_:162546e33ed04d36047daaf91802916a11afdb1bf3d68270a5139c2b391a0eb1_b0n0"},"dct:title":{"@language":"sv","@value":"LÅP-åtgärder SVOA - Öppna data"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/3908b733-6e24-4aeb-8a66-b4da5b584290#HTTP:Information/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-svoa2.hub.arcgis.com/maps/5ff3b25e59c3407e80980cc4911da3ed"},"dct:description":"LÅP-åtgärder SVOA","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Stockholm Vatten och Avfall - Öppna data"},{"@id":"https://resources.stockholm.se/data/3908b733-6e24-4aeb-8a66-b4da5b584290#HTTP:OGC:WMS/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata-svoa-extern.stockholm.se/Geodata/arcgis/services/Dagvatten/LAP_atgarder_SVOA/MapServer/WMSServer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"LÅP-åtgärder SVOA"},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:gis@svoa.se"},"foaf:name":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"foaf:phone":{"@id":"tel:+08-52212000"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis@svoa.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-52212000"}}],"@id":"urn:source:162546e33ed04d36047daaf91802916a11afdb1bf3d68270a5139c2b391a0eb1"},{"@graph":[{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-22"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-22"}},{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1a1c7d47b26debe0e13f68b0f16482c7ab"},{"@id":"http://data.europa.eu/88u/dataset/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/6395ee02-4f4d-4e96-8b79-62894b2a76b0"},{"@id":"http://data.europa.eu/88u/distribution/6697183c-68d3-4415-b48e-31f7782acd8f"},{"@id":"http://data.europa.eu/88u/distribution/b1600728-3fd0-4481-82d6-fa92ad1cfe9e"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"SBK Planeringsunderlag"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=3c463b5f-2b62-4b62-b131-a3eefcad2515"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-01-10"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Координираните и повишени точки във файла с координатната мрежа се основават на данни от въздушно лазерно сканиране над град Стокхолм в периода 9 април — 7 май 2024 г. Плътността на точките в първоначалния точков облак е най-малко 16 точки/m2 на земята. Елементите не се актуализират след създаването им. Данните се интерполират в координатна мрежа с разделителна способност 1 m. Това означава, че за райони, в които почвата се е променила след сканирането, координатите на точките не съвпадат. Точките в слоя \"Скрита земя\" показват интерполираната височина на земята под съществуващите сгради. Точките в слоя \"Dolt Water\" показват интерполираната височина на водата под съществуващите мостове. Известните височини са наситени около мостовете. Мрежовите точки за вода се основават на височините и разпределението на водните повърхности в базовата карта."},{"@language":"cs-t-sv-t0-mtec","@value":"Koordinované a zvýšené body v souboru mřížky jsou založeny na údajích z leteckého laserového skenování nad městem Stockholm v období od 9. dubna do 7. května 2024. Hustota bodů v původním bodovém oblaku je nejméně 16 bodů/m2 na zemi. Položky se po vytvoření neaktualizují. Data se interpolují do mřížky s rozlišením 1 m. To znamená, že v oblastech, kde se půda od skenování změnila, se souřadnice bodů neshodují. Body ve vrstvě \"Skrytá země\" ukazují interpolovanou výšku země pod stávajícími budovami. Body ve vrstvě \"Dolt Water\" ukazují interpolovanou výšku vody pod stávajícími mosty. Známé výšky jsou nasyceny kolem mostů. Mřížkové body pro vodu jsou založeny na výškách a rozložení vodních ploch v základní mapě."},{"@language":"da-t-sv-t0-mtec","@value":"De koordinerede og forhøjede punkter i netfilen er baseret på data fra luftbåren laserscanning over Stockholm by i perioden 9. april-7. maj 2024. Punkttætheden i den oprindelige punktsky er mindst 16 punkter/m2 på jorden. Elementer opdateres ikke, når de er oprettet. Dataene interpoleres til et gitter med en opløsning på 1 m. Det betyder, at for områder, hvor jorden har ændret sig siden scanningen, stemmer punkternes koordinater ikke overens. Punkterne i laget \"Skjult jord\" viser den interpolerede jordhøjde under eksisterende bygninger. Punkterne i \"Dolt Water\" laget viser den interpolerede højde af vand under eksisterende broer. De kendte højder er mættet omkring broerne. Gitterpunkter for vand er baseret på højder og fordeling af vandoverflader i basiskortet."},{"@language":"de-t-sv-t0-mtec","@value":"Die koordinierten und erhöhten Punkte in der Rasterdatei basieren auf Daten aus dem luftgestützten Laserscanning über der Stadt Stockholm im Zeitraum vom 9. April bis 7. Mai 2024. Die Punktdichte in der ursprünglichen Punktwolke beträgt mindestens 16 Punkte/m2 am Boden. Elemente werden nicht aktualisiert, nachdem sie erstellt wurden. Die Daten werden auf ein Raster mit einer Auflösung von 1 m interpoliert, was bedeutet, dass für Bereiche, in denen sich der Boden seit dem Scan verändert hat, die Koordinaten der Punkte nicht übereinstimmen. Die Punkte in der Ebene \"Versteckter Boden\" zeigen die interpolierte Bodenhöhe unter Bestandsgebäuden. Die Punkte in der Schicht \"Dolt Water\" zeigen die interpolierte Höhe des Wassers unter bestehenden Brücken. Die bekannten Höhen sind rund um die Brücken gesättigt. Gitterpunkte für Wasser basieren auf den Höhen und der Verteilung der Wasseroberflächen in der Grundkarte."},{"@language":"el-t-sv-t0-mtec","@value":"Τα συντονισμένα και υπερυψωμένα σημεία στο αρχείο πλέγματος βασίζονται σε δεδομένα από αερομεταφερόμενη σάρωση με λέιζερ πάνω από τον δήμο της Στοκχόλμης κατά την περίοδο 9 Απριλίου - 7 Μαΐου 2024. Η πυκνότητα των σημείων στο αρχικό νέφος σημείων είναι τουλάχιστον 16 σημεία/m2 στο έδαφος. Τα στοιχεία δεν ενημερώνονται μετά τη δημιουργία τους. Τα δεδομένα παρεμβάλλονται σε πλέγμα με ανάλυση 1 m. Αυτό σημαίνει ότι για περιοχές όπου το έδαφος έχει αλλάξει μετά τη σάρωση, οι συντεταγμένες των σημείων δεν ταιριάζουν. Τα σημεία στο στρώμα \"Κρυφό έδαφος\" δείχνουν το παρεμβαλλόμενο ύψος του εδάφους κάτω από τα υπάρχοντα κτίρια. Τα σημεία στο στρώμα \"Dolt Water\" δείχνουν το παρεμβαλλόμενο ύψος του νερού κάτω από τις υπάρχουσες γέφυρες. Τα γνωστά ύψη είναι κορεσμένα γύρω από τις γέφυρες. Τα σημεία πλέγματος για το νερό βασίζονται στα ύψη και την κατανομή των επιφανειών νερού στον βασικό χάρτη."},{"@language":"en-t-sv-t0-mtec","@value":"The coordinated and elevated points in the grid file are based on data from airborne laser scanning over the City of Stockholm during the period 9 April - 7 May 2024. The point density in the original point cloud is at least 16 points/m2 on the ground. Items are not updated after they are created. The data is interpolated to a grid with a resolution of 1 m. This means that for areas where the soil has changed since the scan, the coordinates of the points do not match. The points in the layer \"Hidden ground\" show the interpolated ground height under existing buildings. The points in the \"Dolt Water\" layer show the interpolated height of water under existing bridges. The known heights are saturated around the bridges. Grid points for water are based on the heights and distribution of water surfaces in the base map."},{"@language":"es-t-sv-t0-mtec","@value":"Los puntos coordinados y elevados en el archivo de cuadrícula se basan en datos del escaneo láser aerotransportado sobre la ciudad de Estocolmo durante el período comprendido entre el 9 de abril y el 7 de mayo de 2024. La densidad de puntos en la nube de puntos original es de al menos 16 puntos/m2 en el suelo. Los elementos no se actualizan después de su creación. Los datos se interpolan a una cuadrícula con una resolución de 1 m. Esto significa que para las áreas donde el suelo ha cambiado desde el escaneo, las coordenadas de los puntos no coinciden. Los puntos de la capa \"Tierra oculta\" muestran la altura interpolada del suelo debajo de los edificios existentes. Los puntos en la capa \"Dolt Water\" muestran la altura interpolada del agua debajo de los puentes existentes. Las alturas conocidas están saturadas alrededor de los puentes. Los puntos de rejilla para el agua se basan en las alturas y la distribución de las superficies de agua en el mapa base."},{"@language":"et-t-sv-t0-mtec","@value":"Võrgufailis olevad koordineeritud ja kõrgemad punktid põhinevad ajavahemikul 9. aprillist kuni 7. maini 2024 Stockholmi linna kohal õhus tehtud laserskaneerimise andmetel. Algse punktpilve punkttihedus on maapinnal vähemalt 16 punkti/m2. Esemeid ei värskendata pärast nende loomist. Andmed interpoleeritakse 1 m eraldusvõimega ruutvõrku. See tähendab, et alade puhul, kus muld on pärast skaneerimist muutunud, ei lange punktide koordinaadid kokku. Kihi \"Peidetud maa\" punktid näitavad interpoleeritud maapinna kõrgust olemasolevate hoonete all. \"Dolt Water\" kihi punktid näitavad vee interpoleeritud kõrgust olemasolevate sildade all. Teadaolevad kõrgused on sillade ümber küllastunud. Vee võrgupunktid põhinevad aluskaardil olevate veepindade kõrgusel ja jaotusel."},{"@language":"fi-t-sv-t0-mtec","@value":"Koordinoidut ja korotetut pisteet ruudukkotiedostossa perustuvat Tukholman kaupungin yllä 9.4.–7.5.2024 tehdystä laserkeilauksesta saatuihin tietoihin. Pistetiheys alkuperäisessä pistepilvessä on vähintään 16 pistettä/m2 maassa. Kohteita ei päivitetä niiden luomisen jälkeen. Tiedot interpoloidaan ruudukkoon, jonka resoluutio on 1 m. Tämä tarkoittaa, että alueilla, joilla maaperä on muuttunut skannauksen jälkeen, pisteiden koordinaatit eivät vastaa toisiaan. Kerroksen \"Piilotettu maa\" pisteet osoittavat interpoloidun maan korkeuden olemassa olevien rakennusten alla. \"Dolt Water\" -kerroksen pisteet osoittavat veden interpoloidun korkeuden olemassa olevien siltojen alla. Tunnetut korkeudet ovat kyllästettyjä siltojen ympärillä. Veden ruudukkopisteet perustuvat pohjakartan vedenpinnan korkeuteen ja jakautumiseen."},{"@language":"fr-t-sv-t0-mtec","@value":"Les points coordonnés et élevés dans le fichier de grille sont basés sur les données du balayage laser aérien au-dessus de la ville de Stockholm au cours de la période allant du 9 avril au 7 mai 2024. La densité de points dans le nuage de points d'origine est d'au moins 16 points/m2 au sol. Les éléments ne sont pas mis à jour après leur création. Les données sont interpolées sur une grille avec une résolution de 1 m. Cela signifie que pour les zones où le sol a changé depuis le balayage, les coordonnées des points ne correspondent pas. Les points de la couche \"terrain caché\" montrent la hauteur interpolée du sol sous les bâtiments existants. Les points de la couche \"Dolt Water\" montrent la hauteur interpolée de l'eau sous les ponts existants. Les hauteurs connues sont saturées autour des ponts. Les points de grille pour l'eau sont basés sur les hauteurs et la répartition des surfaces d'eau dans la carte de base."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá na pointí comhordaithe agus ardaithe sa chomhad greille bunaithe ar shonraí ó scanadh léasair aerbheirthe thar Chathair Stócólm le linn na tréimhse ón 9 Aibreán go dtí an 7 Bealtaine 2024. Tá an dlús pointe sa scamall pointe bunaidh 16 pointe / m2 ar a laghad ar an talamh. Ní dhéantar na míreanna a nuashonrú tar éis iad a chruthú. Déantar na sonraí a idirshuí le greille ag a bhfuil taifeach 1 m. Ciallaíonn sé sin, i gcás limistéir ina bhfuil athrú tagtha ar an ithir ó rinneadh an scanadh, nach bhfuil comhordanáidí na bpointí ag teacht le chéile. Léiríonn na pointí sa tsraith ‘Talamh folaithe’ an airde talún idirshuite faoi fhoirgnimh atá ann cheana. Taispeánann na pointí sa chiseal \"Uisce Dolt\" airde idirshuite an uisce faoi dhroichid atá ann cheana. Tá na hairdí aitheanta sáithithe timpeall na ndroichead. Tá pointí eangaí le haghaidh uisce bunaithe ar airde agus dáileadh dromchlaí uisce sa bhunmhapa."},{"@language":"hr-t-sv-t0-mtec","@value":"Koordinirane i povišene točke u datoteci mreže temelje se na podacima iz laserskog skeniranja u zraku iznad grada Stockholma u razdoblju od 9. travnja do 7. svibnja 2024. Gustoća točke u izvornom oblaku točke iznosi najmanje 16 točaka/m2 na tlu. Stavke se ne ažuriraju nakon što su stvorene. Podaci se interpoliraju u mrežu razlučivosti 1 m. To znači da se za područja na kojima se tlo promijenilo nakon skeniranja koordinate točaka ne podudaraju. Točke u sloju \"Skriveno tlo\" pokazuju interpoliranu visinu tla ispod postojećih zgrada. Točke u sloju \"Dolt Water\" pokazuju interpoliranu visinu vode ispod postojećih mostova. Poznate visine su zasićene oko mostova. Mrežne točke za vodu temelje se na visinama i raspodjeli vodenih površina na osnovnoj karti."},{"@language":"hu-t-sv-t0-mtec","@value":"A hálózati fájl összehangolt és emelt pontjai a Stockholm városa felett a 2024. április 9. és május 7. közötti időszakban végzett, levegőben végzett lézerszkennelésből származó adatokon alapulnak. Az eredeti pontfelhőben a pontsűrűség legalább 16 pont/m2 a földön. Az elemek a létrehozásuk után nem frissülnek. Az adatokat 1 m felbontású rácsra interpolálják. Ez azt jelenti, hogy azokon a területeken, ahol a szkennelés óta megváltozott a talaj, a pontok koordinátái nem egyeznek meg. A \"Rejtett talaj\" réteg pontjai a meglévő épületek alatti interpolált talajmagasságot mutatják. A \"Dolt víz\" réteg pontjai a meglévő hidak alatti víz interpolált magasságát mutatják. Az ismert magasságok telítettek a hidak körül. A vízhálózati pontok az alaptérképen szereplő vízfelületek magasságán és eloszlásán alapulnak."},{"@language":"it-t-sv-t0-mtec","@value":"I punti coordinati ed elevati nel file della griglia si basano sui dati della scansione laser in volo sulla città di Stoccolma nel periodo dal 9 aprile al 7 maggio 2024. La densità del punto nella nuvola di punti originale è di almeno 16 punti / m2 sul terreno. Gli elementi non vengono aggiornati dopo la loro creazione. I dati vengono interpolati su una griglia con una risoluzione di 1 m. Ciò significa che per le aree in cui il terreno è cambiato dopo la scansione, le coordinate dei punti non corrispondono. I punti nello strato \"Terra nascosta\" mostrano l'altezza interpolata del terreno sotto gli edifici esistenti. I punti dello strato \"Dolt Water\" mostrano l'altezza interpolata dell'acqua sotto i ponti esistenti. Le altezze conosciute sono sature intorno ai ponti. I punti di griglia per l'acqua si basano sulle altezze e sulla distribuzione delle superfici dell'acqua nella mappa di base."},{"@language":"lt-t-sv-t0-mtec","@value":"Koordinuoti ir padidinti tinklelio rinkmenos taškai grindžiami 2024 m. balandžio 9 d. – gegužės 7 d. Stokholmo miesto lazerinio skenavimo ore duomenimis. Taškų tankis pradiniame taškų debesyje yra ne mažesnis kaip 16 taškų/m2 ant žemės. Elementai nėra atnaujinami po to, kai jie yra sukurti. Duomenys interpoliuojami į 1 m skiriamosios gebos tinklelį. Tai reiškia, kad plotuose, kuriuose po skenavimo pasikeitė dirvožemis, taškų koordinatės nesutampa. Sluoksnio \"Paslėpta žemė\" taškai rodo interpoliuotą žemės aukštį po esamais pastatais. \"Dolto vandens\" sluoksnio taškai rodo interpoliuotą vandens aukštį po esamais tiltais. Žinomos aukštumos yra prisotintos aplink tiltus. Vandens tinklelio taškai yra pagrįsti vandens paviršių aukščiu ir pasiskirstymu pagrindiniame žemėlapyje."},{"@language":"lv-t-sv-t0-mtec","@value":"Koordinētie un paaugstinātie punkti režģa datnē ir balstīti uz datiem no lāzerskenēšanas gaisā Stokholmas pilsētā laikposmā no 2024. gada 9. aprīļa līdz 7. maijam. Punktu blīvums sākotnējā punktu mākonī ir vismaz 16 punkti/m2 uz zemes. Pēc izveides vienumi netiek atjaunināti. Datus interpolē uz koordinātu tīklu ar izšķirtspēju 1 m. Tas nozīmē, ka vietās, kur augsne kopš skenēšanas ir mainījusies, punktu koordinātas nesakrīt. Punkti slānī \"Slēpta zeme\" parāda interpolēto zemes augstumu zem esošajām ēkām. Punkti \"Dolt Water\" slānī parāda ūdens interpolēto augstumu zem esošajiem tiltiem. Zināmie augstumi ir piesātināti ap tiltiem. Režģa punkti ūdenim ir balstīti uz ūdens virsmu augstumu un sadalījumu bāzes kartē."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-punti kkoordinati u elevati fil-fajl tal-grilja huma bbażati fuq data minn skennjar bil-laser fl-ajru fuq il-Belt ta' Stokkolma matul il-perjodu 9 ta' April - 7 ta' Mejju 2024. Id-densità tal-punt fis-sħaba tal-punt oriġinali hija mill-inqas 16-il punt/m2 fuq l-art. L-oġġetti ma jiġux aġġornati wara li jinħolqu. Id-data tiġi interpolata ma’ grilja b’riżoluzzjoni ta’ 1 m. Dan ifisser li għal żoni fejn il-ħamrija nbidlet mill-iskan, il-koordinati tal-punti ma jaqblux. Il-punti fis-saff “Art moħbija” juru l-għoli tal-art interpolat taħt bini eżistenti. Il-punti fis-saff \"Dolt Water\" juru l-għoli interpolat tal-ilma taħt il-pontijiet eżistenti. L-għoli magħruf huwa saturat madwar il-pontijiet. Il-punti tal-grilja għall-ilma huma bbażati fuq l-għoli u d-distribuzzjoni tal-uċuħ tal-ilma fil-mappa bażi."},{"@language":"nl-t-sv-t0-mtec","@value":"De gecoördineerde en verhoogde punten in het rasterbestand zijn gebaseerd op gegevens van laserscanning in de lucht boven de stad Stockholm in de periode van 9 april tot en met 7 mei 2024. De puntdichtheid in de oorspronkelijke puntwolk bedraagt ten minste 16 punten/m2 op de grond. Items worden niet bijgewerkt nadat ze zijn gemaakt. De gegevens worden geïnterpoleerd naar een raster met een resolutie van 1 m. Dit betekent dat voor gebieden waar de bodem sinds de scan is veranderd, de coördinaten van de punten niet overeenkomen. De punten in de laag \"Verborgen grond\" tonen de geïnterpoleerde grondhoogte onder bestaande gebouwen. De punten in de laag \"Dolt Water\" tonen de geïnterpoleerde hoogte van het water onder bestaande bruggen. De bekende hoogtes zijn verzadigd rond de bruggen. Netpunten voor water zijn gebaseerd op de hoogte en verdeling van wateroppervlakken in de basiskaart."},{"@language":"pl-t-sv-t0-mtec","@value":"Skoordynowane i podwyższone punkty w pliku siatki opierają się na danych z lotniczego skanowania laserowego nad miastem Sztokholm w okresie od 9 kwietnia do 7 maja 2024 r. Gęstość punktów w pierwotnej chmurze punktów wynosi co najmniej 16 punktów/m2 na ziemi. Elementy nie są aktualizowane po ich utworzeniu. Dane są interpolowane do siatki o rozdzielczości 1 m. Oznacza to, że w przypadku obszarów, w których gleba zmieniła się od czasu skanowania, współrzędne punktów nie są zgodne. Punkty w warstwie \"Ukryte podłoże\" pokazują interpolowaną wysokość podłoża pod istniejącymi budynkami. Punkty w warstwie \"Dolt Water\" pokazują interpolowaną wysokość wody pod istniejącymi mostami. Znane wysokości są nasycone wokół mostów. Punkty siatki dla wody są oparte na wysokościach i rozmieszczeniu powierzchni wody na mapie bazowej."},{"@language":"pt-t-sv-t0-mtec","@value":"Os pontos coordenados e elevados no ficheiro da grelha baseiam-se em dados de varrimento a laser aéreo sobre a cidade de Estocolmo durante o período de 9 de abril a 7 de maio de 2024. A densidade de pontos na nuvem de pontos original é de pelo menos 16 pontos/m2 no solo. Os itens não são atualizados depois de serem criados. Os dados são interpolados para uma grelha com uma resolução de 1 m. Isto significa que, para áreas onde o solo mudou desde a varredura, as coordenadas dos pontos não coincidem. Os pontos na camada \"Terra oculta\" mostram a altura do solo interpolada sob os edifícios existentes. Os pontos na camada \"Dolt Water\" mostram a altura interpolada da água sob as pontes existentes. As alturas conhecidas estão saturadas em torno das pontes. Os pontos de grelha para a água baseiam-se nas alturas e na distribuição das superfícies de água no mapa de base."},{"@language":"ro-t-sv-t0-mtec","@value":"Punctele coordonate și ridicate din fișierul de rețea se bazează pe datele obținute prin scanarea cu laser în aer deasupra orașului Stockholm în perioada 9 aprilie-7 mai 2024. Densitatea punctului în norul de puncte original este de cel puțin 16 puncte/m2 pe sol. Elementele nu sunt actualizate după ce au fost create. Datele sunt interpolate într-o rețea cu o rezoluție de 1 m. Aceasta înseamnă că, pentru zonele în care solul s-a schimbat de la scanare, coordonatele punctelor nu se potrivesc. Punctele din stratul \"Teren ascuns\" arată înălțimea interpolată a solului sub clădirile existente. Punctele din stratul \"Dolt Water\" arată înălțimea interpolată a apei sub podurile existente. Înălțimile cunoscute sunt saturate în jurul podurilor. Punctele de rețea pentru apă se bazează pe înălțimile și distribuția suprafețelor de apă din harta de bază."},{"@language":"sk-t-sv-t0-mtec","@value":"Koordinované a zvýšené body v súbore mriežky sú založené na údajoch z leteckého laserového skenovania nad mestom Štokholm v období od 9. apríla do 7. mája 2024. Hustota bodu v pôvodnom bodovom oblaku je najmenej 16 bodov/m2 na zemi. Položky sa po vytvorení neaktualizujú. Údaje sa interpolujú do mriežky s rozlíšením 1 m. To znamená, že v oblastiach, kde sa pôda od skenovania zmenila, sa súradnice bodov nezhodujú. Body vo vrstve \"Skrytá zem\" zobrazujú interpolovanú výšku zeme pod existujúcimi budovami. Body vo vrstve \"Dolt Water\" ukazujú interpolovanú výšku vody pod existujúcimi mostami. Známe výšky sú nasýtené okolo mostov. Mriežkové body pre vodu sú založené na výškach a rozložení vodných plôch v základnej mape."},{"@language":"sl-t-sv-t0-mtec","@value":"Usklajene in povišane točke v mrežni datoteki temeljijo na podatkih iz laserskega skeniranja v zraku nad mestom Stockholm v obdobju od 9. aprila do 7. maja 2024. Gostota točk v prvotnem oblaku točk je najmanj 16 točk/m2 na tleh. Elementi se ne posodabljajo, ko so ustvarjeni. Podatki se interpolirajo v mrežo z ločljivostjo 1 m. To pomeni, da se na območjih, kjer so se tla od skeniranja spremenila, koordinate točk ne ujemajo. Točke v sloju \"Skrita tla\" prikazujejo interpolirano višino tal pod obstoječimi stavbami. Točke v sloju \"Dolt Water\" prikazujejo interpolirano višino vode pod obstoječimi mostovi. Znane višine so nasičene okoli mostov. Omrežne točke za vodo temeljijo na višini in porazdelitvi vodnih površin na osnovnem zemljevidu."},{"@language":"sv","@value":"De koordinatsatta och höjdsatta punkterna i gridfilen är baserade på data från flygburen laserskanning över Stockholms stad under perioden 9 april7 maj 2024. Punkttätheten i originalpunktmolnet är minst 16 punkter/m2 på marken. Punkterna ajourförs inte sedan de skapas. Datat är interpolerat till ett grid med upplösning 1 m. Det innebär att för områden där marken har förändrats sedan skanningstillfället, stämmer inte koordinaterna för punkterna. Punkterna i lagret Dold mark visar den interpolerade markhöjden under befintliga byggnader. De kända höjderna är mätta runtom byggnaden.Punkterna i lagret Dolt vatten visar den interpolerade vattenhöjden under befintliga broar. De kända höjderna är mätta runtom broarna. Gridpunkter för vatten är baserade på höjder och utbredning av vattenytor i baskartan."},{"@language":"uk-t-sv-t0-mtec","@value":"Координовані та підвищені точки у файлі сітки базуються на даних повітряного лазерного сканування над містом Стокгольм у період з 9 квітня по 7 травня 2024 року. Щільність точок у початковій хмарі точок становить щонайменше 16 точок/м2 на землі. Елементи не оновлюються після їх створення. Дані інтерполюються в сітку з роздільною здатністю 1 м. Точки в шарі «Прихована земля» показують інтерпольовану висоту землі під існуючими будівлями. Точки в шарі «Долтова вода» показують інтерпольовану висоту води під існуючими мостами. Відомі висоти насичені навколо мостів. Точки сітки для води базуються на висоті та розподілі водних поверхонь на базовій карті."}],"dct:format":"text/html","dct:identifier":"ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b0n0"},"dct:temporal":{"@id":"_:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Höggrid (2024 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Höggridová (2024)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Höggrid (2024) (στα αγγλικά)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Höggrid (2024.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Höggrid (2024 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"},{"@language":"sv","@value":"SBK Höjdgrid (2024)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Höggrid (2024)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/6395ee02-4f4d-4e96-8b79-62894b2a76b0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Information/2","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити карти і геодані"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/6395ee02-4f4d-4e96-8b79-62894b2a76b0"}},{"@id":"http://data.europa.eu/88u/distribution/6697183c-68d3-4415-b48e-31f7782acd8f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/H%C3%B6jdgrid.dwg"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/ff7e5192-4d5d-433a-9d4d-b2d3f834f0a6#HTTP:Nedladdning:data/3","dct:title":["Testdata DWG-format",{"@language":"bg-t-sv-t0-mtec","@value":"Формат на DWG за данните от изпитванията"},{"@language":"cs-t-sv-t0-mtec","@value":"Zkušební data ve formátu DWG"},{"@language":"da-t-sv-t0-mtec","@value":"Prøvningsdata i DWG-format"},{"@language":"de-t-sv-t0-mtec","@value":"Testdaten DWG-Format"},{"@language":"el-t-sv-t0-mtec","@value":"Μορφότυπος δεδομένων δοκιμής DWG"},{"@language":"en-t-sv-t0-mtec","@value":"Test data DWG format"},{"@language":"es-t-sv-t0-mtec","@value":"Formato DWG de los datos de prueba"},{"@language":"et-t-sv-t0-mtec","@value":"Katseandmed DWG formaat"},{"@language":"fi-t-sv-t0-mtec","@value":"Testitiedot DWG-muodossa"},{"@language":"fr-t-sv-t0-mtec","@value":"Format DWG des données d'essai"},{"@language":"ga-t-sv-t0-mtec","@value":"Formáid DWG sonraí tástála"},{"@language":"hr-t-sv-t0-mtec","@value":"DWG format podataka o ispitivanju"},{"@language":"hu-t-sv-t0-mtec","@value":"Vizsgálati adatok DWG formátuma"},{"@language":"it-t-sv-t0-mtec","@value":"Dati di prova in formato DWG"},{"@language":"lt-t-sv-t0-mtec","@value":"DWG formato bandymų duomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Testa datu DWG formāts"},{"@language":"mt-t-sv-t0-mtec","@value":"Il-format tad-DWG tad-data tat-test"},{"@language":"nl-t-sv-t0-mtec","@value":"Testgegevens DWG-formaat"},{"@language":"pl-t-sv-t0-mtec","@value":"Dane testowe w formacie DWG"},{"@language":"pt-t-sv-t0-mtec","@value":"Formato DWG dos dados de ensaio"},{"@language":"ro-t-sv-t0-mtec","@value":"Formatul DWG al datelor de încercare"},{"@language":"sk-t-sv-t0-mtec","@value":"Skúšobné údaje vo formáte DWG"},{"@language":"sl-t-sv-t0-mtec","@value":"Preskusni podatki v obliki DWG"},{"@language":"uk-t-sv-t0-mtec","@value":"Перевірка даних у форматі DWG"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/6697183c-68d3-4415-b48e-31f7782acd8f"}},{"@id":"http://data.europa.eu/88u/distribution/b1600728-3fd0-4481-82d6-fa92ad1cfe9e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_H%C3%B6jdgrid.pdf"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/ff7e5192-4d5d-43