stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Nedladdning/3"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:OGC:WFS/4"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature4000040"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som representerar utbredning av trafikregel om tättbebyggt område, meddelad genom föreskrifter beslutade av kommunen. Tättbebyggt område är det område inom vilket kommunen utfärdar lokala trafikföreskrifter. Ett område får förklaras vara tättbebyggt område om det har stads- eller bykaraktär eller därmed jämförbart vägnät och bebyggelse. Tillhör verksamhet NVDB (Trafikverket). Utbredning: Stockholms län"},"dct:identifier":"f44ac005-c497-4235-b063-e8318a3abca0","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:edbda7408d6d140323f931057f765bb2bb56cd08f4d0cefde855b2afb4f75de2_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - Tättbebyggt område"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se/LvWS-2.2/Lv.asmx"},"dct:description":"Beskrivning av LvWS APIs olika metoder.","dct:title":"Tjänsteadress web service"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:Nedladdning/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:NVDB_Tattbebyggt_omrade&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:OGC:WFS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:NVDB_Tattbebyggt_omrade"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/f44ac005-c497-4235-b063-e8318a3abca0#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:NVDB_Tattbebyggt_omrade"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:edbda7408d6d140323f931057f765bb2bb56cd08f4d0cefde855b2afb4f75de2"},{"@graph":[{"@id":"_:ee5c9f21933bdc4b2e05313abcce7d95cbadb21810bfe55b395e26b1422adf5c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:ee5c9f21933bdc4b2e05313abcce7d95cbadb21810bfe55b395e26b1422adf5c_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"150c85d800a2643d34518ca93bf25e1d09"},{"@id":"http://data.europa.eu/88u/dataset/88f534a5-bcb6-439a-a067-b5e6079a1d3c","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/d492c8cb-0e6c-4850-8477-565c6245534a"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f8c5e7e8-a792-4bd4-915d-873ef3feaba9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта - Номерът на парцела се състои от следните подтипове (подтипове) при информационната класификация за 2020 г. (за текущия списък вж. Обща продуктова спецификация Регистрационна карта) :450130, Подтипове на парцела10, Парцел, подлежащ на промяна"},{"@language":"cs-t-sv-t0-mtec","@value":"Registrační mapa - Číslo parcely sestávalo z následujících podtypů (subtypů) v informační klasifikaci 2020 (aktuální seznam viz Obecná specifikace produktu Registrační mapa) :450130, Plot Subtypes10, Plot, modifikovatelný"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort — Plotnummer bestod af følgende undertyper (undertyper) i informationsklassifikationen 2020 (for den nuværende liste henvises til den generelle varespecifikation Registerkort):450130, Plot Undertype10, Plot, modificerbar"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte - Grundstücksnummer bestand aus den folgenden Untertypen (Untertypen) bei der Informationsklassifizierung 2020 (für die aktuelle Liste siehe Allgemeine Produktspezifikation Registerkarte) :450130, Grundstücksuntertypen10, Grundstück, veränderbar"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Ο αριθμός οικοπέδου αποτελείται από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλέπε γενικές προδιαγραφές προϊόντος Χάρτης μητρώου):450130, Υποτύποι οικοπέδου10, Οικόπεδο, τροποποιήσιμο"},{"@language":"en-t-sv-t0-mtec","@value":"Register map - Plot number consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General product specification Register map) :450130, Plot Subtypes10, Plot, modifiable"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa de registro - El número de parcela constaba de los siguientes subtipos (subtipos) en la clasificación de la información 2020 (para la lista actual, véase el mapa de registro del pliego de condiciones general): 450130, Subtipos de parcela10, Parcela, modificable"},{"@language":"et-t-sv-t0-mtec","@value":"Registrikaart – Krundinumber koosnes 2020. aasta teabeklassifikatsiooni järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt Üldine tootespetsifikaat Registrikaart): 450130, Krundi alatüübid10, Krunt, muudetav"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta - Tontin numero koostui seuraavista alatyypeistä (alatyypeistä) tietoluokituksessa 2020 (nykyisestä luettelosta katso Yleiset tuote-eritelmät Rekisterikartta) :450130, Tontin alatyypit10, Tontti, muokattavissa"},{"@language":"fr-t-sv-t0-mtec","@value":"Carte du registre - Le numéro de parcelle se composait des sous-types suivants (sous-types) à la classification d’information 2020 (pour la liste actuelle, voir le cahier des charges général du produit, carte du registre): 450130, sous-types de parcelle10, parcelle, modifiable"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil an chláir - Is éard a bhí san uimhir phlota na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach an tsonraíocht táirge Ghinearálta Léarscáil an Chláir) :450130, Fochineálacha Plota10, Plot, inmhodhnaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Registarska karta – broj zemljišne čestice sastojao se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti opću specifikaciju proizvoda Registarska karta) :450130, Podvrste zemljišne čestice10, Zemljište, promjenjivo"},{"@language":"hu-t-sv-t0-mtec","@value":"Nyilvántartási térkép - A telek száma a következő altípusokból (altípusokból) állt a 2020. évi információs osztályozás szerint (az aktuális listát lásd az Általános termékleírás nyilvántartási térképén) :450130, telek altípusok10, telek, módosítható"},{"@language":"it-t-sv-t0-mtec","@value":"Mappa del registro - Il numero di lotto era costituito dai seguenti sottotipi (sottotipi) alla classificazione delle informazioni 2020 (per l'elenco attuale si veda la mappa del registro del disciplinare generale): 450130, sottotipi di lotto10, lotto, modificabile"},{"@language":"lt-t-sv-t0-mtec","@value":"Registro žemėlapis. Sklypo numerį 2020 m. informacijos klasifikacijoje sudarė šie potipiai (potipiai) (dabartinį sąrašą žr. Bendrosios produkto specifikacijos registro žemėlapyje):450130, Sklypo potipiai10, Sklypas, modifikuojamas"},{"@language":"lv-t-sv-t0-mtec","@value":"Reģistra karte - Zemes gabala numurs sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu sk. Vispārīgajā produkta specifikācijā Reģistra karte): 450130, Zemes gabala apakštipi10, Zemes gabals, maināms"},{"@language":"mt-t-sv-t0-mtec","@value":"- In-numru tal-lott kien jikkonsisti mis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-mappa tar-Reġistru tal-Ispeċifikazzjoni Ġenerali tal-Prodott): 450130, Plott Subtipi10, Plott, modifikabbli"},{"@language":"nl-t-sv-t0-mtec","@value":"Registerkaart - Perceelnummer bestond uit de volgende subtypen (subtypen) bij de informatieclassificatie 2020 (zie voor de huidige lijst het algemene productdossier Registerkaart):450130, Perceelsubtypen10, Perceel, aanpasbaar"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa rejestracji - Numer działki składał się z następujących podtypów (podtypów) w klasyfikacji informacyjnej 2020 (aktualny wykaz znajduje się w ogólnej specyfikacji produktu Mapa rejestracji): 450130, Podtypy działki10, Działka, modyfikowalny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa do registo - O número da parcela consistia nos seguintes subtipos (subtipos) na classificação da informação de 2020 (para a lista atual, ver especificação geral do produto Mapa do registo):450130, Subtipos da parcela10, Lote, modificável"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta registrului – Numărul parcelei a constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor din 2020 (pentru lista actuală, a se vedea caietul de sarcini general al produsului Harta registrului): 450130, Subtipurile parcelei 10, Plot, modificabil"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa registra - číslo parcely pozostávalo z nasledujúcich podtypov (podtypov) pri klasifikácii informácií 2020 (pre aktuálny zoznam pozri Všeobecnú špecifikáciu výrobku Mapa registra) :450130, parcelné podtypy10, parcela, modifikovateľná"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevid registra – številka ploskve je bila sestavljena iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Splošna specifikacija proizvoda Zemljevid registra) :450130, Plot Subtypes10, Plot, spremenljiv"},{"@language":"sv","@value":"Registerkarta - Tomtnummer bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450130, TomtUndertyper10, Tomt, modifierbar"},{"@language":"uk-t-sv-t0-mtec","@value":"Номер ділянки складався з наступних підтипів (підтипів) при класифікації інформації 2020 (для поточного списку див."}],"dct:format":"text/html","dct:identifier":"88f534a5-bc