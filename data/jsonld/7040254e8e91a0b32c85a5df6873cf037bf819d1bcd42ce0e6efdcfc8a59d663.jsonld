23c4b769aa","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c39f007786171997eaf4efca3db2285569a3b109b8ab9e1497965ebd57336a7f_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Stadskarta - Stadsdelar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/9a7ec133-14ae-4398-b1e2-7a23c4b769aa#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=464514632_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Stadskarta"},{"@id":"https://resources.stockholm.se/data/9a7ec133-14ae-4398-b1e2-7a23c4b769aa#HTTP:Nedladdning:data/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Stadsdelar.zip"},"dct:description":"Stadsdelsgränser är fastställda av Lantmäteriet och har sin gränslinje ofta i mitten av gatan eller i vatten. De kan inte ändras utan att konsultera LM men är inte juridiska. Själva de administrativa besluten kring småjusteringarna fattas av stadsbyggnadsnämnden efter behandling av dess namnberedning.Stadsdelsnämndsgränser ligger oftast på ena eller andra sidan av en gata pga. juridiken där det är viktigt att veta vilken nämnd som ansvarar för hela gatan. Här vill man inte dela & göra det otydligt mellan nämnderna.","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Stadsdelar (117 stycken) i Esri Shape-format"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelnin