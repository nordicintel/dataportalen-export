endrag: 10, Bäck; 20, Dike. Vegetation: 10, Buskage, (ofullständigt, ajourhålls ej); 20, Häck, (ofullständigt, ajourhålls ej); 30, Plantering, (ofullständigt, ajourhålls ej)."},"dct:identifier":"52dbdbb5-79b9-4d40-9335-d213017bedb0","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1a3e9db58f9894dc47cddcc5e6d66e09b5a6010fbb93e56964f93737f154f858_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta - Natur"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/52dbdbb5-79b9-4d40-9335-d213017bedb0#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=269cb7f1-fdb3-43de-aed0-db3ed047162b&showmetadataview"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Baskarta (1:400 - 1:2000)."},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1a3e9db58f9894dc47cddcc5e6d66e09b5a6010fbb93e56964f93737f154f858"},{"@graph":[{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2023-05-07"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-04-20"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2023-05-07"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2023-04-20"}},{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"17b71cd433e7910d355431d6e99f32ad4f"},{"@id":"http://data.europa.eu/88u/dataset/dc08c358-e3a9-45a2-bc84-e36b10ce66b7","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=f53645a8-ea71-4fa0-bd8c-6524fee7f379"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000\""},"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b0n0"},"dct:temporal":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed60eeb9fee128c97e1_b1n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant (2025)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_Ortofoto_2025.pdf"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information:Produktspecfikation/3","dct:title":"Produktspecifikation","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"}},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2025"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:OGC:WMS/2","dct:title":"Ortofoto 2025","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"}},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/dc08c358-e3a9-45a2-bc84-e36b10ce66b7#HTTP:Information/1","dct:title":"Beställ kartor och geodata","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}},{"@id":"http://data.europa.eu/88u/record/dc08c358-e3a9-45a2-bc84-e36b10ce66b7","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/5b1f8d29-0c82-45ca-b2e3-d79d98a56b22"},{"@id":"http://data.europa.eu/88u/distribution/5d857548-567c-4c97-8d1d-3702946bf681"},{"@id":"http://data.europa.eu/88u/distribution/d247dae4-e663-46ca-938c-c794c28f3ecb"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"dc08c358-e3a9-45a2-bc84-e36b10ce66b7","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-15T11:15:25Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-16T11:15:03Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/dc08c358-e3a9-45a2-bc84-e36b10ce66b7"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:1a9380a3e7ced437dc2a3e194ae7a55f2ff5ecd709df4ed6