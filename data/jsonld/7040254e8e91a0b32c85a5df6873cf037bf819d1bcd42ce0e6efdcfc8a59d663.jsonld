t+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsledningskontoret - Kommunikations- och omvärldsavdelningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ola.williams@stockholm.se"}}],"@id":"urn:source:bcfe327294809a8b2801a8b88fc73e100ebfcc2ca0f3be79d108e2f49af291f1"},{"@graph":[{"@id":"_:bd73acd0dc362279c9923c07d187b68ef9c50f477103b8297809399752682526_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Park"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature17314454"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:created":{"@type":"xsd:date","@value":"2012-12-01"},"dct:description":{"@language":"sv","@value":"Ytgeometri som visar utbredningen för stadens plaskdammar och hämtas från stadens parkdatabas."},"dct:identifier":"4fcf1597-c30f-4c85-87ba-4e73386b10b4","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:bd73acd0dc362279c9923c07d187b68ef9c50f477103b8297809399752682526_b0n0"},"dct:title":{"@language":"sv","@value":"Plaskdamm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Plaskdamm_Yta&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:OGC:WFS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Plaskdamm_Yta"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/4fcf1597-c30f-4c85-87ba-4e73386b10b4#HTTP:OGC:WMS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Plaskdamm_Yta"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:bd73acd0dc362279c9923c07d187b68ef9c50f477103b8297809399752682526"},{"@graph":[{"@id":"_:bec70093bf07ef0b99a21e9d190f0f28541cdf0683736ef28e0e58f3524086b2_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:bec70093bf07ef0b99a21e9d190f0f28541cdf0683736ef28e0e58f3524086b2_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16870fc116976e59110bca76ad327adeba"},{"@id":"http://data.europa.eu/88u/dataset/8d6e25de-d393-4346-8a68-12750a433f7b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/b5fa842f-c180-4c2f-883f-8465b0a780fd"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5077f026-172d-48bf-b1ec-ff3fa452c9f7"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Строителните съоръжения се състоят от следните неясноти и подтипове (за текущия списък вж. базовата карта на общата продуктова спецификация): Строителен завод: 10, Altan; г., Lanternin; 30, сенници; 50, стълбища; На 60 години, Лашкай."},{"@language":"cs-t-sv-t0-mtec","@value":"Stavební zařízení se skládají z následujících nejasností a podtypů (aktuální seznam viz základní mapa obecných specifikací produktu): Stavební závod: 10, Altan; 20, Lanternin; 30, přístřešky; 50, schodiště; 60, Lastkaj."},{"@language":"da-t-sv-t0-mtec","@value":"Konstruktionsfaciliteterne består af følgende uklarheder og undertyper (den nuværende liste findes i basiskortet over generelle produktspecifikationer): Bygge- og anlægsvirksomhed: 10, Altan; 20, Lanternin; 30, baldakiner 50, Trapper; 60, Lastkaj."},{"@language":"de-t-sv-t0-mtec","@value":"Bauanlagen bestehen aus den folgenden Unklarheiten und Subtypen (für die aktuelle Liste siehe Allgemeine Produktspezifikation Basiskarte): Baubetrieb: 10, Altan; 20, Lanternin; 30, Vordächer; 50, Treppe; 60, Lastkaj."},{"@language":"el-t-sv-t0-mtec","@value":"Οι κατασκευαστικές εγκαταστάσεις αποτελούνται από τις ακόλουθες ασάφειες και υποκατηγορίες (για τον τρέχοντα κατάλογο βλέπε χάρτη βάσης γενικών προδιαγραφών προϊόντος): Κατασκευαστική μονάδα: 10, Altan· 20, Lanternin· 30, Θόλοι· 50, Σκάλες· 60, Λάστκαϊ."},{"@language":"en-t-sv-t0-mtec","@value":"Construction facilities consist of the following obscurity and subtypes (for the current list see General Product Specification Base Map): Construction plant: 10, Altan; 20, Lanternin; 30, Canopies; 50, Stairs; 60, Lastkaj."},{"@language":"es-t-sv-t0-mtec","@value":"Las instalaciones de construcción consisten en las siguientes oscuridades y subtipos (para la lista actual, véase el mapa base de las especificaciones generales del producto): Planta de construcción: 10, Altan; 20, Lanternin; 30, Canopies; 50, escaleras; 60 años, Lastkaj."},{"@language":"et-t-sv-t0-mtec","@value":"Ehitusrajatised koosnevad järgmistest hägusustest ja alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaart): Ehitustehas: 10, Altan; 20, Lanternin; 30, varikatused; 50, trepid; 60, Lastkaj."},{"@language":"fi-t-sv-t0-mtec","@value":"Rakennuslaitokset koostuvat seuraavista epäselvyyksistä ja alatyypeistä (nykyisen luettelon osalta katso yleinen tuote-eritelmän peruskartta): Rakennuslaitos: 10, Altan; 20, Lanternin; 30, katokset; 50, portaat; 60 vuotta, Lastkaj."},{"@language":"fr-t-sv-t0-mtec","@value":"Les installations de construction se composent des obscurités et des sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): Usine de construction: 10, Altan; 20, Lanternine; 30, Auvents; 50, Escaliers; 60, Lastkaj."},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard atá i saoráidí foirgníochta an doiléire agus na fochineálacha seo a leanas (le haghaidh an liosta reatha féach an Bhunléarscáil Sonraíochta Táirge Ginearálta): Gléasra foirgníochta: 10, Altan; 20, Lanternin; 30, Ceannbhrait; 50, Staighre; 60, Lastkaj."},{"@language":"hr-t-sv-t0-mtec","@value":"Građevinski objekti sastoje se od sljedećih nejasnoća i podvrsta (za trenutačni popis vidjeti osnovnu kartu opće specifikacije proizvoda): Građevinsko postrojenje: 10, Altan; 20, Lanternin; 30, nadstrešnice; 50, stubišta; 60, Lastkaj."},{"@language":"hu-t-sv-t0-mtec","@value":"Az építési létesítmények a következő homályosságból és altípusokból állnak (az aktuális listát lásd az általános termékspecifikációs alaptérképen): Építési üzem: 10, Altan; 20, Lanternin; 30, előtetők; 50, Lépcsők; 60 éves, Lastkaj."},{"@language":"it-t-sv-t0-mtec","@value":"Gli impianti di costruzione sono costituiti dai seguenti elementi di oscurità e sottotipi (per l'elenco attuale si veda la mappa di base delle specifiche generali di prodotto): Impianto di costruzione: 10, Altan; 20, Lanternin; 30, tettoie; 50, Scale; 60 anni, Lastkaj."},{"@language":"lt-t-sv-t0-mtec","@value":"Statybos įrenginius sudaro šie neaiškumai ir potipiai (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): Statybos įmonė: 10, Altan; 20, Žibintai; 30, stogeliai; 50, laiptai; 60, Lastkaj."},{"@language":"lv-t-sv-t0-mtec","@value":"Būvobjekti sastāv no šādiem neskaidrībām un apakštipiem (pašreizējo sarakstu sk. vispārējā produktu specifikācijas bāzes kartē): Būvuzņēmums: 10, Altan; 20, laternīns; 30, nojumes; 50, kāpnes; 60, Lastkaj."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-faċilitajiet tal-kostruzzjoni jikkonsistu mill-oskurità u s-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): Impjant tal-kostruzzjoni: 10, Altan; 20, Lanternin; 30, Kanopji; 50, Taraġ; 60, Lastkaj."},{"@language":"nl-t-sv-t0-mtec","@value":"Bouwfaciliteiten bestaan uit de volgende onduidelijkheid en subtypes (zie voor de huidige lijst de basiskaart van de algemene productspecificatie): Bouwbedrijf: 10, Altan; 20, Lantaarn; 30, Luifels; 50, Trappen; 60 jaar, Lastkaj."},{"@language":"pl-t-sv-t0-mtec","@value":"Obiekty budowlane składają się z następujących niejasności i podtypów (aktualny wykaz znajduje się na mapie podstawowej specyfikacji produktu): Zakład budowlany: 10, Altan; 20, Lanternin; 30, zadaszenia; 50, schody; 60, Lastkaj."},{"@language":"pt-t-sv-t0-mtec","@value":"As instalações de construção consistem nas seguintes obscuridades e subtipos (para a lista atual, ver mapa de base das especificações gerais dos produtos): Instalação de construção: 10, Altan; 20, Lanterna; 30, copas; 50, Escadas; 60 anos, Lastkaj."},{"@language":"ro-t-sv-t0-mtec","@value":"Instalațiile de construcție constau în următoarele obscurități și subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): Instalație de construcții: 10, Altan; 20, Lanternină; 30, Copertine; 50, scări; 60 de ani, Lastkaj."},{"@language":"sk-t-sv-t0-mtec","@value":"Stavebné zariadenia pozostávajú z týchto nejasností a podtypov (aktuálny zoznam je uvedený v základnej mape všeobecných špecifikácií výrobku): Stavebný závod: 10, Altan; 20, Lanternin; 30, baldachýny; 50, schody; 60, Lastkaj."},{"@language":"sl-t-sv-t0-mtec","@value":"Gradbeni objekti so sestavljeni iz naslednjih nejasnosti in podvrst (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): Gradbeni obrat: 10, Altan; 20, Lanternin; 30, nadstreški; 50, Stopnice; 60, Lastkaj."},{"@language":"sv","@value":"Byggnadsanläggningar består av följande objket- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Byggnadsanläggning: 10, Altan; 20, Lanternin; 30, Skärmtak; 50, Trappa; 60, Lastkaj."},{"@language":"uk-t-sv-t0-mtec","@value":"Будівельні об'єкти складаються з наступних неясностей і підтипів (для поточного списку див. Будівельний завод: 10, Алтан; 20, ліхтарик; 30, навіси; 50, сходи; 60 років, Ласткай."}],"dct:format":"text/html","dct:identifier":"8d6e25de-d393-4346-8a68-12750a433f7b","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:bec70093bf07ef0b99a21e9d190f0f28541cdf0683736ef28e0e58f3524086b2_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Сгради и съоръжения"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Budovy a stavby"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Bygninger, konstruktioner og anlæg"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Bauwerke"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Base map - Κτίρια και κατασκευές"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Buildings and structures"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Edificios y estructuras"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Base map - Hooned ja rajatised"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Rakennukset ja rakennelmat"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base - Bâtiments et structures"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Bhunáite SBK - Foirgnimh agus struchtúir"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Bazna karta - Zgrade i građevine"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Épületek és építmények"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Base map - Edifici e strutture"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Pastatai ir statiniai"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Base map - Ēkas un būves"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Bażi ta' mappa - Bini u strutturi"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Gebouwen en bouwwerken"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Base map - Budynki i budowle"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa de base SBK - Edifícios e estruturas"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta bazei SBK - Clădiri și structuri"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Základná mapa - Budovy a stavby"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Osnovni zemljevid - Zgradbe in objekti"},{"@language":"sv","@value":"SBK Baskarta - Byggnadsanläggningar"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Базова карта - Будівлі та споруди"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/b5fa842f-c180-4c2f-883f-8465b0a780fd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/8d6e25de-d393-4346-8a68-12750a433f7b#HTTP:Information/1","dct:title":["Datamängden ingår i produkten Baskarta (1:400  - 1:2000).",{"@language":"bg-t-sv-t0-mtec","@value":"Наборът от данни е включен в продуктовата базова карта (1:400 - 1:2000)."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový soubor je součástí produktové Základní mapy (1:400 - 1:2000)."},{"@language":"da-t-sv-t0-mtec","@value":"Datasættet er inkluderet i produktbasen (1:400 - 1:2000)."},{"@language":"de-t-sv-t0-mtec","@value":"Der Datensatz ist im Produkt Basiskarte (1:400 - 1:2000) enthalten."},{"@language":"el-t-sv-t0-mte