.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:1e4c0325520a970bc14c21cd7e524fe2213a9f8f62ed1d4596294679be02dce4"},{"@graph":[{"@id":"_:1eaa82786cbf4f969ee53af5934eaf2af1ecb149f0d015b2e6429c43310b7c5b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Information:Produktspecfikation/2"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Nedladdning:data/4"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Nedladdning:data/5"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Nedladdning:data/6"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:OGC:WMS/11"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:OGC:WMS/7"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:OGC:WMS/8"}],"dcat:keyword":[{"@language":"sv","@value":"Bakgrundskarta"},{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Samhällsbyggnadsprocessen"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=0eed76ad-7a89-4da1-9766-e9fcf7b31789"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:description":{"@language":"sv","@value":"Stadskartan är en översiktskarta anpassad för skalintervallet 1:4 000 till 1:8 000. Den varma och milda färgsättningen i kombination med det detaljerade innehållet gör stadskartan lättläst och lämplig att användas både i tryck och webbanpassade versioner. Stadskartans generaliserade innehåll gör att kartan är tydlig även när större geografiska områden ska visas och den kan därmed användas som bakgrundskarta när verksamhetsspecifik information ska tydliggöras. Den används även som en egen informationsbärande karta. Innehållet inkluderar t ex administrativa gränser, kvarter, fastigheter, alla byggnader, gator, adressnummer, naturområden, 2-meters höjdkurvor och spårnät. Gällande WMS-tjänsterna: applikationer som implementerar WMS Tiling Client Recommendation rekommenderas att använda den tilade WMS-tjänsten.Datamängden registerenhet ingår inte den öppna data versionen av Stadskartan."},"dct:identifier":"33d41dcd-fcf4-4e5e-9a43-616b5e9fee58","dct:issued":{"@type":"xsd:date","@value":"2026-02-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:1eaa82786cbf4f969ee53af5934eaf2af1ecb149f0d015b2e6429c43310b7c5b_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Stadskarta (1:4000 - 1:8000)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Beställ kartor och geodata"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Information:Produktspecfikation/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Allm%C3%A4n_produktspecifikation_Stadskarta.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Produktspecifkation"},{"@id":"https://resources.stockholm.se/data/33d41dcd-fcf4-4e5e-9a43-616b5e9fee58#HTTP:Nedladdning:data/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stadsbyggnadskontoret/Stadskarta_per_stadsdelsn%C3%A4mnd.zip"},"dct:format":{"@id":"http://publicati