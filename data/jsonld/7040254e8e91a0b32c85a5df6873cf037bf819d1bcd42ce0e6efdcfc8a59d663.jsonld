/bb516f14-234c-4c3e-ac48-acde8a7ba961","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Nedladdning/3"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:OGC:WFS/4"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature4000002"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som representerar data om väghållare på vägsträcka, meddelad genom beslut. Väghållare i detta sammanhang är den som skall hålla vägen och som är ansvarig för väghållningen vilket inte behöver vara densamma som den som praktiskt utför byggande, drift och underhåll av en väg. Tillhör verksamhet NVDB (Trafikverket). Utbredning: Stockholms län"},"dct:identifier":"bb516f14-234c-4c3e-ac48-acde8a7ba961","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:62e891b71208fa401356471e1560ea3aa921e82b98fcd79b3b6166de82ff1942_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - Väghållare"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se/LvWS-2.2/Lv.asmx"},"dct:description":"Beskrivning av LvWS APIs olika metoder.","dct:title":"Tjänsteadress web service"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:Nedladdning/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:NVDB_Vaghallare&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:OGC:WFS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:NVDB_Vaghallare"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/bb516f14-234c-4c3e-ac48-acde8a7ba961#HTTP:OGC:WMS/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:NVDB_Vaghallare"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:62e891b71208fa401356471e1560ea3aa921e82b98fcd79b3b6166de82ff1942"},{"@graph":[{"@id":"_:640363102f3548791936e2b23e65bff8b312d75dab6b13e5fd5626b5d0aa3078_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/ab659a75-5515-4b75-b7b3-ccb15487af08","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/ab659a75-5515-4b75-b7b3-ccb15487af08#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=a21b1113-0c72-4a29-97c9-9c7af9950298"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"I den kommunala författningssamlingen finns vissa beslut som fattats av Stockholms kommunfullmäktige. Det kan handla om till exempel om reglemente för nämnder, bolagsordningar för kommunala bolag och taxor för kommunala tjänster."},"dct:identifier":"ab659a75-5515-4b75-b7b3-ccb15487af08","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:640363102f3548791936e2b23e65bff8b312d75dab6b13e5fd5626b5d0aa3078_b0n0"},"dct:title":{"@language":"sv","@value":"Stockholms stads författningssamling"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ab659a75-5515-4b75-b7b3-ccb15487af08#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.stockholm.se/OmStockholm/Politik-och-demokrati/Stadsovergripande-styrdokument/Kommunal-forfattningssamling/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbplats med mer information"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Stadsledningskontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Stadsledningskontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:anders.broberg@stockholm.se"},{"@id":"mailto:kommunstyrelsen@stockholm.se"}]}],"@id":"urn:source:640363102f3548791936e2b23e65bff8b312d75dab6b13e5fd5626b5d0aa3078"},{"@graph":[{"@id":"_:6413d0c5cbab6b4c03d1e220ea1d8ea3012a17e771544fe1649534c388f637ea_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:6413d0c5cbab6b4c03d1e220ea1d8ea3012a17e771544fe1649534c388f637ea_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"123fce3ad17956f709fca3caa1dc2a9ab2"},{"@id":"http://data.europa.eu/88u/dataset/6724fc99-fd4b-4418-bd23-b42e1be55a32","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/180c2491-64b8-45e0-861a-66bd3bb9fb29"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=e7c49f2a-8e24-4b37-8699-4f28771f48a9"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Инфраструктурата се състои от следните обекти и подтипове (за текущия списък вж. базовата карта на общата продуктова спецификация): Релсова мрежа: 10, релсите на метрото; 20, SJ Нормална писта; 30, SJ Тесен коловоз; 60, трамвайни релси. Съоръжение за движение: 10, Navfollower; 20, Perrong; 50, мост; 60, тунел; 80, Теренно стълбище. Демаркация на пътя: 10, вход; На 20 години, Рефуг. Размножаване на пътищата: 10, Пътна илюстрация; 20, размножаване на паркоместата; 70, Разпространение на пътищата; 80, Разпространение на пътя в тунела."},{"@language":"cs-t-sv-t0-mtec","@value":"Infrastruktura se skládá z následujících objektů a podtypů (aktuální seznam viz Základní mapa obecných specifikací produktu): Traťová síť: 10, trasy metra; 20, SJ normální dráha; 30, úzká trať SJ; 60, tramvajové tratě. Dopravní zařízení: 10, Navfollower; 20, Perrong; 50, můstek; 60, tunel; 80, Terénní schodiště. Vymezení silnice: 10, vstup; 20, Refugová. Šíření vozovky: 10, Silniční ilustrace; 20, šíření Parkway; 70, Šíření po silnici; 80, Šíření silnic v tunelu."},{"@language":"da-t-sv-t0-mtec","@value":"Infrastrukturen består af følgende objekt- og undertyper (se basiskortet for den generelle produktspecifikation for den aktuelle liste): Spornet: 10, Metrospor 20, SJ Normal spor; 30, SJ smalsporet; 60, Sporvognsspor. Færdselsanlæg: 10, Navfollower; 20, Perrong; 50, bro; 60, tunnel, 80, Terræntrappe. Vejafgrænsning: 10, Indgang; 20, Refug. Udbredelse af veje: 10, vejillustration 20, Parkway-udbredelse; 70, Vejspredning 80, Vejspredning i tunnel."},{"@language":"de-t-sv-t0-mtec","@value":"Infrastruktur besteht aus folgenden Objekten und Untertypen (für die aktuelle Liste siehe Basiskarte der allgemeinen Produktspezifikation): Streckennetz: 10, U-Bahn-Strecken; 20, SJ Normalschiene; 30, SJ Schmale Spur; 60, Straßenbahngleise. Verkehrseinrichtung: 10, Navfollower; 20, Perrong; 50, Brücke; 60, Tunnel; 80, Geländetreppe. Straßenabgrenzung: 10, Eingang; 20, Zuflucht. Straßenausbreitung: 10, Straßenillustration; 20, Parkway-Verbreitung; 70, Straßenausbreitung; 80, Straßenausbreitung im Tunnel."},{"@language":"el-t-sv-t0-mtec","@value":"Η υποδομή αποτελείται από τα ακόλουθα αντικείμενα και υποτύπους (για τον τρέχοντα κατάλογο βλέπε χάρτη βάσης γενικών προδιαγραφών προϊόντος): Δίκτυο τροχιάς: 10, γραμμές μετρό· 20, κανονική τροχιά SJ· 30, στενή τροχιά SJ· 60, ίχνη του τραμ. Διευκόλυνση κυκλοφορίας: 10, Navfollower· 20, Perrong· 50, Γέφυρα· 60, σήραγγα· 80, Σκάλα εδάφους. Οριοθέτηση οδών: 10, είσοδος· 20, απόφευγε. Διάδοση του οδικού δικτύου: 10, Οδική απεικόνιση· 20, διάδοση Parkway· 70, διάδοση στο οδικό δίκτυο· 80, Οδική διάδοση στο τούνελ."},{"@language":"en-t-sv-t0-mtec","@value":"Infrastructure consists of the following object and subtypes (for the current list see General Product Specification Base Map): Track network: 10, Metro tracks; 20, SJ Normal track; 30, SJ Narrow track; 60, Tram tracks. Traffic facility: 10, Navfollower; 20, Perrong; 50, Bridge; 60, Tunnel; 80, Terrain staircase. Road demarcation: 10, Entrance; 20, Refug. Road propagation: 10, Road illustration; 20, Parkway propagation; 70, Road propagation; 80, Road propagation in tunnel."},{"@language":"es-t-sv-t0-mtec","@value":"La infraestructura consta de los siguientes objetos y subtipos (para consultar la lista actual, véase el mapa base de las especificaciones generales del producto): Red de seguimiento: 10, vías de metro; 20, SJ Vía normal; 30, SJ Vía estrecha; 60, huellas del tranvía. Facilidad de tráfico: 10, Navfollower; 20, Perrong; 50, puente; 60, túnel; 80, escalera del terreno. Demarcación de carreteras: 10, entrada; 20 años, Refug. Propagación por carretera: 10, Ilustración del camino; 20, propagación de Parkway; 70, Propagación de carreteras; 80, Propagación de carreteras en túnel."},{"@language":"et-t-sv-t0-mtec","@value":"Taristu koosneb järgmistest objektidest ja alatüüpidest (praeguse loetelu kohta vt üldise tootespetsifikaadi aluskaart): Rööbasteevõrk: 10, metroorajad; 20, SJ Normaalne rada; 30, SJ Kitsas rada; 60, Trammirajad. Liiklusrajatis: 10, Navfollower; 20, Perrong, 50, sild; 60, tunnel; 80, Terrain trepp. Teede piiritlemine: 10, sissepääs; 20, põgenik. Teede paljundamine: 10, tee illustratsioon; 20, Parkway paljundamine; 70, Teede paljundamine; 80, Teede paljundus tunnelis."},{"@language":"fi-t-sv-t0-mtec","@value":"Infrastruktuuri koostuu seuraavista kohteista ja alatyypeistä (nykyisen luettelon osalta katso yleinen tuote-eritelmän peruskartta): Rataverkko: 10, metroradat; 20, SJ Normaali rata; 30, SJ Kapea rata; 60, raitiovaunujen jälkiä. Liikenneväline: 10, Navfollower; 20, Perrong; 50, silta; 60, tunneli; 80, Maastoportaat. Tien rajaus: 10, Sisäänkäynti; 20 pistettä, Refug. Tien eteneminen: 10, Tien kuva; 20, Parkway-lisäys; 70, tien eteneminen; 80, Tien eteneminen tunnelissa."},{"@language":"fr-t-sv-t0-mtec","@value":"L'infrastructure se compose de l'objet et des sous-types suivants (pour la liste actuelle, voir la carte de base des spécifications générales du produit): Réseau de voies: 10, Voies de métro; 20, voie normale SJ; 30, voie étroite SJ; 60, Tramway. Facilité de circulation: 10, Navfollower; 20, Perrong; 50, pont; 60, tunnel; 80, Escalier de terrain. Démarcation routière: 10, Entrée; 20, Refug. Propagation routière: 10, Illustration routière; 20, propagation de la promenade; 70, Propagation des routes; 80, Propagation de la route dans le tunnel."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá an réad agus na fochineálacha seo a leanas sa bhonneagar (le haghaidh an liosta reatha féach Bunléarscáil Sonraíochta Táirge Ginearálta): Líonra rianta: 10, rianta Metro; 20, SJ Gnáthrian; 30, SJ caolrian; 60, Tram rianta. Saoráid tráchta: 10, Navfollower; 20, Perrong; 50, Droichead; 60, Tollán; 80, Staighre tír-raoin. Críochú bóthair: 10, Iontráil; 20, Refug. Iomadú bóthair: 10, Léaráid bhóthair; 20, Forleathadh Parkway; 70, Iomadú bóthair; 80, Iomadú bóthair i dtollán."},{"@language":"hr-t-sv-t0-mtec","@value":"Infrastruktura se sastoji od sljedećih objekata i podvrsta (za trenutačni popis vidjeti osnovnu kartu opće specifikacije proizvoda): Mreža kolosijeka: 10, tračnice podzemne željeznice; 20, SJ Normal track; 30, SJ Uski kolosijek; 60, Tramvajske staze. Prometni objekt: 10, Navfollower; 20, Perrong; 50, most; 60, tunel; 80, Terrain stubište. Razgraničenje cesta: 10, Ulaz; 20, Odbij. Umnažanje cesta: 10, ilustracija ceste; 20, razmnožavanje Parkwaya; 70, širenje cesta; 80, širenje ceste u tunelu."},{"@language":"hu-t-sv-t0-mtec","@value":"Az infrastruktúra a következő objektumokból és altípusokból áll (az aktuális listát lásd az Általános Termékleírási Alaptérképben): Pályahálózat: 10, metróvágányok; 20, SJ Normál vágány; 30, SJ keskeny nyomtáv; 60, villamos nyomok. Forgalmi létesítmény: 10, Navfollower; 20 éves, Perrong; 50, híd; 60., Alagút; 80, Terep lépcsőház. Közúti elhatárolás: 10, Bejárat; 20 éves, Refug. Útterjedés: 10, közúti illusztráció; 20, Parkway-terjedés; 70, Közúti terjedés; 80, Útterjedés az alagútban."},{"@language":"it-t-sv-t0-mtec","@value":"L'infrastruttura è costituita dai seguenti oggetti e sottotipi (per l'elenco corrente si veda General Product Specification Base Map): Rete di binari: 10, binari della metropolitana; 20, pista normale di SJ; 30, pista stretta di SJ; 60, binari del tram. Impianto di traffico: 10, Navfollower; 20, Perrong; 50, ponte; 60, galleria; 80, Scala del terreno. Demarcazione stradale: 10, Ingresso; 20, rifiuto. propagazione stradale: 10, illustrazione stradale; 20, propagazione di Parkway; 70, propagazione stradale; 80, propagazione stradale in galleria."},{"@language":"lt-t-sv-t0-mtec","@value":"Infrastruktūrą sudaro toliau nurodyti objektai ir potipiai (dabartinį sąrašą žr. Bendrosios produkto specifikacijos baziniame žemėlapyje): Bėgių kelių tinklas: 10, Metro bėgių keliai; 20, SJ įprastas bėgių kelias; 30, SJ siauras kelias; 60, Tramvajų trasos. Eismo infrastruktūra: 10, Navfollower; 20, Perrong; 50, tiltas; 60, tunelis; 80, Terrain laiptai. Kelio atribojimas: 10, įėjimas; 20, Refug. Kelio sklidimas: 10, Kelio iliustracija; 20, Parkway dauginimas; 70, Kelių sklidimas; 80, Kelio sklidimas tuneliu."},{"@language":"lv-t-sv-t0-mtec","@value":"Infrastruktūru veido šādi objekti un apakštipi (pašreizējo sarakstu sk. vispārējā produkta specifikācijas bāzes kartē): Sliežu ceļu tīkls: 10, metro trases; 20, SJ parastā trase; 30, SJ šaura trase; 60, tramvaju trases. Satiksmes iekārta: 10, Navfollower; 20, Perrong; 50, tilts; 60, tunelis; 80, Terrain kāpnes. Ceļu demarkācija: 10, ieeja; 20, atteikums. Ceļu pavairošana: 10, ceļa ilustrācija; 20, Parkway pavairošana; 70, Ceļu pavairošana; 80, Ceļu pavairošanu tunelī."},{"@language":"mt-t-sv-t0-mtec","@value":"L-infrastruttura tikkonsisti mill-oġġett u s-sottotipi li ġejjin (għal-lista attwali ara l-Mappa Bażi tal-Ispeċifikazzjoni Ġenerali tal-Prodott): Network tal-binarji: 10, Trekks tal-metro; 20, SJ Traċċa normali; 30, SJ Narrow track; 60, Trekks tat-tramm. Faċilità tat-traffiku: 10, Navfollower; 20, Perrong; 50, Pont; 60, Mina; 80, Taraġ tal-art. Id-demarkazzjoni tat-toroq: 10, Dħul; 20, Refug. Propagazzjoni tat-triq: 10, Illustrazzjoni tat-triq; 20, Propagazzjoni tal-parkway; 70, Propagazzjoni tat-triq; 80, Propagazzjoni tat-triq fil-mina."},{"@language":"nl-t-sv-t0-mtec","@value":"Infrastructuur bestaat uit de volgende objecten en subtypen (zie voor de huidige lijst de basiskaart van het algemene productdossier): Spoornetwerk: 10, Metrosporen; 20, SJ Normaal spoor; 30, SJ smal spoor; 60, Tramsporen. Verkeersvoorziening: 10, Navfollower; 20, Perrong; 50, Brug; 60, Tunnel; 80, Terreintrap. Wegafbakening: 10, Ingang; 20, toevluchtsoord. Wegverspreiding: 10, Wegillustratie; 20, Parkway-voortplanting; 70, Wegverspreiding; 80, Wegverspreiding in tunnel."},{"@language":"pl-t-sv-t0-mtec","@value":"Infrastruktura składa się z następujących obiektów i podtypów (aktualna lista znajduje się w mapie podstawowej specyfikacji produktu): Sieć torowa: 10, tory metra; 20, SJ Normalny tor; 30, wąski tor SJ; 60, tory tramwajowe. Infrastruktura ruchu drogowego: 10, Navfollower; 20, Perrong; 50, mostek; 60, tunel; 80, schody terenowe. Wyznaczenie drogi: 10, wejście; 20, schronienie. Rozprzestrzenianie się na drogach: 10, ilustracja drogowa; 20, Rozprzestrzenianie się drogi parkowej; 70, Rozprzestrzenianie się dróg; 80, Propagacja drogowa w tunelu."},{"@language":"pt-t-sv-t0-mtec","@value":"A infraestrutura consiste no seguinte objeto e subtipos (para a lista atual, ver mapa de base das especificações gerais do produto): Rede de vias: 10, vias de metropolitano; 20, SJ Via normal; 30, SJ Via estreita; 60, rastos de eléctrico. Instalação de tráfego: 10, Navfollower; 20, Perrong; 50, Ponte; 60, túnel; 80, Escada do terreno. Demarcação rodoviária: 10, Entrada; 20, Refug. Propagação rodoviária: 10, Ilustração rodoviária; 20, Propagação de pistas de estacionamento; 70, Propagação rodoviária; 80, Propagação da estrada no túnel."},{"@language":"ro-t-sv-t0-mtec","@value":"Infrastructura constă în următoarele obiecte și subtipuri (pentru lista actuală, a se vedea Harta de bază a caietului de sarcini general al produsului): Rețeaua de cale ferată: 10, piste de metrou; 20, SJ pistă normală; 30, SJ Linie îngustă; 60, șine de tramvai. Instalație de trafic: 10, Navfollower; 20, Perrong; 50, Podul; 60, tunelul; 80, scară de teren. Delimitarea drumurilor: 10, Intrarea; 20, în refugiu. Propagarea drumurilor: 10, Ilustrație rutieră; 20, propagarea pe Parkway; 70, Propagarea drumurilor; 80, Propagarea drumului în tunel."},{"@language":"sk-t-sv-t0-mtec","@value":"Infraštruktúra pozostáva z týchto objektov a podtypov (pre aktuálny zoznam pozri základnú mapu všeobecných špecifikácií výrobku): Koľajová sieť: 10, Metro koľaje; 20, normálna dráha SJ; 30, SJ Úzka trať; 60, električkové trate. Dopravné zariadenie: 10, Navfollower; 20, Perrong; 50, most; 60, tunel; 80, prízemné schodisko. Vymedzenie cesty: 10, vstupné; 20, refugovať. Šírenie ciest: 10, Cestná ilustrácia; 20, propagácia parkway; 70, Šírenie ciest; 80, Šírenie cesty v tuneli."},{"@language":"sl-t-sv-t0-mtec","@value":"Infrastrukturo sestavljajo naslednji objekti in podtipi (za trenutni seznam glej osnovni zemljevid splošnih specifikacij proizvoda): Tirno omrežje: 10, podzemne železnice; 20, SJ običajna proga; 30, SJ ozka proga; 60, tramvajske steze. Prometni objekt: 10, Navfollower; 20, Perrong; 50, most; 60, predor; 80, terensko stopnišče. Razmejitev cest: 10, vhod; 20, refug. št. Razmnoževanje v cestnem prometu: 10, Ilustracija ceste; 20, širjenje Parkwaya; 70, širjenje cest; 80, širjenje ceste v tunelu."},{"@language":"sv","@value":"Infrastruktur består av följande objekt- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Spårnät: 10, Tunnelbanespår; 20, SJ Normalspår; 30, SJ Smalspår; 60, Spårvagnsspår. Trafikanläggning: 10, Navföljare; 20, Perrong; 50, Bro; 60, Tunnel; 80, Terrängtrappa. Vägavgränsning: 10, Infart; 20, Refug. Vägutbredning: 10, Vägillustration; 20, Parkvägsutbredning; 70, Vägutbredning; 80, Vägutbredning i tunnel."},{"@language":"uk-t-sv-t0-mtec","@value":"Інфраструктура складається з наступних об'єктів і підтипів (для поточного списку див. Відстеження мережі: 10, Метро колії; 20, SJ Нормальна доріжка; 30, SJ Вузька колія; 60, Трамвайні колії. Об'єкт дорожнього руху: 10, Navfollower; 20, Перронг; 50, міст; 60, тунель; 80, сходова клітка. Демаркація доріг: 10) вхід; Двадцять, відступ. Розповсюдження доріг: 10, Дорожня ілюстрація; 20, розмноження Парквей; 70, Розповсюдження доріг; 80, Розповсюдження доріг у тунелі."}],"dct:format":"text/html","dct:identifier":"6724fc99-fd4b-4418-bd23-b42e1be55a32","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:6413d0c5cbab6b4c03d1e220ea1d8ea3012a17e771544fe1649534c388f637ea_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Базова карта - Инфраструктура"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa - Infrastruktura"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort - Infrastruktur"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte - Infrastruktur"},{"@language":"el-t-sv-t0-mtec","@value":"Βασικός χάρτης SBK - Υποδομή"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map - Infrastructure"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Mapa base - Infraestructura"},{"@language":"et-t-sv-t0-mtec","@value":"SBK baaskaart - Infrastruktuur"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Base map - Infrastruktuuri"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base - Infrastructure"},{"@language":"ga-t-sv-t0-mtec","@value":"Bunmhapa SBK - Bonneagar"},{"@language":"hr-t-sv-t0-mtec","@value":"Bazna karta SBK-a - Infrastruktura"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Alaptérkép - Infrastruktúra"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Mappa di base - Infrastrutture"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Bazinis žemėlapis - Infrastruktūra"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK bāzes karte - infrastruktūra"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Base map - Infrastructure"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Basiskaart - Infrastructuur"},{"@language":"pl-t-sv-t0-mtec","@value