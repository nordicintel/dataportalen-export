guage":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/1"},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/2"},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=b1c6ab86-b277-43df-9707-8602ec6c4714"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2024-02-16"},"dct:description":{"@language":"sv","@value":"Kartlagret visar det totala kolförrådet (ton kol/ha) i skog och mark i Stockholms stad. Kolförrådet omfattas av organiskt kol som finns inlagrat som markkol, i dött organiskt material och i levande biomassa i marken. Detta kan ge upphov till läckage beroende på hur staden väljer att använda marken."},"dct:identifier":"02e4ca8b-0213-4f73-994c-e82b01ec7181","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:257024c659c1e2ad16ba4b9000d0bb61e3c37b582bc8f3bb623ef24767d6207d_b0n0"},"dct:title":{"@language":"sv","@value":"Kolförråd 2021, totalt"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/1728a77b296548b0b78c5903087fc769/explore?location=59.334150%252C17.981958%252C12.55"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartvy"},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sthlm-miljo.maps.arcgis.com/home/item.html?id=ad6ecc1bc6c2471aae5463c0a00bf884"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub - Hämta Tile package"},{"@id":"https://resources.stockholm.se/data/02e4ca8b-0213-4f73-994c-e82b01ec7181#HTTP:ESRI+Portal-URL/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/f2ffe82e0d624cca9ea67bbb4ff4915e"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:257024c659c1e2ad16ba4b9000d0bb61e3c37b582bc8f3bb623ef24767d6207d"},{"@graph":[{"@id":"_:25f48b48d95d1737766a98c00cced6a5ceae9a0f9869681c1ad77f2482a58797_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,1