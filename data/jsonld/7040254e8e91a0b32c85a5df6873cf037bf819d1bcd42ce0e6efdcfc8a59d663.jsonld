e":"Datamängden ingår i produkten Tätortskarta Stockholms län"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:2d21e7401216dc884b58c7b267c2187440180e0a424450a264492e50a3d2a7b9"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:OGC:WMS/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=59b72fb2-0588-4fda-88af-53d7772055bc"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:created":{"@type":"xsd:gYear","@value":"2014"},"dct:description":{"@language":"sv","@value":"Stockholms stadsmuseum ansvarar för att peka ut och definiera kulturhistoriskt värdefull bebyggelse i Stockholms stad. Klassificeringen grundas på de inventeringar Stadsmuseet kontinuerligt gjort sedan 1970-talet och omfattar bebyggelse uppförd före 1960 eller 1990. Ställningstagandet om stadens kulturhistoriska klassificering fattas av Stadsmuseets chef, stadsantikvarien, på delegation av kommunfullmäktige. Klassificering av stadens bebyggelse är ett pågående arbete och nya klassificeringar förs in på den digitala kartan."},"dct:identifier":"2a64e957-9133-41b1-a101-05196d12df33","dct:issued":{"@type":"xsd:gYear","@value":"2014"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@value":"Stadsmuseets kulturhistoriska klassifcieringskarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/dpwebmap/cust_sth/kul/klassificering/DPWebMap.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Kartapplikation (DP/webmap) -Stockholms stadsmuseums kulturhistoriska klassificeringskarta"},{"@id":"https://resources.stockholm.se/data/2a64e957-9133-41b1-a101-05196d12df33#HTTP:OGC:WMS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/dpmap/cust_sth/kul/web/WMS_KUL_KLASSIFICERING_DPWEBMAP?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"Kulturhistorisk klassificering (WMS)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Kulturf%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#