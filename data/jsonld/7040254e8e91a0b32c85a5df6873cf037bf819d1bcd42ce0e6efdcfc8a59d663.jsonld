ac870"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"Att övervaka biologisk mångfald är avgörande för att skydda livsviktiga ekosystemtjänster, förstå miljöförändringar och fatta hållbara beslut. Utan övervakning riskerar vi att förlora arter och funktioner som är grundläggande för människor, djur och växters överlevnad."},"dct:format":"text/html","dct:identifier":"b899f057-8d17-4018-96eb-3de4e5de93f2","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:84af6ad9d52541c9949adb269ec4480ce1af3f861738431010ed2396b2c47af3_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Natur - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2#HTTP:ESRI+Portal-URL/2","dct:title":"Miljöförvaltningens öppna data-hub","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/c0700d6a-ab26-402b-9569-952efa845e74"}},{"@id":"http://data.europa.eu/88u/distribution/d6429cc3-8f08-4214-9c48-62cec731420c","@type":