informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Stadskartan) :Natur10, Geografiska namn, modifierbar, aktiv20, Önamn, modifierbar, aktiv"},"dct:identifier":"b75d3ff7-ce21-43dd-99ce-934ab26a09af","dct:issued":{"@type":"xsd:date","@value":"2005-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cb7f02e68edd94bc5dfff346b22188567a496125b538663bd735714f070a92d3_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Stadskarta - Geografiska namn"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/b75d3ff7-ce21-43dd-99ce-934ab26a09af#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=464514632_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Stadskarta"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cb7f02e68edd94bc5dfff346b22188567a496125b538663bd735714f070a92d3"},{"@graph":[{"@id":"_:cc851930a4e7baebf42249fbe254022eb35d51557df74af5c59e4fd13e480b50_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/8d6e25de-d393-4346-8a68-12750a433f7b","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"https://resources.stockholm.se/data/8d6e25de-d393-4346-8a68-12750a433f7b#HTTP:Information/1"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=5077f026-172d-48bf-b1ec-ff3fa452c9f7"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":{"@language":"sv","@value":"Byggnadsanläggningar består av följande objket- och subtyper (för aktuell lista se Allmän produktspecifikation Baskartan): Byggnadsanläggning: 10, Altan; 20, Lanternin; 30, Skärmtak; 50, Trappa; 60, Lastkaj."},"dct:identifier":"8d6e25de-d393-4346-8a68-12750a433f7b","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cc851930a4e7baebf42249fbe254022eb35d51557df74af5c59e4fd13e480b50_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Baskarta - Byggnadsanläggningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/8d6e25de-d393-4346-8a68-12750a433f7b#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/?query=748573062_Dataportalen_EnkelVy_resultset&loc=sv&SplashScreen=no"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Datamängden ingår i produkten Baskarta (1:400  - 1:2000)."},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:cc851930a4e7baebf42249fbe254022eb35d51557df74af5c59e4fd13e480b50"},{"@graph":[{"@id":"_:cc94abfd0dc87838df3ed2d9c88d949f815e70468de1a0cdf416fdf57a3ecba3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/48868a4d-86bb-493c-9238-06ba82d3ac6c","@type":["dcat:Dataset","dcat:dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/48868a4d-86bb-493c-9238-06ba82d3ac6c#HTTP:API/1"},{"@id":"https://resources.stockholm.se/data/48868a4d-86bb-493c-9238-06ba82d3ac6c#HTTP:Information:Produktspecfikation/2"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=bfedd350-01c1-44b1-ac83-92e8ad92fc18"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},"dct:created":{"@type":"xsd:date","@value":"2018-01-01"},"dct:description":{"@language":"sv","@value":"Informationen i Hitta service API:et används på Stockholms stads webbplatser för att hitta olika typer av service. Informationen i API:et uppdateras löpande."},"dct:identifier":"48868a4d-86bb-493c-9238-06ba82d3ac6c","dct:issued":{"@type":"xsd:date","@value":"2021-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cc94abfd0dc87838df3ed2d9c88d949f815e70468de1a0cdf416fdf57a3ecba3_b0n0"},"dct:title":{"@language":"sv","@value":"Evenemangsplats (ur Hitta Service API)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/48868a4d-86bb-493c-9238-06ba82d3ac6c#HTTP:API/1","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://apigw.stockholm.se/api/PublicHittaCMS/api/serviceunits?&filter%5Bservicetype.id%5D=100&page%5Blimit%5D=1500&page%5Boffset%5D=0&sort=name"},"dct:title":"API anrop av servicetype = Evenemangsplats (JSON)"},{"@id":"https://resources.stockholm.se/data/48868a4d-86bb-493c-9238-06ba82d3ac6c#HTTP:Information:Produktspecfikation/2","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://dataportalen.stockholm.se/dataportalen/Data/Stockholm-VattenOchAvfall/Dokumentation_Hitta_Service_API_(1).pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Dokumentation av API för Hitta Service (pdf)"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsledningskontoret+-+Kommunikations-+och+omv%C3%A4rldsavdelningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsledningskontoret - Kommunikations- och omvärldsavdelningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ola.williams@stockholm.se"}}],"@id":"urn:source:cc94abfd0dc87838df3ed2d9c88d949f815e70468de1a0cdf416fdf57a3ecba3"},{"@graph":[{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2009-04-12"},"dcat:startDate":{"@type":"xsd:date","@value":"2009-04-11"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2009-04-12"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2009-04-11"}},{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1fd57798977b3a626614310e6179200e3d"},{"@id":"http://data.europa.eu/88u/dataset/a83503d8-bafc-4ce7-8026-1335da28c559","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/a1cb2150-8360-434b-90a3-f8827e175f7f"},{"@id":"http://data.europa.eu/88u/distribution/f580d8ee-9e7b-4357-a843-6e59db2c7ffb"},{"@id":"http://data.europa.eu/88u/distribution/f771fba1-c560-4d1f-a2dd-e6f64e4f7b89"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=1e946ed6-9ca0-4916-8592-aa23aab96bca"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2009-04-12"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. 900 mРезолюция: 8 см/пикселОртофотото не е толкова добро, защото няма достатъчно добро покритие, което води до много наклонени къщи. Дата на снимката: 11-12 април 2009 г."},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. 900 mRozlišení: 8 cm/pixelOrtofoto není tak dobré, protože nemá dostatečně dobrý kryt, což má za následek mnoho šikmých domů. Datum pořízení fotografie: a 12. dubna 2009."},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. 900 mResolution: 8 cm / pixelOrtofotoet er ikke så godt, fordi det ikke har god nok dækning, hvilket resulterer i mange skrå huse. Fotografiets dato: den 11.-12. april 2009."},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. 900 mAuflösung: 8 cm/PixelDas Orthofoto ist nicht so gut, weil es nicht genug Abdeckung hat, was zu vielen geneigten Häusern führt. Fotodatum: 11./12. April 2009."},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. 900 mΨήφισμα: 8 cm/pixelΗ ορθοφωτογραφία δεν είναι τόσο καλή επειδή δεν έχει αρκετά καλό κάλυμμα, με αποτέλεσμα πολλά κεκλιμένα σπίτια. Ημερομηνία φωτογραφίας: 11-12 Απριλίου 2009."},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. 900 mResolution: 8 cm/pixelThe orthophoto is not so good because it does not have good enough cover, resulting in many inclined houses. Date of photograph: 11-12 April 2009."},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. 900 mResolución: 8 cm / píxelLa ortofoto no es tan buena porque no tiene una cubierta lo suficientemente buena, lo que resulta en muchas casas inclinadas. Fecha de la fotografía: 11 y 12 de abril de 2009."},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. 900 mLahustusvõime: 8 cm / pikselOrtofoto ei ole nii hea, sest sellel ei ole piisavalt head katet, mille tulemuseks on palju kaldmaju. Foto kuupäev: 12. aprill 2009."},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. 900 mResoluutio: 8 cm / pikseliOrtokuva ei ole niin hyvä, koska siinä ei ole tarpeeksi hyvää suojaa, mikä johtaa moniin kalteviin taloihin. Valokuvauksen päivämäärä: 11.–12. huhtikuuta 2009."},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. 900 mRésolution: 8 cm/pixelL'orthophoto n'est pas si bonne car elle n'a pas assez de couverture, ce qui entraîne de nombreuses maisons inclinées. Date de la photographie: 11-12 avril 2009."},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. 900 mRéiteach: 8 cm / picteilín Níl an orthophoto chomh maith sin toisc nach bhfuil clúdach maith go leor aige, rud a fhágann go bhfuil go leor tithe claonta ann. Dáta an ghrianghraif: 11-12 Aibreán 2009."},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. 900 mRezolucija: 8 cm / pikselaOrtofoto nije tako dobar jer nema dovoljno dobar pokrov, što rezultira mnogim sklonim kućama. Datum fotografije: 12. travnja 2009."},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. 900 mFelbontás: 8 cm / pixelAz ortofotó nem olyan jó, mert nincs elég jó fedél, ami sok ferde házat eredményez. Fénykép dátuma: 2009. április 11–12."},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. 900 mRisoluzione: 8 cm/pixelL'ortofoto non è così buona perché non ha una copertura sufficiente, con conseguente molte case inclinate. Data della fotografia: 11-12 aprile 2009."},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. 900 mRezoliucija: 8 cm / pikselisOrtofotografija nėra tokia gera, nes ji neturi pakankamai geros dangos, todėl yra daug nuožulnių namų. Fotografavimo data: 2009 m. balandžio 11–12 d."},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. 900 mIzšķirtspēja: 8 cm / pikseļiOrtofoto nav tik labs, jo tam nav pietiekami laba pārsega, kā rezultātā rodas daudzas slīpas mājas. Fotogrāfijas datums: 2009. gada 11.–12. aprīlī."},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. 900 mRiżoluzzjoni: 8 cm / pixelL-ortofoto mhuwiex daqshekk tajjeb għax m'għandux kopertura tajba biżżejjed, li tirriżulta f'ħafna djar inklinati. Data tar-ritratt: 11-12 ta' April 2009."},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. 900 mResolutie: 8 cm/pixelDe orthofoto is niet zo goed omdat deze niet goed genoeg afdekking heeft, wat resulteert in veel schuine huizen. Datum van de foto: 11-12 april 2009."},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. 900 mRozdzielczość: 8 cm / pikselOrtofotomapa nie jest tak dobra, ponieważ nie ma wystarczająco dobrej pokrywy, co skutkuje wieloma nachylonymi domami. Data zdjęcia: 11–12 kwietnia 2009 r."},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. 900 mResolução: 8 cm/pixelA ortofotografia não é tão boa porque não tem uma cobertura suficientemente boa, resultando em muitas casas inclinadas. Data da fotografia: 11-12 de Abril de 2009."},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. 900 mRezoluție: 8 cm / pixelOrtofoto nu este atât de bun, deoarece nu are o acoperire suficient de bună, rezultând în multe case înclinate. Data fotografiei: 11-12 aprilie 2009."},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. 900 mRozlíšenie: 8 cm / pixelOrtofoto nie je tak dobré, pretože nemá dostatočne dobrý kryt, čo vedie k mnohým šikmým domom. Dátum fotografie: 12. apríla 2009."},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. 900 mResolucija: Ortofoto ni tako dober, ker nima dovolj dobrega pokrova, zaradi česar je veliko nagnjenih hiš. Datum fotografiranja: in 12. aprila 2009."},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter.Flyghöjd: 900 mUpplösning: 8 cm/pixelOrtofotot är inte så bra eftersom det inte har tillräckligt bra övertäckning, vilket resulterar i många lutande hus. Fotograferingsdatum: 11-12 april 2009."},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. 900 мРезолюція: 8 см/піксельОртофото не так добре, тому що воно не має достатньо гарного покриття, що призводить до багатьох похилих будинків. Дата фотографії: 11-12 квітня 2009 року."}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"a83503d8-bafc-4ce7-8026-1335da28c559","dct:issued":{"@type":"xsd:date","@value":"2010-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b0n0"},"dct:temporal":{"@id":"_:cca10ecfb1d1ecb833c7695bb273eed43c54a35ca76d1026e57d29919278a42b_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Ortofoto (2009 г.)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Ortofoto (2009) - scénář"},{"@language":"da-t-sv-t0-mtec","@value":"Ortofoto af SBK (2009)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Ορτοφότο (2009)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Ortofoto (2009.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)[szerkesztés]"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Ortofoto (2009 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Ortofoto (2009) - Kto odpowiedział?"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"},{"@language":"sv","@value":"SBK Ortofoto (2009)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Ortofoto (2009)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/a1cb2150-8360-434b-90a3-f8827e175f7f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2009"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:OGC:WMS/5","dct:title":["WMS-tjänst Ortofoto 2009",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2009"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2009"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2009"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2009"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2009"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2009"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2009"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Ortofoto 2009"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2009"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2009"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2009"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2009"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2009"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2009"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2009"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2009"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2009"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS service Ortofoto 2009"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2009"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2009"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2009"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2009"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2009"},{"@language":"uk-t-sv-t0-mtec","@value":"Сервіс WMS Ortofoto 2009"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/a1cb2150-8360-434b-90a3-f8827e175f7f"}},{"@id":"http://data.europa.eu/88u/distribution/f580d8ee-9e7b-4357-a843-6e59db2c7ffb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/a83503d8-bafc-4ce7-8026-1335da28c559#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes 