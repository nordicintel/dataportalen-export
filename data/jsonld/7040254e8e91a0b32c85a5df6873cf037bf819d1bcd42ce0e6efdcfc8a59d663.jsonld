ortal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:a09682e9f2aa5e37882acee8737ea235d66827a36d8bfc0f84e5d77e4d46cfcc_b0n0"},"dct:title":{"@language":"sv","@value":"NVDB - Inskränkningar för transport av farligt gods"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/a02305a6-52b0-4685-bfc4-cef4d29e0286#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/a02305a6-52b0-4685-bfc4-cef4d29e0286#HTTP:Nedladdning/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se/LvWS-2.2/Lv.asmx"},"dct:description":"Beskrivning av LvWS APIs olika metoder.","dct:title":"Tjänsteadress web service"},{"@id":"https://resources.stockholm.se/data/a02305a6-52b0-4685-bfc4-cef4d29e0286#HTTP:Nedladdning/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:NVDB_Inskrankningar_for_transport_av_farligt_gods&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar en GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/a02305a6-52b0-4685-bfc4-cef4d29e0286#HTTP:OGC:WFS/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:NVDB_Inskrankningar_for_transport_av_farligt_gods"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/