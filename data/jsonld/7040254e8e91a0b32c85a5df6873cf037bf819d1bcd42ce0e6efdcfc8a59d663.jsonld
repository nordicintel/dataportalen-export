s#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:16e51758ad2d9a6609a05d861617c8ee573bd8282f5acb022a725b654d8bf8e4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/68117e95-508c-466a-9814-02344bd3e8ee","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"},{"@language":"sv","@value":"IoT"},{"@language":"sv","@value":"MQTT"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=73b4a664-10b8-4dae-ae45-b80bebebeea9"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"OBS TEST: DENNA TJÄNST BÖR INTE ANVÄNDAS. Sensorerna publicerar data med jämna intervall till en meddelandetjänst baserad på MQTT, och som är publikt åtkomlig i realtid. MQTT (Message Queuing Telemetry Transport) är ett lättviktigt och publicerings-/prenumerationsbaserat protokoll som är idealiskt för applikationer där bandbredd och nätverksstabilitet är begränsade, såsom vid överföring av sensordata i IoT-miljöer. Genom att använda MQTT för att hantera sensordata kan man bygga effektiva och skalbara IoT-lösningar som är både pålitliga och energieffektiva. För att använda sig av servern, behöver man en klient för desktop eller servertjänst som kan koppla upp sig och prenumerera på MQTT strömmar. Vanliga MQTT klienter är till exempel ”MQTT Explorer” eller ”MQTT Box”."},"dct:identifier":"68117e95-508c-466a-9814-02344bd3e8ee","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:title":{"@language":"sv","@value":"SBK Testmetadata för RISE IoT-portal (open)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stadsbyggnadskontoret - Stadsmätningsavdelningen - Geodatadistributionsenheten"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodataservice@stockholm.se"}}],"@id":"urn:source:18a66e226b5b974ae486c13c7dcca89ed51fbf642f29dc9146ffb89c0899325b"},{"@graph":[{"@id":"_:199ee625f52f4a82d8d329a31c022d0b89dced211b83ea1472b49bdc1636fc5e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockh