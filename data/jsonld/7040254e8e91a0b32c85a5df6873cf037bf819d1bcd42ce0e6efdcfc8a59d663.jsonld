@stockholm.se"}}],"@id":"urn:source:07d252a204dfba7e3b4d839c4a9f8b970fcc312a59207fe0da1f12b1e2af9979"},{"@graph":[{"@id":"_:0852dcece257790cef31ebcbec34b01d0260762d3b919fb00c00568cd828c1b5_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/bbd44423-0b7e-4563-bacf-7563dcb9b24a","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/bbd44423-0b7e-4563-bacf-7563dcb9b24a#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/bbd44423-0b7e-4563-bacf-7563dcb9b24a#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/bbd44423-0b7e-4563-bacf-7563dcb9b24a#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/bbd44423-0b7e-4563-bacf-7563dcb9b24a#HTTP:OGC:WMS/4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Signal"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById