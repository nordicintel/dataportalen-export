#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:50f2948b16b70c751c16a8021440dd86a18a20b91f64ded8f30979091ac35bdd"},{"@graph":[{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.444,18.2011 59.444,18.2011 59.2272,17.7605 59.2272,17.7605 59.444))"}},{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16bee1c293014c0b841a52a49ea77e8b9c"},{"@id":"http://data.europa.eu/88u/dataset/097af499-5a1d-4e17-9341-c71176eb18c4","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37"},{"@id":"http://data.europa.eu/88u/distribution/a4698b79-e435-4067-858c-60dba7613b05"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=6acef71a-7573-4dc8-a4f7-32df59c39399"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2026-01-01"},"dct:description":{"@language":"sv","@value":"Kommunerna har ett viktigt ansvar för att Sveriges vatten ska uppnå miljökvalitetsnormerna enligt EU:s vattendirektiv. Därför tar Stockholms stad fram lokala åtgärdsprogram för stadens vattenförekomster. Syftet med åtgärdsprogrammen är att beskriva lokala påverkanskällor, vilket förbättringsbehov som finns samt vilka åtgärder som behöver genomföras för att uppnå normerna. Den geografiska avgränsningen är vattenförekomstens avrinningsområde. De lokala åtgärdsprogrammen är inte rättsligt bindande, så som Vattenmyndighetens åtgärdsprogram är. Vattenmyndighetens åtgärdsprogram avhandlar generella åtgärder inom vattendistriktet medan de lokala åtgärdsprogrammen förtydligar vad som behöver göras inom respektive avrinningsområde. De lokala åtgärdsprogrammen är tänkta att användas som ett stöd i kommunernas egen planering, samt för att visa vilken miljökvalitet som behöver uppnås och vad som krävs för att nå dit."},"dct:format":"text/html","dct:identifier":"097af499-5a1d-4e17-9341-c71176eb18c4","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:5195258ec1cf1eed25840622e395b7ae4f6f9dfb9170dad2265bd2a6cf346fbe_b0n0"},"dct:title":{"@language":"sv","@value":"Åtgärdsdata - Lokala åtgärdsprogram - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/6df809c9-08b0-45c5-90bb-d444833b0c37","@type":"dcat:Di