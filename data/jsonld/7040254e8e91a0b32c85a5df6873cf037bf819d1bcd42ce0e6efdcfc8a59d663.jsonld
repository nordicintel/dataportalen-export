00e96e4d2693a1357b"},{"@graph":[{"@id":"_:a704550743b45d30b17500b090bddaf49d54fddec8222ade92881542ad8bac55_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.759 59.4403,18.2024 59.4403,18.2024 59.2272,17.759 59.2272,17.759 59.4403))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.759 59.4403,18.2024 59.4403,18.2024 59.2272,17.759 59.2272,17.759 59.4403))"}},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:API/1"},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:Information/4"},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:OGC:WFS/2"},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:OGC:WMS/3"}],"dcat:keyword":["Stockholm Vatten och Avfall",{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fastigheter och fysisk planering"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Höjddata"},{"@language":"sv","@value":"Miljö"},{"@language":"sv","@value":"Sjöar och vattendrag"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=50d6db4c-88d3-401f-92e1-60ee1dc7e038"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Naturliga Avrinningsområden Stockholms kommun. Det finns även något som kallas tekniskt avrinningsområde. Det är det avrinningsområde som bidrar med vatten när man tar hänsyn till att det finns ett dagvattennät i marken. Vid skyfall fylls dagvattennätet och därför är de naturliga avrinningsområdena mest relevanta för analys av skyfall. En yta per vattenförekomst."},"dct:identifier":"6edac281-4ad2-479a-aeae-b082f49d1eeb","dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:modified":{"@type":"xsd:date","@value":"2018-12-10"},"dct:publisher":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/"},"dct:spatial":{"@id":"_:a704550743b45d30b17500b090bddaf49d54fddec8222ade92881542ad8bac55_b0n0"},"dct:title":{"@language":"sv","@value":"Avrinningsområden (Naturliga) - Öppna data"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:API/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata-svoa-extern.stockholm.se/Geodata/arcgis/rest/services/Dagvatten/Naturliga_avromr_dag_vattenforekomst/MapServer"},"dct:description":"Naturliga avrinningsområden dagvatten (vattenförekomst)","dct:title":"Stockholm Vatten och Avfall - Öppna Data"},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:Information/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data-svoa2.hub.arcgis.com/maps/ce0da0c09b3e48468c5a912e42b15dcb"},"dct:description":"Naturliga avrinningsområden","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Stockholm Vatten och Avfall - Öppna Data"},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:OGC:WFS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata-svoa-extern.stockholm.se/Geodata/arcgis/services/Dagvatten/Naturliga_avromr_dag_vattenforekomst/MapServer/WFSServer?request=GetCapabilities&service=WFS"},"dct:description":"Naturliga avrinningsområden dagvatten (vattenförekomst)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"Stockholm Vatten och Avfall - Öppna Data","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/50d6db4c-88d3-401f-92e1-60ee1dc7e038#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata-svoa-extern.stockholm.se/Geodata/arcgis/services/Dagvatten/Naturliga_avromr_dag_vattenforekomst/MapServer/WMSServer?request=GetCapabilities&service=WMS"},"dct:description":"Naturliga avrinningsområden dagvatten (vattenförekomst)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"Stockholm Vatten och Avfall - Öppna Data"},{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholm+Vatten+och+Avfall/","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:gis@svoa.se"},"foaf:name":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"foaf:phone":{"@id":"tel:+08-52212000"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholm+Vatten+och+Avfall/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholm Vatten och Avfall"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis@svoa.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"tel:+08-52212000"}}],"@id":"urn:source:a704550743b45d30b17500b090bddaf49d54fddec8222ade92881542ad8bac55"},{"@graph":[{"@id":"_:a7d96820818c0d029f2148690a256ecdff03db88bd2a0e7a9c5334874374cc2c_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:a7d96820818c0d029f2148690a256ecdff03db88bd2a0e7a9c5334874374cc2c_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1b84e882262f1521c17638427819a08422"},{"@id":"http://data.europa.eu/88u/dataset/f9710b3f-401b-4c88-8138-2cd57408b104","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/11a889af-6a83-4939-be5b-4404b7d3d36a"},{"@id":"http://data.europa.eu/88u/distribution/74ae072e-007b-4576-bba8-d663f0c9f486"},{"@id":"http://data.europa.eu/88u/distribution/e446aa22-110f-474f-9e51-83bfe919f1fc"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=269cb7f1-fdb3-43de-aed0-db3ed047162b"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:created":{"@type":"xsd:date","@value":"1992-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Базовата карта е широкомащабна, триизмерна, с висока точност работа по цифрово картографиране, която представя основните географски и административни условия в град Стокхолм. Информацията за картата се съхранява в равнини с координати x, y и на височината на z-стойностите. Картата показва, наред с други неща, сгради, пътища, дървета и информация за надморската височина. Картата се използва главно в диапазона от 1:400 до 1:2000. В много общини основната карта се нарича още Primärktartan.Основната карта се използва в много различни контексти като основна карта, където се добавя специфична за дейността информация, за да се създаде карта, адаптирана за целта. Това могат да бъдат основни карти, нови карти на сградите, карти на разрешителните за строеж, карти на основните точки, карти на наредбите, карти на инвентара и др. Събирането на информация за базовата карта продължава от много години и с различни методи. Това означава, че качеството варира, но с течение на времето има постепенно подобрение. Цялата информация е качество, маркирано с произход, време и метод на събиране, когато се съхранява в базата данни. Има няколко различни картографски продукта, които могат да бъдат експортирани от базовата карта и доставени на клиентите. Някои от продуктите на картата съдържат информация за собствеността. Информацията за имота всъщност принадлежи към картата на регистъра. Това важи и за основните точки, които също са тясно свързани с базовата карта, но формират свой собствен набор от данни. Службата за градско планиране използва различен клиентски софтуер (напр. dpMap, MicroStation, StockholmExport), за да извлича, експортира и доставя информация от базовата карта на клиентите."},{"@language":"cs-t-sv-t0-mtec","@value":"Základní mapa je rozsáhlá, trojrozměrná, vysoce přesná digitální mapová práce, která představuje základní geografické a administrativní podmínky ve městě Stockholm. Mapové informace jsou uloženy v rovinách se souřadnicemi x, y a ve výšce hodnot z. Mapa zobrazuje mimo jiné informace o budovách, silnicích, stromech a nadmořské výšce. Mapa se používá hlavně v měřítku od 1:400 do 1:2000. V mnoha obcích se základní mapa také nazývá Primärktartan.Základní mapa se používá v mnoha různých kontextech jako podkladová mapa, kde se přidávají informace specifické pro danou činnost, aby se vytvořila mapa přizpůsobená pro tento účel. Může se jednat o základní mapy, nové stavební mapy, mapy stavebních povolení, mapy základních bodů, mapy vyhlášek, inventární mapy atd. Shromažďování informací pro základní mapu probíhá již mnoho let a různými metodami. To znamená, že kvalita se liší, ale v průběhu času dochází k postupnému zlepšování. Všechny informace jsou kvalita označena původem, časem a způsobem sběru, když jsou uloženy v databázi. Existuje několik různých mapových produktů, které lze exportovat ze základní mapy a dodávat zákazníkům. Některé mapové produkty obsahují informace o vlastnostech. Informace o majetku ve skutečnosti patří do mapy registru. To platí i pro klíčové body, které jsou také úzce spjaty se základní mapou, ale tvoří svůj vlastní datový soubor. Městský plánovací úřad používá různé klientské programy (např. dpMap, MicroStation, StockholmExport) k extrakci, exportu a doručení informací ze Základní mapy zákazníkům."},{"@language":"da-t-sv-t0-mtec","@value":"Basiskortet er et storstilet, tredimensionelt, højpræcist digitalt kortlægningsarbejde, der præsenterer de grundlæggende geografiske og administrative forhold i Stockholm. Kortoplysningerne gemmes i planer med x-, y-koordinater og i højden af z-værdier. Kortet viser blandt andet bygninger, veje, træer og højdeinformation. Kortet bruges hovedsageligt i skalaen fra 1:400 til 1:2000. I mange kommuner kaldes det grundlæggende kort også Primärktartan.Det grundlæggende kort bruges i mange forskellige sammenhænge som baggrundskort, hvor aktivitetsspecifikke oplysninger tilføjes for at skabe et kort, der er tilpasset formålet. Disse kan være grundlæggende kort, nye byggekort, byggetilladelseskort, centrale punktkort, ordinancekort, lagerkort osv Indsamlingen af oplysninger til basekortet har foregået i mange år og med forskellige metoder. Det betyder, at kvaliteten varierer, men der sker en gradvis forbedring over tid. Alle oplysninger er kvalitetsmærket med oprindelse, tid og indsamlingsmetode, når de gemmes i databasen. Der er flere forskellige kortprodukter, der kan eksporteres fra Base Map og leveres til kunder. Flere af kortprodukterne indeholder ejendomsoplysninger. Ejendomsoplysninger hører faktisk til registerkortet. Dette gælder også for centrale punkter, der også er tæt forbundet med basiskortet, men danner deres eget datasæt. Byplanlægningskontoret bruger forskellige klientsoftware (f.eks. dpMap, MicroStation, StockholmExport) til at udtrække, eksportere og levere oplysninger fra basiskortet til kunderne.Kortoplysningerne offentliggøres også via en række korttjenester, såkaldte WMS-tjenester."},{"@language":"de-t-sv-t0-mtec","@value":"Die Basiskarte ist eine groß angelegte, dreidimensionale, hochpräzise digitale Kartierungsarbeit, die die grundlegenden geografischen und administrativen Bedingungen in der Stadt Stockholm darstellt. Die Karteninformationen werden in Ebenen mit x-, y-Koordinaten und auf der Höhe von z-Werten gespeichert. Die Karte zeigt unter anderem Gebäude, Straßen, Bäume und Höheninformationen. Die Karte wird hauptsächlich im Maßstabsbereich von 1:400 bis 1:2000 verwendet. In vielen Gemeinden wird die Basiskarte auch Primärktartan genannt.Die Basiskarte wird in vielen verschiedenen Kontexten als Hintergrundkarte verwendet, bei der aktivitätsspezifische Informationen hinzugefügt werden, um eine für den Zweck angepasste Karte zu erstellen. Dies können Basiskarten, Neubaukarten, Baugenehmigungskarten, Kernpunktkarten, Verordnungskarten, Bestandskarten usw. sein. Dies bedeutet, dass die Qualität variiert, aber es gibt eine allmähliche Verbesserung im Laufe der Zeit. Alle Informationen sind mit Herkunft, Zeit und Erhebungsmethode gekennzeichnet, wenn sie in der Datenbank gespeichert sind. Es gibt verschiedene Kartenprodukte, die aus der Basiskarte exportiert und an Kunden geliefert werden können. Einige der Kartenprodukte enthalten Eigenschaftsinformationen. Immobilieninformationen gehören tatsächlich zur Registerkarte. Dies gilt auch für Kernpunkte, die ebenfalls eng mit der Basiskarte verbunden sind, aber einen eigenen Datensatz bilden. Das Stadtplanungsbüro verwendet verschiedene Client-Software (z.B. dpMap, MicroStation, StockholmExport), um Informationen aus der Basiskarte zu extrahieren, zu exportieren und an Kunden zu liefern.Die Karteninformationen werden auch über eine Reihe von Kartendiensten, sogenannte WMS-Dienste, veröffentlicht."},{"@language":"el-t-sv-t0-mtec","@value":"Ο βασικός χάρτης είναι ένα μεγάλης κλίμακας, τρισδιάστατο, υψηλής ακρίβειας έργο ψηφιακής χαρτογράφησης που παρουσιάζει τις βασικές γεωγραφικές και διοικητικές συνθήκες στην πόλη της Στοκχόλμης. Οι πληροφορίες του χάρτη αποθηκεύονται σε επίπεδα με συντεταγμένες x, y και στο ύψος των τιμών z. Ο χάρτης δείχνει, μεταξύ άλλων, κτίρια, δρόμους, δέντρα και πληροφορίες για το υψόμετρο. Ο χάρτης χρησιμοποιείται κυρίως στην κλίμακα από 1:400 έως 1:2000. Σε πολλούς δήμους, ο βασικός χάρτης ονομάζεται επίσης Primärktartan.Ο βασικός χάρτης χρησιμοποιείται σε πολλά διαφορετικά πλαίσια ως χάρτης υποβάθρου, όπου προστίθενται ειδικές πληροφορίες ανά δραστηριότητα για τη δημιουργία ενός χάρτη προσαρμοσμένου για το σκοπό αυτό. Αυτοί μπορεί να είναι βασικοί χάρτες, νέοι χάρτες κτιρίων, χάρτες οικοδομικών αδειών, χάρτες βασικών σημείων, χάρτες διατάξεων, χάρτες απογραφής κ.λπ. Η συλλογή πληροφοριών για τον βασικό χάρτη συνεχίζεται εδώ και πολλά χρόνια και με διαφορετικές μεθόδους. Αυτό σημαίνει ότι η ποιότητα ποικίλλει, αλλά υπάρχει σταδιακή βελτίωση με την πάροδο του χρόνου. Όλες οι πληροφορίες είναι ποιότητα που επισημαίνεται με την προέλευση, το χρόνο και τη μέθοδο συλλογής όταν αποθηκεύονται στη βάση δεδομένων. Υπάρχουν πολλά διαφορετικά προϊόντα χαρτών που μπορούν να εξαχθούν από το βασικό χάρτη και να παραδοθούν στους πελάτες. Πολλά από τα προϊόντα του χάρτη περιέχουν πληροφορίες ιδιοκτησίας. Οι πληροφορίες ιδιοκτησίας ανήκουν πραγματικά στον χάρτη μητρώου. Αυτό ισχύει επίσης για τα βασικά σημεία που συνδέονται επίσης στενά με τον βασικό χάρτη, αλλά αποτελούν το δικό τους σύνολο δεδομένων. Το Γραφείο Πολεοδομικού Σχεδιασμού χρησιμοποιεί διάφορα λογισμικά πελατών (π.χ. dpMap, MicroStation, StockholmExport) για την εξαγωγή, εξαγωγή και παράδοση πληροφοριών από τον Βασικό Χάρτη στους πελάτες."},{"@language":"en-t-sv-t0-mtec","@value":"The base map is a large-scale, three-dimensional, high-accuracy digital mapping work that presents the basic geographical and administrative conditions in the City of Stockholm. The map information is stored in planes with x, y coordinates and at the height of z-values. The map shows, among other things, buildings, roads, trees, and altitude information. The map is mainly used in the scale range from 1:400 to 1:2000. In many municipalities, the basic map is also called Primärktartan.The basic map is used in many different contexts as a background map, where activity-specific information is added to create a map adapted for the purpose. These can be basic maps, new building maps, building permit maps, core point maps, ordinance maps, inventory maps, etc. The collection of information for the Base Map has been going on for many years and with different methods. This means that the quality varies, but there is a gradual improvement over time. All information is quality marked with origin, time and method of collection when stored in the database. There are several different map products that can be exported from the Base Map and delivered to customers. Several of the map products contain property information. Property information actually belongs to the Register Map. This also applies to core points that are also closely related to the Base Map but form their own dataset. The City Planning Office uses various client software (e.g. dpMap, MicroStation, StockholmExport) to extract, export and deliver information from the Base Map to customers.The map information is also published via a number of map services, so-called WMS services."},{"@language":"es-t-sv-t0-mtec","@value":"El mapa base es un trabajo de mapeo digital a gran escala, tridimensional y de alta precisión que presenta las condiciones geográficas y administrativas básicas en la ciudad de Estocolmo. La información del mapa se almacena en planos con coordenadas x, y y a la altura de los valores z. El mapa muestra, entre otras cosas, edificios, carreteras, árboles e información de altitud. El mapa se utiliza principalmente en el rango de escala de 1:400 a 1:2000. En muchos municipios, el mapa básico también se llama Primärktartan.El mapa básico se utiliza en muchos contextos diferentes como un mapa de fondo, donde se agrega información específica de la actividad para crear un mapa adaptado para el propósito. Estos pueden ser mapas básicos, mapas de construcción nuevos, mapas de permisos de construcción, mapas de puntos centrales, mapas de ordenanzas, mapas de inventario, etc. La recopilación de información para el Mapa Base ha estado ocurriendo durante muchos años y con diferentes métodos. Esto significa que la calidad varía, pero hay una mejora gradual con el tiempo. Toda la información es de calidad marcada con origen, hora y método de recogida cuando se almacena en la base de datos. Hay varios productos de mapas diferentes que se pueden exportar desde el Mapa Base y entregar a los clientes. Varios de los productos del mapa contienen información de la propiedad. La información de la propiedad realmente pertenece al Mapa del Registro. Esto también se aplica a los puntos centrales que también están estrechamente relacionados con el Mapa Base, pero forman su propio conjunto de datos. La Oficina de Planificación Urbana utiliza varios programas informáticos del cliente (por ejemplo, dpMap, MicroStation, StockholmExport) para extraer, exportar y entregar información del mapa base a los clientes."},{"@language":"et-t-sv-t0-mtec","@value":"Baaskaart on suuremahuline, kolmemõõtmeline, suure täpsusega digitaalne kaardistamine, mis tutvustab Stockholmi linna peamisi geograafilisi ja administratiivseid tingimusi. Kaardiinfot hoitakse x- ja y-koordinaatidega tasapindadel ning z-väärtuste kõrgusel. Kaardil on muu hulgas näidatud hooned, teed, puud ja kõrgusteave. Kaarti kasutatakse peamiselt skaalal 1:400 kuni 1:2000. Paljudes omavalitsustes nimetatakse põhikaarti ka Primärktartaniks.Põhikaarti kasutatakse paljudes erinevates kontekstides taustakaardina, kuhu lisatakse tegevusspetsiifilist teavet, et luua selleks kohandatud kaart. Need võivad olla põhikaardid, uued ehituskaardid, ehituslubade kaardid, põhipunktide kaardid, määruste kaardid, inventarikaardid jne. Baaskaardi jaoks teabe kogumine on toimunud juba aastaid ja erinevate meetoditega. See tähendab, et kvaliteet varieerub, kuid aja jooksul paraneb see järk-järgult. Andmebaasis talletatud andmete kvaliteedile on märgitud nende päritolu, kogumise aeg ja viis. On mitmeid erinevaid kaarditooteid, mida saab baaskaardilt eksportida ja klientidele tarnida. Mitmed kaarditooted sisaldavad kinnisvarateavet. Kinnisvarateave kuulub tegelikult registrikaardile. See kehtib ka põhipunktide kohta, mis on samuti tihedalt seotud põhikaardiga, kuid moodustavad oma andmekogumi. Linnaplaneerimisamet kasutab erinevaid klienditarkvarasid (nt dpMap, MicroStation, StockholmExport) baaskaardilt teabe hankimiseks, eksportimiseks ja klientidele edastamiseks. Kaarditeavet avaldatakse ka mitmete kaarditeenuste, nn WMS-teenuste kaudu."},{"@language":"fi-t-sv-t0-mtec","@value":"Peruskartta on laajamittainen, kolmiulotteinen ja erittäin tarkka digitaalinen kartoitustyö, joka esittelee Tukholman kaupungin maantieteelliset ja hallinnolliset perusolosuhteet. Karttatiedot tallennetaan x-, y-koordinaateilla varustettuihin tasoihin ja z-arvojen korkeudelle. Kartta näyttää muun muassa rakennukset, tiet, puut ja korkeustiedot. Karttaa käytetään pääasiassa asteikolla 1:400 - 1:2000. Monissa kunnissa peruskarttaa kutsutaan myös Primärktartaniksi.Peruskarttaa käytetään monissa eri yhteyksissä taustakarttana, johon lisätään toimintokohtaista tietoa tarkoitukseen mukautetun kartan luomiseksi. Näitä voivat olla peruskartat, uudet rakennuskartat, rakennuslupakartat, ydinpistekartat, määräyskartat, inventaariokartat jne. Tämä tarkoittaa, että laatu vaihtelee, mutta paranee vähitellen ajan myötä. Tietokantaan tallennetut tiedot ovat laatumerkitty alkuperällä, keruuajalla ja -tavalla. On olemassa useita erilaisia karttatuotteita, jotka voidaan viedä peruskartasta ja toimittaa asiakkaille. Useat karttatuotteet sisältävät kiinteistötietoja. Kiinteistön tiedot kuuluvat itse asiassa rekisterikarttaan. Tämä koskee myös keskeisiä kohtia, jotka liittyvät läheisesti myös peruskarttaan mutta muodostavat oman tietoaineistonsa. Kaupunkisuunnittelutoimisto käyttää erilaisia asiakasohjelmistoja (esim. dpMap, MicroStation, StockholmExport) peruskartan tietojen poimimiseen, vientiin ja toimittamiseen asiakkaille."},{"@language":"fr-t-sv-t0-mtec","@value":"La carte de base est un travail de cartographie numérique à grande échelle, tridimensionnel et de haute précision qui présente les conditions géographiques et administratives de base de la ville de Stockholm. Les informations cartographiques sont stockées dans des plans avec des coordonnées x, y et à la hauteur des valeurs z. La carte montre, entre autres, les bâtiments, les routes, les arbres et les informations d'altitude. La carte est principalement utilisée dans la gamme d'échelle de 1:400 à 1:2000. Dans de nombreuses municipalités, la carte de base est également appelée Primärktartan.La carte de base est utilisée dans de nombreux contextes différents comme carte de fond, où des informations spécifiques à l'activité sont ajoutées pour créer une carte adaptée à cet effet. Il peut s'agir de cartes de base, de nouvelles cartes de bâtiments, de cartes de permis de construire, de cartes de points de base, de cartes d'ordonnance, de cartes d'inventaire, etc. La collecte d'informations pour la carte de base se poursuit depuis de nombreuses années et avec différentes méthodes. Cela signifie que la qualité varie, mais qu'il y a une amélioration progressive au fil du temps. Toutes les informations sont de qualité marquée avec l'origine, l'heure et la méthode de collecte lorsqu'elles sont stockées dans la base de données. Il existe plusieurs produits cartographiques différents qui peuvent être exportés à partir de la carte de base et livrés aux clients. Plusieurs des produits cartographiques contiennent des informations sur la propriété. Les informations sur la propriété appartiennent en fait à la carte du registre. Cela s'applique également aux points de base qui sont également étroitement liés à la carte de base, mais qui forment leur propre ensemble de données. Le bureau d'urbanisme utilise divers logiciels clients (par exemple dpMap, MicroStation, StockholmExport) pour extraire, exporter et fournir des informations de la carte de base aux clients."},{"@language":"ga-t-sv-t0-mtec","@value":"Is obair mhapála dhigiteach ar scála mór, tríthoiseach, ardchruinnis í an bhunléarscáil lena gcuirtear i láthair na bunchoinníollacha geografacha agus riaracháin i gCathair Stócólm. Stóráiltear an fhaisnéis léarscáile i bplánaí le comhordanáidí x, y agus ag airde luachanna z. Taispeánann an léarscáil, i measc rudaí eile, foirgnimh, bóithre, crainn agus faisnéis airde. Úsáidtear an léarscáil go príomha sa raon scála ó 1:400 go 1:2000. I roinnt mhaith bardas, tugtar Primärktartan ar an léarscáil bhunúsach freisin. Úsáidtear an léarscáil bhunúsach i go leor comhthéacsanna éagsúla mar léarscáil chúlra, áit a gcuirtear faisnéis a bhaineann go sonrach le gníomhaíocht leis chun léarscáil a chruthú atá oiriúnaithe chun na críche sin. Is féidir iad seo a bheith ina léarscáileanna bunúsacha, léarscáileanna tógála nua, léarscáileanna ceadanna tógála, léarscáileanna pointí lárnacha, léarscáileanna ordúcháin, léarscáileanna fardail, etc. Tá bailiú faisnéise don Bhonnléarscáil ag dul ar aghaidh le blianta fada agus le modhanna éagsúla. Ciallaíonn sé seo go n-athraíonn an caighdeán, ach tá feabhas de réir a chéile le himeacht ama. Tá an fhaisnéis go léir marcáilte ar chaighdeán le tionscnamh, am agus modh bailithe nuair a stóráiltear sa bhunachar sonraí í. Tá roinnt táirgí léarscáil éagsúla is féidir a onnmhairiú ón mBonnléarscáil agus a sheachadadh chuig custaiméirí. Tá faisnéis faoi mhaoin i gcuid de na táirgí léarscáile. Baineann faisnéis faoi mhaoin leis an Léarscáil Cláir i ndáiríre. Baineann sé sin freisin le croíphointí a bhfuil dlúthbhaint acu freisin leis an mBonnléarscáil ach arb iad a dtacar sonraí féin iad. Úsáideann an Oifig Pleanála Cathrach bogearraí cliant éagsúla (m.sh. dpMap, MicroStation, StockholmExport) chun faisnéis a bhaint, a easpórtáil agus a sheachadadh ón mBonnléarscáil chuig custaiméirí."},{"@language":"hr-t-sv-t0-mtec","@value":"Osnovna karta je veliki, trodimenzionalni, visokoprecizni digitalni kartografski rad koji predstavlja osnovne zemljopisne i administrativne uvjete u gradu Stockholmu. Informacije na karti pohranjuju se u ravninama s koordinatama x, y i na visini z-vrijednosti. Karta prikazuje, između ostalog, zgrade, ceste, drveće i informacije o nadmorskoj visini. Karta se uglavnom koristi u rasponu ljestvice od 1:400 do 1:2000. U mnogim općinama osnovna karta naziva se i Primärktartan.Osnovna karta koristi se u mnogim različitim kontekstima kao pozadinska karta, gdje se dodaju informacije specifične za aktivnost kako bi se izradila karta prilagođena toj svrsi. To mogu biti osnovne karte, nove karte zgrada, karte građevinskih dozvola, karte glavnih točaka, karte pravilnika, karte inventara itd. Prikupljanje informacija za osnovnu kartu traje već dugi niz godina i različitim metodama. To znači da kvaliteta varira, ali s vremenom dolazi do postupnog poboljšanja. Sve informacije su kvalitete označene porijeklom, vremenom i načinom prikupljanja kada su pohranjene u bazi podataka. Postoji nekoliko različitih kartografskih proizvoda koji se mogu izvesti iz osnovne karte i isporučiti kupcima. Nekoliko proizvoda na karti sadržava informacije o nekretninama. Informacije o nekretnini zapravo pripadaju Registrnoj karti. To se odnosi i na osnovne točke koje su također usko povezane s osnovnom kartom, ali čine vlastiti skup podataka. Gradski ured za planiranje koristi se raznim klijentskim softverom (npr. dpMap, MicroStation, StockholmExport) za izdvajanje, izvoz i isporuku informacija korisnicima s Osnovne karte."},{"@language":"hu-t-sv-t0-mtec","@value":"Az alaptérkép egy nagyszabású, háromdimenziós, nagy pontosságú digitális térképezési munka, amely Stockholm városának alapvető földrajzi és adminisztratív feltételeit mutatja be. A térképinformációkat az x, y koordinátákkal rendelkező síkokban és a z értékek magasságában tárolják. A térkép többek között épületeket, utakat, fákat és magassági információkat mutat. A térképet elsősorban az 1:400 és 1:2000 közötti skálán használják. Sok településen az alaptérképet Primärktartan-nak is nevezik.Az alaptérképet számos különböző kontextusban használják háttértérképként, ahol tevékenységspecifikus információkat adnak hozzá a célhoz igazított térkép létrehozásához. Ezek lehetnek alaptérképek, új épülettérképek, építési engedélyezési térképek, alapponttérképek, rendeleti térképek, leltártérképek stb. Ez azt jelenti, hogy a minőség változik, de idővel fokozatosan javul. Az adatbázisban tárolt összes információ minősége az eredettel, az időponttal és a gyűjtés módjával van jelölve. Számos különböző térképtermék exportálható az alaptérképről, és szállítható az ügyfeleknek. Számos térképtermék tartalmaz ingatlaninformációkat. Az ingatlanra vonatkozó információk valójában a nyilvántartási térképhez tartoznak. Ez azokra az alapvető pontokra is vonatkozik, amelyek szintén szorosan kapcsolódnak az alaptérképhez, de saját adatkészletet alkotnak. A Várostervezési Hivatal különböző ügyfélszoftvereket (pl. dpMap, MicroStation, StockholmExport) használ az alaptérképből származó információk kinyerésére, exportálására és az ügyfelekhez történő eljuttatására.A térképinformációkat számos térképszolgáltatáson, úgynevezett WMS-szolgáltatásokon keresztül is közzéteszik."},{"@language":"it-t-sv-t0-mtec","@value":"La mappa di base è un lavoro di mappatura digitale su larga scala, tridimensionale e ad alta precisione che presenta le condizioni geografiche e amministrative di base nella città di Stoccolma. Le informazioni della mappa sono memorizzate in piani con coordinate x, y e all'altezza dei valori z. La mappa mostra, tra le altre cose, edifici, strade, alberi e informazioni sull'altitudine. La mappa viene utilizzata principalmente nell'intervallo di scala da 1:400 a 1:2000. In molti comuni, la mappa di base è anche chiamata Primärktartan.La mappa di base viene utilizzata in molti contesti diversi come mappa di sfondo, in cui vengono aggiunte informazioni specifiche per attività per creare una mappa adattata allo scopo. Queste possono essere mappe di base, nuove mappe degli edifici, mappe dei permessi di costruzione, mappe dei punti principali, mappe delle ordinanze, mappe dell'inventario, ecc. Ciò significa che la qualità varia, ma c'è un graduale miglioramento nel tempo. Tutte le informazioni sono marcate con l'origine, l'ora e il metodo di raccolta quando vengono memorizzate nel database. Esistono diversi prodotti cartografici che possono essere esportati dalla mappa di base e consegnati ai clienti. Molti dei prodotti della mappa contengono informazioni sulla proprietà. Le informazioni sulla proprietà appartengono effettivamente alla mappa del registro. Questo vale anche per i punti chiave che sono anche strettamente correlati alla mappa di base, ma formano il proprio set di dati. L'ufficio di pianificazione urbana utilizza vari software client (ad esempio dpMap, MicroStation, StockholmExport) per estrarre, esportare e fornire informazioni dalla mappa di base ai clienti."},{"@language":"lt-t-sv-t0-mtec","@value":"Bazinis žemėlapis yra didelio masto, trimatis, didelio tikslumo skaitmeninis kartografavimas, kuriame pateikiamos pagrindinės geografinės ir administracinės sąlygos Stokholmo mieste. Žemėlapio informacija saugoma plokštumose su x, y koordinatėmis ir z verčių aukštyje. Žemėlapyje, be kita ko, rodomi pastatai, keliai, medžiai ir aukščio informacija. Žemėlapis dažniausiai naudojamas skalėje nuo 1:400 iki 1:2000. Daugelyje savivaldybių pagrindinis žemėlapis taip pat vadinamas Primärktartan.Pagrindinis žemėlapis naudojamas daugelyje skirtingų kontekstų kaip foninis žemėlapis, kuriame pridedama su konkrečia veikla susijusi informacija, kad būtų sukurtas šiam tikslui pritaikytas žemėlapis. Tai gali būti pagrindiniai žemėlapiai, nauji pastatų žemėlapiai, statybos leidimų žemėlapiai, pagrindinių taškų žemėlapiai, potvarkių žemėlapiai, inventoriaus žemėlapiai ir kt. Tai reiškia, kad kokybė skiriasi, tačiau laikui bėgant ji palaipsniui gerėja. Visa duomenų bazėje saugoma informacija yra kokybiška, pažymėta kilme, laiku ir rinkimo būdu. Yra keletas skirtingų žemėlapio produktų, kuriuos galima eksportuoti iš bazinio žemėlapio ir pristatyti klientams. Keliuose žemėlapio produktuose yra informacija apie nuosavybę. Nekilnojamojo turto informacija iš tikrųjų priklauso registro žemėlapiui. Tai taip pat taikoma pagrindiniams punktams, kurie taip pat yra glaudžiai susiję su baziniu žemėlapiu, tačiau sudaro savo duomenų rinkinį. Miesto planavimo biuras naudoja įvairią kliento programinę įrangą (pvz., „dpMap“, „MicroStation“, „StockholmExport“) informacijai iš bazinio žemėlapio išgauti, eksportuoti ir pristatyti klientams. Žemėlapio informacija taip pat skelbiama naudojantis įvairiomis žemėlapių paslaugomis, vadinamomis WMS paslaugomis."},{"@language":"lv-t-sv-t0-mtec","@value":"Bāzes karte ir plaša mēroga, trīsdimensiju, augstas precizitātes digitālās kartēšanas darbs, kas atspoguļo galvenos ģeogrāfiskos un administratīvos apstākļus Stokholmas pilsētā. Kartes informācija tiek glabāta plaknēs ar x, y koordinātām un z vērtību augstumā. Kartē cita starpā redzama informācija par ēkām, ceļiem, kokiem un augstumu virs jūras līmeņa. Karti galvenokārt izmanto mērogā no 1:400 līdz 1:2000. Daudzās pašvaldībās pamata karti sauc arī par Primärktartan.Pamatkarte tiek izmantota daudzos dažādos kontekstos kā fona karte, kurā tiek pievienota ar darbību saistīta informācija, lai izveidotu šim nolūkam pielāgotu karti. Tās var būt pamata kartes, jaunu ēku kartes, būvatļauju kartes, galveno punktu kartes, rīkojumu kartes, inventarizācijas kartes utt. Informācijas vākšana bāzes kartei notiek daudzus gadus un ar dažādām metodēm. Tas nozīmē, ka kvalitāte mainās, bet laika gaitā notiek pakāpeniska uzlabošanās. Visa informācija ir kvalitāte atzīmēta ar izcelsmi, laiku un savākšanas metodi, kad glabājas datubāzē. Ir vairāki dažādi karšu produkti, kurus var eksportēt no bāzes kartes un piegādāt klientiem. Vairāki no kartes produktiem satur informāciju par īpašumu. Īpašuma informācija faktiski pieder reģistra kartei. Tas attiecas arī uz pamatpunktiem, kas arī ir cieši saistīti ar bāzes karti, bet veido paši savu datu kopu. Pilsētas plānošanas birojs izmanto dažādas klientu programmatūras (piemēram, dpMap, MicroStation, StockholmExport), lai iegūtu, eksportētu un piegādātu klientiem informāciju no bāzes kartes. Kartes informācija tiek publicēta arī, izmantojot vairākus karšu pakalpojumus, tā sauktos WMS pakalpojumus."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-mappa bażi hija xogħol ta’ mmappjar diġitali fuq skala kbira, tridimensjonali u ta’ preċiżjoni għolja li jippreżenta l-kundizzjonijiet ġeografiċi u amministrattivi bażiċi fil-Belt ta’ Stokkolma. L-informazzjoni tal-mappa tinħażen fi pjani b’koordinati x, y u fl-għoli tal-valuri z. Il-mappa turi, fost affarijiet oħra, bini, toroq, siġar, u informazzjoni dwar l-altitudni. Il-mappa tintuża prinċipalment fil-firxa tal-iskala minn 1:400 sa 1:2000. F’ħafna muniċipalitajiet, il-mappa bażika tissejjaħ ukoll Primärktartan. Il-mappa bażika tintuża f’ħafna kuntesti differenti bħala mappa tal-isfond, fejn tiżdied informazzjoni speċifika għall-attività biex tinħoloq mappa adattata għall-iskop. Dawn jistgħu jkunu mapep bażiċi, mapep ġodda tal-bini, mapep tal-permessi tal-bini, mapep tal-punti ewlenin, mapep tal-ordinanza, mapep tal-inventarju, eċċ. Il-ġbir ta’ informazzjoni għall-Mappa Bażi ilu għaddej għal ħafna snin u b’metodi differenti. Dan ifisser li l-kwalità tvarja, iżda hemm titjib gradwali maż-żmien. L-informazzjoni kollha hija mmarkata bil-kwalità bl-oriġini, il-ħin u l-metodu tal-ġbir meta tinħażen fil-bażi tad-data. Hemm diversi prodotti tal-mappa differenti li jistgħu jiġu esportati mill-Mappa Bażi u kkonsenjati lill-klijenti. Ħafna mill-prodotti tal-mappa fihom informazzjoni dwar il-proprjetà. L-informazzjoni dwar il-proprjetà fil-fatt tappartjeni għall-Mappa tar-Reġistru. Dan japplika wkoll għal punti ewlenin li huma wkoll relatati mill-qrib mal-Mappa Bażi iżda jiffurmaw is-sett tad-data tagħhom stess. L-Uffiċċju tal-Ippjanar tal-Belt juża diversi software tal-klijenti (eż. dpMap, MicroStation, StockholmExport) biex jestratta, jesporta u jwassal informazzjoni mill-Mappa Bażi lill-klijenti. L-informazzjoni tal-mappa hija ppubblikata wkoll permezz ta’ għadd ta’ servizzi tal-mappa, l-hekk imsejħa servizzi WMS."},{"@language":"nl-t-sv-t0-mtec","@value":"De basiskaart is een grootschalig, driedimensionaal, zeer nauwkeurig digitaal karteringswerk dat de fundamentele geografische en administratieve omstandigheden in de stad Stockholm presenteert. De kaartinformatie wordt opgeslagen in vlakken met x-, y-coördinaten en ter hoogte van z-waarden. De kaart toont onder andere gebouwen, wegen, bomen en hoogte-informatie. De kaart wordt voornamelijk gebruikt in het schaalbereik van 1:400 tot 1:2000. In veel gemeenten wordt de basiskaart ook Primärktartan genoemd.De basiskaart wordt in veel verschillende contexten gebruikt als achtergrondkaart, waar activiteitsspecifieke informatie wordt toegevoegd om een kaart te maken die is aangepast aan het doel. Dit kunnen basiskaarten, nieuwe bouwkaarten, bouwvergunningskaarten, kernpuntenkaarten, ordonnantiekaarten, inventariskaarten, enz. zijn. Dit betekent dat de kwaliteit varieert, maar er is een geleidelijke verbetering in de loop van de tijd. Alle informatie is kwaliteit gemarkeerd met oorsprong, tijd en methode van verzameling wanneer opgeslagen in de database. Er zijn verschillende kaartproducten die uit de basiskaart kunnen worden geëxporteerd en aan klanten kunnen worden geleverd. Verscheidene van de kaartproducten bevatten eigendomsinformatie. Eigendomsinformatie behoort eigenlijk tot de Register Map. Dit geldt ook voor kernpunten die ook nauw verwant zijn aan de Basiskaart maar hun eigen dataset vormen. Het City Planning Office gebruikt verschillende clientsoftware (bijv. dpMap, MicroStation, StockholmExport) om informatie uit de basiskaart te extraheren, te exporteren en aan klanten te leveren."},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa bazowa jest wielkoskalowym, trójwymiarowym, dokładnym cyfrowym mapowaniem, które przedstawia podstawowe warunki geograficzne i administracyjne w Sztokholmie. Informacje o mapie są przechowywane w płaszczyznach o współrzędnych x, y i na wysokości wartości z. Mapa pokazuje między innymi budynki, drogi, drzewa i informacje o wysokości. Mapa używana jest głównie w skali od 1:400 do 1:2000. W wielu gminach podstawowa mapa jest również nazywana Primärktartan.Podstawowa mapa jest używana w wielu różnych kontekstach jako mapa tła, w której dodawane są informacje specyficzne dla danej działalności, aby stworzyć mapę dostosowaną do tego celu. Mogą to być mapy podstawowe, nowe mapy budynków, mapy pozwoleń na budowę, mapy punktów podstawowych, mapy zarządzeń, mapy inwentaryzacji itp. Zbieranie informacji na potrzeby mapy bazowej trwa od wielu lat i przy użyciu różnych metod. Oznacza to, że jakość jest różna, ale z czasem następuje stopniowa poprawa. Wszystkie informacje to jakość oznaczona pochodzeniem, czasem i sposobem zbierania, gdy są przechowywane w bazie danych. Istnieje kilka różnych produktów mapowych, które można wyeksportować z mapy bazowej i dostarczyć klientom. Kilka produktów na mapie zawiera informacje o nieruchomościach. Informacje o nieruchomościach faktycznie należą do mapy rejestru. Dotyczy to również podstawowych punktów, które są również ściśle powiązane z mapą bazową, ale tworzą własny zbiór danych. Urząd Planowania Miasta wykorzystuje różne oprogramowanie klienckie (np. dpMap, MicroStation, StockholmExport) do wyodrębniania, eksportowania i dostarczania informacji z mapy bazowej do klientów."},{"@language":"pt-t-sv-t0-mtec","@value":"O mapa de base é um trabalho de mapeamento digital de grande escala, tridimensional e de alta precisão que apresenta as condições geográficas e administrativas básicas na cidade de Estocolmo. As informações do mapa são armazenadas em planos com coordenadas x, y e na altura dos valores z. O mapa mostra, entre outras coisas, edifícios, estradas, árvores e informações de altitude. O mapa é usado principalmente na escala de 1:400 a 1:2000. Em muitos municípios, o mapa básico também é chamado Primärktartan.O mapa básico é usado em muitos contextos diferentes como um mapa de fundo, onde informações específicas da atividade são adicionadas para criar um mapa adaptado para o efeito. Estes podem ser mapas básicos, novos mapas de construção, mapas de licenças de construção, mapas de pontos centrais, mapas de ordenanças, mapas de inventário, etc. A recolha de informações para o Mapa Base tem vindo a decorrer há muitos anos e com diferentes métodos. Isto significa que a qualidade varia, mas há uma melhoria gradual ao longo do tempo. Todas as informações são de qualidade marcada com origem, tempo e método de recolha quando armazenadas na base de dados. Há vários produtos de mapas diferentes que podem ser exportados a partir do Mapa Base e entregues aos clientes. Vários dos produtos do mapa contêm informações sobre a propriedade. Na verdade, as informações do imóvel pertencem ao Mapa do Registro. Isto também se aplica a pontos centrais que também estão intimamente relacionados com o Mapa Base, mas formam seu próprio conjunto de dados. O Gabinete de Planeamento da Cidade utiliza vários softwares de clientes (por exemplo, dpMap, MicroStation, StockholmExport) para extrair, exportar e fornecer informações do Mapa Base aos clientes."},{"@language":"ro-t-sv-t0-mtec","@value":"Harta de bază este o lucrare de cartografiere digitală la scară largă, tridimensională, de înaltă precizie, care prezintă condițiile geografice și administrative de bază din orașul Stockholm. Informațiile cartografice sunt stocate în planuri cu coordonatele x, y și la înălțimea valorilor z. Harta arată, printre altele, clădiri, drumuri, copaci și informații despre altitudine. Harta este utilizată în principal în intervalul de scară de la 1:400 la 1:2000. În multe municipalități, harta de bază este numită și Primärktartan.Harta de bază este utilizată în multe contexte diferite ca hartă de fundal, unde se adaugă informații specifice activității pentru a crea o hartă adaptată scopului. Acestea pot fi hărți de bază, hărți noi ale clădirilor, hărți ale autorizațiilor de construcție, hărți ale punctelor de bază, hărți de ordonanță, hărți de inventar etc. Colectarea de informații pentru harta de bază se desfășoară de mulți ani și cu diferite metode. Aceasta înseamnă că calitatea variază, dar există o îmbunătățire treptată în timp. Toate informațiile sunt de calitate marcate cu originea, timpul și metoda de colectare atunci când sunt stocate în baza de date. Există mai multe produse diferite de hărți care pot fi exportate de pe harta de bază și livrate clienților. Mai multe dintre produsele hărții conțin informații despre proprietate. Informațiile privind proprietatea aparțin de fapt hărții registrului. Acest lucru este valabil și pentru punctele de bază care sunt, de asemenea, strâns legate de harta de bază, dar care formează propriul set de date. Biroul de planificare urbană utilizează diverse software-uri client (de exemplu, dpMap, MicroStation, StockholmExport) pentru a extrage, exporta și furniza informații din harta de bază clienților."},{"@language":"sk-t-sv-t0-mtec","@value":"Základná mapa je rozsiahla, trojrozmerná digitálna mapovacia práca s vysokou presnosťou, ktorá predstavuje základné geografické a administratívne podmienky v meste Štokholm. Informácie o mape sú uložené v rovinách so súradnicami x, y a vo výške hodnôt z. Mapa zobrazuje okrem iného budovy, cesty, stromy a informácie o nadmorskej výške. Mapa sa používa hlavne v mierke od 1:400 do 1:2000. V mnohých obciach sa základná mapa nazýva aj Primärktartan.Základná mapa sa používa v mnohých rôznych kontextoch ako mapa pozadia, kde sa pridávajú informácie špecifické pre jednotlivé činnosti, aby sa vytvorila mapa prispôsobená na tento účel. Môžu to byť základné mapy, nové mapy budov, mapy stavebných povolení, mapy základných bodov, mapy vyhlášok, inventarizačné mapy atď. Zber informácií pre základnú mapu prebieha už mnoho rokov a rôznymi metódami. To znamená, že kvalita sa líši, ale časom dochádza k postupnému zlepšovaniu. Všetky informácie sú označené akosťou pôvodu, časom a spôsobom zberu, keď sú uložené v databáze. Existuje niekoľko rôznych mapových produktov, ktoré je možné exportovať zo základnej mapy a dodávať zákazníkom. Niektoré z mapových produktov obsahujú informácie o nehnuteľnostiach. Informácie o nehnuteľnosti v skutočnosti patria do mapy registra. Vzťahuje sa to aj na hlavné body, ktoré takisto úzko súvisia so základnou mapou, ale tvoria vlastný súbor údajov. Mestský plánovací úrad využíva rôzne klientske softvéry (napr. dpMap, MicroStation, StockholmExport) na extrakciu, export a doručovanie informácií zo základnej mapy zákazníkom."},{"@language":"sl-t-sv-t0-mtec","@value":"Osnovni zemljevid je obsežno, tridimenzionalno, zelo natančno digitalno kartiranje, ki predstavlja osnovne geografske in upravne pogoje v mestu Stockholm. Podatki zemljevida so shranjeni v ravninah s koordinatami x, y in na višini z-vrednosti. Zemljevid med drugim prikazuje stavbe, ceste, drevesa in podatke o nadmorski višini. Zemljevid se uporablja predvsem v razponu od 1:400 do 1:2000. V mnogih občinah se osnovni zemljevid imenuje tudi Primärktartan.Osnovni zemljevid se uporablja v številnih različnih kontekstih kot osnovni zemljevid, kjer se dodajo informacije, specifične za dejavnost, da se ustvari zemljevid, prilagojen za ta namen. To so lahko osnovni zemljevidi, novi zemljevidi stavb, zemljevidi gradbenih dovoljenj, zemljevidi osrednjih točk, zemljevidi odlokov, zemljevidi inventarja itd. To pomeni, da se kakovost razlikuje, vendar se sčasoma postopoma izboljšuje. Vsi podatki so kakovostni, označeni z izvorom, časom in načinom zbiranja, ko so shranjeni v bazi podatkov. Obstaja več različnih izdelkov zemljevidov, ki jih je mogoče izvoziti iz osnovnega zemljevida in dostaviti strankam. Več zemljevidov vsebuje informacije o nepremičninah. Podatki o nepremičnini dejansko spadajo na zemljevid registra. To velja tudi za osrednje točke, ki so prav tako tesno povezane z osnovnim zemljevidom, vendar tvorijo svoj nabor podatkov. Mestni urad za načrtovanje uporablja različne odjemalske programske opreme (npr. dpMap, MicroStation, StockholmExport) za pridobivanje, izvoz in dostavo informacij iz osnovnega zemljevida strankam."},{"@language":"sv","@value":"Baskartan är ett storskaligt och tredimensionellt digitalt kartverk med hög noggrannhet som redovisar de grundläggande geografiska och administrativa förhållandena i Stockholms stad. Kartans information lagras i plan med x, y koordinater och i höjd med z-värden. Kartan redovisar bland annat byggnader, vägar, träd, samt höjdinformation. Kartan används främst i skalområdet från 1:400 till 1:2000. I många kommuner kallas Baskartan också för Primärkartan.Baskartan används i många olika sammanhang som bakgrundskarta, där verksamhetsspecifik information läggs till för att skapa en för syftet anpassad karta. Det kan röra sig om grundkartor, nybyggnadskartor, bygglovskartor, stompunktskartor, förrättningskartor, inventeringskartor etc. Insamlingen av information till Baskartan har pågått under många år och med olika metoder. Det innebär att kvaliteten varierar, men det sker en succesiv kvalitetsförbättring över tid. All information kvalitetsmärks med ursprung, tidpunkt och insamlingsmetod vid lagringen i databasen. Det finns flera olika kartprodukter som kan exporteras ur Baskartan och levereras till kunder. Flera av kartprodukterna innehåller fastighetsinformation. Fastighetsinformationen tillhör egentligen Registerkartan. Det gäller också för stompunkter som också är nära relaterade till Baskartan men som utgör ett eget dataset. Stadsbyggnadskontoret använder olika klientprogramvaror (ex dpMap, MicroStation, StockholmExport) för att extrahera, exportera och leverera information från Baskartan till kunder.Kartinformationen publiceras också via ett antal karttjänster, s.k. WMS tjänster.."},{"@language":"uk-t-sv-t0-mtec","@value":"Базова карта - це великомасштабна, тривимірна, високоточна цифрова картографічна робота, яка представляє основні географічні та адміністративні умови в місті Стокгольм. Інформація про карту зберігається в площинах з координатами x, y і на висоті z-значень. Карта показує, серед іншого, будівлі, дороги, дерева та інформацію про висоту. Карта в основному використовується в діапазоні масштабів від 1:400 до 1:2000. У багатьох муніципалітетах базова карта також називається Primärktartan.The базова карта використовується в багатьох різних контекстах як фонова карта, де інформація про діяльність додається для створення карти, адаптованої для цієї мети. Це можуть бути базові карти, карти нових будівель, карти дозволів на будівництво, карти основних точок, карти розпоряджень, карти інвентаризації тощо. Це означає, що якість змінюється, але з часом відбувається поступове поліпшення. Вся інформація має якість, позначену походженням, часом і способом збору при зберіганні в базі даних. Існує кілька різних картографічних продуктів, які можна експортувати з Базової карти та доставляти клієнтам. Деякі з картографічних продуктів містять інформацію про властивості. Інформація про майно фактично належить до Реєстрової карти. Це також стосується основних точок, які також тісно пов'язані з Базовою картою, але формують власний набір даних. Управління планування міста використовує різне клієнтське програмне забезпечення (наприклад, dpMap, MicroStation, StockholmExport) для вилучення, експорту та доставки інформації з базової карти клієнтам."}],"dct:format":"text/html","dct:identifier":"f9710b3f-401b-4c88-8138-2cd57408b104","dct:issued":{"@type":"xsd:date","@value":"1992-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:a7d96820818c0d029f2148690a256ecdff03db88bd2a0e7a9c5334874374cc2c_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK базова карта (1:400 - 1:2000)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Základní mapa (1:400 - 1:2000)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Basiskort (1:400 - 1:2000)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Basiskarte (1:400 - 1:2000)"},{"@language":"el-t-sv-t0-mtec","@value":"Βασικός χάρτης (1:400 - 1:2000)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Base map (1:400 - 1:2000)"},{"@language":"es-t-sv-t0-mtec","@value":"Mapa base de SBK (1:400 - 1:2000)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK aluskaart (1:400 - 1:2000)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Pohjakartta (1:400 - 1:2000)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Carte de base (1:400 - 1:2000)"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáil Bhunáite SBK (1:400 - 1:2000)"},{"@language":"hr-t-sv-t0-mtec","@value":"Bazna karta SBK (1:400 - 1:2000)"},{"@language":"hu-t-sv-t0-mtec","@valu