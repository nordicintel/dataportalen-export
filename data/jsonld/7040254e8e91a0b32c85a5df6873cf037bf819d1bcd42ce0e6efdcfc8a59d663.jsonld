2))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:c560ccebb0e32870b8fa65acd2b4db58f05438751b2df7f1e4a8cce21cacfb87_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"144b81088bc274081d873d8fb824c1dd80"},{"@id":"http://data.europa.eu/88u/dataset/04bd3e2e-3b35-4f76-8a0a-d53518e657f6","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/3c60c31a-c361-4059-96a0-b543cad0b222"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=72d7aa11-0025-46b7-a249-ec5ef779daf3"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:created":{"@type":"xsd:date","@value":"1995-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Карта на регистъра — Общ механизъм (ОС) се състои от следните подтипове (подтипове) при информационната класификация за 2020 г. (за настоящия списък вж. Обща карта на регистъра на спецификациите на продуктите) :450070, Подтипове на общия механизъм10, Общ механизъм, подлежащ на изменение"},{"@language":"cs-t-sv-t0-mtec","@value":"Mapa registrů – společná facilita (GA) sestávala z následujících podtypů (podtypů) v klasifikaci informací 2020 (aktuální seznam viz mapa registru obecných specifikací výrobků) :450070, podtypy společné facility10, společná facilita, upravitelné"},{"@language":"da-t-sv-t0-mtec","@value":"Registerkort - Fælles facilitet (GA) bestod af følgende undertyper (undertyper) i informationsklassifikationen for 2020 (for den nuværende liste se Kort over det generelle produktspecifikationsregister) :450070, Fælles facilitetsundertyper10, Fælles facilitet, modificerbar"},{"@language":"de-t-sv-t0-mtec","@value":"Registerkarte – Gemeinsame Fazilität (GA) bestand bei der Informationsklassifizierung 2020 aus den folgenden Untertypen (Untertypen) (für die aktuelle Liste siehe Karte des allgemeinen Registers für Produktspezifikationen): 450070, Untertypen der Gemeinsamen Fazilität10, Gemeinsame Fazilität, veränderbar"},{"@language":"el-t-sv-t0-mtec","@value":"Χάρτης μητρώου - Κοινή διευκόλυνση (GA) που αποτελείται από τους ακόλουθους υποτύπους (υποτύπους) στην ταξινόμηση πληροφοριών 2020 (για τον τρέχοντα κατάλογο βλ. χάρτη μητρώου γενικών προδιαγραφών προϊόντος) :450070, Υποτύποι κοινής διευκόλυνσης10, Κοινή διευκόλυνση, τροποποιήσιμη"},{"@language":"en-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) consisted of the following subtypes (subtypes) at the information classification 2020 (for the current list see General Product Specification Register Map) :450070, Common Facility Subtypes10, Common Facility, modifiable"},{"@language":"es-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) consistió en los siguientes subtipos (subtipos) en la clasificación de información 2020 (para la lista actual, véase General Product Specification Register Map): 450070, Common Facility Subtypes10, Common Facility, modificable"},{"@language":"et-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) koosnes 2020. aasta teabeklassifikatsiooni järgmistest alatüüpidest (alatüübid) (praeguse loetelu kohta vt üldise tootespetsifikaadi registri kaart):450070, Common Facility Subtypes10, Common Facility, Modable"},{"@language":"fi-t-sv-t0-mtec","@value":"Rekisterikartta – Yhteinen järjestely (GA) koostui seuraavista alatyypeistä (alatyypeistä) vuoden 2020 tietoluokituksessa (nykyinen luettelo on Yleistä tuote-eritelmää koskevassa rekisterikartassa):450070, Yhteisen järjestelyn alatyypit10, Yhteinen järjestely, muokattavissa"},{"@language":"fr-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) se composait des sous-types (sous-types) suivants lors de la classification des informations 2020 (pour la liste actuelle, voir la carte du registre des spécifications générales de produits):450070, Common Facility Subtypes10, Common Facility, modifiable"},{"@language":"ga-t-sv-t0-mtec","@value":"Is éard a bhí i Léarscáil Chláraithe - Saoráid Choiteann (GA) na fochineálacha (fochineálacha) seo a leanas ag aicmiú faisnéise 2020 (le haghaidh an liosta reatha féach Léarscáil Chláraithe na Sonraíochta Táirge Ginearálta) :450070, Fochineálacha Saoráide Coitinne10, Saoráid Choiteann, inmhodhnaithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Karta registra – Zajednički objekt (GA) sastojao se od sljedećih podvrsta (podvrsta) u informacijskoj klasifikaciji 2020. (za trenutačni popis vidjeti kartu registra općih specifikacija proizvoda) :450070, podvrste zajedničkog instrumenta10, zajednički objekt, koji se može izmijeniti"},{"@language":"hu-t-sv-t0-mtec","@value":"Nyilvántartási térkép – A közös eszköz (GA) a következő altípusokból (altípusokból) állt a 2020. évi információs osztályozási rendszerben (a jelenlegi listát lásd az általános termékspecifikációs nyilvántartás térképén): 450070, közös eszköz altípusai10, közös eszköz, módosítható"},{"@language":"it-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) consisteva dei seguenti sottotipi (sottotipi) nella classificazione delle informazioni 2020 (per l'elenco attuale si veda General Product Specification Register Map) :450070, Common Facility Subtypes10, Common Facility, modifiable"},{"@language":"lt-t-sv-t0-mtec","@value":"Registro žemėlapis. Bendroji priemonė (GA) pagal 2020 m. informacijos klasifikaciją (dabartinį sąrašą žr. Bendrųjų produktų specifikacijų registro žemėlapyje) buvo sudaryta iš šių potipių (potipių):450070, Bendrosios priemonės potipiai10, Bendroji priemonė, modifikuojama"},{"@language":"lv-t-sv-t0-mtec","@value":"Reģistra karte — kopējā iekārta (GA) sastāvēja no šādiem apakštipiem (apakštipiem) 2020. gada informācijas klasifikācijā (pašreizējo sarakstu sk. Vispārējā produktu specifikācijas reģistra kartē): 450070, kopējās iekārtas apakštipi10, kopējā iekārta, maināma"},{"@language":"mt-t-sv-t0-mtec","@value":"Faċilità Komuni (GA) tal-Mappa tar-Reġistru - kienet tikkonsisti fis-sottotipi (sottotipi) li ġejjin fil-klassifikazzjoni tal-informazzjoni 2020 (għal-lista attwali ara l-Mappa tar-Reġistru Ġenerali tal-Ispeċifikazzjoni tal-Prodott) :450070, Sottotipi tal-Faċilità Komuni10, Faċilità Komuni, modifikabbli"},{"@language":"nl-t-sv-t0-mtec","@value":"Registerkaart - Gemeenschappelijke faciliteit (GA) bestond uit de volgende subtypen (subtypen) in de informatieclassificatie 2020 (zie voor de huidige lijst de algemene productspecificatieregisterkaart) :450070, Gemeenschappelijke faciliteitssubtypen10, Gemeenschappelijke faciliteit, aanpasbaar"},{"@language":"pl-t-sv-t0-mtec","@value":"Mapa rejestru – wspólny instrument (GA) składał się z następujących podtypów (podtypów) w klasyfikacji informacji na 2020 r. (aktualny wykaz znajduje się w mapie rejestru ogólnej specyfikacji produktu):450070, podtypy wspólnego instrumentu10, wspólny instrument, modyfikowalny"},{"@language":"pt-t-sv-t0-mtec","@value":"Mapa do Registo — Instalação Comum (GA) constituído pelos seguintes subtipos (subtipos) na classificação da informação de 2020 (para a lista atual, ver Mapa do Registo das Especificações Gerais do Produto):450070, Subtipos da Instalação Comum10, Instalação Comum, modificável"},{"@language":"ro-t-sv-t0-mtec","@value":"Harta registrului - Facilitatea comună (GA) a constat din următoarele subtipuri (subtipuri) la clasificarea informațiilor din 2020 (pentru lista actuală, a se vedea Harta registrului caietului de sarcini general al produsului): 450070, Subtipurile facilității comune10, Facilitatea comună, modificabilă"},{"@language":"sk-t-sv-t0-mtec","@value":"Mapa registra – spoločný nástroj (GA) pozostával z týchto podtypov (podtypov) v rámci klasifikácie informácií na rok 2020 (pre aktuálny zoznam pozri mapu všeobecného registra špecifikácií výrobkov):450070, podtypy spoločného nástroja10, spoločný nástroj, modifikovateľné"},{"@language":"sl-t-sv-t0-mtec","@value":"Register Map - Common Facility (GA) je bil sestavljen iz naslednjih podtipov (podtipov) pri klasifikaciji informacij 2020 (za trenutni seznam glej Zemljevid registra splošnih specifikacij proizvoda):450070, Common Facility Subtypes10, Common Facility, spremenljivi"},{"@language":"sv","@value":"Registerkarta - Gemensamhetsanläggning (GA) bestod av följande undertyper (subtyper) vid informationsklassningen 2020 (för aktuell lista se Allmän produktspecifikation Registerkartan) :450070, GemensamhetsanläggningUndertyper10, Gemensamhetsanläggning, modifierbar"},{"@language":"uk-t-sv-t0-mtec","@value":"Карта реєстрації - Common Facility (GA) складалася з наступних підтипів (підтипів) при класифікації інформації 2020 (для поточного списку див."}],"dct:format":"text/html","dct:identifier":"04bd3e2e-3b35-4f76-8a0a-d53518e657f6","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c560ccebb0e32870b8fa65acd2b4db58f05438751b2df7f1e4a8cce21cacfb87_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистрационна карта на SBK — Инструмент на Общността (GA)"},{"@language":"cs-t-sv-t0-mtec","@value