eature15489448"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som beskriver trafikflöden. Linjegeometri. Enbart för kommunalt vägnät. Verksamhet Analys & Dialog, Trafikplanering, Trafikkontoret. Trafikflödeskartan cykel innehåller uppgifter om trafikmängder i Stockholm uppdelat på cykel, per vardagsmedeldygn och för en vissa tidsperiod över dygnet. Data avser 2017 och täcker Norrmalm, Stockholms kommun."},"dct:identifier":"ad608d58-4a26-4f55-bfe8-b68f8a9ccff4","dct:issued":{"@type":"xsd:date","@value":"2018-09-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:3fc7e5f092879e03a2ca4cfb5c20e19374b5221db246bf02d5907cd90dca4802_b0n0"},"dct:title":{"@language":"sv","@value":"Trafikflöde Cykel"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/ad608d58-4a26-4f55-bfe8-b68f8a9ccff4#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/ad608d58-4a26-4f55-bfe8-b68f8a9ccff4#HTTP:Nedladdning/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Trafikflode_Cykel&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService retur