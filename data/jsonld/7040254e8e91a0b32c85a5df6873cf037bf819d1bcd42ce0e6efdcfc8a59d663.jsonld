at":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"MiljödataStockholm"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:934e49cfb4996711650744dee590b35ad3cc6d950ff1c2069ecd4d0e4d178f32"},{"@graph":[{"@id":"_:94cb8850a806cdb651d22f911593d12bedd67b783ba10eea84ba0a91101e6de8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:94cb8850a806cdb651d22f911593d12bedd67b783ba10eea84ba0a91101e6de8_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2019-04-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2019-04-17"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"2019-04-20"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"2019-04-17"}},{"@id":"_:94cb8850a806cdb651d22f911593d12bedd67b783ba10eea84ba0a91101e6de8_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"16ea0c4058b4ec6a2eea8626e518b41a9c"},{"@id":"http://data.europa.eu/88u/dataset/ac02c6f4-6172-43e5-8604-b2116250c76a","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/3d41ddcd-c66c-4ed7-89d3-2ca7872fd255"},{"@id":"http://data.europa.eu/88u/distribution/d2907bb2-572b-4c9d-8dd7-9ce3bcc32ba4"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=137fc1a0-59ad-4e23-9712-8d81205ad75d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2019-04-20"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Ортофотографията на Стокхолм се състои от стотици въздушни снимки. Въздушните изображения се обработват така, че грешките в перспективата и измерването да бъдат сведени до минимум, за да се получи мащабируемо изображение. След това мащабируемите изображения се сглобяват в мозайка. Заявления: Ортофотите могат да се използват, например, за планиране и проектиране или визуализации. Различните реколти могат да се използват за сравнителни проучвания. Те също са подходящи за печат и могат да бъдат представени заедно с други картографски продукти. Надморска височина на полета: 1828 - 1890 метра над земята. Разделителна способност: 8 cm на земята на пиксел. Дата на снимката: 17—19 април 2019 г. Референтна система в план: Sweref 991800, на височина: RH2000"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto Stockholmu se skládá ze stovek leteckých fotografií. Letecké snímky jsou zpracovány tak, aby byly minimalizovány chyby perspektivy a měření a získaly škálovatelný obraz. Škálovatelné obrazy se pak spojí do mozaiky. Žádosti: Ortofotosnímky lze použít například pro plánování a promítání nebo vizualizace. Různé ročníky lze použít pro srovnávací studie. Jsou také vhodné pro tisk a mohou být prezentovány společně s dalšími mapovými produkty. Nadmořská výška letu: 1828 - 1890 metrů nad zemí. Usnesení: 8 cm na zem na pixel. Datum pořízení fotografie: a 19. dubna 2019. Referenční systém v plánu: Sweref 991800, na výšku: RH2000"},{"@language":"da-t-sv-t0-mtec","@value":"Et ortofoto af Stockholm består af hundredvis af luftfotos. Luftbilleder behandles, så perspektiv- og målefejl minimeres for at få et skalerbart billede. De skalerbare billeder sættes derefter sammen til en mosaik. Ansøgninger: Ortofotos kan f.eks. bruges til planlægning og projektering eller visualiseringer. De forskellige årgange kan bruges til sammenligningsundersøgelser. De er også velegnede til trykning og kan præsenteres sammen med andre kortprodukter. Flyvehøjde: 1828 - 1890 meter over jorden. Beslutning: 8 cm på jorden pr. pixel. Fotografiets dato: 17.-19. april 2019. Referencesystem i planen: Sweref 991800, i højden: RH2000"},{"@language":"de-t-sv-t0-mtec","@value":"Ein Orthofoto von Stockholm besteht aus Hunderten von Luftaufnahmen. Luftbilder werden so verarbeitet, dass Perspektiv- und Messfehler minimiert werden, um ein skalierbares Bild zu erhalten. Die skalierbaren Bilder werden dann zu einem Mosaik zusammengefügt. Anträge: Orthophotos können zum Beispiel für die Planung und Projektierung oder Visualisierungen verwendet werden. Die verschiedenen Jahrgänge können für Vergleichsstudien verwendet werden. Sie sind auch für den Druck geeignet und können zusammen mit anderen Kartenprodukten präsentiert werden. Flughöhe: 1828 - 1890 Meter über dem Boden. Entschließung: 8 cm auf dem Boden pro Pixel. Fotodatum: 17.-19. April 2019. Referenzsystem im Plan: Sweref 991800, in der Höhe: RH2000"},{"@language":"el-t-sv-t0-mtec","@value":"Μια ορθοφωτογραφία της Στοκχόλμης αποτελείται από εκατοντάδες αεροφωτογραφίες. Οι εναέριες εικόνες υποβάλλονται σε επεξεργασία έτσι ώστε τα σφάλματα προοπτικής και μέτρησης να ελαχιστοποιούνται για να ληφθεί μια κλιμακούμενη εικόνα. Οι κλιμακούμενες εικόνες στη συνέχεια τοποθετούνται μαζί σε ένα μωσαϊκό. Αιτήσεις: Οι ορθοφωτογραφίες μπορούν να χρησιμοποιηθούν, για παράδειγμα, για σχεδιασμό και προβολή ή οπτικοποιήσεις. Οι διαφορετικές εσοδείες μπορούν να χρησιμοποιηθούν για συγκριτικές μελέτες. Είναι επίσης κατάλληλα για εκτύπωση και μπορούν να παρουσιαστούν μαζί με άλλα προϊόντα χαρτών. Υψόμετρο πτήσης: 1828 - 1890 μέτρα πάνω από το έδαφος. Ψήφισμα: 8 cm στο έδαφος ανά pixel. Ημερομηνία φωτογραφίας: 17-19 Απριλίου 2019. Σύστημα αναφοράς στο σχέδιο: Sweref 991800, σε ύψος: ΠΥ2000"},{"@language":"en-t-sv-t0-mtec","@value":"An orthophoto of Stockholm consists of hundreds of aerial photographs. Aerial images are processed so that perspective and measurement errors are minimized to get a scalable image. The scalable images are then put together into a mosaic. Applications: Orthophotos can be used, for example, for planning and projecting or visualizations. The different vintages can be used for comparison studies. They are also suitable for printing and can be co-presented with other map products. Flight altitude: 1828 - 1890 meters above the ground. Resolution: 8 cm on the ground per pixel. Date of photograph: 17-19 April 2019. Reference system in plan: Sweref 991800, in height: RH2000"},{"@language":"es-t-sv-t0-mtec","@value":"Una ortofoto de Estocolmo consiste en cientos de fotografías aéreas. Las imágenes aéreas se procesan para que los errores de perspectiva y medición se minimicen para obtener una imagen escalable. Las imágenes escalables se juntan en un mosaico. Solicitudes: Las ortofotos se pueden usar, por ejemplo, para planificar y proyectar o visualizar. Las diferentes añadas se pueden utilizar para estudios de comparación. También son adecuados para la impresión y se pueden co-presentar con otros productos de mapas. Altitud de vuelo: 1828 - 1890 metros sobre el suelo. Resolución: 8 cm en el suelo por píxel. Fecha de la fotografía: 17-19 de abril de 2019. Sistema de referencia en el plan: Sweref 991800, en altura: RH2000"},{"@language":"et-t-sv-t0-mtec","@value":"Stockholmi ortofoto koosneb sadadest aerofotodest. Aerofotosid töödeldakse nii, et skaleeritava pildi saamiseks minimeeritakse perspektiiv- ja mõõtmisvead. Seejärel pannakse skaleeritavad pildid kokku mosaiigiks. Taotlused: Ortofotosid saab kasutada näiteks planeerimiseks ja projitseerimiseks või visualiseerimiseks. Võrdlusuuringutes saab kasutada erinevaid vintage. Need sobivad ka trükkimiseks ja neid saab esitada koos teiste kaarditoodetega. Lennukõrgus: 1828-1890 meetrit maapinnast. Resolutsioon: 8 cm maapinnal piksli kohta. Foto kuupäev: 17.–19. aprill 2019. Võrdlussüsteem kavas: Kandevõime 991800, kõrgus: RH2000"},{"@language":"fi-t-sv-t0-mtec","@value":"Tukholman ortokuva koostuu sadoista ilmakuvista. Ilmakuvat käsitellään siten, että perspektiivi- ja mittausvirheet minimoidaan skaalautuvan kuvan saamiseksi. Skaalautuvat kuvat kootaan sitten mosaiikiksi. Hakemukset: Ortokuvia voidaan käyttää esimerkiksi suunnitteluun ja projisointiin tai visualisointeihin. Eri vuosikertoja voidaan käyttää vertailututkimuksiin. Ne soveltuvat myös painatukseen ja ne voidaan esittää yhdessä muiden karttatuotteiden kanssa. Lentokorkeus: 1828 - 1890 metriä maanpinnan yläpuolella. Päätöslauselma: 8 cm pikseliä kohti. Valokuvauksen päivämäärä: huhtikuuta 2019. Viitejärjestelmä suunnitelmassa: Sweref 991800, korkeus: RH2000"},{"@language":"fr-t-sv-t0-mtec","@value":"Une orthophoto de Stockholm se compose de centaines de photographies aériennes. Les images aériennes sont traitées de sorte que les erreurs de perspective et de mesure soient minimisées pour obtenir une image évolutive. Les images évolutives sont ensuite assemblées dans une mosaïque. Demandes : Les orthophotos peuvent être utilisées, par exemple, pour la planification et la projection ou les visualisations. Les différents millésimes peuvent être utilisés pour des études comparatives. Ils sont également adaptés à l'impression et peuvent être co-présentés avec d'autres produits cartographiques. Altitude de vol: 1828 - 1890 mètres au-dessus du sol. Résolution : 8 cm au sol par pixel. Date de la photographie: du 17 au 19 avril 2019. Système de référence dans le plan: Sweref 991800, en hauteur: RH2000"},{"@language":"ga-t-sv-t0-mtec","@value":"Tá orthophoto de Stócólm comhdhéanta de na céadta grianghraf ón aer. Déantar íomhánna ón aer a phróiseáil ionas go n-íoslaghdaítear earráidí peirspictíochta agus tomhais chun íomhá inscálaithe a fháil. Ansin cuirtear na híomhánna inscálaithe le chéile i mósáic. Iarratais: Is féidir Orthophotos a úsáid, mar shampla, le haghaidh pleanála agus teilgean nó léirshamhlú. Is féidir na seanréanna éagsúla a úsáid le haghaidh staidéir chomparáide. Tá siad oiriúnach freisin le haghaidh priontála agus is féidir iad a chur i láthair i gcomhar le táirgí léarscáile eile. Airde eitilte: 1828 - 1890 méadar os cionn na talún. Rún: 8 cm ar an talamh in aghaidh an phicteilín. Dáta an ghrianghraif: 17-19 Aibreán 2019. Córas tagartha sa phlean: Séarach 991800, ar airde: RH2000"},{"@language":"hr-t-sv-t0-mtec","@value":"Ortofoto iz Stockholma sastoji se od stotina zračnih fotografija. Zračne slike obrađuju se tako da se perspektivne i mjerne pogreške svedu na najmanju moguću mjeru kako bi se dobila skalabilna slika. Skalabilne slike zatim se sastavljaju u mozaik. Zahtjevi: Ortofotografije se mogu koristiti, na primjer, za planiranje i projiciranje ili vizualizaciju. Različite berbe mogu se koristiti za usporedne studije. Također su prikladni za ispis i mogu se zajednički predstaviti s drugim kartografskim proizvodima. Visina leta: 1828 - 1890 metara iznad tla. Rezolucija: 8 cm na tlu po pikselu. Datum fotografije: 19. travnja 2019. Referentni sustav u planu: Sweref 991800, u visini: RH2000"},{"@language":"hu-t-sv-t0-mtec","@value":"Egy stockholmi ortofotó több száz légi felvételből áll. A légi felvételeket úgy dolgozzák fel, hogy a perspektíva és a mérési hibák minimálisak legyenek, hogy skálázható képet kapjanak. A skálázható képeket ezután egy mozaikba helyezik. Alkalmazások: Az ortofotók felhasználhatók például tervezésre, kivetítésre vagy vizualizációra. A különböző évjáratok összehasonlító tanulmányokhoz használhatók. Nyomtatásra is alkalmasak, és más térképtermékekkel együtt is bemutathatók. Repülési magasság: 1828 - 1890 méterrel a föld felett. Állásfoglalás: 8 cm a földön pixelenként. Fénykép dátuma: 2019. április 17–19. Referenciarendszer a tervben: Sweref 991800, magassága: RH2000"},{"@language":"it-t-sv-t0-mtec","@value":"Un'ortofoto di Stoccolma è costituita da centinaia di fotografie aeree. Le immagini aeree vengono elaborate in modo che gli errori di prospettiva e di misurazione siano ridotti al minimo per ottenere un'immagine scalabile. Le immagini scalabili vengono poi messe insieme in un mosaico. Applicazioni: Le ortofoto possono essere utilizzate, ad esempio, per la pianificazione e la progettazione o la visualizzazione. Le diverse annate possono essere utilizzate per studi comparativi. Sono adatti anche per la stampa e possono essere co-presentati con altri prodotti cartografici. Altitudine di volo: 1828 - 1890 metri dal suolo. Risoluzione: 8 cm a terra per pixel. Data della fotografia: 17-19 aprile 2019. Sistema di riferimento nel piano: Sweref 991800, in altezza: RH2000"},{"@language":"lt-t-sv-t0-mtec","@value":"Stokholmo ortofotografiją sudaro šimtai aeronuotraukų. Antenos vaizdai apdorojami taip, kad perspektyvos ir matavimo klaidos būtų kuo mažesnės, kad būtų gautas kintamo dydžio vaizdas. Tada keičiamo mastelio vaizdai sudedami į mozaiką. Paraiškos: Ortofotografijos gali būti naudojamos, pavyzdžiui, planuojant ir projektuojant ar vizualizuojant. Skirtingi derliaus metai gali būti naudojami palyginimo tyrimams. Jie taip pat tinka spausdinti ir gali būti pateikiami kartu su kitais žemėlapių produktais. Skrydžio aukštis: 1828 - 1890 metrų virš žemės. Rezoliucija 8 cm ant žemės vienam pikseliui. Fotografavimo data: 2019 m. balandžio 17–19 d. Plane numatyta atskaitos sistema: Sweref 991800, aukštis: RH2000"},{"@language":"lv-t-sv-t0-mtec","@value":"Stokholmas ortofoto sastāv no simtiem aerofotogrāfiju. Avioattēli tiek apstrādāti tā, lai perspektīvas un mērījumu kļūdas tiktu samazinātas līdz minimumam, lai iegūtu mērogojamu attēlu. Pēc tam mērogojamie attēli tiek salikti mozaīkā. Pieteikumi: Ortofoto var izmantot, piemēram, plānošanai un projicēšanai vai vizualizācijām. Dažādos laikmetus var izmantot salīdzinājuma pētījumos. Tie ir piemēroti arī drukāšanai, un tos var prezentēt kopā ar citiem karšu produktiem. Lidojuma absolūtais augstums: 1828 - 1890 metri virs zemes. Izšķirtspēja: 8 cm uz zemes uz pikseli. Fotogrāfijas datums: 2019. gada 17.–19. aprīlī. Atsauces sistēma plānā: Sweref 991800, augstumā: RH2000"},{"@language":"mt-t-sv-t0-mtec","@value":"Ortofonu ta' Stokkolma jikkonsisti f'mijiet ta' ritratti mill-ajru. Immaġnijiet mill-ajru huma pproċessati sabiex il-perspettiva u l-iżbalji tal-kejl jiġu minimizzati biex tinkiseb immaġni skalabbli. L-immaġnijiet skalabbli mbagħad jitqiegħdu flimkien f'mużajk. Applikazzjonijiet: L-ortofotos jistgħu jintużaw, pereżempju, għall-ippjanar u l-projezzjoni jew il-viżwalizzazzjonijiet. Il-vendemmji differenti jistgħu jintużaw għal studji ta’ tqabbil. Huma wkoll adattati għall-istampar u jistgħu jiġu ppreżentati flimkien ma 'prodotti oħra tal-mappa. L-altitudni tat-titjira: 1828 - 1890 metru 'l fuq mill-art. Riżoluzzjoni: 8 cm fuq l-art għal kull pixel. Data tar-ritratt: 17-19 ta' April 2019. Sistema ta’ referenza fil-pjan: Sweref 991800, fl-għoli: RH2000"},{"@language":"nl-t-sv-t0-mtec","@value":"Een orthofoto van Stockholm bestaat uit honderden luchtfoto's. Luchtfoto's worden verwerkt zodat perspectief- en meetfouten worden geminimaliseerd om een schaalbaar beeld te krijgen. De schaalbare beelden worden vervolgens samengevoegd tot een mozaïek. Aanvragen: Orthofoto's kunnen bijvoorbeeld worden gebruikt voor planning en projectie of visualisaties. De verschillende jaargangen kunnen worden gebruikt voor vergelijkingsstudies. Ze zijn ook geschikt voor afdrukken en kunnen samen met andere kaartproducten worden gepresenteerd. Vlieghoogte: 1828 - 1890 meter boven de grond. Resolutie: 8 cm op de grond per pixel. Datum van de foto: 17-19 april 2019. Referentiesysteem in het plan: Sweref 991800, in hoogte: RH2000"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa Sztokholmu składa się z setek zdjęć lotniczych. Obrazy lotnicze są przetwarzane w taki sposób, aby zminimalizować błędy perspektywy i pomiaru, aby uzyskać skalowalny obraz. Skalowalne obrazy są następnie łączone w mozaikę. Wnioski: Ortofotomapy mogą być wykorzystywane na przykład do planowania i projekcji lub wizualizacji. Różne roczniki można wykorzystać do badań porównawczych. Nadaje się również do drukowania i może być współprezentowany z innymi produktami mapowymi. Wysokość bezwzględna lotu: 1828 - 1890 metrów nad ziemią. Rozdzielczość: 8 cm na ziemi na piksel. Data zdjęcia: 17–19 kwietnia 2019 r. System odniesienia w planie: Sweref 991800, wysokość: RH2000"},{"@language":"pt-t-sv-t0-mtec","@value":"Uma ortofotografia de Estocolmo consiste em centenas de fotografias aéreas. As imagens aéreas são processadas para que os erros de perspectiva e medição sejam minimizados para obter uma imagem escalável. As imagens escaláveis são então reunidas num mosaico. Candidaturas: Os ortofotos podem ser utilizados, por exemplo, para planeamento e projecção ou visualizações. Os diferentes vintages podem ser utilizados para estudos de comparação. Também são adequados para impressão e podem ser co-apresentados com outros produtos de mapas. Altitude de voo: 1828 - 1890 metros acima do solo. Resolução: 8 cm no chão por pixel. Data da fotografia: 17-19 de abril de 2019. Sistema de referência no plano: Sweref 991800, em altura: RH2000"},{"@language":"ro-t-sv-t0-mtec","@value":"O ortofotografie a orașului Stockholm constă în sute de fotografii aeriene. Imaginile aeriene sunt procesate astfel încât erorile de perspectivă și de măsurare să fie reduse la minimum pentru a obține o imagine scalabilă. Imaginile scalabile sunt apoi puse împreună într-un mozaic. Aplicații: Ortofotografiile pot fi utilizate, de exemplu, pentru planificare și proiectare sau vizualizare. Diferitele recolte pot fi utilizate pentru studii comparative. Ele sunt, de asemenea, potrivite pentru imprimare și pot fi co-prezentate cu alte produse de hartă. Altitudinea de zbor: 1828 - 1890 metri deasupra solului. Rezoluție: 8 cm pe sol per pixel. Data fotografiei: 17-19 aprilie 2019. Sistemul de referință în plan: Sweref 991800, în înălțime: RH2000"},{"@language":"sk-t-sv-t0-mtec","@value":"Ortofotografia Štokholmu pozostáva zo stoviek leteckých fotografií. Letecké snímky sú spracované tak, aby sa minimalizovali chyby perspektívy a merania, aby sa získal škálovateľný obraz. Škálovateľné obrázky sa potom spoja do mozaiky. Aplikácie: Ortofotografie môžu byť použité napríklad na plánovanie a projektovanie alebo vizualizácie. Rôzne ročníky sa môžu použiť na porovnávacie štúdie. Sú tiež vhodné na tlač a môžu byť prezentované spolu s inými mapovými produktmi. Letová nadmorská výška: 1828 - 1890 metrov nad zemou. Uznesenie: 8 cm na zem na pixel. Dátum fotografie: 19. apríla 2019. Referenčný systém v pláne: Sweref 991800, na výšku: RH2000"},{"@language":"sl-t-sv-t0-mtec","@value":"Ortofoto Stockholma je sestavljen iz več sto aerofotografij. Zračne slike so obdelane tako, da so napake pri perspektivi in merjenju čim manjše, da se dobi razširljiva slika. Razširljive slike se nato združijo v mozaik. Prijave: Ortofoto posnetki se lahko uporabljajo na primer za načrtovanje in projektiranje ali vizualizacije. Različni letniki se lahko uporabijo za primerjalne študije. Primerni so tudi za tiskanje in se lahko predstavijo skupaj z drugimi kartografskimi izdelki. nadmorska višina leta: 1828 - 1890 metrov nad tlemi. Resolucija: 8 cm na tleh na slikovno piko. Datum fotografiranja: in 19. aprila 2019. Referenčni sistem v načrtu: Sweref 991800, po višini: RH2000"},{"@language":"sv","@value":"Ett ortofoto över Stockholm består av hundratals flygbilder. Flygbilderna bearbetas så att perspektiv- och måttfel minimeras för att få en skalriktig bild. De skalriktiga bilderna sätts därefter samman till en mosaik. Användningsområden: Ortofoton kan användas för exempelvis planering och projektering eller visualiseringar.. De olika årgångarna kan användas för jämförelsestudier. De är också lämpliga att använda för tryck och kan sampresenteras med andra kartprodukter. Flyghöjd: 1828 - 1890 meter över marken. Upplösning: 8 cm på marken per pixel. Fotograferingsdatum: 17-19 april 2019. Referenssytem i plan: Sweref 991800, i höjd: RH2000"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофотоплан Стокгольма складається з сотень аерофотознімків. Аерозображення обробляються таким чином, щоб мінімізувати похибки перспективи та вимірювання, щоб отримати масштабоване зображення. Масштабовані зображення потім об'єднуються в мозаїку. Типи застосувань: Ортофотоплани можна використовувати, наприклад, для планування і проектування або візуалізації. Різні вінтажі можна використовувати для порівняльних досліджень. Вони також підходять для друку і можуть бути спільно представлені з іншими картографічними продуктами. Висота польоту: 1828 - 1890 метрів над землею. Роздільна здатність: 8 см на землі на піксель. Дата фотографії: 17-19 квітня 2019 року. Референтна система в плані: Свереф 991800, по висоті: RH2000"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"ac02c6f4-6172-43e5-8604-b2116250c76a","dct:issued":{"@type":"xsd:date","@value":"2020-04-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:94cb8850a806cdb651d22f911593d12bedd67b783ba10eea84ba0a91101e6de8_b0n0"},"dct:temporal":{"@id":"_:94cb8850a806cdb651d22f911593d12bedd67b783ba10eea84ba0a91101e6de8_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"SBK Orthophoto / Ортофото СБК (2019)"},{"@language":"cs-t-sv-t0-mtec","@value":"Ortofoto SBK (2019)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"el-t-sv-t0-mtec","@value":"Ορθοφωτογραφία SBK (2019)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Ortofoto (2019)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ortofoto (2019)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Ortokuva (2019)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Orthophoto (2019.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Ortofotó (2019)"},{"@language":"it-t-sv-t0-mtec","@value":"Ortofoto di SBK (2019)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK ortofotografija (2019 m.)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Orthophoto (2019) - Nederlandse film online kijken"},{"@language":"pl-t-sv-t0-mtec","@value":"Ortofotomapa SBK (2019)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Orthophoto (2019)"},{"@language":"sv","@value":"SBK Ortofoto (2019)"},{"@language":"uk-t-sv-t0-mtec","@value":"Ортофото SBK (2019)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/3d41ddcd-c66c-4ed7-89d3-2ca7872fd255","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2019"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/ac02c6f4-6172-43e5-8604-b2116250c76a#HTTP:OGC:WMS/4","dct:title":["WMS-tjänst Ortofoto 2019",{"@language":"bg-t-sv-t0-mtec","@value":"WMS услуга Ortofoto 2019"},{"@language":"cs-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2019"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Ortofoto 2019"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Ortofoto 2019"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Ortofoto 2019"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Ortofoto 2019"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio WMS Ortofoto 2019"},{"@language":"et-t-sv-t0-mtec","@value":"WMS-teenus Ortofoto 2019"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Ortofoto 2019"},{"@language":"fr-t-sv-t0-mtec","@value":"Service WMS Ortofoto 2019"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Ortofoto 2019"},{"@language":"hr-t-sv-t0-mtec","@value":"WMS usluga Ortofoto 2019"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Ortofoto 2019"},{"@language":"it-t-sv-t0-mtec","@value":"Servizio WMS Ortofoto 2019"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Ortofoto 2019"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Ortofoto 2019"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Ortofoto 2019"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS-service Ortofoto 2019"},{"@language":"pl-t-sv-t0-mtec","@value":"Serwis WMS Ortofoto 2019"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço WMS Ortofoto 2019"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Ortofoto 2019"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Ortofoto 2019"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Ortofoto 2019"},{"@language":"uk-t-sv-t0-mtec","