-9a08-aa14ec8de99b#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/d33e3d68-b568-42d1-9a08-aa14ec8de99b#HTTP:Nedladdning/2"},{"@id":"https://resources.stockholm.se/data/d33e3d68-b568-42d1-9a08-aa14ec8de99b#HTTP:OGC:WFS/3"},{"@id":"https://resources.stockholm.se/data/d33e3d68-b568-42d1-9a08-aa14ec8de99b#HTTP:OGC:WMS/5"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Måttlig skada"},{"@language":"sv","@value":"Tillstånd"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LTFRlastzon"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Innehåller alla typer av ändamålsplatser som t ex: lastplats, tidsbegränsad lastplats, taxiplats, skolskjutsplats, etc. Huvuddelen av lastplatserna är tidsbegränsade. Populär benämning är lastzon. Enbart på det kommunala vägnätet. Verksamhet Juridik & Parkering, Tillståndsavdelningen, Trafikkontoret"},"dct:identifier":"d33e3d68-b568-42d1-9a08-aa14ec8de99b","dct:issued":{"@type":"xsd:date","@value":"2012-03-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-06"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:56a3ef77d42c91facd6d42c2b69358cb04b914d1e31a673732928dfc7137e5c2_b0n0"},"dct:title":{"@language":"sv","@value":"Parkeringsdata - Ändamålsplats"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@