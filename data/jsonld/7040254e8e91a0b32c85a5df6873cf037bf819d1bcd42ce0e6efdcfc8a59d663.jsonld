:"sv","@value":"Stadsmiljö"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=Miljodata0001"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2019-12-31"},"dct:description":{"@language":"sv","@value":"Biotopdatabasen från 2019. Biotopkarteringen är både en metodik och en biotopdatabas som visar naturens egenskaper och markanvändning. Syftet är att underlaget ska användas för analyser av natur, ekosystemtjänster och gröna infrastruktur. Bygger på en hybridmetod i flera steg, omfattande bl a semiautomatiska klassningar från fjärranalys och nationella data samt flygbildstolkning av IR-bilder. Karteringen är utförd av Stockholms Universitet (Institutionen för naturgeografi) samt Calluna AB."},"dct:identifier":"f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:86715edf8cb61c45d0d890ef56a71907d94c47c958b15d3a4b947982fa2ccc42_b0n0"},"dct:title":{"@language":"sv","@value":"Biotopdatabasen 2019"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/datasets/b89445e6ffab414bb1fca76b1a361496_49"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens Öppna data-hub"},{"@id":"https://resources.stockholm.se/data/f3ed4efd-2b3b-4600-abd5-c18fec1dc7c7#HTTP:ESRI+Portal-URL/2","@type":"dcat:D