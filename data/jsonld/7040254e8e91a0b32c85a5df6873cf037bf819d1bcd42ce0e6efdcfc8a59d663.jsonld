"@language":"fi-t-sv-t0-mtec","@value":"Karttasovellus"},{"@language":"fr-t-sv-t0-mtec","@value":"Application de la carte"},{"@language":"ga-t-sv-t0-mtec","@value":"Feidhmchlár léarscáile"},{"@language":"hr-t-sv-t0-mtec","@value":"Aplikacija zemljovida"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképes alkalmazás"},{"@language":"it-t-sv-t0-mtec","@value":"Applicazione della mappa"},{"@language":"lt-t-sv-t0-mtec","@value":"Žemėlapio taikomoji programa"},{"@language":"lv-t-sv-t0-mtec","@value":"Kartes pieteikums"},{"@language":"mt-t-sv-t0-mtec","@value":"Applikazzjoni tal-mappa"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarttoepassing"},{"@language":"pl-t-sv-t0-mtec","@value":"Aplikacja mapowa"},{"@language":"pt-t-sv-t0-mtec","@value":"Aplicação de mapas"},{"@language":"ro-t-sv-t0-mtec","@value":"Aplicație pentru hărți"},{"@language":"sk-t-sv-t0-mtec","@value":"Aplikácia máp"},{"@language":"sl-t-sv-t0-mtec","@value":"Aplikacija zemljevida"},{"@language":"uk-t-sv-t0-mtec","@value":"Додаток для мап"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/a5cef749-bb9f-49d8-80bd-e1cb77f988b4"}},{"@id":"http://data.europa.eu/88u/record/fddcb042-f88f-4501-9671-9714714dbe97","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/4582070e-be30-4d46-b307-8d80426ddad6"},{"@id":"http://data.europa.eu/88u/distribution/a5cef749-bb9f-49d8-80bd-e1cb77f988b4"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"fddcb042-f88f-4501-9671-9714714dbe97","dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-20T11:15:07Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:47Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/fddcb042-f88f-4501-9671-9714714dbe97"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/fddcb042-f88f-4501-9671-9714714dbe97"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:47Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"fddcb042-f88f-4501-9671-9714714dbe97","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/fddcb042-f88f-4501-9671-9714714dbe97"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:846149bf283adc599bf4e4b4d09184ebeebd95a725009c8c26870e21361bd505"},{"@graph":[{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"1981-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"1949-01-01"},"http://schema.org/endDate":{"@type":"xsd:date","@value":"1981-12-31"},"http://schema.org/startDate":{"@type":"xsd:date","@value":"1949-01-01"}},{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"12716a00a7556bbcdea4ee3ea37dd96aa2"},{"@id":"http://data.europa.eu/88u/dataset/584dc6de-3231-4efe-9d6a-aa12f97e03e0","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/1d51f6aa-d442-48b7-8555-6c5feefe2c7e"},"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=13439fb8-7368-4c97-a599-19af9ece0bd8"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"1949-06-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"въздушни изображения за производство на стереоскопични изображения за фотограметрично измерване; Снимките са правени в различна степен между 1949 и 1981 година. За да получите представа къде и кога сте летели, вижте прегледите на траекторията на полета. Снимките са в хартиени копия и/или негативи в архивите на Градоустройствената служба."},{"@language":"cs-t-sv-t0-mtec","@value":"letecké snímky pro výrobu stereoskopických snímků pro fotogrammetrické měření; Fotografie byly pořízeny v různé míře mezi lety 1949 a 1981. Chcete-li získat představu o tom, kde a kdy jste letěli, podívejte se na přehledy letové dráhy. Fotografie jsou v tištěné podobě a/nebo negativy v archivu Městského úřadu pro územní plánování."},{"@language":"da-t-sv-t0-mtec","@value":"luftbilleder til fremstilling af stereoskopiske billeder til fotogrammetrisk måling Billederne blev taget i varierende grad mellem 1949 og 1981. For at få en idé om, hvor du fløj og hvornår, henvises der til oversigterne over flyruter. Billederne er i papirudgaver og/eller negativer i byplanlægningskontorets arkiver."},{"@language":"de-t-sv-t0-mtec","@value":"Luftbilder zur Herstellung stereoskopischer Bilder zur photogrammetrischen Messung; Die Fotografien wurden zwischen 1949 und 1981 in unterschiedlichem Maße aufgenommen. Um eine Vorstellung davon zu bekommen, wo und wann Sie geflogen sind, lesen Sie die Flugbahnübersichten. Die Bilder befinden sich in Papierform und/oder Negativen im Archiv des Stadtplanungsamtes."},{"@language":"el-t-sv-t0-mtec","@value":"εναέριες εικόνες για την παραγωγή στερεοσκοπικών εικόνων για φωτογραμμετρικές μετρήσεις· Οι φωτογραφίες τραβήχτηκαν σε διάφορους βαθμούς μεταξύ 1949 και 1981. Για να πάρετε μια ιδέα για το πού πετάξατε και πότε, ανατρέξτε στις επισκοπήσεις της διαδρομής πτήσης. Οι εικόνες είναι σε έντυπη ή/και αρνητική μορφή στα αρχεία του Γραφείου Πολεοδομίας."},{"@language":"en-t-sv-t0-mtec","@value":"aerial images for the production of stereoscopic images for photogrammetric measurement; The photographs were taken to varying degrees between 1949 and 1981. To get an idea where you flew and when, refer to the flight path overviews. The pictures are in hard copies and/or negatives in the archives of the City Planning Office."},{"@language":"es-t-sv-t0-mtec","@value":"imágenes aéreas para la producción de imágenes estereoscópicas para la medición fotogramétrica; Las fotografías fueron tomadas en diversos grados entre 1949 y 1981. Para tener una idea de dónde voló y cuándo, consulte las vistas generales de la ruta de vuelo. Las imágenes están en copias impresas y / o negativos en los archivos de la Oficina de Planificación de la Ciudad."},{"@language":"et-t-sv-t0-mtec","@value":"aerofotod stereoskoopiliste kujutiste tootmiseks fotogramm-meetriliste mõõtmiste jaoks; Fotod on tehtud erineval määral aastatel 1949-1981. Et saada aimu, kuhu ja millal lendasite, vaadake lennutrajektoori ülevaateid. Pildid on linnaplaneerimisameti arhiivis paberkandjal ja/või negatiivis."},{"@language":"fi-t-sv-t0-mtec","@value":"ilmakuvat stereoskooppisten kuvien tuottamiseksi fotogrammetristä mittausta varten; Valokuvat on otettu vaihtelevassa määrin vuosina 1949-1981. Saadaksesi käsityksen siitä, missä lensit ja milloin, katso lentoradan yleiskatsaukset. Kuvat ovat paperikopioina ja/tai negatiivina kaupunkisuunnittelutoimiston arkistossa."},{"@language":"fr-t-sv-t0-mtec","@value":"images aériennes pour la production d'images stéréoscopiques pour la mesure photogrammétrique; Les photographies ont été prises à des degrés divers entre 1949 et 1981. Pour avoir une idée de l'endroit où vous avez volé et du moment où vous l'avez fait, reportez-vous aux aperçus des trajectoires de vol. Les images sont en copie papier et/ou en négatif dans les archives du bureau d'urbanisme."},{"@language":"ga-t-sv-t0-mtec","@value":"aeríomhánna chun íomhánna steiréascópacha a tháirgeadh chun fótagramiméadracht a thomhas; Tógadh na grianghraif go céimeanna éagsúla idir 1949 agus 1981. Chun smaoineamh a fháil ar an áit ar eitil tú agus cathain, déan tagairt do na forbhreathnuithe ar an gconair eitilte. Tá na pictiúir i gcóipeanna crua agus/nó i gclaonchlónna i gcartlann na hOifige Pleanála Cathrach."},{"@language":"hr-t-sv-t0-mtec","@value":"zračne snimke za izradu stereoskopskih slika za fotogrametrijsko mjerenje; Fotografije su snimljene u različitim stupnjevima između 1949. i 1981. godine. Da biste dobili ideju gdje ste letjeli i kada, pogledajte pregled putanje leta. Slike su u tiskanim primjercima i/ili negativima u arhivu Gradskog ureda za planiranje."},{"@language":"hu-t-sv-t0-mtec","@value":"légi felvételek sztereoszkopikus képek készítésére fotogrammetriai méréshez; A fényképek különböző mértékben készültek 1949 és 1981 között. Ha szeretné megtudni, hogy hol és mikor repült, olvassa el a repülési útvonal áttekintését. A képek nyomtatott és/vagy negatív formában a Várostervezési Hivatal archívumában találhatók."},{"@language":"it-t-sv-t0-mtec","@value":"immagini aeree per la produzione di immagini stereoscopiche per la misurazione fotogrammetrica; Le fotografie sono state scattate a vari livelli tra il 1949 e il 1981. Per avere un'idea di dove hai volato e quando, fai riferimento alle panoramiche della traiettoria di volo. Le immagini sono in copie cartacee e/o negative negli archivi dell'Ufficio Pianificazione Comunale."},{"@language":"lt-t-sv-t0-mtec","@value":"aerofotografiniai vaizdai stereoskopiniams vaizdams, skirtiems fotogrametriniams matavimams, gauti; Nuo 1949 m. iki 1981 m. nuotraukos buvo daromos įvairiais laipsniais. Norėdami sužinoti, kur ir kada skridote, peržiūrėkite skrydžio trajektorijos apžvalgas. Paveikslėliai spausdinti ir (arba) negatyvai saugomi Miesto planavimo biuro archyvuose."},{"@language":"lv-t-sv-t0-mtec","@value":"aeroattēli stereoskopisku attēlu radīšanai fotogrammetriskiem mērījumiem; Fotogrāfijas dažādās pakāpēs tika uzņemtas laikā no 1949. līdz 1981. gadam. Lai iegūtu priekšstatu par to, kur un kad lidojāt, skatiet lidojuma trajektorijas pārskatus. Attēli ir cietos eksemplāros un/vai negatīvi pilsētas plānošanas biroja arhīvos."},{"@language":"mt-t-sv-t0-mtec","@value":"immaġnijiet mill-ajru għall-produzzjoni ta’ immaġnijiet sterjoskopiċi għall-kejl fotogrammetriku; Ir-ritratti ttieħdu fi gradi differenti bejn l-1949 u l-1981. Biex tikseb idea fejn ttir u meta, irreferi għall-ħarsiet ġenerali tar-rotta tat-titjira. L-istampi huma f'kopji stampati u / jew negattivi fl-arkivji tal-Uffiċċju tal-Ippjanar tal-Belt."},{"@language":"nl-t-sv-t0-mtec","@value":"luchtbeelden voor de productie van stereoscopische beelden voor fotogrammetrische meting; De foto's zijn in verschillende mate genomen tussen 1949 en 1981. Om een idee te krijgen waar je bent gevlogen en wanneer, raadpleeg je de vluchtpadoverzichten. De foto's staan op papier en/of negatief in de archieven van het Stadsplanningsbureau."},{"@language":"pl-t-sv-t0-mtec","@value":"obrazy lotnicze do produkcji obrazów stereoskopowych do pomiarów fotogrametrycznych; Zdjęcia zostały wykonane w różnym stopniu w latach 1949-1981. Aby dowiedzieć się, gdzie i kiedy leciałeś, zapoznaj się z przeglądami torów lotu. Zdjęcia znajdują się w kopiach papierowych i/lub negatywach w archiwach Urzędu Planowania Miejskiego."},{"@language":"pt-t-sv-t0-mtec","@value":"Imagens aéreas para a produção de imagens estereoscópicas para medição fotogramétrica; As fotografias foram tiradas em diferentes graus entre 1949 e 1981. Para ter uma ideia de onde voou e quando, consulte as panorâmicas da trajetória de voo. As imagens estão em cópias impressas e/ou negativas nos arquivos do Gabinete de Planeamento da Cidade."},{"@language":"ro-t-sv-t0-mtec","@value":"imagini aeriene pentru producerea de imagini stereoscopice pentru măsurători fotogrammetrice; Fotografiile au fost realizate în grade diferite între 1949 și 1981. Pentru a vă face o idee unde ați zburat și când, consultați prezentările generale ale traiectoriilor de zbor. Imaginile sunt în exemplare tipărite și/sau negative în arhivele Biroului de urbanism."},{"@language":"sk-t-sv-t0-mtec","@value":"letecké snímky na výrobu stereoskopických snímok na fotogrammetrické meranie; Fotografie boli zhotovené v rôznych stupňoch medzi rokmi 1949 a 1981. Ak chcete získať predstavu o tom, kam a kedy ste leteli, pozrite si prehľady dráhy letu. Fotografie sú vyhotovené v tlačenej podobe a/alebo v negatívoch v archívoch Mestského úradu."},{"@language":"sl-t-sv-t0-mtec","@value":"slike iz zraka za izdelavo stereoskopskih slik za fotogrametrično merjenje; Fotografije so bile posnete v različnem obsegu med letoma 1949 in 1981. Če želite dobiti idejo, kje ste leteli in kdaj, si oglejte preglede poti leta. Slike so v tiskanih izvodih in/ali negativih v arhivu urada za prostorsko načrtovanje."},{"@language":"sv","@value":"Flygbilder för framställning av stereobilder för fotogrametriskt mätning. Bilderna togs i varierande omfattning mellan åren 1949 och 1981. För att få en uppfattning var man flög och när hänvisas till flygstråksöversikterna. Bilderna ligger som papperskopior och/eller negativ i stadsbyggnadskontorets arkiv."},{"@language":"uk-t-sv-t0-mtec","@value":"аерофотознімки для виготовлення стереоскопічних знімків для фотограмметричних вимірювань; Фотографії були зроблені в різній мірі між 1949 і 1981 роками. Щоб отримати уявлення про те, куди і коли ви летіли, зверніться до оглядів траєкторії польоту. Фотографії зберігаються на паперових носіях та/або в негативі в архівах Містобудівного управління."}],"dct:format":"text/html","dct:identifier":"584dc6de-3231-4efe-9d6a-aa12f97e03e0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b0n0"},"dct:temporal":{"@id":"_:849eacc9950cf0dbc2061a5741201db3c0b5df92600627a257efc8bbb8d13a9e_b1n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Исторически въздушни снимки (1949 - 1981)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Historické letecké fotografie (1949 - 1981)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Historiske luftfotos (1949 - 1981)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Historische Luftaufnahmen (1949 - 1981)"},{"@language":"el-t-sv-t0-mtec","@value":"Ιστορικές αεροφωτογραφίες (1949 - 1981)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Historical aerial photographs (1949 - 1981)"},{"@language":"es-t-sv-t0-mtec","@value":"SBK Fotografías aéreas históricas (1949 - 1981)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Ajaloolised aerofotod (1949-1981)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Historialliset ilmakuvat (1949 - 1981)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Photographies aériennes historiques (1949 - 1981)"},{"@language":"ga-t-sv-t0-mtec","@value":"SBK Aerghrianghraif Stairiúla (1949 - 1981)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Povijesne zračne fotografije (1949. - 1981.)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Történelmi légi felvételek (1949-1981)"},{"@language":"it-t-sv-t0-mtec","@value":"SBK Fotografie aeree storiche (1949 - 1981)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Istorinės aeronuotraukos (1949 - 1981)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Vēsturiskās aerofotogrāfijas (1949 - 1981)"},{"@language":"mt-t-sv-t0-mtec","@value":"SBK Ritratti storiċi mill-ajru (1949 - 1981)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Historische luchtfoto's (1949 - 1981)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Historyczne zdjęcia lotnicze (1949 - 1981)"},{"@language":"pt-t-sv-t0-mtec","@value":"SBK Fotografias aéreas históricas (1949 - 1981)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Fotografii aeriene istorice (1949 - 1981)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Historické letecké fotografie (1949 - 1981)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Zgodovinske aerofotografije (1949-1981)"},{"@language":"sv","@value":"SBK Historiska flygbilder (1949 - 1981)"},{"@language":"uk-t-sv-t0-mtec","@value":"SBK Історичні аерофотознімки (1949 - 1981)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"htt