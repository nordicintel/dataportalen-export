7e498e36ab65e43b84331f4162450e783e5ba5c545_b1n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/1e2d37d6-1bbe-4c51-b182-f03854c13a9c"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:44:27Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"1e2d37d6-1bbe-4c51-b182-f03854c13a9c","https://piveau.eu/ns/voc#originalURIRef":"https://resources.stockholm.se/data/1e2d37d6-1bbe-4c51-b182-f03854c13a9c"},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:c98569c032e2553318ca537e498e36ab65e43b84331f4162450e783e5ba5c545"},{"@graph":[{"@id":"_:c9b2438be1c6334ee432a3ad5182b4095fd5c69f3d8b012aaca0aa1ea3cd6906_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"http://dataportal.se/organisation/SE2120000142","@type":"foaf:Agent","dct:identifier":"2120000142","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommunstyrelsen@stockholm.se"},"foaf:name":{"@language":"sv","@value":"Stockholms stad"},"foaf:page":{"@id":"https://www.stockholm.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://resources.stockholm.se/metadata#foaf/Stockholms+stad/"}},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/"},"dcat:distribution":[{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:Information/1"},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:Nedladdning/4"},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:OGC:WFS/2"},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:OGC:WMS/3"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"},{"@language":"sv","@value":"Ingen eller försumbar skada"},{"@language":"sv","@value":"Trafikplanering"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=LvFeature15489450"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/5850"},"dct:description":{"@language":"sv","@value":"Geometri som beskriver trafikflöden. Linjegeometri. Enbart för kommunalt vägnät. Verksamhet Analys & Dialog, Trafikplanering, Trafikkontoret. Trafikflödeskartan gång innehåller uppgifter om trafikmängder i Stockholm uppdelat på gång, per vardagsmedeldygn och för en vissa tidsperiod över dygnet. Data avser 2017 och täcker Norrmalm, Stockholms kommun."},"dct:identifier":"45b3cdab-2a6e-4477-9d01-19139f87829a","dct:issued":{"@type":"xsd:date","@value":"2018-09-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c9b2438be1c6334ee432a3ad5182b4095fd5c69f3d8b012aaca0aa1ea3cd6906_b0n0"},"dct:title":{"@language":"sv","@value":"Trafikflöde Gång"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetws.stockholm.se"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Webbsida med handledning och API-beskrivning"},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:Nedladdning/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs/?version=1.0.0&request=GetFeature&typeName=od_gis:Trafikflode_Gang&outputFormat=GeoPackage"},"dct:description":"Export via WFS och GeoService returnerar GeoPackage","dct:title":"TK Open data GeoPackage export"},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:OGC:WFS/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wfs?typename=od_gis:Trafikflode_Gang"},"dct:description":"OGC Web Feature Service 1.0.0 och 1.1.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":"TK Open data WFS tjänst","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://resources.stockholm.se/data/45b3cdab-2a6e-4477-9d01-19139f87829a#HTTP:OGC:WMS/3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://openstreetgs.stockholm.se/geoservice/api/DIN+API-NYCKEL/wms?layers=od_gis:Trafikflode_Gang"},"dct:description":"OGC Web Map Service 1.1.1 och 1.3.0. Gällande featuretype hittas i capabilities informationen (FeatureType)","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:title":"TK Open data WMS tjänst"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Trafikkontoret/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Trafikkontoret"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:funktionsbrevlada.tk.open.data@stockholm.se"}}],"@id":"urn:source:c9b2438be1c6334ee432a3ad5182b4095fd5c69f3d8b012aaca0aa1ea3cd6906"},{"@graph":[{"@id":"_:c9ce8bb245b029c97b59e70c47cde3e343dad0363998568b0bb1ea27dc24cb65_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"},"http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,18.2011 59.4402,18.2011 59.2272,17.7605 59.2272,17.7605 59.4402))"}},{"@id":"_:c9ce8bb245b029c97b59e70c47cde3e343dad0363998568b0bb1ea27dc24cb65_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"1948eb5d788221d9aabafa4774e043a518"},{"@id":"http://data.europa.eu/88u/dataset/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/39536bf7-8129-49ab-88e6-f30aa0429867"},{"@id":"http://data.europa.eu/88u/distribution/e7bb08a9-b9cf-45e5-80fd-2c2c7d0209cc"},{"@id":"http://data.europa.eu/88u/distribution/f440c443-be5b-481d-aa11-f423a579668c"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Fullständiga metadata"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=4563bcc3-9739-46ad-994e-9479c51fdb9d"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"1961-01-01"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Подробен устройствен план регулира развитието в рамките на определен район или имот. Той определя, наред с други неща, къде могат да бъдат разположени къщите, колко високи могат да бъдат и за какво могат да се използват. Регулационният план управлява както разрешението за планиране, така и предишното образуване на собственост.Всеки регулационен план е ограничен от граница на регулация. Зоналната граница указва географския район, обхванат от регулационния план. Прочетете повече на https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Този набор от данни показва планове (подробни планове, градоустройствени планове, строителни планове, генерален план, поземлени участъци, планове за недвижими имоти, промени в подробен план и планове за разрушаване) в град Стокхолм, които са придобили правна сила, както и за райони, в които се работи по подробен план. Във всяка област се посочва регистрационният номер на плана (напр. 7538 или P2012-13546). Документите за планиране могат да бъдат намерени в Службата за строителство и планиране и са достъпни чрез регистрационния номер. Страница за търсене на текущи планове: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Търсене на страница за текущата работа по планирането: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"cs-t-sv-t0-mtec","@value":"Podrobný plán rozvoje upravuje rozvoj v určité oblasti nebo nemovitosti. Upřesňuje mimo jiné, kde mohou být domy umístěny, jak vysoké mohou být a k čemu mohou být použity. Územní plán řídí jak územní povolení, tak předchozí tvorbu nemovitostí.Každý územní plán je vymezen hranicí územního plánu. Územní hranice označuje zeměpisnou oblast, na kterou se vztahuje územní plán. Další informace naleznete na adrese https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/This data set shows plans (detailed plans, city plans, building plans, master plan, plot divisions, real estate plans, changes to detailed plan and demolition plans) in the City of Stockholm that have got legal force and for areas where detailed plan work is ongoing. V každé oblasti je uvedeno registrační číslo plánu (např. 7538 nebo P2012-13546). Plánovací dokumenty jsou k dispozici ve stavebním a plánovacím oddělení a jsou přístupné prostřednictvím registračního čísla. Vyhledávací stránka pro aktuální plány: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Vyhledávací stránka pro probíhající plánovací práce: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"da-t-sv-t0-mtec","@value":"En detaljeret udviklingsplan regulerer udviklingen inden for et bestemt område eller ejendom. Det specificerer blandt andet, hvor huse kan placeres, hvor høje de kan være, og hvad de kan bruges til. En zoneplan regulerer både byggetilladelsen og den tidligere ejendomsdannelse.Hver zoneplan er afgrænset af en zoneinddelingsgrænse. Zonegrænsen angiver det geografiske område, der er omfattet af zoneplanen. Læs mere på https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Dette datasæt viser planer (detaljerede planer, byplaner, bygningsplaner, masterplan, parcelafdelinger, ejendomsplaner, ændringer af detaljerede planer og nedrivningsplaner) i Stockholm by, som har fået retskraft, og for områder, hvor der arbejdes med detaljerede planer. I hvert område angives planens registreringsnummer (f.eks. 7538 eller P2012-13546). Planlægningsdokumenter findes i Bygnings- og Planlægningstjenesten og kan tilgås via registreringsnummeret. Søgeside for aktuelle planer: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for ongoing planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"de-t-sv-t0-mtec","@value":"Ein detaillierter Bebauungsplan regelt die Bebauung innerhalb eines bestimmten Gebiets oder Grundstücks. Sie legt unter anderem fest, wo Häuser platziert werden dürfen, wie hoch sie sein dürfen und wofür sie verwendet werden dürfen. Ein Zoning-Plan regelt sowohl die Baugenehmigung als auch die vorherige Grundstücksbildung.Jeder Zoning-Plan wird durch eine Zoning-Grenze begrenzt. Die Zonengrenze gibt das geografische Gebiet an, auf das sich der Zonenplan bezieht. Lesen Sie mehr unter https://www.boverket.se/de/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Dieser Datensatz zeigt Pläne (detaillierte Pläne, Stadtpläne, Baupläne, Masterplan, Grundstücksteilungen, Immobilienpläne, Änderungen an Detailplänen und Abrissplänen) in der Stadt Stockholm, die an Rechtskraft gewonnen haben, und für Gebiete, in denen detaillierte Planungsarbeiten im Gange sind. In jedem Bereich wird die Registrierungsnummer des Plans angegeben (z. B. 7538 oder P2012-13546). Planungsunterlagen finden Sie im Gebäude- und Planungsservice und sind über die Registrierungsnummer abrufbar. Suchseite für aktuelle Pläne: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Suchseite für laufende Planungsarbeiten: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"el-t-sv-t0-mtec","@value":"Ένα λεπτομερές σχέδιο ανάπτυξης ρυθμίζει την ανάπτυξη μέσα σε μια συγκεκριμένη περιοχή ή ιδιοκτησία. Διευκρινίζει, μεταξύ άλλων, πού μπορούν να τοποθετηθούν τα σπίτια, πόσο ψηλά μπορούν να είναι και για τι μπορούν να χρησιμοποιηθούν. Ένα σχέδιο χωροταξίας διέπει τόσο την πολεοδομική άδεια όσο και τον προηγούμενο σχηματισμό ιδιοκτησίας.Κάθε σχέδιο χωροταξίας οριοθετείται από ένα όριο χωροταξίας. Το όριο ζώνης δηλώνει τη γεωγραφική περιοχή που καλύπτεται από το σχέδιο διαίρεσης σε ζώνες. Διαβάστε περισσότερα στη διεύθυνση https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/This data set shows plans (detailed plans, city plans, building plans, master plan, plot divisions, real estate plans, changes to detailed plan and demolition plans) in the City of Stockholm that have gained legal force and for areas where detailed plan work is ongoing. Σε κάθε περιοχή αναγράφεται ο αριθμός καταχώρισης του σχεδίου (π.χ. 7538 ή P2012-13546). Τα έγγραφα σχεδιασμού βρίσκονται στην Υπηρεσία Κτιρίων και Σχεδιασμού και είναι προσβάσιμα μέσω του αριθμού καταχώρισης. Αναζήτηση σελίδας για τρέχοντα σχέδια: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Σελίδα αναζήτησης για τις εν εξελίξει εργασίες σχεδιασμού: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"en-t-sv-t0-mtec","@value":"A detailed development plan regulates the development within a certain area or property. It specifies, among other things, where houses may be placed, how high they may be and what they may be used for. A zoning plan governs both the planning permission and the previous property formation.Each zoning plan is delimited by a zoning boundary. The zonal boundary indicates the geographical area covered by the zoning plan. Read more at https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/This data set shows plans (detailed plans, city plans, building plans, master plan, plot divisions, real estate plans, changes to detailed plan and demolition plans) in the City of Stockholm that have gained legal force and for areas where detailed plan work is ongoing. In each area it says the registration number of the plan (e.g. 7538 or P2012-13546). Planning documents can be found in the Building and Planning Service and can be accessed via the registration number. Search page for current plans: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for ongoing planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"es-t-sv-t0-mtec","@value":"Un plan de desarrollo detallado regula el desarrollo dentro de un área o propiedad determinada. Especifica, entre otras cosas, dónde se pueden colocar las casas, qué tan altas pueden ser y para qué se pueden usar. Un plan de zonificación rige tanto el permiso de planificación como la formación de propiedad anterior. El límite zonal indica la zona geográfica cubierta por el plan de zonificación. Lea más en https://www.boverket.se/es/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Este conjunto de datos muestra planes (planos detallados, planes urbanos, planes de construcción, plan maestro, divisiones de parcelas, planes inmobiliarios, cambios en el plan detallado y planes de demolición) en la ciudad de Estocolmo que han adquirido fuerza legal y para áreas donde se está trabajando en el plan detallado. En cada área dice el número de registro del plan (por ejemplo, 7538 o P2012-13546). Los documentos de planificación se pueden encontrar en el Servicio de Construcción y Planificación y se puede acceder a través del número de registro. Página de búsqueda de planes actuales: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Página de búsqueda de trabajos de planificación en curso: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"et-t-sv-t0-mtec","@value":"Detailplaneering reguleerib teatud piirkonna või vara arengut. Selles on muu hulgas täpsustatud, kuhu maju võib paigutada, kui kõrgel need võivad olla ja milleks neid võib kasutada. Tsoneerimisplaan reguleerib nii planeerimisluba kui ka eelmist kinnisvara moodustamist.Iga tsoneerimisplaan on piiritletud tsoneerimispiiriga. Piirkonnapiir näitab piirkonnaplaneeringuga hõlmatud geograafilist piirkonda. Loe lisaks aadressilt https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/See andmekogum näitab Stockholmi linna plaane (üksikasjalikud plaanid, linnaplaanid, ehitusplaanid, üldplaneeringud, kruntide jaotused, kinnisvaraplaanid, detailplaneeringute ja lammutusplaanide muudatused), mis on omandanud õigusliku jõu, ja nende piirkondade plaane, kus detailplaneeringute koostamine on käimas. Igas piirkonnas märgitakse kava registreerimisnumber (nt 7538 või P2012-13546). Planeerimisdokumendid leiate ehitus- ja planeerimisteenistusest ning need on kättesaadavad registreerimisnumbri kaudu. Otsi praeguste plaanide lehte: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Otsi käimasolevat planeerimistööd: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"fi-t-sv-t0-mtec","@value":"Yksityiskohtainen kehittämissuunnitelma säätelee tietyn alueen tai kiinteistön kehitystä. Siinä määritellään muun muassa, mihin taloja voidaan sijoittaa, kuinka korkeita ne voivat olla ja mihin niitä voidaan käyttää. Kaavoitussuunnitelma ohjaa sekä kaavoituslupaa että edellistä kiinteistönmuodostusta.Kutakin kaavoitussuunnitelmaa rajoittaa kaavoitusraja. Alueraja osoittaa kaavoitussuunnitelman kattaman maantieteellisen alueen. Lue lisää osoitteesta https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Tässä tietokokonaisuudessa esitetään Tukholman kaupungin suunnitelmat (yksityiskohtaiset suunnitelmat, kaupunkisuunnitelmat, rakennussuunnitelmat, yleissuunnitelma, tonttijako, kiinteistösuunnitelmat, muutokset yksityiskohtaisiin suunnitelmiin ja purkusuunnitelmiin), jotka ovat saaneet lainvoiman, sekä alueet, joilla yksityiskohtainen suunnitelmatyö on käynnissä. Kullakin alueella ilmoitetaan suunnitelman rekisterinumero (esim. 7538 tai P2012-13546). Suunnitteluasiakirjat löytyvät rakennus- ja suunnittelupalvelusta ja ne ovat saatavilla rekisteröintinumeron kautta. Nykyisten suunnitelmien hakusivu: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for ongoing planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"fr-t-sv-t0-mtec","@value":"Un plan de développement détaillé réglemente le développement dans une zone ou une propriété donnée. Il précise, entre autres, où les maisons peuvent être placées, à quelle hauteur elles peuvent être et à quoi elles peuvent servir. Un plan de zonage régit à la fois le permis d'urbanisme et la formation de la propriété précédente.Chaque plan de zonage est délimité par une limite de zonage. La limite zonale indique la zone géographique couverte par le plan de zonage. Pour en savoir plus, consultez le site https://www.boverket.se/fr/PBL-knowledgebanken/planning/detailed plan/detailed regulation/plan designations/This data set shows plans (detailed plans, city plans, building plans, master plan, plot divisions, real estate plans, changes to detailed plan and démolition plans) in the City of Stockholm that have gain legal force and for areas where detailed plan work is ongoing. Dans chaque zone, il indique le numéro d'enregistrement du plan (par exemple, 7538 ou P2012-13546). Les documents d'urbanisme se trouvent au Service Immeubles et Planification et sont accessibles via le numéro d'enregistrement. Page de recherche pour les plans actuels: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Page de recherche pour les travaux de planification en cours: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"ga-t-sv-t0-mtec","@value":"Rialaíonn plean forbartha mionsonraithe an fhorbairt laistigh de limistéar nó de mhaoin áirithe. Sonraíonn sé, i measc rudaí eile, cá háit ar féidir tithe a chur, cé chomh hard agus a d'fhéadfadh siad a bheith agus cad is féidir iad a úsáid. Rialaíonn plean criosaithe an cead pleanála agus an foirmiú maoine roimhe sin araon.Tá gach plean criosaithe teoranta ag teorainn criosaithe. Léiríonn an teorainn chriosach an limistéar geografach a chumhdaítear leis an bplean criosaithe. Léigh tuilleadh ag https://www.boverket.se/en/PBL-knowledgebanken/pleanáil/plean mionsonraithe/rialacháin phlean/ainmnithe móra/Taispeánann an tacar sonraí seo pleananna (pleananna mionsonraithe, pleananna cathrach, pleananna tógála, máistirphlean, ranna dáileachta talún, pleananna eastáit réadaigh, athruithe ar phlean mionsonraithe agus pleananna scartála) i gCathair Stócólm a bhfuil feidhm dhlíthiúil bainte amach acu agus le haghaidh limistéir ina bhfuil obair phlean mhionsonraithe ar siúl. I ngach réimse deir sé uimhir chlárúcháin an phlean (e.g. 7538 nó P2012-13546). Is féidir doiciméid phleanála a fháil sa tSeirbhís Tógála agus Pleanála agus is féidir teacht orthu tríd an uimhir chlárúcháin. Leathanach cuardaigh le haghaidh pleananna reatha: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Leathanach cuardaigh le haghaidh obair phleanála leanúnach: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"hr-t-sv-t0-mtec","@value":"Detaljan razvojni plan regulira razvoj unutar određenog područja ili nekretnine. Navodi se, između ostalog, gdje se kuće mogu smjestiti, koliko visoko mogu biti i za što se mogu koristiti. Prostorni plan upravlja i lokacijskom dozvolom i prethodnom formacijom imovine.Svaki prostorni plan ograničen je prostornom granicom. Zonska granica označava zemljopisno područje obuhvaćeno prostornim planom. Pročitajte više na https://www.boverket.se/en/PBL-knowledgebanken/planning/detaljni plan/uredbe o planovima/velike oznake/Ovaj skup podataka prikazuje planove (detaljne planove, gradske planove, građevinske planove, glavni plan, podjele parcela, planove nekretnina, izmjene detaljnih planova i planova rušenja) u gradu Stockholmu koji su stekli pravnu snagu i za područja u kojima su u tijeku detaljni planovi. U svakom području navodi se registracijski broj plana (npr. 7538 ili P2012-13546). Dokumenti za planiranje mogu se pronaći u Službi za gradnju i planiranje, a dostupni su putem registracijskog broja. Stranica za pretraživanje trenutačnih planova: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Stranica pretraživanja za tekuće planiranje: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"hu-t-sv-t0-mtec","@value":"Részletes fejlesztési terv szabályozza a fejlesztést egy adott területen vagy ingatlanon belül. Meghatározza többek között, hogy hol helyezhetők el a házak, milyen magasak lehetnek, és mire használhatók. A területrendezési terv szabályozza mind a tervezési engedélyt, mind az előző ingatlanalapítást. Az övezeti határ a területrendezési terv által lefedett földrajzi területet jelöli. További információk: https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Ez az adatkészlet Stockholm város azon terveit (részletes tervek, várostervek, építési tervek, főterv, telekosztások, ingatlantervek, a részletes terv és a bontási tervek módosításai) mutatja be, amelyek jogerőre emelkedtek, és amelyek olyan területekre vonatkoznak, ahol a részletes tervekkel kapcsolatos munka folyamatban van. Minden területen feltünteti a terv nyilvántartási számát (pl. 7538 vagy P2012-13546). A tervezési dokumentumok megtalálhatók az Épület- és Tervezési Szolgálatnál, és a nyilvántartási számon keresztül érhetők el. Aktuális tervek keresése: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Keresési oldal a folyamatban lévő tervezési munkákhoz: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"it-t-sv-t0-mtec","@value":"Un piano di sviluppo dettagliato regola lo sviluppo all'interno di una determinata area o proprietà. Specifica, tra le altre cose, dove possono essere collocate le case, quanto possono essere alte e per cosa possono essere utilizzate. Un piano di zonizzazione governa sia il permesso di pianificazione che la precedente formazione di proprietà.Ogni piano di zonizzazione è delimitato da un confine di zonizzazione. Il confine zonale indica la zona geografica coperta dal piano regolatore. Maggiori informazioni su https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Questo set di dati mostra i piani (piani dettagliati, piani urbanistici, piani edilizi, master plan, lottizzazioni, piani immobiliari, modifiche ai piani dettagliati e piani di demolizione) nella città di Stoccolma che hanno acquisito forza giuridica e per le aree in cui sono in corso lavori di pianificazione dettagliata. In ogni area indica il numero di registrazione del piano (ad esempio 7538 o P2012-13546). I documenti di pianificazione sono disponibili nel servizio Edilizia e pianificazione e sono accessibili tramite il numero di registrazione. Pagina di ricerca per i piani attuali: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Pagina di ricerca per i lavori di pianificazione in corso: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"lt-t-sv-t0-mtec","@value":"Išsamus plėtros planas reglamentuoja plėtrą tam tikroje teritorijoje ar nuosavybėje. Jame, be kita ko, nurodoma, kur gali būti pastatyti namai, kokio dydžio jie gali būti ir kam jie gali būti naudojami. Zonos planas reglamentuoja tiek planavimo leidimą, tiek ankstesnį turto formavimą.Kiekvienas zonavimo planas yra apribotas zonavimo riba. Zonos riba rodo geografinę teritoriją, kuriai taikomas zonavimo planas. Plačiau žr. https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan Regulations/grand designations/This data set shows plans (detalieji planai, miestų planai, pastatų planai, bendrasis planas, sklypo skyriai, nekilnojamojo turto planai, detaliojo plano pakeitimai ir griovimo planai) in the City of Stockholm that have got force and for areas where detailed plan work is ongoing. Kiekvienoje srityje nurodomas plano registracijos numeris (pvz., 7538 arba P2012-13546). Planavimo dokumentus galima rasti Statybos ir planavimo tarnyboje ir su jais galima susipažinti pagal registracijos numerį. Dabartinių planų paieškos puslapis: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Tęsiamo planavimo darbo paieškos puslapis: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"lv-t-sv-t0-mtec","@value":"Detalizēts attīstības plāns regulē attīstību noteiktā teritorijā vai īpašumā. Tajā cita starpā ir noteikts, kur var novietot mājas, cik augstas tās var būt un kādam nolūkam tās var izmantot. Zonējuma plāns regulē gan plānošanas atļauju, gan iepriekšējo īpašuma veidošanu.Katru zonējuma plānu ierobežo zonējuma robeža. Zonas robeža norāda ģeogrāfisko apgabalu, uz kuru attiecas zonējuma plāns. Lasiet vairāk vietnē https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan rules/grand designations/Šī datu kopa parāda Stokholmas pilsētas plānus (detalizēti plāni, pilsētas plāni, apbūves plāni, ģenerālplāns, zemesgabalu sadalīšana, nekustamā īpašuma plāni, izmaiņas detālplānojumā un nojaukšanas plānos), kas ir ieguvuši juridisku spēku, un attiecībā uz jomām, kurās notiek detalizēta plāna izstrāde. Katrā apgabalā norāda plāna reģistrācijas numuru (piemēram, 7538 vai P2012-13546). Plānošanas dokumentus var atrast Ēku un plānošanas dienestā, un tiem var piekļūt, izmantojot reģistrācijas numuru. Pašreizējo plānu meklēšanas lapa: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Pašreizējā plānošanas darba meklēšanas lapa: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"mt-t-sv-t0-mtec","@value":"Pjan dettaljat ta’ żvilupp jirregola l-iżvilupp f’ċerta żona jew proprjetà. Hija tispeċifika, fost affarijiet oħra, fejn jistgħu jitqiegħdu d-djar, kemm jistgħu jkunu għoljin u għal xiex jistgħu jintużaw. Pjan ta’ tqassim f’żoni jirregola kemm il-permess tal-ippjanar kif ukoll il-formazzjoni preċedenti tal-proprjetà. Kull pjan ta’ tqassim f’żoni huwa delimitat minn limitu ta’ tqassim f’żoni. Il-konfini taż-żona jindikaw iż-żona ġeografika koperta mill-pjan ta’ tqassim f’żoni. Aqra aktar fuq https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Dan is-sett ta’ data juri pjanijiet (pjanijiet dettaljati, pjanijiet tal-belt, pjanijiet tal-bini, pjan ewlieni, diviżjonijiet tal-plott, pjanijiet tal-proprjetà immobbli, bidliet fil-pjanijiet dettaljati u pjanijiet ta’ demolizzjoni) fil-Belt ta’ Stokkolma li kisbu forza legali u għal żoni fejn il-ħidma dettaljata tal-pjan għadha għaddejja. F’kull qasam jgħid in-numru ta’ reġistrazzjoni tal-pjan (eż. 7538 jew P2012-13546). Id-dokumenti tal-ippjanar jistgħu jinstabu fis-Servizz tal-Bini u l-Ippjanar u jistgħu jiġu aċċessati permezz tan-numru tar-reġistrazzjoni. Paġna tat-tiftix għall-pjanijiet attwali: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Paġna tat-tiftix għal xogħol ta’ ppjanar kontinwu: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"nl-t-sv-t0-mtec","@value":"Een gedetailleerd ontwikkelingsplan regelt de ontwikkeling binnen een bepaald gebied of eigendom. Het specificeert onder andere waar huizen kunnen worden geplaatst, hoe hoog ze kunnen zijn en waarvoor ze kunnen worden gebruikt. Een bestemmingsplan regelt zowel de bouwvergunning als de vorige eigendomsvorming. De zonegrens geeft het geografische gebied aan waarop het bestemmingsplan betrekking heeft. Lees meer op https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/This data set shows plans (detailed plans, city plans, building plans, master plan, plot divisions, real estate plans, changes to detailed plan and smolition plans) in the City of Stockholm that have gained legal force and for areas where detailed plan work is ongoing. In elk gebied staat het registratienummer van het plan (bv. 7538 of P2012-13546). Planningsdocumenten zijn te vinden in de Bouw- en Planningsdienst en zijn toegankelijk via het registratienummer. Zoekpagina voor huidige plannen: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Zoekpagina voor lopende planningswerkzaamheden: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"pl-t-sv-t0-mtec","@value":"Szczegółowy plan zagospodarowania reguluje zagospodarowanie w obrębie określonego obszaru lub nieruchomości. Określa między innymi, gdzie mogą być umieszczone domy, jak wysokie mogą być i do czego mogą być używane. Plan zagospodarowania przestrzennego reguluje zarówno pozwolenie na budowę, jak i poprzednie tworzenie nieruchomości.Każdy plan zagospodarowania przestrzennego jest ograniczony granicą zagospodarowania przestrzennego. Granica strefy wskazuje obszar geograficzny objęty planem zagospodarowania przestrzennego. Więcej informacji można znaleźć na stronie https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Ten zbiór danych przedstawia plany (szczegółowe plany, plany miejskie, plany budowlane, plan generalny, działki, plany nieruchomości, zmiany w szczegółowym planie i planach rozbiórki) w Sztokholmie, które zyskały moc prawną, oraz obszary, w których trwają szczegółowe prace planistyczne. W każdym obszarze podaje numer rejestracyjny planu (np. 7538 lub P2012-13546). Dokumenty dotyczące planowania można znaleźć w Dziale ds. Budynków i Planowania, a dostęp do nich można uzyskać za pośrednictwem numeru rejestracyjnego. Strona wyszukiwania aktualnych planów: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Strona wyszukiwania dotycząca bieżących prac planistycznych: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"pt-t-sv-t0-mtec","@value":"Um plano de desenvolvimento detalhado regula o desenvolvimento dentro de uma determinada área ou propriedade. Especifica, entre outras coisas, onde as casas podem ser colocadas, quão altas podem ser e para que podem ser usadas. Um plano de zoneamento rege tanto a permissão de planejamento quanto a formação anterior da propriedade.Cada plano de zoneamento é delimitado por um limite de zoneamento. O limite zonal indica a área geográfica abrangida pelo plano de urbanização. Para mais informações, consultar https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Este conjunto de dados mostra planos (planos pormenorizados, planos municipais, planos de construção, plano diretor, divisões de parcelas, planos imobiliários, alterações ao plano pormenorizado e planos de demolição) na cidade de Estocolmo que adquiriram força jurídica e em zonas onde estão em curso trabalhos pormenorizados sobre o plano. Em cada área indica o número de registo do plano (por exemplo, 7538 ou P2012-13546). Os documentos de planeamento podem ser encontrados no Serviço de Planeamento e Construção e podem ser acedidos através do número de registo. Página de pesquisa para os planos atuais: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Página de pesquisa para os trabalhos de planeamento em curso: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"ro-t-sv-t0-mtec","@value":"Un plan detaliat de dezvoltare reglementează dezvoltarea într-o anumită zonă sau proprietate. Acesta specifică, printre altele, unde pot fi amplasate casele, cât de înalte pot fi și pentru ce pot fi folosite. Un plan de zonare guvernează atât autorizația de planificare, cât și formarea anterioară a proprietății.Fiecare plan de zonare este delimitat de o limită de zonare. Limita zonală indică aria geografică acoperită de planul de zonare. Citiți mai multe la adresa https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Acest set de date prezintă planurile (planuri detaliate, planuri urbane, planuri de construcție, plan general, divizii de parcele, planuri imobiliare, modificări ale planurilor detaliate și planuri de demolare) din orașul Stockholm care au dobândit forță juridică și pentru zonele în care sunt în curs de desfășurare lucrări detaliate privind planurile. În fiecare zonă se menționează numărul de înregistrare al planului (de exemplu, 7538 sau P2012-13546). Documentele de planificare pot fi găsite în Serviciul de planificare a clădirilor și pot fi accesate prin intermediul numărului de înregistrare. Pagina de căutare pentru planurile curente: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Pagina de căutare pentru lucrările de planificare în curs: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"sk-t-sv-t0-mtec","@value":"Podrobný plán rozvoja reguluje rozvoj v rámci určitej oblasti alebo majetku. Okrem iného špecifikuje, kde môžu byť domy umiestnené, aké vysoké môžu byť a na čo sa môžu použiť. Územný plán upravuje územné povolenie aj predchádzajúcu formáciu nehnuteľnosti.Každý územný plán je vymedzený hranicou zónovania. Hranica zón označuje zemepisnú oblasť, na ktorú sa vzťahuje územný plán. Viac informácií nájdete na adrese https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/This data set shows plans (detailed plans, city plans, building plan, master plan, plot divisions, real estate plans, changes to detailed plan and demolition plans) in the City of Stockholm that have become legal force and for areas where detailed plan work is ongoing. V každej oblasti sa uvádza registračné číslo plánu (napr. 7538 alebo P2012-13546). Plánovacie dokumenty možno nájsť v oddelení pre výstavbu a plánovanie a sú prístupné prostredníctvom registračného čísla. Vyhľadávacia stránka pre aktuálne plány: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for ongoing planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"sl-t-sv-t0-mtec","@value":"Podroben razvojni načrt ureja razvoj na določenem območju ali nepremičnini. Med drugim določa, kje se lahko postavijo hiše, kako visoke so lahko in za kaj se lahko uporabljajo. Območni načrt ureja tako gradbeno dovoljenje kot prejšnjo tvorbo nepremičnine.Vsak prostorski načrt je omejen z območno mejo. Območna meja označuje geografsko območje, ki ga zajema prostorski načrt. Več informacij je na voljo na https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan regulations/grand designations/Ta nabor podatkov prikazuje načrte (podrobne načrte, mestne načrte, gradbene načrte, glavni načrt, delitve parcel, nepremičninske načrte, spremembe podrobnega načrta in načrte rušenja) v mestu Stockholm, ki so pridobili pravno veljavo, in za območja, na katerih poteka delo v zvezi s podrobnimi načrti. Na vsakem območju je navedena registrska številka načrta (npr. 7538 ali P2012-13546). Dokumenti za načrtovanje so na voljo v službi za gradnjo in načrtovanje, do njih pa lahko dostopate prek registracijske številke. Stran za iskanje trenutnih načrtov: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for ongoing planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"},{"@language":"sv","@value":"En detaljplan reglerar bebyggelsen inom ett visst område eller fastighet. Den anger bland annat var hus får placeras, hur höga de får vara och vad de får användas till. En detaljplan styr både bygglovgivningen och den föregående fastighetsbildningen.Varje detaljplan avgränsas av en planområdesgräns. Planområdesgränsen anger vilket geografiskt område detaljplanen omfattar. Läs mer under https://www.boverket.se/sv/PBL-kunskapsbanken/planering/detaljplan/planbestammelser/gransbeteckningar/Denna datamängd visar planer (detaljplaner, stadsplaner, byggnadsplaner, generalplan, tomtindelningar, fastighetsplaner, ändring av detaljplan och avstyckningsplaner) i Stockholms stad som har vunnit laga kraft samt för områden där ett detaljplanearbete pågår. I varje yta står det planens diarienummer (t ex 7538 eller P2012-13546). Planhandlingar finns i Bygg- och plantjänsten och går att slå upp via diarienumret. Söksida för gällande planer: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Söksida för pågående planarbeten: http://insynsbk.stockholm.se/Byggochplantjansten/Pagaende-planarbete/PagaendePlanarbete/"},{"@language":"uk-t-sv-t0-mtec","@value":"Детальний план забудови регламентує забудову в межах певної території або об'єкта нерухомості. Він вказує, серед іншого, де будинки можуть бути розміщені, наскільки високо вони можуть бути і для чого вони можуть бути використані. План зонування регулює як дозвіл на планування, так і попереднє формування власності. Зональна межа позначає географічну територію, охоплену планом зонування. Детальніше читайте на https://www.boverket.se/en/PBL-knowledgebanken/planning/detailed plan/plan Regulation/grand позначення/Цей набір даних показує плани (детальні плани, міські плани, плани забудови, генеральний план, ділянки підрозділів, плани нерухомості, зміни до детального плану та плани знесення) у місті Стокгольм, які набули юридичної сили, та для районів, де тривають детальні планові роботи. У кожній області вказано реєстраційний номер плану (наприклад, 7538 або P2012-13546). Документи з планування можна знайти в Службі будівництва та планування, а доступ до них можна отримати за реєстраційним номером. Сторінка пошуку поточних планів: http://insynsbk.stockholm.se/Byggochplantjansten/GallandePlan/Search page for current planning work: http://insynsbk.stockholm.se/Byggochplantjansten/Pågående-planarbete/PagaendePlanarbete/"}],"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"7de38d37-6583-4b1b-9b1f-a4a0dd797c1d","dct:issued":{"@type":"xsd:date","@value":"2019-05-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:modified":{"@type":"xsd:date","@value":"2022-10-26"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:c9ce8bb245b029c97b59e70c47cde3e343dad0363998568b0bb1ea27dc24cb65_b0n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Детайлни планове на SBK и др. - граници на зониране за съществуващи планове и текуща работа по зониране (вътрешен SBK)"},{"@language":"cs-t-sv-t0-mtec","@value":"SBK Detailní plány apod. - územní hranice pro stávající plány a probíhající územní práce (vnitřní SBK)"},{"@language":"da-t-sv-t0-mtec","@value":"SBK Detailplaner m.v. - zoneinddelingsgrænser for eksisterende planer og igangværende zoneinddelingsarbejde (intern SBK)"},{"@language":"de-t-sv-t0-mtec","@value":"SBK Detailpläne etc. - Zonierungsgrenzen für bestehende Pläne und laufende Zonierungsarbeiten (interne SBK)"},{"@language":"el-t-sv-t0-mtec","@value":"SBK Λεπτομερή σχέδια κ.λπ. - όρια ζωνών για υφιστάμενα σχέδια και εν εξελίξει εργασίες χωροθέτησης σε ζώνες (εσωτερική SBK)"},{"@language":"en-t-sv-t0-mtec","@value":"SBK Detail plans, etc. - zoning boundaries for existing plans and ongoing zoning work (internal SBK)"},{"@language":"es-t-sv-t0-mtec","@value":"Planes de detalle de SBK, etc. - límites de zonificación para los planes existentes y el trabajo de zonificación en curso (SBK interno)"},{"@language":"et-t-sv-t0-mtec","@value":"SBK Detail plaanid jne - tsoneerimispiirid olemasolevate plaanide ja käimasolevate tsoneerimistööde jaoks (sisemine SBK)"},{"@language":"fi-t-sv-t0-mtec","@value":"SBK Yksityiskohtaiset suunnitelmat jne. - olemassa olevien suunnitelmien ja käynnissä olevien kaavoitustöiden kaavoitusrajat (sisäinen SBK)"},{"@language":"fr-t-sv-t0-mtec","@value":"SBK Plans détaillés, etc. - limites de zonage pour les plans existants et les travaux de zonage en cours (SBK interne)"},{"@language":"ga-t-sv-t0-mtec","@value":"Pleananna Sonraí SBK, etc. - teorainneacha criosaithe do phleananna atá ann cheana agus obair chriosaithe leanúnach (SBK inmheánach)"},{"@language":"hr-t-sv-t0-mtec","@value":"SBK Detaljni planovi itd. - zoniranje granica za postojeće planove i tekući rad na zoniranju (unutarnji SBK)"},{"@language":"hu-t-sv-t0-mtec","@value":"SBK Részlettervek stb. - a meglévő tervek és a folyamatban lévő övezeti munkák övezeti határai (belső SBK)"},{"@language":"it-t-sv-t0-mtec","@value":"Piani di dettaglio SBK, ecc. - Confini di zonizzazione per i piani esistenti e lavori di zonizzazione in corso (SBK interno)"},{"@language":"lt-t-sv-t0-mtec","@value":"SBK Detalieji planai ir kt. - esamų planų ir vykdomų zonų nustatymo darbų ribos (vidinis SBK)"},{"@language":"lv-t-sv-t0-mtec","@value":"SBK Detalizēti plāni u.c. - zonējuma robežas esošajiem plāniem un notiekošajiem zonējuma darbiem (iekšējais SBK)"},{"@language":"mt-t-sv-t0-mtec","@value":"Pjanijiet dettaljati tal-SBK, eċċ. Il-konfini tat-tqassim f'żoni tal-- għall-pjanijiet eżistenti u x-xogħol ta' tqassim f'żoni li għaddej bħalissa (SBK intern)"},{"@language":"nl-t-sv-t0-mtec","@value":"SBK Detailplannen, enz. - bestemmingsgrenzen voor bestaande plannen en lopende bestemmingsplannen (interne SBK)"},{"@language":"pl-t-sv-t0-mtec","@value":"SBK Plany szczegółowe itp. - granice strefowe dla istniejących planów i trwających prac strefowych (wewnętrzny SBK)"},{"@language":"pt-t-sv-t0-mtec","@value":"Planos detalhados de SBK, etc. - limites de zoneamento para os planos existentes e trabalhos de zoneamento em andamento (SBK interno)"},{"@language":"ro-t-sv-t0-mtec","@value":"SBK Planuri detaliate etc. - limite de zonare pentru planurile existente și lucrări de zonare în curs de desfășurare (SBK intern)"},{"@language":"sk-t-sv-t0-mtec","@value":"SBK Detailné plány atď. - zonačné hranice pre existujúce plány a prebiehajúce zonačné práce (vnútorné SBK)"},{"@language":"sl-t-sv-t0-mtec","@value":"SBK Podrobni načrti itd. - prostorske meje za obstoječe načrte in tekoča prostorska dela (notranji SBK)"},{"@language":"sv","@value":"SBK Detaljplaner mm - planområdesgränser för gällande planer och pågående detaljplanearbeten (internt SBK)"},{"@language":"uk-t-sv-t0-mtec","@value":"СБК Детальні плани і т.д. - зонування меж існуючих планів і поточні роботи по зонуванню (внутрішній СБК)"}],"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/39536bf7-8129-49ab-88e6-f30aa0429867","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_PLANOVERSIKT?layers=PL_Planer"},"dct:format":"application/vnd.ogc.wms_xml","dct:identifier":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:OGC:WMS/2","dct:title":["WMS-tjänst Detaljplaner (planområdesgränser för gällande planer och pågående planarbeten)",{"@language":"bg-t-sv-t0-mtec","@value":"Подробни планове (планиране на границите на района за текущите планове и текущата работа по планирането)"},{"@language":"cs-t-sv-t0-mtec","@value":"Podrobné plány (ohraničení území pro aktuální plány a probíhající plánovací práce)"},{"@language":"da-t-sv-t0-mtec","@value":"WMS-tjeneste Detaljerede planer (planområdegrænser for aktuelle planer og igangværende planlægningsarbejde)"},{"@language":"de-t-sv-t0-mtec","@value":"WMS-Service Detaillierte Pläne (Planflächengrenzen für aktuelle Pläne und laufende Planungsarbeiten)"},{"@language":"el-t-sv-t0-mtec","@value":"Υπηρεσία WMS Λεπτομερή σχέδια (όρια περιοχής σχεδίου για τα τρέχοντα σχέδια και τις τρέχουσες εργασίες σχεδιασμού)"},{"@language":"en-t-sv-t0-mtec","@value":"WMS service Detailed plans (plan area boundaries for current plans and ongoing planning work)"},{"@language":"es-t-sv-t0-mtec","@value":"Planes detallados (límites del área del plan para los planes actuales y el trabajo de planificación en curso)"},{"@language":"et-t-sv-t0-mtec","@value":"WMS teenus Detailplaneeringud (planeeri piirkonna piirid praegustele plaanidele ja käimasolevatele planeerimistöödele)"},{"@language":"fi-t-sv-t0-mtec","@value":"WMS-palvelu Yksityiskohtaiset suunnitelmat (suunnittelualueen rajat nykyisille suunnitelmille ja meneillään olevalle suunnittelutyölle)"},{"@language":"fr-t-sv-t0-mtec","@value":"Plan détaillé (limites des zones de planification pour les plans actuels et les travaux de planification en cours)"},{"@language":"ga-t-sv-t0-mtec","@value":"Seirbhís WMS Pleananna mionsonraithe (teorainneacha limistéir phleanála do phleananna reatha agus obair phleanála leanúnach)"},{"@language":"hr-t-sv-t0-mtec","@value":"Detaljni planovi (granice područja plana za postojeće planove i tekući planski rad)"},{"@language":"hu-t-sv-t0-mtec","@value":"WMS szolgáltatás Részletes tervek (a jelenlegi tervek és a folyamatban lévő tervezési munkák területhatárai)"},{"@language":"it-t-sv-t0-mtec","@value":"Piani dettagliati (pianificare i confini dell'area per i piani attuali e i lavori di pianificazione in corso)"},{"@language":"lt-t-sv-t0-mtec","@value":"WMS paslauga Detalūs planai (plano teritorijos ribos dabartiniams planams ir vykdomi planavimo darbai)"},{"@language":"lv-t-sv-t0-mtec","@value":"WMS pakalpojums Detalizēti plāni (plāna teritorijas robežas pašreizējiem plāniem un notiekošajam plānošanas darbam)"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz tad-WMS Pjanijiet dettaljati (limiti taż-żona tal-pjan għall-pjanijiet attwali u xogħol ta’ ppjanar kontinwu)"},{"@language":"nl-t-sv-t0-mtec","@value":"WMS-service Gedetailleerde plannen (gebiedsgrenzen plannen voor huidige plannen en lopende planningswerkzaamheden)"},{"@language":"pl-t-sv-t0-mtec","@value":"Usługa WMS Szczegółowe plany (planuj granice obszaru dla bieżących planów i trwających prac planistycznych)"},{"@language":"pt-t-sv-t0-mtec","@value":"Planos detalhados do serviço WMS (limites da área do plano para os planos actuais e o trabalho de planeamento em curso)"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul WMS Planuri detaliate (planificarea limitelor zonelor pentru planurile curente și lucrările de planificare în curs)"},{"@language":"sk-t-sv-t0-mtec","@value":"Služba WMS Podrobné plány (hranice oblastí plánu pre súčasné plány a prebiehajúce plánovacie práce)"},{"@language":"sl-t-sv-t0-mtec","@value":"Storitev WMS Podrobni načrti (načrt meje območja za trenutne načrte in tekoče načrtovanje dela)"},{"@language":"uk-t-sv-t0-mtec","@value":"Послуга WMS Детальні плани (межі планової площі для поточних планів та поточних планових робіт)"}],"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/39536bf7-8129-49ab-88e6-f30aa0429867"}},{"@id":"http://data.europa.eu/88u/distribution/e7bb08a9-b9cf-45e5-80fd-2c2c7d0209cc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:identifier":"https://resources.stockholm.se/data/7de38d37-6583-4b1b-9b1f-a4a0dd797c1d#HTTP:Information/1","dct:title":["Beställ kartor och geodata",{"@language":"bg-t-sv-t0-mtec","@value":"Карти на поръчките и геоданни"},{"@language":"cs-t-sv-t0-mtec","@value":"Objednat mapy a geodata"},{"@language":"da-t-sv-t0-mtec","@value":"Bestil kort og geodata"},{"@language":"de-t-sv-t0-mtec","@value":"Karten und Geodaten bestellen"},{"@language":"el-t-sv-t0-mtec","@value":"Παραγγελία χαρτών και γεωδεδομένων"},{"@language":"en-t-sv-t0-mtec","@value":"Order maps and geodata"},{"@language":"es-t-sv-t0-mtec","@value":"Mapas de pedidos y geodatos"},{"@language":"et-t-sv-t0-mtec","@value":"Telli kaardid ja geoandmed"},{"@language":"fi-t-sv-t0-mtec","@value":"Tilaa karttoja ja paikkatietoja"},{"@language":"fr-t-sv-t0-mtec","@value":"Commander des cartes et des géodonnées"},{"@language":"ga-t-sv-t0-mtec","@value":"Léarscáileanna ordaithe agus geoshonraí"},{"@language":"hr-t-sv-t0-mtec","@value":"Karte narudžbi i geopodaci"},{"@language":"hu-t-sv-t0-mtec","@value":"Térképek és geodaták rendelése"},{"@language":"it-t-sv-t0-mtec","@value":"Ordina mappe e geodati"},{"@language":"lt-t-sv-t0-mtec","@value":"Užsakymo žemėlapiai ir geoduomenys"},{"@language":"lv-t-sv-t0-mtec","@value":"Pasūtījumu kartes un ģeodati"},{"@language":"mt-t-sv-t0-mtec","@value":"Mapep tal-ordnijiet u ġeodata"},{"@language":"nl-t-sv-t0-mtec","@value":"Kaarten en geodata bestellen"},{"@language":"pl-t-sv-t0-mtec","@value":"Zamów mapy i geodane"},{"@language":"pt-t-sv-t0-mtec","@value":"Encomendar mapas e dados geográficos"},{"@language":"ro-t-sv-t0-mtec","@value":"Comandă hărți și geodate"},{"@language":"sk-t-sv-t0-mtec","@value":"Objednať mapy a geoúdaje"},{"@language":"sl-t-sv-t0-mtec","@value":"Zemljevidi naročil in geopodatki"},{"@language":"uk-t-sv-t0-mtec","@value":"Замовити ка