e5b9d6fb65701d284b"},{"@id":"_:f913876e095f705331b8c38605fdbcafa8be0d2bab8b0e8012d46ea1227a9c5e_b2n0","dct:identifier":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:Information/1","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/e5bb5978-c441-401f-aeac-8e58461649b1"}},{"@id":"_:f913876e095f705331b8c38605fdbcafa8be0d2bab8b0e8012d46ea1227a9c5e_b3n0","dct:identifier":"https://resources.stockholm.se/data/c697ef48-613a-4a48-a554-a46633977896#HTTP:OGC:WMS/2","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/cb8a3133-957f-47cc-94e2-0b9b8cd1c4fb"}},{"@id":"http://data.europa.eu/88u/dataset/c697ef48-613a-4a48-a554-a46633977896","@type":["dcat:Dataset","dcat:dataset"],"dcat:contactPoint":{"@id":"https://resources.stockholm.se/metadata#vcard/Stadsbyggnadskontoret+-+Stadsm%C3%A4tningsavdelningen+-+Geodatadistributionsenheten/"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/cb8a3133-957f-47cc-94e2-0b9b8cd1c4fb"},{"@id":"http://data.europa.eu/88u/distribution/e5bb5978-c441-401f-aeac-8e58461649b1"}],"dcat:keyword":[{"@language":"sv","@value":"Extern dataportal"},{"@language":"sv","@value":"Förenklade metadata"},{"@language":"sv","@value":"Stockholms stad"}],"dcat:landingPage":{"@id":"https://dataportalen.stockholm.se/dataportalen/GetMetaDataById?id=2e0a1e12-0d10-45af-9cb0-9ae6cc095c66"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/crs/EPSG/0/3011"},"dct:created":{"@type":"xsd:date","@value":"2025-07-01"},"dct:description":{"@language":"sv","@value":"Ortofoto sant I ett sant ortofoto är även byggnader skalriktiga vilket gör att de återges med sitt rätta läge utan sidoförskjutning i bilden. Ett sant ortofoto ställer högre krav på övertäckning mellan bilder vid flygfotografering. För att få insyn från alla sidor av byggnaden, bör man fotografera med 60% övertäckning i både längdled och sidled. Där det finns trånga gator och höga byggnader bör man räkna med ännu större övertäckning. Terrängmodell och 3D-modellerade byggnader i vektorformat används för rektifiering av flygbilderna. Flyghöjd: ca 1900 meter över marken. Upplösning: 8 cm på marken per pixel. Övertäckning %: 60/60 Fotograferingsdatum: 20 och 31 maj, 15 juni och 1 juli 2025. Referenssytem i plan: Sweref 991800, i höjd: RH2000\""},"dct:format":["application/vnd.ogc.wms_xml","text/html"],"dct:identifier":"c697ef48-613a-4a48-a554-a46633977896","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:f913876e095f705331b8c38605fdbcafa8be0d2bab8b0e8012d46ea1227a9c5e_b0n0"},"dct:title":{"@language":"sv","@value":"SBK Ortofoto - sant (2023)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"http://data.europa.eu/88u/distribution/cb8a3133-957f-47cc-94e2-0b9b8cd1c4fb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://kartor.stockholm.se/bios/wms/app/baggis/web/WMS_STHLM_ORTOFOTO_2023"},"dct:format":"application/vnd.ogc.wms_xml","dct:title":"Ortofoto 2023"},{"@id":"http://data.europa.eu/88u/distribution/e5bb5978-c441-401f-aeac-8e58461649b1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kartor.stockholm/kartor-geodata/"},"dct:format":"text/html","dct:title":"Beställ kartor och geodata"},{"@id":"http://data.europa.eu/88u/record/c697ef48-613a-4a48-a554-a46633977896","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:f913876e095f705331b8c38605fdbcafa8be0d2bab8b0e8012d46ea1227a9c5e_b2n0"},{"@id":"_:f913876e095f705331b8c38605fdbcaf