nde för människor, djur och växters överlevnad."},"dct:identifier":"b899f057-8d17-4018-96eb-3de4e5de93f2","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000142"},"dct:spatial":{"@id":"_:490c2fddc6324489fe0ff69374ee8b0063168601126f641e0d16fb3ac03ad327_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatordata Natur - MiljödataStockholm"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"}},{"@id":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2#HTTP:ESRI+Portal-URL/2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open-data-sthlm-miljo.hub.arcgis.com/maps/648e41e4935744768ded37bb3d8f072e/about"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"Miljöförvaltningens öppna data-hub"},{"@id":"https://resources.stockholm.se/data/b899f057-8d17-4018-96eb-3de4e5de93f2#HTTP:Information/1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.miljodatastockholm.se/natur/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":"MiljödataStockholm"},{"@id":"https://resources.stockholm.se/metadata#vcard/Stockholms+stad+-+Milj%C3%B6f%C3%B6rvaltningen/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Stockholms stad - Miljöförvaltningen"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mgis@stockholm.se"}}],"@id":"urn:source:490c2fddc6324489fe0ff69374ee8b0063168601126f641e0d16fb3ac03ad327"},{"@graph":[{"@id":"_:4928902eacbd5f642ac143b4f6526ad3cd3826dd55cfb72478cfc93739fc3f3d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.7605 59.4402,