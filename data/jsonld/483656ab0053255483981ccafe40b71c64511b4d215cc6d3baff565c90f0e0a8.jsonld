cription":{"@language":"en","@value":"\"Campylobacter surveillance in Sweden is carried out in humans by the Public Health Agency of Sweden (Folkhälsomyndigheten - FoHM), in slaughterhouses executed by Svensk Fågel, and analysed by the Swedish Veterinary Agency (Statens veterinärmedicinska Anstalt - SVA), and in retailers by the Swedish Food Agency (Livsmedelsverket - SLV). Results are consolidated yearly by SVA, and published in the Surveillance of infectious diseases in animals and humans in Sweden (see related resources). This dataset is updated annualy with the number published in that report.\""},"dct:issued":{"@type":"xsd:date","@value":"2019-09-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":{"@id":"https://old.sva.se/en/reports-and-publications-in-english/disease-surveillance/disease-surveillance-reports"},"dct:title":{"@language":"en","@value":"Campylobacter surveillance in Sweden"}},{"@id":"https://data.sva.se/dcat/surveillancereport/campylobacter_surveillance_swedenCSV.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.sva.se/opendata/surveillance/campy/campylobacter_surveillance_sweden.csv"},"dct:description":{"@language":"en","@value":"Numbers from the campylobacter surveillance in Sweden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"CSV"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://data.sva.se/dcat/surveillancereport/campylobacter_surveillance_swedenRDF.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.sva.se/opendata/surveillance/campy/campylobacter_surveillance_sweden.rdf"},"dct:description":{"@language":"en","@value":"Numbers from the campylobacter surveillance in Sweden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"RDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}}],"@id":"urn:source:f0bf4ad291252eb3def9172167cb619ef6a9c4019bf67784bea39ec5ff2f1137"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2023.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2023_PDF.rdf"},"dcat:keyword":[{"@language":"en","@value":"beaked whale"},{"@language":"en","@value":"disease"},{"@language":"en","@value":"harbour porpoise"},{"@language":"en","@value":"health"},{"@language":"en","@value":"marine mammal"},{"@language":"en","@value":"mortality"},{"@language":"en","@value":"seal"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"dödsorsaker"},{"@language":"sv","@value":"hälsostatus"},{"@language":"sv","@value":"marina däggdjur"},{"@language":"sv","@value":"näbbval"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"säl"},{"@language":"sv","@value":"tumlare"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the health- and disease surveillance program for marine mammals 2023 set up by the Swedish Veterinary Agency (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History (NRM)."},{"@language":"sv","@value":"Resultat från hälso- och sjukdomsövervakningsprogram för marina däggdjur 2023 som Statens veterinärmedicinska anstalt (SVA) utfört på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats på SVA 2023. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet (NRM)."}],"dct:issued":{"@type":"xsd:date","@value":"2024-03-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_2060"},{"@id":"https://www.dataportal.se/en/datasets/59_2061"}],"dct:title":[{"@language":"en","@value":"Health, diseases and causes of death in marine mammals in Sweden, 2023: Results from post-mortem investigations of marine mammals conducted at the Swedish Veterinary Agency (SVA) "},{"@language":"sv","@value":"Hälsa, sjukdomar och dödsorsaker hos marina däggdjur 2023: Resultat från obduktion och provtagning av marina däggdjur som undersökts på SVA"}]},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2023_PDF.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sva.se/vi-erbjuder/publikationer/rapport-haelsa%252c-sjukdomar-och-doedsorsaker-hos-marina-daeggdjur-2023/c-28/c-83/p-1631"},"dcat:downloadURL":{"@id":"https://sva13.euwest01.umbraco.io/media/fdbnxy1t/sva-rapport-95-marina-daeggdjur-aarsrapport-2023.pdf"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the health- and disease surveillance program for marine mammals 2023 set up by the Swedish Veterinary Agency (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History (NRM).  "},{"@language":"sv","@value":"Resultat från hälso- och sjukdomsövervakningsprogram för marina däggdjur 2023 som Statens veterinärmedicinska anstalt (SVA) utfört på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats på SVA 2023. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet (NRM)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:f72341699e5bf12ec17e8714698c0d0e387308f394dbb249c1e283e6431bd1dd"}]}
