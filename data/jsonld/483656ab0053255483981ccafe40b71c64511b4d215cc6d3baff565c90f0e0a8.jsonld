"dct:title":{"@language":"sv","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:a1c74be523d9be67e457938a77282f9430eff72a5a8baed2b3fc8758be245f05"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2020.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2020_PDF.rdf"},"dcat:keyword":[{"@language":"en","@value":"beaked whale"},{"@language":"en","@value":"disease"},{"@language":"en","@value":"harbour porpoise"},{"@language":"en","@value":"health"},{"@language":"en","@value":"marine mammal"},{"@language":"en","@value":"mortality"},{"@language":"en","@value":"seal"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"dödsorsaker"},{"@language":"sv","@value":"hälsostatus"},{"@language":"sv","@value":"marina däggdjur"},{"@language":"sv","@value":"näbbval"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"säl"},{"@language":"sv","@value":"tumlare"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the first year of the health- and disease surveillance program for marine mammals set up by the Swedish Veterinary Agency (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History. "},{"@language":"sv","@value":"Resultat från första året av hälso- och sjukdomsövervakningsprogram för marina däggdjur som SVA utförde på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats av SVA 2020. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet."}],"dct:issued":{"@type":"xsd:date","@value":"2021-03-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_2060"},{"@id":"https://www.dataportal.se/en/datasets/59_2061"}],"dct:title":[{"@language":"en","@value":"Health, diseases and causes of death in marine mammals in Sweden, 2020: Results from post-mortem investigations of marine mammals conducted at the Swedish Veterinary Agency (SVA)"},{"@language":"sv","@value":"Hälsa, sjukdomar och dödsorsaker hos marina däggdjur 2020: Resultat från obduktion och provtagning av marina däggdjur som undersökts på SVA"}]},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2020_PDF.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sva.se/vi-erbjuder/publikationer/rapport-haelsa%252c-sjukdomar-och-doedsorsaker-hos-marina-daeggdjur-i-sverige-under-2020/c-28/c-83/p-1346"},"dcat:downloadURL":{"@id":"https://sva13.euwest01.umbraco.io/media/lrib1j3m/sva-rapport-61-haelsa-sjukdomar-och-doedsorsaker-hos-marina-daeggdjur-2020.pdf"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the first year of the health- and disease surveillance program for marine mammals set up by the Swedish Veterinary Agency (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History."},{"@language":"sv","@value":"Resultat från första året av hälso- och sjukdomsövervakningsprogram för marina däggdjur som SVA utförde på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats av SVA 2020. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:a3ea6c4ff8c6f128e895daad91b5eb33ad8f3d9025ee67d425b02dbcc4b2f4cd"},{"@graph":[{"@id":"https://data.sva.se/dcat/main/svaCat.rdf","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://data.sva.se/dcat/surveillancereport/campylobacter_surveillance_sweden.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2006.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2007.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2008.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2009.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2010.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2011.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2012.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2013.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2014.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2015.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2016.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2017.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2018.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2019.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2020.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2021.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2022.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2023.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2024.rdf"},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2025.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_Aldata_2020-2022.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_fisk_Gyrodactylus_2020-2025.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_havslevande_blotdjur_2021-2025.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2020.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2021.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2022.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2023.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2024.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2025.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_cetaceans.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_phocids.rdf"}],"dct:description":[{"@language":"en","@value":"The Swedish Veterinary Agency, SVA, is a Swedish national authority that strives for good animal and human health, a good environment and sustainable food production. Good Animal Health Promotes Public Health."},{"@language":"sv","@value":"Statens veterinärmedicinska anstalt, SVA, är en expertmyndighet med beredskapsuppdrag. SVA främjar djurs och människors hälsa, svensk djurhållning och vår miljö genom diagnostik, forskning, beredskap och rådgivning. Myndigheten ligger under Näringsdepartementet."}],"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:title":[{"@language":"en","@value":"Swedish Veterinary Agency"},{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"}]}],"@id":"urn:source:c0036c8fd14fe360c1ff6d4a36f67d337d4d8006e1f4e2849050c4d6db9b7b1d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_cetaceans.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":[{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_cetaceans_CSV.rdf"},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_cetaceans_XLSX.rdf"}],"dcat:keyword":[{"@language":"en","@value":"beaked whale"},{"@language":"en","@value":"disease"},{"@language":"en","@value":"harbour porpoise"},{"@language":"en","@value":"health"},{"@language":"en","@value":"marine mammal"},{"@language":"en","@value":"mortality"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"dödsorsaker"},{"@language":"sv","@value":"hälsostatus"},{"@language":"sv","@value":"marina däggdjur"},{"@language":"sv","@value":"näbbval"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"tumlare"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"Health status, diseases and cause of stranding or death of cetaceans examined at SVA from 2020-2025. Cetaceans were examined together with the Swedish Museum of Natural History (NRM). These data support the annual reports from the health- and disease surveillance program for marine mammals set up by the Swedish Veterinary Agency (SVA) under the directive of the Swedish Agency for Marine and Water Management. Please see RELATED RESOURCES for a link to the full report. Phocid data is provided in their own data file, also available in the related resources."},{"@language":"sv","@value":"Hälsostatus, sjukdomar och dödsorsaker hos valdjur som har obducerats av SVA från 2020-2025. Datan underbygger de resultat som presenteras i årsrapporterna från hälso- och sjukdomsövervakningsprogrammet för marina däggdjur som SVA utför på uppdrag av Havs- och vattenmyndigheten. Se RELATERADE KÄLLOR för länk till rapporten. Data från sälar som presenteras i rapporten finns tillgänglig i separat datafil."}],"dct:issued":{"@type":"xsd:date","@value":"2021-03-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_2061"},{"@id":"https://www.sva.se/media/bqdhsryi/