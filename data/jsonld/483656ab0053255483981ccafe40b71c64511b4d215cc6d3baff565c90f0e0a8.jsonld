ance mandates along the entire food chain, from farm to fork."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:366177f02c5e099f44b479df9b42ee262da82ee45cafaca3d792a515eb4afe20"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2024.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2024_PDF.rdf"},"dcat:keyword":[{"@language":"en","@value":"beaked whale"},{"@language":"en","@value":"disease"},{"@language":"en","@value":"harbour porpoise"},{"@language":"en","@value":"health"},{"@language":"en","@value":"marine mammal"},{"@language":"en","@value":"mortality"},{"@language":"en","@value":"seal"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"dödsorsaker"},{"@language":"sv","@value":"hälsostatus"},{"@language":"sv","@value":"marina däggdjur"},{"@language":"sv","@value":"näbbval"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"säl"},{"@language":"sv","@value":"tumlare"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the health- and disease surveillance program for marine mammals 2024 set up by the National Veterinary Institute (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History (NRM)."},{"@language":"sv","@value":"Resultat från hälso- och sjukdomsövervakningsprogram för marina däggdjur 2024 som Statens veterinärmedicinska anstalt (SVA) utfört på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats på SVA 2024. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet (NRM)."}],"dct:issued":{"@type":"xsd:date","@value":"2025-04-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_2060"},{"@id":"https://www.dataportal.se/en/datasets/59_2061"}],"dct:title":[{"@language":"en","@value":"Health, diseases and causes of death in marine mammals in Sweden, 2024: Results from post-mortem investigations of marine mammals conducted at the National Veterinary Institute (SVA) "},{"@language":"sv","@value":"Hälsa, sjukdomar och dödsorsaker hos marina däggdjur 2024: Resultat från obduktion och provtagning av marina däggdjur som undersökts på SVA"}]},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_marina_daggdjur_2024_PDF.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sva.se/djurhaelsa/djurslag-a-oe/vilda-djur/marina-daeggdjur/"},"dcat:downloadURL":{"@id":"https://www.sva.se/media/bqdhsryi/svakom248-marina-daeggdjur-2024.pdf"},"dct:description":[{"@language":"en","@value":"This report summarizes findings from the health- and disease surveillance program for marine mammals 2024 set up by the National Veterinary Institute (SVA) under the directive of the Swedish Agency for Marine and Water Management. It describes health status, diseases and cause of stranding or death of cetaceans and phocids examined at SVA. Cetceans were examined together with the Swedish Museum of Natural History (NRM).  "},{"@language":"sv","@value":"Resultat från hälso- och sjukdomsövervakningsprogram för marina däggdjur 2024 som Statens veterinärmedicinska anstalt (SVA) utfört på uppdrag av Havs- och vattenmyndigheten presenteras i rapporten. Här beskrivs hälsostatus, sjukdomar och dödsorsaker hos sälar och valdjur som har obducerats på SVA 2024. Valdjuren undersöktes gemensamt med Naturhistoriska riksmuseet (NRM)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:3c407a5721e9c5ca7ecf8fe6989f22a15ceb1cf59651e15dbe02b3ab2b015b0e"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/