{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_havslevande_blotdjur_2021-2025.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/sva_hav/SVA_havslevande_blotdjur_2021-2025_XLSX.rdf"},"dcat:keyword":[{"@language":"en","@value":"Blue mussel/Mytilus edulis"},{"@language":"en","@value":"Bonamia exitiosa"},{"@language":"en","@value":"Bonamia ostreae"},{"@language":"en","@value":"Disease"},{"@language":"en","@value":"European oyster/Ostrea edulis"},{"@language":"en","@value":"Kattegatt"},{"@language":"en","@value":"Marteilia pararefringens"},{"@language":"en","@value":"Marteilia refringens"},{"@language":"en","@value":"Mikrocytos mackini"},{"@language":"en","@value":"Perkinsus marinus"},{"@language":"en","@value":"Skagerack"},{"@language":"en","@value":"Surveillance"},{"@language":"en","@value":"Swedish Veterinary Agency"},{"@language":"en","@value":"health"},{"@language":"en","@value":"parasite"},{"@language":"sv","@value":"Blåmussla/Mytilus edulis"},{"@language":"sv","@value":"Bonamia exitiosa"},{"@language":"sv","@value":"Bonamia ostreae"},{"@language":"sv","@value":"Europeiskt ostron/Ostrea edulis"},{"@language":"sv","@value":"Hälsa"},{"@language":"sv","@value":"Kattegat"},{"@language":"sv","@value":"Marteilia pararefringens"},{"@language":"sv","@value":"Marteilia refringens"},{"@language":"sv","@value":"Mikrocytos mackini"},{"@language":"sv","@value":"Parasit"},{"@language":"sv","@value":"Perkinsus marinus"},{"@language":"sv","@value":"Sjukdom"},{"@language":"sv","@value":"Skagerrak"},{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},{"@language":"sv","@value":"Övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"Övervakning av parasiten Marteilia pararefringens hos blåmusslor (Mytilus edulis). Övervakning av parasiterna Marteilia refringens, Bonamia ostreae, Bonamia exitiosa, Perkinsus marinus och Mikrocytos mackini hos europeiska ostron (Ostrea edulis). Datasetet från 2025 inkluderar vilda ostron och blåmusslor från den ordinarie övervakningen samt vilda ostron som provtagits inom smittspårning av Bonamia ostreae efter att parasiten för första gången påvisats i svenska vatten."},{"@language":"sv","@value":"Övervakning av parasiten Marteilia pararefringens hos blåmusslor (Mytilus edulis). Övervakning av parasiterna Marteilia refringens, Bonamia ostreae, Bonamia exitiosa, Perkinsus marinus och Mikrocytos mackini hos europeiska ostron (Ostrea edulis). Datasetet från 2025 inkluderar vilda ostron och blåmusslor från den ordinarie övervakningen samt vilda ostron som provtagits inom smittspårning av Bonamia ostreae efter att parasiten för första gången påvisats i svenska vatten."}],"dct:issued":{"@type":"xsd:date","@value":"2024-04-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/a