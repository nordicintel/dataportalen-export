ood chain, from farm to fork."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:d8307ca603498ab6e44b54eddf9bbc74653166b59f8877290824f3b3db36fb3a"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2023pdf.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sva.se/djurhaelsa/smittlaege/smittlaegesrapporter/"},"dcat:downloadURL":{"@id":"https://www.sva.se/media/3xjbzi4a/smittlaget_2023_webb_v20250410.pdf"},"dct:description":{"@language":"sv","@value":"Sedan 2009 har Statens veterinärmedicinska anstalt (SVA) publicerat en årlig rapport som beskriver smittläget i Sverige för djursjukdomar och zoonoser baserat på resultat från den sjukdomsövervakning som genomfördes i landet under föregående år. Årets rapport är den 15:e i ordningen, och den första som ges ut på svenska. Rapporten omfattar övervakning av viktiga djursjukdomar och zoonotiska smittämnen hos djur, människor, livsmedel och foder och är skriven och sammanställd av experter från SVA, Folkhälsomyndigheten, Livsmedelsverket, SLU, Jordbruksverket samt djurhälsoorganisationerna Växa och Gård & Djurhälsan, det vill säga de aktörer som har en roll i svensk sjukdomsövervakning längs hela livsmedelskedjan - från jord till bord."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2024.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/surveillancereport/sr2023pdf.rdf"},"dcat:keyword":[{"@language":"en","@value":"disease"},{"@language":"en","@value":"surveillance"},{"@language":"en","@value":"zoonoses"},{"@language":"sv","@value":"djursjukdomar"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"smittläge"},{"@language":"sv","@value":"zoonoser"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sedan 2009 har Statens veterinärmedicinska anstalt (SVA) publicerat en årlig rapport som beskriver smittläget i Sverige för djursjukdomar och zoonoser baserat på resultat från den sjukdomsövervakning som genomfördes i landet under föregående år. Årets rapport är den 16:e i ordningen. Rapporten omfattar övervakning av viktiga djursjukdomar och zoonotiska smittämnen hos djur, människor, livsmedel och foder och är skriven och sammanställd av experter från SVA, Folkhälsomyndigheten, Livsmedelsverket, SLU, Jordbruksverket samt djurhälsoorganisationerna Växa och Gård & Djurhälsan, det vill säga de aktörer som har en roll i svensk sjukdomsövervakning längs hela livsmedelskedjan - från jord till bord."},"dct:issued":{"@type":"xsd:date","@value":"2025-06-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_1684/campylobacter-surveillance-in-sweden"},{"@id":"https://www.sva.se/djurhaelsa/smittlaege/smittlaegesrapporter/"}],"dct:title":{"@language":"sv","@value":"Smittläget i Sverige för djursjukdomar och zoonoser 2024"}}],"@id":"urn:source:e032b7dd0d149b5d827b022b6fa00a130bd0c74324937d678b5d1252bce46ee8"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2023.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/surveillancereport/sr2023pdf.rdf"},"dcat:keyword":[{"@language":"en","@value":"disease"},{"@language":"en","@value":"surveillance"},{"@language":"en","@value":"zoonoses"},{"@language":"sv","@value":"djursjukdomar"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"smittläge"},{