2020-2025.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/sva_hav/SVA_fisk_Gyrodactylus_2020-2025_XLSX.rdf"},"dcat:keyword":[{"@language":"en","@value":"Atlantic salmon"},{"@language":"en","@value":"Swedish west coast rivers"},{"@language":"en","@value":"disease"},{"@language":"en","@value":"gyrodactylus salaris"},{"@language":"en","@value":"parasite"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"Atlantlax"},{"@language":"sv","@value":"Västkustvattendrag"},{"@language":"sv","@value":"gyrodactylus salaris"},{"@language":"sv","@value":"parasit"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"Filerna innehåller data avseende övervakade vattendrag och undersökta lokaler inom vattendragen, antalet provtagna laxungar samt hur många Gyrodactylus som påvisats på varje laxunge. Parasitundersökningarna görs visuellt. I vattendrag som hittills varit fria från Gyrodactylus salaris, men där fynd av Gyrodactylus görs, kompletteras undersökningen med en genetisk undersökning av parasiten. Eventuella fynd av Gyrodactylus i tidigare oinfekterade vattendrag presenteras i en egen kolumn för att särskilja dem från tidigare infekterade vattendrag, eller för att en annan art av Gyrodactylus påvisats."},{"@language":"sv","@value":"Filerna innehåller data avseende övervakade vattendrag och undersökta lokaler inom vattendragen, antalet provtagna laxungar samt hur många Gyrodactylus som påvisats på varje laxunge. Parasitundersökningarna görs visuellt. I vattendrag som hittills varit fria från Gyrodactylus salaris, men där fynd av Gyrodactylus görs, kompletteras undersökningen med en genetisk undersökning av parasiten. Eventuella fynd av Gyrodactylus i tidigare oinfekterade vattendrag presenteras i en egen kolumn för att särskilja dem från tidigare infekterade vattendrag, eller för att en annan art av Gyrodactylus påvisats."}],"dct:issued":{"@type":"xsd:date","@value":"2024-01-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:title":[{"@language":"en","@value":"Öppna data, undersökningar avseende parasiten Gyrodactylus salaris i vattendrag längs svenska västkusten, 2020-2025"},{"@language":"sv","@value":"Öppna data, undersökningar avseende parasiten Gyrodactylus salaris i vattendrag längs svenska västkusten, 2020-2025"}]},{"@id":"https://data.sva.se/dcat/sva_hav/SVA_fisk_Gyrodactylus_2020-2025_XLSX.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://data.sva.se/opendata/sva_hav/Gyro2020-2025.xlsx"},"dct:description":[{"@language":"en","@value":"Öppna data, undersökningar avseende parasiten Gyrodactylus salaris i vattendrag längs svenska västkusten, 2020-2025"},{"@language":"sv","@value":"Öppna data, undersökningar avseende parasiten Gyrodactylus salaris i vattendrag längs svenska västkusten, 2020-2025"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"XLSX"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:a121c77edf89650b201c350ba5a1cf0030203690c8073ddfd4080bbb23c5e25d"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statens veterinärmedicinska anstalt","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sva@sva.se"}},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2013.rdf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf"},"dcat:distribution":{"@id":"https://data.sva.se/dcat/surveillancereport/sr2013pdf.rdf"},"dcat:keyword":[{"@language":"en","@value":"disease"},{"@language":"en","@value":"surveillance"},{"@language":"sv","@value":"sjukdom"},{"@language":"sv","@value":"övervakning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"en","@value":"Surveillance of infectious diseases in animals and humans is the annual report describing the surveillance activities carried out in Sweden during the year. The report covers surveillance for important animal diseases and zoonotic agents in humans, food, feed and animals, carried out and compiled by experts from several Swedish governmental agencies, university and private industry with surveillance mandates along the entire food chain, from farm to fork."},"dct:issued":{"@type":"xsd:date","@value":"2014-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001868"},"dct:relation":[{"@id":"https://www.dataportal.se/en/datasets/59_1684/campylobacter-surveillance-in-sweden"},{"@id":"https://www.sva.se/djurhaelsa/smittlaege/smittlaegesrapporter/"}],"dct:title":{"@language":"en","@value":"Surveillance of infectious diseases in animals and humans in Sweden, 2013"}},{"@id":"https://data.sva.se/dcat/surveillancereport/sr2013pdf.rdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sva.se/djurhaelsa/smittlaege/smittlaegesrapporter/"},"dcat:downloadURL":{"@id":"https://www.sva.se/media/tmacqneb/sva-rapport-28-surveillance-2013.pdf"},"dct:description":{"@language":"en","@value":"Surveillance of infectious diseases in animals and humans is the annual report describing the surveillance activities carried out in Sweden during the year. The report covers surveillance for important animal diseases and zoonotic agents in humans, food, feed and animals, carried out and compiled by experts from several Swedish governmental agencies, university and private industry with surveillance mandates along the entire food chain, from farm to fork."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"en","@value":"PDF"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:a183e053991df26c03fe2f15596f80516694d15e542349f5c60f9c742d174897"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001868","@type":"foaf:Agent","dct:identifier":"2021001868","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:sva@sva.se"},"foaf:name":{"@language":"sv","@value":"Statens veterinärmedicinska anstalt"},"foaf:page":{"@id":"https://www.sva.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://data.sva.se/dcat/main/svaAgent.rdf"}},{"@id":"https://data.sva.se/dcat/main/svaOrg.rdf","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www