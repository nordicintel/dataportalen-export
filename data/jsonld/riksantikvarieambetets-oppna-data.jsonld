://www.w3.org/2006/vcard/ns#postal-code":"621 38","http://www.w3.org/2006/vcard/ns#street-address":"Artillerigatan 33 A"},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://catalog.raa.se/store/1/resource/186","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.raa.se/store/1/resource/32"},"dcat:distribution":[{"@id":"https://catalog.raa.se/store/1/resource/187"},{"@id":"https://catalog.raa.se/store/1/resource/188"},{"@id":"https://catalog.raa.se/store/1/resource/189"},{"@id":"https://catalog.raa.se/store/1/resource/199"},{"@id":"https://catalog.raa.se/store/1/resource/204"},{"@id":"https://catalog.raa.se/store/1/resource/207"}],"dcat:keyword":[{"@language":"sv","@value":"Byggnadsminne"},{"@language":"sv","@value":"Enskilt byggnadsminne"},{"@language":"sv","@value":"Kulturhistorisk byggnad"},{"@language":"sv","@value":"Kulturhistorisk inventering"},{"@language":"sv","@value":"Kulturmiljö"},{"@language":"sv","@value":"Kyrkligt kulturminne"},{"@language":"sv","@value":"Statligt byggnadsminne"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller information om bebyggelse som dokumenterats i kulturhistoriska inventeringar och registrerats i Riksantikvarieämbetets bebyggelseregister. Även statliga och enskilda byggnadsminnen och kyrkliga kulturminnen ingår.\n\nBebyggelseregistret har släppts i en ny version våren 2025. Under en övergångsperiod kommer vissa av de gamla geodatatjänsterna finnas tillgängliga parallellt med de nya. Anledningen är att de som är beroende av de gamla tjänsterna ska få tid på sig att ställa om. De tjänster som hämtar information från det gamla registret har fått tillägget ”OLD” i början av namnet. Uppdateringar av byggnadsminnen, statliga byggnadsminnen och kyrkliga kulturminnen kommer att göras i både de gamla och de nya tjänsterna så länge de finns tillgängliga parallellt. \n\nDen nya informationsmodellen skiljer sig en del åt från den gamla och därför är attributdata också olika. Vad tjänsterna innehåller syns i respektive produktbeskrivning."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":[{"@id":"_:ef5a4978f50719eae3694016dd9380d5a58964d1e4d1ecb2540c3d3f0f769b4d_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:title":{"@language":"sv","@value":"Bebyggelse, kulturhistoriskt inventerad"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"},"http://schema.org/diagram":{"@id":"https://catalog.raa.se/store/1/resource/192"}},{"@id":"https://catalog.raa.se/store/1/resource/187","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dcat:downloadURL":[{"@id":"https://pub.raa.se/nedladdning/datauttag/bebyggelse/kulturhistoriskt_inventerad_bebyggelse/kulturhistoriskt_inventerad_bebyggelse_%C3%B6rebro.gpkg"