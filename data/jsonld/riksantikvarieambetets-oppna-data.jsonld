gatan 33 A"},{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://catalog.raa.se/store/1/resource/193","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.raa.se/store/1/resource/32"},"dcat:distribution":[{"@id":"https://catalog.raa.se/store/1/resource/194"},{"@id":"https://catalog.raa.se/store/1/resource/195"},{"@id":"https://catalog.raa.se/store/1/resource/196"},{"@id":"https://catalog.raa.se/store/1/resource/201"},{"@id":"https://catalog.raa.se/store/1/resource/205"},{"@id":"https://catalog.raa.se/store/1/resource/206"}],"dcat:landingPage":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller skyddsområden för statliga och enskilda byggnadsminnen. Samtliga statliga byggnadsminnen ingår. Enskilda byggnadsminnen ingår endast i de fall skyddsområdesytorna kommit in till Riksantikvarieämbetet. \n\nBebyggelseregistret har släppts i en ny version våren 2025. Under en övergångsperiod kommer vissa av de gamla geodatatjänsterna finnas tillgängliga parallellt med de nya. Anledningen är att de som är beroende av de gamla tjänsterna ska få tid på sig att ställa om. De tjänster som hämtar information från det gamla registret har fått tillägget ”OLD” i början av namnet. Uppdateringar av byggnadsminnen, statliga byggnadsminnen och kyrkliga kulturminnen kommer att göras i både de gamla och de nya tjänsterna så länge de finns tillgängliga parallellt. \n\nDen nya informationsmodellen skiljer sig en del åt från den gamla och därför är attributdata också olika. Vad tjänsterna innehåller syns i respektive produktbeskrivning."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:spatial":[{"@id":"_:a89435aecd4257e409c676f9bd82014234a6547acc08045106c1f89ed4b57643_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:title":{"@language":"sv","@value":"Enskilda och statliga byggnadsminnen, skyddsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"},"http://schema.org/diagram":{"@id":"https://catalog.raa.se/store/1/resource/203"}},{"@id":"https://catalog.raa.se/store/1/resource/194","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.raa.se/hitta-information/oppna-data/oppna-data-portal/"},"dcat:downloadURL":[{"@id":"https://pub.raa.se/nedladdning/datauttag/bebyggelse/byggnadsminnen_skyddsomraden/byggnadsminnen_skyddsomraden_%C3%B6rebro.gpkg"},{"@id":"https://pub.raa.se/nedladdning/datauttag/bebyggelse/byggnadsminnen_skyddsomraden/byggnadsminnen_skyddsomraden_%C3%B6sterg%C3%B6tland.gpkg"},{"@id":"https://pub.raa.se/nedladdning/datauttag/bebyggelse/byggnadsminnen_skyddsomraden/byggnadsminnen_skyddsomraden_blekinge.gpkg"},{"@id":"https://pub.raa.se/nedladdning/datauttag/bebyggelse/byggnadsminnen_skyddsomraden/byggnadsminnen_skyddsomraden_da