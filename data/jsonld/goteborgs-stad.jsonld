/15791","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Leverantörsfaktura Juni 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/17398","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Leverantörsfaktura Juli 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/18779","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Leverantörsfaktura Augusti 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/20231","@type":"http://entryscape.com/terms/File","dct:title":{"@language":"sv","@value":"Leverantorsfaktura September 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/21773","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Leverantörsfaktura oktober 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/23164","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Leverantörsfaktura november 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/24805","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":{"@language":"sv","@value":"Leverantörsfaktura december 2021"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48807","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad intraservice"}},{"@id":"https://catalog.goteborg.se/store/6/resource/78","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Intraservice","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:intraservice@intraservice.goteborg.se"}}],"@id":"urn:source:6c0a4fadfe0898038ff58ba97257918ca445910635ecbe9c146b6954bcef42bc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/38","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:it.support@stadsmiljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/44463","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/StartPermissionService/v1.4/help"},"dct:description":{"@language":"sv","@value":"Alla metoder som returnerar flera Starttillstånd har följande querystring gemensamt:\n{APPID}?affectsbikelane={AFFECTSBIKELANE}&onlyLive={ONLYLIVE}&latitude={LATITUDE}&longitude={LONGITUDE}&radius={RADIUS}&format={FORMAT}\n<b>{APPID}</b>:\nApplikationens GUID som fås från http://data.goteborg.se\n<b>{AFFECTSBIKELANE}</b>:\nSätts till true om bara starttillstånd som påverkar cykelvägar önskas i svaret. Frivilligt\n<b>{ONLYLIVE}</b>:\nSätts till true om bara starttillstånd som är aktiverade eller inom tillståndstiden just nu önskas i svaret. Frivilligt\n<b>{LATITUDE}</b>:\nAnvändarens latitud i decimalform, t.ex. 57.7. Frivilligt\n<b>{LONGITUDE}</b>:\nAnvändarens longitud i decimalform, t.ex. 11.9. Frivilligt\n<b>{RADIUS}</b>:\nRadie i meter inom vilken träffar returneras. Frivilligt\n<b>{FORMAT}</b>:\nFormat på svaret, XML eller JSON. XML som standard om inget anges. Frivilligt\n\nDatamodell utökad:\nSEVERITYCODES och BIKESEVERITYCODES har inte längre \"4,5\" som default-värde och använder sig av en OCH filtrering.\nExempel : skickar man in SEVERITYCODES=4 och BIKESEVERITYCODES=5 så returneras enbart starttillstånd som både har SEVERITYCODES 4 OCH BIKESEVERITYCODES 5."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2023-02-24"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"StartPermissionService - v1.4"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}},{"@id":"https://catalog.goteborg.se/store/6/resource/483","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/38"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/44463"},{"@id":"https://catalog.goteborg.se/store/6/resource/484"},{"@id":"https://catalog.goteborg.se/store/6/resource/654"}],"dcat:keyword":[{"@language":"sv","@value":"Gräva"},{"@language":"sv","@value":"Starttillstånd"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"1.3","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:description":{"@language":"sv","@value":"Starttillstånd, utfärdade tillstånd för att utföra arbete på eller i närheten av kommunens gator.\nHär kan du läsa mer om starttillstånd: http://goteborg.se/wps/portal/start/foretag/tillstand-och-regler/grava-i-gatan/starttillstand\nHär kan du se systemet som hanterar starttillstånd: https://nystart.stadsmiljo.goteborg.se/"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Starttillstånd"}},{"@id":"https://catalog.goteborg.se/store/6/resource/484","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/StartPermissionService/v1.2/help"},"dct:description":{"@language":"sv","@value":"Alla metoder som returnerar flera Starttillstånd har följande querystring gemensamt: \n{APPID}?affectsbikelane={AFFECTSBIKELANE}&onlyLive={ONLYLIVE}&latitude={LATITUDE}&longitude={LONGITUDE}&radius={RADIUS}&format={FORMAT}\n  <b>{APPID}</b>: \n Applikationens GUID som fås från http://data.goteborg.se\n<b>{AFFECTSBIKELANE}</b>:\nSätts till true om bara starttillstånd som påverkar cykelvägar önskas i svaret. Frivilligt\n<b>{ONLYLIVE}</b>:\nSätts till true om bara starttillstånd som är aktiverade eller inom tillståndstiden just nu önskas i svaret. Frivilligt\n<b>{LATITUDE}</b>: \n Användarens latitud i decimalform, t.ex. 57.7. Frivilligt\n<b>{LONGITUDE}</b>: \n Användarens longitud i decimalform, t.ex. 11.9. Frivilligt\n<b>{RADIUS}</b>: \n Radie i meter inom vilken träffar returneras. Frivilligt\n<b>{FORMAT}</b>: \n Format på svaret, XML eller JSON. XML som standard om inget anges. Frivilligt\n\nhttps://data.goteborg.se/startpermissionservice/v1.2/help\nDatamodell utökad:\n<b>Addition</b>:\nPåverkans-information.\n<b>BikeAddition</b>:\nCykelväg påverkan.\n<b>BikeSeverityCode</b>:\nCykelväg påverkansgrad.\n<b>BikeSeverityText</b>:\nCykelväg påverkansgrad-text.\n<b>CreatedDate</b>:\nDatum då situationen skapades.\n<b>UpdatedDate</b>:\nDatum då situationen senast uppdaterades.\n"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"StartPermissionService - v1.2"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}},{"@id":"https://catalog.goteborg.se/store/6/resource/654","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/StartPermissionService/v1.3/help"},"dct:description":{"@language":"sv","@value":"Alla metoder som returnerar flera Starttillstånd har följande querystring gemensamt: {APPID}?affectsbikelane={AFFECTSBIKELANE}&onlyLive={ONLYLIVE}&latitude={LATITUDE}&longitude={LONGITUDE}&radius={RADIUS}&format={FORMAT}<b>{APPID}</b>:Applikationens GUID som fås från http://data.goteborg.se <b>{AFFECTSBIKELANE}</b>: Sätts till true om bara starttillstånd som påverkar cykelvägar önskas i svaret. Frivilligt <b>{ONLYLIVE}</b>: Sätts till true om bara starttillstånd som är aktiverade eller inom tillståndstiden just nu önskas i svaret. Frivilligt <b>{LATITUDE}</b>:Användarens latitud i decimalform, t.ex. 57.7. Frivilligt <b>{LONGITUDE}</b>:Användarens longitud i decimalform, t.ex. 11.9. Frivilligt <b>{RADIUS}</b>:Radie i meter inom vilken träffar returneras. Frivilligt <b>{FORMAT}</b>:Format på svaret, XML eller JSON. XML som standard om inget anges. Frivilligt\n\nDatamodell utökad:\nStatus på arbetet: \"Ej startad\", \"Startad\", \"Stoppad\", \"Avslutad\"\n"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2019-05-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"StartPermissionService - v1.3"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:6dbb70a52a04bfca4fb85f522b1a99ecfa50c467abf3336ff07b8d7126c7c854"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/38","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:it.support@stadsmiljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/479","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/38"},"dcat:distribution":{"@id":"https://catalog.goteborg.se/store/6/resource/480"},"dcat:keyword":[{"@language":"sv","@value":"Göta Älv"},{"@language":"sv","@value":"Vattennivå"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"1.1","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:description":{"@language":"sv","@value":"Denna service publicerar vattennivåer uppmätta i Götaälv och Mölndalsån. Se https://molndalsan.se//. För Mölndalsån finns även flöden och nederbörd.\n\nVattennivån anges i cm enligt höjdsystemet RH2000."},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Vattennivå i Götaälv"}},{"@id":"https://catalog.goteborg.se/store/6/resource/480","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/RiverService/v1.1/help"},"dct:description":{"@language":"sv","@value":"Webbtjänst på data.goteborg.se\n\nMeasurements ger alla insamlade data för vald mätplats och mätparameter och inom vald period. Som standard returneras dygnsmedelvärden men det är möjligt att hämta ut alla insamlade värden.\nParametrar:\nAPPID: Applikations-GUID som fås via ”Mitt  konto” på data.goteborg.se.\nMEASURESITECODE: Anger vilken mätplats som mätvärden ska hämtas från.\nMEASUREPARAMETERCODE: Anger vilken mätparamete som mätvärden ska hämtas från.\nFROMDATE: Från och med datum och tid.\nTODATE:  Till och med datum och tid. Sätt till samma som FROMDATE om ögonblicksbild önskas vid specifik tidpunkt.\nFROMDATE och TODATE kan utelämnas, då får senaste mätning.\nDAILYAVERAGEVALUES (valfri): Anger om svaret ska innehålla dygnsmedelvärden eller samtliga insamlade mätvärden, TRUE (dygnsmedelvärden) som default.\nFORMAT (valfri): Anger vilket format som önskas i svaret. JSON eller XML. XML är default.\n\nSvar:\nMetoden returnerar en lista med Measurements, varje Measurement har följande egenskaper:\nMeasurement:\nTimeStamp: Datum och tid för aktuell mätning.\nValue: Värdet för aktuell mätning. Nivåer anges i meter i höjdsystemet RH2000, flöden anges i kubikmeter per sekund och nederbörd anges i millimeter.\nIsUnreliable: Flagga som säger om mätvärdet är pålitligt eller ej. Returneras endast om det är opålitligt och då som TRUE. Opålitliga mätvärden kan bero på olika faktorer, t.ex. dataavbrott, givare som fastnat mm.\n\nMetoden MeasureSites ger alla mätplatser längs Mölndalsån och Göta älv. Hämtar även alla tillgängliga mätparametrar och senast insamlade värden om så önskas.\n\nParametrar:\nAPPID: Applikations-GUID som fås via ”Mitt  konto” på data.goteborg.se.\nMEASURESITECODE (valfri):  Anges om endast en speciell mätplats önskas i resultatet.\nGETCURRENTVALUES (valfri):  Sätts till TRUE om senast insamlade värden ska följa med i resultatet, TRUE som default.\nLATITUDE (valfri): Latitud i decimalform i koordinatsystem WGS84, används för att kunna beräkna avstånd och radie. Kräver LONGITUDE för att fungera.\nLONGITUDE (valfri): Samma som LATITUDE, kräver LATITUDE för att fungera.\nRADIUS (valfri): Radie i meter för att hämta mätplatser inom. Kräver att LATITUDE och LONGITUDE anges.\nFORMAT (valfri): Anger vilket format som önskas i svaret. JSON eller XML. XML är default.\n\nSvar:\nMetoden returnerar en lista med MeasureSites, varje MeasureSite har följande egenskaper:\nMeasureSite:\nCode: Koden för mätplatsen.\nDescription: Mätplatsens namn på svenska.\nSG: Sänkningsgräns eller undre nivå vid normala förhållanden.\nDG: Dämningsgräns eller övre nivå vid normala förhållanden.\nLat: Latitud i WGS84 decimalform.\nLong: Longitud i WGS84 decimalform.\nDistance: Avstånd i meter till mätplatsen. Returneras endast om LATITUDE och LONGITUDE är satta.\nMeasureParameters: En lista på alla mätparametrar som finns på angiven mätplats.\n\n \nMeasureParameter:\nCode: Koden för mätparametern.\nDescription: Mätparameterns namn på svenska.\nCurrentValue: Det senast insamlade värdet för aktuell mätparameter på aktuell mätplats. Alla nivåer anges i meter i höjdsystemet RH2000, nederbörd anges som mm/h senaste timmen. Returneras om GETCURRENTVALUES inte är satt till FALSE.\n"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"RiverService"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}}],"@id":"urn:source:70ae06a126df7d3d48bcbdc36822cb7ecd32721a298882e82706624108914003"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/111117","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Overskridande.csv"},{"@id":"https://catalog.goteborg.se/store/6/resource/111118","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/111117"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/111117"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:title":{"@language":"sv","@value":"Överskridande"}},{"@id":"https://catalog.goteborg.se/store/6/resource/130687","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Overskridande (4).csv"},{"@id":"https://catalog.goteborg.se/store/6/resource/130688","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/130687"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/130687"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:title":{"@language":"sv","@value":"Överskridande 2"}},{"@id":"https://catalog.goteborg.se/store/6/resource/134095","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"api4 (12).csv"},{"@id":"https://catalog.goteborg.se/store/6/resource/134096","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/134095"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/134095"},"dct:format":{"@id":"http://publications.europa.eu/res