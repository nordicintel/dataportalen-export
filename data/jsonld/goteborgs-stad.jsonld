{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/38","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:it.support@stadsmiljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/466","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/38"},"dcat:distribution":{"@id":"https://catalog.goteborg.se/store/6/resource/476"},"dcat:keyword":{"@language":"sv","@value":"Parkering"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"2.3","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:description":{"@language":"sv","@value":"Tjänsten ger information om parkeringsplatser för olika trafikslag och städzoner som regleras av Göteborgs Stad stadsmiljöförvaltningen samt parkeringsplatser från Göteborgs Stads Parkeringsaktiebolag.\n\nFör att få med alla avgiftsfria parkeringar och betalparkeringar på gatumark och kvartersmark för biltrafik så behöver följande tre api:er anropas \n\nhttps://data.goteborg.se/ParkingService/v2.3/PublicTollParkings/\nhttps://data.goteborg.se/ParkingService/v2.3/PrivateTollParkings/\nhttps://data.goteborg.se/ParkingService/v2.3/PublicTimeParkings"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Parkeringsplatser"}},{"@id":"https://catalog.goteborg.se/store/6/resource/476","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/ParkingService/v2.3/help"},"dct:description":{"@language":"sv","@value":"Varje parkering beskrivs med hjälp av nedanstående attribut, endast tillgängliga attribut returneras:\nId: Unikt id för parkeringen, om det är en kommunal parkering är det dess LTF-nummer\nName: Namn på parkeringen, oftast en adress eller namnet på P-huset\nOwner: Anger vem som äger parkeringen, mer information om ägaren kan fås via metoden ParkingOwners\nParkingSpaces: Totalt antal parkeringsplatser\nParkableLength: Antal meter fickparkeringar\nParkingSpaceCount: Antal P-rutor\nPhoneParkingCode: Telefonparkeringskod (fr.o.m. v2.0)\nParkingCharge: Taxa\nParkingCost: Kostnad i klartext\nCurrentParkingCost: Kostnad per timme att parkera just nu\nMaxParkingTime: Max tillåten P-tid\nMaxParkingTimeLimitation: Ytterligare villkor till max tillåten P-tid\nResidentialParkingArea: Boendeparkering, t.ex M4\nExtraInfo: Övrig info, t.ex. städzon mm\nDistance: Avstånd i meter från aktuell position (returneras endast om egen position skickats in)\nLat: Latitud i WGS84\nLong: Longitud i WGS84\n\nAlla metoder som returnerar flera parkeringar eller städzoner har följande querystring gemensamt: {APPID}?latitude={LATITUDE}&longitude={LONGITUDE}&radius={RADIUS}&format={FORMAT}\n\n{APPID}: Applikationens GUID som fås från http://data.goteborg.se\n{LATITUDE}: Användarens latitud i decimalform, t.ex. 57.7. Frivilligt\n{LONGITUDE}: Användarens longitud i decimalform, t.ex. 11.9. Frivilligt\n{RADIUS}: Radie i meter inom vilken träffar returneras. Frivilligt\n{FORMAT}: Format på svaret, XML eller JSON. XML som standard om inget anges. Frivilligt"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ParkingService"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}}],"@id":"urn:source:0cc8959ed2f13ad2cbbd9f2ffd1e92c4ec660dbfa144256dd94b875aa9c84a82"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/38","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:it.support@stadsmiljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/500","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/38"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/502"},{"@id":"https://catalog.goteborg.se/store/6/resource/503"}],"dcat:keyword":[{"@language":"sv","@value":"cykel"},{"@language":"sv","@value":"cykelbana"},{"@language":"sv","@value":"karta"},{"@language":"sv","@value":"trafik"},{"@language":"sv","@value":"wms"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Cykelbanor Göteborg"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:title":{"@language":"sv","@value":"Cykelbanor"}},{"@id":"https://catalog.goteborg.se/store/6/resource/501","@type":"http://entryscape.com/terms/File","dct:title":"Produktbeskrivning CYKELBANOR.pdf"},{"@id":"https://catalog.goteborg.se/store/6/resource/502","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/501"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/501"},"dct:description":{"@language":"sv","@value":"Produktbeskrivning av karttjänst för cykelbanor i Göteborg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-25"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2018-01-25"},"dct:title":{"@language":"sv","@value":"Cykelbanor beskrivning av karttjänst"}},{"@id":"https://catalog.goteborg.se/store/6/resource/503","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://open.geodata.tkgbg.se/wms"},"dct:description":{"@language":"sv","@value":"Cykelbanor som karttjänst wms"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-25"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Cykelbanor kartjänst wms"},"foaf:page":{"@id":"https://catalog.goteborg.se/store/6/resource/501"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}}],"@id":"urn:source:0d5c5bd710a276a2ec10d50f98380f67649bbc8d6a1e41148d31f14e346cda3b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/114","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/18"},"dcat:distribution":{"@id":"https://catalog.goteborg.se/store/6/resource/339"},"dcat:hasVersion":{"@id":"https://catalog.goteborg.se/store/6/resource/114"},"dcat:isVersionOf":{"@id":"https://catalog.goteborg.se/store/6/resource/114"},"dcat:keyword":[{"@language":"en","@value":"Noise"},{"@language":"en","@value":"Silent areas"},{"@language":"en","@value":"Trafficnoise"},{"@language":"sv","@value":"Buller"},{"@language":"sv","@value":"Trafikbuller"},{"@language":"sv","@value":"Tysta områden"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48806"},"dct:description":[{"@language":"en","@value":"WMS service showing the distribution of day-to-day (LAeq, day) traffic noise in the municipality of Gothenburg. Noise sources are tram traffic, rail and road traffic. Calculations are made in the Sondplan with input data from 2015-2016.\n\nThe information is divided into three WMS layers.\n\n(1) Traffic noise 50 - 65 dB Noise spread at 2 meters height divided into noise levels (surfaces).\n\n(2) Traffic noise 50 - 65 dB divided by floor level (façade points)\n\n(3) Traffic noise below 50 dB "},{"@language":"sv","@value":"WMS- tjänst som visar utbredning av dygnsekvivalent (LAeq,dygn) trafikbuller i Göteborgs kommun. Bullerkällor är spårvagnstrafik, järnvägstrafik och vägtrafik. Beräkningar är utförda i Sondplan med ingångsdata från åren 2015-2016. \n\nInformationen delas upp i tre WMS- lager. \n\n(1) Trafikbuller 50 - 65 dB buller utbredning på 2 meters höjd indelat i bullernivåer (ytor). \n\n(2) Trafikbuller 50 - 65 dB indelat per våningsplan (fasadpunkter)\n\n(3) Trafikbuller under 50 dB utbredning (yta)"}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:source":{"@id":"https://catalog.goteborg.se/store/6/resource/114"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Trafikbuller karttjänst WMS 2016"},"foaf:page":{"@id":"https://catalog.goteborg.se/store/6/resource/13435"}},{"@id":"https://catalog.goteborg.se/store/6/resource/13435","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Produktbeskrivning Trafikbuller 2016"}},{"@id":"https://catalog.goteborg.se/store/6/resource/18","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoforvaltningen@miljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/339","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geoserverextern.miljoforvaltningen.goteborg.se/geoserver/miljoovervakning_buller_v1/wms"},"dct:description":{"@language":"sv","@value":"Trafikbullerberäkningar Göteborgs stad"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst trafikbuller"},"foaf:page":{"@id":"https://catalog.goteborg.se/store/6/resource/337"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48806","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Miljöförvaltningen"}}],"@id":"urn:source:0e8ca1eea0e06e18be7d9780fef427b17824eeda2a42e0f5cecd0eb557d1f7fc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/14911","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Demokrati och medborgarservice","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:support.digitalakanaler@goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/14912","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/14911"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/14914"},{"@id":"https://catalog.goteborg.se/store/6/resource/14916"}],"dcat:keyword":[{"@language":"sv","@value":"utbildning"},{"@language":"sv","@value":"öppna data"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48810"},"dct:description":{"@language":"sv","@value":"Grundkurs + fortsättningskurs i området öppna data i Göteborgs Stad. Grundkursen är till för dig som inte har någon erfarenhet alls om öppna data. Fortsättningskursen tar vid där grundkursen slutar och visar även hur du ska göra när du publicerar en ny datamängd."},"dct:issued":{"@type":"xsd:date","@value":"2021-06-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:title":{"@language":"sv","@value":"Utbildningsmaterial i öppna data"}},{"@id":"https://catalog.goteborg.se/store/6/resource/14913","@type":"http://entryscape.com/terms/File","dct:title":"Utbildning_ÖppnaData_del1.pdf"},{"@id":"https://catalog.goteborg.se/store/6/resource/14914","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/14913"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/14913"},"dct:description":{"@language":"sv","@value":"Grundkurs i öppna data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Grundkurs i öppna data"}},{"@id":"https://catalog.goteborg.se/store/6/resource/14915","@type":"http://entryscape.com/terms/File","dct:title":"Utbildning_Ö