istribution","dcat:accessURL":{"@id":"https://geoserverextern.miljoforvaltningen.goteborg.se/geoserver/miljoovervakning_buller_v1/wms"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:issued":{"@type":"xsd:date","@value":"2019-06-19"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst trafikbuller 2023"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:9cb1b5ced99e049649eead1f66af149992f753769cff1686280d6e815576f089"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/43630","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/78"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/43632"},{"@id":"https://catalog.goteborg.se/store/6/resource/43637"}],"dcat:keyword":[{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantör"},{"@language":"sv","@value":"Pengar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48807"},"dct:description":{"@language":"sv","@value":"Fakturor som har kommit till Göteborgs Stad under respektive månad. Informationen om fakturorna publiceras i tabellform och innehåller: nämnd eller förvaltning som fakturan är bokförd på, leverantörens namn, leverantörens organisationsnummer, fakturanummer, verifikationsnummer (Göteborgs Stads numrering), konto som fakturan är bokförd på, kontotext (anger i klartext vilken slags kostnad det gäller), konterat belopp exklusive moms. För dig som vill ladda ner filen och läsa den i tex Excel finns nu en CSV-fil att ladda ned per månad. Nu finns även ett nytt API som kommer innehålla respektive månad under 2021. För tidigare år finns fler datamängder på goteborg.se/psidata sidan. För att beställa en faktura bild gå till vår E-tjänst: http://goteborg.se/wps/portal?uri=gbglnk%3a20161025123948522"},"dct:issued":{"@type":"xsd:date","@value":"2023-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor för 2023"}},{"@id":"https://catalog.goteborg.se/store/6/resource/43632","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.goteborg.se/store/6/resource/43633"},{"@id":"https://catalog.goteborg.se/store/6/resource/44992"},{"@id":"https://catalog.goteborg.se/store/6/resource/46662"},{"@id":"https://catalog.goteborg.se/store/6/resource/47977"},{"@id":"https://catalog.goteborg.se/store/6/resource/49472"},{"@id":"https://catalog.goteborg.se/store/6/resource/50892"},{"@id":"https://catalog.goteborg.se/store/6/resource/52379"},{"@id":"https://catalog.goteborg.se/store/6/resource/54083"},{"@id":"https://catalog.goteborg.se/store/6/resource/56182"},{"@id":"https://catalog.goteborg.se/store/6/resource/58484"},{"@id":"https://catalog.goteborg.se/store/6/resource/60653"},{"@id":"https://catalog.goteborg.se/store/6/resource/62963"}],"dcat:downloadURL":[{"@id":"https://ca