t synlig och tillgänglig under den period då remissen är öppen för granskning. När remissperioden är avslutad tas datamängden bort eller upphör att vara tillgänglig via den publika tjänsten."},"dct:issued":{"@type":"xsd:date","@value":"2026-04-29"},"dct:publisher":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:title":{"@language":"sv","@value":"Aktuell remiss beläggning"}},{"@id":"https://catalog.goteborg.se/store/6/resource/122567","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://open.geodata.tkgbg.se/general/aktuell_remiss_belaggning/ows?SERVICE=WMS&REQUEST=GetCapabilities"},"dct:description":{"@language":"sv","@value":"WMS-tjänst för datamängden Aktuell remiss beläggning. Datamängden visar Stadsmiljöförvaltningens föreslagna underhållsbeläggningar för gata under aktuell remissperiod."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc-nd/4.0/"},"dct:title":{"@language":"sv","@value":"Aktuell remiss beläggning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}},{"@id":"https://catalog.goteborg.se/store/6/resource/86806","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:wifak.shatt@stadsmiljo.goteborg.se"}}],"@id":"urn:source:a508c18a435234c132dfce47a6ccde873f65012ba5159d9618c3a8fb7a06bc03"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stads