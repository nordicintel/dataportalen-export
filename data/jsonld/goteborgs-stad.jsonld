:"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/11337","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/78"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/11339"},{"@id":"https://catalog.goteborg.se/store/6/resource/11341"}],"dcat:keyword":[{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantör"},{"@language":"sv","@value":"Pengar"}],"dcat:landingPage":{"@id":"http://goteborg.se/wps/portal?uri=gbglnk%253a20161025123948522"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48807"},"dct:description":"Fakturor som har kommit till Göteborgs Stad under respektive månad. Informationen om fakturorna publiceras i tabellform och innehåller:\n\nnämnd eller förvaltning som fakturan är bokförd på,\nleverantörens namn,\nleverantörens organisationsnummer,\nfakturanummer,\nverifikationsnummer (Göteborgs Stads numrering),\nkonto som fakturan är bokförd på,\nkontotext (anger i klartext vilken slags kostnad det gäller), konterat belopp exklusive moms. \nFör dig som vill ladda ner filen och läsa den i tex Excel finns nu en CSV-fil att ladda ned per månad. Nu finns även ett nytt API som kommer innehålla respektive månad under 2021. \nFör tidigare år finns fler datamängder på goteborg.se/psidata.\n\nFör att beställa en fakturabild gå till vår E-tjänst: http://goteborg.se/wps/portal?uri=gbglnk%3a20161025123948522","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:temporal":{"@id":"_:6c0a4fadfe0898038ff58ba97257918ca445910635ecbe9c146b6954bcef42bc_b0n0"},"dct:title":"Leverantörsfakturor för 2021"},{"@id":"https://catalog.goteborg.se/store/6/resource/11339","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.goteborg.se/store/6/resource/11941"},{"@id":"https://catalog.goteborg.se/store/6/resource/12683"},{"@id":"https://catalog.goteborg.se/store/6/resource/13455"},{"@id":"https://catalog.goteborg.se/store/6/resource/14141"},{"@id":"https://catalog.goteborg.se/store/6/resource/14905"},{"@id":"https://catalog.goteborg.se/store/6/resource/15791"},{"@id":"https://catalog.goteborg.se/store/6/resource/17398"},{"@id":"https://catalog.goteborg.se/store/6/resource/18779"},{"@id":"https://catalog.goteborg.se/store/6/resource/20231"},{"@id":"https://catalog.goteborg.se/store/6/resource/21773"},{"@id":"https://catalog.goteborg.se/store/6/resource/23164"},{"@id":"https://catalog.goteborg.se/store/6/resource/24805"}],"dcat:downloadURL":[{"@id":"https://catalog.goteborg.se/store/6/resource/11941"},{"@id":"https://catalog.goteborg.se/store/6/resource/12683"},{"@id":"https://catalog.goteborg.se/store/6/resource/13455"},{"@id":"https://catalog.goteborg.se/store/6/resource/14141"},{"@id":"https://catalog.goteborg.se/store/6/resource/14905"},{"@id":"https://catalog.goteborg.se/store/6/resource/15791"},{"@id":"https://catalog.goteborg.se/store/6/resource/17398"},{"@id":"https://catalog.goteborg.se/store/6/resource/18779"},{"@id":"https://catalog.goteborg.se/store/6/resource/20231"},{"@id":"https://catalog.goteborg.se/store/6/resource/21773"},{"@id":"https://catalog.goteborg.se/store/6/resource/23164"},{"@id":"https://catalog.goteborg.se/store/6/resource/24805"}],"dct:description":{"@language":"sv","@value":"Leverantörsfaktura 2021"},"dct:format":{"@id":"http://publications.europa.eu/re