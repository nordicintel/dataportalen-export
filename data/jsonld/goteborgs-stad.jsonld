:"sv","@value":"Produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15T14:28:29.804Z"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning WMS-tjänst Mätstationer Luft"}}],"@id":"urn:source:da80dd6bd59b1e5c0cf6b08628e5abc01e5af108c5a773f392f8fb1c280d1053"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/38","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsmiljöförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:it.support@stadsmiljo.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/462","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/38"},"dcat:distribution":{"@id":"https://catalog.goteborg.se/store/6/resource/463"},"dcat:keyword":[{"@language":"sv","@value":"Grundvatten"},{"@language":"sv","@value":"Nivå"},{"@language":"sv","@value":"Vatten"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dcat:version":"1.0","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:description":{"@language":"sv","@value":"OBS Denna tjänst är under avveckling och kommer att stängas ner 2018-01-31.\n\nDu som använder dess data hänvisas till www.vattenigoteborg.se där du kan hämta motsvarande data.\n\nKontakta Victoria (victoria.svahn@exploatering.goteborg.se) för mer information.\n\nTjänsten levererar mätdata i form av grundvattennivåmätningar från grundvattenrör inom Göteborg."},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Grundvattennivåer"}},{"@id":"https://catalog.goteborg.se/store/6/resource/463","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/GroundWaterService/v1.0/help"},"dct:description":{"@language":"sv","@value":"Förklaring av datakolumner:\nID: Unikt löpnummer för respektive observationspunkt\nCode: Unikt namn/beteckningför respektive mätpunkt\nReferenceLevelMASL: Mätpunktens referensnivå i angivet som plushöjd i RH2000, ofta annars uttryckt som Rör Överkant (RÖK).\nAquifer: Typ av grundvattenmagasin som mätpunkten representerar, övre (ömag), undre (umag), portryck i finmaterial (pp).\nWelltype: Typ av observationspunkt, vanligen Grundvattenrör eller portrycksmätare.\nFrequency: Mätfrekvens kontrollmätningar, observera att uppgiften kan vara gammal dvs att mätpunkten inte längre mäts.\nMeasurementsNo: Antal mätningar i databasen\nStartDate: Datum för första mätning\nEndDate: Datum för sista mätning\nDistrict: Geografiskt delområde\nAddress: Adress för mätpunkt i förekommande fall\nBottomLevelMASL: Nivå för rör underkant, dvs rördjup uttryckt i plusnivå\nScreenLength: Längd på perforerad spets av observationsrör\nAlertLevelHighMASL: Larmnivå för hög grundvattennivå (plushöjd). Manuellt vald nivå utifrån studier av tidsseriedata. Syftet med larmnivå är att uppmärksamma avvikande grundvattennivåer.\nAlertLevelLowMASL: Larmnivå för låg grundvattennivå (plushöjd). Manuellt vald nivå utifrån studier av tidsseriedata. Syftet med larmnivå är att uppmärksamma avvikande grundvattennivåer. "},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2018-01-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"GroundWaterService"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}}],"@id":"urn:source:db91454f51f042c4342cfe07abbe20c424826f23490e7afa929c20a21d66c92a"},{"@graph":[{"@id":"https://catalog.goteborg.se/store/6/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://catalog.goteborg.se/store/6/resource/10"},{"@id":"https://catalog.goteborg.se/store/6/resource/11337"},{"@id":"https://catalog.goteborg.se/store/6/resource/114"},{"@id":"https://catalog.goteborg.se/store/6/resource/115675"},{"@id":"https://catalog.goteborg.se/store/6/resource/122566"},{"@id":"https://catalog.goteborg.se/store/6/resource/132801"},{"@id":"https://catalog.goteborg.se/store/6/resource/14"},{"@id":"https://catalog.goteborg.se/store/6/resource/14912"},{"@id":"https://catalog.goteborg.se/store/6/resource/21"},{"@id":"https://catalog.goteborg.se/store/6/resource/24806"},{"@id":"https://catalog.goteborg.se/store/6/resource/3"},{"@id":"https://catalog.goteborg.se/store/6/resource/3004"},{"@id":"https://catalog.goteborg.se/store/6/resource/30077"},{"@id":"https://catalog.goteborg.se/store/6/resource/340"},{"@id":"https://catalog.goteborg.se/store/6/resource/35"},{"@id":"https://catalog.goteborg.se/store/6/resource/38802"},{"@id":"https://catalog.goteborg.se/store/6/resource/41231"},{"@id":"https://catalog.goteborg.se/store/6/resource/41339"},{