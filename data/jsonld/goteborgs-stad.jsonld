type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Göteborg stads konstsamling inköp 2025 (Excel, svenska)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91154","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Göteborg Stad Kulturförvaltningen"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91155","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/91183"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/118687"},{"@id":"https://catalog.goteborg.se/store/6/resource/91674"},{"@id":"https://catalog.goteborg.se/store/6/resource/91676"},{"@id":"https://catalog.goteborg.se/store/6/resource/91678"}],"dcat:keyword":["Göteborg Stad Kulturförvaltningen",{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Konst"},{"@language":"sv","@value":"Kultur"}],"dcat:landingPage":{"@id":"https://www.goteborg.se/kultur"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/91154"},"dct:description":{"@language":"sv","@value":"I denna datamängd publiceras information om konstverken i Göteborg stads konstsamling. Samlingen består i nuläget av ca 11.000 konstverk som placeras ut i konstkollektioner på arbetsplatser inom Göteborgs Stad, så kallad lös konst.\n\nPå grund av licenskostnader har vi tyvärr inte möjlighet att publicera bilder på konstverken, bilder på enskilda verk kan skickas vid förfrågan. Datamängden uppdateras i februari/mars varje år. \n\nDatamängden innehåller information om verk som köpts in enligt Göteborg Konsts inköpsrutiner men även övertag från andra kommunala bolag och förvaltningar, samt gåvor under den period då dessa accepterades.\n\nSyftet är att ge medborgarna insyn i vår samling och att dela information om vår samling med andra kulturinstitutioner.\n\nMer information om Göteborg Konsts verksamhet finns på https://goteborg.se/goteborgkonst"},"dct:issued":{"@type":"xsd:date","@value":"2025-03-13"},"dct:publisher":{"@id":"https://catalog.goteborg.se/store/6/resource/91154"},"dct:title":{"@language":"sv","@value":"Göteborg stads konstsamling"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91183","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Kulturförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:hampus.bovbjerg.grip@kultur.goteborg.se"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91673","@type":"http://entryscape.com/terms/File","dct:title":"Göteborg Konst samtliga verk 2025-02-17 (Excel Svenska).xlsx"},{"@id":"https://catalog.goteborg.se/store/6/resource/91674","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/91673"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/91673"},"dct:description":{"@language":"sv","@value":"Förteckning över samtliga verk i Göteborg stads konstsamling, uppdaterad 2026-03-06."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Göteborg stads konstsamling - svenska rubriker (Uppdaterad 2026-03-05)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91675","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Göteborgs kommunala konstsamling samtliga verk 2026-03-05.csv"},{"@id":"https://catalog.goteborg.se/store/6/resource/91676","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/91675"},"dcat:downloadURL":{"@id":"https://catalog.goteborg.se/store/6/resource/91675"},"dct:description":[{"@language":"en","@value":"All works in the City of Gothenburg art collection, excluding deaccessed works, .CSV format with english headers. Updated 2026-06-05."},{"@language":"sv","@value":"Förteckning över samtliga verk i Göteborg stads konstsamling, exklusive avförda verk, i CSV-format med engelska rubriker. Uppdaterad 2026-06-05."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-05T08:38:20.429Z"},"dct:title":[{"@language":"en","@value":"Gothenburgs municipal art collection (CSV english headers)"},{"@language":"sv","@value":"Göteborg stads konstsamling (CSV Engelska rubriker)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.goteborg.se/store/6/resource/91678","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.goteborg.se/rowstore/dataset/2821b90a-7a8a-4131-8d0c-6ff83bd0aae3"},"dct:conformsTo":{"@id":"https://catalog.goteborg.se/rowstore/dataset/2821b90a-7a8a-4131-8d0c-6ff83bd0aae3/swagger"},"dct:description":[{"@language":"sv","@value":"Auto-generated API. City of Gothenburgs art collection, excluding deaccessed works as of 2025-02-17."},{"@language":"sv","@value":"Auto-genererat API. Samtliga verk i Göteborg stads konstsamling exklusive avförda verk. Uppdaterad 2026-03-06"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-05T08:38:35.025Z"},"dct:source":{"@id":"https://catalog.goteborg.se/store/6/resource/91676"},"dct:title":[{"@language":"en","@value":"Gothenburgs municipal art collection (API)"},{"@language":"sv","@value":"Göteborgs kommunala konstsamling (API)"}],"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.goteborg.se/rowstore/dataset/2821b90a-7a8a-4131-8d0c-6ff83bd0aae3/swagger"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:8210d9258312a2ee15e6b573d431bf058bfeeb4a784e7557df35a0b42c876024"},{"@graph":[{"@id":"_:9815a4f9d54cb986c1dc8136971c9ccc1de358341491a3a2b970ee8cd575d8f6_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#locality":"Göteborg","http://www.w3.org/2006/vcard/ns#postal-code":"41118","http://www.w3.org/2006/vcard/ns#street-address":"Magasinsgatan 18A"},{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/115675","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/115678"},"dcat:distribution":[{"@id":"https://catalog.goteborg.se/store/6/resource/115677"},{"@id":"https://catalog.goteborg.se/store/6/resource/115681"}],"dcat:keyword":[{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantör"},{"@language":"sv","@value":"Pengar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/115679"},"dct:description":{"@language":"sv","@value":"Datamängden avser öppna data avseende leverantörsfakturor för Göteborgs Stads förvaltningar.\n\nDatamängden utgår från den nationella specifikation som finns framtagen för leverantörsreskontra (https://lankadedata.se/spec/leverantorsreskontra/). Datamängden innehåller data över bokförda leverantörsfakturor för Göteborgs Stads förvaltningar. Beloppen som redovisas är SEK, exkl. moms. Datamängden publiceras en gång per månad och varje publicering innehåller föregående bokföringsperiods leverantörsfakturor. \n\nAv sekretesskäl exkluderas leverantörsfakturor som är sekretessmarkerade i Göteborgs Stads fakturasystem. Därtill döljs de organisationsnummer som utgörs av personnummer eller samordningsnummer. \n\nFakturor inom eller mellan förvaltningar i Göteborgs Stad inkluderas inte i datamängden. Konton avseende moms samt öresutjämning inkluderas inte i datamängden. Ombokningar (rättningar) i ekonomisystemet inkluderas ej i datamängden. De frivilliga fälten \"grund\", \"avtal\", \"s_kod_nr\" i den nationella specifikationen för leverantörsreskontra lämnas tomma då det inte finns stöd för dessa i Göteborgs Stads relevanta system.\n\nFör tidigare år finns fler datamängder på: www.goteborg.se/psidata.\n\nFör att beställa en fakturabild. Använd E-tjänst: http://goteborg.se/wps/portal?uri=gbglnk%3a20161025123948522"},"dct:issued":{"@type":"xsd:date","@value":"2026-02-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra för 2026"},"foaf:page":[{"@id":"https://catalog.goteborg.se/store/6/resource/115686"},{"@id":"https://www.dataportal.se/specifications/leverantorsreskontra/latest"}]},{"@id":"https://catalog.goteborg.se/store/6/resource/115677","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.goteborg.se/store/6/resource/117073"},{"@id":"https://catalog.goteborg.se/store/6/resource/119033"},{"@id":"https://catalog.goteborg.se/store/6/resource/121201"},{"@id":"https://catalog.goteborg.se/store/6/resource/123371"},{"@id":"https://catalog.goteborg.se/store/6/resource/125472"},{"@id":"https://catalog.goteborg.se/store/6/resource/129627"},{"@id":"https://catalog.goteborg.se/store/6/resource/129628"},{"@id":"https://catalog.goteborg.se/store/6/resource/131824"},{"@id":"https://catalog.goteborg.se/store/6/resource/134131"}],"dcat:downloadURL":[{"@id":"https://catalog.goteborg.se/store/6/resource/117073"},{"@id":"https://catalog.goteborg.se/store/6/resource/119033"},{"@id":"https://catalog.goteborg.se/store/6/resource/121201"},{"@id":"https://catalog.goteborg.se/store/6/resource/123371"},{"@id":"https://catalog.goteborg.se/store/6/resource/125472"},{"@id":"https://catalog.goteborg.se/store/6/resource/129627"},{"@id":"https://catalog.goteborg.se/store/6/resource/129628"},{"@id":"https://catalog.goteborg.se/store/6/resource/131824"},{"@id":"https://catalog.goteborg.se/store/6/resource/134131"}],"dct:conformsTo":{"@id":"https://dataportal.se/specifications/DCAT-AP-SE/3.0.0"},"dct:description":{"@language":"sv","@value":"CSV-filer avseende leverantörsreskontra för Göteborgs Stads förvaltningar."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-12T12:58:08.125Z"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra CSV"}},{"@id":"https://catalog.goteborg.se/store/6/resource/115678","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Inköps- och upphandling