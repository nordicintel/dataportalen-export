d":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/48808"},"dct:description":{"@language":"sv","@value":"Här listas de aktuella vägtrafikrelaterade händelser som Stadsmiljöförvaltningens system har information om.\n\nI dagsläget inkluderas data från Starttillstånd."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-05-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:source":{"@id":"https://catalog.goteborg.se/store/6/resource/483"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Trafikpåverkan"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Uppdaterad med status för påverkan."}},{"@id":"https://catalog.goteborg.se/store/6/resource/488","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/TrafficInformationService/v1.1/help"},"dct:description":{"@language":"sv","@value":"Webbtjänst på data.goteborg.se<>\n<b>Situation.CountryCode</b>\n-\tLandsbetäckning\n<b>Situation.Id</b>\n-\tDatapostens id\n<b>Situation.Deviation.CountyNo</b>\n-\tLänsnummer\n<b>Situation.Deviation.Creator</b>\n-\tKälla till datat\n<b>Situation.Deviation.StartTime</b>\n-\tDataposten är giltig från och med\n<b>Situation.Deviation.EndTime</b>\n-\tDataposten är giltig till och med\n<b>Situation.Deviation.Geometry.SWEREF99TM</b>\n-\tWKT, i koordinatsystem SWEREF99TM\n<b>Situation.Deviation.Geometry.WGS84</b>\n-\tWKT, i koordinatsystem WGS84\n<b>Situation.Deviation.Message</b>\n-\tMeddelandetext\n<b>Situation.Deviation.MessageCode</b>\n-\tMeddelandekod, ex. \"Vägarbeten\"\n<b>Situation.Deviation.MessageCodeValue</b>\n-\tMeddelandekodsvärde, ex. \"resurfacingWork\"\n<b>Situation.Deviation.MessageType</b>\n-\tMeddelandetyp, ex: \"Vägarbete\"\n<b>Situation.Deviation.MessageTypeValue</b>\n-\tMeddelandetypsvärde, ex: \"MaintenanceWorks\"\n<b>Situation.Deviation.SeverityCode</b>\n-\tPåverkansgrad, värden: 1, 2, 4, 5\n<b>Situation.Deviation.SeverityText</b>\n-\tPåverkan: \"Ingen påverkan\", \"Liten påverkan\", \"Stor påverkan\", \"Mycket stor påverkan\"\n<b>Situation.Deviation.LocationDescriptor</b>\n- \tYtterligare detaljer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"TrafficInformationService - v1.1"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}},{"@id":"https://catalog.goteborg.se/store/6/resource/514","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/TrafficInformationService/v1.2/help"},"dct:description":{"@language":"sv","@value":"Webbtjänst på data.goteborg.se<>\n<b>Situation.CountryCode</b>\n-\tLandsbetäckning\n<b>Situation.Id</b>\n-\tDatapostens id\n<b>Situation.Deviation.CountyNo</b>\n-\tLänsnummer\n<b>Situation.Deviation.Creator</b>\n-\tKälla till datat\n<b>Situation.Deviation.StartTime</b>\n-\tDataposten är giltig från och med\n<b>Situation.Deviation.EndTime</b>\n-\tDataposten är giltig till och med\n<b>Situation.Deviation.Geometry.SWEREF99TM</b>\n-\tWKT, i koordinatsystem SWEREF99TM\n<b>Situation.Deviation.Geometry.WGS84</b>\n-\tWKT, i koordinatsystem WGS84\n<b>Situation.Deviation.Message</b>\n-\tMeddelandetext\n<b>Situation.Deviation.MessageCode</b>\n-\tMeddelandekod, ex. \"Vägarbeten\"\n<b>Situation.Deviation.MessageCodeValue</b>\n-\tMeddelandekodsvärde, ex. \"resurfacingWork\"\n<b>Situation.Deviation.MessageType</b>\n-\tMeddelandetyp, ex: \"Vägarbete\"\n<b>Situation.Deviation.MessageTypeValue</b>\n-\tMeddelandetypsvärde, ex: \"MaintenanceWorks\"\n<b>Situation.Deviation.SeverityCode</b>\n-\tPåverkansgrad, värden: 1, 2, 4, 5\n<b>Situation.Deviation.SeverityText</b>\n-\tPåverkan: \"Ingen påverkan\", \"Liten påverkan\", \"Stor påverkan\", \"Mycket stor påverkan\"\n<b>Situation.Deviation.ValidityStatus</b>\n- Meddelandestatus: ”active”, ”suspended”\n<b>Situation.Deviation.LocationDescriptor</b>\n- \tYtterligare detaljer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2018-04-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2018-04-12"},"dct:title":{"@language":"sv","@value":"TrafficInformationService - v1.2"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.goteborg.se/store/6/resource/653","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://data.goteborg.se/TrafficInformationService/v1.3/help"},"dcat:downloadURL":{"@id":"http://data.goteborg.se/TrafficInformationService/v1.2/help"},"dct:description":{"@language":"sv","@value":"Webbtjänst på data.goteborg.se\nSituation.CountryCode\n-\tLandsbeteckning\nSituation.Id\n-\tDatapostens id\nSituation.Deviation.CountyNo\n-\tLänsnummer\nSituation.Deviation.Creator\n-\tKälla till datat\nSituation.Deviation.StartTime\n-\tDataposten är giltig från och med\nSituation.Deviation.EndTime\n-\tDataposten är giltig till och med\nSituation.Deviation.Geometry.SWEREF99TM\n-\tWKT, i koordinatsystem SWEREF99TM\nSituation.Deviation.Geometry.WGS84\n-\tWKT, i koordinatsystem WGS84\nSituation.Deviation.Message\n-\tMeddelandetext\nSituation.Deviation.MessageCode\n-\tMeddelandekod, ex. \"Vägarbeten\"\nSituation.Deviation.MessageCodeValue\n-\tMeddelandekodsvärde, ex. \"roadworks\"\nSituation.Deviation.MessageType\n-\tMeddelandetyp, ex: \"Vägarbete\"\nSituation.Deviation.MessageTypeValue\n-\tMeddelandetypsvärde, ex: \"MaintenanceWorks\"\nSituation.Deviation.SeverityCode\n-\tPåverkansgrad, värden: 1, 2, 4, 5\nSituation.Deviation.SeverityText\n-\tPåverkan: \"Ingen påverkan\", \"Liten påverkan\", \"Stor påverkan\", \"Mycket stor påverkan\"\nSituation.Deviation.ValidityStatus\n- Meddelandestatus: \"unactive\", ”active”, ”suspended”, \"finished\"\nSituation.Deviation.LocationDescriptor\n- Beskrivning, ex \"Grävning vid Hamngatan 4\"\nSituation.Deviation.Lat\n- Latitud WGS 84 decimal\nSituation.Deviation.Long\n- Longitud WGS 84 decimal\nSituation.Deviation.VersionTime\n- Senast uppdaterad\nSituation.Deviation.CreationTims\n- Skapad\nSituation.Deviation.TrafficRestrictionType\n- Påverkanstyp, ex \"Väg avstängd\", \"Mötande trafik\"\nSituation.Deviation.Schedule\n- Start och sluttid för tillståndet, samt schemalagda arbetstider.\n\n\n"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2019-05-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"TrafficInformationService - v1.3"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:38a376ec856bb465f83d015cfda468c05c526d7d31d65195e502f0b9f2285f6b"},{"@graph":[{"@id":"_:3b384f915aa4dd854bd17da498729c480e1f28245a0af2b1d26a6e9590f16dc2_b0n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2022-12-21"}},{"@id":"_:3b384f915aa4dd854bd17da498729c480e1f28245a0af2b1d26a6e9590f16dc2_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46313650000"}},{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identif