"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/86162"},"dct:description":{"@language":"sv","@value":"Den här datamängden är ett projekt där Göteborg & Co deltog, och syftet var att samla information om hur människor rör sig till och från evenemangsstråket som inkluderar Liseberg, Ullevi och Valhalla. Målet var att förstå hur besökare tar sig till dessa platser och evenemang. (https://www.goteborg.com/guider/evenemangsstraket)\n\nDatan kommer från WiFi-mätare som staden har installerat i dessa områden. Det visar hur många som går, cyklar eller kör bil, samt hur lång tid resan tar för varje grupp. Informationen samlades in mellan 1 september 2023 och 1 september 2024."},"dct:issued":{"@type":"xsd:date","@value":"2024-12-02"},"dct:publisher":{"@id":"https://catalog.goteborg.se/store/6/resource/86162"},"dct:spatial":{"@id":"https://sws.geonames.org/2711533"},"dct:temporal":{"@id":"_:4980ff1dfa0c31f36da36f89215060b139e323067c9e315a6c04aff95e3816a8_b0n0"},"dct:title":{"@language":"sv","@value":"Flödesmätningar för projektet Green City Zone 2023-2024"},"http://schema.org/offers":{"@id":"_:4980ff1dfa0c31f36da36f89215060b139e323067c9e315a6c04aff95e3816a8_b1n0"}},{"@id":"https://catalog.goteborg.se/store/6/resource/86162","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://www.goteborg.com/"},"foaf:mbox":{"@id":"mailto:anders.fahl@goteborg.com"},"foaf:name":{"@language":"sv","@value":"Göteborg & Co"}},{"@id":"https://catalog.goteborg.se/store/6/resource/86163","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"FloUllLis.csv"},{"@id":"https://catalog.goteborg.se/store/6/resource/86164","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.goteborg.se/store/6/resource/8