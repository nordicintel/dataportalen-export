ice för Styr & Ställ 2025-10-31. \n\nDatamängden för Styr & Ställ finns fortfarande tillgänglig direkt från leverantörens Maps OpenAPI-specifikation och GBFS-flöden på Github: https://github.com/nextbike/api-doc?tab=readme-ov-file\n\nTjänsten visar positioner, lediga cyklar samt lediga cykelställ för Göteborgs lånecykelsystem Styr&Ställ."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"http://sws.geonames.org/2711533/"},"dct:title":{"@language":"sv","@value":"Styr & Ställ"}},{"@id":"https://catalog.goteborg.se/store/6/resource/48808","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Göteborgs Stad Stadsmiljöförvaltningen"}},{"@id":"https://catalog.goteborg.se/store/6/resource/99622","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://github.com/nextbike/api-doc?tab=readme-ov-file"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Nextbike Maps OpenAPI"}}],"@id":"urn:source:f4f33cc645bc3cfe97911a3dd970e312ddbc9cace368338d97a4c5d7b200b36a"},{"@graph":[{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46313650000"}},{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.4697265625 57.89062140809806,12.431030273437502 57.89062140809806,12.431030273437502 57.44406263860647,11.4697265625 57.44406263860647,11.4697265625 57.89062140809806))"}},{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2019-11-19"}},{"@id":"http://dataportal.se/organisation/SE2120001355","@type":"foaf:Agent","dct:identifier":"2120001355","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:stadsledningskontoret@stadshuset.goteborg.se"},"foaf:name":{"@language":"sv","@value":"Göteborgs stad"},"foaf:page":{"@id":"https://goteborg.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.goteborg.se/store/6/resource/1"}},{"@id":"https://catalog.goteborg.se/store/6/resource/100848","@type":"foaf:Agent","foaf:name":{"@language":"sv","@value":"Göteborgs Stads Stadsbyggnadskontoret"}},{"@id":"https://catalog.goteborg.se/store/6/resource/617","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sbk@sbk.goteborg.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b0n0"}},{"@id":"https://catalog.goteborg.se/store/6/resource/718","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.goteborg.se/store/6/resource/617"},"dcat:distribution":{"@id":"https://catalog.goteborg.se/store/6/resource/719"},"dcat:keyword":[{"@language":"en","@value":"citymap basemap geodata"},{"@language":"sv","@value":"stadskarta bakgrundskarta geodata"}],"dcat:landingPage":{"@id":"https://goteborg.se/wps/portal?uri=gbglnk%253a2015816171319546"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.goteborg.se/store/6/resource/100848"},"dct:description":[{"@language":"en","@value":"The City map is a generalized map showing the texture of Gothenburg.\nPrimarily it is used as a basemap for visualizing diffrent types of data, and for general orientation. It is available in two forms, color or grayscale. The map contains general information about landcover, infrastucture, hydrography, buildings, address, streetnames, administrative units and some complementary text for orientation.\n"},{"@language":"sv","@value":"Stadskartan är en översiktlig karta som beskriver Göteborg.\nKartan kan primärt användas som bakgrund till verksamhetsdata samt för översiktlig orientering i staden.\nStadskartan finns i två varianter, färg och gråtonad. Den innehåller generell information om mark, kommunikation, hydrografi, byggnader, adressnummer och gatunamn, administrativ indelning och övrig orienterande  text."}],"dct:issued":{"@type":"xsd:date","@value":"2019-11-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001355"},"dct:spatial":{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b1n0"},"dct:temporal":{"@id":"_:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409_b2n0"},"dct:title":{"@language":"sv","@value":"Stadskarta"},"foaf:page":[{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/City_planning_authority_open_geodata__terms_and_information_en.pdf"},{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/Stadsbyggnadsf%C3%B6rvaltningens_%C3%B6ppna_geodata_-_Villkor.pdf"}],"http://schema.org/diagram":{"@id":"https://catalog.goteborg.se/store/6/resource/41246"}},{"@id":"https://catalog.goteborg.se/store/6/resource/719","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opengeodata.goteborg.se/services/stadskarta/wms/v4"},"dct:description":[{"@language":"en","@value":"HTTP:OGC:WMS"},{"@language":"sv","@value":"Stadskartan är en översiktlig karta som beskriver Göteborg. Kartan kan primärt användas som bakgrund till verksamhetsdata samt för översiktlig orientering i staden. Stadskartan finns i två varianter, färg och gråtonad. Den innehåller generell information om mark, kommunikation, hydrografi, byggnader, adressnummer och gatunamn, administrativ indelning och övrig orienterande text."}],"dct:issued":{"@type":"xsd:date","@value":"2019-11-18"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Stadskarta WMS"},"foaf:page":[{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/City_planning_authority_open_geodata__terms_and_information_en.pdf"},{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/Stadsbyggnadsf%C3%B6rvaltningens_%C3%B6ppna_geodata_-_Villkor.pdf"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/City_planning_authority_open_geodata__terms_and_information_en.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"City_planning _authority_open_geodata__terms_and_information_en.pdf linked"}},{"@id":"https://geodata-external.sbk.goteborg.se/dokument/oppnadata/Stadsbyggnadsf%C3%B6rvaltningens_%C3%B6ppna_geodata_-_Villkor.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Stadsbyggnadsförvaltningens öppna geodata - Villkor länkad"}}],"@id":"urn:source:f5181d7ab4f3157583f2117a0064d4f6b277f0e41aee92c90c51841d323ef409"}]}
