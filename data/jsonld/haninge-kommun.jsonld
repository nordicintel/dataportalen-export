s noggrannhet."},"dct:issued":{"@type":"xsd:date","@value":"2020-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Polygonpunkter - Stompunkter noggranna i plan (*gpkg)"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://haninge.entryscape.net/store/7/resource/119","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.haninge.se/services/karta_open/ows?SERVICE=WFS&REQUEST=GetFeature&typeName=polygonpunkter&outputFormat=xlsx&CRS=EPSG:3011"},"dcat:downloadURL":{"@id":"https://karta.haninge.se/services/karta_open/ows?SERVICE=WFS&REQUEST=GetFeature&typeName=polygonpunkter&outputFormat=xlsx&CRS=EPSG:3011"},"dct:description":{"@language":"sv","@value":"https://geodata.haninge.se/ows/KartaOpen?SERVICE=WFS&REQUEST=GetFeature&typeName=polygonpunkter&outputFormat=xlsx&CRS=EPSG:3011"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2020-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Polygonpunkter - Stompunkter noggranna i plan (*xlsx)"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://haninge.entryscape.net/store/7/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:kartor@haninge.se"},{"@id":"mailto:trafik@haninge.se"}]},{"@id":"https://haninge.entryscape.net/store/7/resource/97","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Stompunkterna utgör ett viktigt underlag för all mätning i samband med utsättning, detaljmätning, avvägning, kartframställning och fastighetsbildning. Stompunkter är ett samlingsnamn för Höjdfixar och Polygonpunkter (se nedan).\nDu kan själv ta ut Polygonpunkter och Höjdfixar på Haninge kommuns portal för öppna data. Om du behöver en enstaka punkt kan du gå in i vår karta och tända upp det lager du är intresserad av och sen klicka på punkten. \nPolygonpunkter är noggrant inmätta och beräknade så att koordinatvärdena har en hög lägesnoggrannhet i plan, en del polygonpunkter har även en höjd med centimeters noggrannhet.\nHöjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan.\nDet åligger alltid utföraren att kontrollera mätpunkternas riktighet.\n"},"dct:title":{"@language":"sv","@value":"Stompunkter"}},{"@id":"https://haninge.entryscape.net/store/7/resource/98","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://haninge.entryscape.net/store/7/resource/4"},"dcat:distribution":[{"@id":"https://haninge.entryscape.net/store/7/resource/103"},{"@id":"https://haninge.entryscape.net/store/7/resource/104"},{"@id":"https://haninge.entryscape.net/store/7/resource/105"},{"@id":"https://haninge.entryscape.net/store/7/resource/106"},{"@id":"https://haninge.entryscape.net/store/7/resource/107"},{"@id":"https://haninge.entryscape.net/store/7/resource/108"},{"@id":"https://haninge.entryscape.net/store/7/resource/109"},{"@id":"https://haninge.entryscape.net/store/7/resource/110"},{"@id":"https://haninge.entryscape.net/store/7/resource/111"},{"@id":"https://haninge.entryscape.net/store/7/resource/112"},{"@id":"https://haninge.entryscape.net/store/7/resource/113"},{"@id":"https://haninge.entryscape.net/store/7/resource/114"},{"@id":"https://haninge.entryscape.net/store/7/resource/115"},{"@id":"https://haninge.entryscape.net/store/7/resource/116"},{"@id":"https://haninge.entryscape.net/store/7/resource/117"},{"@id":"https://haninge.entryscape.net/store/7/resource/118"},{"@id":"https://haninge.entryscape.net/store/7/resource/119"}],"dcat:keyword":[{"@language":"sv","@value":"CSV"},{"@language":"sv","@value":"GeoJSON"},{"@language":"sv","@value":"GeoPackage"},{"@language":"sv","@value":"Höjddata"},{"@language":"sv","@value":"Höjdfixar"},{"@language":"sv","@value":"KML"},{"@language":"sv","@value":"MIF"},{"@language":"sv","@value":"Nedladdningstjänster"},{"@language":"sv","@value":"Polygonspunkter"},{"@language":"sv","@value":"Shape"},{"@language":"sv","@value":"Stompunkter"},{"@language":"sv","@value":"TAB"},{"@language":"sv","@value":"WFS"},{"@language":"sv","@value":"WMS"},{"@language":"sv","@value":"gpkg"},{"@language":"sv","@value":"Öppna data"},{"@language":"sv","@value":"Öppna geodata"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2020-03-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000084"},"dct:description":{"@language":"sv","@value":"Stompunkterna utgör ett viktigt underlag för all mätning i samband med utsättning, detaljmätning, avvägning, kartframställning och fastighetsbildning.\n\nPolygonpunkter är noggrant inmätta och beräknade så att koordinatvärdena har en hög lägesnoggrannhet i plan, en del polygonpunkter har även en höjd med centimeters noggrannhet.\n\nHöjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan.\n\nÖvrig beskrivning finns i dokumentation."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000084"},"dct:spatial":{"@id":"http://sws.geonames.org/2707952"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/elevation"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/location"}],"dct:title":{"@language":"sv","@value":"Stompunkter - Nedladdningstjänster"},"dct:type":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/service"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"}],"foaf:page":{"@id":"https://haninge.entryscape.net/store/7/resource/97"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Uppdateringar körs ut en gång i veckan. Mätning ute i fält sker vid behov."},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:2c34d189e69a75dbe84a9e6038c580903977713d49653fb7efe8b793dc3dd4c1_b0n0"}}],"@id":"urn:source:2c34d189e69a75dbe84a9e6038c580903977713d49653fb7efe8b793dc3dd4c1"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000084","@type":"foaf:Agent","dct:identifier":"2120000084","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:haningekommun@haninge.se"},"foaf:name":{"@language":"sv","@value":"Haninge kommun"},"foaf:page":{"@id":"https://www.haninge.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://haninge.entryscape.net/store/7/resource/3"}},{"@id":"https://haninge.entryscape.net/store/7/resource/44","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://haninge.entryscape.net/store/7/resource/45"},"dcat:keyword":[{"@language":"sv","@value":"kolada"},{"@language":"sv","@value":"nyckeltal"},{"@language":"sv","@value":"publiceringsverktyg"},{"@language":"sv","@value":"skl"}],"dct:description":{"@language":"sv","@value":"Haninge kommuns nyckeltal som finns publicerade i Kommun- och landstingsdatabasen (Kolada). "},"dct:pu