{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:1bf9ef46572075a20bcd0a52ababadc772d4a80a5be363fc1410318583cdf644_b0n0","@type":"dct:PeriodOfTime","http://schema.org/startDate":{"@type":"xsd:date","@value":"2020-04-15"}},{"@id":"_:1bf9ef46572075a20bcd0a52ababadc772d4a80a5be363fc1410318583cdf644_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/originator"}},{"@id":"http://dataportal.se/organisation/SE2120000084","@type":"foaf:Agent","dct:identifier":"2120000084","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:haningekommun@haninge.se"},"foaf:name":{"@language":"sv","@value":"Haninge kommun"},"foaf:page":{"@id":"https://www.haninge.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://haninge.entryscape.net/store/7/resource/3"}},{"@id":"https://haninge.entryscape.net/store/7/resource/120","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://haninge.entryscape.net/store/7/resource/4"},"dcat:distribution":{"@id":"https://haninge.entryscape.net/store/7/resource/121"},"dcat:keyword":[{"@language":"sv","@value":"Höjdfixar"},{"@language":"sv","@value":"Polygonspunkter"},{"@language":"sv","@value":"Stompunkter"},{"@language":"sv","@value":"Visningstjänst"},{"@language":"sv","@value":"WFS"},{"@language":"sv","@value":"WMS"},{"@language":"sv","@value":"Öppna data"},{"@language":"sv","@value":"Öppna geodata"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:created":{"@type":"xsd:date","@value":"2020-03-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000084"},"dct:description":{"@language":"sv","@value":"Stompunkterna utgör ett viktigt underlag för all mätning i samband med utsättning, detaljmätning, avvägning, kartframställning och fastighetsbildning.\n\nPolygonpunkter är noggrant inmätta och beräknade så att koordinatvärdena har en hög lägesnoggrannhet i plan, en del polygonpunkter har även en höjd med centimeters noggrannhet.\n\nHöjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan.\n\nÖvrig beskrivning finns i dokumentation."},"dct:issued":{"@type":"xsd:date","@value":"2020-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000084"},"dct:spatial":{"@id":"http://sws.geonames.org/2707952"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/elevation"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/location"}],"dct:temporal":{"@id":"_:1bf9ef46572075a20bcd0a52ababadc772d4a80a5be363fc1410318583cdf644_b0n0"},"dct:title":"Stompunkter - Visningstjänster","dct:type":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResourceType/service"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"}],"foaf:page":{"@id":"https://haninge.entryscape.net/store/7/resource/97"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Uppdateringar körs ut en gång i veckan. Mätning ute i fält sker vid behov."},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:1bf9ef46572075a20bcd0a52ababadc772d4a80a5be363fc1410318583cdf644_b1n0"}},{"@id":"https://haninge.entryscape.net/store/7/resource/121","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.haninge.se/services/karta_open/ows"},"dct:description":{"@language":"sv","@value":"Stompunkterna utgör ett viktigt underlag för all mätning i samband med utsättning, detaljmätning, avvägning, kartframställning och fastighetsbildning. Polygonpunkter är noggrant inmätta och beräknade så att koordinatvärdena har en hög lägesnoggrannhet i plan, en del polygonpunkter har även en höjd med centimeters noggrannhet. Höjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan. Övrig beskrivning finns i dokumentation."},"dct:issued":{"@type":"xsd:date","@value":"2020-04-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Stompunkter - Hödjfixar och Polygonpunkter (*WMS/*WFS)"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://haninge.entryscape.net/store/7/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stadsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:kartor@haninge.se"},{"@id":"mailto:trafik@haninge.se"}]},{"@id":"https://haninge.entryscape.net/store/7/resource/97","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Stompunkterna utgör ett viktigt underlag för all mätning i samband med utsättning, detaljmätning, avvägning, kartframställning och fastighetsbildning. Stompunkter är ett samlingsnamn för Höjdfixar och Polygonpunkter (se nedan).\nDu kan själv ta ut Polygonpunkter och Höjdfixar på Haninge kommuns portal för öppna data. Om du behöver en enstaka punkt kan du gå in i vår karta och tända upp det lager du är intresserad av och sen klicka på punkten. \nPolygonpunkter är noggrant inmätta och beräknade så att koordinatvärdena har en hög lägesnoggrannhet i plan, en del polygonpunkter har även en höjd med centimeters noggrannhet.\nHöjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan.\nDet åligger alltid utföraren att kontrollera mätpunkternas riktighet.\n"},"dct:title":{"@language":"sv","@value":"Stompunkter"}}],"@id":"urn:source:1bf9ef46572075a20bcd0a52ababadc772d4a80a5be363fc1410318583cdf644"},{"@graph":[{"@id":"_:2c34d189e69a75dbe84a9e6038c580903977713d49653fb7efe8b793dc3dd4c1_b0n0","@type":"http://www.w3.org/ns/prov#Attribution","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/originator"}},{"@id":"http://dataportal.se/organisation/SE2120000084","@type":"foaf:Agent","dct:identifier":"2120000084","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:haningekommun@haninge.se"},"foaf:name":{"@language":"sv","@value":"Haninge kommun"},"foaf:page":{"@id":"https://www.haninge.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://haninge.entryscape.net/store/7/resource/3"}},{"@id":"https://haninge.entryscape.net/store/7/resource/103","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://karta.haninge.se/services/karta_open/ows?SERVICE=WFS&outputFormat=application/vnd.geo+json&REQUEST=GetFeature&typeName=hojdfixar&CRS=EPSG:3011"},"dcat:downloadURL":{"@id":"https://karta.haninge.se/services/karta_open/ows?SERVICE=WFS&outputFormat=application/vnd.geo+json&REQUEST=GetFeature&typeName=hojdfixar&CRS=EPSG:3011"},"dct:description":{"@language":"sv","@value":"Höjdfixar är finavvägda och har hög noggrannhet i höjd men kan ej användas för inmätning i plan.\n\nReferenssystem\nI plan: SWEREF99 18 00.  (2009 övergick Haninge kommun att arbeta i referenssystem Sweref 99 18 00.\nI höjd: RH 2000. Sedan 1 januari 2013 används höjdsystemet RH 2000. (Skillnaden mellan det tidigare RH 00 och RH 2000 varierar från +47 till +54 cm)."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2020-04-08"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":