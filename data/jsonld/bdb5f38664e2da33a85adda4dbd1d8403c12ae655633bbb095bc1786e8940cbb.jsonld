on/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset contains geographic information on all buildings within Trollhättan municipality. It includes precise building outlines (lines) covering the entire municipal area. The data is ideal for use in analysis, planning, and visualization of building structures in Trollhättan."},{"@language":"sv","@value":"Byggnadslinjer i Trollhättan stad innehåller geografisk information över samtliga byggnader i kommunen. Datasetet består av byggnadernas fotavtryck (linjer) och täcker hela kommunens geografiska område. Informationen kan användas för analys, planering och visualisering av byggnadsstrukturer inom Trollhättans kommun."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b1n0"},"dct:title":[{"@language":"en","@value":"Building Outlines"},{"@language":"sv","@value":"Byggnader ytterlinjer"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/115","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"byggnaderlinjer.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/116","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/115"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/115"},"dct:description":[{"@language":"en","@value":"This dataset contains geographic information on all buildings within Trollhättan municipality. It includes precise building outlines (lines) covering the entire municipal area. The data is ideal for use in analysis, planning, and visualization of building structures in Trollhättan."},{"@language":"sv","@value":"Det här datasetet innehåller geografisk information om samtliga byggnader inom Trollhättans kommun. Det inkluderar byggnadskonturer (linjer) som täcker hela kommunens geografiska område. Datan är idealisk för användning inom analys, planering och visualisering av byggnadsstrukturer i Trollhättan."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Building Outlines"},{"@language":"sv","@value":"Byggnader ytterlinje"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b4n0"}}],"@id":"urn:source:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650"},{"@graph":[{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-01-01"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-12-17 06:13:48"}},{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/144","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/56"},"dcat:distribution":[{"@id":"https://catalog.trollhattan.se/store/1/resource/148"},{"@id":"https://catalog.trollhattan.se/store/1/resource/150"}],"dcat:keyword":["Ekonomi","Faktura","Fakturor","Inköp","Leverantörsreskontra","Reskontra","Upphandling","Utgift","accounts receivable","invoices","openspending","payments","procured services","spending"],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":["I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda.","The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."],"dct:issued":{"@type":"xsd:date","@value":"2024-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-02-21 06:13:46"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":{"@id":"https://sws.geonames.org/2667302"},"dct:temporal":{"@id":"_:194d37b61cdaafa09e2257d92eed5832aee1407bb9bed05c935ab00a2ceed7b0_b0n0"},"dct:title":"Leverantörsfakturor 2025","http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/148","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.trollhattan.se/store/1/resource/152"},{"@id":"https://catalog.trollhattan.se/store/1/resource/153"},{"@id":"https://catalog.trollhattan.se/store/1/resource/154"},{"