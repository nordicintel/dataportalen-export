jer inom Trollhättans kommun. Gränserna representerar fastigheters avgränsningar med specificerad kvalitet utifrån färgskalan grön, gul och röd, och kan användas för en första förståelse för hur trovärdiga gränserna är."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Property Boundaries with quality Indicators"},{"@language":"sv","@value":"Fastighetslinjer med gränskvalité"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1a516c95ce521cfb7093f0036e64839d812ebc5b825f5b8f753a249b4fb6398c_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1a516c95ce521cfb7093f0036e64839d812ebc5b825f5b8f753a249b4fb6398c_b4n0"}}],"@id":"urn:source:1a516c95ce521cfb7093f0036e64839d812ebc5b825f5b8f753a249b4fb6398c"},{"@graph":[{"@id":"_:1daee81a3ce1021cba57632c3c6ac2b2d31bd0ea830adfd0216d1bf70e0cd94f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:1daee81a3ce1021cba57632c3c6ac2b2d31bd0ea830adfd0216d1bf70e0cd94f_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:1daee81a3ce1021cba57632c3c6ac2b2d31bd0ea830adfd0216d1bf70e0cd94f_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:1daee81a3ce1021cba57