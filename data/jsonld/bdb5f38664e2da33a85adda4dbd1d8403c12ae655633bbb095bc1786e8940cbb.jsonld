"@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0520-496777"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/126","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":{"@id":"https://catalog.trollhattan.se/store/1/resource/128"},"dcat:keyword":[{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Land information"},{"@language":"en","@value":"Land use boundaries"},{"@language":"en","@value":"Land use"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Terrain transitions"},{"@language":"en","@value":"Terrain"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Landinformation"},{"@language":"sv","@value":"Markanvändning"},{"@language":"sv","@value":"Markkanter"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Terrängövergångar"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides geographic information on land use boundaries within Trollhättan municipality. These boundaries represent transitions between different surfaces, such as roads, pedestrian and cycling paths, and other land use types. The dataset is useful for planning, analysis, and visualization of transport networks and land structures. It is particularly valuable for urban planning and infrastructure projects."},{"@language":"sv","@value":"Det här datasetet innehåller geografisk information om markkanter inom Trollhättans kommun. Markkanterna representerar övergångar mellan olika ytor, såsom väg, gång- och cykelvägar, samt andra typer av markanvändning. Datasetet är användbart för planering, analys och visualisering av transportnät och markstrukturer. Det är särskilt värdefullt för samhällsplanering och infrastrukturprojekt."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b1n0"},"dct:title":[{"@language":"en","@value":"Land Use Boundaries in Trollhättan Municipality"},{"@language":"sv","@value":"Markkanter i Trollhättans kommun"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/127","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"markkant.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/128","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/127"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/127"},"dct:description":[{"@language":"en","@value":"This dataset provides geographic information on land use boundaries within Trollhättan municipality. Land use boundaries represent transitions between different land types or areas and are useful for planning, analysis, and visualization of land use and terrain. The dataset is a valuable resource for urban planning and geographic analysis."},{"@language":"sv","@value":"Det här datasetet innehåller geografisk information om markkanter inom Trollhättans kommun. Markkanter representerar övergångar mellan olika marktyper eller områden och är användbara för planering, analys och visualisering av markanvändning och terräng. Datasetet är ett värdefullt verktyg för samhällsplanering och geografisk analys."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Land Use Boundaries in Trollhättan Municipality"},{"@language":"sv","@value":"Markkanter i Trollhättans kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf_b4n0"}}],"@id":"urn:source:c7e01afb20d4bd904b3ae0521408e3f0ee11622c63c4748a0ec4d961d1792bdf"},{"@graph":[{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0520-496777"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/109","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":{"@id":"https://catalog.trollhattan.se/store/1/resource/113"},"dcat:keyword":[{"@language":"en","@value":"Administrative boundaries"},{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"District boundaries"},{"@language":"en","@value":"Districts"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Official boundaries"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Landmärken"},{"@language":"sv","@value":"Namnsatta platser"},{"@language":"sv","@value":"Platsnamn"},{"@language":"sv","@value":"Rondeller"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Vattendrag"},{"@language":"sv","@value":"Öar"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides geographic information on named locations within Trollhättan, including roundabouts, islands, waterways, schools, and other significant landmarks. It encompasses both natural and man-made features and is valuable for mapping services, urban planning, and various types of analysis. The names are officially designated and are regularly updated to ensure accuracy and relevance."},{"@language":"sv","@value":"Platsnamn i Trollhättan stad innehåller geografisk information över namnsatta platser inom kommunen, såsom rondeller, öar, vattendrag, skolor, och andra betydelsefulla landmärken. Datasetet omfattar både naturliga och byggda objekt och är användbart för karttjänster, samhällsplanering och olika typer av analys. Platsnamnen är beslutade och uppdateras regelbundet för att säkerställa korrekthet och relevans."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b1n0"},"dct:title":[{"@language":"en","@value":"Named locations"},{"@language":"sv","@value":"Platsnamn"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/112","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"platsnamn.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/113","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/112"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/112"},"dct:description":{"@language":"sv","@value":"Platsnamn i Trollhättan stad innehåller geografisk information över namnsatta platser inom kommunen, såsom rondeller, öar, vattendrag, skolor, och andra betydelsefulla landmärken. Datasetet omfattar både naturliga och byggda objekt och är användbart för karttjänster, samhällsplanering och olika typer av analys. Platsnamnen är beslutade och uppdateras regelbundet för att säkerställa korrekthet och relevans."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":{"@language":"sv","@value":"Namngivna platser i Trollhättan"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1_b4n0"}}],"@id":"urn:source:c88b9d48acfe5f7a9d078a8987f89985c005b9b2f4829d514b0ea312b74c8de1"},{"@graph":[{"@id":"_:c980fae2b1db6c95b32714b57d8ea1bd2706ce3ffc25a883af2210078bbd306b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.2