aset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":{"@id":"https://catalog.trollhattan.se/store/1/resource/108"},"dcat:keyword":[{"@language":"en","@value":"Building footprints"},{"@language":"en","@value":"Building polygons"},{"@language":"en","@value":"Buildings"},{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Administrativa gränser"},{"@language":"sv","@value":"Arkitektur"},{"@language":"sv","@value":"Byggnader"},{"@language":"sv","@value":"Byggnadsytor"},{"@language":"sv","@value":"Fotavtryck"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Planering"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Samhällsplanering"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset contains geographic information on all buildings within Trollhättan municipality. It includes precise building outlines (polygons) covering the entire municipal area. The data is ideal for use in analysis, planning, and visualization of building structures in Trollhättan."},{"@language":"sv","@value":"Byggnadsytor i Trollhättan stad innehåller geografisk information över samtliga byggnader i kommunen. Datasetet består av byggnadernas fotavtryck (polygoner) och täcker hela kommunens geografiska område. Informationen kan användas för analys, planering och visualisering av byggnadsstrukturer inom Trollhättans kommun."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65_b1n0"},"dct:title":[{"@language":"en","@value":"Building Footprints"},{"@language":"sv","@value":"Byggnader ytor"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/107","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"byggnaderytor.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/108","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/107"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/107"},"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dct:description":{"@language":"sv","@value":"Byggnadsytor i Trollhättan stad innehåller geografisk information över samtliga byggnader i kommunen. Datasetet består av byggnadernas fotavtryck (polygoner) och täcker hela kommunens geografiska område. Informationen kan användas för analys, planering och visualisering av byggnadsstrukturer inom Trollhättans kommun"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Byggnadsytor"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65_b4n0"}}],"@id":"urn:source:09d6769eb0abd76a7135fcab2cdf97526468c049876078f84ac27ddd60758e65"},{"@graph":[{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0520-496777"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/129","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":[{"@id":"https://catalog.trollhattan.se/store/1/resource/131"},{"@id":"https://catalog.trollhattan.se/store/1/resource/133"}],"dcat:keyword":[{"@language":"en","@value":"Borehole points"},{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Geotechnical surveys"},{"@language":"en","@value":"Geotechnics"},{"@language":"en","@value":"Land information"},{"@language":"en","@value":"Land use"},{"@language":"en","@value":"Soil analysis"},{"@language":"en","@value":"Soil conditions"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Survey data"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Borrpunkter"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Geoteknik"},{"@language":"sv","@value":"Geotekniska undersökningar"},{"@language":"sv","@value":"Markanalys"},{"@language":"sv","@value":"Markanvändning"},{"@language":"sv","@value":"Markförhållanden"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Undersökningsdata"},{"@language":"sv","@value":"Undersökningsområden"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset contains information on geotechnical surveys conducted within Trollhättan municipality. It includes both survey areas and borehole points with detailed geographic information. The survey areas represent locations where geotechnical surveys have been conducted, while the borehole points provide data from specific measurement sites. The dataset is useful for analysis and planning in construction, infrastructure, and soil condition studies."},{"@language":"sv","@value":"Det här datasetet innehåller information om geotekniska undersökningar som utförts inom Trollhättans kommun. Datasetet inkluderar både undersökningsområden och borrpunkter med detaljerad geografisk information. Undersökningsområden visar ytor där geotekniska undersökningar har genomförts, medan borrpunkterna innehåller data från specifika mätplatser. Datasetet är användbart för analyser och planering inom byggnation, infrastruktur och markförhållanden."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b1n0"},"dct:title":[{"@language":"en","@value":"Geotechnical Surveys in Trollhättan Municipality"},{"@language":"sv","@value":"Geotekniska undersökningar i Trollhättans kommun"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/130","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"Geot_und_ytor.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/131","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/130"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/130"},"dct:description":[{"@language":"en","@value":"This dataset contains geographic information on survey areas where geotechnical investigations have been conducted within Trollhättan municipality. The areas represent locations that have been the subject of soil condition studies. The dataset is useful for planning and analysis in construction, infrastructure, and land management."},{"@language":"sv","@value":"Det här datasetet innehåller geografisk information om undersökningsområden där geotekniska undersökningar har genomförts inom Trollhättans kommun. Områdena representerar ytor som har varit föremål för analyser av markförhållanden. Datasetet är användbart för planering och analys inom byggnation, infrastruktur och markförvaltning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-01T13:24:05.803Z"},"dct:title":[{"@language":"en","@value":"Geotechnical Survey Areas in Trollhättan Municipality"},{"@language":"sv","@value":"Geotekniska undersökningsområden i Trollhättans kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/132","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"Borrpunkter.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/133","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/132"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/132"},"dct:description":[{"@language":"en","@value":"This dataset contains geographic information on borehole points from geotechnical surveys conducted within Trollhättan municipality. Each borehole point represents a specific location where soil condition data has been collected. The dataset is useful for detailed analysis and planning in construction, infrastructure, and geotechnics."},{"@language":"sv","@value":"Det här datasetet innehåller geografisk information om borrpunkter från geotekniska undersökningar inom Trollhättans kommun. Varje borrpunkt representerar en specifik plats där data om markförhållanden har insamlats. Datasetet är användbart för detaljerad analys och planering inom byggnation, infrastruktur och geoteknik."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Geotechnical Borehole Points in Trollhättan Municipality"},{"@language":"sv","@value":"Geotekniska borrpunkter i Trollhättans kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176_b4n0"}}],"@id":"urn:source:0e1fb424cb590fc152cc82443d9fa39b6d8cdb88ae8e3f52c974fc7edcb16176"},{"@graph":[{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:142725fb6c5d28de414e7c163ca4417e8fc2f750228df5ddccb08151d7097650_b4n0","ht