@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0520-496777"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/134","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":[{"@id":"https://catalog.trollhattan.se/store/1/resource/136"},{"@id":"https://catalog.trollhattan.se/store/1/resource/138"}],"dcat:keyword":[{"@language":"en","@value":"100-year rain"},{"@language":"en","@value":"50-year rain"},{"@language":"en","@value":"500-year rain"},{"@language":"en","@value":"Climate adaptation"},{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"Flood mapping"},{"@language":"en","@value":"Flow velocity"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Maximum depth"},{"@language":"en","@value":"Risk analysis"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Urban planning"},{"@language":"en","@value":"Water flow"},{"@language":"sv","@value":"100-årsregn"},{"@language":"sv","@value":"50-årsregn"},{"@language":"sv","@value":"500-årsregn"},{"@language":"sv","@value":"Flödeshastighet"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Klimatanpassning"},{"@language":"sv","@value":"Maxdjup"},{"@language":"sv","@value":"Riskanalys"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Vattenflöden"},{"@language":"sv","@value":"Öppna data"},{"@language":"sv","@value":"Översvämning"},{"@language":"sv","@value":"Översvämningskartering"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"The flood mapping for Trollhättan municipality is based on modeling of extreme rainfall events to assess the risks and impacts of flooding from 2019. The dataset consists of two main components:\n\nFlow Velocity\nThis dataset presents water flow speeds during various flood scenarios. The flow velocities are visualized as geometries highlighting areas where water moves fastest and how these flows interact with the surrounding environment. The mapping includes simulations for 50-, 100-, and 500-year rain events, offering crucial insights for infrastructure planning and emergency preparedness.\n\nMaximum Depth\nThis dataset displays the maximum water depth reached during floods under the same scenarios (50-, 100-, and 500-year rain events). Maximum depths are geographically visualized to pinpoint high-risk areas, aiding in risk management and climate adaptation planning.\n\nThese datasets are useful for urban planning, infrastructure development, risk assessment, and preparedness for climate change. The information is also a critical resource for researchers and policymakers aiming to develop long-term strategies to mitigate flood damage."},{"@language":"sv","@value":"Översvämningskarteringen från 2019 för Trollhättans kommun baseras på modellering av extrema regn för att kartlägga risker och konsekvenser av översvämningar. Datasetet består av två huvudsakliga delar:\n\nFlödeshastighet\nDenna datamängd visar vattenflöden och deras hastigheter under olika översvämningsscenarier. Flödeshastigheterna presenteras som geometrier som anger var vattnet rör sig snabbast och hur dessa flöden påverkar omgivningen. Kartläggningen inkluderar simuleringar för 50-, 100- och 500-årsregn och ger viktiga insikter för beredskap och planering av infrastruktur.\n\nMaxdjup\nDenna datamängd visar det maximala vattendjupet som uppstår vid översvämningar under samma scenarier (50-, 100- och 500-årsregn). Maxdjupen visualiseras geografiskt för att identifiera områden med särskilt hög översvämningsrisk och för att stödja riskhantering och klimatanpassning.\n\nDessa datamängder är användbara för samhällsplanering, infrastrukturutveckling, riskanalyser och beredskap inför klimatförändringar. Informationen kan även användas av forskare och beslutsfattare för att skapa långsiktiga strategier för att minska översvämningsskador."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b1n0"},"dct:title":[{"@language":"en","@value":"Flood Mapping 2019 in Trollhättan Municipality"},{"@language":"sv","@value":"Översvämningskartering 2019 i Trollhättans kommun"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/135","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"Flodeshastighet.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/136","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/135"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/135"},"dct:description":[{"@language":"en","@value":"This dataset presents water flow speeds during various flood scenarios. The flow velocities are visualized as geometries highlighting areas where water moves fastest and how these flows interact with the surrounding environment. The mapping includes simulations for 50-, 100-, and 500-year rain events, offering crucial insights for infrastructure planning and emergency preparedness."},{"@language":"sv","@value":"Denna datamängd visar vattenflöden och deras hastigheter under olika översvämningsscenarier. Flödeshastigheterna presenteras som geometrier som anger var vattnet rör sig snabbast och hur dessa flöden påverkar omgivningen. Kartläggningen inkluderar simuleringar för 50-, 100- och 500-årsregn och ger viktiga insikter för beredskap och planering av infrastruktur."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Flow Velocity 2019"},{"@language":"sv","@value":"Flödeshastighet 2019"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/137","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"Maxdjup.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/138","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/137"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/137"},"dct:description":[{"@language":"en","@value":"This dataset displays the maximum water depth reached during floods under the same scenarios (50-, 100-, and 500-year rain events). Maximum depths are geographically visualized to pinpoint high-risk areas, aiding in risk management and climate adaptation planning."},{"@language":"sv","@value":"Denna datamängd visar det maximala vattendjupet som uppstår vid översvämningar under samma scenarier (50-, 100- och 500-årsregn). Maxdjupen visualiseras geografiskt för att identifiera områden med särskilt hög översvämningsrisk och för att stödja riskhantering och klimatanpassning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Maximum Depth 2019"},{"@language":"sv","@value":"Maxdjup 2019"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08_b4n0"}}],"@id":"urn:source:2daf58732d6c70d92ca2646d95cb5fe7664b96c3769b077b84c62d422e8fbf08"},{"@graph":[{"@id":"_:5a104c41499621d07bbeab7407c4ef726c78f6954b7721dafac1dea9768e0801_b0n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2023-01-01"},"dct:modified":{"@type":"xsd:dateTime","@value":"2023-05-10 12:31:42"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomikontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ekonomikontoret@trollhattan.se"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/58","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/56"},"dcat:distribution":[{"@id":"https://catalog.trollhattan.se/store/1/resource/60"},{"@id":"https://catalog.trollhattan.se/store/1/resource/63"}],"dcat:keyword":"inköp, faktura, leverantörsreskontra, ekonomi, upphandling, utgift","dcat:temporalResolution":{"@type":"xsd:duration","@value":"P2023Y"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest#ref=?p=1&q=leverant%C3%B6rs&s=2&t=20&f=&rt=spec_standard%2524spec_profile&c=false"},"dct:description":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation,\n verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser.\nI vissa fall anges [Kan innehålla personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter]\n betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare.\nNär det står [Kan omfattas av sekretess] innebär det att någon uppgift avseende inköpet kan omfattas av sekretess och att en mer noggrann prövning måste göras.\nFör att ta del av underliggande fakturor; använd  vår E-tjänst https://minasidor.trollhattan.se/534 och ange verifikationsnummer för den eller de fakturor ni är intresserade av.\nEn beskrivning av den specifikation som datamängden utgår från finns att tillgå via dataportal.se\nhttps://www.dataportal.se/sv/specifications/leverantorsreskontra/latest","dct:issued":{"@type":"xsd:date","@value":"2023-05-15"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-17T06:13:47"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:s