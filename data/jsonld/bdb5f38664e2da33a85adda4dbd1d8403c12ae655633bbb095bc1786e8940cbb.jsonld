pna data från Trollhättans Stad"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:title":{"@language":"sv","@value":"Öppna Data Trollhättans Stad"}}],"@id":"urn:source:642e4ef339fac9746b8de92eda3cbbe545053581f10e0495e6b363240b4a5c8a"},{"@graph":[{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(12.287287019344438 58.28685146449848)"}},{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-11-20"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-11-20"}},{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2120001546"}},{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Trollhättan","http://www.w3.org/2006/vcard/ns#postal-code":"46183","http://www.w3.org/2006/vcard/ns#street-address":"Gärdhemsvägen 9"},{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:0520-496777"}},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/139","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/28"},"dcat:distribution":{"@id":"https://catalog.trollhattan.se/store/1/resource/141"},"dcat:keyword":[{"@language":"en","@value":"Airport"},{"@language":"en","@value":"Aviation safety"},{"@language":"en","@value":"Building permits"},{"@language":"en","@value":"Community planning"},{"@language":"en","@value":"Geospatial data"},{"@language":"en","@value":"Height restrictions"},{"@language":"en","@value":"Helipad"},{"@language":"en","@value":"Land information"},{"@language":"en","@value":"Land use"},{"@language":"en","@value":"Obstacle limitations"},{"@language":"en","@value":"Spatial data"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Bygglov"},{"@language":"sv","@value":"Flygplats"},{"@language":"sv","@value":"Flygsäkerhet"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Helikopterplatta"},{"@language":"sv","@value":"Hinderbegränsningar"},{"@language":"sv","@value":"Höjdbegränsningar"},{"@language":"sv","@value":"Markanvändning"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides information on obstacle limitations for construction near Trollhättan’s airport and helipad, in compliance with international Code 3C. The limitations define the maximum allowable heights for buildings to ensure aviation safety. For new constructions, buildings must either comply with the specified height restrictions or apply for a permit to exceed them.\n\nThe dataset is an essential resource for urban planning, building permit processes, and project development where construction heights may impact airport safety and operations."},{"@language":"sv","@value":"Det här datasetet innehåller information om hinderbegränsningar för byggnation i anslutning till Trollhättans flygplats och helikopterplatta, enligt internationell kod 3C. Begränsningarna definierar de maximala höjder som byggnader får uppnå för att säkerställa flygsäkerhet. Vid nybyggnation måste byggnader antingen hålla sig under angivna höjder eller ansöka om dispens för att överskrida begränsningarna.\n\nDatasetet är ett viktigt verktyg för samhällsplanering, bygglovshantering och projektutveckling där höjd på konstruktioner kan påverka flygplatsens säkerhet och funktion."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b1n0"},"dct:title":[{"@language":"en","@value":"Airport Obstacle Limitations According to Code 3C"},{"@language":"sv","@value":"Flygplats hinderbegränsningar enligt kod 3C"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/140","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"Hinderbeg_flygplats.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/141","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/140"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/140"},"dct:description":[{"@language":"en","@value":"This dataset provides information on obstacle limitations for construction near Trollhättan’s airport and helipad, in compliance with international Code 3C. The limitations define the maximum allowable heights for buildings to ensure aviation safety. For new constructions, buildings must either comply with the specified height restrictions or apply for a permit to exceed them.\n\nThe dataset is an essential resource for urban planning, building permit processes, and project development where construction heights may impact airport safety and operations."},{"@language":"sv","@value":"Det här datasetet innehåller information om hinderbegränsningar för byggnation i anslutning till Trollhättans flygplats och helikopterplatta, enligt internationell kod 3C. Begränsningarna definierar de maximala höjder som byggnader får uppnå för att säkerställa flygsäkerhet. Vid nybyggnation måste byggnader antingen hålla sig under angivna höjder eller ansöka om dispens för att överskrida begränsningarna.\n\nDatasetet är ett viktigt verktyg för samhällsplanering, bygglovshantering och projektutveckling där höjd på konstruktioner kan påverka flygplatsens säkerhet och funktion."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Airport Obstacle Limitations According to Code 3C"},{"@language":"sv","@value":"Flygplats hinderbegränsningar enligt kod 3C"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18_b4n0"}}],"@id":"urn:source:92ad8bb0bea5c882df75af7acab924deca1619bf3f59c3420d9081ffc72b6e18"},{"@graph":[{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2024-01-01"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-11-20 06:13:47"}},{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120001546","@type":"foaf:Agent","dct:identifier":"2120001546","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:lars.carlen@trollhattan.se"},"foaf:name":{"@language":"sv","@value":"Trollhättans stad"},"foaf:page":{"@id":"https://www.trollhattan.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.trollhattan.se/store/1/resource/1"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/100","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202409.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/102","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202410.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/142","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202411.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/143","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202412.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomikontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ekonomikontoret@trollhattan.se"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/73","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.trollhattan.se/store/1/resource/56"},"dcat:distribution":[{"@id":"https://catalog.trollhattan.se/store/1/resource/75"},{"@id":"https://catalog.trollhattan.se/store/1/resource/77"}],"dcat:keyword":[{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"},{"@language":"sv","@value":"accounts receivable"},{"@language":"sv","@value":"invoices"},{"@language":"sv","@value":"openspending"},{"@language":"sv","@value":"payments"},{"@language":"sv","@value":"procured services"},{"@language":"sv","@value":"spending"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:issued":{"@type":"xsd:date","@value":"2024-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-02-21 06:13:46"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":{"@id":"https://sws.geonames.org/2667302"},"dct:temporal":{"@id":"_:b192b98f17d8fda8bf1c1e9c224d761b33bc40a947730bde879c21f52c2d8c27_b0n0"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2024"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/74","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:modified":{"@type":"xsd:dateTime","@value":"2024-02-21T06:13:46"},"dct:title":"Leverantörsfakturor202401.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/75","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.trollhattan.se/store/1/resource/100"},{"@id":"https://catalog.trollhattan.se/store/1/resource/102"},{"@id":"https://catalog.trollhattan.se/store/1/resource/142"},{"@id":"https://catalog.trollhattan.se/store/1/resource/143"},{"@id":"https://catalog.trollhattan.se/store/1/resource/74"},{"@id":"https://catalog.trollhattan.se/store/1/resource/78"},{"@id":"https://catalog.trollhattan.se/store/1/resource/79"},{"@id":"https://catalog.trollhattan.se/store/1/resource/80"},{"@id":"https://catalog.trollhattan.se/store/1/resource/81"},{"@id":"https://catalog.trollhattan.se/store/1/resource/82"},{"@id":"https://catalog.trollhattan.se/store/1/resource/83"},{"@id":"https://catalog.trollhattan.se/store/1/resource/84"}],"dcat:downloadURL":[{"@id":"https://catalog.trollhattan.se/store/1/resource/100"},{"@id":"https://catalog.trollhattan.se/store/1/resource/102"},{"@id":"https://catalog.trollhattan.se/store/1/resource/142"},{"@id":"https://catalog.trollhattan.se/store/1/resource/143"},{"@id":"https://catalog.trollhattan.se/store/1/resource/74"},{"@id":"https://catalog.trollhattan.se/store/1/resource/78"},{"@id":"https://catalog.trollhattan.se/store/1/resource/79"},{"@id":"https://catalog.trollhattan.se/store/1/resource/80"},{"@id":"https://catalog.trollhattan.se/store/1/resource/81"},{"@id":"https://catalog.trollhattan.se/store/1/resource/82"},{"@id":"https://catalog.trollhattan.se/store/1/resource/83"},{"@id":"https://catalog.trollhattan.se/store/1/resource/84"}],"dct:description":"CSV-filer med Trollhättans leverantörsfakturor 2024månad för månad.","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-24T08:37:09.143Z"},"dct:title":"Leverantörsreskontra 2024","http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/77","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.trollhattan.se/rowstore/dataset/398e2c69-3db8-41e4-a72d-11e9d368bceb"},"dct:conformsTo":{"@id":"https://catalog.trollhattan.se/rowstore/dataset/398e2c69-3db8-41e4-a72d-11e9d368bceb/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-24T08:38:14.482Z"},"dct:source":{"@id":"https://catalog.trollhattan.se/store/1/resource/75"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.trollhattan.se/rowstore/dataset/398e2c69-3db8-41e4-a72d-11e9d368bceb/swagger"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/78","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202402.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/79","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202403.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/80","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202404.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/81","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202405.csv"},{"@id":"https://catalog.trollhattan.se/store/1/resource/82","@type":"http://entryscape.com/terms/File","dct:title":"Leverantörsfakturor202406.csv"},{"@id"