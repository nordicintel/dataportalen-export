ncy/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides the official neighborhood boundaries for Trollhättan, established by the Community Building Committee in 2015. It contains geographic information represented as polygons, serving as the city's standard for administrative and planning purposes."},{"@language":"sv","@value":"Lagret stadsdelsgränser över Trollhättan. Stadsdelarna är beslutade i Samhällsbyggnadsnämnden 2015 och används som den officiella gränssättningen i staden. Lagret består av geografiskinformation och innehåller ytor."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:source":{"@id":"https://catalog.trollhattan.se/store/1/resource/103"},"dct:spatial":[{"@id":"_:ddf0fad7d7e7fad05104407e1713894a1ddac5169fc512b8ae6a495abca73365_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:ddf0fad7d7e7fad05104407e1713894a1ddac5169fc512b8ae6a495abca73365_b1n0"},"dct:title":[{"@language":"en","@value":"Neighborhood boundaries within the urban area of Trollhättan"},{"@language":"sv","@value":"Stadsdelar i Trollhättans tätort"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:ddf0fad7d7e7fad05104407e1713894a1ddac5169fc512b8ae6a495abca73365_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/104","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"stadsdelar.geojson"},{"@id":"https://catalo