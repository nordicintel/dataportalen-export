ts and recreation"},{"@language":"en","@value":"Urban planning"},{"@language":"sv","@value":"Geodata"},{"@language":"sv","@value":"Geografisk information"},{"@language":"sv","@value":"Idrott och lek"},{"@language":"sv","@value":"Kvartersmark"},{"@language":"sv","@value":"Markanvändning"},{"@language":"sv","@value":"Markdata"},{"@language":"sv","@value":"Marktyper"},{"@language":"sv","@value":"Markytor"},{"@language":"sv","@value":"Parker"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Skog"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Vägar"},{"@language":"sv","@value":"Öppen mark"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides land area data for the entire Trollhättan municipality, represented as polygons. Each polygon is categorized under the attribute \"land types,\" including categories such as urban areas, roads, parks, sports and recreation, forests, and open spaces. The dataset is useful for analysis, planning, and visualization of land use."},{"@language":"sv","@value":"Det här datasetet innehåller markdata för hela Trollhättans kommun representerat som polygoner. Varje polygon är kategoriserad under attributet \"marktyper\", som exempelvis kvartersmark, vägar, parker, idrott och lek, skog och öppen mark. Datasetet är användbart för analys, planering och visualisering av markanvändning."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5_b1n0"},"dct:title":[{"@language":"en","@value":"Land Areas in Trollhättan Municipality"},{"@language":"sv","@value":"Markytor i Trollhättans kommun"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"Första versionen"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5_b2n0"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/121","@type":"http://entryscape.com/terms/File","dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16"},"dct:title":"markytor.geojson"},{"@id":"https://catalog.trollhattan.se/store/1/resource/122","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/121"},"dcat:downloadURL":{"@id":"https://catalog.trollhattan.se/store/1/resource/121"},"dct:description":[{"@language":"en","@value":"This dataset provides land area data for the entire Trollhättan municipality, represented as polygons. Each polygon is categorized under the attribute \"land types,\" including categories such as urban areas, roads, parks, sports and recreation, forests, and open spaces. The dataset is useful for analysis, planning, and visualization of land use."},{"@language":"sv","@value":"Det här datasetet innehåller markdata för hela Trollhättans kommun representerat som polygoner. Varje polygon är kategoriserad under attributet \"marktyper\", som exempelvis kvartersmark, vägar, parker, idrott och lek, skog och öppen mark. Datasetet är användbart för analys, planering och visualisering av markanvändning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":[{"@language":"en","@value":"Land Areas in Trollhättan Municipality"},{"@language":"sv","@value":"Markytor i Trollhättans kommun"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.trollhattan.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Samhällsbyggnadsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:samhallsbyggnad@trollhattan.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5_b4n0"}}],"@id":"urn:source:e4f2a300f08c9de8c0a7ba3431a266fd65cb8700971cfdd8ac56b0cbbb95a7f5"}]}
