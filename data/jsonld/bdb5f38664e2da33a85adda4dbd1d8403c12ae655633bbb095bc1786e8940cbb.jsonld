anguage":"sv","@value":"Ljudmiljö"},{"@language":"sv","@value":"Ljudnivåer"},{"@language":"sv","@value":"Ljudutredning"},{"@language":"sv","@value":"Samhällsbyggnad"},{"@language":"sv","@value":"Trafikbuller"},{"@language":"sv","@value":"Trollhättan"},{"@language":"sv","@value":"Öppna data"}],"dcat:spatialResolutionInMeters":{"@type":"xsd:decimal","@value":"1.0"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:description":[{"@language":"en","@value":"This dataset provides a noise mapping of Trollhättan municipality, detailing sound levels in decibels (dB). The mapping was conducted in 2017 and illustrates the distribution of noise across the municipal area. The dataset is useful for planning, analysis, and visualization of the sound environment in Trollhättan."},{"@language":"sv","@value":"Det här datasetet innehåller en bullerkartering över Trollhättans kommun, med information om ljudnivåer i decibel (dB). Kartläggningen utfördes år 2017 och visar hur buller fördelar sig inom kommunens område. Datasetet är användbart för planering, analys och visualisering av ljudmiljöer i Trollhättan."}],"dct:identifier":"ID","dct:issued":{"@type":"xsd:date","@value":"2024-11-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001546"},"dct:spatial":[{"@id":"_:1daee81a3ce1021cba57632c3c6ac2b2d31bd0ea830adfd0216d1bf70e0cd94f_b0n0"},{"@id":"https://sws.geonames.org/2667302"}],"dct:temporal":{"@id":"_:1daee81a3ce1021cba57632c3c6ac2b2d31bd0ea830adfd0216d1bf70e0cd94f_b1n0"},"dct:title":[{"@language":"en","@value":"Noise Mapping for Trollhättan (2017)"},{"@