metadata.boverket.se/store/1/resource/11"},{"@id":"https://metadata.boverket.se/store/1/resource/119"},{"@id":"https://metadata.boverket.se/store/1/resource/12"},{"@id":"https://metadata.boverket.se/store/1/resource/120"},{"@id":"https://metadata.boverket.se/store/1/resource/16"},{"@id":"https://metadata.boverket.se/store/1/resource/18"}],"dcat:keyword":[{"@language":"sv","@value":"detaljplanering"},{"@language":"sv","@value":"planbestämmelsekatalogen"},{"@language":"sv","@value":"planbestämmelser"}],"dcat:landingPage":{"@id":"https://www.boverket.se/sv/PBL-kunskapsbanken/planering/detaljplan/planbestammelser/planbestammelsekatalogen/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Det här är Boverkets öppna data från Planbestämmelsekatalogen.\nDenna öppna data innehåller information om cirka 3700 detaljplanebestämmelser. Genom öppna data kan alla som vill fritt använda innehållet i databasen. Du har tillstånd att kopiera och distribuera våra öppna data samt göra bearbetningar. Du ska ange Boverket och Planbestämmelsekatalogen som källa."},"dct:issued":{"@type":"xsd:date","@value":"2017-03-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:7d6bb16f4428f6ee23740812759ede0170413431f534dcb82830eed8b00a1d85_b0n0"},"dct:title":{"@language":"sv","@value":"Planbestämmelser"},"foaf:page":[{"@id":"https://www.boverket.se/contentassets/ae0f088994ab44cd80b03e1d3f359b28/teknisk-beskrivning-api-for-planbestammelsekatalogen.pdf"},{"@id":"https://www.boverket.se/contentassets/eaeaa4e5e1a84e5ebff1ba563e87916d/20201001-symbolbeteckningar-png-till-planbestammelsekatalogen.zip"},{"@id":"https://www.boverket.se/contentassets/eaeaa4e5e1a84e5ebff1ba563e87916d/20201001-symbolforteckning-till-planbestammelsekatalogen.docx"}]},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}},{"@id":"https://www.boverket.se/contentassets/ae0f088994ab44cd80b03e1d3f359b28/teknisk-beskrivning-api-for-planbestammelsekatalogen.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Teknisk beskrivning API för planbestämmelsekatalogen"}},{"@id":"https://www.boverket.se/contentassets/eaeaa4e5e1a84e5ebff1ba563e87916d/20201001-symbolbeteckningar-png-till-planbestammelsekatalogen.zip","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Symbolbeteckningar png"}},{"@id":"https://www.boverket.se/contentassets/eaeaa4e5e1a84e5ebff1ba563e87916d/20201001-symbolforteckning-till-planbestammelsekatalogen.docx","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Symbolförteckning till planbestämmelsekatalogen"}}],"@id":"urn:source:7d6bb16f4428f6ee23740812759ede0170413431f534dcb82830eed8b00a1d85"},{"@graph":[{"@id":"_:7f4a603c352d8642618093e25b02a01ec8f946f155ecd7a36c9d74c891bcff11_b0n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"1984"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}},{"@id":"https://metadata.boverket.se/store/1/resource/96","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":[{"@id":"https://metadata.boverket.se/store/1/resource/98"},{"@id":"https://metadata.boverket.se/store/1/resource/99"}],"dcat:keyword":[{"@language":"sv","@value":"bfs"},{"@language":"sv","@value":"byggregler"},{"@language":"sv","@value":"detaljplan"},{"@language":"sv","@value":"författningssamling"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Boverkets författningssamling, BFS, innehåller Boverkets föreskrifter och allmänna råd. I författningssamlingen ingår även regler utgivna av den tidigare myndigheten Bostadsstyrelsen, BOFS. Till vissa författningar finns tillhörande konsekvensutredning.\n\nAPI-tjänsten tillhandahåller övergripande information om alla Boverkets författningar, till exempel titel, datum för ikraftträdande samt en hänvisning till dokumentet i pdf-format. För ett urval av författningarna tillgängliggörs även innehållet i författningen i ett strukturerat format."},"dct:issued":{"@type":"xsd:date","@value":"2020-12-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:7f4a603c352d8642618093e25b02a01ec8f946f155ecd7a36c9d74c891bcff11_b0n0"},"dct:title":{"@language":"sv","@value":"Boverkets författningssamling"}},{"@id":"https://metadata.boverket.se/store/1/resource/98","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api-portal.boverket.se/reference#api=azu004-digitala-forfattningar"},"dct:description":{"@language":"sv","@value":"API-tjänsten innehåller övergripande information om samtliga Boverkets författningar. För ett antal äldre författningar och samtliga författningar som är publicerade från år 2024 och framåt är det även möjligt att hämta innehållet i författningen från tjänsten. Innehållet är tillgängligt i JSON, XML eller HTML-format. Vilka författningar som har innehåll publicerat går att utläsa från tjänsten."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://www.boverket.se/contentassets/565a41dc66a24bcb9ce29b728135fdd8/anvandarvillkor-och-teknisk-beskrivning---api-tjanst-for-boverkets-forfattningssamling.pdf"},"dct:title":{"@language":"sv","@value":"API-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://forfattningssamling.boverket.se/"},"dct:description":{"@language":"sv","@value":"Boverkets författningssamling, BFS, innehåller Boverkets föreskrifter och allmänna råd. I författningssamlingen ingår även regler utgivna av den tidigare myndigheten Bostadsstyrelsen, BOFS. Till vissa författningar finns tillhörande konsekvensutredning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"E-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:7f4a603c352d8642618093e25b02a01ec8f946f155ecd7a36c9d74c891bcff11"},{"@graph":[{"@id":"_:92f27859e8193a1d030cc4ce80347bacdd537d1249f4998c2f716fce23a2f47b_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2020-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"1991-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/58","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":[{"@id":"https://metadata.boverket.se/store/1/resource/59"},{"@id":"https://metadata.boverket.se/store/1/resource/60"}],"dcat:keyword":[{"@language":"sv","@value":"dimensionering"},{"@language":"sv","@value":"dvut"},{"@language":"sv","@value":"vinterutetemperatur"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"SMHI har på uppdrag av Boverket tagit fram dimensionerande vinterutetemperaturer (DVUT) för 310 orter i Sverige, baserat på griddade temperaturdata för perioden 1991–2020. Beräkningarna följer standarden SS-EN ISO 15927-5 och omfattar tidskonstanter på 1–30 dygn. Resultaten bygger på optimerad viktning av olika datakällor samt hänsyn till lokal topografi, och är avsedda att stödja energiberäkningar och byggprojektering."},"dct:issued":{"@type":"xsd:date","@value":"2022-12-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:92f27859e8193a1d030cc4ce80347bacdd537d1249f4998c2f716fce23a2f47b_b0n0"},"dct:title":{"@language":"sv","@value":"Dimensionerande vinterutetemperaturer (DVUT)"}},{"@id":"https://metadata.boverket.se/store/1/resource/59","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/contentassets/78ea1170505245b8b105e163b56dff27/dvut_1991_2020.csv"},"dct:description":{"@language":"sv","@value":"Dimensionerande vinterutetemperatur DVUT 1-30 dygn för 310 orter i Sverige 1991-2020."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Dimensionerande vinterutetemperatur (DVUT 1991-2020)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/60","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/contentassets/78ea1170505245b8b105e163b56dff27/dvut_1991_2020.xlsx"},"dct:description":{"@language":"sv","@value":"Dimensionerande vinterutetemperatur DVUT 1-30 dygn för 310 orter i Sverige 1991-2020."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Dimensionerande vinterutetemperatur (DVUT 1991-2020)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}}],"@id":"urn:source:92f27859e8193a1d030cc4ce80347bacdd537d1249f4998c2f716fce23a2f47b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/108","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/109"},"dcat:keyword":[{"@language":"sv","@value":"Byggnad"},{"@language":"sv","@value":"Byggregler"},{"@language":"sv","@value":"Bärförmåga"},{"@language":"sv","@value":"Klimatlast"},{"@language":"sv","@value":"Konstruktion"},{"@language":"sv","@value":"Konstruktionsregler"},{"@language":"sv","@value":"Snölast"},{"@language":"sv","@value":"Tak"},{"@language":"sv","@value":"Temperaturlast"},{"@language":"sv","@value":"Vindlast"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Boverket publicerar här informationen som ingår i klimatlastkartorna i Boverkets författningar som öppet API. Genom API:et är det möjligt att få tillgång till värden på karakteristisk snölast, vindlast, maximal temperatur och minimal temperatur."},"dct:issued":{"@type":"xsd:date","@value":"2025-07-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Klimatlaster"}},{"@id":"https://metadata.boverket.se/store/1/resource/109","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api-portal.boverket.se/reference#api=klimatlast-v2"},"dct:description":{"@language":"sv","@value":"API för klimatlaster"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"https://www.boverket.se/contentassets/c5e90a5ecd644b40b3f5b888b2170176/anvandarvillkor-bfs-2024-6.pdf"},"dct:title":{"@language":"sv","@value":"API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}}],"@id":"urn:source:94510c0a9051efe83098b7e94e409660b4219432aa99117b4cddc6c6a19ae5fc"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/106","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/107"},"dcat:keyword":[{"@language":"sv","@value":"klimatpåverkan"},{"@language":"sv","@value":"referensvärde"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Här kan du ta del av underlaget för de byggnader som ligger till grund för de referensvärden för klimatpåverkan som Kungliga Tekniska Högskolan (KTH) har tagit fram på Boverkets uppdrag."},"dct:issued":{"@type":"xsd:gYear","@value":"2021"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Referensvärden för klimatpåverkan vid uppförande av byggnader"}},{"@id":"https://metadata.boverket.se/store/1/resource/107","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/contentassets/5c704bbb2b2f4bd1a31beecf355efaa4/bilaga-till-rapporten-referensvarden-for-klimatpaverkan-vid-uppforande-av-byggander.-version-3-2023.xlsx"},"dct:description":{"@language":"sv","@value":"Här kan du ta del av underlaget för de byggnader som ligger till grund för de referensvärden för klimatpåverkan som Kungliga Tekniska Högskolan (KTH) har tagit fram på Boverkets uppdrag."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Referensvärden för klimatpåverkan vid uppförande av byggnader"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}}],"@id":"urn:source:95205cbad43715353198cff28691b2572feb2b614c991f64bd74964b46b998d5"},{"@graph":[{"@id":"_:9824fbbbe9b5329a12785c30aabe716028737492ee6f43d43265f6abc7c40d3e_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2008-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2007-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/54","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/55"},"dcat:keyword":[{"@language":"sv","@value":"asbest"},{"@language":"sv","@value":"badrum"},{"@language":"sv","@value":"bebyggelsen"},{"@language":"sv","@value":"betsi"},{"@language":"sv","@value":"blå lättbetong"},{"@language":"sv","@value":"brandvarnare"},{"@language":"sv","@value":"bristande underhåll"},{"@language":"sv","@value":"byggnaders tekniska utformning"},{"@language":"sv","@value":"byggnadsbeståndet"},{"@language":"sv","@value":"byggteknik"},{"@language":"sv","@value":"energi"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"flerbostadshus"},{"@language":"sv","@value":"freon"},{"@language":"sv","@value":"fönster"},{"@language":"sv","@value":"grund"},{"@language":"sv","@value":"hissar"},{"@language":"sv","@value":"inomhusmiljö"},{"@language":"sv","@value":"inomhustemperatur"},{"@language":"sv","@value":"lokaler"},{"@language":"sv","@value":"obligatorisk ventilationskontroll"},{"@language":"sv","@value":"ovk"},{"@language":"sv","@value":"pcb"},{"@language":"sv","@value":"radon"},{"@language":"sv","@value":"skador"},{"@language":"sv","@value":"småhus"},{"@language":"sv","@value":"tak"},{"@language":"sv","@value":"teknisk status"},{"@language":"sv","@value":"tillgänglighet"},{"@language":"sv","@value":"varmvattentemperatur"},{"@language":"sv","@value":"vattenskador"},{"@language":"sv","@value":"ventilation"},{"@language":"sv","@value":"värmekällor"},{"@language":"sv","@value":"våtrum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"BETSI är en omfattande studie som Boverket genomförde 2006–2009 för att kartlägga det svenska byggnadsbeståndets skick. Genom besiktningar av cirka 1 800 byggnader och enkäter till boende samlades data in om energianvändning, teknisk status, inomhusmiljö, underhållsbrister samt kopplingar till hälsa."},"dct:issued":{"@type":"xsd:date","@value":"2008-12-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:9824fbbbe9b5329a12785c30aabe716028737492ee6f43d43265f6abc7c40d3e_b0n0"},"dct:title":{"@language":"sv","@value":"Byggnaders energianvändning, tekniska status och inomhusmiljö (BETSI )"}},{"@id":"https://metadata.boverket.se/store/1/resource/55","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/sv/om-boverket/oppna-data/betsi-oppna-data/databasen-fran-betsi/"},"dcat:mediaType":"text/csv+zip","dct:description":{"@language":"sv","@value":"BETSI-databasen innehåller öppna data i form av en mängd CSV-filer med information från en omfattande byggnadsundersökning. Data omfattar bland annat klimatskal, fasadskador och åtgärder, samt underlagsmaterial, som innehåller besiktningsprotokoll, instruktioner och enkätfrågor om boendes hälsa. Data kan kopplas via unika variabler."},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Databasen för Betsi"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}}],"@id":"urn:source:9824fbbbe9b5329a12785c30aabe716028737492ee6f43d43265f6abc7c40d3e"},{"@graph":[{"@id":"_:add33b2f3f01c7af307015b666b54da3981e8b0cf975aa42686f3d986c439f7c_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"2034bf308d1e6f18636ba0ea083dbcb62f"},{"@id":"_:add33b2f3f01c7af307015b666b54da3981e8b0cf975aa42686f3d986c439f7c_b1n0","dct:identifier":"https://metadata.boverket.se/store/1/resource/27","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/fb5b9297-cbec-4f7a-9222-6933ba9d949d"}},{"@id":"_:add33b2f3f01c7af307015b666b54da3981e8b0cf975aa42686f3d986c439f7c_b2n0","dct:identifier":"https://metadata.boverket.se/store/1/resource/45","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/ac948b9e-1079-4caf-8ac6-133d2a0aca5e"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-26~~1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/25"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/ac948b9e-1079-4caf-8ac6-133d2a0aca5e"},"dcat:isVersionOf":{"@id":"https://metadata.boverket.se/store/1/resource/26"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://sokenergideklaration.boverket.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Тази електронна услуга ви позволява да търсите енергийно декларирани сгради. Основната информация от енергийната декларация е достъпна директно в електронната услуга. Можете също така да поръчате енергийната декларация в нейната цялост в електронната услуга.\nАко сте собственик на сграда или имате пълномощно (представител), винаги можете да потърсите и изтеглите енергийната декларация в нейната цялост за сградите, за които притежавате или имате пълномощно (представител)."},{"@language":"cs-t-sv-t0-mtec","@value":"Tato elektronická služba vám umožňuje vyhledávat energeticky deklarované budovy. Základní informace z energetického prohlášení jsou dostupné přímo v e-službě. V e-službě si můžete také objednat energetické prohlášení v plném rozsahu.\nPokud jste vlastníkem budovy nebo máte plnou moc (zástupce), můžete vždy vyhledat a stáhnout energetické prohlášení v plném rozsahu pro budovy, pro které vlastníte nebo máte plnou moc (zástupce)."},{"@language":"da-t-sv-t0-mtec","@value":"Denne e-tjeneste giver dig mulighed for at søge efter energianmeldte bygninger. De grundlæggende oplysninger fra energierklæringen kan tilgås direkte i e-tjenesten. Du kan også bestille energideklarationen i sin helhed i e-tjenesten.\nHvis du er bygningsejer eller har en fuldmagt (repræsentant), kan du altid søge efter og downloade energierklæringen i sin helhed for de bygninger, som du ejer eller har en fuldmagt (repræsentant)."},{"@language":"de-t-sv-t0-mtec","@value":"Mit diesem E-Service können Sie nach energiedeklarierten Gebäuden suchen. Die Basisinformationen aus der Energiedeklaration sind direkt im E-Service abrufbar. Sie können die Energiedeklaration auch vollständig im E-Service bestellen.\nWenn Sie Gebäudeeigentümer sind oder über eine Vollmacht (Vertreter) verfügen, können Sie die Energieerklärung für die Gebäude, für die Sie eine Vollmacht (Vertreter) besitzen oder besitzen, jederzeit vollständig suchen und herunterladen."},{"@language":"el-t-sv-t0-mtec","@value":"Αυτή η ηλεκτρονική υπηρεσία σας επιτρέπει να αναζητήσετε ενεργειακά δηλωμένα κτίρια. Οι βασικές πληροφορίες από την ενεργειακή δήλωση είναι προσβάσιμες απευθείας στην ηλεκτρονική υπηρεσία. Μπορείτε επίσης να παραγγείλετε την ενεργειακή δήλωση στο σύνολό της στην ηλεκτρονική υπηρεσία.\nΕάν είστε ιδιοκτήτης κτιρίου ή έχετε πληρεξούσιο (εκπρόσωπος), μπορείτε πάντα να αναζητήσετε και να τηλεφορτώσετε την ενεργειακή δήλωση στο σύνολό της για τα κτίρια για τα οποία είστε ιδιοκτήτης ή έχετε πληρεξούσιο (εκπρόσωπος)."},{"@language":"en-t-sv-t0-mtec","@value":"This e-service allows you to search for energy-declared buildings. The basic information from the energy declaration can be accessed directly in the e-service. You can also order the energy declaration in its entirety in the e-service.\nIf you are a building owner or have a power of attorney (representative), you can always search for and download the energy declaration in its entirety for the buildings for which you own or have a power of attorney (representative)."},{"@language":"es-t-sv-t0-mtec","@value":"Este servicio electrónico le permite buscar edificios declarados energéticamente. La información básica de la declaración energética se puede acceder directamente en el servicio electrónico. También puede solicitar la declaración energética en su totalidad en el servicio electrónico.\nSi usted es propietario de un edificio o tiene un poder notarial (representante), siempre puede buscar y descargar la declaración energética en su totalidad para los edificios de los que es propietario o tiene un poder notarial (representante)."},{"@language":"et-t-sv-t0-mtec","@value":"See e-teenus võimaldab otsida energiadeklaratsiooniga hooneid. Energiadeklaratsiooni põhiteave on kättesaadav otse e-teeninduses. Energiadeklaratsiooni saab tervikuna tellida ka e-teenindusest.\nKui olete hoone omanik või teil on volikiri (esindaja), saate alati otsida ja alla laadida kogu energiadeklaratsiooni hoonete kohta, mille jaoks teil on või on volikiri (esindaja)."},{"@language":"fi-t-sv-t0-mtec","@value":"Sähköisen asiointipalvelun avulla voit hakea energiailmoitettuja rakennuksia. Energiailmoituksen perustiedot ovat suoraan saatavilla sähköisessä asiointipalvelussa. Sähköisessä asiointipalvelussa voit myös tilata energiailmoituksen kokonaisuudessaan.\nJos olet rakennuksen omistaja tai sinulla on valtakirja (edustaja), voit aina hakea ja ladata energiailmoituksen kokonaisuudessaan rakennuksista, joiden omistat tai joilla on valtakirja (edustaja)."},{"@language":"fr-t-sv-t0-mtec","@value":"Ce service en ligne vous permet de rechercher des bâtiments déclarés énergétiques. Les informations de base de la déclaration énergétique sont accessibles directement dans le service en ligne. Vous pouvez également commander la déclaration énergétique dans son intégralité dans le service en ligne.\nSi vous êtes propriétaire d'un bâtiment ou avez une procuration (représentant), vous pouvez toujours rechercher et télécharger la déclaration énergétique dans son intégralité pour les bâtiments pour lesquels vous êtes propriétaire ou avez une procuration (représentant)."},{"@language":"ga-t-sv-t0-mtec","@value":"Ligeann an ríomhsheirbhís seo duit foirgnimh atá dearbhaithe ó thaobh fuinnimh de a chuardach. Is féidir rochtain dhíreach a fháil ar an bhfaisnéis bhunúsach ón dearbhú fuinnimh sa ríomhsheirbhís. Is féidir leat an dearbhú fuinnimh ina iomláine a ordú sa ríomhsheirbhís freisin.\nMás úinéir foirgnimh thú nó má tá cumhacht aturnae (ionadaí) agat, is féidir leat an dearbhú fuinnimh a chuardach agus a íoslódáil ina iomláine i gcás na bhfoirgneamh ar leat iad nó a bhfuil cumhacht aturnae (ionadaí) agat ina leith."},{"@language":"hr-t-sv-t0-mtec","@value":"Ova e-usluga omogućuje vam pretraživanje energetski prijavljenih zgrada. Osnovnim informacijama iz energetske deklaracije može se pristupiti izravno u e-usluzi. Energetsku deklaraciju u cijelosti možete naručiti i u e-usluzi.\nAko ste vlasnik zgrade ili imate punomoć (predstavnik), uvijek možete tražiti i preuzeti energetsku deklaraciju u cijelosti za zgrade za koje posjedujete ili imate punomoć (predstavnik)."},{"@language":"hu-t-sv-t0-mtec","@value":"Ez az e-szolgáltatás lehetővé teszi az energiaigényes épületek keresését. Az energianyilatkozatban szereplő alapvető információk közvetlenül az e-szolgáltatásban érhetők el. Az energianyilatkozatot teljes egészében megrendelheti az e-szolgáltatásban is.\nHa Ön épülettulajdonos vagy meghatalmazással (képviselő) rendelkezik, mindig megkeresheti és letöltheti a teljes energianyilatkozatot azon épületekre vonatkozóan, amelyek tulajdonosa vagy meghatalmazásával (képviselő) rendelkezik."},{"@language":"it-t-sv-t0-mtec","@value":"Questo servizio elettronico ti consente di cercare edifici dichiarati energetici. Le informazioni di base della dichiarazione energetica sono accessibili direttamente nell'e-service. È inoltre possibile ordinare la dichiarazione energetica nella sua interezza nell'e-service.\nSe sei proprietario di un edificio o hai una procura (rappresentante), puoi sempre cercare e scaricare la dichiarazione energetica nella sua interezza per gli edifici di cui possiedi o hai una procura (rappresentante)."},{"@language":"lt-t-sv-t0-mtec","@value":"Ši e. paslauga suteikia galimybę ieškoti energetiškai deklaruotų pastatų. Pagrindinę informaciją iš energijos deklaracijos galima rasti tiesiogiai e. paslaugoje. Elektroninėje paslaugoje taip pat galite užsisakyti visą energijos deklaraciją.\nJei esate pastato savininkas arba turite įgaliojimą (atstovą), visada galite ieškoti ir atsisiųsti visą pastatų, kuriems turite arba turite įgaliojimą (atstovą), energijos deklaraciją."},{"@language":"lv-t-sv-t0-mtec","@value":"Šis e-pakalpojums ļauj meklēt ēkas ar deklarētu energopatēriņu. Pamatinformācijai no enerģijas deklarācijas var piekļūt tieši e-pakalpojumā. E-pakalpojumā varat pasūtīt arī visu enerģijas deklarāciju.\nJa esat ēkas īpašnieks vai jums ir pilnvara (pārstāvis), jūs vienmēr varat meklēt un lejupielādēt visu enerģijas deklarāciju par ēkām, par kurām jums pieder vai ir pilnvara (pārstāvis)."},{"@language":"mt-t-sv-t0-mtec","@value":"Dan is-servizz elettroniku jippermettilek tfittex bini ddikjarat fl-enerġija. L-informazzjoni bażika mid-dikjarazzjoni tal-enerġija tista’ tiġi aċċessata direttament fis-servizz elettroniku. Tista’ tordna wkoll id-dikjarazzjoni tal-enerġija fl-intier tagħha fis-servizz elettroniku.\nJekk inti sid ta’ bini jew għandek prokura (rappreżentant), dejjem tista’ tfittex u tniżżel id-dikjarazzjoni tal-enerġija fl-intier tagħha għall-bini li għalih inti sid jew għandek prokura (rappreżentant)."},{"@language":"nl-t-sv-t0-mtec","@value":"Met deze e-service kunt u zoeken naar energiegedeclareerde gebouwen. De basisinformatie uit de energieverklaring is rechtstreeks toegankelijk in de e-dienst. U kunt de energieverklaring ook in zijn geheel bestellen in de e-service.\nAls u eigenaar van een gebouw bent of een volmacht hebt (vertegenwoordiger), kunt u altijd de energieverklaring in zijn geheel zoeken en downloaden voor de gebouwen waarvan u eigenaar bent of een volmacht hebt (vertegenwoordiger)."},{"@language":"pl-t-sv-t0-mtec","@value":"Ta e-usługa umożliwia wyszukiwanie budynków deklarowanych pod względem energetycznym. Podstawowe informacje z deklaracji energetycznej można uzyskać bezpośrednio w e-usługi. Możesz również zamówić deklarację energetyczną w całości w e-usługi.\nJeśli jesteś właścicielem budynku lub masz pełnomocnictwo (przedstawiciel), zawsze możesz wyszukać i pobrać deklarację energetyczną w całości dla budynków, dla których jesteś właścicielem lub masz pełnomocnictwo (przedstawiciel)."},{"@language":"pt-t-sv-t0-mtec","@value":"Este serviço eletrónico permite-lhe procurar edifícios declarados energeticamente. As informações básicas da declaração energética podem ser consultadas diretamente no serviço eletrónico. Também pode encomendar a declaração energética na sua totalidade no serviço eletrónico.\nSe é proprietário de um edifício ou tem uma procuração (representante), pode sempre pesquisar e descarregar a declaração energética na sua totalidade para os edifícios de que é proprietário ou tem uma procuração (representante)."},{"@language":"ro-t-sv-t0-mtec","@value":"Acest serviciu electronic vă permite să căutați clădiri declarate energetic. Informațiile de bază din declarația privind energia pot fi accesate direct în serviciul electronic. De asemenea, puteți comanda declarația privind energia în întregime în cadrul serviciului electronic.\nDacă sunteți proprietar de clădire sau aveți o procură (reprezentant), puteți căuta și descărca întotdeauna declarația energetică în întregime pentru clădirile pentru care dețineți sau aveți o procură (reprezentant)."},{"@language":"sk-t-sv-t0-mtec","@value":"Táto elektronická služba vám umožňuje vyhľadávať energeticky deklarované budovy. Základné informácie z energetického vyhlásenia sú dostupné priamo v elektronickej službe. Energetické vyhlásenie v celom rozsahu si môžete objednať aj v rámci e-služby.\nAk ste vlastníkom budovy alebo máte splnomocnenie (zástupca), môžete vždy vyhľadať a stiahnuť energetické vyhlásenie v celom rozsahu pre budovy, pre ktoré vlastníte alebo máte splnomocnenie (zástupca)."},{"@language":"sl-t-sv-t0-mtec","@value":"Ta e-storitev vam omogoča iskanje energijsko prijavljenih stavb. Do osnovnih informacij iz energijske deklaracije je mogoče dostopati neposredno v e-storitvi. Energijsko deklaracijo v celoti lahko naročite tudi v e-storitvi.\nČe ste lastnik stavbe ali imate pooblastilo (predstavnik), lahko vedno poiščete in prenesete energetsko deklaracijo v celoti za stavbe, za katere imate v lasti ali imate pooblastilo (predstavnik)."},{"@language":"sv","@value":"Denna e-tjänst ger dig möjlighet att söka efter energideklarerade byggnader. Basuppgifterna från energideklarationen kan du direkt ta del av i e-tjänsten. Du kan även beställa energideklarationen i sin helhet i e-tjänsten.\nÄr du byggnadsägare eller har en fullmakt (ombud) kan du alltid söka fram och ladda ned energideklarationen i sin helhet för de byggnader som du äger eller har en fullmakt (ombud) för."},{"@language":"uk-t-sv-t0-mtec","@value":"Ця електронна послуга дозволяє шукати енергодекларовані будівлі. Базову інформацію з енергетичної декларації можна отримати безпосередньо в електронному сервісі. Ви також можете замовити енергетичну декларацію в повному обсязі в електронному сервісі.\nЯкщо ви є власником будівлі або маєте довіреність (представника), ви завжди можете знайти та завантажити енергетичну декларацію в повному обсязі на будівлі, якими ви володієте або маєте довіреність (представника)."}],"dct:format":"application/pdf","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Електронна услуга за енергийни декларации"},{"@language":"cs-t-sv-t0-mtec","@value":"Elektronická služba pro energetická prohlášení"},{"@language":"da-t-sv-t0-mtec","@value":"E-tjeneste for energierklæringer"},{"@language":"de-t-sv-t0-mtec","@value":"E-Service für Energiedeklarationen"},{"@language":"el-t-sv-t0-mtec","@value":"Ηλεκτρονική Υπηρεσία Ενεργειακών Δηλώσεων"},{"@language":"en-t-sv-t0-mtec","@value":"E-service for Energy declarations"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio electrónico para declaraciones de energía"},{"@language":"et-t-sv-t0-mtec","@value":"Energiadeklaratsioonide e-teenus"},{"@language":"fi-t-sv-t0-mtec","@value":"Energiailmoitusten sähköinen asiointipalvelu"},{"@language":"fr-t-sv-t0-mtec","@value":"Service en ligne pour les déclarations énergétiques"},{"@language":"ga-t-sv-t0-mtec","@value":"Ríomhsheirbhís le haghaidh dearbhuithe fuinnimh"},{"@language":"hr-t-sv-t0-mtec","@value":"E-usluga za deklaracije o energiji"},{"@language":"hu-t-sv-t0-mtec","@value":"E-szolgáltatás az energianyilatkozatokhoz"},{"@language":"it-t-sv-t0-mtec","@value":"E-service per le dichiarazioni energetiche"},{"@language":"lt-t-sv-t0-mtec","@value":"Energijos deklaracijų teikimo e. paslauga"},{"@language":"lv-t-sv-t0-mtec","@value":"E-pakalpojums enerģijas deklarācijām"},{"@language":"mt-t-sv-t0-mtec","@value":"Servizz elettroniku għad-dikjarazzjonijiet tal-Enerġija"},{"@language":"nl-t-sv-t0-mtec","@value":"E-dienst voor energieverklaringen"},{"@language":"pl-t-sv-t0-mtec","@value":"E-usługa w zakresie deklaracji energetycznych"},{"@language":"pt-t-sv-t0-mtec","@value":"Serviço eletrónico para declarações energéticas"},{"@language":"ro-t-sv-t0-mtec","@value":"Serviciul electronic pentru declarațiile privind energia"},{"@language":"sk-t-sv-t0-mtec","@value":"Elektronická služba pre energetické vyhlásenia"},{"@language":"sl-t-sv-t0-mtec","@value":"E-storitev za energetske deklaracije"},{"@language":"sv","@value":"E-tjänst för Energideklarationer"},{"@language":"uk-t-sv-t0-mtec","@value":"Електронний сервіс для енергетичних декларацій"}]},{"@id":"http://data.europa.eu/88u/distribution/ac948b9e-1079-4caf-8ac6-133d2a0aca5e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sokenergideklaration.boverket.se/search"},"dct:format":"application/pdf","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Електронна услуга за PDF"},{"@language":"cs-t-sv-t0-mtec","@value":"Elektronická služba pro PDF"},{"@language":"da-t-sv-t0-mtec","@value":"E-tjeneste til PDF"},{"@language":"de-t-sv-t0-mtec","@value":"E-Service für PDF"},{"@language":"el-t-sv-t0-mtec","@value":"Ηλεκτρονική υπηρεσία για PDF"},{"@language":"en-t-sv-t0-mtec","@value":"E-service for PDF"},{"@language":"es-t-sv-t0-mtec","@value":"Servicio electrónico para PDF"},{"@language":"et-t-sv-t0-mtec","@value":"PDF-failide e-teenus"},{"@language":"fi-t-sv-t0-mtec","@value":"Sähköinen asiointipalvelu PDF-tiedostoille"},{"@language":"fr-t-sv-t0-mtec","@value":"Service en ligne pour PDF"},{"@language":"ga-t-sv-t0-mtec","@value":"Ríomhsheirbhís le haghaidh PDF"},{"@language":"hr-t-sv-t0-mtec","@value":"E-usluga za PDF"},{"@language":"hu-t-sv-t0-mtec","@value":"E-szolgáltatás PDF-hez"},{"@language":"it-t-sv-t0-mtec","@value":"E-service per PDF"},{"@language":"lt-t-sv-t0-mtec","@value":"E-paslauga PDF formatu"},{"@language":"lv-t-sv-t0-mtec","@value":"E-pakalpojums PDF f