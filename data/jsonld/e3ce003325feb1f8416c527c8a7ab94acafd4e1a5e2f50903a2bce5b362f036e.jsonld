ta.boverket.se/store/1/resource/20","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/28"},"dcat:distribution":[{"@id":"https://metadata.boverket.se/store/1/resource/22"},{"@id":"https://metadata.boverket.se/store/1/resource/23"},{"@id":"https://metadata.boverket.se/store/1/resource/29"}],"dcat:keyword":[{"@language":"en","@value":"CO2 calculation"},{"@language":"en","@value":"CO2e"},{"@language":"en","@value":"carbon dioxide emissions"},{"@language":"en","@value":"climate data"},{"@language":"en","@value":"climate impact"},{"@language":"en","@value":"construction products"},{"@language":"en","@value":"emission factors"},{"@language":"en","@value":"generic climate data"},{"@language":"en","@value":"sustainable construction"},{"@language":"sv","@value":"CO2-beräkning"},{"@language":"sv","@value":"CO2e"},{"@language":"sv","@value":"byggprodukter"},{"@language":"sv","@value":"emissionfaktorer"},{"@language":"sv","@value":"generiska klimatdata"},{"@language":"sv","@value":"hållbart byggande"},{"@language":"sv","@value":"klimatdata"},{"@language":"sv","@value":"klimatpåverkan"},{"@language":"sv","@value":"koldioxidutsläpp"}],"dcat:landingPage":{"@id":"https://klimatdatabasen.boverket.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"This open data contains information about over 200 generic building products in Swedish and English. Through open data, anyone who wants can freely use the contents of the database. You must specify the Housing Authority and climate database as the source. The content is made available as open data via API in the formats JSON and XML."},{"@language":"sv","@value":"Denna öppna data innehåller information om över 200 generiska byggprodukter på svenska och engelska. Genom öppna data kan alla som vill fritt använda innehållet i databasen. Du ska ange Boverket och klimatdatabas som källa. Innehållet tillgängliggörs som öppen data via API i formaten JSON och XML."}],"dct:issued":{"@type":"xsd:date","@value":"2024-01-25"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Climate database"},{"@language":"sv","@value":"Klimatdatabasen"}]},{"@id":"https://metadata.boverket.se/store/1/resource/22","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api-portal.boverket.se/reference#api=klimatdatabas"},"dct:description":[{"@language":"en","@value":"Api for climate data"},{"@language":"sv","@value":"Api för klimatdata"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"JSON-API"},{"@language":"sv","@value":"JSON-API"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/23","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api-portal.boverket.se/reference#api=klimatdatabas"},"dct:description":{"@language":"sv","@value":"Api för klimatdata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"https://www.boverket.se/contentassets/eb39a37752af4f74a61ccf92ac21cd5b/anvandarvillkor-for-oppna-data-for-boverkets-klimatdatabas.pdf"},"dct:title":{"@language":"sv","@value":"XML-API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/28","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Klimatdeklarationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatdeklaration@boverket.se"}},{"@id":"https://metada