dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:38Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:46Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-26~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:add33b2f3f01c7af307015b666b54da3981e8b0cf975aa42686f3d986c439f7c_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-boverket-se-store-1-resource-26~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:05Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:45:46Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Energideklarationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://metadata.boverket.se/store/1/resource/26","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/48"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/fb5b9297-cbec-4f7a-9222-6933ba9d949d"},"dcat:hasVersion":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-boverket-se-store-1-resource-26~~1"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Syftet med detta API är att ge avtalsbundna företag möjlighet att göra löpande uppslag i energideklarationssystemet för att få \ntillgång till basuppgifterna. Bland basuppgifterna finns bland annat energiklass och energiprestanda."},"dct:format":"application/json","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/otherlicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"API för Energideklarationer"},"foaf:page":{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/"}},{"@id":"https://metadata.boverket.se/store/1/resource/48","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Boverkets publika API","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://www.boverket.se/sv/om-boverket/publicerat-av-boverket/oppna-data/publikt-api-for-energideklarationer/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Dokumentation av API för Energideklaration"}}],"@id":"urn:source:add33b2f3f01c7af307015b666b54da3981e8b0cf975aa42686f3d986c439f7c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/123","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":[{"@id":"https://metadata.boverket.se/store/1/resource/124"},{"@id":"https://metadata.boverket.se/store/1/resource/125"}],"dcat:keyword":[{"@language":"sv","@value":"Kommunala bostadsbolag"},{"@language":"sv","@value":"Värdeöverföringar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"I lagen om allmännyttiga kommunala bostadsaktiebolag finns bestämmelser om begränsning av värdeöverföringar. Begränsningen innebär att ett allmännyttigt bostadsbolags värdeöverföringar, exempelvis vinstutdelning och överföring av koncernbidrag, inte får överstiga ett visst belopp. \n\nVärdeöverföring definieras enligt 17 kap. aktiebolagslagen som \n•\tvinstutdelning\n•\tförvärv av egna aktier\n•\tminskning av aktiekapitalet eller reservfonden för återbetalning till aktieägarna\n•\toch annan affärshändelse som medför att bolagets förmögenhet minskar och inte har rent affärsmässig karaktär för bolaget.\n\nNedan finns detaljerade uppgifter om värdeöverföringar från räkenskapsår 2023 och framåt. För information om värdeöverföringar gjorda innan räkenskapsår 2023, se tidigare rapporter."},"dct:issued":{"@type":"xsd:date","@value":"2024-12-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"Värdeöverföring från allmännyttiga bostadsföretag"}},{"@id":"https://metadata.boverket.se/store/1/resource/124","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/contentassets/1115f61a84594c6ab05231d7554b2503/vardeoverforingar-rakenskapsar-2024---tabell.xlsx"},"dct:description":{"@language":"sv","@value":"Uppgifter om värdeöverföringar från räkenskapsår 2024."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by-nc/4.0/"},"dct:title":{"@language":"sv","@value":"Värdeöverföring från allmännyttiga bostadsföretag 2024"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://metadata.boverket.se/store/1/resource/125","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.boverket.se/contentassets/1115f61a84594c6ab05231d7554b2503/vardeoverforingar-rakenskapsar-2023--tabeller.xlsx"},"dct:description":{"@language":"sv","@value":"Uppgifter om värdeöverföringar från räkenskapsår 2023."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Värdeöverföring från allmännyttiga bostadsföretag 2023"}},{"@id":"https://metadata.boverket.se/store/1/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registraturen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registraturen@boverket.se"}}],"@id":"urn:source:b9fe9b7480e498fc1d8bd9110d9883c339baa90590c95897c15fd6dd0475d7ac"},{"@graph":[{"@id":"_:d4e4d639a0a53ba4802b2be584dc306b0c91087e87e8719a85d6aa8f0410b5e3_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2022"},"dcat:startDate":{"@type":"xsd:gYear","@value":"1993"}},{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent"