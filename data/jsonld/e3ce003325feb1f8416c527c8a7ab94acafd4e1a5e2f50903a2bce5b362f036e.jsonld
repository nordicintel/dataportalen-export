472d2501a21311481b29d2c8722fe1fcaa103cbf374dbf"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Energideklarationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:boverketspublikaapi@boverket.se"}},{"@id":"https://metadata.boverket.se/store/1/resource/44","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/25"},"dcat:distribution":{"@id":"https://metadata.boverket.se/store/1/resource/45"},"dcat:isVersionOf":{"@id":"https://metadata.boverket.se/store/1/resource/26"},"dcat:keyword":[{"@language":"sv","@value":"byggnader"},{"@language":"sv","@value":"energianvändning"},{"@language":"sv","@value":"energideklarationer"},{"@language":"sv","@value":"energiklass"},{"@language":"sv","@value":"energiprestanda"}],"dcat:landingPage":{"@id":"https://sokenergideklaration.boverket.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":{"@language":"sv","@value":"Denna e-tjänst ger dig möjlighet att söka efter energideklarerade byggnader. Basuppgifterna från energideklarationen kan du direkt ta del av i e-tjänsten. Du kan även beställa energideklarationen i sin helhet i e-tjänsten.\nÄr du byggnadsägare eller har en fullmakt (ombud) kan du alltid söka fram och ladda ned energideklarationen i sin helhet för de byggnader som du äger eller har en fullmakt (ombud) för."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003989"},"dct:spatial":{"@id":"https://sws.geonames.org/2661886"},"dct:title":{"@language":"sv","@value":"E-tjänst för Energideklarationer"}},{"@id":"https://metadata.boverket.se/store/1/resource/45","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sokenergideklaration.boverket.se/search"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:title":{"@language":"sv","@value":"E-tjänst för PDF"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:696a3e27ade123b0aca48918c72d1104f9eb66effd72f060acf6431e8eecd520"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021003989","@type":"foaf:Agent","dct:identifier":"2021003989","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:magnus.evertsson@boverket.se"},"foaf:name":{"@language":"sv","@value":"Boverket"},"foaf:page":{"@id":"https://www.boverket.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://metadata.boverket.se/store/1/resource/1"}},{"@id":"https://metadata.boverket.se/store/1/resource/87","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.boverket.se/store/1/resource/9"},"dcat:distribution":[{"@id":"https://metadata.boverket.se/store/1/resource/88"},{"@id":"https://metadata.boverket.se/store/1/resource/89"},{"@id":"https://metadata.boverket.se/store/1/resource/90"},{"@id":"https://metadata.boverket.se/store/1/resource/91"}],"dcat:keyword":[{"@language":"sv","@value":"databasmodell"},{"@language":"sv","@value":"gis"},{"@language":"sv","@value":"översiktsplan"},{"@language":"sv","@value":"översiktsplanering"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id