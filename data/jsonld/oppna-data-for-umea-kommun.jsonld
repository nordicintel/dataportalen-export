istribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Samverkanshuset peakload shaving (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:58:15.990000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:58:15.990000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/samverkanshuset-peakload-shaving","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi%252C+Datalager&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/samverkanshuset-peakload-shaving-xlsx"}],"dcat:keyword":["Umeå Energi",{"@language":"sv","@value":"Laststyrning"},{"@language":"sv","@value":"Peakload"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/samverkanshuset-peakload-shaving/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:description":{"@language":"sv","@value":"\n\n\nGenom att anpassa fjärrvärmeanvändningen (meter_effect) under kritiska tillfällen\nunder ett dygn när det är hög last kan man minska klimatpåverkan. Idén är att\ngenom att minska användning av fjärrvärme när det är som mest press på systemet,\nkan man minska klimatpåverkan genom att slippa använda mindre klimatvänliga\nbränslen. \n  \nDetta dataset\nbeskriver hur man genom att artificiellt signalera en lägre utomhustemperatur\n(outdoortemp_offset) än den faktiska utomhustemperaturen (outdoortemp)\n\"lurar\" styrningen att det är varmare ute. Men för att det inte ska\nbli för kallt inne och offra komfort i byggnaden, finns det en\nbudget/begränsning för hur mycket man får styra ner vilket styrs genom\ntemperaturgivare i fastigheten. Fastigheten är Samverkanshuset i Umeå.Detta dataset kan med fördel kombineras med datasett [Matematikgränd](https://opendata.umea.se/explore/dataset/matematikgrand-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit) & [Ålidhem HC peakload shaving](https://opendata.umea.se/explore/dataset/alidhem-hc-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit), då de tre byggnaderna tillsammans bildar ett grid. För att relatera utfallet mot prognostiserade värden för hela griden se dataset [Peakload shaving forecast and actual](https://opendata.umea.se/explore/dataset/peakload-prognosis-actual/table/?sort=timestamp)\n\n\n"},"dct:identifier":"samverkanshuset-peakload-shaving@http://da