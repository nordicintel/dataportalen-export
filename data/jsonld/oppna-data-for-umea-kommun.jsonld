:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-02-01T23:11:03.972000+00:00"},"dct:title":{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Leverantörsfakturor 2021 (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2022-02-01T23:11:03.972000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-02-01T23:11:03.972000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/leverantorsfakturor-2021","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2021-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Leverantörsfakturor"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/leverantorsfakturor-2021/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:description":{"@language":"sv","@value":"Information om Umeå kommuns inkomna leverantörsfakturor för 2021 finns samlade i denna datamängd. Datat presenteras i tabellform och innehåller konteringsmånad, förvaltning, leverantör, organisationsnummer, konto, kontotext, summa (exkl. moms), verifikationsnummer och fakturanummer. Viss data är dolt enligt GDPR. Inga fakturabilder finns presenterade. Informationen går att ladda ner i filformat CSV, JSON och Excel.Vi kan ta fram och skicka fakturakopior med post (ej digitalt) enligt önskemål.\nÅterkom med vilka verifikationsnummer du vill ha kopior på, gärna i excelformat.Skicka in er förfrågan till [leverantorsgruppen@umea.se](mailto:leverantorsgruppen@umea.se)Sida 1-9; Gratis.Sida 10; 50 krSida 11--; 2 kr / sidaPorto tillkommer. Ingen moms debiteras.Vid utdrag av fakturakopior behöver vi era faktureringsuppgifter samt adress dit fakturakopiorna ska skickas.Organisationsnummer Namn Kundreferens Adress Postnummer ort "},"dct:identifier":"leverantorsfakturor-2021@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2022-02-01T23:11:03.972000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-02-01T23:11:03.972000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2021"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomi, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:leverantorsgruppen@umea.se"}}],"@id":"urn:source:4afdbd9293f66a00bdbcabe5eac1d39b45052cb69fccf19f81de9eeec54d9c12"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/befolkningsfoeraendringar-helar-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/befolkningsfoeraendringar-helar/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Befolkningsförändringar helår (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-09-30T22:01:24.181000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-30T22:01:24.181000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/befolkningsfoeraendringar-helar-csv","@type":"dcat:D