e-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:08.613000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:08.613000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Bygglov%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=bygglov%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Bygglov"},{"@language":"sv","@value":"Handläggningstid"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/bygglov-handlaggningstid-for-anmalningspliktiga-atgarder/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:description":{"@language":"sv","@value":"Data för ärenden inlämnade från 16 november 2023 kommer inte synas då vi har bytt ärendehanteringssystem. Vi jobbar på att dela ny data så fort vi kan!Hur lång tid tar handläggningen av en anmälan? Hur lång tid tar det innan anmälan blir komplett och handläggningstiden startar?Statistiken visar handläggningstiden, hur lång tid det tar innan anmälan blir komplett och även tiden från inlämnad anmälan till beslut om startbesked. Handläggningstiden mäts i dagar från den dag då anmälan blev komplett till det att startbesked gavs. Statistiken omfattar ärenden och beslut från 2017-01-01, innan det datumet mättes inte handläggningstiden för anmälningspliktiga åtgärder. Datum för komplett ansökan registreras manuellt och kan saknas, ärenden där komplett datum saknas är undantagna från statistiken. Endast beslut tagna av tjänstemännen är medtagna i nuläget, beslut från politiken saknas alltså och kommer senare. "},"dct:identifier":"bygglov-handlaggningstid-for-anmalningspliktiga-atgarder@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:08.613000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:08.613000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Bygglov - Handläggningstid för anmälningspliktiga åtgärder"}},{"@id":"https://opendata.umea.s