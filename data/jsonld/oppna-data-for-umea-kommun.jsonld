-type/ZIP"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:title":{"@language":"sv","@value":"shp"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-turtle","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd/exports/turtle"},"dct:description":{"@language":"sv","@value":"Utvidgat strandskydd (turtle)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:title":{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Utvidgat strandskydd (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/utvidgat-strandskydd","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=L%C3%A4nsstyrelsen+V%C3%A4sterbotten&refine.dcat.contact_email=vasterbotten%2540lansstyrelsen.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Strandskydd"},{"@language":"sv","@value":"Utvidgat strandskydd "}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/utvidgat-strandskydd/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Vissa områden inom Umeå kommun har utvidgat strandskydd.  Länsstyrelserna har möjlighet att utvidga det generella strandskyddet upp till 300 m från strandlinjen, både upp på land eller ut i vattnet, om det behövs för att säkerställa något av strandskyddets syften. Bestämmelsen är upprättad med utgångspunkt från att det inom vissa strandområden kan finnas sådana värden, för friluftsliv, djur- och växtliv, att det inte är tillräckligt med generellt strandskydd för att långsiktigt skydda det som strandskyddet avser att värna.  I besluten beskrivs de miljöer och de företeelser som utgör motiv till varför det generella strandskyddet har utvidgats. Dessa är till exempel förekomst av strand- och sumpskog, hällmarksskog, hällkar, strandängar, å- och bäckmynningar. Vidare utgör grunda havsvikar med riklig bottenvegetation, flador och glosjöar samt sandstränder, områden med sandrevlar, klapperstenfält och strandvallar betydelsefulla miljöer för skapande och bevarande av biologisk mångfald. Gamla fisklägen med äldre färdvägar och strövstigar, och anläggningar som gistgårdar och labyrinter är också intressanta ur ett friluftslivsperspektiv. Om man vill veta mer om anledningen till varför ett specifikt område fått utvidgat strandskydd så finns informationen att söka hos Länsstyrelsen Västerbotten.Denna datamängd bygger på data hämtad ifrån Länsstyrelsen Västerbotten. Den bearbetning som har gjorts är att vi har filtrerat bort information för alla kommuner utom Umeå kommun. Vi har även valt att ta bort fälten ObjectID samt ShapeSTLength.I den visuella presentation har vi bytt namn på vissa kolumner för att öka förståelsen för datamängden."},"dct:identifier":"utvidgat-strandskydd@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Utvidgat strandskydd"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=L%C3%A4nsstyrelsen+V%C3%A4sterbotten&refine.dcat.contact_email=vasterbotten%2540lansstyrelsen.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Länsstyrelsen Västerbotten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vasterbotten@lansstyrelsen.se"}}],"@id":"urn:source:ef2337faad0dc9f6a982586a78b677738790d987ced1de6ebd78dc944797d15d"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-143801-nydala-sjostad-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-143801-nydala-sjostad/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 143801 (Tomtebo strand) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T23:05:42.062000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T23:05:42.062000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-143801-nydala-sjostad-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"htt