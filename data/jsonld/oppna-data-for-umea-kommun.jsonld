/opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/avvikelse-fran-modellvaerde-valdsbrott-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Våldsbrott"},{"@language":"sv","@value":"anmälda brott"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/avvikelse-fran-modellvaerde-valdsbrott/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avvikelse från modellberäknat värde för anmälda våldsbrott. Avvikelsen graderas enligt följande: Färre än=2, lika många=1, fler än=0Modellberäkningen bygger på olika strukturella faktorer i kommunen. Modellberäkningen ställs mot indikatorn som anger anmälda våldsbrott. Uppgifterna har hämtats från Brottsförebyggande rådets officiella kriminalstatistik och belyser brottsligheten utifrån de brott som anmäls till och handläggs av polis, tull, åklagare, domstol och kriminalvård. Brott som inte anmäls kommer därför inte med i kriminalstatistiken. Brott som har ägt rum tidigare, men anmälts under redovisningsåret finns med i statistiken, liksom brott som anmälts i Sverige men begåtts utomlands. I mindre omfattning finns även anmälda brott som i senare utredning inte visar sig vara brott redovisad. I brottskategorin våldsbrott ingår mord, dråp, barnadråp och misshandel med och utan dödlig utgång, våldtäkt inklusive grov våldtäkt, grov fridskränkning, grov kvinnofridskränkning, våld mot tjänsteman samt rån inklusive grovt rån. Antalet anmälda brott har sedan justerats med uppgifter från SCB om befolkningen i respektive kommun. Treårsmedelvärde (år T-2 till år T).Datat är hämtat från  [Kolada](https://kolada.se/). Källan är [MSB – Myndigheten för samhällsskydd och beredskap](https://www.msb.se/)."},"dct:identifier":"avvikelse-fran-modellvaerde-valdsbrott@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-09T00:05:11.262000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-09T00:05:11.262000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Avvikelse från modellvärde, våldsbrott"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:12a03b8827c73f84f03d45581ea32f333576bf849ab01176c4d768fb195bfc4a"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-API","@type":["dcat:Distribution","http://entryscape.com/t