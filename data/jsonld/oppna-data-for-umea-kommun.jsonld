 och indikationer.Datafilerna kommer endast innehålla värden för fastigheter i Umeå kommun där Umeå Energi är nätägare och informationen inte anses vara olämplig för distribution. Uppdateras normalt en gång varje månad med nytillkomna värden.Frågor kring detta förbrukningsdata hänvisas till matdata.datalager@umeaenergi.se "},"dct:identifier":"energiforbrukning-i-geografiska-omradet-1334-del-av-universitetsomradet@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-16T22:17:03.598000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T22:17:03.598000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 1334 (del av Universitetsområdet)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:a327a79cf5fe965c90b7ead9793365a4ed9837724792a94a9efb0b947d21726d"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-154007-sca-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-154007-sca/records"},"dct:conformsTo":{"@id":"https://opendata