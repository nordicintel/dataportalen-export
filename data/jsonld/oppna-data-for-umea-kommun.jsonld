ata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-081806-kroksjos-omland-xlsx"}],"dcat:keyword":["Umeå Energi",{"@language":"sv","@value":"El"},{"@language":"sv","@value":"Energi"},{"@language":"sv","@value":"Fjärrvärme"},{"@language":"sv","@value":"Förbrukning"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/energiforbrukning-i-geografiska-omradet-081806-kroksjos-omland/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:description":{"@language":"sv","@value":"Anonymiserad förbrukningsdata från Umeå Energi per nyckelkodsområde i Umeå Kommun. Detta data bör inte ses som exakta och kompletta förbrukningsvärden utan mer som en kvalificerad uppskattning av förbrukningen i syfte att se trender och indikationer.Datafilerna kommer endast innehålla värden för fastigheter i Umeå kommun där Umeå Energi är nätägare och informationen inte anses vara olämplig för distribution. Uppdateras normalt en gång varje månad med nytillkomna värden.Frågor kring detta förbrukningsdata hänvisas till matdata.datalager@umeaenergi.se "},"dct:identifier":"energiforbrukning-i-geografiska-omradet-081806-kroksjos-omland@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T23:16:21.536000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T23:16:21.536000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 081806 (Kroksjös omland)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:ee45f74404226b2f15490dd585e101f5bc9a8777d5aa4e91b6269044ca5c927f"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Utvidgat strandskydd (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strandskydd/exports/csv?use_labels=true"},"dct:description":{"@language":"sv","@value":"Utvidgat strandskydd (csv)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-01-31T23:01:29.109000+00:00"},"dct:title":{"@language":"sv","@value":"csv"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utvidgat-strand