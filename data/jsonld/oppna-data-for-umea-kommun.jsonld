y/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T22:17:08.020000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/resultat-fran-radon-matningar","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6-+och+h%C3%A4lsoskydd+Ume%C3%A5+kommun&refine.dcat.contact_email=miljoochhalsoskydd%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-fran-radon-matningar-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Inomhusmiljö"},{"@language":"sv","@value":"Mätning"},{"@language":"sv","@value":"Radon"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/resultat-fran-radon-matningar/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Uppmätt radonhalt i inomhusluften.Datamängden redovisar värden för de radonmätningar som inkommit till Umeå kommun. Datamängden är för närvarande inte komplett, men arbete pågår med att lägga in fler radonmätningar. Det kan även finnas fler mätningar gjorda som kommunen inte har kännedom om.I flerbostadshus kan mätningar ha gjorts i flera olika lägenheter med olika resultat men mätningens läge är kopplat till entréadress eller fastighet där mätningen utförts.Radonhalterna i inomhusluften varierar över året. Variationerna beror framförallt på förändringar i utomhustemperatur och vindstyrka. Halterna varierar även över dygnet och från rum till rum. Ventilationssystemet och hur ofta det vädras påverkar också radonhalten. Därför måste radonmätningar pågå under lång tid, minst två månader och utföras under den kalla årstiden. Mätningar som gjorts under kortare tidsperiod eller utanför uppvärmningssäsong är endast indikerade. Det är viktigt att notera att om ventilationen förändras, fönster tätas, sprickor uppkommer i grunden eller om större ombyggnationer görs, bör en ny mätning göras. Strålsäkerhetsmyndigheten rekommenderar även att en ny mätning görs om det har gått mer än 10 år sedan den senaste mätningen genomfördes.Uppdateringen av informationen sker kontinuerligt. Dels löpande för enstaka inkommande radonmätningar och dels i samband med årliga sammanställda leveranser från radonlaboratorier. Miljö- och hälsoskydd på Umeå kommun ansvarar för informationen. Umeå kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Umeå kommun till konsumenten. Umeå kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information.Vid frågor kontakta miljoochhalsoskydd@umea.se"},"dct:identifier":"resultat-fran-radon-matningar@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-16T22:17:08.020000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T22:17:08.020000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Resultat från radonmätningar"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6-+och+h%C3%A4lsoskydd+Ume%C3%A5+kommun&refine.dcat.contact_email=miljoochhalsoskydd%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljö- och hälsoskydd Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoochhalsoskydd@umea.se"}}],"@id":"urn:source:997a908ebbdbaf1534a9988c9b29b808212a3f90baaa506839015ef2f3461caa"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/utlaningsstatistik-fran-biblioteken-i-umea-kommun-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"http