ik kommun.Du finner information om Skolverkets öppna data här: [https://www.skolverket.se/om-oss/oppna-data](https://www.skolverket.se/om-oss/oppna-data) Datamängden i denna portal uppdateras (hämtas/skapas)  inte regelbundet av denna portal. Vill du ha aktuella data hänvisar vi dig till Skolverket."},"dct:identifier":"skolor-i-vaesterbottens-kommuner-samt-oernskoeldsvik-kommun@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-10T12:20:03+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-04-10T12:20:03+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Exempel Skolor i Västerbottens kommuner samt Örnsköldsvik (Öppna data Skolverket)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:209dc231da4cf5b0bd11f571ca0d57a3d3b1b9e34b4f6cb64a55bbdc23092de5"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-193610-nydalsjon-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-193610-nydalsjon/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2