0-15T17:00:47.918000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/badplatser","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Fritid%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=umea.fritid%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/badplatser-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Bad"},{"@language":"sv","@value":"Badplats"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/badplatser/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:description":{"@language":"sv","@value":"Umeå kommun har många fina badplatser, både havsbad, badplatser vid sjöar och vid älven. Utforska badplatsen i närheten av där du bor eller gör en utflykt till en annan närbelägen badplats för att upptäcka variationen, möjligheterna och kanske ett nytt favoritställe? Badmöjligheterna i kommunen är många, varierade och passar för olika behov.Här hittar du information om några av de största badplatserna som finns i kommunen. På några av badplatserna finns entreprenörer som driver mat- och fikaförsäljning.Denna datamängd uppdateras oregelbundet. Det kan finnas felaktigher i t.ex. positioner och det kan även vara så att publika badplatser har försvunnit eller tillkommit mellan uppdateringar.De positioner som finns angivna ska endast ses som indikationer på var platsen är och inte som exakta värden."},"dct:identifier":"badplatser@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-15T17:00:47.918000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T17:00:47.918000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Badplatser"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Fritid%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=umea.fritid%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fritid, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:umea.fritid@umea.se"}}],"@id":"urn:source:14ff1e808974de4188e3ffda86e978b8aa0dc8049b81c20f2c68c58519450107"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Compan