apas)  inte regelbundet av denna portal. Vill du ha aktuella data hänvisar vi dig till Trafikverket."},"dct:identifier":"test_join@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-08T11:53:36+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-04-08T11:53:36+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Exempel Nationella vägdatabasen (Kombinerade data)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=opendata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@umea.se"}}],"@id":"urn:source:adb777866e3bf43677dd2720cacf2b1d1f82bd942b1d43219806166605e0c8f4"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-112713-gimonas-industromrade-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-112713-gimonas-industromrade/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 112713 (Gimonäs industrområde) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@va