data.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Flygplats"},{"@language":"sv","@value":"Statistik"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/flygplatsstatistik_1/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Flygtrafikstatistik från Transportstyrelsen avseende Umeå flygplats. Datat innehåller statistik avseende passagerare, utbjudna säten, starter, landningar, frakt och post. Statistiken redovisas månadsvis.För åren 2005-2007 saknas data för frakt och post. För 2019 saknas data för frakt på Swedavias 10 flygplatser. Detta markeras med ett streck (-) i data. I slutet av september 2022 slutade Swedavia att samla in och rapportera majoriteten av sina militära rörelser, vilket gör att statistiken från och med september 2022 inte är jämförbar med tidigare statistik.  Mer information om dessa och andra öppna transportrelaterade data finns hos Transportstyrelsen [Öppna data - Transportstyrelsen](https://www.transportstyrelsen.se/sv/om-oss/statistik-och-analys/oppna-data/)"},"dct:identifier":"flygplatsstatistik_1@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-09-19T00:00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-22T02:01:11.547000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a6006464