or 2018 (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2020-04-09T05:57:56.070000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-04-09T05:57:56.070000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/leverantorsfakturor-2018","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2018-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Leverantörsfakturor"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/leverantorsfakturor-2018/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:description":{"@language":"sv","@value":"Information om Umeå kommuns inkomna leverantörsfakturor för 2018 finns samlade i denna datamängd. Datat presenteras i tabellform och innehåller konteringsmånad, förvaltning, leverantör, organisationsnummer, konto, kontotext, summa (exkl. moms) och verifikationsnummer. Viss data är dolt enligt GDPR. Inga fakturabilder finns presenterade. Informationen går att ladda ner i filformat CSV, JSON och Excel.Vi kan ta fram och skicka fakturakopior med post (ej digitalt) enligt önskemål.Återkom med vilka verifikationsnummer du vill ha kopior på, gärna i excelformat.Skicka in er förfrågan till [leverantorsgruppen@umea.se](mailto:leverantorsgruppen@umea.se)Sida 1-9; Gratis.Sida 10; 50 krSida 11--; 2 kr / sidaPorto tillkommer. Ingen moms debiteras.Vid utdrag avfakturakopior behöver vi era faktureringsuppgifter.Organisationsnummer Namn Kundreferens Adress Postnummer ort "},"dct:identifier":"leverantorsfakturor-2018@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2020-04-09T05:57:56.070000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-04-09T05:57:56.070000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2018"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomi, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:leverantorsgruppen@umea.se"}}],"@id":"urn:source:a9033c15c96018e5832817a3118ce21baaa0bd0888ceb