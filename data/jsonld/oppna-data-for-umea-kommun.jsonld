"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T12:07:23.601000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T12:07:23.601000+00:00"},"dct:title":{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Laststyrning prognos & utfall (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T12:07:23.601000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T12:07:23.601000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/peakload-prognosis-actual","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi%252C+Datalager&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/peakload-prognosis-actual-xlsx"}],"dcat:keyword":["Umeå Energi",{"@language":"sv","@value":"Laststyrning"},{"@language":"sv","@value":"Peakload"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/peakload-prognosis-actual/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:description":{"@language":"sv","@value":"Genom att anpassa fjärrvärmeanvändningen under kritiska tillfällen under ett dygn när det är hög last kan man minska minska klimatpåverkan. Idén är att genom att minska användning av fjärrvärme när det är som mest press på systemet, kan man minska klimatpåverkan genom att slippa använda mindre klimatvänliga bränslen.  Detta dataset beskriver hur den prognostiserade fjärrvärmeanvändningen per timme för en hel grid stämmer med faktiskt utfall. Gridden består av byggnaderna Samverkanshuset, Matematikgränd och Ålidhems hälsocentral. För data för respektive byggnad i griden se:- [Matematikgränd peakload shaving](https://opendata.umea.se/explore/dataset/matematikgrand-peakload-shaving/information/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit)- [Ålidhem HC peakload shaving](https://opendata.umea.se/explore/dataset/alidhem-hc-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit)- [Samverkanshuset peakload shaving](https://opendata.umea.se/explore/dataset/samverkanshuset-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit&sort=timestamp)"},"dct:identif