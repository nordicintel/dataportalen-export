ttps://creativecommons.org/licenses/by-nc-nd/4.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-12-16T10:13:12.180000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6utveckling+Ume%C3%A5+kommun&refine.dcat.contact_email=klimatneutrala%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"CO2"},{"@language":"sv","@value":"CO2-utsläpp"},{"@language":"sv","@value":"Klimatutsläpp"},{"@language":"sv","@value":"Koldioxidekvivalenter"},{"@language":"sv","@value":"Koldioxidutsläpp"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Insamlad data som visar klimatpåverkan i Umeå kommun från hushållens konsumtion uppdelat på olika kategorier.Sifferkoden som redovisas med varje underkategori är en så kallad COICOP-kod, enligt en internationell standard för att klassificera konsumtionsbaserade utsläpp: FN (2018), Classification of Individual Consumption According to Purpose (COICOP) 2018,  Department of Economic and Social Affairs Statistics Division. \nDirekta utsläpp, som utsläpp från bränslen under körning eller eldning av bränslen för uppvärmning, ingår inte i COICOP och redovisas därför utan kod.\nLäs mer om COICOP-klassificeringen här:\nhttps://ec.europa.eu/eurostat/statistics-explained/index.php?title=Glossary:Classification_of_individual_consumption_by_purpose_(COICOP)Källa: Stockholm Environment Institute (SEI), verktyget KonsumtionskompassenSEI:s analysverktyg Konsumtionskompassen redovisar ett genomsnitt för varje kommungrupp enligt Sveriges kommuner och regioner, kommungruppsindelning från 2017. Umeå kommun ingår i kommungrupp B3, vilket innebär en större stad med minst 40 000 och mindre än 200 000 invånare i kommunens största tätort.På sei.org finns fördjupning, metodbeskrivningar och mer data för alla kommuner i Sverige. \nhttps://www.sei.org/projects-and-tools/tools/konsumtionskompassen/Visit sei.org for an English version of the data.\nhttps://www.sei.org/projects-and-tools/tools/konsumtionskompassen/\nVissa rubriker har ändrats för att förtydliga att det är huvud-/underkategori eller för att förtydliga att det är data avseende Umeå kommun"},"dct:identifier":"hushallens-klimatavtryck-i-umea-2019-konsumtionskompassen@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-16T10:13:12.180000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-12-16T10:13:12.180000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Hushållens  klimatavtryck i Umeå 2019, Konsumtionskompassen"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6utveckling+Ume%C3%A5+kommun&refine.dcat.contact_email=klimatneutrala%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljöutveckling Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:klimatneutrala@umea.se"}}],"@id":"urn:source:0e2233ef78fe08ebdd72aabbb9acf4d7720442d039153a7b38519ec76af0792b"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-samrad-och-platsbesok-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/bygglov-samrad-och-platsbesok/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Bygglov - Samråd och platsbesök (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-11-14T10:17:40.458000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.