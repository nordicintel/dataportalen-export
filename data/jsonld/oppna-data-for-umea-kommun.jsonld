E"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-11-24T12:56:07.036000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/leverantorsfakturor-2019","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2019-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Leverantörsfakturor"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/leverantorsfakturor-2019/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:description":{"@language":"sv","@value":"Information om Umeå kommuns inkomna leverantörsfakturor för 2019 finns samlade i denna datamängd. Datat presenteras i tabellform och innehåller konteringsmånad, förvaltning, leverantör, organisationsnummer, konto, kontotext, summa (exkl. moms) och verifikationsnummer. Viss data är dolt enligt GDPR. Inga fakturabilder finns presenterade. Informationen går att ladda ner i filformat CSV, JSON och Excel.Vi kan ta fram och skicka fakturakopior med post enligt önskemål.Skicka in er\nförfrågan till [ leverantorsgruppen@umea.se](mailto:leverantorsgruppen@umea.se)Sida 1-9; Gratis.Sida\n10; 50 krSida 11--; 2 kr / sidaPorto tillkommer. Ingen moms debiteras.Vid utdrag avfakturakopior behöver vi era faktureringsuppgifter.Organisationsnummer Namn Kundreferens Adress Postnummer ort "},"dct:identifier":"leverantorsfakturor-2019@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2021-11-24T12:56:07.036000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-11-24T12:56:07.036000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2019"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomi, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:leverantorsgruppen@umea.se"}}],"@id":"urn:source:86c88c7ef35f266163f8e823c7485d44143878de44aa4b9717564d7c9d04d2db"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-