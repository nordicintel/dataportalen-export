tact_email=detaljplanering%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/gallande-detaljplaner-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Detaljplan"},{"@language":"sv","@value":"Gällande detaljplaner"},{"@language":"sv","@value":"Markanvändning"},{"@language":"sv","@value":"Planering"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/gallande-detaljplaner/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Kommunens fysiska planering avgör\nhur mark- och vattenområden ska användas. I detaljplaner regleras bland annat\nbebyggelse, gator, parker och friluftsområden. Detaljplanerna ligger till grund\nför beslut om till exempel bygglov.\nDetta dataset visar var, inom kommunens gränser det finns en gällande\nplan, vilket aktnummer planen har och när planen fick laga kraft.  Med aktnumret kan du sedan kontakta kommunen och få ut\ngällande plan med bestämmelser som visar vad som möjliggörs i just ditt område. Olika typer av planer i datasetet är:\ndetaljplaner, områdesbestämmelser, ändringsplaner,\nbyggnadsplaner, stadsplaner och generalplaner.Vid frågor kontakta detaljplanering@umea.se"},"dct:identifier":"gallande-detaljplaner@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-11T22:44:07.658000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T22:44:07.658000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Gällande detaljplaner"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Detaljplanering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=detaljplanering%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Detaljplanering, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:detaljplanering@umea.se"}}],"@id":"urn:source:7ffa5830e225b8e18dc4e5a73351c4c74548248401ff40f1d6a12f77aee4a160"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"http