2.1/catalog/datasets/skyddade-omraden-naturreservat-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/skyddade-omraden-naturreservat-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/skyddade-omraden-naturreservat-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/skyddade-omraden-naturreservat-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/skyddade-omraden-naturreservat-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/skyddade-omraden-naturreservat-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Skyddsområde"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/skyddade-omraden-naturreservat/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Länsstyrelserna och kommunerna kan bilda naturreservat enligt miljöbalken. Naturreservat bildas i ”syfte att bevara biologisk mångfald, vårda och bevara värdefulla naturmiljöer eller tillgodose behov av områden för friluftslivet. Ett område som behövs för att skydda, återställa eller nyskapa värdefulla naturmiljöer eller livsmiljöer för skyddsvärda arter får också förklaras som naturreservat.” (ur miljöbalken). Sverige har drygt 3 300 naturreservat.Denna datamängd kommer ursprungligen från [Naturvårdsverket](http://www.naturvardsverket.se/). Vi har filtrerat ursprungsdatat så att endast data för Västerbotten visas.Beskrivningar för de olika kolumnerna kan komma att saknas om det inte fanns någon kopplad till datamängden då vi importerade den.Om du har frågor kring skyddade områden kontakta Naturvårdsverket."},"dct:identifier":"skyddade-omraden-naturreservat@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-04T02:17:10.279000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-04T02:17:10.279000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Skyddade områden: Naturreservat"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:3fa3cd22b35a01020403987688d721ab3ead2efa84b3c94fddbd1cd1e3cde718"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-193613-innertavles-och-yttertavles-omlan-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-193613-innertavles-och-yttertavles-omlan/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 193613 (Innertavles och Yttertavles omland) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T23:03:52.062000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T23:03:52.062000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/e