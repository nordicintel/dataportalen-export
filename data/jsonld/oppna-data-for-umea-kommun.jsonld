den-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Bygglov"},{"@language":"sv","@value":"Inlämnade ansökningar"},{"@language":"sv","@value":"Upprättade ärenden"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/bygglov-inkomna-arenden/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:description":{"@language":"sv","@value":"Data för ärenden inlämnade från 16 november 2023 kommer inte synas då vi har bytt ärendehanteringssystem. Vi jobbar på att dela ny data så fort vi kan!Statistik över inlämnade ansökningar och upprättade ärenden hos Bygglov, Umeå kommun. Ärendena omfattar ansökningar om bygglov, marklov, rivningslov, anmälningspliktiga åtgärder samt strandskyddsdispenser men även upprättade tillsynsärenden. Statistiken över inkomna och upprättade är från 2013-01-01. "},"dct:identifier":"bygglov-inkomna-arenden@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:13.325000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:55:13.325000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Bygglov - Inlämnade ansökningar och upprättade ärenden"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Bygglov%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=bygglov%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Bygglov, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:bygglov@umea.se"}}],"@id":"urn:source:b398df7a1438476a5bac7bb5bde0b96c950c3332d06660ff8cca888dc74ce7ed"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publi