tasets/umea-kommun-transportutslapp-google-data","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Digitalisering+och+verksamhetsutveckling&refine.dcat.contact_email=oppnadata%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-kommun-transportutslapp-google-data-xlsx"}],"dcat:keyword":"Umeå kommun","dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/umea-kommun-transportutslapp-google-data/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:description":{"@language":"sv","@value":"Denna datamängd består av en sammanställning av Googles Environmental insights uppskattning av transportutsläpp inom Umeå kommun per år. Förutom skattat utsläpp så finns information om totalt alla resor, per år, som gjorts inom Umeå kommuns gräns samt resor som passerat kommunens gräns.Total ressträcka för alla resor aggregeras och modelleras för hela kommunen med hjälp av aggregerad platsinformation från Google platshistoria och andra källor.Årliga transportutsläpp beräknas baserat på en extrapolering av den totala sträckan för alla gjorda resor, typ av transportsätt och genomsnittlig bränsleförbrukning för varje transportsätt. Regionalt uppskattat genomsnittlig bränsleförbrukning och utsläpp från klimatåtgärden för stadshållbarhetsverktyg (Curb) tillämpas på alla resor för varje läge.För ytterligare information - besök [Google Environmental Insights Explorer - Make Informed Decisions](https://insights.sustainability.google/)Källa: Google Environmental Insights Explorer (2025-05-13)"},"dct:identifier":"umea-kommun-transportutslapp-google-data@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-05-12T12:02:00.171000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-05-12T12:02:00.171000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Umeå kommun, antal resor och transportutsläpp"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Digitalisering+och+verksamhetsutveckling&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Digitalisering och verksamhetsutveckling","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:40908a22eeaf98675abd1de1772a47087dbfdd556a94eb7eeca50ebeea79badf"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/a