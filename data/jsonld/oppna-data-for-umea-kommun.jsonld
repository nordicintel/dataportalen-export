ta.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/nyckelkodsomraden_2siffer-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Area"},{"@language":"sv","@value":"Befolkning"},{"@language":"sv","@value":"NYKO2"},{"@language":"sv","@value":"Nyckelkodsområde"},{"@language":"sv","@value":"Statistik"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/nyckelkodsomraden_2siffer/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:description":{"@language":"sv","@value":"Umeå kommun är indelad i nyckelkodsområden, Nyckelkodsområden är sin finaste indelning på en 6-siffrig nivå som sedan kan aggregeras upp till 5-siffrig, 4-siffrig, 3-siffrig och två-siffrig-nivå. Det vanliga är att använda 6-siffrig eller 2-siffrig nivå- Detta dataset är aggregerat på en 2-siffrig nivå.Indelningen är i första hand gjord för att kunna planera olika kommunala verksamheter utifrån hur många som bor i kommunens olika delar.Notera att kartgränserna endast är indikationer på gränserna.Datamängden uppdateras normalt en gång per år eller vid behov.För frågor kontakta analysgruppen@umea.se"},"dct:identifier":"nyckelkodsomraden_2siffer@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-08T07:52:02+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2022-11-08T07:52:02+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Nyckelkodsområden, 2-siffrig nivå"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik och analys, Övergripande planering, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:analysgruppen@umea.se"}}],"@id":"urn:source:6909375c89b6a7d13f89d579108fd3e609c388332901004b582115461b6f47ac"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-174914-savars-omland-ostra-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-174914-savars-omland-ostra/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 174914 (Sävars omland, östra) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2021-10-17T04:21:08.920000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-10-17T04:21:08.920000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"http