quet","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1/exports/parquet"},"dcat:mediaType":"application/parquet","dct:description":{"@language":"sv","@value":"Flygplatsstatistik Umeå flygplats (parquet)"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-09-19T00:00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-22T02:01:11.547000+00:00"},"dct:title":{"@language":"sv","@value":"parquet"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-rdfxml","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1/exports/rdfxml"},"dct:description":{"@language":"sv","@value":"Flygplatsstatistik Umeå flygplats (rdfxml)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-09-19T00:00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-22T02:01:11.547000+00:00"},"dct:title":{"@language":"sv","@value":"rdfxml"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1-turtle","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/flygplatsstatistik_1/exports/turtle"},"dct:description":{"@language":"sv","@value":"Flygplatsstatistik Umeå flygplats (turtle)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-09-19T00:00:00"},"dct:language":{"@id":"http://publication