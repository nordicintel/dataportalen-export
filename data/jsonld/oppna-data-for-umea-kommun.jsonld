e":"xsd:dateTime","@value":"2024-03-21T12:05:56.617000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-03-21T12:05:56.617000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/miljobilar-i-kommunorganisationen","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-i-kommunorganisationen-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":" Statistik"},{"@language":"sv","@value":"Kolada"},{"@language":"sv","@value":"Miljöbilar"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/miljobilar-i-kommunorganisationen/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:description":{"@language":"sv","@value":"Miljöbilar i kommunorganisationen, andel (%)Detta är ett utvecklingsnyckeltal, se frågor och svar på kolada.se för mer information. Andel personbilar och lätta lastbilar som uppfyller miljöbilskrav enligt förordning. Från 1 juli 2018 avser uppgiften klimatbonusbilar. För fordon registrerade före 1 jan 2013 används tidigare miljöbilsdefinition (SFS 2004:1364). För fordon registrerade från 1 januari 2013 används ny miljöbilsdefinition (Vägtrafikskattelagen SFS 2006:227). Avser bilar som enligt vägtrafikregistret är registrerade på kommunen och dess majoritetsägda bolag. Miljöfordon Sverige har gett möjlighet till kommuner och landsting att komplettera med fordon i operationell leasing samt justera för andra avvikelser. Ingår i Kommunens kvalitet i korthet (KKiK).Källa: Miljöfordon Sverige (MFS).Detta är angivet enligt den statistik som tidigare återfanns på Kolada.I Kolada kan alla söka information om Umeå kommun. "},"dct:identifier":"miljobilar-i-kommunorganisationen@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2024-03-21T12:05:56.617000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-03-21T12:05:56.617000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Miljöbilar i kommunorganisationen (Kolada)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se","@type":"