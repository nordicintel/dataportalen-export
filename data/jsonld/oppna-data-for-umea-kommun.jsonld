atser-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/rastplatser-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/rastplatser-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/rastplatser-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/rastplatser-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Rastplatser"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/rastplatser/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:description":{"@language":"sv","@value":"Det finns iordningställda rastplatser runtom i Umeå kommun på vissa av dem finns det grillmöjligheter. I denna datamängd har vi samlat de rastplatser som finns samt kort information om dessa.Denna datamängd uppdateras oregelbundet. Det kan finnas felaktigher i t.ex. positioner och det kan även vara så att rastplatser har försvunnit eller tillkommit mellan uppdateringar.Om du har frågor om våra rastplatser kontakta [umea.fritid@umea.se](mailto:umea.fritid@umea.se)"},"dct:identifier":"rastplatser@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-13T01:15:09.723000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-13T01:15:09.723000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Rastplatser"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Fritid%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=umea.fritid%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fritid, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:umea.fritid@umea.se"}}],"@id":"urn:source:7a9351f95fa5a8546a8475c2