.961000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-01-21T11:45:51.961000+00:00"},"dct:title":{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Umeå stad, antal resor och transportutsläpp (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-21T11:45:51.961000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-01-21T11:45:51.961000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/umea-transportation-emissions-google-data","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Digitalisering+och+verksamhetsuveckling&refine.dcat.contact_email=oppnadata%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/umea-transportation-emissions-google-data-xlsx"}],"dcat:keyword":"Umeå kommun","dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/umea-transportation-emissions-google-data/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:description":{"@language":"sv","@value":"Denna datamängd består av en sammanställning av Environmental insights uppskattning av transportutsläpp inom Umeå stad per år. Förutom skattat utsläpp så finns information om totalt alla resor, per år, som gjorts inom Umeås stadsgräns samt resor som passerat stadens gräns.Total ressträcka för alla resor aggregeras och modelleras för hela staden med hjälp av aggregerad platsinformation från Google platshistoria och andra källor.Årliga transportutsläpp beräknas baserat på en extrapolering av den totala sträckan för alla gjorda resor, typ av transportsätt och genomsnittlig bränsleförbrukning för varje transportsätt. Regionalt uppskattat genomsnittlig bränsleförbrukning och utsläpp från klimatåtgärden för stadshållbarhetsverktyg (Curb) tillämpas på alla resor för varje läge.Källa: Environmental Insigts Explorer (2024-05-13)"},"dct:identifier":"umea-transportation-emissions-google-data@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-21T11:45:51.961000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resour