23.299000+00:00"},"dct:title":{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Matematikgränd peakload shaving (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:59:23.299000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:59:23.299000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/matematikgrand-peakload-shaving","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi%252C+Datalager&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matematikgrand-peakload-shaving-xlsx"}],"dcat:keyword":["Umeå Energi",{"@language":"sv","@value":"Laststyrning"},{"@language":"sv","@value":"Peakload"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/matematikgrand-peakload-shaving/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:description":{"@language":"sv","@value":"\n\n\nGenom att anpassa fjärrvärmeanvändningen (meter_effect) under kritiska tillfällen\nunder ett dygn när det är hög last kan man minska klimatpåverkan. Idén är att\ngenom att minska användning av fjärrvärme när det är som mest press på systemet,\nkan man minska klimatpåverkan genom att slippa använda mindre klimatvänliga\nbränslen. \n  \nDetta dataset\nbeskriver hur man genom att artificiellt signalera en lägre utomhustemperatur\n(outdoortemp_offset) än den faktiska utomhustemperaturen (outdoortemp)\n\"lurar\" styrningen att det är varmare ute. Men för att det inte ska\nbli för kallt inne och offra komfort i byggnaden, finns det en\nbudget/begränsning för hur mycket man får styra ner vilket styrs genom\ntemperaturgivare i fastigheten, som ligger på Matematikgränd i Umeå.Detta dataset kan med fördel kombineras med dataset [Ålidhem HC peakload shaving](https://opendata.umea.se/explore/dataset/alidhem-hc-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit) & [Samverkanshuset peakload shaving](https://opendata.umea.se/explore/dataset/samverkanshuset-peakload-shaving/table/?disjunctive.sensorname&disjunctive.type_of_premises&disjunctive.type_of_frame&disjunctive.unit&sort=timestamp), då de tre byggnaderna tillsammans bildar ett grid. För att relatera utfallet mot prognostiserade värden för hela griden se dataset [Laststyrning prognos & utfall](https://opendata.umea.se/explore/dataset/peakload-prognosis-actual/table/?sort=timestamp). \n\n\n"},"dct:identifier":"matematikgrand-peakload-shaving@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-17T14:59:23.299000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-17T14:59:23.299000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Matematikgränd peakload shaving"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi%252C+Datalager&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi, Datalager","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:e23ca71820c93c8fd794edd5d9b1cdec04358d8c1b6f5ba97bd71545153129fe"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":"Umeå kommun"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/getteamsuseractivityusercounts-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/getteamsuseractivityusercounts/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Microsoft Teams-användare efter aktivitetstyp (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-01T02:13:04.331000+00:00"