ts/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Resultat stadsdelsdialogen 2019 Övrigt (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2020-09-30T07:20:34+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-09-30T07:20:34+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/resultat-stadsdelsdialogen-2019-ovrigt-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Dialog"},{"@language":"sv","@value":"Planering"},{"@language":"sv","@value":"Stadsdelar"},{"@language":"sv","@value":"medborgardialog"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/resultat-stadsdelsdialogen-2019-ovrigt/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Under hösten 2019 har Umeå kommun genomfört en dialog om Umeås stadsdelar. Vi ville bland annat veta vilka platser man trivs och inte trivs på samt vad man önskar för sin stadsdel i framtiden. Synpunkter har samlats in både vid dialogmöten i stadsdelarna men även via en digital karta och resultaten från båda delarna ingår i detta dataset.  Resultaten är indelade i tre olika datamängder varav denna behandlar svaren på frågorna om vad man önskar för sin stadsdel i framtiden och vad man skulle sakna vid flytt. Resterande datamängder hittas [här](https://opendata.umea.se/explore/dataset/resultat-stadsdelsdialog-2019-otrivsamma-platser/) och [här](https://opendata.umea.se/explore/dataset/resultat-stadsdelsdialog-2019/table/)."},"dct:identifier":"resultat-stadsdelsdialogen-2019-ovrigt@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2020-09-30T07:20:34+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-09-30T07:20:34+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Resultat stadsdelsdialogen 2019 Övrigt"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine