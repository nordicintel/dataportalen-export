:{"@language":"sv","@value":"turtle"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-xlsx","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall/exports/xlsx?use_labels=true"},"dct:description":{"@language":"sv","@value":"Insamling av avfall (Kolada) (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-16T13:28:03.027000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T13:28:03.027000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/insamling-av-avfall","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/insamling-av-avfall-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Avfall"},{"@language":"sv","@value":"Hushållssopor"},{"@language":"sv","@value":"Kolada"},{"@language":"sv","@value":"Statistik"},{"@language":"sv","@value":"Återvinning"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/insamling-av-avfall/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Antal kilogram insamlat hushållsavfall per justerat invånarantal i Umeå kommun. I hushållsavfall ingår mat- och restavfall (tidigare benämt kärl- och säckavfalll), grovavfall inklusive trädgårdsavfall, farligt avfall, jämförligt avfall från bland annat affärer, kontor, industrier och restauranger, samt den del av hushållsavfallet som omfattas av producentansvar (förpackningar, tidningar, elavfall, batterier etc.), även om det inte faller under kommunalt renhållningsansvar. Invånarantalet justeras med hänsyn till fritidshus, gästnätter och in-/utpendling. I utpräglade fritidshuskommuner eller kommuner med omfattande turistverksamhet genereras betydligt mer hushållsavfall än vad de permanentboende ger upphov till. Även i kommuner med stort inpendlingsöverskott genereras mycket hushållsavfall via arbetsplatserna. Genom att använda ett justerat invånarantal speglas mängden avfall per person på ett mer korrekt sätt för den egna kommunen, vilket underlättar jämförelser med andra kommuner.  Datamängden är hämtad från KoladaI Kolada kan alla söka information om Umeå kommun. En ny förfrågan på data görs mot Kolada en gång i månaden."},"dct:identifier":"insamling-av-avfall@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-16T13:28:03.027000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T13:28:03.027000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Insamling av avfall (Kolada)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik och Analys, Övergripande planering, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:analysgruppen@umea.se"}}],"@id":"urn:source:deecdd38620cb43ff68645afbb7a737696a7d4700949c7367fa6f96e0cec4d08"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-102403-hossjo-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-102403-hossjo/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 102403 (Hössjö) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T23:03:30.882000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T23:03: