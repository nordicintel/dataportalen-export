rce/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Här hittar du flygfoton från 2019 som tagits över Umeå stad. Till varje foto finns information om vilken stadsdel den är tagen över, i vilken riktning, samt grov uppskattning på positionen för bildcentrum Det finns två format att ladda ner en bild i. Större bilder är i formatet .jpg och har hög upplösning, .png bilder har lägre upplösning.Fotografierna i original är inte anpassade efter kompassriktning, i webbläsaren när du tittar på bilden. Enklaste sättet att se den mer högupplösta bilden från kartläget är att trycka på knappen \"Öppna högupplöst jpg\" längst ned. "},"dct:identifier":"flygfoton-over-umea@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2021-04-16T09:10:32.154000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2021-04-16T09:10:32.154000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Flygfoton över Umeå"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Lantm%C3%A4teri%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=lantmateri%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Lantmäteri, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lantmateri@umea.se"}}],"@id":"urn:source:d6b36c32dd06d2bc9e2608b736bfbfc072814a0682e20a27bad1356f2917f146"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-