on finns hos Nobil.Energimyndigheten har nu tagit över registrering av svenska\nladdstationer, med andra ord ansvaret för Sveriges laddstationsdata i den\nnorska databasen Nobil.\n\n\nDet kan finnas brister i datat, i synnerhet det data som\nregistrerades innan Energimyndigheten tog över ansvaret för registreringen. Ett\nAPI med möjlighet att använda andra data och data över andra geografiska\nområden finns hos Nobil.Datat uppdateras 1 gång per månad."},"dct:identifier":"laddplatser@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-09-14T02:00:27.714000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-14T02:00:27.714000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Laddplatser i Umeå"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:957e5c1812285780181929a6249e92116c1a421b8417a6c78ca176689c5dc23e"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-092018-industriomrade-volvo-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-092018-industriomrade-volvo/re