ad uppskattning av förbrukningen i syfte att se trender och indikationer.Datafilerna kommer endast innehålla värden för fastigheter i Umeå kommun där Umeå Energi är nätägare och informationen inte anses vara olämplig för distribution. Uppdateras normalt en gång varje månad med nytillkomna värden.Frågor kring detta förbrukningsdata hänvisas till matdata.datalager@umeaenergi.se "},"dct:identifier":"energiforbrukning-i-geografiska-omradet-184901-holmon0@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T22:09:04.263000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T22:09:04.263000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 184901 (Holmön)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:89732270cbf2d16c1fe3627333eb3fa874788445ec9dd370e4cf62e20b1f0764"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/a1e87c9dd15ad3940293a45bc00a7574","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Vatten- och avfallskompetens i norr AB"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matavfall-utsortering-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/matavfall-utsortering/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/ap