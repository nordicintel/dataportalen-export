carlslid-xlsx"}],"dcat:keyword":["Umeå Energi",{"@language":"sv","@value":"El"},{"@language":"sv","@value":"Energi"},{"@language":"sv","@value":"Fjärrvärme"},{"@language":"sv","@value":"Förbrukning"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/energiforbrukning-i-geografiska-omradet-112907-carlslid/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:description":{"@language":"sv","@value":"Anonymiserad förbrukningsdata från Umeå Energi per nyckelkodsområde i Umeå Kommun. Detta data bör inte ses som exakta och kompletta förbrukningsvärden utan mer som en kvalificerad uppskattning av förbrukningen i syfte att se trender och indikationer.Datafilerna kommer endast innehålla värden för fastigheter i Umeå kommun där Umeå Energi är nätägare och informationen inte anses vara olämplig för distribution. Uppdateras normalt en gång varje månad med nytillkomna värden.Frågor kring detta förbrukningsdata hänvisas till matdata.datalager@umeaenergi.se "},"dct:identifier":"energiforbrukning-i-geografiska-omradet-112907-carlslid@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-31T22:11:05.540000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-31T22:11:05.540000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 112907 (Carlslid)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:159d1e7420299658046ad1701a1ea7198