icense":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2019-12-19T07:43:52.844000+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/radonriskomraden","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6-+och+h%C3%A4lsoskydd+Ume%C3%A5+kommun&refine.dcat.contact_email=miljoochhalsoskydd%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/radonriskomraden-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Radon"},{"@language":"sv","@value":"Radongas"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/radonriskomraden/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Radongas finns naturligt i jord och bergarter. Jordluften innehåller därför nästan alltid radon. Lufttrycket är oftast lägre inomhus än utomhus och radon kan därför sugas in i hus från marken. Om stora mängder jordluft läcker in i huset finns det alltid risk för höga radonhalter inomhus.Radonsituationen i kommunen har översiktligt undersökts och redovisats på en radonriskkarta som visar områden med låg, normal och högrisk för markradon. Det har dock visat sig att klassningen av marken inte har så stor betydelse för hur många hus med förhöjda radonhalter man hittar. Den viktigaste faktorn är om det finns otätheter i bottenplatta eller bjälklag som gör att jordluft tränger in i husen. Om du har frågor kring datamängden kontakta miljoochhalsoskydd@umea.se"},"dct:identifier":"radonriskomraden@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2019-12-19T07:43:52.844000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2019-12-19T07:43:52.844000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Radonriskområden"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6-+och+h%C3%A4lsoskydd+Ume%C3%A5+kommun&refine.dcat.contact_email=miljoochhalsoskydd%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljö- och hälsoskydd Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoochhalsoskydd@umea.se"}}],"@id":"urn:source:6a6ac7077ded203644dfee34fbbbcca19405e0efcc52ef778e4976c05dc77634"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-123002-mariehem-radhus-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-123002-mariehem-radhus/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 123002 (Mariehem (radhus)) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-17T01:14:05.823000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-17T01:14:05.823000+00:00"},"dct:title":{"@language":"sv","@value":"API"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-123002-mariehem-radhus-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-123002-mariehem-radhus/exports/csv?use_labels=true"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 123002 (Mariehem (radhus)) (csv)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-17T01:14:05.823000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authori