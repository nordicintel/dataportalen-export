tact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":" Statistik"},{"@language":"sv","@value":"Bilar"},{"@language":"sv","@value":"Kolada"},{"@language":"sv","@value":"Miljöbilar"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:description":{"@language":"sv","@value":"Antal miljöbilar i trafik dividerat med totalt antal bilar i trafik, multiplicerat med 100. Avser den 31/12 och den geografiska kommunen/regionen. Från 1 juli 2018 avser uppgiften klimatbonusbilar. Avser bilar som vid tiden för registrering uppfyllde kraven för miljöbil. Detta innebär att bilar registrerade före den 1 januari 2013 ska uppfylla kriterierna för MB2007 och bilar registrerade 1 januari 2013 eller senare ska uppfylla kriterierna för MB2013. Källa: SCB.Detta är angivet enligt den statistik som tidigare fanns på Kolada.I Kolada kan alla söka information om Umeå kommun. "},"dct:identifier":"miljobilar-andel-av-totalt-antal-bilar-i-det-geografiska-omradet-kolada@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2020-01-22T11:02:58+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-01-22T11:02:58+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Miljöbilar, andel av totalt antal bilar i det geografiska området, (%) (Kolada)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Statistik+och+Analys%252C+%C3%96vergripande+planering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=analysgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistik och Analys, Övergripande planering, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:analysgruppen@umea.se"}}],"@id":"urn:source:400422b853940b8aaa5cb8d533494a6506826b954c24957d753ec851aac2b6f6"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent","