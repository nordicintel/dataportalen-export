iption":{"@language":"sv","@value":"Exempel Bolag i Umeå (Öppna data från Bolagsverket) (xlsx)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-06-02T10:41:21+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"https://creativecommons.org/publicdomain/zero/1.0/deed.sv"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-06-02T10:41:21+00:00"},"dct:title":{"@language":"sv","@value":"xlsx"}},{"@id":"https://opendata.umea.se/api/v2/catalog/datasets/test_bolagsdata","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se"},"dcat:distribution":[{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-API"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-csv"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/test_bolagsdata-xlsx"}],"dcat:keyword":"Umeå kommun","dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/test_bolagsdata/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:description":{"@language":"sv","@value":"Vill du ha information om företag i kommunen kan du söka denna hos Bolagsverket.Bolagsverkets öppna data innehåller en mängd information om företag.Detta dataset innehåller information om företag där postnumret i adressen finns inom  Umeå kommuns gränser. Det är inte säkert att verksamheten bedrivs i Umeå. På motsvarande sätt kan det finnas företag med adressen utanför Umeå kommun som bedriver verksamhet inom Umeå kommuns gränser.Du finner information om Bolagsverkets öppna data här: https://bolagsverket.se/apierochoppnadata.2531.html Detta är ett exempel på den data som kan hämtas. Denna datamängd uppdateras (hämtas)  inte regelbundet av denna portal och kan därför vara missvisande. Detta gäller särskilt bokslutsinformationen. Vill du ha aktuella data hänvisar vi dig till Bolagsverket."},"dct:identifier":"test_bolagsdata@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-06-02T10:41:21+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-06-02T10:41:21+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Exempel Bolag i Umeå (Öppna data från Bolagsverket)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=%C3%96ppna+Data+Ume%C3%A5+kommun&refine.dcat.contact_email=oppnadata%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna Data Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@umea.se"}}],"@id":"urn:source:fee804559e07ed114a0731fe3c61a5ec94c6d282a69011fc320ab2e53600e261"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"