endata.umea.se/explore/dataset/pagaende-detaljplaner0/"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:description":{"@language":"sv","@value":"Här hittar du information om pågående detaljplaner.Kommunens fysiska planering avgör hur mark- och\nvattenområden ska användas. I detaljplaner regleras bland annat bebyggelse,\ngator, parker och friluftsområden. Detaljplanerna ligger till grund för beslut\nom till exempel bygglov.  Ta del av gällande och pågående detaljplaner Du kan hitta de flesta av våra detaljplaner och\nområdesbestämmelser via någon av kartorna nedan. Kartorna hittar du även på\nsidan för [gällande detaljplaner](https://www.umea.se/byggaboochmiljo/oversiktsplanochdetaljplaner/detaljplanerochomradesbestammelser/gallandedetaljplanerochomradesbestammelser.4.7d7d901172bb372c5d2d7d.html) och på sidan med [pågående detaljplaner](https://www.umea.se/byggaboochmiljo/oversiktsplanochdetaljplaner/detaljplanerochomradesbestammelser/pagaendedetaljplaner.4.7c1df79418a3ef90b26da4e8.html). Ytorna som illustreras i webbkartan för pågående planer ska\nförstås som preliminära, det vill säga, de kan ändras under planprocessens\ngång. Ytorna indikerar att det pågår ett planarbete på platsen och färgen\npå ytan visar i vilken fas planarbetet befinner sig. Ytan illustrerar den ungefärliga utbredningen som planen\nhar. Definitiv blir ytan först när planen får laga kraft och ytan övergår då\ntill webbkartan för gällande planer.  Om du använder ytorna genom att ladda ner dem via\nöppna-data-portalen, till exempelvis till GIS-analys eller liknande, ansvarar\ndu själv för kvaliteten i datamaterialet. Till varje pågående detaljplan finns en projektsida där du\nkan ta del av de olika handlingarna som hör till planen. Om du har frågor kring datamängden kontakta detaljplanering@umea.se\nDatamängden uppdateras regelbundet."},"dct:identifier":"pagaende-detaljplaner0@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-16T22:00:45.875000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T22:00:45.875000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Pågående detaljplaner"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Detaljplanering%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=detaljplanering%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Detaljplanering, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:detaljplanering@umea.se"}}],"@id":"urn:source:5cb951e1f20155e5cbd0d13188b13eb6d141d26d06f055fd9a795da85d5dfea8"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-154006-djupviksandvik-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-154006-djupviksandvik/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 154006 (Djupvik/Sandvik) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T22:57:04.521000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modifi