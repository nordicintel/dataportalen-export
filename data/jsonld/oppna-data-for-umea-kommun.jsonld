talog/datasets/leverantorsfakturor-2024-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2024-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/leverantorsfakturor-2024-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsfakturor"}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/leverantorsfakturor-2024/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:conformsTo":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"},"dct:description":{"@language":"sv","@value":"Information om Umeå kommuns inkomna leverantörsfakturor för 2024 finns samlade i denna datamängd. Datat presenteras i tabellform och innehåller konteringsmånad, förvaltning, leverantör, organisationsnummer, konto, kontotext, summa (exkl. moms), verifikationsnummer och fakturanummer. Viss data är dolt enligt GDPR. Inga fakturabilder finns presenterade. Informationen går att ladda ner i filformat CSV, JSON och Excel.Vi kan ta fram och skicka fakturakopior med post (ej digitalt) enligt önskemål.\nÅterkom med vilka verifikationsnummer du vill ha kopior på, gärna i excelformat.Skicka in er förfrågan till [leverantorsgruppen@umea.se](mailto:leverantorsgruppen@umea.se)Sida 1-9; Gratis.Sida 10; 50 krSida 11--; 2 kr / sidaPorto tillkommer. Ingen moms debiteras.Vid utdrag av fakturakopior behöver vi era faktureringsuppgifter samt adress dit fakturakopiorna ska skickas.Organisationsnummer Namn Kundreferens Adress Postnummer ort "},"dct:identifier":"leverantorsfakturor-2024@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2025-01-04T05:11:40.093000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2025-01-04T05:11:40.093000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Leverantörsfakturor 2024"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ekonomi%252C+Ume%C3%A5+kommun&refine.dcat.contact_email=leverantorsgruppen%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ekonomi, Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:leverantorsgruppen@umea.se"}},{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokumentation Leverantörsreskontra"},"dct:title":{"@language":"sv","@value":"Dokumentation Leverantörsreskontra"}}],"@id":"urn:source:08b995a27c648d019b2b311b7073e029c0d09d3f3e3cedb80c9b9241bc200781"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-102406-stocke-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-102406-stocke/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 102406 (Stöcke) (API)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-01-16T23:15:22.726000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2024-01-16T23:15:2