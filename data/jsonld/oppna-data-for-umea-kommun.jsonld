 innehålla värden för fastigheter i Umeå kommun där Umeå Energi är nätägare och informationen inte anses vara olämplig för distribution. Uppdateras normalt en gång varje månad med nytillkomna värden.Frågor kring detta förbrukningsdata hänvisas till matdata.datalager@umeaenergi.se "},"dct:identifier":"energiforbrukning-i-geografiska-omradet-030404-vast-pa-stan@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-01T20:53:05.816000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-01T20:53:05.816000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02"},"dct:title":{"@language":"sv","@value":"Energiförbrukning i Geografiska området 030404 (Väst på stan)"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Ume%C3%A5+Energi&refine.dcat.contact_email=matdata.datalager%2540umeaenergi.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Umeå Energi","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matdata.datalager@umeaenergi.se"}}],"@id":"urn:source:27f1d4a9018abd1e37d7396b9b3c6b071da5d12ddfdf1d531930d240dc487698"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/fd2584866d01e4eaee64e3ffcfe40e02","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:name":{"@language":"sv","@value":"Umeå Energi"}},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-081702-rodasel-API","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/energiforbrukning-i-geografiska-omradet-081702-rodasel/records"},"dct:conformsTo":{"@id":"https://opendata.umea.se/api-console/explore/v2.1/"},"dct:description":{"@l