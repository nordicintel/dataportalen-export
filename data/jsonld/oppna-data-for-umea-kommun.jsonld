/catalog/datasets/generellt_strandskydd-fgb"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-geojson"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-gpx"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-json"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-jsonl"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-jsonld"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-kml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-n3"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-ov2"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-parquet"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-rdfxml"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-shp"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-turtle"},{"@id":"https://opendata.umea.se/api/explore/v2.1/catalog/datasets/generellt_strandskydd-xlsx"}],"dcat:keyword":["Umeå kommun",{"@language":"sv","@value":"Kust"},{"@language":"sv","@value":"Sjö"},{"@language":"sv","@value":"Strandskydd"},{"@language":"sv","@value":"Vattendrag "}],"dcat:landingPage":{"@id":"https://opendata.umea.se/explore/dataset/generellt_strandskydd/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Strandskyddet är ett generellt områdesskydd vid hav, sjöar, vatten och öar.  I allmänhet gäller det 100 meter inåt land och lika långt ut i vattnet från strandlinjen, men skyddet kan vara utökat genom särskilt beslut upp till 300 meter både inåt land och ut i vattnet. Strandskyddet kan dock vara upphävt i ett område för en detaljplan om det har funnits särskilda skäl. Länsstyrelsen kan också ha upphävt strandskyddet för ett område. Det finns även områden som inte omfattas av strandskydd på grund av äldre regler.Avgränsning av det generella strandskyddet har gjorts enligt beslutsunderlag från 1979. Strandlinjerna har digitaliserats utifrån GSD Terrängkarta(2017). Urvalet av vattendrag har gjorts utifrån den georefererade kartbild med Länsstyrelsens beslut 1979 och Regeringens beslut 1989. I underlaget har mindre öar i sjöar och mindre sjöar på öar inte tagits med, dessa borde rymmas inom sjön/öns strandskyddsavgränsning på 100 m. De gränser som anges i denna datamängd ska endast ses som indikationer kring gränserna och inte som exakta gränser.Ursprungskälla till data är Länsstyrelsen Västerbotten.Vid frågor kring datamängden kontakta: miljoochhalsoskydd@umea.se"},"dct:identifier":"generellt_strandskydd@http://dataportal.se/organisation/SE2120002627","dct:issued":{"@type":"xsd:dateTime","@value":"2020-01-03T09:15:26.369000+00:00"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2020-01-03T09:15:26.369000+00:00"},"dct:publisher":{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722"},"dct:title":{"@language":"sv","@value":"Generellt strandskydd"}},{"@id":"https://opendata.umea.se/explore/?refine.dcat.contact_name=Milj%C3%B6-+och+h%C3%A4lsoskydd+Ume%C3%A5+kommun&refine.dcat.contact_email=miljoochhalsoskydd%2540umea.se","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljö- och hälsoskydd Umeå kommun","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljoochhalsoskydd@umea.se"}}],"@id":"urn:source:eac8193322c1fb65832b11103ae270250fb43a11e6d1cafba29e200e19cf7c29"},{"@graph":[{"@id":"https://admin.dataportal.se/store/43/resource/7a00bd3796ed09a600646432cb321722","@type":"foaf:Agent"