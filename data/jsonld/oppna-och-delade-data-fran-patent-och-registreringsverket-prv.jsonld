ta@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=2bbc7766c9224e9084da72c16e86097363b7bd0f9c2f4eb58d232b5e37cc26ac","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=2bbc7766c9224e9084da72c16e86097363b7bd0f9c2f4eb58d232b5e37cc26ac"},"dcat:keyword":[{"@language":"en","@value":"Patent Gazette"},{"@language":"en","@value":"application number"},{"@language":"en","@value":"granted patent"},{"@language":"en","@value":"invention"},{"@language":"en","@value":"patent application"},{"@language":"en","@value":"patent publication"},{"@language":"en","@value":"patent"},{"@language":"en","@value":"public notification"},{"@language":"en","@value":"publication number"},{"@language":"sv","@value":"ansökningsnummer"},{"@language":"sv","@value":"beviljat patent"},{"@language":"sv","@value":"kungörelse"},{"@language":"sv","@value":"patent"},{"@language":"sv","@value":"patentansökan"},{"@language":"sv","@value":"patentskrift"},{"@language":"sv","@value":"patenttidning"},{"@language":"sv","@value":"publiceringsnummer"},{"@language":"sv","@value":"uppfinning"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=2bbc7766c9224e9084da72c16e86097363b7bd0f9c2f4eb58d232b5e37cc26ac&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The Swedish Patent Gazette was a PDF publication containing announcements concerning patent applications and patents valid in Sweden, including European patents. It was published until February 2026, when it was replaced by electronic announcements in the Search PRV’s databases e-service.\n\nThe announcements published by PRV make it possible to monitor competitors’ patent activities in Sweden, follow patent applications within specific fields of technology, and access other relevant patent information.\n\nThe Swedish Patent Gazette was published every Tuesday, except on public holidays.\n\nThe gazette archive is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\nDirectory: Svensk_Patenttidning"},{"@language":"sv","@value":"Svensk patenttidning var en publikation i PDF-format som innehöll kungörelser om patentansökningar och patent med verkan i Sverige, inklusive europeiska patent. Tidningen publicerades fram till februari 2026, då den ersattes av elektroniska kungörelser i e-tjänsten Sök i PRV databaser.\n\nKungörelserna från PRV gör det möjligt att bevaka konkurrenters patentaktiviteter i Sverige, följa patentansökningar inom särskilda teknikområden och ta del av annan relevant patentinformation.\n\nSvensk patenttidning publicerades varje helgfri tisdag.\n\nTidningsarkivet finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\nKatalog: Svensk_Patenttidning"}],"dct:identifier":"2bbc7766c9224e9084da72c16e86097363b7bd0f9c2f4eb58d232b5e37cc26ac","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"The Swedish Patent Gazette"},{"@language":"sv","@value":"Svensk Patenttidning"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=2bbc7766c9224e9084da72c16e86097363b7bd0f9c2f4eb58d232b5e37cc26ac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Svensk Patenttidning"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:262ad0e1314445d88f65692b8034b0a01a961329e993708f5a17ead03e956221_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:262ad0e1314445d88f65692b8034b0a01a961329e993708f5a17ead03e956221_b1n0"}}],"@id":"urn:source:262ad0e1314445d88f65692b8034b0a01a961329e993708f5a17ead03e956221"},{"@graph":[{"@id":"_:40346bd28506cc9d6f6e573a76eb8e1e09de3b93d4ecf9411b926b74bcbb8ce8_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:40346bd28506cc9d6f6e573a76eb8e1e09de3b93d4ecf9411b926b74bcbb8ce8_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=5a0ff7b17e04469cb38bb50e68d6662e9aef27449a784e539763872924cf9ed6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=5a0ff7b17e04469cb38bb50e68d6662e9aef27449a784e539763872924cf9ed6"},"dcat:keyword":[{"@language":"en","@value":"codes"},{"@language":"en","@value":"document"},{"@language":"en","@value":"kind"},{"@language":"en","@value":"patent"},{"@language":"en","@value":"st.16"},{"@language":"en","@value":"standard"},{"@language":"sv","@value":"dokumentkoder"},{"@language":"sv","@value":"dokumenttyper"},{"@language":"sv","@value":"patent"},{"@language":"sv","@value":"st.16"},{"@language":"sv","@value":"standard"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=5a0ff7b17e04469cb38bb50e68d6662e9aef27449a784e539763872924cf9ed6&lang=sv"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"A list of the kind codes that are used for identifying different kinds of Swedish patent documents. The codes are mainly based on WIPO's standard ST.16.\n"},{"@language":"sv","@value":"En lista över de dokumentkoder (\"kind codes\") som används för att identifiera olika typer av svenska patentdokument. Koderna är i huvudsak baserade på WIPO:s standard ST.16.\n"}],"dct:identifier":"5a0ff7b17e04469cb38bb50e68d6662e9aef27449a784e539763872924cf9ed6","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Kind codes used on Swedish patent documents"},{"@language":"sv","@value":"Dokumentkoder för svenska patentdokument"}]},{"@id":"https://data.prv.se/di