,"dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=8fc30ad1e90c46669a79f9aa55bf755a568c021ae5224da396554b1e9053f3d8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=8fc30ad1e90c46669a79f9aa55bf755a568c021ae5224da396554b1e9053f3d8"},"dcat:keyword":[{"@language":"en","@value":"Bibliografic data"},{"@language":"en","@value":"IPC"},{"@language":"en","@value":"applicant"},{"@language":"en","@value":"class"},{"@language":"en","@value":"date"},{"@language":"en","@value":"inventor"},{"@language":"en","@value":"patent document"},{"@language":"sv","@value":"Bibliografisk data"},{"@language":"sv","@value":"IPC"},{"@language":"sv","@value":"datum"},{"@language":"sv","@value":"klass"},{"@language":"sv","@value":"patentdokument"},{"@language":"sv","@value":"sökande"},{"@language":"sv","@value":"uppfinnare"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=8fc30ad1e90c46669a79f9aa55bf755a568c021ae5224da396554b1e9053f3d8&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"en","@value":"This data set contains the bibliographic data of all Swedish national patent documents published since 2019-01-01.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\n\nFurther documentation about usage and formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"Denna datamängd innehåller bibliografiska uppgifter för alla svenska nationella patentdokument publicerade sedan 2019-01-01.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\n\nYtterligare dokumentation kring användning och format finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"8fc30ad1e90c46669a79f9aa55bf755a568c021ae5224da396554b1e9053f3d8","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Bibliografic data for Swedish patent documents 2019-"},{"@language":"sv","@value":"Bibliografiska data för svenska patentdokument 2019-"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=8fc30ad1e90c46669a79f9aa55bf755a568c021ae5224da396554b1e9053f3d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dcat:mediaType":"application/xml+zip","dct:description":"Standarddistribution","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"Distribution för Bibliografiska data för svenska patentdokument 2019-"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fc539f75eb622240998baf016ead1d57a2167ec3ae261ac8e65bcd2b817ed849_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":