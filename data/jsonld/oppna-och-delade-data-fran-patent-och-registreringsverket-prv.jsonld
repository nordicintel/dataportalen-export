dataset.jsp?uuid=888c893c424148159b41c080653dce973aa8d488e22d42c3aded43618c300f85&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"File Inspection is PRV's public archive for patent applications, Supplementary Protection Certificate (SPC) and extensions of SPC. Here you can view original documents and certain bibliographic data in all the public patent applications from 2004 onwards. The documents can be opened directly in the archive or downloaded as PDF files. A patent application is available to the public 18 months after the filing date or if priority is invoked 18 months after the application was originally filed."},{"@language":"sv","@value":"Aktinsyn är PRV:s offentliga arkiv för patentansökningar, tilläggsskyddsärenden samt förlängda tilläggsskyddsärenden. Här kan du titta på originalhandlingar och vissa bibliografiska uppgifter i alla offentliga patentansökningar från 2004 och framåt. En patentansökan blir offentlig efter 18 månader från ansökans ingivningsdag, eller om prioritet åberopas, 18 månader från prioritetsdagen. Dokumenten öppnas direkt i arkivet eller laddas ner som pdf-filer."}],"dct:identifier":"888c893c424148159b41c080653dce973aa8d488e22d42c3aded43618c300f85","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"File Inspection"},{"@language":"sv","@value":"Aktinsyn"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=888c893c424148159b41c080653dce973aa8d488e22d42c3aded43618c300f85","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://tc.prv.se/aktinsyn/servlet/akt/?lang=sv"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Aktinsyn"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:70417ea95b5c9dcaf34e83579ba064bb85525865821fc5454678dede60795321_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:70417ea95b5c9dcaf34e83579ba064bb85525865821fc5454678dede60795321_b1n0"}}],"@id":"urn:source:70417ea95b5c9dcaf34e83579ba064bb85525865821fc5454678dede60795321"},{"@graph":[{"@id":"_:705dbd5c0719e0de78661e7a8d5d26610fcdaa4148258b1c5b81ae6be97e9d40_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:705dbd5c0719e0de78661e7a8d5d26610fcdaa4148258b1c5b81ae6be97e9d40_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=648ecf971ad84f4082722da041de3ac7ff43bd3d0c0e43e08fc4fa231cee8a38","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=648ecf971ad84f4082722da041de3ac7ff43bd3d0c0e43e08fc4fa231cee8a38"},"dcat:keyword":[{"@language":"en","@value":"Swedish Design Registration Journal"},{"@language":"en","@value":"design registration"},{"@language":"en","@value":"design"},{"@language":"en","@value":"registered designs"},{"@language":"sv","@value":"Svensk Designtidning"},{"@language":"sv","@value":"design"},{"@language":"sv","@value":"designregistrering"},{"@language":"sv","@value":"designskydd"},{"@language":"sv","@value":"mönster"},{"@language":"sv","@value":"mönsterskydd"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=648ecf971ad84f4082722da041de3ac7ff43bd3d0c0e43e08fc4fa231cee8a38&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:description":[{"@language":"en","@value":"In \"Svensk Designtidning\", PRV publishes new designs that have been registered in Sweden.\nWe also announce amendments and corrections of design registrations during the protection period, renewals and lapsed registrations.\nThe magazine is published as a PDF on our website every other Monday. This dataset contains all issues that have been published since 2001.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\nPath: SvenskDesigntidning\n\nAs of January 26, 2026, Svensk Designtidning transitioned from being a daily and weekly edition in PDF format to an online solution with daily publication of announcements.\nAnnouncements made as of January 26, 2026 can be accessed on PRV.se in \"Search PRV's databases - PRV\". under the Design and \"Announcements\" tabs, where you can search for announcements by date and where you can search for announcements made in a certain week.\n\nFurther documentation, for example about file formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"I Svensk Designtidning publicerar PRV ny design som blivit registrerad i Sverige.\nVi meddelar också ändringar och rättelser i designärenden under skyddstiden, förnyelser och avförda registreringar.\nTidningen publiceras som PDF på vår webbplats varannan måndag. Denna datamängd innehåller alla nummer som publicerats sedan 2001.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\nKatalog: SvenskDesigntidning\n\nFrån och med 26 januari 2026 övergick Svensk Designtidning från att vara en dags- och veckoutgåva i pdf-format till en online-lösning med daglig publicering av kungörelser.\nKungörelser gjorda från och med 26 januari 2026 nås på PRV.se i \"Sök i PRV:s databaser - PRV\".  under flikarna Design och �?Kungörelser�?, där du kan söka fram kungörelser efter datum och där du kan söka fram kungörelser gjorda en viss vecka.\n\nYtterligare dokumentation om till exempel filformat finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"648ecf971ad84f4082722da041de3ac7ff43bd3d0c0e43e08fc4fa231cee8a38","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Swedish Design Registration Journal"},{"@language":"sv","@value":"Svensk Designtidning"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=648ecf971ad84f4082722da041de3ac7ff43bd3d0c0e43e08fc4fa231cee8a38","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Svensk Designtidning"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:705dbd5c0719e0de78661e7a8d5d26610fcdaa4148258b1c5b81ae6be97e9d40_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:705dbd5c0719e0de78661e7a8d5d26610fcdaa4148258b1c5b81ae6be97e9d40_b1n0"}}],"@id":"urn:source:705dbd5c0719e0de78661e7a8d5d26610fcdaa4148258b1c5b81ae6be97e9d40"},{"@graph":[{"@id":"_:71741eedb3bda4158b6ec3b14445b3a7d9b19b97d085f215cd0845a4a2cb3eaf_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:71741eedb3bda4158b6ec3b14445b3a7d9b19b97d085f215cd0845a4a2cb3eaf_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=00f5a0443e8c4468bcfca5364759d284e8efc9ddff834aafaa0630a9f9512eee","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=00f5a0443e8c4468bcfca5364759d284e8efc9ddff834aafaa0630a9f9512eee"},"dcat:keyword":[{"@language":"en","@value":"OCR"},{"@language":"en","@value":"Swedish patents"},{"@language":"en","@value":"XML"},{"@language":"en","@value":"abstract"},{"@language":"en","@value":"claims"},{"@language":"en","@value":"description"},{"@language":"en","@value":"full text"},{"@language":"en","@value":"patent documents"},{"@language":"sv","@value":"OCR"},{"@language":"sv","@value":"Svenska patent"},{"@language":"sv","@value":"XML"},{"@language":"sv","@value":"beskrivning"},{"@language":"sv","@value":"fulltext"},{"@language":"sv","@value":"patentdokument"},{"@language":"sv","@value":"patentkrav"},{"@language":"sv","@value":"sammandrag"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=00f5a0443e8c4468bcfca5364759d284e8efc9ddff834aafaa0630a9f9512eee&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The text of new national patent documents is identified by OCR and proofread after publication. This data set contains the text from all patent documents that have been published after 2018-01-01, in the form of XML files.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\n\nFurther documentation about usage and formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"Texten i nya nationella patentdokument OCR-behandlas och korrekturläses efter publiceringen. Denna datamängd innehåller texten från alla dokument som publicerats efter 2018-01-01, i form av XML-filer.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\n\nYtterligare dokumentation kring användning och format finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"00f5a0443e8c4468bcfca5364759d284e8efc9ddff834aafaa0630a9f9512eee","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"XML full text from new Swedish national patent documents"},{"@language":"sv","@value":"Fulltext i XML från nya svenska nationella patentdokument"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=00f5a0443e8c4468bcfca5364759d284e8efc9ddff834aafaa0630a9f9512eee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dcat:mediaType":"application/xml+zip","dct:description":"Standarddistribution","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Fulltext i XML från nya svenska nationella patentdokument"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:71741eedb3bda4158b6ec3b14445b3a7d9b19b97d085f215cd0845a4a2cb3eaf_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:71741eedb3b