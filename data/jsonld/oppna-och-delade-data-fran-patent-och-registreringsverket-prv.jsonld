:{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=4b272b346c904d67b4ea44f9f10ebb66d31c941b722043c3a5e86a2d1257fb9a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=4b272b346c904d67b4ea44f9f10ebb66d31c941b722043c3a5e86a2d1257fb9a"},"dcat:keyword":[{"@language":"en","@value":"OCR"},{"@language":"en","@value":"Swedish patents"},{"@language":"en","@value":"XML"},{"@language":"en","@value":"abstract"},{"@language":"en","@value":"claims"},{"@language":"en","@value":"description"},{"@language":"en","@value":"full text"},{"@language":"en","@value":"patent documents"},{"@language":"sv","@value":"OCR"},{"@language":"sv","@value":"Svenska patent"},{"@language":"sv","@value":"XML"},{"@language":"sv","@value":"beskrivning"},{"@language":"sv","@value":"fulltext"},{"@language":"sv","@value":"patentdokument"},{"@language":"sv","@value":"patentkrav"},{"@language":"sv","@value":"sammandrag"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=4b272b346c904d67b4ea44f9f10ebb66d31c941b722043c3a5e86a2d1257fb9a&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"The text of national patent documents published during the years 1973-2017 was identified by OCR during 2019. This data set contains the text from one document from each application that was published during that period, in the form of XML files.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\n\nFurther documentation about usage and formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"Texten i nationella patentdokument som publicerades under åren 1973-2017 OCR-behandlades under 2019. Denna datamängd innehåller texten från ett dokument från varje ansökning som publicerades under den aktuella perioden, i form av XML-filer.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter: URL: ftp://opendata.prv.se Användare: OpenDataSource Lösenord: opendata\n\nYtterligare dokumentation kring användning och format finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"4b272b346c904d67b4ea44f9f10ebb66d31c941b722043c3a5e86a2d1257fb9a","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Full text from Swedish national patent documents 1973-2017"},{"@language":"sv","@value":"Fulltext från svenska patentdokument 1973-2017"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=4b272b346c904d67b4ea44f9f10ebb66d31c941b722043c3a5e86a2d1257fb9a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"Distribution för Fulltext från svenska patentdokument 1973-2017"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"