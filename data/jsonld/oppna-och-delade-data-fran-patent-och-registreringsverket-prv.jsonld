:"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=e1fc1ed4d5174b9083b8e2013e53ba77817177c262d34c2a98234ed23a0611a2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=e1fc1ed4d5174b9083b8e2013e53ba77817177c262d34c2a98234ed23a0611a2"},"dcat:keyword":[{"@language":"en","@value":"application number"},{"@language":"en","@value":"classification"},{"@language":"en","@value":"database"},{"@language":"en","@value":"goods and services"},{"@language":"en","@value":"national trademark"},{"@language":"en","@value":"registered trademark"},{"@language":"en","@value":"trademark application"},{"@language":"en","@value":"trademark holder"},{"@language":"en","@value":"trademark"},{"@language":"sv","@value":"ansökningsnummer"},{"@language":"sv","@value":"databas"},{"@language":"sv","@value":"klasser"},{"@language":"sv","@value":"nationellt varumärke"},{"@language":"sv","@value":"registrerat varumärke"},{"@language":"sv","@value":"varor och tjänster"},{"@language":"sv","@value":"varumärke"},{"@language":"sv","@value":"varumärkesansökan"},{"@language":"sv","@value":"varumärkesinnehavare"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=e1fc1ed4d5174b9083b8e2013e53ba77817177c262d34c2a98234ed23a0611a2&lang=sv"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"en","@value":"PRV publishes the contents of the Swedish Trademark Database via a collection of files that can be downloaded from our ftp server. The data files and associated image files (compressed in zip archives) are made available in XML format and are updated daily. They are available via a full withdrawal as well as via daily incremental updates.\n\nThe database is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\n\nFurther documentation about usage and formats is available on the ftp-server in the folder \"TrademarkExport/NewExport/Documentation\". \n"},{"@language":"sv","@value":"PRV publicerar innehållet i Svensk Varumärkesdatabas via en samling filer som kan laddas ned från vår ftp-server. Datafilerna och tillhörande bildfiler (komprimerade i zip-arkiv) tillgängliggörs i XML-format och uppdateras dagligen. De finns tillgängliga via ett fulluttag samt via dagliga inkrementella uppdateringar.\n\nDatabasen finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\n\nYtterligare dokumentation kring användning och format finns på ftp-servern i mappen \"TrademarkExport/NewExport/Documentation\".\n"}],"dct:identifier":"e1fc1ed4d5174b9083b8e2013e53ba77817177c262d34c2a98234ed23a0611a2","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Trademark database export"},{"@language":"sv","@value":"Export av varumärkesdatabasen"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=e1fc1ed4d5174b9083b8e2013e53ba77817177c262d34c2a98234ed23a0611a2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Export av varumärkesdatabasen","foaf:page":{"@id":"http://dataportal.se/organisation/SE2021002072"}},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b4feee7ab1005ea6d6d7b3e2b3c4ca95b95b338c042f5cee118c148643dfa9d5_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b4feee7ab1005ea6d6d7b3e2b3c4ca95b95b338c042f5cee118c148643dfa9d5_b1n0"}}],"@id":"urn:source:b4feee7ab1005ea6d6d7b3e2b3c4ca95b95b338c042f5cee118c148643dfa9d5"},{"@graph":[{"@id":"_:b6fe063fef2b441bc61eaf8d238da741ad811907f315698d38225d40b6fd90eb_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:b6fe063fef2b441bc61eaf8d238da741ad811907f315698d38225d40b6fd90eb_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=f1d9b7e5b5394b94bffd9924584240ea37ece6cecb1b45e0b481b410389e6239","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=f1d9b7e5b5394b94bffd9924584240ea37ece6cecb1b45e0b481b410389e6239"},"dcat:keyword":[{"@language":"en","@value":"announcments"},{"@language":"en","@value":"patent applications"},{"@language":"en","@value":"patent documents"},{"@language":"en","@value":"patents"},{"@language":"sv","@value":"kungörelser"},{"@language":"sv","@value":"patent"},{"@language":"sv","@value":"patentansökningar"},{"@language":"sv","@value":"patentdokument"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=f1d9b7e5b5394b94bffd9924584240ea37ece6cecb1b45e0b481b410389e6239&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"en","@value":"New patent documents are published every week, when different decisions and are announced in Svensk Patenttidning (the Swedish patent gazette). This data set contains all patent documents that have been published since 2022-01-01.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\nPath: NyaPatentDokument\n\nFurther documentation about content and formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"Nya patentdokument publiceras varje vecka i samband med beslut och kungörelser i Svensk Patenttidning. Denna datamängd innehåller alla patentdokument som publicerats sedan 2022-01-01.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\nKatalog: NyaPatentDokument\n\nYtterligare dokumentation kring innehåll och format finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"f1d9b7e5b5394b94bffd9924584240ea37ece6cecb1b45e0b481b410389e6239","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"New Swedish Patent Documents"},{"@language":"sv","@value":"Nya svenska patentdokument"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=f1d9b7e5b5394b94bffd9924584240ea37ece6cecb1b45e0b481b410389e6239","@type":"dcat:Distribution","dcat:accessURL":{"@id":"ftp://OpenDataSource@opendata.prv.se/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":"Distribution för Nya svenska patentdokument"},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b6fe063fef2b441bc61eaf8d238da741ad811907f315698d38225d40b6fd90eb_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b6fe063fef2b441bc61eaf8d238da741ad811907f315698d38225d40b6fd90eb_b1n0"}}],"@id":"urn:source:b6fe063fef2b441bc61eaf8d238da741ad811907f315698d38225d40b6fd90eb"},{"@graph":[{"@id":"_:b84daaf5124b0665b95d05c3a2f4b447218d1af76b2a56fe5d4316322ca7b088_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:b84daaf5124b0665b95d05c3a2f4b447218d1af76b2a56fe5d4316322ca7b088_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=80a9228aae404f239fea98a7729d1591c1ed1151a7fa49948dfc3e9be16a237e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=80a9228aae404f239fea98a7729d1591c1ed1151a7fa49948dfc3e9be16a237e"},"dcat:keyword":[{"@language":"en","@value":"DPK"},{"@language":"en","@value":"classes"},{"@language":"en","@value":"classification"},{"@language":"en","@value":"german"},{"@language":"en","@value":"patent"},{"@language":"sv","@value":"DPK"},{"@language":"sv","@value":"klasser"},{"@language":"sv","@value":"klasslistan"},{"@language":"sv","@value":"patent"},{"@language":"sv","@value":"patentklassifikation"},{"@language":"sv","@value":"tyska"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=80a9228aae404f239fea98a7729d1591c1ed1151a7fa49948dfc3e9be16a237e&lang=sv"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":[{"@language":"en","@value":"A list in German of all classes in the German Patent Classification (DPK, Deutsche Patentklassifikation). Each class has a link to a PDF document that contains the class and its subclasses in German.\n\nAn introduction to the German Patent Classification (DPK) is available here:\nhttps://www.prv.se/en/patents/patent-online-services/the-german-patent-classification-dpk/the-german-patent-classification-dpk-in-english/introduction-to-the-german-patent-classification-dpk/\n"},{"@language":"sv","@value":"En lista på tyska på alla klasser i det tyska patentklassystemet (DPK, Deutsche Patentklassifikation). Varje klass har en länk till ett pdf-dokument som innehåller klassen och dess subklasser på tyska.\n\nEn introduktion till det tyska klassystemet finns här: https://www.prv.se/sv/patent/e-tjanster/den-tyska-patentklasslistan-dpk/the-german-patent-classification-dpk-in-english/introduktion-till-det-tyska-klassystemet-dpk/\n"}],"dct:identifier":"80a9228aae404f239fea98a7729d1591c1ed1151a7fa49948dfc3e9be16a237e","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"The German Patent Classification (DPK) in German"},{"@language":"sv","@value":"Den tyska patentklasslistan (DPK) på tyska"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=80a9228aae404f239fea98a7729d1591c1ed1151a7fa49948dfc3e9be16a237e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.prv.se/en/patents/patent-online-services/the-german-patent-classification-dpk/the-german-patent-classification-dpk-in-german/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/DEU"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":"Distribution för Den tyska patentklasslistan (DPK) på tyska","foaf:page":{"@id":"https://www.prv.se/en/patents/patent-online-services/the-german-patent-classification-dpk/the-german-patent-classification-dpk-in-english/introduction-to-the-german-patent-classification-dpk/"}},{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":{"@language":"sv","@value":"Patent- och registreringsverket"},"http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b84daaf5124b0665b95d05c3a2f4b447218d1af76b2a56fe5d4316322ca7b088_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@prv.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:b84daaf5124b0665b95d05c3a2f4b447218d1af76b2a56fe5d4316322ca7b088_b1n0"}}],"@id":"urn:source:b84daaf5124b0665b95d05c3a2f4b447218d1af76b2a56fe5d4316322ca7b088"},{"@graph":[{"@id":"_:c98fdc9d3bf5996eb5cdc70fc6c7013975dd50d812987008d3166f322d3e0461_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10242","http://www.w3.org/2006/vcard/ns#street-address":"Box 5055"},{"@id":"_:c98fdc9d3bf5996eb5cdc70fc6c7013975dd50d812987008d3166f322d3e0461_b1n0","@type":"http://www.w3.org/2006/vcard/ns#TelephoneType","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4687822800"}},{"@id":"http://dataportal.se/organisation/SE2021002072","@type":"foaf:Agent","dct:identifier":"2021002072","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:data@prv.se"},"foaf:name":{"@language":"sv","@value":"Patent- och registreringsverket"},"foaf:page":{"@id":"https://www.prv.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.prv.se/"}},{"@id":"https://data.prv.se/dataset.jsp?uuid=6f6a7fbac8a34b52b37f41846f973103e870a222f4cb4d7d95d46ca2ad667e55","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://www.prv.se/sv/om-oss/kontakta-oss/"},"dcat:distribution":{"@id":"https://data.prv.se/distribution.jsp?uuid=6f6a7fbac8a34b52b37f41846f973103e870a222f4cb4d7d95d46ca2ad667e55"},"dcat:keyword":[{"@language":"en","@value":"Swedish Trademark Gazette"},{"@language":"en","@value":"registration"},{"@language":"en","@value":"trademark"},{"@language":"sv","@value":"Svensk Varumärkestidning"},{"@language":"sv","@value":"registrering"},{"@language":"sv","@value":"varumärke"}],"dcat:landingPage":{"@id":"https://data.prv.se/dataset.jsp?uuid=6f6a7fbac8a34b52b37f41846f973103e870a222f4cb4d7d95d46ca2ad667e55&lang=sv"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"en","@value":"Svensk Varumärkestidning (the Swedish Trademark Gazette) publishes all newly registered trademarks. It helps you monitor the trademarks that other actors on the market register. It also contains alterations and corrections of registrations during the registration period, renewals and removed registrations.\n\nThe gazette is published in PDF format on our website every Monday, in Swedish. This data set contains all issues that have been published since 1999-10-15.\n\nThe dataset is available from our ftp-server with the following connection information:\nURL: ftp://opendata.prv.se\nUsername: OpenDataSource\nPassword: opendata\nPath: SvenskVarumärkestidning\n\nAs of January 26, 2026, the Swedish Trademark Journal transitioned from being a daily and weekly edition in PDF format to an online solution with daily publication of announcements. Announcements made as of January 26, 2026 can be accessed on PRV.se in \"Search PRV's databases - PRV\" under the tabs Trademark and \"Announcements\", where you can search for announcements by date and where you can search for announcements made in a certain week.\n\nFurther documentation, for example about file formats is available on the ftp-server in the folder \"Documentation\"."},{"@language":"sv","@value":"Svensk Varumärkestidning publicerar alla nyregistrerade varumärken. Den hjälper dig att bevaka de registrerade varumärken som andra registrerar. Den innehåller även ändringar, rättelser, förnyelser, avförda varumärken och internationella varumärkesregistreringar.\n\nSvensk Varumärkestidning läggs ut i PDF-format på vår webbplats varje helgfri måndag. Denna datamängd innehåller alla nummer som publicerats sedan 1999-10-15.\n\nDatamängden finns tillgänglig via vår ftp-server med följande inloggningsuppgifter:\nURL: ftp://opendata.prv.se\nAnvändare: OpenDataSource\nLösenord: opendata\nKatalog: SvenskVarumärkestidning\n\nFrån och med 26 januari 2026 övergick Svensk Varumärkestidning från att vara en dags- och veckoutgåva i pdf-format till en online-lösning med daglig publicering av kungörelser. Kungörelser gjorda från och med 26 januari 2026 nås på PRV.se i \"Sök i PRV:s databaser - PRV\" under flikarna Varumärke och �?Kungörelser�?, där du kan söka fram kungörelser efter datum och där du kan söka fram kungörelser gjorda en viss vecka.\n\nYtterligare dokumentation om till exempel filformat finns på ftp-servern i mappen \"Documentation\"."}],"dct:identifier":"6f6a7fbac8a34b52b37f41846f973103e870a222f4cb4d7d95d46ca2ad667e55","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002072"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:title":[{"@language":"en","@value":"Svensk Varumärkestidning (the Swedish Trademark Gazette)"},{"@language":"sv","@value":"Svensk Varumärkestidning"}]},{"@id":"https://data.prv.se/distribution.jsp?uuid=6f6a7fbac8a34b52b37f41846f973103e870a222f4cb4d7d95d46ca2ad667e55","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.prv.se/sv/varumarke/nar-du-har-ett-registrerat-varumarke/bevaka-ditt-varumarke/svensk-varumarkestidning/"},"dct:description":"Standarddistribution","dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:t