ten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/01_Avgjorda_snabbsparsmal_TR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Avgjorda_snabbsparsmal_TR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/01_Avgjorda_snabbsparsmal_TR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Brottmål"},{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Snabbare lagföring"},{"@language":"sv","@value":"Snabbspår"},{"@language":"sv","@value":"Tingsrätt"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Snabbspar/01_Avgjorda_snabbsparsmal_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Snabbspar/01_Avgjorda_snabbsparsmal_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"All measures in this table concern cases within faster legal proceedings at district courts. Faster legal proceedings is an approach aimed at reducing the time between police intervention and resolution in court. The method covers crimes punishable by a maximum of three years of imprisonment, where the suspect is apprehended at the crime scene and involves offenses that the police can investigate on-site. Common offenses include the use and possession of narcotics, shoplifting, or driving without authorization."},{"@language":"sv","@value":"Samtliga mått i denna tabell rör mål inom snabbare lagföring på tingsrätt. Snabbare lagföring är ett arbetssätt för att minska tiden mellan polisingripande och avgörande. Arbetsmetoden omfattar brott som ger högst tre års fängelse, där den misstänkta anträffas på brottsplatsen och avser brott som polisen kan utreda på plats. Vanligt förekommande brott är bruk och innehav av narkotika, stöld från butik eller olovlig körning."}],"dct:issued":{"@type":"xsd:date","@value":"2026-03-31"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:fa880132b41891947348cb03d5b8b04c6c1b92d8a912886cf12121fa44ff3917_b0n0"},"dct:title":[{"@language":"en","@value":"Determined criminal cases within faster legal proceedings at district courts"},{"@language":"sv","@value":"Antal avgjorda brottmål inom snabbare lagföring vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Avgjorda_snabbsparsmal_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Snabbspar/01_Avgjorda_snabbsparsmal_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"