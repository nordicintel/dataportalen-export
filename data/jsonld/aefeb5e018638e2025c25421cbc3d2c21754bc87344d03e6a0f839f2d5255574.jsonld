l.se"},{"@id":"https://www.varmlandstingsratt.domstol.se"},{"@id":"https://www.vastmanlandstingsratt.domstol.se"},{"@id":"https://www.vastrahovratten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/01_Avgjorda_mal_per_avgorandetyp_TR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Avgjorda_mal_per_avgorandetyp_TR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/01_Avgjorda_mal_per_avgorandetyp_TR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Avgörandetyp"},{"@language":"sv","@value":"Beslut"},{"@language":"sv","@value":"Dom"},{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Tingsrätt"},{"@language":"sv","@value":"Tredskodom"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Avgorandetyp/01_Avgjorda_mal_per_avgorandetyp_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Avgorandetyp/01_Avgjorda_mal_per_avgorandetyp_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined cases at district courts through a judgment, final decision, default judgment at district courts or in a different manner. A judgment is a court's decision regarding the matter of fact in the case. A final decision is a decision through which the court, in a manner other than by judgment, separates itself from the case. A default judgment is delivered despite the absence of a called litigant during a hearing or the absence of a written reply to a charge."},{"@language":"sv","@value":"Antal avgjorda mål per målkategori vid tingsrätt som avgjorts med avgörandetypen dom, slutligt beslut, tredskodom eller med annan avgörandetyp vid målets slutliga avgörande. En dom är ett domstolsavgörande av själva saken i målet eller ärendet. Ett slutligt beslut är beslut varigenom domstolen, på annat sätt än genom dom, skiljer saken från sig. En tredskodom är en dom i tingsrätt som avkunnas mot en part som inte avgett skriftligt svaromål eller, som efter kallelse till rättegångsförhandling, ändå inte infunnit sig till förhandlingen."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:edbb33d43097caefce17e4c003dde31c5fd90c489c526991faff20e8c2a13ae8_b0n0"},"dct:title":[{"@language":"en","@value":"Determined cases through a judgment, final decision or default judgment at district courts"},{"@language":"sv","@value":"Avgjorda mål per avgörandetyp vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Avgjorda_mal_per_avgorandetyp_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Avgorandetyp/01_Avgjorda_mal_per_avgorandetyp_TR.px"},"dct:format":{"@id":"http://publications.europa.e