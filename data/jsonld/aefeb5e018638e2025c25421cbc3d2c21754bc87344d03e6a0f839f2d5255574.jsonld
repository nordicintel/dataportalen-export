px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/07_Alder_HFD.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstol"},{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Högsta förvaltningsdomstolen"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Äldre mål"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Alder/07_Alder_HFD.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Alder/07_Alder_HFD.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Age in pending cases at the Supreme Administrative Court as the number of pending cases older than 6 months, 12 months and 24 months. The same case may occur in several age groups. Pending cases are ongoing (open) cases at the end of the year. The cases are divided in case categories."},{"@language":"sv","@value":"Antal balanserade mål i Högsta förvaltningsdomstolen, uppdelade i ålder i månader för pågående/öppna mål vid den 31 december respektive år. Ett mål kan förekomma i flera åldersgrupper. Målen delas in i målkategorier."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:e0b7d49086657ed856f02952f960cd6014334729e65bc0a997f2e6cdbbb5677f_b0n0"},"