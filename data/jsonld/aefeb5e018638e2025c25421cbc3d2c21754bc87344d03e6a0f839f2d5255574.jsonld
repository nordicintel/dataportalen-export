al_huvudforhandling_TR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_Avgjorda_mal_huvudforhandling_TR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Huvudförhandling"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Tingsrätt"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Forhandling/02_Avgjorda_mal_huvudforhandling_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Forhandling/02_Avgjorda_mal_huvudforhandling_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined cases following a main hearing and hearing time in hours at district courts. The table also shows the number of determined cases where the hearing time undercuts six hours, where the hearing time was 6-18 hours and where the hearing time exceeds 18 hours. The cases are divided by case category."},{"@language":"sv","@value":"Antal avgjorda mål vid tingsrätt som har haft huvudförhandling samt avgjorda mål som haft mindre än 6 timmars huvudförhandlingstid, 6-18 timmars huvudförhandlingstid och mer än 18 timmars huvudförhandlingstid. Tabellen visar även antal huvudförhandlingstimmar i avgjorda mål. Målen delas in i målkategorier. Huvudförhandling utgörs av ett flertal mötestyper på tingsrätt."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:ee78dd410bb0a693d8d6260c57807cf43eadaca2365557ceaed62f0313cb2b91_b0n0"},"dct:title":[{"@language":"en","@value":"Determined cases following a main hearing and hearing time at district courts"},{"@language":"sv","@value":"Avgjorda mål med huvudförhandling vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_Avgjorda_mal_huvudforhandling_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Forhandling/02_Avgjorda_mal_huvudforhandling_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_Avgjorda_mal_huvudforhandling_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/Forhandling/02_Avgjorda_mal_huvudforhandling_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metadata (sv)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a","@typ