tps://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_Malutveckling_per_kategori_MMD.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_Malutveckling_per_kategori_MMD.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Fastighetsmål"},{"@language":"sv","@value":"Mark- och miljödomstol"},{"@language":"sv","@value":"Miljömål"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"PBL"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__AntalMMD/02_Malutveckling_per_kategori_MMD.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__AntalMMD/02_Malutveckling_per_kategori_MMD.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of cases and matters at the five Land and environment courts. The cases and matters are divided in separate categories. Pending cases and matters are ongoing (open) cases or matters at a specific date. On May 2, 2011, Land and environment courts were established at five of the country's district courts. Previously, there were special property courts and environment courts at certain district courts."},{"@language":"sv","@value":"Antal mål och ärenden vid alla fem mark- och miljödomstolar och per mark- och miljödomstol. Målen och ärendena delas in i kategorier. Utgående balans är antal pågående/öppna mål eller ärenden vid ett visst datum. Den 2 maj 2011 bildades Mark- och miljödomstolar vid fem av landets tingsrätter. Dessförinnan fanns särskilda fastighetsdomstolar och miljödomstolar vid vissa tingsrätter. Mark- och miljödomstolarnas mål och ärenden ingår i tabellerna hos Domstolsverket för tingsrätterna totalt."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:49cc87e7b09e35f6f67782428c47dce7f0ab05c6304fbc3ce88ed045de5ca4af_b0n0"},"dct:title":[{"@language":"en","@value":"Filed (incoming), determined and pending cases and matters at Land and environment courts (more detailed division)"},{"@language":"sv","@value":"Inkomna, avgjorda och balanserade mål och ärenden vid mark- och miljödomstol (mer uppdelade kategorier)"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_Malutveckling_per_kategori_MMD.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/AntalMMD/02_Malutveckling_per_kategori_MMD.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_Malutveckling_per_kategori_MMD.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/AntalMMD/02_Mal