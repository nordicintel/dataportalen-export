europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined priority cases at the Supreme Administrative Court. Priority cases at the Supreme Administrative Court are cases according to the Compulsory Psychiatric Care Act (LPT), Forensic Mental Care Act (LRV), Care of Young Persons Act (LVU), and Care of Abusers Act (LVM). These cases shall be handled promptly."},{"@language":"sv","@value":"Antal avgjorda mål i Högsta förvaltningsdomstolen som klassificeras som förtursmål och skall handläggas skyndsamt. Förtursmål vid Högsta förvaltningsdomstolen är mål enligt Lagen om psykiatrisk tvångsvård (LPT), Lagen om rättspsykiatrisk vård (LRV), Lagen om vård av unga (LVU) samt Lagen om vård av missbrukare (LVM)."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:554d5415ffbb0a6147767a514e7ddfded6c53da1cddec6cdef4984ef915eb5a4_b0n0"},"dct:title":[{"@language":"en","@value":"Determined priority cases at the Supreme Administrative Court"},{"@language":"sv","@value":"Avgjorda förtursmål i Högsta förvaltningsdomstolen"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/06_Fortursmal_HFD.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Fortursmal/06_Fortursmal