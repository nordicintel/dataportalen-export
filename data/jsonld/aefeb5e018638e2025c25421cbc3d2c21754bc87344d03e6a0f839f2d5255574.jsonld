domstol.se"},{"@id":"https://www.varbergstingsratt.domstol.se"},{"@id":"https://www.varmlandstingsratt.domstol.se"},{"@id":"https://www.vastmanlandstingsratt.domstol.se"},{"@id":"https://www.vastrahovratten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/02_Verksamhetsmal_HR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_Verksamhetsmal_HR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_Verksamhetsmal_HR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Hovrätt"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Verksamhetsmål"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Verksamhetsmal/02_Verksamhetsmal_HR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Verksamhetsmal/02_Verksamhetsmal_HR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Performance of the time targets at the courts of appeal set by the government, measured in months at the 75th percentile for cases determined during the selected time period (time from filed case to determined case) except for civil cases, time from filed case to decision delivered regarding leave to appeal where the decision regarding leave to appeal was given during the selected time period."},{"@language":"sv","@value":"Handläggningstider i månader för alla hovrätter och per hovrätt per de verksamhetsmålskategorier som regeringen satt en målsättning för. Tiden mäts i 75:e percentilen för mål som avgjorts under aktuell tidsperiod från inkommandedag till avgjortdag, förutom för verksamhetsmålskategorin Tvistemål fram till PT-beslut där tiden mäts från inkommandedag till datum då frågan om prövningstillstånd (PT) beslutades för mål som fått ett datum för PT-beslut under vald tidsperiod."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:2ff9d40a11dce03c93b6e58a79e9dd3feffb22f2c47ecd4a05c4f1211bfaf9c0_b0n0"},"dct:title":[{"@language":"en","@value":"Performance of the time targets at courts of appeal (turnaround time 75 percentile in months)"},{"@language":"sv","@value":"Verksamhetsmål vid hovrätt (handläggningstid 75-percentil i månader)"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_Verksamhetsmal_HR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Verksamhetsmal/02_Verksamhetsmal_HR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/