las endast när kammarrätten är tveksam till om förvaltningsrätten dömt rätt, om det finns ett prejudikatsintresse av att överklagandet prövas av högre rätt eller om det annars finns synnerliga skäl."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:63a0a014df8311a000dc2ebb07b47efe7cfd1acb40e0ece9d2db876db39b3e10_b0n0"},"dct:title":[{"@language":"en","@value":"Leave to appeal in determined cases at administrative courts of appeal"},{"@language":"sv","@value":"Frågan om prövningstillstånd (PT) i avgjorda mål per målkategori vid kammarrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02_PT_per_malkategori_KR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/PT/02_PT_per_malkategori_KR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02_PT_per_malkategori_KR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/PT/02_PT_per_malkategori_KR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource