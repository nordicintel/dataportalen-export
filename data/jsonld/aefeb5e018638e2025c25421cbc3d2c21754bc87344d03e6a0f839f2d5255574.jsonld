 inconvenient causes."},{"@language":"sv","@value":"Antal inställda huvudförhandlingar i brottmål vid tingsrätt, uppdelat i orsak till inställt möte. Huvudförhandling utgörs av ett flertal mötestyper på tingsrätt. Enbart inställda huvudförhandlingar som ställts in på grund av en besvärande orsak inkluderas. Dessa besvärande orsaker är belastande för verksamheten då konsekvensen är att målet inte har kunnat avgöras."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:f246c757b962dcf6576fc55bc80e15056d09f4f477dc019e027d4c00f3ebd9e0_b0n0"},"dct:title":[{"@language":"en","@value":"Cancelled main hearings in criminal cases at district courts"},{"@language":"sv","@value":"Antal inställda huvudförhandlingar i brottmål vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/04_Installda_hf_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Forhandling/04_Installda_hf_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/04_Installda_hf_TR.px","@type":"dcat:Distri