essRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Percentage of cases that have been appealed from administrative courts of appeal to the Supreme Administrative Court. The metrics are calculated as the number of incoming cases to the Supreme Administrative Court divided by the number of determined cases in administrative courts of appeal during the same time period. Migration cases are excluded."},{"@language":"sv","@value":"Andel mål i procent som överklagats från kammarrätt till Högsta förvaltningsdomstolen. Måtten beräknas som antal inkomna mål till Högsta förvaltningsdomstolen dividerat med antal avgjorda mål på kammarrätt under samma tidsperiod. Migrationsmål (utlännings- och medborgarskapsmål) på kammarrätt exkluderas från beräkningen."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:c9ed281e580303f5ffa6810dfb64458dcc7ee03083cb9fb069e03f666bab9d8d_b0n0"},"dct:title":[{"@language":"en","@value":"Frequency of appeal from administrative courts of appeal to the Supreme Administrative Court"},{"@language":"sv","@value":"Överklagandefrekvens kammarrätt till Högsta förvaltningsdomstolen"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/06_Overklagandefrekvens_KR_till_HFD.px","@