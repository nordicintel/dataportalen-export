04_Fortursmal_FR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Fortursmal/04_Fortursmal_FR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined priority cases at administrative courts. Priority cases at administrative courts are cases according to the Compulsory Psychiatric Care Act (LPT), Forensic Mental Care Act (LRV), Care of Young Persons Act (LVU), and Care of Abusers Act (LVM). These cases shall be handled promptly."},{"@language":"sv","@value":"Antal avgjorda mål för alla förvaltningsrätter och per förvaltningsrätt som klassificeras som förtursmål. Förtursmål skall handläggas skyndsamt och är mål enligt Lagen om psykiatrisk tvångsvård (LPT), Lagen om rättspsykiatrisk vård (LRV), Lagen om vård av unga (LVU) samt Lagen om vård av missbrukare (LVM)."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:c25572e25780036f3f75830d9694288f2baf01f9e030ce35ec5be75d5a408c91_b0n0"},"dct:title":[{"@language":"en","@value":"Determined priority cases at administrative courts"},{"@language":"sv","@value":"Avgjorda förtursmål vid förvaltningsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{