w.vastrahovratten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/09_Konkurser_TR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/09_Konkurser_TR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/09_Konkurser_TR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Konkurs"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Tingsrätt"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__AntalMal/09_Konkurser_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__AntalMal/09_Konkurser_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of bankruptcy matters at district courts. Concluded bankruptcies refers to a dismissal or rescission of a bankruptcy judgment or a decision that results in a composition arrangement. Pending bankruptcies means that a decision to declare bankruptcy has been made but the bankruptcy is not concluded yet, therefore pending bankruptcies can not be compared to the number of filed bankruptcy applications."},{"@language":"sv","@value":"Antal ärenden avseende konkurser för alla tingsrätter och per tingsrätt. Antal balanserade konkurser avser öppna (pågående) konkursärenden där beslut om försättande i konkurs meddelats. Balansen går inte att sätta i relation till inkomna konkursansökningar eftersom balansen endast avser konkurser som meddelats men ännu inte avslutats. Antal avslutade konkurser är konkurser som avslutats på grund av t.ex. avskrivningsbeslut, hävt konkursbeslut eller beslut varigenom utdelning fastställts."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:e0ec696336ca23834dec8ff77bca2ee44311abf3a0349c40c88103a30a962de4_b0n0"},"dct:title":[{"@language":"en","@value":"Filed (incoming), concluded and pending bankruptcy matters at district courts"},{"@language":"sv","@value":"Inkomna, balanserade och avslutade konkurser vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/09_Konkurser_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/AntalMal/09_Konkurser_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/09_Konkurser_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/Px