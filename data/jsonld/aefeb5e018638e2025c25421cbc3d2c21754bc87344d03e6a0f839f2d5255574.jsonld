":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/01_PMD_och_PMOD.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_PMD_och_PMOD.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/01_PMD_och_PMOD.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Patent- och marknadsdomstolen"},{"@language":"sv","@value":"Patent- och marknadsöverdomstolen"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__AntalPMD/01_PMD_och_PMOD.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__AntalPMD/01_PMD_och_PMOD.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of cases and matters at the Patent and Market Court and at the Patent and Market Court of Appeal. Pending cases and matters are ongoing (open) cases or matters at a specific date. As a court of first instance, the Patent and Market Court is a division of Stockholm District Court. The Patent and Market Court of Appeal is a division of Svea Court of Appeal. They handle criminal cases, civil cases and other cases that are related to patent and market."},{"@language":"sv","@value":"Antal mål och ärenden vid patent- och marknadsdomstolen samt Patent- och marknadsöverdomstolen. Utgående balans är antal pågående/öppna mål eller ärenden vid ett visst datum. Patent- och marknadsdomstolen är första instans sedan den 1 september 2016 och utgör en del av Stockholms tingsrätt. Patent- och marknadsöverdomstolen utgör sedan den 1 september 2016 en del av Svea hovrätt. Patent- och marknadsdomstolens mål och ärenden ingår i tabellerna hos Domstolsverket för tingsrätterna totalt. Patent- och marknadsöverdomstolens mål och ärenden ingår i tabellerna hos Domstolsverket för hovrätterna totalt."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:5aa1ecb0b63c472a473b9f12751dccdc1dcd2df53b2bf80195cad877c8dce0ae_b0n0"},"dct:title":[{"@language":"en","@value":"Filed (incoming), determined and pending cases and matters at the Patent and Market Court and at the Patent and Market Court of Appeal"},{"@language":"sv","@value":"Inkomna, avgjorda och balanserade mål och ärenden vid Patent- och marknadsdomstolen och i Patent- och marknadsöverdomstolen"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_PMD_och_PMOD.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/AntalPMD/01_PMD_och_PMOD.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language