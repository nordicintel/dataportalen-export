min.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/03_Avgjorda_mal_per_avgorandetyp_FR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/03_Avgjorda_mal_per_avgorandetyp_FR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Avgörandetyp"},{"@language":"sv","@value":"Beslut"},{"@language":"sv","@value":"Dom"},{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Förvaltningsrätt"},{"@language":"sv","@value":"Officiell statistik"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Avgorandetyp/03_Avgjorda_mal_per_avgorandetyp_FR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Avgorandetyp/03_Avgjorda_mal_per_avgorandetyp_FR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined cases through a judgment or decision at administrative courts. The cases are divided in case categories. A judgment is a court's decision regarding the matter of fact in the case. A decision is a decision through which the court, in a manner other than by judgment, separates itself from the case."},{"@language":"sv","@value":"Antal avgjorda mål per målkategori vid förvaltningsrätt som avgjorts slutligt med olika avgörandetyper. De vanligast förekommande avgörandetyperna är dom eller beslut, men här summeras även resterande förekommande avgörandetyper under namnet Antal avgjorda mål med annan avgörandetyp. En dom är ett domstolsavgörande av själva frågan i målet medan domstolen med ett beslut skiljer sig från målet utan att meddela dom."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:a38ef50d57b80b8724cc07d6691596df29128f647fa4e8602f2bb7d664e17424_b0n0"},"dct:title":[{"@language":"en","@value":"Determined cases through a judgment or decision at administrative courts"},{"@language":"sv","@value":"Avgjorda mål per avgörandetyp vid förvaltningsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/03_Avgjorda_mal_per_avgorandetyp_FR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Avgorandetyp/03_Avgjorda_mal_per_avgorandetyp_FR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/03_Avgjorda_mal_per_avgorandetyp_FR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/Avgorandetyp/03_Avgjorda_mal_per_avgorandetyp_FR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativeco