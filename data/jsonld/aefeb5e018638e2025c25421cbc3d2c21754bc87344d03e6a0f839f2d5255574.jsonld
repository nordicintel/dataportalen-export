b/en/DOMstat/DOMstat__AntalMal/02b_Malutveckling_per_malkategori_arenden_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__AntalMal/02b_Malutveckling_per_malkategori_arenden_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of matters at district courts. The matters are divided in case categories. Pending matters are ongoing (open) matters at a specific date. The matters at the district courts are the following categories of cases; company reconstruction matters, bankruptcy matters, debt clearance matters, enforcement matters and other court matters. Prior to 2014, matters regarding registration under the Marriage Code also occurred."},{"@language":"sv","@value":"Antal ärenden vid alla tingsrätter och per tingsrätt. Ärendena delas in i målkategorier. Utgående balans är antal pågående/öppna ärenden vid ett visst datum. Ärenden vid tingsrätt är följande målkategorier: Företagsrekonstruktioner, Konkursärenden, Skuldsanering, Utsökningsärenden och Övriga domstolsärenden. Före 2014 förekom även ärenden inom målkategorin Reg enl ÄktB, alltså registrering enligt Äktenskapsbalken."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:23d3c89a07de8a7755f3a57ca6f32b7658cc7f96761d6fc9b9239a36f961cac6_b0n0"},"dct:title":[{"@language":"en","@value":"Filed (incoming), determined and pending matters by case category at district courts"},{"@language":"sv","@value":"Inkomna, avgjorda och balanserade ärenden per målkategori vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/02b_Malutveckling_per_malkategori_arenden_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/AntalMal/02b_Malutveckling_per_malkategori_arenden_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/02b_Malutveckling_per_malkategori_arenden_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/AntalMal/02b_Malutveckling_per_malkategori_arenden_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metadata (sv)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Statistiksupporten","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sta