"},{"@id":"https://www.malmotingsratt.domstol.se"},{"@id":"https://www.moratingsratt.domstol.se"},{"@id":"https://www.nackatingsratt.domstol.se"},{"@id":"https://www.norrkopingstingsratt.domstol.se"},{"@id":"https://www.norrtaljetingsratt.domstol.se"},{"@id":"https://www.nykopingstingsratt.domstol.se"},{"@id":"https://www.orebrotingsratt.domstol.se"},{"@id":"https://www.ostersundstingsratt.domstol.se"},{"@id":"https://www.skaraborgstingsratt.domstol.se"},{"@id":"https://www.skellefteatingsratt.domstol.se"},{"@id":"https://www.sodertaljetingsratt.domstol.se"},{"@id":"https://www.sodertornstingsratt.domstol.se"},{"@id":"https://www.solnatingsratt.domstol.se"},{"@id":"https://www.stockholmstingsratt.se"},{"@id":"https://www.sundsvallstingsratt.se"},{"@id":"https://www.svea.se"},{"@id":"https://www.uddevallatingsratt.domstol.se"},{"@id":"https://www.umeatingsratt.domstol.se"},{"@id":"https://www.uppsalatingsratt.domstol.se"},{"@id":"https://www.vanersborgstingsratt.domstol.se"},{"@id":"https://www.varbergstingsratt.domstol.se"},{"@id":"https://www.varmlandstingsratt.domstol.se"},{"@id":"https://www.vastmanlandstingsratt.domstol.se"},{"@id":"https://www.vastrahovratten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/01_Ungdomsmal_TR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Ungdomsmal_TR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/01_Ungdomsmal_TR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Brottmål"},{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Minderårig"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Tingsrätt"},{"@language":"sv","@value":"Underårig"},{"@language":"sv","@value":"Ungdomsmål"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Ungdomsmal/01_Ungdomsmal_TR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Ungdomsmal/01_Ungdomsmal_TR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Number of determined criminal cases and turnaround times in months involving juveniles at district courts, that is criminal cases where at least one defendant is under 21 years of age and an indictment exists. The group of 15-17 years old (U18) belongs to priority cases. These cases shall be handled promptly. The group of 18-20 years old (U21) does not belong to the priority cases by definition, but is subject to the requirement for prompt handling according to the law for cases involving minors (under 21 years old)."},{"@language":"sv","@value":"Antal avgjorda ungdomsmål och målens handläggningstider i månader för tingsrätter totalt och per tingsrätt. Ungdomsmål är brottmål med förekomst av tilltalad aktör i åldern 15-20 år, i mål där stämningsansökan inkommit. Gruppen 15-17 år (U18) tillhör kategorin förtursmål. I statistiken för denna kategori förekommer såväl mål med lagstadgad frist (kriterium: fängelse i mer än sex månader) som mål som inte uppfyller kriteriet för lagstadgad frist. Gruppen 18-20 år (U21) tillhör inte kategorin förtursmål per definition, men omfattas av krav på skyndsam hantering enligt lag för mål med förekomst av underårig (under 21 år)."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:9a27e72a7bb345eb4f2cf602569ea34c53767d513517fb6be67add3a9d3c5778_b0n0"},"dct:title":[{"@language":"en","@value":"Determined criminal cases with turnaround times involving juveniles at district courts"},{"@language":"sv","@value":"Avgjorda ungdomsmål med handläggningstider vid tingsrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/01_Ungdomsmal_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/en/DOMstat/Ungdomsmal/01_Ungdomsmal_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"Metadata (en)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/01_Ungdomsmal_TR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxweb.etjanst.domstol.se/PxWeb/api/v1/sv/DOMstat/Ungdomsmal/01_Ungdomsmal_TR.px"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metadata (sv)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availabil