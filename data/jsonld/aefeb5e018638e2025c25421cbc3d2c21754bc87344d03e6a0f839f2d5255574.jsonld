ol.se"},{"@id":"https://www.umeatingsratt.domstol.se"},{"@id":"https://www.uppsalatingsratt.domstol.se"},{"@id":"https://www.vanersborgstingsratt.domstol.se"},{"@id":"https://www.varbergstingsratt.domstol.se"},{"@id":"https://www.varmlandstingsratt.domstol.se"},{"@id":"https://www.vastmanlandstingsratt.domstol.se"},{"@id":"https://www.vastrahovratten.domstol.se"},{"@id":"https://www.vaxjotingsratt.domstol.se"},{"@id":"https://www.ystadstingsratt.domstol.se"}],"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://www.domstol.se/domstolsverket"}},{"@id":"http://pxweb.etjanst.domstol.se/dataset/05_Overklagande_andringsfrekvens_FR_till_KR.px","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/601/resource/450f76ab581c240995bffa3cac11448a"},"dcat:distribution":[{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/05_Overklagande_andringsfrekvens_FR_till_KR.px"},{"@id":"http://pxweb.etjanst.domstol.se/distribution/sv/05_Overklagande_andringsfrekvens_FR_till_KR.px"}],"dcat:keyword":[{"@language":"sv","@value":"Domstolsverket"},{"@language":"sv","@value":"Förvaltningsrätt"},{"@language":"sv","@value":"Kammarrätt"},{"@language":"sv","@value":"Migration"},{"@language":"sv","@value":"Officiell statistik"},{"@language":"sv","@value":"Ändrad"},{"@language":"sv","@value":"Ändringsfrekvens"},{"@language":"sv","@value":"Överklagande"}],"dcat:landingPage":[{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/en/DOMstat/DOMstat__Overklagande/05_Overklagande_andringsfrekvens_FR_till_KR.px"},{"@id":"https://pxweb.etjanst.domstol.se/PxWeb/pxweb/sv/DOMstat/DOMstat__Overklagande/05_Overklagande_andringsfrekvens_FR_till_KR.px"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:description":[{"@language":"en","@value":"Percentage of cases that have been appealed from administrative court to administrative courts of appeal. The table also shows the frequency of amendment in percent, that is, when the administrative court of appeal changed the lower court's decision. The metrics are calculated as the number of incoming cases to the administrative courts of appeal divided by the number of determined cases in the administrative courts during the same time period."},{"@language":"sv","@value":"Överklagandefrekvens i % som är andel mål som överklagats från förvaltningsrätt till kammarrätt. Överklagandefrekvens beräknas som inkomna mål till kammarrätt dividerat med avgjorda mål på förvaltningsrätt under samma tidsperiod. Tabellen visar även ändringsfrekvens i % som är andel avgjorda mål där utgången i mål vid kammarrätt innebär att en dom eller ett beslut i förvaltningsrätt ändrats."}],"dct:issued":{"@type":"xsd:date","@value":"2025-06-02"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-31T09:30:00"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002742"},"dct:spatial":{"@id":"http://sws.geonames.org/2661886"},"dct:temporal":{"@id":"_:485043ebe7636cdac062a932d4b92306a9a99f36244b6db040f62be9ee912593_b0n0"},"dct:title":[{"@language":"en","@value":"Frequency of appeal from administrative courts to administrative courts of appeal"},{"@language":"sv","@value":"Överklagande- och ändringsfrekvens förvaltningsrätt till kammarrätt"}],"foaf:page":{"@id":"https://www.domstol.se/om-sveriges-domstolar/statistik-styrning-och-utveckling/statistik/officiell-domstolsstatistik/"}},{"@id":"http://pxweb.etjanst.domstol.se/distribution/en/05_Overklagande_andringsfrekvens_FR_till_KR.px","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://pxwe