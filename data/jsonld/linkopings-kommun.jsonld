s/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommun@linkoping.se"},"foaf:name":{"@language":"sv","@value":"Linköpings kommun"},"foaf:page":{"@id":"https://www.linkoping.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://linkoping.entryscape.net/store/1/resource/1"}},{"@id":"https://linkoping.entryscape.net/store/1/resource/18","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://linkoping.entryscape.net/store/1/resource/31"},"dcat:keyword":{"@language":"sv","@value":"Statistik"},"dcat:landingPage":{"@id":"http://statistik.linkoping.se/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Linköping är Sveriges femte största kommun och antalet kommuninvånare ökar stadigt. Befolkningsstatistik från kommunens statistikdatabas finns tillgängligt som öppna data. \n\nInformationen uppdateras varje år enligt följande:\n- Uppgifter för hela kommunen avseende förvärvsarbetande uppdateras i december strax för jul.\n- Grunduppgifter för hela befolkningen i kommunen uppdateras i slutet av februari.\n- En del av den information som finns inom p.1 och p.2 kombineras med andra variabler och då blir dessa informationsmängder tillgängliga först senare under våren.\n- Huvuddelen av den information som finns för delområden uppdateras under april och maj när information successivt blir tillgänglig från SCB. Ibland är dessa uppgifter inte tillgängliga förrän början av juni.\n- Resterande ämnesområden för hela kommunen – vid sidan av ovan nämnda – uppdateras under april och maj varje år.\n\nInformation om API för respektive tabell finns i fliken \"Om tabellen\". Fliken syns på din bildskärm efter det att du har tagit fram en tabell. Koden kommer fram om du klickar på \"Gör denna tabell tillgänglig i Din applikation\"."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000449"},"dct:title":{"@language":"sv","@value":"Befolkningsstatistik"}},{"@id":"https://linkoping.entryscape.net/store/1/resource/31","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://www.linkoping.se/open/data/befolkningsstatistik/"},"dcat:downloadURL":{"@id":"http://statistik.linkoping.se/PXweb/api/v1/sv/Linkoping/Befolkning/be02.px"},"dct:description":{"@language":"sv","@value":"Skicka (POST) följande JSON fråga till nedanstående URL för att nå denna tabell i Din applikation."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":{"@language":"sv","@value":"API"},"foaf:page":{"@id":"https://www.linkoping.se/open/data/befolkningsstatistik/"}}],"@id":"urn:source:50c732766a435d99f316ca4aac893ec8aaacd3286be196f2cda4af4c7a22e162"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000449","@type":"foaf:Agent","dct:identifier":"2120000449","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommun@linkoping.se"},"foaf:name":{"@language":"sv","@value":"Linköpings kommun"},"foaf:page":{"@id":"https://www.linkoping.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://linkoping.entryscape.net/store/1/resource/1"}},{"@id":"https://linkoping.entryscape.net/store/1/resource/66","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://linkoping.entryscape.net/store/1/resource/67"},"dcat:keyword":[{"@language":"sv","@value":"Livsmedelsinspektioner"},{"@language":"sv","@value":"Livsmedelskontroller"}],"dcat:landingPage":{"@id":"https://www.linkoping.se/bygga-och-bo/livsmedel"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Kommunen kontrollerar regelbundet hur livsmedelsverksamheter som exempelvis restauranger och livsmedelsbutiker uppfyller kraven i livsmedelslagstiftningen. Den här öppna datan innehåller resultatet av alla kontroller som löpande genomförs."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000449"},"dct:title":{"@language":"sv","@value":"Livsmedelskontroller"},"foaf:page":{"@id":"https://www.linkoping.se/open/data/livsmedelskontroll2"}},{"@id":"https://linkoping.entryscape.net/store/1/resource/67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://livsmedelsdata.linkoping.se/swagger/index.html"},"dcat:downloadURL":{"@id":"http://livsmedelsdata.linkoping.se/swagger/index.html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Livsmedelskontroller"}},{"@id":"https://www.linkoping.se/open/data/livsmedelskontroll2","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Livsmedelskontroll"}}],"@id":"urn:source:6185f09abd0f12a84be213b1707e32e9189156354f818f2f5380d440cba9110d"},{"@graph":[{"@id":"https://linkoping.entryscape.net/store/1/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://linkoping.entryscape.net/store/1/resource/109"},{"@id":"https://linkoping.entryscape.net/store/1/resource/12"},{"@id":"https://linkoping.entryscape.net/store/1/resource/14"},{"@id":"https://linkoping.entryscape.net/store/1/resource/18"},{"@id":"https://linkoping.entryscape.net/store/1/resource/26"},{"@id":"https://linkoping.entryscape.net/store/1/resource/28"},{"@