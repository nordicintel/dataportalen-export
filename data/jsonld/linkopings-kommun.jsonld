PDATE_CONT"},"dct:description":{"@language":"sv","@value":"Den här öppna datan beskriver aktuell status på antal lediga platser i parkeringshusen i Linköping stad. Informationen uppdateras direkt i samband med att bilar kör in och ut ur parkeringshusen.\n\nData hämtas via api: https://api.dukaten.parkknowit.com/api/parkings/external\n\nSe dokumentation hur api:et används på: https://dukaten.parkknowit.com/docs/api/parkings#get-apiparkingsexternal\n\nhttps://dukaten.se/"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000449"},"dct:title":{"@language":"sv","@value":"Parkering"}}],"@id":"urn:source:9ec392ac08e10de7adf598f6b94f28000ca3798637f1110bd0e8088f24e6e34f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000449","@type":"foaf:Agent","dct:identifier":"2120000449","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommun@linkoping.se"},"foaf:name":{"@language":"sv","@value":"Linköpings kommun"},"foaf:page":{"@id":"https://www.linkoping.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://linkoping.entryscape.net/store/1/resource/1"}},{"@id":"https://linkoping.entryscape.net/store/1/resource/12","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:distribution":{"@id":"https://linkoping.entryscape.net/store/1/resource/13"},"dcat:keyword":[{"@language":"sv","@value":"Job vacancies"},{"@language":"sv","@value":"Lediga jobb"}],"dcat:landingPage":{"@id":"https://www.linkoping.se/naringsliv-och-arbete/jobba-hos-oss/lediga-jobb/"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UPDATE_CONT"},"dct:description":[{"@language":"en","@value":"Job vacancies in Linkoping municipality.\nThis open data describes all available services within Linköping municipality. The information is updated continuously as new services are announced."},{"@language":"sv","@value":"Den här öppna datan beskriver alla lediga tjänster inom Linköpings kommun. Informationen uppdateras löpande i samband med att nya tjänster annonseras.\n\nDatan levereras i XML-format.\n\n...Typ..................Filformat.....Beskrivning...\n...Lediga jobb ....XML.............Returnerar Linköping kommuns lediga jobb...\n\nAnrop: https://site106.reachmee.com/Public/rssfeed/external.ashx?id=10&InstallationID=I017&CustomerName=linkoping&lang=SE"}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000449"},"dct:title":[{"@language":"en","@value":"Job vacancies"},{"@language":"sv","@value":"Lediga jobb"}]},{"@id":"https://linkoping.entryscape.net/store/1/resource/13","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://site106.reachmee.com/Public/rssfeed/external.ashx?id=24&InstallationID=I017&CustomerName=linkoping&lang=SE"},"dct:description":[{"@language":"en","@value":"Job vacancies in Linkoping municipality"},{"@language":"sv","@value":"Lediga jobb i Linköping kommun"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"API"}}],"@id":"urn:source:bcdb85c2cee7d803ee5e13e754e5150ca40f4f7e36b4cac3284c1e6b58137e2f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2120000449","@type":"foaf:Agent","dct:identifier":"2120000449","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommun@linkoping.se"},"foaf:name":{"@language":"sv","@value":"Linköpings kommun"},"foaf:page":{"@id":"https://www.linkoping.se"},"http://www.w3.