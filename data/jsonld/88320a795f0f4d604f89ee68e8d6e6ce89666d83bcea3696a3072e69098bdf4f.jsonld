aab22fe6"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/a0068fdb-82b8-4472-b402-2a147e01006b"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/a13501cf-c94e-49cd-937f-57ff43c40fde"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/ad047593-4900-43bb-9a57-17680b1cd281"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/bd454c3f-d14f-49b3-b93a-0f98e69cd174"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/c4e7ffa2-0f6f-40b2-9e8c-181ce419f9ae"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/c5456fd8-cba3-4716-a6e8-0cf74edade66"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/e0a7dc0b-8518-41e1-8644-eec36050ce03"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/e2d8d58f-55db-4a0c-b551-5e3e107061ea"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/e9bc4f74-6944-4ed9-b3a0-9e12250693b0"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/ed4735ce-383c-4197-ae7e-925ad66c2de9"},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/fceaaeae-3257-43d1-9a75-f9d989a86b01"}],"dcat:keyword":["Malmö stad","badvatten","havsbad","strandbad"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Malmø kommune måler vandtemperaturen i havet ved en række badeområder.\nMålingerne foretages med temperatursensorer, der er placeret tæt på overfladen\n(optimalt set i en dybde på ca. 50 cm) cirka 50 meter fra land. Sensorerne\nrapporterer normalt temperaturen et antal gange i timen, og gennemsnitsværdien\npr. time er den, der offentliggøres i dette datasæt.  \nForkerte måleværdier er usædvanlige, men kan forekomme, hvis sensorens drift\nafbrydes.\n\nRessourcerne består af GeoJSON-filer (Locations YYYY-MM.geojson), der viser de\nsensorer, der har været aktive, og deres omtrentlige placering på månedlig\nbasis. Tilsvarende måleværdier pr. måned er tilgængelige i CSV-filer (Water\nTemperatures YYYY-MM.csv).\n\nMåleværdifiler følger [FIWAREs specifikation for\nWaterQualityObserved](https://fiware%2ddatamodels.readthedocs.io/en/stable/Environment/WaterQualityObserved/doc/spec/index.html)\n.\n\n**Attributter Placeringer**\n\n  * `id` [sensoridentitet]\n  * `address` [sensorplacering (tekst)]\n  * `geometry` [sensorens omtrentlige position, type: Polygon, CRS: WGS84]\n\n**Attributter Vandtemperaturer**\n\n  * `type` [altid \"VandkvalitetObserveret\"]\n  * `id` [sensoridentitet]\n  * `address` [sensorplacering (tekst)]\n  * `dateObserved` [dato og tidspunkt (ISO 8601-format), hvornår måleværdien blev rapporteret]\n  * `temperature` [målt temperatur i grader Celsius]\n\n"},{"@language":"en","@value":"The city of Malmö measures water temperatures in the sea at a number of\nbathing areas. The measurements are made with temperature sensors that are\nplaced close to the surface (optimally at a depth of about 50 cm) some 50\nmeters from land. The sensors normally report the temperature a number of\ntimes per hour and the average value per hour is what is published in this\ndataset.  \nIncorrect measurement values ​​are uncommon but can occur if sensor operation\nis disrupted.\n\nThe resources consist of GeoJSON files (Locations YYYY-MM.geojson) that show\nthe sensors that have been active and their approximate location on a monthly\nbasis. Corresponding measurement values ​​per month are available in CSV files\n(Water Temperatures YYYY-MM.csv).\n\nMeasurement value files follow [FIWARE's specification for\nWaterQualityObserved](https://fiware%2ddatamodels.readthedocs.io/en/stable/Environment/WaterQualityObserved/doc/spec/index.html)\n.\n\n**Attributes Locations**\n\n  * `id` [sensor identity]\n  * `address` [sensor location (text)]\n  * `geometry` [approximate position of the sensor, type: Polygon, CRS: WGS84]\n\n**Attributes Water temperatures**\n\n  * `type` [always \"WaterQualityObserved\"]\n  * `id` [sensor identity]\n  * `address` [sensor location (text)]\n  * `dateObserved` [date and time (ISO 8601 format) when the measurement value was reported]\n  * `temperature` [measured temperature in degrees Celsius]\n\n"},{"@language":"sv","@value":"Malmö stad mäter vattentemperaturer i havet vid ett antal badplatser. Mätningarna görs med temperatursensorer som är placerade nära ytan (optimalt på ca 50 cm djup) några 50-tal meter ut från land. Sensorerna meddelar i normalfallet temperatur ett antal gånger i timmen och medelvärdet per timme är det som publiceras i denna datamängd.  \nFelaktiga mätvärden är ovanliga men kan förekomma om sensordriften störs.\n\nResurserna består dels av GeoJSON-filer (Platser ÅÅÅÅ-MM.geojson) som månadsvis visar de sensorer som varit aktiva och deras ungefärliga placering. Tillhörande mätvärden per månad finns i CSV-filer (Vattentemperaturer ÅÅÅÅ-MM.csv).  \n\nMätvärdesfiler följer [FIWAREs specifikation för WaterQualityObserved](https://fiware-datamodels.readthedocs.io/en/stable/Environment/WaterQualityObserved/doc/spec/index.html).  \n\n__Attribut Platser__  \n  \n+ `id` [sensoridentitet]  \n+ `address` [sensorns placering (text)]  \n+ `geometry` [sensorns ungefärliga position, typ: Polygon, CRS: WGS84]  \n  \n__Attribut Vattentemperaturer__  \n\n+ `type` [alltid \"WaterQualityObserved\"]  \n+ `id` [sensoridentitet]  \n+ `address` [sensorns placering (text)]  \n+ `dateObserved` [datum och timme (format ISO 8601) då mätvärdet rapporterats]  \n+ `temperature` [uppmätt temperatur i grader Celsius]  \n"}],"dct:identifier":"a6ae4550-f95d-4bf2-a6bf-740592a61c15","dct:issued":{"@type":"xsd:date","@value":"2023-04-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T19:07:51.882736"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:3486dc63f6674b7c8808c89ff799c5ad897fbb19d9552f3d2c7b7d13c51bff78_b14n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Vandtemperaturer"},{"@language":"en","@value":"Water temperatures"},{"@language":"sv","@value":"Vattentemperaturer"}]},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/076bd373-15f9-4471-a1e8-5de8cbb4dde9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/076bd373-15f9-4471-a1e8-5de8cbb4dde9/download/platser_2026-03.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"973"},"dct:description":[{"@language":"da","@value":"Svømmeområder i Malmø by\n\n"},{"@language":"en","@value":"Swimming areas in Malmö city\n\n"},{"@language":"sv","@value":"Badplatser i Malmö stad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-03-01T02:06:37.330199"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-06T13:08:59.572624"},"dct:title":[{"@language":"da","@value":"Lokationer 2026-03"},{"@language":"en","@value":"Locations 2026-03"},{"@language":"sv","@value":"Platser 2026-03"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/1397415d-c9c4-483f-84ed-b4fd2bf880d5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/1397415d-c9c4-483f-84ed-b4fd2bf880d5/download/vattentemperaturer_2026-04.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"150509"},"dct:description":[{"@language":"da","@value":"Vandtemperaturer ved svømmeområder\n\n"},{"@language":"en","@value":"Water temperatures at swimming areas\n\n"},{"@language":"sv","@value":"Vattentemperaturer på badplatser"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-01T01:08:03.473028"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-04T13:07:13.357672"},"dct:title":[{"@language":"da","@value":"Vandtemperaturer 2026-04"},{"@language":"en","@value":"Water temperatures 2026-04"},{"@language":"sv","@value":"Vattentemperaturer 2026-04"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:3486dc63f6674b7c8808c89ff799c5ad897fbb19d9552f3d2c7b7d13c51bff78_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/17d1d531-4bbd-4668-8208-6cbe46c0df86","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/a6ae4550-f95d-4bf2-a6bf-740592a61c15/resource/17d1d531-4bbd-4668-8208-6cbe46c0df86/download/vattentemperaturer_2026-08.csv"},"dcat:byteSize":{"@type":"xsd:n