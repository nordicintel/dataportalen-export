"kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Bruttoomkostninger minus interne indtægter og salg til andre kommuner og\nregioner for førskole, divideret med det gennemsnitlige antal børn indskrevet\ni førskole ved målingen den 15/10 i det foregående og indeværende år.\nRefererer til al ledelse.\n\nKilde: Statistiska centralbanken og Skolstyrelsen.\n\n"},{"@language":"en","@value":"Gross cost minus internal revenue and sales to other municipalities and\nregions for preschool, divided by the average number of children enrolled in\npreschool at the measurement on 15/10 of the previous and current year. Refers\nto all management.\n\nSource: Statistics Sweden and the Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för förskola, dividerat med genomsnittligt antal inskrivna barn i förskola vid mätning 15/10 föregående och innevarande år. Avser samtlig regi.  \n  \nKälla: SCB och Skolverket."}],"dct:identifier":"e4be2cca-8f01-49f3-bed6-25e86cae3947","dct:issued":{"@type":"xsd:date","@value":"2022-11-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:48:02.972008"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:77f370f5b13b9ad692f42894c854d4e14c27607a5a569e48a1261fcb51f2989b_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Førskolepris, SEK/indskrevet barn"},{"@language":"en","@value":"Preschool cost, SEK/enrolled child"},{"@language":"sv","@value":"Kostnad förskola, kr/inskrivet barn"}]},{"@id":"https://opendata-api.malmo.se/dataset/e4be2cca-8f01-49f3-bed6-25e86cae3947/resource/0cedf4ed-ae44-48d3-a3d3-387eabf40d94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N11008"},"dct:description":[{"@language":"da","@value":"Bruttoomkostninger minus interne indtægter og salg til andre kommuner og\nregioner for førskole, divideret med det gennemsnitlige antal børn indskrevet\ni førskole ved målingen den 15/10 i det foregående og indeværende år.\nRefererer til al ledelse.\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Gross cost minus internal revenue and sales to other municipalities and\nregions for preschool, divided by the average number of children enrolled in\npreschool at the measurement on 15/10 of the previous and current year. Refers\nto all management.\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för förskola, dividerat med genomsnittligt antal inskrivna barn i förskola vid mätning 15/10 föregående och innevarande år. Avser samtlig regi.  \n  \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-28T12:28:41.651544"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:48:02.977181"},"dct:title":[{"@language":"da","@value":"Førskolepris, SEK/indskrevet barn"},{"@language":"en","@value":"Preschool cost, SEK/enrolled child"},{"@language":"sv","@value":"Kostnad förskola, kr/inskrivet barn"}]}],"@id":"urn:source:77f370f5b13b9ad692f42894c854d4e14c27607a5a569e48a1261fcb51f2989b"},{"@graph":[{"@id":"_:7875080c09bc61fa7adad980a3fbd0cde6013681828c6847d2900a1dd2165921_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"2076877db13751a45d79da4d69234b86"},{"@id":"_:7875080c09bc61fa7adad980a3fbd0cde6013681828c6847d2900a1dd2165921_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763/resource/3e70ea51-d2a8-45e6-be4e-e14a6c51ece7"},{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763/resource/b05f990e-5de6-4e9b-8e5c-ab241ab39b74"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer, der arbejder og bor i området. Variablen er opdelt\ni fire kategorier: \"Bor og arbejder i Malmø\" er dem, der bor i området og\narbejder i Malmø (ikke nødvendigvis i området). \"Pendler ud af Malmø\" er dem,\nder bor i området, men arbejder uden for kommunen. \"Samlet antal personer, der\narbejder i området\" er summen af ​​disse to variabler. \"Pendler ind fra lande\nuden for Malmø\" er dem, der bor uden for Malmø, men arbejder inden for\nområdet. Baseret på statistik fra BAS (\"Arbejdsmarkedsstatus for\nbefolkningen\"). Fra referenceåret 2022 anvendes en ny datakilde, da SCB ændrer\ndatakilden til BAS fra den tidligere RAMS (\"Registerbaseret\narbejdsmarkedsstatistik\"). Der er forskelle på, hvordan RAMS definerer\nerhvervsaktive, og hvordan BAS definerer beskæftigede. For eksempel\nklassificerer RAMS dem, der arbejder i Danmark, som ikke-erhvervsaktive (og\nderfor ikke som pendlere), mens de i BAS tælles som beskæftigede under visse\nomstændigheder. Der er derfor et tidsseriebrud for denne tidsserie, der\nstarter med data for 2022. Ændringen i kilde og metode betyder, at\nsammenligninger af statistikker vedrørende pendling ud af Malmö i 2022 og\ntidligere referenceår skal foretages med stor forsigtighed. Læs mere på\nSCB.se. Vist for befolkningen 16-74 år.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of people working and living in the area. The variable is\ndivided into four categories: \"Live and work in Malmö\" are those who live in\nthe area and work in Malmö (not necessarily in the area). \"Commutes out of\nMalmö\" are those who live in the area but work outside the municipality.\n\"Total number of people working in the area\" is the sum of these two\nvariables. \"Commutes in from outside Malmö\" are those who live outside Malmö\nbut work within the area. Based on statistics from BAS (\"Labour Market Status\nof the Population\"). From the reference year 2022, a new data source is used\nas SCB changes the data source to BAS from the previous RAMS (\"Register-based\nLabour Market Statistics\"). There are differences between how RAMS defines\ngainfully employed and how BAS defines employed. For example, RAMS classifies\nthose who work in Denmark as not gainfully employed (and therefore not as\ncommuters), while in BAS they are counted as employed under certain\ncircumstances. There is therefore a time series break for this time series\nstarting with data for 2022. The change in source and method means that\ncomparisons of statistics regarding commuting out of Malmö in 2022 and\nprevious reference years must be made with great caution. Read more at SCB.se.\nShown for the population 16–74 years old.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet arbetande och boende i området. Variabeln är uppdelad fyra kategorier: ”Bor och arbetar i Malmö” är de som bor i området och jobbar i Malmö (inte nödvändigtvis i området). ”Pendlar ut ur Malmö” är de som bor i området men som jobbar utanför kommunen. ”Totalt antal arbetande som bor i området” är summan av dessa två variabler. ”Pendlar in från utanför Malmö” är de som bor utanför Malmö men som jobbar inom området. Bygger på statistik från BAS (”Befolkningens Arbetsmarknadsstatus\"). Från och med referensår 2022 används en ny datakälla då SCB byter datakälla till BAS från tidigare RAMS (\"Registerbaserad arbetsmarknadsstatistik\"). Det finns skillnader mellan hur RAMS definierar förvärvsarbetande och hur BAS definierar sysselsatta. Till exempel klassar RAMS de som arbetar i Danmark som ej förvärvsarbetande (och därför inte som pendlare) medan de i BAS under vissa omständigheter räknas som sysselsatta. Det sker därför ett tidsseriebrott för denna tidsserie med start med data för 2022. Bytet av källa och metod innebär att jämförelser av statistik avseende pendling ut ur Malmö 2022 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se. Visas för befolkningen 16–74 år.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"0525f2b9-ce51-49b4-b054-43010582d763","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:20.126098"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7875080c09bc61fa7adad980a3fbd0cde6013681828c6847d2900a1dd2165921_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Pendling 2022 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Commuting 2022- - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Pendling 2022- - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763/resource/3e70ea51-d2a8-45e6-be4e-e14a6c51ece7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763/resource/3e70ea51-d2a8-45e6-be4e-e14a6c51ece7/download/pendling-2022-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"528299"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Pendling 2022\n\n"},{"@language":"en","@value":"Malmö statistics - Commuting 2022-\n\n"},{"@language":"sv","@value":"Malmö statistik - Pendling 2022-"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-14T23:01:41.586058"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:20.145088"},"dct:title":[{"@language":"da","@value":"Pendling 2022-"},{"@language":"en","@value":"Commuting 2022-"},{"@language":"sv","@value":"Pendling 2022-"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7875080c09bc61fa7adad980a3fbd0cde6013681828c6847d2900a1dd2165921_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/0525f2b9-ce51-49b4-b054-43010582d763/resource/b05f990e-5de6-4e9b-8e5c-ab241ab39b74","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=3e70ea51-d2a8-45e6-be4e-e14a6c51ece7"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Pendling 2022\n\n"},{"@language":"en","@value":"Malmö statistics - Commuting 2022-\n\n"},{"@language":"sv","@value":"Malmö statistik - Pendling 2022-"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-14T23:01:42.995089"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-01T11:08:59.109199"},"dct:title":[{"@language":"da","@value":"Pendling 2022-"},{"@language":"en","@value":"Commuting 2022-"},{"@language":"sv","@value":"Pendling 2022-"}]}],"@id":"urn:source:7875080c09bc61fa7adad980a3fbd0cde6013681828c6847d2900a1dd2165921"},{"@graph":[{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"13b77e0dcbee6b0f7d2448fc9e32746a"},{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"4ad3b966477fded28dd6840d8b67e2b62c90b21c"},{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"22ed1d355453786ef365d3fa16fe1abc48e9f39e"},{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://lankadedata.se/spec/skoldata/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Information om skolor, förskolor och gymnasier 2018-12-11"},"dct:title":{"@language":"sv","@value":"Specifikation för skoldata"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/0828bf45-791f-4e75-b34d-2fa57e176042"},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/2853493c-06aa-443d-afd1-7e6cd49bfb23"},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/789ccef5-0967-44eb-9a3f-d4b50d37016f"},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/d495d6a3-f1d5-49e5-987e-8774414cee45"}],"dcat:keyword":["Malmö stad","förskolor","geodata","kindergartens","preschools","schools","skolor"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"https://lankadedata.se/spec/skoldata/"},"dct:description":[{"@language":"da","@value":"Børnehaver, folkeskoler, gymnasier og Komvux i Malmø.\n\nKilder: Skolstyrelsen og Statistiska centralbanken (SCB)\n\n"},{"@language":"en","@value":"Preschools, primary schools, upper secondary schools and Komvux in the city of\nMalmö.\n\nSources: National Agency for Education & Statistics Sweden (SCB)\n\n"},{"@language":"sv","@value":"Förskolor, grundskolor, gymnasieskolor och Komvux i Malmö stad.  \n\nKällor: Skolverket & Statistikmyndigheten (SCB)  "}],"dct:identifier":"dbef184e-e111-407b-84da-635274e1b30e","dct:issued":{"@type":"xsd:date","@value":"2023-03-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T00:00:56.105217"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b3n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Skoledata"},{"@language":"en","@value":"School data"},{"@language":"sv","@value":"Skoldata"}]},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/0828bf45-791f-4e75-b34d-2fa57e176042","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/0828bf45-791f-4e75-b34d-2fa57e176042/download/skoldata.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"192941"},"dct:description":[{"@language":"da","@value":"Skoler i Malmø by.\n\n"},{"@language":"en","@value":"Schools in Malmö city.\n\n"},{"@language":"sv","@value":"Skolor i Malmö stad."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-02-11T09:53:53.600412"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T00:00:56.131970"},"dct:title":[{"@language":"da","@value":"Skoledata"},{"@language":"en","@value":"School data"},{"@language":"sv","@value":"Skoldata"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/2853493c-06aa-443d-afd1-7e6cd49bfb23","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/2853493c-06aa-443d-afd1-7e6cd49bfb23/download/skoldata.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"67774"},"dct:description":[{"@language":"da","@value":"Skoler i Malmø by.\n\n"},{"@language":"en","@value":"Schools in Malmö city.\n\n"},{"@language":"sv","@value":"Skolor i Malmö stad."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-03-02T08:16:10.803006"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/la