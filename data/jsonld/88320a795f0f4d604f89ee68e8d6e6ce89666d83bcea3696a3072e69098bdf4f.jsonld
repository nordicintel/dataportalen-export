44"},"dct:title":[{"@language":"da","@value":"Kombineret støj fra tog, veje og havne"},{"@language":"en","@value":"Combined noise from trains, roads and ports"},{"@language":"sv","@value":"Sammanvägt buller från tåg, väg och hamn"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:aeffc73ea1df64a0d587a68dd7b7094522bf036c4764e9b639ee14f774939bc6_b1n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/51077390-2a07-40d0-a116-d449dd223ac8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/51077390-2a07-40d0-a116-d449dd223ac8/download/stil_buller_j-1-3.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7782"},"dct:description":[{"@language":"da","@value":"Stilisering\n\n"},{"@language":"en","@value":"Stylization\n\n"},{"@language":"sv","@value":"Stilsättning"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2023-03-01T15:45:05.780285"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T20:24:08.853714"},"dct:title":[{"@language":"da","@value":"SLD-stil"},{"@language":"en","@value":"SLD style"},{"@language":"sv","@value":"SLD style"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:aeffc73ea1df64a0d587a68dd7b7094522bf036c4764e9b639ee14f774939bc6_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/66a6588f-bc86-46a3-971e-c3a8bf545ef3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/66a6588f-bc86-46a3-971e-c3a8bf545ef3/download/industribuller.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"6768657"},"dct:description":[{"@language":"da","@value":"Støjundersøgelse 2017\n\n"},{"@language":"en","@value":"Noise survey 2017\n\n"},{"@language":"sv","@value":"Bullerkartläggning 2017"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-03-01T17:47:38.416038"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:41:41.950860"},"dct:title":[{"@language":"da","@value":"Industriel støj"},{"@language":"en","@value":"Industrial noise"},{"@language":"sv","@value":"Industribuller"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:aeffc73ea1df64a0d587a68dd7b7094522bf036c4764e9b639ee14f774939bc6_b3n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/fd301468-c989-45d7-bd61-ca8389fd6d86","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/fd301468-c989-45d7-bd61-ca8389fd6d86/download/vagbuller.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27441669"},"dct:description":[{"@language":"da","@value":"Støjundersøgelse 2017\n\n"},{"@language":"en","@value":"Noise survey 2017\n\n"},{"@language":"sv","@value":"Bullerkartläggning 2017"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-12T10:21:00.430322"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:41:58.098366"},"dct:title":[{"@language":"da","@value":"Vejstøj"},{"@language":"en","@value":"Road noise"},{"@language":"sv","@value":"Vägbuller"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:aeffc73ea1df64a0d587a68dd7b7094522bf036c4764e9b639ee14f774939bc6_b4n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/fd970676-3482-4ad8-af1e-d9f6cb10c270","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/99991a95-6953-4bdf-8b42-5184f1dfd328/resource/fd970676-3482-4ad8-af1e-d9f6cb10c270/download/tagbuller.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"4921961"},"dct:description":[{"@language":"da","@value":"Støjundersøgelse 2017\n\n"},{"@language":"en","@value":"Noise survey 2017\n\n"},{"@language":"sv","@value":"Bullerkartläggning 2017"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-03-01T17:47:25.584093"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:42:07.816079"},"dct:title":[{"@language":"da","@value":"Togstøj"},{"@language":"en","@value":"Train noise"},{"@language":"sv","@value":"Tågbuller"}],"h