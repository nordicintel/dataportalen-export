"http://spdx.org/rdf/terms#checksum":{"@id":"_:c1664a07035de238f5eed118c85782f47cf242679bd721e04628dfc93404af6c_b4n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/dbc421bc-23c7-47d4-a427-f6e6588c4120/resource/fe528f94-108b-4ce9-9a5c-ab99d264666c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/dbc421bc-23c7-47d4-a427-f6e6588c4120/resource/fe528f94-108b-4ce9-9a5c-ab99d264666c/download/bullertillstand_industri_2022.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"26433140"},"dct:description":[{"@language":"da","@value":"Støjtilladelser til industrier 2022\n\n"},{"@language":"en","@value":"Noise permits for industries 2022\n\n"},{"@language":"sv","@value":"Bullertillstånd för industrier 2022"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-06-27T16:09:08.529612"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:44:44.172460"},"dct:title":[{"@language":"da","@value":"Støjtilladelser til industrien"},{"@language":"en","@value":"Noise permits for industries"},{"@language":"sv","@value":"Bullertillstånd för industrier"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c1664a07035de238f5eed118c85782f47cf242679bd721e04628dfc93404af6c_b5n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:c1664a07035de238f5eed118c85782f47cf242679bd721e04628dfc93404af6c"},{"@graph":[{"@id":"_:c2f34e68e76316f89cf96fe072e95bc350608ac4849cfe90d7b8de3c36645630_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/aedc7084-1fd4-4923-bbdd-c71d1ef2ea7c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/aedc7084-1fd4-4923-bbdd-c71d1ef2ea7c/resource/c2e098a0-6683-422b-b50b-2d903ef94fa9"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Procentdel af elever med beståede karakterer i alle fag, der indgår i elevens\nuddannelse.\n\nAndelen beregnes ud fra elever, der har modtaget eller ville have modtaget\nkarakterer i henhold til det mål- og vidensrelaterede karaktersystem (elever,\nder ikke har bestået i alle fag, er inkluderet).\n\nStatistik i procenter fra 1998.\n\nDataene omfatter elever, der er registreret i kommunen, uanset hvor de går i\nskole.\n\nKilde: Statistiska centralbanken og Skolstyrelsen.\n\n"},{"@language":"en","@value":"Percentage of students with passing grades in all subjects included in the\nstudent's education.\n\nThe proportion is calculated on students who received or would have received\ngrades according to the goal- and knowledge-related grading system (students\nwho do not have a passing grade in all subjects are included).\n\nStatistics in percentages from 1998.\n\nThe data refers to students registered in the municipality regardless of where\nthey attend school.\n\nSource: Statistics Sweden and the Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":"Andel elever med godkänt betyg i alla ämnen som ingått i elevens utbildning. \n\nAndelen beräknas på dem elever som fått eller skulle ha fått betyg enligt det mål- och kunskapsrelaterade betygssystemet (elever som saknar godkänt betyg i alla ämnen ingår). \n\nStatistik i procent från 1998.\n\nUppgiften avser elever folkbokförda i kommunen oavsett var de går i skola. \n\nKälla: SCB och Skolverket."}],"dct:identifier":"aedc7084-1fd4-4923-bbdd-c71d1ef2ea7c","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:03:48.586747"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c2f34e68e76316f89cf96fe072e95bc350608ac4849cfe90d7b8de3c36645630_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der har opnået videnskravene i alle fag, hjemkommune"},{"@language":"en","@value":"Students in grade 9 who have achieved the knowledge requirements in all subjects, home municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som uppnått kunskapskraven i alla ämnen, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/aedc7084-1fd4-4923-bbdd-c71d1ef2ea7c/resource/c2e098a0-6683-422b-b50b-2d903ef94fa9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15508"},"dct:description":[{"@language":"da","@value":"Procentdel af elever med beståede karakterer i alle fag, der indgår i elevens\nuddannelse. Procentdelen er beregnet ud fra elever, der har modtaget eller\nville have modtaget karakterer i henhold til det mål- og vidensrelaterede\nkaraktersystem (elever, der ikke har bestået karakterer i alle fag, er\ninkluderet). Dataene refererer til elever, der er registreret i kommunen,\nuanset hvor de går i skole. Kilde: Kolada\n\n"},{"@language":"en","@value":"Percentage of students with passing grades in all subjects included in the\nstudent's education. The percentage is calculated on students who received or\nwould have received grades according to the goal- and knowledge-related\ngrading system (students who do not receive passing grades in all subjects are\nincluded). The data refers to students registered in the municipality\nregardless of where they attend school. Source: Kolada\n\n"},{"@language":"sv","@value":"Andel elever med godkänt betyg i alla ämnen som ingått i elevens utbildning. Andelen beräknas på dem  elever som fått eller skulle ha fått betyg enligt det mål- och kunskapsrelaterade betygssystemet (elever som saknar godkänt betyg i alla ämnen ingår). Uppgiften avser elever folkbokförda i kommunen oavsett var de går i skola. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-16T08:01:00.007019"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:03:48.610209"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der har opnået videnskravene i alle fag, hjemkommune, procentdel (%) (N15508)"},{"@language":"en","@value":"Students in grade 9 who have achieved the knowledge requirements in all subjects, home municipality, percentage (%) (N15508)"},{"@language":"sv","@value":"Elever i åk 9 som uppnått kunskapskraven i alla ämnen, hemkommun, andel (%) (N15508)"}]}],"@id":"urn:source:c2f34e68e76316f89cf96fe072e95bc350608ac4849cfe90d7b8de3c36645630"},{"@graph":[{"@id":"_:c38cc74226208f83c60054e674af05e39c2851649e7ae3dace24e1da29a72a8e_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"3113fe69954762ff92511086710c678f"},{"@id":"_:c38cc74226208f83c60054e674af05e39c2851649e7ae3dace24e1da29a72a8e_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f/resource/69a7105e-2b37-426b-b803-44cd2c07f2e7"},{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f/resource/8aa2ad77-d405-45e2-bf47-e0c9f7a94207"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Vises som et gennemsnit af den årlige indkomst for beboere i området. Består\naf indkomst fra beskæftigelse og erhvervsaktiviteter samt overskydende\nkapital. Tallene viser bruttoindkomst. Ud over lønindkomst omfatter indkomst\nfra beskæftigelse også indkomst fra pensioner, sygedagpenge og anden\nskattepligtig kompensation. Fra data for 2020 er indkomst fra arbejde og\npensioner fra andre nordiske lande inkluderet i statistikken. Dette gør\nsammenligninger tilbage i tiden misvisende, da indkomst fra dem, der pendler\ntil Danmark for at arbejde, tidligere ikke var inkluderet i statistikken.\nTallene er vist i løbende priser, hvilket betyder, at de ikke er\ninflationsjusterede. Vist for gruppen 20-64 (dvs. både erhvervsaktive og ikke-\nerhvervsaktive). Variablen er opdelt efter køn. Data fra Indkomst- og\nSkatteregisteret (IoT).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows as an average of the annual income for residents in the area. Consists\nof income from employment and business activities as well as surplus capital.\nThe figures show gross income. In addition to salary income, income from\nemployment also includes income from pensions, sickness benefits and other\ntaxable compensation. As of data for 2020, income from work and pensions from\nother Nordic countries is included in the statistics. This makes comparisons\nback in time misleading as income from those who commute to Denmark for work\nwas previously not included in the statistics. The figures are shown in\ncurrent prices, which means that they are not inflation-adjusted. Shown for\nthe group 20–64 (i.e. both gainfully employed and non-gainfully employed). The\nvariable is broken down by gender. Data from the Income and Tax Register\n(IoT).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar som ett genomsnitt av årsinkomsten för boende i området. Består av inkomst av tjänst och näringsverksamhet samt överskott av kapital.  Siffrorna visar bruttoinkomst. I inkomst av tjänst ingår förutom löneinkomst även inkomst från pension, sjukpenning och andra skattepliktiga ersättningar. Från och med data för 2020 ingår inkomster från arbete och pension från övriga nordiska länder i statistiken. Detta gör att jämförelser bakåt i tiden blir missvisande då inkomster från de som arbetspendlar till Danmark tidigare inte ingått i statistiken. Siffrorna visas i löpande priser vilket betyder att de inte är inflationsjusterade. Visas för gruppen 20–64 (alltså både förvärvsarbetande och icke-förvärvsarbetande).  Variabeln finns uppdelad på kön. Data från Inkomst- och taxeringsregistret (IoT).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"893f2080-f656-463b-a4ef-fe1db7e9bc4f","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:06:36.788782"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c38cc74226208f83c60054e674af05e39c2851649e7ae3dace24e1da29a72a8e_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Samlet arbejds- og kapitalindkomst 2020- - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Total earned and capital income 2020- - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Summa förvärvs- och kapitalinkomst 2020- - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f/resource/69a7105e-2b37-426b-b803-44cd2c07f2e7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f/resource/69a7105e-2b37-426b-b803-44cd2c07f2e7/download/summa-forvarvs-och-kapitalinkomst-2020-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"252846"},"dct:description":[{"@language":"da","@value":"Malmö statistik - Samlet arbejds- og kapitalindkomst 2020-\n\n"},{"@language":"en","@value":"Malmö statistics - Total earned and capital income 2020-\n\n"},{"@language":"sv","@value":"Malmö statistik - Summa förvärvs- och kapitalinkomst 2020-"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:45.428937"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:06:36.795348"},"dct:title":[{"@language":"da","@value":"Samlet arbejds- og kapitalindkomst 2020-"},{"@language":"en","@value":"Total earned and capital income 2020-"},{"@language":"sv","@value":"Summa förvärvs- och kapitalinkomst 2020-"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c38cc74226208f83c60054e674af05e39c2851649e7ae3dace24e1da29a72a8e_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/893f2080-f656-463b-a4ef-fe1db7e9bc4f/resource/8aa2ad77-d405-45e2-bf47-e0c9f7a94207","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=69a7105e-2b37-426b-b803-44cd2c07f2e7"},"dct:description":[{"@language":"da","@value":"Malmö statistik - Samlet arbejds- og kapitalindkomst 2020-\n\n"},{"@language":"en","@value":"Malmö statistics - Total earned and capital income 2020-\n\n"},{"@language":"sv","@value":"Malmö statistik - Summa förvärvs- och kapitalinkomst 2020-"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:46.854595"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-01T10:47:22.957309"},"dct:title":[{"@language":"da","@value":"Samlet arbejds- og kapitalindkomst 2020-"},{"@language":"en","@value":"Total earned and capital income 2020-"},{"@language":"sv","@value":"Summa förvärvs- och kapitalinkomst 2020-"}]}],"@id":"urn:source:c38cc74226208f83c60054e674af05e39c2851649e7ae3dace24e1da29a72a8e"},{"@graph":[{"@id":"_:c42ad594ec936496a329da206120ab4b5a170fbee6afe8e6030fbd389e5ec509_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/7bbdd484-f311-4db2-bb6e-b1ef08d1645a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/7bbdd484-f311-4db2-bb6e-b1ef08d1645a/resource/8d3d5901-732a-4eaf-9b0e-48ddfea683e4"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal bogudlån divideret med antal indbyggere 31/12. Samlet antal udlån\n(første udlån + genudlån) af bøger med skriftlig tekst på fysiske medier.\nRefererer kun til folkebiblioteker (skolebiblioteker er ikke inkluderet,\nkommuner, der har indberettet skolebiblioteker i fællesskab med\nfolkebiblioteker, er blevet overstreget).\n\nKilde: Det Kongelige Bibliotek og Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of book loans divided by number of inhabitants 31/12. Total number of\nloans (initial loans + re-loans) of books with written text on physical media.\nRefers only to public libraries (school libraries are not included,\nmunicipalities that have jointly reported school libraries with public\nlibraries have been crossed out).\n\nSource: Royal Library and Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal boklån dividerat med antal invånare 31/12. Totalt antal lån (initiala lån + omlån) av böcker med skriven text på fysiskt medium. Avser endast folkbibliotek (skolbibliotek ingår inte, de kommuner som samredovisat skolbibliotek med folkbiblioteken har streckats).  \n  \nKälla: Kungliga biblioteket och SCB."}],"dct:identifier":"7bbdd484-f311-4db2-bb6e-b1ef08d1645a","dct:issued":{"@type":"xsd:date","@value":"2022-11-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:17:57.647397"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c42ad594ec936496a329da206120ab4b5a170fbee6afe8e6030fbd389e5ec509_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Udlån af bøger fra kommunale biblioteker, antal/befolkning"},{"@language":"en","@value":"Borrowing of books from municipal libraries, number/population"},{"@language":"sv","@value":"Lån av böcker kommunala bibliotek, antal/inv"}]},{"@id":"https://opendata-api.malmo.se/dataset/7bbdd484-f311-4db2-bb6e-b1ef08d1645a/resource/8d3d5901-732a-4eaf-9b0e-48ddfea683e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N09803"},"dct:description":[{"@language":"da","@value":"Antal bogudlån divideret med antal indbyggere 31/12. Samlet antal udlån\n(første udlån + genudlån) af bøger med skriftlig tekst på fysiske medier.\nRefererer kun til folkebiblioteker (skolebiblioteker er ikke inkluderet,\nkommuner, der har indberettet skolebiblioteker i fællesskab med\nfolkebiblioteker, er blevet overstreget).\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of book loans divided by number of inhabitants 31/12. Total number of\nloans (initial loans + re-loans) of books with written text on physical media.\nRefers only to public libraries (school libraries are not included,\nmunicipalities that have jointly reported school libraries with public\nlibraries have been crossed out).\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Antal boklån dividerat med antal invånare 31/12. Totalt antal lån (initiala lån + omlån) av böcker med skriven text på fysiskt medium. Avser endast folkbibliotek (skolbibliotek ingår inte, de kommuner som samredovisat skolbibliotek med folkbiblioteken har streckats).  \n  \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-28T12:22:34.568779"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:17:57.671574"},"dct:title":[{"@language":"da","@value":"Udlån af bøger fra kommunale biblioteker, antal/befolkning"},{"@language":"en","@value":"Borrowing of books from municipal libraries, number/population"},{"@language":"sv","@value":"Lån av böcker kommunala bibliotek, antal/inv"}]}],"@id":"urn:source:c42ad594ec936496a329da206120ab4b5a170fbee6afe8e6030fbd389e5ec509"},{"@graph":[{"@id":"_:c624a136c3a7137828705b18083b8bc42b663e6d40cc07ba30c03b5183a79840_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"33c618f824cffcd826ae85771f9fd905"},{"@id":"_:c624a136c3a7137828705b18083b8bc42b663e6d40cc07ba30c03b5183a79840_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c/resource/0cf8e900-8ef1-4a2d-981c-e5dd6afed3ae"},{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c/resource/fdbe8498-5ab5-428d-be97-369858213701"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser, i hvilken branche de beskæftigede i området arbejder. Opdelingen følger\nStandarden for svensk brancheklassificering (SNI) 2007. Kategorierne 0\n(ukendt), A (landbrug, jagt og skovbrug), B (udvinding af materialer), D\n(forsyning af el, gas, varme og køling), E (vandforsyning osv.), T\n(husholdningsproduktion osv.) og U (aktivitet i internationale organisationer)\ner blevet slået sammen til kategorien \"Andet\" på grund af det lave antal\npersoner, der arbejder i disse brancher. Variablen viser også det samlede\nantal personer, der arbejder i området. Kun personer, der arbejder i Sverige,\ntælles med. Variablen er opdelt efter køn. Vist for befolkningen i alderen\n16-74 år. Baseret på statistik fra SCB RAMS (\"Registerbaseret\narbejdsmarkedsstatistik\"). Statistikken omfatter alle personer mellem 16 og 74\når, der er registreret i Sverige den 31. december. Siden 2011 har Statistisk\nCentralbyrån foretaget nogle ændringer i, hvordan den tæller personer på 65 år\neller ældre, for at opnå en mere ensartet vurdering af selvstændige. Det er\nderfor ikke hensigtsmæssigt at sammenligne statistikker længere tilbage i\ntiden end 2011. Fra og med referenceåret 2019 bruger Statistiska Centralen\n(SCB) en ny datakilde og metode til at klassificere erhvervsaktive i RAMS.\nÆndringen i kilde og metode betyder, at sammenligninger af statistikker for\n2019 og tidligere referenceår skal foretages med stor forsigtighed. Læs mere\npå SCB.se\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows in which industry the gainfully employed people living in the area work.\nThe division follows the Standard for Swedish Industrial Classification (SNI)\n2007. The categories 0 (unknown), A (Agriculture, hunting and forestry), B\n(extraction of materials), D (supply of electricity, gas, heating and\ncooling), E (water supply, etc.), T (household production, etc.) and U\n(activity at international organizations) have been merged into the category\n\"Other\" due to the low number of people working in these industries. The\nvariable also shows the total number of people working in the area. Only\npeople working in Sweden are counted. The variable is divided by gender. Shown\nfor the population aged 16–74. Based on statistics from SCB RAMS (\"Register-\nbased labour market statistics\"). The statistics include all individuals\nbetween 16 and 74 who are registered in Sweden on 31 December. Since 2011,\nStatistics Sweden has made some changes to how it counts people aged 65 or\nolder in order to obtain a more uniform assessment of self-employed persons.\nIt is therefore not appropriate to compare statistics further back in time\nthan 2011. As of reference year 2019, Statistics Sweden uses a new data source\nand method to classify gainfully employed persons in RAMS. The change in\nsource and method means that comparisons of statistics for 2019 and previous\nreference years must be made with great caution. Read more at SCB.se\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar inom vilken industri de förvärvsarbetande som bor inom området arbetar. Uppdelningen följer Standard för svensk näringsgrensindelning (SNI) 2007. Kategorierna 0 (okänd), A (Jordbruk, jakt och skogsbruk), B (utvinning av material), D (försörjning av el, gas, värme och kyla), E (vattenförsörjning m.m.), T (hushållens produktion med mera) och U (verksamhet vid internationella organisationer) har slagits ihop till kategorin ”Övriga” på grund av det låga antalet arbetande i dessa industrier. Variabeln visar även totalt antal arbetande som bor i området. Endast personer som arbetar i Sverige räknas med. Variabeln finns uppdelad på kön. Visas för befolkningen 16–74 år. Bygger på statistik från SCB RAMS (”Registerbaserad arbetsmarknadsstatistik”). I statistiken ingår samtliga individer mellan 16 och 74 som är folkbokförda i Sverige den 31 december. Fr.o.m. 2011 har SCB gjort en del förändringar i hur man räknar personer som är 65 år eller äldre för att få en mer enhetlig bedömning av egna företagare. Det är därför inte lämpligt att jämföra statistik längre bak i tiden än 2011. Från och med referensår 2019 använder SCB en ny datakälla och metod för att klassificera förvärvsarbetande i RAMS. Bytet av källa och metod innebär att jämförelser av statistik avseende 2019 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"98d23f25-4e29-4857-b5a4-1bd10131ed3c","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:04:05.515503"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c624a136c3a7137828705b18083b8bc42b663e6d40cc07ba30c03b5183a79840_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Natbefolkning ifølge SNI 2007, 2008-2018 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Nighttime population according to SNI 2007, 2008-2018 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Nattbefolkning efter SNI 2007, 2008-2018 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c/resource/0cf8e900-8ef1-4a2d-981c-e5dd6afed3ae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c/resource/0cf8e900-8ef1-4a2d-981c-e5dd6afed3ae/download/nattbefolkning-efter-sni-2007-2008-2018.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"12334459"},"dct:description":[{"@language":"da","@value":"Malmö-statistik - Natbefolkning ifølge SNI 2007, 2008-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Nighttime population according to SNI 2007, 2008-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Nattbefolkning efter SNI 2007, 2008-2018"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:16:59.634901"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:04:05.523869"},"dct:title":[{"@language":"da","@value":"Natbefolkning efter SNI 2007, 2008-2018"},{"@language":"en","@value":"Nighttime population by SNI 2007, 2008-2018"},{"@language":"sv","@value":"Nattbefolkning efter SNI 2007, 2008-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c624a136c3a7137828705b18083b8bc42b663e6d40cc07ba30c03b5183a79840_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/98d23f25-4e29-4857-b5a4-1bd10131ed3c/resource/fdbe8498-5ab5-428d-be97-369858213701","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=0cf8e900-8ef1-4a2d-981c-e5dd6afed3ae"},"dct:description":[{"@language":"da","@value":"Malmö-statistik - Natbefolkning ifølge SNI 2007, 2008-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Nighttime population according to SNI 2007, 2008-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Nattbefolkning efter SNI 2007, 2008-2018"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:17:05.738178"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-13T23:04:47.417288"},"dct:title":[{"@language":"da","@value":"Natbefolkning efter SNI 2007, 2008-2018"},{"@language":"en","@value":"Nighttime population by SNI 2007, 2008-2018"},{"@language":"sv","@value":"Nattbefolkning efter SNI 2007, 2008-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:c624a136c3a7137828705b18083b8bc42b663e6d40cc07ba30c03b5183a79840"},{"@graph":[{"@id":"_:c9262aa9257fb34a1cdefee155dd8a5abfaf92a75aeac17a2c623427b9aba24f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/102bbd35-18c9-40a3-9666-30e8dca9488f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/102bbd35-18c9-40a3-9666-30e8dca9488f/resource/826d4d0d-9e2b-428d-9f12-2ad85d5230aa"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Procentdel af elever i 3. klasse i grundskolen, der deltog i og bestod alle\ndelprøver i svensk og svensk som andetsprog.\n\nHenviser til elever, der er registreret i kommunen, uanset hvor de går i\nskole.\n\nKilde: Skolstyrelsen og Statistisk Centralbyrån.\n\n"},{"@language":"en","@value":"Percentage of students in grade 3 of compulsory school who participated in and\npassed all partial tests in Swedish and Swedish as a second language.\n\nRefers to students registered in the municipality regardless of where they\nattend school.\n\nSource: Swedish National Agency for Education and Statistics Sweden.\n\n"},{"@language":"sv","@value":"Andel av elever i grundskolans årskurs 3 som deltagit i och klarat alla delprov i svenska och svenska som andraspråk. \n\nAvser elever folkbokförda i kommunen oavsett var de går i skolan. \n\nKälla: Skolverket och SCB."}],"dct:identifier":"102bbd35-18c9-40a3-9666-30e8dca9488f","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:37:43.244882"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c9262aa9257fb34a1cdefee155dd8a5abfaf92a75aeac17a2c623427b9aba24f_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 3. klasse, der har deltaget i og bestået alle delprøver til fagprøven i svensk og svensk som andetsprog, hjemkommune"},{"@language":"en","@value":"Students in grade 3 who have participated in and passed all partial tests for the subject test in Swedish and Swedish as a second language, home municipality"},{"@language":"sv","@value":"Elever i årskurs 3 som deltagit i och klarat alla delprov för ämnesprovet i svenska och svenska som andraspråk, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/102bbd35-18c9-40a3-9666-30e8dca9488f/resource/826d4d0d-9e2b-428d-9f12-2ad85d5230aa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15472"},"dct:description":[{"@language":"da","@value":"Procentdel af elever i 3. klasse i grundskolen, der deltog i alle delprøver og\nbestod alle delprøver i svensk og svensk som andetsprog. Henviser til elever,\nder er registreret i kommunen, uanset hvor de går i skole. Kilde: Kolada\n\n"},{"@language":"en","@value":"Percentage of students in year 3 of compulsory school who participated in all\npartial tests and passed all partial tests in Swedish and Swedish as a second\nlanguage. Refers to students registered in the municipality regardless of\nwhere they attend school. Source: Kolada\n\n"},{"@language":"sv","@value":"Andel av elever i grundskolans årskurs 3 som deltagit i alla delprov som klarat alla delprov i svenska och svenska som andraspråk. Avser elever folkbokförda i kommunen oavsett var de går i skolan. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-22T05:49:12.201869"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:37:43.249069"},"dct:title":[{"@language":"da","@value":"Elever i 3. klasse, der deltog i alle delprøver og bestod alle delprøver til fagprøven i svensk og svensk som andetsprog, bopælskommune, andel (%) (N15472)"},{"@language":"en","@value":"Pupils in year 3 who participated in all subtests and passed all subtests for the subject test in Swedish and Swedish as a second language, municipality of residence, proportion (%) (N15472)"},{"@language":"sv","@value":"Elever i åk 3 som deltagit i alla delprov som klarat alla delprov för ämnesprovet i svenska och svenska som andraspråk, hemkommun, andel (%) (N15472)"}]}],"@id":"urn:source:c9262aa9257fb34a1cdefee155dd8a5abfaf92a75aeac17a2c623427b9aba24f"},{"@graph":[{"@id":"_:c9bcf722ffd631c8b4d605c096ee147f85a4c2eed04c17fcba3e98c581809cbd_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"daecce6c1f079d2b34aaa5db6a06b915"},{"@id":"_:c9bcf722ffd631c8b4d605c096ee147f85a4c2eed04c17fcba3e98c581809cbd_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98/resource/037b1184-25c4-4e5a-b004-4d9f6a9e41fb"},{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98/resource/60508726-4b2b-46a3-8ae8-5e42b1a5bdef"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer, der arbejder og bor i området. Variablen er opdelt\ni fire kategorier: \"Bor og arbejder i Malmø\" er dem, der bor i området og\narbejder i Malmø (ikke nødvendigvis i området). \"Pendlere ud af Malmø\" er dem,\nder bor i området, men arbejder uden for kommunen. \"Samlet antal personer, der\narbejder i området\" er summen af ​​disse to variabler. \"Pendlere ind fra lande\nuden for Malmø\" er dem, der bor uden for Malmø, men arbejder i området. De,\nder arbejder i udlandet, er ikke inkluderet i variablen (men dem, der pendler\ntil Malmø fra udlandet, er). Variablen er opdelt efter køn. Vist for\nbefolkningen i alderen 16-74 år. Data fra SCB RAMS (\"Registerbaseret\narbejdsmarkedsstatistik\").\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald for at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of people working and living in the area. The variable is\ndivided into four categories: “Live and work in Malmö” are those who live in\nthe area and work in Malmö (not necessarily in the area). “Commuters out of\nMalmö” are those who live in the area but work outside the municipality.\n“Total number of people working in the area” is the sum of these two\nvariables. “Commuters in from outside Malmö” are those who live outside Malmö\nbut work in the area. Those who work abroad are not included in the variable\n(but those who commute to Malmö from abroad are). The variable is divided by\ngender. Shown for the population aged 16–74. Data from SCB RAMS (“Register-\nbased labour market statistics”).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet arbetande och boende i området. Variabeln är uppdelad fyra kategorier: ”Bor och arbetar i Malmö” är de som bor i området och jobbar i Malmö (inte nödvändigtvis i området). ”Pendlar ut ur Malmö” är de som bor i området men som jobbar utanför kommunen. ”Totalt antal arbetande som bor i området” är summan av dessa två variabler. ”Pendlar in från utanför Malmö” är de som bor utanför Malmö men som jobbar inom området. De som arbetar utomlands ingår inte i variabeln (men däremot de som pendlar till Malmö från utlandet). Variabeln finns uppdelad på kön. Visas för befolkningen 16–74 år. Data från SCB RAMS (”Registerbaserad arbetsmarknadsstatistik”).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"252e6274-f887-4514-abc9-daf149afee98","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:09.454819"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:c9bcf722ffd631c8b4d605c096ee147f85a4c2eed04c17fcba3e98c581809cbd_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Pendling 2011-2021 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Commuting 2011-2021 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Pendling 2011-2021 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98/resource/037b1184-25c4-4e5a-b004-4d9f6a9e41fb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98/resource/037b1184-25c4-4e5a-b004-4d9f6a9e41fb/download/pendling-2011-2021.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1933019"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Pendling 2011-2021\n\n"},{"@language":"en","@value":"Malmö statistics - Commuting 2011-2021\n\n"},{"@language":"sv","@value":"Malmö statistik - Pendling 2011-2021"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-14T23:01:36.923580"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:09.476412"},"dct:title":[{"@language":"da","@value":"Pendling 2011-2021"},{"@language":"en","@value":"Commuting 2011-2021"},{"@language":"sv","@value":"Pendling 2011-2021"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:c9bcf722ffd631c8b4d605c096ee147f85a4c2eed04c17fcba3e98c581809cbd_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/252e6274-f887-4514-abc9-daf149afee98/resource/60508726-4b2b-46a3-8ae8-5e42b1a5bdef","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=037b1184-25c4-4e5a-b004-4d9f6a9e41fb"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Pendling 2011-2021\n\n"},{"@language":"en","@value":"Malmö statistics - Commuting 2011-2021\n\n"},{"@language":"sv","@value":"Malmö statistik - Pendling 2011-2021"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2025-04-14T23:01:37.992910"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-01T11:08:47.724338"},"dct:title":[{"@language":"da","@value":"Pendling 2011-2021"},{"@language":"en","@value":"Commuting 2011-2021"},{"@language":"sv","@value":"Pendling 2011-2021"}]}],"@id":"urn:source:c9bcf722ffd631c8b4d605c096ee147f85a4c2eed04c17fcba3e98c581809cbd"},{"@graph":[{"@id":"_:cc25e57816c1119109215b4f817594719cbf9d4ce5fec23fafe2c932f62c3d28_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/ceb61548-b3ad-44b8-94a9-a4526c4eaa4e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/ceb61548-b3ad-44b8-94a9-a4526c4eaa4e/resource/d8493646-cbfc-4fad-9c33-0d36435ce156"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til uddannelserne i økonomi,\nhumaniora og samfundsvidenskab, divideret med antallet af elever, der fik\neller ville have fået karakterer i mindst ét ​​fag i henhold til det mål- og\nvidensrelaterede karaktersystem i 9. klasse. Dataene refererer til elever, der\ner registreret i kommunen. Elever med ukendt baggrund er ikke inkluderet.\nDataene refererer til skoleåret. Kilde: Statistiska Centralbyrån og\nSkolstyrelsen.\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the economics, humanities\nand social science programs divided by the number of students who received or\nwould have received grades in at least one subject according to the goal- and\nknowledge-related grading system in grade 9. The data refers to students\nregistered in the municipality. Students with unknown backgrounds are not\nincluded. The data refers to the academic year. Source: Statistics Sweden and\nthe Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":" Antal elever i årskurs 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Uppgiften avser elever folkbokförda i kommunen. Elever med okänd bakgrund ingår inte. Uppgiften avser läsår. Källa: SCB och Skolverket."}],"dct:identifier":"ceb61548-b3ad-44b8-94a9-a4526c4eaa4e","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:38:26.738435"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:cc25e57816c1119109215b4f817594719cbf9d4ce5fec23fafe2c932f62c3d28_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til økonomi-, humaniora- og samfundsvidenskabelige uddannelser, hjemkommune, procentdel (%)"},{"@language":"en","@value":"Students in grade 9 who are eligible for economics, humanities and social sciences programs, home municipality, percentage (%)"},{"@language":"sv","@value":"Elever i åk 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen, hemkommun,  andel (%)"}]},{"@id":"https://opendata-api.malmo.se/dataset/ceb61548-b3ad-44b8-94a9-a4526c4eaa4e/resource/d8493646-cbfc-4fad-9c33-0d36435ce156","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15426"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til at gå på økonomi-, humaniora-\nog samfundsvidenskabelige uddannelser, divideret med antallet af elever, der\nfik eller ville have fået karakterer i mindst ét ​​fag i henhold til det mål-\nog vidensrelaterede karaktersystem i 9. klasse. Dataene refererer til elever,\nder er registreret i kommunen. Elever med ukendt baggrund er ikke inkluderet.\nDataene refererer til skoleåret. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the economics, humanities\nand social science programs divided by the number of students who received or\nwould have received grades in at least one subject according to the goal- and\nknowledge-related grading system in grade 9. The data refers to students\nregistered in the municipality. Students with unknown backgrounds are not\nincluded. The data refers to the academic year. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Uppgiften avser elever folkbokförda i kommunen. Elever med okänd bakgrund ingår inte. Uppgiften avser läsår. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-17T13:02:30.826949"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:38:26.743622"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til at tage økonomi-, humaniora- og samfundsvidenskabelige uddannelser, hjemkommune, procentdel (%) (N15426)"},{"@language":"en","@value":"Students in grade 9 who are eligible for economics, humanities and social science programs, home municipality, proportion (%) (N15426)"},{"@language":"sv","@value":"Elever i åk 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen, hemkommun,  andel (%) (N15426)"}]}],"@id":"urn:source:cc25e57816c1119109215b4f817594719cbf9d4ce5fec23fafe2c932f62c3d28"},{"@graph":[{"@id":"_:cc4677efa2e6e291362f59ffd8b7bea76e9b04170c4e8dc1c8a72a5bf3d43b75_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"9760add19b43779bb48c8c1b091af5c5"},{"@id":"_:cc4677efa2e6e291362f59ffd8b7bea76e9b04170c4e8dc1c8a72a5bf3d43b75_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/73490f00-0d71-4b17-903c-f77ab7664a53"},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/9e5c63be-243c-42d2-83c0-5fad0079d45f"},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/b6302a33-8fe1-4308-a615-8b584dc81464"},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/c368cced-a813-4545-b816-cc1a7d4efc5a"}],"dcat:keyword":["Malmö stad","datumparkering","geodata","gis","karta","map"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Data, der viser, hvornår og hvor køretøjer skal flyttes på grund af\nrengøringsdage.\n\nMiljøparkering er et parkeringsforbud, der gælder i et par timer én gang om\nmåneden. Parkeringsforbuddet bruges, så vi kan rengøre Malmøs gader så\neffektivt som muligt, men også for at kunne udføre andet arbejde i den\nperiode, forbuddet er gældende.\n\nMere information kan findes her:  \nhttps://malmo.se/Bo%2doch%2dleva/Stadsmiljo%2doch%2dtrafik/Parkering/Miljoparkering.html\n\n**Attribut**\n\n`gid` [id fra kildedata]  \n`value` [parkeringsbestemmelse udtrykt i tekst]  \n`copy_value` [tidspunkt hvor bestemmelsen finder anvendelse, udtrykt i tekst]  \n`tid` [tidsinterval, hvor bestemmelsen gælder, i kombination med attributten\ndag]  \n`day` [dag i måneden, hvor bestemmelsen gælder, i kombination med\ntidsattributten]  \n`ikraftadanadedatum` [dato hvor bestemmelsen træder i kraft]  \n`timestamp` [dato for sidste opdatering fra lokale trafikregler]  \n`geometry` [type: Polygon, CRS: WGS84]\n\n"},{"@language":"en","@value":"Data showing when and where vehicles should be moved due to cleaning days.\n\nEnvironmental parking is a parking ban that applies for a few hours once a\nmonth. The parking ban is used so that we can clean Malmö's streets as\nefficiently as possible, but also to be able to carry out other work during\nthe time the ban is in effect.\n\nMore information can be found here:  \nhttps://malmo.se/Bo%2doch%2dleva/Stadsmiljo%2doch%2dtrafik/Parkering/Miljoparkering.html\n\n**Attribute**\n\n`gid` [id from source data]  \n`value` [parking provision expressed in text]  \n`copy_value` [time at which the provision applies, expressed in text]  \n`tid` [time interval during which the provision applies, in combination with\nthe day attribute]  \n`day` [day of the month when the provision applies, in combination with the\ntime attribute]  \n`ikraftadanadedatum` [date on which the provision enters into force/came into\nforce]  \n`timestamp` [date of last update from local traffic regulations]  \n`geometry` [type: Polygon, CRS: WGS84]\n\n"},{"@language":"sv","@value":"Data som visar när och var fordon ska flyttas på grund av städdagar.  \n\nMiljöparkering är ett parkeringsförbud som gäller under några timmar en gång i månaden. Parkeringsförbudet används för att vi ska kunna komma åt att städa Malmös gator så effektivt som möjligt, men även för att kunna utföra andra arbeten under tiden då förbudet gäller.  \n\nMer information finner du här:  \nhttps://malmo.se/Bo-och-leva/Stadsmiljo-och-trafik/Parkering/Miljoparkering.html  \n\n__Attribut__  \n  \n`gid` [id från källdatan]  \n`value` [parkeringsbestämmelse uttryckt i text]  \n`copy_value` [tidpunkt då bestämmelsen råder, uttryckt i text]  \n`tid` [tidsintervall då bestämmelsen råder, i kombination med attributet day]  \n`day` [dag i månaden då bestämmelsen råder, i kombination med attributet tid]  \n`ikraftadanadedatum` [datum då bestämmelsen träder/trädde ikraft]  \n`timestamp` [datum för senaste uppdatering från de lokala trafikföreskrifterna]  \n`geometry` [typ: Polygon, CRS: WGS84]  "}],"dct:identifier":"c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a","dct:issued":{"@type":"xsd:date","@value":"2025-01-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T05:42:27.036422"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:cc4677efa2e6e291362f59ffd8b7bea76e9b04170c4e8dc1c8a72a5bf3d43b75_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Miljøvenlig parkering"},{"@language":"en","@value":"Environmental parking"},{"@language":"sv","@value":"Miljöparkering"}]},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/73490f00-0d71-4b17-903c-f77ab7664a53","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/73490f00-0d71-4b17-903c-f77ab7664a53/download/miljoparkeringar.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1183464"},"dct:description":[{"@language":"da","@value":"Miljøvenlig parkering\n\n"},{"@language":"en","@value":"Environmental parking\n\n"},{"@language":"sv","@value":"Miljöparkering"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-01-16T07:11:44.244185"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-05T01:38:17.139347"},"dct:title":[{"@language":"da","@value":"Miljøvenlig parkering"},{"@language":"en","@value":"Environmental parking"},{"@language":"sv","@value":"Miljöparkering"}]},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/9e5c63be-243c-42d2-83c0-5fad0079d45f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/9e5c63be-243c-42d2-83c0-5fad0079d45f/download/miljoparkeringar.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"584380"},"dct:description":[{"@language":"da","@value":"Miljøvenlig parkering\n\n"},{"@language":"en","@value":"Environmental parking\n\n"},{"@language":"sv","@value":"Miljöparkering"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T11:33:23.235741"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:22:49.210896"},"dct:title":[{"@language":"da","@value":"Miljøvenlig parkering"},{"@language":"en","@value":"Environmental parking"},{"@language":"sv","@value":"Miljöparkering"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:cc4677efa2e6e291362f59ffd8b7bea76e9b04170c4e8dc1c8a72a5bf3d43b75_b0n0"}},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/b6302a33-8fe1-4308-a615-8b584dc81464","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/b6302a33-8fe1-4308-a615-8b584dc81464/download/miljoparkering.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3274"},"dct:description":[{"@language":"da","@value":"-\n\n"},{"@language":"en","@value":"-\n\n"},{"@language":"sv","@value":"-"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2025-02-10T11:29:58.263342"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:22:49.210612"},"dct:title":[{"@language":"da","@value":"Stilisering"},{"@language":"en","@value":"Stylization"},{"@language":"sv","@value":"Stilsättning"}]},{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/c368cced-a813-4545-b816-cc1a7d4efc5a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c3f1cdfd-fd67-4b3f-ba96-d97c00339b6a/resource/c368cced-a813-4545-b816-cc1a7d4efc5a/download/miljoparkeringar.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"778240"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"Miljøvenlig parkering\n\n"},{"@language":"en","@value":"Environmental parking\n\n"},{"@language":"sv","@value":"Miljöparkering"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T11:33:19.845494"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-05T01:38:34.489566"},"dct:title":[{"@language":"da","@value":"Miljøvenlig parkering"},{"@language":"en","@value":"Environmental parking"},{"@language":"sv","@value":"Miljöparkering"}]}],"@id":"urn:source:cc4677efa2e6e291362f59ffd8b7bea76e9b04170c4e8dc1c8a72a5bf3d43b75"},{"@graph":[{"@id":"_:cdc272246631bd1bd275258d1f4ef49abd6a1ba03f4b480521f3d502ff6cb1aa_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"285960387ae48362e6f3b97b75c1ec99"},{"@id":"_:cdc272246631bd1bd275258d1f4ef49abd6a1ba03f4b480521f3d502ff6cb1aa_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe/resource/e1c5bce6-dec5-41c0-a711-9b93078daf39"},{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe/resource/f454e51f-e7aa-4068-a016-ea4016d18260"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer bosiddende i det valgte område, som har kørekort\nmed et B-kørekort, eller et B-kørekort sammen med andre kørekort, der er\nregistreret i Trafikstyrelsens kørekortregister. Tabellen opdateres ikke.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of people living in the selected area who have a driving\nlicense with a B license, or a B license together with other licenses, that\nare registered in the Swedish Transport Agency's driving license register. The\ntable is not updated.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet personer boende i det valda området som har körkort med B-behörighet, eller B-behörighet tillsammans med andra behörigheter, som finns registrerat i Transportstyrelsens körkortsregister. Tabellen uppdateras ej.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"d17a9137-ac5b-4efa-9647-ea381c648dbe","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:08:58.094637"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:cdc272246631bd1bd275258d1f4ef49abd6a1ba03f4b480521f3d502ff6cb1aa_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Kørekortbesiddelse 2007-2016 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Driving license ownership 2007-2016 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Körkortsinnehav 2007-2016 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe/resource/e1c5bce6-dec5-41c0-a711-9b93078daf39","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=f454e51f-e7aa-4068-a016-ea4016d18260"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Kørekortbesiddelse 2007-2016\n\n"},{"@language":"en","@value":"Malmö statistics - Driving license ownership 2007-2016\n\n"},{"@language":"sv","@value":"Malmö statistik - Körkortsinnehav 2007-2016"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-09-09T08:20:47.807777"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-09T08:20:54.119956"},"dct:title":[{"@language":"da","@value":"Kørekortbeholdninger 2007-2016"},{"@language":"en","@value":"Driving license holdings 2007-2016"},{"@language":"sv","@value":"Körkortsinnehav 2007-2016"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe/resource/f454e51f-e7aa-4068-a016-ea4016d18260","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d17a9137-ac5b-4efa-9647-ea381c648dbe/resource/f454e51f-e7aa-4068-a016-ea4016d18260/download/korkortsinnehav-2007-2016.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"340969"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Kørekortbesiddelse 2007-2016\n\n"},{"@language":"en","@value":"Malmö statistics - Driving license ownership 2007-2016\n\n"},{"@language":"sv","@value":"Malmö statistik - Körkortsinnehav 2007-2016"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-09-09T08:20:43.407690"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:08:58.113940"},"dct:title":[{"@language":"da","@value":"Kørekortbeholdninger 2007-2016"},{"@language":"en","@value":"Driving license holdings 2007-2016"},{"@language":"sv","@value":"Körkortsinnehav 2007-2016"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:cdc272246631bd1bd275258d1f4ef49abd6a1ba03f4b480521f3d502ff6cb1aa_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:cdc272246631bd1bd275258d1f4ef49abd6a1ba03f4b480521f3d502ff6cb1aa"},{"@graph":[{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"e84982606982a12c607242923a25478b5053f61b"},{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"7465626e920fa6fed4ca857ea783bbba0821e431"},{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/40db9f0a-6fcb-4781-9ebd-51cb59d9ed98"},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/6dd8662f-4a87-4777-855a-ebee5b1030ab"},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/a48e759a-3050-413c-b36e-ce0c333a9c43"},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/e85a571b-1f3c-4967-9336-b066f0060679"}],"dcat:keyword":["GIS","Malmö stad","NO2","geodata","karta","kvävedioxid","luftförorening","luftföroreningar","map","utsläpp"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"da","@value":"Beregnede niveauer af nitrogendioxid (NO2) som mikrogram/m3. Nitrogendioxid er\net luftforurenende stof og kan bruges som en indikator for andre\nluftforurenende stoffer. Niveauerne er beregnet 2 meter over jordniveau.\nBeregningens opløsning er 50x50 meter og er baseret på vejret og emissionerne\ni løbet af hvert år.\n\n"},{"@language":"en","@value":"Calculated levels of nitrogen dioxide (NO2) as micrograms/m3. Nitrogen dioxide\nis an air pollutant and can be used as an indicator of other air pollutants.\nThe levels are calculated at 2 meters above ground level. The resolution of\nthe calculation is 50x50 meters and is based on the weather and emissions\nduring each year.\n\n"},{"@language":"sv","@value":"Beräknade halter av kvävedioxid (NO2) som mikrogram/m3. Kvävedioxid är en luftförorening samt kan användas som en indikator på andra luftföroreningar. Halterna är beräknade på 2 meter ovan marknivå. Upplösningen på beräkningen är 50x50 meter och baseras på vädret och utsläppen under respektive år."}],"dct:identifier":"8fe1ecef-724f-4f85-8c78-9e8a769e45c3","dct:issued":{"@type":"xsd:date","@value":"2023-05-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-15T16:17:36.147638"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b3n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Luftforurening - NO2"},{"@language":"en","@value":"Air pollution - NO2"},{"@language":"sv","@value":"Luftförorening - NO2"}]},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/40db9f0a-6fcb-4781-9ebd-51cb59d9ed98","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/40db9f0a-6fcb-4781-9ebd-51cb59d9ed98/download/no2_ar_2023_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3073202"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-22T10:37:05.384037"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-22T10:38:04.046133"},"dct:title":[{"@language":"da","@value":"NO2 i 2023"},{"@language":"en","@value":"NO2 in 2023"},{"@language":"sv","@value":"NO2 år 2023"}]},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/6dd8662f-4a87-4777-855a-ebee5b1030ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/6dd8662f-4a87-4777-855a-ebee5b1030ab/download/no2_ar_2025_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2438082"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-22T10:45:33.812383"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-22T10:45:45.825992"},"dct:title":[{"@language":"da","@value":"NO2 i 2025"},{"@language":"en","@value":"NO2 in 2025"},{"@language":"sv","@value":"NO2 år 2025"}]},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/a48e759a-3050-413c-b36e-ce0c333a9c43","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/a48e759a-3050-413c-b36e-ce0c333a9c43/download/no2_ar_2021_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"28418947"},"dct:description":[{"@language":"da","@value":"Nr. 2 i 2021\n\n"},{"@language":"en","@value":"NO2 in 2021\n\n"},{"@language":"sv","@value":"NO2 år 2021"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-12T12:33:45.733267"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:39:26.840374"},"dct:title":[{"@language":"da","@value":"Nr. 2 i 2021"},{"@language":"en","@value":"NO2 in 2021"},{"@language":"sv","@value":"NO2 år 2021"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b1n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/e85a571b-1f3c-4967-9336-b066f0060679","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/8fe1ecef-724f-4f85-8c78-9e8a769e45c3/resource/e85a571b-1f3c-4967-9336-b066f0060679/download/no2.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"8420"},"dct:description":[{"@language":"da","@value":"Stilisering\n\n"},{"@language":"en","@value":"Stylization\n\n"},{"@language":"sv","@value":"Stilsättning"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-12T11:55:03.579674"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-15T16:17:36.155314"},"dct:title":[{"@language":"da","@value":"Stilisering"},{"@language":"en","@value":"Stylization"},{"@language":"sv","@value":"Stilsättning"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2_b2n0"}}],"@id":"urn:source:ce5e4cf2b84a7cc6cdc0ee721bdcef94588402b59f76ab3e7a0e4c4d3a7baaf2"},{"@graph":[{"@id":"_:cf3de71546037a74564106c2c50ddcc6986d072c2ce61acbb9d6a9d2a8b67891_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/75d9173e-a318-41d0-aaa7-03b8d66784b2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/75d9173e-a318-41d0-aaa7-03b8d66784b2/resource/3aedd2f7-163c-45f6-b52d-192f6235a33c"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Lærere med en pædagogisk universitetsuddannelse i en gymnasial skole\nbeliggende i kommunen (omregnet til fuldtidsstillinger).\n\nStatistikkerne vises i procenter og refererer til det akademiske år, målt den\n15. oktober.\n\nOplysninger om læreruddannelser indhentes fra Statistiska Centralbyråns\nregister over videregående uddannelser (Højere Uddannelsesregisteret) og fra\nStatistiska Centralbyråns register over befolkningens uddannelse. Udenlandske\nlæreruddannelser og læreruddannelser, der drives under Waldorfbevægelsens\nregi, er ikke altid inkluderet i disse registre.\n\nKilde: Den svenske statslige skolestyrelse (Siris)\n\n"},{"@language":"en","@value":"Teachers with a pedagogical university degree in an upper secondary school\nlocated in the municipality (converted to full-time positions).\n\nThe statistics are shown in percentages and refer to the academic year,\nmeasured on October 15.\n\nInformation on teacher education is obtained from Statistics Sweden's register\nof higher education degrees (the Higher Education Register) and from\nStatistics Sweden's register of the population's education. Foreign teacher\neducation programmes and teacher education programmes run under the auspices\nof the Waldorf movement are not always included in these registers.\n\nSource: Swedish National Agency for Education (Siris)\n\n"},{"@language":"sv","@value":"Lärare med pedagogisk högskoleexamen i gymnasieskola belägen i kommunen (omräknat till heltidstjänster). \n\nStatistiken visas i procent och avser läsår, mätt den 15 oktober.\n\nUppgifter om lärares utbildning hämtas från SCB:s register över högskoleexamina (Högskoleregistret) och från SCB:s register över befolkningens utbildning. Utländska lärarutbildningar och lärarutbildningar som bedrivs i Waldorfrörelsens regi finns inte alltid med i dessa register.\n\nKälla: Skolverket (Siris)"}],"dct:identifier":"75d9173e-a318-41d0-aaa7-03b8d66784b2","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:29:59.242656"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:cf3de71546037a74564106c2c50ddcc6986d072c2ce61acbb9d6a9d2a8b67891_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Lærere med en pædagogisk universitetsgrad i gymnasiet"},{"@language":"en","@value":"Teachers with a pedagogical university degree in upper secondary school"},{"@language":"sv","@value":"Lärare med pedagogisk högskoleexamen i gymnasieskola"}]},{"@id":"https://opendata-api.malmo.se/dataset/75d9173e-a318-41d0-aaa7-03b8d66784b2/resource/3aedd2f7-163c-45f6-b52d-192f6235a33c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17813"},"dct:description":[{"@language":"da","@value":"Lærere med en pædagogisk universitetsgrad i en gymnasial skole beliggende i\nkommunen (omregnet til fuldtidsstillinger), procent (%). Data om\nlæreruddannelser er indhentet fra Statistiska Centralbyråns register over\nuniversitetsgrader (Højskoleregistret) og fra Statistiska Centralbyråns\nregister over befolkningens uddannelse. Udenlandske læreruddannelser og\nlæreruddannelser, der drives under Waldorfbevægelsens regi, er ikke altid\ninkluderet i disse registre. Henviser til studieår, målt den 15. oktober.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Teachers with a pedagogical university degree in an upper secondary school\nlocated in the municipality (converted to full-time positions), percentage\n(%). Data on teachers' education is obtained from Statistics Sweden's register\nof university degrees (the Higher Education Register) and from Statistics\nSweden's register of the population's education. Foreign teacher education\nprogrammes and teacher education programmes run under the auspices of the\nWaldorf movement are not always included in these registers. Refers to\nacademic year, measured on 15 October. Source: Kolada\n\n"},{"@language":"sv","@value":"Lärare med pedagogisk högskoleexamen i gymnasieskola belägen i kommunen (omräknat till heltidstjänster) , andel (%). Uppgifter om lärares utbildning hämtas från SCB:s register över högskoleexamina (Högskoleregistret) och från SCB:s register över befolkningens utbildning. Utländska lärarutbildningar och lärarutbildningar som bedrivs i Waldorfrörelsens regi finns inte alltid med i dessa register. Avser läsår, mätt den 15 oktober. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-17T05:41:58.381280"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:29:59.261419"},"dct:title":[{"@language":"da","@value":"Lærere med en pædagogisk universitetsgrad i gymnasiet, placeringskommune, andel (%) (N17813)"},{"@language":"en","@value":"Teachers with a pedagogical university degree in upper secondary school, location municipality, proportion (%) (N17813)"},{"@language":"sv","@value":"Lärare med pedagogisk högskoleexamen i gymnasieskola, lägeskommun, andel (%) (N17813)"}]}],"@id":"urn:source:cf3de71546037a74564106c2c50ddcc6986d072c2ce61acbb9d6a9d2a8b67891"},{"@graph":[{"@id":"_:d110c31a432658e53e185f221260507f88e944cf1adb825c84807c61fec936d1_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"07b6697b4a4fc4d32266af30f9ceafa0"},{"@id":"_:d110c31a432658e53e185f221260507f88e944cf1adb825c84807c61fec936d1_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235/resource/14730648-f554-4a3a-b621-de13c96c0842"},{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235/resource/4a1da160-af6d-4094-a095-b47927720cfc"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser Malmø Kommunes befolkningsprognose og udsigter for delområder og\ngeografiske statistiske områder på det samlede billede. De seneste fem år er\nbaseret på meget usikre antagelser og bør ses som en prognose og ikke en\nprognose. Tabellen viser den senest offentliggjorte prognose. Mere detaljerede\ntabeller og en beskrivelse af prognosen kan findes på malmo.se/redovisningar.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows Malmö City's population forecast and outlook for sub-areas and\ngeographic statistical areas on the total. The last five years are based on\nvery uncertain assumptions and should be seen as an outlook and not a\nforecast. The table shows the most recently published forecast. More detailed\ntables and a description of the forecast can be found at\nmalmo.se/redovisningar.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar Malmö stads befolkningsprognos och utblick för delområde och geografiska statistikområden på totalen. De sista fem åren bygger på mycket osäkra antaganden och ska ses som en utblick och inte en prognos. Tabellen visar den senast publicerade prognosen. Mer detaljerade tabeller samt beskrivning av prognosen kan man hitta på malmo.se/redovisningar. \n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"d5fb6802-b6dd-4a5a-a399-e57f4418b235","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:01:57.774891"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d110c31a432658e53e185f221260507f88e944cf1adb825c84807c61fec936d1_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Befolkningsprognose - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Population forecast - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Befolkningsprognos - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235/resource/14730648-f554-4a3a-b621-de13c96c0842","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235/resource/14730648-f554-4a3a-b621-de13c96c0842/download/befolkningsprognos.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"154205"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Befolkningsprognose\n\n"},{"@language":"en","@value":"Malmö statistics - Population forecast\n\n"},{"@language":"sv","@value":"Malmö statistik - Befolkningsprognos"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-20T07:55:00.596241"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:01:57.799447"},"dct:title":[{"@language":"da","@value":"Befolkningsprognose"},{"@language":"en","@value":"Population forecast"},{"@language":"sv","@value":"Befolkningsprognos"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:d110c31a432658e53e185f221260507f88e944cf1adb825c84807c61fec936d1_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d5fb6802-b6dd-4a5a-a399-e57f4418b235/resource/4a1da160-af6d-4094-a095-b47927720cfc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=14730648-f554-4a3a-b621-de13c96c0842"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Befolkningsprognose\n\n"},{"@language":"en","@value":"Malmö statistics - Population forecast\n\n"},{"@language":"sv","@value":"Malmö statistik - Befolkningsprognos"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-20T07:55:04.671130"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-20T07:55:09.766830"},"dct:title":[{"@language":"da","@value":"Befolkningsprognose"},{"@language":"en","@value":"Population forecast"},{"@language":"sv","@value":"Befolkningsprognos"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:d110c31a432658e53e185f221260507f88e944cf1adb825c84807c61fec936d1"},{"@graph":[{"@id":"_:d322d59761174e5582ec61f08c2de0c21abcb0be06556a54d8df197c4d6ebc24_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/588bc189-a14e-432a-bcf8-4acd54054651","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/588bc189-a14e-432a-bcf8-4acd54054651/resource/0ca6c302-8ff3-450a-890f-3fef6d101da4"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Procentdel af elever med beståede karakterer i alle fag, der indgår i elevens\nuddannelse.\n\nAndelen beregnes ud fra de elever, der fik eller ville have fået karakterer i\nhenhold til det mål- og vidensrelaterede karaktersystem (elever, der ikke har\nen beståelseskarakter i alle fag, er inkluderet).\n\nStatistik i procenter fra 1998.\n\nBegrebet \"lokalkommune\" henviser til elever i kommunale og friskoler i\nkommunen, uanset hvor de er indskrevet.\n\nI 2016 blev studerende med ukendt baggrund udelukket.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"Percentage of students with passing grades in all subjects included in the\nstudent's education.\n\nThe proportion is calculated based on the students who received or would have\nreceived grades according to the goal- and knowledge-related grading system\n(students who do not have a passing grade in all subjects are included).\n\nStatistics in percentages from 1998.\n\nThe term \"local municipality\" refers to students in municipal and independent\nschools in the municipality, regardless of where they are registered.\n\nIn 2016, students with unknown backgrounds were excluded.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Andel elever med godkänt betyg i alla ämnen som ingått i elevens utbildning. \n\nAndelen beräknas på de elever som fått eller skulle ha fått betyg enligt det mål- och kunskapsrelaterade betygssystemet (elever som saknar godkänt betyg i alla ämnen ingår). \n\nStatistik i procent från 1998.\n\nMed lägeskommun avses elever i kommunala och fristående skolor i kommunen oberoende av var de är folkbokförda. \n\n2016 exkluderades elever med okänd bakgrund. \n\nKälla Skolverket (Siris)."}],"dct:identifier":"588bc189-a14e-432a-bcf8-4acd54054651","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:39:48.297933"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d322d59761174e5582ec61f08c2de0c21abcb0be06556a54d8df197c4d6ebc24_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der har opnået videnskravene i alle fag, placering kommune"},{"@language":"en","@value":"Students in grade 9 who have achieved the knowledge requirements in all subjects, location municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som uppnått kunskapskraven i alla ämnen, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/588bc189-a14e-432a-bcf8-4acd54054651/resource/0ca6c302-8ff3-450a-890f-3fef6d101da4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15418"},"dct:description":[{"@language":"da","@value":"Procentdel af elever med en bestået karakter i alle fag, der indgår i elevens\nuddannelse. Procentdelen beregnes ud fra elever, der har modtaget eller ville\nhave modtaget karakterer i henhold til det mål- og vidensrelaterede\nkaraktersystem (elever, der ikke har en bestået karakter i alle fag, er\ninkluderet). Beliggenhedskommunen refererer til elever i kommunale og private\nskoler i kommunen, uanset hvor de er indskrevet. I 2016 blev elever med ukendt\nbaggrund ekskluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Percentage of students with a passing grade in all subjects included in the\nstudent's education. The percentage is calculated on students who received or\nwould have received grades according to the goal- and knowledge-related\ngrading system (students who do not receive a passing grade in all subjects\nare included). The municipality of location refers to students in municipal\nand independent schools in the municipality regardless of where they are\nregistered. In 2016, students with an unknown background were excluded.\nSource: Kolada\n\n"},{"@language":"sv","@value":"Andel elever med godkänt betyg i alla ämnen som ingått i elevens utbildning. Andelen beräknas på dem  elever som fått eller skulle ha fått betyg enligt det mål- och kunskapsrelaterade betygssystemet (elever som saknar godkänt betyg i alla ämnen ingår). Med lägeskommun avses elever i kommunala och fristående skolor i kommunen oberoende av var de är folkbokförda. 2016 exkluderades elever med okänd bakgrund. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-18T06:52:48.073135"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:39:48.305301"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der har opnået videnskravene i alle fag, kommune, procentdel (%) (N15418)"},{"@language":"en","@value":"Students in grade 9 who have achieved the knowledge requirements in all subjects, municipality of location, percentage (%) (N15418)"},{"@language":"sv","@value":"Elever i åk 9 som uppnått kunskapskraven i alla ämnen, lägeskommun, andel (%) (N15418)"}]}],"@id":"urn:source:d322d59761174e5582ec61f08c2de0c21abcb0be06556a54d8df197c4d6ebc24"},{"@graph":[{"@id":"_:d4de74c7f586c7bbc63728aea5e85068e5de7649984e1f8825b65724ab21c7bf_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/b6fe783f-a968-4669-a51c-da88fb80e3e0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/b6fe783f-a968-4669-a51c-da88fb80e3e0/resource/594087a0-dbcf-483d-8e64-1da8d9a099c0"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENER"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Endeligt energiforbrug målt i megawatt-timer (MWh) divideret med antallet af\nindbyggere i kommunen. Henviser til det endelige forbrug, der finder sted i\noffentlige aktiviteter, uanset brændstoftype, inden for det geografiske\nområdes grænser. Kilde:\n\nDen svenske energimyndighed og Statistiska Centralbyrån (via Kolada)\n\n"},{"@language":"en","@value":"Final use of energy measured in megawatt hours (MWh) divided by the number of\ninhabitants in the municipality. Refers to final use that occurs in public\nactivities, regardless of fuel type, within the boundaries of the geographical\narea. Source:\n\nThe Swedish Energy Agency and Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Slutanvändning av energi mätt i megawattimmar (MWh) dividerat med antalet invånare i kommunen. Avser slutanvändning som sker inom offentlig verksamhet, oavsett bränsletyp, inom det geografiska områdets gränser. Källa:  \n  \nEnergimyndigheten och SCB (via Kolada)"}],"dct:identifier":"b6fe783f-a968-4669-a51c-da88fb80e3e0","dct:issued":{"@type":"xsd:date","@value":"2022-12-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:27:40.420909"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d4de74c7f586c7bbc63728aea5e85068e5de7649984e1f8825b65724ab21c7bf_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Endeligt energiforbrug i offentlige aktiviteter inden for det geografiske område, MWh/indbygger"},{"@language":"en","@value":"Final energy use in public activities within the geographical area, MWh/inhabitant"},{"@language":"sv","@value":"Slutanvändning energi inom offentlig verksamhet inom det geografiska området, MWh/inv"}]},{"@id":"https://opendata-api.malmo.se/dataset/b6fe783f-a968-4669-a51c-da88fb80e3e0/resource/594087a0-dbcf-483d-8e64-1da8d9a099c0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N45912"},"dct:description":[{"@language":"da","@value":"Endeligt energiforbrug målt i megawatt-timer (MWh) divideret med antallet af\nindbyggere i kommunen. Henviser til det endelige forbrug, der finder sted i\noffentlige aktiviteter, uanset brændstoftype, inden for det geografiske\nområdes grænser. Kilde:\n\nDen svenske energimyndighed og Statistiska Centralbyrån (via Kolada)\n\n"},{"@language":"en","@value":"Final use of energy measured in megawatt hours (MWh) divided by the number of\ninhabitants in the municipality. Refers to final use that occurs in public\nactivities, regardless of fuel type, within the boundaries of the geographical\narea. Source:\n\nThe Swedish Energy Agency and Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Slutanvändning av energi mätt i megawattimmar (MWh) dividerat med antalet invånare i kommunen. Avser slutanvändning som sker inom offentlig verksamhet, oavsett bränsletyp, inom det geografiska områdets gränser. Källa:  \n  \nEnergimyndigheten och SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-14T08:53:07.036390"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:27:40.443759"},"dct:title":[{"@language":"da","@value":"Endeligt energiforbrug i offentlige aktiviteter inden for det geografiske område, MWh/indbygger"},{"@language":"en","@value":"Final energy use in public activities within the geographical area, MWh/inhabitant"},{"@language":"sv","@value":"Slutanvändning energi inom offentlig verksamhet inom det geografiska området, MWh/inv"}]}],"@id":"urn:source:d4de74c7f586c7bbc63728aea5e85068e5de7649984e1f8825b65724ab21c7bf"},{"@graph":[{"@id":"_:d56a8036b91c201250a3cb548f1fe540f67407d8920b7c9926670539be7168d1_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/e0c53853-fe07-4175-9ba0-f496e474fec3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/e0c53853-fe07-4175-9ba0-f496e474fec3/resource/e6bd50f5-1fae-4dd7-b61d-8de4e98076d1"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til æstetikuddannelsen, divideret\nmed antallet af elever, der fik eller ville have fået en karakter i mindst ét\n​​fag i henhold til det mål- og vidensrelaterede karaktersystem i 9. klasse.\n\nStatistik i procenter fra 2011.\n\nBegrebet \"lokationskommune\" henviser til elever på skoler beliggende i\nkommunen, uanset deres folkeregistreringssted.\n\nOplysningerne refererer til skoleåret. Hvis det samlede antal elever er 40\neller mere, og antallet af IKKE-berettigede elever er 1-4 elever, vises\nprocentdelen af ​​berettigede elever som 95 procent. I 2016 blev elever med\nukendt baggrund udelukket.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the aesthetics program\ndivided by the number of students who received or would have received a grade\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9.\n\nStatistics in percentages from 2011.\n\nThe term \"location municipality\" refers to students in schools located in the\nmunicipality, regardless of their place of population registration.\n\nThe information refers to the school year. If the total number of students is\n40 or more and the number of NOT eligible students is 1-4 students, the\npercentage of eligible students is shown as 95 percent. In 2016, students with\nunknown backgrounds were excluded.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till estetiska programmet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. \n\nStatistik i procent från 2011.\n\nMed lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort. \n\nUppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. 2016 exkluderades elever med okänd bakgrund. \n\nKälla: Skolverket (Siris)."}],"dct:identifier":"e0c53853-fe07-4175-9ba0-f496e474fec3","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:17:29.066796"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d56a8036b91c201250a3cb548f1fe540f67407d8920b7c9926670539be7168d1_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til det æstetiske program, placeringskommune"},{"@language":"en","@value":"Students in grade 9 who are eligible for the aesthetic program, location municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som är behöriga till estetiska programmet, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/e0c53853-fe07-4175-9ba0-f496e474fec3/resource/e6bd50f5-1fae-4dd7-b61d-8de4e98076d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15423"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til det æstetiske program,\ndivideret med antallet af elever, der modtog eller ville have modtaget\nkarakterer i mindst ét ​​fag i henhold til det mål- og vidensrelaterede\nkaraktersystem i 9. klasse. Kommunen, hvor eleverne bor, refererer til elever\npå skoler i kommunen, uanset folkeregistreringssted. Dataene refererer til\nskoleåret. Hvis det samlede antal elever er 40 eller flere, og antallet af\nIKKE-berettigede er 1-4 elever, vises procentdelen af ​​berettigede elever som\n95 procent. I 2016 blev elever med ukendt baggrund ekskluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the aesthetic program\ndivided by the number of students who received or would have received grades\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9. The municipality of location refers to students in schools\nlocated in the municipality regardless of the place of population\nregistration. The data refers to the academic year. If the total number of\nstudents is 40 or more and the number of NOT eligible is 1-4 students, the\npercentage of eligible students is shown as 95 percent. In 2016, students with\nunknown backgrounds were excluded. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till estetiska programmet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Med lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort. Uppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. 2016 exkluderades elever med okänd bakgrund. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-18T05:44:14.304074"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:17:29.071505"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til det æstetiske program, placering, kommune, procentdel (%) (N15423)"},{"@language":"en","@value":"Students in year 9 who are eligible for the aesthetic program, location municipality, percentage (%) (N15423)"},{"@language":"sv","@value":"Elever i år 9 som är behöriga till estetiska programmet, lägeskommun, andel (%) (N15423)"}]}],"@id":"urn:source:d56a8036b91c201250a3cb548f1fe540f67407d8920b7c9926670539be7168d1"},{"@graph":[{"@id":"_:d67f8c90c4928eb7020a692bf2e1b492d9c6b68f5e09a8bd06ba1a865641e003_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"17b2b5c66b2b63c0e45ebe66cf038870"},{"@id":"_:d67f8c90c4928eb7020a692bf2e1b492d9c6b68f5e09a8bd06ba1a865641e003_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://lankadedata.se/spec/public-toilets/","@type":"dct:Standard"},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/247860ce-9413-405e-ab54-39892cdb0349"},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/81b70be0-1860-467f-bfcc-5bf70d094dd0"},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/dcaba0b6-1da4-4363-b826-538bb39d1581"}],"dcat:keyword":["Malmö stad","restroom","toalett","toilet","wc"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://lankadedata.se/spec/public-toilets/"},"dct:description":[{"@language":"da","@value":"Dette datasæt indeholder offentlige toiletter, der forvaltes af Malmø by.\n\n**Attribut**\n\n  * `source` [organisationsnummer for forvaltningsmyndighed]\n  * `name` [navn på offentligt toilet]\n  * `description` [kort beskrivelse]\n  * `id` [identifikator for det offentlige toilet]\n  * `opens` [åbningstid]\n  * `closes` [lukketid]\n  * `service` [vedligeholdelsesfrekvens]\n  * `fee` [gebyr]\n  * `rwc` [tilgængelig]\n  * `amenities` [eksisterende faciliteter]\n  * `street` [gadeadresse]\n  * `postalcode` [postnummer]\n  * `city` [postby]\n  * `phone` [telefonnummer til spørgsmål, kommentarer, fejlrapporter]\n  * `email` [e-mailadresse for yderligere kontakt]\n  * `URL` [indgangsside for mere information]\n  * `image` [links til billeder]\n  * `geometry` [type: Punkt, CRS: WGS84]\n\nAttributterne følger i vid udstrækning [Specifikationen for offentlige\ntoiletter - version 0.9](https://lankadedata.se/spec/public%2dtoilets/) ,\nudviklet af National Data Workshop. Specifikationens felter for længdegrad og\nbreddegrad er her tilpasset GeoJSONs **geometriattributter** .\n\nMalmø Bys offentlige toiletter kan have varierende åbningstider afhængigt af\nsæsonen, hvilket ikke kan repræsenteres godt i henhold til den nuværende\nspecifikation. Toiletter med varierende åbningstider mangler derfor\ninformation om åbningstider.\n\n"},{"@language":"en","@value":"This dataset contains public toilets managed by the city of Malmö.\n\n**Attribute**\n\n  * `source` [organizational number of managing authority]\n  * `name` [public toilet name]\n  * `description` [short description]\n  * `id` [identifier for the public toilet]\n  * `opens` [opening time]\n  * `closes` [closing time]\n  * `service` [maintenance frequency]\n  * `fee` [fee]\n  * `rwc` [accessible]\n  * `amenities` [existing amenities]\n  * `street` [street address]\n  * `postalcode` [postal code]\n  * `city` ​​[postal town]\n  * `phone` [phone number for questions, comments, bug reports]\n  * `email` [email address for further contact]\n  * `URL` [entry page for more information]\n  * `image` [links to images]\n  * `geometry` [type: Point, CRS: WGS84]\n\nThe attributes largely follow [the Specification for public toilets - version\n0.9](https://lankadedata.se/spec/public%2dtoilets/) , developed by the\nNational Data Workshop. The specification's fields for longitude and latitude\nare here adapted to GeoJSON's **geometry** attributes.\n\nMalmö City's public toilets may have varying opening hours depending on the\nseason, which cannot be represented well according to the current\nspecification. Toilets with varying opening hours therefore lack information\nabout opening hours.\n\n"},{"@language":"sv","@value":"Denna datamängd innehåller offentliga toaletter som förvaltas av Malmö stad.\n\n__Attribut__  \n  \n+ `source` [organisationsnr för förvaltande myndighet]  \n+ `name` [den offentliga toalettens namn]  \n+ `description` [kort beskrivning]  \n+ `id` [identifierare för den offentliga toaletten]  \n+ `opens` [öppningstid]  \n+ `closes` [stängningstid]  \n+ `service` [underhållsfrekvens]  \n+ `fee` [avgiftsbelagd]  \n+ `rwc` [tillgänglighetsanpassad]  \n+ `amenities` [befintliga bekvämligheter]  \n+ `street` [gatuadress]  \n+ `postalcode` [postnummer]  \n+ `city` [postort]  \n+ `phone` [telefonnummer för frågor, synpunkter, felanmälan]  \n+ `email` [e-postadress för vidare kontakt]  \n+ `URL` [ingångssida för mer information]  \n+ `image` [länkar till bilder]  \n+ `geometry` [typ: Point, CRS: WGS84]  \n\nAttributen följer i stort [Specifikation för offentliga toaletter - version 0.9](https://lankadedata.se/spec/public-toilets/), framtagen av Nationell Dataverkstad. Specifikationens fält för longitud, latitud är här anpassade till GeoJSONs __geometry__-attribut.  \n\nMalmö stads offentliga toaletter kan ha varierande öppettider beroende på säsong, vilket inte kan representeras på ett bra sätt enligt nuvarande specifikation. Toaletter med varierande öppettider saknar därför uppgift om öppettid.  "}],"dct:identifier":"82b9290d-bd82-4611-ae28-161f95c71339","dct:issued":{"@type":"xsd:date","@value":"2025-11-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T18:00:22.641210"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d67f8c90c4928eb7020a692bf2e1b492d9c6b68f5e09a8bd06ba1a865641e003_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Offentlige toiletter"},{"@language":"en","@value":"Public toilets"},{"@language":"sv","@value":"Offentliga toaletter"}]},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/247860ce-9413-405e-ab54-39892cdb0349","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/247860ce-9413-405e-ab54-39892cdb0349/download/offentliga_toaletter.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7838"},"dct:description":[{"@language":"da","@value":"Offentlige toiletter\n\n"},{"@language":"en","@value":"Public toilets\n\n"},{"@language":"sv","@value":"Offentliga toaletter"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T09:03:19.380374"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T18:00:09.499378"},"dct:title":[{"@language":"da","@value":"Offentlige toiletter"},{"@language":"en","@value":"Public toilets"},{"@language":"sv","@value":"Offentliga toaletter"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:d67f8c90c4928eb7020a692bf2e1b492d9c6b68f5e09a8bd06ba1a865641e003_b0n0"}},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/81b70be0-1860-467f-bfcc-5bf70d094dd0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/81b70be0-1860-467f-bfcc-5bf70d094dd0/download/offentliga_toaletter.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"31129"},"dct:description":[{"@language":"da","@value":"Offentlige toiletter\n\n"},{"@language":"en","@value":"Public toilets\n\n"},{"@language":"sv","@value":"Offentliga toaletter"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-11-04T13:18:03.712596"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T18:00:16.142712"},"dct:title":[{"@language":"da","@value":"Offentlige toiletter"},{"@language":"en","@value":"Public toilets"},{"@language":"sv","@value":"Offentliga toaletter"}]},{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/dcaba0b6-1da4-4363-b826-538bb39d1581","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/82b9290d-bd82-4611-ae28-161f95c71339/resource/dcaba0b6-1da4-4363-b826-538bb39d1581/download/offentliga_toaletter.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"98304"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"Offentlige toiletter\n\n"},{"@language":"en","@value":"Public toilets\n\n"},{"@language":"sv","@value":"Offentliga toaletter"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T09:03:17.638790"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-11T18:00:22.664051"},"dct:title":[{"@language":"da","@value":"Offentlige toiletter"},{"@language":"en","@value":"Public toilets"},{"@language":"sv","@value":"Offentliga toaletter"}]}],"@id":"urn:source:d67f8c90c4928eb7020a692bf2e1b492d9c6b68f5e09a8bd06ba1