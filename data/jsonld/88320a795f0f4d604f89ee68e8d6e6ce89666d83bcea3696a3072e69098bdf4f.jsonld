@language":"da","@value":"Måleværdier fra sensorer over en måned\n\n"},{"@language":"en","@value":"Measurement values ​​from sensors over a month\n\n"},{"@language":"sv","@value":"Mätvärden från sensorer under en månad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-05-14T09:26:43.068016"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:18:34.875830"},"dct:title":[{"@language":"da","@value":"Jordfugtighedsmålinger 2024-10"},{"@language":"en","@value":"Soil moisture measurements 2024-10"},{"@language":"sv","@value":"Mätvärden markfukt 2024-10"}]},{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/d0d49ed5-f3e6-4392-86c5-d9f7fa9513ea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/d0d49ed5-f3e6-4392-86c5-d9f7fa9513ea/download/matvarden_markfukt_2026_08"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"8384949"},"dct:description":[{"@language":"da","@value":"Måleværdier fra sensorer over en måned\n\n"},{"@language":"en","@value":"Measurement values ​​from sensors over a month\n\n"},{"@language":"sv","@value":"Mätvärden från sensorer under en månad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-09-02T19:38:32.347482"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-08T17:41:31.144715"},"dct:title":[{"@language":"da","@value":"Jordfugtighedsmålinger 2026-08"},{"@language":"en","@value":"Soil moisture measurements 2026-08"},{"@language":"sv","@value":"Mätvärden markfukt 2026-08"}]},{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/d7f3fae