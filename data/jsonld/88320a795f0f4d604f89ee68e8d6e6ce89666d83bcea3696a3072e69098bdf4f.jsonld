sv","@value":"Mätvärden från sensorer under en månad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-02T19:38:31.318911"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-02T19:38:32.307043"},"dct:title":[{"@language":"da","@value":"Jordfugtighedsmålinger 2026-07"},{"@language":"en","@value":"Soil moisture measurements 2026-07"},{"@language":"sv","@value":"Mätvärden markfukt 2026-07"}]},{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/eb88d542-abec-46ed-a288-03ca7872a64c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/eb88d542-abec-46ed-a288-03ca7872a64c/download/matvarden_markfukt_2026_09"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7600839"},"dct:description":[{"@language":"da","@value":"Måleværdier fra sensorer over en måned\n\n"},{"@language":"en","@value":"Measurement values ​​from sensors over a month\n\n"},{"@language":"sv","@value":"Mätvärden från sensorer under en månad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-10-02T19:38:36.206448"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-02T19:38:36.186667"},"dct:title":[{"@language":"da","@value":"Jordfugtighedsmålinger 2026-09"},{"@language":"en","@value":"Soil moisture measurements 2026-09"},{"@language":"sv","@value":"Mätvärden markfukt 2026-09"}]}],"@id":"urn:source:8cd5c8d0a84a24afdb1a832881990183f9f53e8c5fe288913d7f097e576573ed"},{"@graph":[{"@id":"_:8d28d94a8f5c50980e5ca5776bb8655374d4bc22477546f1edb3d9629abb6b41_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"82f65df5b5248d73765e2a532dd7431c"},{"@id":"_:8d28d94a8f5c50980e5ca5776bb8655374d4bc22477546f1edb3d9629abb6b41_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1/resource/39fcfc26-97f5-4a42-a934-f9b0015060aa"},{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1/resource/71b9eade-df88-4adc-a91d-7f7ef48b9664"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser i hvilken branche de erhvervsaktive i området arbejder. Opdelingen\nfølger Standarden for svensk brancheklassificering (SNI) 2007. Kategorierne O\n(ukendt), A (landbrug, jagt og skovbrug), B (udvinding af materialer), D\n(forsyning af el, gas, varme og køling), E (vandforsyning mv.), T\n(husholdningsproduktion mv.) og U (aktivitet i internationale organisationer)\ner blevet slået sammen til kategorien \"Andet\" på grund af det lave antal\npersoner, der arbejder i disse brancher. Variablen viser også det samlede\nantal personer, der arbejder i området. Variablen er opdelt efter køn. Den\nvises for befolkningen i alderen 16-74 år. Den er baseret på statistik fra SCB\nRAMS (\"Registerbaseret arbejdsmarkedsstatistik\"). Statistikken omfatter alle\npersoner mellem 16 og 74 år, der er registreret i Sverige den 31. december.\nFra referenceåret 2019 anvendes en ny datakilde og metode til at klassificere\nerhvervsaktive i RAMS. Der er derfor et tidsseriebrud for denne tidsserie, der\nstarter med data fra 2019. Et stort antal arbejdstagere inden for et område er\nnødvendige for at kunne opdele gruppen i de forskellige SNI-kategorier. SNI-\nkategorierne kan derfor kun rapporteres for nogle få delområder. Fra og med\nreferenceåret 2019 bruger Statistiska Centralen (SCB) en ny datakilde og\nmetode til at klassificere erhvervsaktive personer i RAMS. Ændringen i kilde\nog metode betyder, at sammenligninger af statistikker for 2019 og tidligere\nreferenceår skal foretages med stor forsigtighed. Læs mere på SCB.se\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows in which industry the gainfully employed people working in the area\nwork. The division follows the Standard for Swedish Industrial Classification\n(SNI) 2007. The categories O (unknown), A (agriculture, hunting and forestry),\nB (extraction of materials), D (supply of electricity, gas, heating and\ncooling), E (water supply, etc.), T (household production, etc.) and U\n(activity at international organizations) have been merged into the category\n\"Other\" due to the low number of people working in these industries. The\nvariable also shows the total number of people working in the area. The\nvariable is broken down by gender. It is shown for the population aged 16–74.\nIt is based on statistics from SCB RAMS (\"Register-based labour market\nstatistics\"). The statistics include all individuals between 16 and 74 who are\nregistered in Sweden on 31 December. As of reference year 2019, a new data\nsource and method are used to classify gainfully employed people in RAMS.\nThere is therefore a time series break for this time series starting with data\nfrom 2019. A large number of workers within an area are required to be able to\nbreak down the group into the different SNI categories. The SNI categories can\ntherefore only be reported for a few sub-areas. Starting with reference year\n2019, Statistics Sweden uses a new data source and method to classify\ngainfully employed people in RAMS. The change in source and method means that\ncomparisons of statistics for 2019 and previous reference years must be made\nwith great caution. Read more at SCB.se\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar inom vilken industri de förvärvsarbetande som arbetar inom området arbetar. Uppdelningen följer Standard för svensk näringsgrensindelning (SNI) 2007. Kategorierna O (okänd), A (jordbruk, jakt och skogsbruk), B (utvinning av material), D (försörjning av el, gas, värme och kyla), E (vattenförsörjning m.m.), T (hushållens produktion med mera) och U (verksamhet vid internationella organisationer) har slagits ihop till kategorin ”Övriga” på grund av det låga antalet arbetande i dessa industrier. Variabeln visar även totalt antalet som arbetar i området. Variabeln finns uppdelad på kön. Visas för befolkningen 16–74 år. Bygger på statistik från SCB RAMS (”Registerbaserad arbetsmarknadsstatistik”). I statistiken ingår samtliga individer mellan 16 och 74 som är folkbokförda i Sverige den 31 december. Från och med referensår 2019 används en ny datakälla och metod för att klassificera förvärvsarbetande i RAMS. Det sker därför ett tidsseriebrott för denna tidsserie med start med data från 2019. Det krävs ett stort antal arbetande inom ett område för att kunna bryta ner gruppen i de olika SNI-kategorierna. SNI-kategorierna kan därför bara redovisas för ett fåtal delområden. Från och med referensår 2019 använder SCB en ny datakälla och metod för att klassificera förvärvsarbetande i RAMS. Bytet av källa och metod innebär att jämförelser av statistik avseende 2019 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se\n\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"73a8b10d-3f7c-49c5-b917-2dff38eaddf1","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:42.062022"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:8d28d94a8f5c50980e5ca5776bb8655374d4bc22477546f1edb3d9629abb6b41_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) ifølge SNI 2007, 2019-2021 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Daytime population (number of workplaces) according to SNI 2007, 2019 - 2021 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2019 - 2021 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1/resource/39fcfc26-97f5-4a42-a934-f9b0015060aa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=71b9eade-df88-4adc-a91d-7f7ef48b9664"},"dct:description":[{"@language":"da","@value":"Malmø-statistik - Dagbefolkning (antal arbejdspladser) efter SNI 2007,\n2019-2021\n\n"},{"@language":"en","@value":"Malmö statistics - Daytime population (number of workplaces) by SNI 2007, 2019\n- 2021\n\n"},{"@language":"sv","@value":"Malmö statistik - Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2019 - 2021"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:55:51.170367"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-01T11:09:22.441102"},"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) efter SNI 2007, 2019-2021"},{"@language":"en","@value":"Daytime population (number of workplaces) by SNI 2007, 2019 - 2021"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2019 - 2021"}]},{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1/resource/71b9eade-df88-4adc-a91d-7f7ef48b9664","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/73a8b10d-3f7c-49c5-b917-2dff38eaddf1/resource/71b9eade-df88-4adc-a91d-7f7ef48b9664/download/dagbefolkning-antal-arbetsplatser-efter-sni-2007-2019-2021.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2878925"},"dct:description":[{"@language":"da","@value":"Malmø-statistik - Dagbefolkning (antal arbejdspladser) efter SNI 2007,\n2019-2021\n\n"},{"@language":"en","@value":"Malmö statistics - Daytime population (number of workplaces) by SNI 2007, 2019\n- 2021\n\n"},{"@language":"sv","@value":"Malmö statistik - Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2019 - 2021"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:55:50.418446"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:42.068606"},"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) efter SNI 2007, 2019-2021"},{"@language":"en","@value":"Daytime population (number of workplaces) by SNI 2007, 2019 - 2021"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2019 - 2021"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:8d28d94a8f5c50980e5ca5776bb8655374d4bc22477546f1edb3d9629abb6b41_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:8d28d94a8f5c50980e5ca5776bb8655374d4bc22477546f1edb3d9629abb6b41"},{"@graph":[{"@id":"_:8dd95b5645ecbe4ef92b42144a18282736f85b8846012d147c26a50b6211239e_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d88e356f-c6e2-41e8-aa7a-cd39669ba823","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/d88e356f-c6e2-41e8-aa7a-cd39669ba823/resource/e23cf623-f2ac-4e3c-9c4b-c2549cc202e0"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem samlede nettoomkostninger og samlede\nreferenceomkostninger for førskole, fritidshjem, grundskole, gymnasium,\nindividuel og familiepleje samt ældrepleje, SEK pr. indbygger.\n\nI 2015 blev førskole- og skolepasning erstattet af førskole- og SFO-pasning\n(dvs. eksklusive pædagogisk pasning).\n\nNettoomkostninger er bruttoomkostninger minus bruttoomsætning.\nReferenceomkostningerne er baseret på nettoomkostninger og strukturelle\nvariabler for det indeværende år. Se nettoomkostningsvarians for hvert\nforretningsområde for information om, hvilke variabler der er inkluderet i\nberegningen.\n\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier indikerer en lavere omkostningssituation end\nstatistisk forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR\n\n"},{"@language":"en","@value":"Deviation in percentage between total net cost and total reference cost for\npreschool, after-school care, compulsory school, upper secondary school,\nindividual and family care and care for the elderly, SEK per inhabitant.\n\nIn 2015, preschool and school childcare were replaced with preschool and\nafter-school care (i.e. excluding educational care).\n\nNet cost is gross cost minus gross revenue. The reference cost is based on net\ncosts and structural variables for the current year. See net cost variance for\neach business area for information on which variables are included in the\ncalculation.\n\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​indicate a lower cost situation than statistically\nexpected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan total nettokostnad och total referenskostnad för förskola, fritidshem, grundskola, gymnasieskola, individ- och familjeomsorg och vård och omsorg om äldre, kronor per invånare. \n\nÅr 2015 ersattes förskola och skolbarnomsorg med förskola och fritidshem (det vill säga exklusive pedagogisk omsorg). \n\nNettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnader och strukturvariabler för det aktuella året. Se nettokostnadsavvikelse för respektive verksamhetsområde för information om vilka variabler som ingår i beräkningen.\n\nPositiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. \n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR"}],"dct:identifier":"d88e356f-c6e2-41e8-aa7a-cd39669ba823","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:45:59.950749"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:8dd95b5645ecbe4ef92b42144a18282736f85b8846012d147c26a50b6211239e_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Samlet nettoomkostningsafvigelse (eksklusive LSS), procent"},{"@language":"en","@value":"Total net cost variance (excluding LSS), percent"},{"@language":"sv","@value":"Nettokostnadsavvikelse totalt (exklusive LSS), procent"}]},{"@id":"https://opendata-api.malmo.se/dataset/d88e356f-c6e2-41e8-aa7a-cd39669ba823/resource/e23cf623-f2ac-4e3c-9c4b-c2549cc202e0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N00097"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem samlede nettoomkostninger og samlede\nreferenceomkostninger for førskole, fritidshjem, grundskole, gymnasium,\nindividuel og familiepleje samt ældrepleje, SEK pr. indbygger.\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Deviation in percentage between total net cost and total reference cost for\npreschool, after-school care, compulsory school, upper secondary school,\nindividual and family care and care for the elderly, SEK per inhabitant.\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan total nettokostnad och total referenskostnad för förskola, fritidshem, grundskola, gymnasieskola, individ- och familjeomsorg och vård och omsorg om äldre, kronor per invånare.\n\nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-06-07T08:02:36.022173"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:45:59.978480"},"dct:title":[{"@language":"da","@value":"Samlet nettoomkostningsafvigelse (ekskl. LSS), andel (%) (N00097)"},{"@language":"en","@value":"Total net cost variance (excl. LSS), share (%) (N00097)"},{"@language":"sv","@value":"Nettokostnadsavvikelse totalt (exkl. LSS), andel (%) (N00097)"}]}],"@id":"urn:source:8dd95b5645ecbe4ef92b42144a18282736f85b8846012d147c26a50b6211239e"},{"@graph":[{"@id":"_:922b73a3b85b57692a9d2ec93445ee58791d25621a124e8ef4d8887498cf5303_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"ad5f62d52b9745ea9429884d1944db79"},{"@id":"_:922b73a3b85b57692a9d2ec93445ee58791d25621a124e8ef4d8887498cf5303_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160/resource/040a16e4-eb33-46e2-bb03-dcb351389434"},{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160/resource/8f3f8c7d-0dec-44a4-ad3f-f5c9ea805575"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Vises som et gennemsnit af den årlige indkomst for beboere i området. Består\naf summen af ​​al skattepligtig og skattefri indkomst fratrukket skat og andre\nnegative overførsler. Den skattepligtige indkomst består blandt andet af:\nlønindkomst, indkomst fra erhvervsaktivitet, kapitalindkomst, pension,\nsygedagpenge, sygedagpenge i særlige tilfælde, fast indkomst, boligtillæg,\narbejdsmarkedsstøtte, forældreydelse og syge- og aktivitetskompensation.\nSkattefri indkomst består blandt andet af: boligstøtte, børnetilskud,\nstudiestøtte inkl. studielån, økonomisk bistand og underholdsbidrag (fra\nIndkomstregisteret 2013). Negative overførsler består blandt andet af: skat,\ntilbagebetaling af studielån og udbetalt underholdsbidrag. Udbetalingen følger\n2004-definitionen, som også omfatter bruttokapitalgevinster og -tab. Fra og\nmed data for 2020 er indkomst fra arbejde og pension fra andre nordiske lande\ninkluderet i statistikken. Dette gør sammenligninger tilbage i tiden\nmisvisende, da indkomst fra dem, der pendler til Danmark for at arbejde, ikke\ntidligere har været inkluderet i statistikken. Tallene er vist i løbende\npriser, hvilket betyder, at de ikke er inflationsjusteret. Det skal\nunderstreges, at disponibel indkomst ikke giver et mål for økonomisk velfærd i\nbred forstand. Uden for målingerne ligger blandt andet egenproduktion i\nhjemmene, fordelen ved offentligt forbrug og eventuel \"sort\" indkomst. Fra\n2012 er introduktionsgodtgørelsen udeladt af opgørelsen af ​​økonomisk\nbistand. Bemærk, at denne variabel vises for befolkningen i alle aldre. Den\nvises som et gennemsnit af den årlige indkomst for området. Variablen er\nopdelt efter køn. Data fra Indkomst- og Skatteregisteret (IoT).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'en**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald for at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows as an average of the annual income for residents in the area. Consists\nof the sum of all taxable and tax-free income minus tax and other negative\ntransfers. Taxable income consists of, among other things: wage income, income\nfrom business activities, income from capital, pension, sickness benefit,\nsickness benefit in special cases, flat-rate income, housing supplement,\nlabour market support, parental benefit and sickness and activity\ncompensation. Tax-free income consists of, among other things: housing\nallowance, child allowance, student aid incl. student loans, financial\nassistance and maintenance allowance (from the Incomes Register 2013).\nNegative transfers consist of, among other things: tax, repayment of student\nloans and maintenance allowance paid. The withdrawal follows the 2004\ndefinition, which also includes gross capital gains and capital losses. As of\ndata for 2020, income from work and pension from other Nordic countries is\nincluded in the statistics. This makes comparisons back in time misleading as\nincome from those who commute to Denmark for work has not previously been\nincluded in the statistics. The figures are shown in current prices, which\nmeans that they are not adjusted for inflation. It should be emphasized that\ndisposable income does not provide a measure of economic welfare in the broad\nsense. Outside the measurements are, among other things, own production in\nhomes, the benefit of public consumption and any \"black\" income. From 2012,\nthe introduction allowance is excluded from the accounting of financial\nassistance. Note that this variable is shown for the population of all ages.\nIt is shown as an average of the annual income for the area. The variable is\nbroken down by gender. Data from the Income and Tax Register (IoT).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar som ett genomsnitt av årsinkomsten för boende i området. Består av summan av alla skattepliktiga och skattefria inkomster minus skatt och övriga negativa transfereringar. Skattepliktiga inkomster består bland annat av: löneinkomst, inkomst från näringsverksamhet, inkomst av kapital, pension, sjukpenning, sjukpenning i särskilda fall, schablonintäkter, boendetillägg, arbetsmarknadsstöd, föräldrapenning och sjuk- och aktivitetsersättning. Skattefria inkomster består bland annat av: bostadsbidrag, barnbidrag, studiestöd inkl. studielån, ekonomiskt bistånd och underhållsbidrag (fr.o.m. inkomstregistret 2013). Negativa transfereringar består bland annat av: skatt, återbetalning av studielån och utbetalt underhållsbidrag. Uttaget följer 2004 års definition vilket även inkluderar kapitalvinster och kapitalförluster brutto. Från och med data för 2020 ingår inkomster från arbete och pension från övriga nordiska länder i statistiken. Detta gör att jämförelser bakåt i tiden blir missvisande då inkomster från de som arbetspendlar till Danmark tidigare inte ingått i statistiken. Siffrorna visas i löpande priser vilket betyder att de inte är inflationsjusterade. Det bör understrykas att disponibel inkomst inte ger ett mått av ekonomisk välfärd i vid mening. Utanför mätningarna ligger bland annat egen produktion i hemmen, nyttan av offentlig konsumtion samt eventuella \"svarta\" inkomster. Från och med 2012 exkluderas introduktionsersättningen ur redovisningen av ekonomiskt bistånd. Notera att denna variabel visas för befolkningen i alla åldrar.  Visas som ett genomsnitt av årsinkomsten för området. Variabeln finns uppdelad på kön. Data från Inkomst- och taxeringsregistret (IoT).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"9e894366-4d3f-47bb-8b9d-fe49d68b0160","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:07:09.761217"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:922b73a3b85b57692a9d2ec93445ee58791d25621a124e8ef4d8887498cf5303_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Disponibel indkomst 2020- - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Disposable income 2020- - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Disponibel inkomst 2020- - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160/resource/040a16e4-eb33-46e2-bb03-dcb351389434","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=8f3f8c7d-0dec-44a4-ad3f-f5c9ea805575"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Disponibel indkomst 2020-\n\n"},{"@language":"en","@value":"Malmö statistics - Disposable income 2020-\n\n"},{"@language":"sv","@value":"Malmö statistik - Disponibel inkomst 2020-"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:28.467043"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:32.742047"},"dct:title":[{"@language":"da","@value":"Disponibel indkomst 2020-"},{"@language":"en","@value":"Disposable income 2020-"},{"@language":"sv","@value":"Disponibel inkomst 2020-"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160/resource/8f3f8c7d-0dec-44a4-ad3f-f5c9ea805575","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/9e894366-4d3f-47bb-8b9d-fe49d68b0160/resource/8f3f8c7d-0dec-44a4-ad3f-f5c9ea805575/download/disponibel-inkomst-2020-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"205830"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Disponibel indkomst 2020-\n\n"},{"@language":"en","@value":"Malmö statistics - Disposable income 2020-\n\n"},{"@language":"sv","@value":"Malmö statistik - Disponibel inkomst 2020-"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:23.757389"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:07:09.767094"},"dct:title":[{"@language":"da","@value":"Disponibel indkomst 2020-"},{"@language":"en","@value":"Disposable income 2020-"},{"@language":"sv","@value":"Disponibel inkomst 2020-"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:922b73a3b85b57692a9d2ec93445ee58791d25621a124e8ef4d8887498cf5303_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:922b73a3b85b57692a9d2ec93445ee58791d25621a124e8ef4d8887498cf5303"},{"@graph":[{"@id":"_:924d3c09b0815a9f356bfda7729099dbdfc80e71a45bbaef686d909fa4c2c74a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/4bc0a377-29f3-4bf6-94f2-a1ff243413a2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/4bc0a377-29f3-4bf6-94f2-a1ff243413a2/resource/7d61594a-386d-45ac-94cc-9ef203ffebaf"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i T-1, der var registreret i kommunen, som havde afsluttet\ngymnasiet, og som i T-1 var etableret på arbejdsmarkedet eller under\nuddannelse (inklusive introduktionsprogrammet IM). Dette tal er divideret med\nantallet af elever i T-1, der var registreret i kommunen, som havde afsluttet\ngymnasiet (inklusive IM).\n\n**Etableret på arbejdsmarkedet, er det**  \n_hvem er ansat i henhold til definitionen i beskæftigelsesregistret (november)  \n_ ikke har nogen hændelser, der indikerer arbejdsløshed eller\narbejdsmarkedspolitiske foranstaltninger, der ikke betragtes som beskæftigelse  \n* og har haft en indkomst, der ikke er under en grænse, der er forskellig for hvert år afhængigt af den gennemsnitlige procentvise lønvækst.\n\nI 2016 var grænsen for at blive betragtet som etableret på arbejdsmarkedet\n191.800 SEK.\n\nStuderende refererer til både universitetsstudier og anden uddannelse, der er\nberettiget til studiestøtte, såsom Komvux eller højskoler.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of students in year T-1 who were registered in the municipality, who\nhad completed upper secondary school, and who in year T were established in\nthe labour market or studying (including the Introduction Program IM). This\nnumber has been divided by the number of students in year T-1 who were\nregistered in the municipality, who had completed upper secondary school,\n(including IM).\n\n**Established in the labor market, it is**  \n_who is employed according to the definition of the employment register\n(November)  \n_ does not have any events that indicate unemployment or labor market policy\nmeasures that are not considered employment  \n* and have had an income that is not below a limit that is different for each year depending on the average percentage wage growth.\n\nIn 2016, the limit for being considered established in the labor market was\nSEK 191,800.\n\nStudents refer to both university studies and other education eligible for\nstudy grants, such as Komvux or folk high schools.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal elever år T-1 som var folkbokförda i kommunen, som avslutat gymnasium, , och som år T var etablerade på arbetsmarknaden eller studerade (inklusive Introduktionsprogrammet IM). Detta antal har dividerats med antal elever år T-1 som var folkbokförda i kommunen, som avslutat gymnasium, (inklusive IM). \n\n__Etablerad på arbetsmarknaden är den__  \n* som är sysselsatt enligt sysselsättningsregistrets definition (november månad)  \n* inte har några händelser som indikerar arbetslöshet eller  arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning   \n* samt har haft en arbetsinkomst som inte understiger en gräns som är olika för varje år beroende på den genomsnittliga procentuella löneutvecklingen.  \n\nÅr 2016 var gränsen för att räknas som etablerad på arbetsmarknaden 191 800 kr. \n\nStuderande avser både högskolestudier och annan studiemedelsberättigad utbildning som exempelvis Komvux eller folkhögskola. \n\nKälla: SCB."}],"dct:identifier":"4bc0a377-29f3-4bf6-94f2-a1ff243413a2","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:01:33.495468"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:924d3c09b0815a9f356bfda7729099dbdfc80e71a45bbaef686d909fa4c2c74a_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Unge, der er etableret på arbejdsmarkedet eller studerer 1 år efter endt ungdomsuddannelse"},{"@language":"en","@value":"Young people who are established in the labor market or studying 1 year after completing upper secondary education"},{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden eller studerar 1 år efter fullföljd gymnasieutbildning"}]},{"@id":"https://opendata-api.malmo.se/dataset/4bc0a377-29f3-4bf6-94f2-a1ff243413a2/resource/7d61594a-386d-45ac-94cc-9ef203ffebaf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17524"},"dct:description":[{"@language":"da","@value":"Antal elever i klassetrin T-1, der var registreret i kommunen som havende\nafsluttet gymnasiet, som i klassetrin T var etableret på arbejdsmarkedet eller\nunder uddannelse, inkl. IM, divideret med antallet af elever i klassetrin T-1,\nder var registreret i kommunen som havende afsluttet gymnasiet, inkl. IM.\nEtableret på arbejdsmarkedet er en person, der er i beskæftigelse i henhold\ntil definitionen i beskæftigelsesregistret (november), ikke har haft nogen\nbegivenheder, der indikerer arbejdsløshed eller arbejdsmarkedspolitiske\nforanstaltninger, der ikke skal betragtes som beskæftigelse, og har haft en\nindkomst, der ikke er under en grænse, der er forskellig for hvert år\nafhængigt af den gennemsnitlige procentvise lønvækst. I 2016 var grænsen for\nat blive betragtet som etableret på arbejdsmarkedet 191.800 SEK. Studerende\nrefererer til både universitetsstudier og anden uddannelse, der er berettiget\ntil studiestøtte, såsom kommunal voksenuddannelse eller højskole. Kilde:\nKolada\n\n"},{"@language":"en","@value":"Number of students in year T-1 who were registered in the municipality as\nhaving completed upper secondary school, who in year T were established in the\nlabour market or studying, incl. IM divided by the number of students in year\nT-1 who were registered in the municipality as having completed upper\nsecondary school, incl. IM. Established in the labour market is someone who is\nemployed according to the definition of the employment register (November),\nhas not had any events that indicate unemployment or labour market policy\nmeasures that are not to be considered employment and has had an income that\nis not below a limit that is different for each year depending on the average\npercentage wage growth. In 2016, the limit for being considered established in\nthe labour market was SEK 191,800. Students refer to both university studies\nand other education eligible for study grants, such as municipal adult\neducation or folk high school. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever år T-1 som var folkbokförda i kommunen som avslutat gymnasium , som år T var etablerade på arbetsmarknaden eller studerade, inkl. IM dividerat med antal elever år T-1 som var folkbokförda i kommunen som avslutat gymnasium, inkl. IM. Etablerad på arbetsmarknaden är den som är sysselsatt enligt sysselsättningsregistrets definition (november månad), inte har några händelser som indikerar arbetslöshet eller arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning samt har haft en arbetsinkomst som inte understiger en gräns som är olika för varje år beroende på den genomsnittliga procentuella löneutvecklingen. År 2016 var gränsen för att räknas som etablerad på arbetsmarknaden 191 800 kr. Studerande avser både högskolestudier och annan studiemedelsberättigad utbildning som t.ex. komvux eller folkhögskola. Källa: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-15T07:24:19.590231"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:01:33.519828"},"dct:title":[{"@language":"da","@value":"Unge, der er etableret på arbejdsmarkedet eller studerer 1 år efter endt gymnasial uddannelse, bopælskommune, andel (%) (N17524)"},{"@language":"en","@value":"Young people who are established in the labor market or studying 1 year after completing upper secondary education, municipality of residence, share (%) (N17524)"},{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden eller studerar 1 år efter fullföljd gymnasieutbildning, hemkommun, andel (%) (N17524)"}]}],"@id":"urn:source:924d3c09b0815a9f356bfda7729099dbdfc80e71a45bbaef686d909fa4c2c74a"},{"@graph":[{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"1a0dac7e67e1561dcdb7a07f7eaf86b5"},{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b2n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1994-01-01"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/4f35858d-3afd-49fb-a4a8-224313899b00"},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/65f64cdd-e8b3-4df8-b6a0-c96a51c8d335"},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/df979cde-894c-4b08-a576-0cd0a30ea58d"}],"dcat:keyword":["Malmö stad","geodata","gis","karta","map","trafik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"**Cykelstrømme i Malmø**  \nFormålet med denne trafikmængdeopgørelse er at rapportere den aktuelle\ntrafikmængde for knallert- og cykeltrafik i Malmø. Samtidig bør ændringerne\nvære letlæselige, da data om trafikmængder er tilgængelige fra 1994 og\nfremefter.\n\nDet er vigtigt at huske på, at der er faktorer, der kan påvirke\nmåleresultaterne, når man studerer trafikdata, især når kun én dag tælles\n(f.eks. vejarbejde, større ombygninger, vejr).  \nDer er kun ét datapunkt fra 2020 på grund af COVID-19-pandemien.\nTrafikstrømmene fra 2021 har også vist sig at være påvirket af pandemien.\n\nRapporten er et uddrag samlet fra Ejendoms- og Vejkontorets trafikdatabase,\nhvor målte trafikmængder løbende er blevet lagret hvert år.\n\n**Attribut**\n\n  * `pg_id` [unik identifikator for hvert målested]\n  * `pg_nummer` [identifikator for målepunktets position]\n  * `gatunamn` [gade hvor målingen blev udført]\n  * `delsträcka` [position hvor målingen blev udført]\n  * `punkt_uppdaterat` [seneste opdatering af målepunktsdata og/eller geometri]\n  * `year` [måleår]\n  * `vardagsdygn` [trafik på hverdage¹]\n  * `stats_uppdaterat` [seneste opdatering af statistiske værdier; kan være en justering af tidligere offentliggjorte tal eller nye tal]\n  * `geometry` [type: MultiLineString, CRS: WGS84]\n  * `timestamp` [dato for sidste opdatering af trafikmålingsobjekter]\n\n¹ Trafiktællinger udføres i løbet af efteråret og foråret, tirsdage, onsdage\neller torsdage mellem kl. 06-09 og 15-18. Antallet af knallerter, scootere og\ncykler tælles i begge retninger. Ved hjælp af et koefficientsystem omregnes\nværdierne til _hverdagstrafik_ , hvilket betyder, at værdierne indeholder en\nvis usikkerhed.\n\n"},{"@language":"en","@value":"**Bicycle flows in Malmö**  \nThe purpose of this traffic volume compilation is to report current moped and\nbicycle traffic volumes in Malmö. At the same time, changes should be easily\nreadable since data on traffic volumes is available from 1994 onwards.\n\nIt is important to keep in mind that there are factors that can affect the\nmeasurement results when studying traffic data, especially when only one day\nis counted (e.g. road works, major reconstruction, weather).  \nThere is only one data point from 2020 due to the COVID-19 pandemic. Traffic\nflows from 2021 have also been shown to be affected by the pandemic.\n\nThe report is an excerpt compiled from the Property and Street Office's\ntraffic database in which measured traffic volumes have been continuously\nstored each year.\n\n**Attribute**\n\n  * `pg_id` [unique identifier for each measurement site]\n  * `pg_nummer` [identifier for the measurement point position]\n  * `gatunamn` [street where measurement was carried out]\n  * `delsträcka` [position where the measurement was carried out]\n  * `punkt_uppdaterat` [latest update of measurement point data and/or geometry]\n  * `year` [year of measurement]\n  * `vardagsdygn` [weekday traffic¹]\n  * `stats_uppdaterat` [latest update of statistical values; may be an adjustment to previously published figures or new figures]\n  * `geometry` [type: MultiLineString, CRS: WGS84]\n  * `timestamp` [last update date of traffic measurement objects]\n\n¹ Traffic counts are carried out during autumn and spring, on a Tuesday,\nWednesday or Thursday between 06-09 and 15-18. The number of mopeds, scooters\nand bicycles is counted in both directions. Using a coefficient system, the\nvalues ​​are converted to _Weekday Traffic_ , which means that the values\n​​contain a certain uncertainty.\n\n"},{"@language":"sv","@value":"__Cykelflöden i Malmö__  \nSyftet med denna trafikmängdssammanställning är att redovisa aktuella moped- och cykeltrafikmängder i Malmö. Samtidigt ska förändringar på ett enkelt sätt kunna avläsas eftersom uppgifter om trafikmängder finns från och med år 1994.  \n\nDet är viktigt att tänka på att det finns faktorer som kan ha inverkan på mätresultaten när trafikuppgifter studeras, speciellt då det endast är en dag som räknas (t.ex. vägarbete, större ombyggnation, väder).  \nDet finns bara en datapunkt från år 2020 på grund av COVID-19 pandemin. Även trafikflöden från år 2021 har visat sig påverkade av pandemin.  \n  \nRapporten är ett utdrag sammanställt ur Fastighet- och gatukontorets trafikdatabas i vilken uppmätta trafikmängder kontinuerligt har lagrats varje år.  \n  \n__Attribut__  \n  \n+ `pg_id` [unik identifierare för varje mätplats]  \n+ `pg_nummer` [identifierare för mätpunktens position]  \n+ `gatunamn` [gata där mätning genomförts]  \n+ `delsträcka` [position där mätningen genomförts]  \n+ `punkt_uppdaterat` [senaste uppdatering av mätpunktsuppgifter och/eller geometri]  \n+ `year` [mätår]  \n+ `vardagsdygn` [vardagsdygnstrafik¹]  \n+ `stats_uppdaterat` [senaste uppdatering av statistikvärden; kan vara en justering av tidigare publicerade siffror eller nya siffror]  \n+ `geometry` [typ: MultiLineString, CRS: WGS84]  \n+ `timestamp` [trafikmätningsobjektens senaste uppdateringsdatum]  \n  \n¹ Trafikräkningarna utförs under höst och vår, på en tisdag, onsdag eller torsdag mellan kl. 06-09 och kl. 15-18. Antalet mopeder, sparkcyklar och cyklar räknas i båda riktningarna. Med hjälp av ett koefficientsystem räknas värdena om till *Vardagsdygnstrafik*, vilket betyder att värdena innehåller en viss osäkerhet.  "}],"dct:identifier":"00b1590e-a504-4c55-a7f2-3d6fd659d982","dct:issued":{"@type":"xsd:date","@value":"2024-03-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-07T02:01:36.312809"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:temporal":{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b2n0"},"dct:title":[{"@language":"da","@value":"Trafikmåling for cykler"},{"@language":"en","@value":"Traffic measurement for bicycles"},{"@language":"sv","@value":"Trafikmätning för cykel"}]},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/4f35858d-3afd-49fb-a4a8-224313899b00","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/4f35858d-3afd-49fb-a4a8-224313899b00/download/trafikmatning_for_cykel.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"890034"},"dct:description":[{"@language":"da","@value":"Viser målesteder og måleværdier for trafikmålinger\n\n"},{"@language":"en","@value":"Shows measurement locations and measurement values ​​for traffic measurements\n\n"},{"@language":"sv","@value":"Visar mätplatser och mätvärden för trafikmätningar"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T10:11:56.061102"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-07T02:01:36.325155"},"dct:title":[{"@language":"da","@value":"Trafikmåling for cykelmålepunkter"},{"@language":"en","@value":"Traffic measurement for bicycle measuring points"},{"@language":"sv","@value":"Trafikmätning för cykel mätplatser"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9_b0n0"}},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/65f64cdd-e8b3-4df8-b6a0-c96a51c8d335","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/65f64cdd-e8b3-4df8-b6a0-c96a51c8d335/download/trafikmatning_for_cykel.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1171456"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"Viser målesteder og måleværdier for trafikmålinger\n\n"},{"@language":"en","@value":"Shows measurement locations and measurement values ​​for traffic measurements\n\n"},{"@language":"sv","@value":"Visar mätplatser och mätvärden för trafikmätningar"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T10:11:52.257461"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-07T02:01:11.614720"},"dct:title":[{"@language":"da","@value":"Trafikmåling for cykelmålepunkter"},{"@language":"en","@value":"Traffic measurement for bicycle measuring points"},{"@language":"sv","@value":"Trafikmätning för cykel mätplatser"}]},{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/df979cde-894c-4b08-a576-0cd0a30ea58d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/00b1590e-a504-4c55-a7f2-3d6fd659d982/resource/df979cde-894c-4b08-a576-0cd0a30ea58d/download/trafikmatning_for_cykel.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2303772"},"dct:description":[{"@language":"da","@value":"Viser målesteder og måleværdier for trafikmålinger\n\n"},{"@language":"en","@value":"Shows measurement locations and measurement values ​​for traffic measurements\n\n"},{"@language":"sv","@value":"Visar mätplatser och mätvärden för trafikmätningar"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-11-14T06:32:14.748234"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-07T02:01:04.048367"},"dct:title":[{"@language":"da","@value":"Trafikmåling for cykelmålepunkter"},{"@language":"en","@value":"Traffic measurement for bicycle measuring points"},{"@language":"sv","@value":"Trafikmätning för cykel mätplatser"}]}],"@id":"urn:source:925abcc05f89bc67e15324a4281b0ccf230ec52ad68c6f0324a308d180a181a9"},{"@graph":[{"@id":"_:940d3c622f2bea5268935b21d815c1ee7823841713a5e760fcff6199891e4558_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/dbbe5983-d8f7-45f3-b248-0961f52ee82a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/dbbe5983-d8f7-45f3-b248-0961f52ee82a/resource/4e9e0316-d0c6-481b-ac06-661944ea0792"},"dcat:keyword":["Malmö stad","kolada","lön","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Medianløn for mænd ansat i kommunen i SEK (pr. måned). Alle rapporterede\nlønninger er beregnet som fuldtidslønninger. Fuldtidslønninger inkluderer\ngrundløn plus variable tillæg og goder. Henviser til medarbejdere i alderen\n18-66 (indtil 2013 henvistes der til 18-64 år), der aflønnes måneds- eller\ntimelønnet. Medarbejdere i kommunalt ejede virksomheder er ikke inkluderet.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Median salary for men employed by the municipality in SEK (per month). All\nsalaries reported are calculated as full-time salaries. Full-time salaries\ninclude basic salary plus variable supplements and benefits. Refers to\nemployees aged 18-66 (until 2013, 18-64 years old were referred to) who are\npaid monthly or hourly. Employees in municipally owned companies are not\nincluded.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Medianlön för män anställda av kommunen kronor (i månaden). All lön som redovisas är uppräknad till heltidslön. I heltidslön ingår grundlön plus rörliga tillägg och förmåner. Avser anställda 18-66 år (t.o.m. 2013 avsågs 18-64 år) som är månads- eller timavlönade. Anställda i kommunägda bolag ingår inte.  \n  \nKälla: SCB (via Kolada)"}],"dct:identifier":"dbbe5983-d8f7-45f3-b248-0961f52ee82a","dct:issued":{"@type":"xsd:date","@value":"2022-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:46:16.727533"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:940d3c622f2bea5268935b21d815c1ee7823841713a5e760fcff6199891e4558_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Medianløn for mænd ansat i kommunen, SEK"},{"@language":"en","@value":"Median salary for men employed by the municipality, SEK"},{"@language":"sv","@value":"Medianlön män anställda av kommunen, kr"}]},{"@id":"https://opendata-api.malmo.se/dataset/dbbe5983-d8f7-45f3-b248-0961f52ee82a/resource/4e9e0316-d0c6-481b-ac06-661944ea0792","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N00950"},"dct:description":[{"@language":"da","@value":"Medianløn for mænd ansat i kommunen i SEK (pr. måned). Alle rapporterede\nlønninger er beregnet som fuldtidslønninger. Fuldtidslønninger inkluderer\ngrundløn plus variable tillæg og goder. Henviser til medarbejdere i alderen\n18-66 (indtil 2013 henvistes der til 18-64 år), der aflønnes måneds- eller\ntimelønnet. Medarbejdere i kommunalt ejede virksomheder er ikke inkluderet.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Median salary for men employed by the municipality in SEK (per month). All\nsalaries reported are calculated as full-time salaries. Full-time salaries\ninclude basic salary plus variable supplements and benefits. Refers to\nemployees aged 18-66 (until 2013, 18-64 years old were referred to) who are\npaid monthly or hourly. Employees in municipally owned companies are not\nincluded.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Medianlön för män anställda av kommunen kronor (i månaden). All lön som redovisas är uppräknad till heltidslön. I heltidslön ingår grundlön plus rörliga tillägg och förmåner. Avser anställda 18-66 år (t.o.m. 2013 avsågs 18-64 år) som är månads- eller timavlönade. Anställda i kommunägda bolag ingår inte.  \n  \nKälla: SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-01T09:18:15.138472"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:46:16.731939"},"dct:title":[{"@language":"da","@value":"Medianløn for mænd ansat i kommunen, SEK"},{"@language":"en","@value":"Median salary for men employed by the municipality, SEK"},{"@language":"sv","@value":"Medianlön män anställda av kommunen, kr"}]}],"@id":"urn:source:940d3c622f2bea5268935b21d815c1ee7823841713a5e760fcff6199891e4558"},{"@graph":[{"@id":"_:9656ced6c6acb076bc03e62c43f01a710ab78dc37c2ddb752273047ecac2862b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/8576071f-06e9-4e6e-a208-3d0093d4a003","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/8576071f-06e9-4e6e-a208-3d0093d4a003/resource/ac45ba41-2510-4110-8ea3-501c5642b00a"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til en erhvervsuddannelse,\ndivideret med antallet af elever, der fik eller ville have fået en karakter i\nmindst ét ​​fag i henhold til det mål- og vidensrelaterede karaktersystem i 9.\nklasse.\n\nStatistik i procenter fra 1998.\n\nFor at være berettiget til optagelse på en erhvervsuddannelse i gymnasiet\nkræves der karakterer i svensk eller svensk som andetsprog, engelsk og\nmatematik samt i mindst 5 andre fag fra grundskolen. Indtil 2011 krævedes der\nkarakterer i svensk eller svensk som andetsprog, engelsk og matematik for at\nopnå minimumsadgangskravet til gymnasiet.\n\n  * Dataene vedrører elever, der er registreret i kommunen.\n  * Studerende med ukendt baggrund er ikke inkluderet.\n  * Oplysningerne refererer til studieåret.\n\nKilde: Statistiska centralbanken og Skolstyrelsen.\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for a vocational program\ndivided by the number of students who received or would have received a grade\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9.\n\nStatistics in percentages from 1998.\n\nTo be eligible for upper secondary school admission to a vocational program,\npassing grades in Swedish or Swedish as a second language, English and\nmathematics and in at least 5 other subjects from compulsory school are\nrequired. Until 2011, passing grades in Swedish or Swedish as a second\nlanguage, English and mathematics were required to achieve the minimum\neligibility for upper secondary school.\n\n  * The data refers to students registered in the municipality.\n  * Students with unknown backgrounds are not included.\n  * The information refers to the academic year.\n\nSource: Statistics Sweden and the Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till ett yrkesprogram dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. \n\nStatistik i procent från 1998.\n\nFör att ha gymnasiebehörighet till ett yrkesprogram krävs godkända betyg i svenska eller svenska som andraspråk, engelska och matematik och i minst 5 andra ämnen från grundskolan. Fram till och med 2011 krävdes godkända betyg i svenska eller svenska som andraspråk, engelska och matematik för att uppnå lägsta behörighet till gymnasiet. \n\n* Uppgiften avser elever folkbokförda i kommunen.  \n* Elever med okänd bakgrund ingår inte.  \n* Uppgiften avser läsår.  \n\nKälla: SCB och Skolverket."}],"dct:identifier":"8576071f-06e9-4e6e-a208-3d0093d4a003","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:38:09.641323"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:9656ced6c6acb076bc03e62c43f01a710ab78dc37c2ddb752273047ecac2862b_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til erhvervsuddannelser, hjemkommune"},{"@language":"en","@value":"Students in grade 9 who are eligible for vocational programs, home municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som är behöriga till yrkesprogram, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/8576071f-06e9-4e6e-a208-3d0093d4a003/resource/ac45ba41-2510-4110-8ea3-501c5642b00a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15428"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til en erhvervsuddannelse,\ndivideret med antallet af elever, der fik eller ville have fået karakterer i\nmindst ét ​​fag i henhold til det mål- og vidensrelaterede karaktersystem i 9.\nklasse. For at være berettiget til en erhvervsuddannelse i gymnasiet kræves\nder beståede karakterer i svensk eller svensk som andetsprog, engelsk og\nmatematik samt i mindst fem andre fag fra grundskolen. Indtil 2011 krævedes\ndet at have beståede karakterer i svensk eller svensk som andetsprog, engelsk\nog matematik for at opnå minimumsberettigelsen til gymnasiet. Dataene\nrefererer til elever, der er registreret i kommunen. Elever med ukendt\nbaggrund er ikke inkluderet. Dataene refererer til skoleåret.  \nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for a vocational program\ndivided by the number of students who received or would have received grades\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9. In order to have upper secondary school eligibility for a\nvocational program, passing grades in Swedish or Swedish as a second language,\nEnglish and mathematics and in at least five other subjects from compulsory\nschool are required. Until 2011, passing grades in Swedish or Swedish as a\nsecond language, English and mathematics were required to achieve the minimum\neligibility for upper secondary school. The data refers to students registered\nin the municipality. Students with unknown backgrounds are not included. The\ndata refers to the academic year.  \nSource: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till ett yrkesprogram dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. För att ha gymnasiebehörighet till ett yrkesprogram krävs godkända betyg i svenska eller svenska som andraspråk, engelska och matematik och i minst fem andra ämnen från grundskolan. Fram t.o.m. 2011 krävdes godkända betyg i svenska eller svenska som andraspråk, engelska och matematik för att uppnå lägsta behörighet till gymnasiet. Uppgiften avser elever folkbokförda i kommunen. Elever med okänd bakgrund ingår inte. Uppgiften avser läsår.  \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-22T06:18:18.095872"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:38:09.646389"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til erhvervsuddannelser, hjemkommune, procentdel (%) (N15428)"},{"@language":"en","@value":"Students in grade 9 who are eligible for vocational programs, home municipality, percentage (%) (N15428)"},{"@language":"sv","@value":"Elever i åk 9 som är behöriga till yrkesprogram, hemkommun, andel (%) (N15428)"}]}],"@id":"urn:source:9656ced6c6acb076bc03e62c43f01a710ab78dc37c2ddb752273047ecac2862b"},{"@graph":[{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"7c5a46c1029b9abcf35cd825b0124d02fc48031d"},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"557141d1a4db48d8002272c3097bdcba0b1d14d4"},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"f153f17c6b7a1a187b33557709ff254a8d2bfd55"},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b3n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"9997c1f55ea122345837b323d41f2351254d444a"},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b4n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"12d36186f5106ba8fa0d93e22b10fd8f5fc02c55"},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b5n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b6n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2022-10-01"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/2fb0c094-2e11-48c0-be41-d651fd9265fb"},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/d5531a09-9a46-4478-a0c2-13f4f5e80265"},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/debb0669-b491-454a-9cc9-e5c7d37ffc4d"},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/f5b30f28-2f54-407a-a032-a83b60f945a3"},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/fc883562-61e7-4c26-8318-30c33539803f"}],"dcat:keyword":["Malmö stad","geodata","gis","karta","map","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"da","@value":"## Kortlag\n\nKortlag, der viser de geografiske statistiske områder i Malmø by. Ny inddeling\nfra 2022.\n\n##  Polygonlag\n\n**Koordinatsystem**\n\nSWEREF99 13 30 (EPSG3008)  \nWGS84 (EPSG4326)\n\n**Forklaring af attributter**\n\nNavn på det geografiske statistiske område: Betegnelse  \nGeografisk statistisk områdekode: GeSO\n\n(TopoJSON-formatressourcen er blevet brugt med succes til distribution af\nspatiale data i Power BI.)\n\n"},{"@language":"en","@value":"## Map layers\n\nMap layer showing the geographical statistical areas of the city of Malmö. New\ndivision from 2022.\n\n##  Polygon layer\n\n**Coordinate system**\n\nSWEREF99 13 30 (EPSG3008)  \nWGS84 (EPSG4326)\n\n**Attribute explanation**\n\nName of the geographical statistical area: Designation  \nGeographical statistical area code: GeSO\n\n(The TopoJSON format resource has been successfully used for spatial data\ndistribution in Power BI.)\n\n"},{"@language":"sv","@value":"## Kartlager  \nKartlager som visar Malmö stads geografiska statistikområden. Ny indelning från 2022.\n\n## Polygonlager  \n\n**Koordinatsystem**\n\nSWEREF99 13 30 (EPSG3008)  \nWGS84 (EPSG4326)\n\n**Attributförklaring**\n\nDet geografiska statistikområdets namn: Benamning  \nGeografisk statistikområdeskod: GeSO\n\n(Resursen i TopoJSON-format har framgångsrikt använts vid geografisk datafördelning i Power BI.)"}],"dct:identifier":"e31232ee-7a56-4814-8496-e8ffaeb0b9d2","dct:issued":{"@type":"xsd:date","@value":"2022-10-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-15T16:19:00.642979"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b5n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:temporal":{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b6n0"},"dct:title":[{"@language":"da","@value":"Geografiske statistiske områder"},{"@language":"en","@value":"Geographical statistical areas"},{"@language":"sv","@value":"Geografiska statistikområden"}]},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/2fb0c094-2e11-48c0-be41-d651fd9265fb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/2fb0c094-2e11-48c0-be41-d651fd9265fb/download/geografiska_statistikomraden_epsg4326.json"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"47651"},"dct:description":[{"@language":"da","@value":"Geografiske statistiske områder i henhold til\nWGS84/EPSG4326-koordinatsystemet. (Har med succes været anvendt til geografisk\ndatadistribution i Power BI).\n\n"},{"@language":"en","@value":"Geographic statistical areas according to the WGS84/EPSG4326 coordinate\nsystem. (Has been successfully used for geographic data distribution in Power\nBI).\n\n"},{"@language":"sv","@value":"Geografiska statistikområden enligt koordinatsystem WGS84/EPSG4326.\n(Har med framgång använts för geografisk datafördelning i Power BI)."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-11-30T07:30:44.024773"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T14:56:25.603651"},"dct:title":[{"@language":"da","@value":"Geografiske statistiske områder EPSG4326 (TopoJSON)"},{"@language":"en","@value":"Geographic statistical areas EPSG4326 (TopoJSON)"},{"@language":"sv","@value":"Geografiska statistikområden EPSG4326 (TopoJSON)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:96d5f0e48f9a06e3d2eb95be80ea565d3d1d9ce73b74708654553f104aa76d07_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/d5531a09-9a46-4478-a0c2-13f4f5e80265","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/e31232ee-7a56-4814-8496-e8ffaeb0b9d2/resource/d5531a09-9a46-4478-a0c2-13f4f5e80265/download/geografiska_statistikomr.json"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"428015"},"dct:description":[{"@language":"da","@value":"Geografiske statistiske områder i h