dms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/d495d6a3-f1d5-49e5-987e-8774414cee45","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/dbef184e-e111-407b-84da-635274e1b30e/resource/d495d6a3-f1d5-49e5-987e-8774414cee45/download/skoldata.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"4276"},"dct:description":[{"@language":"da","@value":"Styling af kortpunkter\n\n"},{"@language":"en","@value":"Styling for map points\n\n"},{"@language":"sv","@value":"Stilsättning för kartpunkter"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2023-03-01T14:32:39.089023"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:53:17.799722"},"dct:title":[{"@language":"da","@value":"SLD-stil"},{"@language":"en","@value":"SLD style"},{"@language":"sv","@value":"SLD style"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:7a75ad402e4f8ed6b7b706322c6db2e95e9454a5beb036c5630eb745f068388b"},{"@graph":[{"@id":"_:7ab7056a3dc17e06bfeb1d791e78ab814e0aa51dfe794adf5d5d70ea7436c342_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"d3f628f5acedfaa524ee78410d37a543"},{"@id":"_:7ab7056a3dc17e06bfeb1d791e78ab814e0aa51dfe794adf5d5d70ea7436c342_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd/resource/84dbe40c-7adb-4682-bf85-dcab781aeef9"},{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd/resource/c306cee6-41e1-42f4-afd6-e1e1dbf10a9f"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser det gennemsnitlige antal dage, en person i området modtog erstatning i\nløbet af året fra den svenske socialforsikringskasse i form af sygedagpenge,\nrehabiliteringsydelse og syge- og aktivitetserstatning. Bemærk venligst, at\ndefinitionen af, hvad der berettiger til erstatning, har ændret sig over tid,\nhvilket gør det upassende at sammenligne tal over tid. Bemærk venligst også,\nat tallene afviger fra Sveriges officielle statistik produceret af den svenske\nsocialforsikringskasse. Statistiska Centralbyråns tal for sygefravær (som er\ndem, der vises her) er baseret på et øjebliksbillede af antallet af\nsygefraværsdage i det seneste år blandt befolkningen, der bor i området pr.\n31/12. Den svenske socialforsikringskasse bruger i stedet et rullende\ngennemsnit for året. Statistiska Centralbyråns statistik tæller derfor\nantallet af sygefraværsdage, som personer, der bor i et område, har haft i\nløbet af året, uanset hvor de boede, da de var syge. Den svenske\nsocialforsikringskasses officielle statistik for en kommune tæller i stedet\nalle sygefraværsdage, der blev registreret inden for et område i løbet af\nåret, uanset om personerne derefter flytter. Vist for befolkningen i alderen\n20-64 år. Tilgængelig opdelt efter køn.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the average number of days a person in the area received compensation\nduring the year from the Swedish Social Insurance Agency in the form of\nsickness benefit, rehabilitation benefit and sickness and activity\ncompensation. Please note that the definition of what qualifies for\ncompensation has changed over time, which makes it inappropriate to compare\nfigures over time. Please also note that the figures differ from Sweden's\nofficial statistics produced by the Swedish Social Insurance Agency.\nStatistics Sweden's ill-health figures (which are the ones shown here) are\nbased on a snapshot of the number of ill-health days in the past year among\nthe population living in the area on 31/12. The Swedish Social Insurance\nAgency instead uses a rolling average for the year. Statistics Sweden's\nstatistics therefore count the number of ill-health days people living in an\narea have had during the year, regardless of where they lived when they were\nsick. The Swedish Social Insurance Agency's official statistics for a\nmunicipality instead count all ill-health days that were registered within an\narea during the year, regardless of whether the people then move. Shown for\nthe population aged 20–64. Available broken down by gender.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar genomsnittligt antal dagar en person i området fick ersättning under året från Försäkringskassan i form av sjukpenning, rehabiliteringspenning samt sjuk- och aktivitetsersättning. Observera att definitionen av vad som berättigar ersättning har ändrats över tid vilket gör det olämpligt att jämföra siffror över tid. Observera vidare att siffrorna skiljer sig från Sveriges officiella statistik som produceras av Försäkringskassan. SCB:s ohälsotal (som alltså är de som visas här) bygger på en ögonblicksbild av antalet ohälsodagar det senaste året bland befolkningen som bor i området den 31/12. Försäkringskassan använder istället ett rullande medelvärde för året. I SCB:s statistik räknas alltså antalet ohälsodagar personer som bor i ett område har haft under året, oavsett var hen bodde när hen var sjuk. I Försäkringskassans officiella statistik för en kommun räknas istället alla ohälsodagar som registrerades inom ett område under året, oavsett om personerna sedan flyttar. Visas för befolkningen 20–64 år. Finns uppdelad på kön.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"73d17884-b754-43a5-baf3-745626ef08fd","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:38.036366"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7ab7056a3dc17e06bfeb1d791e78ab814e0aa51dfe794adf5d5d70ea7436c342_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Sundhedsstatistik - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Health statistics - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Ohälsotal - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd/resource/84dbe40c-7adb-4682-bf85-dcab781aeef9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=c306cee6-41e1-42f4-afd6-e1e1dbf10a9f"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Sundhedsstatistik\n\n"},{"@language":"en","@value":"Malmö statistics - Health statistics\n\n"},{"@language":"sv","@value":"Malmö statistik - Ohälsotal"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:58.533706"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:19:08.319425"},"dct:title":[{"@language":"da","@value":"Usund tale"},{"@language":"en","@value":"Unhealthy speech"},{"@language":"sv","@value":"Ohälsotal"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd/resource/c306cee6-41e1-42f4-afd6-e1e1dbf10a9f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/73d17884-b754-43a5-baf3-745626ef08fd/resource/c306cee6-41e1-42f4-afd6-e1e1dbf10a9f/download/ohalsotal.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1805466"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Sundhedsstatistik\n\n"},{"@language":"en","@value":"Malmö statistics - Health statistics\n\n"},{"@language":"sv","@value":"Malmö statistik - Ohälsotal"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:53.867649"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:38.055973"},"dct:title":[{"@language":"da","@value":"Usund tale"},{"@language":"en","@value":"Unhealthy speech"},{"@language":"sv","@value":"Ohälsotal"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7ab7056a3dc17e06bfeb1d791e78ab814e0aa51dfe794adf5d5d70ea7436c342_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:7ab7056a3dc17e06bfeb1d791e78ab814e0aa51dfe794adf5d5d70ea7436c342"},{"@graph":[{"@id":"_:7ae187d183a9c3a2cf56b9e5d7a42f372ddde69965ea3f0b5df229e760883aa8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/2d6a0ac9-a6f0-4bdf-9753-0362486bc698","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/2d6a0ac9-a6f0-4bdf-9753-0362486bc698/resource/c4a0165f-135d-41ca-916a-8919aa8a2091"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Bruttoomkostninger minus interne indtægter og salg til andre kommuner og\nregioner inden for kultursektoren (støtte til foreninger, biblioteker,\nmusikskoler mv.) pr. indbygger pr. 31/12. Vedrører støtte til\nstudieorganisationer, generelle kulturelle aktiviteter, biblioteker samt\nmusik- og kulturskoler. Vedrører al administration.\n\nKilde: Statistiska centralbankens økonomiske oversigt.\n\n"},{"@language":"en","@value":"Gross cost minus internal revenue and sales to other municipalities and\nregions within the cultural sector (support for associations, libraries, music\nschools, etc.) per inhabitant on 31/12. Refers to support for study\norganizations, general cultural activities, libraries and music and culture\nschools. Refers to all management.\n\nSource: Statistics Sweden's Financial Summary.\n\n"},{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner inom kulturområdet (stöd till föreningar, bibliotek, musikskola etc) per invånare den 31/12. Avser stöd till studieorganisationer, allmän kulturverksamhet, bibliotek samt musik- och kulturskola. Avser samtlig regi.  \n  \nKälla: SCB:s Räkenskapssammandrag."}],"dct:identifier":"2d6a0ac9-a6f0-4bdf-9753-0362486bc698","dct:issued":{"@type":"xsd:date","@value":"2022-11-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:46.267628"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7ae187d183a9c3a2cf56b9e5d7a42f372ddde69965ea3f0b5df229e760883aa8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Omkostninger til kulturelle aktiviteter, SEK/indbygger"},{"@language":"en","@value":"Cost of cultural activities, SEK/inhabitant"},{"@language":"sv","@value":"Kostnad kulturverksamhet, kr/inv"}]},{"@id":"https://opendata-api.malmo.se/dataset/2d6a0ac9-a6f0-4bdf-9753-0362486bc698/resource/c4a0165f-135d-41ca-916a-8919aa8a2091","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N09100"},"dct:description":[{"@language":"da","@value":"Bruttoomkostninger minus interne indtægter og salg til andre kommuner og\nregioner inden for kultursektoren (støtte til foreninger, biblioteker,\nmusikskoler mv.) pr. indbygger pr. 31/12. Vedrører støtte til\nstudieorganisationer, generelle kulturelle aktiviteter, biblioteker samt\nmusik- og kulturskoler. Vedrører al administration.\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Gross cost minus internal revenue and sales to other municipalities and\nregions within the cultural sector (support for associations, libraries, music\nschools, etc.) per inhabitant on 31/12. Refers to support for study\norganizations, general cultural activities, libraries and music and culture\nschools. Refers to all management.\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner inom kulturområdet (stöd till föreningar, bibliotek, musikskola etc) per invånare den 31/12. Avser stöd till studieorganisationer, allmän kulturverksamhet, bibliotek samt musik- och kulturskola. Avser samtlig regi.  \n  \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-28T12:09:59.978699"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:46.272394"},"dct:title":[{"@language":"da","@value":"Omkostninger til kulturelle aktiviteter, SEK/indbygger"},{"@language":"en","@value":"Cost of cultural activities, SEK/inhabitant"},{"@language":"sv","@value":"Kostnad kulturverksamhet, kr/inv"}]}],"@id":"urn:source:7ae187d183a9c3a2cf56b9e5d7a42f372ddde69965ea3f0b5df229e760883aa8"},{"@graph":[{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"4b7333f9ca78081b67531718df12d1d7"},{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"31c530a750b53ddd9f2bd756d948a732b6b2361e"},{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/5249aa0b-6528-43ef-880f-172adac8515b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/5249aa0b-6528-43ef-880f-172adac8515b/resource/8aa6f956-d315-4c42-88c7-2ee33b21169a"},{"@id":"https://opendata-api.malmo.se/dataset/5249aa0b-6528-43ef-880f-172adac8515b/resource/b8c20e85-9785-4950-b272-05ffedf85e3e"}],"dcat:keyword":["GIS","Malmö stad","Miljöfarlig verksamhet","Prövningsplikt","geodata","karta","map"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"da","@value":"Miljøfarlige aktiviteter, der er underlagt vurderingspligt, og som er\nregistreret hos Miljøforvaltningen.\n\nA- og B-aktiviteter er aktiviteter, der kræver en tilladelse.\n\nC-aktiviteter er aktiviteter, der kræver anmeldelse.\n\nU-virksomheder er ikke underretningspligtige.\n\nDriften er i gang, og objekter, der kan klassificeres som beskyttede, er\nblevet fjernet.\n\n"},{"@language":"en","@value":"Environmentally hazardous activities subject to an assessment obligation that\nare registered with the Environmental Administration.\n\nA and B activities are activities that require a permit.\n\nC-activities are activities that require notification.\n\nU-businesses are not subject to notification.\n\nThe operations are in operation and objects that may be classified as\nprotected have been sorted out.\n\n"},{"@language":"sv","@value":"Miljöfarliga verksamheter med prövningsplikt som finns registrerade hos miljöförvaltningen.\n\nA- och B-verksamheter är tillståndspliktiga verksamheter.\n\nC-verksamheter är anmälningspliktiga verksamheter.\n\nU-verksamheter är inte anmälningspliktiga.\n\nVerksamheterna är i drift och objekt som kan vara skyddsklassade är bortsorterade.\n"}],"dct:identifier":"5249aa0b-6528-43ef-880f-172adac8515b","dct:issued":{"@type":"xsd:date","@value":"2024-06-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T23:32:48.288148"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b3n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Miljøfarlige aktiviteter"},{"@language":"en","@value":"Environmentally hazardous activities"},{"@language":"sv","@value":"Miljöfarliga verksamheter"}]},{"@id":"https://opendata-api.malmo.se/dataset/5249aa0b-6528-43ef-880f-172adac8515b/resource/8aa6f956-d315-4c42-88c7-2ee33b21169a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/5249aa0b-6528-43ef-880f-172adac8515b/resource/8aa6f956-d315-4c42-88c7-2ee33b21169a/download/miljofarligaverksamheter.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"314490"},"dct:description":[{"@language":"da","@value":"Data opdateret 20261017\n\n"},{"@language":"en","@value":"Data updated 20261017\n\n"},{"@language":"sv","@value":"Data uppdaterat 20261017"}],"dct:format":{"@id":"http:/