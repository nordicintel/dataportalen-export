c/resource/ac18ce32-d9e9-4c10-a929-65096e42654e"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/b94f130b-3e44-4af9-b54a-005ef9fc0619"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/bf44c80a-48fc-4865-aaa5-861a52078b97"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/c3fec4bb-e0fd-4f2b-9d37-7e096ceec0ec"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/c55f4a49-953f-4747-a4a3-fd21389e7985"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/c63d4419-33a9-4627-9993-9c5a92481ab4"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/cd1f96fd-e43d-4040-b4aa-7f825636ba47"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/e067b108-f83f-4e13-9d66-a552b991eaf8"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/e3ff24ef-747a-45f6-b24b-87e42648f3c8"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/ec8eac7e-8acb-4adb-b2a3-7f9088e46f83"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/f3b88df8-7bb0-49b2-b998-4205454ecc42"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/f50a88af-9dd5-466c-ac8d-e1b46d941487"},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/f824305c-b943-415d-ae8a-0f96cab6b503"}],"dcat:keyword":["Malmö stad","statistik","årsbok"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":[{"@language":"da","@value":"Malmø Kommunes statistiske årbog indeholder blandt andet statistik om Malmøs\nbefolkning, erhvervsliv og boligmarked. Publikationerne indeholder også\nstatistik om byens finanser og arbejder samt kort over de forskellige anvendte\ngeografiske opdelinger.\n\n"},{"@language":"en","@value":"The City of Malmö's statistical yearbook contains statistics on Malmö's\npopulation, business and housing market, among other things. The publications\nalso contain statistics on the city's finances and works, as well as maps of\nthe various geographical divisions used.\n\n"},{"@language":"sv","@value":"Malmö stads statistiska årsbok innehåller statistik om bland annat Malmös befolkning, näringsliv och bostadsmarknad. Publikationerna innehåller även statistik om stadens finanser och verk samt kartor över de olika geografiska indelningarna som används."}],"dct:identifier":"a2e5d087-8576-4028-a6c2-1e979c75e2dc","dct:issued":{"@type":"xsd:date","@value":"2022-12-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T15:47:26.971959"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:75d105113e70bca197e10c27c911aeffe612b9e780c9d74b823412f9053eab55_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:temporal":{"@id":"_:75d105113e70bca197e10c27c911aeffe612b9e780c9d74b823412f9053eab55_b1n0"},"dct:title":[{"@language":"da","@value":"Malmø Bys Statistiske Årbog 1965 - 2001/2003"},{"@language":"en","@value":"Malmö City Statistical Yearbook 1965 - 2001/2003"},{"@language":"sv","@value":"Malmö stads statistiska årsbok 1965 - 2001/2003"}]},{"@id":"https://opendata-api.malmo.se/dataset/a2e5d087-8576-4028-a6c2-1e979c75e2dc/resource/00f91425-d16d-40ec-ac9e-082c16f7e02a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mmostatfiler.malmo.se/statistisk_arsbok/statistisk_arsbok_1987.pdf"},"dct:description":[{"@language":"da","@value":"* * *\n\n"},{"@lang