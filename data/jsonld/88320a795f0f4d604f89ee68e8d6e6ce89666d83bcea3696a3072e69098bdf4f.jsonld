55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/64abd172-68f0-4d4e-909f-39e1f20f81db","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/64abd172-68f0-4d4e-909f-39e1f20f81db/resource/ed0628be-7631-48a8-b208-e13a8176df80"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Skattesats til kommunen.\n\nStatistik i procenter fra 1995.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Tax rate to the municipality.\n\nStatistics in percentages from 1995.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Skattesats till kommunen. \n\nStatistik i procent från 1995.\n\nKälla: SCB."}],"dct:identifier":"64abd172-68f0-4d4e-909f-39e1f20f81db","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:45:23.114018"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:6dc4751483564a30a1d9773cec4973423e1b24ad6d3b94d0ce26ca93257ec33b_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Skattesats til kommunen"},{"@language":"en","@value":"Tax rate to municipality"},{"@language":"sv","@value":"Skattesats till kommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/64abd172-68f0-4d4e-909f-39e1f20f81db/resource/ed0628be-7631-48a8-b208-e13a8176df80","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N00901"},"dct:description":[{"@language":"da","@value":"Skattesats til kommune (N00901)\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Tax rate to municipality (N00901)\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Skattesats till kommun (N00901)\n\nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-05-27T06:42:52.750565"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:45:23.120316"},"dct:title":[{"@language":"da","@value":"Skattesats til kommune, (%) (N00901)"},{"@language":"en","@value":"Tax rate to municipality, (%) (N00901)"},{"@language":"sv","@value":"Skattesats till kommun, (%) (N00901)"}]}],"@id":"urn:source:6dc4751483564a30a1d9773cec4973423e1b24ad6d3b94d0ce26ca93257ec33b"},{"@graph":[{"@id":"_:6f2bf7bf41e6069c7ce80393b749a3fea55983add678292a918e77cef0bc894b_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/10623910-9865-4675-a816-ffd8d22f5b74","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/10623910-9865-4675-a816-ffd8d22f5b74/resource/707f6dfd-b61f-447f-bd74-0bbfbb4d83c2"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Kvindelige medlemmer af kommunalbestyrelsen divideret med det samlede antal\nmedlemmer af kommunalbestyrelsen, ganget med 100. Statistikken produceres kun\nhvert fjerde år, men i Kolada offentliggøres den, udover måleåret T, også i\nårene T+1, T+2 og T+3.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Female members of the municipal council divided by the total number of members\nof the municipal council, multiplied by 100. The statistics are only produced\nevery four years, but in Kolada, in addition to the measurement year T, they\nare also published in years T+1, T+2 and T+3.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Kvinnliga ledamöter i kommunfullmäktige dividerat med antal ledamöter i kommunfullmäktige totalt, multiplicerat med 100. Statistiken tas bara fram vart fjärde år men i Kolada publiceras den förutom mätåret T även på år T+1, T+2 och T+3.  \n  \nKälla: SCB (via Kolada)"}],"dct:identifier":"10623910-9865-4675-a816-ffd8d22f5b74","dct:issued":{"@type":"xsd:date","@value":"2022-12-06"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:09.600127"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:6f2bf7bf41e6069c7ce80393b749a3fea55983add678292a918e77cef0bc894b_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Kvinder i byrådet, procentdel (%)"},{"@language":"en","@value":"Women in the city council, percentage (%)"},{"@language":"sv","@value":"Kvinnor i kommunfullmäktige, andel (%)"}]},{"@id":"https://opendata-api.malmo.se/dataset/10623910-9865-4675-a816-ffd8d22f5b74/resource/707f6dfd-b61f-447f-bd74-0bbfbb4d83c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N05815"},"dct:description":[{"@language":"da","@value":"Kvindelige medlemmer af kommunalbestyrelsen divideret med det samlede antal\nmedlemmer af kommunalbestyrelsen, ganget med 100. Statistikken produceres kun\nhvert fjerde år, men i Kolada offentliggøres den, udover måleåret T, også i\nårene T+1, T+2 og T+3.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Female members of the municipal council divided by the total number of members\nof the municipal council, multiplied by 100. The statistics are only produced\nevery four years, but in Kolada, in addition to the measurement year T, they\nare also published in years T+1, T+2 and T+3.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Kvinnliga ledamöter i kommunfullmäktige dividerat med antal ledamöter i kommunfullmäktige totalt, multiplicerat med 100. Statistiken tas bara fram vart fjärde år men i Kolada publiceras den förutom mätåret T även på år T+1, T+2 och T+3.  \n  \nKälla: SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-06T07:44:31.872647"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:09.605987"},"dct:title":[{"@language":"da","@value":"Kvinder i byrådet, procentdel (%)"},{"@language":"en","@value":"Women in the city council, percentage (%)"},{"@language":"sv","@value":"Kvinnor i kommunfullmäktige, andel (%)"}]}],"@id":"urn:source:6f2bf7bf41e6069c7ce80393b749a3fea55983add678292a918e77cef0bc894b"},{"@graph":[{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"9e387d04462564b15c9af04a8d95a31a"},{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b10n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"d35c9d5ed271a84a13f24af1d1f8a728"},{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b11n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"d35c9d5ed271a84a13f24af1d1f8a728"},{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"a9dd994feaa97435b6a42c2f2fb8d61f"},{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b3n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#a