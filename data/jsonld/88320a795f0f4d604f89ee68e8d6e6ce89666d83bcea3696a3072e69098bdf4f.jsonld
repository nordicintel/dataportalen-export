af965a2b23ca73472eeaed0651be50b7d0b791fb4fd6e3249277e33bd193_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/da0f59e9-7a47-4313-b1bd-1e1e5adc8fb7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/da0f59e9-7a47-4313-b1bd-1e1e5adc8fb7/resource/23d5d971-b633-4d83-ae2f-f7473f2c5dfe"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Samlet antal indbyggere pr. 31/12.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Total number of inhabitants on 31/12.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal invånare totalt den 31/12.  \n  \nKälla: SCB (via Kolada)"}],"dct:identifier":"da0f59e9-7a47-4313-b1bd-1e1e5adc8fb7","dct:issued":{"@type":"xsd:date","@value":"2022-11-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:14:36.514814"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e3cbaf965a2b23ca73472eeaed0651be50b7d0b791fb4fd6e3249277e33bd193_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Samlet antal indbyggere"},{"@language":"en","@value":"Total inhabitants, number"},{"@language":"sv","@value":"Invånare totalt, antal"}]},{"@id":"https://opendata-api.malmo.se/dataset/da0f59e9-7a47-4313-b1bd-1e1e5adc8fb7/resource/23d5d971-b633-4d83-ae2f-f7473f2c5dfe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N01951"},"dct:description":[{"@language":"da","@value":"Samlet antal indbyggere pr. 31/12.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Total number of inhabitants on 31/12.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal invånare totalt den 31/12.  \n  \nKälla: SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-28T14:14:53.659142"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:14:36.536694"},"dct:title":[{"@language":"da","@value":"Samlede indbyggere, antal"},{"@language":"en","@value":"Total inhabitants, number"},{"@language":"sv","@value":"Invånare totalt, antal"}]}],"@id":"urn:source:e3cbaf965a2b23ca73472eeaed0651be50b7d0b791fb4fd6e3249277e33bd193"},{"@graph":[{"@id":"_:e3e529b5f06edf25a4e0d6808276ec121b6820d9a0a6362ce092dea989585ec8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/a5dcbfe0-7610-4077-8b41-788b25d20114","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/a5dcbfe0-7610-4077-8b41-788b25d20114/resource/0aa419a3-2a6c-4910-a464-6e96083147d3"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen (hjemkommunen), der startede i gymnasiet\nfor 3 år siden, og som er berettigede til universitet/gymnasium inden for 3 år\n(inklusive introduktionsprogram IM) divideret med antal registrerede elever i\nkommunen, der startede i gymnasiet for 3 år siden (inklusive IM).\n\nStatistik i procenter fra 2014.\n\nFra 2016 er studerende, der er færdiguddannet fra svenske skoler i udlandet,\nikke inkluderet.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of registered students in the municipality (home municipality) who\nstarted upper secondary school 3 years ago and who are eligible for\nuniversity/college within 3 years, (including introductory program IM) divided\nby number of registered students in the municipality who started upper\nsecondary school 3 years ago, (including IM).\n\nStatistics in percentages from 2014.\n\nAs of 2016, students who have graduated from Swedish schools abroad are not\nincluded.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen (hemkommunen) som började på gymnasium för 3 år sedan och som har behörighet till universitet/högskola inom 3 år, (inklusive introduktionsprogram IM) dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 3 år sedan, (inklusive IM). \n\nStatistik i procent från 2014.\n\nFrån och med 2016 ingår inte elever som tagit examen i svenska utlandsskolor.\n\nKälla: SCB."}],"dct:identifier":"a5dcbfe0-7610-4077-8b41-788b25d20114","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:32:18.857288"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e3e529b5f06edf25a4e0d6808276ec121b6820d9a0a6362ce092dea989585ec8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 3 år, hjemkommune"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 3 years, home municipality"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 3 år, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/a5dcbfe0-7610-4077-8b41-788b25d20114/resource/0aa419a3-2a6c-4910-a464-6e96083147d3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17473"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen, der startede på gymnasiet for 3 år\nsiden, og som er berettigede til universitet/højskole inden for 3 år, inkl.\nIM, divideret med antal registrerede elever i kommunen, der startede på\ngymnasiet for 3 år siden, inkl. IM. Fra 2016 er elever, der er færdiguddannet\nfra svenske skoler i udlandet, ikke inkluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of registered students in the municipality who started upper secondary\nschool 3 years ago who are eligible for university/college within 3 years,\nincl. IM divided by number of registered students in the municipality who\nstarted upper secondary school 3 years ago, incl. IM. From 2016, students who\nhave graduated from Swedish schools abroad are not included. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen som började på gymnasium för 3 år sedan som med behörighet till universitet/högskola inom 3 år, inkl. IM dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 3 år sedan, inkl. IM. Fr.o.m. 2016 ingår inte elever som tagit examen i svenska utlandsskolor. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T05:30:45.076302"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:32:18.861401"},"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 3 år, hjemkommune, andel (%) (N17473)"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 3 years, home municipality, proportion (%) (N17473)"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 3 år, hemkommun, andel (%) (N17473)"}]}],"@id":"urn:source:e3e529b5f06edf25a4e0d6808276ec121b6820d9a0a6362ce092dea989585ec8"},{"@graph":[{"@id":"_:e428300e2d9d3dfe2920e9bf44499289ab6b7db24dd31b2533c4c98e14e0bb35_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/397fcbe2-eec4-4bc5-8c41-f66b23e320a4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/397fcbe2-eec4-4bc5-8c41-f66b23e320a4/resource/bc296f06-a924-46d5-a606-27d631441541"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Procentdel af førsteårsstuderende pr. 15. oktober året før, der er skiftet fra\net introduktionsprogram til et nationalt program, uanset år i det nationale\nprogram.\n\nStatistik i procenter fra 2011.\n\nElever, der mangler oplysninger om deres folkeregistreringskommune, er i\nstedet blevet tildelt den kommune, hvor skolen ligger.\n\nFra og med skoleåret 2014/15 er studerende, der har midlertidige personlige\nidentifikationsnumre (mangler et personligt identifikationsnummer eller har en\nbeskyttet identitet), blevet undtaget fra foranstaltningen.\n\nKilde: Skolstyrelsen i Sverige (Sammenligningstal)\n\n"},{"@language":"en","@value":"Percentage of first-year students as of October 15 of the previous year who\nhave switched from an introductory program to a national program, regardless\nof year in the national program.\n\nStatistics in percentages from 2011.\n\nStudents who lack information about their population registration municipality\nhave instead been assigned to the municipality where the school is located.\n\nStarting with the 2014/15 academic year, students who have temporary personal\nidentification numbers (lacking a personal identification number or having a\nprotected identity) have been excluded from the measure.\n\nSource: Swedish National Agency for Education (Comparative figures)\n\n"},{"@language":"sv","@value":"Andel av nybörjare år 1 som den 15 oktober föregående år som bytt från något introduktionsprogram till ett nationellt program, oavsett årskurs på det nationella programmet. \n\nStatistik i procent från 2011.\n\nElever som saknar uppgift om folkbokföringskommun har istället tilldelats den kommun där skolan är belägen. \n\nFrån och med läsåret 2014/15 har elever som har tillfälliga personnummer (saknar personnummer alternativt har skyddad identitet) uteslutets från måttet.\n\nKälla: Skolverket (Jämförelsetal)"}],"dct:identifier":"397fcbe2-eec4-4bc5-8c41-f66b23e320a4","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:30:18.608975"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e428300e2d9d3dfe2920e9bf44499289ab6b7db24dd31b2533c4c98e14e0bb35_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever, der er overgået fra et introduktionsprogram (IM) til et nationalt program, hjemkommune"},{"@language":"en","@value":"Upper secondary school students who have transferred from an introductory program (IM) to a national program, home municipality"},{"@language":"sv","@value":"Gymnasieelever som övergått från introduktionsprogram (IM) till nationellt program, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/397fcbe2-eec4-4bc5-8c41-f66b23e320a4/resource/bc296f06-a924-46d5-a606-27d631441541","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17623"},"dct:description":[{"@language":"da","@value":"Procentdel af førsteårselever i 1. klasse den 15. oktober året før, der\nskiftede fra et introduktionsprogram til et nationalt program, uanset året i\ndet nationale program. Elever, der ikke har oplysninger om\nfolkeregistreringskommunen, er i stedet blevet tildelt den kommune, hvor\nskolen ligger. Fra skoleåret 2014/15 er elever, der har midlertidige\npersonlige identifikationsnumre (mangler et personligt identifikationsnummer\neller har en beskyttet identitet), blevet ekskluderet fra målingen. Kilde:\nKolada\n\n"},{"@language":"en","@value":"Percentage of first-year students in year 1 on 15 October of the previous year\nwho switched from an introductory program to a national program regardless of\nthe year in the national program. Students who do not have information about\nthe municipality of population registration have instead been assigned to the\nmunicipality where the school is located. From the 2014/15 academic year,\nstudents who have temporary personal identification numbers (lacking a\npersonal identification number or having a protected identity) have been\nexcluded from the measure. Source: Kolada\n\n"},{"@language":"sv","@value":"Andel av nybörjare i år 1 den 15 oktober föregående år som bytt från något introduktionsprogram till ett nationellt program oavsett årskurs på det nationella programmet. Elever som saknar uppgift om folkbokföringskommun har istället tilldelats den kommun där skolan är belägen. Från och med läsåret 2014/15 har elever som har tillfälliga personnummer (saknar personnummer alt ha skyddad identitet) uteslutets från måttet. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-18T08:22:38.276004"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:30:18.635364"},"dct:title":[{"@language":"da","@value":"Gymnasieelever, der er overgået fra IM til nationalt program, hjemkommune, procentdel (%) (N17623)"},{"@language":"en","@value":"Upper secondary school students who have transferred from IM to national program, home municipality, percentage (%) (N17623)"},{"@language":"sv","@value":"Gymnasieelever som övergått från IM till nationellt program, hemkommun, andel (%) (N17623)"}]}],"@id":"urn:source:e428300e2d9d3dfe2920e9bf44499289ab6b7db24dd31b2533c4c98e14e0bb35"},{"@graph":[{"@id":"_:e499afaf13813dc5c9b07834ab4ab0fad05482d516ad71036c464171051f6f65_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"bce9d2f12f25e10c91ac72855179ae6e"},{"@id":"_:e499afaf13813dc5c9b07834ab4ab0fad05482d516ad71036c464171051f6f65_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73/resource/0ebd2862-4a11-4fbb-97dd-27ca02422e01"},{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73/resource/3514b028-ee18-40f7-abc8-29a0669a1962"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af husstande divideret med antallet af personer i husstanden.\nHusstand betyder beboelseshusstande. Alle personer, der er registreret i samme\nlejlighed, tælles derfor som den samme husstand. Yderligere information om\nhusstandsstatistik kan findes i Statistiska Centralbyråns dokument\n\"Registerbaseret husstandsstatistik\". Data fra Befolkningsregisteret (RTB).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of households divided by the number of people in the\nhousehold. Household means residential households. All people registered in\nthe same apartment are therefore counted as the same household. More\ninformation about household statistics can be found in Statistics Sweden's\ndocument \"Register-based household statistics\". Data from the Register of\nTotal Population (RTB).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antal hushåll uppdelat efter antal personer i hushållet. Hushåll innebär bostadshushåll. Alla personer som är registrerade i samma lägenhet räknas alltså till samma hushåll. Mer information kring hushållsstatistik finns i SCB:s dokument ”Registerbaserad hushållsstatistik”. Data från Registret över Totalbefolkningen (RTB).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"151d04bf-2569-4450-a357-87fcaa145a73","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:16.156573"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e499afaf13813dc5c9b07834ab4ab0fad05482d516ad71036c464171051f6f65_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Husstandsstørrelse - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Household size - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Hushållsstorlek - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73/resource/0ebd2862-4a11-4fbb-97dd-27ca02422e01","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73/resource/0ebd2862-4a11-4fbb-97dd-27ca02422e01/download/hushallsstorlek.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"681612"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Husstandsstørrelse\n\n"},{"@language":"en","@value":"Malmö statistics - Household size\n\n"},{"@language":"sv","@value":"Malmö statistik - Hushållsstorlek"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:12.155261"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:16.162228"},"dct:title":[{"@language":"da","@value":"Husstandens størrelse"},{"@language":"en","@value":"Household size"},{"@language":"sv","@value":"Hushållsstorlek"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:e499afaf13813dc5c9b07834ab4ab0fad05482d516ad71036c464171051f6f65_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/151d04bf-2569-4450-a357-87fcaa145a73/resource/3514b028-ee18-40f7-abc8-29a0669a1962","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=0ebd2862-4a11-4fbb-97dd-27ca02422e01"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Husstandsstørrelse\n\n"},{"@language":"en","@value":"Malmö statistics - Household size\n\n"},{"@language":"sv","@value":"Malmö statistik - Hushållsstorlek"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:16.566055"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:23.629062"},"dct:title":[{"@language":"da","@value":"Husstandens størrelse"},{"@language":"en","@value":"Household size"},{"@language":"sv","@value":"Hushållsstorlek"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:e499afaf13813dc5c9b07834ab4ab0fad05482d516ad71036c464171051f6f65"},{"@graph":[{"@id":"_:e4ab0184bb9dce2507600ab604cf819e06d8111479c3abfa594ff8af2ec13077_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/590e717ed624870c5e5af379a019ac72","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"GIS-enheten, Stadsbyggnadskontoret, Malmö stad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sbk.geodata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/140830ba-9850-4f01-a1a3-a7e79821a2b7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/590e717ed624870c5e5af379a019ac72"},"dcat:keyword":["Malmö stad","adresser","geodata","gis","karta","map","postnummer"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"da","@value":"### Malmø Kommune ophører med at offentliggøre adressedata på byens åbne\ndataportal (opendata.malmo.se)\n\nOffentliggørelse af adressedata (lokationsadresser) er ikke kompatibel med de\nnuværende licensvilkår i henhold til geodatasamarbejdet med Lantmäteriet.\nLicensvilkårene begrænser yderligere brug og deling med tredjeparter.  \nDerudover kan adresseoplysninger udgøre personoplysninger, hvilket medfører\nyderligere begrænsninger i henhold til databeskyttelseslovgivningen.  \nMalmø Kommunes offentliggørelse af adressedata på opendata.malmo.se anses\nderfor for at mangle retsgrundlag.\n\n**Adressedata vil ikke længere blive offentliggjort på opendata.malmo.se fra\n1-09-2026.**\n\nAdresser på lokationer stilles til rådighed af Lantmäteriet under særlige\nbetingelser. Se https://www.lantmateriet.se/sv/geodata/vara%2dprodukter/.\n\n"},{"@language":"en","@value":"### The City of Malmö ceases publishing address data on the city's open data\nportal (opendata.malmo.se)\n\nPublishing address data (location addresses) is not compatible with the\ncurrent license terms according to geodata collaboration with Lantmäteriet.\nThe license terms restrict further use and sharing with third parties.  \nFurthermore, address data may constitute personal data, which entails further\nrestrictions under data protection legislation.  \nThe City of Malmö's publication of address data on opendata.malmo.se is\ntherefore considered to lack legal basis.\n\n**Address data will no longer be published on opendata.malmo.se from\n2026-09-01.**\n\nLocation addresses are made available by Lantmäteriet under special\nconditions. See https://www.lantmateriet.se/sv/geodata/vara%2dprodukter/.\n\n"},{"@language":"sv","@value":"### Malmö stad upphör med publicering av adressdata på stadens öppna data-portal (opendata.malmo.se)  \nPublicering av adressdata (belägenhetsadresser) är inte förenlig med gällande licensvillkor enligt geodatasamverkan med Lantmäteriet. Licensvillkoren begränsar vidareutnyttjande och delning till tredje part.  \nVidare kan adressdata utgöra personuppgifter, vilket innebär ytterligare begränsningar enligt dataskyddslagstiftningen.  \nMalmö stads publicering av adressdata på opendata.malmo.se bedöms därför sakna rättslig grund.  \n  \n**Adressdata kommer inte längre att publiceras på opendata.malmo.se från och med 2026-09-01.**  \n\nBelägenhetsadresser tillgängliggörs av Lantmäteriet under särskilda villkor. Se https://www.lantmateriet.se/sv/geodata/vara-produkter/.  "}],"dct:identifier":"140830ba-9850-4f01-a1a3-a7e79821a2b7","dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-02T10:36:50.719626"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-01T10:34:45.140232"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e4ab0184bb9dce2507600ab604cf819e06d8111479c3abfa594ff8af2ec13077_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Adresser"},{"@language":"en","@value":"Addresses"},{"@language":"sv","@value":"Adresser"}]}],"@id":"urn:source:e4ab0184bb9dce2507600ab604cf819e06d8111479c3abfa594ff8af2ec13077"},{"@graph":[{"@id":"_:e4e1961c802f1c5838b39b0acd91a45bc02c9e1bda5a2c01dd59ba8d4a850092_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/0d3672c5-50bd-4b09-92af-77682fd5fedf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/0d3672c5-50bd-4b09-92af-77682fd5fedf/resource/6f673526-4065-4f94-b4f0-23dc5b4c0348"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal personer, der er flyttet ud af kommunen. Henviser til indenlandske\nmigranter + emigranter.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Number of people who moved out of the municipality. Refers to domestic\nmigrants + emigrants.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal Utflyttade från kommunen. Avser inrikes utflyttade + emigrerade.  \n  \nKälla: SCB (via Kolada)"}],"dct:identifier":"0d3672c5-50bd-4b09-92af-77682fd5fedf","dct:issued":{"@type":"xsd:date","@value":"2022-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:27:04.400715"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e4e1961c802f1c5838b39b0acd91a45bc02c9e1bda5a2c01dd59ba8d4a850092_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Personer der flytter ud af kommunen, antal"},{"@language":"en","@value":"People moving out of the municipality, number"},{"@language":"sv","@value":"Utflyttade från kommunen, antal"}]},{"@id":"https://opendata-api.malmo.se/dataset/0d3672c5-50bd-4b09-92af-77682fd5fedf/resource/6f673526-4065-4f94-b4f0-23dc5b4c0348","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N01802"},"dct:description":[{"@language":"da","@value":"Antal personer, der er flyttet ud af kommunen. Henviser til indenlandske\nmigranter + emigranter.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Number of people who moved out of the municipality. Refers to domestic\nmigrants + emigrants.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal Utflyttade från kommunen. Avser inrikes utflyttade + emigrerade.  \n  \nKälla: SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-08T12:16:29.443302"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:27:04.405174"},"dct:title":[{"@language":"da","@value":"Personer der flytter ud af kommunen, antal"},{"@language":"en","@value":"People moving out of the municipality, number"},{"@language":"sv","@value":"Utflyttade från kommunen, antal"}]}],"@id":"urn:source:e4e1961c802f1c5838b39b0acd91a45bc02c9e1bda5a2c01dd59ba8d4a850092"},{"@graph":[{"@id":"_:e7e7df50b0472ad1162738c37e3925f944ed697ef7393e6d54856ae38fbaebbc_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"5caf36aef5e7144364eb4ff96f6bc0f4"},{"@id":"_:e7e7df50b0472ad1162738c37e3925f944ed697ef7393e6d54856ae38fbaebbc_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"34f4f16203d4f080df40882dcca01489"},{"@id":"_:e7e7df50b0472ad1162738c37e3925f944ed697ef7393e6d54856ae38fbaebbc_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/590e717ed624870c5e5af379a019ac72","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"GIS-enheten, Stadsbyggnadskontoret, Malmö stad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sbk.geodata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/590e717ed624870c5e5af379a019ac72"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/239c0ce0-aacc-4554-9eb2-d760a0e57d13"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/2b50e053-6cd2-4423-9a1a-ad1d0747e566"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/67a9bb27-2987-4b7d-83e5-21d5ea69f3a1"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/76d6c065-8284-4972-91fb-4d75d07233f7"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/be906a4b-3488-4b50-bc77-4beeee2ab8fc"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/d08f915d-5148-4781-aefe-1bbe2af76e9b"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/e89187a8-6c9d-4f15-bd44-e5f52b5624ce"},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/f97154fa-92fd-4404-9910-fa79ccfe0617"}],"dcat:keyword":["Administrativ indelning","Geografiskt informationssystem","Karta","Malmö stad","Map","Stadsområde","gis"],"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":[{"@language":"da","@value":"Kortlag, der viser de geografiske driftsområder for de daværende 10\ndistriktsforvaltninger i Malmø Kommune. Opdelingen var gyldig fra 1996 til\n2013. Distriktsforvaltningsområder var en politisk besluttet opdeling baseret\npå det geografiske driftsområde for distriktsforvaltningerne i byen. For den\nnuværende geografiske opdeling af byen henvises til delområder. Kortlaget\nopdateres ikke. Polygonlag\n\n"},{"@language":"en","@value":"Map layer showing the geographical areas of operation of the then 10 district\nadministrations in Malmö Municipality. The division was valid from 1996 to\n2013. District administration areas were a politically decided division based\non the geographical area of ​​operation of the district administrations in the\ncity. For the current geographical division of the city, reference is made to\nsub-areas. The map layer is not updated. Polygon layer\n\n"},{"@language":"sv","@value":"Kartlager som visar de dåvarande 10 stadsdelsförvaltningarnas geografiska verksamhetsområden i Malmö kommun. Indelningen gällde 1996 - 2013. Stadsdelsförvaltningsområden var en politiskt beslutad indelning baserad på \nstadsdelsförvaltningarnas geografiska verksamhetsområde i staden. För gällande geografisk indelning av staden hänvisas\ntill delområden.\nKartlagret uppdateras inte.\nPolygonlager"}],"dct:identifier":"3b1e0328-2c40-4400-88f0-0f84c9327955","dct:issued":{"@type":"xsd:date","@value":"2026-05-22"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-04T08:04:32.708960"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:e7e7df50b0472ad1162738c37e3925f944ed697ef7393e6d54856ae38fbaebbc_b2n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Kvarterer"},{"@language":"en","@value":"Neighborhoods"},{"@language":"sv","@value":"Stadsdelar"}]},{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/239c0ce0-aacc-4554-9eb2-d760a0e57d13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/3b1e0328-2c40-4400-88f0-0f84c9327955/resource/239c0ce0-aacc-4554-9eb2-d760a0e57d13/download/stadsdelar_