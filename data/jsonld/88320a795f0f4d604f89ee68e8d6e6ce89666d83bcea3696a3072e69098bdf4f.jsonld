:"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T14:38:08.811355"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-08T17:22:23.831325"},"dct:title":[{"@language":"da","@value":"Strålingstemperatur maksimal varme ekstrem varme RCP8.5 2100"},{"@language":"en","@value":"Radiation temperature maximum heat extreme heat RCP8.5 2100"},{"@language":"sv","@value":"Strålningstemperatur maxvärme extremvärme RCP8,5 2100"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/628ec077-1132-410a-9efc-f4ff5e50434f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/628ec077-1132-410a-9efc-f4ff5e50434f/download/stralningstemperatur_antal_timmar_extremvarme_nutid_rcp8_5_2100.gpkg"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T14:37:16.895839"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-08T17:54:42.844775"},"dct:title":[{"@language":"da","@value":"Strålingstemperatur antal timer over 60 ekstrem varme RCP8.5 2100"},{"@language":"en","@value":"Radiation temperature number of hours above 60 extreme heat RCP8.5 2100"},{"@language":"sv","@value":"Strålningstemperatur antal timmar över 60 extremvärme RCP8,5 2100"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/70cc528e-afce-412c-a938-f6f0599ed7ac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/70cc528e-afce-412c-a938-f6f0599ed7ac/download/malmo_slutrapport_tradsarbarhet_2026-03-26.pdf"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"5581438"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-27T07:50:18.089144"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-31T12:27:01.473260"},"dct:title":[{"@language":"da","@value":"Endelig rapport om træers sårbarhed"},{"@language":"en","@value":"Final report on tree vulnerability"},{"@language":"sv","@value":"Slutrapport trädsårbarhet"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/75f4ebfd-b4d4-4a35-9919-2b4ead6202e2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/75f4ebfd-b4d4-4a35-9919-2b4ead6202e2/download/04_1994-07-26-rcp85-2100.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:53:34.868158"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:04:48.678367"},"dct:title":[{"@language":"da","@value":"04_1994-07-26 RCP8.5 2100"},{"@language":"en","@value":"04_1994-07-26 RCP8.5 2100"},{"@language":"sv","@value":"04_1994-07-26 RCP8,5 2100"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/8dcae5a6-97f5-4b48-ba9b-b31aba302902","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/8dcae5a6-97f5-4b48-ba9b-b31aba302902/download/06_1994-07-26-rcp45-2100.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:53:54.975237"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:07:22.278849"},"dct:title":[{"@language":"da","@value":"06_1994-07-26 RCP4.5 2100"},{"@language":"en","@value":"06_1994-07-26 RCP4.5 2100"},{"@language":"sv","@value":"06_1994-07-26 RCP4,5 2100"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/90a9f99f-fb1f-4ce9-9141-ae024ccacc96","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/90a9f99f-fb1f-4ce9-9141-ae024ccacc96/download/01_1994-07-26-nutid.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:52:54.423785"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T13:58:07.836418"},"dct:title":[{"@language":"da","@value":"01_1994-07-26 NU"},{"@language":"en","@value":"01_1994-07-26 PRESENT"},{"@language":"sv","@value":"01_1994-07-26 NUTID"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/b2ffd7d3-6654-4b55-a856-46fbc85fc7f1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/b2ffd7d3-6654-4b55-a856-46fbc85fc7f1/download/09_2022-06-24-rcp45-2050.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:54:30.186934"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:11:30.252827"},"dct:title":[{"@language":"da","@value":"09_2022-06-24 RCP4.5 2050"},{"@language":"en","@value":"09_2022-06-24 RCP4