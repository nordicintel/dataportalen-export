b166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/513ae6b8-5d25-43df-987a-59cc9db0c422/resource/75b55bb1-c989-44d9-9807-357c95882908"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal fødsler i løbet af året. Statistik fra 1998.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of births during the year. Statistics from 1998.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal födda under året. Statistik från 1998.\n\nKälla: SCB."}],"dct:identifier":"513ae6b8-5d25-43df-987a-59cc9db0c422","dct:issued":{"@type":"xsd:date","@value":"2020-12-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:43:02.645246"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:eab2324e80d2420ee61270f1a70b19779a4112e7e83dfcb876ea6724200452dd_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Fødsler, antal"},{"@language":"en","@value":"Births, number"},{"@language":"sv","@value":"Födda, antal"}]},{"@id":"https://opendata-api.malmo.se/dataset/513ae6b8-5d25-43df-987a-59cc9db0c422/resource/75b55bb1-c989-44d9-9807-357c95882908","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N01804"},"dct:description":[{"@language":"da","@value":"Antal fødsler i løbet af året. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of births during the year. Source: Kolada\n\n"},{"@language":"sv","@value":" Antal födda under året. Källa: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-11T12:50:16.732803"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:43:02.649271"},"dct:title":[{"@language":"da","@value":"Fødsler, antal (N01804)"},{"@language":"en","@value":"Births, number (N01804)"},{"@language":"sv","@value":"Födda, antal (N01804)"}]}],"@id":"urn:source:eab2324e80d2420ee61270f1a70b19779a4112e7e83dfcb876ea6724200452dd"},{"@graph":[{"@id":"_:eb64d0c3bae58952de392068da0288eaeb9ac24334fc9b204edb930279ca6ff3_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/f0ff6507-7a2a-4e44-9092-c40f1104c172","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/f0ff6507-7a2a-4e44-9092-c40f1104c172/resource/8a233031-b58b-456b-b8cd-6f8bf8047410"},"dcat:keyword":["Malmö stad","polisen"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Datasættet indeholder de 500 seneste hændelsesrapporter fra politiet\nvedrørende begivenheder i Malmø. Rapporterne giver kort information om et\nudvalg af de opkald, som politiet har foretaget i Malmø.  \nBemærk venligst, at meddelelserne er baseret på foreløbige oplysninger om\nbegivenheder. Det betyder, at oplysningerne kan ændre sig.\n\n**Regler for brug af politiets åbne data og API'er**  \nhttps://polisen.se/om%2dpolisen/om%2dwebbplatsen/oppna%2ddata/regler%2dfor%2doppna%2ddata/\n\nKilde: Svenske Politimyndigheder (via polisen.se)\n\n"},{"@language":"en","@value":"The dataset contains the 500 most recent incident reports from the police,\nconcerning events in Malmö. The reports provide brief information about a\nselection of the calls made by the police in the city of Malmö.  \nPlease note that the notices are based on preliminary information about\nevents. This means that the information may change.\n\n**Rules for using police open data and APIs**  \nhttps://polisen.se/om%2dpolisen/om%2dwebbplatsen/oppna%2ddata/regler%2dfor%2doppna%2ddata/\n\nSource: Swedish Police Authority (via polisen.se)\n\n"},{"@language":"sv","@value":"Datamängden innehåller de 500 senaste händelsenotiserna från polisen, rörande händelser i Malmö. Notiserna ger kortfattad information om ett urval av de utryckningar som polisen gör i Malmö stad.  \nObservera att det är inledande uppgifter om händelser som ligger till grund för notiserna. Det betyder att uppgifterna kan komma att ändras.  \n  \n**Regler för användning av polisens öppna data och API:er**  \nhttps://polisen.se/om-polisen/om-webbplatsen/oppna-data/regler-for-oppna-data/\n  \nKälla: Polismyndigheten (via polisen.se)"}],"dct:identifier":"f0ff6507-7a2a-4e44-9092-c40f1104c172","dct:issued":{"@type":"xsd:date","@value":"2022-12-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T16:21:01.770579"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:eb64d0c3bae58952de392068da0288eaeb9ac24334fc9b204edb930279ca6ff3_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Politibegivenheder Malmø"},{"@language":"en","@value":"Police events Malmö"},{"@language":"sv","@value":"Polisens händelser Malmö"}]},{"@id":"https://opendata-api.malmo.se/dataset/f0ff6507-7a2a-4e44-9092-c40f1104c172/resource/8a233031-b58b-456b-b8cd-6f8bf8047410","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://polisen.se/api/events?locationname=Malm%C3%B6"},"dct:description":[{"@language":"da","@value":"Datasættet indeholder de 500 seneste hændelsesrapporter fra politiet\nvedrørende begivenheder i Malmø. Rapporterne giver kort information om et\nudvalg af de opkald, som politiet har foretaget i Malmø.  \nBemærk venligst, at meddelelserne er baseret på foreløbige oplysninger om\nbegivenheder. Det betyder, at oplysningerne kan ændre sig.\n\n**Regler for brug af politiets åbne data og API'er**  \nhttps://polisen.se/om%2dpolisen/om%2dwebbplatsen/oppna%2ddata/regler%2dfor%2doppna%2ddata/\n\nKilde: Svenske Politimyndigheder (via polisen.se)\n\n"},{"@language":"en","@value":"The dataset contains the 500 most recent incident reports from the police,\nconcerning events in Malmö. The reports provide brief information about a\nselection of the calls made by the police in the city of Malmö.  \nPlease note that the notices are based on preliminary information about\nevents. This means that the information may change.\n\n**Rules for using police open data and APIs**  \nhttps://polisen.se/om%2dpolisen/om%2dwebbplatsen/oppna%2ddata/regler%2dfor%2doppna%2ddata/\n\nSource: Swedish Police Authority (via polisen.se)\n\n"},{"@language":"sv","@value":"Datamängden innehåller de 500 senaste händelsenotiserna från polisen, rörande händelser i Malmö. Notiserna ger kortfattad information om ett urval av de utryckningar som polisen gör i Malmö stad.  \nObservera att det är inledande uppgifter om händelser som ligger till grund för notiserna. Det betyder att uppgifterna kan komma att ändras.  \n  \n**Regler för användning av polisens öppna data och API:er**  \nhttps://polisen.se/om-polisen/om-webbplatsen/oppna-data/regler-for-oppna-data/\n  \nKälla: Polismyndigheten (via polisen.se)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-15T14:07:43.788018"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T16:20:57.393324"},"dct:title":[{"@language":"da","@value":"Politibegivenheder Malmø"},{"@language":"en","@value":"Police events Malmö"},{"@language":"sv","@value":"Polisens händelser Malmö"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:eb64d0c3bae58952de392068da0288eaeb9ac24334fc9b204edb930279ca6ff3"},{"@graph":[{"@id":"_:ec43441e0fae5e959f0474c8a7d33c33513dde4948d4b7b0ce7994c3816ba681_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4640341000"}},{"@id":"_:ec43441e0fae5e959f0474c8a7d33c33513dde4948d4b7b0ce7994c3816ba681_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/155fe08a3c2cd31689f13de2b1fbdc76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Malmö stad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:malmostad@malmo.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ec43441e0fae5e959f0474c8a7d33c33513dde4948d4b7b0ce7994c3816ba681_b0n0"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c914ed8b-8ce2-42cd-a138-e501215ef8b2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/155fe08a3c2cd31689f13de2b1fbdc76"},"dcat:keyword":["EV","Malmö stad","charging","elbil","elfordon","laddning","laddpunkter","laddstationer","laddstolpar"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"da","@value":"Malmø kommune stiller i øjeblikket ingen kommunalt arrangerede ladestandere\ntil rådighed til offentlig brug.\n\nFor opladning af elbiler i Malmø by henvises til aktører, der tilbyder\noffentlige ladepunkter, såsom parkeringsselskaber, tankstationer,\nelleverandører og detailhandlere.\n\n"},{"@language":"en","@value":"The city of Malmö currently does not provide any municipally arranged charging\npoints for public use.\n\nFor charging electric vehicles in the city of Malmö, please refer to actors\nwho offer public charging points, such as parking companies, gas stations,\nelectricity suppliers and retailers.\n\n"},{"@language":"sv","@value":"Malmö stad tillhandahåller för närvarande inga kommunalt anordnade laddpunkter för allmänt bruk.\n\nFör laddning av elfordon i Malmö stad hänvisas till aktörer som erbjuder offentliga laddplatser, t.ex. parkeringsbolag, mackar, el-leverantörer och detaljhandel."}],"dct:identifier":"c914ed8b-8ce2-42cd-a138-e501215ef8b2","dct:issued":{"@type":"xsd:date","@value":"2022-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T14:58:10.530524"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ec43441e0fae5e959f0474c8a7d33c33513dde4948d4b7b0ce7994c3816ba681_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Ladestationer til elbiler"},{"@language":"en","@value":"Charging stations for electric vehicles"},{"@language":"sv","@value":"Laddstationer för elfordon"}]}],"@id":"urn:source:ec43441e0fae5e959f0474c8a7d33c33513dde4948d4b7b0ce7994c3816ba681"},{"@graph":[{"@id":"_:ecf7c4a0ee281cd4d4b200f97be18209f09a733a3c84573c76bc0a3bb5eb758d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/9db12bd2-6539-4cb6-95ee-67af969ef471","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/9db12bd2-6539-4cb6-95ee-67af969ef471/resource/2c4cdb1c-b782-4952-8ab4-0160fcd445c7"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\ngymnasiet, SEK pr. indbygger. Nettoomkostninger er bruttoomkostninger minus\nbruttoindkomst.\n\nReferenceomkostningerne er baseret på nettoomkostningerne ved\ngymnasieuddannelser i landet, andelen af ​​16-18-årige i kommunen, elevernes\nprogramvalg og antagelser om meromkostninger til små skoler, skoletransport og\nindkvarteringsgodtgørelser. Derudover lægges en del af standardomkostningerne\nfra delmodellerne lønninger, bygningsstruktur og befolkningsudvikling til.\n\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier indikerer en lavere omkostningssituation end\nstatistisk forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR.\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for upper\nsecondary school, SEK per inhabitant. Net cost is gross cost minus gross\nincome.\n\nThe reference cost is based on the net cost of upper secondary school in the\ncountry, the proportion of 16-18 year olds in the municipality, the students'\nprogram choices and assumptions about additional costs for small schools,\nschool transport and accommodation allowances. In addition, part of the\nstandard costs from the sub-models of salaries, building structure and\npopulation development are added.\n\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​indicate a lower cost situation than statistically\nexpected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR.\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för gymnasieskolan, kronor per invånare. Nettokostnad är bruttokostnad minus bruttointäkt. \n\nReferenskostnaden bygger på nettokostnaden för gymnasieskola i riket, andel 16-18-åringar i kommunen, elevernas programval samt antaganden om merkostnader för små skolor, skolskjuts och inackorderingsbidrag. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. \n\nPositiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. \n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR."}],"dct:identifier":"9db12bd2-6539-4cb6-95ee-67af969ef471","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:34:42.428522"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ecf7c4a0ee281cd4d4b200f97be18209f09a733a3c84573c76bc0a3bb5eb758d_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse, gymnasium, procent"},{"@language":"en","@value":"Net cost deviation, upper secondary school, percent"},{"@language":"sv","@value":"Nettokostnadsavvikelse gymnasieskola, procent"}]},{"@id":"https://opendata-api.malmo.se/dataset/9db12bd2-6539-4cb6-95ee-67af969ef471/resource/2c4cdb1c-b782-4952-8ab4-0160fcd445c7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17001"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\ngymnasiet, SEK/indbygger. Nettoomkostningerne er bruttoomkostninger minus\nbruttoindkomst. Referenceomkostningerne er baseret på nettoomkostningerne for\ngymnasiet i landet, andelen af ​​16-18-årige i kommunen, elevernes programvalg\nog antagelser om meromkostninger for små skoler, skoletransport og\nkosttilskud. Derudover lægges en del af standardomkostningerne fra\ndelmodellerne lønninger, bygningsstruktur og befolkningsudvikling til.\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier en lavere omkostningssituation end statistisk\nforventet. Fra og med 2019 beregnes nettoomkostningsafvigelsen på en ny måde\npå grund af ændringer i omkostningsudligningen. Dette påvirker\nsammenligneligheden med tidligere år. Kilde: Kolada\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for upper\nsecondary school, SEK/inhabitant. Net cost is gross cost minus gross income.\nThe reference cost is based on the net cost of upper secondary school in the\ncountry, the proportion of 16-18 year olds in the municipality, the students'\nprogram choice and assumptions about additional costs for small schools,\nschool transport and boarding grants. In addition, part of the standard costs\nfrom the sub-models salaries, building structure and population development\nare added. Positive values ​​indicate a higher cost situation than\nstatistically expected and negative values ​​a lower cost situation than\nstatistically expected. From 2019 onwards, the net cost deviation is\ncalculated in a new way due to changes in cost equalization. This affects\ncomparability with previous years. Source: Kolada\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för gymnasieskolan, kr/inv. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnaden för gymnasieskola i riket, andel 16-18-åringar i kommunen, elevernas programval samt antaganden om merkostnader för små skolor, skolskjuts och inackorderingsbidrag. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat.  Från och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt pga förändringar i kostnadsutjämningen.  Detta påverkar jämförbarheten med tidigare år. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T08:42:36.421960"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:34:42.451176"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsvarians, gymnasium (%) (N17001)"},{"@language":"en","@value":"Net cost variance, upper secondary school, (%) (N17001)"},{"@language":"sv","@value":"Nettokostnadsavvikelse gymnasieskola, (%) (N17001)"}]}],"@id":"urn:source:ecf7c4a0ee281cd4d4b200f97be18209f09a733a3c84573c76bc0a3bb5eb758d"},{"@graph":[{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"d297608bb3e74fe365d49ac394ea5f88"},{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/0063da1b-34e9-4679-9b7c-007eed4080f5"},{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/bc044d97-5e67-4db7-b3c1-669da8822794"}],"dcat:keyword":["Malmö stad","byvind","globalstrålning","jorddemperatur","luftfuktighet","lufttryck","meteorologi","nederbörd","nettostrålning","strålning","temperatur","vindhastighet","vindriktning"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Måledata fra Miljøforvaltningens meteorologiske mast på Heleneholm.  \n  \nParameter|  Info|  Gennemsnitlig periode|  Start og andre oplysninger  \n---|---|---|---  \nTemperatur 2,5 m|  Målt i en højde på cirka 2,5 meter i grader Celsius (°C)|\n1 time|  april 1991  \nTemperaturforskel 8 til 2,5 m|  Temperaturforskel mellem 8 og 2,5 meter i\ngrader Celsius (°C)|  1 time|  april 1991  \nTemperaturforskel 24 til 8 m|  Temperaturforskel mellem 24 og 8 meter i grader\nCelsius (°C)|  1 time|  april 1991  \nVindhastighed 10 m|  Målt i meter pr. sekund (m/s) i en højde på 10 meter|  1\ntime|  april 1991  \nVindretning 10 m|  Målt i grader, mellem 0 og 360 (°) i en højde af 10 meter|\n1 time|  april 1991  \nModvind 10 m|  Maksimal gennemsnitlig vindhastighed i løbet af 10 sekunder i\ntimen (m/s) i 10 meters højde|  Maksimal vindhastighed i løbet af 1 time|\nAugust 2002  \nVindhastighed 24 m|  Målt i meter pr. sekund (m/s) i en højde af 24 meter|  1\ntime|  april 1991  \nVindretning 24 m|  Målt i grader, mellem 0 og 360 (°) i en højde af 24 meter|\n1 time|  april 1991  \nModvind 24 m|  Maksimal gennemsnitlig vindhastighed i løbet af 10 sekunder i\ntimen i meter i sekundet (m/s) i en højde af 24 meter|  Maksimal vindhastighed\ni løbet af 1 time|  August 2002  \nGlobal stråling|  Total indkommende kortbølgestråling fra solen og refleksion\nfra skyer, partikler osv. Enheden er watt pr. kvadratmeter (W/m²). Målt i en\nhøjde på 2,5 meter.|  1 time|  april 1991  \nNettostråling|  Indgående eller udgående langbølget stråling (IR). Negative\nværdier = udgående stråling og positive værdier = indgående stråling. Enheden\ner watt pr. kvadratmeter (W/m²).|  1 time|  Dec. 2008. Mellem januar 2016 og\nmaj 2018 var udstyret ude af drift.  \nRelativ luftfugtighed|  Målt i procent mellem 0 og 100 procent og målt i en\nhøjde på 2,5 meter|  1 time|  August 2002  \nNedbør|  Antal millimeter i timen (mm/t) målt i en højde på 2 meter|  1 time|\napril 1991  \nTryk|  Målt som det aktuelle lufttryk ved målestationen (ca. 11 meter over\nhavets overflade) i hektopascal (hPa), hvilket svarer til det ældre udtryk\nmillibar (mbar) og måles i en højde af 2,5 meter.|  1 time|  August 2002  \nJordtemperatur|  Målt 10 cm under græsoverfladen ved masten i grader Celsius\n(°C)|  1 time|  December 2008, med en pause fra juli 2014 til juni 2017\n\n"},{"@language":"en","@value":"Measurement data from the Environmental Administration's meteorological mast\nat Heleneholm.\n\nParameter|  Info|  Average period|  Start and other information  \n---|---|---|---  \nTemperature 2.5 m|  Measured at a height of approximately 2.5 meters in\ndegrees Celsius (°C)|  1 hour|  April 1991  \nDiff temp 8 to 2.5 m|  Temperature difference between 8 and 2.5 meters in\ndegrees Celsius (°C)|  1 hour|  April 1991  \nDiff temp 24 to 8 m|  Temperature difference between 24 and 8 meters in\ndegrees Celsius (°C)|  1 hour|  April 1991  \nWind speed 10 m|  Measured in meters per second (m/s) at a height of 10\nmeters|  1 hour|  April 1991  \nWind direction 10 m|  Measured in degrees, between 0 and 360 (°) at a height\nof 10 meters|  1 hour|  April 1991  \nHeadwind 10 m|  Maximum average wind speed during 10 seconds per hour (m/s) at\n10 meters height|  Maximum wind speed during 1 hour|  August 2002  \nWind speed 24 m|  Measured in meters per second (m/s) at a height of 24\nmeters|  1 hour|  April 1991  \nWind direction 24 m|  Measured in degrees, between 0 and 360 (°) at a height\nof 24 meters|  1 hour|  April 1991  \nHeadwind 24 m|  Maximum average wind speed during 10 seconds per hour in\nmeters per second (m/s) at a height of 24 meters|  Maximum wind speed during 1\nhour|  August 2002  \nGlobal radiation|  Total incoming shortwave radiation from the sun and\nreflection from clouds, particles, etc. The unit is watts per square meter\n(W/m²). Measured at a height of 2.5 meters|  1 hour|  April 1991  \nNet radiation|  Incoming or outgoing long-wave radiation (IR). Negative values\n​​= outgoing radiation and positive values ​​= incoming radiation. The unit is\nwatts per square meter (W/m²).|  1 hour|  Dec 2008. Between Jan 2016 and May\n2018 the equipment was out of order  \nRelative humidity|  Measured in percentage between 0 and 100 percent and\nmeasured at a height of 2.5 meters|  1 hour|  August 2002  \nRainfall|  Number of millimeters per hour (mm/h) measured at a height of 2\nmeters|  1 hour|  April 1991  \nPressure|  Measured as the current air pressure at the measuring station\n(approximately 11 meters above sea level) in hectopascals (hPa), which\ncorresponds to the older expression millibar (mbar) and is measured at a\nheight of 2.5 meters.|  1 hour|  August 2002  \nSoil temperature|  Measured 10 cm below the grassy ground surface at the mast\nin degrees Celsius (°C)|  1 hour|  Dec 2008, with a break July 2014 to June\n2017\n\n"},{"@language":"sv","@value":"Mätdata från miljöförvaltningens meteorologiska mast på Heleneholm. \n\n<table style=\"border-collapse: collapse; width: 100%;\">\n  <thead>\n    <tr>\n      <th style=\"border: 1px solid #000; padding: 6px; text-align: left;\">Parameter</th>\n      <th style=\"border: 1px solid #000; padding: 6px; text-align: left;\">Info</th>\n      <th style=\"border: 1px solid #000; padding: 6px; text-align: left;\">Medelperiod</th>\n      <th style=\"border: 1px solid #000; padding: 6px; text-align: left;\">Start och annan information</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Temperatur 2,5 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts på ca 2,5 meter höjd i grader Celsius (°C)</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Difftemp 8 till 2,5 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Temperaturskillnad mellan 8 och 2,5 meter i grader Celsius (°C)</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Difftemp 24 till 8 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Temperaturskillnad mellan 24 och 8 meter i grader Celsius (°C)</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Vindhastighet 10 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts i enheten meter per sekund (m/s) på 10 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Vindriktning 10 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts i grader, mellan 0 och 360 (°) på 10 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Byvind 10 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Maximala medelvinden under 10 sekunder per timme (m/s) på 10 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Maximala vindhastigheten under 1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Aug 2002</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Vindhastighet 24 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts i enheten meter per sekund (m/s) på 24 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Vindriktning 24 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts i grader, mellan 0 och 360 (°) på 24 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Byvind 24 m</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Maximala medelvinden under 10 sekunder per timme i meter per sekund (m/s) på 24 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Maximala vindhastigheten under 1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Aug 2002</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Globalstrålning</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Total inkommande kortvågig strålning från solen och reflektion från moln, partiklar mm. Enheten är watt per kvadratmeter (W/m²). Mäts på 2,5 meter höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Nettostrålning</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Inkommande eller utgående långvågig strålning (IR). Negativa värden = utgående strålning och positiva värden = inkommande strålning. Enheten är watt per kvadratmeter (W/m²).</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Dec 2008. Mellan jan 2016 och maj 2018 var utrustningen ur funktion</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Relativ fuktighet</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts i procent mellan 0 och 100 procent och mäts på 2,5 meter höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Aug 2002</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Nederbörd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Antal millimeter per timme (mm/t) mäts på 2 meter höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">April 1991</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Lufttryck</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts som aktuellt lufttryck vid mätstationen (ca 11 meter ovan havsytan) i hektopascal (hPa) vilket motsvarar det äldre uttrycket millibar (mbar) och mäts på 2,5 meters höjd</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Aug 2002</td>\n    </tr>\n    <tr>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Jordtemperatur</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Mäts 10 cm under den gräsbevuxna jordytan vid masten i grader Celsius (°C)</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">1 timme</td>\n      <td style=\"border: 1px solid #000; padding: 6px;\">Dec 2008, med ett avbrott juli 2014 till juni 2017</td>\n    </tr>\n  </tbody>\n</table>"}],"dct:identifier":"0821de64-af9a-44e8-b9aa-db702851bf96","dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-28T12:42:03.520215"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-09T12:02:18.891925"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b2n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Meteorologiske observationer"},{"@language":"en","@value":"Meteorological observations"},{"@language":"sv","@value":"Meteorologiska observationer"}]},{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/0063da1b-34e9-4679-9b7c-007eed4080f5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/0063da1b-34e9-4679-9b7c-007eed4080f5/download/meteorologisk-mast-pa-heleneholm.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"106496"},"dct:description":[{"@language":"da","@value":"Placering af mast, hvor målingerne foretages.\n\n"},{"@language":"en","@value":"Location of mast where measurements are taken.\n\n"},{"@language":"sv","@value":"Placering av mast där mätningarna är utförda."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-29T08:05:03.690522"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-01T13:33:10.953724"},"dct:title":[{"@language":"da","@value":"Meteorologisk mast ved Heleneholm"},{"@language":"en","@value":"Meteorological mast at Heleneholm"},{"@language":"sv","@value":"Meteorologisk mast på Heleneholm"}]},{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/bc044d97-5e67-4db7-b3c1-669da8822794","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/0821de64-af9a-44e8-b9aa-db702851bf96/resource/bc044d97-5e67-4db7-b3c1-669da8822794/download/meteorologisk-data-1991-2025.xlsx"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"38543777"},"dct:description":[{"@language":"da","@value":"Validerede måledata fra Miljøforvaltningens meteorologiske mast på Heleneholm.\n\n"},{"@language":"en","@value":"Validated measurement data from the Environmental Administration's\nmeteorological mast at Heleneholm.\n\n"},{"@language":"sv","@value":"Validerad mätdata från miljöförvaltningens meteorologiska mast på Heleneholm."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-28T12:43:36.651114"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-08T14:12:57.171618"},"dct:title":[{"@language":"da","@value":"Meteorologiske observationer 1991-04-05 til 2025-12-31"},{"@language":"en","@value":"Meteorological observations 1991-04-05 to 2025-12-31"},{"@language":"sv","@value":"Meteorologiska observationer 1991-04-05 till 2025-12-31"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d_b1n0"}}],"@id":"urn:source:ed75582b44219e6c9926dcda29c392ac32d4885cfe5d623eca76bdcf046e7d6d"},{"@graph":[{"@id":"_:ed770c97196c800b1e39be1c037bf5f82eb2d40c557bce235dd57e7682d5e90f_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"e1a9583a3f0e4930090b273c19f57e9ff9806ca3"},{"@id":"_:ed770c97196c800b1e39be1c037bf5f82eb2d40c557bce235dd57e7682d5e90f_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/f4db76db-8670-40be-bdf6-78630062c20d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/f4db76db-8670-40be-bdf6-78630062c20d/resource/ee835204-61b2-4f4b-830f-924f5882d34a"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal valgte repræsentanter (kommunalpolitikere) kvinder divideret med det\nsamlede antal valgte kommunalpolitikere ganget med 100. Valgte repræsentanter\nrefererer til medlemmer og stedfortrædere i byrådet, udvalg og byrådets udvalg\nsamt revisorer. Statistikkerne produceres kun hvert fjerde år, men i Kolada\noffentliggøres de ud over måleåret T også i årene T+1, T+2 og T+3.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Number of elected representatives (municipal politicians) women divided by the\ntotal number of elected municipal politicians, multiplied by 100. Elected\nrepresentatives refer to members and substitutes in the council, committees\nand council committees, and auditors. The statistics are only produced every\nfour years, but in Kolada, in addition to the measurement year T, they are\nalso published in years T+1, T+2 and T+3.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal förtroendevalda (kommunpolitiker) kvinnor dividerat med antal förtroendevalda kommunpolitiker totalt, multiplicerat med 100.  Med förtroendevalda avses ledamöter och ersättare i fullmäktige, nämnder och fullmäktigeberedningar samt revisorer. Statistiken tas bara fram vart fjärde år men i Kolada publiceras den förutom mätåret T även på år T+1, T+2 och T+3.  \n  \nKälla: SCB (via Kolada)"}],"dct:identifier":"f4db76db-8670-40be-bdf6-78630062c20d","dct:issued":{"@type":"xsd:date","@value":"2022-12-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:30.080143"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ed770c97196c800b1e39be1c037bf5f82eb2d40c557bce235dd57e7682d5e90f_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Kvinder blandt valgte kommunalpolitikere, procentdel (%)"},{"@language":"en","@value":"Women among elected municipal politicians, percentage (%)"},{"@language":"sv","@value":"Kvinnor bland förtroendevalda kommunpolitiker, andel (%)"}]},{"@id":"https://opendata-api.malmo.se/dataset/f4db76db-8670-40be-bdf6-78630062c20d/resource/ee835204-61b2-4f4b-830f-924f5882d34a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N05814"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2705"},"dct:description":[{"@language":"da","@value":"Antal valgte repræsentanter (kommunalpolitikere) kvinder divideret med det\nsamlede antal valgte kommunalpolitikere ganget med 100. Valgte repræsentanter\nrefererer til medlemmer og stedfortrædere i byrådet, udvalg og byrådets udvalg\nsamt revisorer. Statistikkerne produceres kun hvert fjerde år, men i Kolada\noffentliggøres de ud over måleåret T også i årene T+1, T+2 og T+3.\n\nKilde: Sveriges Statistik (via Kolada)\n\n"},{"@language":"en","@value":"Number of elected representatives (municipal politicians) women divided by the\ntotal number of elected municipal politicians, multiplied by 100. Elected\nrepresentatives refer to members and substitutes in the council, committees\nand council committees, and auditors. The statistics are only produced every\nfour years, but in Kolada, in addition to the measurement year T, they are\nalso published in years T+1, T+2 and T+3.\n\nSource: Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Antal förtroendevalda (kommunpolitiker) kvinnor dividerat med antal förtroendevalda kommunpolitiker totalt, multiplicerat med 100.  Med förtroendevalda avses ledamöter och ersättare i fullmäktige, nämnder och fullmäktigeberedningar samt revisorer. Statistiken tas bara fram vart fjärde år men i Kolada publiceras den förutom mätåret T även på år T+1, T+2 och T+3.  \n  \nKälla: SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-05T14:13:30.916123"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:47:30.085277"},"dct:title":[{"@language":"da","@value":"Kvinder blandt valgte kommunalpolitikere, procentdel (%)"},{"@language":"en","@value":"Women among elected municipal politicians, percentage (%)"},{"@language":"sv","@value":"Kvinnor bland förtroendevalda kommunpolitiker, andel (%)"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:ed770c97196c800b1e39be1c037bf5f82eb2d40c557bce235dd57e7682d5e90f_b0n0"}}],"@id":"urn:source:ed770c97196c800b1e39be1c037bf5f82eb2d40c557bce235dd57e7682d5e90f"},{"@graph":[{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"a8f183cccc2f56c202d2e89d04e45c1bdb76d441"},{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"2a4a6fbd5d3f4529ec379a42d8ad420da2693fd8"},{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/a94f26c8-9a5b-4370-be78-17ead4b3c35b"},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/aa741b21-015a-4916-a7c3-a837bfaced41"},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/ffc89ee5-2dd9-4be0-b233-548f58e176fc"}],"dcat:keyword":["GIS","Malmö stad","geodata","karta","krontäckning","map","träd","trädkrontäckning","vegetation"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"da","@value":"Analyse af kronedækningsgraden i Malmø baseret på laserdata fra 2022.\nOplysningerne viser andelen af ​​byens land, der er dækket af grønne områder,\nog som er over to meter fra jorden.\n\nFlyveperiode april.\n\n"},{"@language":"en","@value":"Analysis of the crown coverage rate in Malmö based on laser data from 2022.\nThe information shows the proportion of the city's land covered by greenery\nthat is over two meters from the ground.\n\nFlight period April.\n\n"},{"@language":"sv","@value":"Analys av krontäckningsgraden i Malmö baserad på laserdata från 2022. Informationen visar andelen av stadens mark som täcks av grönska som är över två meter från marken. \n\nFlygperiod april."}],"dct:identifier":"e4604123-d659-41d6-9011-3d7073fd1d14","dct:issued":{"@type":"xsd:date","@value":"2023-05-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-26T11:34:03.452934"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b3n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Trækroneoverdækning 2022"},{"@language":"en","@value":"Tree canopy cover 2022"},{"@language":"sv","@value":"Trädkrontäckning 2022"}]},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/a94f26c8-9a5b-4370-be78-17ead4b3c35b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/a94f26c8-9a5b-4370-be78-17ead4b3c35b/download/krontackning2022-0.3.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"156956102"},"dct:description":[{"@language":"da","@value":"Kronedækning over 2 meter. Polygonerne er forenklet ved hjælp af Douglas-\nPeucker-algoritmen med en tolerance på 0,3 meter.\n\nFlyveperiode april.\n\n"},{"@language":"en","@value":"Crown coverage over 2 meters. The polygons are simplified using the Douglas-\nPeucker algorithm with a tolerance of 0.3 meters.\n\nFlight period April.\n\n"},{"@language":"sv","@value":"Krontäckning över 2 meter. Polygonerna är förenklade med Douglas-Peucker algoritmen med en tolerans av 0.3 meter.\n\n\nFlygperiod april."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-23T07:55:43.218938"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-26T09:25:16.249039"},"dct:title":[{"@language":"da","@value":"Trækroneoverdækning 2022 - Forenklet"},{"@language":"en","@value":"Tree canopy cover 2022 - Simplified"},{"@language":"sv","@value":"Trädkrontäckning 2022 - Förenklad"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b1n0"}},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/aa741b21-015a-4916-a7c3-a837bfaced41","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/aa741b21-015a-4916-a7c3-a837bfaced41/download/krontackning_stil.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"985"},"dct:description":[{"@language":"da","@value":"Stilisering\n\n"},{"@language":"en","@value":"Stylization\n\n"},{"@language":"sv","@value":"Stilsättning"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-17T14:54:40.274896"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T22:06:16.447477"},"dct:title":[{"@language":"da","@value":"SLD-stil"},{"@language":"en","@value":"SLD Style"},{"@language":"sv","@value":"SLD Style"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/ffc89ee5-2dd9-4be0-b233-548f58e176fc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/e4604123-d659-41d6-9011-3d7073fd1d14/resource/ffc89ee5-2dd9-4be0-b233-548f58e176fc/download/krontackning-2022-over-2m.zip"},"dct:description":[{"@language":"da","@value":"Kronedækning over to meter.\n\nFlyveperiode april.\n\n"},{"@language":"en","@value":"Crown coverage over two meters.\n\nFlight period April.\n\n"},{"@language":"sv","@value":"Krontäckning över två meter. \n\nFlygperiod april."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-26T09:24:43.665917"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-26T11:34:03.460432"},"dct:title":[{"@language":"da","@value":"Trækroneoverdækning 2022"},{"@language":"en","@value":"Tree canopy cover 2022"},{"@language":"sv","@value":"Trädkrontäckning 2022"}]}],"@id":"urn:source:ef8dfda60882f68eef66be77bef1eafcc939b8073a954370bec3377d260a38d1"},{"@graph":[{"@id":"_:f14eaec83214fe954f576bf108b44e2054cf2e22fd941edecd61663a78687589_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"b405cc6ce90c3ef8212c609e9dcd8d3d9b535da2"},{"@id":"_:f14eaec83214fe954f576bf108b44e2054cf2e22fd941edecd61663a78687589_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/0e4a6d0c-c50d-49a5-bdd7-6b21b3ff1c92"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/47ec10a6-cfd5-444d-8e66-cca17ff94f8b"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/5914b023-c533-4d6d-8088-b0bf345adc92"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/59546359-829f-42b9-8de6-f32d6c6b72e3"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/5a943ed5-a0bd-4a93-8d98-288e7115da8a"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/66678141-5daf-4ce8-a47b-40c092d3cf5f"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/66ac2be6-0d70-4e52-adc3-be1a274d7a15"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/6a367ffe-2cf8-4889-a6a0-0ffa5efc70c6"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/7ed39111-f5a2-4854-be07-687aac37c23a"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/aead93cc-e0c9-4ea0-a54b-c40243615afe"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/c394b482-6f5d-4b42-874d-bb559c9c8043"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/db53659a-f3b1-4815-aeba-a41f9c0ae430"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/e5a77552-f8f1-4083-9f32-995856301e49"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/e5ef7c4e-cde9-4cae-beaa-3c401b9407bb"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/e9e679cf-3b40-47bc-b368-aa137378b7e3"},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/fbb99f95-b0c0-41bf-bd58-368e988ac045"}],"dcat:keyword":["Malmö stad","cad","geodata","gis","karta","map","trafikreglering"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"da","@value":"Permanente vejmarkeringer findes på de fleste veje og bruges til at informere\ntrafikanterne om, hvad der gælder i forskellige trafiksituationer.  \nKortet viser vejmarkeringer på Malmøs byveje. Derudover indeholder kortet også\nvejmarkeringer på den ydre ringvej og individuelle vejmarkeringer.\nVejmarkeringerne er tegnet ud fra ortofotos taget i 2022 og er derfor ikke\nopmålt.  \nVejmarkeringerne er cirka 90% nøjagtige, men hvis du skal bruge dem i et\nprojekt, bør de måles og dobbelttjekkes.  \nProjekter bygget efter 2022, og for hvilke der ikke er modtaget\nrelationsdokumenter, er ikke inkluderet i vejmarkeringslagene. Oplysningerne i\nkildedatabasen opdateres hver anden uge.\n\nDataressourcerne består af en GeoJSON-fil, der gælder for hele Malmø by, et\nantal CAD-filer i DWG-format og en PDF-fil, der beskriver, hvordan hver CAD-\nfil relaterer sig til Malmø bys geografi.\n\n**Download vejmarkeringer i DWG-format**  \nVejmarkeringslagene er opdelt i såkaldte ark/kvadrater over byen, se den\nblandede opdeling. Hvert kvadrat har et nummer og viser en bestemt del af\nMalmø by. Find den gade/vej, du er interesseret i, og vælg derefter det\nkorrekte ark for at downloade de vejmarkeringer, du har brug for.\n\nMere information kan findes her:  \nhttps://malmo.se/Teknisk%2dhandbok/Trafikreglering/Permanent%2dtrafikreglering/Vagmarkering.html\n\n**Attributter i GeoJSON-filen**\n\n  * `typ` [type af vejmarkering¹]\n  * `timestamp` [dato for sidste opdatering af vejmarkørobjekt]\n  * `gid` [unik vejmarkeringsidentifikator]\n  * `geometry` [type: Polygon, CRS: WGS84]\n\n¹ [se IT-vejledningens bilag til\nlageret](https://web1.storegate.com/share/M0CTUw4/files)\n\n"},{"@language":"en","@value":"Permanent road markings are found on most roads and are used to inform road\nusers about what applies in different traffic situations.  \nThe map shows road markings on Malmö city roads. In addition, the map also\ncontains road markings on the Outer Ring Road and individual road markings.\nThe road markings are drawn from orthophotos taken in 2022 and are therefore\nnot measured.  \nThe road markings are approximately 90% accurate, but if you are going to use\nthem in a project, they should be measured and double-checked.  \nProjects built after 2022 and for which relationship documents have not been\nreceived are not included in the road marking layers. The information in the\nsource database is updated every two weeks.\n\nThe data resources consist of a GeoJSON file that applies to the entire city\nof Malmö, a number of CAD files in DWG format and a PDF file that describes\nhow each CAD file relates to the geography of the city of Malmö.\n\n**Download road markings in DWG format**  \nThe road marking layers are divided into so-called sheets/squares over the\ncity, see the mixed division. Each square has a number and shows a certain\npart of the city of Malmö. Locate the street/road you are interested in and\nthen select the correct sheet to download the road markings you need.\n\nMore information can be found here:  \nhttps://malmo.se/Teknisk%2dhandbok/Trafikreglering/Permanent%2dtrafikreglering/Vagmarkering.html\n\n**Attributes in the GeoJSON file**\n\n  * `typ` [type of road marking¹]\n  * `timestamp` [waymarker object's last update date]\n  * `gid` [unique road marking identifier]\n  * `geometry` [type: Polygon, CRS: WGS84]\n\n¹ [see IT Tutorial Appendix\nWarehouse](https://web1.storegate.com/share/M0CTUw4/files)\n\n"},{"@language":"sv","@value":"Permanenta vägmarkeringar finns på de flesta vägar och används för att upplysa trafikanter om vad som gäller i olika trafiksituationer.  \nKartan visar vägmarkeringar på Malmö stads vägar. Utöver detta finns på kartan även vägmarkeringar på Yttre ringvägen samt enstaka vägmarkeringar på enskild väg. Vägmarkeringarna är avritade från ortofoton tagna år 2022 och är därmed inte inmätta.   \nVägmarkeringarna stämmer till ca 90%, men ska man använda dessa i en projektering bör dessa mätas in och dubbelkollas.  \nProjekt som byggts efter 2022 och vars relationshandlingar inte inkommit finns inte med i vägmarkeringslagren. Informationen i källdatabasen uppdateras varannan vecka.  \n\nDataresurserna består av en GeoJSON-fil som gäller för hela Malmö stad, ett antal CAD-filer i formatet DWG och en PDF-fil som beskriver hur respektive CAD-fil anknyter till Malmö stads geografi.  \n\n__Ladda ner vägmarkeringar i DWG format__  \nVägmarkeringslagrena är indelade i så kallade blad/rutor över staden, se blandindelningen. Varje ruta har ett nummer och visar en viss del av Malmö stad. Lokalisera din gata/väg du är intresserad av och välj sedan rätt blad för att ladda ner de vägmarkeringarna du behöver.\n\nMer information finner du här:  \nhttps://malmo.se/Teknisk-handbok/Trafikreglering/Permanent-trafikreglering/Vagmarkering.html  \n\n__Attribut i GeoJSON-filen__  \n  \n+ `typ` [typ av vägmarkering¹]  \n+ `timestamp` [vägmarkeringsobjektets senaste uppdateringsdatum]  \n+ `gid` [unik identifierare för vägmarkering]  \n+ `geometry` [typ: Polygon, CRS: WGS84]  \n  \n¹ [se IT-Handledning Bilaga Lager](https://web1.storegate.com/share/M0CTUw4/files)"}],"dct:identifier":"46e78ddc-757d-4c39-8216-542efe2908a1","dct:issued":{"@type":"xsd:date","@value":"2024-06-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T01:38:20.863782"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:f14eaec83214fe954f576bf108b44e2054cf2e22fd941edecd61663a78687589_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Vejmarkeringer"},{"@language":"en","@value":"Road markings"},{"@language":"sv","@value":"Vägmarkeringar"}]},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/0e4a6d0c-c50d-49a5-bdd7-6b21b3ff1c92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/0e4a6d0c-c50d-49a5-bdd7-6b21b3ff1c92/download/vup_6160_115_6165_120.dwg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"17516787"},"dct:description":[{"@language":"da","@value":"VUP_6160_115_6165_120\n\n"},{"@language":"en","@value":"VUP_6160_115_6165_120\n\n"},{"@language":"sv","@value":"VUP_6160_115_6165_120"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/DWG"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-11-12T13:33:50.053507"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T01:34:51.250533"},"dct:title":[{"@language":"da","@value":"VUP_6160_115_6165_120"},{"@language":"en","@value":"VUP_6160_115_6165_120"},{"@language":"sv","@value":"VUP_6160_115_6165_120"}]},{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resource/47ec10a6-cfd5-444d-8e66-cca17ff94f8b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/46e78ddc-757d-4c39-8216-542efe2908a1/resourc