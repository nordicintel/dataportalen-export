ttp://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/89eb3b31-902a-457d-95bf-2fb2f8f87d53","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/89eb3b31-902a-457d-95bf-2fb2f8f87d53/resource/bf7094e0-5516-4a61-acc6-cface7031478"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Egenkapital reduceret med de pensionsforpligtelser, der er optjent før 1998 og\nopført som en eventualforpligtelse for kommunen, divideret med kommunens\naktiver.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Equity reduced by the pension obligations earned before 1998 and stated as a\ncontingent liability of the municipality, divided by the municipality's\nassets.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Eget kapital minskat med det pensionsåtaganden som är intjänade före 1998 och som anges som en ansvarsförbindelse kommunen, dividerat med tillgångar kommunen. \n\nKälla: SCB."}],"dct:identifier":"89eb3b31-902a-457d-95bf-2fb2f8f87d53","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:09:53.726701"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:1927a7252d567eaac7c9ab64dcd460fd66d48302e492a35d2b99ed6805975381_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Egenkapitalandel inklusive kommunens pensionsforpligtelser, procent"},{"@language":"en","@value":"Equity ratio including pension commitments of the municipality, percent"},{"@language":"sv","@value":"Soliditet inklusive pensionsåtag kommun, procent"}]},{"@id":"https://opendata-api.malmo.se/dataset/89eb3b31-902a-457d-95bf-2fb2f8f87d53/resource/bf7094e0-5516-4a61-acc6-cface7031478","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N03002"},"dct:description":[{"@language":"da","@value":"Egenkapital reduceret med pensionsforpligtelser optjent før 1998 og opført som\nen eventualforpligtelse for kommunen, divideret med kommunens aktiver. Kilde:\nKolada\n\n"},{"@language":"en","@value":"Equity reduced by the pension obligations earned before 1998 and stated as a\ncontingent liability of the municipality, divided by the assets of the\nmunicipality. Source: Kolada\n\n"},{"@language":"sv","@value":"Eget kapital minskat med det pensionsåtaganden som är intjänade före 1998 och som anges som en ansvarsförbindelse kommunen, dividerat med tillgångar kommunen. Källa: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-07-08T06:42:35.379818"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:09:53.748481"},"dct:title":[{"@language":"da","@value":"Egenkapitalandel inklusive pensionsforpligtelser, kommune, (%) (N03002)"},{"@language":"en","@value":"Equity ratio including pension commitments, municipality, (%) (N03002)"},{"@language":"sv","@value":"Soliditet inkl pensionsåtag. kommun, (%) (N03002)"}]}],"@id":"urn:source:1927a7252d567eaac7c9ab64dcd460fd66d48302e492a35d2b99ed6805975381"},{"@graph":[{"@id":"_:1d05083dc0a4ffdfd127eb8c224a04305ec0999e8447a43abf15bfbbf9e972b4_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:1d05083dc0a4ffdfd127eb8c224a04305ec0999e8447a43abf15bfbbf9e972b4_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1d05083dc0a4ffdfd127eb8c224a04305ec0999e8447a43abf15bfbbf9e972b4_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/4f000c6e-0f37-4efd-b14a-bc0c5d66f557"},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/85c08888-d84b-4e6a-b2fd-fb50f7358f12"},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/d0f6656c-8e5b-4602-84ca-8ab1a550d3b8"},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e7822967-75ed-4989-a6dd-b3fd3eb35333"},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e8ce86f2-a820-4a1f-a1c8-cacf2197ffd2"}],"dcat:keyword":["Index","Klimatanpassning","Malmö stad","Sårbarhet","Värme"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"da","@value":"Konsekvenserne af hedebølger afhænger af menneskers helbred, socioøkonomiske\nog miljømæssige sårbarhed. Sårbarhedsindekset er et prioriteringsværktøj, der\nrangerer Malmøs delområder, kvarterer og DeSO-områders sårbarhed fra 0-100.\nFormålet er at give en forståelse af, hvor i Malmø varme er et særligt stort\nproblem.\n\nNår store mængder data indsamles på denne måde, forsvinder noget af\nvariationen inden for områderne, så det er vigtigt at studere de områder, der\ner identificeret i kortlægningen, i dybden. Den seneste version har data fra\n2025 og en metode udviklet i 2026.\n\nIndekset indeholder følgende datapunkter: - Sundhed: Andel beboere over 65 år\n(SCB), Andel beboere under 5 år (SCB), Gennemsnitligt antal sygedage (SCB) -\nSocioøkonomi: Andel enlige uden børn (SCB), Gennemsnitlig disponibel indkomst\n(SCB), Antal enfamiliehuse (SCB), Andel bilejere (SCB), Antal beboere pr.\nværelse (Malmø by). - Miljø: Tagdækning (Malmø by), Maksimal\nstrålingstemperatur på en ekstremt varm sommerdag (Malmø by), Gennemsnitlig\nafstand til nærmeste grønne område (Malmø by), Tilgængelighed til offentlige\ntjenester (Malmø by). Indekset er udviklet ved at normalisere hver indikator i\nforhold til de andre delområder og derefter lægge sammen (hvis de øger\nsårbarheden) og trække fra (hvis de mindsker sårbarheden) for at opnå en\nendelig total for hvert delområde. Dette er igen blevet normaliseret, så alle\nområder har et tal mellem 0-1, hvor 0 er mindst sårbart, og 1 er mest sårbart.\nFor at øge gennemsigtigheden er de tre kategorier blevet vægtet ligeligt i\nhenhold til nedenstående formel: I =\n(s_1+s_2…+s_5)/5+(h_1+h_2+h_3)/3+(v_1+v_2...+v4)/4 hvor s_1 er den første\nsocioøkonomiske indikator, s_2 er den anden osv. Tilsvarende står h for\nsundhed og v for varmeeksponering.\n\n"},{"@language":"en","@value":"The consequences of heat waves depend on people's health, socio-economic and\nenvironmental vulnerability. The vulnerability index is a prioritization tool\nthat ranks Malmö's sub-areas, neighborhoods and DeSO areas' vulnerability from\n0-100. The purpose is to provide an understanding of where in Malmö heat is a\nparticularly big problem.\n\nWhen large amounts of data are collected in this way, some of the variation\nwithin the areas disappears, so it is important to study the areas identified\nin the mapping in depth. The latest version has data from 2025 and a method\ndeveloped in 2026.\n\nThe index includes the following data points: - Health: Proportion of\nresidents over 65 years of age (SCB), Proportion of residents under 5 years of\nage (SCB), Average number of sick days (SCB) - Socio-economics: Proportion of\nsingle people without children (SCB), Average disposable income (SCB), Number\nof single-family homes (SCB), Proportion of car owners (SCB), Number of\nresidents per room (Malmö city). - Environment: Roof coverage (Malmö city),\nMaximum radiation temperature on an extremely hot summer day (Malmö city),\nAverage distance to the nearest green area (Malmö city), Accessibility to\npublic services (Malmö city). The index has been developed by normalizing each\nindicator against the other sub-areas and then adding (if they increase\nvulnerability) and subtracting (if they decrease vulnerability) to obtain a\nfinal total for each sub-area. This has in turn been normalized so that all\nareas have a number between 0-1, where 0 is the least vulnerable and 1 is the\nmost vulnerable. For increased transparency, the three categories have been\nweighted equally, according to the formula below: I =\n(s_1+s_2…+s_5)/5+(h_1+h_2+h_3)/3+(v_1+v_2...+v4)/4 where s_1 is the first\nsocio-economic indicator, s_2 is the second and so on. Similarly, h stands for\nhealth and v for heat exposure.\n\n"},{"@language":"sv","@value":"Konsekvenserna av värmeböljor beror på människors hälsomässiga, socioekonomiska och miljömässiga sårbarhet. Sårbarhetsindexet är ett prioriteringsverktyg som rankar Malmös delområden, kvarter och DeSO-områdes sårbarhet från 0-100. Syftet är att ge en förståelse för var i Malmö värme är ett särskilt stort problem.\n\nNär stora mängder data samlas på det här sättet försvinner en del av variationen inom områdena, det är därför viktigt att djupstudera de områden som pekas ut i kartläggningen. Den senaste versionen har data från 2025 och metod framtagen 2026.\n\nI indexet ingår datapunkterna: - Hälsa: Andel boende över 65 år (SCB), Andel boende under 5 år (SCB), Genomsnittligt antal ohälsodagar (SCB) -Socio-ekonomi: Andel ensamboende utan barn (SCB), Genomsnittlig disponibel inkomst (SCB), Antal småhus (SCB), Andel bilägare (SCB), Antal boende per rum (Malmö stad). - Miljö: Krontäckning (Malmö stad), Maximal strålningstemperatur extremvarm sommardag (Malmö stad), Medeldistansen till närmaste grönområde (Malmö stad), Tillgänglighet till samhällsservice (Malmö stad). Indexet har tagits fram genom att varje indikator normaliserats gentemot de andra delområdena för att sedan adderas (om de ökar sårbarheten) och subtraheras (om de minskar sårbarheten) för att få en slutgiltig summa för varje delområde. Denna har i sin tur normaliserats så att alla områden har en siffra mellan 0-1 där 0 är minst sårbar och 1 mest sårbar. För ökad transparens har de tre kategorierna viktats lika, enligt nedan formel: I = (s_1+s_2…+s_5)/5+(h_1+h_2+h_3)/3+(v_1+v_2...+v4)/4 där s_1 är första socioekonomiska indikatorn, s_2 är andra och så vidare. På samma sätt står h för hälsa och v för värmeutsatthet."}],"dct:identifier":"1215645a-ad8a-4bb7-9986-b57d118cf9bc","dct:issued":{"@type":"xsd:date","@value":"2024-10-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-30T15:27:36.092399"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:1d05083dc0a4ffdfd127eb8c224a04305ec0999e8447a43abf15bfbbf9e972b4_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Sårbarhed over for ekstrem varme"},{"@language":"en","@value":"Vulnerability to extreme heat"},{"@language":"sv","@value":"Sårbarhet för extremvärme"}]},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/4f000c6e-0f37-4efd-b14a-bc0c5d66f557","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/4f000c6e-0f37-4efd-b14a-bc0c5d66f557/download/sarbarhetsindex-deso.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1413248"},"dct:description":[{"@language":"da","@value":"Sårbarhedsindeks på DeSO-niveau fra 2026.\n\n"},{"@language":"en","@value":"Vulnerability index at DeSO level from 2026.\n\n"},{"@language":"sv","@value":"Sårbarhetsindex på DeSO-nivå från 2026."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-29T10:58:37.334128"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-30T15:27:36.107225"},"dct:title":[{"@language":"da","@value":"Sårbarhedsindeks DeSO"},{"@language":"en","@value":"Vulnerability Index DeSO"},{"@language":"sv","@value":"Sårbarhetsindex DeSO"}]},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/85c08888-d84b-4e6a-b2fd-fb50f7358f12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/85c08888-d84b-4e6a-b2fd-fb50f7358f12/download/varmerapport-malmo.pdf"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2486132"},"dct:description":[{"@language":"da","@value":"Varmerapport.\n\n"},{"@language":"en","@value":"Heat report.\n\n"},{"@language":"sv","@value":"Värmerapport."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-12-18T09:56:08.937593"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-29T10:47:43.553497"},"dct:title":[{"@language":"da","@value":"Ekstrem varme i Malmø - Hvem er berørt, og hvordan kan vi afbøde virkningerne?"},{"@language":"en","@value":"Extreme heat in Malmö - Who is affected and how can we alleviate the effects?"},{"@language":"sv","@value":"Extremvärme i Malmö - Vem drabbas och hur kan vi lindra effekterna?"}]},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/d0f6656c-8e5b-4602-84ca-8ab1a550d3b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/d0f6656c-8e5b-4602-84ca-8ab1a550d3b8/download/stilsattning.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7020"},"dct:description":[{"@language":"da","@value":"Stilisering for kortlag\n\n"},{"@language":"en","@value":"Stylization for map layers\n\n"},{"@language":"sv","@value":"Stilsättning till kartlager"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-01-08T09:01:36.426789"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-29T10:36:27.769118"},"dct:title":[{"@language":"da","@value":"Stilisering"},{"@language":"en","@value":"Stylization"},{"@language":"sv","@value":"Stilsättning"}]},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e7822967-75ed-4989-a6dd-b3fd3eb35333","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e7822967-75ed-4989-a6dd-b3fd3eb35333/download/sarbarhetsindex-delomrade.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1333898"},"dct:description":[{"@language":"da","@value":"Sårbarhedsindeks på delområdeniveau fra 2026.\n\n"},{"@language":"en","@value":"Vulnerability index at sub-area level from 2026.\n\n"},{"@language":"sv","@value":"Sårbarhetsindex på delområdesnivå från 2026."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-29T10:58:08.956313"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-29T11:00:01.982164"},"dct:title":[{"@language":"da","@value":"Delområde for sårbarhedsindeks"},{"@language":"en","@value":"Vulnerability index sub-area"},{"@language":"sv","@value":"Sårbarhetsindex delområde"}]},{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e8ce86f2-a820-4a1f-a1c8-cacf2197ffd2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/1215645a-ad8a-4bb7-9986-b57d118cf9bc/resource/e8ce86f2-a820-4a1f-a1c8-cacf2197ffd2/download/sarbarhetsindex-kvarter.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"13399051"},"dct:description":[{"@language":"da","@value":"Sårbarhedsindeks på nabolagsniveau fra 2026.\n\n"},{"@language":"en","@value":"Vulnerability index at the neighborhood level from 2026.\n\n"},{"@language":"sv","@value":"Sårbarhetsindex på kvartersnivå från 2026."}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-07-29T10:59:11.403839"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-29T11:04:19.772270"},"dct:title":[{"@language":"da","@value":"Sårbarhedsindeks-nabolag"},{"@language":"en","@value":"Vulnerability index neighborhood"},{"@language":"sv","@value":"Sårbarhetsindex kvarter"}]}],"@id":"urn:source:1d05083dc0a4ffdfd127eb8c224a04305ec0999e8447a43abf15bfbbf9e972b4"},{"@graph":[{"@id":"_:2065b95641563a91181181d837e365190fa8a2a3d93ab6025f873b9124bc23c6_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"06a49b370bb2092634bda913e46e00ad"},{"@id":"_:2065b95641563a91181181d837e365190fa8a2a3d93ab6025f873b9124bc23c6_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8/resource/34c08877-4aca-49b6-9e9a-96c4d0d30791"},{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8/resource/e15f2c10-62d3-49bf-a620-b8aac1ddc5b8"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af husstande opdelt på forskellige husstandstyper. Variablen er\nopdelt i husstandstyperne enlige (herunder aleneboende), samlevende og andre\nhusstande, alle med eller uden børn. Børn tælles her efter forhold og ikke\nalder. Husstand betyder beboelseshusstande. Alle personer registreret i samme\nlejlighed tælles derfor som den samme husstand. Mere information om\nhusstandsstatistik kan findes i SCB's dokument \"Registerbaseret\nhusstandsstatistik\". Data fra Befolkningsregisteret (RTB).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of households divided by different household types. The\nvariable is divided into the household types single (including living alone),\ncohabiting and other households, all with or without children. Children are\ncounted here by relationship and not age. Household means residential\nhouseholds. All people registered in the same apartment are therefore counted\nas the same household. More information about household statistics can be\nfound in SCB's document \"Register-based household statistics\". Data from the\nRegister of Total Population (RTB).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antal hushåll uppdelat efter olika hushållstyper. Variabeln delas in i hushållstyperna ensamstående (inklusive ensamboende), sammanboende och övriga hushåll, alla med eller utan barn. Barn räknas här efter släktskap och inte ålder. Hushåll innebär bostadshushåll. Alla personer som är registrerade i samma lägenhet räknas alltså till samma hushåll. Mer information kring hushållsstatistik finns i SCB:s dokument ”Registerbaserad hushållsstatistik”. Data från Registret över Totalbefolkningen (RTB).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"91415fcd-bafb-45ce-a1e0-47d01461f9d8","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:24.469280"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:2065b95641563a91181181d837e365190fa8a2a3d93ab6025f873b9124bc23c6_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Husholdningstype - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Household type - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Hushållstyp - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8/resource/34c08877-4aca-49b6-9e9a-96c4d0d30791","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=e15f2c10-62d3-49bf-a620-b8aac1ddc5b8"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Husstandstype\n\n"},{"@language":"en","@value":"Malmö statistics - Household type\n\n"},{"@language":"sv","@value":"Malmö statistik - Hushållstyp"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:30.893361"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:37.688998"},"dct:title":[{"@language":"da","@value":"Husholdningstype"},{"@language":"en","@value":"Household type"},{"@language":"sv","@value":"Hushållstyp"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8/resource/e15f2c10-62d3-49bf-a620-b8aac1ddc5b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91415fcd-bafb-45ce-a1e0-47d01461f9d8/resource/e15f2c10-62d3-49bf-a620-b8aac1ddc5b8/download/hushallstyp.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"978632"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Husstandstype\n\n"},{"@language":"en","@value":"Malmö statistics - Household type\n\n"},{"@language":"sv","@value":"Malmö statistik - Hushållstyp"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:25.928085"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:24.475591"},"dct:title":[{"@language":"da","@value":"Husholdningstype"},{"@language":"en","@value":"Household type"},{"@language":"sv","@value":"Hushållstyp"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:2065b95641563a91181181d837e365190fa8a2a3d93ab6025f873b9124bc23c6_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:2065b95641563a91181181d837e365190fa8a2a3d93ab6025f873b9124bc23c6"},{"@graph":[{"@id":"_:21b74c41a85612a78c022f3bf94dfe06dd09c5ae1ff6a6891b9ecc0f9b5d2834_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/ac223f67-f359-4a8a-a12a-952715fe70ca","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/ac223f67-f359-4a8a-a12a-952715fe70ca/resource/bcb6e91b-e1f2-4d56-8a5b-ec7c20dc9fd0"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til uddannelsen i økonomi,\nhumaniora og samfundsvidenskab, divideret med antallet af elever, der fik\neller ville have fået en karakter i mindst ét ​​fag i henhold til det mål- og\nvidensrelaterede karaktersystem i 9. klasse.\n\nStatistik i procenter fra 2011.\n\nBegrebet \"lokationskommune\" henviser til elever på skoler beliggende i\nkommunen, uanset deres folkeregistreringssted.\n\nOplysningerne refererer til skoleåret. Hvis det samlede antal elever er 40\neller mere, og antallet af IKKE-berettigede elever er 1-4 elever, vises\nprocentdelen af ​​berettigede elever som 95 procent.\n\nI 2016 blev studerende med ukendt baggrund udelukket.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the economics, humanities\nand social sciences program divided by the number of students who received or\nwould have received a grade in at least one subject according to the goal- and\nknowledge-related grading system in grade 9.\n\nStatistics in percentages from 2011.\n\nThe term \"location municipality\" refers to students in schools located in the\nmunicipality, regardless of their place of population registration.\n\nThe information refers to the school year. If the total number of students is\n40 or more and the number of NOT eligible students is 1-4 students, the\npercentage of eligible students is shown as 95 percent.\n\nIn 2016, students with unknown backgrounds were excluded.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. \n\nStatistik i procent från 2011.\n\nMed lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort.\n\nUppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. \n\n2016 exkluderades elever med okänd bakgrund.\n\nKälla: Skolverket (Siris)."}],"dct:identifier":"ac223f67-f359-4a8a-a12a-952715fe70ca","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:07:05.193307"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:21b74c41a85612a78c022f3bf94dfe06dd09c5ae1ff6a6891b9ecc0f9b5d2834_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til at tage økonomi-, humaniora- og samfundsvidenskabelige uddannelser, placeringskommune"},{"@language":"en","@value":"Students in grade 9 who are eligible for the economics, humanities and social sciences programs, location municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/ac223f67-f359-4a8a-a12a-952715fe70ca/resource/bcb6e91b-e1f2-4d56-8a5b-ec7c20dc9fd0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15422"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til uddannelsen i økonomi,\nhumaniora og samfundsvidenskab, divideret med antallet af elever, der fik\neller ville have fået karakterer i mindst ét ​​fag i henhold til det mål- og\nvidensrelaterede karaktersystem i 9. klasse. Placeringskommunen refererer til\nelever på skoler beliggende i kommunen uanset folkeregistreringssted. Dataene\nrefererer til skoleåret. Hvis det samlede antal elever er 40 eller mere, og\nantallet af IKKE-berettigede elever er 1-4 elever, vises procentdelen af\n​​berettigede elever som 95 procent. I 2016 blev elever med ukendt baggrund\nekskluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the economics, humanities\nand social sciences program divided by the number of students who received or\nwould have received grades in at least one subject according to the goal- and\nknowledge-related grading system in grade 9. The location municipality refers\nto students in schools located in the municipality regardless of the place of\npopulation registration. The data refers to the academic year. If the total\nnumber of students is 40 or more and the number of NOT eligible students is\n1-4 students, the percentage of eligible students is shown as 95 percent. In\n2016, students with unknown backgrounds were excluded. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Med lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort. Uppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. 2016 exkluderades elever med okänd bakgrund. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-17T05:39:41.560541"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:07:05.197995"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til at tage økonomi-, humaniora- og samfundsvidenskabelige uddannelser, placering, kommune, procentdel (%) (N15422)"},{"@language":"en","@value":"Students in year 9 who are eligible for the economics, humanities and social sciences programs, location municipality, percentage (%) (N15422)"},{"@language":"sv","@value":"Elever i år 9 som är behöriga till ekonomi-, humanistiska och samhällsvetenskapsprogrammen, lägeskommun, andel (%) (N15422)"}]}],"@id":"urn:source:21b74c41a85612a78c022f3bf94dfe06dd09c5ae1ff6a6891b9ecc0f9b5d2834"},{"@graph":[{"@id":"_:2281eef6fb2e64b13ab55aa312c1274dc1a9e4f19bc884681380621dfbf4eab7_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/9c865a15-3b77-4945-a5d6-e2b10da95643","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/9c865a15-3b77-4945-a5d6-e2b10da95643/resource/f20c9a43-3231-4971-b50e-21c89045bbee"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem.\n\nStatistik i procenter fra 2013.\n\nBegrebet \"lokationskommune\" henviser til elever i både kommunale og friskoler\nbeliggende i kommunen, uanset hvor de er indskrevet.\n\nHvis det samlede antal elever er 40 eller flere, og antallet af EJ med den\nlaveste karakter E er 1-4 elever, vises procentdelen som 95 procent.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system.\n\nStatistics in percentages from 2013.\n\nThe term \"location municipality\" refers to students in both municipal and\nindependent schools located in the municipality, regardless of where they are\nregistered.\n\nIf the total number of students is 40 or more and the number of EJ with the\nlowest grade E is 1-4 students, the percentage is shown as 95 percent.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. \n\nStatistik i procent från 2013.\n\nMed lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. \n\nOm det totala antalet elever är 40 eller fler och antalet EJ med lägst betyget E är 1-4 elever, så visas andelen som 95 procent. \n\nKälla: Skolverket Siris)."}],"dct:identifier":"9c865a15-3b77-4945-a5d6-e2b10da95643","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:37:25.886364"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:2281eef6fb2e64b13ab55aa312c1274dc1a9e4f19bc884681380621dfbf4eab7_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 6. klasse med den laveste karakter på E i engelsk, placeringskommune"},{"@language":"en","@value":"Students in grade 6 with the lowest grade of E in English, location municipality"},{"@language":"sv","@value":"Elever i årskurs 6 med lägsta betyget E  i engelska, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/9c865a15-3b77-4945-a5d6-e2b10da95643/resource/f20c9a43-3231-4971-b50e-21c89045bbee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15480"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem. Elever i 6. klasse med minimumskarakteren\nE i engelsk, placeringskommune, procentdel (%). Placeringskommune refererer\ntil elever i både kommunale og friskoler beliggende i kommunen, uanset hvor de\ner indskrevet. Hvis det samlede antal elever er 40 eller mere, og antallet af\nEJ med minimumskarakteren E er 1-4 elever, vises procentdelen som 95 procent.\nKilde: Kolada\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system. Students in year 6 with a minimum grade of E\nin English, location municipality, percentage (%). Location municipality\nrefers to students in both municipal and independent schools located in the\nmunicipality regardless of where they are registered. If the total number of\nstudents is 40 or more and the number of EJ with a minimum grade of E is 1-4\nstudents, the percentage is shown as 95 percent. Source: Kolada\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. Elever i åk 6 med lägst betyget E  i engelska, lägeskommun, andel (%). Med lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. Om det totala antalet elever är 40 eller fler och antalet EJ med lägst betyget E är 1-4 elever, så visas andelen som 95 procent. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-18T06:51:04.533316"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:37:25.891323"},"dct:title":[{"@language":"da","@value":"Elever i 6. klasse med minimumskarakteren E i engelsk, kommune, procentdel (%) (N15480)"},{"@language":"en","@value":"Students in year 6 with a minimum grade of E in English, municipality of location, percentage (%) (N15480)"},{"@language":"sv","@value":"Elever i åk 6 med lägst betyget E  i engelska, lägeskommun, andel (%) (N15480)"}]}],"@id":"urn:source:2281eef6fb2e64b13ab55aa312c1274dc1a9e4f19bc884681380621dfbf4eab7"},{"@graph":[{"@id":"_:23a182c0b27f73dc68c2e036bd8cad46c2e8c1b9545154e56c04bd24fac3c54d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/ae92d46f-65d2-4c8c-9eb2-137d009a4ea1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/ae92d46f-65d2-4c8c-9eb2-137d009a4ea1/resource/5da763e6-6cac-4088-8860-0756d2792c2a"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsafvigelsen er nettoomkostningerne minus\nreferenceomkostningerne for grundskolen inklusive førskoleklasse, vist her i\nmillioner SEK. Nettoomkostningen er bruttoomkostningerne minus\nbruttoindtægterne.\n\nReferenceomkostningerne er baseret på nettoomkostningerne ved grundskole og\nførskoleklasser i landet, andelen af ​​6-15-årige i kommunen, børn med\nudenlandsk baggrund og antagelser om meromkostninger til små skoler og\nskoletransport. Derudover lægges en del af standardomkostningerne fra\ndelmodellerne for lønninger, bygningsstruktur og befolkningsudvikling til.\n\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier indikerer en lavere omkostningssituation end\nstatistisk forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR.\n\n"},{"@language":"en","@value":"The net cost deviation is the net cost minus the reference cost for compulsory\nschool including preschool class, shown here in millions of SEK. Net cost is\ngross cost minus gross income.\n\nThe reference cost is based on the net cost of compulsory school and preschool\nclasses in the country, the proportion of 6-15 year olds in the municipality,\nchildren with a foreign background, and assumptions about additional costs for\nsmall schools and school transport. In addition, part of the standard costs\nfrom the sub-models for salaries, building structure, and population\ndevelopment are added.\n\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​indicate a lower cost situation than statistically\nexpected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR.\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelsen är nettokostnaden minus referenskostnad för grundskola inklusive förskoleklass, här visat i miljoner kronor. Nettokostnad är bruttokostnad minus bruttointäkt. \n\nReferenskostnaden bygger på nettokostnaden för grundskola och förskoleklass i riket, andel 6-15-åringar i kommunen, barn med utländsk bakgrund samt antaganden om merkostnader för små skolor och skolskjuts. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. \n\nPositiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat.\n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR."}],"dct:identifier":"ae92d46f-65d2-4c8c-9eb2-137d009a4ea1","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:07:42.511257"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:23a182c0b27f73dc68c2e036bd8cad46c2e8c1b9545154e56c04bd24fac3c54d_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse for grundskolen F-9, millioner SEK"},{"@language":"en","@value":"Net cost deviation for primary school F-9, million SEK"},{"@language":"sv","@value":"Nettokostnadsavvikelse grundskola F-9, miljoner kronor"}]},{"@id":"https://opendata-api.malmo.se/dataset/ae92d46f-65d2-4c8c-9eb2-137d009a4ea1/resource/5da763e6-6cac-4088-8860-0756d2792c2a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15045"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsafvigelsen er nettoomkostningerne minus\nreferenceomkostningerne for grundskolen inkl. førskoleklassen, vist her i\nmillioner SEK. Nettoomkostningen er bruttoomkostningerne minus\nbruttoindkomsten. Referenceomkostningerne er baseret på nettoomkostningerne\nfor grundskolen og førskoleklassen i landet, andelen af ​​6-15-årige i\nkommunen, børn med udenlandsk baggrund og antagelser om meromkostninger til\nsmå skoler og skoletransport. Derudover lægges en del af\nstandardomkostningerne fra delmodellerne lønninger, bygningsstruktur og\nbefolkningsudvikling til. Positive værdier indikerer en højere\nomkostningssituation end statistisk forventet, og negative værdier en lavere\nomkostningssituation end statistisk forventet. Fra og med 2019 beregnes\nnettoomkostningsafvigelsen på en ny måde på grund af ændringer i\nomkostningsudligningen. Dette påvirker sammenligneligheden med tidligere år.\nKilde: Kolada\n\n"},{"@language":"en","@value":"The net cost deviation is the net cost minus the reference cost for compulsory\nschool incl. preschool class, shown here in millions of SEK. The net cost is\nthe gross cost minus gross income. The reference cost is based on the net cost\nfor compulsory school and preschool class in the country, the proportion of\n6-15 year olds in the municipality, children with a foreign background and\nassumptions about additional costs for small schools and school transport. In\naddition, part of the standard costs from the sub-models salaries, building\nstructure and population development are added. Positive values ​​indicate a\nhigher cost situation than statistically expected and negative values ​​a\nlower cost situation than statistically expected. From 2019 onwards, the net\ncost deviation is calculated in a new way due to changes in cost equalization.\nThis affects comparability with previous years. Source: Kolada\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelsen är nettokostnaden minus referenskostnad för grundskola inkl. förskoleklass, här visat i miljoner kronor. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnaden för grundskola och förskoleklass i riket, andel 6-15-åringar i kommunen, barn med utländsk bakgrund samt antaganden om merkostnader för små skolor och skolskjuts. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. Från och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt pga förändringar i kostnadsutjämningen.  Detta påverkar jämförbarheten med tidigare år. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-22T06:11:39.271171"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:07:42.534796"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse for grundskolen F-9, millioner SEK (N15045)"},{"@language":"en","@value":"Net cost variance for primary school F-9, million SEK (N15045)"},{"@language":"sv","@value":"Nettokostnadsavvikelse grundskola F-9, miljoner kronor (N15045)"}]}],"@id":"urn:source:23a182c0b27f73dc68c2e036bd8cad46c2e8c1b9545154e56c04bd24fac3c54d"},{"@graph":[{"@id":"_:24aab92c87c02461b8b177f39d7549b4b0755731f9330f5415d30f6260339be4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/1743fbda-45f2-4684-a452-67a322e7d9b6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/1743fbda-45f2-4684-a452-67a322e7d9b6/resource/516a45d6-f5d3-45c6-a129-97412da0c9d3"},"dcat:keyword":["Malmö stad","kolada","parental allowance"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Andel af forældrepenge (målt i antal nettodage), som mænd i kommunen modtager.\n\nStatistik i procenter fra 1999.\n\nKilde: Den svenske socialforsikringsmyndighed.\n\n"},{"@language":"en","@value":"Proportion of parental benefit (in terms of number of net days) that men in\nthe municipality receive.\n\nStatistics in percentages from 1999.\n\nSource: Swedish Social Insurance Agency.\n\n"},{"@language":"sv","@value":"Andel av föräldrapenning (sett till antal nettodagar) som män i kommunen tar ut. \n\nStatistik i procent från 1999.\n\nKälla: Försäkringskassan."}],"dct:identifier":"1743fbda-45f2-4684-a452-67a322e7d9b6","dct:issued":{"@type":"xsd:date","@value":"2020-12-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:43:17.151740"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:24aab92c87c02461b8b177f39d7549b4b0755731f9330f5415d30f6260339be4_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Forældredagpengedage taget af mænd, procentdel af antal dage"},{"@language":"en","@value":"Parental benefit days taken by men, percentage of number of days"},{"@language":"sv","@value":"Föräldrapenningdagar som tas ut av män, andel av antal dagar"}]},{"@id":"https://opendata-api.malmo.se/dataset/1743fbda-45f2-4684-a452-67a322e7d9b6/resource/516a45d6-f5d3-45c6-a129-97412da0c9d3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N00943"},"dct:description":[{"@language":"da","@value":"Andel af forældrepenge (målt i antal nettodage), som mænd (i\nkommunen/regionen) tager ud. Kilde: Kolada\n\n"},{"@language":"en","@value":"Proportion of parental benefit (in terms of number of net days) that men (in\nthe municipality/region) take out. Source: Kolada\n\n"},{"@language":"sv","@value":"Andel av föräldrapenning (sett till antal nettodagar) som män (i kommunen/regionen) tar ut. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-15T11:05:22.272293"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:43:17.172954"},"dct:title":[{"@language":"da","@value":"Forældredagpengedage taget af mænd, andel af antal dage (%) (N00943)"},{"@language":"en","@value":"Parental benefit days taken by men, proportion of number of days (%) (N00943)"},{"@language":"sv","@value":"Föräldrapenningdagar som tas ut av män, andel av antal dagar (%) (N00943)"}]}],"@id":"urn:source:24aab92c87c02461b8b177f39d7549b4b0755731f9330f5415d30f6260339be4"},{"@graph":[{"@id":"_:25df866dda40a7ae5d6aedc633d370562436373df28511286cb119c1977cb775_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"2c3135a0970d02b9a1fab55da6bb169b"},{"@id":"_:25df866dda40a7ae5d6aedc633d370562436373df28511286cb119c1977cb775_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e/resource/19651af4-fd3e-4c4d-b0ab-efd281dd61f2"},{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e/resource/aba76199-519d-4ace-b2ab-8e2840a77ad5"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer, der bor i området og er klassificeret som\nbeskæftigede. Vist for aldersgruppen 20-65. Data fra BAS (\"Befolkningens\narbejdsmarkedsstatus\"). I BAS kategoriseres en person som beskæftiget, hvis de\ni november i referenceåret har modtaget kompensation i henhold til\narbejdsgiverens erklæringer indberettet til Skatteverket (eller tilsvarende\nfor dem, der arbejder i resten af ​​Norden), anses for at være aktive som\nvirksomhedsejer, handels- eller kommanditselskabsejer, eller tidligere har\nmodtaget kompensation i henhold til ovenstående i løbet af året og i november\nhar modtaget en vis kompensation fra Socialförsäkringsverket (forældrepenge,\ngraviditetsydelse, sygedagpenge og lignende). Fra referenceåret 2022 anvendes\nen ny datakilde, når SCB ændrer datakilden til BAS fra den tidligere RAMS\n(\"Registerbaseret arbejdsmarkedsstatistik\"). Der er forskelle på, hvordan RAMS\ndefinerer erhvervsaktive, og hvordan BAS definerer beskæftigede. For eksempel\nklassificerer RAMS dem, der arbejder i Danmark, som ikke-erhvervsaktive, mens\nde i BAS tælles som beskæftigede under visse omstændigheder. Der er derfor et\ntidsseriebrud for denne tidsserie, der starter med data fra 2022. Ændringen i\nkilde og metode betyder, at sammenligninger af statistikker vedrørende\ndagbefolkningen i 2022 og tidligere referenceår skal foretages med stor\nforsigtighed. Læs mere på SCB.se.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of individuals living in the area and classified as employed.\nShown for the age range 20–65. Data from BAS (\"Labour Market Status of the\nPopulation\"). In BAS, a person is categorized as employed if during November\nof the reference year they have received compensation according to the\nemployer's declarations reported to the Swedish Tax Agency (or equivalent for\nthose working in the rest of the Nordic region), are considered to be active\nas a business owner, trading or limited partnership owner, or have previously\nreceived compensation according to the above during the year and during\nNovember have received certain compensation from the Swedish Social Insurance\nAgency (parental benefit, pregnancy benefit, sickness benefit and the like).\nFrom reference year 2022, a new data source is used when SCB changes the data\nsource to BAS from the previous RAMS (\"Register-based labour market\nstatistics\"). There are differences between how RAMS defines gainfully\nemployed and how BAS defines employed. For example, RAMS classifies those\nworking in Denmark as not gainfully employed, while in BAS they are counted as\nemployed under certain circumstances. There is therefore a time series break\nfor this time series starting with data from 2022. The change in source and\nmethod means that comparisons of statistics regarding daytime population in\n2022 and previous reference years must be made with great caution. Read more\nat SCB.se.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet individer som bor inom området och klassas som sysselsatta. Visas för åldersspannet 20–65. Data från BAS (\"Befolkningens arbetsmarknadsstatus\"). I BAS kategoriseras man som sysselsatt om man under november månad referensåret har erhållt ersättning enligt de arbetsgivardeklarationer som redovisas till Skatteverket (eller motsvarande för de som arbetar i övriga Norden), bedöms vara verksam som näringsidkare, handels- eller kommanditbolagägare, eller tidigare under året erhållt ersättning enligt ovan och under november månad fått vissa ersättningar från Försäkringskassan (föräldrapenning, graviditetspenning, sjukpenning och liknande). Från och med referensår 2022 används en ny datakälla då SCB byter datakälla till BAS från tidigare RAMS (\"Registerbaserad arbetsmarknadsstatistik\"). Det finns skillnader mellan hur RAMS definierar förvärvsarbetande och hur BAS definierar sysselsatta. Till exempel klassar RAMS de som arbetar i Danmark som ej förvärvsarbetande medan de i BAS under vissa omständigheter räknas som sysselsatta. Det sker därför ett tidsseriebrott för denna tidsserie med start med data från 2022. Bytet av källa och metod innebär att jämförelser av statistik avseende dagbefolkning 2022 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se. \n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"00ae2bf5-eeec-4dee-b248-3ff8d742151e","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:04:57.651613"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:25df866dda40a7ae5d6aedc633d370562436373df28511286cb119c1977cb775_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Ansat, 2022 - - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Employed, 2022 - - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Sysselsatta, 2022 -  - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e/resource/19651af4-fd3e-4c4d-b0ab-efd281dd61f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=aba76199-519d-4ace-b2ab-8e2840a77ad5"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Beskæftigede, 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Employed, 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Sysselsatta, 2022 - "}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:17.189650"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:01.314172"},"dct:title":[{"@language":"da","@value":"Ansat, 2022 - "},{"@language":"en","@value":"Employed, 2022 - "},{"@language":"sv","@value":"Sysselsatta, 2022 - "}]},{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e/resource/aba76199-519d-4ace-b2ab-8e2840a77ad5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/00ae2bf5-eeec-4dee-b248-3ff8d742151e/resource/aba76199-519d-4ace-b2ab-8e2840a77ad5/download/sysselsatta-2022-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"112477"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Beskæftigede, 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Employed, 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Sysselsatta, 2022 - "}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:15.728999"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:04:57.669369"},"dct:title":[{"@language":"da","@value":"Ansat, 2022 - "},{"@language":"en","@value":"Employed, 2022 - "},{"@language":"sv","@value":"Sysselsatta, 2022 - "}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:25df866dda40a7ae5d6aedc633d370562436373df28511286cb119c1977cb775_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:25df866dda40a7ae5d6aedc633d370562436373df28511286cb119c1977cb775"},{"@graph":[{"@id":"_:279b9150ca36443cc90ef5e0445047cc40ec1258df75868365eab0bb3b50dee9_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/653f8e85-eb89-4ae9-aeac-fa7cb833022c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/653f8e85-eb89-4ae9-aeac-fa7cb833022c/resource/1cabee26-bef9-4cc5-9021-c73b8d4e2794"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i gymnasiet (kommunen) pr. skoleår, målt pr. 15. oktober.\n\nBegrebet \"lokalkommune\" henviser til elever i kommunale og friskoler i\nkommunen, uanset hvor de er indskrevet.\n\nStatistik fra 1997.\n\nKilde: Den svenske statslige skolestyrelse (Siris)\n\n"},{"@language":"en","@value":"Number of students in upper secondary school (local municipality) per academic\nyear, measured on October 15.\n\nThe term \"local municipality\" refers to students in municipal and independent\nschools in the municipality, regardless of where they are registered.\n\nStatistics from 1997.\n\nSource: Swedish National Agency for Education (Siris)\n\n"},{"@language":"sv","@value":"Antal elever i gymnasieskola (lägeskommun) per läsår, mätt den 15 oktober.\n\nMed lägeskommun avses elever i kommunala och fristående skolor i kommunen oberoende av var de är folkbokförda.\n\nStatistik från 1997. \n\nKälla: Skolverket (Siris)"}],"dct:identifier":"653f8e85-eb89-4ae9-aeac-fa7cb833022c","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:29:20.429886"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:279b9150ca36443cc90ef5e0445047cc40ec1258df75868365eab0bb3b50dee9_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Antal elever i gymnasiet, placeringskommune"},{"@language":"en","@value":"Number of students in upper secondary school, municipality of location"},{"@language":"sv","@value":"Antal elever i gymnasieskola, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/653f8e85-eb89-4ae9-aeac-fa7cb833022c/resource/1cabee26-bef9-4cc5-9021-c73b8d4e2794","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17819"},"dct:description":[{"@language":"da","@value":"Elever i gymnasiet, kommune, antal. Henviser til skoleåret, målt den 15.\noktober. Kilde: Kolada\n\n"},{"@language":"en","@value":"Students in upper secondary school, municipality of location, number. Refers\nto academic year, measured on October 15. Source: Kolada\n\n"},{"@language":"sv","@value":"Elever i gymnasieskola, lägeskommun, antal. Avser läsår, mätt den 15 oktober. Källa: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T05:36:12.868704"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:29:20.433959"},"dct:title":[{"@language":"da","@value":"Elever i gymnasiet, kommune, antal (N17819)"},{"@language":"en","@value":"Students in upper secondary school, municipality of location, number (N17819)"},{"@language":"sv","@value":"Elever i gymnasieskola, lägeskommun, antal (N17819)"}]}],"@id":"urn:source:279b9150ca36443cc90ef5e0445047cc40ec1258df75868365eab0bb3b50dee9"},{"@graph":[{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"2f83f467078278adc6ebcb85f099fb4a"},{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c7d18e08-1373-4fce-a4b0-8f46d66279bd","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/c7d18e08-1373-4fce-a4b0-8f46d66279bd/resource/e35d66f8-5504-4469-861c-af6cad4adb52"},"dcat:keyword":["Avlopp","Enskilt Avlopp","Malmö stad","VA","Vatten","geodata","gis","karta","map"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"da","@value":"Steder i Malmø, hvor spildevand fra bygninger behandles på et individuelt\nrensningsanlæg.\n\nVores placering af individuelle afløb er ikke altid præcis, især i\nboligområder. Attributten \"koordinatpunkttype\" beskriver, hvad der blev brugt\ntil at oprette punktet. Ejendommens midtpunkt kan være langt fra det faktiske\nafløb.\n\n"},{"@language":"en","@value":"Locations in Malmö where wastewater from buildings is treated at an individual\nsewage plant.\n\nOur location of individual drains is not always accurate, especially in\nresidential areas. The coordinate point type attribute describes what was used\nto create the point. The center point of the property may be far from the\nactual drain.\n\n"},{"@language":"sv","@value":"Platser i Malmö där avloppsvatten från byggnader renas vid en enskild avloppsanläggning. \n\nVår placering av de enskilda avloppen är inte alltid korrekt, särskilt på koloniområden. Attributet koordinatpunkttyp beskriver vad som använts för att skapa punkten. Mittpunkt av fastighet kan vara långt från det faktiska avloppet. "}],"dct:identifier":"c7d18e08-1373-4fce-a4b0-8f46d66279bd","dct:issued":{"@type":"xsd:date","@value":"2024-03-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T23:32:34.670938"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b2n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Individuelle afløb"},{"@language":"en","@value":"Individual drains"},{"@language":"sv","@value":"Enskilda avlopp"}]},{"@id":"https://opendata-api.malmo.se/dataset/c7d18e08-1373-4fce-a4b0-8f46d66279bd/resource/e35d66f8-5504-4469-861c-af6cad4adb52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c7d18e08-1373-4fce-a4b0-8f46d66279bd/resource/e35d66f8-5504-4469-861c-af6cad4adb52/download/enskildaavlopp.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"182583"},"dct:description":[{"@language":"da","@value":"Data opdateret 20261017\n\nVores placering af individuelle afløb er ikke altid præcis, især i\nboligområder. Attributten \"koordinatpunkttype\" beskriver, hvad der blev brugt\ntil at oprette punktet. Ejendommens midtpunkt kan være langt fra det faktiske\nafløb.\n\n"},{"@language":"en","@value":"Data updated 20261017\n\nOur location of individual drains is not always accurate, especially in\nresidential areas. The coordinate point type attribute describes what was used\nto create the point. The center point of the property may be far from the\nactual drain.\n\n"},{"@language":"sv","@value":"Data uppdaterat 20261017\n\nVår placering av de enskilda avloppen är inte alltid korrekt, särskilt på koloniområden. Attributet koordinatpunkttyp beskriver vad som använts för att skapa punkten. Mittpunkt av fastighet kan vara långt från det faktiska avloppet. "}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-03-22T14:55:18.126015"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T23:32:34.681533"},"dct:title":[{"@language":"da","@value":"Individuelle afløb"},{"@language":"en","@value":"Individual drains"},{"@language":"sv","@value":"Enskilda avlopp"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38_b1n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:29607bd44ab9498661f89a05b0d343a8e162b6c19b4087970c65e16e90000c38"},{"@graph":[{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"c70aaa8bb62f1020610dd3e968d62db5f1ccd497"},{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"c818d466a2852ff5797f38fa9fc44dc585e8636d"},{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/70c109eb-181a-498f-966c-b7e193394a9d"},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/77f5e98e-c5e1-43df-a743-ce000c35206b"},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/aef8830a-69b5-49da-8dbe-c6f85e3db19d"},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/df2f9e32-9f72-4630-9591-4e895bc7f9dd"}],"dcat:keyword":["GIS","Malmö stad","PM2.5","geodata","karta","luftförorening","luftföroreningar","map","partiklar"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"da","@value":"Beregnede koncentrationer af partikler med en størrelse på mindre end 2,5 µm\nberegnet som mikrogram/m3 i 2 meters højde over jorden. Partiklerne har en\nprimær oprindelse fra forbrænding. En stor del af de partikler, der findes i\nluften, stammer fra Nordvesteuropa. Beregningens opløsning er 50x50 meter og\ner baseret på vejret og emissionerne i løbet af hvert år.\n\n"},{"@language":"en","@value":"Calculated concentrations of particles with a size of less than 2.5 µm\ncalculated as micrograms/m3 at 2 meters above ground. The particles have a\nprimary origin from combustion. A large part of the particles found in the air\noriginates in northwestern Europe. The resolution of the calculation is 50x50\nmeters and is based on the weather and emissions during each year.\n\n"},{"@language":"sv","@value":"Beräknade halter av partiklar med storlek mindre än 2,5 µm beräknat som mikrogram/m3 vid 2 meter ovan mark. Partiklarna har primärt ursprung från förbränning. En stor del av partiklar som finns i luften har sitt ursprung i nordvästeuropa. Upplösningen på beräkningen är 50x50 meter och baseras på vädret och utsläppen under respektive år."}],"dct:identifier":"85f5ed2f-ac26-4e7c-99b9-784ada1342c7","dct:issued":{"@type":"xsd:date","@value":"2023-05-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-15T16:16:43.667643"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b3n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Luftbårne partikler - PM2.5"},{"@language":"en","@value":"Airborne particles - PM2.5"},{"@language":"sv","@value":"Luftburna partiklar - PM2.5"}]},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/70c109eb-181a-498f-966c-b7e193394a9d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/70c109eb-181a-498f-966c-b7e193394a9d/download/pm25_ar_2025_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"552330"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-22T10:59:23.686260"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-22T10:59:33.761699"},"dct:title":[{"@language":"da","@value":"PM 2,5 i 2025"},{"@language":"en","@value":"PM 2.5 in 2025"},{"@language":"sv","@value":"PM 2.5 år 2025"}]},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/77f5e98e-c5e1-43df-a743-ce000c35206b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/77f5e98e-c5e1-43df-a743-ce000c35206b/download/pm2.5.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"8416"},"dct:description":[{"@language":"da","@value":"Stilisering\n\n"},{"@language":"en","@value":"Stylization\n\n"},{"@language":"sv","@value":"Stilsättning"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-12T11:40:14.645719"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-06-15T16:16:43.674893"},"dct:title":[{"@language":"da","@value":"Stilisering"},{"@language":"en","@value":"Stylization"},{"@language":"sv","@value":"Stilsättning"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b1n0"}},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/aef8830a-69b5-49da-8dbe-c6f85e3db19d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/aef8830a-69b5-49da-8dbe-c6f85e3db19d/download/pm25_ar_2023_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"782528"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-22T10:55:25.503904"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-22T10:55:34.408119"},"dct:title":[{"@language":"da","@value":"PM 2,5 i 2023"},{"@language":"en","@value":"PM 2.5 in 2023"},{"@language":"sv","@value":"PM 2.5 år 2023"}]},{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/df2f9e32-9f72-4630-9591-4e895bc7f9dd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/85f5ed2f-ac26-4e7c-99b9-784ada1342c7/resource/df2f9e32-9f72-4630-9591-4e895bc7f9dd/download/pm25_ar_2021_p.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3473686"},"dct:description":[{"@language":"da","@value":"PM 2,5 i 2021\n\n"},{"@language":"en","@value":"PM 2.5 in 2021\n\n"},{"@language":"sv","@value":"PM 2.5 år 2021"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-05-12T11:41:14.950429"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-13T17:39:43.748198"},"dct:title":[{"@language":"da","@value":"PM 2,5 i 2021"},{"@language":"en","@value":"PM 2.5 in 2021"},{"@language":"sv","@value":"PM 2.5 år 2021"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:2cd98e31f4a0129ecfa9155056c096afe126fd61242fc54e66a89b334150736d"},{"@graph":[{"@id":"_:2de43110f7a34fc04b4b336a91770fcecc687bbabfa63edfc0bbf8a4a5869f06_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#street-address":"Bergsgatan 17 Malmö"},{"@id":"_:2de43110f7a34fc04b4b336a91770fcecc687bbabfa63edfc0bbf8a4a5869f06_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Avdelningen för miljö och hälsoskydd","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2de43110f7a34fc04b4b336a91770fcecc687bbabfa63edfc0bbf8a4a5869f06_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljo@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/00384f6c30a75c7618456af7c6cec6b6"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ec7f85-30b7-4f8d-b1d7-d7337612ef0c"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ff710c-3acd-45c6-84ad-9a75e5142130"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/21387896-7ba4-4ed5-9918-db215a7cf7e4"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/45f8b961-675e-4fc6-b8c3-8ea1051d7bb5"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/4e50d2e2-f9c1-4bc1-b89a-6be79ce53f2d"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/628ec077-1132-410a-9efc-f4ff5e50434f"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/70cc528e-afce-412c-a938-f6f0599ed7ac"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/75f4ebfd-b4d4-4a35-9919-2b4ead6202e2"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/8dcae5a6-97f5-4b48-ba9b-b31aba302902"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/90a9f99f-fb1f-4ce9-9141-ae024ccacc96"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/b2ffd7d3-6654-4b55-a856-46fbc85fc7f1"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/c098b493-7e30-4784-a7e9-6aa6a3486e74"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/c099fa68-a695-45db-90b7-60113e0e3e20"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/e1faeafa-b1cd-4e7f-bb93-24d7fa56b511"},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/ec09e7f1-dba2-472b-90e7-66d357836aff"}],"dcat:keyword":["Malmö stad","Värme","strålningstemperatur","temperatur","tmrt","utci"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"da","@value":"Strålingstemperatur, forkortet Tmrt, er et mål, der beskriver, hvordan\ntemperaturer opleves baseret på summen af ​​den lang- og kortbølgede stråling,\nder når et punkt (dvs. varmestråling fra både solen og omgivende overflader).\nStrålingstemperaturer korrelerer bedre med lokal overdødelighed end for\neksempel lufttemperatur eller overfladetemperatur og er dermed et bedre mål\ntil at forstå og vurdere konsekvenserne af varme. Forskning i Sverige (Thorson\net. Al 2014) har vist, at overdødeligheden blandt sårbare grupper (ældre)\nstiger betydeligt over 60 grader i maksimal strålingstemperatur. Varigheden af\n​​temperaturer over 60 Tmrt er også yderst relevant for sundhedsresultatet\nunder en hedebølge.\n\nDataene blev genereret ved hjælp af en SOLWEIG-model fra Sweco (Solar and\nLongwave Environmental Irradiance Geometry model) i forbindelse med en\nvarmestresskortlægning, der analyserer træers sårbarhed i bymiljøet. Læs mere\nom metoden i rapporten eller her\nhttps://umep%2ddocs.readthedocs.io/projects/tutorial/en/latest/Tutorials/IntroductionToSolweig.html.\n\nTo meteorologiske standarddage er blevet anvendt i analysen:\n\n  * Ekstremt varm midsommerdag - 26-07-1994 - 32,7 °C\n  * Normal sommerdag - 24-06-2022 - 26,3 °C\n\nTemperaturerne fra disse dage er derefter blevet øget for de forskellige\nsimulerede klimascenarier:\n\n  * RCP4,5 2050 +2,5°C\n  * RCP4.5 2100 +3°C\n  * RCP8,5 2050 +3,5°C\n  * RCP8.5 2100 +5°C\n\n##  Zip-filer\n\nData direkte fra SOLWEIG-analyserne i rasterformat med 1x1m opløsning. Består\naf følgende:\n\n###  Scenarier\n\n  * 01_1994-07-26 NU - Ekstremt varm midsommerdag\n  * 02_2022-06-24 AKTUEL - Normal sommerdag\n  * 03_1994-07-26 RCP8.5 2050 - Ekstremt varm midsommerdag\n  * 04_1994-07-26 RCP8.5 2100 - Ekstremt varm midsommerdag\n  * 05_1994-07-26 RCP4.5 2050 - Ekstremt varm midsommerdag\n  * 06_1994-07-26 RCP4.5 2100 - Ekstremt varm midsommerdag\n  * 07_2022-06-24 RCP8.5 2050 - Normal sommerdag\n  * 08_2022-06-24 RCP8.5 2100 - Normal sommerdag\n  * 09_2022-06-24 RCP4.5 2050 - Normal sommerdag\n  * 10_2022-06-24 RCP4.5 2100 - Normal sommerdag\n\n###  Indholdet af hvert scenarie\n\n  * TMRT_Avg_dag.tiff - Gennemsnitlig Tmrt for dagtimerne 06-23\n  * TMRT_AntalTimmar60.tiff - Antal timer i løbet af dagen, hvor temperaturen overstiger 60 grader Tmrt\n  * TMRT_Max.tiff - Maksimal Tmrt i løbet af dagen for klimascenariet\n  * UTCI_DayAverage.tiff - Gennemsnitlig UTCI for dagtimerne 06-23\n\nTidspunkter i lokal tid\n\n##  Geopakke\n\nFilerne indeholder behandlede data for to af scenarierne (01_1994-07-26 NUTID\nog 04_1994-07-26 RCP8.5 2100) i vektorformat for TMRT_AntalHimmar60 og\nTMRT_MAX. De er behandlet med r.neighbour median 3x3 fra GRASS. Tilgængelig i\nden originale 1x1m opløsning (zoom = 1), og gennemsnitsværdier i 10x10m (zoom\n= 2) og 50x50m (zoom = 3) opløsning. Vektorformatet er designet til at gøre\ndet nemmere at vise, filtrere og foretage beregninger på informationen i Malmø\nbys webkort.\n\n  * Strålingstemperatur antal timer over 60 ekstrem varme til stede\n  * Strålingstemperatur antal timer over 60 ekstrem varme RCP8.5 2100\n  * Strålingstemperatur maksimal varme ekstrem varme tilstede\n  * Strålingstemperatur maksimal varme ekstrem varme RCP8.5 2100\n\n"},{"@language":"en","@value":"Radiant temperature, abbreviated Tmrt, is a measure that describes how\ntemperatures are experienced based on the sum of the long- and short-wave\nradiation that reaches a point (i.e. heat radiation from both the sun and\nsurrounding surfaces). Radiant temperatures correlate better with local excess\nmortality than, for example, air temperature or surface temperature and are\nthus a better measure for understanding and assessing the consequences of\nheat. Research in Sweden (Thorson et. Al 2014) has shown that excess mortality\namong vulnerable groups (the elderly) increases significantly above 60 degrees\nin maximum radiant temperature. The duration of temperatures above 60 Tmrt is\nalso highly relevant to the health outcome during a heat wave.\n\nThe data was generated using a SOLWEIG model from Sweco (Solar and Longwave\nEnvironmental Irradiance Geometry model) in conjunction with a heat stress\nmapping that analyzes the vulnerability of trees in the urban environment.\nRead more about the method in the report or here\nhttps://umep%2ddocs.readthedocs.io/projects/tutorial/en/latest/Tutorials/IntroductionToSolweig.html\n.\n\nTwo meteorological standard days have been used in the analysis:\n\n  * Extremely hot midsummer day - 1994-07-26 - 32.7 °C\n  * Normal summer day - 2022-06-24 - 26.3 °C\n\nThe temperatures from these days have then been increased for the different\nclimate scenarios simulated:\n\n  * RCP4.5 2050 +2.5°C\n  * RCP4.5 2100 +3°C\n  * RCP8.5 2050 +3.5°C\n  * RCP8.5 2100 +5°C\n\n##  Zip files\n\nData directly from the SOLWEIG analyses in raster format with 1x1m resolution.\nConsists of the following:\n\n###  Scenarios\n\n  * 01_1994-07-26 PRESENT - Extremely hot midsummer day\n  * 02_2022-06-24 CURRENT - Normal summer day\n  * 03_1994-07-26 RCP8.5 2050 - Extremely hot midsummer day\n  * 04_1994-07-26 RCP8.5 2100 - Extremely hot midsummer day\n  * 05_1994-07-26 RCP4.5 2050 - Extremely hot midsummer day\n  * 06_1994-07-26 RCP4.5 2100 - Extremely hot midsummer day\n  * 07_2022-06-24 RCP8.5 2050 - Normal summer day\n  * 08_2022-06-24 RCP8.5 2100 - Normal summer day\n  * 09_2022-06-24 RCP4.5 2050 - Normal summer day\n  * 10_2022-06-24 RCP4.5 2100 - Normal summer day\n\n###  Content of each scenario\n\n  * TMRT_Avg_dag.tiff - Average Tmrt for daytime hours 06-23\n  * TMRT_AntalTimmar60.tiff - Number of hours during the day that exceed 60 degrees Tmrt\n  * TMRT_Max.tiff - Maximum Tmrt during the day for the climate scenario\n  * UTCI_DayAverage.tiff - Average UTCI for daytime hours 06-23\n\nTimes in local time\n\n##  Geopackage\n\nThe files contain processed data for two of the scenarios (01_1994-07-26 NUTID\nand 04_1994-07-26 RCP8.5 2100) in vector format for TMRT_AntalHimmar60 and\nTMRT_MAX. They are processed with r.neighbour median 3x3 from GRASS. Available\nin the original 1x1m resolution (zoom = 1), and average values ​​in 10x10m\n(zoom = 2) and 50x50m (zoom = 3) resolution. The vector format is designed to\nmake it easier to display, filter and make calculations on the information in\nMalmö city's web maps.\n\n  * Radiation temperature number of hours above 60 extreme heat present\n  * Radiation temperature number of hours above 60 extreme heat RCP8.5 2100\n  * Radiation temperature maximum heat extreme heat present\n  * Radiation temperature maximum heat extreme heat RCP8.5 2100\n\n"},{"@language":"sv","@value":"Strålningstemperatur, förkortat Tmrt, är ett mått som beskriver hur temperaturer upplevs baserat på summan av den lång- och kortvågiga strålning som når en punkt (alltså värmestrålning både från solen och från kringliggande ytor). Strålningstemperaturer korrelerar bättre med lokal överdödlighet än till exempel lufttemperatur eller yttemperatur och är således ett bättre mått för att förstå och bedöma värmens konsekvenser. Forskning i Sverige (Thorson et. Al 2014) har visat att överdödligheten bland sårbara grupper (äldre) ökar markant över 60 grader i maximal strålningstemperatur. Även varaktigheten för temperaturer över 60 Tmrt har stor relevans för hälsoutfallet vid en värmebölja. \n\nDatan är framtagen med en SOLWEIG-modell av Sweco (Solar and Longwave Environmental Irradiance Geometry model) i samband med en värmestresskartläggning som analyserar trädens sårbarhet i stadsmiljön. Läs mer om metoden i rapporten eller här https://umep-docs.readthedocs.io/projects/tutorial/en/latest/Tutorials/IntroductionToSolweig.html .\n\nI analysen har två meteorologiska typdagar använts:\n\n* Extremvarm högsommardag - 1994-07-26 - 32,7 °C\n* Normalsommardag - 2022-06-24 - 26,3 °C\n\nTemperaturerna från dessa dagar har sedan ökats för de olika klimatscenarier som simulerats:\n\n* RCP4,5 2050 +2,5 °C\n* RCP4,5 2100 +3 °C\n* RCP8,5 2050 +3,5 °C\n* RCP8,5 2100 +5 °C\n\n## Zip-filer \nData direkt från SOLWEIG-analyserna i rasterformat med 1x1m upplösning. Består av följande:\n### Scenarier\n* 01_1994-07-26 NUTID - Extremvarm högsommardag\n* 02_2022-06-24 NUTID - Normalsommardag\n* 03_1994-07-26 RCP8,5 2050 - Extremvarm högsommardag\n* 04_1994-07-26 RCP8,5 2100 - Extremvarm högsommardag\n* 05_1994-07-26 RCP4,5 2050 - Extremvarm högsommardag\n* 06_1994-07-26 RCP4,5 2100 - Extremvarm högsommardag\n* 07_2022-06-24 RCP8,5 2050 - Normalsommardag\n* 08_2022-06-24 RCP8,5 2100 - Normalsommardag\n* 09_2022-06-24 RCP4,5 2050 - Normalsommardag\n* 10_2022-06-24 RCP4,5 2100 - Normalsommardag\n\n### Innehåll i varje scenario\n* TMRT_Avg_dag.tiff - Genomsnittlig Tmrt för dagtimmarna kl. 06-23\n* TMRT_AntalTimmar60.tiff - Antal timmar under dygnet som överstiger 60 grader Tmrt \n* TMRT_Max.tiff - Maximalt Tmrt under dygnet för klimatscenariot \n* UTCI_DayAverage.tiff - Genomsnittligt UTCI för dagtimmarna kl. 06-23\n\nTidsangivelser i lokal tid\n\n## Geopackage\nFilerna innehåller bearbetad data för två av scenarierna (01_1994-07-26 NUTID och 04_1994-07-26 RCP8,5 2100) i vektorformat för TMRT_AntalTimmar60 och TMRT_MAX. De är bearbetade med r.neighbour median 3x3 från GRASS. Finns i den ursprungliga 1x1m upplösningen (zoom = 1), och medelvärden i 10x10m (zoom = 2) och 50x50m (zoom = 3) upplösning. Vektorformatet är framtaget för att enklare kunna visa, filtrera och göra beräkningar på informationen i Malmö stads webbkartor.\n\n* Strålningstemperatur antal timmar över 60 extremvärme nutid\n* Strålningstemperatur antal timmar över 60 extremvärme RCP8,5 2100\n* Strålningstemperatur maxvärme extremvärme nutid\n* Strålningstemperatur maxvärme extremvärme RCP8,5 2100"}],"dct:identifier":"91c7c302-910b-4603-8a1a-22704f7f054f","dct:issued":{"@type":"xsd:date","@value":"2026-09-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-08T17:54:42.837929"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:2de43110f7a34fc04b4b336a91770fcecc687bbabfa63edfc0bbf8a4a5869f06_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Varmekort"},{"@language":"en","@value":"Heat maps"},{"@language":"sv","@value":"Värmekarteringar"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ec7f85-30b7-4f8d-b1d7-d7337612ef0c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ec7f85-30b7-4f8d-b1d7-d7337612ef0c/download/05_1994-07-26-rcp45-2050.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:53:44.158100"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:06:04.708657"},"dct:title":[{"@language":"da","@value":"05_1994-07-26 RCP4.5 2050"},{"@language":"en","@value":"05_1994-07-26 RCP4.5 2050"},{"@language":"sv","@value":"05_1994-07-26 RCP4,5 2050"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ff710c-3acd-45c6-84ad-9a75e5142130","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/14ff710c-3acd-45c6-84ad-9a75e5142130/download/stralningstemperatur_maxvarme_extremvarme_nutid.gpkg"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T14:37:41.047883"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:46:54.638442"},"dct:title":[{"@language":"da","@value":"Strålingstemperatur maksimal varme ekstrem varme tilstede"},{"@language":"en","@value":"Radiation temperature maximum heat extreme heat present"},{"@language":"sv","@value":"Strålningstemperatur maxvärme extremvärme nutid"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/21387896-7ba4-4ed5-9918-db215a7cf7e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/21387896-7ba4-4ed5-9918-db215a7cf7e4/dow