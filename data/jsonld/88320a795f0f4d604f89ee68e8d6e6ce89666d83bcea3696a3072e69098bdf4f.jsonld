dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/e5a1983c-eb1d-4132-b59e-fa6b4e00c826","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/e5a1983c-eb1d-4132-b59e-fa6b4e00c826/resource/e885996c-b567-4fb8-8323-2460ff6fadbc"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til æstetikuddannelsen, divideret\nmed antallet af elever, der fik eller ville have fået en karakter i mindst ét\n​​fag i henhold til det mål- og vidensrelaterede karaktersystem i 9. klasse.\n\nStatistik i procenter i 2011.\n\nDataene vedrører elever, der er registreret i kommunen. Elever med ukendt\nbaggrund er ikke inkluderet.\n\nOplysningerne refererer til studieåret.\n\nKilde: Statistiska centralbanken og Skolstyrelsen.\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the aesthetics program\ndivided by the number of students who received or would have received a grade\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9.\n\nStatistics in percentages in 2011.\n\nThe data refers to students registered in the municipality. Students with\nunknown backgrounds are not included.\n\nThe information refers to the academic year.\n\nSource: Statistics Sweden and the Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till estetiska programmet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. \n\nStatistik i procent i 2011.\n\nUppgiften avser elever folkbokförda i kommunen. Elever med okänd bakgrund ingår inte. \n\nUppgiften avser läsår. \n\nKälla: SCB och Skolverket."}],"dct:identifier":"e5a1983c-eb1d-4132-b59e-fa6b4e00c826","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:05:52.078122"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:3a339c3e9c050741e7a26d2f78fc1706b561df656c5fb750e447e632f4ddbe02_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til æstetikuddannelsen, hjemkommune"},{"@language":"en","@value":"Students in grade 9 who are eligible for the aesthetics program, home municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som är behöriga till estetiska programmet, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/e5a1983c-eb1d-4132-b59e-fa6b4e00c826/resource/e885996c-b567-4fb8-8323-2460ff6fadbc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15427"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til det æstetiske program,\ndivideret med antallet af elever, der fik eller ville have fået en karakter i\nmindst ét ​​fag i henhold til det mål- og vidensrelaterede karaktersystem i 9.\nklasse. Dataene refererer til elever, der er registreret i kommunen. Elever\nmed ukendt baggrund er ikke inkluderet. Dataene refererer til skoleåret.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the aesthetic program\ndivided by the number of students who received or would have received a grade\nin at least one subject according to the goal- and knowledge-related grading\nsystem in grade 9. The data refers to students registered in the municipality.\nStudents with unknown backgrounds are not included. The data refers to the\nschool year. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till estetiska programmet dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Uppgiften avser elever folkbokförda i kommunen. Elever med okänd bakgrund ingår inte. Uppgiften avser läsår. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-15T11:02:55.346249"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:05:52.102467"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til æstetikuddannelsen, hjemkommune, andel (%) (N15427)"},{"@language":"en","@value":"Students in grade 9 who are eligible for the aesthetics program, home municipality, percentage (%) (N15427)"},{"@language":"sv","@value":"Elever i åk 9 som är behöriga till estetiska programmet, hemkommun,  andel (%) (N15427)"}]}],"@id":"urn:source:3a339c3e9c050741e7a26d2f78fc1706b561df656c5fb750e447e632f4ddbe02"},{"@graph":[{"@id":"_:3a4948b347699f5ede8eb9030db8ecf40a56723cf26bc6aa56840aa77b2bf488_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/2fcbd412-4a44-44ae-b681-bc540109ffb4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/2fcbd412-4a44-44ae-b681-bc540109ffb4/resource/88af8a4f-a485-4f52-bbe9-0dc227d4991c"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen (hjemkommunen), der startede på gymnasiet\nfor 4 år siden, og som har en uddannelse inden for 4 år (inklusive\nintroduktionsprogram IM), divideret med antallet af registrerede elever i\nkommunen, der startede på gymnasiet for 4 år siden (inklusive IM).\n\nStatistik i procenter fra 2015.\n\nStuderende, der ikke har et svensk personnummer ved starten af ​​deres\nuddannelse (for eksempel nyankomne studerende, der endnu ikke er blevet\nregistreret), er ikke medregnet.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of registered students in the municipality (home municipality) who\nstarted upper secondary school 4 years ago and who have a degree within 4\nyears, (including introductory program IM), divided by the number of\nregistered students in the municipality who started upper secondary school 4\nyears ago, (including IM).\n\nStatistics in percentages from 2015.\n\nStudents who do not have a Swedish personal identification number at the\nbeginning of their education (for example, newly arrived students who have not\nyet been registered) are not included.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen (hemkommunen) som började på gymnasium för 4 år sedan och som har en examen inom 4 år, (inklusive introduktionsprogram IM), dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan, (inklusive IM). \n\nStatistik i procent från 2015.\n\nElever som vid utbildningens början saknar svenskt personnummer (exempelvis nyanlända elever som ännu inte blivit folkbokförda) ingår ej. \n\nKälla: SCB."}],"dct:identifier":"2fcbd412-4a44-44ae-b681-bc540109ffb4","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:33:01.519778"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:3a4948b347699f5ede8eb9030db8ecf40a56723cf26bc6aa56840aa77b2bf488_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever med en uddannelse inden for 4 år, hjemkommune"},{"@language":"en","@value":"Upper secondary school students with a degree within 4 years, home municipality"},{"@language":"sv","@value":"Gymnasieelever med examen inom 4 år, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/2fcbd412-4a44-44ae-b681-bc540109ffb4/resource/88af8a4f-a485-4f52-bbe9-0dc227d4991c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17461"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen, der startede i gymnasiet for 4 år siden\nog som dimitterede inden for 4 år, inkl. IM, divideret med antal registrerede\nelever i kommunen, der startede i gymnasiet for 4 år siden, inkl. IM. Elever,\nder ikke har et svensk personnummer ved starten af ​​deres uddannelse (f.eks.\nnyankomne elever, der endnu ikke er blevet registreret), er ikke inkluderet.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of registered students in the municipality who started upper secondary\nschool 4 years ago and who graduated within 4 years, incl. IM divided by\nnumber of registered students in the municipality who started upper secondary\nschool 4 years ago, incl. IM. Students who do not have a Swedish personal\nidentity number at the start of their education (e.g. newly arrived students\nwho have not yet been registered) are not included. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan som med examen inom 4 år, inkl. IM dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan, inkl. IM. Elever som vid utbildningens början saknar svenskt personnummer (t ex nyanlända elever som ännu inte blivit folkbokförda) ingår ej. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-22T06:15:52.121239"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:33:01.546883"},"dct:title":[{"@language":"da","@value":"Gymnasieelever med en uddannelse inden for 4 år, bopælskommune, andel (%) (N17461)"},{"@language":"en","@value":"Upper secondary school students with a degree within 4 years, municipality of re