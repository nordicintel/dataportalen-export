":[{"@language":"da","@value":"Malmø Bys Årbog 1932"},{"@language":"en","@value":"Malmö City Yearbook 1932"},{"@language":"sv","@value":"Malmö stads årsbok 1932"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:d6bef23a5fa471f601a8cec47b01d3e3952f5c7c8c44ca8266d0bc64d77a14d6"},{"@graph":[{"@id":"_:d717579ba3f0bad219c91875162827557a7f65867d46ec1cca7d6fc87b9b0c5f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/3ffead4a-9f52-41a5-a4c8-68e77a3d7e95","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/3ffead4a-9f52-41a5-a4c8-68e77a3d7e95/resource/ed8fa281-6fcb-4b08-8775-db7d6652c310"},"dcat:keyword":["Malmö stad","kolada","population"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Samlet antal indbyggere den 31. december, år T, minus det samlede antal\nindbyggere den 31. december, år T-5, divideret med det samlede antal\nindbyggere i år T-5. Gang med 100 for at få procentdelen.\n\nStatistik fra 1998.\n\nKilde: Statistiska centralbanken\n\n"},{"@language":"en","@value":"Total number of inhabitants on December 31, year T minus total number of\ninhabitants on December 31, year T-5, divided by total number of inhabitants\non year T-5. Multiply by 100 for percentage.\n\nStatistics from 1998.\n\nSource: Statistics Sweden\n\n"},{"@language":"sv","@value":"Antal invånare totalt 31 december år T minus antal invånare totalt 31 december år T-5, dividerat med antal invånare totalt år T-5. Multipliceras med 100 för procent.\n\nStatistik från 1998.\n\n Källa: SCB"}],"dct:identifier":"3ffead4a-9f52-41a5-a4c8-68e77a3d7e95","dct:issued":{"@type":"xsd:date","@value":"2020-12-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:42:29.331660"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d717579ba3f0bad219c91875162827557a7f65867d46ec1cca7d6fc87b9b0c5f_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Ændring i antal beboere i løbet af den seneste femårsperiode, procentdel"},{"@language":"en","@value":"Change in number of residents during the last five-year period, percentage"},{"@language":"sv","@value":"Förändring i antal invånare under senaste femårsperioden, andel"}]},{"@id":"https://opendata-api.malmo.se/dataset/3ffead4a-9f52-41a5-a4c8-68e77a3d7e95/resource/ed8fa281-6fcb-4b08-8775-db7d6652c310","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N01958"},"dct:description":[{"@language":"da","@value":"Samlet antal indbyggere 31/12 år T minus det samlede antal indbyggere 31/12 år\nT-5, divideret med det samlede antal indbyggere år T-5. Gang med 100 for at få\nprocent. Kilde: Kolada\n\n"},{"@language":"en","@value":"Total number of inhabitants 31/12 year T minus total number of inhabitants\n31/12 year T-5, divided by total number of inhabitants year T-5. Multiply by\n100 for percentage. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal invånare totalt 31/12 år T minus antal invånare totalt 31/12 år T-5, dividerat med antal invånare totalt år T-5. Multipliceras med 100 för procent. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T10:14:59.558984"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:42:29.339997"},"dct:title":[{"@language":"da","@value":"Ændring i antal indbyggere i løbet af den seneste femårsperiode, procentdel (%) (N01958)"},{"@language":"en","@value":"Change in number of inhabitants during the last five-year period, percentage (%) (N01958)"},{"@language":"sv","@value":"Förändring i antal invånare under senaste femårsperioden, andel (%) (N01958)"}]}],"@id":"urn:source:d717579ba3f0bad219c91875162827557a7f65867d46ec1cca7d6fc87b9b0c5f"},{"@graph":[{"@id":"_:d7faf93591d5ff7f1d4b7a02e04e943ed09fe3b9b25453bbbfea3bd826da660d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/3283f961-b84f-4add-bb9b-b4625c368551","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/3283f961-b84f-4add-bb9b-b4625c368551/resource/af7b88b0-7499-4feb-ba85-096569322936"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\nældrepleje, SEK pr. indbygger.\n\nNettoomkostninger er bruttoomkostninger minus bruttoindkomst.\nReferenceomkostningerne er baseret på nettoomkostningerne til ældrepleje i\nlandet, aldersstruktur (andel af 65-79 år, 80-89 år og 90+ år i kommunen),\ncivilstand, dårligt helbred, andel født uden for Norden, rejsetider i\nhjemmeplejen og meromkostninger til institutionspleje i tyndt befolkede\nområder. Derudover lægges en del af standardomkostningerne fra delmodellerne\nlønninger, boligstruktur og befolkningsudvikling til.\n\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier indikerer en lavere omkostningssituation end\nstatistisk forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for elderly care,\nSEK per inhabitant.\n\nNet cost is gross cost minus gross income. The reference cost is based on the\nnet cost of elderly care in the country, age structure (proportion of 65-79\nyears, 80-89 years and 90+ years in the municipality), marital status, ill\nhealth, proportion born outside the Nordic region, travel times in home care\nand additional costs for institutional care in sparsely populated areas. In\naddition, part of the standard costs from the sub-models salaries, housing\nstructure and population development are added.\n\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​indicate a lower cost situation than statistically\nexpected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för äldreomsorg, kronor per invånare. \n\nNettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden  bygger på nettokostnaden för äldreomsorg i riket, åldersstruktur (andel 65-79 år, 80-89 år och 90+ år i kommunen), civilstånd, ohälsa, andel födda utanför Norden, restider i hemtjänsten samt merkostnader för institutionsboende i glesbygd. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. \n\nPositiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. \n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR"}],"dct:identifier":"3283f961-b84f-4add-bb9b-b4625c368551","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:28:44.071224"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d7faf93591d5ff7f1d4b7a02e04e943ed09fe3b9b25453bbbfea3bd826da660d_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsvarians for ældrepleje, procent"},{"@language":"en","@value":"Net cost variance for elderly care, percent"},{"@language":"sv","@value":"Nettokostnadsavvikelse äldreomsorg, procent"}]},{"@id":"https://opendata-api.malmo.se/dataset/3283f961-b84f-4add-bb9b-b4625c368551/resource/af7b88b0-7499-4feb-ba85-096569322936","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N20900"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\nældrepleje, SEK/indbygger. Nettoomkostninger er bruttoomkostninger minus\nbruttoindkomst. Referenceomkostningerne er baseret på nettoomkostningerne til\nældrepleje i landet, aldersstruktur (andel af 65-79 år, 80-89 år og 90+ år i\nkommunen), civilstand, dårligt helbred, andel født uden for Norden, rejsetider\ni hjemmeplejen og meromkostninger for institutionsbeboere i tyndt befolkede\nområder. Derudover lægges en del af standardomkostningerne fra delmodellerne\nlønninger, bygningsstruktur og befolkningsudvikling til. Positive værdier\nindikerer en højere omkostningssituation end statistisk forventet, og negative\nværdier en lavere omkostningssituation end statistisk forventet. Fra og med\n2019 beregnes nettoomkostningsafvigelsen på en ny måde på grund af ændringer i\nomkostningsudligningen. Dette påvirker sammenligneligheden med tidligere år.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for elderly care,\nSEK/inhabitant. Net cost is gross cost minus gross income. The reference cost\nis based on the net cost of elderly care in the country, age structure\n(proportion of 65-79 years, 80-89 years and 90+ years in the municipality),\nmarital status, ill health, proportion born outside the Nordic countries,\ntravel times in home care and additional costs for institutional residents in\nsparsely populated areas. In addition, part of the standard costs from the\nsub-models salaries, building structure and population development are added.\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​a lower cost situation than statistically expected. From\n2019 onwards, the net cost deviation is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years. Source:\nKolada\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för äldreomsorg, kr/inv. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden  bygger på nettokostnaden för äldreomsorg i riket, åldersstruktur (andel 65-79 år, 80-89 år och 90+ år i kommunen), civilstånd, ohälsa, andel födda utanför Norden, restider i hemtjänsten samt merkostnader för institutionsboende i glesbygd. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. Från och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt pga förändringar i kostnadsutjämningen.  Detta påverkar jämförbarheten med tidigare år. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T10:11:44.762923"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:28:44.077009"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsvarians for ældrepleje, (%) (N20900)"},{"@language":"en","@value":"Net cost variance for elderly care, (%) (N20900)"},{"@language":"sv","@value":"Nettokostnadsavvikelse äldreomsorg, (%) (N20900)"}]}],"@id":"urn:source:d7faf93591d5ff7f1d4b7a02e04e943ed09fe3b9b25453bbbfea3bd826da660d"},{"@graph":[{"@id":"_:d8172bbdf0dd74dea474a1071f764d4d76235395980d3b625b766ae3097d0c7c_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"d68a455c951b49e6459ae282c7f65454"},{"@id":"_:d8172bbdf0dd74dea474a1071f764d4d76235395980d3b625b766ae3097d0c7c_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7/resource/04039f67-6933-4c3d-b97b-15df75a4cb18"},{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7/resource/88647b35-6a51-4c0b-b2bf-1f6cf0df8da3"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser den branche, hvor de erhvervsaktive i området arbejder. Opdelingen\nfølger Standarden for svensk brancheklassificering (SNI) 2007. Kategorierne 0\n(ukendt), A (landbrug, jagt og skovbrug), B (materialeudvinding), D (forsyning\naf el, gas, varme og køling), E (vandforsyning mv.), T (husholdningsproduktion\nmv.) og U (aktivitet i internationale organisationer) er blevet slået sammen\ntil kategorien \"Andet\" på grund af det lave antal personer, der arbejder i\ndisse brancher. Variablen viser også det samlede antal personer, der arbejder\ni området. Variablen er opdelt efter køn. Den vises for befolkningen i alderen\n16-74 år. Baseret på statistik fra SCB RAMS (\"Registerbaseret\narbejdsmarkedsstatistik\"). Statistikken omfatter alle personer mellem 16 og 74\når, der er registreret i Sverige den 31. december. Et stort antal personer,\nder arbejder i et område, er nødvendigt for at kunne opdele gruppen i de\nforskellige SNI-kategorier. SNI-kategorierne kan derfor kun rapporteres for et\npar delområder. Fra 2011 har Statistiska Centralbyrån foretaget nogle\nændringer i, hvordan personer på 65 år eller ældre tælles med for at opnå en\nmere ensartet vurdering af selvstændige. Det er derfor ikke hensigtsmæssigt at\nsammenligne statistikker længere tilbage i tiden end 2011.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the industry in which the gainfully employed people working in the area\nwork. The division follows the Standard for Swedish Industrial Classification\n(SNI) 2007. The categories 0 (unknown), A (Agriculture, hunting and forestry),\nB (extraction of materials), D (supply of electricity, gas, heating and\ncooling), E (water supply, etc.), T (household production, etc.) and U\n(activity at international organizations) have been merged into the category\n\"Other\" due to the low number of people working in these industries. The\nvariable also shows the total number of people working in the area. The\nvariable is divided by gender. It is shown for the population aged 16–74.\nBased on statistics from SCB RAMS (\"Register-based labour market statistics\").\nThe statistics include all individuals between 16 and 74 who are registered in\nSweden on 31 December. A large number of people working in an area are\nrequired to be able to break down the group into the different SNI categories.\nThe SNI categories can therefore only be reported for a few sub-areas. From\n2011, Statistics Sweden has made some changes in how people aged 65 or older\nare counted in order to obtain a more uniform assessment of self-employed\npersons. It is therefore not appropriate to compare statistics further back in\ntime than 2011.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar inom vilken industri de förvärvsarbetande som arbetar inom området arbetar. Uppdelningen följer Standard för svensk näringsgrensindelning (SNI) 2007. Kategorierna 0 (okänd), A (Jordbruk, jakt och skogsbruk), B (utvinning av material), D (försörjning av el, gas, värme och kyla), E (vattenförsörjning m.m.), T (hushållens produktion med mera) och U (verksamhet vid internationella organisationer) har slagits ihop till kategorin ”Övriga” på grund av det låga antalet arbetande i dessa industrier. Variabeln visar även totalt antalet som arbetar i området. Variabeln finns uppdelad på kön. Visas för befolkningen 16–74 år. Bygger på statistik från SCB RAMS (”Registerbaserad arbetsmarknadsstatistik”). I statistiken ingår samtliga individer mellan 16 och 74 som är folkbokförda i Sverige den 31 december. Det krävs ett stort antal arbetande inom ett område för att kunna bryta ner gruppen i de olika SNI-kategorierna. SNI-kategorierna kan därför bara redovisas för ett fåtal delområden. Fr.o.m. 2011 har SCB gjort en del förändringar i hur man räknar personer som är 65 år eller äldre för att få en mer enhetlig bedömning av egna företagare. Det är därför inte lämpligt att jämföra statistik längre bak i tiden än 2011. \n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"c3edcfa2-e0ee-4b4f-a11e-087cab603ca7","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:31.703110"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:d8172bbdf0dd74dea474a1071f764d4d76235395980d3b625b766ae3097d0c7c_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) efter SNI 2007, 2008-2018 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Daytime population (number of workplaces) by SNI 2007, 2008-2018 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2008-2018 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7/resource/04039f67-6933-4c3d-b97b-15df75a4cb18","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7/resource/04039f67-6933-4c3d-b97b-15df75a4cb18/download/dagbefolkning-antal-arbetsplatser-efter-sni-2007-2008-2018.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"10544827"},"dct:description":[{"@language":"da","@value":"Malmø-statistik - Dagbefolkning (antal arbejdspladser) efter SNI 2007,\n2008-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Daytime population (number of workplaces) by SNI 2007,\n2008-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2008-2018"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:16:16.852882"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:03:31.723636"},"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) efter SNI 2007, 2008-2018"},{"@language":"en","@value":"Daytime population (number of workplaces) by SNI 2007, 2008-2018"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2008-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:d8172bbdf0dd74dea474a1071f764d4d76235395980d3b625b766ae3097d0c7c_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/c3edcfa2-e0ee-4b4f-a11e-087cab603ca7/resource/88647b35-6a51-4c0b-b2bf-1f6cf0df8da3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=04039f67-6933-4c3d-b97b-15df75a4cb18"},"dct:description":[{"@language":"da","@value":"Malmø-statistik - Dagbefolkning (antal arbejdspladser) efter SNI 2007,\n2008-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Daytime population (number of workplaces) by SNI 2007,\n2008-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2008-2018"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:16:22.538859"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:16:52.087454"},"dct:title":[{"@language":"da","@value":"Dagbefolkning (antal arbejdspladser) efter SNI 2007, 2008-2018"},{"@language":"en","@value":"Daytime population (number of workplaces) by SNI 2007, 2008-2018"},{"@language":"sv","@value":"Dagbefolkning (antal arbetsplatser) efter SNI 2007, 2008-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:d8172bbdf0dd74dea474a1071f764d4d76235395980d3b625b766ae3097d0c7c"},{"@graph":[{"@id":"_:da1f47f2b26af39a50958f8dc5bf20f9f8ba87a2fcbcf91347313edb2456ddc8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/548605c4-4aa4-4510-899a-07340c7ba88d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/548605c4-4aa4-4510-899a-07340c7ba88d/resource/834f71b2-89ed-4cb3-8551-0942154b77d6"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen (hjemkommunen), der startede i gymnasiet\nfor 4 år siden, og som er berettigede til universitet/gymnasium inden for 4 år\n(inklusive introduktionsprogrammer, IM) divideret med antallet af registrerede\nelever i kommunen, der startede i gymnasiet for 4 år siden (inklusive IM).\n\nStatistik i procenter fra 2015.\n\nFra 2016 er studerende, der er færdiguddannet fra svenske skoler i udlandet,\nikke inkluderet.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of registered students in the municipality (home municipality) who\nstarted upper secondary school 4 years ago and who are eligible for\nuniversity/college within 4 years (including introductory programs, IM)\ndivided by the number of registered students in the municipality who started\nupper secondary school 4 years ago, (including IM).\n\nStatistics in percentages from 2015.\n\nAs of 2016, students who have graduated from Swedish schools abroad are not\nincluded.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen (hemkommunen) som började på gymnasium för 4 år sedan och som har behörighet till universitet/högskola inom 4 år (inklusive introduktionsprogram, IM) dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan, (inklusive IM). \n\nStatistik i procent från 2015.\n\nFrån och med 2016 ingår inte elever som tagit examen i svenska utlandsskolor. \n\nKälla: SCB."}],"dct:identifier":"548605c4-4aa4-4510-899a-07340c7ba88d","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:30:36.700205"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:da1f47f2b26af39a50958f8dc5bf20f9f8ba87a2fcbcf91347313edb2456ddc8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 4 år, hjemkommune"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 4 years, home municipality"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 4 år, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/548605c4-4aa4-4510-899a-07340c7ba88d/resource/834f71b2-89ed-4cb3-8551-0942154b77d6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17538"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen, der startede på gymnasiet for 4 år\nsiden, og som er berettigede til universitet/højskole inden for 4 år, inkl. IM\ndivideret med antal registrerede elever i kommunen, der startede på gymnasiet\nfor 4 år siden, inkl. IM. Fra 2016 er elever, der er færdiguddannet fra\nsvenske skoler i udlandet, ikke inkluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of registered students in the municipality who started upper secondary\nschool 4 years ago who are eligible for university/college within 4 years,\nincl. IM divided by number of registered students in the municipality who\nstarted upper secondary school 4 years ago, incl. IM. From 2016, students who\nhave graduated from Swedish schools abroad are not included. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan som med behörighet till universitet/högskola inom 4 år, inkl. IM dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan, inkl. IM. Fr.o.m. 2016 ingår inte elever som tagit examen i svenska utlandsskolor. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T08:46:33.758529"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:30:36.724393"},"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 4 år, bopælskommune, andel (%) (N17538)"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 4 years, municipality of residence, proportion (%) (N17538)"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 4 år, hemkommun, andel (%) (N17538)"}]}],"@id":"urn:source:da1f47f2b26af39a50958f8dc5bf20f9f8ba87a2fcbcf91347313edb2456ddc8"},{"@graph":[{"@id":"_:da2f2615a9485b4d392a45c0f55c7b3a95458af13115bd6c1556ae5c28aa47eb_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/7f2fa597-db3e-4360-a1c5-d211dfcfa0aa","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/7f2fa597-db3e-4360-a1c5-d211dfcfa0aa/resource/d55e83bd-e7bc-48b6-827e-432c9a08c61b"},"dcat:keyword":["Malmö stad","kolada","miljö"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal grønne biler i trafikken divideret med det samlede antal biler i\ntrafikken, ganget med 100. Refererer til 31/12 og den geografiske\nkommune/region. Fra 1. juli 2018 refererer oplysningerne til klimabonusbiler.\nRefererer til biler, der på registreringstidspunktet opfyldte kravene til\ngrønne biler. Det betyder, at biler registreret før 1. januar 2013 skal\nopfylde kriterierne for MB2007, og biler registreret den 1. januar 2013 eller\nsenere skal opfylde kriterierne for MB2013.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of green cars in traffic divided by total number of cars in traffic,\nmultiplied by 100. Refers to 31/12 and the geographical municipality/region.\nFrom 1 July 2018, the information refers to climate bonus cars. Refers to cars\nthat at the time of registration met the requirements for green cars. This\nmeans that cars registered before 1 January 2013 must meet the criteria for\nMB2007 and cars registered on 1 January 2013 or later must meet the criteria\nfor MB2013.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal miljöbilar i trafik dividerat med totalt antal bilar i trafik, multiplicerat med 100. Avser den 31/12 och den geografiska kommunen/regionen. Från 1 juli 2018 avser uppgiften klimatbonusbilar. Avser bilar som vid tiden för registrering uppfyllde kraven för miljöbil. Detta innebär att bilar registrerade före den 1 januari 2013 ska uppfylla kriterierna för MB2007 och bilar registrerade 1 januari 2013 eller senare ska uppfylla kriterierna för MB2013.  \n  \nKälla: SCB."}],"dct:identifier":"7f2fa597-db3e-4360-a1c5-d211dfcfa0aa","dct:issued":{"@type":"xsd:date","@value":"2022-11-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:40:58.603287"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:da2f2615a9485b4d392a45c0f55c7b3a95458af13115bd6c1556ae5c28aa47eb_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Miljøvenlige biler, andel af det samlede antal biler i det geografiske område"},{"@language":"en","@value":"Environmentally friendly cars, share of total number of cars in the geographical area"},{"@language":"sv","@value":"Miljöbilar, andel av totalt antal bilar i det geografiska området"}]},{"@id":"https://opendata-api.malmo.se/dataset/7f2fa597-db3e-4360-a1c5-d211dfcfa0aa/resource/d55e83bd-e7bc-48b6-827e-432c9a08c61b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N07400"},"dct:description":[{"@language":"da","@value":"Miljøbiler, andel af det samlede antal biler i det geografiske område. Antal\nmiljøbiler i trafikken divideret med det samlede antal biler i trafikken,\nganget med 100. Refererer til 31/12 og den geografiske kommune/region. Fra 1.\njuli 2018 refererer oplysningerne til klimabonusbiler. Refererer til biler,\nder på registreringstidspunktet opfyldte kravene til miljøbiler. Det betyder,\nat biler registreret før 1. januar 2013 skal opfylde kriterierne for MB2007,\nog biler registreret den 1. januar 2013 eller senere skal opfylde kriterierne\nfor MB2013.\n\nKilde: Kolada\n\n"},{"@language":"en","@value":"Environmental cars, share of total number of cars in the geographical area\nNumber of environmental cars in traffic divided by total number of cars in\ntraffic, multiplied by 100. Refers to 31/12 and the geographical\nmunicipality/region. From 1 July 2018, the information refers to climate bonus\ncars. Refers to cars that at the time of registration met the requirements for\nenvironmental cars. This means that cars registered before 1 January 2013 must\nmeet the criteria for MB2007 and cars registered on 1 January 2013 or later\nmust meet the criteria for MB2013.\n\nSource: Kolada\n\n"},{"@language":"sv","@value":"Miljöbilar, andel av totalt antal bilar i det geografiska området\nAntal miljöbilar i trafik dividerat med totalt antal bilar i trafik, multiplicerat med 100. Avser den 31/12 och den geografiska kommunen/regionen. Från 1 juli 2018 avser uppgiften klimatbonusbilar. Avser bilar som vid tiden för registrering uppfyllde kraven för miljöbil. Detta innebär att bilar registrerade före den 1 januari 2013 ska uppfylla kriterierna för MB2007 och bilar registrerade 1 januari 2013 eller senare ska uppfylla kriterierna för MB2013.\n\nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-23T13:27:59.842528"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:40:58.608239"},"dct:title":[{"@language":"da","@value":"Miljøvenlige biler, andel af det samlede antal biler i det geografiske område (N07400)"},{"@language":"en","@value":"Environmentally friendly cars, share of total number of cars in the geographical area (N07400)"},{"@language":"sv","@value":"Miljöbilar, andel av totalt antal bilar i det geografiska området (N07400)"}]}],"@id":"urn:source:da2f2615a9485b4d392a45c0f55c7b3a95458af13115bd6c1556ae5c28aa47eb"},{"@graph":[{"@id":"_:dacc996c8277ac68449ceedd96044cb7ab114c60a9515b20a1ed6d92805660e8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/75659637-4798-4aec-83d7-588fd5301ecb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/75659637-4798-4aec-83d7-588fd5301ecb/resource/b1e2f2d3-6cea-4759-8e42-5ca399735f27"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsvariansen er nettoomkostninger minus referenceomkostninger for\nindividuel og familiepleje, vist her i millioner SEK. Nettoomkostningen er\nbruttoomkostninger minus bruttoindkomst.\n\nFra 2019 og fremefter er referenceomkostningerne baseret på\nnettoomkostningerne til individuel og familiepleje i landet, andelen af\n​​lavtuddannede 20-40-årige født i Sverige, bybefolkningen, andelen der bor i\nflerfamiliehuse bygget i 1965-75, andelen af ​​børn og unge i alderen 0-19 år\ni husstande med en lav indkomststandard, når økonomisk bistand er ekskluderet,\ndårligt helbred, korrektion for grænseoverskridende pendling til Danmark og\nNorge samt lønninger til kommunalt ansatte.\n\nData for lavindkomststandarder er baseret på det foregående års resultat.\nPositive værdier indikerer en højere omkostningssituation end statistisk\nforventet, og negative værdier indikerer en lavere omkostningssituation end\nstatistisk forventet.\n\nIndtil 2018 blev nettoomkostningsvariansen beregnet ved hjælp af den tidligere\nIFO-standardomkostningsmodel. Dette påvirker sammenligneligheden med tidligere\når fra 2019.\n\nKilde: SKR\n\n"},{"@language":"en","@value":"Net cost variance is net cost minus reference cost for individual and family\ncare, shown here in millions of SEK. Net cost is gross cost minus gross\nincome.\n\nFrom 2019 onwards, the reference cost is based on the net cost of individual\nand family care in the country, the proportion of low-educated 20-40-year-olds\nborn in Sweden, the urban population, the proportion living in multi-family\nbuildings built in 1965-75, the proportion of children and young people aged\n0-19 in households with a low income standard when financial assistance is\nexcluded, ill health rates, correction for cross-border commuting to Denmark\nand Norway, and salaries for municipal employees.\n\nData for low income standards are based on the previous year's outcome.\nPositive values ​​indicate a higher cost situation than statistically expected\nand negative values ​​a lower cost situation than statistically expected.\n\nUp until 2018, net cost variance was calculated using the previous IFO\nstandard cost model. This affects comparability with previous years from 2019.\n\nSource: SKR\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelse är nettokostnad minus referenskostnad för individ- och familjeomsorg, här visat i miljoner kronor. Nettokostnad är bruttokostnad minus bruttointäkt. \n\nReferenskostnaden bygger från och med 2019 på nettokostnaden för individ- och familjeomsorg i riket, andel lågutbildade 20-40-åringar födda i Sverige, tätortsbefolkningen, andel boende i flerfamiljshus byggda 1965-75, andel barn och unga 0-19 år i hushåll med låg inkomststandard då ekonomiskt bistånd exkluderas, ohälsotal, korrigering för gränspendling till Danmark och Norge samt löner för kommunalt anställda. \n\nUppgifter för låg inkomststandard bygger på föregående års utfall. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. \n\nTill och med 2018 beräknades nettokostnadsavvikelse enligt den tidigare standardkostnadsmodellen för IFO. Detta påverkar jämförbarheten med tidigare år from 2019. \n\nKälla: SKR"}],"dct:identifier":"75659637-4798-4aec-83d7-588fd5301ecb","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:28:25.887357"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:dacc996c8277ac68449ceedd96044cb7ab114c60a9515b20a1ed6d92805660e8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse for individuel og familiepleje, millioner SEK"},{"@language":"en","@value":"Net cost deviation for individual and family care, SEK million"},{"@language":"sv","@value":"Nettokostnadsavvikelse individ- och familjeomsorg, miljoner kronor"}]},{"@id":"https://opendata-api.malmo.se/dataset/75659637-4798-4aec-83d7-588fd5301ecb/resource/b1e2f2d3-6cea-4759-8e42-5ca399735f27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N30026"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsafvigelsen er nettoomkostninger minus referenceomkostninger\nfor individuel og familiepleje, vist her i millioner SEK. Nettoomkostningen er\nbruttoomkostninger minus bruttoindkomst. Fra og med 2019 er\nreferenceomkostningerne baseret på nettoomkostningerne for individuel og\nfamiliepleje i landet, andelen af ​​lavtuddannede 20-40-årige født i Sverige,\nbybefolkningen, andelen af ​​beboere i flerfamiliehuse bygget i 1965-75,\nandelen af ​​børn og unge i alderen 0-19 år i husstande med lav\nindkomststandard, når økonomisk bistand er ekskluderet, sygefraværsrater,\nkorrektion for grænseoverskridende pendling til Danmark og Norge og lønninger\nfor kommunalt ansatte. Data for lav indkomststandard er baseret på det\nforegående års resultat. Positive værdier indikerer en højere\nomkostningssituation end statistisk forventet, og negative værdier en lavere\nomkostningssituation end statistisk forventet. Til og med 2018 blev\nnettoomkostningsafvigelsen beregnet i henhold til den tidligere\nstandardomkostningsmodel for IFO. Dette påvirker sammenligneligheden med\ntidligere år fra 2019. Kilde: Kolada\n\n"},{"@language":"en","@value":"Net cost deviation is net cost minus reference cost for individual and family\ncare, shown here in millions of SEK. Net cost is gross cost minus gross\nincome. From 2019 onwards, the reference cost is based on the net cost of\nindividual and family care in the country, the proportion of low-educated\n20-40-year-olds born in Sweden, the urban population, the proportion of\nresidents in multi-family buildings built in 1965-75, the proportion of\nchildren and young people aged 0-19 in households with a low income standard\nwhen financial assistance is excluded, ill health rates, correction for cross-\nborder commuting to Denmark and Norway and salaries for municipal employees.\nData for low income standard is based on the previous year's outcome. Positive\nvalues ​​indicate a higher cost situation than statistically expected and\nnegative values ​​a lower cost situation than statistically expected. Up to\nand including 2018, net cost deviation was calculated according to the\nprevious standard cost model for IFO. This affects comparability with previous\nyears from 2019. Source: Kolada\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelse är nettokostnad minus referenskostnad för individ- och familjeomsorg, här visat i miljoner kronor. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger från och med 2019 på nettokostnaden för individ- och familjeomsorg i riket, andel lågutbildade 20-40-åringar födda i Sverige, tätortsbefolkningen, andel boende i flerfamiljshus byggda 1965-75, andel barn och unga 0-19 år i hushåll med låg inkomststandard då ekonomiskt bistånd exkluderas, ohälsotal, korrigering för gränspendling till Danmark och Norge samt löner för kommunalt anställda. Uppgifter för låg inkomststandard bygger på föregående års utfall. Positiva värden indikerar högre kostnadsläge än statistiskt förväntat och negativa värden ett lägre kostnadsläge än statistiskt förväntat. Till och med 2018 beräknades nettokostnadsavvikelse enligt den tidigare standardkostnadsmodellen för IFO. Detta påverkar jämförbarheten med tidigare år from 2019. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T08:23:16.166905"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:28:25.914616"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsvariation for individuel og familiepleje, millioner SEK (N30026)"},{"@language":"en","@value":"Net cost variance for individual and family care, million SEK (N30026)"},{"@language":"sv","@value":"Nettokostnadsavvikelse individ- och familjeomsorg, miljoner kronor (N30026)"}]}],"@id":"urn:source:dacc996c8277ac68449ceedd96044cb7ab114c60a9515b20a1ed6d92805660e8"},{"@graph":[{"@id":"_:dbf2774e5275a2bb6c8ec078ebe0990167587f9d70ff7b48a37d0fc9e5953cd2_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"9acc7ca6937132717ba72db392ffde7c"},{"@id":"_:dbf2774e5275a2bb6c8ec078ebe0990167587f9d70ff7b48a37d0fc9e5953cd2_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9/resource/30119e45-6160-4443-87f6-17ecb15cca3c"},{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9/resource/b791d797-06fc-47dd-8002-6e50e90e651f"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer opdelt efter baggrund. Statistiska Centralbyrån\ndefinerer personer med udenlandsk baggrund som dem, der er født i udlandet\neller er født i Sverige med to udenlandskfødte forældre. Andre personer har\nsvensk baggrund. Data fra Befolkningsregisteret (RTB). Tilgængelig opdelt\nefter køn.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of people divided by background. Statistics Sweden defines\npeople with a foreign background as those who were born abroad or were born in\nSweden with two foreign-born parents. Other people have a Swedish background.\nData from the Register of Total Population (RTB). Available divided by gender.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet personer uppdelat efter bakgrund. SCB definierar personer med utländsk bakgrund som de som är utrikes födda eller är inrikes född med två utrikesfödda föräldrar. Övriga personer har svensk bakgrund.  Data från Registret över Totalbefolkningen (RTB). Finns uppdelat på kön.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"541192ed-e69b-4212-a0c8-415de7920ed9","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:33.145089"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:dbf2774e5275a2bb6c8ec078ebe0990167587f9d70ff7b48a37d0fc9e5953cd2_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Udenlandsk baggrund - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Foreign background - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Utländsk bakgrund - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9/resource/30119e45-6160-4443-87f6-17ecb15cca3c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9/resource/30119e45-6160-4443-87f6-17ecb15cca3c/download/utlandsk-bakgrund.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3285834"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Udenlandsk baggrund\n\n"},{"@language":"en","@value":"Malmö statistics - Foreign background\n\n"},{"@language":"sv","@value":"Malmö statistik - Utländsk bakgrund"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:40.054075"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:02:33.151257"},"dct:title":[{"@language":"da","@value":"Udenlandsk baggrund"},{"@language":"en","@value":"Foreign background"},{"@language":"sv","@value":"Utländsk bakgrund"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:dbf2774e5275a2bb6c8ec078ebe0990167587f9d70ff7b48a37d0fc9e5953cd2_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/541192ed-e69b-4212-a0c8-415de7920ed9/resource/b791d797-06fc-47dd-8002-6e50e90e651f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=30119e45-6160-4443-87f6-17ecb15cca3c"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Udenlandsk baggrund\n\n"},{"@language":"en","@value":"Malmö statistics - Foreign background\n\n"},{"@language":"sv","@value":"Malmö statistik - Utländsk bakgrund"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:45.112210"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:14:58.706177"},"dct:title":[{"@language":"da","@value":"Udenlandsk baggrund"},{"@language":"en","@value":"Foreign background"},{"@language":"sv","@value":"Utländsk bakgrund"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:dbf2774e5275a2bb6c8ec078ebe0990167587f9d70ff7b48a37d0fc9e5953cd2"},{"@graph":[{"@id":"_:dc83c36d63f80c9d09d93b4b91c4e522d2bb0aa34fcff4d48532a51479750982_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d90b9fa0-8ce6-421a-ae6e-2ae477fcefc9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/d90b9fa0-8ce6-421a-ae6e-2ae477fcefc9/resource/1612e369-0b51-4017-8557-24ccd9074856"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/JUST"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Dette er et nøgletal for udviklingen. Se spørgsmål og svar på kolada.se for\nyderligere information. Statistikken rapporteres af den kommune, hvor\nforbrydelsen blev begået (gerningsstedet). Forbrydelseskategorien hærværk\nomfatter \"skade/grov skade/skade på motorkøretøjer (ikke brand), ved brand\n(inklusive motorkøretøjer), graffiti, mod staten, kommunen, regionen (ikke\ngraffiti), anden skade\" og \"brandstiftelse/grov brandstiftelse\". Henviser til\nårene T-2 til T.\n\nKilde: BRÅ og Statistiska centralbyrån (via Kolada)\n\n"},{"@language":"en","@value":"This is a development key figure, see questions and answers on kolada.se for\nmore information. The statistics are reported by the municipality where the\ncrime was committed (crime scene). The crime category of crimes of vandalism\nincludes \"damage/aggravated damage/damage to motor vehicles (not fire), by\nfire (including motor vehicles), graffiti, against the state, municipality,\nregion (not graffiti), other damage\" and \"arson/aggravated arson\". Refers to\nthe years T-2 to T.\n\nSource: BRÅ and Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Detta är ett utvecklingsnyckeltal, se frågor och svar på kolada.se för mer information. Statistiken redovisas efter den kommun där brottet har begåtts (brottsplats). I brottskategorin brott om skadegörelse ingår \"skadegörelse/grov skadegörelse/åverkan på motorfordon (ej brand), genom brand (även motorfordon), klotter, mot stat, kommun, region (ej klotter), annan skadegörelse\" samt \"mordbrand/grov mordbrand\". Avser åren T-2 till T.  \n  \nKälla: BRÅ och SCB (via Kolada)"}],"dct:identifier":"d90b9fa0-8ce6-421a-ae6e-2ae477fcefc9","dct:issued":{"@type":"xsd:date","@value":"2022-12-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:49:29.665725"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:dc83c36d63f80c9d09d93b4b91c4e522d2bb0aa34fcff4d48532a51479750982_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Anmeldte hærværksforbrydelser per 1.000 indbyggere"},{"@language":"en","@value":"Reported crimes of vandalism per 1,000 inhabitants"},{"@language":"sv","@value":"Anmälda brott om skadegörelse per 1 000 inv"}]},{"@id":"https://opendata-api.malmo.se/dataset/d90b9fa0-8ce6-421a-ae6e-2ae477fcefc9/resource/1612e369-0b51-4017-8557-24ccd9074856","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/U07452"},"dct:description":[{"@language":"da","@value":"Dette er et nøgletal for udviklingen. Se spørgsmål og svar på kolada.se for\nyderligere information. Statistikken rapporteres af den kommune, hvor\nforbrydelsen blev begået (gerningsstedet). Forbrydelseskategorien hærværk\nomfatter \"skade/grov skade/skade på motorkøretøjer (ikke brand), ved brand\n(inklusive motorkøretøjer), graffiti, mod staten, kommunen, regionen (ikke\ngraffiti), anden skade\" og \"brandstiftelse/grov brandstiftelse\". Henviser til\nårene T-2 til T.\n\nKilde: BRÅ og Statistiska centralbyrån (via Kolada)\n\n"},{"@language":"en","@value":"This is a development key figure, see questions and answers on kolada.se for\nmore information. The statistics are reported by the municipality where the\ncrime was committed (crime scene). The crime category of crimes of vandalism\nincludes \"damage/aggravated damage/damage to motor vehicles (not fire), by\nfire (including motor vehicles), graffiti, against the state, municipality,\nregion (not graffiti), other damage\" and \"arson/aggravated arson\". Refers to\nthe years T-2 to T.\n\nSource: BRÅ and Statistics Sweden (via Kolada)\n\n"},{"@language":"sv","@value":"Detta är ett utvecklingsnyckeltal, se frågor och svar på kolada.se för mer information. Statistiken redovisas efter den kommun där brottet har begåtts (brottsplats). I brottskategorin brott om skadegörelse ingår \"skadegörelse/grov skadegörelse/åverkan på motorfordon (ej brand), genom brand (även motorfordon), klotter, mot stat, kommun, region (ej klotter), annan skadegörelse\" samt \"mordbrand/grov mordbrand\". Avser åren T-2 till T.  \n  \nKälla: BRÅ och SCB (via Kolada)"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-01T09:51:56.972468"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:49:29.691542"},"dct:title":[{"@language":"da","@value":"Anmeldte hærværksforbrydelser per 1.000 indbyggere"},{"@language":"en","@value":"Reported crimes of vandalism per 1,000 inhabitants"},{"@language":"sv","@value":"Anmälda brott om skadegörelse per 1 000 inv"}]}],"@id":"urn:source:dc83c36d63f80c9d09d93b4b91c4e522d2bb0aa34fcff4d48532a51479750982"},{"@graph":[{"@id":"_:dd22785440adb1f71a419d631bd9963a493bddd1ff782ee8f9a4f207c7150f1a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/ea2ed4a9-c09f-4f1e-9bf4-3f5ebf4f9924","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/ea2ed4a9-c09f-4f1e-9bf4-3f5ebf4f9924/resource/3584fada-b20f-407e-8a00-eec7e1c53831"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsafvigelsen er nettoomkostninger minus referenceomkostninger\nfor fritidshjem inklusive åbne fritidsaktiviteter, vist her i millioner SEK.\n\nPædagogisk pasning (tidligere kaldet familiedagpleje) er ikke inkluderet.\n\nNettoomkostningerne er bruttoomkostningerne minus bruttoindkomsten.\nReferenceomkostningerne er baseret på nettoomkostninger og strukturelle\nvariabler for det indeværende år. Standardomkostningerne for fritidshjem\nberegnes ved hjælp af variablerne andel af personer indskrevet i fritidshjem\nog andel af 6-12-årige. Derudover lægges en del af standardomkostningerne fra\ndelmodellerne lønninger, bygningsstruktur og befolkningsudvikling til.\n\nPositive værdier indikerer en højere omkostningssituation end forventet, og\nnegative værdier indikerer en lavere omkostningssituation end forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR.\n\n"},{"@language":"en","@value":"Net cost deviation is net cost minus reference cost for after-school centers\nincluding open after-school activities, shown here in millions of SEK.\n\nEducational care (formerly called family daycare) is not included.\n\nNet cost is gross cost minus gross income. The reference cost is based on net\ncosts and structural variables for the current year. The standard cost for\nafter-school centers is calculated using the variables share of people\nenrolled in after-school centers and share of 6-12 year olds. In addition,\npart of the standard costs from the sub-models salaries, building structure\nand population development are added.\n\nPositive values ​​indicate a higher cost situation than expected and negative\nvalues ​​indicate a lower cost situation than expected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR.\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelse är nettokostnad minus referenskostnad för fritidshem inklusive öppen fritidsverksamhet, här visat i miljoner kronor. \n\nPedagogisk omsorg (tidigare kallat familjedaghem) ingår inte. \n\nNettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnader och strukturvariabler för det aktuella året. Standardkostnaden för fritidshem beräknas med hjälp av variablerna andel inskrivna i fritidshem samt andel 6-12 åringar. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. \n\nPositiva värden indikerar högre kostnadsläge än förväntat och negativa värden ett lägre kostnadsläge än förväntat. \n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR."}],"dct:identifier":"ea2ed4a9-c09f-4f1e-9bf4-3f5ebf4f9924","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:08:19.867072"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:dd22785440adb1f71a419d631bd9963a493bddd1ff782ee8f9a4f207c7150f1a_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse for fritidshjem, inklusive åbne fritidshjemsaktiviteter, mio. SEK"},{"@language":"en","@value":"Net cost variance for after-school centers, including open after-school activities, SEK million"},{"@language":"sv","@value":"Nettokostnadsavvikelse fritidshem, inklusive öppen fritidsverksamhet, miljoner kronor"}]},{"@id":"https://opendata-api.malmo.se/dataset/ea2ed4a9-c09f-4f1e-9bf4-3f5ebf4f9924/resource/3584fada-b20f-407e-8a00-eec7e1c53831","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N13032"},"dct:description":[{"@language":"da","@value":"Nettoomkostningsafvigelsen er nettoomkostninger minus referenceomkostninger\nfor fritidsordninger inklusive åbne fritidsaktiviteter, vist her i millioner\nSEK. Pædagogisk pasning (tidligere kaldet familiedagpleje) er ikke inkluderet.\nNettoomkostningen er bruttoomkostninger minus bruttoindkomst.\nReferenceomkostningerne er baseret på nettoomkostninger og strukturelle\nvariabler for det indeværende år. Standardomkostningerne for fritidsordninger\nberegnes ved hjælp af variablerne andel af personer indskrevet i\nfritidsordninger og andel af 6-12-årige. Derudover lægges en del af\nstandardomkostningerne fra delmodellerne lønninger, bygningsstruktur og\nbefolkningsudvikling til. Positive værdier indikerer en højere\nomkostningssituation end forventet, og negative værdier en lavere\nomkostningssituation end forventet. Fra og med 2019 beregnes\nnettoomkostningsafvigelsen på en ny måde på grund af ændringer i\nomkostningsudligningen. Dette påvirker sammenligneligheden med tidligere år.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Net cost deviation is net cost minus reference cost for after-school care\nincluding open after-school activities, shown here in millions of SEK.\nEducational care (formerly called family daycare) is not included. Net cost is\ngross cost minus gross income. The reference cost is based on net costs and\nstructural variables for the current year. The standard cost for after-school\ncare is calculated using the variables share of people enrolled in after-\nschool care and share of 6-12 year olds. In addition, part of the standard\ncosts from the sub-models salaries, building structure and population\ndevelopment are added. Positive values ​​indicate a higher cost situation than\nexpected and negative values ​​a lower cost situation than expected. From 2019\nonwards, net cost deviation is calculated in a new way due to changes in cost\nequalization. This affects comparability with previous years. Source: Kolada\n\n"},{"@language":"sv","@value":"Nettokostnadsavvikelse är nettokostnad minus referenskostnad för fritidshem inkl. öppen fritidsverksamhet, här visat i miljoner kronor. Pedagogisk omsorg (tidigare kallat familjedaghem) ingår inte. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnader och strukturvariabler för det aktuella året. Standardkostnaden för fritidshem beräknas med hjälp av variablerna andel inskrivna i fritidshem samt andel 6-12 åringar. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. Positiva värden indikerar högre kostnadsläge än förväntat och negativa värden ett lägre kostnadsläge än förväntat. Från och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt pga förändringar i kostnadsutjämningen.  Detta påverkar jämförbarheten med tidigare år. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T08:18:43.300122"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:08:19.890224"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse for fritidshjem, inkl. åbne fritidshjemsaktiviteter, SEK millioner (N13032)"},{"@language":"en","@value":"Net cost variance after-school centers, incl. open after-school activities, SEK million (N13032)"},{"@language":"sv","@value":"Nettokostnadsavvikelse fritidshem, inkl. öppen fritidsverksamhet, miljoner kronor (N13032)"}]}],"@id":"urn:source:dd22785440adb1f71a419d631bd9963a493bddd1ff782ee8f9a4f207c7150f1a"},{"@graph":[{"@id":"_:de9f8998e9e575bbc48e95b6b2d530354f84c7679e006f3838c7f70e1d83cc25_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"239757525c392ec3080047f07c9be748"},{"@id":"_:de9f8998e9e575bbc48e95b6b2d530354f84c7679e006f3838c7f70e1d83cc25_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/245dae5c-ff37-48af-b16b-537373112397","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/245dae5c-ff37-48af-b16b-537373112397/resource/1d2ce6ca-421a-47af-8661-550e3d640f6a"},{"@id":"https://opendata-api.malmo.se/dataset/245dae5c-ff37-48af-b16b-537373112397/resource/9e3eab8b-7bce-4e8d-b622-cb87f932bc5a"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Vises som et gennemsnit af den årlige indkomst for beboere i området. Består\naf summen af ​​al skattepligtig og skattefri indkomst fratrukket skat og andre\nnegative overførsler. Den skattepligtige indkomst består blandt andet af:\nlønindkomst, indkomst fra erhvervsaktivitet, kapitalindkomst, pension,\nsygedagpenge, sygedagpenge i særlige tilfælde, fast indkomst, boligtillæg,\narbejdsmarkedsstøtte, forældreydelse og syge- og aktivitetskompensation.\nSkattefri indkomst består blandt andet af: boligstøtte, børnetilskud,\nstudiestøtte inkl. studielån, økonomisk bistand og underholdsbidrag (fra\nIndkomstregisteret 2013). Negative overførsler består blandt andet af: skat,\ntilbagebetaling af studielån og udbetalt underholdsbidrag. Fradraget følger\n2004-definitionen, som også omfatter bruttokapitalgevinster og -tab. Bemærk,\nat indkomst, der kun beskattes i udlandet, ikke er inkluderet. Dette påvirker\nf.eks. dem, der arbejder i Danmark; deres indkomst er ikke inkluderet i\nstatistikken. Tallene er vist i løbende priser, hvilket betyder, at de ikke er\ninflationsjusteret. Det skal understreges, at disponibel indkomst ikke giver\net mål for økonomisk velfærd i bred forstand. Uden for målingerne er blandt\nandet egenproduktion i boliger, fordelen ved offentligt forbrug og eventuel\n\"sort\" indkomst. Fra 2012 er introduktionsgodtgørelsen udeladt af opgørelsen\naf ​​økonomisk bistand. Bemærk, at denne variabel vises for befolkningen i\nalle aldre. Vist som et gennemsnit af den årlige indkomst for området.\nVariablen er opdelt efter køn. Data fra Indkomst- og Skatteregisteret (IoT).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows as an average of the annual income for residents in the area. Consists\nof the sum of all taxable and tax-free income minus tax and other negative\ntransfers. Taxable income consists of, among other things: wage income, income\nfrom business activities, income from capital, pension, sickness benefit,\nsickness benefit in special cases, flat-rate income, housing supplement,\nlabour market support, parental benefit and sickness and activity\ncompensation. Tax-free income consists of, among other things: housing\nallowance, child allowance, student aid incl. student loans, financial\nassistance and maintenance allowance (from the Incomes Register 2013).\nNegative transfers consist of, among other things: tax, repayment of student\nloans and maintenance allowance paid. The deduction follows the 2004\ndefinition, which also includes gross capital gains and capital losses. Note\nthat income that is only taxed abroad is not included. This affects, for\nexample, those who work in Denmark; their income is not included in the\nstatistics. The figures are shown in current prices, which means that they are\nnot adjusted for inflation. It should be emphasized that disposable income\ndoes not provide a measure of economic welfare in the broad sense. Outside the\nmeasurements are, among other things, own production in homes, the benefit of\npublic consumption and any \"black\" income. From 2012, the introduction\nallowance is excluded from the accounting of financial assistance. Note that\nthis variable is shown for the population of all ages. Shown as an average of\nthe annual income for the area. The variable is broken down by gender. Data\nfrom the Income and Taxation Register (IoT).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar som ett genomsnitt av årsinkomsten för boende i området. Består av summan av alla skattepliktiga och skattefria inkomster minus skatt och övriga negativa transfereringar. Skattepliktiga inkomster består bland annat av: löneinkomst, inkomst från näringsverksamhet, inkomst av kapital, pension, sjukpenning, sjukpenning i särskilda fall, schablonintäkter, boendetillägg, arbetsmarknadsstöd, föräldrapenning och sjuk- och aktivitetsersättning. Skattefria inkomster består bland annat av: bostadsbidrag, barnbidrag, studiestöd inkl. studielån, ekonomiskt bistånd och underhållsbidrag (fr.o.m. inkomstregistret 2013). Negativa transfereringar består bland annat av: skatt, återbetalning av studielån och utbetalt underhållsbidrag. Uttaget följer 2004 års definition vilket även inkluderar kapitalvinster och kapitalförluster brutto. Notera att inkomster som bara beskattas utomlands inte finns med. Detta berör t.ex. de som arbetare i Danmark; deras inkomster räknas ingår inte i statistiken. Siffrorna visas i löpande priser vilket betyder att de inte är inflationsjusterade. Det bör understrykas att disponibel inkomst inte ger ett mått av ekonomisk välfärd i vid mening. Utanför mätningarna ligger bland annat egen produktion i hemmen, nyttan av offentlig konsumtion samt eventuella \"svarta\" inkomster. Från och med 2012 exkluderas introduktionsersättningen ur redovisningen av ekonomiskt bistånd. Notera att denna variabel visas för befolkningen i alla åldrar.  Visas som ett genomsnitt av årsinkomsten för området. Variabeln finns uppdelad på kön. Data från Inkomst- och taxeringsregistret (IoT).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"245dae5c-ff37-48af-b16b-537373112397","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:06:54.776065"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:de9f8998e9e575bbc48e95b6b2d530354f84c7679e006f3838c7f70e1d83cc25_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Disponibel indkomst 2007-2019 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Disposable income 2007-2019 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Disponibel inkomst 2007-2019 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/245dae5c-ff37-48af-b16b-537373112397/resource/1d2ce6ca-421a-47af-8661-550e3d640f6a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/245dae5c-ff37-48af-b16b-537373112397/resource/1d2ce6ca-421a-47af-8661-550e3d640f6a/download/disponibel-inkomst-2007-2019.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"534757"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Disponibel indkomst 2007-2019\n\n"},{"@language":"en","@value":"Malmö statistics - Disposable income 2007-2019\n\n"},{"@language":"sv","@value":"Malmö statistik - Disponibel inkomst 2007-2019"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:09.218767"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:m