:26.789592"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:3f7f8495bda0d07b6ffaecfd7655ae2ca9caff2f0847d9815ef77b694471cf1e_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Cykelpumper"},{"@language":"en","@value":"Bicycle pumps"},{"@language":"sv","@value":"Cykelpumpar"}]},{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/12946fac-8e4e-4c52-ab12-8fad91da131a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/12946fac-8e4e-4c52-ab12-8fad91da131a/download/cykelpumpar.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"14359"},"dct:description":[{"@language":"da","@value":"cykelpumper\n\n"},{"@language":"en","@value":"bicycle pumps\n\n"},{"@language":"sv","@value":"cykelpumpar"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-20T06:31:37.259725"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-01T04:00:18.090727"},"dct:title":[{"@language":"da","@value":"cykelpumper"},{"@language":"en","@value":"bicycle pumps"},{"@language":"sv","@value":"cykelpumpar"}]},{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/d0a66bf5-aad4-465b-89c1-88b83ce3decb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/d0a66bf5-aad4-465b-89c1-88b83ce3decb/download/cykelpumpar.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"4177"},"dct:description":[{"@language":"da","@value":"cykelpumper\n\n"},{"@language":"en","@value":"bicycle pumps\n\n"},{"@language":"sv","@value":"cykelpumpar"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-20T06:39:24.353044"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-01T04:00:26.804702"},"dct:title":[{"@language":"da","@value":"cykelpumper"},{"@language":"en","@value":"bicycle pumps"},{"@language":"sv","@value":"cykelpumpar"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:3f7f8495bda0d07b6ffaecfd7655ae2ca9caff2f0847d9815ef77b694471cf1e_b0n0"}},{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/f6fdbea3-8997-4ecf-a8f1-b0ef9a2cc9a3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c6051c71-4d12-4c93-9966-1ad599430d03/resource/f6fdbea3-8997-4ecf-a8f1-b0ef9a2cc9a3/download/cykelpumpar.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"98304"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"cykelpumper\n\n"},{"@language":"en","@value":"bicycle pumps\n\n"},{"@language":"sv","@value":"cykelpumpar"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-20T06:27:40.148292"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-01T04:00:11.607347"},"dct:title":[{"@language":"da","@value":"cykelpumper"},{"@language":"en","@value":"bicycle pumps"},{"@language":"sv","@value":"cykelpumpar"}]}],"@id":"urn:source:3f7f8495bda0d07b6ffaecfd7655ae2ca9caff2f0847d9815ef77b694471cf1e"},{"@graph":[{"@id":"_:412d4ee00a5c1e6de859c4d9c7a5b8a0e038ee7e6ff3e02f22bc262d7a64ecba_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"8b09b13bf038e8ece8b5f132c44bc256"},{"@id":"_:412d4ee00a5c1e6de859c4d9c7a5b8a0e038ee7e6ff3e02f22bc262d7a64ecba_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48/resource/60f580f1-4a74-44a5-b3a1-d76f0132d664"},{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48/resource/fb8c2776-ea14-41b2-b3ba-a4152881c6f1"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser andelen af ​​beskæftigede blandt befolkningen i området i alderen 20-65\når. Data fra BAS (\"Befolkningens arbejdsmarkedsstatus\"). I BAS kategoriseres\nen person som beskæftiget, hvis de i november måned i referenceåret har\nmodtaget kompensation i henhold til arbejdsgiverens erklæringer indberettet\ntil Skatteverket (eller tilsvarende for dem, der arbejder i resten af\n​​Norden), anses for at være aktive som virksomhedsejer, handels- eller\nkommanditselskabsejer, eller tidligere har modtaget kompensation i henhold til\novenstående i løbet af året og har modtaget en vis kompensation fra\nSocialförsäkringsverket i november måned (forældrepenge, graviditetsydelse,\nsygedagpenge og lignende). Fra referenceåret 2022 anvendes en ny datakilde,\nnår SCB ændrer datakilden til BAS fra den tidligere RAMS (\"Registerbaseret\narbejdsmarkedsstatistik\"). Der er forskelle på, hvordan RAMS definerer\nerhvervsaktive, og hvordan BAS definerer erhvervsaktive. For eksempel\nklassificerer RAMS dem, der arbejder i Danmark, som ikke-erhvervsaktive, mens\nde i BAS tælles som beskæftigede under visse omstændigheder. Der er derfor et\ntidsseriebrud for denne tidsserie, der starter med data fra 2022. Ændringen i\nkilde og metode betyder, at sammenligninger af statistikker vedrørende\ndagbefolkningen i 2022 og tidligere referenceår skal foretages med stor\nforsigtighed. Læs mere på SCB.se.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the proportion of employed people among the population in the area aged\n20–65. Data from BAS (\"Labour Market Status of the Population\"). In BAS, a\nperson is categorized as employed if, during the month of November of the\nreference year, they have received compensation according to the employer's\ndeclarations reported to the Swedish Tax Agency (or equivalent for those\nworking in the rest of the Nordic region), are considered to be active as a\nbusiness owner, trading or limited partnership owner, or have previously\nreceived compensation according to the above during the year and have received\ncertain compensation from the Swedish Social Insurance Agency during the month\nof November (parental benefit, pregnancy benefit, sickness benefit and\nsimilar). From the reference year 2022, a new data source is used when SCB\nchanges the data source to BAS from the previous RAMS (\"Register-based labour\nmarket statistics\"). There are differences between how RAMS defines gainfully\nemployed people and how BAS defines employed people. For example, RAMS\nclassifies those working in Denmark as not gainfully employed, while in BAS\nthey are counted as employed under certain circumstances. There is therefore a\ntime series break for this time series starting with data from 2022. The\nchange in source and method means that comparisons of statistics regarding\ndaytime population in 2022 and previous reference years must be made with\ngreat caution. Read more at SCB.se.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar andelen sysselsatta bland befolkning i området i åldrarna 20–65 år. Data från BAS (\"Befolkningens arbetsmarknadsstatus\"). I BAS kategoriseras man som sysselsatt om man under november månad referensåret har erhållt ersättning enligt de arbetsgivardeklarationer som redovisas till Skatteverket (eller motsvarande för de som arbetar i övriga Norden), bedöms vara verksam som näringsidkare, handels- eller kommanditbolagägare, eller tidigare under året erhållt ersättning enligt ovan och under november månad fått vissa ersättningar från Försäkringskassan (föräldrapenning, graviditetspenning, sjukpenning och liknande). Från och med referensår 2022 används en ny datakälla då SCB byter datakälla till BAS från tidigare RAMS (\"Registerbaserad arbetsmarknadsstatistik\"). Det finns skillnader mellan hur RAMS definierar förvärvsarbetande och hur BAS definierar sysselsatta. Till exempel klassar RAMS de som arbetar i Danmark som ej förvärvsarbetande medan de i BAS under vissa omständigheter räknas som sysselsatta. Det sker därför ett tidsseriebrott för denna tidsserie med start med data från 2022. Bytet av källa och metod innebär att jämförelser av statistik avseende dagbefolkning 2022 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se.  \n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"0f6029bd-15d1-4551-ba81-68f08aa2db48","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:27.091196"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:412d4ee00a5c1e6de859c4d9c7a5b8a0e038ee7e6ff3e02f22bc262d7a64ecba_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Beskæftigelsesfrekvens, 2022 - - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Employment rate, 2022 - - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Sysselsättningsgrad, 2022 - - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48/resource/60f580f1-4a74-44a5-b3a1-d76f0132d664","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=fb8c2776-ea14-41b2-b3ba-a4152881c6f1"},"dct:description":[{"@language":"da","@value":"Malmø-statistik - Beskæftigelsesfrekvens, 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Employment rate, 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Sysselsättningsgrad, 2022 -"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:28.485760"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:27.109285"},"dct:title":[{"@language":"da","@value":"Beskæftigelsesfrekvens, 2022 -"},{"@language":"en","@value":"Employment rate, 2022 -"},{"@language":"sv","@value":"Sysselsättningsgrad, 2022 -"}]},{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48/resource/fb8c2776-ea14-41b2-b3ba-a4152881c6f1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/0f6029bd-15d1-4551-ba81-68f08aa2db48/resource/fb8c2776-ea14-41b2-b3ba-a4152881c6f1/download/sysselsattningsgrad-2022-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"138739"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Beskæftigelsesfrekvens, 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Employment rate, 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Sysselsättningsgrad, 2022 -"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:26.735495"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:27.109116"},"dct:title":[{"@language":"da","@value":"Beskæftigelsesfrekvens, 2022 -"},{"@language":"en","@value":"Employment rate, 2022 -"},{"@language":"sv","@value":"Sysselsättningsgrad, 2022 -"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:412d4ee00a5c1e6de859c4d9c7a5b8a0e038ee7e6ff3e02f22bc262d7a64ecba_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:412d4ee00a5c1e6de859c4d9c7a5b8a0e038ee7e6ff3e02f22bc262d7a64ecba"},{"@graph":[{"@id":"_:43c48732c995858bc4c004fbc61e406d869514705032f459a1f2a10c0b4241ec_b0n0","@type":"dct:Loc