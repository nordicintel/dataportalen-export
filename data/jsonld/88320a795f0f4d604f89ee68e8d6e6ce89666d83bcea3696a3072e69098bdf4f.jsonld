ord":["Malmö stad","bakgrundskarta","geodata","gis","map","markanvändning","marktäcke","markytor","översiktskartan"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"da","@value":"**Tilhører det primære kort**\n\nOmfattende arealanvendelse for Malmø Kommune, udarbejdet i henhold til\nanvendelsesområderne i juridisk bindende detaljeplaner. Arealerne viser derfor\neksisterende og i nogle tilfælde planlagt arealanvendelse. Arealanvendelsen er\nopdelt i blokarealer, befæstet areal og grønne områder.\n\n"},{"@language":"en","@value":"**Belongs to the Primary Map**\n\nComprehensive land use for Malmö Municipality, produced according to the use\nareas of legally binding detailed plans. The land areas therefore show\nexisting and in some cases planned land use. Land use is divided into block\nland, paved area and green space.\n\n"},{"@language":"sv","@value":"__Tillhör Primärkartan__\n<p>\nHeltäckande markanvändning för Malmö kommun, framtaget efter lagakraftvunna detaljplaners användningsytor. Markytorna visar därför befintlig och i vissa fall planerad markanvändning. Markanvändningen är uppdelad på kvartersmark, hårdgjord yta och grönyta."}],"dct:identifier":"c37d0a55-9be7-4984-9ce1-a6227c5b3c31","dct:issued":{"@type":"xsd:date","@value":"2023-06-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:33:33.354516"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:18caa966586690b3406fa39a15a0140784e5bdd8269043dfeac4a0fc92c1404a_b5n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Landoverflader"},{"@language":"en","@val