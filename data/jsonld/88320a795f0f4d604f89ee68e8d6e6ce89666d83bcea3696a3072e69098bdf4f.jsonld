esource/ccb56bb4-cc5b-4a0e-8dbc-31c058152389","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N05805"},"dct:description":[{"@language":"da","@value":"Antal stemmer for Moderaterne ved det seneste kommunalvalg divideret med\nantallet af gyldige stemmer ved det seneste kommunalvalg, ganget med 100.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of votes for the Moderates in the last municipal election divided by\nthe number of valid votes in the last municipal election, multiplied by 100.\nSource: Kolada\n\n"},{"@language":"sv","@value":"Antal röster på Moderaterna i senaste kommunvalet dividerat med antalet giltiga röster i senaste kommunvalet, multiplicerat med 100. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T06:03:00.366853"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T06:53:20.985782"},"dct:title":[{"@language":"da","@value":"Stemmer for Moderaterne ved det seneste kommunalvalg, andel (%) (N05805)"},{"@language":"en","@value":"Votes for the Moderate Party in the last municipal election, share (%) (N05805)"},{"@language":"sv","@value":"Röster på Moderaterna i senaste kommunvalet, andel (%) (N05805)"}]}],"@id":"urn:source:1091571fdabe8eb69562281ba64014037ac1bf8ad3e122e5913959d404dc434e"},{"@graph":[{"@id":"_:10ce7bfc8a192606dc77590f81a61d7c4e713751c8ec885bad09f646479817f8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/4d28f841-64c4-455d-860a-b057665f58b6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/4d28f841-64c4-455d-860a-b057665f58b6/resource/1fc7ae13-0680-4d54-9d15-ba2a9cbb4880"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem.\n\nStatistik i procenter fra 2013.\n\nBegrebet \"lokationskommune\" henviser til elever i både kommunale og friskoler\nbeliggende i kommunen, uanset hvor de er indskrevet.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system.\n\nStatistics in percentages from 2013.\n\nThe term \"location municipality\" refers to students in both municipal and\nindependent schools located in the municipality, regardless of where they are\nregistered.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet.\n\nStatistik i procent från 2013.\n\nMed lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. \n\nKälla: Skolverket (Siris)."}],"dct:identifier":"4d28f841-64c4-455d-860a-b057665f58b6","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:15:44.934807"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:10ce7bfc8a192606dc77590f81a61d7c4e713751c8ec885bad09f646479817f8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse med mindst karakteren E i matematik, placeringskommune"},{"@language":"en","@value":"Students in grade 9 with a minimum grade of E in mathematics, location municipality"},{"@language":"sv","@value":"Elever i årskurs 9 med lägst betyget E  i matematik, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/4d28f841-64c4-455d-860a-b057665f58b6/resource/1fc7ae13-0680-4d54-9d15-ba2a9cbb4880","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15495"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem. Elever i 9. klasse med minimum karakteren\nE i matematik, placeringskommune, procentdel (%). Placeringskommune refererer\ntil elever i både kommunale og private skoler beliggende i kommunen, uanset\nhvor de er indskrevet. Kilde: Kolada\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system. Students in grade 9 with a minimum grade of\nE in mathematics, location municipality, percentage (%). Location municipality\nrefers to students in both municipal and independent schools located in the\nmunicipality regardless of where they are registered. Source: Kolada\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. Elever i åk 9 med lägst betyget E  i matematik, lägeskommun, andel (%). Med lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-19T08:25:30.628381"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:15:44.939006"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse med minimum karakteren E i matematik, kommune, procentdel (%) (N15495)"},{"@language":"en","@value":"Students in grade 9 with a minimum grade of E in mathematics, municipality of location, percentage (%) (N15495)"},{"@language":"sv","@value":"Elever i åk 9 med lägst betyget E  i matematik, lägeskommun, andel (%) (N15495)"}]}],"@id":"urn:source:10ce7bfc8a192606dc77590f81a61d7c4e713751c8ec885bad09f646479817f8"},{"@graph":[{"@id":"_:13093e6a60f23daae0ce555196968e55cd47b5c279cf9a42c4be0c963712f074_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"7a5d084a91bc49e148dd1ac7edb664e4"},{"@id":"_:13093e6a60f23daae0ce555196968e55cd47b5c279cf9a42c4be0c963712f074_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"77f6747029424568a0a3dbf4ceb4dec3"},{"@id":"_:13093e6a60f23daae0ce555196968e55cd47b5c279cf9a42c4be0c963712f074_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://malmo.se/Uppleva-och-gora/For-familjer-barn-och-unga/Temalekplatser.html","@type":"dct:Standard"},{"@id":"https://opendata-api.malmo.se/dataset/c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2/resource/045d6e25-adbb-4f91-8768-c862049168ed"},{"@id":"https://opendata-api.malmo.se/dataset/c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2/resource/a136d680-a0f2-4f81-a078-7f4a6a262a8d"},{"@id":"https://opendata-api.malmo.se/dataset/c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2/resource/c18f001e-891c-42c6-86e2-f30b8749e26f"}],"dcat:keyword":["Malmö stad","aktivitet","barn","hälsa","lek","nöje"],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":{"@id":"https://malmo.se/Uppleva-och-gora/For-familjer-barn-och-unga/Temalekplatser.html"},"dct:description":[{"@language":"da","@value":"Pladserne på offentligt areal med forskelligt udstyr, såsom gynger og\nsandkasser, beregnet til børns aktivitet, kreativitet og sjov. Nogle af Malmøs\nlegepladser er temalegepladser med unikke, specialbyggede attraktioner, der\nfølger et bestemt tema.\n\nLegepladserne i dette datasæt forvaltes af Malmø Kommune.\n\nDatasættet opfylder de obligatoriske attributter i den nationale specifikation\nfor legepladser. Mulige værdier for `type` er blevet udvidet med T (for\ntemalegeplads).  \nhttps://lankadedata.se/spec/lekplatser/.\n\n"},{"@language":"en","@value":"Places on public land with various equipment, such as swings and sandboxes,\nintended for children's activity, creativity and fun. Some of Malmö's\nplaygrounds are themed playgrounds with unique, specially built attractions\nthat follow a certain theme.\n\nPlaygrounds in this dataset are managed by the City of Malmö.\n\nThe dataset meets the mandatory attributes of the national specification for\nplaygrounds. Possible values ​​for the attribute `type` have been extended\nwith T (for theme playground).  \nhttps://lankadedata.se/spec/lekplatser/.\n\n"},{"@language":"sv","@value":"Platser på allmän platsmark med diverse utrustning, t ex gungor och sandlådor, ämnade för barns aktivitet, kreativitet och nöje.\nEn del av Malmös lekplatser är temalekplatser med unika, specialbyggda attraktioner som följer ett visst tema.\n\nLekplatser i denna datamängd förvaltas av Malmö stad.  \n  \nDatamängden uppfyller de obligatoriska attributen av den nationella specifikationen för lekplatser. Möjliga värden för attributet `type` har utökats med T (för temalekplats).  \nhttps://lankadedata.se/spec/lekplatser/.  "}],"dct:identifier":"c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2","dct:issued":{"@type":"xsd:date","@value":"2026-05-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T02:35:42.089138"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:13093e6a60f23daae0ce555196968e55cd47b5c279cf9a42c4be0c963712f074_b2n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Legepladser"},{"@language":"en","@value":"Playgrounds"},{"@language":"sv","@value":"Lekplatser"}]},{"@id":"https://opendata-api.malmo.se/dataset/c08d7231-9b49-4af5-94bd-3bc6ed5cf7a2/resource/045d6e25-adbb-4f91-8768-c862049168ed","@type":"dcat:D