esource/590e717ed624870c5e5af379a019ac72","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"GIS-enheten, Stadsbyggnadskontoret, Malmö stad","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sbk.geodata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/590e717ed624870c5e5af379a019ac72"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/26134fa0-95f9-41bb-8a4e-55a681ced799"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/30489778-8eb4-43f9-bc52-b7e4c05ac9e4"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/733840dd-affa-4a20-99f3-006c291ed240"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/79e4db81-62c1-4e02-a4ce-9ff4eaa90d46"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/8147ab89-e30f-43bc-9206-cafb0abeceac"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/88140069-9975-485e-8695-faf1eb52822c"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/968bc7e7-0f29-4a1e-a3ce-ccd1bd5c8c24"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/a4b8fd55-1b4d-4043-8f40-dbf112f2c206"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/a5800991-bc33-4956-9035-fd9de3c282d6"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/d190adc8-f0d5-4501-ae5a-eb569915a3d0"},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/e4095d48-4730-464d-8e76-e9995d09fd0f"}],"dcat:keyword":["Malmö stad","Primärkarta","byggnader","geodata","gis","karta","map","transport","träd","vatten","vägar"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"da","@value":"Det primære kort beskriver byens fysiske træk, såsom bygninger, træer eller\ntransport. Oplysningerne opdateres løbende af Byplankontoret, og en ny version\noffentliggøres dagligt. Oplysningerne gemmes som punkt-, linje- og\narealobjekter.\n\nBemærk: Hovedkortet og dets lag er ikke komplette i alle dele af byen.\nArbejdet med at forbedre kvaliteten er i gang. For yderligere information,\nkontakt Byplankontoret eller brug formularen.\n\n"},{"@language":"en","@value":"The primary map describes the physical features of the city, such as\nbuildings, trees or transport. The information is continuously updated by the\nCity Planning Office and a new version is published daily. The information is\nstored as point, line and area objects.\n\nPlease note: The primary map and its layers are not complete in all parts of\nthe city. Work to improve the quality is ongoing, for more information contact\nthe City Planning Office or via the form.\n\n"},{"@language":"sv","@value":"Primärkartan beskriver det fysiska i staden, såsom byggnader, träd eller transport. Informationen uppdateras kontinuerligt av Stadsbyggnadskontoret och ny version publiceras dagligen. Informationen är lagrad som punkt-, linje- och ytobjekt. \n\nObservera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:identifier":"d463475a-5dd9-4130-a97a-dc3e19f1da71","dct:issued":{"@type":"xsd:date","@value":"2022-10-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:28:22.052506"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b11n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Det primære kort"},{"@language":"en","@value":"The primary map"},{"@language":"sv","@value":"Primärkartan"}]},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/26134fa0-95f9-41bb-8a4e-55a681ced799","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/26134fa0-95f9-41bb-8a4e-55a681ced799/download/transport.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"150728921"},"dct:description":[{"@language":"da","@value":"Transporttemaet i det primære kort består af objekter, der udgør en geografisk\nbeskrivelse af byens veje, pladser, tunneler og broer. Objekterne i\ntransporttemaet er offentliggjort som linjeobjekter. Bemærk venligst: Det\nprimære kort og dets lag er ikke komplette i alle dele af byen. Arbejdet med\nat forbedre kvaliteten er i gang, for mere information kontakt Byplankontoret\neller via formularen.\n\n"},{"@language":"en","@value":"The transport theme in the primary map consists of objects that constitute a\ngeographical description of the city's roads, squares, tunnels and bridges.\nThe objects in the transport theme are published as line objects. Please note:\nThe primary map and its layers are not complete in all parts of the city. Work\nto improve the quality is ongoing, for more information contact the City\nPlanning Office or via the form.\n\n"},{"@language":"sv","@value":"Transporttemat i primärkartan består av objekt som utgör geografisk beskrivning av stadens vägar, torg, tunnlar och broar. Objekten i transporttemat är publicerade som linjeobjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2022-10-24T11:33:50.245853"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:24:01.856929"},"dct:title":[{"@language":"da","@value":"Transportere"},{"@language":"en","@value":"Transport"},{"@language":"sv","@value":"Transport"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b0n0"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/30489778-8eb4-43f9-bc52-b7e4c05ac9e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/30489778-8eb4-43f9-bc52-b7e4c05ac9e4/download/vegetation.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"5506859"},"dct:description":[{"@language":"da","@value":"Vegetation fra hovedkortet består af objekter, der udgør en geografisk\nbeskrivelse af hække, skråninger osv. Objekterne i vegetation er\noffentliggjort som linjeobjekter. Bemærk venligst: Hovedkortet og dets lag er\nikke komplette i alle dele af byen. Arbejdet med at forbedre kvaliteten er i\ngang, for mere information kontakt Byplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Vegetation from the primary map consists of objects that constitute a\ngeographical description of hedges, slopes, etc. The objects in vegetation are\npublished as line objects. Please note: The primary map and its layers are not\ncomplete in all parts of the city. Work to improve the quality is ongoing, for\nmore information contact the City Planning Office or via the form.\n\n"},{"@language":"sv","@value":"Vegetation från primärkartan består av objekt som utgör geografisk beskrivning av häckar, slänter med mera. Objekten i vegetation är publicerade som linjeobjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2022-11-03T13:50:20.248400"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:25:16.501039"},"dct:title":[{"@language":"da","@value":"Vegetation"},{"@language":"en","@value":"Vegetation"},{"@language":"sv","@value":"Vegetation"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b1n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/733840dd-affa-4a20-99f3-006c291ed240","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/733840dd-affa-4a20-99f3-006c291ed240/download/markdetaljer_pt.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"11648414"},"dct:description":[{"@language":"da","@value":"Grundoplysninger fra hovedkortet består af objekter, der udgør en geografisk\nbeskrivelse af mure, hegn, fundamenter osv. Objekterne i grundoplysningerne er\noffentliggjort som punkter. Bemærk: Hovedkortet og dets lag er ikke komplette\ni alle dele af byen. Arbejdet med at forbedre kvaliteten er i gang. For mere\ninformation kontakt Byplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Ground details from the primary map consist of objects that constitute a\ngeographical description of walls, fences, foundations, etc. The objects in\nground details are published as points. Please note: The primary map and its\nlayers are not complete in all parts of the city. Work to improve the quality\nis ongoing, for more information contact the City Planning Office or via the\nform.\n\n"},{"@language":"sv","@value":"Markdetaljer från primärkartan består av objekt som utgör geografisk beskrivning av murar, staket, fundament med mera. Objekten i markdetaljer är publicerade som punkter. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-02-24T12:55:31.929640"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:24:50.678135"},"dct:title":[{"@language":"da","@value":"Detaljer om terrænet - point"},{"@language":"en","@value":"Ground details - points"},{"@language":"sv","@value":"Markdetaljer - punkter"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/79e4db81-62c1-4e02-a4ce-9ff4eaa90d46","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/79e4db81-62c1-4e02-a4ce-9ff4eaa90d46/download/byggnader.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"43784672"},"dct:description":[{"@language":"da","@value":"Eksisterende og planlagte bygninger i byen. Bygningerne er offentliggjort som\noverfladeobjekter. Bemærk venligst: Hovedkortet og dets lag er ikke komplette\ni alle dele af byen. Arbejdet med at forbedre kvaliteten er i gang. For mere\ninformation, kontakt Byplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Existing and planned buildings in the city. The buildings are published as\nsurface objects. Please note: The primary map and its layers are not complete\nin all parts of the city. Work to improve the quality is ongoing, for more\ninformation contact the City Planning Office or via the form.\n\n"},{"@language":"sv","@value":"Befintliga och planerade byggnader i staden. Byggnaderna i publicerade som ytobjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-02-24T12:51:55.579310"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:23:14.836351"},"dct:title":[{"@language":"da","@value":"Bygninger"},{"@language":"en","@value":"Buildings"},{"@language":"sv","@value":"Byggnader"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b3n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/8147ab89-e30f-43bc-9206-cafb0abeceac","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/8147ab89-e30f-43bc-9206-cafb0abeceac/download/ovriga_pt.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"64771"},"dct:description":[{"@language":"da","@value":"Andre objekter fra det primære kort består af objekter, der udgør en\ngeografisk beskrivelse af objekter, der mangler deres egen kategori. Laget\nbestår blandt andet af objekter, der beskriver fortidsminder, broer, molearme\nog trapper. Objekterne i det andet lag er offentliggjort som punktobjekter.\nBemærk: Det primære kort og dets lag er ikke komplette i alle dele af byen.\nArbejdet med at forbedre kvaliteten er i gang, for mere information kontakt\nByplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Other objects from the primary map consist of objects that constitute a\ngeographical description of objects that lack their own category. The layer\nconsists of, among other things, objects that describe ancient remains,\nbridges, pier arms and stairs. The objects in the other layer are published as\npoint objects. Please note: The primary map and its layers are not complete in\nall parts of the city. Work to improve the quality is ongoing, for more\ninformation contact the City Planning Office or via the form.\n\n"},{"@language":"sv","@value":"Övriga objekt från primärkartan består av objekt som utgör geografisk beskrivning av objekt som saknar sig en egen kategori. Lagret består av bl.a. objekt som beskriver fornlämningar, bryggor, pirarmar och trappor. Objekten i lagret övrigt är publicerade som punktobjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-02-24T13:10:43.371660"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:27:46.657387"},"dct:title":[{"@language":"da","@value":"Andre objekter - punkter"},{"@language":"en","@value":"Other objects - points"},{"@language":"sv","@value":"Övriga objekt - punkter"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b4n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/88140069-9975-485e-8695-faf1eb52822c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/88140069-9975-485e-8695-faf1eb52822c/download/vatten_pt.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"84763"},"dct:description":[{"@language":"da","@value":"Vand fra hovedkortet består af objekter, der udgør en geografisk beskrivelse\naf objekter såsom vandoverflader eller objekter i vand. Objekterne i vand er\noffentliggjort som punktobjekter. Bemærk venligst: Hovedkortet og dets lag er\nikke komplette i alle dele af byen. Arbejdet med at forbedre kvaliteten er i\ngang. For mere information, kontakt Byplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Water from the primary map consists of objects that constitute a geographical\ndescription of objects such as water surfaces or objects in water. The objects\nin water are published as point objects. Please note: The primary map and its\nlayers are not complete in all parts of the city. Work to improve the quality\nis ongoing, for more information contact the City Planning Office or via the\nform.\n\n"},{"@language":"sv","@value":"Vatten från primärkartan består av objekt som utgör geografisk beskrivning av objekt som vattenytor eller objekt i vatten . Objekten i vatten är publicerade som punktobjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-02-24T13:07:38.113979"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:27:23.698541"},"dct:title":[{"@language":"da","@value":"Vandpunkter"},{"@language":"en","@value":"Water - points"},{"@language":"sv","@value":"Vatten - punkter"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7044f89bff9464f8274d7836e373d4c8210b3a0b14171abe63d9b583326c21b8_b5n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/968bc7e7-0f29-4a1e-a3ce-ccd1bd5c8c24","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/d463475a-5dd9-4130-a97a-dc3e19f1da71/resource/968bc7e7-0f29-4a1e-a3ce-ccd1bd5c8c24/download/vatten.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"181037"},"dct:description":[{"@language":"da","@value":"Vand fra hovedkortet består af objekter, der udgør en geografisk beskrivelse\naf objekter såsom vandoverflader eller objekter i vand. Objekterne i vand er\noffentliggjort som linjeobjekter. Bemærk venligst: Hovedkortet og dets lag er\nikke komplette i alle dele af byen. Arbejdet med at forbedre kvaliteten er i\ngang. For mere information, kontakt Byplankontoret eller via formularen.\n\n"},{"@language":"en","@value":"Water from the primary map consists of objects that constitute a geographical\ndescription of objects such as water surfaces or objects in water. The objects\nin water are published as line objects. Please note: The primary map and its\nlayers are not complete in all parts of the city. Work to improve the quality\nis ongoing, for more information contact the City Planning Office or via the\nform.\n\n"},{"@language":"sv","@value":"Vatten från primärkartan består av objekt som utgör geografisk beskrivning av objekt som vattenytor eller objekt i vatten . Objekten i vatten är publicerade som linjeoebjekt. Observera: Primärkartan och dess lager är inte kompletta i alla delar av staden. Arbete med att höja kvalitén pågår ständigt, för mer information kontakta Stadsbyggnadskontoret eller via formuläret."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2023-02-24T13:01:47.140198"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":