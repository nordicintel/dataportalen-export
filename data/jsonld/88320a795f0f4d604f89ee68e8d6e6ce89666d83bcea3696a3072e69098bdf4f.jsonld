bility/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679_b2n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:7f8c7db9c072224a51f4b972ca0a8c5e4d5a65a45e62089c8527a9e9c1144679"},{"@graph":[{"@id":"_:800ea4ffd86e4e1c62f1309f80d0ac5af5bd72f598dd0e43bcea633c24b933dc_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"649cd2e10bb4bb9489148315438296ef"},{"@id":"_:800ea4ffd86e4e1c62f1309f80d0ac5af5bd72f598dd0e43bcea633c24b933dc_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b/resource/0771338d-ad60-4a45-b77b-693acf0507ee"},{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b/resource/3d2a12bb-27af-4e5c-9c92-fb14e416d648"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af personer i en husstand med lav økonomisk standard. Lav\nøkonomisk standard er et relativt mål for fattigdom. En husstand har en lav\nøkonomisk standard, hvis deres økonomiske standard er lavere end 60 % af\nmedianen for Sverige som helhed. En husstands økonomiske standard måles som\ndisponibel indkomst pr. forbrugsenhed. Det betyder, at husstandens samlede\nindkomst efter skat divideres med antallet af forbrugsenheder i husstanden.\nAntallet af forbrugsenheder i en husstand afhænger af, hvor mange personer der\nbor i husstanden, deres forhold og alder. For eksempel har en husstand med én\nperson én forbrugsenhed, mens et par, der bor sammen, har 1,51\nforbrugsenheder. Systemet med forbrugsenheder bruges til at gøre\nsammenligninger af husstandsindkomst mere retfærdige: et par, der bor sammen,\nbehøver ikke dobbelt så høj en indkomst som to enlige for at have den samme\nstandard: man behøver muligvis kun at have én bolig, et tv, et badekar osv. og\nkan have lavere madomkostninger ved at lave mad sammen. De anvendte vægte er\nbaseret på budgetberegninger foretaget af Statistiska Centralbyrån.\nPopulationen er begrænset til såkaldte helårshusholdninger, hvilket refererer\ntil husstande, hvor de voksne i husstanden var registreret i Sverige både i\nbegyndelsen og slutningen af ​​året. Dette skyldes, at Statistiska\nCentralbyrån mangler indkomststatistik fra perioder, hvor personer boede i\nudlandet - for en person, der immigrerer til Sverige i december, vil kun løn\nog indkomst fra december blive inkluderet. Da det ville være misvisende at\nsammenligne denne person med en person, hvis samlede indkomst var i går, er\nkun helårshusholdninger inkluderet. Se \"Disponibel indkomst 2020-\" for en\nfuldstændig definition af disponibel indkomst.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of people in a household with a low economic standard. Low\neconomic standard is a relative measure of poverty. A household has a low\neconomic standard if their economic standard is lower than 60% of the median\nfor Sweden as a whole. A household's economic standard is measured as\ndisposable income per consumption unit. This means that the household's total\nincome after tax is divided by the number of consumption units in the\nhousehold. The number of consumption units in a household depends on how many\npeople live in the household, their relationship and age. For example, a\nhousehold with one person has one consumption unit, while a couple living\ntogether has 1.51 consumption units. The system of consumption units is used\nto make comparisons of household income fairer: a couple living together does\nnot need twice as high an income as two single people to have the same\nstandard: you may only need to have one home, a TV, a bathtub and so on and\ncan have lower food costs by cooking together. The weights used are based on\nbudget calculations made by Statistics Sweden. The population is limited to\nso-called full-year households, which refers to households where the adults in\nthe household were registered in Sweden at both the beginning and end of the\nyear. This is because Statistics Sweden lacks income statistics from periods\nwhen people lived abroad - for a person who immigrates to Sweden in December,\nonly salary and income from December will be included. Since it would be\nmisleading to compare this person with a person whose entire income was\nyesterday, only full-year households are included. See \"Disposable income\n2020-\" for a complete definition of disposable income.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet personer som ingår i ett hushåll med låg ekonomisk standard. Låg ekonomisk standard är ett relativt fattigdomsmått. Ett hushåll har låg ekonomisk standard om deras ekonomisk standard är lägre än 60% av medianen för Sverige som helhet. Ett hushålls ekonomiska standard mäts som disponibel inkomst per konsumtionsenhet. Det betyder att hushållets samtliga inkomster efter skatt delas på antalet konsumtionsenheter i hushållet. Antalet konsumtionsenheter som finns i ett hushåll beror på hur många som bor i hushållet, deras relation och ålder. Ett hushåll med en person har till exempel en konsumtionsenhet, medan ett sammanboende par har 1,51 konsumtionsenheter. Systemet med konsumtionsenheter används för att göra jämförelser av hushållens inkomster mer rättvisa: ett sammanboende par behöver inte dubbelt så hög inkomst som två ensamboende för att ha samma standard: man behöver kanske bara ha en bostad, en TV, ett badkar och så vidare och kan ha lägre matkostnader genom att laga mat ihop. De vikter som används baseras på budgetberäkningar som görs av SCB.\nPopulationen är avgränsad till så kallade helårshushåll, vilket avser hushåll där de vuxna i hushållet varit folkbokförda i Sverige vid såväl årets början som dess slut. Detta för att SCB saknar inkomststatistik från perioder när man bott utomlands – för en person som invandrar till Sverige i december kommer bara lön och inkomster från december räknas in. Eftersom det skulle vara missvisande att jämföra denna person med en person vars alla inkomster igår räknas bara helårshushållen med.\nSe ”Disponibel inkomst 2020-” för en fullständig definition av disponibel inkomst.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"9ccee09a-a932-4365-bd10-ec9fc3ed763b","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:07:43.846328"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:800ea4ffd86e4e1c62f1309f80d0ac5af5bd72f598dd0e43bcea633c24b933dc_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Lav økonomisk standard - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Low economic standard - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Låg ekonomisk standard - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b/resource/0771338d-ad60-4a45-b77b-693acf0507ee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b/resource/0771338d-ad60-4a45-b77b-693acf0507ee/download/lag-ekonomisk-standard.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1333950"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Lav økonomisk standard\n\n"},{"@language":"en","@value":"Malmö statistics - Low economic standard\n\n"},{"@language":"sv","@value":"Malmö statistik - Låg ekonomisk standard"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-25T23:07:31.256965"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:07:43.852689"},"dct:title":[{"@language":"da","@value":"Lav økonomisk standard"},{"@language":"en","@value":"Low economic standard"},{"@language":"sv","@value":"Låg ekonomisk standard"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:800ea4ffd86e4e1c62f1309f80d0ac5af5bd72f598dd0e43bcea633c24b933dc_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/9ccee09a-a932-4365-bd10-ec9fc3ed763b/resource/3d2a12bb-27af-4e5c-9c92-fb14e416d648","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=0771338d-ad60-4a45-b77b-693acf0507ee"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Lav økonomisk standard\n\n"},{"@language":"en","@value":"Malmö statistics - Low economic standard\n\n"},{"@language":"sv","@value":"Malmö statistik - Låg ekonomisk standard"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-25T23:07:36.042489"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-25T23:07:44.867467"},"dct:title":[{"@language":"da","@value":"Lav økonomisk standard"},{"@language":"en","@value":"Low economic standard"},{"@language":"sv","@value":"Låg ekonomisk standard"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:800ea4ffd86e4e1c62f1309f80d0ac5af5bd72f598dd0e43bcea633c24b933dc"},{"@graph":[{"@id":"_:80815ca61bd68ca65ddfa7ece584af1957465e821350659dcdbc6d541f2d20d6_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/5db292e1-5de2-467c-b692-7dfec887d1bb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/5db292e1-5de2-467c-b692-7dfec887d1bb/resource/6fc3aa80-218c-45f4-a852-65b70d16d657"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Procentdel af unge registreret i kommunen, der fik en endelig karakter eller\ntilsvarende i år T-2, som påbegyndte studier eller som var etableret på\narbejdsmarkedet i år T.\n\n**Etableret på arbejdsmarkedet, er det**  \n_hvem er ansat i henhold til definitionen i beskæftigelsesregistret (november)  \n_ ikke har nogen begivenheder, der indikerer arbejdsløshed, eller har\narbejdsmarkedspolitiske foranstaltninger, der ikke betragtes som beskæftigelse  \n* og har haft en indkomst, der ikke er under en grænse, der er forskellig for hvert år afhængigt af den gennemsnitlige procentvise lønvækst.\n\nStatistik i procenter fra 2006.\n\nI 2016 var grænsen for at blive betragtet som etableret på arbejdsmarkedet\n191.800 SEK.\n\nStuderende refererer til både universitetsstudier og anden uddannelse, der er\nberettiget til studiestøtte, såsom Komvux eller højskoler.\n\nStatistikken er baseret på bopælskommunen. Det vil sige den kommune, hvor en\nperson er registreret.\n\nKilde: Statistiska centralbanken og Skolstyrelsen.\n\n"},{"@language":"en","@value":"Percentage of young people registered in the municipality who received a final\ngrade or equivalent in year T-2 who started studies or who were established in\nthe labor market in year T.\n\n**Established in the labor market, it is**  \n_who is employed according to the definition of the employment register\n(November)  \n_ does not have any events that indicate unemployment or has labor market\npolicy measures that are not considered employment  \n* and have had an income that is not below a limit that is different for each year depending on the average percentage wage growth.\n\nStatistics in percentages from 2006.\n\nIn 2016, the limit for being considered established in the labor market was\nSEK 191,800.\n\nStudents refer to both university studies and other education eligible for\nstudy grants, such as Komvux or folk high schools.\n\nThe statistics are based on the municipality of residence. That is, the\nmunicipality in which a person is registered.\n\nSource: Statistics Sweden and the Swedish National Agency for Education.\n\n"},{"@language":"sv","@value":"Andel av ungdomar folkbokförda i kommunen som erhållit slutbetyg eller motsvarande år T-2 som påbörjat studier eller som var etablerade på arbetsmarknaden år T. \n\n__Etablerad på arbetsmarknaden är den__  \n* som är sysselsatt enligt sysselsättningsregistrets definition (november månad)  \n* inte har några händelser som indikerar arbetslöshet  eller har arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning  \n* samt har haft en arbetsinkomst som inte understiger en gräns som är olika för varje år beroende på den genomsnittliga procentuella löneutvecklingen.   \n\nStatistik i procent från 2006.\n\nÅr 2016 var gränsen för att räknas som etablerad på arbetsmarknaden 191 800 kr. \n\nStuderande avser både högskolestudier och annan studiemedelsberättigad utbildning som exempelvis Komvux eller folkhögskola. \n\nStatistiken är baserat på hemkommun. Det vill säga den kommun en person är folkbokförd i.\n\nKälla: SCB och Skolverket."}],"dct:identifier":"5db292e1-5de2-467c-b692-7dfec887d1bb","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:34:04.062044"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:80815ca61bd68ca65ddfa7ece584af1957465e821350659dcdbc6d541f2d20d6_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Unge, der er etableret på arbejdsmarkedet eller studerer 2 år efter endt ungdomsuddannelse"},{"@language":"en","@value":"Young people who are established in the labor market or studying 2 years after completing upper secondary education"},{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden eller studerar 2 år efter fullföljd gymnasieutbildning"}]},{"@id":"https://opendata-api.malmo.se/dataset/5db292e1-5de2-467c-b692-7dfec887d1bb/resource/6fc3aa80-218c-45f4-a852-65b70d16d657","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17434"},"dct:description":[{"@language":"da","@value":"Andel af unge registreret i kommunen, der fik en endelig karakter eller\ntilsvarende i år T-2, som startede studier eller som blev etableret på\narbejdsmarkedet i år T. Etableret på arbejdsmarkedet er en person, der er\nansat i henhold til beskæftigelsesregisterets definition (november), ikke har\nbegivenheder, der indikerer arbejdsløshed eller arbejdsmarkedspolitiske\nforanstaltninger, der ikke betragtes som beskæftigelse, og har haft en\nindkomst, der ikke er under en grænse, der er forskellig for hvert år\nafhængigt af den gennemsnitlige procentvise lønvækst. I 2016 var grænsen for\nat blive betragtet som etableret på arbejdsmarkedet 191.800 SEK. Studerende\nrefererer til både universitetsstudier og anden uddannelse, der er berettiget\ntil studiestøtte, såsom kommunal voksenuddannelse eller højskole. Kilde:\nKolada\n\n"},{"@language":"en","@value":"Proportion of young people registered in the municipality who received a final\ngrade or equivalent in year T-2 who started studies or who were established in\nthe labor market in year T. Established in the labor market is someone who is\nemployed according to the employment register's definition (November), has no\nevents that indicate unemployment or labor market policy measures that are not\nconsidered employment, and has had an income that is not below a limit that is\ndifferent for each year depending on the average percentage wage growth. In\n2016, the limit for being considered established in the labor market was SEK\n191,800. Students refer to both university studies and other education\neligible for study grants, such as municipal adult education or folk high\nschool. Source: Kolada\n\n"},{"@language":"sv","@value":"Andel av ungdomarna folkbokförda i kommunen som erhållit slutbetyg eller motsvarande år T-2 som påbörjat studier eller som var etablerade på arbetsmarknaden år T. Etablerad på arbetsmarknaden är den som är sysselsatt enligt sysselsättningsregistrets definition (november månad), inte har några händelser som indikerar arbetslöshet eller arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning samt har haft en arbetsinkomst som inte understiger en gräns som är olika för varje år beroende på den genomsnittliga procentuella löneutvecklingen. År 2016 var gränsen för att räknas som etablerad på arbetsmarknaden 191 800 kr. Studerande avser både högskolestudier och annan studiemedelsberättigad utbildning som t.ex. komvux eller folkhögskola. Källa: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-16T08:03:07.938117"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:34:04.070036"},"dct:title":[{"@language":"da","@value":"Unge, der er etableret på arbejdsmarkedet eller studerer 2 år efter endt gymnasial uddannelse, bopælskommune, procentdel (%) (N17434)"},{"@language":"en","@value":"Young people who are established in the labor market or studying 2 years after completing upper secondary education, municipality of residence, percentage (%) (N17434)"},{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden eller studerar 2 år efter fullföljd gymnasieutbildning, hemkommun, andel (%) (N17434)"}]}],"@id":"urn:source:80815ca61bd68ca65ddfa7ece584af1957465e821350659dcdbc6d541f2d20d6"},{"@graph":[{"@id":"_:8254948b0145152ed93f3d24ffea326b0037cd1c82dbce48fd47d14437860910_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"094af1c7a1f7cb0d22137f0f2e4b5d38"},{"@id":"_:8254948b0145152ed93f3d24ffea326b0037cd1c82dbce48fd47d14437860910_b1n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"bef3336a7d2a9bfc1cbe6f5f62f30d4c"},{"@id":"_:8254948b0145152ed93f3d24ffea326b0037cd1c82dbce48fd47d14437860910_b2n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"ec