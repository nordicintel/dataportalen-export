.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/e1faeafa-b1cd-4e7f-bb93-24d7fa56b511/download/03_1994-07-26-rcp85-2050.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:53:26.031527"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:02:56.184506"},"dct:title":[{"@language":"da","@value":"03_1994-07-26 RCP8.5 2050"},{"@language":"en","@value":"03_1994-07-26 RCP8.5 2050"},{"@language":"sv","@value":"03_1994-07-26 RCP8,5 2050"}]},{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/ec09e7f1-dba2-472b-90e7-66d357836aff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/91c7c302-910b-4603-8a1a-22704f7f054f/resource/ec09e7f1-dba2-472b-90e7-66d357836aff/download/07_2022-06-24-rcp85-2050.zip"},"dct:description":[{"@language":"da","@value":"\n\n"},{"@language":"en","@value":"\n\n"},{"@language":"sv","@value":""}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-28T13:54:06.222150"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-08-28T14:08:36.517188"},"dct:title":[{"@language":"da","@value":"07_2022-06-24 RCP8.5 2050"},{"@language":"en","@value":"07_2022-06-24 RCP8.5 2050"},{"@language":"sv","@value":"07_2022-06-24 RCP8,5 2050"}]}],"@id":"urn:source:2de43110f7a34fc04b4b336a91770fcecc687bbabfa63edfc0bbf8a4a5869f06"},{"@graph":[{"@id":"_:2e2b59361306db84e580c63e3393461a01ce9f86fa216abc33ec89f1df24997e_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"9c33e5a3f775be8fc853964065c8eb70"},{"@id":"_:2e2b59361306db84e580c63e3393461a01ce9f86fa216abc33ec89f1df24997e_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb/resource/07b2157b-7aef-47e5-a5b7-7260bb5a7c8b"},{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb/resource/07ccb72d-dc53-41e9-8549-afb3762ae723"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Vises enten som et gennemsnit eller median af den årlige indkomst for beboere\ni området. Består af indkomst fra beskæftigelse og indkomst fra\nerhvervsaktiviteter. Tallene viser bruttoindkomst. Ud over lønindkomst\nomfatter indkomst fra beskæftigelse også indkomst fra pensioner, sygedagpenge\nog anden skattepligtig kompensation. Fra referenceåret 2022 vises indkomsten\nsom et gennemsnit blandt beskæftigede i henhold til BAS (\"Population Labour\nMarket Status\") i stedet for blandt erhvervsaktive i henhold til RAMS\n(\"Register-based Labor Market Statistics\"). Dette skyldes, at\nStatistikcentralen ikke længere opdaterer RAMS. Det betyder, at\nsammenligninger tilbage i tiden skal foretages med forsigtighed. Tallene vises\ni løbende priser, hvilket betyder, at de ikke er inflationsjusterede. Vist for\ngruppen af ​​beskæftigede 20-65 år. Variablen er opdelt efter køn. Data fra\nIndkomst- og Skatteregisteret (IoT).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows either as an average or median of the annual income for residents in the\narea. Consists of income from employment and income from business activities.\nThe figures show gross income. In addition to salary income, income from\nemployment also includes income from pensions, sickness benefits and other\ntaxable compensation. From the reference year 2022, income is shown as an\naverage among employed people according to BAS (\"Population Labour Market\nStatus\") instead of gainfully employed people according to RAMS (\"Register-\nbased Labour Market Statistics\"). This is because Statistics Sweden no longer\nupdates RAMS. This means that comparisons back in time should be made with\ncaution. The figures are shown in current prices, which means that they are\nnot inflation-adjusted. Shown for the group of employed people 20–65. The\nvariable is broken down by gender. Data from the Income and Tax Register\n(IoT).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antingen som ett genomsnitt eller median av årsinkomsten för boende i området. Består av inkomst av tjänst och inkomst av näringsverksamhet. Siffrorna visar bruttoinkomst. I inkomst av tjänst ingår förutom löneinkomst även inkomst från pension, sjukpenning och andra skattepliktiga ersättningar. Från och med referensåret 2022 visas inkomsten som ett snitt bland sysselsatta enligt BAS (\"Befolkningens arbetsmarknadsstatus\") istället för förvärvsarbetande enligt RAMS (\"Registerbaserad arbetsmarknadsstatistik\"). Detta eftersom SCB inte längre uppdaterar RAMS. Detta gör att jämförelser bakåt i tiden ska göras med försiktighet. Siffrorna visas i löpande priser vilket betyder att de inte är inflationsjusterade. Visas för gruppen sysselsatta 20–65. Variabeln finns uppdelad på kön. Data från Inkomst- och taxeringsregistret (IoT).\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"9ad34795-f16c-4f00-a7f1-ff964dab64cb","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:06:08.280616"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:2e2b59361306db84e580c63e3393461a01ce9f86fa216abc33ec89f1df24997e_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Arbejdsindkomst blandt beskæftigede 2022 - - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Earned income among employed people 2022 - - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Förvärvsinkomst bland sysselsatta 2022 - - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb/resource/07b2157b-7aef-47e5-a5b7-7260bb5a7c8b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb/resource/07b2157b-7aef-47e5-a5b7-7260bb5a7c8b/download/forvarvsinkomst-bland-sysselsatta-2022-.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"169731"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Arbejdsindkomst blandt beskæftigede 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Earned income among employed people 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Förvärvsinkomst bland sysselsatta 2022 -"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:37.767101"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:06:08.286801"},"dct:title":[{"@language":"da","@value":"Arbejdsindkomst blandt beskæftigede 2022 -"},{"@language":"en","@value":"Earned income among employed people 2022 -"},{"@language":"sv","@value":"Förvärvsinkomst bland sysselsatta 2022 -"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:2e2b59361306db84e580c63e3393461a01ce9f86fa216abc33ec89f1df24997e_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/9ad34795-f16c-4f00-a7f1-ff964dab64cb/resource/07ccb72d-dc53-41e9-8549-afb3762ae723","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/action/datastore_search?resource_id=07b2157b-7aef-47e5-a5b7-7260bb5a7c8b"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Arbejdsindkomst blandt beskæftigede 2022 -\n\n"},{"@language":"en","@value":"Malmö statistics - Earned income among employed people 2022 -\n\n"},{"@language":"sv","@value":"Malmö statistik - Förvärvsinkomst bland sysselsatta 2022 -"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2024-08-22T07:56:38.920977"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:19:29.871875"},"dct:title":[{"@language":"da","@value":"Arbejdsindkomst blandt beskæftigede 2022 -"},{"@language":"en","@value":"Earned income among employed people 2022 -"},{"@language":"sv","@value":"Förvärvsinkomst bland sysselsatta 2022 -"}]}],"@id":"urn:source:2e2b59361306db84e580c63e3393461a01ce9f86fa216abc33ec89f1df24997e"},{"@graph":[{"@id":"_:32750e2739c5adb6a8a2f5ef404e52d8aa2dc9dca7d0cd15e47fc2544cd0f8a8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/10e61518-3112-440c-9c1e-0ada2c5e2782","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/10e61518-3112-440c-9c1e-0ada2c5e2782/resource/96ddf207-492b-4f6f-9141-108ea1ad4bb1"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem.\n\nStatistik i procenter fra 2013.\n\nBegrebet \"lokationskommune\" henviser til elever i både kommunale og friskoler\nbeliggende i kommunen, uanset hvor de er indskrevet.\n\nHvis det samlede antal elever er 40 eller flere, og antallet af EJ med den\nlaveste karakter E er 1-4 elever, vises procentdelen som 95 procent.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system.\n\nStatistics in percentages from 2013.\n\nThe term \"location municipality\" refers to students in both municipal and\nindependent schools located in the municipality, regardless of where they are\nregistered.\n\nIf the total number of students is 40 or more and the number of EJ with the\nlowest grade E is 1-4 students, the percentage is shown as 95 percent.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. \n\nStatistik i procent från 2013.\n\nMed lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. \n\nOm det totala antalet elever är 40 eller fler och antalet EJ med lägst betyget E är 1-4 elever, så visas andelen som 95 procent. \n\nKälla: Skolverket (Siris)."}],"dct:identifier":"10e61518-3112-440c-9c1e-0ada2c5e2782","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:16:46.314554"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:32750e2739c5adb6a8a2f5ef404e52d8aa2dc9dca7d0cd15e47fc2544cd0f8a8_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 6. klasse med den laveste karakter E i matematik, placeringskommune"},{"@language":"en","@value":"Students in grade 6 with the lowest grade E in mathematics, location municipality"},{"@language":"sv","@value":"Elever i årskurs 6 med lägsta betyget E i matematik, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/10e61518-3112-440c-9c1e-0ada2c5e2782/resource/96ddf207-492b-4f6f-9141-108ea1ad4bb1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15483"},"dct:description":[{"@language":"da","@value":"Alle data refererer til elever i skoler med karakterer i henhold til det mål-\nog vidensrelaterede karaktersystem. Elever i 6. klasse med minimumskarakteren\nE i matematik, placeringskommune, procentdel (%). Placeringskommune refererer\ntil elever i både kommunale og friskoler beliggende i kommunen, uanset hvor de\ner indskrevet. Hvis det samlede antal elever er 40 eller mere, og antallet af\nEJ med minimumskarakteren E er 1-4 elever, vises procentdelen som 95 procent.\nKilde: Kolada\n\n"},{"@language":"en","@value":"All data refers to students in schools with grades according to the goal- and\nknowledge-related grading system. Students in year 6 with a minimum grade of E\nin mathematics, location municipality, percentage (%). Location municipality\nrefers to students in both municipal and independent schools located in the\nmunicipality regardless of where they are registered. If the total number of\nstudents is 40 or more and the number of EJ with a minimum grade of E is 1-4\nstudents, the percentage is shown as 95 percent. Source: Kolada\n\n"},{"@language":"sv","@value":"Samtliga uppgifter avser elever i skolor med betyg enligt det mål- och kunskapsrelaterade betygssystemet. Elever i åk 6 med lägst betyget E  i matematik, lägeskommun, andel (%). Med lägeskommun avses elever i både kommunala och fristående skolor belägna i kommunen oavsett var de är folkbokförda. Om det totala antalet elever är 40 eller fler och antalet EJ med lägst betyget E är 1-4 elever, så visas andelen som 95 procent. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-15T07:31:48.039236"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:16:46.320104"},"dct:title":[{"@language":"da","@value":"Elever i 6. klasse med minimum karakteren E i matematik, kommune, procentdel (%) (N15483)"},{"@language":"en","@value":"Students in year 6 with a minimum grade of E in mathematics, municipality of location, percentage (%) (N15483)"},{"@language":"sv","@value":"Elever i åk 6 med lägst betyget E i matematik, lägeskommun, andel (%) (N15483)"}]}],"@id":"urn:source:32750e2739c5adb6a8a2f5ef404e52d8aa2dc9dca7d0cd15e47fc2544cd0f8a8"},{"@graph":[{"@id":"_:3486dc63f6674b7c8808c89ff799c5ad897fbb19d9552f3d2c7b7d13c51bff78_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"a69525b45ba26f0ba15d8c62457310c2"},{"@id":"_:3486dc63f6674b7c8808c89ff799c5ad897fbb19d9552f3d2c7b7d13c51bff78_b10n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"a0297618d64108e2155fbc85de3b2e0f"},{"@id":"_:3486dc63f6674b7c8808c89ff799c5ad897fbb19d9552f3d2c7b7d13c51bff78_b11n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"}