a-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/c0084ea4-ece6-4ddd-b0b3-c37916be4849"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/cda0a929-0f62-40bb-b952-d383ff14b382"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/e3f4da52-02b6-4176-9fce-96bf1a1eb15a"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/e721aa47-fde5-490a-b9a0-6eb733970d0e"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/e735cf68-2c20-462c-8f4a-15dd0dccc8e9"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/f63b60b6-52a7-496e-be1c-c609d54df0ff"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/f7985b90-f00e-4f60-9115-8d606c5eb7d2"},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/fc3012af-4f92-494e-993a-039db9c2e717"}],"dcat:keyword":["Malmö stad","delområden","områden","stadsdelar","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":[{"@language":"da","@value":"Områdefakta indsamler statistik for de forskellige geografiske områder af\nMalmø by om blandt andet beskæftigelse, boligforhold, indkomst og\nalderssammensætning. For årene 1988-1994 er alle geografiske opdelinger samlet\ni én publikation. For årene 1995-2008 er der i stedet to publikationer: en for\ndelområder og en for bydele. Bemærk, at nogle områdegrænser justeres over tid\n- grænserne vises på kort i publikationerne.\n\n"},{"@language":"en","@value":"Area facts collects statistics for the different geographical areas of Malmö\ncity on, among other things, employment, housing, income and age composition.\nFor the years 1988-1994, all geographical divisions are collected in one\npublication. For the years 1995-2008, there are instead two publications: one\nfor sub-areas and one for city districts. Note that some area boundaries are\nadjusted over time - the boundaries are shown on maps in the publications.\n\n"},{"@language":"sv","@value":"Områdesfakta samlar statistik för Malmö stads olika geografiska områden om bland annat sysselsättning, boende, inkomster och ålderssammansättning. För åren 1988-1994 finns alla geografiska indelningar samlade i en publikation. För åren 1995-2008 finns istället två publikationer: en för delområden och en för stadsdelar. Notera att vissa områdesgränser justeras över tid - gränserna visas på kartor i publikationerna."}],"dct:identifier":"37f74aa9-1596-45e3-87e8-206b925ca03f","dct:issued":{"@type":"xsd:date","@value":"2022-12-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-25T16:19:44.282903"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:6398f64d18176d89cf0ef63b3a7dbd2049bb8ccf8fe8dfbf8bbeefba476c4337_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:temporal":{"@id":"_:6398f64d18176d89cf0ef63b3a7dbd2049bb8ccf8fe8dfbf8bbeefba476c4337_b1n0"},"dct:title":[{"@language":"da","@value":"Områdefakta 1988 - 2008"},{"@language":"en","@value":"Area facts 1988 - 2008"},{"@language":"sv","@value":"Områdesfakta 1988 - 2008"}]},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/0c070d60-35d9-461c-9b2f-1efab56d7c57","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mmostatfiler.malmo.se/stadsdelar/stadsdelar_1998.pdf"},"dct:description":[{"@language":"da","@value":"* * *\n\n"},{"@language":"en","@value":"* * *\n\n"},{"@language":"sv","@value":"---"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-20T10:47:19.128819"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:33:05.071495"},"dct:title":[{"@language":"da","@value":"Områdefakta Distrikter 1998"},{"@language":"en","@value":"Area facts Districts 1998"},{"@language":"sv","@value":"Områdesfakta Stadsdelar 1998"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9-1596-45e3-87e8-206b925ca03f/resource/10e99ff0-ac6f-4562-a8db-6286aeee66de","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://mmostatfiler.malmo.se/delomraden/delomraden_1997.pdf"},"dct:description":[{"@language":"da","@value":"* * *\n\n"},{"@language":"en","@value":"* * *\n\n"},{"@language":"sv","@value":"---"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:issued":{"@type":"xsd:dateTime","@value":"2022-12-20T10:44:50.265676"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:33:05.069070"},"dct:title":[{"@language":"da","@value":"Områdefakta Delområder 1997"},{"@language":"en","@value":"Area facts Sub-areas 1997"},{"@language":"sv","@value":"Områdesfakta Delområden 1997"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/37f74aa9