2-8e54-eddb0401efc1/resource/eb88d542-abec-46ed-a288-03ca7872a64c"}],"dcat:keyword":["Malmö stad","bevattning","markfukt","sensor"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dcat:version":"1","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"da","@value":"Dette datasæt indeholder jordfugtighedsmålinger fra sensorer i 20 cm og 60 cm\ndybde i forbindelse med træer, der vokser på ejendomme ejet af Malmø Kommune.\n\nDette datasæt indeholder:\n\n  * Sensorplacering og tilhørende oplysninger.\n  * Måleværdier fra sensorerne opdelt efter måned. Jordfugtigheden måles i 20 cm og 60 cm dybde ved hver sensor. Der kan være huller i måleserien.\n\n**Information om ressource Jordfugtighedssensorer**\n\nRessourcen oprettes i overensstemmelse med\n[GeoJSON](https://datatracker.ietf.org/doc/html/rfc7946) . Basisniveauet er en\nFeatureCollection, og hver sensor rapporteres som en Feature.\n\nAttributter i ressourcen:\n\n  * `geometry` [Sensorplacering i henhold til GeoJSON, geometritype POINT]\n  * `id` [Sensor-ID]\n  * `type` [Altid funktion, i overensstemmelse med GeoJSON]\n  * `properties` [Se nedenfor]\n\nAttributter i `properties` :\n\n  * `platsbenamning` [Sensorens interne navn]\n\n**Information om ressourcen Måleværdier for jordfugtighed**\n\nRessourcens formatering er inspireret af\n[GreenspaceRecord](https://github.com/smart%2ddata%2dmodels/dataModel.ParksAndGardens/blob/master/GreenspaceRecord/doc/spec.md)\n. Ressourcen har forsøgt at følge GreenspaceRecord-formatet, men har måttet\ntilpasses virksomhedens behov.\n\nAttributter i ressourcen:\n\n  * `id` [ID for målehændelsen]\n  * `dateObserved` [Dato hvor målingen blev udført i henhold til ISO 8601 Dato og klokkeslæt i UTC)]\n  * `refFeature` [sensor-id, reference til id i ressource Sensorer jordfugtighed]\n  * `soilMoistureTension` [Måleværdi i kPa]\n  * `description` [Angiver om målingen blev foretaget i 20 cm eller 60 cm dybde]\n  * `type` [altid GreenspaceRecord]\n\n"},{"@language":"en","@value":"This dataset contains soil moisture measurements from sensors at 20 cm and 60\ncm depths in connection with trees growing on properties owned by the City of\nMalmö.\n\nThis dataset contains:\n\n  * Sensor location and associated information.\n  * Measurement values ​​from the sensors divided by month. Soil moisture is measured at 20 cm and 60 cm depths at each sensor. There may be gaps in the measurement series.\n\n**Information about resource Soil moisture sensors**\n\nThe resource is created in accordance with\n[GeoJSON](https://datatracker.ietf.org/doc/html/rfc7946) . The base level is a\nFeatureCollection and each sensor is reported as a Feature.\n\nAttributes in the resource:\n\n  * `geometry` [Sensor location according to GeoJSON, geometry type POINT]\n  * `id` [Sensor ID]\n  * `type` [Always Feature, in accordance with GeoJSON]\n  * `properties` [See below]\n\nAttributes in `properties` :\n\n  * `platsbenamning` [Internal name of sensor]\n\n**Information about resource Soil moisture measurement values**\n\nThe resource's formatting is inspired by\n[GreenspaceRecord](https://github.com/smart%2ddata%2dmodels/dataModel.ParksAndGardens/blob/master/GreenspaceRecord/doc/spec.md)\n. The resource has attempted to follow the GreenspaceRecord format but has had\nto be adapted to the needs of the business.\n\nAttributes in the resource:\n\n  * `id` [ID of the measurement event]\n  * `dateObserved` [Date when measurement was performed according to ISO 8601 Date Time in UTC)]\n  * `refFeature` [sensor id, reference to id in resource Sensors soil moisture]\n  * `soilMoistureTension` [Measurement value in kPa]\n  * `description` [Indicates whether measurement was made at 20 cm or 60 cm depth]\n  * `type` [always GreenspaceRecord]\n\n"},{"@language":"sv","@value":"Denna datamängd innehåller mätningar av markfukt från sensorer på 20 cm respektive 60 cm djup i anslutning till träd som växer på Malmö stad-ägda fastigheter.  \n\nDenna datamängd innehåller:\n\n* Sensorernas placering och tillhörande information.\n* Mätvärden av från sensorerna uppdelat månadsvis. Mätning av markfukt sker på 20 cm och 60 cm djup vid varje sensor. Det kan förekomma glapp i mätserierna.\n\n**Information om resurs Sensorer markfukt**\n\nResursen är upprättad i enlighet med [GeoJSON](https://datatracker.ietf.org/doc/html/rfc7946). Grundnivån är en FeatureCollection och varje sensor redovisas som en Feature.\n\nAttribut i resursen:\n\n* `geometry` [Sensorns placering i enlighet med GeoJSON, geometrityp POINT]  \n* `id` [Sensorid]  \n* `type` [Alltid Feature, i enlighet med GeoJSON]  \n* `properties` [Se nedan]  \n\nAttribut i `properties`:\n\n* `platsbenamning` [Intern benämning på sensor]  \n\n**Information om resurs Mätvärden markfukt**\n\nResursens formatering är inspirerad av [GreenspaceRecord](https://github.com/smart-data-models/dataModel.ParksAndGardens/blob/master/GreenspaceRecord/doc/spec.md). Resursen har försökt följa GreenspaceRecord-formatet men har behövts anpassas till verksamhetens behov. \n\nAttribut i resursen:\n\n* `id` [ID för mättillfället]  \n* `dateObserved` [Datum då mätning utfördes enligt ISO 8601 Date Time i UTC)]  \n* `refFeature` [sensorid, referens till id i resurs Sensorer markfukt]  \n* `soilMoistureTension` [Mätvärde i kPa]  \n* `description` [Anger om mätning skett på 20 cm eller 60 cm djup]  \n* `type` [alltid GreenspaceRecord]  "}],"dct:identifier":"ffc92859-1c4f-41b2-8e54-eddb0401efc1","dct:issued":{"@type":"xsd:date","@value":"2025-05-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-02T19:38:36.171273"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:8cd5c8d0a84a24afdb1a832881990183f9f53e8c5fe288913d7f097e576573ed_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:temporal":{"@id":"_:8cd5c8d0a84a24afdb1a832881990183f9f53e8c5fe288913d7f097e576573ed_b1n0"},"dct:title":[{"@language":"da","@value":"Jordfugtighed"},{"@language":"en","@value":"Soil moisture"},{"@language":"sv","@value":"Markfukt"}]},{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/0b3db46d-8abb-4663-bbe9-22af90222a25","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/0b3db46d-8abb-4663-bbe9-22af90222a25/download/matvarden_markfukt_2026_02"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"9221393"},"dct:description":[{"@language":"da","@value":"Måleværdier fra sensorer over en måned\n\n"},{"@language":"en","@value":"Measurement values ​​from sensors over a month\n\n"},{"@language":"sv","@value":"Mätvärden från sensorer under en månad"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-25T07:31:00.761675"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-05-25T07:32:11.395715"},"dct:title":[{"@language":"da","@value":"Jordfugtighedsmålinger 2026-02"},{"@language":"en","@value":"Soil moisture measurements 2026-02"},{"@language":"sv","@value":"Mätvärden markfukt 2026-02"}]},{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/0f3b7a35-f7fc-4e0b-b82e-45e2dafa66ea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/ffc92859-1c4f-41b2-8e54-eddb0401efc1/resource/0f3b7a35-f7fc-4e0b-b82e-45e2dafa66ea/download/matvarden_markfukt_2024_09"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2052360"},"dct:description":[{"@language":"da","@value":"Måleværdier fra sensorer over en måned\n\n"},{"@language":"e