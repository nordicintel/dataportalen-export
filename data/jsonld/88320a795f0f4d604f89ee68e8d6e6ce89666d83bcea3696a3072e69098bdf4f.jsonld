ec1349a08d5/download/vatten_linjer_3008.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"200704"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"Koordinatsystem EPSG:3008 / SWEREF 99 13 30\n\n"},{"@language":"en","@value":"Coordinate system EPSG:3008 / SWEREF 99 13 30\n\n"},{"@language":"sv","@value":"Koordinatsystem EPSG:3008 / SWEREF 99 13 30"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-06-30T13:54:30.758675"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:35:10.990396"},"dct:title":[{"@language":"da","@value":"Vandlinjer GeoPakke 3008"},{"@language":"en","@value":"Waterlines GeoPackage 3008"},{"@language":"sv","@value":"Vattenlinjer GeoPackage 3008"}]}],"@id":"urn:source:039c14fde95aab737d9a6ca24db14fe445b18bc1b4cc33324ea3fa3442afa9d6"},{"@graph":[{"@id":"_:0964b1361e540311204c90373b7bb7c1a8aa24c8900c8855d004ea95ae2dd716_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/f6f7789f-8eac-4c03-b132-fadf6b5af241","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/f6f7789f-8eac-4c03-b132-fadf6b5af241/resource/d856412e-39ab-424b-a9fc-ef3abca5c323"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever, der startede på gymnasiet i kommunen for 3 år siden med en\nuddannelse inden for 3 år (inklusive Introduktionsprogrammet IM) divideret med\nantallet af elever, der startede på gymnasiet i kommunen for 3 år siden\n(inklusive IM).\n\nStatistik i procenter fra 2014.\n\nStuderende, der ikke har et svensk personnummer ved starten af ​​deres\nuddannelse (for eksempel nyankomne studerende, der endnu ikke er blevet\nregistreret), er ikke medregnet.\n\nStatistikken er baseret på placeringskommune, hvilket refererer til elever i\nkommunale og friskoler i kommunen uanset hvor de er indskrevet.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of students who started upper secondary school in the municipality 3\nyears ago with a degree within 3 years (including the Introductory Program IM)\ndivided by the number of students who started upper secondary school in the\nmunicipality 3 years ago (including IM).\n\nStatistics in percentages from 2014.\n\nStudents who do not have a Swedish personal identification number at the\nbeginning of their education (for example, newly arrived students who have not\nyet been registered) are not included.\n\nThe statistics are based on location municipality, which refers to students in\nmunicipal and independent schools in the municipality regardless of where they\nare registered.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal elever som började på gymnasium i  kommunen för 3 år sedan med examen inom 3 år (inklusive Introduktionsprogrammet IM) dividerat med antal elever som började på gymnasium i  kommunen för 3 år sedan (inklusive IM). \n\nStatistik i procent från 2014.\n\nElever som vid utbildningens början saknar svenskt personnummer (exempelvis nyanlända elever som ännu inte blivit folkbokförda) ingår ej. \n\nStatistiken är baserat på lägeskommun vilket avser elever i kommunala och fristående skolor i kommunen oberoende på vart de är folkbokförda.\n\nKälla: SCB."}],"dct:identifier":"f6f7789f-8eac-4c03-b132-fadf6b5af241","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:33:22.661559"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:0964b1361e540311204c90373b7bb7c1a8aa24c8900c8855d004ea95ae2dd716_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever, der dimitterer inden for 3 år, placeringskommune"},{"@language":"en","@value":"Upper secondary school students graduating within 3 years, location municipality"},{"@language":"sv","@value":"Gymnasieelever med examen inom 3 år, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/f6f7789f-8eac-4c03-b132-fadf6b5af241/resource/d856412e-39ab-424b-a9fc-ef3abca5c323","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17448"},"dct:description":[{"@language":"da","@value":"Antal elever, der startede på gymnasiet i kommunen for tre år siden og\ndimitterede inden for tre år, inkl. IM, divideret med antal elever, der\nstartede på gymnasiet i kommunen for tre år siden, inkl. IM. Elever, der ikke\nhar et svensk personnummer ved begyndelsen af ​​deres uddannelse (f.eks.\nnyankomne elever, der endnu ikke er blevet registreret), er ikke inkluderet.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of students who started upper secondary school in the municipality\nthree years ago and graduated within three years, incl. IM divided by number\nof students who started upper secondary school in the municipality three years\nago, incl. IM. Students who do not have a Swedish personal identity number at\nthe beginning of their education (e.g. newly arrived students who have not yet\nbeen registered) are not included. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever som började på gymnasium i  kommunen för tre år sedan med examen inom tre år, inkl. IM dividerat med antal elever som började på gymnasium i  kommunen för tre år sedan, inkl. IM. Elever som vid utbildningens början saknar svenskt personnummer (t ex nyanlända elever som ännu inte blivit folkbokförda) ingår ej. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-16T08:08:19.579259"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:33:22.684620"},"dct:title":[{"@language":"da","@value":"Gymnasieelever med en uddannelse inden for 3 år, kommune, andel (%) (N17448)"},{"@language":"en","@value":"Upper secondary school students with a degree within 3 years, municipality of location, proportion (%) (N17448)"},{"@language":"sv","@value":"Gymnasieelever med examen inom 3 år, lägeskommun, andel (%) (N17448)"}]}],"@id":"urn:source:0964b1361e540311204c90373b7bb7c1a8aa24c8900c8855d004ea95ae2dd716"},{"@graph":[{"@id":"_:0be52177f4b69001482feebbf66edefe9b93bbb113f973aaaccad796e185375e_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"93ca02298164834ad792eadcbcc42195"},{"@id":"_:0be52177f4b69001482feebbf66edefe9b93bbb113f973aaaccad796e185375e_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Fastighets- och gatukontoret","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:gis.fgk@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/abd7da407bcfbc956fd6c0e91189412f"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1168f4db-87de-4f8b-b33f-8f2f5e0d44c9"},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1638ddef-4826-4bf4-99b8-9020a8ad89d9"},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1a6bd68b-30ca-40a5-9d62-01e2a566982e"},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/66327bc9-9874-43dc-8445-493857f3f041"}],"dcat:keyword":["Malmö stad","geodata","gis","karta","map","parkeringstaxa","parking charges"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Malmø er opdelt i en række parkeringsområder, hvor forskellige takster gælder.\n\nFil-/kortlaget indeholder de forskellige satser, der er fastsat for\nvejstrækninger i henhold til lokale trafikregler.\n\nMere information kan findes her:  \nhttps://malmo.se/Bo%2doch%2dleva/Stadsmiljo%2doch%2dtrafik/Parkering/Parkeringsavgifter.html\n\n**Attribut**\n\n`gid` [id fra kildedata]  \n`taxa` [tekstuel beskrivelse af omkostninger og tider for hver\nbillettype/område]  \n`boendeomradekod` [områdenummer for parkeringsplads til beboere]  \n`antal_platser` [antal parkeringspladser, som kortlinjen inkluderer]  \n`typ_av_parkering` [f.eks. `\"Längsgående 6\"` , hvor tallet er\nparkeringsplanlæggernes måling af længden i meter, som en parkeringsplads\noptager på en strækning]  \n`timestamp` [dato for sidste opdatering fra lokale trafikregler]  \n`geometry` [type: LineString/MultiLineString, CRS: WGS84]\n\n"},{"@language":"en","@value":"Malmö is divided into a number of parking areas where different rates apply.\n\nThe file/map layer contains the different rates set for road sections\naccording to local traffic regulations.\n\nMore information can be found here:  \nhttps://malmo.se/Bo%2doch%2dleva/Stadsmiljo%2doch%2dtrafik/Parkering/Parkeringsavgifter.html\n\n**Attribute**\n\n`gid` [id from source data]  \n`taxa` [textual description of costs and times for each fare type/area]  \n`boendeomradekod` [residential parking area code]  \n`antal_platser` [number of parking spaces that the map line includes]  \n`typ_av_parkering` [e.g. `\"Längsgående 6\"` , where the number is the parking\nplanners' measurement of the length in meters a parking lot takes up on a\nstretch]  \n`timestamp` [date of last update from local traffic regulations]  \n`geometry` [type: LineString/MultiLineString, CRS: WGS84]\n\n"},{"@language":"sv","@value":"Malmö är uppdelat i ett antal parkeringsområden där olika taxor gäller.  \n\nFilen/kartlagret innehåller de olika taxor som är satta för vägsträckor enligt de lokala trafikföreskrifterna. \n\nMer information finner du här:  \nhttps://malmo.se/Bo-och-leva/Stadsmiljo-och-trafik/Parkering/Parkeringsavgifter.html  \n\n__Attribut__  \n  \n`gid` [id från källdatan]  \n`taxa` [textuell beskrivning av kostnader och tider för respektive taxatyp/område]  \n`boendeomradekod` [områdeskod för boendeparkering]  \n`antal_platser` [antal parkeringsplatser som kartlinjen innefattar]  \n`typ_av_parkering` [t ex `\"Längsgående 6\"`, där siffran är parkeringplanerarnas mått för den längd i meter en parkering tar i anspråk på en sträcka]  \n`timestamp` [datum för senaste uppdatering från de lokala trafikföreskrifterna]  \n`geometry` [typ: LineString/MultiLineString, CRS: WGS84]  "}],"dct:identifier":"c06939a6-65b4-4078-9cb5-b49aa48b9140","dct:issued":{"@type":"xsd:date","@value":"2025-01-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T05:44:21.435097"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:0be52177f4b69001482feebbf66edefe9b93bbb113f973aaaccad796e185375e_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Parkeringsgebyrer"},{"@language":"en","@value":"Parking fees"},{"@language":"sv","@value":"Parkeringsavgifter"}]},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1168f4db-87de-4f8b-b33f-8f2f5e0d44c9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1168f4db-87de-4f8b-b33f-8f2f5e0d44c9/download/parkeringsavgifter.gpkg"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"647168"},"dcat:mediaType":"application/vnd.sqlite3","dct:description":[{"@language":"da","@value":"Parkeringsgebyrer\n\n"},{"@language":"en","@value":"Parking fees\n\n"},{"@language":"sv","@value":"Parkeringsavgifter"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T11:33:21.648365"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-05T01:38:41.004786"},"dct:title":[{"@language":"da","@value":"Parkeringsgebyrer"},{"@language":"en","@value":"Parking fees"},{"@language":"sv","@value":"Parkeringsavgifter"}]},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1638ddef-4826-4bf4-99b8-9020a8ad89d9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1638ddef-4826-4bf4-99b8-9020a8ad89d9/download/parkeringsavgifter.sld"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"6787"},"dct:description":[{"@language":"da","@value":"-\n\n"},{"@language":"en","@value":"-\n\n"},{"@language":"sv","@value":"-"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2025-02-10T10:52:39.186757"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:49:13.821518"},"dct:title":[{"@language":"da","@value":"Stilisering"},{"@language":"en","@value":"Stylization"},{"@language":"sv","@value":"Stilsättning"}]},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1a6bd68b-30ca-40a5-9d62-01e2a566982e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/1a6bd68b-30ca-40a5-9d62-01e2a566982e/download/parkeringsavgifter.geojson"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1019129"},"dct:description":[{"@language":"da","@value":"Parkeringsgebyrer\n\n"},{"@language":"en","@value":"Parking fees\n\n"},{"@language":"sv","@value":"Parkeringsavgifter"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:dateTime","@value":"2025-01-16T07:11:45.689080"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-05T01:38:23.624869"},"dct:title":[{"@language":"da","@value":"Parkeringsgebyrer"},{"@language":"en","@value":"Parking fees"},{"@language":"sv","@value":"Parkeringsavgifter"}]},{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/66327bc9-9874-43dc-8445-493857f3f041","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/c06939a6-65b4-4078-9cb5-b49aa48b9140/resource/66327bc9-9874-43dc-8445-493857f3f041/download/parkeringsavgifter.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"549877"},"dct:description":[{"@language":"da","@value":"Parkeringsgebyrer\n\n"},{"@language":"en","@value":"Parking fees\n\n"},{"@language":"sv","@value":"Parkeringsavgifter"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-01-30T11:33:25.403811"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-03-18T21:49:13.821868"},"dct:title":[{"@language":"da","@value":"Parkeringsgebyrer"},{"@language":"en","@value":"Parking fees"},{"@language":"sv","@value":"Parkeringsavgifter"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:0be52177f4b69001482feebbf66edefe9b93bbb113f973aaaccad796e185375e_b0n0"}}],"@id":"urn:source:0be52177f4b69001482feebbf66edefe9b93bbb113f973aaaccad796e185375e"},{"@graph":[{"@id":"_:0c86e4e1a0a01551712216d2c4c664c0571cf92baeac7735003b69c8dc566dbb_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/d16b2fc7-5781-4443-af96-677e4b1eba85","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/d16b2fc7-5781-4443-af96-677e4b1eba85/resource/86546d19-3167-4d68-83c6-7c24f947a12c"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever, der startede i gymnasiet i kommunen for 3 år siden med adgang\ntil universitet/gymnasium inden for 3 år (inklusive introduktionsprogrammet\nIM), divideret med antallet af elever, der startede i gymnasiet i kommunen for\n3 år siden (inklusive IM).\n\nStatistik i procenter fra 2014.\n\nFra 2016 er studerende, der er færdiguddannet fra svenske skoler i udlandet,\nikke inkluderet.\n\nStatistikken er baseret på placeringskommune, hvilket refererer til elever i\nkommunale og friskoler i kommunen uanset hvor de er indskrevet.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of students who started upper secondary school in the municipality 3\nyears ago with eligibility for university/college within 3 years (including\nthe Introduction Program IM) divided by the number of students who started\nupper secondary school in the municipality 3 years ago, (including IM).\n\nStatistics in percentages from 2014.\n\nAs of 2016, students who have graduated from Swedish schools abroad are not\nincluded.\n\nThe statistics are based on location municipality, which refers to students in\nmunicipal and independent schools in the municipality regardless of where they\nare registered.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal elever som började på gymnasium i kommunen för 3 år sedan med behörighet till universitet/högskola inom 3 år (inklusive Introduktionsprogrammet IM) dividerat med antal elever som började på gymnasium i kommunen för 3 år sedan, (inklusive IM). \n\nStatistik i procent från 2014.\n\nFrån och med 2016 ingår inte elever som tagit examen i svenska utlandsskolor.\n\nStatistiken är baserat på lägeskommun vilket avser elever i kommunala och fristående skolor i kommunen oberoende på vart de är folkbokförda.\n\nKälla: SCB."}],"dct:identifier":"d16b2fc7-5781-4443-af96-677e4b1eba85","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:31:59.134729"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:0c86e4e1a0a01551712216d2c4c664c0571cf92baeac7735003b69c8dc566dbb_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 3 år, placeringskommune"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 3 years, location municipality"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 3 år, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/d16b2fc7-5781-4443-af96-677e4b1eba85/resource/86546d19-3167-4d68-83c6-7c24f947a12c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17476"},"dct:description":[{"@language":"da","@value":"Antal elever, der startede på gymnasiet i kommunen for 3 år siden med adgang\ntil universitet/gymnasium inden for 3 år, inkl. IM divideret med antal elever,\nder startede på gymnasiet i kommunen for 3 år siden, inkl. IM. Fra 2016 er\nelever, der er færdiguddannet fra svenske skoler i udlandet, ikke inkluderet.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Number of students who started upper secondary school in the municipality 3\nyears ago with eligibility for university/college within 3 years, incl. IM\ndivided by number of students who started upper secondary school in the\nmunicipality 3 years ago, incl. IM. From 2016, students who have graduated\nfrom Swedish schools abroad are not included. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever som började på gymnasium i  kommunen för 3 år sedan med behörighet till universitet/högskola inom 3 år, inkl. IM dividerat med antal elever som började på gymnasium i kommunen för 3 år sedan, inkl. IM. Fr.o.m. 2016 ingår inte elever som tagit examen i svenska utlandsskolor. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T12:51:34.256989"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:31:59.138284"},"dct:title":[{"@language":"da","@value":"Gymnasieelever, der har opnået grundlæggende adgang til universitet og videregående uddannelse inden for 3 år, placeringskommune, andel (%) (N17476)"},{"@language":"en","@value":"Upper secondary school students who have achieved basic eligibility for university and college within 3 years, municipality of location, proportion (%) (N17476)"},{"@language":"sv","@value":"Gymnasieelever som uppnått grundläggande behörighet till universitet och högskola inom 3 år, lägeskommun, andel (%) (N17476)"}]}],"@id":"urn:source:0c86e4e1a0a01551712216d2c4c664c0571cf92baeac7735003b69c8dc566dbb"},{"@graph":[{"@id":"_:0df1eaa701c81d5f1c7747ed3a549a9a1bb659115f39fa555e2768551b937a3c_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms