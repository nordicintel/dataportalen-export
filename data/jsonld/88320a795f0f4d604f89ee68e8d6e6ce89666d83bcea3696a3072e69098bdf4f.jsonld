27T09:35:44.806038"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:28:39.219889"},"dct:title":[{"@language":"da","@value":"Parker og pladser GeoPackage 4326"},{"@language":"en","@value":"Parks and Squares GeoPackage 4326"},{"@language":"sv","@value":"Parker och Torg GeoPackage 4326"}]},{"@id":"https://opendata-api.malmo.se/dataset/172c6d5f-7e71-4e7b-ae71-72ff3ed8417b/resource/fe84d9c3-bfb0-4a8d-83f2-203edd3566b8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/172c6d5f-7e71-4e7b-ae71-72ff3ed8417b/resource/fe84d9c3-bfb0-4a8d-83f2-203edd3566b8/download/park_torg.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"76850"},"dct:description":[{"@language":"da","@value":"Intet koordinatsystem\n\n"},{"@language":"en","@value":"No coordinate system\n\n"},{"@language":"sv","@value":"Inget koordinatsystem"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-05-27T10:28:13.645651"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-16T12:28:52.761449"},"dct:title":[{"@language":"da","@value":"Parker og pladser CSV"},{"@language":"en","@value":"Parks and Squares CSV"},{"@language":"sv","@value":"Parker och Torg\nCSV"}],"http://spdx.org/rdf/terms#checksum":{"@id":"_:8254948b0145152ed93f3d24ffea326b0037cd1c82dbce48fd47d14437860910_b4n0"}}],"@id":"urn:source:8254948b0145152ed93f3d24ffea326b0037cd1c82dbce48fd47d14437860910"},{"@graph":[{"@id":"_:84a726f93cbc4b957c4672fd65c49688aaeb46124022a132634680bfa46e7d23_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"07ae400a76422f933d0792b1e5c99f5e"},{"@id":"_:84a726f93cbc4b957c4672fd65c49688aaeb46124022a132634680bfa46e7d23_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861/resource/0aef9317-2193-4868-8167-2c40ed53911c"},{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861/resource/9fda6072-e481-4477-943b-4bde209331aa"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser antallet af lejligheder opdelt efter lejeboliger, ejerboliger eller\nejerlejligheder. \"Lejlighed\" bruges her til at henvise til både lejligheder i\netageejendomme og enfamiliehuse; en villa betragtes f.eks. som en lejlighed i\ndenne statistik. Antallet af lejligheder kan være større end antallet af\nbeboelseshusstande, hvis ingen er registreret i lejligheden på grund af\nadministrative forsinkelser, manglende opholdstilladelse blandt dem, der bor i\nlejligheden, manglende rettidig registrering, hvis ingen blot boede i\nlejligheden den 31/12 i det år, statistikken gælder, eller af andre lignende\nårsager. Alle lejligheder, der er inkluderet i lejlighedsregisteret, er\ninkluderet i statistikken, men kun områder med mere end 30 lejligheder i alt\nrapporteres. Data fra lejlighedsregisteret.\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald til at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the number of apartments divided by rental, tenant-owned or ownership.\n“Apartment” is used here to refer to both apartments in apartment buildings\nand single-family homes; a villa is considered an apartment in these\nstatistics, for example. The number of apartments may be greater than the\nnumber of residential households if no one is registered in the apartment due\nto administrative delays, lack of a residence permit among those living in the\napartment, failure to register on time, if no one simply lived in the\napartment on 31/12 of the year the statistics apply or due to other similar\nreasons. All apartments included in the apartment register are included in the\nstatistics, but only areas with more than 30 apartments in total are reported.\nData from the apartment register.\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar antalet lägenheter uppdelat efter hyresrätt, bostadsrätt eller äganderätt. ”Lägenhet” används här som beteckning både på bostäder i flerbostadshus och småhus, en villa betraktas till exempel som en lägenhet i denna statistik. Antalet lägenheter kan vara större än antalet bostadshushåll om ingen är folkbokförd på lägenheten på grund av administrativ eftersläpning, avsaknad av uppehållstillstånd bland de som bor i lägenheten, att man inte folkbokfört sig i tid, om ingen helt enkelt bodde i lägenheten den 31/12 året statistiken gäller eller på grund av andra liknande skäl. Alla lägenheter som finns med i lägenhetsregistret är med i statistiken men endast områden med fler än 30 totalt lägenheter redovisas. Data från lägenhetsregistret.\n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"cc6f2194-2861-4fda-a279-b2f4e0be7861","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:08:09.840610"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:84a726f93cbc4b957c4672fd65c49688aaeb46124022a132634680bfa46e7d23_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Lejeformular - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Tenancy form - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Upplåtelseform - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861/resource/0aef9317-2193-4868-8167-2c40ed53911c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=9fda6072-e481-4477-943b-4bde209331aa"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Ejerskabstype\n\n"},{"@language":"en","@value":"Malmö statistics - Type of ownership\n\n"},{"@language":"sv","@value":"Malmö statistik - Upplåtelseform"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:56.196942"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-02T23:07:37.095967"},"dct:title":[{"@language":"da","@value":"Leveringsform"},{"@language":"en","@value":"Form of delivery"},{"@language":"sv","@value":"Upplåtelseform"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861/resource/9fda6072-e481-4477-943b-4bde209331aa","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/cc6f2194-2861-4fda-a279-b2f4e0be7861/resource/9fda6072-e481-4477-943b-4bde209331aa/download/upplatelseform.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"397606"},"dct:description":[{"@language":"da","@value":"Malmø statistik - Ejerskabstype\n\n"},{"@language":"en","@value":"Malmö statistics - Type of ownership\n\n"},{"@language":"sv","@value":"Malmö statistik - Upplåtelseform"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:20:51.969315"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:08:09.848952"},"dct:title":[{"@language":"da","@value":"Leveringsform"},{"@language":"en","@value":"Form of delivery"},{"@language":"sv","@value":"Upplåtelseform"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:84a726f93cbc4b957c4672fd65c49688aaeb46124022a132634680bfa46e7d23_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:84a726f93cbc4b957c4672fd65c49688aaeb46124022a132634680bfa46e7d23"},{"@graph":[{"@id":"_:86f7ad183af3cb94a5fc60e3af02dcac326c8ab61b3f8a990155af9a28f53947_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/6540f8e6-39d6-4ab9-82e3-199179c8ff3e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/6540f8e6-39d6-4ab9-82e3-199179c8ff3e/resource/04db943b-bc41-4eef-b3f0-19b6cbcb7b93"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen (hjemkommunen), der startede i gymnasiet\nfor 4 år siden, og som modtog en uddannelse eller et studiebevis inden for 4\når (inklusive introduktionsprogram IM), divideret med antallet af registrerede\nelever i kommunen, der startede i gymnasiet for 4 år siden (inklusive IM).\n\nStatistik i procenter fra 2015.\n\nStuderende, der ikke har et svensk personnummer ved starten af ​​deres\nuddannelse (for eksempel nyankomne studerende, der endnu ikke er blevet\nregistreret), er ikke medregnet.\n\nKun studerende med et studiebevis på 2.500 point indberettes.\n\nKilde: Statistiska Centralbyrån.\n\n"},{"@language":"en","@value":"Number of registered students in the municipality (home municipality) who\nstarted upper secondary school 4 years ago who received a degree or study\ncertificate within 4 years, (including introductory program IM), divided by\nthe number of registered students in the municipality who started upper\nsecondary school 4 years ago, (including IM).\n\nStatistics in percentages from 2015.\n\nStudents who do not have a Swedish personal identification number at the\nbeginning of their education (for example, newly arrived students who have not\nyet been registered) are not included.\n\nOnly students with a study certificate of 2,500 points are reported.\n\nSource: Statistics Sweden.\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen (hemkommunen) som började på gymnasium för 4 år sedan som fått examen eller studiebevis inom 4 år, (inklusive introduktionsprogram IM), dividerat med antal folkbokförda elever i kommunen som började på gymnasium för 4 år sedan, (inklusive IM). \n\nStatistik i procent från 2015.\n\nElever som vid utbildningens början saknar svenskt personnummer (exempelvis nyanlända elever som ännu inte blivit folkbokförda) ingår ej. \n\nEndast elever med  studiebevis om 2 500 poäng redovisas. \n\nKälla: SCB."}],"dct:identifier":"6540f8e6-39d6-4ab9-82e3-199179c8ff3e","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:02:06.641623"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:86f7ad183af3cb94a5fc60e3af02dcac326c8ab61b3f8a990155af9a28f53947_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Gymnasieelever med en uddannelse eller et certifikat inden for de sidste 4 år, hjemkommune"},{"@language":"en","@value":"Upper secondary school students with a degree or certificate within 4 years, home municipality"},{"@language":"sv","@value":"Gymnasieelever med examen eller studiebevis inom 4 år, hemkommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/6540f8e6-39d6-4ab9-82e3-199179c8ff3e/resource/04db943b-bc41-4eef-b3f0-19b6cbcb7b93","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N17457"},"dct:description":[{"@language":"da","@value":"Antal registrerede elever i kommunen, der startede i gymnasiet for fire år\nsiden, og som modtog en uddannelse eller et studiebevis inden for fire år,\ninkl. IM, divideret med antallet af registrerede elever i kommunen, der\nstartede i gymnasiet for fire år siden, inkl. IM. Elever, der ikke har et\nsvensk personnummer ved starten af ​​deres uddannelse (f.eks. nyankomne\nelever, der endnu ikke er blevet registreret), er ikke inkluderet. Kun elever\nmed et studiebevis på 2.500 point rapporteres. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of registered students in the municipality who started upper secondary\nschool four years ago who received a degree or study certificate within four\nyears, incl. IM divided by the number of registered students in the\nmunicipality who started upper secondary school four years ago, incl. IM.\nStudents who do not have a Swedish personal identity number at the start of\ntheir education (e.g. newly arrived students who have not yet been registered)\nare not included. Only students with a study certificate of 2,500 points are\nreported. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal folkbokförda elever i kommunen som började på gymnasium för fyra år sedan som fått examen eller studiebevis inom fyra år, inkl. IM dividerat med antal folkbokförda elever i kommunen som började på gymnasium för fyra år sedan, inkl. IM. Elever som vid utbildningens början saknar svenskt personnummer (t ex nyanlända elever som ännu inte blivit folkbokförda) ingår ej. Endast elever med  studiebevis om 2 500 poäng redovisas. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-12T08:48:24.926234"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:02:06.645764"},"dct:title":[{"@language":"da","@value":"Gymnasieelever med en uddannelse eller et certifikat inden for 4 år, bopælskommune, andel (%) (N17457)"},{"@language":"en","@value":"Upper secondary school students with a degree or certificate within 4 years, municipality of residence, proportion (%) (N17457)"},{"@language":"sv","@value":"Gymnasieelever med examen eller studiebevis inom 4 år, hemkommun, andel (%) (N17457)"}]}],"@id":"urn:source:86f7ad183af3cb94a5fc60e3af02dcac326c8ab61b3f8a990155af9a28f53947"},{"@graph":[{"@id":"_:87147dc9e4567fc65f94f5fbbcfc84485c89b6385713ff299588126dacf3a2cc_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_sha1"},"http://spdx.org/rdf/terms#checksumValue":"3d8a3b0996f44682cf19776d0a858e82"},{"@id":"_:87147dc9e4567fc65f94f5fbbcfc84485c89b6385713ff299588126dacf3a2cc_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karl McShane","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:karl.mcshane@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/ce429264a6a97cd4bc8687f7a5b0847d"},"dcat:distribution":[{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4/resource/1ce147c6-0a47-4286-b1a5-3acc594f1cb5"},{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4/resource/d500deb5-6eeb-47db-96fd-b309cc7a1d36"}],"dcat:keyword":["Malmö stad","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"da","@value":"Viser andelen af ​​erhvervsaktive blandt befolkningen i området i alderen\n20-64 år. Dataene er baseret på data fra det såkaldte kontroldataregister.\nAlle, der udbetaler løn, anden godtgørelse eller ydelser, der udgør\nskattepligtig indkomst fra arbejde, skal indberette kontroldata. Definitionen\ner den samme som i Arbejdskraftundersøgelsen (AKU): For lønmodtagere skal man\nhave arbejdet mindst én time om ugen i november. For selvstændige tælles i\nstedet indkomst fra aktiv erhvervsaktivitet i løbet af året. Selv de, der er\nmidlertidigt fraværende fra et job i måleperioden, f.eks. på grund af sygdom,\ntælles som erhvervsaktive. Personer med meget lav indkomst tælles ikke som\nerhvervsaktive. Dataene er opdelt efter køn. Vist for aldersgruppen 20-64. Fra\nreferenceåret 2019 bruger Statistiska Centralen (SCB) en ny datakilde og\nmetode til at klassificere erhvervsaktive i RAMS. Ændringen i kilde og metode\nbetyder, at sammenligninger af statistik for 2019 og tidligere referenceår\nskal foretages med stor forsigtighed. Læs mere på SCB.se. Data fra SCB RAMS\n(“Registerbaseret arbejdsmarkedsstatistik”).\n\n**Variabelbeskrivelse**  \nDu finder det\n[her](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**API'er**  \nVed at bruge API-kaldet\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics_\nkan du hente alle datasæt, der indeholder statistiske data for Malmøs områder,\ni JSON-format.  \nI hver forekomst af result/results i JSON-resultatet er der en \"id\"-egenskab\nfor hver ressource. Værdien af ​​\"id\" kan bruges til at hente dataene for den\nrespektive statistikvariabel (i henhold til værdien af ​​egenskaben \"name\").\nAPI-kald for at hente statistikdataene:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id-\nværdi]_\n\nBrug gerne tallene, men angiv \"Bykontoret, Malmö Kommune\" som kilde.\n\n"},{"@language":"en","@value":"Shows the proportion of gainfully employed people among the population in the\narea aged 20-64. The data is based on data from the so-called control data\nregister. Everyone who pays out wages, salaries, other compensation or\nbenefits that constitute taxable income from work must report control data.\nThe definition is the same as in the Labour Force Survey (LFS): for wage\nearners, you must have worked at least one hour a week during November. For\nself-employed people, income from active business activities during the year\nis counted instead. Even those who are temporarily absent from a job during\nthe measurement period, e.g. due to illness, are counted as gainfully\nemployed. People with very low income are not counted as gainfully employed.\nThe data is broken down by gender. Shown for the age range 20–64. From the\nreference year 2019, Statistics Sweden uses a new data source and method to\nclassify gainfully employed people in RAMS. The change in source and method\nmeans that comparisons of statistics for 2019 and previous reference years\nmust be made with great caution. Read more at SCB.se. Data from SCB RAMS\n(“Register-based labour market statistics”).\n\n**Variable description**  \nYou find it\n[here](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)\n!\n\n**APIs**  \nUsing the API call\n_https://opendata%2dapi.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistics,_\nyou can retrieve all data sets that contain statistical data for Malmö's areas\nin JSON format.  \nIn each instance of result/results in the JSON result, there is an \"id\"\nproperty for each resource. The value of \"id\" can be used to retrieve the data\nfor the respective statistics variable (according to the value of the \"name\"\nproperty). API call to retrieve the statistics data:\n_https://opendata%2dapi.malmo.se/api/3/action/datastore_search?resource_id=[id\nvalue]_\n\nFeel free to use the numbers, but cite “City Office, Malmö City” as the\nsource.\n\n"},{"@language":"sv","@value":"Visar andelen förvärvsarbetande bland befolkning i området i åldrarna 20-64 år. \nDatan är baserad på data från det så kallade kontrolluppgiftsregistret. Alla som betalar ut lön, arvode, andra ersättningar eller förmåner som utgör skattepliktig inkomst av tjänst ska anmäla kontrolluppgifter. Definitionen är densamma som i arbetskraftsundersökningen (AKU): för lönearbetare måste man ha arbetat minst en timme i veckan under november. För personliga företagare räknas istället inkomst av aktiv näringsverksamhet under året. Även de som är tillfälligt frånvarande från en anställning under mätperioden, t.ex. p.g.a. sjukdom, räknas som förvärvsarbetande. Personer med väldigt låg inkomst räknas inte som förvärvsarbetande. Datan finns uppdelad på kön. Visas för åldersspannet 20–64. Från och med referensår 2019 använder SCB en ny datakälla och metod för att klassificera förvärvsarbetande i RAMS. Bytet av källa och metod innebär att jämförelser av statistik avseende 2019 och tidigare referensår måste göras med stor försiktighet. Läs mer på SCB.se. Data från SCB RAMS (”Registerbaserad arbetsmarknadsstatistik”). \n\n__Variabelbeskrivning__  \nHittar du [här](https://malmo.se/download/18.4968b1201a03e2e59771007/1791175330421/Variabelbeskrivning%20statistikunderlag%20f%C3%B6r%20Malm%C3%B6s%20omr%C3%A5den.pdf)!  \n                     \n__API__  \nMed hjälp av API-anropet *https://opendata-api.malmo.se/api/3/action/resource_search?query=description:malm%C3%B6%20statistik* får man i JSON-format fram samtliga datamängder som innehåller statistikunderlag för Malmös områden.  \nI varje instans av result/results i JSON-resultatet finns för varje resurs en egenskap \"id\". Värdet för \"id\" kan användas för att hämta datan för respektive statistikvariabel (enligt värdet för egenskapen \"name\").\nAPI-anrop för att hämta statistikdatan: *https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=[id-värdet]*   \n\nAnvänd gärna siffrorna, men ange “Stadskontoret, Malmö stad” som källa."}],"dct:identifier":"8642844d-7362-4466-9711-ee7a659c97e4","dct:issued":{"@type":"xsd:date","@value":"2026-10-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:07.176009"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:87147dc9e4567fc65f94f5fbbcfc84485c89b6385713ff299588126dacf3a2cc_b1n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Erhvervsrate, 2007-2018 - Statistiske data for Malmøs områder"},{"@language":"en","@value":"Acquisition rate, 2007-2018 - Statistical data for Malmö's areas"},{"@language":"sv","@value":"Förvärvsgrad, 2007-2018 - Statistikunderlag för Malmös områden"}]},{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4/resource/1ce147c6-0a47-4286-b1a5-3acc594f1cb5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/api/3/action/datastore_search?resource_id=d500deb5-6eeb-47db-96fd-b309cc7a1d36"},"dct:description":[{"@language":"da","@value":"Malmö-statistik - Erhvervsrate, 2007-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Acquisition rate, 2007-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Förvärvsgrad, 2007-2018"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:21.969406"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:27.216015"},"dct:title":[{"@language":"da","@value":"Erhvervsrate, 2007-2018"},{"@language":"en","@value":"Acquisition rate, 2007-2018"},{"@language":"sv","@value":"Förvärvsgrad, 2007-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4/resource/d500deb5-6eeb-47db-96fd-b309cc7a1d36","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://opendata-api.malmo.se/dataset/8642844d-7362-4466-9711-ee7a659c97e4/resource/d500deb5-6eeb-47db-96fd-b309cc7a1d36/download/forvarvsgrad-2007-2018.csv"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"496052"},"dct:description":[{"@language":"da","@value":"Malmö-statistik - Erhvervsrate, 2007-2018\n\n"},{"@language":"en","@value":"Malmö statistics - Acquisition rate, 2007-2018\n\n"},{"@language":"sv","@value":"Malmö statistik - Förvärvsgrad, 2007-2018"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:dateTime","@value":"2026-04-10T07:18:17.268540"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://www.opendefinition.org/licenses/cc-zero"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-10-15T23:05:07.194654"},"dct:title":[{"@language":"da","@value":"Erhvervsrate, 2007-2018"},{"@language":"en","@value":"Acquisition rate, 2007-2018"},{"@language":"sv","@value":"Förvärvsgrad, 2007-2018"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:87147dc9e4567fc65f94f5fbbcfc84485c89b6385713ff299588126dacf3a2cc_b0n0"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:87147dc9e4567fc65f94f5fbbcfc84485c89b6385713ff299588126dacf3a2cc"},{"@graph":[{"@id":"_:8a198c2acc000a6e954f8decbc75ef708bd0dda9edc53064c4a7ce334b5cbc81_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/69ad6420-a28f-49b2-aa0d-54a2f0c588cf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/69ad6420-a28f-49b2-aa0d-54a2f0c588cf/resource/57bdbad8-ab44-456f-b8d5-c602c0f82cd3"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\nførskole inklusive åben førskole, SEK pr. indbygger. Pædagogisk pasning\n(tidligere kaldet familiedagpleje) er ikke inkluderet.\n\nNettoomkostninger er bruttoomkostninger minus bruttoindkomst.\nReferenceomkostningerne er baseret på nettoomkostninger og strukturelle\nvariabler for det indeværende år. Standardomkostningerne for førskole beregnes\nved hjælp af variablerne gennemsnitlig opholdstid i førskole og andelen af\n​​1-5-årige. Derudover lægges en del af standardomkostningerne fra\ndelmodellerne løn, bygningsstruktur og befolkningsudvikling til.\n\nPositive værdier indikerer en højere omkostningssituation end forventet, og\nnegative værdier indikerer en lavere omkostningssituation end forventet.\n\nFra og med 2019 beregnes nettoomkostningsvarians på en ny måde på grund af\nændringer i omkostningsudligningen. Dette påvirker sammenligneligheden med\ntidligere år.\n\nKilde: SKR.\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for preschool\nincluding open preschool, SEK per inhabitant. Pedagogical care (formerly\ncalled family daycare) is not included.\n\nNet cost is gross cost minus gross income. The reference cost is based on net\ncosts and structural variables for the current year. The standard cost for\npreschool is calculated using the variables average length of stay at\npreschool and proportion of 1-5 year olds. In addition, part of the standard\ncosts from the sub-models wages, building structure and population development\nare added.\n\nPositive values ​​indicate a higher cost situation than expected and negative\nvalues ​​indicate a lower cost situation than expected.\n\nStarting in 2019, net cost variance is calculated in a new way due to changes\nin cost equalization. This affects comparability with previous years.\n\nSource: SKR.\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för förskola inklusive öppen förskola, kronor per invånare. Pedagogisk omsorg (tidigare kallat familjedaghem) ingår inte. \n\nNettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnader och strukturvariabler för det aktuella året. Standardkostnaden för förskolan beräknas med hjälp av variablerna genomsnittlig vistelsetid på förskola samt andel 1-5 åringar. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling.\n\nPositiva värden indikerar högre kostnadsläge än förväntat och negativa värden ett lägre kostnadsläge än förväntat. \n\nFrån och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt på grund av förändringar i kostnadsutjämningen.  Detta påverkar jämförbarheten med tidigare år. \n\nKälla: SKR."}],"dct:identifier":"69ad6420-a28f-49b2-aa0d-54a2f0c588cf","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:40:41.786248"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:8a198c2acc000a6e954f8decbc75ef708bd0dda9edc53064c4a7ce334b5cbc81_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse førskole inklusive åben førskole, procent"},{"@language":"en","@value":"Net cost deviation preschool including open preschool, percent"},{"@language":"sv","@value":"Nettokostnadsavvikelse förskola inklusive öppen förskola, procent"}]},{"@id":"https://opendata-api.malmo.se/dataset/69ad6420-a28f-49b2-aa0d-54a2f0c588cf/resource/57bdbad8-ab44-456f-b8d5-c602c0f82cd3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N11024"},"dct:description":[{"@language":"da","@value":"Afvigelse i procent mellem nettoomkostninger og referenceomkostninger for\nførskole inkl. åben førskole, SEK/indbygger. Pædagogisk omsorg (tidligere\nkaldet familiedagpleje) er ikke inkluderet. Nettoomkostninger er\nbruttoomkostninger minus bruttoindkomst. Referenceomkostningerne er baseret på\nnettoomkostninger og strukturelle variabler for indeværende år.\nStandardomkostningerne for førskole beregnes ved hjælp af variablerne\ngennemsnitlig opholdstid i førskole og andel af 1-5-årige. Derudover lægges en\ndel af standardomkostningerne fra delmodellerne lønninger, bygningsstruktur og\nbefolkningsudvikling til. Positive værdier indikerer en højere\nomkostningssituation end forventet, og negative værdier en lavere\nomkostningssituation end forventet. Fra og med 2019 beregnes\nnettoomkostningsafvigelsen på en ny måde på grund af ændringer i\nomkostningsudligningen. Dette påvirker sammenligneligheden med tidligere år.\nKilde: Kolada\n\n"},{"@language":"en","@value":"Deviation in percentage between net cost and reference cost for preschool\nincl. open preschool, SEK/inhabitant. Pedagogical care (formerly called family\ndaycare) is not included. Net cost is gross cost minus gross income. The\nreference cost is based on net costs and structural variables for the current\nyear. The standard cost for preschool is calculated using the variables\naverage length of stay at preschool and proportion of 1-5 year olds. In\naddition, part of the standard costs from the sub-models salaries, building\nstructure and population development are added. Positive values ​​indicate a\nhigher cost situation than expected and negative values ​​a lower cost\nsituation than expected. From 2019 onwards, the net cost deviation is\ncalculated in a new way due to changes in cost equalization. This affects\ncomparability with previous years. Source: Kolada\n\n"},{"@language":"sv","@value":"Avvikelse i procent mellan nettokostnad och referenskostnad för förskola inkl. öppen förskola, kr/inv. Pedagogisk omsorg (tidigare kallat familjedaghem) ingår inte. Nettokostnad är bruttokostnad minus bruttointäkt. Referenskostnaden bygger på nettokostnader och strukturvariabler för det aktuella året. Standardkostnaden för förskolan beräknas med hjälp av variablerna genomsnittlig vistelsetid på förskola samt andel 1-5 åringar. Därutöver tillkommer del av standardkostnaderna från delmodellerna löner, bebyggelsestruktur och befolkningsutveckling. Positiva värden indikerar högre kostnadsläge än förväntat och negativa värden ett lägre kostnadsläge än förväntat. Från och med 2019 beräknas nettokostnadsavvikelse på ett nytt sätt pga förändringar i kostnadsutjämningen. Detta påverkar jämförbarheten med tidigare år. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-17T12:58:44.437248"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:40:41.793167"},"dct:title":[{"@language":"da","@value":"Nettoomkostningsafvigelse børnehave inkl. åben børnehave (%) (N11024)"},{"@language":"en","@value":"Net cost deviation preschool incl. open preschool, (%) (N11024)"},{"@language":"sv","@value":"Nettokostnadsavvikelse förskola inkl. öppen förskola, (%) (N11024)"}]}],"@id":"urn:source:8a198c2acc000a6e954f8decbc75ef708bd0dda9edc53064c4a7ce334b5cbc81"},{"@graph":[{"@id":"_:8a8e5b64f2555980793edf8c2b8c238772061eac17d98665a6a7ba5e8f856ad7_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/802d2eec-4335-40ff-bc0e-ed0d29b47a58","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/802d2eec-4335-40ff-bc0e-ed0d29b47a58/resource/93746ad2-04a0-4e13-842f-4b23812dac15"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til naturvidenskabelige og\nteknologiske uddannelser, divideret med antallet af elever, der fik eller\nville have fået karakterer i mindst ét ​​fag i henhold til det mål- og\nvidensrelaterede karaktersystem i 9. klasse.\n\nStatistik i procenter fra 2011.\n\nBegrebet \"lokationskommune\" henviser til elever på skoler beliggende i\nkommunen, uanset deres folkeregistreringssted.\n\nOplysningerne refererer til skoleåret. Hvis det samlede antal elever er 40\neller mere, og antallet af IKKE-berettigede elever er 1-4 elever, vises\nprocentdelen af ​​berettigede elever som 95 procent.\n\nI 2016 blev studerende med ukendt baggrund udelukket.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the science and technology\nprograms divided by the number of students who received or would have received\ngrades in at least one subject according to the goal- and knowledge-related\ngrading system in grade 9.\n\nStatistics in percentages from 2011.\n\nThe term \"location municipality\" refers to students in schools located in the\nmunicipality, regardless of their place of population registration.\n\nThe information refers to the school year. If the total number of students is\n40 or more and the number of NOT eligible students is 1-4 students, the\npercentage of eligible students is shown as 95 percent.\n\nIn 2016, students with unknown backgrounds were excluded.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till naturvetenskaps- och teknikprogrammen dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. \n\nStatistik i procent från 2011.\n\nMed lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort. \n\nUppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. \n\n2016 exkluderades elever med okänd bakgrund. \n\nKälla: Skolverket (Siris)."}],"dct:identifier":"802d2eec-4335-40ff-bc0e-ed0d29b47a58","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:39:31.434647"},"dct:publisher":{"@id":"https://malmo.se/"},"dct:spatial":[{"@id":"_:8a8e5b64f2555980793edf8c2b8c238772061eac17d98665a6a7ba5e8f856ad7_b0n0"},{"@id":"http://www.geonames.org/2692965/malmoe.html"}],"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til naturvidenskabelige og teknologiske uddannelser, placeringskommune"},{"@language":"en","@value":"Students in grade 9 who are eligible for the science and technology programs, location municipality"},{"@language":"sv","@value":"Elever i årskurs 9 som är behöriga till naturvetenskaps- och teknikprogrammen, lägeskommun"}]},{"@id":"https://opendata-api.malmo.se/dataset/802d2eec-4335-40ff-bc0e-ed0d29b47a58/resource/93746ad2-04a0-4e13-842f-4b23812dac15","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.kolada.se/v3/data/municipality/1280/kpi/N15421"},"dct:description":[{"@language":"da","@value":"Antal elever i 9. klasse, der er berettigede til naturvidenskabelige og\nteknologiske uddannelser, divideret med antallet af elever, der modtog eller\nville have modtaget karakterer i mindst ét ​​fag i henhold til det mål- og\nvidensrelaterede karaktersystem i 9. klasse. Kommunen, hvor eleverne er\nplaceret, refererer til elever på skoler beliggende i kommunen, uanset\nfolkeregistreringssted. Dataene refererer til skoleåret. Hvis det samlede\nantal elever er 40 eller mere, og antallet af IKKE-berettigede er 1-4 elever,\nvises procentdelen af ​​berettigede elever som 95 procent. I 2016 blev elever\nmed ukendt baggrund ekskluderet. Kilde: Kolada\n\n"},{"@language":"en","@value":"Number of students in grade 9 who are eligible for the science and technology\nprograms divided by the number of students who received or would have received\ngrades in at least one subject according to the goal- and knowledge-related\ngrading system in grade 9. The municipality of location refers to students in\nschools located in the municipality regardless of the place of population\nregistration. The data refers to the academic year. If the total number of\nstudents is 40 or more and the number of NOT eligible is 1-4 students, the\npercentage of eligible students is shown as 95 percent. In 2016, students with\nunknown backgrounds were excluded. Source: Kolada\n\n"},{"@language":"sv","@value":"Antal elever i årskurs 9 som är behöriga till naturvetenskaps- och teknikprogrammen dividerat med antal elever som fått eller skulle ha fått betyg i minst ett ämne enligt det mål- och kunskapsrelaterade betygssystemet i årskurs 9. Med lägeskommun avses elever i skolor belägna i kommunen oavsett folkbokföringsort. Uppgiften avser läsår. Om det totala antalet elever är 40 eller fler och antalet EJ behöriga är 1-4 elever, så visas andelen behöriga som 95 procent. 2016 exkluderades elever med okänd bakgrund. \nKälla: Kolada"}],"dct:issued":{"@type":"xsd:dateTime","@value":"2022-08-11T12:53:22.941047"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-04-17T08:39:31.456715"},"dct:title":[{"@language":"da","@value":"Elever i 9. klasse, der er berettigede til naturvidenskabelige og teknologiske uddannelser, placering, kommune, procentdel (%) (N15421)"},{"@language":"en","@value":"Students in year 9 who are eligible for science and technology programs, location municipality, percentage (%) (N15421)"},{"@language":"sv","@value":"Elever i år 9 som är behöriga till naturvetenskaps- och teknikprogrammen, lägeskommun, andel (%) (N15421)"}]}],"@id":"urn:source:8a8e5b64f2555980793edf8c2b8c238772061eac17d98665a6a7ba5e8f856ad7"},{"@graph":[{"@id":"_:8bf40e6d32eed072b306007d5da2e6532220ae4ec435d62847d3d9703ff7b608_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.8850967451 55.6421476735,13.1517619812 55.6421476735,13.1517619812 55.5022773196,12.8850967451 55.5022773196,12.8850967451 55.6421476735))"}},{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"opendata@malmo.se","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:opendata@malmo.se"}},{"@id":"https://malmo.se/","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://malmo.se/"},"foaf:name":"Malmö stad"},{"@id":"https://opendata-api.malmo.se/dataset/c504b8d4-1417-4b36-8024-4efc6f75849e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://admin.dataportal.se/store/290/resource/0e01ba1a25b24ce4d82683ada08cb166"},"dcat:distribution":{"@id":"https://opendata-api.malmo.se/dataset/c504b8d4-1417-4b36-8024-4efc6f75849e/resource/fc5a50c5-12fe-4064-8c5e-34c9264fb3ae"},"dcat:keyword":["Malmö stad","kolada","statistik"],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"da","@value":"Dataene viser antallet af elever pr. lærer (som har en fuldtidsstilling) på\ngymnasier beliggende i kommunen.\n\nStatistik fra 2004. Hentet 15. oktober.\n\nKilde: Den svenske statslige skolestyrelse (Siris).\n\n"},{"@language":"en","@value":"The data shows the number of students per teacher (who holds a full-time\nposition) in upper secondary schools located in the municipality.\n\nStatistics from 2004. Retrieved October 15.\n\nSource: Swedish National Agency for Education (Siris).\n\n"},{"@language":"sv","@value":"Datan visar antal elever per lärare (som innehar en heltidstjänst) inom gymnasieskolor belägna i kommunen. \n\nStatistik från 2004. Tas fram den 15 oktober. \n\nKälla Skolverket (Siris)."}],"dct:identifier":"c504b8d4-1417-4b36-8024-4efc6f75849e","dct:issued":{"@type":"xsd:date","@value":"2020-12-15"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/languag