ue":"Dataset för riksdagens dokument i CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:rights":{"@id":"_:1cb0ccbeb400ba934652c5ba789249aeaea94bc323d385b9b4332be0cbf55a19_b6n0"},"dct:title":{"@language":"sv","@value":"Riksdagens dokument CSV Dataset"},"foaf:page":{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://editera.dataportal.se/store/242/resource/6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Riksdagsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1cb0ccbeb400ba934652c5ba789249aeaea94bc323d385b9b4332be0cbf55a19_b8n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:riksdagsinformation@riksdagen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:1cb0ccbeb400ba934652c5ba789249aeaea94bc323d385b9b4332be0cbf55a19_b10n0"},{"@id":"_:1cb0ccbeb400ba934652c5ba789249aeaea94bc323d385b9b4332be0cbf55a19_b9n0"}]},{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"With the help of Riksdagen's open data, developers, journalists, researchers and other interested parties can build their own services and produce statistics based on Riksdagen's databases. Users can use Riksdagen's API to build their own services, and download ready-made datasets that can then be further processed."},{"@language":"sv","@value":"Med hjälp av riksdagens öppna data kan utvecklare, journalister, forskare och andra intresserade bygga egna tjänster och ta fram statistik med riksdagens databaser som grund. Användare kan dels utgå från riksdagens API för att bygga egna tjänster, och dels ladda ner färdiga dataset som sedan kan bearbetas vidare.\nLäs mer:\nhttps://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/anvandarstod/om-dataset/"}],"dct:title":[{"@language":"en","@value":"Documentation for the Riksdag Open data"},{"@language":"sv","@value":"Dokumentation för Riksdagens Öppna data"}]}],"@id":"urn:source:1cb0ccbeb400ba934652c5ba789249aeaea94bc323d385b9b4332be0cbf55a19"},{"@graph":[{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f4950764b8cdbc3469784_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10012","http://www.w3.org/2006/vcard/ns#street-address":"Riksgatan 1"},{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f4950764b8cdbc3469784_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4620349000"}},{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f4950764b8cdbc3469784_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4620349000"}},{"@id":"http://dataportal.se/organisation/SE2021002627","@type":"foaf:Agent","dct:identifier":"2021002627","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.riksdagen.se"},"foaf:mbox":[{"@id":"mailto:registrator@riksdagen.se"},{"@id":"mailto:webbredaktionen@riksdagen.se"}],"foaf:name":{"@language":"sv","@value":"Riksdagsförvaltningen"},"foaf:page":{"@id":"https://www.riksdagen.se"}},{"@id":"https://editera.dataportal.se/store/242/resource/11","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/242/resource/6"},"dcat:endpointDescription":{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/"},"dcat:endpointURL":{"@id":"https://data.riksdagen.se/dokumentlista/?avd=dokument&doktyp=&sort=rel&sortorder=desc&utformat=json"},"dcat:keyword":[{"@language":"en","@value":"Parliament"},{"@language":"sv","@value":"Betänkande"},{"@language":"sv","@value":"Dokument"},{"@language":"sv","@value":"Framställning"},{"@language":"sv","@value":"Interpellation"},{"@language":"sv","@value":"Motion"},{"@language":"sv","@value":"Proposition"},{"@language":"sv","@value":"Redogörelse"},{"@language":"sv","@value":"Riksdagen"},{"@language":"sv","@value":"SOU"}],"dcat:landingPage":{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/"},"dcat:servesDataset":{"@id":"https://editera.dataportal.se/store/242/resource/2"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Riksdagens dokument, till exempel betänkanden, motioner, interpellationer samt kammarens och utskottens protokoll. Även en del dokument som inte är riksdagens, men som är kopplade till riksdagens arbete, till exempel propositioner, sou, ds samt dokument från riksdagens organ."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002627"},"dct:title":{"@language":"sv","@value":"Riksdagens dokument"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/"}},{"@id":"https://editera.dataportal.se/store/242/resource/6","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Riksdagsförvaltningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f4950764b8cdbc3469784_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:riksdagsinformation@riksdagen.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f4950764b8cdbc3469784_b1n0"},{"@id":"_:2a437e09c54cbb0073784f7807aacdee70a4e2642e7f495