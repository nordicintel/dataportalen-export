uage":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021002627"},"dct:source":{"@id":"https://editera.dataportal.se/store/242/resource/9"},"dct:title":{"@language":"sv","@value":"Riksdagens anföranden"},"foaf:page":{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/"},"http://entryscape.com/terms/servedByDataService":{"@id":"https://editera.dataportal.se/store/242/resource/14"}},{"@id":"https://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"With the help of Riksdagen's open data, developers, journalists, researchers and other interested parties can build their own services and produce statistics based on Riksdagen's databases. Users can use Riksdagen's API to build their own services, and download ready-made datasets that can then be further processed."},{"@language":"sv","@value":"Med hjälp av riksdagens öppna data kan utvecklare, journalister, forskare och andra intresserade bygga egna tjänster och ta fram statistik med riksdagens databaser som grund. Användare kan dels utgå från riksdagens API för att bygga egna tjänster, och dels ladda ner färdiga dataset som sedan kan bearbetas vidare.\nLäs mer:\nhttps://www.riksdagen.se/sv/dokument-och-lagar/riksdagens-oppna-data/anvandarstod/om-dataset/"}],"dct:title":[{"@language":"en","@value":"Documentation for the Riksdag Open data"},{"@language":"sv","@value":"Dokumentation för Riksdagens Öppna data"}]}],"@id":"urn:source:bfb4330d4c0662c38dd11c73e1f02ce57cf93dfc3f754002eede733d93775ce4"},{"@graph":[{"@id":"_:d59e58710e696edaf7d55d110e6da980000d8766f416362af7c5e49f5435491c_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sweden","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"10012","http://www.w3.org/2006/vcard/ns#stre