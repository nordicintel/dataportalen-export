"http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://data.tomelilla.se/store/1/resource/8"},"dcat:distribution":[{"@id":"https://data.tomelilla.se/store/1/resource/11"},{"@id":"https://data.tomelilla.se/store/1/resource/40"},{"@id":"https://data.tomelilla.se/store/1/resource/9"}],"dcat:keyword":[{"@language":"sv","@value":"Elbil"},{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Laddinfra"},{"@language":"sv","@value":"Laddning"},{"@language":"sv","@value":"Laddpunkter"},{"@language":"sv","@value":"Laddstationer"},{"@language":"sv","@value":"Laddstolpar"}],"dcat:landingPage":{"@id":"https://www.tomelilla.se/trafik-och-resor/kora-bil/laddstationer"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller laddstationer och laddpunkter (även kallat laddstolpar) som ägs av kommunen och som kan användas för laddning av elfordon. Innehållet är begränsat till stationer och punkter som inte byggts i samverkan med en etablerad tillhandahållare av laddinfrastruktur (som t.ex. Clever, InCharge eller Charge & Go), data om dessa publiceras av den parten separat. Denna öppna data aggregeras på laddinfra.se där data från många källor samlas på nationell nivå."},"dct:issued":{"@type":"xsd:date","@value":"2021-03-18"},"dct:modified":{"@type":"xsd:date","@value":"2021-03-18"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000886"},"dct:title":{"@language":"sv","@value":"Laddstationer och laddpunkter för elfordon i Tomelilla kommun"}},{"@id":"https://data.tomelilla.se/store/1/resource/40","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://data.tomelilla.se/rowstore/dataset/1b27b61c-1201-45e4-bc5a-b6fb9ffc4407"},"dct:conformsTo":{"@id":"https://data.tomelilla.se/rowstore/dataset/1b27b61c-1201-45e4-bc5a-b6fb9ffc4407/swagger"},"dct:format":{"@id":"http://publicat