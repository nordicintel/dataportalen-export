@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001439"},"dct:spatial":{"@id":"https://sws.geonames.org/2726973"},"dct:temporal":{"@id":"_:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca_b4n0"},"dct:title":[{"@language":"en","@value":"Public spending 2024 and beyond"},{"@language":"sv","@value":"Leverantörsreskontra 2024 och framåt"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest","@type":"dct:Standard","dcat:contactPoint":[{"@id":"https://editera.dataportal.se/store/87/resource/1"},{"@id":"https://editera.dataportal.se/store/87/resource/2"},{"@id":"https://editera.dataportal.se/store/87/resource/4"}],"dcat:keyword":[{"@language":"en","@value":"invoice"},{"@language":"en","@value":"purchase"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"faktura"},{"@language":"sv","@value":"inköp"},{"@language":"sv","@value":"utgift"},{"@language":"sv","@value":"verifikat"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:description":{"@language":"sv","@value":"Information om gjorda inköp med belopp, köpare- och leverantörsinformation"},"dct:issued":[{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2020-10-08"},{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2021-03-23"}],"dct:modified":{"@type":"http://www.w3.org/2001/XMLSchema.xsd#date","@value":"2021-03-25"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/238/leverant%C3%B6rsreskontra-som-%C3%B6ppna-data-hur-du-publicerar?_=1694522571624"},{"@id":"https://gitlab.com/lankadedata/spec/levreskontra"},{"@id":"https://lankadedata.se/spec/levreskontra/"},{"@id":"https://lankadedata.se/spec/levreskontra/schema.json"},{"@id":"https://www.dataportal.se/terminology/leverantorsreskontra_grund"}],"http://www.w3.org/ns/dx/prof/hasToken":"leverantorsreskontra"},{"@id":"https://editera.dataportal.se/store/87/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Mattias Axell","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca_b5n0"},{"@id":"_:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca_b6n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mattias@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/2","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Eric Hjelmestam","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca_b7n0"},{"@id":"_:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca_b8n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:eric@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Matthias Palmér","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matthias@metasolutions.se"}},{"@id":"https://lankadedata.se/spec/levreskontra/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Leverantörsreskontra"}}],"@id":"urn:source:8f4807c72c16f626b9f4ce439db5641e405c5c22d66365b2226872d139901bca"},{"@graph":[{"@id":"_:c4fe4ee8864c2443404c304538c99296d0946c8817c028679bd20307da59e61c_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46303703090"}},{"@id":"http://dataportal.se/organisation/SE2120001439","@type":"foaf:Agent","dct:identifier":"2120001439","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:kommun@ale.se"},"foaf:name":{"@language":"sv","@value":"Ale kommun"},"foaf:page":{"@id":"https://www.ale.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.ale.se/store/1/resource/1"}},{"@id":"https://catalog.ale.se/store/1/resource/15","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://ale.se/4.abd359f1271abbcc4580006319/12.5a22ea6e159ef7824b97108.portlet?state=rss&sv.contenttype=text/xml;charset=UTF-8"},"dct:description":{"@language":"sv","@value":"RSS står för \"Rich document format Site Summary\" och är ett standardformat för att leverera digitala nyhetspubliceringar. Med särskild programvara kan man prenumerera på ett eller flera RSS-flöden och på så sätt få notifieringar när exempelvis en webbplats uppdateras. Stöd för RSS finns idag inbyggt i många moderna webbläsare men det finns också fristående program som går att ladda ner, både i gratis- och betalversioner."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:issued":{"@type":"xsd:date","@value":"2020-11-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://c