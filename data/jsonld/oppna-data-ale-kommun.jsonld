6e0d9d-edfc-4da3-85ee-a7a575881523/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2024-02-16T10:31:16.225Z"},"dct:source":{"@id":"https://catalog.ale.se/store/1/resource/82"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.ale.se/rowstore/dataset/ff6e0d9d-edfc-4da3-85ee-a7a575881523/swagger"}},{"@id":"https://catalog.ale.se/store/1/resource/111","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Ale levres 2023 01-08_5.csv"},{"@id":"https://catalog.ale.se/store/1/resource/49","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ale kommun","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:26aa11daa3bb5f376b2257dd414beb5b77914ed2f0bd6d616d0ebe0f4987c17e_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kommun@ale.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:26aa11daa3bb5f376b2257dd414beb5b77914ed2f0bd6d616d0ebe0f4987c17e_b1n0"}},{"@id":"https://catalog.ale.se/store/1/resource/71","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Ekonomiavdelningen","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:26aa11daa3bb5f376b2257dd414beb5b77914ed2f0bd6d616d0ebe0f4987c17e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:ekonomi@ale.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:26aa11daa3bb5f376b2257dd414beb5b77914ed2f0bd6d616d0ebe0f4987c17e_b3n0"}},{"@id":"https://catalog.ale.se/store/1/resource/80","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://catalog.ale.se/store/1/resource/49"},{"@id":"https://catalog.ale.se/store/1/resource/71"}],"dcat:distribution":[{"@id":"https://catalog.ale.se/store/1/resource/106"},{"@id":"https://catalog.ale.se/store/1/resource/82"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001439"},"dct:spatial":{"@id":"https://sws.geonames.org/2726973"},"dct:temporal":{"@id":"_:26aa11daa3bb5f376b2257dd414beb5b77914ed2f0bd6d616d0ebe0f4987c17e_b4n0"},"dct:title":[{"@language":"en","@value":"Public spending 2023"},{"@language":"sv","@value":"Leverantörsreskontra 2023"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.ale.se/store/1/resource/82","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://catalog.ale.se/store/1/resource/100"},{"@id":"https://catalog.ale.se/store/1/resource/101"},{"@id":"https://catalog.ale.se/store/1/resource/102"},{"@id":"https://catalog.ale.se/store/1/resource/103"},{"@id":"https://catalog.ale.se/store/