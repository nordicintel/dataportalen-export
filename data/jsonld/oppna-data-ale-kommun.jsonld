actPoint":{"@id":"https://catalog.ale.se/store/1/resource/49"},"dcat:distribution":{"@id":"https://catalog.ale.se/store/1/resource/58"},"dcat:keyword":[{"@language":"en","@value":"Business and Trade"},{"@language":"en","@value":"Community building and society"},{"@language":"en","@value":"Comparison"},{"@language":"en","@value":"Culture"},{"@language":"en","@value":"Disability"},{"@language":"en","@value":"Economy"},{"@language":"en","@value":"Elderly care"},{"@language":"en","@value":"Elementary school"},{"@language":"en","@value":"Equality"},{"@language":"en","@value":"Family care"},{"@language":"en","@value":"High school"},{"@language":"en","@value":"Human rights"},{"@language":"en","@value":"Integration"},{"@language":"en","@value":"KPI costs"},{"@language":"en","@value":"Leisure"},{"@language":"en","@value":"Preschool"},{"@language":"en","@value":"Revision"},{"@language":"en","@value":"Social services"},{"@language":"en","@value":"Staff"},{"@language":"en","@value":"quality"},{"@language":"sv","@value":"Agenda 2030"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Jämförelsedata för självrapporterad jämförelsetal från SKR och Sveriges kommuner och Regioner. Datamängden beskriver jämförelsedata i form av nyckeltal från Gullspångs kommun.\n\nHär finner du information om Folkmängd, Grundskola, Hållbar utveckling, IFO mfl. Mer information om Kolada hittar du på www.kolada.se\n\nKommun- och landstingsdatabasen Kolada innehåller jämförbara nyckeltal om alla Sveriges kommuner och landsting. Dessa nyckeltal bygger på data från ett stort antal myndigheter och organisationer, t.ex. SCB, SKL, Valmyndigheten, Bolagsverket, Skolverket, Socialstyrelsen och BRÅ, och täcker allt från demografi till hur mycket olika tjänster kostar.\n\nPå översiktssidan för Kolada-rapporterad data i distirbutionen, visas för varje nyckeltal dels en graf över hur det har utvecklats under de år som Kolada har data för, dels en beskrivning av nyckeltalet och det API-anrop som används för att hämta data från Kolada.\n\nDu kan använda sammanställningssidan för att få en snabb överblick över kommunen, och vill du jämföra eller arbeta mer på djupet med nyckeltalen rekommenderar vi dig att besöka Koladas webbplats där flera verktyg för jämförelser finns, samt dokumentation för de API som finns till systemet."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001439"},"dct:title":{"@language":"sv","@value":"Kolada, jämförelsedata kommun och region från SKR"}},{"@id":"https://catalog.ale.se/store/1/resource/58","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.kolada.se/verktyg/jamforaren/?focus=16680&report=130255"},"dct:description":{"@language":"sv","@value":"Länk till webbsida på kommunens webbplats där sammanställningssida över Kolada-data med grafisk presentation och exempelslagning mot API redovisas."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:title":{"@language":"sv","@value":"Länk till samlade data från Kolada, Ale kommun"}}],"@id":"urn:source:3aea6472cac9c88f2046a270a9c416cdc79952cc27504b380b06d334bc15e4aa"},{"@graph":[{"@id":"_:55aba783afbd91d258de68e283620b85e8ea239ce0782d7d0ed62906e7aa345a_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.953245534473764 58.096338387122984,12.266694383713634 58.096338387122984,12.266694383713634 57.804186819913724,11.953245534473764 57.804186819913724,11.953245534473764 58.096338387122984))"}},{"@id":"_:55aba783afbd91d258de68e283620b85e8ea239ce0782d7d0ed62906e7aa345a_b1n0","@type":"dct:PeriodOfTime","dca