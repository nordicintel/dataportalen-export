le","dct:format":"text/csv","dct:title":"KIR-data.csv"},{"@id":"https://catalog.ale.se/store/1/resource/41","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.ale.se/store/1/resource/40"},"dcat:downloadURL":{"@id":"https://catalog.ale.se/store/1/resource/40"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-05-07T10:19:15+02:00"}},{"@id":"https://catalog.ale.se/store/1/resource/46","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.ale.se/rowstore/dataset/7890b4d7-79be-41f2-acf1-c4894fb00804"},"dct:conformsTo":{"@id":"https://catalog.ale.se/rowstore/dataset/7890b4d7-79be-41f2-acf1-c4894fb00804/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-05-07T10:19:31+02:00"},"dct:source":{"@id":"https://catalog.ale.se/store/1/resource/41"}},{"@id":"https://catalog.ale.se/store/1/resource/47","@type":"http://entryscape.com/terms/File","dct:title":"KIR-data.xlsx"},{"@id":"https://catalog.ale.se/store/1/resource/48","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.ale.se/store/1/resource/47"},"dcat:downloadURL":{"@id":"https://catalog.ale.se/store/1/resource/47"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"}},{"@id":"https://catalog.ale.se/store/1/resource/49","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Ale kommun","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:10f8344be62a369f9f1967c9e2ce3056c09acc7a872bae05fb9a5d41c72a63b6_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kommun@ale.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:10f8344be62a369f9f1967c9e2ce3056c09acc7a872bae05fb9a5d41c72a63b6_b2n0"}}],"@id":"urn:source:10f8344be62a369f9f1967c9e2ce3056c09acc7a872bae05fb9a5d41c72a63b6"},{"@graph":[{"@id":"https://catalog.ale.se/store/1/resource/55","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://catalog.ale.se/store/1/resource/56"},"dct:description":{"@language":"sv","@value":"Skolmatsmenyer presenteras i ett webbaserat gränssnitt med RSS-funktionalitet per skola, för skolorna i kommunen. Genom att skolornas matbespisningar delar informationen till tjänsten Skolmaten.se, hamnar den i den app som utvecklats till den tjänsten. Skolmaten finns att ladda ned som app för alla mobilplattformar.\n\nMaten per skola presenteras som ett RSS-flöde och kan därför anpassas och läggas till i appar i smartphones och tablets eller andra plattformar och tjänster som stödjer RSS för att skapa en meny som presenteras i en exempelvis en kalender. På så vis kan både barn och föräldrar enkelt ta del av skolmatsedeln för sin skola på det vis de själva önskar, dag för dag.\n\nTjänsten tillhandahålls genom avtal mellan kommunen och Skolmaten.se och det är respektive skola som själva lägger ut informationen vilket borgar för hög kvalitet - informationen delas nära källan och ofta av den funktion som förestår skolbespisningen på varje skolenhet.\n\nLäs gärna mer om tjänsten \"Skolmaten\" på deras egen webb: http://www.dinskolmat.se/"},"dct:title":{"@language":"sv","@value":"Skolmatsmenyer för Ale kommuns skolor"}},{"@id":"https://catalog.ale.se/store/1/resource/56","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skolmaten.se/d/ale-kommun/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:title":{"@language":"sv","@value":"Skolmatsmenyer för Ale kommuns skolor"}}],"@id":"urn:source:24957683932ffbde1031e574705f1cca4f901ae2a7c93cffe38f76cc4d87402d"},{"@graph":[{"@id":"_:26