friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Potholes"},{"@language":"sv","@value":"Potthål"}]},{"@id":"https://catalog.gavle.se/store/1/resource/227","@type":"http://entryscape.com/terms/File","dct:title":"potthal.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/228","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/227"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"149063"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/227"},"dct:description":[{"@language":"en","@value":"A shapefile containing geografical information about potholes in Gävle Municipality. The file contains only geografical location in point geometry format without any object attributes. The coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller geografiskinformation om potthål i Gävle kommun. Filen innehåller endast geografisktläge i punkgeometri format utan några objektattribut. Koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16"},"dct:title":[{"@language":"en","@value":"Potholes (*.shp)"},{"@language":"sv","@value":"Potthål (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/229","@type":"http://entryscape.com/terms/File","dct:title":"potthal-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/230","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/229"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"46675"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/229"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing geographical information about potholes in Gävle Municipality. The file contains only point coordinates without any object attributes. The coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller geografisk information om potthål i Gävle kommun. Filen innehåller endast punktkoordinater utan några objektattribut. Koordinatsystemet är WGS84."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16"},"dct:title":[{"@language":"en","@value":"Potholes (*.json)"},{"@language":"sv","@value":"Potthål (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:50c9bdfd20d71924f17f7d6d4d4be97efc1bc3b2013ca6a75531a1866aac4bd3_b0n0"}}],"@id":"urn:source:50c9bdfd20d71924f17f7d6d4d4be97efc1bc3b2013ca6a75531a1866aac4bd3"},{"@graph":[{"@id":"_:50daff01cb938fc7fb93b6416b0991a04dca4bc5783144876993e091c117567b_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Innehållet i baskartans datamängder kommer ursprungligen från olika källor. Exempelvis Lantmäteriets fastighetskarta, fotogrammetisk digitalisering, traditionell inmätning med GNSS eller totalstation. Noggrannhet och aktualitet kan variera kraftigt beroende på insamlingsmetod och insamlingstillfälle. Det bör tas i beaktande vid användning av data."}},{"@id":"_:50daff01cb938fc7fb93b6416b0991a04dca4bc5783144876993e091c117567b_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/269","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Kartdeklaration Gävle kommuns baskarta"}},{"@id":"https://catalog.gavle.se/store/1/resource/502","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-vatten-gpkg.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/503","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/502"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"16807923"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/502"},"dct:description":[{"@language":"en","@value":"One geopackage containing water polygons, shorelines and water related objects. The spatial reference is SWEREF 99 16 30. Water and shorelines contains the attributes date of last update and file date. Water related objects also has a type attribute."},{"@language":"sv","@value":"En geopackage som innehåller vattenytor, strandlinjer och vattenobjekt. Koordinatsystemet är SWEREF 99 16 30. Vatten och strandlinjer innehåller attributen uppdateringsdatum och fildatum medan vattenobjekten även har attributet typ."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Water (*.gpkg)"},{"@language":"sv","@value":"Vatten (*.gpkg)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/62","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/503"},{"@id":"https://catalog.gavle.se/store/1/resource/67"},{"@id":"https://catalog.gavle.se/store/1/resource/93"}],"dcat:keyword":[{"@language":"en","@value":"Bridge"},{"@language":"en","@value":"Pier"},{"@language":"en","@value":"Pool"},{"@language":"en","@value":"Public water"},{"@language":"en","@value":"Reservoir"},{"@language":"en","@value":"Shoreline"},{"@language":"en","@value":"Stream direction"},{"@language":"en","@value":"Trench"},{"@language":"en","@value":"Water"},{"@language":"sv","@value":"Allmänt vatten"},{"@language":"sv","@value":"Bassäng"},{"@language":"sv","@value":"Bro"},{"@language":"sv","@value":"Brygga"},{"@language":"sv","@value":"Dike"},{"@language":"sv","@value":"Kaj"},{"@language":"sv","@value":"Strandlinje"},{"@language":"sv","@value":"Strömriktning"},{"@language":"sv","@value":"Vatten"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Water, shorelines and water related objects from Gävles basemap. \n\nThe basemap provided by us is constructed in an accurate, timeless way, it is tailored from set specifics. We strive to have correct information, but we cannot guarantee it in all regard. \n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Vatten, strandlinjer och vattenrelaterade objekt från Gävles baskarta. \n\nGävle kommun upplyser om att baskartans innehåll med avseende på noggrannhet och aktualitet överensstämmer med fastställda specifikationer och beskrivningar. Gävle kommun strävar efter att informationen skall vara så riktig som möjligt men kan inte garantera det i alla avseenden.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till kunden. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för kunden till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:50daff01cb938fc7fb93b6416b0991a04dca4bc5783144876993e091c117567b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Basemap - Water"},{"@language":"sv","@value":"Baskarta - Vatten"}],"foaf:page":{"@id":"https://catalog.gavle.se/store/1/resource/269"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:50daff01cb938fc7fb93b6416b0991a04dca4bc5783144876993e091c117567b_b1n0"}},{"@id":"https://catalog.gavle.se/store/1/resource/66","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-vatten.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/66"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"16083629"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/66"},"dct:description":[{"@language":"en","@value":"Five shapefiles containing water polygons, shorelines and water related objects. The spatial reference is SWEREF 99 16 30. Water and shorelines contains the attributes date of last update and file date. Water related objects also has a type attribute."},{"@language":"sv","@value":"Fem shapefiler som innehåller vattenytor, strandlinjer och vattenobjekt. Koordinatsystemet är SWEREF 99 16 30. Vatten och strandlinjer innehåller attributen uppdateringsdatum och fildatum medan vattenobjekten även har attributet typ."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Water (*.shp)"},{"@language":"sv","@value":"Vatten (*.shp)"}]},{"@id":"https://catalog.gavle.se/store/1/resource/92","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-vatten-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/93","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/92"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2327790"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/92"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"Five geojson files containing water polygons, shorelines and water related objects. The spatial reference is WGS84. Water and shorelines contains the attributes date of last update and file date. Water related objects also has a type attribute."},{"@language":"sv","@value":"Fem geojson-filer som innehåller vattenytor, strandlinjer och vattenobjekt. Koordinatsystemet är WGS84. Vatten och strandlinjer innehåller attributen uppdateringsdatum och fildatum medan vattenobjekten även har attributet typ."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Water (*.json)"},{"@language":"sv","@value":"Vatten (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:50daff01cb938fc7fb93b6416b0991a04dca4bc5783144876993e091c117567b"},{"@graph":[{"@id":"_:51f3090b10bc871a2d10977085caeecbf37556c79dfb763f50d768a4a73c7458_b0n0","@type":"dct:ProvenanceStatement","dct:description":[{"@language":"en","@value":"The data set includes an aggregation of parking places as points and zones as polygons."},{"@language":"sv","@value":"Datamängden omfattar en aggregation av alla typer parkeringar som punkter och parkeringszoner som ytor."}]},{"@id":"_:51f3090b10bc871a2d10977085caeecbf37556c79dfb763f50d768a4a73c7458_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/112","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/114"},{"@id":"https://catalog.gavle.se/store/1/resource/116"}],"dcat:keyword":[{"@language":"en","@value":"bus"},{"@language":"en","@value":"commuter parking"},{"@language":"en","@value":"electric car"},{"@language":"en","@value":"mobile home"},{"@language":"en","@value":"mobility impaired"},{"@language":"en","@value":"motorbike"},{"@language":"en","@value":"parking places"},{"@language":"en","@value":"parking"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"elbil"},{"@language":"sv","@value":"husbil"},{"@language":"sv","@value":"mc"},{"@language":"sv","@value":"parkering"},{"@language":"sv","@value":"parkeringsplatser"},{"@language":"sv","@value":"pendlarparkering"},{"@language":"sv","@value":"rörelsehindrad"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Parking places and parking zones in Gävle Municipality. Update frequency: monthly, by Trafik och tillstånd, Gävle. Parking information is used in several maps in Gävle.\n\nParking prohibited zone: inside this zone - marked with signposts -  parking is prohibited if no other signs says otherwise. Parking prohibited zone applies the whole year within the whole zone. \n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Parkeringsplatser och parkeringszoner i Gävle kommun.\nUppdateras en gång i månaden av Trafik och tillstånd, Gävle kommun.  Ingår i Gävle kommuns olika kartor med parkeringar och parkerings-/avgiftszoner.\n \nParkeringsförbudszon innebär att om man kör förbi en zontavla i ett område är det förbjudet att parkera om det inte finns vägmärken som anger annat. Om det finns en P-skylt inom p-förbudzon så får du parkera där och det kan vara avgiftsfritt eller betalning. P-förbudzon gäller tills du passerar ett vägmärke som anger att zonen upphör. Förbudet gäller hela året.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:provenance":{"@id":"_:51f3090b10bc871a2d10977085caeecbf37556c79dfb763f50d768a4a73c7458_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Parking"},{"@language":"sv","@value":"Parkeringar"}]},{"@id":"https://catalog.gavle.se/store/1/resource/113","@type":"http://entryscape.com/terms/File","dct:title":"Parkeringar.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/114","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/113"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"17710"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/113"},"dct:description":[{"@language":"en","@value":"Two shapefiles containing parking places and parking zones.\n\nAttribute data parking places - PARKERING_P:\n- Typ: Rörelsehindrad (mobility impaired) , Pendlarparkering (commuter parking), Husbil (mobile home), Elbil (electric car), MC (motorbike), Buss (bus)\n- Antplatser: Number om parkingplaces ( husbil, elbil, mc, buss)\n- Foreskrift: Trafikföreskriftsnummer (applies to mobility imparied)\n- Gatunamn: Name of road (applies to mobility imparied)\n- Fordonstyp: Bil (car), Bil och cykel (car and bike) (applies to commuter parking)\n- Upddat: Date updated\n\nAttribute data parking zones - PARKERING_A:\n- Typ: P-avgiftzon (parking zone), P-förbudzon (parking inhibition zone)\n- Zontyp: Vit (white), blå (blue), gul (yellow), röd (red) (applies to P-avgiftzon), förbud (inhibition) - (applies to P-förbudzon)\n- Taxa:  Parking rate (applies to P-avgiftzon)\n- Fran_datum:  From date (applies to P-förbudzon)\n- Till_datum: To date (applies to P-förbudzon)\n- Upddat: Date updated\n\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"Två shapefiler med parkeringsplatser och parkeringszoner. \n\nAttributdata parkeringsplatser - PARKERING_P:\n- Typ: Rörelsehindrad, Pendlarparkering, Husbil, Elbil, MC, Buss\n- Antplatser: Antal parkeringsplatser (gäller husbil, elbil, mc, buss)\n- Foreskrift: Trafikföreskriftsnummer (gäller rörelsehindrad)\n- Gatunamn: (gäller rörelsehindrad)\n- Fordonstyp: Bil, Bil och cykel (gäller pendlarparkeringar).\n- Upddat: Uppdateringsdatum\n\nAttributdata parkeringszoner - PARKERING_A:\n- Typ: P-avgiftzon, P-förbudzon\n- Zontyp: Vit, blå, gul, röd (gäller P-avgiftzon), förbud (gäller P-förbudzon)\n- Taxa: (gäller P-avgiftzon)\n- Fran_datum: (gäller P-förbudzon)\n- Till_datum: (gäller P-förbudzon)\n- Upddat: Uppdateringsdatum\n\nFilernas koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-05"},"dct:title":[{"@language":"en","@value":"Parking (*.shp)"},{"@language":"sv","@value":"Parkeringar (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/115","@type":"http://entryscape.com/terms/File","dct:title":"Parkeringar-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/116","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/115"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"5823"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/115"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"Parking places and parking zones.\n\nAttribute data parking places - Parkering_L:\n- Typ: Rörelsehindrad (mobility impaired) , Pendlarparkering (commuter parking), Husbil (mobile home), Elbil (electric car), MC (motorbike), Buss (bus)\n- Antplatser: Number om parkingplaces ( husbil, elbil, mc, buss)\n- Foreskrift: Trafikföreskriftsnummer (applies to mobility imparied)\n- Gatunamn: Name of road (applies to mobility imparied)\n- Fordonstyp: Bil (car), Bil och cykel (car and bike) (applies to commuter parking)\n\nAttribute data parking zones - Parkering_A:\n- Typ: P-avgiftzon (parking zone), P-förbudzon (parking inhibition zone)\n- Zontyp: Vit (white), blå (blue), gul (yellow), röd (red) (applies to P-avgiftzon), förbud (inhibition) - (applies to P-förbudzon)\n- Taxa:  Parking rate (applies to P-avgiftzon)\n- Fran_datum:  From date (applies to P-förbudzon)\n- Till_datum: To date (applies to P-förbudzon)\n\nThe coordinate system is WGS84."},{"@language":"sv","@value":"Parkeringsplatser och parkeringszoner. \n\nAttributdata parkeringsplatser - Parkering_L:\n- Typ: Rörelsehindrad, Pendlarparkering, Husbil, Elbil, MC, Buss\n- Antplatser: Antal parkeringsplatser (gäller husbil, elbil, mc, buss)\n- Foreskrift: Trafikföreskriftsnummer (gäller rörelsehindrad)\n- Gatunamn: (gäller rörelsehindrad)\n- Fordonstyp: Bil, Bil och cykel (gäller pendlarparkeringar)\n\nAttributdata parkeringszoner - Parkering_A:\n- Typ: P-avgiftzon, P-förbudzon\n- Zontyp: Vit, blå, gul, röd (gäller P-avgiftzon), förbud (gäller P-förbudzon)\n- Taxa: (gäller P-avgiftzon)\n- Fran_datum: (gäller P-förbudzon)\n- Till_datum: (gäller P-förbudzon)\n\nFilernas koordinatsystemet är WGS84."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-05"},"dct:title":[{"@language":"en","@value":"Parking (*.json)"},{"@language":"sv","@value":"Parkeringar (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:51f3090b10bc871a2d10977085caeecbf37556c79dfb763f50d768a4a73c7458_b1n0"}}],"@id":"urn:source:51f3090b10bc871a2d10977085caeecbf37556c79dfb763f50d768a4a73c7458"},{"@graph":[{"@id":"_:52ad0fa8552feb961778f7e33da97f882379fd6b866dfc72cb7ef5f1ee6fe069_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/475","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/477"},{"@id":"https://catalog.gavle.se/store/1/resource/479"}],"dcat:keyword":[{"@language":"en","@value":"Graffitti cleaning"},{"@language":"en","@value":"Graffitti removal"},{"@language":"en","@value":"Graffitti"},{"@language":"sv","@value":"Graffiti"},{"@language":"sv","@value":"Klotter"},{"@language":"sv","@value":"Klottersanering"},{"@language":"sv","@value":"Sanering"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"en","@value":"The dataset shows where graffitti removal has been carried out on public sites in Gävle Municipality.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Datamängden redovisar var någonstans klottersanering på allmän platsmark i Gävle kommun har utförts.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Graffiti removal"},{"@language":"sv","@value":"Klottersanering"}]},{"@id":"https://catalog.gavle.se/store/1/resource/476","@type":"http://entryscape.com/terms/File","dct:title":"klottersanering.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/477","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/476"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"59608"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/476"},"dct:description":[{"@language":"en","@value":"Shapefil containing places on public sites in Gävle Municipality where graffitti removal has been carried out.\nAttribute data:\nOBJEKTID - Object id\nOBJEKTTYP - Object type\nCoordinate system SWEREF 99 16 30.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Shapefil som innehåller platser för utförd klottersanering på allmän platsmark i Gävle kommun.\nAttributdata:\nOBJEKTID \nOBJEKTTYP\nKoordinatsystemet är SWEREF 99 16 30.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16"},"dct:title":[{"@language":"en","@value":"Graffitti removal (*.shp)"},{"@language":"sv","@value":"Klottersanering (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/478","@type":"http://entryscape.com/terms/File","dct:title":"klottersanering-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/479","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/478"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"27003"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/478"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"GEOJson-file containing places on public sites in Gävle Municipality where graffitti removal has been carried out.\nAttribute data:\nOBJEKTID - Object id\nOBJEKTTYP - Object type\nCoordinate system WGS84\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"GEOJson-fil som innehåller platser för utförd klottersanering på allmän platsmark i Gävle kommun. \nAttributdata: \nOBJEKTID  \nOBJEKTTYP \nKoordinatsystemet är WGS84.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-16"},"dct:title":[{"@language":"en","@value":"Graffitti removal (*.json)"},{"@language":"sv","@value":"Klottersanering (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:52ad0fa8552feb961778f7e33da97f882379fd6b866dfc72cb7ef5f1ee6fe069_b0n0"}}],"@id":"urn:source:52ad0fa8552feb961778f7e33da97f882379fd6b866dfc72cb7ef5f1ee6fe069"},{"@graph":[{"@id":"_:5a154267ebe20ee128db1bed5515da619b71da03a61653aa3b5dbf83f8523241_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/484","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":{"@id":"https://catalog.gavle.se/store/1/resource/486"},"dcat:keyword":[{"@language":"en","@value":"downloads"},{"@language":"en","@value":"statistics"},{"@language":"sv","@value":"nedladdningar"},{"@language":"sv","@value":"statistik"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Download statistics for datasets published by the municipality of Gävle as open data. Also includes statistics for number of requests to WMS services that are published as open data.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Statistik om antal nedladdningar av datamängder som Gävle kommun publicerat som öppna data. Inkluderat är också statistik om antal anrop mot WMS-tjänster som är publicerade som öppna data.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:issued":{"@type":"xsd:date","@value":"2022-07-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Download statistics for datasets"},{"@language":"sv","@value":"Statistik datamängder"}]},{"@id":"https://catalog.gavle.se/store/1/resource/485","@type":"http://entryscape.com/terms/File","dct:title":"statistik-csv.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/486","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/485"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3555"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/485"},"dcat:mediaType":"text/csv+zip","dct:description":[{"@language":"en","@value":"Two CSV files, one containing statistics for datasets published in a file format, and one for datasets published as WMS services.\n\nThe file statistik_filformat.csv contains information about the number of downloads for the file formats geojson, shape and CSV. Attribute data:\nDataset-ID (unique ID for the dataset)\nDataset (the dataset's name)\nGeoJSON (number of downloads in the geojson format)\nShapefile (number of downloads in the shape format)\nCSV (number of downloads in the CSV format)\nDate from (from which date downloads are counted)\nDate to (to which date downloads are counted)\nTotal (The sum of geojson, shape and CSV downloads)\n\nThe file statistik_wms.csv contains information about the number of requests that have been made to WMS services. Attribute data:\nWMS-ID (unique ID for the dataset)\nDataset (WMS) (the dataset's name)\nDate from (from which date requests are counted)\nDate to (to which date requests are counted)\nTotal (totalt number of requests)"},{"@language":"sv","@value":"Två stycken CSV-filer, en med statistik för datamängder i filformat, och en för de som är publicerade som WMS-tjänster.\n\nFilen statistik_filformat.csv innehåller information om antal nedladdningar för formaten geojson, shape och CSV. Attributdata:\nDataset-ID (unikt ID för datamängden)\nDataset (namn på datamängden)\nGeoJSON (antal nedladdningar i geojson-format)\nShapefile (antal nedladdningar i shape-format)\nCSV (antal nedladdningar i CSV-format)\nDate from (från vilket datum nedladdningar är räknade)\nDate to (till vilket datum nedladdningar är räknade)\nTotal (summan av geojson, shape och CSV nedladdningar)\n\nFilen statistik_wms.csv innehåller information om antal anrop mot WMS-tjänster. Attributdata:\nWMS-ID (unikt ID för datamängden)\nDataset (WMS) (namn på datamängden)\nDate from (från vilket datum anrop är räknade)\nDate to (till vilket datum anrop är räknade)\nTotal (totalt antal anrop)"}],"dct:issued":{"@type":"xsd:date","@value":"2022-07-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-03"},"dct:title":[{"@language":"en","@value":"Statistics datasets (*.csv)"},{"@language":"sv","@value":"Statistik datamängder (*.csv)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5a154267ebe20ee128db1bed5515da619b71da03a61653aa3b5dbf83f8523241_b0n0"}}],"@id":"urn:source:5a154267ebe20ee128db1bed5515da619b71da03a61653aa3b5dbf83f8523241"},{"@graph":[{"@id":"_:5b0b47e166423e3c6bea0613f5a2c1c2a1079557971f310788804cda543340ed_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2020-11-17"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-11-17"}},{"@id":"_:5b0b47e166423e3c6bea0613f5a2c1c2a1079557971f310788804cda543340ed_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/450","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/452"},{"@id":"https://catalog.gavle.se/store/1/resource/454"}],"dcat:keyword":[{"@language":"en","@value":"Leaf removal"},{"@language":"en","@value":"Sand removal"},{"@language":"en","@value":"Street sweeping"},{"@language":"en","@value":"Street"},{"@language":"en","@value":"Town square"},{"@language":"en","@value":"car"},{"@language":"sv","@value":"Bil"},{"@language":"sv","@value":"Gatusopning"},{"@language":"sv","@value":"Lövupptagning"},{"@language":"sv","@value":"Sandupptagning"},{"@language":"sv","@value":"Torg"},{"@language":"sv","@value":"Väg"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Information about where street sweeping has been done within Gävle municipality. \n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Gatusopning visar information kring delar av Gävle kommun där gatusopning utförts på olika typer av vägar.  \n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:issued":{"@type":"xsd:date","@value":"2020-11-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-11-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:temporal":{"@id":"_:5b0b47e166423e3c6bea0613f5a2c1c2a1079557971f310788804cda543340ed_b0n0"},"dct:title":[{"@language":"en","@value":"Street sweeping"},{"@language":"sv","@value":"Gatusopning"}]},{"@id":"https://catalog.gavle.se/store/1/resource/451","@type":"http://entryscape.com/terms/File","dct:title":"gatusopning.z