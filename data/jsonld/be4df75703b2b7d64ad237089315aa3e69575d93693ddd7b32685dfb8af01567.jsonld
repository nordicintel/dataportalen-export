{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:02f40fa66af583f42d4397342cc29df970b20f4c3d12d7cdc33e2b50cefcb19b_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/182","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/184"},{"@id":"https://catalog.gavle.se/store/1/resource/186"}],"dcat:keyword":[{"@language":"en","@value":"Bicycle paths"},{"@language":"en","@value":"Road maintenance"},{"@language":"en","@value":"Roads"},{"@language":"en","@value":"Snow removal"},{"@language":"en","@value":"Walkways"},{"@language":"en","@value":"Winter road maintenance"},{"@language":"en","@value":"Winter sanding"},{"@language":"sv","@value":"Cykelvägar"},{"@language":"sv","@value":"Gångvägar"},{"@language":"sv","@value":"Sandning"},{"@language":"sv","@value":"Snöröjning"},{"@language":"sv","@value":"Vinterväghållning"},{"@language":"sv","@value":"Vägar"},{"@language":"sv","@value":"Väghållning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":[{"@language":"en","@value":"Winter road maintenance in Gävle Municipality. The dataset consists only of roads, bicycle paths and walkways where Gävle Municipality performs winter road maintenance.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Vinterväghållning inom Gävle kommun. Datamängden innehåller endast vägar, cykelvägar och gångvägar där Gävle kommun ombesörjer vinterväghållningen.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-04-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Winter road maintenance"},{"@language":"sv","@value":"Vinterväghållning"}]},{"@id":"https://catalog.gavle.se/store/1/resource/183","@type":"http://entryscape.com/terms/File","dct:title":"vintervaghallning.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/184","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/183"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"668088"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/183"},"dct:description":[{"@language":"en","@value":"A shapefile containing roads in Gävle Municipality, where the municipality performs winter road maintenance. Attribute data:\nVAGTYP (Road type contains Bil (car), GC (bicycle paths) or G (walkways))\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller vinterväghållning inom Gävle kommun, där kommunen ombesörjer detta. Attributdata:\nVAGTYP (Bil, GC=cykelväg, G=gångväg)\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-12"},"dct:title":[{"@language":"en","@value":"Winter road maintenance (*.shp)"},{"@language":"sv","@value":"Vinterväghållning (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/185","@type":"http://entryscape.com/terms/File","dct:title":"vintervaghallning-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/186","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/185"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"186678"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/185"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing roads in Gävle Municipality, where the municipality performs winter road maintenance. Attribute data:\nVAGTYP (Road type contains Bil (car), GC (bicycle paths) or G (walkways))\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller vinterväghållning inom Gävle kommun, där kommunen ombesörjer detta. Attributdata:\nVAGTYP (Bil, GC=cykelväg eller G=gångväg)\nKoordinatsystemet är WGS84."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-12"},"dct:title":[{"@language":"en","@value":"Winter road maintenance (*.json)"},{"@language":"sv","@value":"Vinterväghållning (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:02f40fa66af583f42d4397342cc29df970b20f4c3d12d7cdc33e2b50cefcb19b_b0n0"}}],"@id":"urn:source:02f40fa66af583f42d4397342cc29df970b20f4c3d12d7cdc33e2b50cefcb19b"},{"@graph":[{"@id":"_:050acad6138631de59d2a603e469775673f59e441906fde5c9429308e9e91dcf_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Uppdateringar hämtas dagligen från Registerkartan hos Lantmäteriet till Gävles lokala databas."}},{"@id":"_:050acad6138631de59d2a603e469775673f59e441906fde5c9429308e9e91dcf_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/269","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Kartdeklaration Gävle kommuns baskarta"}},{"@id":"https://catalog.gavle.se/store/1/resource/50","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/501"},{"@id":"https://catalog.gavle.se/store/1/resource/52"},{"@id":"https://catalog.gavle.se/store/1/resource/87"}],"dcat:keyword":[{"@language":"sv","@value":"3D"},{"@language":"sv","@value":"3D-fastighet"},{"@language":"sv","@value":"3D-utrymme"},{"@language":"sv","@value":"Baskarta"},{"@language":"sv","@value":"Fastighet"},{"@language":"sv","@value":"Fastighetsgräns"},{"@language":"sv","@value":"Fastighetskarta"},{"@language":"sv","@value":"Gränspunkt"},{"@language":"sv","@value":"Kommungräns"},{"@language":"sv","@value":"Oregistrerad"},{"@language":"sv","@value":"Outredd"},{"@language":"sv","@value":"Samfällighet"},{"@language":"sv","@value":"Trakt"},{"@language":"sv","@value":"Traktgräns"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":[{"@language":"en","@value":"Includes division into property units in the municipality of Gävle. Contains boundary points and parcels for property units, regions and municipality. The parcels also includes joint property units and three-dimensional property units. \n\nBoundaries and coordinates shown in the map have large differences in quality. \n\nN.B. boundaries and coordinates have no legal validation.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Innehåller Gävle kommuns fastighetsindelning, bestående av gränspunkter samt ytor för fastigheter, trakter och kommungräns. Fastigheter innefattar även ytor för samfälligheter, oregistrerade områden och 3D-utrymmen.\n\nGränserna som redovisas i kartan har stora variationer i lägesnoggrannhet. Lägst kvalitet förekommer normalt på landsbygden, vilket beror på att fastighetsgränserna ofta har digitaliserats från analoga kartor i skala 1:10 000. Om fastighetsindelningen ska användas som underlag för användning som kräver hög aktualitet och lägesnoggrannhet rekommenderas att ta kontakt med Lantmäterimyndigheten i Gävle kommun för att få tillgång till förrättningskartor med mera.\n\nFastighetsindelningen uppdateras av lantmäterimyndigheten i Gävle kommun i samband med fastighetsbildning och kvalitetsförbättrande åtgärder. \n\nOBS! Gränser och koordinater som redovisas i kartan är inte juridiskt gällande. \n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information. "}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:050acad6138631de59d2a603e469775673f59e441906fde5c9429308e9e91dcf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:spatial":{"@id":"http://sws.geonames.org/2712409"},"dct:title":[{"@language":"en","@value":"Basemap - Real properties"},{"@language":"sv","@value":"Baskarta - Fastigheter"}],"foaf:page":{"@id":"https://catalog.gavle.se/store/1/resource/269"}},{"@id":"https://catalog.gavle.se/store/1/resource/500","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-fastigheter-gpkg.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/501","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/500"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"14720297"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/500"},"dct:description":[{"@language":"en","@value":"The information includes the division into property units in the municipality of Gävle and includes one geopackage. Three files contains parcels for property units, regions and municipality. The parcels also includes joint property units and three-dimensional property units. One file contains boundary points. \n\nThe coordinate system is SWEREF 99 16 30 for all files. \n\nN.B. boundaries and coordinates have no legal validation."},{"@language":"sv","@value":"Informationen innehåller Gävle kommuns fastighetsindelning och består av en geopackage-fil. Tre lager innehåller ytor för fastigheter, trakter och kommun. Ett lager innehåller gränspunkter. \n\nFastigheter innehåller ytor för fastigheter, samfälligheter, oregistrerade områden och 3D-utrymmen. Attribut för ytorna är fastighetsbeteckning, fastighetstyp, områdesnummer, trakt, uppdateringsdatum, fildatum och FNR/UUID från Fastighetsregistret. Inom Gävle kommun finns outredda äldre samfälligheter som saknar eller har ofullständig geometri.  \n\nTrakter innehåller ytor för trakt med attributen traktnamn, uppdateringsdatum och fildatum.\n\nKommun innehåller en yta för hela Gävle kommun med attributen fildatum och uppdateringsdatum.\n\nGränspunkter innehåller attributen mätmetod, medelfel i plan, markeringstyp, extern-Id och uppdateringsdatum. Många gränspunkter saknas i Registerkartan.\n\nKoordinatsystemet för alla filerna är SWEREF 99 16 30.\n\nOBS! Gränser och koordinater som redovisas i kartan är inte juridiskt gällande."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Real Properties(*.gpkg)"},{"@language":"sv","@value":"Fastigheter (*.gpkg)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/51","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-granser.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/51"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"12289609"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/51"},"dct:description":[{"@language":"en","@value":"The information includes the division into property units in the municipality of Gävle and includes four shapefiles. Three files contains parcels for property units, regions and municipality. The parcels also includes joint property units and three-dimensional property units. One shapefile contains boundary points. \n\nThe coordinate system is SWEREF 99 16 30 for all files. \n\nN.B. boundaries and coordinates have no legal validation."},{"@language":"sv","@value":"Informationen innehåller Gävle kommuns fastighetsindelning och består av fyra shapefiler. Tre filer innehåller ytor för fastigheter, trakter och kommun. En fil innehåller gränspunkter. \n\nFastigheter innehåller ytor för fastigheter, samfälligheter, oregistrerade områden och 3D-utrymmen. Attribut för ytorna är fastighetsbeteckning, fastighetstyp, områdesnummer, trakt, uppdateringsdatum, fildatum och FNR/UUID från Fastighetsregistret. Inom Gävle kommun finns outredda äldre samfälligheter som saknar eller har ofullständig geometri.  \n\nTrakter innehåller ytor för trakt med attributen traktnamn, uppdateringsdatum och fildatum.\n\nKommun innehåller en yta för hela Gävle kommun med attributen fildatum och uppdateringsdatum.\n\nGränspunkter innehåller attributen mätmetod, medelfel i plan, markeringstyp, extern-Id och uppdateringsdatum. Många gränspunkter saknas i Registerkartan.\n\nKoordinatsystemet för alla filerna är SWEREF 99 16 30.\n\nOBS! Gränser och koordinater som redovisas i kartan är inte juridiskt gällande."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Real Properties(*.shp)"},{"@language":"sv","@value":"Fastigheter (*.shp)"}],"foaf:page":{"@id":"https://gis.gavle.se/pubs/oppnadata/Kartdeklaration.pdf"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:050acad6138631de59d2a603e469775673f59e441906fde5c9429308e9e91dcf_b1n0"}},{"@id":"https://catalog.gavle.se/store/1/resource/86","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-fastigheter-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/87","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/86"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"4384883"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/86"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"The information includes the division into property units in the municipality of Gävle and includes four geojson files. Three files contains parcels for property units, regions and municipality. The parcels also includes joint property units and three-dimensional property units. One shapefile contains boundary points. \n\nThe coordinate system is WGS84 for all files. \n\nN.B. boundaries and coordinates have no legal validation."},{"@language":"sv","@value":"Informationen innehåller Gävle kommuns fastighetsindelning och består av fyra geojson-filer. Tre filer innehåller ytor för fastigheter, trakter och kommun. En fil innehåller gränspunkter. \n\nFastigheter innehåller ytor för fastigheter, samfälligheter, oregistrerade områden och 3D-utrymmen. Attribut för ytorna är fastighetsbeteckning, fastighetstyp, områdesnummer, trakt, uppdateringsdatum, fildatum och FNR/UUID från Fastighetsregistret. Inom Gävle kommun finns outredda äldre samfälligheter som saknar eller har ofullständig geometri.  \n\nTrakter innehåller ytor för trakt med attributen traktnamn, uppdateringsdatum och fildatum.\n\nKommun innehåller en yta för hela Gävle kommun med attributen fildatum och uppdateringsdatum.\n\nGränspunkter innehåller attributen mätmetod, medelfel i plan, markeringstyp, extern-Id och uppdateringsdatum. Många gränspunkter saknas i Registerkartan.\n\nKoordinatsystemet för alla filerna är WGS84.\n\nOBS! Gränser och koordinater som redovisas i kartan är inte juridiskt gällande."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Real Properties (*.json)"},{"@language":"sv","@value":"Fastigheter (*.json)"}]}],"@id":"urn:source:050acad6138631de59d2a603e469775673f59e441906fde5c9429308e9e91dcf"},{"@graph":[{"@id":"_:0d58e8d1a140677e1ac8ad988ac830cfeff219a26f7591100c3926bb9f70c413_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/166","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/174"},{"@id":"https://catalog.gavle.se/store/1/resource/180"}],"dcat:keyword":[{"@language":"en","@value":"Bicycle parking "},{"@language":"en","@value":"Bicycle parking places"},{"@language":"en","@value":"Bicycle"},{"@language":"en","@value":"Parking"},{"@language":"sv","@value":"Cykel"},{"@language":"sv","@value":"Cykelparkering"},{"@language":"sv","@value":"Cykelparkeringsplats"},{"@language":"sv","@value":"Parkering"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Bicycle parking places including the number of lots. The dataset consists only of bicycle parking places where Gävle Municipality performs maintenance during the snow free season.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Cykelparkeringsplatser med antal cykelplatser per parkering. Datamängden innehåller endast cykelparkeringsplatser där Gävle kommun ombesörjer barmarksrenhållning.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Bicycle parking places"},{"@language":"sv","@value":"Cykelparkeringsplatser"}]},{"@id":"https://catalog.gavle.se/store/1/resource/173","@type":"http://entryscape.com/terms/File","dct:title":"cykelparkeringsplatser.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/174","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/173"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3912"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/173"},"dct:description":[{"@language":"en","@value":"A shapefile containing bicycle parking places in Gävle Municipality, where the municipality performs maintenance during the snow free season. Attribute data:\nANTPLATSER (The number of lots per bicycle parking place.)\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller cykelparkeringsplatser inom Gävle kommun, där kommunen ombesörjer barmarksrenhållning. Attributdata:\nANTPLATSER (Antal cykelplatser per parkering.)\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-05"},"dct:title":[{"@language":"en","@value":"Bicycle parking places (*.shp)"},{"@language":"sv","@value":"Cykelparkeringsplatser (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/179","@type":"http://entryscape.com/terms/File","dct:title":"cykelparkeringsplatser-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/180","@type":"dcat:Di