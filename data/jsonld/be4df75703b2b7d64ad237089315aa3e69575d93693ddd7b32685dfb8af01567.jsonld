to:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:68ec4aebe5d2be45594789cfbf624cb5c95e6248443c028cbafb279998ea6f37_b0n0"}}],"@id":"urn:source:68ec4aebe5d2be45594789cfbf624cb5c95e6248443c028cbafb279998ea6f37"},{"@graph":[{"@id":"_:6cf778931a025ff6393533bfae9edad0cea586a13cf4f1ad5958f2a65fe1ce3f_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/376","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/378"},{"@id":"https://catalog.gavle.se/store/1/resource/380"}],"dcat:keyword":[{"@language":"en","@value":"Boundaries"},{"@language":"en","@value":"Comprehensive plan"},{"@language":"sv","@value":"Antagen"},{"@language":"sv","@value":"Gränser"},{"@language":"sv","@value":"Gällande"},{"@language":"sv","@value":"Plangränser"},{"@language":"sv","@value":"ÖP"},{"@language":"sv","@value":"Översiktsplan"}],"dcat:landingPage":{"@id":"https://www.gavle.se"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/QUARTERLY"},"dct:description":[{"@language":"en","@value":"Valid comprehensive plans in Gävle Municipality. To see all valid comprehensive plans in Gävle Municipality please visit the web page gavle.se.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Gällande översiktsplaner i Gävle kommun. \n\nLagret innehåller planområdesgränser för gällande översiktsplaner i Gävle kommun. Detta gäller kommuntäckande översiktsplan, men även fördjupningar för vissa områden eller tematiska planer. Med lagret kommer information om när översiktsplanen antogs och en hänvisning till ärendets diarienummer i Gävle kommuns arkiv. För att läsa alla gällande planer hänvisas till Gävle kommuns hemsida gavle.se.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Comprehensive plan - Boundaries"},{"@language":"sv","@value":"Översiktsplan - Plangränser"}]},{"@id":"https://catalog.gavle.se/store/1/resource/377","@type":"http://entryscape.com/terms/File","dct:title":"oversiktsplan_granser.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/378","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/377"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"19960"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/377"},"dct:description":[{"@language":"en","@value":"A shapefile containing comprehensive plan boundaries in Gävle Municipality. Attribute data:\n\nNAMN (Name of plan)\nDIARIENR (Registration number in Gävle Municipality archives)\nDOKTYP (Type of plan)\nANTAG-DAT (Adoption date)\n\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller översiktsplan - gränser i Gävle kommun. Attributdata:\n\nNAMN (Plannamn)\nDIARIENR (Diarienummer i Gävle kommuns arkiv)\nDOKTYP (Typ av plan)\nANTAG_DAT (Antagandedatum)\n\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2020-04-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:title":[{"@language":"en","@value":"Comprehensive plan - Boundaries (*shp)"},{"@language":"sv","@value":"Översiktsplan - Gränser (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/379","@type":"http://entryscape.com/terms/File","dct:title":"oversiktsplan_granser-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/380","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/379"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7980"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/379"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing comprehensive plan boundaries in Gävle Municipality. Attribute data:\n\nNAMN (Name of plan)\nDIARIENR (Registration number in Gävle Municipality archives)\nDOKTYP (Type of plan)\nANTAG-DAT (Adoption date)\n\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller översiktsplan - gränser i Gävle kommun. Attributdata:\n\nNAMN (Plannamn)\nDIARIENR (Diarienummer i Gävle kommuns arkiv)\nDOKTYP (Typ av plan)\nANTAG_DAT (Antagandedatum)\n\nKoordinatsystemet är WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-14"},"dct:title":[{"@language":"en","@value":"Comprehensive plan - Boundaries (*json)"},{"@language":"sv","@value":"Översiktsplan - Gränser (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:6cf778931a025ff6393533bfae9edad0cea586a13cf4f1ad5958f2a65fe1ce3f_b0n0"}}],"@id":"urn:source:6cf778931a025ff6393533bfae9edad0cea586a13cf4f1ad5958f2a65fe1ce3f"},{"@graph":[{"@id":"_:6fbabd6aab1d873c25912ea1e26c217ef94534378f61de20fc859b774c669785_b0n0","@type":"dct:ProvenanceStatement","dct:description":[{"@language":"en","@value":"The objects are measured photogrammetrically."},{"@language":"sv","@value":"Objekten är fotogrammetriskt framtagna."}]},{"@id":"_:6fbabd6aab1d873c25912ea1e26c217ef94534378f61de20fc859b774c669785_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/30","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/32"},{"@id":"https://catalog.gavle.se/store/1/resource/84"}],"dcat:keyword":[{"@language":"en","@value":"Playground"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"Lekplats"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Playgrounds in Gävle, points and names. Updates regularly through interpretation of orthophoto, etc.\n \nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Lekplatser i Gävle, punkter och namn. Uppdateras löpande genom tolkning av ortofoto m.m. \n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:6fbabd6aab1d873c25912ea1e26c217ef94534378f61de20fc859b774c669785_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Playgrounds"},{"@language":"sv","@value":"Lekplatser"}]},{"@id":"https://catalog.gavle.se/store/1/resource/31","@type":"http://entryscape.com/terms/Fil