log.gavle.se/store/1/resource/8"},{"@id":"https://catalog.gavle.se/store/1/resource/98"}],"dct:description":{"@language":"sv","@value":"Gävles datakatalog"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":{"@language":"sv","@value":"Gävles datakatalog"}}],"@id":"urn:source:3fcd595a9827b3254ebcadd18326d1f13a23f91aa7fe7a359f8960177ab6b37c"},{"@graph":[{"@id":"_:4d48cd9a05699ffc63f7a146d9562c6d4941c4437e613df95268cbe6ef678010_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/390","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/392"},{"@id":"https://catalog.gavle.se/store/1/resource/394"}],"dcat:keyword":[{"@language":"en","@value":"Bush"},{"@language":"en","@value":"Equipment"},{"@language":"en","@value":"Grass"},{"@language":"en","@value":"Hedge"},{"@language":"en","@value":"Nature"},{"@language":"en","@value":"Paved surface"},{"@language":"en","@value":"Trees"},{"@language":"en","@value":"Water system"},{"@language":"sv","@value":"Buskar"},{"@language":"sv","@value":"Gräs"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"Häckar"},{"@language":"sv","@value":"Markbeläggning"},{"@language":"sv","@value":"Markutrustning"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Träd"},{"@language":"sv","@value":"Vattenanläggning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"en","@value":"Objects in Gävle Municipality where the municipal company Gavlegårdarna is responsible for the maintenance.(e.g. grass surfaces, paved surfaces).\n\nThis data is used as base when calculating costs for maintenance and  care, as well as in procurement. \n\nThe schema is the same as for the dataset Maintenance objects - Gavlefastigheter, therefore these two datasets can be consumed together.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Objekt i Gävle kommun där det kommunala bostadsbolaget Gavlegårdarna ansvarar för skötsel. Datat innehåller vad för slags skötselytor Gavlegårdarna har (ex. gräsytor och markbeläggningsytor).\n\nSkötseldatat används som underlag vid framtagning av skötsel- och underhållskostnader samt vid upphandlingar. \n\nSchemat för innehållet ser likadant ut som för datamängden Skötselobjekt - Gavlefastigheter, så de kan med fördel konsumeras tillsammans.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Maintenance objects - Gavlegårdarna"},{"@language":"sv","@value":"Skötselobjekt - Gavlegårdarna"}]},{"@id":"https://catalog.gavle.se/store/1/resource/391","@type":"http://entryscape.com/terms/File","dct:title":"Skotsel_abg.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/392","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/391"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7057272"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/391"},"dct:description":[{"@language":"en","@value":"Eleven shapefiles containing different types of maintenance objects:\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_LINJE: Bushes and hedges (lines)\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_YTA: Bushes and hedges (polygons)\nABG_SKOTSELOBJEKT_GRAS_YTA: Grass (polygons)\nABG_SKOTSELOBJEKT_MARKBELAGGNINGAR_YTA: Paved surfaces (polygons)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_LINJE: Equipment (lines)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_PUNKT: Equipment (points)\nABG_SKOTSELOBJEKT_NATUR_YTA: Nature (polygons)\nABG_SKOTSELOBJEKT_RABATTER_YTA: Flower beds (polygons)\nABG_SKOTSELOBJEKT_TRAD_PUNKT: Trees (points)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_PUNKT: Water systems (points)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_YTA: Water systems (polygons)\n\nAttribute in all shapefiles:\nSKOTS_PROD - Maintenance product. Specifies type.\n\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"Elva shapefiler som innehåller olika typer av skötselobjekt:\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_LINJE: Buskar och häckar (linje)\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_YTA: Buskar och häckar (yta)\nABG_SKOTSELOBJEKT_GRAS_YTA: Gräs (yta)\nABG_SKOTSELOBJEKT_MARKBELAGGNINGAR_YTA: Markbeläggningar (yta)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_LINJE: Markutrustning (linje)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_PUNKT: Markutrustning (punkt)\nABG_SKOTSELOBJEKT_NATUR_YTA: Natur (yta)\nABG_SKOTSELOBJEKT_RABATTER_YTA: Rabatter (yta)\nABG_SKOTSELOBJEKT_TRAD_PUNKT: Träd (punkt)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_PUNKT: Vattenanläggningar (punkt)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_YTA: Vattenanläggningar (yta)\n\nAttribut i samtliga shapefiler:\nSKOTS_PROD - Skötselprodukt. Anger typ.\n\nFilernas koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:title":[{"@language":"en","@value":"Maintenance objects Gavlegårdarna (*.shp)"},{"@language":"sv","@value":"Skötselobjekt Gavlegårdarna (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/393","@type":"http://entryscape.com/terms/File","dct:title":"Skotsel_abg-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/394","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/393"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"6144987"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/393"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"Eleven GeoJSON files containing different types of maintenance objects:\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_LINJE: Bushes and hedges (lines)\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_YTA: Bushes and hedges (polygons)\nABG_SKOTSELOBJEKT_GRAS_YTA: Grass (polygons)\nABG_SKOTSELOBJEKT_MARKBELAGGNINGAR_YTA: Paved surfaces (polygons)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_LINJE: Equipment (lines)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_PUNKT: Equipment (points)\nABG_SKOTSELOBJEKT_NATUR_YTA: Nature (polygons)\nABG_SKOTSELOBJEKT_RABATTER_YTA: Flower beds (polygons)\nABG_SKOTSELOBJEKT_TRAD_PUNKT: Trees (points)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_PUNKT: Water systems (points)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_YTA: Water systems (polygons)\n\nAttribute in all GeoJSON files:\nSKOTS_PROD - Maintenance product. Specifies type.\n\nThe coordinate system is WGS84."},{"@language":"sv","@value":"Elva GeoJSON filer som innehåller olika typer av skötselobjekt:\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_LINJE: Buskar och häckar (linje)\nABG_SKOTSELOBJEKT_BUSKAR_HACKAR_YTA: Buskar och häckar (yta)\nABG_SKOTSELOBJEKT_GRAS_YTA: Gräs (yta)\nABG_SKOTSELOBJEKT_MARKBELAGGNINGAR_YTA: Markbeläggningar (yta)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_LINJE: Markutrustning (linje)\nABG_SKOTSELOBJEKT_MARKUTRUSTNING_PUNKT: Markutrustning (punkt)\nABG_SKOTSELOBJEKT_NATUR_YTA: Natur (yta)\nABG_SKOTSELOBJEKT_RABATTER_YTA: Rabatter (yta)\nABG_SKOTSELOBJEKT_TRAD_PUNKT: Träd (punkt)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_PUNKT: Vattenanläggningar (punkt)\nABG_SKOTSELOBJEKT_VATTENANLAGGNINGAR_YTA: Vattenanläggningar (yta)\n\nAttribut i samtliga GeoJSON filer:\nSKOTS_PROD - Skötselprodukt. Anger typ.\n\nFilernas koordinatsystemet är WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2020-05-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-04"},"dct:title":[{"@language":"en","@value":"Maintenance objects Gavlegårdarna (*.json)"},{"@language":"sv","@value":"Skötselobjekt Gavlegårdarna (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelepho