//catalog.gavle.se/store/1/resource/8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/41"},{"@id":"https://catalog.gavle.se/store/1/resource/79"}],"dcat:keyword":[{"@language":"en","@value":"cross country skiing"},{"@language":"en","@value":"jogging tracks"},{"@language":"en","@value":"mountainbike"},{"@language":"en","@value":"resting areas"},{"@language":"en","@value":"ski trails"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"längdskidor"},{"@language":"sv","@value":"motionsspår"},{"@language":"sv","@value":"mountainbike"},{"@language":"sv","@value":"rastplatser"},{"@language":"sv","@value":"skidspår"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Jogging tracks in the municipality of Gävle - municipal and sports associations. Update frequency: monthly, by Kultur och fritid, Gävle.  \n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Motionsspår i Gävle kommun - kommunägda och idrottsföreningar. Uppdateras en gång i månaden av Kultur och fritid, Gävle kommun.  \n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Jogging tracks"},{"@language":"sv","@value":"Motionsspår"}]}],"@id":"urn:source:e30e3bf141be38a9d175bc2acaec0d91bf0e2dbcf6910fa32dd5def8575a5598"},{"@graph":[{"@id":"_:e75e0e1ea8735caafa25037f12dbbe8dc085bea6b32c18118b77b65f1e810411_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/438","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/442"},{"@id":"https://catalog.gavle.se/store/1/resource/444"}],"dcat:keyword":[{"@language":"en","@value":"Bicycle lane"},{"@language":"en","@value":"Bicycle network"},{"@language":"en","@value":"Bicycle"},{"@language":"en","@value":"Biking"},{"@language":"en","@value":"School"},{"@language":"sv","@value":"Cykel"},{"@language":"sv","@value":"Cykelnätverk"},{"@language":"sv","@value":"Cykelväg"},{"@language":"sv","@value":"Cykling"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"Skola"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/QUARTERLY"},"dct:description":[{"@language":"en","@value":"Existing and planned bicycles infrastructure consisting bicycle lanes and passages within Gävle Municipality\n\nAttached reports (in Swedish):\n\nCykelplan Del 1.pdf\n\nBicycle plan 2020, Part 1 – Steering document\nPart 1 of Gävles bicycle plan includes policies and principles regarding the continued work of the development profiling Gävle as a bicycle city.\n\nCykelplan Del 2.pdf\nBicycle plan 2020, Part 2 – Action maps\nPart 2 of Gävles bicycle plan includes suggestion of actions to Gävle municipalities' bicycle network. The document consists lines and points identified by street name, type of action, and estimated cost and prioritization. The suggestion actions are evaluated and updated every second year.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Befintlig och planerad infrastruktur för cykel i form av cykelbanor och passager inom Gävle kommun.\n\nBifogade rapporter:\nCykelplan Del 1.pdf\n\nCykelplan 2020, Del 1 – Styrdokument\nDel 1 av Gävle kommuns cykelplan beskriver förhållningssätt och principer för det fortsatta arbetet med att utveckla Gävle som cykelkommun.\n\nCykelplan del 2.pdf\n\nCykelplan 2020, Del 2 – Åtgärdskartor\nDel 2 av Gävle kommuns cykelplan visar förslag på åtgärder i Gävle kommuns cykelvägnät. Dokumentet innehåller sträckor och punkter identifierade med gatunamn. Det går även att läsa vilken typ av åtgärd som kommer att göras samt tuppskattad kostnad och prioritering. \nÅtgärdskartorna utvärderas och uppdateras vartannat år.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:issued":{"@type":"xsd:date","@value":"2020-10-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Bicycle plan"},{"@language":"sv","@value":"Cykelplan"}],"foaf:page":[{"@id":"https://catalog.gavle.se/store/1/resource/439"},{"@id":"https://catalog.gavle.se/store/1/resource/440"}]},{"@id":"https://catalog.gavle.se/store/1/resource/439","@type":"foaf:Document","dct:title":[{"@language":"en","@value":"Bicycle plan - Part 1"},{"@language":"sv","@value":"Cykelplan - Del 1"}]},{"@id":"https://catalog.gavle.se/store/1/resource/440","@type":"foaf:Document","dct:title":[{"@language":"en","@value":"Bicycle plan - Part 2"},{"@language":"sv","@value":"Cykelplan - Del 2"}]},{"@id":"https://catalog.gavle.se/store/1/resource/441","@type":"http://entryscape.com/terms/File","dct:title":"Cykelplan.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/442","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/441"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"326238"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/441"},"dct:description":[{"@language":"en","@value":"Bicycle plan, Gävle municipality. The file contains five shapefiles:\n\nCYKELPLAN_SKOLOR - Schools units\nAttributes: \nNAMN - Name\nTYP - Type of school\nSKOLFORM - Operation\nGATUADRESS - Street address\nORT - City\n\nCYKELPLAN_NY_PASSAGE - New bicycle passageways\nAttributes:\nNumrering - Number (Reference in PDF report\nPrio - Priority\nSOKVAG - Path to report. The reports are also published in the distribution.\n\nCYKELPLAN_NY_CYKELBANA - New bicycle lanes\nAttributes:\nNr- Number (Reference i PDF report)\nPrioritet - Priority\nSOKVAG - Path to report. The reports are also published in the distribution.\n\nCYKELPLAN_MALPUNKTER - Target points\nAttributes:\nNAMN - Name\nGATUADRESS - Address\nORT - City\nSOKVAG - Path to PDF reports. The reports are also published in the distribution.\n\nCYKELPLAN_BEFINTLIGT_CYKELNAT - Existing bicycle network\nAttributes:\nNAT - Network type\nSOKVAG - Path to PDF-reports. The reports are also published in the distribution.\n\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"Cykelplan för Gävle kommun. Filen innehåller fem shapefiler:\n\nCYKELPLAN_SKOLOR - Skolenheter\nAttribut: \nNAMN \nTYP\nSKOLFORM\nGATUADRESS\nORT\n\nCYKELPLAN_NY_PASSAGE - Nya cykelpassager\nAttribut:\nNumrering - Hänvisning i PDF-rapport\nPrio - Prioritet\nSOKVAG - Sökväg till rapport. Rapporter finns även publicerade i distributionen\n\nCYKELPLAN_NY_CYKELBANA - Nya cykelvägar\nAttribut:\nNr- Hänvisning i PDF-rapport\nPrioritet \nSOKVAG - Sökväg till rapport. Rapporter finns även publicerade i distributionen\n\nCYKELPLAN_MALPUNKTER - Målpunkter\nAttribut:\nNAMN\nGATUADRESS\nORT\nSOKVAG - Sökväg till PDF-rapporter från utredningen. Dessa är även bifogade i publikationen.\n\nCYKELPLAN_BEFINTLIGT_CYKELNAT - Befintligt cykelnät\nAttribut:\nNAT - Nättyp\nSOKVAG - Sökväg till PDF-rapporter från utredningen. Dessa är även bifogade i publikationen.\n\nFilernas koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-01"},"dct:title":[{"@language":"en","@value":"Bicycle plan (*.shp)"},{"@language":"sv","@value":"Cykelplan (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/443","@type":"http://entryscape.com/terms/File","dct:title":"Cykelplan-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/444","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/443"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"106915"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/443"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"Bicycle plan, Gävle municipality. The file contains five shapefiles:\n\nCYKELPLAN_SKOLOR - Schools units\nAttributes: \nNAMN - Name\nTYP - Type of school\nSKOLFORM - Operation\nGATUADRESS - Street address\nORT - City\n\nCYKELPLAN_NY_PASSAGE - New bicycle passageways\nAttributes:\nNumrering - Number (Reference in PDF report\nPrio - Priority\nSOKVAG - Path to report. The reports are also published in the distribution.\n\nCYKELPLAN_NY_CYKELBANA - New bicycle lanes\nAttributes:\nNr- Number (Reference i PDF report)\nPrioritet - Priority\nSOKVAG - Path to report. The reports are also published in the distribution.\n\nCYKELPLAN_MALPUNKTER - Target points\nAttributes:\nNAMN - Name\nGATUADRESS - Address\nORT - City\nSOKVAG - Path to PDF reports. The reports are also published in the distribution.\n\nCYKELPLAN_BEFINTLIGT_CYKELNAT - Existing bicycle network\nAttributes:\nNAT - Network type\nSOKVAG - Path to PDF-reports. The reports are also published in the distribution.\n\nThe coordinate system is WGS84"},{"@language":"sv","@value":"Cykelplan för Gävle kommun. Filen innehåller fem shapefiler:\n\nCYKELPLAN_SKOLOR - Skolenheter\nAttribut: \nNAMN \nTYP\nSKOLFORM\nGATUADRESS\nORT\n\nCYKELPLAN_NY_PASSAGE - Nya cykelpassager\nAttribut:\nNumrering - Hänvisning i PDF-rapport\nPrio - Prioritet\nSOKVAG - Sökväg till rapport. Rapporter finns även publicerade i distributionen\n\nCYKELPLAN_NY_CYKELBANA - Nya cykelvägar\nAttribut:\nNr- Hänvisning i PDF-rapport\nPrioritet \nSOKVAG - Sökväg till rapport. Rapporter finns även publicerade i distributionen\n\nCYKELPLAN_MALPUNKTER - Målpunkter\nAttribut:\nNAMN\nGATUADRESS\nORT\nSOKVAG - Sökväg till PDF-rapporter från utredningen. Dessa är även bifogade i publikationen.\n\nCYKELPLAN_BEFINTLIGT_CYKELNAT - Befintligt cykelnät\nAttribut:\nNAT - Nättyp\nSOKVAG - Sökväg till PDF-rapporter från utredningen. Dessa är även bifogade i publikationen.\n\nFilernas koordinatsystemet är WGS84"}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-01"},"dct:title":[{"@language":"en","@value":"Bicycle plan (*.GeoJSON)"},{"@language":"sv","@value":"Cykelplan (*.GeoJSON)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e75e0e1ea8735caafa25037f12dbbe8dc085bea6b32c18118b77b65f1e810411_b0n0"}}],"@id":"urn:source:e75e0e1ea8735caafa25037f12dbbe8dc085bea6b32c18118b77b65f1e810411"},{"@graph":[{"@id":"_:e801a9ab88a19addbdcd8de51658921caf3de7a847d24baf1d9b8217c3da0606_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/395","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/397"},{"@id":"https://catalog.gavle.se/store/1/resource/399"}],"dcat:keyword":[{"@language":"en","@value":"Ecology"},{"@language":"en","@value":"Gardens"},{"@language":"en","@value":"History"},{"@language":"en","@value":"Recreation"},{"@language":"en","@value":"School"},{"@language":"sv","@value":"Ekologi"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"Historia"},{"@language":"sv","@value":"Kultur"},{"@language":"sv","@value":"Rekreation"},{"@language":"sv","@value":"Skola"},{"@language":"sv","@value":"Trädgårdar"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Green structure monitoring in Gävle Municipality 1999-2006.\n\nMonitoring of Gävle's green structure has been  carried out in eleven phases during the years 1999 to 2006. The aim has been to clarify the importance of green structures, and to form a basis for planning that can be  weighed together with other interests in  the municipalitie's comprehensive plans.\n\nNote: This is not to be used as basis for decision or guidelines. For final leveling, decisions and guidelines, see valid comprehensive plans in Gävle Municipality on the web site gavle.se.\n\nPlease read the eleven green structure reports linked in the monitoring zone layer (GRST_UTREDN_OMRADEN). These reports are also found as a zip file under Documentation.\n\nNot updated.\n\nFor recommended layer order, see the distributions.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Grönstrukturinventeringar i Gävle kommun 1999-2006.\n\nKartläggningen av Gävles grönstruktur har gjorts i 11 etapper under åren 1999 till 2006. Syftet har bl a varit att tydliggöra grönstrukturens betydelse och utgöra ett planeringsunderlag som sammanvägs med andra intressen vid kommunens översiktsplanering.\n\nOBS! Inventeringarna är inga beslutade dokument eller riktlinjer. För att se slutliga avvägningar, beslut och riktlinjer hänvisas till gällande översiktsplaner, fördjupade översiktsplaner och andra politiskt antagna dokument och riktlinjer.\n\nLäs gärna de elva Grönstrukturrapporterna som finns kopplade i  utredningsområden (GRST_UTREDN_OMRADEN) för större förståelse och mer information om datat. Rapporterna är av skiftande kvalitet p g a att originalen saknas.\n\nFör rekommenderad lagerordning, se distributionerna.\n\nLänkar till rapporter finns i lagret GRST_UTREDN_OMRADEN. Rapporterna finns även som zip-fil under Dokumentation.\n\nUppdateras ej.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Green structure monitoring"},{"@language":"sv","@value":"Grönstrukturinventering"}],"foaf:page":{"@id":"https://catalog.gavle.se/store/1/resource/432"}},{"@id":"https://catalog.gavle.se/store/1/resource/396","@type":"http://entryscape.com/terms/File","dct:title":"Gronstrukturinventering.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/397","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/396"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"4670000"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/396"},"dct:description":[{"@language":"en","@value":"14 shapefiles, green structure monitoring. Listed in recommended layer order (upper to lower):\n1. Monitoring zones (GRST_UTREDN_OMRADEN)\n2. School (GRST_SKOLA_A)\n3. Recreation (point) (GRST_REKREATION_P)\n4. Recreation (line) (GRST_REKREATION_L)\n5. Recreation (area) (GRST_REKREATION_A)\n6. Ecology (point) (GRST_EKOLOGI_P)\n7. Ecology (line) (GRST_EKOLOGI_L)\n8. Evology (area) (GRST_EKOLOGI_A)\n9. Gardens (GRST_TRADGARDAR)\n10. Culture (point) (GRST_KULTUR_P)\n11. Culture (line) (GRST_KULTUR_L)\n12. Culture (area) (GRST_KULTUR_A)\n13. History (line) (GRST_HISTORIA_L)\n14. History (area) (GRST_HISTORIA_A)\n\nAttributes in all shapefiles:\nOBJBESKR - Object description\n\nGRST_UTREDN_OMRADEN also contains the attribute SOKVAG  (path) containing paths to PDF documents from the monitoring.\n\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"14 shapefiler som ingår i grönstrukturinventeringar. Listas i rekommenderad lagerordning (övre till undre):\n\n1. Utredningsområden (GRST_UTREDN_OMRADEN)\n2. Skola (GRST_SKOLA_A)\n3. Rekreation (punkt) (GRST_REKREATION_P)\n4. Rekreation (linje) (GRST_REKREATION_L)\n5. Rekreation (yta) (GRST_REKREATION_A)\n6. Ekologi (punkt) (GRST_EKOLOGI_P)\n7. Ekologi (linje) (GRST_EKOLOGI_L)\n8. Ekologi (yta) (GRST_EKOLOGI_A)\n9. Trädgårdar (GRST_TRADGARDAR)\n10. Kultur (punkt) (GRST_KULTUR_P)\n11. Kultur (linje) (GRST_KULTUR_L)\n12. Kultur (yta) (GRST_KULTUR_A)\n13. Historia (linje) (GRST_HISTORIA_L)\n14. Historia (yta) (GRST_HISTORIA_A)\n\nAttribut i samtliga shapefiler:\nOBJBESKR - Objektbeskrivning\n\nGRST_UTREDN_OMRADEN innehåller även attributet SOKVAG som består av sökvägar till PDF-rapporter från inventeringarna.\n\nFilernas koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Green structure monitoring (*.shp)"},{"@language":"sv","@value":"Grönstrukturinventering (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/398","@type":"http://entryscape.com/terms/File","dct:title":"Gronstrukturinventering-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/399","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/398"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"5612000"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/398"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"14 shapefiles, green structure monitoring. Listed in recommended layer order (upper to lower):\n1. Monitoring zones (GRST_UTREDN_OMRADEN)\n2. School (GRST_SKOLA_A)\n3. Recreation (point) (GRST_REKREATION_P)\n4. Recreation (line) (GRST_REKREATION_L)\n5. Recreation (area) (GRST_REKREATION_A)\n6. Ecology (point) (GRST_EKOLOGI_P)\n7. Ecology (line) (GRST_EKOLOGI_L)\n8. Evology (area) (GRST_EKOLOGI_A)\n9. Gardens (GRST_TRADGARDAR)\n10. Culture (point) (GRST_KULTUR_P)\n11. Culture (line) (GRST_KULTUR_L)\n12. Culture (area) (GRST_KULTUR_A)\n13. History (line) (GRST_HISTORIA_L)\n14. History (area) (GRST_HISTORIA_A)\n\nAttributes in all GeoJSON files:\nOBJBESKR - Object description\n\nGRST_UTREDN_OMRADEN also contains the attribute SOKVAG  (path) containing paths to PDF documents from the monitoring.\n\nThe coordinate system is WGS84."},{"@language":"sv","@value":"14 shapefiler som ingår i grönstrukturinventeringar. Listas i rekommenderad lagerordning (övre till undre):\n\n1. Utredningsområden (GRST_UTREDN_OMRADEN)\n2. Skola (GRST_SKOLA_A)\n3. Rekreation (punkt) (GRST_REKREATION_P)\n4. Rekreation (linje) (GRST_REKREATION_L)\n5. Rekreation (yta) (GRST_REKREATION_A)\n6. Ekologi (punkt) (GRST_EKOLOGI_P)\n7. Ekologi (linje) (GRST_EKOLOGI_L)\n8. Ekologi (yta) (GRST_EKOLOGI_A)\n9. Trädgårdar (GRST_TRADGARDAR)\n10. Kultur (punkt) (GRST_KULTUR_P)\n11. Kultur (linje) (GRST_KULTUR_L)\n12. Kultur (yta) (GRST_KULTUR_A)\n13. Historia (linje) (GRST_HISTORIA_L)\n14. Historia (yta) (GRST_HISTORIA_A)\n\nAttribut i samtliga shapefiler:\nOBJBESKR - Objektbeskrivning\n\nGRST_UTREDN_OMRADEN innehåller även attributet SOKVAG som består av sökvägar till PDF-rapporter från inventeringarna.\n\nFilernas koordinatsystemet är WGS84."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Green structure monitoring (*.json)"},{"@language":"sv","@value":"Grönstrukturinventering (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/432","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Reports i pdf-format (zip file) connected to the green structure monitoring. These are also linked to the objects in the distribution in GRST_UTREDN_OMRADEN (monitoring zones)"},{"@language":"sv","@value":"Rapporter i pdf-format (zip-fil) tillhörande grönstrukturinventeringen. Finns även länkade från distributionens fil GRST_UTREDN_OMRADEN."}],"dct:title":[{"@language":"en","@value":"Reports, green structure monitoring"},{"@language":"sv","@value":"Rapporter, grönstrukturinventering"}]},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e801a9ab88a19addbdcd8de51658921caf3de7a847d24baf1d9b8217c3da0606_b0n0"}}],"@id":"urn:source:e801a9ab88a19addbdcd8de51658921caf3de7a847d24baf1d9b8217c3da0606"},{"@graph":[{"@id":"_:efe0f72f63740cedc3962474382baa54816112e3e7ea377ad8b0b13e28a255fb_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/470","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":{"@id":"https://catalog.gavle.se/store/1/resource/474"},"dcat:keyword":[{"@language":"en","@value":"access points"},{"@language":"en","@value":"internet"},{"@language":"en","@value":"usage data"},{"@language":"en","@value":"wifi"},{"@language":"sv","@value":"accesspunkter"},{"@language":"sv","@value":"användningsdata"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TECH"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"This data set has been deprecated and is not recommended for any use.\n\nData from public access points owned by the municipality of Gävle . Information is gathered from an API and the responses are saved as JSON files, one JSON file per API call. Among the data included is the number of users, the number of sessions and data usage. Included is also information about the device types and operating systems being used. There is an PDF attachment to the data set which includes more information about the content of the JSON files.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Denna datamängd uppdateras inte längre. Det rekommenderas att du avstår från att använda den.\n\nData från publika accesspunkter som ägs av Gävle kommun. Information hämtas från ett API och svaren skrivs obehandlade direkt till JSON-filer, en JSON-fil per anrop. Data inkluderar exempelvis antal användare, antal sessioner och total datamängd. Information om enhetstyp och operativsystem finns också tillgängligt. Bifogat till datamängden finns en PDF med mer detaljerad information om JSON-filernas innehåll.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:issued":{"@type":"xsd:date","@value":"2021-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-03-23"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Wifi usage data"},{"@language":"sv","@value":"Wifi-användning"}]},{"@id":"https://catalog.gavle.se/store/1/resource/473","@type":"http://entryscape.com/terms/File","dct:format":"application/x-zip-compressed","dct:title":"wifi_anvandning-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/474","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/473"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2830"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/473"},"dcat:mediaType":"application/x-zip-compressed","dct:description":[{"@language":"en","@value":"Seven JSON files, each file represents a call to the API that is used to collect the information. The files included are DailyUsage, OnlineProcessStatistics, RecentMonths, RecentMonthsDetailed, SummarybyDevice, SummarybyOS and VenuesStatus.See the attached PDF for more information on the content of the files."},{"@language":"sv","@value":"Sju stycken JSON-filer, varje fil motsvarar ett anrop mot det API som används för att hämta information. Filerna som ingår är DailyUsage, OnlineProcessStatistics, RecentMonths, RecentMonthsDetailed, SummarybyDevice, SummarybyOS och VenuesStatus.Se den bifogade PDF:en för mer information om innehållet i filerna."}],"dct:issued":{"@type":"xsd:date","@value":"2021-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-01-01"},"dct:title":[{"@language":"en","@value":"Wifi usage data (*.json)"},{"@language":"sv","@value":"Wifi-användningsdata (*.json)"}],"foaf:page":[{"@id":"https://catalog.gavle.se/store/1/resource/471"},{"@id":"https://catalog.gavle.se/store/1/resource/472"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:efe0f72f63740cedc3962474382baa54816112e3e7ea377ad8b0b13e28a255fb_b0n0"}}],"@id":"urn:source:efe0f72f63740cedc3962474382baa54816112e3e7ea377ad8b0b13e28a255fb"},{"@graph":[{"@id":"_:f031e43df7add9256c0d58f335c78cd27590e2517a28406767c0cf1e0bf11837_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/291","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/294"},{"@id":"https://catalog.gavle.se/store/1/resource/300"}],"dcat:keyword":[{"@language":"en","@value":"Ice resurfacing"},{"@language":"en","@value":"Ice skating rinks"},{"@language":"en","@value":"Ice skating"},{"@language":"en","@value":"Outdoor"},{"@language":"sv","@value":"Isbanor"},{"@language":"sv","@value":"Isspolning"},{"@language":"sv","@value":"Skridskoåkning"},{"@language":"sv","@value":"Utomhus"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/QUARTERLY"},"dct:description":[{"@language":"en","@value":"Outdoor ice skating rinks resurfaced in winter by Gävle Municipality, Gavlefastigheter and Gavlegårdarna.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Isbanor utomhus som Gävle kommun, Gavlefastigheter och Gavlegårdarna spolar för skridskoåkning på vintern.\n \nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Ice skating rinks"},{"@language":"sv","@value":"Isbanor"}]},{"@id":"https://catalog.gavle.se/store/1/resource/293","@type":"http://entryscape.com/terms/File","dct:title":"isbanor.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/294","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/293"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"2124"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/293"},"dct:description":[{"@language":"en","@value":"A shapefile containing ice skating rinks maintained by Gävle Municipality, Gavlefastigheter and Gavlegårdarna. Attribute data:\nOBJEKTID (Object identifier)\nNAMN (Name)\nSPOLAS_AV (Resurfaced by)\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller isbanor som underhålls av Gävle kommun, Gavlefastigheter och Gavlegårdarna. Attributdata:\nOBJEKTID\nNAMN\nSPOLAS_AV\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2019-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-08"},"dct:title":[{"@language":"en","@value":"Ice skating rinks (*.shp)"},{"@language":"sv","@value":"Isbanor (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/299","@type":"http://entryscape.com/terms/File","dct:title":"isbanor-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/300","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/299"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"896"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/299"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing ice skating rinks maintained by Gävle Municipality, Gavlefastigheter and Gavlegårdarna. Attribute data:\nOBJEKTID (Object identifier)\nNAMN (Name)\nSPOLAS_AV (Resurfaced by)\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller isbanor som underhålls av Gävle kommun, Gavlefastigheter och Gavlegårdarna. Attributdata:\nOBJEKTID\nNAMN\nSPOLAS_AV\nKoordinatsystemet är WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2019-12-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-08"},"dct:title":[{"@language":"en","@value":"Ice skating rinks (*.json)"},{"@language":"sv","@value":"Isbanor (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f031e43df7add9256c0d58f335c78cd27590e2517a28406767c0cf1e0bf11837_b0n0"}}],"@id":"urn:source:f031e43df7add9256c0d58f335c78cd27590e2517a28406767c0cf1e0bf11837"},{"@graph":[{"@id":"_:f7bf1d4bce118813be557771a2fdcd259b614243c57e050732f0efe4caab03f1_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"_:f7bf1d4bce118813be557771a2fdcd259b614243c57e050732f0efe4caab03f1_b1n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Skoldata hämtas med Tieto Enators \"Organization API v3\" för lagring i Gävle kommuns geografiska databas. Därifrån hämtas skolenheter och de attribut som krävs skapas (se specifikation: https://docs.google.com/document/d/1Bpyy0TSsVUuukqusg-36OkW0p1bRtPHAO8vh1mlSBIg/edit). Koordinater skapas genom geokodning av adresser."}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/38","@type":"http://entryscape.com/terms/File","dct:title":"Skoldata.csv"},{"@id":"https://catalog.gavle.se/store/1/resource/39","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/38"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"19369"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/38"},"dct:description":[{"@language":"en","@value":"A CSV-file containing  school units in Gävle municipality. \nAttributes: source, id, name, type, operation, street, postalcode, locality, lat, long, email, phone, url, capacity, open.from, open.to\nSpatial reference: WGS84.\nCSV-UTF-8 (comma separated)"},{"@language":"sv","@value":"En CSV-fil med skolenheter i Gävle kommun. \nAttributdata: source, id, name, type, operation, street, postalcode, locality, lat, long, email, phone, url, capacity, open.from, open.to\nKoordinatsystem: WGS84.\nCSV-UTF-8 (kommaavgränsad)"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"0NaN-NaN-NaN"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-02"},"dct:title":[{"@language":"en","@value":"School data (*.csv)"},{"@language":"sv","@value":"Skoldata (*csv)"}],"foaf:page":{"@id":"http://lankadedata.se/spec/skoldata"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/47","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.gavle.se/rowstore/dataset/2bc022d9-abd2-4808-a8f7-1a7b209a7de6"},"dct:conformsTo":{"@id":"https://catalog.gavle.se/rowstore/dataset/2bc022d9-abd2-4808-a8f7-1a7b209a7de6/swagger"},"dct:description":[{"@language":"en","@value":"Automatic generated REST-API from EntryScape.\nAttributes: source, id, name, type, operation, street, postalcode, locality, lat, long, email, phone, url, capacity, open.from, open.to.\nSpatial reference: WGS84."},{"@language":"sv","@value":"Automatiskt API som är genererat av CSV-fil i EntryScape.\nAttributdata: source, id, name, type, operation, street, postalcode, locality, lat, long, email, phone, url, capacity, open.from, open.to.\nKoordinatsystem: WGS84."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2018-09-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-06-13T08:56:26.966Z"},"dct:source":{"@id":"https://catalog.gavle.se/store/1/resource/39"},"dct:title":[{"@language":"en","@value":"EntryScape API, School data"},{"@language":"sv","@value":"EntryScape API, Skoldata"}],"foaf:page":{"@id":"http://lankadedata.se/spec/skoldata"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/6","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/39"},{"@id":"https://catalog.gavle.se/store/1/resource/47"}],"dcat:keyword":[{"@language":"en","@value":"GIS"},{"@language":"en","@value":"High school"},{"@language":"en","@value":"Location"},{"@language":"en","@value":"Preschool"},{"@language":"en","@value":"School"},{"@language":"en","@value":"Secondary school"},{"@language":"sv","@value":"Förskola"},{"@language":"sv","@value":"Gymnasium"},{"@language":"sv","@value":"Gävle"},{"@language":"sv","@value":"Plats"},{"@language":"sv","@value":"Skola"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"en","@value":"Addresses and coordinates for schools in Gävle Municipality. Update frequency: Twice a year, by Utbildning (Education), Gävle. \nSchools are used in the map cX Länskartan, a map of the county Gävleborg. Coordinate system: WGS84.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Adresser och koordinater för skolor i Gävle kommun. Uppdateras två gånger per år av Utbildning, Gävle. Ingår i Gävle kommuns cX Länskartan. Koordinatsystem: WGS84\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:f7bf1d4bce118813be557771a2fdcd259b614243c57e050732f0efe4caab03f1_b1n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Public and private schools"},{"@language":"sv","@value":"Kommunala och privata skolor"}],"foaf:page":{"@id":"https://entryscape.com/guide-publicering-av-skoldata-som-oppna-data/"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f7bf1d4bce118813be557771a2fdcd259b614243c57e050732f0efe4caab03f1_b0n0"}},{"@id":"https://entryscape.com/guide-publicering-av-skoldata-som-oppna-data/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Publicering av skoldata som Öppna data"}}],"@id":"urn:source:f7bf1d4bce118813be557771a2fdcd259b614243c57e050732f0efe4caab03f1"},{"@graph":[{"@id":"_:fa4ea5975255e4c957b8dd64c59e09453476ce60616764c9ef686f5877d57050_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/404","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/429"},{"@id":"https://catalog.gavle.se/store/1/resource/431"}],"dcat:keyword":[{"@language":"en","@value":"De-icing"},{"@language":"en","@value":"snowremoval"},{"@language":"sv","@value":"Halkbekämpning"},{"@language":"sv","@value":"Plogområden"},{"@language":"sv","@value":"Snöröjning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"The data set contains areas for which AB Gavlegårdarna and Gavlefastigheter perform services for snow removal and de-icing.\nThe purpose is to coordinate snow removal efforts between the companies in order to achieve more cost-effective management of winter care.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. \n\nThe Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Datamängden innehåller områden för vilka AB Gavlegårdarna och Gavlefastigheter utför tjänster för snöröjning och halkbekämpning.\nSyftet är att samordna snöröjningsinsatser mellan bolagen för att få en kostnadseffektivare hantering av vinterskötsel.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. \n\nGävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Areas of snowremoval and de-icing"},{"@language":"sv","@value":"Plogområden"}]},{"@id":"https://catalog.gavle.se/store/1/resource/428","@type":"http://entryscape.com/terms/File","dct:title":"Plogomraden_abgg_gfab.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/429","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/428"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"17570"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/428"},"dct:description":[{"@language":"en","@value":"The data set contains areas for which AB Gavlegårdarna and Gavlefastigheter perform services for snow removal and de-icing.\nThe purpose is to coordinate snow removal efforts between the companies in order to achieve more cost-effective management of winter care.\n\nAttributes:\nPLOGOMRID (Identity on areas of snow removal and de-icing)\nPLOGOMRNAM (Name in plain text on areas of snow removal and de-icing)\nANSVARIG (Responsible organization of ordering snow removal and de-icing)\nMASKIN (Responsible contractor of performing snow removal and de-icing with a machine)\nHANDSKOTTN (Responsible contractor of performing snow removal and de-icing by hand)\nANMARKNING (Notes about plow area of snow removal and de-icing)\n\nCoordinatesystem: SWEREF 99 16 30\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. \n\nThe Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Datamängden innehåller områden för vilka AB Gavlegårdarna och Gavlefastigheter utför tjänster för snöröjning och halkbekämpning.\nSyftet är att samordna snöröjningsinsatser mellan bolagen för att få en kostnadseffektivare hantering av vinterskötsel.\n\nAttribut:\nPLOGOMRID (Områdesidentitet för snöröjning och halkbekämpning)\nPLOGOMRNAM (Områdesnamn i klartext för snöröjning och halkbekämpning)\nANSVARIG (Ansvarig organisation för att beställa snöröjning och halkbekämpning)\nMASKIN (Ansvarig entreprenör för att utföra snöröjning och halkbekämpning med maskin)\nHANDSKOTTN (Ansvarig entreprenör för att utföra snöröjning och halkbekämpning för hand)\nANMARKNING (Noteringar om snöröjnings- och halkbekämpningsområden)\n\nKoordinatsystem SWEREF 99 16 30\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. \n\nGävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2020-08-01"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-25"},"dct:title":[{"@language":"en","@value":"Areas of snow removal and de-icing (*.shp)"},{"@language":"sv","@value":"Plogområden (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/430","@type":"http://entryscape.com/terms/File","dct:title":"Plogomraden_abgg_gfab-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/431","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/430"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"16984"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/430"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"The data set contains areas for which AB Gavlegårdarna and Gavlefastigheter perform services for snow removal and de-icing.\nThe purpose is to coordinate snow removal efforts between the companies in order to achieve more cost-effective management of winter care.\n\nAttributes:\nPLOGOMRID (Identity on areas of snow removal and de-icing)\nPLOGOMRNAM (Name in plain text on areas of snow removal and de-icing)\nANSVARIG (Responsible organization of ordering snow removal and de-icing)\nMASKIN (Responsible contractor of performing snow removal and de-icing with a machine)\nHANDSKOTTN (Responsible contractor of performing snow removal and de-icing by hand)\nANMARKNING (Notes about plow area of snow removal and de-icing)\n\nCoordinatesystem : SWEREF 99 16 30\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. \n\nThe Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Attribut:\nPLOGOMRID (Områdesidentitet för snöröjning och halkbekämpning)\nPLOGOMRNAM (Områdesnamn i klartext för snöröjning och halkbekämpning)\nANSVARIG (Ansvarig organisation för att beställa snöröjning och halkbekämpning)\nMASKIN (Ansvarig entreprenör för att utföra snöröjning och halkbekämpning med maskin)\nHANDSKOTTN (Ansvarig entreprenör för att utföra snöröjning och halkbekämpning för hand)\nANMARKNING (Noteringar om snöröjnings- och halkbekämpningsområden)\n\n\nKoordinatsystem SWEREF 99 16 30\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. \n\nGävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information"}],"dct:issued":{"@type":"xsd:date","@value":"2020-08-01"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-25"},"dct:title":[{"@language":"en","@value":"Areas of snow removal and de-icing (*.json)"},{"@language":"sv","@value":"Plogområden (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:fa4ea5975255e4c957b8dd64c59e09453476ce60616764c9ef686f5877d57050_b0n0"}}],"@id":"urn:source:fa4ea5975255e4c957b8dd64c59e09453476ce60616764c9ef686f5877d57050"},{"@graph":[{"@id":"_:faf4e2afd480959b79822ea39ca094e27596237f1f1f1758b1aa4a0abb97d651_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/205","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/207"},{"@id":"https://catalog.gavle.se/store/1/resource/209"}],"dcat:keyword":[{"@language":"en","@value":"road maintenance"},{"@language":"en","@value":"road sweeping"},{"@language":"en","@value":"roads"},{"@language":"en","@value":"sand removal"},{"@language":"sv","@value":"gatuskötsel"},{"@language":"sv","@value":"gatusopning"},{"@language":"sv","@value":"sandupptagning"},{"@language":"sv","@value":"vägar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"The information is available for informing the public where Gävle Municipality plans to perform sand removal of the roads after the winter season. The dataset consists only of roads, bicycle paths and walkways where Gävle Municipality performs sand removal.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Informationen finns till för att kommunicera med allmänheten var Gävle kommun planerar att ta upp sand på vägarna efter vinterns slut. Datamängden innehåller endast vägar, cykelvägar och gångvägar där Gävle kommun ombesörjer sandupptagning.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Sand removal areas"},{"@language":"sv","@value":"Sandupptagningsområden"}]},{"@id":"https://catalog.gavle.se/store/1/resource/206","@type":"http://entryscape.com/terms/File","dct:title":"sandupptagningsomraden.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/207","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/206"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"23501"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/206"},"dct:description":[{"@language":"en","@value":"A shapefile containing sand removal areas in Gävle Municipality. Attribute data:\nTURORDNING (Order of priority)\nNAMN (Name of the sand removal area)\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller sandupptagningsområden inom Gävle kommun, där Gävle kommun ombesörjer sandupptagning. Attributdata:\nTURORDNING\nNAMN (Namnet på sandupptagningsområdet)\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-24"},"dct:title":[{"@language":"en","@value":"Sand removal areas (*.shp)"},{"@language":"sv","@value":"Sandupptagningsområden (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/208","@type":"http://entryscape.com/terms/File","dct:title":"sandupptagningsomraden-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/209","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/208"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"10530"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/208"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing sand removal areas in Gävle Municipality. Attribute data:\nTURORDNING (Order of priority)\nNAMN (Name of the sand removal area)\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller sandupptagningsområden inom Gävle kommun, där Gävle kommun ombesörjer sandupptagning. Attributdata:\nTURORDNING\nNAMN (Namnet på sandupptagningsområdet)\nKoordinatsystemet är WGS84."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-24"},"dct:title":[{"@language":"en","@value":"Sand removal areas (*.json)"},{"@language":"sv","@value":"Sandupptagningsområden (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vca