ägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:dbede295750ba3532c1569c1350c5f9a78e0702c942d6b24bff65605074a6e0e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Public toilets"},{"@language":"sv","@value":"Offentliga toaletter"}]},{"@id":"https://catalog.gavle.se/store/1/resource/148","@type":"http://entryscape.com/terms/File","dct:title":"offentliga_toaletter.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/149","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/148"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"1446"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/148"},"dct:description":[{"@language":"en","@value":"A shapefile containing public toilets in Gävle. Attribute data:\nBENAMN (Name of the public toilet)\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller offentliga toaletter i Gävle. Attributdata:\nBENAMN (Namnet på toaletten)\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-10"},"dct:title":[{"@language":"en","@value":"Public toilets (*.shp)"},{"@language":"sv","@value":"Offentliga toaletter (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/150","@type":"http://entryscape.com/terms/File","dct:title":"offentliga_toaletter-js