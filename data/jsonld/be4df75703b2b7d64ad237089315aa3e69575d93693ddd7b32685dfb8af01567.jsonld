log.gavle.se/store/1/resource/499"},{"@id":"https://catalog.gavle.se/store/1/resource/69"},{"@id":"https://catalog.gavle.se/store/1/resource/97"}],"dcat:keyword":[{"@language":"en","@value":"Bog soil"},{"@language":"en","@value":"Cropland"},{"@language":"en","@value":"Dense forest"},{"@language":"en","@value":"Earth cellar"},{"@language":"en","@value":"Electric Cable"},{"@language":"en","@value":"Electricity pylon"},{"@language":"en","@value":"Fence"},{"@language":"en","@value":"Fountain"},{"@language":"en","@value":"Gas-pipe"},{"@language":"en","@value":"Graveyard"},{"@language":"en","@value":"Hedge"},{"@language":"en","@value":"Light pole"},{"@language":"en","@value":"Meadow"},{"@language":"en","@value":"Patio"},{"@language":"en","@value":"Pipeline"},{"@language":"en","@value":"Railway pole"},{"@language":"en","@value":"Revetment"},{"@language":"en","@value":"Staircase"},{"@language":"en","@value":"Stone wall"},{"@language":"en","@value":"Street light"},{"@language":"en","@value":"Temperate coniferous forest"},{"@language":"en","@value":"Temperate deciduous forest"},{"@language":"en","@value":"Tree"},{"@language":"en","@value":"Water tube"},{"@language":"en","@value":"Water well"},{"@language":"sv","@value":"Altan"},{"@language":"sv","@value":"Barrskog"},{"@language":"sv","@value":"Belysningsstolpe"},{"@language":"sv","@value":"Elledning"},{"@language":"sv","@value":"Elstolpe"},{"@language":"sv","@value":"Fontän"},{"@language":"sv","@value":"Gasledning"},{"@language":"sv","@value":"Häck"},{"@language":"sv","@value":"Jordkällare"},{"@language":"sv","@value":"Kyrkogård"},{"@language":"sv","@value":"Lövskog"},{"@language":"sv","@value":"Pipeline"},{"@language":"sv","@value":"SJ-stolpe"},{"@language":"sv","@value":"Sankmark"},{"@language":"sv","@value":"Staket"},{"@language":"sv","@value":"Stenmur"},{"@language":"sv","@value":"Stödmur"},{"@language":"sv","@value":"Trappa"},{"@language":"sv","@value":"Träd"},{"@language":"sv","@value":"Tätskog"},{"@language":"sv","@value":"Vattenbrunn"},{"@language":"sv","@value":"Vattentub"},{"@language":"sv","@value":"Vägtrumma"},{"@language":"sv","@value":"Ägoslagsgräns"},{"@language":"sv","@value":"Äng"},{"@language":"sv","@value":"Åker"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Various objects from Gävles basemap. \n\nThe basemap provided by us is constructed in an accurate, timeless way, it is tailored from set specifics. We strive to have correct information, but we cannot guarantee it in all regard. \n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Detaljer från Gävles baskarta. \n\nGävle kommun upplyser om att baskartans innehåll med avseende på noggrannhet och aktualitet överensstämmer med fastställda specifikationer och beskrivningar. Gävle kommun strävar efter att informationen skall vara så riktig som möjligt men kan inte garantera det i alla avseenden.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till kunden. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för kunden till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:d851c78eafbf65d9c4141286d1ee4e350fb803cc9fb6899561647133567c654c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Basemap - Details"},{"@language":"sv","@value":"Baskarta - Detaljer"}],"foaf:page":{"@id":"https://catalog.gavle.se/store/1/resource/269"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d851c78eafbf65d9c4141286d1ee4e350fb803cc9fb6899561647133567c654c_b1n0"}},{"@id":"https://catalog.gavle.se/store/1/resource/68","@type":"http://entryscape.com/terms/File","dct:title":"baskarta-detaljer.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/68"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"7325081"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/68"},"dct:description":[{"@language":"en","@value":"Two shapefiles containing various objects from Gävles basemap. Attribute data consist of type, date of last update, file date and collection method. The coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"Två shapefiler som innehåller detaljer från Gävles baskarta i form av punktobjekt och linjeobjekt. Attributdata innehåller typ, uppdateringsdatum, fildatum och mätmetod. Koordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-10-13"},"dct:title":[{"@language":"en","@value":"Various objects (*.shp)"},{"@language":"sv","@value":"Detaljer (*.shp)"}],"http://www.w3.org/ns/adms#status":{