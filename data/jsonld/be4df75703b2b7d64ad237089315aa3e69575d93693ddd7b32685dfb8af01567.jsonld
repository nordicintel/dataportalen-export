ormation."},"dct:issued":{"@type":"xsd:gYear","@value":"2025"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:temporal":{"@id":"_:8af953f2b35ae9437629b263ef222bcbf954c80841511f5116bfbfc658ebafd3_b0n0"},"dct:title":{"@language":"sv","@value":"Mediepubliceringskostnader"},"http://schema.org/diagram":{"@id":"https://catalog.gavle.se/store/1/resource/551"}},{"@id":"https://catalog.gavle.se/store/1/resource/547","@type":"http://entryscape.com/terms/File","dct:title":"Mediepubliceringskostnader 2025.xlsx"},{"@id":"https://catalog.gavle.se/store/1/resource/548","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/547"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/547"},"dct:description":{"@language":"sv","@value":"Mediepubliceringskostnader 2025 med detaljer och sammanställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLS"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Mediepubliceringskostnader 2025 (detaljer och sammanställning)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.gavle.se/store/1/resource/552","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Mediepubliceringskostnader 2025 UTF-8.csv"},{"@id":"https://catalog.gavle.se/store/1/resource/553","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/552"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/552"},"dct:description":{"@language":"sv","@value":"Enbart detaljer om mediepubliceringskostnader 2025, ingen sammanställning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Mediepubliceringsko