":"quiet zones"},{"@language":"en","@value":"road"},{"@language":"en","@value":"traffic noise"},{"@language":"en","@value":"traffic"},{"@language":"en","@value":"train"},{"@language":"sv","@value":"bullerkartläggning"},{"@language":"sv","@value":"bullerutredning"},{"@language":"sv","@value":"trafik"},{"@language":"sv","@value":"trafikbuller"},{"@language":"sv","@value":"tysta områden"},{"@language":"sv","@value":"tåg"},{"@language":"sv","@value":"väg"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/TRIENNIAL"},"dct:description":[{"@language":"en","@value":"Noise study in Gävle Municipality.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Bullerutredning i Gävle kommun. \n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Noise study"},{"@language":"sv","@value":"Bullerutredning"}]},{"@id":"https://catalog.gavle.se/store/1/resource/216","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.gavle.se/pubs/bullerutredning/wms?request=GetCapabilities&service=WMS"},"dct:conformsTo":{"@id":"http://www.opengis.net/def/serviceType/ogc/wms"},"dct:description":[{"@language":"en","@value":"Noise study in Gävle Municipality as a Web Map Service (WMS). The service supports the coordinate system SWEREF 99 16 30. Read the service capabilites for more information.\n\nA report for the noise study can be downloaded from the section Documentation.\n\nThe Municipality of Gävle cannot guarantee that the service is available at all times. Recurrent system maintenance and other operations may result in service downtime."},{"@language":"sv","@value":"Bullerutredning i Gävle kommun som WMS. Tjänsten stödjer koordinatsystemet SWEREF 99 16 30. Använd anropet GetCapabilites för att se mer information om tjänsten.\n\nEn rapport tillhörande bullerutredning finns att ladda ned från sektionen Dokumentation.\n\nGävle kommun kan inte garantera att tjänsten är tillgänglig vid alla tidpunkter. Återkommande systemunderhåll och andra driftåtgärder kan innebära att tjänsten ibland inte går att nå."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Noise study (WMS)"},{"@language":"sv","@value":"Bullerutredning (WMS)"}],"foaf:page":{"@id":"https://catalog.gavle.se/store/1/resource/217"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@i