pe":"http://entryscape.com/terms/File","dct:title":"gast_naturhamnar.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/201","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/200"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"5012"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/200"},"dct:description":[{"@language":"en","@value":"A shapefile containing guest harbors and natural harbors in Gävle Municipality. Attribute data: namn=name, gatuadress=address, ort=city, beskr_kort=description short, URL=URL, upddatum=date of update.\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller gäst- och naturhamnar inom Gävle kommun. Attributdata består av namn, gatuadress, ort, beskr_kort, URL, upddatum.\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2019-06-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-25"},"dct:title":[{"@language":"en","@value":"Guest harbors and natural harbors (*.shp)"},{"@language":"sv","@value":"Gästhamnar och naturhamnar (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/202","@type":"http://entryscape.com/terms/File","dct:title":"gast_naturhamnar-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/203","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/202"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"3904"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/202"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing guest harbors and natural harbors in Gävle Municipality. Attribute data: namn=name, gatuadress=address, ort=city, beskr_kort=description short, URL=URL, upddatum=date of update.\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller gäst- och naturhamnar inom Gävle kommun. Attributdata består av namn, gatuadress, ort, beskr_kort, URL, upddatum.\nKoordinatsystemet är WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2019-06-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-25"},"dct:title":[{"@language":"en","@value":"Guest harbors and natural harbors (*.json)"},{"@language":"sv","@value":"Gästhamnar och naturhamnar (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:305ea813b76ca627b17063b7e70e7571072eac0f4c11805c9f3f9afe3f6dea60_b0n0"}}],"@id":"urn:source:305ea813b76ca627b17063b7e70e7571072eac0f4c11805c9f3f9afe3f6dea60"},{"@graph":[{"@id":"_:3081633f5a0ad7053ea087d2afef29cd74cd17577c6778076d50198fb16d158e_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/204","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/219"},{"@id":"https://catalog.gavle.se/store/1/resource/221"}],"dcat:keyword":[{"@language":"en","@value":"Traffic flow"},{"@language":"en","@value":"Traffic volume"},{"@language":"sv","@value":"Bilföden"},{"@language":"sv","@value":"Trafikmängd"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":[{"@language":"en","@value":"Each year approximately 300 surveys are conducted to measure the number of vehicles involved in traffic flow. The results show the yearly average vehicular traffic that occurs on weekdays. The purpose of these surveys is to observe changes in traffic and collect data on traffic volume which may be used for planning various establishments.\n\nThe surveys are conducted by a contractor when there is no snow on the ground. There are a number of fixed points that are compiled each year end and an annual index is taken from these points. All annual calculations are indexed and the results are added to an attribute chart to be correlated with a collection of maps from Gävle Municipality and updated on an annual basis.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Det utförs ungefär 300 mätningar av antalet fordon varje år. Resultatet från mätningarna redovisar årsvardagsdygnmedeltrafik, ÅVADT. Syftet med mätningarna är att se förändringar i trafiken och att få fram uppgifter om trafikmängd som till exempel kan användas som planeringsunderlag vid olika slags nyetableringar.\n\nMätningarna utförs av en entreprenör under barmarkssäsongen. Det finns ett antal fasta punkter som sammanställs efter årsslutet och ett årsindex tas ut från dessa. Alla årsräkningar räknas om med index i ett hanteringsprogram och därefter läggs siffrorna in i en attributtabell kopplad till bland annat Samlingskartan från Gävle kommun. Uppdateringen sker 1 gång per år då Gävle kommun är beroende av årsindex.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:issued":{"@type":"xsd:date","@value":"2019-07-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Traffic flow"},{"@language":"sv","@value":"Bilflöden"}]},{"@id":"https://catalog.gavle.se/store/1/resource/218","@type":"http://entryscape.com/terms/File","dct:title":"bilfloden.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/219","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/218"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"83560"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/218"},"dct:description":[{"@language":"en","@value":"A shapefile containing traffic flow in Gävle Municipality. \nAttribute data:\nNAMN (street names)\nPUNKTNR (measure points)\nBF2015 (traffic flow values year 2015)\nBF2016 (traffic flow values year 2016)\nBF2017 (traffic flow values year 2017)\nBF2018 (traffic flow values year 2018)\nThe coordinate system is SWEREF 99 16 30."},{"@language":"sv","@value":"En shapefil som innehåller bilflöden i Gävle kommun. \nAttributdata:\nNAMN (vägnamn)\nPUNKTNR (mätpunkter)\nBF2015 (beräknat bilföde år 2015)\nBF2016 (beräknat bilföde år 2016)\nBF2017 (beräknat bilföde år 2017)\nBF2018 (beräknat bilföde år 2018)\nKoordinatsystemet är SWEREF 99 16 30."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/SHP"},"dct:issued":{"@type":"xsd:date","@value":"2019-07-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-02"},"dct:title":[{"@language":"en","@value":"Traffic flow (*.shp)"},{"@language":"sv","@value":"Bilflöden (*.shp)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/220","@type":"http://entryscape.com/terms/File","dct:title":"bilfloden-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/221","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/220"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"32175"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/220"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"A GeoJSON file containing traffic flow in Gävle Municipality. \nAttribute data:\nNAMN (streetnames)\nPUNKTNR (measurepoints)\nBF2015 (traffic flow values year 2015)\nBF2016 (traffic flow values year 2016)\nBF2017 (traffic flow values year 2017)\nBF2018 (traffic flow values year 2018)\nThe coordinate system is WGS84."},{"@language":"sv","@value":"En GeoJSON fil som innehåller bilflöden i Gävle kommun. \nAttributdata:\nNAMN (vägnamn)\nPUNKTNR (mätpunkter)\nBF2015 (beräknat bilföde år 2015)\nBF2016 (beräknat bilföde år 2016)\nBF2017 (beräknat bilföde år 2017)\nBF2018 (beräknat bilföde år 2018)\nKoordinatsystemet är WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2019-07-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-02"},"dct:title":[{"@language":"en","@value":"Traffic flow (*.json)"},{"@language":"sv","@value":"Bilflöden (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:3081633f5a0ad7053ea087d2afef29cd74cd17577c6778076d50198fb16d158e_b0n0"}}],"@id":"urn:source:3081633f5a0ad7053ea087d2afef29cd74cd17577c6778076d50198fb16d158e"},{"@graph":[{"@id":"_:30e8da3d20913520eab27a91e753b5bb49f02897149a1e0e11040859c1a4e6b4_b0n0","@type":"dct:ProvenanceStatement","dct:description":[{"@language":"en","@value":"Historical places and objects in Gävle municipality. The citation for the points can be found in the data set."},{"@language":"sv","@value":"Historiska platser och objekt i Gävle kommun. Källangivelse för punkterna finns i datamängden."}]},{"@id":"_:30e8da3d20913520eab27a91e753b5bb49f02897149a1e0e11040859c1a4e6b4_b1n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/140","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":{"@id":"https://catalog.gavle.se/store/1/resource/142"},"dcat:keyword":[{"@language":"en","@value":"blocks"},{"@language":"en","@value":"bridges"},{"@language":"en","@value":"businesses"},{"@language":"en","@value":"documents"},{"@language":"en","@value":"footpaths"},{"@language":"en","@value":"habitation"},{"@language":"en","@value":"objects"},{"@language":"en","@value":"parks"},{"@language":"en","@value":"paths"},{"@language":"en","@value":"places"},{"@language":"en","@value":"railways"},{"@language":"en","@value":"roads"},{"@language":"en","@value":"streets"},{"@language":"en","@value":"town squares"},{"@language":"sv","@value":"bebyggelse"},{"@language":"sv","@value":"broar"},{"@language":"sv","@value":"dokument"},{"@language":"sv","@value":"föremål"},{"@language":"sv","@value":"gator"},{"@language":"sv","@value":"gångar"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"historiska"},{"@language":"sv","@value":"järnvägar"},{"@language":"sv","@value":"kvarter"},{"@language":"sv","@value":"parker"},{"@language":"sv","@value":"plats"},{"@language":"sv","@value":"stigar"},{"@language":"sv","@value":"torg"},{"@language":"sv","@value":"verksamhet"},{"@language":"sv","@value":"vägar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":[{"@language":"en","@value":"Historical objects in Gävle Municipality. The dataset is produced mainly from history books, Wikipedia, decision-making protocols for the naming of roads, parks and city blocks.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information. "},{"@language":"sv","@value":"Historiska objekt inom Gävle kommun. Datamängden är framtagen främst via historieböcker, Wikipedia samt beslutande protokoll som rör namnsättning av gator, parker och kvarter.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:30e8da3d20913520eab27a91e753b5bb49f02897149a1e0e11040859c1a4e6b4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Historical objects"},{"@language":"sv","@value":"Historiska objekt"}]},{"@id":"https://catalog.gavle.se/store/1/resource/141","@type":"http://entryscape.com/terms/File","dct:title":"historiska_objekt-json.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/142","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/141"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"295754"},"dcat:downloadURL":{"@id":"https://catalog.gavle.se/store/1/resource/141"},"dcat:mediaType":"application/json+zip","dct:description":[{"@language":"en","@value":"The GeoJSON file contains historical objects in Gävle Municipality, including citations.\n\nAttributes: name (namn), category (kategori), description (beskrivning), source (källa), updated (upddatum).\nCategories: Habitation (bebyggelse), bridges (broar), documents (dokument), objects (objekt), roads/streets (gator/vägar), railways (järnvägar), blocks (kvarter), parks (parker), places (plats), paths/footpaths (stigar/gångar), town squares (torg), business (verksamhet).\n\nCoordinate system: WGS84."},{"@language":"sv","@value":"Geojson-filen innehåller historiska objekt i Gävle kommun med källanvisningar.\n\nAttribut: namn, kategori, beskrivning, källa, upddatum\nKategorier: Bebyggelse, broar, dokument, föremål, gator/vägar, järnvägar, kvarter, parker, plats, stigar/gångar, torg, verksamhet.\n\nKoordinatsystem: WGS84."}],"dct:issued":{"@type":"xsd:date","@value":"2019-01-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-30"},"dct:title":[{"@language":"sv","@value":"Historical objects (*.json)"},{"@language":"sv","@value":"Historiska objekt (*.json)"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/64","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Öppna data Gävle","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:oppnadata@gavle.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:30e8da3d20913520eab27a91e753b5bb49f02897149a1e0e11040859c1a4e6b4_b1n0"}}],"@id":"urn:source:30e8da3d20913520eab27a91e753b5bb49f02897149a1e0e11040859c1a4e6b4"},{"@graph":[{"@id":"_:39f9f7c2bb37761f651c2751e0e826a0609171dee48640ec576ebab62b267a3d_b0n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+4626178000"}},{"@id":"http://dataportal.se/organisation/SE2120002338","@type":"foaf:Agent","dct:identifier":"2120002338","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:marie.1.nilsson@gavle.se"},"foaf:name":{"@language":"sv","@value":"Gävle kommun"},"foaf:page":{"@id":"https://www.gavle.se"}},{"@id":"https://catalog.gavle.se/store/1/resource/153","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.gavle.se/store/1/resource/64"},"dcat:distribution":[{"@id":"https://catalog.gavle.se/store/1/resource/154"},{"@id":"https://catalog.gavle.se/store/1/resource/156"},{"@id":"https://catalog.gavle.se/store/1/resource/158"}],"dcat:keyword":[{"@language":"en","@value":"Core sample"},{"@language":"en","@value":"Geotechnical investigation"},{"@language":"en","@value":"Geotechnics"},{"@language":"en","@value":"Soil investigation"},{"@language":"sv","@value":"Borrprov"},{"@language":"sv","@value":"Geoteknik"},{"@language":"sv","@value":"Geoteknisk undersökning"},{"@language":"sv","@value":"Markundersökning"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Geotechnical investigations executed by different consulting companies on behalf of the Gävle Municipality.\n\nThe dataset is also included in the Gävle Municipality's web map Geotekniska undersökningar.\n\nThe Municipality of Gävle disclaims all responsibility for any errors or changes in open data that has been supplied by Gävle Municipality to the consumer. The Municipality of Gävle disclaims all responsibility for damage or other inconvenience resulting from improper use of open data in assimilated products or with other information."},{"@language":"sv","@value":"Geotekniska undersökningar utförda av olika konsultbolag på uppdrag av Gävle kommun.\n\nDatamängden ingår även i Gävle kommuns webbkarta Geotekniska undersökningar.\n\nGävle kommun friskriver sig från varje form av ansvar för fel eller förändringar i öppna data som levererats från Gävle kommun till konsumenten. Gävle kommun friskriver sig från varje form av ansvar för skada eller annan olägenhet som kan uppkomma för konsumenten till följd av nyttjande av öppna data i följdproduktion eller tillsammans med annan information."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120002338"},"dct:title":[{"@language":"en","@value":"Geotechnical investigations"},{"@language":"sv","@value":"Geotekniska undersökningar"}]},{"@id":"https://catalog.gavle.se/store/1/resource/154","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.gavle.se/pubs/smart/?karta=geotekniska"},"dct:description":[{"@language":"en","@value":"A web link to a map containing geotechnical investigations in Gävle Municipality. Attribute data contains: Planning area, Area, Object type, Date, Consultant, Path and Notations. The coordinate system is SWEREF99 1630."},{"@language":"sv","@value":"En webblänk till en karta som innehåller geotekniska undersökningar i Gävle kommun. Attributdata innehåller: Planeringsområde, Område, Objekttyp, Datum, Konsult, Sökväg och Anmärkning. Koordinatsystemet är SWEREF99 1630."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Geotechnical investigations"},{"@language":"sv","@value":"Geotekniska undersökningar"}],"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.gavle.se/store/1/resource/155","@type":"http://entryscape.com/terms/File","dct:title":"geotekniska_undersokningar.zip"},{"@id":"https://catalog.gavle.se/store/1/resource/156","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.gavle.se/store/1/resource/155"},"dcat:byteSize":{"@type":"xsd:nonNegativeInteger","@value":"63672"},"dcat:down