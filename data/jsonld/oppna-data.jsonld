 Axell","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:efff911fe8808142e413bdec6fc5a071754e8e41e9786794114382d71ae60156_b0n0"},{"@id":"_:efff911fe8808142e413bdec6fc5a071754e8e41e9786794114382d71ae60156_b1n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:mattias@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/2","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Eric Hjelmestam","http://www.w3.org/2006/vcard/ns#hasAddress":[{"@id":"_:efff911fe8808142e413bdec6fc5a071754e8e41e9786794114382d71ae60156_b2n0"},{"@id":"_:efff911fe8808142e413bdec6fc5a071754e8e41e9786794114382d71ae60156_b3n0"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:eric@metasolutions.se"}},{"@id":"https://editera.dataportal.se/store/87/resource/4","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Matthias Palmér","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:matthias@metasolutions.se"}},{"@id":"https://katalog.lund.se/store/1/resource/64","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://katalog.lund.se/store/1/resource/66"},"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001132"},"dct:title":[{"@language":"en","@value":"Public spending"},{"@language":"sv","@value":"Leverantörsreskontra"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"},"http://schema.org/diagram":{"@id":"https://katalog.lund.se/store/1/resource/68"}},{"@id":"https://katalog.lund.se/store/1/resource/65","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"P230101-231231_20240425_del1.csv"},{"@id":"https://katalog.lund.se/store/1/resource/66","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://katalog.lund.se/store/1/resource/65"},{"@id":"https://katalog.lund.se/store/1/resource/67"}],"dcat:downloadURL":[{"@id":"https://katalog.lund.se/store/1/resource/65"},{"@id":"https://katalog.lund.se/store/1/resource/67"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2024-04-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-04-25T13:48:52.838Z"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/temporary"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://katalog.lund.se/store/1/resource/67","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"P230101-231231_20240425_del2.csv"},{"@id":"https://lankadedata.se/spec/levreskontra/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Leverantörsreskontra"}}],"@id":"urn:source:efff911fe8808142e413bdec6fc5a071754e8e41e9786794114382d71ae60156"},{"@graph":[{"@id":"https://katalog.lund.se/store/1/resource/2","@type":"dcat:Catalog","dcat:dataset":{"@id":"https://katalog.lund.se/store/1/resource/64"},"dct:description":"denna katalog behövs för skördning till öppnadata.se - ta inte bort","dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001132"},"dct:title":"Öppna data"}],"@id":"urn:source:f1b436579adfce0cc6e2652633d0d19793af0a4f971fcbf714c8d69a797aa63c"}]}
