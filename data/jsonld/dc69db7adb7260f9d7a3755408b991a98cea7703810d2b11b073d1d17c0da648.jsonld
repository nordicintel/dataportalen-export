ws?layers=SD.FaglarsUtbredning.2013"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1cf473e3242a16030141f6fe65998bb7d85706ba3ee0ed5c7280133031855da9_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:1cf473e3242a16030141f6fe65998bb7d85706ba3ee0ed5c7280133031855da9"},{"@graph":[{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Nationalparkernas begränsningslinjer håller minst samma kvalitet som Fastighetskartan skala 1:10 000. Under 2008-2009 genomfördes ett kvalitetsförbättringsprojekt där gränserna justerades mot fastighetsgränser och topografiska objekt i Fastighetskartan. Vissa av Nationalparkerna har även mätts in i fält med GPS eller med annan mätteknik med hög noggrannhet. Nationalparker ska inte överlappa Naturreservat och Naturvårdsområden."}},{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/bfc33845-ffb9-4835-8355-76af3773d4e0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:147dfb7e-bc51-864f-110b-59c640212c43"},{"@id":"urn:uuid:23825ccc-c12a-7f8f-2164-0eafc78fc8c8"},{"@id":"urn:uuid:37b31bb1-5d5d-abb8-26ef-645773f63777"},{"@id":"urn:uuid:39778586-68ad-2c0d-a424-2c3eb92113f4"},{"@id":"urn:uuid:5267082a-c758-a461-b4c5-e65df573bfc6"},{"@id":"urn:uuid:62b98694-c10e-e7a0-b229-49c83c4f8fa7"},{"@id":"urn:uuid:838c9824-9a3b-88eb-1eb8-58fcdec64ddf"},{"@id":"urn:uuid:ab418e07-6428-e0ae-e074-b8852948d09a"},{"@id":"urn:uuid:cc818e77-bdaa-8797-16da-2b53d28bb6d0"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Syftet med en nationalpark är att 'bevara ett större sammanhängande område av viss landskapstyp i dess naturliga tillstånd eller i väsentligt oförändrat skick' (ur miljöbalken). Staten äger all mark i en nationalpark. Nationalparkerna ska utgöras av representativa landskapstyper som bevaras i naturligt tillstånd men de ska också vara natursköna eller unika miljöer som kan ge starka naturupplevelser. Sverige har 31 nationalparker."},"dct:identifier":"bfc33845-ffb9-4835-8355-76af3773d4e0","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: nationalparker"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:147dfb7e-bc51-864f-110b-59c640212c43","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:23825ccc-c12a-7f8f-2164-0eafc78fc8c8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/skyddad-natur/Nationalparker/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med information."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:37b31bb1-5d5d-abb8-26ef-645773f63777","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/NP.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:39778586-68ad-2c0d-a424-2c3eb92113f4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps/wfs?"},"dct:description":{"@language":"sv","@value":"WFS tjänst för naturvårdsregistret enligt Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:5267082a-c758-a461-b4c5-e65df573bfc6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till dokumentation och legender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation och legender"}},{"@id":"urn:uuid:62b98694-c10e-e7a0-b229-49c83c4f8fa7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSites_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:838c9824-9a3b-88eb-1eb8-58fcdec64ddf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_beskrivning_av_oppna_data.pdf"},"dct:description":{"@language":"sv","@value":"Länk till produktbeskrivning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av öppna data"}},{"@id":"urn:uuid:ab418e07-6428-e0ae-e074-b8852948d09a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}},{"@id":"urn:uuid:cc818e77-bdaa-8797-16da-2b53d28bb6d0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-nvr/ows?layers=PS.ProtectedSites.NP"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:1d6bccecf0895a374c19a37e427b59c23928634e6bc9759d6645f037f1b3c22e"},{"@graph":[{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"TDB"}},{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/be4c0a8c-7fe3-49d4-bb5c-bf10234dc281","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:693d5203-e37a-a991-f85b-c1434c074e99"},{"@id":"urn:uuid:cb731ae3-9b3f-1e3e-23bd-41b71b76a0eb"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"SCB:s lantbruksregister (LBR) och jordbruks/lantbruksräkningarna innehåller uppgifter om jordbruksföretagen som togs in årligen genom postenkät fram till slutet av 1990-talet.  \n\nPå uppdrag av Naturvårdsverket lät SCB på 1990-talet göra en omräkning av alla data på församlingsnivå till 1992 års administrativa indelning. På så sätt är data ur registren jämförbara över tid och kan kopplas till ett vektorskikt över 1992 års församlingsindelning. I dagsläget finns åker och betesmark inlagda och kan visas som förändringskartor över perioden 1951 till 1995. Syftet är att ge en snabb överblick över var i landet eller regionalt förändringar skett och i en upplösning på församlingsnivå. Lantbruksstatistiken innehåller ett stort antal variabler."},"dct:identifier":"be4c0a8c-7fe3-49d4-bb5c-bf10234dc281","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b1n0"},"dct:title":{"@language":"sv","@value":"Lantbruksstatistik - Lantbruksregistret"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:693d5203-e37a-a991-f85b-c1434c074e99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/betesmarker/Visualisering_LBR.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:cb731ae3-9b3f-1e3e-23bd-41b71b76a0eb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/visualisering_lbr/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:1dcaffc51838a6d3f6b7e14b3cc9eb1c6a59619c0abd4f9eff96ad4949ce049c"},{"@graph":[{"@id":"_:1f68b61132c11a94581ea708ad562288e13008434d7f41cd3a320a49f3cbd5e9_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden är en nationellt avgränsad och för analys anpassad version av den datamängd som EEA tillhandahåller för biogeografiska regioner enligt art- och habitatdirektivet (Biogeographical regions, Europe 2016, ver. 1). \n\nAnalysmasken för de biogeografiska regionerna togs fram genom att buffra regionerna ut till territorial gräns/ekonomisk zon. Gränsdragningen mellan regionerna följer i stort sett Naturvårdsverkets tidigare datamängd Biogeografiska regioner enligt art- och habitatdirektivet. För yttre gräns i hav har Sjöfartsverkets senast publicerade gräns för territorialvatten/ekonomisk zon använts. \n\nAnalysmask för biogeografiska regioner ersätter Naturvårdsverkets tidigare datamängd Biogeografiska regioner enligt art- och habitatdirektivet (identifierare för resursen: 1eb016c8-f362-42c0-b7a8-e34650396110 / filnamn: Biogeografiska_regioner_17juni2015.shp) som nu är borttagen från Naturvårdsverkets metadatakatalog. \n\nFör en mer detaljerad beskrivning av datamängden och dess framtagande, se Nationellt anpassad geodata för biogeografiska och marina regioner - Metodbeskrivning."}},{"@id":"_:1f68b61132c11a94581ea708ad562288e13008434d7f41cd3a320a49f3cbd5e9_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/56cd67a7-726a-436a-abbb-f0a2d16a7dfa","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:1b67a465-c447-b7a4-76f4-a8df70c98ff5"},{"@id":"urn:uuid:5155e5ee-a805-7871-dfee-f4a31efa3aa0"},{"@id":"urn:uuid:96450437-bb40-41b3-c702-8d24b6ef6070"},{"@id":"urn:uuid:b96e6591-804a-b15f-a7fd-42ca0c954b92"},{"@id":"urn:uuid:e74a0501-b5d7-f6a8-db8d-0f26be769e3f"},{"@id":"urn:uuid:f43e5ca8-c1b0-9dd6-32cd-5aa711f7502b"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Filnamn: SE_analysmask_biogeografiska_regioner \n\nDatamängden är en nationellt avgränsad och för analys anpassad version av den datamängd som EEA tillhandahåller för biogeografiska regioner enligt art- och habitatdirektivet (Biogeographical regions, Europe 2016, ver. 1). \n\nFör att fungera som en analysmask har de biogeografiska regionerna sträckts ut över marina områden till gränsen för ekonomisk zon/territorialgräns. De biogeografiska regionerna ”överlappar” således de marina regionerna i denna datamängd. \n\nAnalysmasken kan användas för att tex bestämma regiontillhörighet för olika förekomster av habitat och arter. Överlappen med de marina regionerna möjliggör att terrestra, strandnära habitat och arter som befinner sig på ”fel” sida av en hårt dragen gränslinje mellan biogeografiska och marina regioner kan fångas upp. \n\nUtpekande, uppföljning och rapportering av terrestra arter och naturtyper enligt art- och habitatdirektivet görs med hjälp av denna datamängd. \n\nFör analyser där boreala subregioner ska ingå, använd datamängden Analysmask för biogeografiska regioner med boreala subregioner. För regionanalys av marina arter och habitat, se datamängden Analysmask för marina regioner."},"dct:identifier":"56cd67a7-726a-436a-abbb-f0a2d16a7dfa","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-08"},"dct:provenance":{"@id":"_:1f68b61132c11a94581ea708ad562288e13008434d7f41cd3a320a49f3cbd5e9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:1f68b61132c11a94581ea708ad562288e13008434d7f41cd3a320a49f3cbd5e9_b1n0"},"dct:title":{"@language":"sv","@value":"Analysmask för biogeografiska regioner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:1b67a465-c447-b7a4-76f4-a8df70c98ff5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/SE_BiogeografiskaMarinaRegioner.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil; geopackage, ESRI-databas och metodbeskrivning"}},{"@id":"urn:uuid:5155e5ee-a805-7871-dfee-f4a31efa3aa0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/Nationellt%20anpassad%20geodata%20f%C3%B6r%20biogeografiska%20och%20marina%20regioner.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metodbeskrivning"}},{"@id":"urn:uuid:96450437-bb40-41b3-c702-8d24b6ef6070","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/br/SE_BR_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:b96e6591-804a-b15f-a7fd-42ca0c954b92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.eea.europa.eu/en/analysis/publications/report_2002_0524_154909"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till EEA:s hemsida med information om biogeografiska regioner"}},{"@id":"urn:uuid:e74a0501-b5d7-f6a8-db8d-0f26be769e3f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f43e5ca8-c1b0-9dd6-32cd-5aa711f7502b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}}],"@id":"urn:source:1f68b61132c11a94581ea708ad562288e13008434d7f41cd3a320a49f3cbd5e9"},{"@graph":[{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Förändrade områden delas in i två förändringsklasser som indikerar ökad biomassa/igenväxning; säker förändringsindikation och potentiell förändringsindikation med en minsta karteringsenhet på 0,5 ha. Förändringsklasserna ger en direkt indikation på styrkan och omfattningen av förändringen. Förändringsklassningen redovisas därför även som förändringskartor: andel säker förändringsindikation per analyserad öppen myr för olika områdes- eller regionsindelningar. Läs mer i \"Satellitbaserad övervakning av våtmarker - Nationell slutrapport första omdrevet\" som finns på www.myrar.se eller i miljödataportalen."}},{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/52a46ba0-45b7-4837-bbd4-4d18e2cd6940","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0c812448-96c4-be3f-b1f6-5ad267c58000"},{"@id":"urn:uuid:57f8c168-a08a-1adc-1297-70670f4f6bbc"},{"@id":"urn:uuid:bb8f6bd4-c023-e635-0d15-58ffa06dfd91"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Under perioden 2007-2017 utfördes \"Satellitbaserad övervakning av våtmarker\" i hela Sverige inom ramen för den nationella miljöövervakningen. Den satellitbaserade övervakningen är utformad för att upptäcka markanvändningsrelaterade förändringar i öppna myrar i form av ökad biomassa/igenväxning. Till förändringsanalysen för en tidsperiod används två set av satellitdata, ett från en äldre tidpunkt och ett från en senare tidpunkt. I norra Sverige analyserades tidsperioden 1990-2000 och i södra Sverige analyserades tidsperioden 1999-2009."},"dct:identifier":"52a46ba0-45b7-4837-bbd4-4d18e2cd6940","dct:issued":{"@type":"xsd:date","@value":"2022-04-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:provenance":{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b1n0"},"dct:title":{"@language":"sv","@value":"Nationell miljöövervakning: Satellitbaserad våtmarksövervakning, förändringskartor"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0c812448-96c4-be3f-b1f6-5ad267c58000","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/4ac40f/globalassets/media/publikationer-pdf/6900/978-91-620-6950-6.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Rapport"}},{"@id":"urn:uuid:57f8c168-a08a-1adc-1297-70670f4f6bbc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/vatmark/vatmark_nationell_t01t02_fkartor.20210319.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data"}},{"@id":"urn:uuid:bb8f6bd4-c023-e635-0d15-58ffa06dfd91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/om-miljoarbetet/miljoovervakning/programomraden/vatmark/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:25326053965492c47b40f811f38e68e108000d9a499a78980153de5d90d298b2"},{"@graph":[{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Svenska Marktäckedata baseras på klassning och tolkning av Landsat TM satellitdata med indata från huvudsakligen Lantmäteriets allmänna kartdatabaser (Terrängkarta, GGD, Vägkarta, Vegetationskarta), riksskogstaxeringsdata från SLU (Sveriges lantbruksuniversitet) samt uppgifter från SMHI (Sveriges meteorologiska och hydrologiska institut), SCB (Statistiska centralbyrån), SGU (Sveriges geologiska undersökning), Naturvårdsverket och Länsstyrelsens miljöenheter. Hur olika material användes vid karteringen framgår av produktbeskrivningens bilaga 1. Det finns även tillgång till information om vilka indata som använts vid produktionen (se metadata i produktbeskrivningen)."}},{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/C14735E6-6DB3-4BE5-B99D-96FABB98CCAA","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:18f89291-0749-f270-ccf9-de876f7851b7"},{"@id":"urn:uuid:873a41bf-2cd4-b855-b4cf-d6f450807da9"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Svenska Marktäckedata (SMD) redovisar vegetation och markanvändning med en indelning som bygger på EU:s klassificeringssystem för CORINE Land Cover; anlagda ytor, jordbruksmarker, skog och naturliga marker, våtmarker och vatten.  I databasen redovisas 58 klasser, minsta karteringsenhet är 1, 2, 5 eller 25 ha beroende på klass. Klasserna är ett resultat av användarbehov, EU-krav samt vad som var tekniskt och ekonomiskt möjligt att kartera. SMD finns tillgängligt som tre olika produkter:   •\tSMD, pixel. Produkten har en upplösning på 25*25 meter där de klasser som karterats genom klassning av satellitinformation kan ha den upplösningen. Klasser som tolkats visuellt av operatör har minsta karteringsenhet för aktuell klass, medan de klasser som hämtats från annat material har en upplösning som är beroende av utgångsmaterialet.   •\tSMD, raster. Produkten är i rasterformat och de ingående ytorna är automatiskt generaliserade till minsta karteringsenhet (1, 2, 5 eller 25 hektar). Olika klasser har olika minsta karteringsenhet, se bilaga 1 för detaljerad beskrivning. Vid generaliseringen tillämpades de regler som specificerats för arbetet med CORINE Land Cover   •\tSMD, vektor. Produkten är en vektorisering av ”Marktäckedata, raster”. Vektoriseringen är gjord så att vektorerna följer rastret exakt."},"dct:identifier":"C14735E6-6DB3-4BE5-B99D-96FABB98CCAA","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-09-23"},"dct:provenance":{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b1n0"},"dct:title":{"@language":"sv","@value":"Svenska Marktäckedata, basår 2000"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:18f89291-0749-f270-ccf9-de876f7851b7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/SMD/SMD_produktbeskrivning_20140627.pdf"},"dct:description":{"@language":"sv","@value":"Länk till dokument med produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning SMD (version 2014-06-27)"}},{"@id":"urn:uuid:873a41bf-2cd4-b855-b4cf-d6f450807da9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/SMD/"},"dct:description":{"@language":"sv","@value":"Nedladdningsbar information."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:26fbe45c0ced227838be36e6574f7384a3c7376df22f8895294e7beb4bc3977e"},{"@graph":[{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skogsstyrelsen publicerade en rikstäckande dikeskartering med 1 × 1 m upplösning i rasterformat i november 2021 (https://www.skogsstyrelsen.se/nyhetslista/digitala-dikeskartor-nytt-verktyg-i-klimatkampen/). Metria har fått tillhanda de dikena (från Skogsstyrelsen/SLU) i en vektoriserad version och uppdragits att attributsätta dem och tillgängliggöra dem i länsvisa linjeskikt samt uppdelat per huvudavrinningsområde. Med attributsättningen har dikena kategoriserats i följande klasser: vägdike, skogsdike, dike på öppen våtmark, dike på åkermark och övrigt dike. \n\nI ett senare projekt har Metria fått i uppdrag att vidare förädla dikesskiktet genom att öka konnektiviteten mellan dikessegmenten. Detta skikt är inte attributsatt."}},{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/3966381f-2157-45cc-b2f1-6694f884a0c6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:1543e6ea-7db9-d838-50d2-5ec4fd5c2e0c"},{"@id":"urn:uuid:81b0d47c-7f7e-73ae-d13b-ab59b34d2aeb"},{"@id":"urn:uuid:c823a8e3-daae-d725-7105-b424e87d7bab"},{"@id":"urn:uuid:de664346-1838-19d9-2b8c-045aece4d37b"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Skogsstyrelsens rikstäckande dikeskartering från november 2021 (rasterformat i 1 × 1 m upplösning) har attributsatts och är nu tillgänglig för nedladdning i vektorformat länsvis och per huvudavrinningsområde. Dikena har kategoriserats i följande fem klasser: vägdike, skogsdike, dike på öppen våtmark, dike på åkermark och övrigt dike med hjälp av buffrade vägytor (bearbetade av SCB 2020, ursprungligen från Trafikverket) och Nationella Marktäckedata (NMD) v1.1.\n\nDikeskarteringen finns även som en bearbetad version, där bearbetningen har syftat till att öka konnektiviteten i analysen och felaktiga diken i hav och sjöar har rensats bort. Data finns tillgängligt för nedladdning i vektorformat nationellt, skiktet är ej attributsatt.\n\nDet har konstaterats att många naturliga vattendrag fallit ut som diken i den ursprungliga dikesmodellen och att skiktet därför inte enbart ska antas innehålla antropogena diken. Detta är särskilt ett problem i fjällen men förekommer även frekvent i resten av Sverige. Rensning av dessa diken har inte ingått i bearbetningarna. Dikeskartan är heller inte komplett då diken som inte fångats upp av laserskanningen inte kunnat karteras. Täckdiken och vägtrummor ingår inte i skiktet."},"dct:identifier":"3966381f-2157-45cc-b2f1-6694f884a0c6","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b1n0"},"dct:title":{"@language":"sv","@value":"Diken - Bearbetning av Skogsstyrelsens rikstäckande dikeskartering"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:1543e6ea-7db9-d838-50d2-5ec4fd5c2e0c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Diken/Diken_Sverige/LEVERANS-PM%20Bearbetning%20av%20Skogsstyrelsens%20dikesskikt%20241202.pdf"},"dct:description":{"@language":"sv","@value":"[FORMAT]=pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverans-PM Diken Sverige"}},{"@id":"urn:uuid:81b0d47c-7f7e-73ae-d13b-ab59b34d2aeb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/diken/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Nationellt dikesskikt som WMS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:c823a8e3-daae-d725-7105-b424e87d7bab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Diken/"},"dct:description":{"@language":"sv","@value":"Diken finns tillgängliga länsvis och per huvudavrinningsområde."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Diken finns tillgängliga länsvis och per huvudavrinningsområde"}},{"@id":"urn:uuid:de664346-1838-19d9-2b8c-045aece4d37b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Diken/Diken_Sverige_konnektivitet/LEVERANS-PM%20Dikesskikt%20med%20f%C3%B6rb%C3%A4ttrad%20konnektivitet%20241202.pdf"},"dct:description":{"@language":"sv","@value":"[FORMAT]=pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverans-PM Diken Sverige konnektivitet"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:29030a3b6e5aa18a1d937628f21d097ce6dec76158414be722d693f649d4dbff"},{"@graph":[{"@id":"https://data.naturvardsverket.se/store/16/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"http://data.naturvardsverket.se/resources/03e6e0d2-9ff8-4234-8dba-1a1ef88cb1ad"},{"@id":"http://data.naturvardsverket.se/resources/0672b114-2058-4c00-bcc4-1c8949323f0f"},{"@id":"http://data.naturvardsverket.se/resources/08f53d26-0f94-419f-819a-f57fa59283a7"},{"@id":"http://data.naturvardsverket.se/resources/11bdc43a-17c9-4e72-8b7a-f4f9be1b0e18"},{"@id":"http://data.naturvardsverket.se/resources/12dacd90-1479-4a39-be35-087604ce2b11"},{"@id":"http://data.naturvardsverket.se/resources/13