397-0e27-72f8-d0b8f2321da2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-land-cover-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:c8e83464-fc7f-5def-275a-696ba0fdd420","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v0_x/NMD2023_Produktbeskrivning_Basskikt_NMD2023_och_NMD2018.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, sammanlagrad NMD2023 och NMD2018 v0.x"}},{"@id":"urn:uuid:d1728d36-de00-5ce4-b03c-7b023e65fb68","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/NMD_Produktf%C3%B6r%C3%A4ndring_och_Avvikelser.xlsx"},"dct:description":{"@language":"sv","@value":"Länk till plats för nedladdning av fil med beskrivning av förändringar och avvikelser."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av förändringar och avvikelser NMD2023 och NMD2018"}},{"@id":"urn:uuid:e7c4a440-2542-302e-3b8c-093ff364f8d0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v2_x/Kvalitetsutv%C3%A4rdering_33VWC_NMD2023bas_v2_0.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation med jämförelse av NMD2023 v2.0 med data från Riksskogstaxeringen och uppgifter som tolkats i flygbilder"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f77f37ca-c315-0def-e8b7-39f439795f2c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD2018_basskikt_ogeneraliserad_Sverige_v1_1.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data, ogeneraliserad version"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Basskikt NMD2018 v1.1"}},{"@id":"urn:uuid:f947afad-18fc-d416-7f05-8974dc06db2c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v0_x/NMD2023och2018_basskikt_v0_3.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Basskikt NMD2023 v0.3 sammanlagrad med 2018"}}],"@id":"urn:source:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088"},{"@graph":[{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning.\n\nFör Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9b8f56df-c0c0-41c6-baea-04931a361b66","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0d98ac7a-0bd4-b0b7-4746-cd65685e9202"},{"@id":"urn:uuid:0ff02ebb-1999-bd66-8627-cf070007147a"},{"@id":"urn:uuid:30d3c8ea-0c19-0f74-655b-cd6b8e776826"},{"@id":"urn:uuid:63f49d80-514f-b570-4425-ab98abbdfcdb"},{"@id":"urn:uuid:a0d06cc4-2be3-3a3c-68b7-b4e7bd971c1f"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Platser där det utförts mätningar av radioaktiva ämnen i olika typer av miljöprover såsom luft, vatten, sediment och biota, eller mätningar av gammastrålning vid marknivån."},"dct:identifier":"9b8f56df-c0c0-41c6-baea-04931a361b66","dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b1n0"},"dct:title":{"@language":"sv","@value":"Platser för miljöövervakning: Strålningsmätningar (SSM)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0d98ac7a-0bd4-b0b7-4746-cd65685e9202","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell,Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:0ff02ebb-1999-bd66-8627-cf070007147a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.stralsakerhetsmyndigheten.se/omraden/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"Länk till hemsida med mer information om datamängden och miljöövervakningen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Strålsäkerhetsmyndighetens hemsida"}},{"@id":"urn:uuid:30d3c8ea-0c19-0f74-655b-cd6b8e776826","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?cql_filter=(datahost_id=11)"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:63f49d80-514f-b570-4425-ab98abbdfcdb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_Stralningsmatningar/atomDatasetFeed-SE_EF_StnReg_Stralningsmatningar.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:a0d06cc4-2be3-3a3c-68b7-b4e7bd971c1f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_Stralningsmatningar/SE_EF_StnReg_Stralningsmatningar.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=GML"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:b50b6290f3a0a6816d00afa1a4ec603bdf75fed6c783ef95d56b6a4f779f45c1"},{"@graph":[{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är från de analyser som genomfördes för regeringsuppdraget \"Grön infrastruktur\" (M201/722/Nm). Landskapsanalysen har fokuserats på skogs- respektive odlingslandskapet inom fem olika terrestra naturtyper: tallskog, granskog, triviallövskog, ädellövskog, gräsmarker samt sjöar, vattendrag och kustvatten. Mosaiklandskapet behandlas översiktligt. Analysen utgår från den rumsliga fördelningen av värdefulla områden/värdekärnor och inkluderar även övriga landskapets potential som spridnings- och förstärkningsområden. Alla naturtyper har dock inte genomgått samma sorts analys. De kartor som presenteras baseras på en stor mängd data vilka sammanställts på delvis nytt sätt genom att även inkludera en grov uppskattning av arternas möjligheter att sprida sig genom vardagslandskapet."}},{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/FDCDEF24-C13A-411A-BE0E-FFF39722AB3C","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:585be7e4-bb32-ea41-a08e-7bfb2579a943"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Naturvårdsverket fick i mars 2012 i uppdrag att i samråd med flera andra myndigheter ”utarbeta en landskapsanalys och analysera relevanta styrmedel för att utveckla den gröna infrastrukturen” med syfte att klarlägga den geografiska och rumsliga fördelningen i landskapet av områden och strukturer som har särskild betydelse för den biologiska mångfalden, för deras långsiktiga bevarande och visa på behov av förstärkning och förbättrad kontakt. En slutsats är att det finns ett stort behov av dels ett verktyg, dels förbättrad styrning, för att kunna bedriva en sektorsövergripande översiktlig planering med åtgärder för grön infrastruktur, både nationellt och på landskapsnivå i Sverige. Inom uppdraget har arbetet med att analysera landskap och styrmedel för att stärka den gröna infrastrukturen påbörjats. Rapporten bör ses som ett första steg där ytterligare fördjupningar är nödvändiga för att stärka den gröna infrastrukturen. Vi pekar på ett antal områden som bör utredas närmare i ett nästa steg eftersom tiden för genomförande av uppdraget har medfört stora avgränsningar. Landskapsanalysen har fokuserats på skogs- respektive odlingslandskapet inom fem olika terrestra naturtyper: tallskog, granskog, triviallövskog, ädellövskog, gräsmarker samt sjöar, vattendrag och kustvatten. Mosaiklandskapet behandlas översiktligt. Analysen utgår från den rumsliga fördelningen av värdefulla områden/värdekärnor och inkluderar även övriga landskapets potential som spridnings- och förstärkningsområden. Alla naturtyper har dock inte genomgått samma sorts analys. De kartor som presenteras baseras på en stor mängd data vilka sammanställts på delvis nytt sätt genom att även inkludera en grov uppskattning av arternas möjligheter att sprida sig genom vardagslandskapet."},"dct:identifier":"FDCDEF24-C13A-411A-BE0E-FFF39722AB3C","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b1n0"},"dct:title":{"@language":"sv","@value":"Grön infrastruktur - analysresultat"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:585be7e4-bb32-ea41-a08e-7bfb2579a943","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/gron_infrastruktur/"},"dct:description":{"@language":"sv","@value":"Länk till den katalog där nedladdningsbara data finns. Data är delat i två grupper av tre zip-filer, som var för sig är relativt stora. Den första gruppen innehåller data i ArcGIS Geodatabase format, ZIP filer utan någon anmärkning i namnet: \"Gron_Infrastruktur_areal_andel_vardekarna.zip\", \"Gron_Infrastruktur_cost_analys.zip\", \"Gron_Infrastruktur_habitat.zip\". Den andra gruppen har filer i ShapeFile och GeoTIFF format, vilket anges som tillägg i namnet: \"Gron_Infrastruktur_areal_andel_vardekarna_SHAPE.zip\", \"Gron_Infrastruktur_cost_analys_GTIFF.zip\", \"Gron_Infrastruktur_habitat_GTIFF.zip\".\nI katalogen finns även ett dokument med en kortfattad beskrivning av data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:b5c7a680dad065ed9e4db5f05ecb61accd6a4b6c6c6191d902f7805094bdc406"},{"@graph":[{"@id":"_:b899f5b713064031f1a95260d9c334f6dd96f4e45676fb88232fd3c76fb44aa8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"De digitiserade stomkartorna finns i rasterformaten tif och jpg. Geokorrigeringen är endast gjord på tif-filerna och har i huvudsak skett automatiskt genom användande av rutnät med hörnkoordinater för kartorna. Geokorrigeringen är därför grov vilket användare måste vara uppmärksamma på."}},{"@id":"_:b899f5b713064031f1a95260d9c334f6dd96f4e45676fb88232fd3c76fb44aa8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"http://data.naturvardsverket.se/resources/11bdc43a-17c9-4e72-8b7a-f4f9be1b0e18","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:13e61431-6a48-7112-045a-78ca5c4e1aee"},{"@id":"urn:uuid:39d5bfd5-7535-972d-49a6-b6cdaa218ea9"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Stomkartor till generalstabens topografiska karta har geokorrigerats. \nStomkartor utgör ett historiskt källmaterial som visar läget och utbredningarna av tidigare odlingsmark, dvs. mark som brukats som åker eller slåttermark. \nStomkartorna består av transporter av storskaliga lantmäterikartor, storskiftes- och lagaskifteskartor, som klistrats ihop till en stomkarta. Den kronologiska spännvidden för underlagen är stor - från ca 1700 till ca 1900. Transporterna av lantmäterikartorna varierar i kvalitet och i hur tydligt markslagen åker och äng är redovisade. Våtmarker är som regel väl redovisade. \nStomkartbladen har tidigare enbart funnits som original hos Riksarkivet. Täckning är inte fullständig och kvalitén varierande. Enbart kartblad som i någon mån redovisar markanvändning har digitaliserats.\nDe kompletterar den Häradsekonomiska kartan som täcker stora delar av Götaland och Svealand och som finns georefererad och nedladdningsbar (https://geodata.naturvardsverket.se/nedladdning/haradskartan/).\nStomkartorna är indelade i två kartserier, Norra (Serie J2aa) och Södra verket (Serie J2ab). Norra verket har kartblad i skala 1:100 000 eller 1:200 000 och det Södra verket kartblad i skala 1:100 000. Volymerna i Norra verket består i allmänhet av fyra till sex del-kartblad som tillsammans utgör ett kartblad, medan volymerna i Södra verket oftast består av två till fyra del-kartblad."},"dct:identifier":"11bdc43a-17c9-4e72-8b7a-f4f9be1b0e18","dct:issued":{"@type":"xsd:date","@value":"2023-04-05"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-04-05"},"dct:provenance":{"@id":"_:b899f5b713064031f1a95260d9c334f6dd96f4e45676fb88232fd3c76fb44aa8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:b899f5b713064031f1a95260d9c334f6dd96f4e45676fb88232fd3c76fb44aa8_b1n0"},"dct:title":{"@language":"sv","@value":"Georefererade stomkartor till generalstabens topografiska karta"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:13e61431-6a48-7112-045a-78ca5c4e1aee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Stomkartor/"},"dct:description":{"@language":"sv","@value":"De digitiserade stomkartorna finns här i rasterformaten tif och jpg. Geokorrigeringen är endast gjord på tif-filerna och har i huvudsak skett automatiskt genom användande av rutnät med hörnkoordinater för kartorna."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:39d5bfd5-7535-972d-49a6-b6cdaa218ea9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Stomkartor/Leverans-PM%20Stomkartor.docx"},"dct:description":{"@language":"sv","@value":"[FORMAT]=docx"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverans-PM"}}],"@id":"urn:source:b899f5b713064031f1a95260d9c334f6dd96f4e45676fb88232fd3c76fb44aa8"},{"@graph":[{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning. \n\nFör Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/1b5a5c73-d653-4952-be0b-86629e663805","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:2d99ad30-1137-b007-82b2-8e39d6929ac7"},{"@id":"urn:uuid:2f256f03-350b-5f7a-73d7-21bc37a412ae"},{"@id":"urn:uuid:35149dec-48d2-fca4-5fd1-f0ada3a85d63"},{"@id":"urn:uuid:62d45543-8557-333f-aa5b-178882fecb6c"},{"@id":"urn:uuid:95d23d51-6779-fe2a-a32d-c865b4f81c78"},{"@id":"urn:uuid:e8eddc81-632d-fd16-2a25-50139bfe724d"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning."},"dct:identifier":"1b5a5c73-d653-4952-be0b-86629e663805","dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b1n0"},"dct:title":{"@language":"sv","@value":"Platser för miljöövervakning: Datavärdskap Naturdata fåglar och fjärilar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2d99ad30-1137-b007-82b2-8e39d6929ac7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Naturdata_faglar_fjarilar/SE_EF_StnReg_DV_Naturdata_faglar_fjarilar.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=GML 3.1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:2f256f03-350b-5f7a-73d7-21bc37a412ae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/miljoovervakning/"},"dct:description":{"@language":"sv","@value":"Länk till hemsida med mer information om datamängden och miljöövervakningen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:35149dec-48d2-fca4-5fd1-f0ada3a85d63","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Naturdata_faglar_fjarilar/atomDatasetFeed-SE_EF_StnReg_DV_Naturdata_faglar_fjarilar.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:62d45543-8557-333f-aa5b-178882fecb6c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-environmental-monitoring-facilities-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:95d23d51-6779-fe2a-a32d-c865b4f81c78","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?cql_filter=(datahost_id=12)"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:e8eddc81-632d-fd16-2a25-50139bfe724d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell,Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:b983348089a22bef2dc8e60c7601f6b7a4d8856d648ec984289e9ddfbd652933"},{"@graph":[{"@id":"_:ba4c026f932119dfcdfa4849ea1cfebe98998307e26e7febd80b36bd8a401d60_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Underlag för torvmark (egentligen organogena jordarter) togs fram genom att slå samman utvalda jordarterna från SGU:s jordartskarta grundlager med torvkarteringar från SLU och SU.\nFör historisk jordbruksmark användes tidigare framtaget arbetsmaterial av Metria där man extraherat områden som klassats som åker, betesmark och trädgårdar från Ekonomiska kartan. Förekomst av nuvarande åkermark enligt NMD (Nationella marktäckedata från Naturvårdsverket) identifierades i de fall denna låg utanför den ovan framtagna historiska jordbruksmarken.\nÅtervätning är ej lämplig på exploaterad mark och därför identifierades den exploaterade marken enligt NMD. Efter att ha buffrat den exploaterade marken med 25 meter exkluderades arealer i det ovan framtagna torv-skiktet som överlappades med denna buffer.\nEfter detta identifierades föreslagna återvätningsytor genom att filtrera fram de ställen av överlapp mellan torv och jordbruksmark enligt ovan som också hade en förekomst av minst en meter diken enligt Dikeskartan.\nSlutligen analyserades dessa föreslagna återvätningsytor mot kommunala fastigheter och endast de återvätningsytor som låg helt eller delvis (ibland till mycket liten del) inom kommunal mark valdes ut.\nEn mer fullständig beskrivning av indata samt beskrivning av Shapefilens attribut återfinns i: Leverans_PM_Potentiellt_atervatningsbara_objekt_kommunal_mark.pdf"}},{"@id":"_:ba4c026f932119dfcdfa4849ea1cfebe98998307e26e7febd80b36bd8a401d60_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://data.naturvardsverket.se/resources/1c9ce3aa-42cb-41f4-b667-9010257bef30","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:9f31fa24-bf09-27f6-d196-cfa5e0e411b7"},{"@id":"urn:uuid:aab1d3ae-2912-2cb8-b6ba-e304a76296c3"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Datamängden visar potentiella ytor på kommunens mark som skulle kunna vara relevant för hydrologiskt restaurering / återvätning och som skulle kunna bidra till utsläppsminskning av växthusgaser. Datamängden visar enbart ytorna som har förekomst av torv, är dikade och har varit eller fortfarande är jordbruksmark.\nYtorna har kategoriserats utifrån vilket län de ligger i, vilken kommun de tillhör, om de ligger helt eller delvis inom kommunens markinnehav, om ytan har historiskt varit jordbruksmark eller fortfarande är jordbruksmark samt hur mycket diken som ligger inom ytan.\nData finns tillgängligt för nedladdning i vektorformat nationellt."},"dct:identifier":"1c9ce3aa-42cb-41f4-b667-9010257bef30","dct:issued":{"@type":"xsd:date","@value":"2024-05-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-05-24"},"dct:provenance":{"@id":"_:ba4c026f932119dfcdfa4849ea1cfebe98998307e26e7febd80b36bd8a401d60_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ba4c026f932119dfcdfa4849ea1cfebe98998307e26e7febd80b36bd8a401d60_b1n0"},"dct:title":{"@language":"sv","@value":"Potentiellt återvätningsbara objekt på kommunens mark"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:9f31fa24-bf09-27f6-d196-cfa5e0e411b7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/atervatning/Potentiellt_atervatningsbara_objekt_kommunal_mark.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil"}},{"@id":"urn:uuid:aab1d3ae-2912-2cb8-b6ba-e304a76296c3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/atervatning/Leverans_PM_Potentiellt_atervatningsbara_objekt_kommunal_mark.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leveransbeskrivning"}}],"@id":"urn:source:ba4c026f932119dfcdfa4849ea1cfebe98998307e26e7febd80b36bd8a401d60"},{"@graph":[{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Våtmarksövervakningen baseras på satellitdata. Ytterligare information om ursprungsdata, datainsamlingsmetod, bearbetningssteg, kvalitetsutvärdering och aktualitet finns i rapporten ”Satellitbaserad övervakning av våtmarker - Nationell slutrapport första omdrevet. Naturvårdsverket, Rapport 6950. (Hahn, N., Wester, K. & Gunnarsson, U., 2021)”."}},{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/51876246-04bf-4cd2-ac31-6711b5895405","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:7bc47d69-322c-fda1-bcd3-1ef3a7002910"},{"@id":"urn:uuid:7f394bb6-730b-989f-440a-6939fa920bff"},{"@id":"urn:uuid:c1cb5414-da8f-58cb-3f66-0b1b3035c20c"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Under perioden 2007-2017 utfördes \"Satellitbaserad övervakning av våtmarker\" i hela Sverige inom ramen för den nationella miljöövervakningen. Den satellitbaserade övervakningen är utformad för att upptäcka markanvändningsrelaterade förändringar i öppna myrar i form av ökad biomassa/igenväxning. Till förändringsanalysen för en tidsperiod används två set av satellitdata, ett från en äldre tidpunkt och ett från en senare tidpunkt. I norra Sverige analyserades tidsperioden 1990-2000 och i södra Sverige analyserades tidsperioden 1999-2009."},"dct:identifier":"51876246-04bf-4cd2-ac31-6711b5895405","dct:issued":{"@type":"xsd:date","@value":"2022-04-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-26"},"dct:provenance":{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b1n0"},"dct:title":{"@language":"sv","@value":"Nationell miljöövervakning: Satellitbaserad våtmarksövervakning, förändringsklassning"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:7bc47d69-322c-fda1-bcd3-1ef3a7002910","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/4ac40f/globalassets/media/publikationer-pdf/6900/978-91-620-6950-6.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Rapport"}},{"@id":"urn:uuid:7f394bb6-730b-989f-440a-6939fa920bff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/om-miljoarbetet/miljoovervakning/programomraden/vatmark/"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets hemsida"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:c1cb5414-da8f-58cb-3f66-0b1b3035c20c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Vatmark/vatmark_nationell_t01t02_fklass.20210319.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:bafbf7a70ad422ccf15bf6d86f5431d7e918658e487def2cb1bb152ee7578b90"},{"@graph":[{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av unionslistade arter under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."}},{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/887f08b3-0239-4a64-a54a-940e19bd6c29","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:071019d5-c8d2-9b6c-e111-4948f9b6d670"},{"@id":"urn:uuid:0a1d40b8-5b7a-ec07-803f-659bf73279e4"},{"@id":"urn:uuid:0bfe3502-2ed9-7628-e113-e4ac23e79fa9"},{"@id":"urn:uuid:0f553d6b-4b3f-d051-46c2-49fdc60a9559"},{"@id":"urn:uuid:17a541d7-1112-3171-c18e-1f67ff338257"},{"@id":"urn:uuid:64cdc69b-6fb5-77e1-c733-44c4d4e58236"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av listade arter under en tidsperiod relevant för rapporteringen 2019 (2015-2018). Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."},"dct:identifier":"887f08b3-0239-4a64-a54a-940e19bd6c29","dct:issued":{"@type":"xsd:date","@value":"2019-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b1n0"},"dct:title":{"@language":"sv","@value":"Invasiva främmande arter, rapportering 2019: Impatiens glandulifera"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:071019d5-c8d2-9b6c-e111-4948f9b6d670","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=se/eu/ias/envxkngww/IAS_Invasive_Alien_Species_SE.xml"},"dct:description":{"@language":"sv","@value":"Information on the reporting"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information on the reporting"}},{"@id":"urn:uuid:0a1d40b8-5b7a-ec07-803f-659bf73279e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_IAS_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata som ingår i rapporteringen om Invasiva främmande arter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:0bfe3502-2ed9-7628-e113-e4ac23e79fa9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/ows?layers=SD.SpeciesDistribution.ImpatiensGlandulifera"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:0f553d6b-4b3f-d051-46c2-49fdc60a9559","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Sa-mar-miljon/Vaxter-och-djur/Frammande-arter/Invasiva-frammande-arter/"},"dct:description":{"@language":"sv","@value":"Webbsida med information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:17a541d7-1112-3171-c18e-1f67ff338257","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:64cdc69b-6fb5-77e1-c733-44c4d4e58236","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:bbc4f58c832bb6dbebb2a5f5f23ebb3a2e85ff75f17134b24738fd427bd6f10c"},{"@graph":[{"@id":"_:bdd9233d8892d9b039d7d214074d0707661e5f18d811082c481ab7f2630aa183_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Polygonerna representerar beräkningar av buller från väg- och tågtrafik, vindkraftverk och flygplatser. Beräkningarna är utförda med beräkningsmetoden Nord2000 och bygger på underlag från Trafikverket, Energimyndigheten (vindbrukskollen) och Transportstyrelsen. Beräkningarna genomfördes under 2024, och underlagsdata representerar trafikförhållanden med mera under 2022 (2017 för vägtrafik). Attributen L0622MIN och L0622MAX motsvarar övre och under gräns för den årsekvivalenta A-vägda ljudtrycksnivån mellan kl 06 och 22 i enheten dB. Ljudtrycksnivån är beräknad för väderförhållanden motsvarande tidsperioden 2013 – 2022.\n\nRastret representerar beräkningar av buller från väg- och tågtrafik, vindkraftverk och flygplatser. Beräkningarna är utförda med beräkningsmetoden Nord2000 och bygger på underlag från Trafikverket, Energimyndigheten (vindbrukskollen) och Transportstyrelsen. Beräkningarna genomfördes under 2024, och underlagsdata representerar trafikförhållanden med mera under 2022 (2017 för vägtrafik). Band 1 i rastret består av flyttal som motsvarar den årsekvivalenta A-vägda ljudtrycksnivån mellan kl 06 och 22 i enheten dB. Ljudtrycksnivån är beräknad för väderförhållanden motsvarande tidsperioden 2013 – 2022."}},{"@id"