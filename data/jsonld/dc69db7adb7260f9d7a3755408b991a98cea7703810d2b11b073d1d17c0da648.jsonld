b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:ec1f68900289018457e917d62ce6bf514500f33bc785ac47306f31634f01909d"},{"@graph":[{"@id":"_:ef88217f15ea8083e8969830336d645316be41e68816c3a15ba72e1032fc2b19_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Analysmask för boreala subregioner motsvarar Analysmask för biogeografiska regioner, förutom att boreal region i denna datamängd är uppdelad i tre subregioner: Nordvästboreal, Sydostboreal, Boreonemoral. \n\nSom underlag för indelningen i subregioner ligger en av SLU Artdatabanken digitaliserad och generaliserad tolkning av vegetationszoner enligt Ahti et al (1968): Vegetation zones and their sections in northwestern Europe. \n\nFör en mer detaljerad beskrivning, se Nationellt anpassad geodata för biogeografiska och marina regioner - Metodbeskrivning."}},{"@id":"_:ef88217f15ea8083e8969830336d645316be41e68816c3a15ba72e1032fc2b19_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/c5a0d2b7-7784-4e3d-98fa-19adfc2f1395","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:15d6d349-a20f-308f-863e-2e8f63b87eb8"},{"@id":"urn:uuid:241d31dc-6f12-7238-7613-9c69c011f5d1"},{"@id":"urn:uuid:573070bb-01bb-1f54-2157-022d49a5eb6d"},{"@id":"urn:uuid:61097129-0f3f-8879-88c5-b914d59687f0"},{"@id":"urn:uuid:8225d850-a617-3df9-10ce-8936f7e63ea7"},{"@id":"urn:uuid:e0fe636c-d71b-78d0-db99-b2ad8146a2b3"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Filnamn: SE_analysmask_biogeoreg_boreala_subreg \n\nDatamängden innehåller samma information som datamängden Analysmask för biogeografiska regioner, med undantag för att den boreala regionen har delats in i subregioner: Nordvästboreal, Sydostboreal, Boreonemoral. \n\nDatamängden är en nationellt avgränsad och för analys anpassad version av den datamängd som EEA tillhandahåller för biogeografiska regioner enligt art- och habitatdirektivet (Biogeographical regions, Europe 2016, ver. 1). \n\nFör att fungera som en analysmask har de biogeografiska regionerna sträckts ut över marina områden till gränsen för ekonomisk zon/territorialgräns. De biogeografiska regionerna ”överlappar” således de marina regionerna i denna datamängd. \n\nAnalysmasken kan användas för att tex bestämma regiontillhörighet för olika förekomster av habitat och arter. Överlappen med de marina regionerna möjliggör att terrestra, strandnära habitat och arter som befinner sig på ”fel” sida av en hårt dragen gränslinje mellan biogeografiska och marina regioner kan fångas upp. \n\nFör analys där boreala subregioner inte ska ingå, använd datamängden Analysmask för biogeografiska regioner. För regionanalys av marina arter och habitat, se datamängden Analysmask för marina regioner."},"dct:identifier":"c5a0d2b7-7784-4e3d-98fa-19adfc2f1395","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-08"},"dct:provenance":{"@id":"_:ef88217f15ea8083e8969830336d645316be41e68816c3a15ba72e1032fc2b19_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ef88217f15ea8083e8969830336d645316be41e68816c3a15ba72e1032fc2b19_b1n0"},"dct:title":{"@language":"sv","@value":"Analysmask för biogeografiska regioner med boreala subregioner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:15d6d349-a20f-308f-863e-2e8f63b87eb8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/br/SE_BR_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:241d31dc-6f12-7238-7613-9c69c011f5d1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.eea.europa.eu/en/analysis/publications/report_2002_0524_154909"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till EEA:s hemsida med information om biogeografiska regioner"}},{"@id":"urn:uuid:573070bb-01bb-1f54-2157-022d49a5eb6d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/Nationellt%20anpassad%20geodata%20f%C3%B6r%20biogeografiska%20och%20marina%20regioner.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metodbeskrivning"}},{"@id":"urn:uuid:61097129-0f3f-8879-88c5-b914d59687f0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:8225d850-a617-3df9-10ce-8936f7e63ea7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:e0fe636c-d71b-78d0-db99-b2ad8146a2b3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/SE_BiogeografiskaMarinaRegioner.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil; geopackage, ESRI-databas och metodbeskrivning"}}],"@id":"urn:source:ef88217f15ea8083e8969830336d645316be41e68816c3a15ba72e1032fc2b19"},{"@graph":[{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av unionslistade arter under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."}},{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/f0be67ee-4c6a-4103-a443-1530d2a31411","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:20a3a8b9-9c58-6105-7289-ffde804755a4"},{"@id":"urn:uuid:300dfffb-7518-4453-b333-0c2d32b678b9"},{"@id":"urn:uuid:368196e7-cce5-e58c-0a24-e265f0009486"},{"@id":"urn:uuid:7aa95b73-1e95-8806-6056-88bb332dc9e2"},{"@id":"urn:uuid:8db025db-5f1e-6e20-c128-14f16a3551ec"},{"@id":"urn:uuid:c328fa89-2ece-dbd5-a5c5-8f79a28574a3"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av listade arter under en tidsperiod relevant för rapporteringen 2019 (2015-2018). Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."},"dct:identifier":"f0be67ee-4c6a-4103-a443-1530d2a31411","dct:issued":{"@type":"xsd:date","@value":"2019-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f