ivning."}},{"@id":"_:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9B0E1F98-B945-492F-81B9-9701D3907E76","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:7794fb95-b878-b301-fea2-f6c0da64246a"},{"@id":"urn:uuid:b77c43db-3e7e-32f5-3f66-f0f82096e4a7"},{"@id":"urn:uuid:e4fbfda6-9935-8a2d-cfba-71f1e41dcdbe"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Våtmarksinventeringens (VMI) objekt, troligen vektoriserat 2006, men kallas oftast version 2010. Data innehåller ytorna (objektsgränserna) och centralpunkterna med ett ID (LOID) för alla objekt samt grundläggande attributdata. \n\nSkala 1:250 000. På Sverigenivå (1:6 400 000) och ner till 1:250 000 visas endast inventeringar > 1000 HA. Under 1:250 000 visas samtliga inventerade våtmarksytor oavsett storlek.\n\nOBS: Datamängden innehåller fel. Se fördjupad text om restriktioner och användbarhetsbegränsningar.\n\nSamlat underlag finns i Naturvårdsverkets ärende NV-10059-11."},"dct:identifier":"9B0E1F98-B945-492F-81B9-9701D3907E76","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d_b1n0"},"dct:title":{"@language":"sv","@value":"Naturtyper och biotoper: Våtmarksinventeringen, VMI – Objekt 2010"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:7794fb95-b878-b301-fea2-f6c0da64246a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/vatmarksinventering/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS) som visar ytor, punkter och LOID."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:b77c43db-3e7e-32f5-3f66-f0f82096e4a7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Documents/publikationer/978-91-620-5925-5.pdf"},"dct:description":{"@language":"sv","@value":"Länk till rapport med information om våtmarksinventeringen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Rapport"}},{"@id":"urn:uuid:e4fbfda6-9935-8a2d-cfba-71f1e41dcdbe","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/vmi/ursprunglig_digitalisering"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av länsvisa filer"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets nedladdningsyta"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:9a830d2be92100cb6f7b90a962380705c0e6b19df35d3244839fc427bf16b94d"},{"@graph":[{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skikten visar landskapsanalyser utifrån kända skogliga värdekärnor inom och utanför formellt skyddade områden i den boreala regionen framtagna med hjälp av geografiska analyser. De län som omfattats av projektet är Dalarna, Gävleborg, Jämtland, Norrbotten, Värmland, Västerbotten och Västernorrland. Målet med landskapsanalysen har varit att ta fram kunskapsunderlag på en nationell nivå som ska ge stöd i arbetet med revideringen av den nationella strategin för formellt skydd av skog men även för arbetet med grön infrastruktur. \n\nProjektets utgångspunkt har varit att utveckla objektiva metoder med ett dataunderlag som är jämförbart över länsgränser för att dels identifiera landskapsavsnitt med höga andelar skogliga värdekärnor och dels för att möjliggöra liknande analyser till olika typer av uppföljningar. \n\nFör mer information se beskrivning i projektrapport."}},{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.59208 69.05994,24.17741 69.05994,24.17741 58.53721,10.59208 58.53721,10.59208 69.05994))"}},{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/69655223-a8f3-475c-bf7f-5c0354cd232b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:065a4e48-0ee3-e13b-07c8-fe190de3f14b"},{"@id":"urn:uuid:d61f4255-db04-4b1b-c116-ed27f5c2826e"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data har producerats inom projektet ”Analyser av skogliga värdetrakter och nätverk i den boreala regionen” där syftet har varit att genomföra landskapsanalyser utifrån kända skogliga värdekärnor inom och utanför formellt skyddade områden i den boreala regionen med hjälp av geografiska analyser. De län som omfattats av projektet är Dalarna, Gävleborg, Jämtland, Norrbotten, Värmland, Västerbotten och Västernorrland. \n\nProjektets användare/kravställare har varit Naturvårdsverket och Länsstyrelserna i Dalarna, Gävleborg, Jämtland, Norrbotten, Värmland, Västerbotten och Västernorrland.\n\nMaterial är ett arbetsmaterial."},"dct:identifier":"69655223-a8f3-475c-bf7f-5c0354cd232b","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b1n0"},"dct:title":{"@language":"sv","@value":"Landskapsanalys av skogliga värdekärnor i boreal region - arbetsmaterial"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:065a4e48-0ee3-e13b-07c8-fe190de3f14b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/skog/Slutrapport_Landskapsanalys_av_skogliga_vardekarnor_i_boreal_region.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar rapport."}},{"@id":"urn:uuid:d61f4255-db04-4b1b-c116-ed27f5c2826e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/skog/analys_boreal_region.zip"},"dct:description":{"@language":"sv","@value":"Länk till ftp-site med nedladdningsbar rapport."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:9fec383dbf1c4aa401056239135112c74fb07b68c31f9bb862fb9ef42239c531"},{"@graph":[{"@id":"_:a0efde34d845e9b7fc8d7f05509cbb5c9977223173cecdd40becde802d30a96d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Produkten potentiella lövskogar karterar, med hjälp av satellitdata och referenspunkter i fält, andelen lövskog i skogsmark. Utifrån andelen lövskog klassas skogen in i befintlig lövskog (> 70 % löv) och utvecklingsmark (20 - 70 % löv).\nI utvecklingsområden har komplettering med information som kan påverka möjligheterna för lövskogsutveckling lagts till. Denna information är markfuktighet, produktivitet och trädhöjd. Vidare finns även information om hur representativ en lövskogsyta är i landskapet.\nhttps://geodata.naturvardsverket.se/nedladdning/potentiella_lovskogar/"}},{"@id":"_:a0efde34d845e9b7fc8d7f05509cbb5c9977223173cecdd40becde802d30a96d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"http://data.naturvardsverket.se/resources/5bcfada7-690f-42ff-b948-a32c0ea9bd5c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0591ba06-ffea-cfbb-62af-55df3634fd36"},{"@id":"urn:uuid:1939aa6a-b37c-31d5-3506-326c452c592d"},{"@id":"urn:uuid:cf030efd-81f1-2ffb-4519-5aa808e334cf"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Framtida potentiella lövskogar är ett projekt med målet att identifiera potentiella utvecklingsområden för lövskog vilket kan främja arbetet med både grön infrastruktur och värdetrakter inom både planering och beslutsfattande. Syftet med projektet är att i samband med att kartera dessa områden, presentera dessa som digitala tjänster som riktar sig till användare på både informations- och expertnivå. \nDetta är en del i en förstudie där kartinformationen tagits fram för två områden, ett i södra Sverige och ett i Västernorrland. \nDataseten som tagits fram har tagits fram med stöd av en referensgrupp med deltagare från Naturvårdsverket, Skogsstyrelsen och representanter för markägare."},"dct:identifier":"5bcfada7-690f-42ff-b948-a32c0ea9bd5c","dct:issued":{"@type":"xsd:date","@value":"2022-05-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-11"},"dct:provenance":{"@id":"_:a0efde34d845e9b7fc8d7f05509cbb5c9977223173cecdd40becde802d30a96d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a0efde34d845e9b7fc8d7f05509cbb5c9977223173cecdd40becde802d30a96d_b1n0"},"dct:title":{"@language":"sv","@value":"Framtida potentiella lövskogar - förstudie"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0591ba06-ffea-cfbb-62af-55df3634fd36","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/potentiella_lovskogar/Anvandarstod_potentiella_lovskogar.pdf"},"dct:description":{"@language":"sv","@value":"Användarstöd framtida potentiella lövskogar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Användarstöd: Framtida potentiella lövskogar"}},{"@id":"urn:uuid:1939aa6a-b37c-31d5-3506-326c452c592d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/potentiella_lovskogar/GPT_potentella_lovskogar.zip"},"dct:description":{"@language":"sv","@value":"Nedladdning data framtida potentiella lövskogar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:cf030efd-81f1-2ffb-4519-5aa808e334cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/potentiella_lovskogar/Leverans-PM_potentiella_lovskogar.pdf"},"dct:description":{"@language":"sv","@value":"Leverans-PM framtida potentiella lövskogar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Leverans-PM"}}],"@id":"urn:source:a0efde34d845e9b7fc8d7f05509cbb5c9977223173cecdd40becde802d30a96d"},{"@graph":[{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Detta ska fyllas inom kort."}},{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/0672b114-2058-4c00-bcc4-1c8949323f0f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:118e127d-1cd0-6066-4c87-9734e8ad6ff2"},{"@id":"urn:uuid:43809513-4d40-0133-94a5-ad26e34b2cf2"},{"@id":"urn:uuid:575346aa-7d1b-6519-a861-c109bfc44c40"},{"@id":"urn:uuid:9aed60f3-a457-b311-11e3-a8e182159124"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Fågel utbredningsområde 2008-2013. Data rapporterad enligt Fågel direktivet 2013."},"dct:identifier":"0672b114-2058-4c00-bcc4-1c8949323f0f","dct:issued":{"@type":"xsd:date","@value":"2019-09-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b1n0"},"dct:title":{"@language":"sv","@value":"Fågel utbredningsområde, rapportering enligt fågel direktivet 2013"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:118e127d-1cd0-6066-4c87-9734e8ad6ff2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_BIRD_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:43809513-4d40-0133-94a5-ad26e34b2cf2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:575346aa-7d1b-6519-a861-c109bfc44c40","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd-fagel/ows?layers=SD.FaglarsUtbredningsomrade.2013"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:9aed60f3-a457-b311-11e3-a8e182159124","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Stod-i-miljoarbetet/Rattsinformation/Direktiv/EU-register---forfattningar-inom-miljobalkens-omrade/Fageldirektivet/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:a1c63c4517a2fc4b4a35f92b8d2472dcbd7b012cfb93f383e70a64312d8450db"},{"@graph":[{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från laserdata (Nationella höjdmodellens punktmoln från Lantmäteriet) har ett objektshöjdsraster (mellan 0,5 och 45 m) med en pixelstorlek på 2 m tagits fram. Från detta har det framställts objektshöjdsskikt med höjder mellan 0,5 och 5 m respektive över 5 m, med en geometrisk upplösning på 10 m.\n \nTäckningsgradsskikt har tagits fram genom att på objektshöjdsskiktet, med 2 m pixelstorlek, göra en statistisk filteranalys, inom ett område som är 10 x 10 m. Slutresultatet visar objekttätheten i procent, med en pixelstorlek på 10 m. \n\nIngående produktionsmoment är att i punktmolnet dels hantera flygstråk som saknar markklass och dels att filtrera bort dis, samt överlapp mellan flygstråk. Därefter skapas tiles med buffertzoner, brus reduceras och höjd över havet görs till höjd över marken. Buffertzonerna tas därefter bort för att skapa jämna punktmolnsgrid som sedan rastreras till 2 x 2 m. Verktyg som används i produktionen är LAStools och Erdas Imagine."}},{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/ced868cd-7081-421e-806a-98374431b666","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:024c2043-22c7-72bb-2b9b-84ea4022169b"},{"@id":"urn:uuid:0a58f4a9-ce59-d066-a0ef-a1683610a504"},{"@id":"urn:uuid:0cabf5a8-b6b5-b056-d97d-3ebe837cb955"},{"@id":"urn:uuid:1678d748-81c4-e7a6-10db-6f19694fd969"},{"@id":"urn:uuid:357228f1-e344-3a5a-936c-1dd0042a73cf"},{"@id":"urn:uuid:48fdce83-3099-5dd0-5f60-369e784cf3f4"},{"@id":"urn:uuid:4de1d919-1fb9-fdc8-f5b9-4d7754dc8a3a"},{"@id":"urn:uuid:68687839-01c3-b5f6-81d2-fec2ddddafb0"},{"@id":"urn:uuid:8f472720-e057-bbb5-2117-d2671ec814c3"},{"@id":"urn:uuid:9c6ca3fd-d248-51b3-fbfe-24a43dfcf09c"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"NMD objekthöjd och -täckning är ett tilläggsskikt inom Nationella Marktäckedata. Detta tilläggsskikt består av fyra separata rasterskikt i 10 m upplösning:\n\n- Objekthöjder mellan 0,5 till 5 m\n- Objekthöjder 5 till 45 m\n- Täckningsgrad av objekthöjder mellan 0,5 till 5 m\n- Täckningsgrad av objekthöjder mellan 5 till 45 m\n\nNMD består av en baskartering i flera hierarkiska nivåer. Karteringen är i rasterformat med 10 meters upplösning och med en minsta karteringsenhet ned till 0,01 hektar. Utöver baskarteringen ingår följande tilläggsskikt: \n\n- objekthöjd och -täckning \n- produktivitet (skoglig produktivitet) \n- markanvändning \n- låg fjällskog (endast 2018, därefter inkluderat i basskiktet)\n\nFör baskartering och övriga tilläggsskikt finns separata metadatabeskrivningar och nedladdningstjänster."},"dct:identifier":"ced868cd-7081-421e-806a-98374431b666","dct:issued":{"@type":"xsd:date","@value":"2020-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-07-04"},"dct:provenance":{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata, tilläggsskikt objekthöjd och objekttäckning"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:024c2043-22c7-72bb-2b9b-84ea4022169b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Objekt_tackning_hojdintervall_5_till_45_v1_3.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar data: Täckningsgrad av objekthöjder mellan 5 – 45 m"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Täckningsgrad av objekthöjder mellan 5 – 45 m, 2018"}},{"@id":"urn:uuid:0a58f4a9-ce59-d066-a0ef-a1683610a504","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Objekt_hojd_intervall_0_5_till_5_v1_3.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar data: Objekthöjder mellan 0,5 – 5 m"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Objekthöjder mellan 0,5 – 5 m, 2018"}},{"@id":"urn:uuid:0cabf5a8-b6b5-b056-d97d-3ebe837cb955","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktbeskrivning_tillaggsskikt_Objekthojd_objekttackning_v1_0.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning objekthöjd, objekttäckning, 2023"}},{"@id":"urn:uuid:1678d748-81c4-e7a6-10db-6f19694fd969","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Objekt_tackning_hojdintervall_0_5_till_5_v1_3.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar data: Täckningsgrad av objekthöjder mellan 0,5 – 5 m"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Täckningsgrad av objekthöjder mellan 0,5 – 5 m, 2018"}},{"@id":"urn:uuid:357228f1-e344-3a5a-936c-1dd0042a73cf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Produktforandring_och_Avvikelser.xlsx"},"dct:description":{"@language":"sv","@value":"Länk till dokument med beskrivning av produktförändringar och avvikelser."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av förändringar och avvikelser"}},{"@id":"urn:uuid:48fdce83-3099-5dd0-5f60-369e784cf3f4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD_Produktbeskrivning_tillaggsskikt_Objekthojd_objekttackning.pdf"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, 2018"}},{"@id":"urn:uuid:4de1d919-1fb9-fdc8-f5b9-4d7754dc8a3a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:description":{"@language":"sv","@value":"Länk till mer information på Naturvårdsverkets hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:68687839-01c3-b5f6-81d2-fec2ddddafb0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Tillaggsskikt_Objekthojd_objekttackning_v1_0.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning objekthöjd och objekttäckning (4 skikt), 2023"}},{"@id":"urn:uuid:8f472720-e057-bbb5-2117-d2671ec814c3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Objekt_metadata_flygstraksdatum_v1_3.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av metadata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning - metadata, 2018"}},{"@id":"urn:uuid:9c6ca3fd-d248-51b3-fbfe-24a43dfcf09c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Objekt_hojd_intervall_5_till_45_v1_3.zip"},"dct:description":{"@language":"sv","@value":"Objekthöjder mellan 5 – 45 m"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Objekthöjder mellan 5 – 45 m, 2018"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:a21ee2ab3d3620656e6e59930d01c61caba687c97c18421bf21092915905dd50"},{"@graph":[{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Version 2018: Tilläggsskiktet skoglig produktivitet har producerats genom att kombinera Sentinel-2 satellitdata med information från laserskanningen och annan kartdata. Satellitdatabaserad förändringsinformation och klassning, vägs samman med trädhöjd och trädkvot skapade från laserdata, samt annan kartdata visande sankmarker, berg och hyggen. För fjällnära skogsmark används även underlaget temperatursumma. Temperatursumma är en kombination av höjd över havet och latitud och används för stratifiering av höjdlägen och markens sannolikhet för att vara produktiv. Resultatet från sammanvägningen överlagrades med områden där NMD basskikt visar någon av skogsklasserna, så att tilläggsskiktet enbart finns inom skogsmark i NMD. För klassning av improduktiv skogsmark har träningsytorna hämtats från Naturvårdsverkets produkt KNAS.  \n\nVersion2023: Tilläggsskiktet skoglig produktivitet har skapats med hjälp av maskininlärning i kombination med laserdata, skogliga grunddata, markfuktighetsdata och temperatursumma."}},{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9c3310f6-73d5-4ae3-865f-0e16e03d44c8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:189d41da-6d32-62df-7fcf-cadaf0f79727"},{"@id":"urn:uuid:42e9a607-66d1-3cc9-4ef6-75a28ea1ee4e"},{"@id":"urn:uuid:52b7d6a7-9fcd-5cb9-4881-60da736e1e50"},{"@id":"urn:uuid:6909fd24-fde9-d2a7-c4a7-18d3e5356d42"},{"@id":"urn:uuid:d9946dbf-edcd-7173-aa64-bd2cdc527df7"},{"@id":"urn:uuid:e9ffcdc7-85f1-694d-acf5-57a08b56210e"},{"@id":"urn:uuid:fbab9096-f584-452f-e611-08bea56507f0"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Produkten redovisar uppdelningen av produktiv och improduktiv skogsmark inom vad som är karterat som skogsmark i NMDs basskikt. Skogsmark, produktiv skog och improduktiv skog som tas fram i NMD är i enlighet med definitionerna i skogsvårdslagen (och FAO) med undantag av att NMD även karterar skog i jordbruks- och bebyggda områden som skogsmark.\n\nData har producerats vid två tillfällen, i samband med NMD 2018 och NMD 2023. För information om skillnader mellan produkterna hänvisas till produktbeskrivningen för Nationella marktäckedata 2023 – tilläggsskikt skoglig produktivitet.\n\nEftersom NMD2023 ännu inte har rikstäckande täckning levereras en sammanslagen produkt, där produktivitetsskiktet från NMD2018 används som komplement i de områden där NMD2023 saknar täckning."},"dct:identifier":"9c3310f6-73d5-4ae3-865f-0e16e03d44c8","dct:issued":{"@type":"xsd:date","@value":"2020-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-03"},"dct:provenance":{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata: tilläggsskikt produktivitet"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:189d41da-6d32-62df-7fcf-cadaf0f79727","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/lc-nmd/ows?layers=LC.LandCoverRaster.Produktivitet"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till WMS-tjänst med aktuella data."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS; tilläggsskikt produktivitet NMD2018 v1.1"}},{"@id":"urn:uuid:42e9a607-66d1-3cc9-4ef6-75a28ea1ee4e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:description":{"@language":"sv","@value":"Länk till mer information på Naturvårdsverkets hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:52b7d6a7-9fcd-5cb9-4881-60da736e1e50","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/NMD_Produktf%C3%B6r%C3%A4ndring_och_Avvikelser.xlsx"},"dct:description":{"@language":"sv","@value":"Länk till dokument med beskrivning av produktförändringar och avvikelser."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av förändringar och avvikelser NMD2018 och NMD2023"}},{"@id":"urn:uuid:6909fd24-fde9-d2a7-c4a7-18d3e5356d42","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktivitet_v1_0.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning tilläggsskikt produktivitet NMD2023 sammanslagen med 2018"}},{"@id":"urn:uuid:d9946dbf-edcd-7173-aa64-bd2cdc527df7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD_Produktbeskrivning_tillaggsskikt_Produktivitet.pdf"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning tilläggsskikt produktivitet NMD2018 v1.1"}},{"@id":"urn:uuid:e9ffcdc7-85f1-694d-acf5-57a08b56210e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktbeskrivning_till%C3%A4ggsskikt_Skoglig_Produktivitet.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning tilläggsskikt produktivitet NMD2023 sammanslagen med 2018"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:fbab9096-f584-452f-e611-08bea56507f0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD_Produktivitet_v1_1.zip"},"dct:description":{"@language":"sv","@value":"Länk till ftp-site för nedladdning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning tilläggsskikt produktivitet NMD2018"}}],"@id":"urn:source:a2e0e403fcce91fe59a1548cc2eca261aee4f86d05b19b344a64968f2532b7de"},{"@graph":[{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Naturvårdsverket tog i början av 1990-talet fram Myrskyddplan för Sverige och planen publicerades 1994. Naturvårdsverket reviderade Myrskyddsplan för Sverige 2007. Under 2013 sammanställdes korrektur på felaktigheter som hittats i planen med tillhörande GIS-skikt. Samtidigt kompletterades planen med de skyddade områden som tagits bort 2007, dels för att några län bedömde att Natura 2000 inte var ett de inte var tillräckligt skydd, dels för att planens genomslag sedan 1994 skulle kunna följas i uppföljningar och utvärderingar av miljöarbetet och miljömålen. Under 2016 gjordes ytterligare en revidering, områden som förskjutits och överlappade varandra korrigerades. Dessutom adderades länkar till de länsfiler områdestexterna ingår i samt information om områdenas myrskyddsplanehistorik. Rapporterna och länsfiler finns nedladdningsbara på webbsidan dit länken under ”informationssida” i metadatat leder. Rapporterna bör inte läsas utan tillgång till det supplement som hör till rapporterna. Det här GIS-skiktet inkluderar korrekturen som tagits fram 2016 och är det skikt som bör användas."}},{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/A6863D6D-68B7-45E9-9E4D-36C572AE2FD8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:a990b273-f2bf-1e92-a7a3-13ed873ac15a"},{"@id":"urn:uuid:b960296b-e832-9615-ce7f-56e1ef3bc769"},{"@id":"urn:uuid:f462bc6e-6ad0-b8ad-74e8-e46a60502945"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Naturvårdsverket reviderade Myrskyddsplan för Sverige 2007. Planen innehöll de oskyddade myrar med höga naturvärden som Naturvårdsverket ansåg borde ges ett långsiktigt skydd. Under 2016 genomfördes mindre korrigeringar och korrektur. Rapporterna och länsfiler och tillhörande supplement finns nedladdningsbara på webbsidan dit den första länken ovan går. Det här GIS-skiktet inkluderar korrekturen som tagits fram 2016 och är det skikt som bör användas."},"dct:identifier":"A6863D6D-68B7-45E9-9E4D-36C572AE2FD8","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b1n0"},"dct:title":{"@language":"sv","@value":"Planer: Myrskyddsplan för Sverige (MSP)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:a990b273-f2bf-1e92-a7a3-13ed873ac15a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/planeringsunderlag_o_strategier/wms?layers=Myrskyddsplan"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) för myrskyddsplan"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:b960296b-e832-9615-ce7f-56e1ef3bc769","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/vatmark/Myrskyddsplan_2007_reviderad_2016.zip"},"dct:description":{"@language":"sv","@value":"Nedladdningsbar fil (shape) för myrskyddplan"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil (shape) för myrskyddsplan"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f462bc6e-6ad0-b8ad-74e8-e46a60502945","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/skyddad-natur/myrskyddsplan-for-sverige"},"dct:description":{"@language":"sv","@value":"Länk till hemsida med information och möjlighet att ladda ned filer med rapporten. Rapporterna bör inte läsas utan tillgång till det supplement som hör till rapporterna."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara (länsvisa) rapporter."}}],"@id":"urn:source:a3232141419603c3f51ebe69c0831d8b720c867f58a93430cd542148a24ca898"},{"@graph":[{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Skiktet ”Sannolikt och potentiell kontinuitetsskog” är en sammanslagning av en grundkartering 2015 och efterföljande preciseringar. Skiktet är en rasterprodukt i boreal region med en upplösning på 10 x 10 m där minsta karteringsenhet är större än eller lika med 0,5 hektar och bredare än 20 meter.\n\nDen första karteringen har aktualitet 2015 och är genomförd med heltäckande indata i en automatiserad produktionsprocess. Analysen utförs inom skogsmark enligt avgränsning från kartdata. Inom analysområdet är principen att ta bort områden som i olika bildunderlag har varit kala eller är unga under tidperioden från det första bildunderlaget (historiska ortofoton, 60-tal) och fram till 2015 (Sentinel-2). Andra underlag såsom laserdata och faktiskt avverkat från Skogsstyrelsen har också använts i processen.\n\nPrecisering av karteringen från 2015 har genomförts genom visuell tolkning av historiska och aktuella ortofoton för ett urval av ytor från karteringen 2015. För länen Z, Y och AC har preciseringen skett nedan fjällnära gräns och lägre än 450 m.ö.h., med några få undantag. Ytor större eller lika med 5 hektar klassificerades i tre klasser (k-skog, påverkad k-skog och ej k-skog). I fjällen genomfördes en grövre precisering med fokus på att avgränsa större och tydligt avverkade ytor i äldre och aktuella ortofoton. Dessutom klipptes de ytor som låg utanför den nya skogsmarksavgränsningen från Nationella Marktäckedata (NMD v.1 från 2018) bort i fjällregionen.\n\nOmråden som enligt Skogsstyrelsens data är avverkade tas bort en gång per år ur det sammanlagda skiktet. De länsvisa skikten uppdateras inte."}},{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.1822 68.8746,23.685 68.8746,23.685 58.9544,11.1822 58.9544,11.1822 68.8746))"}},{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/2b9d4c76-3b0e-4a55-a16c-51513da84558","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0f8eeba9-e0be-44d1-b5ff-46364464cb90"},{"@id":"urn:uuid:288bc4a7-0c29-019e-cf0d-9b048b5f8439"},{"@id":"urn:uuid:570a4b60-83c1-efe6-358c-b859899da2e6"},{"@id":"urn:uuid:58f58b05-67af-7d40-4b20-93254633ae9b"},{"@id":"urn:uuid:f7f05597-b057-9673-e104-dd6da86fc630"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kartering av kontinuitetsskogar och skogar som har potential att uppfylla kraven för att vara kontinuitetsskogar har genomförts för att:\n-Skapa ett kunskapsunderlag för att identifiera och prioritera skogsområden för inventeringar och formellt skydd.\n-Skapa ett geografiskt underlag som kan användas i arbetet med att beskriva grön infrastruktur och skogslandskapets konnektivitet.\n\nKontinuitetsskog karterades 2015 i hela den boreala regionen och inom fyra områden är denna kartering preciserad. Kartering 2015 genomfördes med automatiserade metoder. Precisering har genomförts eftersom karteringen 2015 överskattar förekomsten av kontinuitetsskog. Precisering genomfördes genom visuell tolkning av äldre och aktuella ortofoton i Västernorrland (2016), Jämtland (2017), Västerbotten (2018), fjällregionen (2019), Norrbotten (2022) och Dalarna (2022). \n\nKarteringen 2015 och efterföljande preciseringar är sammanslaget till ett skikt ”Sannolikt och potentiell kontinuitetsskog”. Det sammanslagna skiktet med dokumentation är tillgängligt för nedladdning direkt under angiven nedladdningslänk nedan. Karteringen 2015 och preciseringarna finns för nedladdning i de fem undermappar. Det sammanlagda skiktet har uppdaterats 2024 och områden som i Skogsstyrelsen underlag är avverkade har tagits bort."},"dct:identifier":"2b9d4c76-3b0e-4a55-a16c-51513da84558","dct:issued":{"@type":"xsd:date","@value":"2022-01-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-02-15"},"dct:provenance":{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b1n0"},"dct:title":{"@language":"sv","@value":"Sannolikt och potentiell kontinuitetsskog"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0f8eeba9-e0be-44d1-b5ff-46364464cb90","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/planeringsunderlag_o_strategier/wms?layers=Sannolikt_och_potentiell_kontinuitetsskog"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst (WMS) för den mest aktuella versionen"}},{"@id":"urn:uuid:288bc4a7-0c29-019e-cf0d-9b048b5f8439","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Kartering_av_kontinuitetsskog/Sannolikt_och_potentiell_kontinuitetsskog_BorealRegion_2024.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbar fil med sannolikt och potentiell kskog, version 2024"}},{"@id":"urn:uuid:570a4b60-83c1-efe6-358c-b859899da2e6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Kartering_av_kontinuitetsskog/Leverans-PM_Sannolikt_och_potentiell_kontinuitetsskog_i_Boreal_Region_2024.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till beskrivning av produkten (Leverans PM)"}},{"@id":"urn:uuid:58f58b05-67af-7d40-4b20-93254633ae9b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Kartering_av_kontinuitetsskog/Sannolikt_och_potentiell_kontinuitetsskog_BorealRegion_2022.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbar fil med sannolikt och potentiell kskog, version 2022"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f7f05597-b057-9673-e104-dd6da86fc630","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Kartering_av_kontinuitetsskog/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till katalog för nedladdning av samtliga versioner"}}],"@id":"urn:source:a3ce3ae226b95d5aca2d49bad148e8fa8654b8440b8f4ec9af28dcc488a87dbd"},{"@graph":[{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Informationen har skapats genom tolkning av beslutsdokument. I följande län är information som visas i tjänsten ajourförd: Norrbotten, Värmland, Gävleborg, Västra Götaland, Västernorrland, Uppsala, Östergötland, Skåne, Jämtland, Dalarna, Halland, Västerbotten, Kalmar, Jönköping, Västmanland, Blekinge och Kronoberg (17 st). I följande län finns det för närvarande brister i ajourföringen (4 st):  Södermanland: Tillträdesförbud saknas i naturreservaten Strandstuviken och Bålbergsudden. Örebro:\tTillträdesförbud saknas i alla berörda skyddade områden. Gotland: Tillträdesförbud saknas i alla berörda skyddade områden. Stockholm: Tillträdesförbud saknas i en del av de skyddade områdena.  Kommer att åtgärdas i början av 2014."}},{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/F2554ED6-3A9B-4955-B4AC-D61B35026C88","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0"},"dcat:distribution":[{"@id":"urn:uuid:06e92ca7-0632-60d2-c270-71f248971c3f"},{"@id":"urn:uuid:21524654-cea0-c1bf-610c-cd1dade538f7"},{"@id":"urn:uuid:45405d9b-b4b1-bf55-c250-9bfeefd97f2c"},{"@id":"urn:uuid:6cf01793-68c6-d330-c73e-2b7607d7733b"},{"@id":"urn:uuid:85ffda71-62b6-a5c7-0207-ee0ce3d8709a"},{"@id":"urn:uuid:e9a38260-4fe5-1ccb-604a-233fc1a86f9a"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Områden (inom t.ex. naturreservat, nationalparker, m. fl.) med föreskrifter som inskränker rätten att färdas eller vistas i området, permanent eller under en del av året. Föreskrifter om rätten att färdas och vistas inom ett område upprättas om det behövs för att tillgodose syftet med skyddet. \nFöreskrifterna skall gälla omedelbart, även om de överklagas. I Örebro län redovisas inte tillträdesförbuden. Se även Djur- och växtskyddsområden för information."},"dct:identifier":"F2554ED6-3A9B-4955-B4AC-D61B35026C88","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: tillträdesförbud (föreskriftsområden)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:06e92ca7-0632-60d2-c270-71f248971c3f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/am-restriction/ows?layers=AM.regulatoryAreas"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Visningstjänst (WMS) över tillträdesförbud"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:21524654-cea0-c1bf-610c-cd1dade538f7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/TILLTRADESFORBUD.zip"},"dct:description":{"@language":"sv","@value":"Nedladdningsbar fil (shape) över tillträdesförbud"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:45405d9b-b4b1-bf55-c250-9bfeefd97f2c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-area-managementrestrictionregulation-zones-and-reporting-units-technical_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:6cf01793-68c6-d330-c73e-2b7607d7733b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Inspire/am/AM_regulatoryAreas.gml"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:85ffda71-62b6-a5c7-0207-ee0ce3d8709a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/skyddad-natur/process-att-bilda-naturreservat/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer information."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:e9a38260-4fe5-1ccb-604a-233fc1a86f9a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}}],"@id":"urn:source:a422dc3e7f8c6fc1a5215347c35d9cdb38760f769071f5a39945860adfa07966"},{"@graph":[{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Beslut registreras kontinuerligt av respektive länsstyrelse i det s.k. naturvårdsregistret. Registreringen styrs utifrån att attribut är obligatoriska/frivilliga. Geometrin digitaliseras av länsstyrelsen mot fastighetsgränser och ortofoton. Naturreservatens begränsningslinjer håller minst samma kvalitet som Fastighetskartan skala 1:10 000. Under 2008-2009 genomfördes ett kvalitetsförbättringsprojekt där gränserna justerades mot fastighetsgränser och topografiska objekt i Fastighetskartan. Nya Naturreservaten mäts in i fält med GPS, men även en del av de äldre reservaten har mätts in med GPS eller med annan mätteknik med hög noggrannhet. Naturreservat ska inte överlappa Nationalparker och Naturvårdsområden."}},{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/2921b01a-0baf-4702-a89f-9c5626c97844","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:251d87d2-ab7c-7e50-2c66-0f0d480accf0"},{"@id":"urn:uuid:2fc8e8aa-e67b-87b6-4b7c-911cfc77b47c"},{"@id":"urn:uuid:38029475-b2ce-66c9-bf26-0240660a021a"},{"@id":"urn:uuid:3fd807fe-7941-359d-21ae-7006f5d19e98"},{"@id":"urn:uuid:44f4536b-2caa-c9f5-6569-ce62a2e7500d"},{"@id":"urn:uuid:5ad22d0f-1693-8d4b-09f7-db7a76d5b2e7"},{"@id":"urn:uuid:cc430a81-8a78-0caa-05fd-ca122a950897"},{"@id":"urn:uuid:d548ab8f-8121-4a1d-eba1-34f396dcbff0"},{"@id":"urn:uuid:e6a1f529-91d3-d567-fce7-43bb4f36a972"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Länsstyrelserna och kommunerna kan bilda naturreservat enligt miljöbalken. Naturreservat bildas i ”syfte att bevara biologisk mångfald, vårda och bevara värdefulla naturmiljöer eller tillgodose behov av områden för friluftslivet. Ett område som behövs för att skydda, återställa eller nyskapa värdefulla naturmiljöer eller livsmiljöer för skyddsvärda arter får också förklaras som naturreservat.” (ur miljöbalken). Sverige har drygt 5 100 naturreservat."},"dct:identifier":"2921b01a-0baf-4702-a89f-9c5626c97844","dct:issued":{"@type":"xsd:date","@value":"2021-12-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: naturreservat"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:251d87d2-ab7c-7e50-2c66-0f0d480accf0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}},{"@id":"urn:uuid:2fc8e8aa-e67b-87b6-4b7c-911cfc77b47c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSites_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för data som ingår i INSPIRE bilaga 1, Naturreservat"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:38029475-b2ce-66c9-bf26-0240660a021a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_beskrivning_av_oppna_data.pdf"},"dct:description":{"@language":"sv","@value":"Länk till produktbeskrivning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av öppna data"}},{"@id":"urn:uuid:3fd807fe-7941-359d-21ae-7006f5d19e98","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till dokumentation och legender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation och legender"}},{"@id":"urn:uuid:44f4536b-2caa-c9f5-6569-ce62a2e7500d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/NR.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data (shape)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:5ad22d0f-1693-8d4b-09f7-db7a76d5b2e7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-nvr/ows?layers=PS.ProtectedSites.NR"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:cc430a81-8a78-0caa-05fd-ca122a950897","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/skyddad-natur/Naturreservat/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets webbsida med mer information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:d548ab8f-8121-4a1d-eba1-34f396dcbff0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps/wfs?"},"dct:description":{"@language":"sv","@value":"Länk till WFS tjänst (WFS)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:e6a1f529-91d3-d567-fce7-43bb4f36a972","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:a44bab194d584896e457600d2119075facd53ca66d744ab1e3cda35fe56c9a14"},{"@graph":[{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Ingående datakällor \n\nData från lavinprognoserna består av:\n- Prognoser för lavinfaran kommande 24 respektive 48 timmar från tidpunkt  för utfärdande (Valid from)\n- Varje prognos definieras med ett geografiskt område och en giltighetstid. \n\nData innehåller:\nEn gradering av lavinfaran enligt den internationella lavinskalan.\nSpecifikation av främsta lavinproblem, inklusive typ, höjd och väderstreck.\nSamtliga texter som är bundna till varje enskild prognos:  Råd samt sammanfattning av  lavin, väder och snöförhållanden. Från och med 2018.12.20 även en kort fjällväderprognos i textform, för aktuellt prognosområde och giltig för kommande 24 timmar från tidpunkten för utfärdandet.  \n\nDatainsamling:\nDatat är lavinprognostjänstens bedömning av lavinfaran vid tillfället och dess utveckling."}},{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.068 70.2321,24.2661 70.2321,24.2661 60.7053,11.068 60.7053,11.068 70.2321))"}},{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/dc9b0173-14bf-432e-a5a2-08f359018259","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:258a9804-b271-ed26-ab39-4bd3786db171"},{"@id":"urn:uuid:6374ceda-7e6a-bc2b-c80e-d1f7140929a5"},{"@id":"urn:uuid:b6263236-99e7-def7-c7e7-8ee6ecc93f1c"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Innehåller samtliga lavinprognoser publicerade av Naturvårdverkets Lavinprognostjänst från och med 2017.01.01"},"dct:identifier":"dc9b0173-14bf-432e-a5a2-08f359018259","dct:issued":{"@type":"xsd:date","@value":"2019-10-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b1n0"},"dct:title":{"@language":"sv","@value":"Lavinprognoser: kontinuerlig lavinprognosdata"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:258a9804-b271-ed26-ab39-4bd3786db171","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://lavinprognoser.se/lavinprognoser-wfs/"},"dct:description":{"@language":"sv","@value":"Lavinprognoser WFS: beskrivning av tjänsten"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Lavinprognoser WFS: beskrivning av tjänsten"}},{"@id":"urn:uuid:6374ceda-7e6a-bc2b-c80e-d1f7140929a5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://nvgis.naturvardsverket.se/geoserver/lavinprognoser/ows?service=WFS&version=1.0.0&request=getCapabilities"},"dct:description":{"@language":"sv","@value":"Lavinprognoser WFS"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:b6263236-99e7-def7-c7e7-8ee6ecc93f1c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://lavinprognoser.se/"},"dct:description":{"@language":"sv","@value":"Webbsida för Naturvårdsverketslavinprognostjänsten"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida för Naturvårdsverkets lavinprognostjänst"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:a5c8f02debe732b93809fcbf109358af00ab550c3d721ea33f332afab0d8f64c"},{"@graph":[{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data har tagits fram genom att skapa värdekärnor för gräsmarker baserat på befintliga databaser och sedan göra en täthetsanalys av värdekärnor. Analysen har gjorts för sex olika fall. Tätheten värdekärna överstiger 5% respektive 10% där ytor har lagts samman inom en radie av 500 meter, 1000 meter eller 3000 meter. Tillsammans med data finns modellbeskrivningar."}},{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/d5b232f8-50a8-4f80-8ac9-06b2b010c797","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:bcd6f48f-7af0-db91-5e85-0ef6d92d5319"},{"@id":"urn:uuid:da36f93e-7d12-946a-bdc4-a26a56836b9b"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data innehåller resultatet från analys av värdekärnor för gräsmarker för grön infrastruktur. Data finns uppdelat länsvis och även nationellt och innehåller sex olika analyser: Områden med höga tätheter av värdekärna (> 5% alternativt >10 %) av gräsmark och annan öppen mark inom en radie av 500, 1000 eller 3000 meter.\n\nLeveransen innehåller data för samtliga län och samtliga analyser."},"dct:identifier":"d5b232f8-50a8-4f80-8ac9-06b2b010c797","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b1n0"},"dct:title":{"@language":"sv","@value":"Grön infrastruktur: Täthetsanalys av värdekärnor för gräsmarker"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:bcd6f48f-7af0-db91-5e85-0ef6d92d5319","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/gron_infrastruktur/grasmark/gi_analys_grasmark.pdf"},"dct:description":{"@language":"sv","@value":"Länk till dokument som beskriver analysen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation för analysen"}},{"@id":"urn:uuid:da36f93e-7d12-946a-bdc4-a26a56836b9b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/gron_infrastruktur/grasmark/"},"dct:description":{"@language":"sv","@value":"Länk till dokument som beskriver analysen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data och dokumentation"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:a9e45357122ae41d10b6beaab888c56074753028905978445f1ce2ddbc9f6f59"},{"@graph":[{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Geokorrigering av ca 1450 st häradskartor har skett automatiskt genom användandet av ett rutnät med hörnkoordinater för kartorna. Geokorrigeringen är därför grov vilket användare måste vara uppmärksamma på. Kanter runt varje kartblad är med."}},{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.5345 60.9643,19.0483 60.9643,19.0483 55.1902,10.5345 55.1902,10.5345 60.9643))"}},{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/a2f536bd-97e6-4608-a60b-784f272dfcc5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:5ac3540f-4bf4-0b33-cc51-3419cddf7c87"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Häradsekonomiska kartan (1859 till 1934) baserades på laga skifteskartor och beskriver markanvändning, vegetation, bebyggelse, kommunikationer och gränser. Den omfattar dock inte hela Sverige utan bara delar av Götaland och Svealand samt ett antal blad i Norrbottens län. Skalan är 1:20 000 i den södra delen av landet och 1:50 000 i Norrbotten. \nHäradskartor finns i rasterformat (tif) och inom detta uppdrag skedde en georeferering av kartorna i södra Sverige. Geokorrigering har skett automatiskt genom användandet av ett rutnät med hörnkoordinater för kartorna. Geokorrigeringen är därför grov vilket användare måste vara uppmärksamma på."},"dct:identifier":"a2f536bd-97e6-4608-a60b-784f272dfcc5","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b1n0"},"dct:title":{"@language":"sv","@value":"Häradskartan (georefererade kartblad)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:5ac3540f-4bf4-0b33-cc51-3419cddf7c87","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/haradskartan/"},"dct:description":{"@language":"sv","@value":"Nedladdning av zip-filer med häradskartor. Zip-filer har ID enligt kartbild."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:aa5181435a0b88890ecdb78fde3331d7d941bf9b44c47ad73061863ce0461b3a"},{"@graph":[{"@id":"_:ac05bd4807de5df80bcd9065ae66244e7c98c366af8a5e63a80af2d320848ccc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av unionslistade arter under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."}},{"@id":"_:ac05bd4807de5df80bcd9065ae66244e7c98c366af8a5e63a80af2d320848ccc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:ac05bd4807de5df80bcd9065ae66244e7c98c366af8a5e63a80af2d320848ccc_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/4ecf0337-11c9-4035-9d65-5b45fc94cb0f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:3025863e-0358-a93c-d41b-05015ac8bb68"},{"@id":"urn:uuid:40f62b2b-277e-e44a-6262-349c09855db4"},{"@id":"urn:uuid:68987cd8-9e18-d960-c763-2844beea8c70"},{"@id":"urn:uuid:c34c1291-8a67-b64c-87a0-3891336c76a1"},{"@id":"urn:uuid:e193b737-e5f5-d807-3a4f-c5eb8044e527"},{"@id":"urn:uuid:f3e688e5-88ed-920d-