 https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:907ddfb6b9388db72fb033a0e55153fa2a36d7117528a5d0b039c7dc48d4f10e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:907ddfb6b9388db72fb033a0e55153fa2a36d7117528a5d0b039c7dc48d4f10e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/5fca4342-7a48-43bf-965a-056d0d1ee896","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0"},"dcat:distribution":[{"@id":"urn:uuid:057ee427-a424-f1fd-e187-58d5964bad07"},{"@id":"urn:uuid:919e2df7-543d-90a1-e09c-2d6eedfbdbf8"},{"@id":"urn:uuid:aab85648-d4cb-0d49-c1c4-0c3edd71aaf1"},{"@id":"urn:uuid:af8e0d7e-832e-e824-37a3-844f1ef74fdc"},{"@id":"urn:uuid:e872fbb2-0cbf-688d-be2f-6f3a4339eca7"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Inom datavärdskapet för den hälsorelaterade miljöövervakningen förvaltas resultat från övervakning av miljögifter i humana matriser samt luftexponeringsdata. Det är både löpande undersökningar och screeningar som samlas i datavärdskapet. Platser där man registrerar humanprover samt personburna luftprover finns endast registrerat som region i det specifika datavärdskapet. Platser för stationära luftprover registreras i Stationsregistret, som är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning."},"dct:identifier":"5fca4342-7a48-43bf-965a-056d0d1ee896","dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:907ddfb6b9388db72fb033a0e55153fa2a36d7117528a5d0b039c7dc48d4f10e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:907ddfb6b9388db72fb033a0e55153fa2a36d7117528a5d0b039c7dc48d4f10e_b1n0"},"dct:title":{"@language":"sv","@value":"Platser för miljöövervakning: Datavärdskap Hälsorelaterad miljöövervakning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:057ee427-a424-f1fd-e187-58d5964bad07","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://ki.se/imm/halsorelaterad-miljoovervakning"},"dct:description":{"@language":"sv","@value":"Hemsida och data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Karolinska Institutet, Institutet för Miljömedicin - Hemsida och data"}},{"@id":"urn:uuid:919e2df7-543d-90a1-e09c-2d6eedfbdbf8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-environmental-monitoring-facilities-technical-guidelines_en"},"dct:format":{"