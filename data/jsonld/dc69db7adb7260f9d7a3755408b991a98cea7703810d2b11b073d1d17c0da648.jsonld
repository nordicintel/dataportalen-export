,{"@id":"_:e5e8bd78f05f3fd94efe7aaf9edfdfc850908a71332b138c42d72c47ccb9122e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/4a577a3f-fb23-4a24-abdc-7f908dbc668b","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0"},"dcat:distribution":[{"@id":"urn:uuid:70abd0c9-9dc1-c005-9513-d7a6ebb942b9"},{"@id":"urn:uuid:bb9532d3-bd73-d71f-49d5-48f56de94be7"},{"@id":"urn:uuid:cbda43be-6abf-dcbb-25ad-903bad77b9a0"},{"@id":"urn:uuid:ecff707c-8e43-9be7-4123-d2e265cc5ae5"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Områden känsliga för övergödning enligt rådets direktiv 91/271/EEG av den 21 maj 1991 om rening av avloppsvatten från tätbebyggelse.\n\nDetta datapaket innehåller GIS-skikt med polygoner som avbildar områden känsliga för övergödning med kväve (N) och fosfor (P) och som är en del av data som rapporteras till Europeiska Miljöbyrån enligt Avloppsvattendirektivet (Urban Waste Water Directive, 91/271/EEG)."},"dct:identifier":"4a577a3f-fb23-4a24-abdc-7f908dbc668b","dct:issued":{"@type":"xsd:date","@value":"2022-11-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-22"},"dct:provenance":{"@id":"_:e5e8bd78f05f3fd94efe7aaf9edfdfc850908a71332b138c42d72c47ccb9122e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:e5e8bd78f05f3fd94efe7aaf9edfdfc850908a71332b138c42d72c47ccb9122e_b1n0"},"dct:title":{"@language":"sv","@value":"Områden känsliga för övergödning enligt avloppsvattendirektivet (91/271/EEG) - Områden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:70abd0c9-9dc1-c005-9513-d7a6ebb942b9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-area-managementrestrictionregulation-zones-and-reporting-units-technical_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e5e8bd78f05f3fd94efe7aaf9edfdfc850908a71332b138c42d72c47ccb9122e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:bb9532d3-bd73-d71f-49d5-48f56de94be7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/am-uwwtd/ows?layers=AM.sensitiveArea"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:cbda43be-6abf-dcbb-25ad-903bad77b9a0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/am/am_uwwtd_avloppsvattendirektivet_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM feed för Inspire anpassad data som ingår i Naturvårdsverkets rapportering enligt avloppsvattendirektivet (Urban Waste Water Directive, 91/271/EEG)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:ecff707c-8e43-9be7-4123-d2e265cc5ae5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/avlopp/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}}],"@id":"urn:source:e5e8bd78f05f3fd94efe7aaf9edfdfc850908a71332b138c42d72c47ccb9122e"},{"@graph":[{"@id":"_:e870d35e7925f284906854e024a2fdfbfcac7c2750e469c21b04da61d1e55e31_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"I analysskiktet för marina regioner ligger en buffert, från strandlinjen (från Lantmäteriets Topografi 50 Nedladdning, vektor), på 10 km upp på land. Gränsdragningen mellan Marin Östersjön och Marin Atlantisk inom denna landbuffert börjar vid strandlinjen i gränspunkten mellan den marina gränsdragningen mellan regionerna och följer därefter väg E20 och därefter E65.  För yttre gräns i hav har Sjöfartsverkets senast publicerade gräns för territorialvatten/ekonomisk zon använts. \n\nFör en mer detaljerad beskrivning, se Nationellt anpassad geodata för biogeografiska och marina regioner - Metodbeskrivning."}},{"@id":"_:e870d35e7925f284906854e024a2fdfbfcac7c2750e469c21b04da61d1e55e31_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/6b357d2a-21b7-485a-b2e6-e5d435e310fe","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0382a1d1-2e25-6a0a-521c-609a0d11ed69"},{"@id":"urn:uuid:2dc329d9-4ec2-a502-9606-ff5b61ac03ab"},{"@id":"urn:uuid:6a693de3-3edc-d036-dae4-849f6a4d9e36"},{"@id":"urn:uuid:98bdcb83-d9e5-da4c-712f-02deaee6e044"},{"@id":"urn:uuid:ac26bf06-384c-67c3-e5b9-6770842e232d"},{"@id":"urn:uuid:b67fb43b-33f5-b28f-c117-3e281e03dfea"},{"@id":"urn:uuid:e5bddd1f-d1d5-da59-1b52-d68d1f75da52"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Filnamn: SE_analysmask_marina_regioner \n\nDatamängden är en marin motsvarighet till datamängden Analysmask för biogeografiska regioner. Den sträcker sig ut till gränsen för ekonomisk zon/territorialgräns och är buffrad från strandlinjen (från Lantmäteriets Topografi 50 Nedladdning, vektor) och 10 km upp på land. De marina regionerna ”överlappar” således de biogeografiska regionerna i denna geodatamängd. \n\nAnalysmasken kan användas för att tex bestämma regiontillhörighet för olika förekomster av habitat och arter. Överlappen med de biogeografiska regionerna möjliggör att marina, strandnära habitat och arter som befinner sig på ”fel” sida av en hårt dragen gränslinje mellan biogeografiska och marina regioner kan fångas upp. \n\nRapportering av marina arter och naturtyper enligt art- och habitatdirektivet gör med hjälp av denna datamängd. \n\nFrågor rörande de marina regionerna riktas till Havs- och vattenmyndigheten (HaV)."},"dct:identifier":"6b357d2a-21b7-485a-b2e6-e5d435e310fe","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-08"},"dct:provenance":{"@id":"_:e870d35e7925f284906854e024a2fdfbfcac7c2750e469c21b04da61d1e55e31_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:e870d35e7925f284906854e024a2fdfbfcac7c2750e469c21b04da61d1e55e31_b1n0"},"dct:title":{"@language":"sv","@value":"Analysmask för marina regioner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0382a1d1-2e25-6a0a-521c-609a0d11ed69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?layers=BR.BiogeographicalRegions.Marinaregioner"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS Marina regioner"}},{"@id":"urn:uuid:2dc329d9-4ec2-a502-9606-ff5b61ac03ab","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/SE_BiogeografiskaMarinaRegioner.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil; geopackage, ESRI-databas och metodbeskrivning"}},{"@id":"urn:uuid:6a693de3-3edc-d036-dae4-849f6a4d9e36","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/Nationellt%20anpassad%20geodata%20f%C3%B6r%20biogeografiska%20och%20marina%20regioner.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil; geopackage, ESRI-databas och metodbeskrivning"}},{"@id":"urn:uuid:98bdcb83-d9e5-da4c-712f-02deaee6e044","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://testgeodata.naturvardsverket.se/atom/inspire/br/SE_BR_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:ac26bf06-384c-67c3-e5b9-6770842e232d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:b67fb43b-33f5-b28f-c117-3e281e03dfea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/br/SE_BR_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Biogeografiska regioner, nedladdningstjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Biogeografiska regioner, nedladdningstjänst"}},{"@id":"urn:uuid:e5bddd1f-d1d5-da59-1b52-d68d1f75da52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WFS"}}],"@id":"urn:source:e870d35e7925f284906854e024a2fdfbfcac7c2750e469c21b04da61d1e55e31"},{"@graph":[{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Länsstyrelsen Västerbotten och ArtDatabanken gjorde en utökad baskartering av alpina översilningskärr (annex I-naturtypen 7240) i fjällen i Västerbottens län. Syftet var att öka kunskapen om det dåligt kända habitatet som ett underlag för biogeografisk uppföljning. Sammanlagt besökte vi ett sju olika fjällområden och avgränsade samt dokumenterade (referens: manual för basinventering av fjäll- och bergnaturtyper, Naturvårdsverket 2007) strukturer/funktioner samt typiska arter. Resultatet är GIS-skikt (lagras i NNK) samt excelfiler, foton och GPS-data."}},{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((14.00 66.30,15.70 66.30,15.70 65.00,14.00 65.00,14.00 66.30))"}},{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9EC3EFA3-134B-4710-990D-5AC537144E89","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:ae997798-9afb-d6c1-6965-47668ce958bf"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Länsstyrelsen Västerbotten och ArtDatabanken gjorde en utökad baskartering av alpina översilningskärr (annex I-naturtypen 7240) i fjällen i Västerbottens län. Syftet var att öka kunskapen om det dåligt kända habitatet som ett underlag för biogeografisk uppföljning. Sammanlagt besökte vi sju olika fjällområden och avgränsade samt dokumenterade (referens: manual för basinventering av fjäll- och bergnaturtyper, Naturvårdsverket 2007) strukturer/funktioner samt typiska arter. Resultatet är GIS-skikt (lagras i NNK) samt excelfiler, foton och GPS-data.\n\nData finns tillgängligt som en del av den generella NNK-karteringen, urprungsinventeringen finns via NV-05499-24."},"dct:identifier":"9EC3EFA3-134B-4710-990D-5AC537144E89","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b1n0"},"dct:title":{"@language":"sv","@value":"Utökad baskartering av alpina översilningskärr (Naturanaturtypskod: 7240)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:ae997798-9afb-d6c1-6965-47668ce958bf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/hb/SE_HabitatsBiotopes_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Atom-tjänst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:e8935a502ca4f5b76813d21ea3c9471a3afa5652a7839469429059b42473246d"},{"@graph":[{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data redovisar den yttre avgränsningen för området."}},{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/f57de73f-0ce0-4be0-a638-5778bec38cde","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:29c0f1db-b668-53ce-e272-e08627696634"},{"@id":"urn:uuid:4d7c71eb-966f-33ec-a9e2-b802187a31d2"},{"@id":"urn:uuid:8e212a54-2e06-0ce0-595d-fc74fb056ad8"},{"@id":"urn:uuid:9d86c62f-8f62-cd51-5271-18132c1c5cdf"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Sverige har 15 världsarv. Detta skikt innehåller information om de två som pekats ut på grund av sina naturvärden. Ett världsarv är ett kulturminne eller naturminne som är så värdefullt att det är en angelägenhet för hela mänskligheten. Det är en plats, ort, miljö eller objekt som på ett alldeles unikt sätt vittnar om jordens och människans historia. Världsarvslistan grundar sig på FN-organet Unescos konvention till skydd för världens natur- och kulturarv, som antogs 1972. Sverige undertecknade konventionen 1985. Världsarvet Lapponia utpekades 1996 och Höga kusten 2000. Gränserna för områdena är ungefärliga."},"dct:identifier":"f57de73f-0ce0-4be0-a638-5778bec38cde","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: världsarv med höga naturvärden"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:29c0f1db-b668-53ce-e272-e08627696634","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Varldsarv.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbart dataset (shape)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:4d7c71eb-966f-33ec-a9e2-b802187a31d2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSites_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för data som ingår i INSPIRE bilaga 1, Världsarv, Laponia och Höga Kusten"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:8e212a54-2e06-0ce0-595d-fc74fb056ad8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/skyddad-natur/olika-former-av-naturskydd/varldsarv"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med information om världsarven"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:9d86c62f-8f62-cd51-5271-18132c1c5cdf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-ic/ows?layers=PS.ProtectedSites.WorldHeritage"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:e8e1026f17d281051c8ef21ebbb9472c866fb59afd2b68bb32383f83a950727c"},{"@graph":[{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data framställs genom att man antingen bedömer att arten finns i en speciell ruta i ett 10 X 10 km rutskikt över Sverige eller genom att koppla arten  till rutorna i skiktet genom s.k. Overlay med de faktiska observationspunkterna."}},{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9a503eb4-5a74-42cc-b228-3e38bfe8f061","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:3f8996fc-685b-dce0-896f-9158396f9eea"},{"@id":"urn:uuid:55033e61-9f7f-e20e-4442-09a1a0c80811"},{"@id":"urn:uuid:f1bb2184-36e2-5567-8208-50e354342585"},{"@id":"urn:uuid:fcb43d4a-f9e1-7b78-56f9-5a54998e8f26"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Habitat Distribution beskriver förekomsten av livsmiljöer listade i habitatdirektivet (EEG 92/443 annex 2, 4 och 5). Förekomsten är representerad i ett rutnät om 10 X 10 km och datasetet motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet."},"dct:identifier":"9a503eb4-5a74-42cc-b228-3e38bfe8f061","dct:issued":{"@type":"xsd:date","@value":"2020-09-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b1n0"},"dct:title":{"@language":"sv","@value":"Habitatutbredningsområde, rapportering enligt art- och habitatdirektivet 2013"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:3f8996fc-685b-dce0-896f-9158396f9eea","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-habitats-and-biotopes-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:55033e61-9f7f-e20e-4442-09a1a0c80811","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/hb/SE_HB_HABITAT_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f1bb2184-36e2-5567-8208-50e354342585","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/hb-habitat/ows?layers=HB.HabitatUtbredningOmrade.2013"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:fcb43d4a-f9e1-7b78-56f9-5a54998e8f26","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Stod-i-miljoarbetet/Rattsinformation/Direktiv/EU-register---forfattningar-inom-miljobalkens-omrade/Art--och-habitatdirektivet/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}}],"@id":"urn:source:ea3f8ab074f46541d6d213c88ae64ad9d4e5e8f19f4349a7e355501c01325dec"},{"@graph":[{"@id":"_:ebf898ee27ddaddaf780ba4f4218ab335b4e9f8fcb6f1e5489400784039934c5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Äldre beslut importerade från länsstyrelsernas digitala databaser i samband med skapandet. Nyare beslut registreras kontinuerligt direkt i geodatabasen (naturvårdsregistret) av respektive länsstyrelse. Registreringen styrs utifrån att attribut är obligatoriska/frivilliga. Geometrin digitaliseras av länsstyrelsen mot fastighetsgränser och ortofoton."}},{"@id":"_:ebf898ee27ddaddaf780ba4f4218ab335b4e9f8fcb6f1e5489400784039934c5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:ebf898ee27ddaddaf780ba4f4218ab335b4e9f8fcb6f1e5489400784039934c5_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/c6b02e88-8084-4b3f-8a7d-33e5d45349c4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0403f9bb-ab5d-25fd-8a62-d359f8bfde88"},{"@id":"urn:uuid:501b873e-09a2-7ce0-3395-91c094468c7a"},{"@id":"urn:uuid:5439d876-2800-d0f9-aa4e-572f3afc2d94"},{"@id":"urn:uuid:78cb4fbf-e768-bbc1-840d-0cfc54dbbedc"},{"@id":"urn:uuid:8859115d-6141-e606-ee02-d6a292285e04"},{"@id":"urn:uuid:8e653182-ecee-3d66-c98f-0d8414a4f21b"},{"@id":"urn:uuid:91b55b97-4cd9-ed2e-ffd8-8c8da7d2d0d3"},{"@id":"urn:uuid:98d4f902-3330-8f15-af6e-8df7aed4ba20"},{"@id":"urn:uuid:9acde5ba-d07e-d85f-fc8d-107116901805"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Merparten av naturminnena är inrättade genom äldre beslut och med stöd av tidigare naturvårdslagstiftning. De flesta utgörs av särskilt skyddsvärda träd, t.ex. jätteekar. Andra objekt är flyttblock och jättegrytor. Även mindre områden, som t.ex. växtplatser för ovanliga växter eller små holmar, förekommer bland naturminnena. Naturminnen kan vara både ytor och punkter. \n\nObservera för närvarande återfinns alla naturminnen i geometrin för ytor, dvs geometrin med punkter är tomt då dessa redovisas som ytor. Detta gäller både för den nedladdningsbara datamängden och i de relaterade tjänsterna/resurserna."},"dct:identifier":"c6b02e88-8084-4b3f-8a7d-33e5d45349c4","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-25"},"dct:provenance":{"@id":"_:ebf898ee27ddaddaf780ba4f4218ab335b4e9f8fcb6f1e5489400784039934c5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ebf898ee27ddaddaf780ba4f4218ab335b4e9f8fcb6f1e5489400784039934c5_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: naturminnen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0403f9bb-ab5d-25fd-8a62-d359f8bfde88","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till dokumentation och legender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation och legender"}},{"@id":"urn:uuid:501b873e-09a2-7ce0-3395-91c094468c7a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:5439d876-2800-d0f9-aa4e-572f3afc2d94","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps/wfs?"},"dct:description":{"@language":"sv","@value":"WFS tjänst för naturvårdsregistret enligt Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":