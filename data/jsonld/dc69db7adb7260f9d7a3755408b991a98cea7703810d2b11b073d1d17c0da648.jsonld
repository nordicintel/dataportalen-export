"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:053a5c85-3ba0-bb54-4c1c-6d7e4fdc47d3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:22090c79-3dad-3047-1ec7-62ff0e2acb6d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/ows?layers=SD.SpeciesDistribution.PacifastacusLeniusculus"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:5320e833-9bae-cd22-8fcc-f715f5b09e42","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_IAS_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata som ingår i rapporteringen om Invasiva främmande arter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:aba6dc4d-5e88-6a07-c285-505df460f145","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:d19487df-a4a3-8def-7a1c-9959c3c59b69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=se/eu/ias/envxkngww/IAS_Invasive_Alien_Species_SE.xml"},"dct:description":{"@language":"sv","@value":"Information on the reporting"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information on the reporting"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2a8d0f5cfc179de672355b7dafc81ea699ed4748924bf80450b8468a8a78460e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:2a8d0f5cfc179de672355b7dafc81ea699ed4748924bf80450b8468a8a78460e"},{"@graph":[{"@id":"_:2c179cc70876e6a707e73e97466ee43e1d11132b6bfde45892a5eab11a43cb29_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Våtmarkskarteringen baseras på satellitdata. Ytterligare information om ursprungsdata, datainsamlingsmetod, bearbetningssteg, kvalitetsutvärdering och aktualitet finns i rapporten ”Satellitbaserad kartering av vegetationstyper inom öppen våtmark - Resultat och exempel från den första nationella karteringen. Naturvårdsverket, Rapport 7127. (Hahn, N. & Wester, K., 2023)”."}},{"@id":"_:2c179cc70876e6a707e73e97466ee43e1d11132b6bfde45892a5eab11a43cb29_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"http://data.naturvardsverket.se/resources/acbabea9-3303-429e-81e6-e388f26294b0","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:401c233b-9c97-18fc-187e-5bb2d8b5503c"},{"@id":"urn:uuid:83fb00e8-1058-3e49-1580-119768ab049a"},{"@id":"urn:uuid:9b4e0401-2671-1017-6e4c-45069d5f586b"},{"@id":"urn:uuid:c9b280d8-7955-a467-c41e-1c4bee1cd30c"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inom ramen för den nationella miljöövervakningen har det genomförts en nationell kartering av vegetationstyper inom öppen våtmark. Karteringen är gjort under perioden 2018 - 2022 och baseras på satellitdata. Karteringen som innehåller 16 vegetationstyper är gjord för all öppen våtmark (enligt nationella marktäckedata) nedanför fjällen."},"dct:identifier":"acbabea9-3303-429e-81e6-e388f26294b0","dct:issued":{"@type":"xsd:date","@value":"2023-11-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-16"},"dct:provenance":{"@id":"_:2c179cc70876e6a707e73e97466ee43e1d11132b6bfde45892a5eab11a43cb29_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:2c179cc70876e6a707e73e97466ee43e1d11132b6bfde45892a5eab11a43cb29_b1n0"},"dct:title":{"@language":"sv","@value":"Nationell miljöövervakning: Satellitbaserad kartering av vegetationstyper inom öppen våtmark"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:401c233b-9c97-18fc-187e-5bb2d8b5503c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/4adb57/globalassets/media/publikationer-pdf/7100/978-91-620-7127-1.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport med beskrivning av genomförd kartering"}},{"@id":"urn:uuid:83fb00e8-1058-3e49-1580-119768ab049a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.myrar.se"},"dct:description":{"@language":"sv","@value":"Webbsida med mer information om satellitbaserad övervakning av våtmarker."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida med information om satellitbaserad övervakning av våtmarker"}},{"@id":"urn:uuid:9b4e0401-2671-1017-6e4c-45069d5f586b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/om-miljoarbetet/miljoovervakning/programomraden/vatmark/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information på Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:c9b280d8-7955-a467-c41e-1c4bee1cd30c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/vatmark/satellitbaserad_vatmarkskartering_2018_v1.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data"}}],"@id":"urn:source:2c179cc70876e6a707e73e97466ee43e1d11132b6bfde45892a5eab11a43cb29"},{"@graph":[{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"De geokorrigerade tolkningsskisserna (raster) konverteras till GIS-skikt i vektor, både för avgränsning av objekt och delobjekt samt inre objekt fastmarksholmar och vatten. Avgränsning av objekt och inre objekt genomförs med en maskinell metod och avgränsning av delobjekt genomförs med visuell tolkning av de geokorrigerade tolkningsskisserna med stöd av ortofoto.\nLeverans för nedladdning läggs successivt upp per län (under respektive län i undermapp \"5. GIS-skikt\"). För objektskikten finns inledningsvis en version som inte har lika mycket attributdata som det är tänkt ska ingå i slutversionen. Så fort ett län har ett skikt med delobjekten vektoriserade kommer data om areal för olika typer av marker att kompletteras i objektskiktet."}},{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((9.809 66.3185,25.6968 66.3185,25.6968 55.082,9.809 55.082,9.809 66.3185))"}},{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/cea7ad91-0b2c-4534-8f45-80e92ad4cc9d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:4b64838e-ea7b-b652-b0ab-7a351d9e0090"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Våtmarksinventeringen (VMI) genomfördes 1981–2005. Alla inventerade våtmarker har flygbildstolkats och detta finns dokumenterat på tolkningsskisser. Undantaget är Norrbottens län som utförde flygbildstolkningen digitalt från början. Arbete med att geokorrigera tolkningsskisserna och göra dem digitalt tillgängliga (i rasterformat) har pågått sedan 2019 och beräknas vara färdigt 2022. Resultaten finns tillgängliga via Miljödataportalen. \nDe geokorrigerade tolkningsskisserna (raster) har nu med start 2021 börjat konverteras till GIS-skikt i vektor, både för avgränsning av objekt och delobjekt samt inre objekt fastmarksholmar och vatten. Dessutom har mer attributdata inkluderats jämfört vektorskiktet 2010. Det är fortfarande oklart när arbetet för alla länen blir klart.\nNedladdningsfiler läggs successivt upp under respektive län i undermapp \"5. GIS-skikt\". För nedladdning finns idag objektskikt 2021 för Uppsala län."},"dct:identifier":"cea7ad91-0b2c-4534-8f45-80e92ad4cc9d","dct:issued":{"@type":"xsd:date","@value":"2021-12-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-12-21"},"dct:provenance":{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b1n0"},"dct:title":{"@language":"sv","@value":"Våtmarksinventeringen VMI: vektorisering av nydigitaliserade objekt"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:4b64838e-ea7b-b652-b0ab-7a351d9e0090","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/VMI/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=ESRI Shape"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:2e925576769816ad8695031926695d03d141ec56367b657d31b48be8ab8d137c"},{"@graph":[{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Beslut om interimistiska förbud registreras kontinuerligt direkt i geodatabasen (naturvårdsregistret) av respektive länsstyrelse. Registreringen styrs utifrån att attribut är obligatoriska/frivilliga. Geometrin digitaliseras av länsstyrelsen mot fastighetsgränser och ortofoton. Områdets begränsningslinjer håller minst samma kvalitet som Fastighetskartan skala 1:10 000."}},{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/03e6e0d2-9ff8-4234-8dba-1a1ef88cb1ad","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0636ff91-1c7d-2755-acf7-b829eba79687"},{"@id":"urn:uuid:3570250b-1346-cbe1-c742-53f2055cb1dc"},{"@id":"urn:uuid:86f37748-a4c9-b387-f37e-575bf55ab879"},{"@id":"urn:uuid:966f201f-a6b6-80b3-19ca-c17343c40c88"},{"@id":"urn:uuid:9c841d45-5480-9539-309f-9901684c5718"},{"@id":"urn:uuid:add129e0-9afa-a4ed-ab84-d6f6f59b20f2"},{"@id":"urn:uuid:ba6d21fa-c67b-d31b-b037-6025817656b6"},{"@id":"urn:uuid:c6d870c8-5960-690d-e9c9-5faba8d0226b"},{"@id":"urn:uuid:d9b72c68-7b75-2de3-165a-29fa13f3b60f"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Ett områdes naturvärden kan skyddas i avvaktan på beslut om naturreservat. \n\nLänsstyrelsen eller kommunen kan meddela ett tillfälligt förbud (enligt Miljöbalken) att utan tillstånd vidta åtgärder som skulle kunna skada de värden man vill skydda – ett interimistiskt förbud. Exempel på åtgärder som kan strida mot syftet med tilltänkt naturreservat är avverkning, husbehovstäkt, uppförande av byggnad eller dikesrensning.\n\nEtt ofta ändamålsenligt alternativ till interimistiska förbud är att staten eller en kommun träffar ett naturvårdsavtal med fastighetsägaren med innebörd att ägaren avstår från att t.ex. avverka skog under upplåtelsetiden."},"dct:identifier":"03e6e0d2-9ff8-4234-8dba-1a1ef88cb1ad","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: interimistiska förbud"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0636ff91-1c7d-2755-acf7-b829eba79687","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_beskrivning_av_oppna_data.pdf"},"dct:description":{"@language":"sv","@value":"Länk till produktbeskrivning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av öppna data"}},{"@id":"urn:uuid:3570250b-1346-cbe1-c742-53f2055cb1dc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-nvr/ows?layers=PS.ProtectedSites.IF"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:86f37748-a4c9-b387-f37e-575bf55ab879","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSites_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningstjänst (ATOM)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:966f201f-a6b6-80b3-19ca-c17343c40c88","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/globalassets/vagledning/skyddad-natur/naturreservat/processen/dokument/forberedelser-interimistiska-forbud.pdf"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets vägledning om interimistiska förbud"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets vägledning om interimistiska förbud"}},{"@id":"urn:uuid:9c841d45-5480-9539-309f-9901684c5718","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}},{"@id":"urn:uuid:add129e0-9afa-a4ed-ab84-d6f6f59b20f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till dokumentation och legender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation och legender"}},{"@id":"urn:uuid:ba6d21fa-c67b-d31b-b037-6025817656b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/IF.zip"},"dct:description":{"@language":"sv","@value":"Länk till ftp-plats för nedladdning av data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:c6d870c8-5960-690d-e9c9-5faba8d0226b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:d9b72c68-7b75-2de3-165a-29fa13f3b60f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps/wfs?"},"dct:description":{"@language":"sv","@value":"WFS tjänst för Naturvårdsregistret enligt Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:2fcd9f0c23b2e790f48ed43b9a3e4c489804d5d673914e5ceca164c15d3cff6f"},{"@graph":[{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning.\n\nFör Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/8e00a38f-03ea-4409-8d4b-fd4a687a2c87","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0174a47e-9c43-94a5-2347-846e7aff96f5"},{"@id":"urn:uuid:2e1397d6-ee3e-1640-2c33-b91616490f5b"},{"@id":"urn:uuid:36d7c669-377c-f8fd-dd63-94642b8f65a3"},{"@id":"urn:uuid:66ac60a9-ed50-6529-061a-537ca6564d68"},{"@id":"urn:uuid:a4ae1a8b-82eb-aa50-778f-be8869632431"},{"@id":"urn:uuid:b8184097-ea07-3689-52af-a47dacfa6682"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"I datavärdskap för miljögifter förvaltas resultat från övervakning av miljögifter i sediment, biota och vatten. Det är både löpande undersökningar, provtagningskampanjer och screeningar som samlas i datavärdskapet. Platserna där prover tas registreras i Stationsregistret, som är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning.\n\nLänk Datavärdskap miljögifter - nedladdning data: https://www.sgu.se/produkter/geologiska-data/nationella-datavardskap/datavardskap-for-miljogifter/rapporterad-data-till-datavardskap-for-miljogifter/"},"dct:identifier":"8e00a38f-03ea-4409-8d4b-fd4a687a2c87","dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b1n0"},"dct:title":{"@language":"sv","@value":"Platser för miljöövervakning: Datavärdskap Miljögifter"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0174a47e-9c43-94a5-2347-846e7aff96f5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?cql_filter=(datahost_id=6)"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:2e1397d6-ee3e-1640-2c33-b91616490f5b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Miljogifter/atomDatasetFeed-SE_EF_StnReg_DV_Miljogifter.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:36d7c669-377c-f8fd-dd63-94642b8f65a3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Miljogifter/SE_EF_StnReg_DV_Miljogifter.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=GML 3.1"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:66ac60a9-ed50-6529-061a-537ca6564d68","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/miljoovervakning/nationella-datavardskap/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer information om nationella datavärdskap."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:a4ae1a8b-82eb-aa50-778f-be8869632431","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sgu.se/produkter/geologiska-data/nationella-datavardskap/datavardskap-for-miljogifter/rapporterad-data-till-datavardskap-for-miljogifter/"},"dct:description":{"@language":"sv","@value":"SGUs karttjänst och utsökningsfunktion för datavärdskap miljögifter samt API."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"SGU:s hemsida"}},{"@id":"urn:uuid:b8184097-ea07-3689-52af-a47dacfa6682","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell,Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:31139a3bf87b5b97f98cfc472469061fb0e487667dcefb20e3139551b9193032"},{"@graph":[{"@id":"_:33edc8c8d34e40a800bd1cce7f7ea4b963e805cc41cf24535a20766b74d6f5fb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Avgränsningen har skapats av Länsstyrelsen i samband med att överenskommelsen gjorts. Bakrundsdata är ofta fastighetsindelning, topografiska karta och andra skyddade områden."}},{"@id":"_:33edc8c8d34e40a800bd1cce7f7ea4b963e805cc41cf24535a20766b74d6f5fb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:33edc8c8d34e40a800bd1cce7f7ea4b963e805cc41cf24535a20766b74d6f5fb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/3a5790ff-8cd3-45ea-bbee-28cf2c1b6b06","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:1550a6b2-cef5-7ca7-e27f-726e1b0dccd9"},{"@id":"urn:uuid:327879e5-91a1-0cec-a4cc-d84f3f402ec2"},{"@id":"urn:uuid:ad498a27-5bd4-367e-8621-dc7e38ff2795"},{"@id":"urn:uuid:bf359fb8-5ad4-1ff7-be5c-ae131e800498"},{"@id":"urn:uuid:c278565e-78b2-2bd9-5533-aa4b70f5bed3"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Naturvårdsavtal som tecknats mellan fastighetsägare och Naturvårdsverket eller länsstyrelse som avtalspart för staten. Naturvårdsavtal är ett civilrättsligt avtal. Fastighetsägaren och staten eller en kommun kommer överens om en viss ekonomisk ersättning för fastighetsägaren mot att denne avstår från till exempel skogsbruk. Naturvårdsavtal kan träffas både för områden som är beroende av skötsel för att bevara naturvärdena och för sådana områden där naturvärdena gynnas bäst av fri utveckling. Avtalstiden kan variera mellan 1 och 50 år. Skogsstyrelsen och Naturvårdsverket vägleder tillsammans hur man kan gå till väga."},"dct:identifier":"3a5790ff-8cd3-45ea-bbee-28cf2c1b6b06","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-09-23"},"dct:provenance":{"@id":"_:33edc8c8d34e40a800bd1cce7f7ea4b963e805cc41cf24535a20766b74d6f5fb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:33edc8c8d34e40a800bd1cce7f7ea4b963e805cc41cf24535a20766b74d6f5fb_b1n0"},"dct:title":{"@language":"sv","@value":"Områden som omfattas av naturvårdsavtal (Naturvårdsverket, Länsstyrelsen)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:1550a6b2-cef5-7ca7-e27f-726e1b0dccd9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/skyddad-natur/naturvardsavtal/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer information"},"dct:format":{"@id":"http://publications.euro