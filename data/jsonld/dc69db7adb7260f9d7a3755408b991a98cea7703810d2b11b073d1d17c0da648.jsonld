.se/inspire/SE_EF_AQD_AirQualityMonitoringFacilities.gml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:a46c3f4c-5605-04ef-2ff0-7803122a6379","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell,Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:c4ad5359-9a9d-6f07-6cbf-0e065c68b206","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/luft/overvakning-av-luftkvaliteten/"},"dct:description":{"@language":"sv","@value":"Information om resursen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6e20032c7cb7f1a6ea4802f9ebd2e41abb0f11fcb54ef27bf138de885bb9b835_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:6e20032c7cb7f1a6ea4802f9ebd2e41abb0f11fcb54ef27bf138de885bb9b835"},{"@graph":[{"@id":"_:6f34204f474b03bd840b5dddfc5d4af3bb7d250cece67618f1097b1169fbdd43_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"De aktuella områdena finns i form av geografiska avgränsningar av de aktuella områdena. Överenskommelsen med annan myndighet har tagits fram av Naturvårdsverket baserat på fastighetsgränser och bedömningar av var avgränsning av områden med skyddsvärda områden finns. \nFör frivilliga avsättningar skickas data in från de markägare som har godkänt att data ingår i rapporteringen.\n\nAvgränsningen av de aktuella ytorna är inte exakt vilket användaren av data behöver ta hänsyn till. Dessa områden kan t ex endast finnas på den aktuella markägarens fastighet. \n\nFormatet vid rapporteringen till EEA är GML och uppdelat per typ av OECM. De data som tillhandahålls här har lagts ihop till en fil och konverterats till geopackages. Ett attribut för typ av OECM (DESTYP) har lagts till, i övrigt har attribut bibehållits."}},{"@id":"_:6f34204f474b03bd840b5dddfc5d4af3bb7d250cece67618f1097b1169fbdd43_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"http://data.naturvardsverket.se/resources/5ce79065-8746-4544-a4a6-a796da5a7718","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:dba915a6-e791-ad86-27d5-f0cc6f0e51ed"},{"@id":"urn:uuid:eb089c66-c270-f156-2fe0-c10e783f2832"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sverige redovisar skyddad natur (land och sötvatten) i internationella sammanhang till Europeiska miljöbyrån (EEA). Rapporteringen av skyddsformer sker enligt Internationella naturvårdsunionens (IUCN:s) kriterier på ett sätt som blir mer jämförbart med andra länder. Ett skyddat område enligt IUCN är ett område där områdets naturvärden är av stor betydelse för biologisk mångfald och där skyddet är utformat så att naturvärdena bevaras inom området, det vill säga att områdets syfte, mål, regleringar och förvaltning ska avse biologisk mångfald och bevarandet av biologisk mångfald ska ha prioritet mot andra värden över tid. Det är dessa områden som ska rapporteras till EEA. Det finns många instrument som skyddar natur utan att vara skyddade områden enligt IUCN, men som likväl har stor betydelse för biologisk mångfald. I den svenska modellen för naturvård i skogen ingår till exempel både formellt skydd, frivilliga avsättningar och generell hänsyn som en helhet. \n\nRapporteringen sker årligen och i rapporteringen ingår samtliga områden som finns med i den officiella statistiken för skyddad natur (nationella skyddsformer och Natura 2000 områden och naturvårdsavtal som tecknas av Skogsstyrelsen, länsstyrelserna eller Naturvårdsverket).\n\nFrån och med 2021 rapporteras även det som benämns Other effective area-based conservation measures (OECM). Det som rapporteras är Naturvårdsverkets överenskommelse med Fortifikationsverket om värdefulla områden och de områden med frivilliga avsättningar som markägare väljer att öppet redovisa på ett sätt som möjliggör rapportering som OECM.\n\nData innehåller attributet DESTYP som anger om en aktuell yta är Överenskommelse med annan myndighet eller Frivillig avsättning."},"dct:identifier":"5ce79065-8746-4544-a4a6-a796da5a7718","dct:issued":{"@type":"xsd:date","@value":"2024-10-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-14"},"dct:provenance":{"@id":"_:6f34204f474b03bd840b5dddfc5d4af3bb7d250cece67618f1097b1169fbdd43_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:6f34204f474b03bd840b5dddfc5d4af3bb7d250cece67618f1097b1169fbdd43_b1n0"},"dct:title":{"@language":"sv","@value":"OECM 2024 (Sveriges rapportering till EEA)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:dba915a6-e791-ad86-27d5-f0cc6f0e51ed","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/cdda/oecm_2024.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data (shape)"}},{"@id":"urn:uuid:eb089c66-c270-f156-2fe0-c10e783f2832","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/cdda/oecm_2024.gpkg"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data (geopackage)"}}],"@id":"urn:source:6f34204f474b03bd840b5dddfc5d4af3bb7d250cece67618f1097b1169fbdd43"},{"@graph":[{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Havs- och vattenmyndigheten (HaV) bereder, tillsammans med länsstyrelserna, frågor om skyddade områden. HaV tar även fram förslag på vilka områden som ska skyddas, vilket regeringen sedan fattar beslut om. Naturvårdsverket upprätthåller listan över skyddade områden (enligt miljöbalken) och Ospar-områden ingår bland dessa."}},{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/39948786-a278-4cdb-8b95-2ce99f941f65","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:20c43178-2001-1aed-ae0e-df1316a97585"},{"@id":"urn:uuid:5ab48c7c-e0e9-5ff5-3ad5-d442212fc61d"},{"@id":"urn:uuid:5ed20755-ec5b-1230-5039-3a259b5430a9"},{"@id":"urn:uuid:761f4059-0d73-7970-da14-5c9edba91a99"},{"@id":"urn:uuid:ab83901b-57b5-1d26-67a1-e03a1f385691"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Skyddade områden i Östersjön som ingår i nätverket Ospar. Ospar är en regional konvention om att skydda miljön i Nordostatlanten. Där ingår Nordsjön, Skagerrak och delar av Kattegatt."},"dct:identifier":"39948786-a278-4cdb-8b95-2ce99f941f65","dct:issued":{"@type":"xsd:date","@value":"2022-01-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: marina områden i Sverige enligt Ospar"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:20c43178-2001-1aed-ae0e-df1316a97585","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:5ab48c7c-e0e9-5ff5-3ad5-d442212fc61d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSitesIS_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:5ed20755-ec5b-1230-5039-3a259b5430a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.havochvatten.se/hav/samordning--fakta/internationellt-arbete/konventioner/ospar---skydd-av-den-marina-miljon-i-nordostatlanten.html"},"dct:description":{"@language":"sv","@value":"Länk till Havs- och vattenmyndighetens sida där det finns mer information om Ospar."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Havs- och vattenmyndighetens hemsida"}},{"@id":"urn:uuid:761f4059-0d73-7970-da14-5c9edba91a99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-ic/ows?layers=PS.ProtectedSites.Ospar"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till WMS-tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:ab83901b-57b5-1d26-67a1-e03a1f385691","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/OSPAR.zip"},"dct:description":{"@language":"sv","@value":"Länk till dataset på en ftp-site för nedladdning, nedladdningsbara data är i form av shape-filer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:6f8f953e7dfe7117db09aa66cb7d2b43f3a39a812bc8b07153fa57498c2891d3"},{"@graph":[{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Markfuktighetsindex_NMD kombinerar det topografiska måttet Depth to Water med ett Soil Topographic wetness Index, se ARTIKEL Markfuktighetsindex_NMD.pdf för mer information om metoden."}},{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/cae71f45-b463-447f-804f-2847869b19b0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:044b18a4-1f2b-a11d-5635-6ec5e408b672"},{"@id":"urn:uuid:13c75625-3f85-d81f-d014-dc4267e81b30"},{"@id":"urn:uuid:2d680548-dba3-fa21-8e5f-56c7fb4e32d9"},{"@id":"urn:uuid:43120f4b-436f-16e6-ca4a-e8e1105eebda"},{"@id":"urn:uuid:4e3bbf98-8d0d-70b6-b211-817edc19d955"},{"@id":"urn:uuid:5b906e86-3b73-e72b-a705-d3d8485394e7"},{"@id":"urn:uuid:9d6b8faa-8f75-9c71-90d9-8838b99f293a"},{"@id":"urn:uuid:b8329aa8-b88a-3f71-f804-69dec36f01a4"},{"@id":"urn:uuid:c066ebc7-4593-7c45-bd5f-6511fb027dff"},{"@id":"urn:uuid:cdf50e9e-7b57-302f-debb-496e97c19215"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Markfuktighetsindexet är ett delresultat från produktionen av Nationella Marktäckedata där det användes till avgränsning av våtmarker. Produkten redovisar markfuktighet i ett kontinuerligt spektrum från torrt till blött och har 10 meters upplösning. Markfuktighetsindex_NMD kombinerar det topografiska måttet Depth to Water med ett Soil Topographic wetness Index, se ARTIKEL Markfuktighetsindex_NMD.pdf (tillgänglig via nedladdningsbart material) för mer information om metoden."},"dct:identifier":"cae71f45-b463-447f-804f-2847869b19b0","dct:issued":{"@type":"xsd:date","@value":"2019-03-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-03-18"},"dct:provenance":{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b1n0"},"dct:title":{"@language":"sv","@value":"Markfuktighetsindex, Nationella marktäckedata"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:044b18a4-1f2b-a11d-5635-6ec5e408b672","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_del4.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfuktighetsindex NMD Delområde 4"}},{"@id":"urn:uuid:13c75625-3f85-d81f-d014-dc4267e81b30","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_del1.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=TIFF[RESTRIKTIONER]=Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfukt