rce/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Beskriver utbredning (range) av livsmiljötyper listade i Art- och habitatdirektivet. Datasetet är representerat som en generalisering av  förekomst/distribution som inkluderar yttre gränser av förekomstens rutnät om 10*10 km och motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet år 2025 omfattande perioden 2019-2024."},"dct:identifier":"fbc70a9d-2243-419c-a317-ee3e83f6ceea","dct:issued":{"@type":"xsd:date","@value":"2020-09-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:6821ae386cb2408d0f31b3ad589422d587de8c069e672497c6480037fe7d6371_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:6821ae386cb2408d0f31b3ad589422d587de8c069e672497c6480037fe7d6371_b1n0"},"dct:title":{"@language":"sv","@value":"Livsmiljötypers utbredning, rapportering enligt art- och habitatdirektivet 2025"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0048f074-d012-141a-8345-e37ce83dfb1f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/hb-habitat/ows"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:6de0f519-0d3b-3b02-2946-0b0ba89d1b0e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/hb/SE_HB_HABITAT_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6821ae386cb2408d0f31b3ad589422d587de8c069e672497c6480037fe7d6371_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:6821ae386cb2408d0f31b3ad589422d587de8c069e672497c6480037fe7d6371"},{"@graph":[{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Regeringsuppdraget bygger på bl a sammanställning av PFAS-ämnen och bekämpningsmedel från olika källor där ursprunglig metod och syfte varierat."}},{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/f13ff20b-2385-40df-b7ab-7a16cb17335a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:003b0f1b-202f-81cc-0215-3e188d6ed0e4"},{"@id":"urn:uuid:384f9539-3ca2-8032-0728-5e3fcc5e6ddf"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"I rapporten redovisas resultaten från den screening av förekomsten av högfluorerade ämnen (PFAS) och växtskyddsmedel i yt- och grundvatten som Naturvårdsverket genomförde på uppdrag av regeringen under 2015-2016. Screeningen genomfördes dels genom nya mätningar av PFAS och växtskyddsmedel, dels genom att sammanställa resultaten från äldre mätningar. Resultaten visar att PFAS finns i halter som kan utgöra en risk för människors hälsa och miljö i anslutning till bekräftade punktkällor, främst brandövningsplatser. Halterna av växtskyddsmedel i miljön bedöms i dagsläget inte utgöra en ökande risk för hälsa eller miljö – ett fåtal ämnen förekommer mest frekvent i halter över rikt- eller gränsvärden."},"dct:identifier":"f13ff20b-2385-40df-b7ab-7a16cb17335a","dct:issued":{"@type":"xsd:date","@value":"2019-09-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-22"},"dct:provenance":{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b1n0"},"dct:title":{"@language":"sv","@value":"Högfluorerade ämnen (PFAS) och bekämpningsmedel: en sammantagen bild av förekomsten i miljön. Redovisning av ett regeringsuppdrag"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:003b0f1b-202f-81cc-0215-3e188d6ed0e4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/miljofororeningar/organiska-miljogifter/hogfluorerade-amnen-i-miljon-pfas/"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets webbsida"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:384f9539-3ca2-8032-0728-5e3fcc5e6ddf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Documents/publikationer6400/978-91-620-6709-0.pdf"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets rapport"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:6c6c0af66e240ff2d2d637e6b2c32bbc06c1a50b99673e3d20cb6452b9aee210_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:6c6c0af66e240ff2d2d637