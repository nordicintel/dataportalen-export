{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:e9c59610-f597-e370-e19c-a601383842be","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_ARTER_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjäns för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM tjäns för nedladdning av Inspire data"}},{"@id":"urn:uuid:eb8f870e-2207-d11d-aadb-8e22a51a3b64","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/geoserver/ARTER/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:774c7e47f5b2203e8bbd0c1ac8ddbc9193e7dbd32998c49a95da179472958af2_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:774c7e47f5b2203e8bbd0c1ac8ddbc9193e7dbd32998c49a95da179472958af2"},{"@graph":[{"@id":"_:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data har karterats i olika omgångar och med olika ambitionsnivå. Den första karteringen var inom ramen för projektet \"Basinventering av Natura 2000 och skyddade områden\" och efter att det projektet avslutades sker en mer kontinuerlig kartering av nytillkomna områden. Kartering sker med olika metoder beroende på områdenas storlek och karaktär. Vanliga metoder är flygbildstolkning eller tolkning i ortofoto som kompletteras med information från andra rikstäckande inventeringar (t ex Ängs- och betesmarksinventeringen, nyckelbiotopsinventeringen, våtmarksinventeringen). Data granskas sedan av länsstyrelsen och i vissa fall sker kompletteringar genom fältbesök. Det är viktigt att veta att en del områden endast är översiktligt karterade medan andra delar kan vara väldigt noggrant bedömda. Data är inte ”sanningen” utan en bedömning som gjorts vid ett visst tillfälle. Genom att granska attributet \"karteringsstatus\" går det att bedöma hur noggrant ett område är karterat och avgöra om det är tillräckligt för aktuellt användningsområde."}},{"@id":"_:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/A8C54FB7-1AEB-441C-B649-3E29FF86EB52","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:46e834c2-f2a4-13df-cf61-8cbe4b8a4c42"},{"@id":"urn:uuid:50e0f98f-34fe-0f9c-1cc2-d8e2566890d1"},{"@id":"urn:uuid:6958259d-f8ea-e31d-cefd-10030f41dbab"},{"@id":"urn:uuid:8acd1a9a-2dc1-31ee-848e-6933d2b0a5a7"},{"@id":"urn:uuid:a477de1d-17d6-63d2-2ff4-9f7f1d1f48e2"},{"@id":"urn:uuid:c63ecb1b-80a5-f8b6-4b79-6ca56af0ddc5"},{"@id":"urn:uuid:cbf7b3e6-47eb-ed38-09d8-e38853aac2b8"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:description":{"@language":"sv","@value":"Natura naturtypskartan beskriver utbredningen av naturtyper som ingår i EU:s Art- och habitatdirektivet, bilaga 1 (EEG 92/443) samt ett urval av andra naturtyper. Kodlistan och en kort beskrivning finns i dokumentet ”Tillgängliga koder för attributet naturtyp i NNK-IT systemet” (bifogas vid nedladdning av data).   Den geografiska utbredningen för data är beslutade Natura 2000-områden, naturreservat och nationalparker, men det kan finnas områden som ej är karterade."},"dct:identifier":"A8C54FB7-1AEB-441C-B649-3E29FF86EB52","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-09-23"},"dct:provenance":{"@id":"_:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28_b1n0"},"dct:title":{"@language":"sv","@value":"Naturtyper och biotoper: Natura naturtypskartan"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"N