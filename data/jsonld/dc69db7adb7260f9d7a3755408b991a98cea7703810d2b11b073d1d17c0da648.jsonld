dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:d5630a69-7966-b077-f5e8-e98d892b5058","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till dokumentation och legender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation och legender"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5"},{"@graph":[{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Se beskrivning."}},{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.9114 69.1594,29.5148 69.1594,29.5148 54.8741,7.9114 54.8741,7.9114 69.1594))"}},{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/d9037db2-2bfa-4775-81d5-a89a34d9c4e2","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:94f12d6a-7028-7dfa-2c85-936197817356"},{"@id":"urn:uuid:d2366fff-28b8-1445-623a-5e94dfbb68ad"},{"@id":"urn:uuid:f2e8dc92-d4fb-a3dd-97f5-5552fd5106c9"},{"@id":"urn:uuid:ffb345e0-71a4-bff4-a712-162c58563153"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Sverige har delats in i sex zoner för säkerhetsställande av luftkvalitet: Norra Sverige (SW1), Mellersta Sverige (SW2), Södra Sverige (SW3), Stockholms tätortsområde (SW4), Göteborgs tätortsområde (SW5) och Malmös tätortsområde (SW6). Denna datamängd beskriver dessa zoner.\n\nEnligt EU:s luftkvalitetsdirektiv ska övervakningen av luftkvalitet ske inom bestämda zoner, som täcker in hela landets yta. Luftkvaliteten inom varje zon ska klassificeras enligt särskilda utvärderingströsklar som, tillsammans med befolkningsmängder, reglerar den omfattning av kontroll (t.ex. kravet på antal mätstationer) som ska utföras i zonen enligt direktivet.\n\nAnsvaret för att kontrollera luftkvaliteten inom Sverige ligger främst på kommunerna. Kontrollen är dock inte direkt kopplad till de sex utvärderingszonerna, utan kommunerna får välja att antingen utföra arbetet själva eller samverka med andra. Zonerna används framförallt för utvärdering av marknära ozon inom Naturvårdsverkets luftövervakningsprogram samt för rapportering och uppföljning av luftkvalitet i enlighet med direktivens krav."},"dct:identifier":"d9037db2-2bfa-4775-81d5-a89a34d9c4e2","dct:issued":{"@type":"xsd:date","@value":"2020-02-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b1n0"},"dct:title":{"@language":"sv","@value":"Luftkvalitet: zonindelning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:94f12d6a-7028-7dfa-2c85-936197817356","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:d2366fff-28b8-1445-623a-5e94dfbb68ad","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/inspire/SE_AM_AQD_AirQualityManagementZone.gml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f2e8dc92-d4fb-a3dd-97f5-5552fd5106c9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:ffb345e0-71a4-bff4-a712-162c58563153","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wms?layers=AM.AirQualityManagementZone"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}}],"@id":"urn:source:0e816e7081e06a2f1334ceaa9fcba8f607a4737acf5dc7410187e309eb5525f7"},{"@graph":[{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data framställs genom att man antingen bedömer att arten finns i en speciell ruta i ett 10 X 10 km rutskikt över Sverige eller genom att koppla arten till rutorna i skiktet genom s.k. Overlay med de faktiska observationspunkterna."}},{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/5aeb53bf-bdb8-498e-86eb-885a43a0dead","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:1b890bc9-1483-7748-6d0c-82df055623fd"},{"@id":"urn:uuid:520c55c7-1b79-6b21-cc67-54dfeca21fcd"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Beskriver förekomsten (distribution)  av livsmiljötyper listade i Art- och habitatdirektivet. Förekomsten är representerad i ett rutnät om 10 X 10 km och datasetet motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet år 2025 omfattande perioden 2019-2024."},"dct:identifier":"5aeb53bf-bdb8-498e-86eb-885a43a0dead","dct:issued":{"@type":"xsd:date","@value":"2020-09-14"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b1n0"},"dct:title":{"@language":"sv","@value":"Livsmiljötypers förekomst, rapportering enligt art- och habitatdirektivet 2025"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:1b890bc9-1483-7748-6d0c-82df055623fd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/hb-habitat/ows"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:520c55c7-1b79-6b21-cc67-54dfeca21fcd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/hb/SE_HB_HABITAT_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:0ee36ad0332bb131634e8ca4990e86fb31b0dbc3ea490241e974dd298a4f0f74"},{"@graph":[{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tillkommer senare."}},{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/673b6ae2-293a-4b42-ba7a-a3a44bb72cbc","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:20f69da0-b73e-906b-fc64-8c584e4e8111"},{"@id":"urn:uuid:7126b21c-f5c4-dc8b-1cf8-07cb3568818b"},{"@id":"urn:uuid:963e2b67-dac9-8cf0-2b1e-fa6f7d5763a8"},{"@id":"urn:uuid:afa7d895-2744-a70d-d48b-3a45b25b9541"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Aktuella utsläppsdata från stora förbränningsanläggningar, rapportering 2021 (IED-direktivet 2010/75/EU). Gäller data från år 2020.\n\nFrån och med 2020 rapporterar medlemsstaterna aktuella utsläppsdata för Large Combustion Plants årligen integrerat med utsläppsdata (Industrial Emissions Directive) (European pollutant and Transfer Register), via den integrerade LCP- och E-PRTR-rapporteringen. De aktuella utsläppen kopplas via ett identifikationsnummer till respektive anläggning som rapporteras till EU Registry on Industrial sites."},"dct:identifier":"673b6ae2-293a-4b42-ba7a-a3a44bb72cbc","dct:issued":{"@type":"xsd:date","@value":"2020-09-10"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b1n0"},"dct:title":{"@language":"sv","@value":"Aktuella utsläppsdata från stora förbränningsanläggningar, IED-direktivet (2010/75/EU)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:20f69da0-b73e-906b-fc64-8c584e4e8111","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/pf/SE_PF_EURegistry_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:7126b21c-f5c4-dc8b-1cf8-07cb3568818b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/pf/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:963e2b67-dac9-8cf0-2b1e-fa6f7d5763a8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-production-and-industrial-facilities-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:afa7d895-2744-a70d-d48b-3a45b25b9541","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/pf/ows?layers=ProductionFacility"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:1392a3cc474ae90a064398b9abab669ea39173191d8f76a466810328c5237864"},{"@graph":[{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Fältinventering. Inventeringen av ängs- och hagmarker inleddes 1987 och gjordes länsvis. Syftet var att sprida kunskap om dessa markers kultur- och naturvärden samt att skapa ett underlagsmaterial för fysisk planering. Objekten avgränsades från början analogt på kartor och digitaliserades först i efterhand av länen. Efter noggranna studier av IR-bilder, skala 1:60 000, plottades intressanta områden in på topografiska kartor. Därefter inventerades dessa markområden noga i fält. Underlaget är delvis bordsdigitaliserat i skala 1:10 000/20 000 med ekonomiska kartan som bakgrund och delvis klippt ur ekonomiska kartan. Inventeringsmetodiken är beskriven i 'Inventering av Ängs- och hagmarker. Handbok' (Naturvårdsverket 1987)."}},{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/d978bfb2-95a3-4a0b-a9a1-12eb2f0b0339","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:ff5478c6-6ebc-c962-5569-a62f5306e334"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Inventeringen av ängs- och hagmarker inleddes 1987 och gjordes länsvis. Syftet var att sprida kunskap om dessa markers kultur- och naturvärden samt att skapa ett underlagsmaterial för fysisk planering. Objekten avgränsades från början analogt på kartor och digitaliserades först i efterhand av länen. Efter noggranna studier av IR-bilder, skala 1:60 000, plottades intressanta områden in på topografiska kartor. Därefter inventerades dessa markområden noga i fält. De områdestyper som Naturvårdsverket angett som utslagsgivande vid värderingen är: välhävdade områden med lång hävdkontinuitet, goda exempel på nyss nämnda, restaurerade, hotade natur-, vegetationstyper, biotoper, arter, mycket rik flora och/eller fauna, säregna eller märkliga områden. Underlaget är delvis bordsdigitaliserat i skala 1:10 000/20 000 med ekonomiska kartan som bakgrund och delvis klippt ur ekonomiska kartan. Inventeringsmetodiken är beskriven i 'Inventering av Ängs- och hagmarker. Handbok' (Naturvårdsverket 1987). 1999 initierade Naturvårdsverket ett projekt med syftet att koppla informationen i databasen till GIS-skikten och erhålla en nationell jämförbar produkt."},"dct:identifier":"d978bfb2-95a3-4a0b-a9a1-12eb2f0b0339","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b1n0"},"dct:title":{"@language":"sv","@value":"Ängs- och hagmarksinventeringen"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:ff5478c6-6ebc-c962-5569-a62f5306e334","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Grasmark/Angs_hagmarksinv.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=ESRI Shape"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}}],"@id":"urn:source:14ae328c08f1858f69bbc7ac435a07e93cb07b993488a294d7e4db906e263395"},{"@graph":[{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Beskrivs i rapport som finns tillgängligt tillsammans med data. \n\nDe ursprungliga filerna har komprimerats och paketerats om."}},{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/993a7ed2-4e69-47e8-ae01-ed3ab64aae5d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:0e0cbb11-4864-1feb-04cc-1a6af8673013"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Lövskogsanalys med fokus på livsmiljö för vitryggig hackspett är en beställning av Naturvårdsverket som genomförts av Calluna AB. Resultatet från analysen består förutom rapporten av ett antal kartskikt där olika scenarion analyserats. Utgångspunkten för analyserna har varit att ta fram kartunderlag för prioriteringar och strategisk planering inom åtgärdsprogrammet (ÅGP) för vitryggig hackspett. Underlagsdata för analyserna är från 2019. För mer information om kartskikten hänvisar vi till rapporten (se länk under fliken Nedladdningar och länkar). \n\nNaturvårdsverket har komprimerat de ursprungliga filerna till mer lätthanterlig storlek.\n\nData är inte tillgängligt on-line, men finns via NV-08549-20."},"dct:identifier":"993a7ed2-4e69-47e8-ae01-ed3ab64aae5d","dct:issued":{"@type":"xsd:date","@value":"2022-02-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b1n0"},"dct:title":{"@language":"sv","@value":"Lövskogsanalys: Livsmiljö vitryggig hackspett"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0e0cbb11-4864-1feb-04cc-1a6af8673013","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://naturvardsverket.diva-portal.org/smash/record.jsf?pid=diva2:1935386"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport Lövskogsanalys med fokus på livsmiljö för vitryggig hackspett"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:14c72f6d16e403af3b371d9bc5d9577efd388917f8f23189bb1aea0589afdb55"},{"@graph":[{"@id":"_:17dddbf27669c653a707fdab7d31d1f10c7786188a312fc290c9ae8914454f24_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av unionslistade arter under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."}},{"@id":"_:17dddbf27669c653a707fdab7d31d1f10c7786188a312fc290c9ae8914454f24_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:17dddbf27669c653a707fdab7d31d1f10c7786188a312fc290c9ae8914454f24_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/9607802d-8e24-454c-9b02-0fa158aabdeb","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:22a3633f-cab7-faeb-17c8-562d27850fe1"},{"@id":"urn:uuid:503cda4f-fae4-9a20-7ded-4443f426fd07"},{"@id":"urn:uuid:6889b689-192b-4f45-a49d-60f0d09184c6"},{"@id":"urn:uuid:95cc43a0-c29f-e8a7-e1f5-83b3449f0e45"},{"@id":"urn:uuid:a1fd09ba-2c7e-5325-7655-6676f2cfe5cf"},{"@id":