592077 69.059941))"}},{"@id":"_:c1fa88027de49b81747f2fc81e73c31310c1bd72cfcdbaacd7a60bb3f36881e8_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/68e8ccd8-cfcb-413c-9c32-ec0c169ef003","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:6140dc8d-9c32-1a7e-3eb6-d03925240606"},{"@id":"urn:uuid:7329e77a-bc1a-4e54-76b5-8389b002720e"},{"@id":"urn:uuid:73955a54-83c6-2913-c5b0-a8adae3938d8"},{"@id":"urn:uuid:ceea1d85-5920-2c4c-466a-5e6b3e15945c"},{"@id":"urn:uuid:eba05a97-2222-dbe7-60cb-c42321b27499"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Species Distribution beskriver förekomsten av arter listade i habitatdirektivet (EEG 92/443 annex 2, 4 och 5). Förekomsten är representerad i ett rutnät om 10 X 10 km och datasetet motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet.\n\nDatamängder avser rapportering år 2013. Observations perioden 2008-2012."},"dct:identifier":"68e8ccd8-cfcb-413c-9c32-ec0c169ef003","dct:issued":{"@type":"xsd:date","@value":"2022-11-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-25"},"dct:provenance":{"@id":"_:c1fa88027de49b81747f2fc81e73c31310c1bd72cfcdbaacd7a60bb3f36881e8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:c1fa88027de49b81747f2fc81e73c31310c1bd72cfcdbaacd7a60bb3f36881e8_b1n0"},"dct:title":{"@language":"sv","@value":"Arters utbredning, rapportering enligt art- och habitatdirektivet 2013"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:6140dc8d-9c32-1a7e-3eb6-d03925240606","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_ARTER_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:7329e77a-bc1a-4e54-76b5-8389b002720e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:73955a54-83c6-2913-c5b0-a8adae3938d8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd-arter/ows?layers=SD.ArtersUtbredning.2013"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:ceea1d85-5920-2c4c-466a-5e6b3e15945c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Stod-i-miljoarbetet/Rattsinformation/Direktiv/EU-register---forfattningar-inom-miljobalkens-omrade/Art--och-habitatdirektivet/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"}},{"@id":"urn:uuid:eba05a97-2222-dbe7-60cb-c42321b27499","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/hb-arter/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c1fa88027de49b81747f2fc81e73c31310c1bd72cfcdbaacd7a60bb3f36881e8_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:c1fa88027de49b81747f2fc81e73c31310c1bd72cfcdbaacd7a60bb3f36881e8"},{"@graph":[{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av invasiva främmande arter på EU:s förteckning under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter. Observationerna är inrapporterade av både allmänhet och experter och har verifierats av ArtDatabanken. Utöver detta har ingen bearbetning skett. Observationerna gäller för sexårsperioden fram till och med 2018."}},{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/5a668a28-3eb7-4040-a545-a0414788ebd7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:2844f033-5126-8c2f-1db6-3fc11d679d83"},{"@id":"urn:uuid:3e153d5a-2cee-d56e-7f9c-20c54b2cd151"},{"@id":"urn:uuid:54c7a013-8bbc-f435-aafe-b6d3ad641ca5"},{"@id":"urn:uuid:9c0e55c8-70b6-fa93-578a-767a0d2f66d5"},{"@id":"urn:uuid:ceb075fa-a5bc-e7fa-58c7-b4314b49f909"},{"@id":"urn:uuid:f9c75589-0ac9-b35b-2623-c6195572dafd"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av listade arter under en tidsperiod relevant för rapporteringen 2019 (2015-2018). Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har använts för olika arter."},"dct:identifier":"5a668a28-3eb7-4040-a545-a0414788ebd7","dct:issued":{"@type":"xsd:date","@value":"2019-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b1n0"},"dct:title":{"@language":"sv","@value":"Invasiva främmande arter, rapportering 2019: Alopochen aegyptiacus"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2844f033-5126-8c2f-1db6-3fc11d679d83","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Sa-mar-miljon/Vaxter-och-djur/Frammande-arter/Invasiva-frammande-arter/"},"dct:description":{"@language":"sv","@value":"Webbsida med information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:3e153d5a-2cee-d56e-7f9c-20c54b2cd151","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/ows?layers=SD.SpeciesDistribution.AlopochenAegyptiacus"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:54c7a013-8bbc-f435-aafe-b6d3ad641ca5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:9c0e55c8-70b6-fa93-578a-767a0d2f66d5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=se/eu/ias/envxkngww/IAS_Invasive_Alien_Species_SE.xml"},"dct:description":{"@language":"sv","@value":"Information on the reporting"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information on the reporting"}},{"@id":"urn:uuid:ceb075fa-a5bc-e7fa-58c7-b4314b49f909","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_IAS_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata som ingår i rapporteringen om Invasiva främmande arter år 2019"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f9c75589-0ac9-b35b-2623-c6195572dafd","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}}],"@id":"urn:source:c34d7ce7a5d5086c4edcc89d1f08073a1844f72d0c3a7d1d265aa2fdff51fedc"},{"@graph":[{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Luftkvalitetsdata som rapporteras till Naturvårdsverkets datavärd tillgängliggörs via en webbtjänst, en s.k. Sensor Observation Service (SOS). Data tillgängliggörs via SOS i realtid (dvs. halter för den senaste timmen) för ett urval luftföroreningar och mätstationer. Historiska data tillgängliggörs också via tjänsten. Data om halter av olika luftföroreningar, inklusive partiklar, kvävedioxid och marknära ozon, i Svenska städer och på landsbygden.\n\nAlla data som rapporteras till Naturvårdsverkets datavärd för luft tillgängliggörs via tjänsten. Det inkluderar kvalitetssäkrade historiska data och s.k. realtidsdata som rapporteras direkt från mätinstrument utan kvalitetsgranskning.\n\nTillgängliga data är framtagna av kommuner, länsstyrelser, Naturvårdsverket och andra organisationer såsom luftvårdsförbund, i enlighet med bestämmelserna i luftkvalitetsförordningen (SFS 2010:477) och Naturvårdsverkets föreskrifter om kontroll av luftkvalitet (NFS 2016:9)."}},{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/64f3850f-fa1a-4cbf-a2b5-a58fb85f8ff3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:2d6f20e9-96c9-1671-fc2c-ecd6b5cefb8d"},{"@id":"urn:uuid:9c66f34c-5e39-12f4-4ccd-e847f37bbdbb"},{"@id":"urn:uuid:c4f83435-62e2-b94e-9be4-8ddf7ba61c12"},{"@id":"urn:uuid:e884fd40-7db7-2901-7fe0-263e875a6d40"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Luftkvalitetsdata som rapporteras till Naturvårdsverkets datavärd tillgängliggörs via en webbtjänst, en s.k. Sensor Observation Service (SOS). Data tillgängliggörs via SOS i realtid (dvs. halter för den senaste timmen) för ett urval luftföroreningar och mätstationer. Historiska data tillgängliggörs också via tjänsten. Data om halter av olika luftföroreningar, inklusive partiklar, kvävedioxid och marknära ozon, i Svenska städer och på landsbygden.\n\nAlla data som rapporteras till Naturvårdsverkets datavärd för luft tillgängliggörs via tjänsten. Det inkluderar kvalitetssäkrade historiska data och s.k. realtidsdata som rapporteras direkt från mätinstrument utan kvalitetsgranskning.\n\nTillgängliga data är framtagna av kommuner, länsstyrelser, Naturvårdsverket och andra organisationer såsom luftvårdsförbund, i enlighet med bestämmelserna i luftkvalitetsförordningen (SFS 2010:477) och Naturvårdsverkets föreskrifter om kontroll av luftkvalitet (NFS 2016:9)."},"dct:identifier":"64f3850f-fa1a-4cbf-a2b5-a58fb85f8ff3","dct:issued":{"@type":"xsd:date","@value":"2019-10-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-10-12"},"dct:provenance":{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b1n0"},"dct:title":{"@language":"sv","@value":"Luftkvalitetsdata"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2d6f20e9-96c9-1671-fc2c-ecd6b5cefb8d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:9c66f34c-5e39-12f4-4ccd-e847f37bbdbb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/52North/client"},"dct:description":{"@language":"sv","@value":"SMHI / 52 North / SOS tjänst"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"SMHI / 52 North / SOS tjänst"}},{"@id":"urn:uuid:c4f83435-62e2-b94e-9be4-8ddf7ba61c12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.smhi.se/klimatdata/miljo/luftmiljodata"},"dct:description":{"@language":"sv","@value":"Webbsida för urval och nedladdning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Webbsida för urval och nedladdning"}},{"@id":"urn:uuid:e884fd40-7db7-2901-7fe0-263e875a6d40","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-environmental-monitoring-facilities-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:c4ca070625bacb39eb29966a0b5b9c7cef14514eec77a5cb822cd089a8841c50"},{"@graph":[{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Rutorna (5x5 km respective 10x10 km) är enligt indexrutor från Lantmäteriet.\nIndata för analysen är Kartdata KNAS som är baserad på GGD (terrängkarta och vägkarta), med aktualitet 2000-2006."}},{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/e818a249-413a-438f-b771-2a2fffd6477c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:75672ae3-733c-2152-5802-59de6f9321a3"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Två nationella GIS-skikt som visar andel våtmark i procent av landareal för rutnät (5 x 5 km repektive 10 x 10 km) i Sverige. \n\nAttribut:\nBK = Lantmäteriets benämning på 5 x 5 km respektive 10 x 10 km rutor\nTOTAL_HA = Areal land och vatten i hektar inom respektive ruta\nLAND_HA = Areal land i hektar inom respektive ruta\nVATMARK_HA = Areal våtmark i hektar inom respektive ruta\nANDEL_PROC = Andel våtmarksareal av landareal i hektar inom respektive ruta"},"dct:identifier":"e818a249-413a-438f-b771-2a2fffd6477c","dct:issued":{"@type":"xsd:date","@value":"2019-09-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-22"},"dct:provenance":{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b1n0"},"dct:title":{"@language":"sv","@value":"Våtmarkstäthet i procent av landareal, KNAS"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:75672ae3-733c-2152-5802-59de6f9321a3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/vatmark/vatmarkstathet.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar zip-fil med shape-filer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:c9d95ef61b3180fdabfa4e382bbb69c0ee5f349283b267f63e8ed53b8c1d259e"},{"@graph":[{"@id":"_:cb70afeb88e7d03acbdc39adf0c7eea5915dceec200d3a75610f81414e4f63d2_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data framställs genom att man antingen bedömer att arten finns i en speciell ruta i ett 10 X 10 km rutskikt över Sverige eller genom att koppla arten  till rutorna i skiktet genom s.k. Overlay med de faktiska observationspunkterna.\n\nDatasetet är representerat som en generalisering av  förekomst/distribution som inkluderar yttre gränser av förekomstens rutnät om 10*10 km och motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet år 2025 omfattande perioden 2019-2024."}},{"@id":"_:cb70afeb88e7d03acbdc39adf0c7eea5915dceec200d3a75610f81414e4f63d2_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((8.8917 70.5807,29.6478 70.5807,29.6478 54.785,8.8917 54.785,8.8917 70.5807))"}},{"@id":"_:cb70afeb88e7d03acbdc39adf0c7eea5915dceec200d3a75610f81414e4f63d2_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/13ac9724-ffae-4291-8978-43ace1dd6277","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:27f7f7f0-5277-32dc-63e6-cc2364a26052"},{"@id":"urn:uuid:f5a2a3c0-4457-d8ee-125f-815923cd7d6e"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Beskriver utbredning (range) av arter listade i habitatdirektivet (EEG 92/443 annex 2, 4 och 5). Datasetet är representerat som en generalisering av  förekomst/distribution som inkluderar yttre gränser av förekomstens rutnät om 10*10 km och motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet år 2025 omfattande perioden 2019-2024."},"dct:identifier":"13ac9724-ffae-4291-8978-43ace1dd6277","dct:issued":{"@type":"xsd:date","@value":"2019-09-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05