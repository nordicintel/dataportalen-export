{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data underhålls inte längre utan har ersatts av Nationella marktäckedata.\n\nKNAS är en satellitbildbaserad klassning av skogstyper som läggs samman med olika kartdata (vägkarta, terrängkarta, Svenska marktäckedata (SMD), Ängs- och betesmarksinventeringen (TUVA).   Karteringen görs per satellitbild och ett delresultat är en grundkartering som täcker mer än 95 % av Sverige. Den slutliga karteringen omfattar de objekt som ska karteras. Dessa har genomgått en visuell kontroll och en bestämning av om kala skogsområden är skogliga impediment eller hygge/ungskog. Den aktuella versionen av KNAS är KNAS 6 som är en sammanslagning av KNAS 4 (nedanför fjällnära gränsen) och KNAS 5 (ovanför fjällnära gränsen)."}},{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/6f7a777a-14f8-4939-a4aa-9cff2c40b7a8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:2a3cab08-c846-2ea5-543f-18c661c3a08c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Dessa data underhålls inte längre utan har för operativ användning ersatts av Nationella marktäckedata, NMD. Data är fortsatt tillgängliga för nedladdning om det finns intresse av dessa äldre data.\n\nTidigare beskrivning av data:\nKontinuerlig Naturtypskartering av Skyddade områden (KNAS) är en nationellt homogen naturtypsindelning av skyddade områden. KNAS-karteringen täcker naturreservat, nationalparker, naturvårdsområden och Natura 2000 områden. Den används som underlag för strategier och praktiskt naturvårdsarbete samt för nationell och internationell rapportering.   KNAS är en satellitbildbaserad klassning av skogstyper som läggs samman med olika kartdata (vägkarta, terrängkarta, Svenska marktäckedata (SMD), Ängs- och betesmarksinventeringen (TUVA)."},"dct:identifier":"6f7a777a-14f8-4939-a4aa-9cff2c40b7a8","dct:issued":{"@type":"xsd:date","@value":"2021-03-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-03-16"},"dct:provenance":{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b1n0"},"dct:title":{"@language":"sv","@value":"Naturtypskartering (KNAS)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2a3cab08-c846-2ea5-543f-18c661c3a08c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/KNAS/"},"dct:description":{"@language":"sv","@value":"Länsvis nedladdningsbar fil (shape) innehållande KNAS-karteringen"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:044fd9c273fe89962598b4add42192360c804b67f3bce5a42cad40da85af5442"},{"@graph":[{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Detta ska fyllas inom kort."}},{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/cbb34ce3-c064-4f75-b955-1cefb0315a26","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0797d37b-df62-b84f-1f63-d84bd9890bc5"},{"@id":"urn:uuid:bac79b66-b4dc-96b3-62c3-a0001bd9fa6e"},{"@id":"urn:uuid:bfcb2016-fff5-ef7e-72d0-fc2034f5e49c"},{"@id":"urn:uuid:c5175d7e-70ae-6e47-b46e-c05587b33cb5"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Fågelutbredning 2013-2018. Data rapporterad enligt fågeldirektivet 2019. Data avser perioden 2013-2018."},"dct:identifier":"cbb34ce3-c064-4f75-b955-1cefb0315a26","dct:issued":{"@type":"xsd:date","@value":"2019-09-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b1n0"},"dct:title":{"@language":"sv","@value":"Fågelutbredning, rapportering enligt fågeldirektivet 2019"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0797d37b-df62-b84f-1f63-d84bd9890bc5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:bac79b66-b4dc-96b3-62c3-a0001bd9fa6e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_BIRD_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata som ingår i rapporteringen om Fågeldirektivet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:bfcb2016-fff5-ef7e-72d0-fc2034f5e49c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd-fagel/ows?layers=SD.FaglarsUtbredning.2019"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:c5175d7e-70ae-6e47-b46e-c05587b33cb5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Stod-i-miljoarbetet/Rattsinformation/Direktiv/EU-register---forfattningar-inom-miljobalkens-omrade/Fageldirektivet/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:0589f6aa9c8e70e6b76dc1fcdc8e1362852e55c76cb93db84b284c9f15f0eb1a"},{"@graph":[{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Äldre beslut importerade från länsstyrelsernas digitala databaser i samband med skapandet. Nyare beslut registreras kontinuerligt direkt i geodatabasen (naturvårdsregistret) av respektive länsstyrelse. Registreringen styrs utifrån att attribut är obligatoriska/frivilliga. Geometrin till äldre beslut är justerad mot fastighetsgränser, nyare beslut ges geometri från Lantmäteriet i samband med inmätning."}},{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/dd8371a0-f692-44e3-bd0b-25de8dee8906","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:1d981b1c-4c41-1fa7-c9bc-e887d313344f"},{"@id":"urn:uuid:372e7923-2c5b-7cc2-c377-83ef523679f1"},{"@id":"urn:uuid:551b1d04-b465-47a4-66ec-2f197402c77b"},{"@id":"urn:uuid:62e3c633-9b8e-2a52-afb2-6a5233bae6e2"},{"@id":"urn:uuid:6e9fe6e4-fb75-1440-f89b-eb4d149653bf"},{"@id":"urn:uuid:75971489-0f0a-2d81-9bf0-0be3e41017f7"},{"@id":"urn:uuid:7f1443f1-9d39-7708-f0df-54920b429fd8"},{"@id":"urn:uuid:d031f85d-1d4a-7a7f-28df-5dcba95620c5"},{"@id":"urn:uuid:d5630a69-7966-b077-f5e8-e98d892b5058"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Länsstyrelsen eller kommunen kunde innan miljöbalken trädde i kraft avsätta naturvårdsområden med stöd av naturvårdslagen. Skyddsformen var svagare än naturreservatet och fick inte hindra pågående markanvändning, som till exempel skogsbruk. De flesta naturvårdsområden inrättades för att värna om landskapsbilden, framför allt i kusttrakter, eller för att upprätthålla skötseln av slåtterängar och betesmarker. Några kommuner har använt skyddsformen för att slå vakt om populära friluftsmarker. Sedan miljöbalken trädde i kraft har möjligheten att skapa nya naturvårdsområden upphört. Men redan bildade naturvårdsområden finns kvar och ska enligt miljöbalken numera betraktas som naturreservat."},"dct:identifier":"dd8371a0-f692-44e3-bd0b-25de8dee8906","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:0c747b7fb3dee8e08f114c6b69cb3dbe11b5faf53913f81ab8168a3a4068fbd5_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: naturvårdsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf