6533c65f1ae","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-utility-and-government-services-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}}],"@id":"urn:source:3572de2d9fd8308212f0a3af68f12372fbf5c6d1949ac34bf17b83e161992eb2"},{"@graph":[{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Naturvårdsverket tog i början av 1990-talet fram Myrskyddplan för Sverige och planen publicerades 1994. Planen innehöll de myrar som Naturvårdsverket ansåg borde ges ett långsiktigt skydd. Huvudsakliga underlagsdata till planen var resultat från våtmarksinventeringen i de län där den genomförts och andra typer av länsvisa våtmarksinventeringar. Planen innehöll också myrar som redan skyddats i de fall det var myrar med höga naturvärden eller stora arealer med myr så att rapporten innehöll alla myrar med höga bevarandevärden i landet. Underlaget för dessa områden var utöver våtmarksinventeringen även naturvårdsregistret och beslut om områdesskydd. Då våtmarksinventeringen inte påbörjats i Norrbottens län gjordes inget fullständigt urval av myrar i det länet. En reviderad version av planen kom 2007 och därför bör det GIS-skikt som visar situationen 1994 inte användas annat än om Myrskyddsplanens historik ska belysas i något sammanhang."}},{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/5ac8225b-60bd-42ec-9c94-658918c81904","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:00e598a4-143b-aeb2-8dda-6d481588a9c5"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Naturvårdsverket tog i början av 1990-talet fram Myrskyddplan för Sverige och planen publicerades 1994. Planen innehöll de myrar som Naturvårdsverket ansåg borde ges ett långsiktigt skydd och myrar med höga naturvärden i redan skyddade områden. En reviderad version av planen kom 2007 och därför bör det GIS-skikt som visar situationen 1994 inte användas. Filer med olika avsnitt av rapporten finns nedladdningsbara på webbsidan dit den första länken ovan går. En digital version av hela rapporten kan beställas från data@naturvardsverket.se."},"dct:identifier":"5ac8225b-60bd-42ec-9c94-658918c81904","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b1n0"},"dct:title":{"@language":"sv","@value":"Myrskyddsplan 1994"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:00e598a4-143b-aeb2-8dda-6d481588a9c5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/skyddad-natur/myrskyddsplan-for-sverige"},"dct:description":{"@language":"sv","@value":"Länk till hemsida med information och möjlighet att ladda ned filer med rapporten."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till hemsida med information och möjlighet att ladda ned filer med rapporten."}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:3943e8b2f9101822fb9bda346390e64de5b49c0034638668a6c2aa3f00c501bc"},{"@graph":[{"@id":"_:3c2aea83d5cdd380b6a17202b4593a4fa7037d71d0194dd6a3c36f3eb3cc5c00_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Fylls inom kort!"}},{"@id":"_:3c2aea83d5cdd380b6a17202b4593a4fa7037d71d0194dd6a3c36f3eb3cc5c00_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:3c2aea83d5cdd380b6a17202b4593a4fa7037d71d0194dd6a3c36f3eb3cc5c00_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http: