metadata."}},{"@id":"_:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/8853721d-a466-4c01-afcc-9eae57b17b39","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:065e8c28-34a9-e3f3-fe4e-69d2a4bd629d"},{"@id":"urn:uuid:1b532ae9-a92a-edd6-e06a-14aa11ffb81d"},{"@id":"urn:uuid:2229f3a8-0e00-3c36-2f1f-a21aaaa9807e"},{"@id":"urn:uuid:2931c6f5-7fa5-b11c-1104-9b33c442c120"},{"@id":"urn:uuid:390d9a88-1c92-8375-d3f4-be1ddd62477a"},{"@id":"urn:uuid:44177797-eb63-1552-9e9a-6cb95f176d25"},{"@id":"urn:uuid:56d9cce8-1b74-dcda-1df5-5c1008395fb4"},{"@id":"urn:uuid:6e028915-1809-55c0-fc7a-a4f488bccbe0"},{"@id":"urn:uuid:7beacb72-a865-e448-c322-34c40504cf17"},{"@id":"urn:uuid:7bf4917f-deb1-199a-93e0-2e1635f421f6"},{"@id":"urn:uuid:c2a308e8-4397-0e27-72f8-d0b8f2321da2"},{"@id":"urn:uuid:c8e83464-fc7f-5def-275a-696ba0fdd420"},{"@id":"urn:uuid:d1728d36-de00-5ce4-b03c-7b023e65fb68"},{"@id":"urn:uuid:e7c4a440-2542-302e-3b8c-093ff364f8d0"},{"@id":"urn:uuid:f77f37ca-c315-0def-e8b7-39f439795f2c"},{"@id":"urn:uuid:f947afad-18fc-d416-7f05-8974dc06db2c"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Nationella marktäckedata (NMD) är en heltäckande kartering av Sverige. Syftet är att få grundläggande information om landskapet och hur det förändras. Den första karteringen genomfördes 2017- februari 2019 och benämns NMD2018, den senaste versionen är NMD2023 och planen är att data ska uppdateras vart 5:e år. \n \nNMD består av en baskartering med ett antal tematiska klasser i hierarkiska nivåer. För senaste versionen, NMD2023, finns baskarteringen i två versioner 0.x och 2.x med olika antal klasser (där högre prefix-siffra indikerar en större tematisk indelning). Karteringen är i rasterformat med 10 meters upplösning och med en minsta karteringsenhet ned till 0,01 hektar. \n\nFör att skapa ett underlag med nationell täckning har vi tagit fram en sammanlagrad version av NMD2023 och NMD2018 för version 0.x. Utgångspunkten är NMD2023, som har kompletterats med information från NMD2018 i de områden där data saknas i NMD2023. Det sammanlagrade lagret kan därför användas när nationell täckning är viktig, samtidigt som det är bra att känna till att informationen i vissa områden härrör från NMD2018 där NMD2023 saknar data.\n\nUtöver baskarteringen ingår följande tilläggsskikt: \n- objekthöjd och -täckning \n- produktivitet (skoglig produktivitet)\n- markanvändning\n- låg fjällskog (endast för NMD2018, därefter inkluderat i basskiktet)\n- trädslag\n- jordbearbetning\n\nFör tilläggsskikten finns separata metadatabeskrivningar och nedladdningstjänster. För samtliga dataset finns produktbeskrivningar tillgängligt."},"dct:identifier":"8853721d-a466-4c01-afcc-9eae57b17b39","dct:issued":{"@type":"xsd:date","@value":"2020-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-03"},"dct:provenance":{"@id":"_:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:afbc72692dc36e95dfcbda4f84355d1539bf6ed677237a8ebfb0c7e22a234088_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata: basskikt"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:065e8c28-34a9-e3f3-fe4e-69d2a4bd629d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:description":{"@language":"sv","@value":"Länk till mer information på Naturvårdsverkets hemsida."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida för NMD"}},{"@id":"urn:uuid:1b532ae9-a92a-edd6-e06a-14aa11ffb81d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v2_x/NMD2023_Produktbeskrivning_Basskikt_NMD2023_v2_x.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, NMD2023 v2.x"}},{"@id":"urn:uuid:2229f3a8-0e00-3c36-2f1f-a21aaaa9807e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/lc-nmd/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till nationell WMS-tjänst som innehåller NMD basskikt och tilläggskiten för låg fjällskog och produktivitet."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS NMD2018 och NMD2023"}},{"@id":"urn:uuid:2931c6f5-7fa5-b11c-1104-9b33c442c120","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v0_x/NMD2023_basskikt_v0_3.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Basskikt NMD2023 v0.3"}},{"@id":"urn:uuid:390d9a88-1c92-8375-d3f4-be1ddd62477a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Jamforelse_NMD_RT_20200908.pdf"},"dct:description":{"@language":"sv","@value":"Länk till dokument med jämförelse av NMD med data från Riksskogstaxeringen och NILS."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Dokumentation med jämförelse av NMD2018 med data från Riksskogstaxeringen och NILS"}},{"@id":"urn:uuid:44177797-eb63-1552-9e9a-6cb95f176d25","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Basskikt_v0_x/NMD2023_Produktbeskrivning_Basskikt_NMD2023_v0_x.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, NMD2023 v0.x"}},{"@id":"urn:uuid:56d9cce8-1b74-dcda-1df5-5c1008395fb4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD2