tyrelsen mot fastighetsgränser och ortofoton."}},{"@id":"_:ec1f68900289018457e917d62ce6bf514500f33bc785ac47306f31634f01909d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:ec1f68900289018457e917d62ce6bf514500f33bc785ac47306f31634f01909d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/b4bb8837-8980-4093-be7e-c09f650df996","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:047898d4-bb4b-00ec-16e8-c46a70ca83ef"},{"@id":"urn:uuid:24ca8ca7-918f-f256-50e2-432c4fe029ee"},{"@id":"urn:uuid:41602084-e114-00e2-6a11-28bcf4639d72"},{"@id":"urn:uuid:5be190ce-0cc2-4f1e-41ad-d8c496c305f7"},{"@id":"urn:uuid:679afe0f-35e5-2aa6-2d55-508713330358"},{"@id":"urn:uuid:6c498e3a-a7d0-d2c9-84f8-943922ca8d36"},{"@id":"urn:uuid:78e46e1f-5386-d583-64c2-def651d4c93f"},{"@id":"urn:uuid:9cc6b7b1-22d4-ab19-099f-9adaeebf668a"},{"@id":"urn:uuid:9eea5071-41d3-14f4-80d2-1585d60e0f55"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Det är möjligt att skydda till exempel häckande fåglar eller sälkolonier genom att bilda \"Djur- och växtskyddsområden\" och då förbjuda tillträde till ett område under vissa av årets månader (Miljöbalken 7 kap § 12). \nDe flesta av de drygt 1000 djurskyddsområden som finns i dag ligger vid kuster eller insjöar och har tillkommit för att freda sjöfågel eller säl.\nInom naturreservat och nationalparker kan istället beslut om tillträdesförbud skapas."},"dct:identifier":"b4bb8837-8980-4093-be7e-c09f650df996","dct:issued":{"@type":"xsd:date","@value":"2020-09-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-09-23"},"dct:provenance":{"@id":"_:ec1f68900289018457e917d62ce6bf514500f33bc785ac47306f31634f01909d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ec1f68900289018457e917d62ce6bf514500f33bc785ac47306f31634f01909d_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: djur- och växtskyddsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:047898d4-bb4b-00ec-16e8-c46a70ca83ef","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps/wfs?"},"dct:description":{"@language":"sv","@value":"WFS tjänst för naturvårdsregistret enligt Inspire"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:24ca8ca7-918f-f256-50e2-432c4fe029ee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Naturvardsregistret_beskrivning_av_oppna_data.pdf"},"dct:description":{"@language":"sv","@value":"Länk till produktbeskrivning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av öppna data"}},{"@id":"urn:uuid:41602084-e114-00e2-6a11-28bcf4639d72","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSites_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för data som ingår i INSPIRE bilaga 1, Djur- och växtskyddsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:5be190ce-0cc2-4f1e-41ad-d8c496c305f7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/DVO.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data (shape)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:679afe0f-35e5-2aa6-2d55-508713330358","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-nvr/ows?layers=PS.ProtectedSites.DVO"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:6c498e3a-a7d0-d2c9-84f8-943922ca8d36","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/skyddad-natur/"},"dct:description":{"@language":"sv","@value":"L