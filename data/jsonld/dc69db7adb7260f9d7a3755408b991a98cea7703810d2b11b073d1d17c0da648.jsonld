ttribut är obligatoriska/frivilliga. Geometrin digitaliseras av länsstyrelsen mot fastighetsgränser och ortofoton."}},{"@id":"_:ff52e09a2b51c662f8d0253e2b766e8212dd063eb9c48a1df303d2910a564940_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:ff52e09a2b51c662f8d0253e2b766e8212dd063eb9c48a1df303d2910a564940_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/c3dd73b1-1c82-4db5-aac3-c8c6f240fa25","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:0924a49e-64e5-ed4d-7482-6b79476a4cf7"},{"@id":"urn:uuid:231ee644-0f3d-1673-4cfe-19358dfb689d"},{"@id":"urn:uuid:8babb66c-28e9-3bf4-3362-33ffe1d83cc8"},{"@id":"urn:uuid:99fddd4d-7fd5-2eb8-1122-2ae730655466"},{"@id":"urn:uuid:b401af8d-6370-5c45-45d4-f1e13279c1e7"},{"@id":"urn:uuid:d9d3619d-2e69-fb06-aefb-1fd58350372f"},{"@id":"urn:uuid:e19f1ec9-7071-87f2-d7b5-ce820470668a"},{"@id":"urn:uuid:eea3dff1-b40c-56ce-21c8-4949f84fc2f4"},{"@id":"urn:uuid:f73c961a-1cad-0cb6-7052-52bd52ef479c"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:description":{"@language":"sv","@value":"Biotopskyddsområde används för att bevara mindre livsmiljöer för nationellt hotade arter och små skyddsvärda naturtyper i skogs- eller jordbrukslandskapet. Skogliga biotopskyddsområden hanteras av Skogsstyrelsen."},"dct:identifier":"c3dd73b1-1c82-4db5-aac3-c8c6f240fa25","dct:issued":{"@type":"xsd:date","@value":