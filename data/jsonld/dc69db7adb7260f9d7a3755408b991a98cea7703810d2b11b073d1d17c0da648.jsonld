publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:836f7149-7ee6-e20e-64db-0a57efa6a418","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?cql_filter=(datahost_id=7)"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst. Länken använder en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen endast de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också klicka på \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välj lagret \"active_site\". En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:89ecb5aa-7774-befa-7a99-5f8d80cf7dc8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/docs/atom/SE_EF_StnReg_DV_Luftkvalitet/atomDatasetFeed-SE_EF_StnReg_DV_Luftkvalitet.xml"},"dct:description":{"@language":"sv","@value":"ATOM tjänst för nedladdning av Inspire anpassade GML filer. OBS! Filerna kan vara mycket stora!"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:960fd9e3-af0c-17f5-1457-104d5c894e83","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-environmental-monitoring-facilities-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resou