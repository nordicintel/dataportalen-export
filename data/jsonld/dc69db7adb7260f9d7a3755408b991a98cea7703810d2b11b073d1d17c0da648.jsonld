fe677bd49dd434fb9f69e46f68fffb28_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:795d9c18245648713ed93921fe290876fe677bd49dd434fb9f69e46f68fffb28"},{"@graph":[{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data skapas av den organisation som förvaltar ett skyddat område eller statlig led  (länsstyrelse, kommun eller utsedd förvaltare). Data registreras och ajourhålls via handläggarstödet SkötselDOS där förvaltaren genom en speciell klarmarkering godkänner publicering som öppen data."}},{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/af2e37d3-45b0-4623-bcf2-0765c8ca7ab5","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:021a56ed-9c54-b705-38c4-0ff8ad2a0b42"},{"@id":"urn:uuid:3d08d7d5-ecf4-fd78-2000-e3a19a25633f"},{"@id":"urn:uuid:3e0ba123-0278-eb47-a648-f81d8ae0a8e6"},{"@id":"urn:uuid:8a01d775-7ae0-11d2-70da-6e4f5d0a3363"},{"@id":"urn:uuid:dd2d5f13-3634-a04c-2c1f-d39737d13116"},{"@id":"urn:uuid:eb54da33-5fb7-acc7-de63-d44fb944b452"},{"@id":"urn:uuid:fd015d15-5372-b55b-16fb-9a01a5aba92c"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Data för leder och anordningar inom skyddade områden samt statliga leder i fjällen finns tillgängliga enligt principen för öppen data.\n\nData som publiceras registreras och underhålls av länsstyrelser och utsedda förvaltare för de skyddade områdena och de statliga lederna i fjällen.\n\nSom stöd i användningen finns en produktbeskrivning och förslag till legender tillgängliga för nedladdning.\n\nSynpunkter på data och tjänster kan skickas till data@naturvardsverket.se."},"dct:identifier":"af2e37d3-45b0-4623-bcf2-0765c8ca7ab5","dct:issued":{"@type":"xsd:date","@value":"2022-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-07-07"},"dct:provenance":{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b1n0"},"dct:title":{"@language":"sv","@value":"Friluftsliv: Leder och anordningar i skyddade områden"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:021a56ed-9c54-b705-38c4-0ff8ad2a0b42","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/leder_friluftsliv/wfs?"},"dct:description":{"@language":"sv","@value":"Länk till WFS-tjänst med leder."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS med leder"}},{"@id":"urn:uuid:3d08d7d5-ecf4-fd78-2000-e3a19a25633f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/anordningar_friluftsliv/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till WMS-tjänst med anordningar för friluftsliv"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS med anordningar för friluftsliv"}},{"@id":"urn:uuid:3e0ba123-0278-eb47-a648-f81d8ae0a8e6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/friluftsliv/"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbart data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:8a01d775-7ae0-11d2-70da-6e4f5d0a3363","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/friluftsliv/Leder_och_friluftsanordningar_dokumentation_och_legender.zip"},"dct:description":{"@language":"sv","@value":"Länk till ftp för nedladdning av legender och beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till ftp för nedladdning av legender och beskrivning av data"}},{"@id":"urn:uuid:dd2d5f13-3634-a04c-2c1f-d39737d13116","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/leder_friluftsliv/wms?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till WMS-tjänst med leder"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS med leder"}},{"@id":"urn:uuid:eb54da33-5fb7-acc7-de63-d44fb944b452","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/anordningar_friluftsliv/wfs?"},"dct:description":{"@language":"sv","@value":"Länk till WFS-tjänst med friluftsanordningar."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS med friluftsanordningar"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:fd015d15-5372-b55b-16fb-9a01a5aba92c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/friluftsliv/Leder_och_friluftsanordningar_beskrivning_av_oppna_data.pdf"},"dct:description":{"@language":"sv","@value":"Länk till ftp för nedladdning av dokument med produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}}],"@id":"urn:source:79bc7448ab31d482162f8e5848db307b64b02b6c706dae45037ca69b41e9eaf7"},{"@graph":[{"@id":"_:80301bff4cba88580c1336d68a90fd2a298322a7d758ea90cee25c03f8a3f2eb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data innehåller flygbildstolkningar av Natura 2000 och skyddade områden som genomfördes inom projektet \"Basinventering av Natura 2000 och skyddade områden\". Flygbildstolkningen är gjord baserad på infraröda flygbilder från 4600 meters höjd, tagna 1997 eller senare. Tolkning har skett enligt en fastställd manual och har fokus på att tolka de naturtyper som ingår i Art- och Habitatdirektivets (EEG 92/443),  bilaga 1. Flygbildstolkningen var en grund för ett fortsatt arbete där länsstyrelserna genom inventeringar bedömde naturtyper, strukturer och funktioner inom de aktuella områdena. Uppdateringar som gjorts finns i datasetet \"Naturtypskarta\".   Projektet och data beskrivs i rapporterna \"Basinventering av Natura 2000 och skyddade områden 2004-2008\" ISBN: 978-91-620-5990-3 och \"Data från basinventering av Natura 2000 och skyddade områden\", ISBN: 978-91-620-5907-1.   I mars 2013 uppdaterades den nedladdningsbara filen med några områden som saknats tidigare."}},{"@id":"_:80301bff4cba88580c1336d68a90fd2a298322a7d758ea90cee25c03f8a3f2eb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:80301bff4cba88580c1336d68a90fd2a298322a7d758ea90cee25c03f8a3f2eb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/CF8B023A-A8CB-459A-BA2A-1E406307D024","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:c07bd4a0-fa4f-be7d-2962-6a44267bd3f8"},{"@id":"urn:uuid:eb9d6872-6cf3-bb0b-f659-ffedc167eb79"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data innehåller flygbildstolkningar av Natura 2000 och skyddade områden som genomfördes inom projektet \"Basinventering av Natura 2000 och skyddade områden\" och som avslutades 2008. Flygbildstolkningen är gjord av Metria och är baserad på infraröda flygbilder från 4600 meters höjd, tagna 1997 eller senare. Tolkning har skett enligt en fastställd manual och har fokus på att tolka de naturtyper som ingår i Art- och Habitatdirektivets bilaga 1.\n\nData är inte tillgängliga on-line men finns via NV-05499-24"},"dct:identifier":"CF8B023A-A8CB-459A-BA2A-1E406307D024","dct:issued":{"@type":"xsd:date","@value":"2019-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:80301bff4cba88580c1336d68a90fd2a298322a7d758ea90cee25c03f8a3f2eb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:80301bff4cba88580c1336d68a90fd2a298322a7d758ea90cee25c03f8a3f2eb_b1n0"},"dct:title":{"@language":"sv","@value":"Basinventering, flygbildstolkning"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:c07bd4a0-fa4f-be7d-2962-6a44267bd3f8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.diva-portal.org/smash/get/diva2:1618296/FULLTEXT01.pdf"},"dct:description":{"@language":"sv","@value":"Länk till rapport med information om data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport med information om data"}},{"@id":"urn:uuid:eb9d6872-6cf3-bb0b-f659-ffedc167eb79","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.diva-por