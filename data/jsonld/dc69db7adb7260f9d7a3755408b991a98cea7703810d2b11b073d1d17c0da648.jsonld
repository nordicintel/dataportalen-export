diaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}}],"@id":"urn:source:907ddfb6b9388db72fb033a0e55153fa2a36d7117528a5d0b039c7dc48d4f10e"},{"@graph":[{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Detta datapaket innehåller GIS-skikt med polygoner som avbildar områden känsliga för övergödning med kväve (N) och fosfor (P) och som är en del av data som rapporteras till Europeiska Miljöbyrån enligt Avloppsvattendirektivet (Urban Waste Water Directive, 91/271/EEG)."}},{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/12dacd90-1479-4a39-be35-087604ce2b11","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:5551500e-4efb-304a-18e1-40f02da2201d"},{"@id":"urn:uuid:6641fbcb-5ec3-4cfe-69a1-df4da1c89f5a"},{"@id":"urn:uuid:ad64ac66-b9a6-73ac-bf19-117eca8f08b9"},{"@id":"urn:uuid:c7aa33d9-f692-3356-9dfe-1e51e213585f"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Områden känsliga för övergödning enligt rådets direktiv 91/271/EEG av den 21 maj 1991 om rening av avloppsvatten från tätbebyggelse.\n\nDetta datapaket innehåller GIS-skikt med polygoner som avbildar områden känsliga för övergödning med kväve (N) och fosfor (P) och som är en del av data som rapporteras till Europeiska Miljöbyrån enligt Avloppsvattendirektivet (Urban Waste Water Directive, 91/271/EEG)."},"dct:identifier":"12dacd90-1479-4a39-be35-087604ce2b11","dct:issued":{"@type":"xsd:date","@value":"2022-11-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-11-25"},"dct:provenance":{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b1n0"},"dct:title":{"@language":"sv","@value":"Områden känsliga för övergödning enligt avloppsvattendirektivet (91/271/EEG) - Upptagningsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:5551500e-4efb-304a-18e1-40f02da2201d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-area-managementrestrictionregulation-zones-and-reporting-units-technical_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:6641fbcb-5ec3-4cfe-69a1-df4da1c89f5a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/am-uwwtd/ows?layers=AM.sensitiveAreaCatchments"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:ad64ac66-b9a6-73ac-bf19-117eca8f08b9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/am/am_uwwtd_avloppsvattendirektivet_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"ATOM feed för Inspire anpassad data som ingår i Naturvårdsverkets rapportering enligt avloppsvattendirektivet (Urban Waste Water Directive, 91/271/EEG)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:c7aa33d9-f692-3356-9dfe-1e51e213585f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/amnesomraden/avlopp/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=html"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:92fe604b69b3d4e1873147337ba38e19edc1593878795af0ecf72c8297572aa1"},{"@graph":[{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Myrvegetationstypskartan har flera tillämpningsområden, t.ex. att hitta unika livsmiljöer för viktiga arter, för att hitta variationsrika våtmarksområden och för att studera biologisk mångfald.\nProjektet har genomförts på uppdrag av Naturvårdsverket med finansiering från revision av det regionala miljöövervakningsprogrammet. Vidare har länsstyrelserna i Dalarnas och Gävleborgs län bidragit med fältarbete och expertkunskap om myrvegetation.\n\nLäs mer på www.myrar.se samt i följande rapport:\n\nHahn, N., Wester, K., Gunnarsson, U. & Kellner, O., 2016. Kartering av vegetation på öppna myrar i Dalarna och Gävleborg - myrvegetationskartan. Länsstyrelsen Dalarnas län, Rapport 2016:01."}},{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.13767 62.34337,18.11565 62.34337,18.11565 59.85475,12.13767 59.85475,12.13767 62.34337))"}},{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/fd084ab8-c7d4-48b5-ac6b-7b189bc47e8a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:564c6747-0a16-1c5f-41d1-f01c96502a8c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"\"Satellitbaserad övervakning av våtmarker\" används för att upptäcka markanvändningsbetingade vegetationsförändringar i öppna myrar. Metoden baseras på antagandet att spektralt och vegetationsmässigt homogena myrtyper uppträder likartat med avseende på fenologi och väder. I \"Satellitbaserad övervakning av våtmarker\" görs en basklassning av öppen myr i den äldre satellitscenen. Basklassningen särskiljer spektralt homogena våtmarksenheter som utgör grunden för den riktade förändringsanalysen som genomförs i nästa steg. Basklassningen är egentligen en biprodukt som används för den riktade förändringsanalysen, men den har ett värde i sig genom att det är en heltäckande kartering av myrvegetation inom masken för öppen myr. \nStudien \"Kartering av vegetation på öppna myrar i Dalarna och Gävleborg - Myrvegetationstypskartan\" syftar till att ta fram en myrvegetationstypskarta för öppen myr genom att översätta basklassningens våtmarksenheter (via en översättningstabell) till välkända hydrologiska vegetationstyper."},"dct:identifier":"fd084ab8-c7d4-48b5-ac6b-7b189bc47e8a","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b1n0"},"dct:title":{"@language":"sv","@value":"Regional miljöövervakning: Kartering av vegetation på öppna myrar i Dalarna och Gävleborg, 1999. Myrvegetationstypskartan."}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:564c6747-0a16-1c5f-41d1-f01c96502a8c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/om-miljoarbetet/sveriges-miljomal/fordjupad-utvardering-av-sveriges-miljomal-2023/nar-vi-miljokvalitetsmalen/myllrande-vatmarker/"},"dct:description":{"@language":"sv","@value":"Myllrande våtmarker. Övervakning av våtmarker."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:948a95dbbf61653692f451ecd310320ddf70c8beb6c5eac2c03d52abfe8a4546"},{"@graph":[{"@id":"_:95bae3edbc3acc633b16fa2a253f8c026c7029a0a0be42df9be1b7b390aa289e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data utgörs av rapporterade och expertvaliderade observationer av svensk förekomst av unionslistade arter under en tidperiod relevant för rapporteringen 2019. Underlaget är sammanställt av SLU ArtDatabanken och olika observationsdatabaser har an