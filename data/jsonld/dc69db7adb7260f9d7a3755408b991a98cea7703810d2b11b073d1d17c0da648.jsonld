on","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Sa-mar-miljon/Vaxter-och-djur/Frammande-arter/Invasiva-frammande-arter/"},"dct:description":{"@language":"sv","@value":"Webbsida med information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}},{"@id":"urn:uuid:69a043e2-87bf-b2db-c3e8-45489ca430c9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:e35b7b49-e87e-7c24-3683-2cf5663eb105","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd/ows?layers=SD.SpeciesDistribution.TrachemysScripta"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"[FORMAT]=WMS\n[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ce30478196b5de53477a78ea15446f64e419646091c13437ca62c9cc7d84be25_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f2aeb59f-3de0-f9eb-012e-9f82674e6eed","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-species-distribution-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:f7255cab-c75f-1919-6870-1aa69e1e0d6c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_IAS_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata som ingår i rapporteringen om Invasiva främmande arter"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}}],"@id":"urn:source:ce30478196b5de53477a78ea15446f64e419646091c13437ca62c9cc7d84be25"},{"@graph":[{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För att göra tolkningsöverlägg (tolkningsskisserna) digitalt tillgängliga har de fotograferats och geokorrigerats (SWEREF 99 TM). \nUppdraget omfattar:\n1. Fotografering av tolkningsskisser \n2. Geokorrigering av tolkningsöverlägg med stöd av ortofoto (Lantmäteriets WMS-tjänster). \n3. Mosaik (sammanfogning) av de enskilda digitala tolkningsöverläggen till en fil per län. \n4. Leverans kartblad: Utsnitt av leveransfiler baserade på VMI-id. Objekt med id baserade på samma kartbladsindelning (storruta, kvartsruta) utgör en leveransfil. Geotiff, färgindexerad.\n5. Leverans länsmosaik i jp2.\n6. Leverans enskilda tolkningsskisser: I de fall där enskilda tolkningsskisser har beskurits innan mosaik så levereras även oklippta och rektifierade tolkningsskisser i geotiff.\n7. Samlad leverans per län med Leverans-PM för respektive län.\nFör de län som är klara läggs leverans för nedladdning successivt upp. Leveransbeskrivning inklusive kvalitetskontroll framgår av Leverans-PM för respektive län (finns i respektive läns nedladdningsfil i undermapp \"4. Tolkningsskisser\")."}},{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/4c628030-13f1-4cee-af7d-dade314675a8","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:903e0418-e425-7a4b-2018-4b9e71b0483c"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Våtmarksinventeringen (VMI) genomfördes mellan åren 1981 och 2005. Alla inventerade våtmarker har flygbildstolkats. Tolkningen finns dokumenterad på tolkningsöverlägg innehållande avgränsningen av objekten, avgränsning av delobjekt och annan information som hydrologi, hydromorfologi, trädtäckning och ingrepp.  Tolkningsöverlägg har sedan inventeringen varit arkiverade på länsstyrelsen. Undantaget är Norrbottens län som utförde flygbildstolkningen digitalt från början utgående från vegetationskartan.\nFör att göra tolkningsöverläggen digitalt tillgängliga har de fotograferats och geokorrigerats (SWEREF 99 TM). För de län som är klara läggs leverans för nedladdning successivt upp. Leveransbeskrivning inklusive kvalitetskontroll framgår av Leverans-PM för respektive län (finns i respektive läns nedladdningsfil i undermapp \"4. Tolkningsskisser\"). För närvarande är följande län klara: Stockholm, Värmland, Uppsala, Jämtland, Blekinge, Västmanland, Södermanland, Gävleborg, Dalarna, Kalmar,  Göteborg och Bohus, Älvsborg, Skaraborg, Jönköping, Västernorrland,  Halland, Gotland, Örebro och Västerbotten."},"dct:identifier":"4c628030-13f1-4cee-af7d-dade314675a8","dct:issued":{"@type":"xsd:date","@value":"2019-12-19"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-12-19"},"dct:provenance":{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b1n0"},"dct:title":{"@language":"sv","@value":"Inventering: Våtmarksinventeringen (VMI) i Sverige, kvalitetssäkrad 2020-tal"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:903e0418-e425-7a4b-2018-4b9e71b0483c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/VMI/"},"dct:description":{"@language":"sv","@value":"[FORMAT]=TIFF"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:ce3a0a391e7ce5e2a7102d7a2b2f74a92d78d09e6a099a114ec88d2a525a6c03"},{"@graph":[{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Den nationella sammanställning som finns hos Naturvårdsverket gjordes vid ett tillfälle genom att data från länsstyrelserna samlades in. Under 2022 har det gjorts en översyn och uppdatering av länsstyrelserna, men det kan vara aktuellt med ytterligare kompletteringar och rättningar."}},{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/bf435698-15a4-4b0b-85ec-727605a0a6ba","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:5849596d-6b99-444d-45f9-bd2fdbb9137b"},{"@id":"urn:uuid:80bef14c-9faf-9ebd-0be0-1273ed8d657c"},{"@id":"urn:uuid:bb3dc84c-f1d9-0726-0248-abf38421df6b"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Landskapsbildsskydd är en äldre skyddsform (som bildades med stöd av 19 § naturvårdslagen) och ett begrepp som inte finns i miljöbalken. Det ersätts successivt med andra skyddsformer, men fram tills dess gäller bestämmelserna i landskapsskyddsområdena. Särskilda föreskrifter finns framtagna för varje landskapsbildsskydd. Skyddet reglerar bebyggelse, vägar och andra anläggningar som kan ha en negativ effekt på landskapsbilden. Det reglerar inte skogsbruk och jordbruk. Länsstyrelserna handlägger landskapsbildsskydd. Kontakta respektive länsstyrelse om ytterligare information efterfrågas."},"dct:identifier":"bf435698-15a4-4b0b-85ec-727605a0a6ba","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-09-26"},"dct:provenance":{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b1n0"},"dct:title":{"@language":"sv","@value":"Landskapsbildsskyddsområde"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:5849596d-6b99-444d-45f9-bd2fdbb9137b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms?layers=Landskapsbildsskyddsomrade"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:80bef14c-9faf-9ebd-0be0-1273ed8d657c","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/LBSO.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdning av de data som visas i WMS-tjänsten"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av data"}},{"@id":"urn:uuid:bb3dc84c-f1d9-0726-0248-abf38421df6b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/naturvardsregistret/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:cf3f7c57e99ae718c9319e19850eef30289ef72782ecc3203bf4a0da96fc4139"},{"@graph":[{"@id":"_:d0210eb3ae98280027213834b1ba96623bad7b9d9577f3a198b66a407c85df70_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tilläggsskiktet Jordbearbetning bygger på en analys av NDVI-värden i data från satelliten Sentinel-2. Samtliga tillgängliga bilder från alla år under perioden maj-oktober används för att beräkna maximala värden samt medelvärden. Stora skillnader i dessa värden indikerar att en jordbearbetning har genomförts under aktuell analysperiod. \nEn sammanvägning av alla analysperioder genererar den slutgiltiga klassningen."}},{"@id":"_:d0210eb3ae98280027213834b1ba96623bad7b9d9577f3a198b66a407c85df70_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((7.6975 69.1486,25.492 69.1486,25.492 54.79,7.6975 54.79,7.6975 69.1486))"}},{"@id":"http://data.naturvardsverket.se/resources/8f292929-34ce-4d1f-b185-782e828b813f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:01c4a270-629f-a4c1-ab4e-81ea62df774a"},{"@id":"urn:uuid:92a813cf-7b6b-ccf9-f623-32e9123d6d76"},{"@id":"urn:uuid:f3941a1e-7bef-93df-bb31-b4e3684078ee"}],"dcat:keyword":"Naturvardsverket","dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Tilläggsskiktet för jordbearbetning visar status för åkermark inom Nationella marktäckedata år 2023 (NMD2023) avseende tillfälle för jordbearbetning. \nMed jordbearbetning menas markåtgärd som avlägsnar växttäcke och lämnar någon form av bar jord. \nTilläggsskiktet jordbearbetning finns inte för NMD2018.\n\nNMD består av en baskartering med ett antal tematiska klasser i hierarkiska nivåer. Karteringen är i rasterformat med 10 meters upplösning och med en minsta karteringsenhet ned till 0,01 hektar. Följande tilläggsskikt ingår:\n\n- objekthöjd och -täckning\n- produktivitet (skoglig produktivitet)\n- markanvändning\n- låg fjällskog (endast för NMD2018, därefter inkluderat i basskiktet)\n- trädslag\n- jordbearbetning\n\nFör baskarteringen samt övriga tilläggsskikt finns separata metadatabeskrivningar och nedladdningstjänster. För samtliga datamängder finns produktbeskrivningar tillgängligt."},"dct:identifier":"8f292929-34ce-4d1f-b185-782e828b813f","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-07-02"},"dct:provenance":{"@id":"_:d0210eb3ae98280027213834b1ba96623bad7b9d9577f3a198b66a407c85df70_b0n0"},"dct:publisher":{"@id":"urn:uuid:c9d77b91-0c61-e08e-2533-b7767b06687f"},"dct:spatial":{"@id":"_:d0210eb3ae98280027213834b1ba96623bad7b9d9577f3a198b66a407c85df70_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata: tilläggsskikt jordbearbetning"}},{"@id":"urn:uuid:01c4a270-629f-a4c1-ab4e-81ea62df774a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida för Nationella marktäckedata (NMD)"}},{"@id":"urn:uuid:92a813cf-7b6b-ccf9-f623-32e9123d6d76","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Jordbearbetning_v1_1.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning NMD tilläggsskikt jorbearbetning version 1.1"}},{"@id":"urn:uuid:c9d77b91-0c61-e08e-2533-b7767b06687f","@type":"foaf:Organization","foaf:mbox":{"@id":"mailto:data@naturvardsverket.se"},"foaf:name":"Naturvardsverket"},{"@id":"urn:uuid:f3941a1e-7bef-93df-bb31-b4e3684078ee","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktbeskrivning_till%C3%A4gsskikt_Jordbearbetning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning NMD tilläggsskikt jordbearbetning"}}],"@id":"urn:source:d0210eb3ae98280027213834b1ba96623bad7b9d9577f3a198b66a407c85df70"},{"@graph":[{"@id":"_:d10d8c2007d3586ce0bba40f163c8c38164c0cd6fca5246c2c9f4b41877b822d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"För att skapa datamängden har följande (översiktliga) steg genomförts: \n\n1. Markskiktet i Lantmäteriets datamängd Topografi 50 Nedladdning, vektor har använts för att särskilja marin (hav) och biogeografisk (land) regionindelning, samt för att sätta rikets gräns på land. \n\n2. Sjöfartsverkets datamängder Sjöterritoriets gräns i havet och Gräns för ekonomisk zon har använts för att sätta de yttre gränserna i hav. \n\n3. Analysmask för biogeografiska regioner respektive Analysmask för marina regioner har använts för inre regionuppdelning (se respektive datamängd för tillkomsthistorik). \n\nFör en mer detaljerad beskrivning, se Nationellt anpassad geodata för biogeografiska och marina regioner - Metodbeskrivning."}},{"@id":"_:d10d8c2007d3586ce0bba40f163c8c38164c0cd6fca5246c2c9f4b41877b822d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/161b2ae2-d9a5-4e35-bf6d-d1eed7350215","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:2ea8d33a-d0a0-8def-46e3-5dd39879b336"},{"@id":"urn:uuid:4d89d543-d4df-52b3-04b9-0eb3bdaae500"},{"@id":"urn:uuid:88332e54-924a-9fff-66b5-e9cda1d50a16"},{"@id":"urn:uuid:a015273e-09cf-899f-d420-37dc93e557f2"},{"@id":"urn:uuid:a4c0affc-5b3f-9dac-7f6c-244f2222b4a6"},{"@id":"urn:uuid:afb4ace1-3493-c8fb-d161-5d865d6978c2"},{"@id":"urn:uuid:b4f5c8aa-79bb-e028-fa80-f5a2b4257be5"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Filnamn: SE_biogeografiska_marina_regioner\n\nDatamängden är en nationellt avgränsad och anpassad version av den datamängd som EEA tillhandahåller för biogeografiska regioner enligt art- och habitatdirektivet (Biogeographical regions, Europe 2016, ver. 1). På önskemål från Havs- och vattenmyndigheten (HaV) har de marina regionerna inkluderats enligt deras specifikationer. För gränsdragning mellan marina och biogeografiska regioner har strandlinjen i Lantmäteriets Topografi 50 Nedladdning, vektor använts. Regionerna har på land klippts mot Sveriges riksgräns, (Topografi 50 Nedladdning, vektor) och i hav mot Sjöfartsverkets senast publicerade gräns för territorialvatten/ekonomisk zon. \n\nDatamängden kan användas för att översiktligt visa de individuella regionernas utsträckning och för att fastställa ungefärliga regionarealer. Den är inte lämplig för att analysera arters och naturtypers regiontillhörighet. För denna typ av analyser bör tillhörande analysmasker användas: \n\n•\tAnalysmask för biogeografiska regioner,\n•\tAnalysmask för marina regioner\n•\tAnalysmask för biogeografiska regioner med boreala subregioner \n\nFrågor rörande de marina regionerna riktas till HaV."},"dct:identifier":"161b2ae2-d9a5-4e35-bf6d-d1eed7350215","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-08"},"dct:provenance":{"@id":"_:d10d8c2007d3586ce0bba40f163c8c38164c0cd6fca5246c2c9f4b41877b822d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d10d8c2007d3586ce0bba40f163c8c38164c0cd6fca5246c2c9f4b41877b822d_b1n0"},"dct:title":{"@language":"sv","@value":"Nationellt anpassade biogeografiska och marina regioner"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2ea8d33a-d0a0-8def-46e3-5dd39879b336","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/SE_BiogeografiskaMarinaRegioner.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar fil; geopackage, ESRI-databas och metodbeskrivning"}},{"@id":"urn:uuid:4d89d543-d4df-52b3-04b9-0eb3bdaae500","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-bio-geographical-regions-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical guidelines"}},{"@id":"urn:uuid:88332e54-924a-9fff-66b5-e9cda1d50a16","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/biogeografiska_marina_regioner/Nationellt%20anpassad%20geodata%20f%C3%B6r%20biogeografiska%20och%20marina%20regioner.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Metodbeskrivning"}},{"@id":"urn:uuid:a015273e-09cf-899f-d420-37dc93e557f2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:a4c0affc-5b3f-9dac-7f6c-244f2222b4a6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.eea.europa.eu/en/analysis/publications/report_2002_0524_154909"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till EEA:s hemsida med information om biogeografiska regioner"}},{"@id":"urn:uuid:afb4ace1-3493-c8fb-d161-5d865d6978c2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/br/SE_BR_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:b4f5c8aa-79bb-e028-fa80-f5a2b4257be5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}}],"@id":"urn:source:d10d8c2007d3586ce0bba40f163c8c38164c0cd6fca5246c2c9f4b41877b822d"},{"@graph":[{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Landskapsanalysen av skogliga värdekärnor har genomförts baserat på de dataunderlag vilka identifierades som värdekärnor i revideringen av den nationella strategin för formellt skydd av skog. De skogliga värdekärnorna utgörs av kända skogliga värdekärnor inom och utanför formellt skyddade områden i hela Sverige. Övriga GIS-skikt är framtagna med hjälp av geografiska analyser. Målet med landskapsanalysen har varit att ta fram kunskapsunderlag på en nationell nivå som ska ge stöd i arbetet med revideringen av den nationella strategin för formellt skydd av skog men även för arbetet med grön infrastruktur. Projektets utgångspunkt har varit att utveckla objektiva metoder med ett dataunderlag som är jämförbart över länsgränser för att dels identifiera landskapsavsnitt med höga tätheter skogliga värdekärnor och dels för att möjliggöra liknande analyser till olika typer av uppföljningar. För mer information se beskrivning i projektrapport."}},{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/08f53d26-0f94-419f-819a-f57fa59283a7","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:405552fc-5cba-b3f4-d263-53e5f4748a88"},{"@id":"urn:uuid:f6d0c2b7-db23-fbea-e722-57a2f223001f"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"De data som tillhandahålls i denna post har tagits fram inom projektet \"Landskapsanalys av skogliga värdekärnor i boreonemoral och nemoral region\". Syftet med projektet har varit att geografiskt analysera skogliga värdekärnor ur ett nationellt perspektiv med hjälp av olika GIS-metoder, för att dels ge förslag till skogliga värdetrakter och dels redovisa hur sammanhängande de skogliga värdekärnorna är inom olika avstånd.\n\nMer information om projektet och de olika GIS-metoderna som använts presenteras i bifogad rapport."},"dct:identifier":"08f53d26-0f94-419f-819a-f57fa59283a7","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b1n0"},"dct:title":{"@language":"sv","@value":"Landskapsanalys av skogliga värdekärnor i boreonemoral och nemoral region - arbetsmaterial"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:405552fc-5cba-b3f4-d263-53e5f4748a88","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/skog/analys_boreonemoral_nemoral_region.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Täthetsanalyser"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f6d0c2b7-db23-fbea-e722-57a2f223001f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/skog/Rapport_Landskapsanalys_skogliga_v%C3%A4rdek%C3%A4rnor_boreonemoral_nemoral_region_2017.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbar rapport."}}],"@id":"urn:source:d1bfa313cb879c58fdac5db8488c340d93db3f26c9829893294db3250251eedb"},{"@graph":[{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Karteringen är i huvudsak baserad på flygbildstolkning (analog hantering) baserat på infraröda flygbilder i skala 1:60 000. Materialen kompletterades med information från en litteraturinventering och fältkontroller som var koncentrerade till svårklassificerade eller intresseväckande objekt, men innefattade även stickprovskontroller. De data som är nedladdningsbara via denna länk är de geomorfologiska kartblad som finns som bilaga till varje rapport. Kartorna är scannade (300dpi) och georektifierad till RT90 2,5gV. För vissa kartblad finns legenden med, för andra har legenden inte tagits med vid scanningen. Filen 25EF_300.tif innehåller legend."}},{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.90 69.06,23.29 69.06,23.29 67.30,17.90 67.30,17.90 69.06))"}},{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/91EAA4C4-012E-4A5E-AF82-E702FDCFB9D0","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:b3a059da-46ed-b309-95fe-8950b6e6133a"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Projektet Geomorfologisk kartering i fjällen var en översiktlig inventering och värdering av landformer och områden i fjällregionen. Under perioden 1975-1983 producerades 17 stycken rapporter med tillhörande kartor. Rapporterna beskriver området och dess terrängformer. Det finns även naturvärdesbedömningar och utpekande av geomorfologiskt värdefulla områden. Rapporterna innehåller en hel del bilder och illustrationer. Karteringen är i huvudsak baserad på flygbildstolkning (analog hantering) av infraröda flygbilder i skala 1:60 000. Materialen kompletterades med information från tillgänglig litteratur och fältkontroller. Fältkontrollerna koncenterades till svårklassificerade eller intresseväckande objekt men innefattade även stickprovskontroller. De data som är nedladdningsbara via denna länk är de geomorfologiska kartblad som finns som bilaga till varje rapport. Kartorna är scannade och georektifierade till RT90 2,5gV. För optimalt utnyttjande av materialet bör rapporterna studeras. Rapporterna finns endast i analog form. Rapport och författare:  Geomorfologiska kartbladet 27G Sulitelma, Ann-Cathrine Ulfstedt  Geomorfologiska kartbladet 28 H SAREK, Olle Melander  Geomorfologiska kartbladet 30 J Rensjön, Olle Melander  Geomorfologiska kartbladet 19 D Åre, Ingmar Borgström  Geomorfologiska kartbladet 21 E Håkafot, Ann-Cathrine Ulfstedt  Geomorfologiska kartbladet 18 C Sylarna, Ingmar Borgström  Geomorfologiska kartbladet 28 G Virihaure, Olle Melander  Geomorfologiska kartbladet 18 D Storsjö, Ingmar Borgström  Geomorfologiska kartbladet 29 J Kiruna, Olle Melander  Geomorfologiska kartbladet 25 G Ammarnäs, Ann-Cathrine  Geomorfologiska kartbladet 17C Funäsdalen, Ingmar Borgström, Leif  Geomorfologiska kartbladet 27 H Kvikkjokk, Ann-Cathrine Ulfstedt  Geomorfologiska kartbladet 19 C Storlien, Ingmar Borgström  Geomorfologiska kartbladet 29 I Kebnekaise, Olle Melander  Geomorfologiska kartbladet 28 I Stora Sjöfallet, Gunnar Hoppe, Olle Melander  Geomorfologiska kartbladet 20 C Skalstugan 20 D Kolåsen 21 D, Ingmar Borgström  Geomorfologiska kartbladet 30 H Riksgränsen (öst), 30 I Abisko, 31 H Reurivare och 31 I Vadvetjåkka, Olle Melander"},"dct:identifier":"91EAA4C4-012E-4A5E-AF82-E702FDCFB9D0","dct:issued":{"@type":"xsd:date","@value":"2020-06-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-06-18"},"dct:provenance":{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b1n0"},"dct:title":{"@language":"sv","@value":"Geomorfologisk karta"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:b3a059da-46ed-b309-95fe-8950b6e6133a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/geomorfologisk_karta.zip"},"dct:description":{"@language":"sv","@value":"Länk till zip-fil som innehåller samtliga geomorfologiska kartblad. Obs filen är 180 MB."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:d5b6c63ef690a00517ed1463054502fdff68fe8611de73650eee15441766f094"},{"@graph":[{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tilläggsskiktet är en pixelbaserad trädslagsklassning där maskininlärningsmodell används för att utföra en regression mellan tidsserier av Sentinel-2 bilder som spänner över tre år (2021 - 2023) och träningsdata. Referensdata för träning av modellen är från en kombination av Riksskogstaxeringens temporära ytor och tolkning av ortofoto. Tilläggsskiktet trädslag ger indikation på förekomst av respektive trädslag, från 0 till 100 och levereras för tall, gran, triviallöv, ädellöv, lärk och contorta (som är en del av tall), samt för bok respektive ek/övrig ädellövskog (som utgör ädellöv). Karteringen är i rasterformat med 10 meters upplösning."}},{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((-5.119 68.537,31.0147 68.537,31.0147 53.8419,-5.119 53.8419,-5.119 68.537))"}},{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/fac02deb-f0e6-480d-b4ae-06e5d5997466","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:af02310c-b18f-60f7-65db-eed546e5352a"},{"@id":"urn:uuid:c7bb43e4-fcbb-5260-6877-43b142fecebc"},{"@id":"urn:uuid:fd31d24c-870f-af2c-86ad-eb2bc7e545b3"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden är ett tilläggsskikt inom Nationella Marktäckedata (NMD). \nTilläggsskiktet ger indikation på andel krontäckning av respektive trädslag, från 0 till 100 och levereras för tall, gran, lärk, contorta, triviallöv, ädellöv, samt även uppdelat på bok respektive ek/övrig ädellövskog. Värdena motsvarar indikation på krontäckningsgrad (i procent).  Trädslagsskikten är ett underlag för att skapa NMD:s trädslagsklasser vilka är definierade utifrån krontäckning. \nTilläggsskiktet trädslag finns inte för NMD2018.\n\nNMD består av en baskartering med ett antal tematiska klasser i hierarkiska nivåer. Karteringen är i rasterformat med 10 meters upplösning och med en minsta karteringsenhet ned till 0,01 hektar. Följande tilläggsskikt ingår: \n\n- objekthöjd och -täckning \n- produktivitet (skoglig produktivitet)\n- markanvändning\n- låg fjällskog (endast för NMD2018, därefter inkluderat i basskiktet)\n- trädslag\n- jordbearbetning\n\nFör baskarteringen samt övriga tilläggskikt finns separata metadatabeskrivningar och nedladdningstjänster. För samtliga datamängder finns produktbeskrivningar tillgängligt."},"dct:identifier":"fac02deb-f0e6-480d-b4ae-06e5d5997466","dct:issued":{"@type":"xsd:date","@value":"2025-07-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-07-08"},"dct:provenance":{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata: tilläggsskikt trädslag"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:af02310c-b18f-60f7-65db-eed546e5352a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida för Nationella marktäckedata (NMD)"}},{"@id":"urn:uuid:c7bb43e4-fcbb-5260-6877-43b142fecebc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Tradslag_v1_1.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning NMD tilläggsskikt trädslag"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:fd31d24c-870f-af2c-86ad-eb2bc7e545b3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktbeskrivning_till%C3%A4gsskikt_Tr%C3%A4dslag.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktspecifikation NMD tilläggsskikt trädslag"}}],"@id":"urn:source:d61c561a88f7c5a97eb27bacb2f2bb438e56feabc6f0a15451432c9bbfe2b72a"},{"@graph":[{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning.\n\nFör Stationsregistrets WMS tjänst använder länkarna en s.k. CQL filter över attributen \"datahost_id\" för att filtrera ur databasen de provplatserna som omfattas av datavärdskapet av intresse. För att använda denna länk i t.ex. QGIS bör man också bocka av \"Ignore GetMap/GetTile URI reported in capabilities\", och sedan välja lagret \"active_site\". Lägg märke på att under uppbyggnadsfasen kan visa datavärdskap sakna id. En förteckning över vilka id tillhör varje datavärd kan ses i denna länk: https://stationsregistertest.miljodatasamverkan.se/geoserver/rest/nv/stnreg/datahosts.json"}},{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/e929bec9-8709-4b7c-9cb1-c24fa2ed97d6","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:20049941-0547-0053-7997-257a3f1c9945"},{"@id":"urn:uuid:54a7ebe3-d045-e243-ac08-c87d4f4f1516"},{"@id":"urn:uuid:a2b0098c-7fe3-5a3a-f421-7b26be3a3462"},{"@id":"urn:uuid:f509a1bb-113f-9b7f-3bbd-21c04d9cd802"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Inom datavärdskapet för Jordbruksmark förvaltas resultat från övervakning av bl.a. näringsämnen, växtskyddsmedel samt analyser av jordprover, och markpackning i jordbruksmark. Det är främst resultaten från löpande undersökningar som lagras och förvaltas i datavärdskapet för Jordbruksmark. Platser för provtagning finns registrerade tillsammans med mätdata i databasen hos Sveriges Lantbruksuniversitet (SLU) samt i Stationsregistret, som är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning."},"dct:identifier":"e929bec9-8709-4b7c-9cb1-c24fa2ed97d6","dct:issued":{"@type":"xsd:date","@value":"2020-09-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-09"},"dct:provenance":{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b1n0"},"dct:title":{"@language":"sv","@value":"Platser för miljöövervakning: Datavärdskap Jordbruksmark"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:20049941-0547-0053-7997-257a3f1c9945","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/data-databaser-och-sokregister/miljoovervakningsdata/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer information om datamängden och miljöövervakningen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:54a7ebe3-d045-e243-ac08-c87d4f4f1516","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wms?cql_filter=(datahost_id=8)"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:a2b0098c-7fe3-5a3a-f421-7b26be3a3462","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.slu.se/om-slu/organisation/institutioner/mark-miljo/miljoanalys/datavardskap/"},"dct:description":{"@language":"sv","@value":"Här på SLU och Institutionen för mark och miljö finns mer information om de olika datamängderna inom Datavärdskap Jordbruksmark."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Sveriges lantbruksuniversitet (SLU) - Ladda ner data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f509a1bb-113f-9b7f-3bbd-21c04d9cd802","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/wfs?"},"dct:description":{"@language":"sv","@value":"[FORMAT]=WFS[RESTRIKTIONER]=Creative commons  CC0 1.0 Universiell,Inga begränsningar"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}}],"@id":"urn:source:d658e07d80259412f6e43a31eb3bfc80333f429e10506c765727f3767520e540"},{"@graph":[{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Tilläggsskikt markanvändning är baserat på data från LPIS (land parcel information system) och fastighetskartan och SCB infrastrukturobjekt.\n•\tMarkanvändning betesmark. Jordbruksverkets LPIS, ägoslag = bete. Hål < 100 m2 generaliseras bort.\n•\tMarkanvändning kraftledning Lantmäteriets Fastighetskartan, detaljtyp KRAFTRE.M, KRAFTST.M, TRAFOMR.B. Buffert 20 m kraftledning, isolerade transformatorstationer tas bort, hål <5 000 m2 generaliseras. \n•\tMarkanvändning anlagda områden. SCBs infrastrukturobjekt: flygplatsområde, kyrkogårdar/begravningsplatser, grus-, berg-, mineral- och torvtäkt, gruvområde, koloniområde, campingplats, golfbana, skidbacke, motorbana, övrig sport- och idrottsanläggning, avfalls- och återvinningsanläggning.\n\nOvanstående resultat är i vektorformat. Dessa konverterades till rasterformat, 10 x 10 m.\n\nAktualitet för ingående data framgår av tillhörande metadata.\nSe produktbeskrivning för ytterligare information."}},{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/4162afae-c657-4367-a813-7b3a760e3852","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:50369e0b-60fc-fce4-eb88-1b5b7f640e61"},{"@id":"urn:uuid:7f3735f5-600f-546a-9ca7-bfab4e6409fc"},{"@id":"urn:uuid:88541ef8-bbf2-f382-c303-a7ebcc72ece1"},{"@id":"urn:uuid:8a497b71-2aa7-0e4a-72bb-9923bbdeb43d"},{"@id":"urn:uuid:b449578a-38b6-bf62-ae76-cfa16a5bf808"},{"@id":"urn:uuid:ba388c8b-2110-fb09-257c-f6e4106bcf10"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"NMD Markanvändning är ett tilläggsskikt inom Nationella Marktäckedata. Detta tilläggsskikt består av tre separata rasterskikt i 10 m upplösning:\n\n- Betesmark (från LPIS, Jordbruksverket) \n- Kraftledning (från fastighetskarta, Lantmäteriet)\n- Anlagda områden (från SCBs infrastrukturobjekt)\n\nNMD består av en baskartering i flera hierarkiska nivåer. Karteringen är i rasterformat med 10 meters upplösning och med en minsta karteringsenhet ned till 0,01 hektar. Utöver baskarteringen ingår följande tilläggsskikt:\n- objekthöjd och -täckning \n- produktivitet (skoglig produktivitet)\n- markanvändning\n- låg fjällskog (endast 2018, därefter inkluderat i basskiktet)\n\nFör baskartering och övriga tilläggsskikt finns separata metadatabeskrivningar och nedladdningstjänster."},"dct:identifier":"4162afae-c657-4367-a813-7b3a760e3852","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b1n0"},"dct:title":{"@language":"sv","@value":"Nationella marktäckedata, tilläggsskikt markanvändning"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:50369e0b-60fc-fce4-eb88-1b5b7f640e61","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD_Produktbeskrivning_tillaggsskikt_Markanvandning.pdf"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbar produktbeskrivning"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, 2018"}},{"@id":"urn:uuid:7f3735f5-600f-546a-9ca7-bfab4e6409fc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Tillaggsskikt_Markanvandning_v1_0.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data, 2023"}},{"@id":"urn:uuid:88541ef8-bbf2-f382-c303-a7ebcc72ece1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Produktforandring_och_Avvikelser.xlsx"},"dct:description":{"@language":"sv","@value":"Dokument med beskrivning av produktförändringar och avvikelser."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Beskrivning av förändringar och avvikelser NMD2018"}},{"@id":"urn:uuid:8a497b71-2aa7-0e4a-72bb-9923bbdeb43d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/verktyg-och-tjanster/kartor-och-karttjanster/nationella-marktackedata"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer aktuell information om projektet."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbplats"}},{"@id":"urn:uuid:b449578a-38b6-bf62-ae76-cfa16a5bf808","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2023/Tillaggsskikt/NMD2023_Produktbeskrivning_till%C3%A4gsskikt_Markanvandning.pdf"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning, 2023"}},{"@id":"urn:uuid:ba388c8b-2110-fb09-257c-f6e4106bcf10","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/NMD_Tillaggsskikt_Markanvandning.zip"},"dct:description":{"@language":"sv","@value":"Länk till dataset på en ftp-site för nedladdning, nedladdningsbara data är i form av geotiff."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data, 2018"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:d9e579484ad40a532b4a8eee4afa36fed549ea372d984538d6fb509d4bc4224b"},{"@graph":[{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är framtaget genom analys genomförd av Metria. Beskrivning bifogas tillsammans med data."}},{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.7782 60.5024,19.3346 60.5024,19.3346 55.1406,10.7782 55.1406,10.7782 60.5024))"}},{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/295f99d5-5d4d-4823-a8a8-d04e232cd2e1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Analys av riskskogar för angrepp av granbarkborre med zoneringar från skyddade områden. Materialet riktar sig till de län som ingår i bekämpningsområdet för granbarkborrar, det vill säga för stora delar av Götaland och Svealand.\n\nData är inte tillgängligt on-line, men finns via NV-08582-14.\n\nSkogar i Skogsstyrelsens riskindex beskrivs här som riskskogar. I princip är det granskogar med risk för angrepp av granbarkborrar. Dessa har identifierats på grund av ålder, volym, växtplats, etc. För att ge en tydlig bild av hur riskskogar fördelar sig i och runt varje naturreservat eller nationalpark har Naturvårdsverket genomfört en granskogsanalys med zoneringar. I denna är riskskogarna i och kring varje skyddat område kartlagda i zoner så att det framgår:\n• Hur mycket riskskog det finns i varje naturreservat, nationalpark etc\n• Hur mycket riskskog det finns i närzonen dvs, i direkt anslutning till naturreservatet, 1-300 meter från riskskog i naturreservat\n• Hur mycket riskskog det finns i den yttre närzonen, dvs 301-500 meter från riskskog i naturreservat\n• Dessutom ingår även riskskogar från omgivningszonen för att ge en bild av situationen i landskapet, 501-1000 meter från riskskog i naturreservat.\n\nUnderlaget är tänkt att fungera som ett kunskapsunderlag till Länsstyrelserna i arbetet med att minska angrepp från granbarkborrar i skyddade skogar men shape-filerna och statistiken i bifogad excelfil kan förstås vara av intresse även för andra."},"dct:identifier":"295f99d5-5d4d-4823-a8a8-d04e232cd2e1","dct:issued":{"@type":"xsd:date","@value":"2022-07-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-07-07"},"dct:provenance":{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b1n0"},"dct:title":{"@language":"sv","@value":"Riskskogar för granbarkborre"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:d9ed1c3cb95e97d53de8097c326fde98d594aad7f75ad4b1e1e90573072b859f"},{"@graph":[{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inscanning av analog karta, transformering till RT 90. Skärmdigitalisering med rasterkarta och Sveriges gränser från databasen Sverige kartan 1:2.5 milj som bakgrund.Original kartans ursprung okänd (skala, projektion mm) vilket ger brister vid transformering till Rikets nät RT 90 2.5g V. Transformation till SWEREF99 TM."}},{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/b166b68e-1305-4acc-b3de-a4f9cfa22faf","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:652a4bac-cf15-c383-8d1e-f2a65146c9c1"},{"@id":"urn:uuid:6e8755c0-594e-14c9-6ae2-6051d7ed8cf6"},{"@id":"urn:uuid:a81faea5-8797-a824-1529-14df690fc177"},{"@id":"urn:uuid:ecc424ea-0118-c82d-c3d0-0b8f717e616b"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Sverige delas in i olika naturgeografiska regioner. Regionindelningen bygger på såväl biologiska som geologiska faktorer i landskapet. Indelningen tar också hänsyn till topografi, det vill säga dess höjdförhållanden och brutenhet.  Regionindelningen gjordes i regi av Nordiska ministerrådet (1984). Norden omfattar 76 naturgeografiska regioner. Av dessa berör 29 Sverige."},"dct:identifier":"b166b68e-1305-4acc-b3de-a4f9cfa22faf","dct:issued":{"@type":"xsd:date","@value":"2020-06-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b1n0"},"dct:title":{"@language":"sv","@value":"Biogeografiska regioner: Naturgeografiska regioner (enligt Nordiska ministerrådet 1994)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:652a4bac-cf15-c383-8d1e-f2a65146c9c1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:6e8755c0-594e-14c9-6ae2-6051d7ed8cf6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-bio-geographical-regions-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:a81faea5-8797-a824-1529-14df690fc177","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/br/SE_BR_Biogeoregion_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för biogeografiska regioner (Inspire tema BR)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:ecc424ea-0118-c82d-c3d0-0b8f717e616b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/br/ows?layers=BR.BiogeographicalRegions.NaturgeografiskaRegioner"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:dae712fc64b1cebc1367455b2bff18469e5e223a08a541864f6a54e6cf63ccac"},{"@graph":[{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Genom att utnyttja existerande geodata har detta projekt tagit fram GIS-skikt över befintliga och potentiellt restaurerbara betesmarker i Sverige. Med hjälp av historiska data från Lantbruksregistret som visar jordbrukets förändring under perioden 1951-1995 har vissa tematiska förändringsbilder tagits fram.\nKompletterande kartskikt över olika indelningar av betesmarker/ängar har lagts till 2023. Dessa är en gruppering av material som tagits fram som underlag inför ekonomiska modellberäkningar (SASM). De nya kartskikten är både en uppdatering av det tidigare skiktet ”aktiv hävd” och en komplettering med underindelning av betesmark/äng."}},{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/4baf1451-355b-4b6f-bf1a-682361aef31a","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:331d56a4-28bc-546d-5559-139fee26a448"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Genom att utnyttja existerande geodata har det skapats data med befintliga och potentiellt restaurerbara betesmarker i Sverige.\n\nDet finns även ett nationellt bruttoskikt för befintliga och potentiella gräsmarker och så även skikt för befintlig hävdad mark i Sverige, samt dagens marktäcke på tidigare brukad åkermark.\n\nMed hjälp av historiska data från Lantbruksregistret som visar jordbrukets förändring under perioden 1951-1995 har vissa tematiska förändringsbilder tagits fram. Kartskikten ska ge ett kunskapsunderlag till stöd för en dialog med lantbrukare för att bidra till ekonomiskt bärkraftiga jordbruksföretag med inriktning på animalieproduktion på naturbetesmarker. De ska kunna användas som konkret underlag för stöd till aktiva åtgärder från såväl Länsstyrelsen som lantbrukare, såsom utvidgade betesfållor, förbättrad arrondering, för att identifiera restaurerbara eller potentiellt röjbara marker etc. Rådgivning om hur olika ekonomiska stöd/ersättningar kan kombineras för att förbättra ekonomin för brukaren utgör ett viktigt komplement. \n\nYtterligare ett användningsområde är att det kan vara underlag för att lokalisera potentiella betesmarker att utnyttjas vid krissituationer pga. långvarig torka såsom sommaren 2018."},"dct:identifier":"4baf1451-355b-4b6f-bf1a-682361aef31a","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b1n0"},"dct:title":{"@language":"sv","@value":"Potentiell restaurerbar betesmark"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:331d56a4-28bc-546d-5559-139fee26a448","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/betesmarker/"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:db6e3245a55d66dde4ca509f0995a8ce227614a1f1e214bad9279f11ad510335"},{"@graph":[{"@id":"_:dc1389ea3ab373b1fc7cd327f7f69578462a73347bc929b5014a2ff569a4e143_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Stationsregistret är ett samlat nationellt register över anläggningar (stationer, provplatser) där man bedriver miljöövervakning."}},{"@id":"_:dc1389ea3ab373b1fc7cd327f7f69578462a73347bc929b5014a2ff569a4e143_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:dc1389ea3ab373b1fc7cd327f7f69578462a73347bc929b5014a2ff569a4e143_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.s