.org/2006/vcard/ns#hasAddress":{"@id":"_:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:f231fcd57f1cbe879c22c72932f5c1f7c423fb7ac6ef47ba8615aad30ae6bcbc"},{"@graph":[{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Inscanning av analog karta, transformering till RT 90. Skärmdigitalisering med rasterkarta och Sveriges gränser från databasen Sverige kartan 1:2.5 milj som bakgrund.Original kartans ursprung okänd (skala, projektion mm) vilket ger brister vid transformering till Rikets nät RT 90 2.5g V. Transformation till SWEREF99 TM."}},{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/61d3fefb-d982-46ab-8ff6-f18c8235400d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0"},"dcat:distribution":[{"@id":"urn:uuid:4ab0f19a-c726-c82a-641a-c9ba2958ad13"},{"@id":"urn:uuid:6e87c066-f701-dafd-c86b-b0bf1430e494"},{"@id":"urn:uuid:83f77e46-3245-04ef-a39e-851fcb325e9f"},{"@id":"urn:uuid:fefd92fa-c072-5794-3b76-cb2e10f1bb06"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"--"},"dct:identifier":"61d3fefb-d982-46ab-8ff6-f18c8235400d","dct:issued":{"@type":"xsd:date","@value":"2021-04-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2021-04-04"},"dct:provenance":{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b1n0"},"dct:title":{"@language":"sv","@value":"Biogeografiska regioner: Naturgeografiska regioner (enligt Nordiska ministerrådet 1994) TT"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_ac64a52d"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:4ab0f19a-c726-c82a-641a-c9ba2958ad13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-bio-geographical-regions-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:6e87c066-f701-dafd-c86b-b0bf1430e494","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/geoserver/BIOGEO/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:83f77e46-3245-04ef-a39e-851fcb325e9f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/geoserver/BIOGEO/wms?layers=SE_BR_NaturgeografiskaRegioner"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:9a24898c-f257-a2f2-8d16-10e9356a2eb0","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:fefd92fa-c072-5794-3b76-cb2e10f1bb06","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/SE_BR_Biogeoregion_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för biogeografiska regioner (Inspire tema BR)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}}],"@id":"urn:source:f31e99c75a5771e81ded2efb3f880f55096e519cd66b926eb1f9dd22200807c3"},{"@graph":[{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data innehåller karteringar av Natura 2000 och skyddade områden som genomfördes inom projektet \"Basinventering av Natura 2000 och skyddade områden\". Fokus är de naturtyper som ingår i Art- och Habitatdirektivets (EEG 92/443), bilaga 1. Som grund för karteringen användes topografiska kartor, flygbildstolkning och fältbesök som genomfördes av länsstyrelserna.   Data har funnits tillgängligt via systemet BIDOS där ansvarig länsstyrelse kontinuerligt har haft möjlighet att komplettera och redigera data. I september 2012 stängdes systemet BIDOS och data migrerades till ett nytt system (NNK).   Detta dataset är data från BIDOS som det såg ut när systemet stängdes, 3:e september 2012. Är det mer aktuella data som är önskvärt ska data från NNK användas.   Projektet och data beskrivs i rapporterna \"Basinventering av Natura 2000 och skyddade områden 2004-2008\" ISBN: 978-91-620-5990-3 och \"Data från basinventering av Natura 2000 och skyddade områden\", ISBN: 978-91-620-5907-1."}},{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/A527D369-8788-44D5-B7F0-62D67607CB1C","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:12b3fe24-e319-b358-80dd-bc10bbf65407"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data innehåller den kartering av naturtyper för Natura 2000 och skyddade områden som genomfördes inom projektet \"Basinventering av Natura 2000 och skyddade områden\". Indelningssystemet innehåller de naturtyper som ingår i Art- och Habitatdirektivets (EEG 92/443), bilaga 1.   Projektet och data beskrivs i rapporterna \"Basinventering av Natura 2000 och skyddade områden 2004-2008\" ISBN: 978-91-620-5990-3 och \"Data från basinventering av Natura 2000 och skyddade områden\", ISBN: 978-91-620-5907-1.\n\nData är inte tillgängligt on-line men finns via NV-05499-24."},"dct:identifier":"A527D369-8788-44D5-B7F0-62D67607CB1C","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b1n0"},"dct:title":{"@language":"sv","@value":"Basinventeringens naturtypskarta"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:12b3fe24-e319-b358-80dd-bc10bbf65407","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.diva-portal.org/smash/get/diva2:1618296/FULLTEXT01.pdf"},"dct:description":{"@language":"sv","@value":"Länk till rapport med beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport med beskrivning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:f861d0effe416e0df78c7270e5e84591151dfb7ce365db6528a310586fd813ac"},{"@graph":[{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data har framställts genom att hämta avgränsningar av län, kommuner och församlingar från Lantmäteriets översiktskarta. Övriga områden med markavvattningsförbud är Ramsar-områden och dessa har hämtats från Naturvårdsverkets tjänster."}},{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/d0430cec-4b3d-4b4d-ac21-5b2e540c8c6c","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:2f8f3e38-8995-8020-f924-6f5c74955bd0"},{"@id":"urn:uuid:4f01b3b7-6aef-8ce4-7c71-ddfae2ce7cce"},{"@id":"urn:uuid:8eec92d3-3ebb-f930-b26b-47b276e32fb2"},{"@id":"urn:uuid:b020a633-a1cf-b31f-f9fd-afc78b345a8a"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Data redovisar de områden där det rådet förbud mot markavvattning enligt miljöbalken (11 kap. 14 § första stycket) och Förordning (1998:1388) om vattenverksamheter\n\nMarkavvattning är de åtgärder som utförs för att avlägsna oönskat vatten (dränera mark) eller skydda mot vatten. För att en åtgärd ska vara markavvattning i miljöbalkens mening krävs att syftet med åtgärden är att varaktigt öka markens lämplighet för ett visst ändamål. Markavvattning är en juridisk definition som inte ska\nblandas ihop med den hydrologiska definitionen av markvatten. Tillstånd krävs alltid för markavvattning. I större delen av södra och mellersta Sverige råder förbud mot markavvattning. Där krävs dispens från markavvattningsförbudet om tillstånd ska kunna ges. Länsstyrelsen prövar dispenser. Tillstånd för markavvattning prövas av länsstyrelsen eller miljödomstolen.\n\nData uppdaterades i juli 2018 (ändring av två RAMSAR-områden)."},"dct:identifier":"d0430cec-4b3d-4b4d-ac21-5b2e540c8c6c","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b1n0"},"dct:title":{"@language":"sv","@value":"Förbud mot markavvattning"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:2f8f3e38-8995-8020-f924-6f5c74955bd0","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/am-restriction/ows?layers=AM.soilDrainageRestrictionZone"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till den WMS-tjänst som visar data."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:4f01b3b7-6aef-8ce4-7c71-ddfae2ce7cce","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Inspire/am/AM_soilDrainageRestrictionZone.zip"},"dct:description":{"@language":"sv","@value":"Länk till dataset på en ftp-site för nedladdning, nedladdningsbara data är i form av shape-filer."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data."}},{"@id":"urn:uuid:8eec92d3-3ebb-f930-b26b-47b276e32fb2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-area-managementrestrictionregulation-zones-and-reporting-units-technical_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:b020a633-a1cf-b31f-f9fd-afc78b345a8a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/vagledning-och-stod/branscher-och-verksamheter/markavvattning"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverekts handbok kring markavvattning och rensning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:fd684066955758e848fbd81cfaea05d97def10cbdd450da15e4f02319136e9eb"},{"@graph":[{"@id":"_:fe2e09db19b155b43e717124b76d219bb52eafa1b829090ddcc30e7db6c27a63_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data redovisar den yttre avgränsningen för biosfärsområden."}},{"@id":"_:fe2e09db19b155b43e717124b76d219bb52eafa1b829090ddcc30e7db6c27a63_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:fe2e09db19b155b43e717124b76d219bb52eafa1b829090ddcc30e7db6c27a63_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/bc2ce857-fa87-42f6-8870-fbdc3a9b113e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:04342d9e-4765-d09f-92fc-a6cbc3eeb70e"},{"@id":"urn:uuid:0fb1a28b-3aef-7d4f-94ae-aa8f494fe7a9"},{"@id":"urn:uuid:5fcf63dc-05a8-7f70-48e9-7b0245c00412"},{"@id":"urn:uuid:75e102c2-da32-aeaa-2ffc-8d2e6616c497"},{"@id":"urn:uuid:af23b89a-cfc3-68a9-d91a-fa3562ccc24f"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Data redovisar de yttre gränserna för Sveriges biosfärsområden. \n\nBiosfärområden handlar om naturvård och hållbar utveckling på ett nytt sätt. Människor ska kunna bo och utvecklas i områden samtidigt som samhället kan testa ny kunskap och praktik när det gäller att hållbart hantera relationen mellan människan och naturen – att både bruka och bevara. \n \nI Sverige är biosfärområden ett komplement till kultur- och naturreservat, nationalparker och andra utpekanden av områden med höga natur- och kulturvärden. Beslut om biosfärområde ger i sig inte ett skydd i juridisk mening. Det ger inte heller några inskränkningar av eller utökade krav på befintliga skyddade områden."},"dct:identifier":"bc2ce857-fa87-42f6-8870-fbdc3a9b113e","dct:issued":{"@type":"xsd:date","@value":"2021-12-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:fe2e09db19b155b43e717124b76d219bb52eafa1b829090ddcc30e7db6c27a63_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:fe2e09db19b155b43e717124b76d219bb52eafa1b829090ddcc30e7db6c27a63_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: biosfärsområden"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:04342d9e-4765-d09f-92fc-a6cbc3eeb70e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:0fb1a28b-3aef-7d4f-94ae-aa8f494fe7a9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/biosfarsomraden.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data (shape)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:5fcf63dc-05a8-7f70-48e9-7b0245c00412","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/ps/SE_ProtectedSitesIS_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Nedladdningstjänst för data som ingår i INSPIRE bilaga 1, Biosfärsområden"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@val