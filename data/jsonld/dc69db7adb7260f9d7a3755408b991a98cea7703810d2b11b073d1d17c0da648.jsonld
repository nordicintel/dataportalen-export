"urn:uuid:e193b737-e5f5-d807-3a4f-c5eb8044e527","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://cdr.eionet.europa.eu/Converters/run_conversion?file=se/eu/ias/envxkngww/IAS_Invasive_Alien_Species_SE.xml"},"dct:description":{"@language":"sv","@value":"Information on the reporting"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information on the reporting"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ac05bd4807de5df80bcd9065ae66244e7c98c366af8a5e63a80af2d320848ccc_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:f3e688e5-88ed-920d-e97d-1f37fe8e34e6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/Sa-mar-miljon/Vaxter-och-djur/Frammande-arter/Invasiva-frammande-arter/"},"dct:description":{"@language":"sv","@value":"Webbsida med information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets webbsida"}}],"@id":"urn:source:ac05bd4807de5df80bcd9065ae66244e7c98c366af8a5e63a80af2d320848ccc"},{"@graph":[{"@id":"_:ad2d8ec7251a271a11dbe9b678d32b3234c7ef602536bec8931ae16470534728_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Rastret representerar beräkningar av buller från väg- och tågtrafik, vindkraftverk och flygplatser. Beräkningarna är utförda med beräkningsmetoden Nord2000 och bygger på underlag från Trafikverket, Energimyndigheten (vindbrukskollen) och Transportstyrelsen. Beräkningarna genomfördes under 2024, och underlagsdata representerar trafikförhållanden med mera under 2022 (2017 för vägtrafik). Band 1 i rastret består av flyttal som motsvarar den årsekvivalenta A-vägda ljudtrycksnivån mellan kl 06 och 22 i enheten dB. Ljudtrycksnivån är beräknad för väderförhållanden motsvarande tidsperioden 2013 – 2022."}},{"@id":"_:ad2d8ec7251a271a11dbe9b678d32b3234c7ef602536bec8931ae16470534728_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/9673a0c2-370c-4612-926c-2b38b4fcf75c","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:33da8fd3-c95b-efe6-0a00-ce279e07a93d"},{"@id":"urn:uuid:429017f8-0cb3-d097-1e33-5a8f9fd58d2e"},{"@id":"urn:uuid:b0eab062-8a3c-abf3-b9a7-ef730c3fda02"},{"@id":"urn:uuid:c51f6319-219e-d12f-b279-6faf12b53458"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data representerar beräkningar av buller från väg- och tågtrafik, vindkraftverk och flygplatser. Beräkningarna är utförda med beräkningsmetoden Nord2000 och bygger på underlag från Trafikverket, Energimyndigheten (vindbrukskollen) och Transportstyrelsen. Beräkningarna genomfördes under 2024, och underlagsdata representerar trafikförhållanden med mera under 2022 (2017 för vägtrafik).  Ljudtrycksnivån är beräknad för väderförhållanden motsvarande tidsperioden 2013 – 2022."},"dct:identifier":"9673a0c2-370c-4612-926c-2b38b4fcf75c","dct:issued":{"@type":"xsd:date","@value":"2024-06-24"},"dct:language":{"@id":"http://publication