esource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"Stationer för övervakning av luftkvalitet (alla stationer)."},"dct:identifier":"7ea84da7-5928-45ec-983f-755002157723","dct:issued":{"@type":"xsd:date","@value":"2022-03-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-03"},"dct:provenance":{"@id":"_:588a827ca65d39814f478b9eba0bc92bb04f873ed4f08d6ee35d42a90e1f53e4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:588a827ca65d39814f478b9eba0bc92bb04f873ed4f08d6ee35d42a90e1f53e4_b1n0"},"dct:title":{"@language":"sv","@value":"Luftkvalitet: Stationer för övervakning av luftkvalitet (alla stationer)"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:8364fda6-6667-f122-4231-7a927735071d","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wms?layers=dataflow_D_allstations"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:e1e0b1d3-efd3-9a26-48a5-9a5fa23ca759","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datavardluft.smhi.se/aqd/wfs?"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst WFS"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:588a827ca65d39814f478b9eba0bc92bb04f873ed4f08d6ee35d42a90e1f53e4_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:588a827ca65d39814f478b9eba0bc92bb04f873ed4f08d6ee35d42a90e1f53e4"},{"@graph":[{"@id":"_:5bbf1d221cf655e0bd48a159cd88189f8dddcecf83469a5cebad83cd9e3ba93e_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Datamängden för verksamhetsår 2024 innehåller endast uppgifter om Revaq-certifierat avloppsslam vilket utgör ca 70% av allt avloppsslam som sprids på jordbruksmark i Sverige. Uppgifterna om platser för spridning kommer från Svensk Vattens dataregister där jordbrukare själva ritar in de arealer där de har spridit avloppsslam. Uppgifterna har blivit anonymiserade och generaliserade till ytenheter på 10 km2."}},{"@id":"_:5bbf1d221cf655e0bd48a159cd88189f8dddcecf83469a5cebad83cd9e3ba93e_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.108 69.036,24.163 69.036,24.163 55.343,11.108 55.343,11.108 69.036))"}},{"@id":"http://data.naturvardsverket.se/resources/5f474931-ece5-47c1-a000-d18a368fd22f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"urn:uuid:0811c3a2-fee2-9a18-b54b-75ece2a7ff2f"},{"@id":"urn:uuid:14d4944c-e5b4-13f3-e703-6a05f8cc68b6"},{"@id":"urn:uuid:2013d9f6-0e83-87d7-e9da-005219e3353b"},{"@id":"urn:uuid:a41296da-4de3-941e-9c41-66eeb5e11e6a"},{"@id":"urn:uuid:bed2a25e-bb91-d381-17e6-fd030cde2683"},{"@id":"urn:uuid:e592216a-322f-a022-44f8-ff3824389786"},{"@id":"urn:uuid:eb8b9475-eebd-0d17-a68f-da4d4b073e37"},{"@id":"urn:uuid:efbfe86c-3a53-262d-be60-cac8e80d8eb9"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avloppsslam innehåller fosfor och kväve som kan återanvändas som gödsel i jordbruksverksamhet. Avloppsslam innehåller dock också föroreningar, som tungmetaller. Användning av avloppsslam på jordbruksmark regleras av EU:s slamdirektiv (86/278/EEG) samt SNFS 1994:2 och 20 § i SFS 1998:944. \n\nSverige behöver rapportera till EU om hur dessa regler efterlevs. Rapporteringskraven har varierat. Från och med hösten 2023 behöver Sverige årligen sammanställa och tillgängliggöra uppgifter över hur mycket avloppsslam som föregående år producerades i landet, hur mycket av detta avloppsslam som användes som gödsel på jordbruksmark, genomsnittliga halter av vissa tungmetaller i avloppsslammet som användes på jordbruksmark, samt platserna där avloppsslammet användes på jordbruksmark.\n\nDenna datamängd innehåller uppgifter om de platser där avloppsslam användes på svensk jordbruksmark under föregående kalenderår, 2025. De övriga uppgifterna publiceras på Naturvårdsverkets hemsida, se länk under resurser.\n\nDatamängden 2025 är generaliserad till ytenheter på 10 km2 samt omfattar endast REVAQ-certifierat (SPCR 167) avloppsslam\n\nFörgående års datamängder finns tillgängliga via både nedladdningstjänst och visningstjänst."},"dct:identifier":"5f474931-ece5-47c1-a000-d18a368fd22f","dct:issued":{"@type":"xsd:date","@value":"2023-08-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-08-29"},"dct:provenance":{"@id":"_:5bbf1d221cf655e0bd48a159cd88189f8dddcecf83469a5cebad83cd9e3ba93e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:5bbf1d221cf655e0bd48a159cd88189f8dddcecf83469a5cebad83cd9e3ba93e_b1n0"},"dct:title":{"@language":"sv","@value":"Avloppsslam på jordbruksmark"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:0811c3a2-fee2-9a18-b54b-75ece2a7ff2f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/af/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Slamdata, visningstjänst"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Avloppsslam på jordbruksmark, visningstjänst"}},{"@id":"urn:uuid:14d4944c-e5b4-13f3-e703-6a05f8cc68b6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-agricultural-and-aquaculture-facilities-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till Technical Guidelines"}},{"@id":"urn:uuid:2013d9f6-0e83-87d7-e9da-005219e3353b","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/inspire/af/Avloppsslam_pa_jordbruksmark.gpkg"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Geopackage 2024-års data"}},{"@id":"urn:uuid:a41296da-4de3-941e-9c41-66eeb5e11e6a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/af/SE_AF_serviceFeed.xml"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Avloppsslam på jordbruksmark, nedladdningstjänst"}},{"@id":"urn:uuid:bed2a25e-bb91-d381-17e6-fd030cde2683","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/inspire/af/Avloppsslam_pa_jordbruksmark_2023.gpkg"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Geopackage 2023-års data"}},{"@id":"urn:uuid:e592216a-322f-a022-44f8-ff3824389786","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/inspire/af/Avloppsslam_pa_jordbruksmark_2022.gpkg"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Geopackage 2022-års data"}},{"@id":"urn:uuid:eb8b9475-eebd-0d17-a68f-da4d4b073e37","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=celex%253A31986L0278"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information Direktiv"}},{"@id":"urn:uuid:efbfe86c-3a53-262d-be60-cac8e80d8eb9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/data-och-statistik/avlopp/avloppsslam-pa-jordbruksmark-anvandning-innehall-och-spridningsplatser/"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Information Naturvårdsverket"}}],"@id":"urn:source:5bbf1d221cf655e0bd48a159cd88189f8dddcecf83469a5cebad83cd9e3ba93e"},{"@graph":[{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Projektet \"Basinventering av Natura 2000 och skyddade områden\" genomfördes 2004-2009 och innebar kartering av de naturtyper som ingår i Art- och Habitatdirektivets (EEG 92/443), bilaga 1, samt inventeringar av strukturer, funktioner och typiska arter.   Projektet och data beskrivs i rapporterna \"Basinventering av Natura 2000 och skyddade områden 2004-2008\" ISBN: 978-91-620-5990-3 och \"Data från basinventering av Natura 2000 och skyddade områden\", ISBN: 978-91-620-5907-1.   Utbredningen av naturtyper samlades in genom flygbildstolkning i IR-bilder kombinerat med GIS-analyser och fältbesök. Metoder för fältinventeringar varierade beroende på naturtyp. Manualer för inventeringsmetoder från projektet finns nedladdningsbara.   Följande data finns i huvudsak lagrat på andra platser:  Data från de inventeringsmetoder som följde någon \"standardmetod\" för miljöövervakning lagras hos den aktuella datavärden.  Data kring arter finns i Artportalen."}},{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/3042ED2D-32E4-4498-8813-9D41F67CFD36","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:8ffc43ec-fdc8-4b0c-2525-7f845c32efce"},{"@id":"urn:uuid:aa2b392a-2745-8aaf-d4df-1cd2a9b37802"},{"@id":"urn:uuid:b359efb2-17d2-9e19-6fdc-f18e79e50c67"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Data innehåller länstäckande geodatabaser (ett dataset per län) med samtliga data som fanns för aktuellt län lagrade i IT-systemet \"BIDOS\" som användes för projektet \"Basinventering av Natura 2000 och skyddade områden\".   Projektet \"Basinventering av Natura 2000 och skyddade områden\" genomfördes 2004-2009 och innebar kartering av de naturtyper som ingår i Art- och Habitatdirektivets (EEG 92/443), bilaga 1 samt data från de fältinventeringar av strukturer och funktioner som genomfördes.   Projektet och data beskrivs i rapporterna \"Basinventering av Natura 2000 och skyddade områden 2004-2008\" ISBN: 978-91-620-5990-3 och \"Data från basinventering av Natura 2000 och skyddade områden\", ISBN: 978-91-620-5907-1.   Även manualer och dokumentation från projektet finns nedladdningsbart.\n\nData är inte tillgängligt on-line, men finns via NV-05499-24."},"dct:identifier":"3042ED2D-32E4-4498-8813-9D41F67CFD36","dct:issued":{"@type":"xsd:date","@value":"2019-09-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-03"},"dct:provenance":{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b1n0"},"dct:title":{"@language":"sv","@value":"Basinventeringen, länsvisa naturtypskartor"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:8ffc43ec-fdc8-4b0c-2525-7f845c32efce","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.diva-portal.org/smash/get/diva2:1618296/FULLTEXT01.pdf"},"dct:description":{"@language":"sv","@value":"Länk till rapport som beskriver data. För att ta del av samtliga inventeringsmanualer sök på bi-dokumentation i Miljödataportalen."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport med information om data"}},{"@id":"urn:uuid:aa2b392a-2745-8aaf-d4df-1cd2a9b37802","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/bidos_20120903/"},"dct:description":{"@language":"sv","@value":"Länk till den katalog där data finns. Länken går till en katalog där filerna är döpta till  BIDOS_’lansbokstav’_lan.zip. Filerna innehåller en sk personlig geodatabas där all information som fanns i BIDOS för aktuellt län 2012-09-03 har exporterats."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till nedladdningsbara data"}},{"@id":"urn:uuid:b359efb2-17d2-9e19-6fdc-f18e79e50c67","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.diva-portal.org/smash/get/diva2:1623047/FULLTEXT01.pdf"},"dct:description":{"@language":"sv","@value":"Länk till rapport med beskrivning av det projekt som samlade in data."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till rapport med information om projektet som samlade in data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:5d4c75f3d4a2d6084c7fdd374244895b4385e1416699e1a24be3890559306f44"},{"@graph":[{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Från laserdata (Nationella höjdmodellens punktmoln från Lantmäteriet) har ett objektshöjdsraster (mellan 0,5 och 45 m) med en pixelstorlek på 2 m tagits fram. Från detta har det framställts objektshöjdsskikt med höjder mellan 0,5 och 5 m med en geometrisk upplösning på 10 m. Täckningsgradsskikt har tagits fram genom att på objektshöjdsskiktet, med 2 m pixelstorlek, göra en statistisk filteranalys, inom ett område som är 10 x 10 m. Rastren har konverterats till punktskikt och avstånd till 14 olika sorts ägoslag/företeelser kalkylerats. Verktyg som används i produktionen är ArcGIS, LAStools och Erdas Imagine."}},{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/f08b42c5-9e78-4b50-9653-3945045ecc1f","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:c31c3fea-51b0-c789-f271-cc3e1308c570"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Buskskikten är producerade från laserdata (Nationella höjdmodellens punktmoln från Lantmäteriet) och inkluderar höjder mellan 0,5 och 5 m. Till varje pixel återfinns information om höjd (tre klasser), täckningsgrad (i 10 % intervall) och laserscanningsaktualitet samt avstånd till olika ägoslag/företeelser inklusive skogsbryn, åkerholmar, vattendrag, sjöar, hav, våtmarker, vägar, kraftledningsgator, ängs- och betesmarker, åkermarker, övriga gräsmarker, skyddade områden och träd som inte tillhör en skog. Ägoslag är baserade på den interna produkten Kartdata KNAS som Naturvårdsverket använde innan Nationella marktäckedata (NMD) färdigställdes.\n\nI dagsläget finns bättre möjligheter att skapa ett liknande dataset utifrån NMD och dess tilläggsskikt. Dessa data är därför inte tillgängliga för nedladdningen, men kan lämnas ut av Naturvårdsverket. Kontakta i så fall data@naturvardsverket.se och ange att följande data önskas: \"Buskskikt, nationell indelning, ärende NV-05499-24\"."},"dct:identifier":"f08b42c5-9e78-4b50-9653-3945045ecc1f","dct:issued":{"@type":"xsd:date","@value":"2020-06-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2020-06-18"},"dct:provenance":{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b1n0"},"dct:title":{"@language":"sv","@value":"Buskskikt utanför skog - länsvisa data"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:c31c3fea-51b0-c789-f271-cc3e1308c570","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/Buskskikt/Nationellt_buskskikt_ej_skog.pdf"},"dct:description":{"@language":"sv","@value":"Länk till beskrivning av data"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Produktbeskrivning"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:5fe109d406a461321a612b5211130f8127a72be740d805057f1240790aff8f1c"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"https://data.naturvardsverket.se/store/16/resource/47","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Registratur","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:registrator@naturvardsverket.se"}},{"@id":"https://data.naturvardsverket.se/store/16/resource/48","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://data.naturvardsverket.se/store/16/resource/47"},"dcat:keyword":[{"@language":"sv","@value":"arkiv"},{"@language":"sv","@value":"opublicerade handlingar"},{"@language":"sv","@value":"övriga handlingar"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"sv","@value":"Handlingar från Naturvårdsverkets verksamhet som inte publiceras som öppna data kan vanligen tillgängliggöras elektroniskt om de inte omfattas av sekretess eller om tillgängliggörande hindras av begränsningar i personuppgiftslagstiftningen eller upphovsrätten. Av Naturvårdsverkets klassificeringsstruktur framgår vilka processer handlingarna skapas i och vilka typer av ärenden som finns. Handlingarna kan utgöras av t.ex. beslut, PM, yttranden, skrivelser, planer och mötesanteckningar. Om du vill ta del av allmänna handlingar från Naturvårdsverkets verksamhet så kontaktar du registrator."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:title":{"@language":"sv","@value":"Övriga allmänna handlingar i Naturvårdsverkets verksamhet"}}],"@id":"urn:source:6106030a9d8434bb15b39a580c88ec398647364cf3e5d627ba11ca7937ebc98a"},{"@graph":[{"@id":"_:61166d505800c3224480acf90bdc031d895dcb4f9f68823a391f7701935dfbc7_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Natura 2000-områdena genomgick 2008-2009 en översyn inom det s.k. kvalitetsförbättringsprojektet. Projektet omfattade samtliga SCI (Art- och Habitatdirektivet) och SPA (Fågeldirektivet) områden, med undantag för de stora älvsystemen. I kvalitetsföbättringsprojektet redigerade länsstyrelserna områdesgränserna och anpassade dem mot fastighetsgränser, objekt i Naturvårdsregistret och topografiska objekt som vägar och vatten i enlighet med hur beslutet för respektive objekt såg ut. Kontroller utfördes också för att säkerställa att det inte fanns överlapp mellan SCI-objekt respektive mellan SPA-objekt. Det kontrollerades även att det inte fanns felaktiga geometrier som spikar, dubbla brytpunkter och begränsningslinjer som korsade sig själva (self-intersections)."}},{"@id":"_:61166d505800c3224480acf90bdc031d895dcb4f9f68823a391f7701935dfbc7_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.61 69.06,24.18 69.06,24.18 55.14,10.61 55.14,10.61 69.06))"}},{"@id":"_:61166d505800c3224480acf90bdc031d895dcb4f9f68823a391f7701935dfbc7_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/a80bf3d7-e70c-42d1-9b8d-8148e53e011d","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:06ffe935-3927-c625-57ab-7cfdb46b8812"},{"@id":"urn:uuid:25d9289c-e72c-907b-9a54-52536fe489f3"},{"@id":"urn:uuid:3102747a-95bc-821b-f081-f721a830a02a"},{"@id":"urn:uuid:4de1d8e1-988b-e26b-fbb5-1aee18af49f7"},{"@id":"urn:uuid:7ddb6fa1-8b2b-8720-c79e-2c17acc70c91"},{"@id":"urn:uuid:f17b5d88-1380-c4a7-8b95-435b623d00e6"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"År 1979 beslöt EU-länderna att införa särskilda regler för skydd av fåglar, fågeldirektivet (direktiv 79/409/EEG). Fågeldirektivet berör totalt 200 fågelarter som förekommer i medlemsländerna. Av dem finns 66 i Sverige (se fågellistan i pdf-biblioteket). Varje medlemsland ska dels vidta åtgärder som är nödvändiga för att bibehålla fågelarter i livskraftiga populationer (exempelvis reglera fågeljakten) och dels vidta särskilda åtgärder för fågelarter som är listade i direktivets bilaga 1. Bland annat ska särskilda skyddsområden pekas ut. Skyddet kan också handla om att återställa livsmiljöer för fåglarna. Direktivet innehåller flera regler som styr ländernas möjligheter att jaga och handla med fåglar."},"dct:identifier":"a80bf3d7-e70c-42d1-9b8d-8148e53e011d","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-04"},"dct:provenance":{"@id":"_:61166d505800c3224480acf90bdc031d895dcb4f9f68823a391f7701935dfbc7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:61166d505800c3224480acf90bdc031d895dcb4f9f68823a391f7701935dfbc7_b1n0"},"dct:title":{"@language":"sv","@value":"Skyddade områden: fågeldirektivet (Natura 2000, SPA)"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:06ffe935-3927-c625-57ab-7cfdb46b8812","@type":"dcat:Distribution","dcat:accessURL":{"@id":"http://www.naturvardsverket.se/amnesomraden/skyddad-natur/Natura-2000/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemsida med mer information"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:25d9289c-e72c-907b-9a54-52536fe489f3","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/SPA_Rikstackande.zip"},"dct:description":{"@language":"sv","@value":"Länk till nedladdningsbara data (shape)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:3102747a-95bc-821b-f081-f721a830a02a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/n2000/wms"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst, nationell för naturvårdsregistret"}},{"@id":"urn:uuid:4de1d8e1-988b-e26b-fbb5-1aee18af49f7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/ps-n2k/ows?"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till visningstjänst (WMS)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:7ddb6fa1-8b2b-8720-c79e-2c17acc70c91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/inspire-data-specification-protected-sites-technical-guidelines_en"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id