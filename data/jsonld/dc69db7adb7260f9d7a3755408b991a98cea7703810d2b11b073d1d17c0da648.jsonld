eodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_Sverige.zip"},"dct:description":{"@language":"sv","@value":"[FORMAT]=TIFF"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfuktighetsindex NMD Sverige"}},{"@id":"urn:uuid:b8329aa8-b88a-3f71-f804-69dec36f01a4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_del6.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfuktighetsindex NMD Delområde 6"}},{"@id":"urn:uuid:c066ebc7-4593-7c45-bd5f-6511fb027dff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_del3.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfuktighetsindex NMD Delområde 3"}},{"@id":"urn:uuid:cdf50e9e-7b57-302f-debb-496e97c19215","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/marktacke/NMD2018/Markfuktighetsindex_NMD_del9.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av Markfuktighetsindex NMD Delområde 9"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:71f345902914a28e40efef310e896172c01ed571ff8633797ac2acf489b61cc8"},{"@graph":[{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Underlag för Nationalparksplanen kommer från boken Nationalparksplan för Sverige, ISBN 978-91-620-1269-4 (ursprunglig publikation). Nationalparksplanen har tagits fram av Naturvårdsverket 2008. Denna nationalparksplan bygger på gällande kriterier och faktaunderlag om ett toppskikt av större, värdefulla naturområden i landet. I bedömningsunderlaget ingår de förslag till nationalparker som finns med i 1989 års plan men som ännu ej genomförts. Dessa har åter granskats varvid flertalet kvarstår med oförändrade eller ändrade avgränsningar medan några av olika skäl har utgått. Några helt nya områden har tillkommit liksom förslag till utvidgningar av befintliga parker. Totalt föreslås 13 nya nationalparker. Om samtliga genomförs skulle detta innebära att Sverige får totalt 40 nationalparker (en befintlig park uppgår i en ny större). För 7 av de 28 befintliga nationalparkerna föreslås dessutom utvidgningar."}},{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/6951b7d9-a479-413b-8fb5-f1a6fbf528ed","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:34d763cd-b718-655b-d626-482dafbd9e91"},{"@id":"urn:uuid:462ec6e3-ffc0-df9e-ff2a-39a6b66ad84a"},{"@id":"urn:uuid:cf7dd5c0-3c60-e44b-ce90-9eba19c8f58e"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/OTHER"},"dct:description":{"@language":"sv","@value":"I Nationalparksplan för Sverige (2008) presenterar Naturvårdsverket en långsiktig plan med nya och utvidgade nationalparker. Urvalet baserades på Miljöbalkens bestämmelser, internationella och svenska kriterier för nationalparker. Nationalparksplanen utgör ett toppskikt av större värdefulla områden i landet. Planen är att se som en samlad redovisning av områden som enligt nuvarande bedömning är lämpade att ingå i landets nät av nationalparker. Det har därmed mer karaktär av en önskelista eller handlingsprogram för bildande av nationalparker än som plan för genomförandet. Gränserna för områdena är ungefärliga.\n\nLänk till boken Nationalparksplan för Sverige:  https://www.naturvardsverket.se/publikationer/1200/nationalparksplan-for-sverige/"},"dct:identifier":"6951b7d9-a479-413b-8fb5-f1a6fbf528ed","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b1n0"},"dct:title":{"@language":"sv","@value":"Nationalparksplan"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:34d763cd-b718-655b-d626-482dafbd9e91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.naturvardsverket.se/publikationer/1200/nationalparksplan-for-sverige/"},"dct:description":{"@language":"sv","@value":"Länk till boken Nationalparksplan för Sverige"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Naturvårdsverkets hemsida"}},{"@id":"urn:uuid:462ec6e3-ffc0-df9e-ff2a-39a6b66ad84a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/planeringsunderlag_o_strategier/wms?layers=Nationalparksplan"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Länk till WMS-tjänst. Tjänsten kan användas utan användarnamn och lösenord."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:cf7dd5c0-3c60-e44b-ce90-9eba19c8f58e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/nedladdning/naturvardsregistret/Nationalparksplan.zip"},"dct:description":{"@language":"sv","@value":"Länk till ftp-plats där nedladdingsbara data finns (shape-format)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningsbara data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:72914673657d23e7785911c619d4a7596f8108057fb6a895c78e204f2093b44c"},{"@graph":[{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"--------"}},{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/c48fba5f-eca7-4e1d-a403-a5b3cc348486","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Naturvårdsverket, tillsammans med Riksantikvarieämbetet och Jordbruksverket, beställde bearbetade uppgifter ur Lantbruksregistret från Statistiska Centralbyrån i något som kallades SCB-Atlas Jordbruk. Arbetet var en del i det s.k. LiM-projektet, en uppföljning och utvärdering av miljöeffekterna av 1990 års livsmedelspolitik. Syftet var att kunna följa och analysera förändringar inom jordbruket från efterkrigstiden till 1990-talet. Alla uppgifter är omräknade till 1992 års administrativa indelning för att få jämförbarhet över tid. Handboken till SCB-Atlas Jordbruk innehåller en fullständig beskrivning av alla ingående variabler och beskriver också hur SCB har gått tillväga med omräkningar m.m."},"dct:identifier":"c48fba5f-eca7-4e1d-a403-a5b3cc348486","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dct:provenance":{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b1n0"},"dct:title":{"@language":"sv","@value":"Data ur Lantbruksregistret, f.d. SCB Atlas jordbruk, 1951 - 1995"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:76aeec9d60447144066f6e30b23ae29b8eac2f5306e55f005f806d418fccf4fd"},{"@graph":[{"@id":"_:76f8c2700628e55eee03029713479a531f6771f3f7f4b4e20f763e66262f3e91_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data framställs genom att man antingen bedömer att arten finns i en speciell ruta i ett 10 X 10 km rutskikt över Sverige eller genom att koppla arten  till rutorna i skiktet genom s.k. Overlay med de faktiska observationspunkterna."}},{"@id":"_:76f8c2700628e55eee03029713479a531f6771f3f7f4b4e20f763e66262f3e91_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:76f8c2700628e55eee03029713479a531f6771f3f7f4b4e20f763e66262f3e91_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/e2cba3b8-c8ad-47d1-85e4-121f0d07e1e3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":{"@id":"urn:uuid:8aa7104c-ff3a-2696-2eb3-72f48c9e0bae"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Species Distribution Sensitive beskriver förekomsten av känsliga arter listade i habitatdirektivet (EEG 92/443 annex 2, 4 och 5). Förekomsten är representerad i ett rutnät om 10 X 10 km och datasetet motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet.\n\nDenna datamängd är skyddad."},"dct:identifier":"e2cba3b8-c8ad-47d1-85e4-121f0d07e1e3","dct:issued":{"@type":"xsd:date","@value":"2019-09-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2019-09-21"},"dct:provenance":{"@id":"_:76f8c2700628e55eee03029713479a531f6771f3f7f4b4e20f763e66262f3e91_b0n0"},"dct:publisher":