3.org/2006/vcard/ns#hasAddress":{"@id":"_:dc1389ea3ab373b1fc7cd327f7f69578462a73347bc929b5014a2ff569a4e143_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"},{"@id":"urn:uuid:fb267b3a-612a-3386-f647-32024a4a9bfb","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/geoserver/stationsregistret/ows?layers=active_site"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:description":{"@language":"sv","@value":"Stationsregistrets WMS tjänst."},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:fefeb21e-fba7-5598-aeca-483152474bff","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://stationsregister.miljodatasamverkan.se/"},"dct:description":{"@language":"sv","@value":"Länk till Naturvårdsverkets hemisda med mer information om miljöövervakning."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Stationsregistret"}}],"@id":"urn:source:dc1389ea3ab373b1fc7cd327f7f69578462a73347bc929b5014a2ff569a4e143"},{"@graph":[{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data framställs genom att man antingen bedömer att arten finns i en speciell ruta i ett 10 X 10 km rutskikt över Sverige eller genom att koppla arten  till rutorna i skiktet genom s.k. Overlay med de faktiska observationspunkterna."}},{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592 69.0599,24.1774 69.0599,24.1774 55.1372,10.592 55.1372,10.592 69.0599))"}},{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/3a98a57f-70e1-4396-b308-332787dd713e","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:27235950-1195-7fd4-a954-d66fba319b2a"},{"@id":"urn:uuid:43ec9971-b66a-de6b-be76-9f50447ca141"}],"dcat:keyword":[{"@language":"sv","@value":"Inspire"},{"@language":"sv","@value":"Värdefulla datamängder"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Beskriver förekomsten (distribution) av arter listade i habitatdirektivet (EEG 92/443 annex 2, 4 och 5). Förekomsten är representerad i ett rutnät om 10 X 10 km och datasetet motsvarar det som rapporteras enligt Artikel 17 i Art- och habitatdirektivet 2025 för perioden 2019-2024."},"dct:identifier":"3a98a57f-70e1-4396-b308-332787dd713e","dct:issued":{"@type":"xsd:date","@value":"2022-04-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-04-28"},"dct:provenance":{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001975"},"dct:spatial":{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b1n0"},"dct:title":{"@language":"sv","@value":"Arters förekomst, rapportering enligt art- och habitatdirektivet 2025"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_dd313021"}},{"@id":"http://dataportal.se/organisation/SE2021001975","@type":"foaf:Agent","dct:identifier":"2021001975","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@naturvardsverket.se"},"foaf:name":{"@language":"sv","@value":"Naturvårdsverket"},"foaf:page":{"@id":"https://www.naturvardsverket.se"}},{"@id":"urn:uuid:27235950-1195-7fd4-a954-d66fba319b2a","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/inspire/sd-arter/ows"},"dcat:mediaType":"application/vnd.iso.19139+xml","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst WMS"}},{"@id":"urn:uuid:43ec9971-b66a-de6b-be76-9f50447ca141","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.naturvardsverket.se/atom/inspire/sd/SE_SD_ARTER_serviceFeed.xml"},"dct:description":{"@language":"sv","@value":"Naturvårdsverkets ATOM nedladdningstjänst för geodata om fågel direktivet, samt art- och habitat direktivet"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"ATOM-flöde för nedladdning av data"}},{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Naturvårdsverket","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:data@naturvardsverket.se"},"http://www.w3.org/2006/vcard/ns#organization-name":"Naturvårdsverket"}],"@id":"urn:source:dd0acc6300f35b81294fa5ecdfcaefceb04c814ef5a7b7eb0c1ae0656b69fbc1"},{"@graph":[{"@id":"_:df20529d4ceb6cd7a8c4dc72086850a1c59b264e7f81b59a4c045647a53b151d_b0n0","@type":"dct:ProvenanceStatement","http://www.w3.org/2000/01/rdf-schema#value":{"@language":"sv","@value":"Data är framtaget genom GIS-analyser och sammanställning av tillgängliga underlag. Detta beskrivs i den tillhörande rapporten."}},{"@id":"_:df20529d4ceb6cd7a8c4dc72086850a1c59b264e7f81b59a4c045647a53b151d_b1n0","@type":"dct:Location","http://www.w3.org/ns/locn#geometry":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((10.592077 69.059941,24.177412 69.059941,24.177412 55.137212,10.592077 55.137212,10.592077 69.059941))"}},{"@id":"_:df20529d4ceb6cd7a8c4dc72086850a1c59b264e7f81b59a4c045647a53b151d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address"},{"@id":"http://data.naturvardsverket.se/resources/a312a354-9b28-474c-8d0a-1e52e7382ba1","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"urn:uuid:f110432b-5a81-0a56-0779-95c58d61af76"},"dcat:distribution":[{"@id":"urn:uuid:252c7604-58c1-a683-2c73-cfd08350eeef"},{"@id":"urn:uuid:5e9992fb-9589-342a-6c9f-8e8a399a3e7e"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/UNKNOWN"},"dct:description":{"@language":"sv","@value":"Arbetet (rapport och data) redovisar ett uppdrag med syfte att ta fram underlag för beslut om kompletterande kartering av naturtyperna i Art- och habitatdirektivets bilaga 1, 2320 Rissandhedar och 2330 Grässandhedar i Sverige.\n\nArbetet baseras på en baskartering som genomfördes 2013 som har kompletterats med ytterligare indata och GIS-analyser. Fyra testområden har tolkats i IR-bilder."},"dct:identifier":"a312a354-9b28-474c-8d0a-1e52e7382ba1","dct:issued":{"@type":"xsd:date","@value":"2022-03-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-23"},"dc