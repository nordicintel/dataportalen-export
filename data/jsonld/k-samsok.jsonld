id":"http://www.etnografiska.se/"},"dct:source":{"@id":"http://www.etnografiska.se/"},"dct:title":{"@language":"sv","@value":"Etnografiska, foto"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/b0269e6e938c7845b8b62c314ad948fc","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value":"A RDF/XML web-API."},{"@language":"sv","@value":"Ett RDF/XML webb-API."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/efb0563e6562254cd41a5f6c6fddf77f","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:83aa331190df905674ed83849f9ddbbccd744b500020dd728f9336a90fc112b4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://admin.dataportal.se/store/697/resource/59016a636923433ba7f153f80bb12c09","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://admin.dataportal.se/store/697/resource/eaf99b03485d57cf4c6025625cb65462"},{"@id":"https://admin.dataportal.se/store/697/resource/fed7089e53ec8be0e1dc33863a5b5fe1"}],"dcat:keyword":[{"@language":"en","@value":"culture"},{"@language":"en","@value":"history"},{"@language":"en","@value":"museum"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Bebyggelseregistret, BeBR, är ett nationellt register med information om det byggda kulturarvet. Här ryms allt från timmerstugor och gamla industrimiljöer till modern stadsbebyggelse. Det finns omkring 80 000 sökbara poster i registret, av dem är cirka 13000 byggnader skyddade som byggnadsminnen och kyrkor. Uppdateringar och nya registreringar görs kontinuerligt. De uppgifter som finns presenterade i Bebyggelseregistret är hämtade från inventeringar, dokumentationer, arkiv och litteratur. Informationen är framtagen och registrerad av regionala museer, Svenska Kyrkan, länsstyrelser, kommuner, universitet och högskolor i samverkan med Riksantikvarieämbetet.\n\nTermen anläggning har sedan länge använts inom kulturmiljövården i olika sammanhang bland annat vid bebyggelseinventeringar. En anläggning betecknar i det här sammanhanget ett avgränsat område med en eller flera byggnader. Byggnaderna har ett gemensamt, funktionellt samband och utgör tillsammans t.ex. en bondgård, en skola eller ett bostadshus med garage. Det område, som tillsammans med byggnaden/byggnaderna, bildar en anläggning överensstämmer oftast ytmässigt med den berörda fastigheten. \nI ett inventeringsarbete har fältarbetet mestadels gjorts fastighetsvis med en beskrivning av de enskilda byggnaderna och av den tomt eller gårdsmiljö som omger byggnaderna. I flera fall har en situationsplan med markering för byggnaden/byggnaderna och för t.ex. växtlighet, gångar, staket eller murar tagits fram.\n"},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:source":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Bebyggelseregistret anläggning"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/eaf99b03485d57cf4c6025625cb65462","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/fed7089e53ec8be0e1dc33863a5b5fe1","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value":"A RDF/XML web-API."},{"@language":"sv","@value":"Ett RDF/XML webb-API."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},