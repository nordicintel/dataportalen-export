"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"I Livrustkammaren finns över 30.000 föremål. Flertalet har anknytning till svenska kungar från Gustav Vasa och fram till idag. Det är framförallt praktföremål, dräkter från kröningar, bröllop och dop och paradrustningar och unika vapen som ingått i kungarnas samlingar. Dessutom finns här kröningsvagnar och praktkarosser från hovstallet. "},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021003732"},"dct:source":{"@id":"http://dataportal.se/organisation/SE2021003732"},"dct:title":{"@language":"sv","@value":"LSH, föremål"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:10af496a6dfdfc2b0e2a02dce5a7ca4b0fdbcf535c38af8aab847aca557ed651"},{"@graph":[{"@id":"https://admin.dataportal.se/store/697/resource/2173eab299a7f903faf382467d8f87e7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/7d31c3666745c06ce1a59031cb103c9e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value"