msok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/84437b648a9d7ac0cf8d384ae03e2018","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/bf48b4755bf06283aeb486ed1d32d62e","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value":"A RDF/XML web-API."},{"@language":"sv","@value":"Ett RDF/XML webb-API."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:91b0b362230e088b739d9e4f0e8b317bd7c6f0bed239fd89fac199707c8943d9"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021004953","@type":"foaf:Agent","dct:identifier":"2021004953","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:registrator@historiska.se"},"foaf:name":{"@language":"sv","@value":"Statens historiska museer"},"foaf:page":{"@id":"https://www.historiska.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"http://www.historiska.se/"}},{"@id":"https://admin.dataportal.se/store/697/resource/0b01ed88c54a827e7935265d74881581","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://admin.dataportal.se/store/697/resource/622dcc7b1ec5ce7553e9934879dd2431"},{"@id":"https://admin.dataportal.se/store/697/resource/cd879983b96d567538d60e70a45210f9"}],"dcat:keyword":[{"@language":"en","@value":"culture"},{"@language":"en","@value":"history"},{"@language":"en","@value":"museum"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Innehåller platser som har koppling till Historiska museets samlingar. Platsen har fyra viktiga funktioner:\n1. Det är ett urval. Den ger användaren ett urval av spännande platser som i sin tur har urval av relevanta länkar till sidor och objekt inom och utanför K-samsök.\n2. Den är en bearbetning. Den innehåller en översiktlig kort beskrivning av platsen och platsens historiska funktion. Den har funktionen att i K-samsök kunna agera agnad krok i det att platsen kan beskrivas med vanliga sökbegrepp och nyckelord som fångar upp användaren och länkar vidare till rådata som annars är svår att hitta.\n3. Den paketerar. Den sammanför fyndplatser/fyndlokaler (med föremål) som hör ihop till en begriplig enhet för en större publik än forskare, studenter och anställda inom kulturmiljövården. Platsen kan skapa ett filter vid sökningar som hjälper användaren att nå information om just den platsen, trots att platsens information är fragmenterad i en mängd administrativa objekt.\n4. Det är lätt att hitta. Den är alltid lägesbunden med sikte på kartapplikationer."},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021004953"},"dct:source":{"@id":"http://dataportal.se/organisation/SE2021004953"},"dct:title":{"@language":"sv","@value":"SHM, platser"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/622dcc7b1ec5ce7553e9934879dd2431","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value":"A RDF/XML web-API."},{"@language":"sv","@value":"Ett RDF/XML webb-API."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/cd879983b96d567538d60e70a45210f9","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:92ba9760eba6ddee1f10a6846c34f386e04175f718e4351020f24d1c83dc05e9"},{"@graph":[{"@id":"http://malmo.se/Kultur--fritid/Kultur--noje/Museer--utstallningar/Malmo-Museer.html","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"http://malmo.se/Kultur--fritid/Kultur--noje/Museer--utstallningar/Malmo-Museer.html"},"foaf:name":[{"@language":"en","@value":""},{"@language":"sv","@value":"Malmö museer"}],"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:"}},{"@id":"https://admin.datapor