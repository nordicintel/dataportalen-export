ion":[{"@id":"https://admin.dataportal.se/store/697/resource/0adee0905844e1e4b9d7d4e2d61da96c"},{"@id":"https://admin.dataportal.se/store/697/resource/d86aeab5f3e8d333ca8baaebc21fa58e"}],"dcat:keyword":["The Museum of Mediterranean and Near Eastern Antiquities",{"@language":"en","@value":"culture"},{"@language":"en","@value":"history"},{"@language":"en","@value":"museum"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Dokument. Skannade föremålskataloger."},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://www.medelhavsmuseet.se/"},"dct:source":{"@id":"http://www.medelhavsmuseet.se/"},"dct:title":{"@language":"sv","@value":"Medelhavsmuseet, dokument"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:3b3c0429ec10537ea42e0eb8a60d95a593fce200b49041e56076806f4e1ee4d7"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://admin.dataportal.se/store/697/resource/569ae8408a69c903417d004ff6c8e9b5","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://admin.dataportal.se/store/697/resource/61d7f1c92e55de3cd12f9c90b46341b2"},{"@id":"https://admin.dataportal.se/store/697/resource/644be4231d9d19178c4a338a0bbdb9ef"}],"dcat:keyword":[{"@language":"en","@value":"culture"},{"@language":"en","@value":"history"},{"@language":"en","@value":"museum"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Bebyggelseregistret, BeBR, är ett nationellt register med information om det byggda kulturarvet. Här ryms allt från timmerstugor och gamla industrimiljöer till modern stadsbebyggelse. Det finns omkring 80 000 sökbara poster i registret, av dem är cirka 13000 byggnader skyddade som byggnadsminnen och kyrkor. Uppdateringar och nya registreringar görs kontinuerligt. De uppgifter som finns presenterade i Bebyggelseregistret är hämtade från inventeringar, dokumentationer, arkiv och litteratur. Informationen är framtagen och registrerad av regionala museer, Svenska Kyrkan, länsstyrelser, kommuner, universitet och högskolor i samverkan med Riksantikvarieämbetet.\n\nI BeBR betecknar byggnad en funktionellt självständig byggnadskropp, företrädesvis under tak och i en eller flera våningar. Den kan vara försedd med på- och tillbyggnader. BeBR:s begrepp omfattar även byggnadsverk och objekt av annat slag t.ex. bro, brygga damm, dansbana etc. Registrets byggnader är indelade i funktioner. Med funktion menas det ändamål för vilken byggnaden/objektet en gång har skapats eller senare kommit att präglas av. Exempel på byggnadsfunktioner är bl.a. bod, ekonomibyggnad, operahus och skolbyggnad.\n"},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:source":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Bebyggelseregistret byggnad"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/61d7f1c92e55de3cd12f9c90b46341b2","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dct:description":[{"@language":"en","@value":"A RDF/XML web-API."},{"@language":"sv","@value":"Ett RDF/XML webb-API."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF_XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/644be4231d9d19178c4a338a0bbdb9ef","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:3c094d0563197a4c327b1840124c988c8776a00bcb448c005768968aa047119a"},{"@graph":[{"@id":"https://admin.dataportal.se/store/697/resource/5263b22087191fec9cf6bfddd29ce595","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}