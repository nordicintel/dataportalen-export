mål"},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://www.vaxholmsfastning.se/"},"dct:source":{"@id":"http://www.vaxholmsfastning.se/"},"dct:title":{"@language":"sv","@value":"Vaxholms Fästnings Museum"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/da21d97981a9ec72ffd714d22008eccf","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://kulturarvsdata.se/ksamsok/api"},"dcat:mediaType":"application/json-ld","dct:description":[{"@language":"en","@value":"A JSON LD web-API."},{"@language":"sv","@value":"Ett JSON LD webb-API."}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:rights":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/anvandarvillkor/"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}}],"@id":"urn:source:1343a4fad9a7b262191b7ec9c44158dfe2ebee72d4a7e7fd130dfb4ac8efc4b2"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021001090","@type":"foaf:Agent","dct:identifier":"2021001090","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:homepage":{"@id":"https://www.raa.se/"},"foaf:mbox":{"@id":"mailto:oppnadata@raa.se"},"foaf:name":[{"@language":"en","@value":"Swedish National Heritage Board"},{"@language":"sv","@value":"Riksantikvarieämbetet"}],"foaf:page":{"@id":"https://raa.se/"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.raa.se/store/1/resource/1"},{"@id":"https://www.raa.se/"}]},{"@id":"https://admin.dataportal.se/store/697/resource/17ae5ef80ce82fc00dac5e3325077e4f","@type":"dcat:Dataset","dcat:distribution":[{"@id":"https://admin.dataportal.se/store/697/resource/45ab09d21fa4522baf0ccd3329e848cb"},{"@id":"https://admin.dataportal.se/store/697/resource/ef5303a11d8c02ac4fe332a905c1b864"}],"dcat:keyword":[{"@language":"en","@value":"culture"},{"@language":"en","@value":"history"},{"@language":"en","@value":"museum"},{"@language":"sv","@value":"historia"},{"@language":"sv","@value":"kultur"},{"@language":"sv","@value":"museum"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Bebyggelseregistret, BeBR, är ett nationellt register med information om det byggda kulturarvet. Här ryms allt från timmerstugor och gamla industrimiljöer till modern stadsbebyggelse. Det finns omkring 80 000 sökbara poster i registret, av dem är cirka 13000 byggnader skyddade som byggnadsminnen och kyrkor. Uppdateringar och nya registreringar görs kontinuerligt. De uppgifter som finns presenterade i Bebyggelseregistret är hämtade från inventeringar, dokumentationer, arkiv och litteratur. Informationen är framtagen och registrerad av regionala museer, Svenska Kyrkan, länsstyrelser, kommuner, universitet och högskolor i samverkan med Riksantikvarieämbetet.\n\nI BeBR avser miljö den fysiska miljö där bebyggelsen ligger. Miljön är indelad i olika kategorier, baserade på den indelning i landskaps- och miljötyper som tillämpas av RAÄ vid beskrivning av riksintresseområdena för kulturminnesvård. Exempel på miljökategorier är kust- och skärgårdsmiljö, odlingslandskap och bruksmiljö.\n"},"dct:language":{"@id":"http://id.loc.gov/vocabulary/iso639-1/sv"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:source":{"@id":"http://dataportal.se/organisation/SE2021001090"},"dct:title":{"@language":"sv","@value":"Bebyggelseregistret miljö"},"foaf:page":{"@id":"https://www.raa.se/hitta-information/k-samsok/att-anvanda-k-samsok/api/"}},{"@id":"https://admin.dataportal.se/store/697/resource/45ab09d21fa4522baf0ccd3329e848cb","@type":"dcat:Distribution","dcat:accessURL":{"@id":