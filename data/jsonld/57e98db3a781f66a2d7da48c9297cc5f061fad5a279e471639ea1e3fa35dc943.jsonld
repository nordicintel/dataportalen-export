":"sv","@value":"Järnvägsnät - Riktning_för_trafikflödet (INSPIRE)"},{"@language":"sv","@value":"TN.Järnvägsnät.RiktningFörTrafikflödet"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the direction of the traffic flow according to the INSPIRE Transport Network (TN) specification TrafficFlowDirection. The direction attribute indicates the main direction of traffic flow in relation to the direction of the referenced network link in RailwayLinkSequence. The actual traffic flow direction is determined by Train traffic management."},{"@language":"sv","@value":"Datamängden redovisar riktiningen för trafikflödet enligt Inspiretema transportnät (TN) TrafficFlowDirection. Attributet direction anger huvudsaklig trafikflödesriktning i förhållande till den riktning som den refererade nätverkslänken i RailwayLinkSequence har. Den verkliga trafikflödesriktningen bestäms vid tågtrafikledning.\n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"1c9bd63b-3f0c-4d45-964e-735d7c802dbd","dct:issued":{"@type":"xsd:date","@value":"2012-06-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-06-07"},"dct:provenance":{"@id":"_:414911155a65619ee6f5296ef9d0cbddfe8fe688734dbd2bfb5b505fb24eb87b_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:4149111