city":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Körriktning"},{"@language":"sv","@value":"Vägnät - Körriktning (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the direction of traffic flow in relation to the direction of the road, according to the INSPIRE Transport Network (TN) specification for TrafficFlowDirection. It is generated from the following road data products: \nProhibited Direction of Travel / Förbjuden färdriktning\no\tReference link part / Referenslänksdel"},{"@language":"sv","@value":"Datamängden redovisar riktning för trafikflödet i relation till väglänkens riktning enligt Inspiretema transportnät (TN) TrafficFlowDirection. TrafficFlowDirection är genererad ur från följande vägdataprodukter: \n- Förbjuden färdriktning \n- Referenslänksdel \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"b45edba3-53ef-43d5-b7a1-a196f790696f","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b19n0"},{"@id":"https:/