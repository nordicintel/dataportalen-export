/metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/463"},{"@id":"https://metadata.trafikverket.se/store/1/resource/511"},{"@id":"https://metadata.trafikverket.se/store/1/resource/557"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=431&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"Järnvägsnät - Vertikal_position (INSPIRE)"},{"@language":"sv","@value":"TN.Järnväg.VertikalPosition"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the vertical position of the railwayaccording to the INSPIRE Transport Network (TN) specification VerticalPosition. Data shall describe the vertical position of the railway in relation to other transport elements. What the dataset actually providess are stretches where the railway runs above or below ground, based on information that the railway runs on a bridge or in a tunnel. Remaining stretches are treated as being on ground level."},{"@language":"sv","@value":"Datamängden redovisar järnvägens vertikala position enligt Inspiretema transportnät (TN) VerticalPosition. Temat ska beskriva järnvägens vertikala position i förhållande till andra transportelement. Det datamängden faktiskt redovisar är sträckor där järnvägen går ovan eller under mark, utifrån uppgifter om att järnvägen går på bro eller i tunnel. Resterande sträckor behandlas som att de går på marken."}],"dct:identifier":"03c5fa5f-045d-46b0-b0ad-d96db50b66ed","dct:issued":{"@type":"xsd:date","@value":"2012-06-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-06-07"},"dct:provenance":{"@id":"_:79b1dfc910f4f289c956b70464a28c51c88b985cf839fb53db0b056bb964971b_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:79b1dfc910f4f289c956b70464a28c51c88b985cf839fb53db0b056bb964971b_b9n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:79b1dfc910f4f289c956b70464a28c51c88b985cf839fb53db0b056bb964971b_b10n0"},"dct:title":{"@language":"en","@value":"Railway Transport Network - Vertical Position (INSPIRE)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"