Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1572","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1573"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1574"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1598"},{"@id":"https://metadata.trafikverket.se/store/1/resource/2433"}],"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1572&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":{"@language":"en","@value":"Wildlife Accident Maps - Roe Deer 2020-2024"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2023-10-30"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Viltolyckskartor för rådjur utgörs av vektor- och rasterdata som presenterar aggregerad viltolycksstatistik med rådjur under den angivna femårsperioden. Materialet levereras i en .gpkg-fil som  hjälper vid visualisering och tolkning av materialet. Viltolyckstätheter redovisas i rasterfiler med olika upplösning. Viltolycksfrekvenser redovisas längs huvudvägnätet och inom utpekade områden med höga olyckstal. Frekvens beräknats som antal viltolyckor per km och år under femårsperiod. Materialet bygger på inrapporterade viltolyckor till polis samt jägarrapporter enligt Nationella Viltolycksrådet."},"dct:identifier":"8964095f-e1e5-4d03-b2ca-d20134406f29","dct:issued":{"@type":"xsd:date","@value":"2023-10-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-05"},"dct:provenance":{"@id":"_:13105079b83e9963a5196a37ff2168b646f27bcfb57cfd11978fb8d7c5be719d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:13105079b83e9963a5196a37ff2168b646f27bcfb57cfd11978fb8d7c5be719d_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:13105079b83e9963a5196a37ff2168b646f27bcfb57cfd11978fb8d7c5be719d_b2n0"},"dct:title":{"@language":"sv","@value":"Viltolyckskartor - Rådjur 2020 - 2024"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikve