u/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"Järnväg - Tillträdesbegränsning (INSPIRE)"},{"@language":"sv","@value":"TN_Järnväg_Tillträdesbegränsning"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"en","@value":"The dataset provides the number of tracks represented by each railway link according to the the INSPIRE Transport Network (TN) specification for AccessRestriction. \n\nRailway managed by The Swedish Transport Administration and having inspection class=0 (no inspection) are given the value ”physicallyImpossible”.  Other railways managed by The Swedish Transport Administration are given the value ”publicAccess”. Currently, railways managed by another organization than The Swedish Transport Administration are always given the value ”physicallyImpossible”."},"dct:identifier":"478fdd5f-709a-4884-955c-03653cfda7f6","dct:issued":{"@type":"xsd:date","@value":"2012-06-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-06-07"},"dct:provenance":{"@id":"_:99629d494558444334238159721ba11ed49af097cc33402ef26e3aa5857eed4e_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:99629d494558444334238159721ba11ed49af097cc33402ef26e3aa5857eed4