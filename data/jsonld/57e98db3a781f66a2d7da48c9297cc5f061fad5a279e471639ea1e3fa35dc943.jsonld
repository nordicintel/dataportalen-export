g/2009/976/oj"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med dataprodukter inom järnväg"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra järnvägsdata"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1015","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1101"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1173"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1347"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1355"}],"dcat:keyword":[{"@language":"en","@value":"NJDB"},{"@language":"sv","@value":"NJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1015&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Railway data Railway bridge"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-12-07"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En järnvägsbro är en bro som belastas av tågen. Järnvägsbron är en del av järnvägsnätet.\n\nProdukten ska innehålla allmänna uppgifter om alla järnvägsbroar som ingår i Det statliga järnvägsnätet (indelningstyp Trafikverkets spåranläggning) även om inte Trafikverket förvaltar dem.\n\nFör att kunna söka ut om man planskilt kan passera järnvägen finns attributet ”Typ av planskildhet” som t.ex. kan ha värden för att visa planskildhet för GC-trafik och planskildhet för motordrivna fordon.\n\nEtt attribut är Kombinerad jvg/vägbro. Med det menas en bro där väg och järnväg delar på farbanan.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod och närmast föregående kilometertavla med avstånd i meter till både start- och slutläget på sträckan i spårlänkens riktning.\n\nUndantag: De broar som Trafikverket äger och ska förvalta men som ligger vid en nedlagd eller flyttad bana. Dessa broar saknar läge eftersom det inte finns något järnvägsnät att koppla till."},"dct:identifier":"29f27e74-2798-4aa3-ae6f-2f656b564b51","dct:issued":{"@type":"xsd:date","@value":"2012-12-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:649cc8b34e579fe50edadb153678c718dab1860fc831323a68335112093967ba_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:649cc8b34e579fe50edadb153678c718dab1860fc831323a68335112093967ba_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:649cc8b34e579fe50edadb153678c718dab1860fc831323a68335112093967ba_b2n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Järnvägsbro"},"foaf:pag