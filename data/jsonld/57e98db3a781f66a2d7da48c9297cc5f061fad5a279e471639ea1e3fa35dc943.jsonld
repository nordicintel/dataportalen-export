","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7c9b88c93ae7a896ea38b06b71511ea78f65965692effb707475ed5759983f5e_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:7c9b88c93ae7a896ea38b06b71511ea78f65965692effb707475ed5759983f5e_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:7c9b88c93ae7a896ea38b06b71511ea78f65965692effb707475ed5759983f5e"},{"@graph":[{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor."}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n0"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n1"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n10"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n6"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n4"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n5"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n0"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n1"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n10"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n4"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n5"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n7"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n8"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n9"}]},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n7"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n8"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b10n9"},{"@id":"_:7cff33dac0d2a2528d411d65fe8cbbe5ce813cad9f5c10367052ce679491360c_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket