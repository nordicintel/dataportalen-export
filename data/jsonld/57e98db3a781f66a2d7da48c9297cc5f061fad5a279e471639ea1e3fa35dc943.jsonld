sRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/AS_NEEDED"},"dct:alternative":{"@language":"en","@value":"Railway Data - Maximum Authorised Speed A/B/C/S-Train"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-10-31"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Största tillåtna hastighet (STH A/B/C/S-tåg), vilket beskriver skyltad hastighet kombinerad med hastighetsöverskridande för en viss tågkategori på bansträckningen i angiven riktning. Dataprodukten STH A/B/C/S-tåg skapas utifrån andra dataprodukter och finns på alla normal- och avvikande huvudspår samt vissa sidospår.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod med avstånd i meter till både start- och slutläget på sträckan i spårlänkens riktning."},"dct:identifier":"e2fbd5c6-47e7-4750-afa2-e6b21aaa51ce","dct:issued":{"@type":"xsd:date","@value":"2012-10-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:ac5a2ea596f71410fdbdffe23735b07e0112ba3a9b0d01f01f91489dd473756d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:ac5a2ea596f71410fdbdffe23735b07e0112ba3a9b0d01f01f91489dd473756d_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transp