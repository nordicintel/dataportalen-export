store/1/resource/2437"}],"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1590&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":{"@language":"en","@value":"Wildlife Accident Maps - Reindeer 2020-2024"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2023-10-30"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Viltolyckskartor för ren utgörs av vektor- och rasterdata som presenterar aggregerad viltolycksstatistik med ren under den angivna femårsperioden. Materialet levereras i en .gpkg-fil som  hjälper vid visualisering och tolkning av materialet. Viltolyckstätheter redovisas i rasterfiler med olika upplösning. Viltolycksfrekvenser redovisas längs huvudvägnätet och inom utpekade områden med höga olyckstal. Frekvens beräknats som antal viltolyckor per km och år under femårsperiod. Materialet bygger på inrapporterade viltolyckor till polis samt jägarrapporter enligt Nationella Viltolycksrådet."},"dct:identifier":"16e61ece-c484-4530-8351-119f26351ace","dct:issued":{"@type":"xsd:date","@value":"2023-10-30"},"dct:language":{"@id":"http://publications.europa.eu/