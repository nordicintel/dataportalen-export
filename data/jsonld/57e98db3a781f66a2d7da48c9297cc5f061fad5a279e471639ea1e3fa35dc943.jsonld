ps://metadata.trafikverket.se/store/1/resource/826"},{"@id":"https://metadata.trafikverket.se/store/1/resource/932"}],"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=685&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":{"@language":"en","@value":"Strategic Road Network for Heavy Transports"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1037strategiskt_vagnat_for_tyngre_transporter.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2016-06-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Strategiskt vägnät för tyngre transporter visar var de tyngre transporterna går och förväntas gå i framtiden på det statliga vägnätet. Vägnätet är framtaget i dialog med näringslivet samt Trafikverkets experter på bro och bärighet. Användningsområde för vägnätet är bland annat som underlag för planering och för drift- och underhållsåtgärder samt för trafiksäkerhetsanalyser och åtgärder."},"dct:identifier":"10d0fd40-54fd-41ce-84ac-3a345eede4a7","dct:issued":{"@type":"xsd:date","@value":"2016-06-01"},"dct:language":{"@id":"http://publications.e