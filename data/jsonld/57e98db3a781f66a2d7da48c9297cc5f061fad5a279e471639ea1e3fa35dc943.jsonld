,"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":[{"@language":"en","@value":"The Interactive Map for Traffic Flow - Road"},{"@language":"sv","@value":"Klickbara kartan, trafikflöden väg"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-12-18"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Webbapplikation för trafikflöde för statligt vägnät. \n\nKartan visar olika typer av trafikmätningsplatser utifrån vilka vägtrafikdata används till statistiska undersökningar som presenteras i tabeller. Trafikmätningarna avser t.ex. trafikflöden och fordonshastigheter kopplade till olika motorfordonskategorier."},"dct:identifier":"d147df25-ccb1-4b4e-9fd0-89f862d1cc90","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:28af7bd5a9e12c2dbbc61499d27ce0da02478ba3ec5f3d3598e07aec64c505fe_b12n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Trafikinformation klickbar karta (TIKK)"},"dct:type":{"@id":