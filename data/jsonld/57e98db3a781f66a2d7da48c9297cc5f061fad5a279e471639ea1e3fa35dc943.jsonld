,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n3"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n0"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b16n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n3"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n0"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/meta