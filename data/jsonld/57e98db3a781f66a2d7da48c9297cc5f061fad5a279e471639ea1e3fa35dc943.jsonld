/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b11n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b11n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b11n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b12n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b12n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b12n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b13n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b13n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b13n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b14n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b14n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b14n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b15n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b15n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b15n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b16n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b16n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b16n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b17n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b17n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b17n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n13"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n4"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n5"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n6"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n7"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n8"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n9"}]},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n4"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n5"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n6"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n7"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n8"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b18n9"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n13"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n4"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n5"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n6"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n7"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n8"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n9"}]},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n4"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n5"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n6"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n7"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n8"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b19n9"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n13"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n0"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n10"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n11"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n12"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n4"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n5"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n6"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n7"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n8"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n9"}]},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n14"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n15"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n16"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n17"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n2"},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b20n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc1