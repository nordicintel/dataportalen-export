":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:eed827752d6161fc2d59cb0b102ecf9de2d5bb9a745b009afe327737ff50c880_b9n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:eed827752d6161fc2d59cb0b102ecf9de2d5bb9a745b009afe327737ff50c880_b10n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:eed827752d6161fc2d59cb0b102ecf9de2d5bb9a745b009afe327737ff50c880"},{"@graph":[{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden har digitaliserats med utgångspunkt från äldre handritade papperskartor av varierande kvalitet, som tillhandahållits av informationsansvarig part, funktionen för Juridik och planprövning (JPp). Därefter har manuell granskning och validering av den digitaliserade datamängden tagits vid (utförts av JPp) och vid behov polygonerna reviderats.\n\nSektionen Förädla Geodata har digitaliserat handritade kartor och gjort dem tillgängliga för ytterligare granskning och iterationer för att överensstämma med uppgiftslämnarens, funktionen för Juridik och planprövning, uppfattning om områdesutbredning.\n\nAjourhållning sker utifrån tillkomsten av nya beslutsunderlag."}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n3"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n0"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.nvdb.se","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Nationell vägdatabas för dataanvändare och dataleverantörer (Trafikverket, Sveriges kommuner, skogsnäringen, Transportstyrelsen, Lantmäteriet)."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB - nationell vägdatabas"}},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med presentation av dataprodukspecifikationer."},"dct:title":{"@language":"sv","@value":"Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om de dataprodukter som varken kan kopplas direkt till väg eller järnväg, så kallade omgivande geodata, eller är dataprodukter skapade som en kombination av både väg- och järnväg."},"dct:title":{"@language":"sv","@value":"Informationssida: Omgivande geodata och kombinerade väg-järnvägsdataprodukter"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/997","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=997&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:alternative":{"@language":"en","@value":"Municipal Road Management Areas"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-05-21"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Kommunala väghållningsområden (yta, polygon).\n\nRedovisar utbredningen av områden där kommunen är väghållare av allmän väg.\n\nVarje polygon representerar ett kommunalt väghållningsområde. Varje kommunalt väghållningsområde omfattar en eller flera tätorter eller en hel kommun.\n\nSyftet med dataprodukten är att visualisera utbredningen av respektive kommunalt väghållningsområde.\n\nDataprodukten ska redovisa var gränsen går mellan kommunal och statlig väghållare av allmän väg. Det är viktigt att ha en väldefinierad avgränsning av det kommunala väghållningsområdet eftersom Trafikverket inte är väghållare för allmän väg inom området, förutom för det fåtal vägar med en övergripande funktion som har undantagits. Vilka vägar som har undantagits framgår av beslutsdokumentationen.\n\nViktiga attribut:\n\n- Kommun - Namn på väghållande kommun\n- Tätort - Namn på den tätort i kommunen för vilket det kommunala väghållningsområdet är knutet\n\nBehov finns internt inom Trafikverket (till exempel vägnätsutredare, samhällsplanerare, driften, med flera) men även externt (kommuner, länsstyrelser, med flera) att på ett lättförståeligt och lättillgängligt sätt kunna ta del av de kommunala väghållningsområdenas utbredningar."},"dct:identifier":"2a5ccda7-4449-4e23-9506-408569797f64","dct:issued":{"@type":"xsd:date","@value":"2015-05-21"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/boundaries"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b2n0"},"dct:title":{"@language":"sv","@value":"Kommunala väghållningsområden"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.org/terms/metadataIdentifier":"b76967c4-50c0-4846-bac2-adbcbfc8f961","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Inga särskilda begränsningar för åtkomst men för interna användare finns som attribut en URL som länkar direkt till en katalog på Trafikverkets nätverk, innehållandes beslutsdokumentation, samt ett annat attribut med URL till motsvarande katalog med kartbilagor. Dessa kataloger är inte tillgänglig för externa användare. Vill man som extern användare komma åt källan till informationen får man begära ut de dokument med Trafikverkets dokumentbeteckning, som finns i attributet Gallande_DiarieNR. Inga särskilda villkor för åtkomst och nyttjande av resursen eller andra skäl för begränsning av allmän åtkomst föreligger. För att få tillgång till dataprodukten krävs det att användaren godkänner licensvillkor samt anger källa vid användning."},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/DataPackagesAndSpecialProducts"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93_b4n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:eefc93d1f44fb7a7e3b8a87b324558c187d1f3bcc3ed875d9d1c0653cd0dbc93"},{"@graph":[{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b10n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n3"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n0"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b11n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n2"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n0"}},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b13n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFr