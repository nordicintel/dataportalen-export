.se/store/1/resource/1429"},{"@id":"https://metadata.trafikverket.se/store/1/resource/790"},{"@id":"https://metadata.trafikverket.se/store/1/resource/900"}],"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=639&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"FPV Freight Transport"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://intranat.trafikverket.local/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2016-01-12"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"FPV godstransporter är en funktion till vägnätet FPV (Funktionellt Prioriterat Vägnät). FPV godstransporter pekar ut vägar som är internationellt, nationellt och regionalt viktiga för långväga godstransporter samt vägar med kopplingar till nationellt och regionalt viktiga noder. De vägar som pekats ut skapar ett sammanhängande regionalt och nationellt nät med kopplingar till viktiga målpunkter och noder."},"dct:identifier":"ebd3a6fe-9796-42d8-9dc6-cadf7dd26f3b","dct:issued":{"@type":"xsd:date","@value":"2016-01-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@