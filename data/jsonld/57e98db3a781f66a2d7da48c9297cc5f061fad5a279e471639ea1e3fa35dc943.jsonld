tps://metadata.trafikverket.se/store/1/resource/1242"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1428"},{"@id":"https://metadata.trafikverket.se/store/1/resource/788"},{"@id":"https://metadata.trafikverket.se/store/1/resource/895"}],"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=638&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"FPV Daily Personal Travel"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1001FPV%20dagliga%20personresor.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2016-01-12"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"FPV Dagliga personresor är en funktion till vägnätet FPV (Funktionellt Prioriterat Vägnät). FPV Dagliga personresor pekar ut vägar som i regel har kortväga och regionalt resande, vanligtvis upp till cirka 10 mil, till exempel arbets-och studiependling, resor till centrala servicefunktioner, större handelsområden och sjukhus. Vägnätet avser i första hand vägar med vana resenärer som kan vägen och färdas där regelbundet eller dagligen."},"dct:identi