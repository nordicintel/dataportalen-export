ty","http://www.w3.org/ns/prov#generated":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b1n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b1n0"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b1n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b1n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n3"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n0"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b4n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Initial insamling av data har skett genom att hösten 2013 inventera och samla in underlag avseende TEN-T-vägnätet. Därefter gjorde man en bedömning och klassning av trafiksäkerhetsstatusen samt om det var landsbygd eller tätort på sträckor på detta vägnät.\n\nTrafiksäkerhetsenheten inom verksamhetsområde Planering levererade därefter detta underlag till enheten Väg- och järnvägsdata som tolkade underlaget och registrerade gällande sträckor.\n\nUnderlag för ajourhållning fångas av ansvariga på regionerna och levereras till Trafikverkets enhet för Väg- och järnvägsdata för registrering enligt uppgjorda avtal och processer. Underlaget på regionerna tas fram på uppdrag av enheten Trafiksäkerhet inom verksamhetsområde Planering."}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b5n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b6n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n3"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n0"}},{"@id":"_:7497ef2dbe8af3a4dc5e50f015f7a75e246907555731110b94144ebcb0a34d24_b7n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/Degre