guage":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1578","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1579"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1580"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/2436"}],"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1578&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":{"@language":"en","@value":"Wildlife Accident Maps - Moose 2020-2024"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2023-10-30"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Viltolyckskartor för älg utgörs av vektor- och rasterdata som presenterar aggregerad viltolycksstatistik med älg under den angivna femårsperioden. Materialet levereras i en .gpkg-fil som  hjälper vid visualisering och tolkning av materialet. Viltolyckstätheter redovisas i rasterfiler med olika upplösning. Viltolycksfrekvenser redovisas längs huvudvägnätet och inom utpekade områden med höga olyckstal. Frekvens beräknats som antal viltolyckor per km och år under femårsperiod. Materialet bygger på inrapporterade viltolyckor till polis samt jägarrapporter enligt Nationella Viltolycksrådet."},"dct:identifier":"3712eb0c-f24e-4326-b6fc-ea6a082b2ad5","dct:issued":{"@type":"xsd:date","@value":"2023-10-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-05"},"dct:provenance":{"@id":"_:bc82d59acbbd23eef668207cfe8aa0c46840c880f9bb359320875a47ef47007f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:bc82d59acbbd23eef668207cfe8aa0c46840c880f9bb359320875a47ef47007f_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:bc82d59acbbd23eef668207cfe8aa0c46840c880f9bb359320875a47ef47007f_b2n0"},"dct:title":{"@language":"sv","@value":"Viltolyckskartor - Älg 2020 - 2024"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"}],"http://entryscape.org/terms/metadataIdentifier":"8e5e8163-927e-40c1-8bf9-674ddde65b2c","http://www.w3.org/ns/adms#status":{"@id":"https://dat