c4b9_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n3"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n0"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b22n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b23n3"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b23n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b23n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e