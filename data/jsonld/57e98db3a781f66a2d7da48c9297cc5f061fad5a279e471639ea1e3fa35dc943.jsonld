#wasUsedBy":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b7n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b8n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b9n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b10n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:ab0af869b43549f9b45d603b84f696f044b2e3167ea24a5cc6b23c8bef2027cf"},{"@graph":[{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b10n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b10n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b10n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b11n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b11n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b11n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b12n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b12n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b12n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b13n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b13n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b13n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b14n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b14n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b14n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b15n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b15n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b15n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b16n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b16n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b16n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b17n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b17n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b17n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Vägnummer avser den nationella nummersättningen av vägsträckor enligt beslut som publiceras årligen av Länsstyrelsen i dokumentet ”Sammanställning över allmänna vägar”, en per län.\n\nVägnummer är numrerade i tre nummerserier:\n- Vägnummer 1-99 (europavägar och riksvägar)\n- Vägnummer 100-499 (primära länsvägar)\n- Vägnummer 500-5000 (sekundära och tertiära länsvägar)\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n0"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n13"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n10"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n11"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n12"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n0"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n10"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n11"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n12"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n14"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n15"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n16"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n17"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n2"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n4"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n5"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n6"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n7"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n8"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n9"}]},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n14"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n15"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n16"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n17"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n2"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n4"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n5"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n6"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n7"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n8"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b18n9"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n0"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n13"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n10"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n11"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n12"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b19n13","@type