etagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/contentassets/921c2de120b4449fbc0e8119bb721c45/generaliserat_jarnvagsnat_forbindelser_2_0.pdf","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dataproduktspecifikation i PDF format.\n\nGeneraliserat järnvägsnät med förbindelser är en förädlad järnvägsdataprodukt vilket innebär att den genereras utifrån ett antal redan existerande dataprodukter. Syftet är att skapa objekt som motsvarar förbindelser mellan trafikplatser i järnvägsnätet.\n\nDataproduktens geometrier baseras på en generalisering av det detaljerade järnvägsnätet.\n\nDataproduktens attribut hämtas från dataprodukterna; Förbindelse, Plats, Bandel, Stråk, Elektrifiering, Infrastrukturförvaltare, Status Järnvägsnät, Anläggningsregion, Trafikeringssystem och Trafikcentralområde.\n\nDataprodukten omfattar det järnvägsnät som är registrerat i den nationella järnvägsdatabasen, NJDB med undantag av sträckor som är rivna."},"dct:title":{"@language":"sv","@value":"DPS: Generaliserat järnvägsnät med förbindelser"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med dataprodukter inom järnväg"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra järnvägsdata"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/982","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:keyword":[{"@language":"en","@value":"Railway data"},{"@language":"sv","@value":"Järnvägsdata"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=982&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":[{"@language":"en","@value":"Generalized Segment between Railway Locations"},{"@language":"sv","@value":"Generaliserat järnvägsnät"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2018-06-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"\"Generaliserat järnvägsnät med förbindelser\" utgörs av en generaliserad linjeutbredning mellan två järnvägsplatsers platsmittar med järnvägstrafikala egenskaper som avser hela förbindelsen."},"dct:identifier":"0d52fe3d-6502-4010-b5c6-2b9e4ec2b22c","dct:issued":{"@type":"xsd:date","@value":"2018-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:cea4efcac0081bc1ade4c34eabd188e0d9f03bb96ba134dc95172174242be7f6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:cea4efcac0081bc1ade4c34eabd188e0d9f03bb96ba134dc95172174242be7f6_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:cea4efcac0081bc1ade4c34eabd188e0d9f03bb96ba134dc95172174242be7f6_b2n0"},"dct:title":{"@language":"sv","@value":"Generaliserat järnvägsnät med förbindelser"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/921c2de120b4449fbc0e8119bb721c45/generaliserat_jarnvagsnat_forbindelser_2_0.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://