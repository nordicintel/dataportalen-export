sourceDescriptor","dct:subject":{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b10n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n3"}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n0"}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:68bc0b468bbbc623bbc2247a139868b53b292c5b318b1a2899761d8e76382be9_b11n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg