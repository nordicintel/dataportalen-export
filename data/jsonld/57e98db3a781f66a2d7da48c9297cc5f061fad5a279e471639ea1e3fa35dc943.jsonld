"https://metadata.trafikverket.se/store/1/resource/1391"}],"dcat:keyword":[{"@language":"en","@value":"StJDB"},{"@language":"sv","@value":"StJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1054&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Railway Data - Railroad Switch"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-12-20"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten representerar de fysiska spårväxlarna i järnvägsnätet som är anordningar som gör det möjligt att framföra ett spårfordon från ett spår till ett annat.\n\nDet finns ett antal huvudtyper av spårväxlar som är representerade i dataprodukten. Det är enkel växel (EV), enkel växel med rörlig korsningsspets (EKR), enkel korsningsväxel (EKV), dubbel korsningsväxel (DKV) och tredelig växel (3V). En översikt över dessa spårväxeltyper ges här:\n\nEnkel växel (ev) - en spårväxel som har ett avvikande spår.\n\nEnkel växel med rörlig korsningsspets (evr) – en spårväxel som har ett avvikande spår och en omläggningsbar korsningsspets.\n\nEnkel korsningsväxel (ekv) - två korsande spår där två rörelsevägar har förbindelse med varandra.\n\nDubbel korsningsväxel (dkv) - två korsande spår där alla fyra rörelsevägar har förbindelse med varandra.\n\nTredelig växel (3v) - en spårväxel som har två avvikande spår. Spårväxeln är sammansatt av två enkla växlar som representeras av två noder.\n\nDataprodukten är en objekttyp men spårväxlarna är även noder i spårnätet, där spårlänkarna har sina start- och slutpunkter.\n\nProdukten innehåller uppgifter i form av attribut och komponenter. Det är uppgifter om typ av spårväxel, vilka egenskaper spårväxeln har, vem som är ägare, identitet och årtal för installation i spåret. Vissa av attributen som finns i produkten finns även knutna till noden och förs över till Spårväxel med automatiska processer. Följande attribut är obligatoriska för Spårväxel:\n- Växelnr (data överförs automatiskt från nod)\n- Växeltyp (data överförs automatiskt från nod)\n- BISref nodtyp (data överförs automatiskt från nod)\n- Tunglängd (data överförs automatiskt från nod)\n- V/H växel\n- LÖradie - spårväxlar på LÖ-väg\n- Krökningstyp(Båge)\n- Typ av anslutningsväxel\n\nAttributet Växeltyp har värden som är sammansatta av fyra delar enligt exempel EV-UIC60-760-1:15 och EV-SJ50-11-1:9 . Inledningsvis är huvudväxeltyp representerad av två till tre tecken, t ex EV, EVR och DKV. Därefter följer data som representerar profiltyp för räl och vikt per meter räl, t ex UIC60 och SJ50. Som del tre följer, för äldre spårväxlar, tunglängden(m), t ex 11 och för nyare spårväxlar, radie (m) för grenspår t ex 760. Slutligen består sista delen av ett värde på spårväxelns vinkel mot anslutande spår, t ex 1:9 och 1:15. Vinkeln utgår från den matematiska korsningspunkten och mäts mellan tangenterna för respektive spår."},"dct:identifier":"2db46873-0f02-4f47-bdf3-a5fe16950dac","dct:issued":{"@type":"xsd:date","@value":"2012-12-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:2342b6a08760109b6bf7962064e9e337e786ac894c172222dfe7684981a712be_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:2342b6a08760109b6bf7962064e9e337e786ac894c172222dfe7684981a712be_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:2342b6a08760109b6bf7962064e9e337e786ac894c172222dfe7684981a712be_b2n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Spårväxel"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/958"},{"@id":"https://metadata.trafikverket.se/store/1/resource/960"}],"http://entryscape.org/terms/metadataIdentifier":"358ac010-28e7-48f5-98c6-12aa1e4c64be","http://schema.org/image":[{"@id":"http://geo-baninfo.trafikverket.se/MapService/wms.axd/BanInfo_1_5?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Sparvaxel_inlaggningsar&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"},{"@id":"http://geo-baninfo.trafikverket.se/MapService/wms.axd/BanInfo_1_5?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Sparvaxel_typ&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"},{"@id":"https://geo-baninfo.trafikverket.se/MapService/wms.axd/BanInfo_1_5?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Sparvaxel_nummer&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"}],"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:2342b6a08760109b6bf7962064e9e337e786ac894c172222dfe7684981a712be_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RW_StateRailwayNetworkDataStJDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/StJDB_PhysicalObjects"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1127","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/orderdata/jvg"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Datamängd gällande Spårväxel. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst. \n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Järnvägsdata Spårväxel - nedla