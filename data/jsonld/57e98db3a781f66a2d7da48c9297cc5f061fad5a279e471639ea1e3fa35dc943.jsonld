uropa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Väg"},{"@language":"sv","@value":"Vägnät - Väg (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides road names and road numbers, according to the INSPIRE Transport Network (TN) specification for RoadName. Only onethe road number (the main number) of the host road is provided in the dataset.\n\n It is generated from the following road data product:\no\tRoad number / Vägnummer"},{"@language":"sv","@value":"Datamängden redovisar vägnamn och vägnummer enligt Inspiretema transportnät (TN) RoadName. Road är genererad ur från följande vägdataprodukter: \n- Vägnummer \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer. Endast ett vägnummer (huvudnumret) för värdvägen anges i datamängden."}],"dct:identifier":"44ff17af-e064-43e8-8598-296d14b5b61c","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:gYear","@value":"2018"},"dct:provenance":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b38n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b39n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation