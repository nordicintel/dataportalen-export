"@id":"https://metadata.trafikverket.se/store/1/resource/1437","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/folder/5254"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Dataprodukten finns i det färdiga paketet: Länsfiler NVDB data. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Funktionellt prioriterat vägnät (FPV) - nedladdning i Lastkajen/Länsfiler NVDB data"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b28n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/lastkajen"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_b79e35eb"},{"@id":"http://data.europa.eu/bna/c_e1da4e07"}],"http://entryscape.org/terms/metadataIdentifier":"f9489872-7415-4c6b-a46a-7929235d4983","http://www.w3.org/ns/adms#identifier":"Lastkajen.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b29n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/187","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:endpointURL":{"@id":"https://nvdbpakarta.trafikverket.se/map"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"},{"@language":"sv","@value":"karttjänst"},{"@language":"sv","@value":"map service"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=187&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2024-02-23"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Webbapplikation som gör det möjligt att se Sveriges alla vägar och cykelvägar som finns lagrade i Nationella vägdatabasen (NVDB). Man kan välja att titta på flera olika egenskaper (dataslag) som gäller för en vissa sträcka. Det är också möjligt att rapportera felaktigheter i det data som visas och är du leverantör av data till Nationella vägdatabasen kan du även rapportera förändringar."},"dct:identifier":"b936f118-81a8-4e59-84bb-1aaa6b7865c0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b30n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanWorkflowEnactmentManager"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NVDB på karta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"ae20d31d-c316-4d73-aab1-8bdc9dc68633","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b31n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/642","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1246"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1437"},{"@id":"https://metadata.trafikverket.se/store/1/resource/795"},{"@id":"https://metadata.trafikverket.se/store/1/resource/907"}],"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=642&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Functionally prioritized road network (FPV)"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1008Funktionellt%20prioriterat%20v%C3%A4gn%C3%A4t%20(FPV).pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-11-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"FPV (Funktionellt Prioriterat Vägnät) är ett planeringsunderlag. Trafikverkets utgångspunkt är att tillgängligheten ur ett nationellt och regionalt perspektiv ska prioriteras på de vägar som ingår i FPV och den tillgänglighet som vägarna redan har ska värnas och vid behov utvecklas. Vägarna som pekats ut som funktionellt prioriterade delas in i tre skikt och utifrån fyra viktiga funktioner. Dessa skikt är:\nNationella vägar – nationella stamvägar\nRegionalt viktiga vägar – vägar som binder samman län och funktionella regioner (i regel riksvägar men det kan även vara länsvägar)\nKompletterande regionalt viktiga vägar – vägar som binder samman kommuncentrum och produktionsnoder inom regioner och län (i regel länsvägar, men kan även vara riksvägar)\nDe fyra funktionerna har tagits fram med avseende på vägarnas funktion utifrån tillgänglighet. Funktionerna kan överlappa varandra och kan pekas ut utifrån en eller flera funktioner. Funktionerna är:\nGodstransporter\nLångväga personresor med bil\nDagliga personresor med bil\nKollektivtrafik med buss"},"dct:identifier":"17ed750b-c5d2-4b1a-9705-569c29a7962d","dct:issued":{"@type":"xsd:date","@value":"2015-11-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b32n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b33n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b34n0"},"dct:title":{"@language":"sv","@value":"Funktionellt prioriterat vägnät (FPV)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/for-dig-i-branschen/vag/funktionellt-prioriterat-vagnat/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}],"http://entryscape.org/terms/metadataIdentifier":"30e4c13e-1f6e-4387-9d0d-6aff5cf53c80","http://schema.org/image":{"@id":"https://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo_1_6?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Funktionellt_prioriterat_vagnat&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"},"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:77810452eb72188c6df390ee74f37345626dd347d7c23e34ef31ce55f5a13e3f_b35n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.