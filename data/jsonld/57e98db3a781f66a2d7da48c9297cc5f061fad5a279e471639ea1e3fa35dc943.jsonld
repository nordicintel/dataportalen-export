afikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d8181e756e62a41a68a371217512090037104cc1c3c079c57b3bc2625b878ae7_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d8181e756e62a41a68a371217512090037104cc1c3c079c57b3bc2625b878ae7_b6n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/55","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - LVS förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lvs.forvaltning@trafikverket.se"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/59","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Webb och projektstöd","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:webbochprojektstod@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:d8181e756e62a41a68a371217512090037104cc1c3c079c57b3bc2625b878ae7"},{"@graph":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n3"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n0"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b4n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"6bc5e32ffe4144d050f92972ced2a34ca6"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b5n0","dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2430","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0cf2985e-0bc4-49ea-9ec8-893c52fecac7"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b6n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Ajourhållning: Kontinuerligt."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b7n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten beskriver permanent monterade vägräckesavslutningar i början eller i slutet av vägräcken längs vägnätet.  \n\nVägräckesavslutning har en sidouppdelad punktutbredning placerad där avslutningen ansluter till räcket. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n0"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För exempel på vägräckesavslutningar se referens #100."}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling har skett genom konvertering från företeelser av typen Vägräckesavslutning från Regionala företeelsedatabasen som endast har ajourhållits för vissa av dåvarande Vägverkets regioner från och med 2006-01-01. \n\nFör regioner som inte har ajourhållit data i den Regionala företeelsedatabasen sker inventering inom processen för drift- och underhållsupphandling. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n1"},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n4"}]},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b8n0"}},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b9n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-trafikverket-se-store-1-resource-2429","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/0cf2985e-0bc4-49ea-9ec8-893c52fecac7"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=2429&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Guard rail terminal"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1065V%C3%A4gr%C3%A4ckesavslutning.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-05-04"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Продуктът с данни показва как започва и завършва пътният участък по пътя."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový produkt ukazuje, jak silniční úsek podél silnice začíná a končí."},{"@language":"da-t-sv-t0-mtec","@value":"Dataproduktet viser, hvordan vejstrækningen langs vejen begynder og slutter."},{"@language":"de-t-sv-t0-mtec","@value":"Das Datenprodukt zeigt, wie der Straßenabschnitt entlang der Straße beginnt und endet."},{"@language":"el-t-sv-t0-mtec","@value":"Το προϊόν δεδομένων δείχνει πώς αρχίζει και τελειώνει το οδικό τμήμα κατά μήκος του δρόμου."},{"@language":"en-t-sv-t0-mtec","@value":"The data product shows how the road section along the road begins and ends."},{"@language":"es-t-sv-t0-mtec","@value":"El producto de datos muestra cómo comienza y termina la sección de la carretera a lo largo de la carretera."},{"@language":"et-t-sv-t0-mtec","@value":"Andmetoode näitab, kuidas teelõik tee ääres algab ja lõpeb."},{"@language":"fi-t-sv-t0-mtec","@value":"Datatuote näyttää, miten tien varrella oleva tieosuus alkaa ja päättyy."},{"@language":"fr-t-sv-t0-mtec","@value":"Le produit de données montre comment le tronçon de route le long de la route commence et se termine."},{"@language":"ga-t-sv-t0-mtec","@value":"Taispeánann an táirge sonraí conas a thosaíonn agus a chríochnaíonn an chuid bóthair feadh an bhóthair."},{"@language":"hr-t-sv-t0-mtec","@value":"Podatkovni proizvod pokazuje kako cestovna dionica uz cestu počinje i završava."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adattermék megmutatja, hogyan kezdődik és végződik az útszakasz az út mentén."},{"@language":"it-t-sv-t0-mtec","@value":"Il prodotto dati mostra come inizia e finisce il tratto stradale lungo la strada."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų produktas parodo, kaip prasideda ir baigiasi kelio atkarpa palei kelią."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu produkts parāda, kā ceļa posms gar ceļu sākas un beidzas."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-prodott tad-data juri kif is-sezzjoni tat-triq matul it-triq tibda u tispiċċa."},{"@language":"nl-t-sv-t0-mtec","@value":"Het dataproduct laat zien hoe het weggedeelte langs de weg begint en eindigt."},{"@language":"pl-t-sv-t0-mtec","@value":"Produkt danych pokazuje, jak zaczyna się i kończy odcinek drogi wzdłuż drogi."},{"@language":"pt-t-sv-t0-mtec","@value":"O produto de dados mostra como a secção da estrada ao longo da estrada começa e termina."},{"@language":"ro-t-sv-t0-mtec","@value":"Produsul de date arată modul în care porțiunea de drum de-a lungul drumului începe și se termină."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový produkt ukazuje, ako sa začína a končí úsek cesty pozdĺž cesty."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni izdelek prikazuje, kako se cestni odsek ob cesti začne in konča."},{"@language":"sv","@value":"Dataprodukten redovisar hur vägräcket utefter vägen börjar respektive avslutas."},{"@language":"uk-t-sv-t0-mtec","@value":"Продукт даних показує, як починається і закінчується ділянка дороги вздовж дороги."}],"dct:format":"application/vnd.ogc.wms_xml","dct:issued":{"@type":"xsd:date","@value":"2026-08-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-18"},"dct:provenance":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:d8db9768247b650537f487f1c8c6266877508194fe2e14adb7f7c3eeade6efbb_b2n0"},"dct:title":[{"@lang