tion/SE2021006297"},"dct:description":{"@language":"sv","@value":"Information om plankorsningar, varje post representerar en plankorsning. För riktningsberoende företeelser anges höger och vänster med att stå i riktning vänd mot stigande km-tal."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:0bf0c878dd915712b65dd661e46a6fc534daa93ba732bf719c31ca00bce84174_b0n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":[{"@language":"en","@value":"RailCrossing"},{"@language":"sv","@value":"RailCrossing"}],"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},"http://entryscape.org/terms/metadataIdentifier":"cd7c9de9-03dd-4be3-8718-df174a3ab782","https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/APIArea/api-public"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1828","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},"dcat:accessURL":{"@id":"https://data.trafikverket.se/documentation/datacache/data-model?namespace=Road.Infrastructure&collection=RailCrossing"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Information"},"dct:description":{"@language":"sv","@value":"Visning av datat i Datautbytesportalen - API Öppna Data.\n\nOBS: Om du vill hämta data behöver du registrera ett konto. Du behöver en e-postadress och godkänna licensen för att registrera ett konto."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"RailCrossing- visning/nedladdning i öppna API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/754","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://data.trafikverket.se"},"dcat:keyword":[{"@language":"en","@value":"download service"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=754&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Data Exchange Portal"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-10-13"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Plattform avsedd﻿ för integration och datautbyte. Applikationen innehåller också API-tjänster för nedladdning av väg- och järnvägsdata: \n\n- API Öppna Data  - https://data.trafikverket.se/documentation/datacache\n- API Järnväg - https://data.trafikverket.se/documentation/api-railway\n- API Datex II - https://data.trafikverket.se/documentation/datex"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:0bf0c878dd915712b65dd661e46a6fc534daa93ba732bf719c31ca00bce84174_b1n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Datautbytesportalen"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/transformation"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:0bf0c878dd915712b65dd661e46a6fc534daa93ba732bf719c31ca00bce84174_b2n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0bf0c878dd915712b65dd661e46a6fc534daa93ba732bf719c31ca00bce84174_b3n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/67","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Datautbytesportalen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:datautbyte@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:0bf0c878dd915712b65dd661e46a6fc534daa93ba732bf719c31ca00bce84174"},{"@graph":[{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Med dataprodukten Rastplatser avses sidoanläggning för trafikanters behov av vila, toalettbesök, rekreation eller dylikt, som uppfyller riktlinjerna beskrivna på \"Informationssida: Vägar och gators utformning (VGU)\" under Dokumentation.\n\nDataprodukten Rastplatser är fältinventerade sommar 2023 och 2024. Ny och uppdaterad information har lagts till för att bättre möte trafikanters och Väghållarens behov. Rastplatsernas utrustning eller utformning beskrivs m.h.a. attributen som innehåller information om bl.a. antal parkeringsplatser samt för vilket fordon, skötselansvarig, antal bord med sittplatser, tillgång till toalett samt om det finns lekutrustning eller latrintömning.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet,  se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n0"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n3"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n4"}]},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b10n0"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b12n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b12n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b12n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b13n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b13n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b13n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n0"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n1"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n10"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n6"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n4"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n5"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n0"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n1"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n10"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n4"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n5"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n7"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n8"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n9"}]},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n7"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n8"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b14n9"},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b15n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b15n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b15n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b16n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n3"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n0"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b18n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n3"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n0"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Med dataprodukten Rastplatser avses sidoanläggning för trafikanters behov av vila, toalettbesök, rekreation eller dylikt, som uppfyller riktlinjerna beskrivna på \"Informationssida: Vägar och gators utformning (VGU)\" under Dokumentation.\n\nDataprodukten Rastplatser är fältinventerade sommar 2023 och 2024. Ny och uppdaterad information har lagts till för att bättre möte trafikanters och Väghållarens behov. Rastplatsernas utrustning eller utformning beskrivs m.h.a. attributen som innehåller information om bl.a. antal parkeringsplatser samt för vilket fordon, skötselansvarig, antal bord med sittplatser, tillgång till toalett samt om det finns lekutrustning eller latrintömning.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet,  se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b20n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b21n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b22n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n3"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n0"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b23n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b24n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n3"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n0"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b26n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b27n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b27n3"}},{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b27n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0d8bce30b16a4b52964f2cbbdd1f05c9f9fe3c23300a70b5e95c116bc4aaddce_b27n2"},"http://www.w3.org/