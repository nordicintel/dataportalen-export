cat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1265"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1420"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1421"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1422"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1423"},{"@id":"https://metadata.trafikverket.se/store/1/resource/794"},{"@id":"https://metadata.trafikverket.se/store/1/resource/892"}],"dcat:keyword":[{"@language":"sv","@value":"NVDB"},{"@language":"sv","@value":"område: transport"},{"@language":"sv","@value":"trafikslag: väg"},{"@language":"sv","@value":"väghållare: enskild"},{"@language":"sv","@value":"väghållare: kommunal"},{"@language":"sv","@value":"väghållare: statlig"},{"@language":"sv","@value":"vägtrafiknät: bilnät"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=629&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"C-Recommended Road for Bicycle Traffic"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2007-08-13"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten består av företeelsetypen C-Rekommenderad bilväg för cykeltrafik som tillhör produktgruppen NVDB-GCM.Dataprodukten omfattar data om rekommenderad bilväg för cykeltrafik som skapar kontinuitet i cykelnätet genom att peka ut lämpliga vägar i bilnätet för cykeltrafik. Dataprodukten kan enbart anknytas till bilnätet, d v s de vägsträckor där vägtrafiknät är angivet som ”Bilnät”, se referens #5 i DPS - Dataproduktspecifikation - \"Det svenska vägnätet\".\n\nSyftet med dataprodukten är att t ex i en cykelreseplanerare leda cykeltrafiken till de gator som är mest lämpade för cykeltrafik ur trafiksäkerhetssynpunkt eller av annat skäl."},"dct:identifier":"751fe083-551c-4d5d-a881-631d4ea5dc05","dct:issued":{"@type":"xsd:date","@value":"2007-08-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:d7ae4f486a3e060ef6b917ccf608ec84a70a79fda33a5266db7f40069e1ec3b4_b12n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d7ae4f486a3e060ef6b917ccf608ec84a70a79fda33a5266db7f40069e1ec3b4_b13n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:d7ae4f486a3e060ef6b917ccf608ec84a70a79fda33a5266db7f40069e1ec3b4_b14n0"},"dct:title":{"@language":"sv","@value":"C-Rekomenderad bilväg för cykeltrafik"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1020C-Rekommenderad%20bilv%C3%A4g%20f%C3%B6r%20cykeltrafik.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bransch.trafikverket.se/anv