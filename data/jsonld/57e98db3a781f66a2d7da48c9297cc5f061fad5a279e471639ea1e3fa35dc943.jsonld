nguage":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://lastkajen.trafikverket.se/aboutdatarailway","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Detaljerad information om dataprodukten inklusive källdata från datakatalog"},"dct:title":{"@language":"sv","@value":"Lastkajen: Läs om våra järnvägsdata"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1045","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1123"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1201"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1383"}],"dcat:keyword":[{"@language":"en","@value":"StJDB"},{"@language":"sv","@value":"StJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1045&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Railway Data - Rail Cross"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-01-09"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Ett spårkors är en växeltyp där spåren korsar varandra i samma plan. Spårkorset har inga rörliga delar och det finns ingen möjlighet att byta/växla spår.\n\nEtt spårkors ses funktionellt som en växeltyp men datamässigt saknar den spårväxelns funktion som nod i referensnätet.\n\nDataprodukten har punktutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod och närmast föregående kilometertavla, med avstånd i meter i spårlänkens riktning. Läget för spårkorset anges för spårkorsets tänkta mittpunkt."},"dct:identifier":"7bc2d1b7-1a4a-4faf-bd87-b82e9284a46a","dct:issued":{"@type":"xsd:date","@value":"2013-01-09"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:95c1b76c82356a9a66fa5f52d5a4ae4d09d3e2f83daa3471803fa20c4f1c7951_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:95c1b76c82356a9a66fa5f52d5a4ae4d09d3e2f83daa3471803fa20c4f1c7951_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:95c1b76c82356a9a66fa5f52d5a4ae4d09d3e2f83daa3471803fa20c4f1c7951_b2n0"},"dct:title":{"@lan