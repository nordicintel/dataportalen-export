älva järnvägsnätet."}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n3"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n0"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea530512902427d1e97607d258a77_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:a6d5147b59c79b36972ef1010e155921571ea