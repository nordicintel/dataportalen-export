aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b9n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/contentassets/50e12058cb4747ea9809b2ffa8c3dbe2/data-i-pmsv4-extern-aktualitet-och-ursprung.pdf","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som beskriver PMS: en extern applikation som presenterar information om tillstånd och åtgärder på statliga vägar. PMS extern är tillgängligt för alla, utan att behöva nån speciell behörighet."},"dct:title":{"@language":"sv","@value":"Informationsdokument: Data i PMS extern – aktualitet och ursprung"}},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med presentation av dataprodukspecifikationer."},"dct:title":{"@language":"sv","@value":"Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/for-dig-i-branschen/vag/information-om-statliga-vagar-verktyget-pmsv4/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Webbsida med länkar till vidare information om verktyget PMS."},"dct:title":{"@language":"sv","@value":"Informationsida: Om statliga vägar - verktyget PMS"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1618","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/22"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1619"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1620"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1621"}],"dcat:keyword":[{"@language":"en","@value":"road - pavement information"},{"@language":"sv","@value":"väg - beläggningsinformation"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"sv","@value":"Mätdata 100m  - Vägbeläggningsrelaterade data från PMS systemen"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Mätdata per 100 meter för vägytan på statliga belagda vägar. Trafikverket beställer vägytemätningar årligen eller vartannat år (beroende på trafikmängd). Datum för när mätvärdet är ifrån samt värdena för måtten IRI (höger), spårdjup (höger), spårdjup15, spårdjup17, kantdjup, MPD makrotextur för statliga belagda vägar. Ett medelvärde har räknats fram för 100 meter baserat på de ingående 20-metersvärdena (se mer info i MeasurementData20). Observera att det inte finns 100-metersdata för alla våra 20-metersvariabler. \n\nKällsystem är PMS-systemen (pavement management systems). Se gärna mer info i applikationen PMSv4.\n\nI API:et tillhandahålls endast senaste gällande data för respektive väg. \n\nLastkajen har filer för både senast gällande data och filer där all mätdatahistorik finns för nu gällande vägnät. \n\nObservera att det kan finnas glapp, dvs att mätdata saknas, i datat längs en väg. Orsaker är oftast att vägnätet förändrats (i NVDB) för vägsträckan och ingen ny mätning samt ingen beläggningsåtgärd har rapporterats för sträckan. Om det finns åtgärd rapporterad på en sådan ändrad sträcka, utan ny mätning, hämtas ett schablonmätvärde baserat på tabeller för tillstånd på ny beläggning (för den vägtypen per län). (INFO: NVDB:s vägnät används som grund för allt PMS-data och vi kopplar in vårt mätdata mot det nätet)."},"dct:issued":{"@type":"xsd:date","@value":"2019-03-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":{"@language":"en","@value":"MeasurementData 100 - Pavement related data from Pavement-systems"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/50e12058cb4747ea9809b2ffa8c3dbe2/data-i-pmsv4-extern-aktualitet-och-ursprung.pdf"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/for-dig-i-branschen/vag/information-om-statliga-vagar-verktyget-pmsv4/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://pmsv4.trafikverket.se/about-vars"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/966"}],"http://entryscape.org/terms/metadataIdentifier":"f492a5e9-0f07-4b8d-b446-8c806ac77424","https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/APIArea/api-public"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1619","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"http://lastkajen2-p.trafikverket.local/productpackages/10125"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Datapaket för vägbeläggning.  Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst. \n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning i Lastkajen - Datapaket för Data om vägbeläggning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1620","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},"dcat:accessURL":{"@id":"https://data.trafikverket.se/documentation/datacache/data-model?namespace=Road.PavementInfo&collection=MeasurementData100"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Information"},"dct:description":{"@language":"sv","@value":"Visning av datat i Datautbytesportalen - API Öppna Data.\n\nOBS: Om du vill hämta data behöver du registrera ett konto. Du behöver en e-postadress och godkänna licensen för att registrera ett konto."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"MeasurementData 100  - visning/nedladdning i öppna API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1621","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/966"},"dcat:accessURL":{"@id":"https://pmsv4.trafikverket.se/"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Information"},"dct:description":{"@language":"sv","@value":"Här visas data för statliga vägar - beläggnings- och avvattningsåtgärder, mätta och beräknade tillstånd tillsammans med ett urval av vägdata. Det kan ses i kartor, tabeller eller diagram."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"PMSv4 - visning av beläggnings- och avvattningsåtgärder"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b2n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-o