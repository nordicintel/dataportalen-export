8641"}],"dct:title":{"@language":"sv","@value":"Datautbytesportalen"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/transformation"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:bf38784e4606e4c957ca87242f33781284b96fd806c2f7a0a3e1b1bf7a686901_b3n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:bf38784e4606e4c957ca87242f33781284b96fd806c2f7a0a3e1b1bf7a686901_b4n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - STRESS förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:stress-forvaltning@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:bf38784e4606e4c957ca87242f33781284b96fd806c2f7a0a3e1b1bf7a686901"},{"@graph":[{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/image":{"@id":"https://metadata.trafikverket.se/store/233/resource/5"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten skall beskriva det årtal då vägens överbyggnad och underbyggnad färdigställdes i den sträckning som fortfarande gäller (se Bild 1). \n\n- Dataprodukten beskriver det årtal som en nybyggnad färdigställdes på en vägsträcka. \n- Beskrivs som en sträckutbredning på vägnätet. \n- Nybyggnadsobjektets ID-nummer skall alltid anges efter 2010-02-01. \n- Nybyggnadsår kan anges för arbeten utförda efter 1890. Om årtalet är okänt anges årtalet 9999. \n- Företeelser av typen Vägnybyggnad ska anges på allt nytt vägnät som är levererat inom statliga vägnybyggnadsobjekt oavsett väghållare. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n0"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n1"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n10"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n6"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n4"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n5"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n0"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n1"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n10"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n4"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n5"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n7"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n8"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n9"}]},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n7"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n8"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b10n9"},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b12n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Har initialt laddats genom konvertering från en sammanslagning av två avslutade företeelsetyper, Vägförstärkning och Vägnybyggnad som har ajourhållits sedan 2001. Den historiska informationen om vägars ålder har samlats in under 2001 genom regionala källor, främst genom lokalkännedom.\n\nAjourhålls med underlag från Trafikverkets verksamhet för nybyggnad/ombyggnad av det statliga vägnätet."}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b13n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b14n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b15n3"}},{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62a213_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c08ab736b2148629ba075611b131d726955c0691115205e72321c14f8f62