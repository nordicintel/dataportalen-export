adata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f88a4f2b4d6b277b4cfa523b791a1b65f79884823ee05162f0435152d24c2664_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f88a4f2b4d6b277b4cfa523b791a1b65f79884823ee05162f0435152d24c2664_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:f88a4f2b4d6b277b4cfa523b791a1b65f79884823ee05162f0435152d24c2664"},{"@graph":[{"@id":"_:f90bc4b1dc840a7ca749a038772f747f90fbaa60e40ef173c162f48f2634ffd1_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Dataprodukter för järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet."}},{