ndlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet."}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n3"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n0"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:d79ee8c6f44b7c3fc4af713a0a277de5ed68bf5fb383bef3f12f7cf76cad8989_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.