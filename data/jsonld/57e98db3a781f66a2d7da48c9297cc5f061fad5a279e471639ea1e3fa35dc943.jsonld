iskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:e8264f8061fd51151001ced73e527c3ab614813ebb462199cb4b144e458dc1c3"},{"@graph":[{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n3"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n0"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b1n3","@type":"http://www.w