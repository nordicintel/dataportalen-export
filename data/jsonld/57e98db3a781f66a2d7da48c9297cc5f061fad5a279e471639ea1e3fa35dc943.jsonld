b4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b27n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},{"@id":"https://metadata.trafikverket.se/store/1/resource/965"}]},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b27n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b27n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b28n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n3"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n0"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b29n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n0"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n3"},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n4"}]},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b2n0"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b30n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b31n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b31n3"}},{"@id":"_:ab4490519