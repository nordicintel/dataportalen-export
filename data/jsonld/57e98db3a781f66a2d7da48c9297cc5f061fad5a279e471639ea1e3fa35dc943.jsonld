/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b10n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n3"}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n0"}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:b520eb26c57b58f86d0f34de56372258df77d8b38f900a1bdd5cb8610e171f04_b11n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa