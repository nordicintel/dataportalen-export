0285ef03ec44969c_b1n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:36c01f25203029b579201cc64ea35fbd3d889214dc2f1dc90285ef03ec44969c_b2n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1052","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-ri.trafikverket.se/MapService/wms.axd/Riksintressen"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1052&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":[{"@language":"en","@value":"National Interests for the Facilities of the Modes of Transport - View Service"},{"@language":"sv","@value":"Riksintressen för luftfart, järnväg, sjöfart och väg"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2011-07-12"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller riksintressena för trafikslagens anläggningar (flyg, järnväg, sjöfart och väg). Såväl befintliga som planerade och framtida riksintressen redovisas.\n\nDe tidigare fyra trafikverken, numera Trafikverket, har under hösten 2009 och våren 2010 arbetat med en trafikslagsövergripande översyn av riksintressen. I juli 2010 beslutade Trafikverket om riksintressen för trafikslagens anläggningar. Det beslutet har reviderats och ett nytt beslut om riksintressen för trafikslagens anläggningar har tagits 20 februari 2013. Det innebär att tidigare utpekanden av riksintressen som har gjorts av Vägverket, Banverket, Sjöfartsverket och Luftfartsstyrelsen inte längre gäller.\n\nI dagsläget kan inte tjänsten producera en teckenförklaring. Tillsvidare tillhandahålls en separat teckenförklaring på följande adress: http://www.trafikverket.se/PageFiles/14982/teckenforklaring_wms_ri_trafikslagens_anl.pdf."},"dct:identifier":"0791b2c7-5eb0-4a66-aa95-717a7c2ccdf5","dct:issued":{"@type":"xsd:date","@value":"2011-07-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2013-02-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:36c01f25203029b579201cc64ea35fbd3d889214dc2f1dc90285ef03ec44969c_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoCatalogueService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Trafikverket - WMS riksintresse trafikslagens anläggningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"5344336b-1923-40c1-bd24-21617e32a390","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:36c01f25203029b579201cc64ea35fbd3d889214dc2f1dc90285ef03ec44969c_b1n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road-ferry"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:36c01f25203029b579201cc64ea35fbd3d889214dc2f1dc90285ef03ec44969c_b2n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:36c01f25203029b579201cc64ea35fbd3d889214dc2f1dc90285ef03ec44969c"},{"@graph":[{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n0"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n1"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n10"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n6"}},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n4"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n5"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n0"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n1"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n10"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n4"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n5"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n7"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n8"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n9"}]},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n7"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n8"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b10n9"},{"@id":"_:384070568124581e3743629f3e5f351b65a9a4adca5b56d254b018365f663abb_b11n0","@type":"