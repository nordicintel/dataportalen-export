DB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:17c62f164b0149a30dea355da7b3a416c6042cdba9c58a8f9cbb5fc573b44bda"},{"@graph":[{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n3"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n0"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b2n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Materialet är vektor-data och bygger på information från Trafikverkets brodatabas (Batman) där man teoretiskt räknat fram barriärer, passager och effektområden utifrån bestämda kriterier som trafikvolym, utformning m.m."}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b4n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n3"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n0"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b6n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1148","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/10177"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Datamängd gällande Barriärkartor större däggdjur. Dataprodukten finns i det färdiga paketet: Barriärkartor. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Barriärkartor större däggdjur - nedladdning i Lastkajen/Barriärkartor"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/lastkajen"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_b79e35eb"},{"@id":"http://data.europa.eu/bna/c_e1da4e07"}],"http://entryscape.org/terms/metadataIdentifier":"f9489872-7415-4c6b-a46a-7929235d4983","http://www.w3.org/ns/adms#identifier":"Lastkajen.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b1n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/976","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:distribution":{"@id":"https://metadata.trafikverket.se/store/1/resource/1148"},"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=976&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:alternative":{"@language":"en","@value":"Movement Barrier Maps - Larger Mammals"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2022-01-26"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Detta paket innehåller barriärkartor för väg- och järnväg inkl. potentiella passager för större däggdjur. Detaljer om barriärkartorna för större däggdjur finns i följande rapport: \nhttp://trafikverket.diva-portal.org/smash/get/diva2:1364535/FULLTEXT01.pdf\n\nPaketet innehåller både vektor-data (geopackage) och en gemensam lyr-fil för Esri användare  och en stil-fil för Qgis-användare. Öppna lyrfilen (\"Barriaranalys.lyr\") i ARCGIS för att läsa in alla datalager med föreslagen layout. I Qgis startar du Qgis och drar in stilfilen så startar den med rätt symbologi. \n\n\nInnehåll\n---------------------------\nAlla lager ligger i en gemensam geopackage-fil som heter Barriaranalys.gpkg. I denna finns följande geopackagelager:\n\n1) \"Barriaranalys_2024.lyr\" läser in alla övriga lager och styr layouten av kartorna (bör öppnas först om du använder Esri)\n\n2) \"Barriaranalys_2024_qgis.qlr\" läser in alla övriga lager och styr layouten av kartorna (bör öppnas först om du använder Qgis)\n\n3) Effektområde för potentiella passager vid väg \"Effektomrade_passager_vag\" = Cirklar som illustrerar passagernas teoretiska, barriärupplösande effektavstånd. Detta avstånd kan vara 500, 1000, 1500 eller 2000 meter beroende på hur hög funktionalitet passagen potentiellt bedöms kunna uppnå.\n\n4) Vägbarriärsträckor: \"Barriarer_vag_oklippt\" = Vägsträckor som utgör barriärer enligt ett antal kriterier.\n\n5) Kvarvarande vägbarriär: \"Barriarer_kvarvarande_vag\" = De vägbarriärsträckor som kvarstår efter att sträckor innanför passagers effektavstånd och inom tätorter har uteslutits.\n\n6) Effektområde för potentiella passager vid järnväg: \"Effektomrade_passager_jvg\" = Cirklar som illustrerar passagernas teoretiska, barriärupplösande effektavstånd. Detta avstånd kan vara 500, 1000, 1500 eller 2000 meter beroende på hur hög funktionalitet passagen potentiellt bedöms kunna uppnå.\n\n7) Järnvägbarriärsträckor: \"Barriarer_jvg_oklippt\" = Järnvägssträckor som utgör barriärer enligt ett antal kriterier.\n\n8) Kvarvarande järnvägsbarriär: \"Barriarer_kvarvarande_jvg\" = De järnvägsbarriärsträckor som kvarstår efter att sträckor innanför passagers effektavstånd och inom tätorter har uteslutits.\n\n9) Potentiella passager 2024: \"Potentiella_passager_2024\" = Passager på barriärsträckor med potential för passager. Dessa inkluderar alla passageplatser som använts för att skapa skikt 3 och 6 samt de passageplatser som bedömts ha en funktion under 10 % men som inte exkluderats i urvalsprocessen.   \n\n9) Tätortsbuffert: \"Tatorter_50mBuffert\" = Tätortsskikt från SCB med en buffert på 50 meter."},"dct:identifier":"a082f306-82ab-4d8b-b64f-9829c65c62d7","dct:issued":{"@type":"xsd:date","@value":"2022-01-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-05"},"dct:provenance":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b3n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b4n0"},"dct:title":{"@language":"sv","@value":"Barriärkartor - större däggdjur"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"http://entryscape.org/terms/metadataIdentifier":"cd569057-4b96-4c98-8d59-fe7b859ccd60","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b5n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/CM_DataPackagesAndSpecialProducts"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/cross-modal-data-products"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31_b6n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:184407bf093f03fdb9df39da363200b36e87c1a706bf4ef147b9f444ad22ff31"},{"@graph":[{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n0"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n1"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n10"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n6"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n4"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n5"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n0"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n1"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n10"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n4"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n5"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n7"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n8"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n9"}]},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n7"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n8"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b10n9"},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17c5e3235ff7fc15_b13n3"}},{"@id":"_:1bd4bcc4bb979166a2571e2f0077e2770a40a8ccec6723fa17