:[{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Data har initialt laddats från äldre databaser eller initial inventering. Underlag för ajourhållning fångas hos Trafikverkets verksamhet för underhåll av statliga vägar eller investeringsverksamhet för nya statliga vägar.\n\nInformation om tillkomst lagras på objektsnivå.\n\nKrav på datakvalitet varierar med typ av vägnät och delas upp i kvalitetskravklasser. Ett exempel på detta är att kraven är högre för motorvägar än för skogsbilvägar. Kvalitetskravklasserna beskrivs jämte kraven i dataproduktspecifikationerna för NVDB."}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n3"}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n0"}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4ced9eb27f9fd4_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7d7752aa660e83572525f21aa90259acec3a0a591c096003aa4c