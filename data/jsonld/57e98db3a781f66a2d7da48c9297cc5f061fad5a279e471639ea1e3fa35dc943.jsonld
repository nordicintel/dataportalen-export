UBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://datex2.eu/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Öppet API: Datamängden innehåller Information om position av rastplatser och parkeringar. Det finns även information om rastplatsen är stängd eller öppen och utrustning på rastplatsen såsom toaletter, handikapptoaletter, lekutrustning.\n\nDatex II: Datamängden för metadata prk:hierarchyElementGeneral innehåller information om rastplatser och dess utrustning som t ex handikappanpassningar, toaletter, lekplats, rastplatsmöbler, latrintömning m.m. samt antal parkeringar för bilar och lastbilar som tillhandahålls av Trafikverket. Datamängden för dynamisk data prk:parkingStatusInformation innehåller information om rastplatsen är öppen eller stängd."},"dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:9f9b24aa51b5c390a2d063d84baf182b2859aa6c051624c51cc2016188add9a4_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:9f9b24aa51b5c390a2d063d84baf182b2859aa6c051624c51cc2016188add9a4_b3n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":[{"@language":"en","@value":"Parking"},{"@language":"sv","@value":"Parking"}],"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id