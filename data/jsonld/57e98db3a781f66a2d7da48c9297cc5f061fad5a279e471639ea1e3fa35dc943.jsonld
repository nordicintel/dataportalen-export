value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med presentation av dataprodukspecifikationer."},"dct:title":{"@language":"sv","@value":"Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://data.trafikverket.se/documentation/datex/situation","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Sida för beskrivning av datamängden situation (trafiksituation) i Datex II."},"dct:title":{"@language":"sv","@value":"Informationssida: Beskrivning av situation (trafiksituation) i Datex II"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1641","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/23"},"dcat:distribution":{"@id":"https://metadata.trafikverket.se/store/1/resource/1643"},"dcat:keyword":[{"@language":"en","@value":"road - traffic information"},{"@language":"sv","@value":"väg - trafikinformation"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Normativ väderinformation samt metadata från respektive vägväderstation, sju dagar tillbaka. \n\nDatamängden innehåller information om väderläget längs vägarna baserat på rapporter från automatiska vägväderstationer. Innehåller data om luft- och yttemperatur, nederbörd, vindriktning och vindhastighet. \n\nI datamängden roa:measurementSite innehåller information om mätvärdesindex och mätpostens positioner.\n\nVad källsystemet levererar är beroende av vilken utrustning mätstationen har och det kan förändras över tid."},"dct:issued":{"@type":"xsd:date","@value":"2022-09-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:provenance":{"@id":"_:6cbd21eca59da113f0d685ad4185db0c2bd69b50543df24a9580dd3d957d35fe_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:6cbd21eca59da113f0d685ad4185db0c2bd69b50543df24a9580dd3d957d35fe_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":[{"@language":"en","@value":"WeatherObservation"},{"@language":"sv","@value":"WeatherObservation"}],"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://data.trafikverket.se/documentati