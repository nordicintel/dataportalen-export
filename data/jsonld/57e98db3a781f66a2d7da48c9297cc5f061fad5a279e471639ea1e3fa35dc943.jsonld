/prov#hadPlan":{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n3"}},{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n0"}},{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b9n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med dataprodukter inom järnväg"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra järnvägsdata"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1035","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1115"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1183"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1373"}],"dcat:keyword":[{"@language":"en","@value":"StJDB"},{"@language":"sv","@value":"StJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1035&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"en","@value":"Railway Data - Cant"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-01-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Rälsförhöjningar anordnas normalt i cirkulär- och övergångskurvor i spåret så att ytterrälen ligger högre än innerrälen. De syftar till att minska sidokraften som uppstår i kurva. Rätt utformade rälsförhöjningar leder till högre komfort för passagerare, högre hastigheter i kurva och lägre underhållskostnader för spår och fordon.\n\nÖkning och minskning av rälsförhöjningen ska ske med hjälp av rälsförhöjningsramper.\n\nRälsförhöjning ingår som ett spårelement i beskrivningen av spårgeometrin och är en del av plangeometrin, som även omfattar cirkulärkurvor, raklinjer och övergångskurvor.\n\nDataprodukten innehåller rälsförhöjningens storlek i geometrielementets start- och slutpunkter (=tangentpunkterna) och anges i millimeter. Rälsförhöjningen anges positiv då ytterrälen är högre än innerrälen och negativ då innerrälen är högre än ytterrälen (s.k. negativ rälsförhöjning). För övergångskurvor är även typ av ramp specificerat. Typ av ramp är rak eller svängd. Rak ramp är den vanligaste typen och används normalt för att ändra rälsförhöjningen genom en övergångskurva av typen klotoid. Svängd ramp används tillsammans med svängda övergångskurvor i befintliga spår men nyanläggs inte.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod och närmast föregående kilometertavla med avstånd i meter till både start- och slutläget på cirkulärkurvan (=tangentpunkterna) i spårlänkens riktning."},"dct:identifier":"3311eccb-ffd9-44d8-925a-81a5ffad0c46","dct:issued":{"@type":"xsd:date","@value":"2013-01-22"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:b6d4c421f1d2e1bd279183022fb3aee9b074f20396fe1fc13749ed8ce956e15e_b2n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Rälsförhöjning"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/958"},{"@id":"https://metadata.trafikverket.se/store/1/resource/960"}],"http://entryscape.org/terms/metadataIdentifier":"cc48850f-3750-4d71-b610-bd94194c342c","http:/