E2021006297"},"dct:description":{"@language":"sv","@value":"Tittskåpstjänst där man kan titta på och göra filtreringar av järnvägsdata."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b2n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NJDB på webb"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"a4430f27-339d-4abc-b29d-4d2b2e46f7dc","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b3n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/987","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1087"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1151"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1331"}],"dcat:keyword":[{"@language":"en","@value":"StJDB"},{"@language":"sv","@value":"StJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=987&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"en","@value":"Railway Data - Fastener"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-08-02"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Befästning är ett begrepp för den förankring som görs av räl mot slipers. Befästningen har flera syften:\n- Överföra krafter från rälen till slipern.\n- Säkra spårvidden så att rälen inte flyttar sig.\n- Minska buller genom att dämpa rälens vibrationer mot slipern.\n- Förhindra böjning i sidled (solkurvor).\n- Isolera rälen mot slipern (jord) om rälen ingår i en spårledning.\n- Underlätta montering av räl.\n\nDet finns olika typer av befästningar som används vid olika typ av slipers, underlag eller på olika platser i spåret, t ex i växlar.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod och närmast föregående kilometertavla med avstånd i meter till både start- och slutläget på sträckan i spårlänkens riktning."},"dct:identifier":"66a8c965-8b0e-4f71-8d41-f9da75c7784b","dct:issued":{"@type":"xsd:date","@value":"2012-08-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b6n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b7n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b8n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Befästning"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/958"},{"@id":"https://metadata.trafikverket.se/store/1/resource/960"}],"http://entryscape.org/terms/metadataIdentifier":"e99a57bc-9aa7-4792-94d6-930c93c41cf8","http://schema.org/image":{"@id":"http://geo-baninfo.trafikverket.se/MapService/wms.axd/BanInfo_1_5?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Befastning&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"},"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b9n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RW_StateRailwayNetworkDataStJDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/StJDB_PhysicalObjects"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b10n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:d266712615f13f5e9f4266f9ffdf48196397da908b9ba74ba3416c47613fad36"},{"@graph":[{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Befintliga trafikregler samlas i Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). Dataprodukten avser högsta tillåtna hastighetsgräns och kan vara en följd av den allmänna hastighetsgränsen i trafikförordningen, för närvarande 50 km/tim inom tättbebyggt område och 70 km/tim utanför samt 110 km/tim på motorväg. Gågata och gångfartsområde ska ha gångfart. Hastighetsgräns kan även vara en följd av föreskrift om högre hastighet än 70 km/tim utanför tättbebyggt område beslutad av Trafikverket. Till sist kan hastighetsgränsen vara en följd av lokal trafikföreskrift meddelad av kommun eller länsstyrelse. \n\nI förekommande fall ska avvikande hastighetsgräns registreras och under vilket tidsintervall den gäller. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n0"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n1"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n10"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n6"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n4"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n5"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n0"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n1"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n10"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n4"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n5"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n7"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n8"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n9"}]},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n7"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n8"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b10n9"},{"@id":"_:d378039e106a3d964f50083f09dca459ea29cde9beaaea69bc3f099f775238b7_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.s