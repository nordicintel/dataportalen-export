11-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"GeoPackagefiler som redovisar riksintressena för trafikslagens anläggningar (luftfart, järnväg, sjöfart och väg). Såväl befintliga som planerade och framtida anläggningar av riksintresse redovisas. Trafikverkets senaste beslut om riksintressen är från 2022-09-26. Det kan förekomma förändringar i beslutet som inte har fått genomslag i kartmaterialet. Det rör främst planerad eller framtida anläggning, där korridorer kan ha justerats som en konsekvens av planeringsprocessen.\n\nFör kontroll av status i ett enskilt objekt hänvisas till Trafikverket."},"dct:identifier":"a9950f07-ffe6-41d7-80a6-0cd8fed01034","dct:issued":{"@type":"xsd:date","@value":"2019-03-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b2n0"},"dct:title":{"@language":"sv","@value":"Trafikverket - riksintressen för trafikslagens anläggningar"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/1052"},"http://entryscape.org/terms/metadataIdentifier":"bc6e01e4-0c11-4724-a753-968d645468a8","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"},"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1052","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-ri.trafikverket.se/MapService/wms.axd/Riksintressen"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1052&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":[{"@language":"en","@value":"National Interests for the Facilities of the Modes of Transport - View Service"},{"@language":"sv","@value":"Riksintressen för luftfart, järnväg, sjöfart och väg"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2011-07-12"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller riksintressena för trafikslagens anläggningar (flyg, järnväg, sjöfart och väg). Såväl befintliga som planerade och framtida riksintressen redovisas.\n\nDe tidigare fyra trafikverken, numera Trafikverket, har under hösten 2009 och våren 2010 arbetat med en trafikslagsövergripande översyn av riksintressen. I juli 2010 beslutade Trafikverket om riksintressen för trafikslagens anläggningar. Det beslutet har reviderats och ett nytt beslut om riksintressen för trafikslagens anläggningar har tagits 20 februari 2013. Det innebär att tidigare utpekanden av riksintressen som har gjorts av Vägverket, Banverket, Sjöfartsverket och Luftfartsstyrelsen inte längre gäller.\n\nI dagsläget kan inte tjänsten producera en teckenförklaring. Tillsvidare tillhandahålls en separat teckenförklaring på följande adress: http://www.trafikverket.se/PageFiles/14982/teckenforklaring_wms_ri_trafikslagens_anl.pdf."},"dct:identifier":"0791b2c7-5eb0-4a66-aa95-717a7c2ccdf5","dct:issued":{"@type":"xsd:date","@value":"2011-07-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2013-02-20"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoCatalogueService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Trafikverket - WMS riksintresse trafikslagens anläggningar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"5344336b-1923-40c1-bd24-21617e32a390","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road-ferry"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/1211","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/1052"},"dcat:accessURL":{"@id":"https://geo-ri.trafikverket.se/MapService/wms.axd/Riksintressen"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Trafikverket - riksintressen för trafikslagens anläggningar - visning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2439","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.trafikverket.se/portal/apps/mapviewer/index.html"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},"dct:description":{"@language":"sv","@value":"Visning av datat med denna egenskap i Trafikverkets GIS-portal.\n\nOBS: För åtkomst/visning, klistra in åtkomstadresslänken i webbläsaren. Välj sedan egenskapen som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Riksintressen - visning i Trafikverkets GIS-portal"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2440","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gis.trafikverket.se/portal/apps/webappviewer/index.html?id=23fbe09f27fb4fd79769deef9300a1a5"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},"dct:description":{"@language":"sv","@value":"Visning av datat med denna egenskap i Trafikverkets GIS-portal.\n\nOBS: För åtkomst/visning, klistra in åtkomstadresslänken i webbläsaren. Välj sedan egenskapen som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Riksintressen - visning i Riksintressen"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e_b6n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:9a3daf3d32e03189ed26118708878e1b0ca970092aa8271412f40fb35472ca6e"},{"@graph":[{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n0"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n1"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n10"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n6"}},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n4"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n5"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n0"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n1"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n10"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n4"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n5"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n7"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n8"},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c_b10n9"}]},{"@id":"_:9abc3e41d10c3ca4f4335fad2be48aa4e