n","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:960f7dbfcbc27d623714459aad2248e485d972b31c87dfa0863e24fd64d2fd95"},{"@graph":[{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från Trafikverket internt."}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n0"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n1"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n10"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n6"}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n4"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n5"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n0"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n1"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n10"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n4"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n5"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n7"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n8"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n9"}]},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n7"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n8"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b10n9"},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:968665d73d3fdb64a3774e1305601d732112c2f8a3bac25c8704771e7cae5214_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:968665d73d3fdb64a3774e