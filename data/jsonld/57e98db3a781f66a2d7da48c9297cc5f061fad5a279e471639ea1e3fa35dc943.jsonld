https://data.trafikverket.se/search/search-data/details?esc_entry=1061&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Railway Data - Board (mainly ATC)"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-07-26"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten består av Tavla (främst ATC) och beskriver de tavlor som är relaterade till ATC.\n\nMed ATC övervakas tågets hastighet och framförande. Om tågföraren överskrider de gränser som signaleras av balisgrupperna tar ATC över (sänker hastigheten t e x).\n\nInformation till tågföraren via optiska signaler och tavlor kan finnas i alla spår oavsett om de är ATC-kontrollerade eller inte.\n\nRelaterade objekttyper:\n- Relaterade objekttyper är Tavla (ej ATC) samt Signal (ej ATC)."},"dct:identifier":"b55acfeb-5ba6-4db2-b02e-0f4c12e5296b","dct:issued":{"@type":"xsd:date","@value":"2012-07-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:d63d6a9d858a0ee0fe164c62a42421f0787b7708c5c73d2e59c605c99de4b851_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d63d6a9d858a0ee0fe164c62