#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Tjäldjup och väderstationer","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:vvisarenden@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:7bd30f49d12690caafe64115cf11d1cf7c10c79bd003db2ec96683e69145338a"},{"@graph":[{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n0"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n1"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n10"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n6"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n4"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n5"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n0"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n1"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n10"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n4"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n5"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n7"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n8"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n9"}]},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n7"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n8"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b10n9"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org