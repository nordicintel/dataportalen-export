ataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides ferry routes operated by the Swedish Transport Administration (Trafikverket), according to the INSPIRE Transport Network (TN) specification for WaterwayNode and FerryCrossing. It is generated from the following road data products:\n•\tFerry route / Färjeled"},{"@language":"sv","@value":"Datamängden redovisar färjeleder som trafikeras av Trafikverkets färjerederi. Datamängden omfattar objekttyperna Waterway node och Ferry crossing, som båda genereras ur färjeled i den nationella vägdatabasen (NVDB)."}],"dct:identifier":"53b0c0ae-89cf-4532-8ba7-fc69cdd760fc","dct:issued":{"@type":"xsd:date","@value":"2018-11-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-28"},"dct:provenance":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b6n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b7n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b8n0"},"dct:title":{"@language":"en","@value":"Water Transport Network (INSPIRE)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_E-G/1015F%C3%A4rjeled.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa