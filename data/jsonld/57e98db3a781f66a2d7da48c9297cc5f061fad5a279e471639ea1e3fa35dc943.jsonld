n":[{"@id":"https://metadata.trafikverket.se/store/1/resource/475"},{"@id":"https://metadata.trafikverket.se/store/1/resource/570"},{"@id":"https://metadata.trafikverket.se/store/1/resource/596"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=260&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Vägnod"},{"@language":"sv","@value":"Vägnät - Vägnod (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the road node, according to the INSPIRE Transport Network (TN) specification for RoadNode. It is generated from the following road data products:\no\tReference node / \no\tIntersection / Korsning\no\tRoundabout \no\tRest area / Rastplat\no\tRailway crossing\n."},{"@language":"sv","@value":"Datamängden redovisar noder i vägnätet enligt Inspiretema transportnät (TN) RoadNode. RoadNode är genererad ur från följande vägdataprodukter: \n- Referensnod \n- Korsning \n- Cirkulationsplats \n- Rastplats \n- Järnvägskorsning \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"5dfd14ee-e013-4d55-b5a0-82068da0a408","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-28"},"dct:provenance":{"@id":"_:c4d6cae8f4899866c673fb5e9e7550a3ada904d285f68c8b4213853f565787d4_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:c4d6cae8f4899866c673fb5e9e7550a3ada904d285f68c8b4213853f565787d4_b19n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:c4d6cae8f4899866c673fb5e9e7550a3ada904d285f68c8b4213853f565787d4_b20n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Road Node (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1040cirkulationsplats.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_H-K/1075Korsning.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_L-R/1050rastplats.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"h