n Line (PlfrPlti)"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2016-12-13"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Spårsträcka mellan två intilliggande platser. Med plats avses trafikplatser av typerna driftplatser utan driftplatsdelar, driftplatsdelar och linjeplatser. För icke statligt nät kan platser också utgöras av stationer och hållplatser."},"dct:identifier":"0b8acc3b-1f7a-494c-9a03-3f4e29e2c771","dct:issued":{"@type":"xsd:date","@value":"2016-12-13"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:0627fddf2a84c2d7005f67de17893d03a5e8dd0ecd73868352961283b537ac98_b6n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:0627fddf2a84c2d7005f67de17893d03a5e8dd0ecd73868352961283b537ac98_b7n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:0627fddf2a84c2d7005f67de17893d03a5e8dd0ecd73868352961283b537ac98_b8n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Förbindelselinje (PlfrPlti)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/dat