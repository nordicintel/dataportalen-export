02bec0a4c277082_b17n0"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b18n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. \n\nMappningen mellan Inspire OwnerAuthority och Trafikverkets vägdata är fullständig. \n\nOwnerAuthority är genererad ur från följande vägdataprodukter:\n- Väghållare"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b19n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b20n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n2"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n0"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b21n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b22n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b22n3"}},{"@id":"_:b494