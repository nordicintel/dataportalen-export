"dct:subject":{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från datakällan."}},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n0"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n1"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n10"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n6"}},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n4"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n5"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n0"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n1"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n10"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n4"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n5"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n7"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n8"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n9"}]},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n7"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n8"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b10n9"},{"@id":"_:ea71a03d0ddf83bdf03ba623a5711fa94403357f8fac72b0f0b7a10e9e2c8bea_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@i