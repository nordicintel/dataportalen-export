mpningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WFS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"INSPIRE-compliant download service for road transport network datasets from the Swedish Transport Administration. \nAll INSPRE datasets from the Swedish Transport Administration are  also available for  downloaded as pre-generated GeoPackage files via Lastkajen - the Swedish Transport Administration's service for downloading file-based geodata."},{"@language":"sv","@value":"WFS-tjänst för vägdata enligt INSPIRE-direktiv. För användning i applikationer. Används i tillämpningar internt och externt för att visa vägdata på karta. \n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara."}],"dct:identifier":"a3e0b2ae-7869-4ece-8a18-5b27737ebd0e","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:gYear","@value":"2022"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b15n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"en","@value":"Road Transport Network - Download Service (INSPIRE)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/f4d7a64a5cb84b6f919d5e4645e868c7/tjanstebeskrivning_inspire_tn_giltig-version.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"84ce3866-7e61-4a30-9827-c51631ad0121","http://www.w3.org/ns/adms#identifier":"TN.RoadTransportNetwork.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b16n1"},{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b17n1"}],"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/282","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/477"},{"@id":"https://metadata.trafikverket.se/store/1/resource/526"},{"@id":"https://metadata.trafikverket.se/store/1/resource/574"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=282&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Vägbredd"},{"@language":"sv","@value":"Vägnät - Vägbredd (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the road width according to the INSPIRE Transport Network (TN) specification for RoadWidth. It is the width of the roadway in metres. For paved roads, this refers to the distance between the pavement edges or edge supports. For other roads, it refers to the load-bearing width, i.e. the part of the roadway that fulfils the specified load-bearing capacity.  It is generated from the following road data products:\no\tRoad width / Vägbredd\no\tWearing course / Slitlager"},{"@language":"sv","@value":"Datamängden redovisar vägbredd enligt Inspiretema transportnät (TN) RoadWidth. Datamängden redovisar vägbanans bredd i meter. För belagd väg avses avståndet mellan beläggningskanterna eller kantstöden. För övrig väg avses bärig bredd, dvs. den del av vägbanan som uppfyller den angivna bärigheten. \n\nRoadWidth är genererad ur från följande vägdataprodukter: \n- Vägbredd \n- Slitlager \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"0f0f7b1c-200e-4d19-af51-1b3f5aa65e17","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b19n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:74cce7ae7469f61bbe39ecebaea91a3d3d415446e14ed6c473ed99d2b3cb226c_b20n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Road Width (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_S-T/1015slitlager.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_U-%C3%96/1030vagbredd.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"h