9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b15n0"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2005 förekommer företeelsetypen C-Cykel_vägtyp i NVDB och den ersattes med GCMvägtyp från och med 2014. Ingen initial insamling har skett.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet för Vägdata för beredning och registrering enligt uppgjorda avtal och processer."}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b17n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b18n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n3"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n0"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar data om gång- och cykel- eller mopednätets (moped klass II) funktion och kan nyttjas i olika ruttningssituationer och ger även möjlighet att i en ruttplanerare välja väg efter vägtyp. \n\nDataprodukten registreras enbart på gång- och cykelnätet, heltäckande, dvs. de vägsträckor där Vägtrafiknät är angivet som cykelnät eller gångnät. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}