is.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1050Trafik.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-09-21"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Trafikflödet enligt mätning eller bedömning. ÅDT = årsmedeldygnstrafik (antal fordon per dygn i genomsnitt under året). ÅDT som redovisas är ett flöde för hela mätavsnittet och baserar sig på 2 till 6 mätningar fördelade på vardag och helg i en slumpmässigt vald punkt inom avsnittet. Flödet kan även vara ett bedömt värde. Trafikflödet redovisas med olika koder, som visar mätår, osäkerhet och trafiksiffrans ursprung."},"dct:issued":{"@type":"xsd:date","@value":"2026-08-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-17"},"dct:provenance":{"@id":"_:64a8e5dd2edd8bb8de5f2c7a968f730043a2f584c9a187c6ba1c68de8ca50e6b_b16n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:64a8e5dd2edd8bb8de5f2c7a968f730043a2f584c9a187c6ba1c68de8ca50e6b_b17n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:64a8e5dd2edd8bb8de5f2c7a968f730043a2f584c9a187c6ba1c68de8ca50e6b_b18n0"},"dct:title":{"@language":"sv","@value":"Trafik"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.