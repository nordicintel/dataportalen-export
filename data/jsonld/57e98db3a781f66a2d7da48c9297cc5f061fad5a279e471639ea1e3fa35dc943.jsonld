att se ingående lager hänvisar vi till tjänstebeskrivningen för NetInfo, vilken innehåller en komplett lista för respektive tjänst. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för vägdata - NetInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"1ef16f56-348f-471d-8469-d5b212e9f690","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b23n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/Transport