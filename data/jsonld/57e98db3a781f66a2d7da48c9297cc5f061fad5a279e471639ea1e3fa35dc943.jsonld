language":"sv","@value":"Datamängden redovisar den organisation eller typ av organisation som äger vägen enligt Inspiretema transportnät (TN) OwnerAuthority. OwnerAuthority är genererad ur från följande vägdataprodukter: \n- Väghållare \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"b1176d45-5eb3-4e08-a311-c9f0aa09621f","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b19n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:b494abfb53e2fb8edafb0b018628b949a819bc0c4cc1b5e5f02bec0a4c277082_b20n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Owner Authority (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_U-%C3%96/1040V%C3%A4gh%C3%A5llare.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-