ta.se/codelist/metadata/protokoll.xml#HTTP:Information"},"dct:description":{"@language":"sv","@value":"Visning av datat i Datautbytesportalen - API Öppna Data.\n\nOBS: Om du vill hämta data behöver du registrera ett konto. Du behöver en e-postadress och godkänna licensen för att registrera ett konto."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Huvudled - visning/nedladdning i öppna API"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2070","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/882"},"dcat:accessURL":{"@id":"http://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfoRoad?layers=Huvudled"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Huvudled - visning i NetInfoRoad"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2073","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/orderdata/vag"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Datamängd gällande Huvudled. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst. \n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Huvudled - nedladdning i Lastkajen"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2076","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/963"},"dcat:accessURL":{"@id":"http://vtf.trafikverket.se/SeTrafikinformation"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},"dct:description":{"@language":"sv","@value":"Visning av datat med denna egenskap i Vägtrafikflödeskartan (TIKK/TFK). \n\nOBS: För åtkomst/visning, klistra in åtkomstadresslänken i webbläsaren. Välj sedan egenskapen som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Huvudled - visning i Vägtrafikflödeskartan (TIKK/TFK)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/2464","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/10498"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Dataprodukten finns i det färdiga paketet: Data för Blåljusnavigering. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst. \n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Huvudled - nedladdning i Lastkajen/Data för Blåljusnavigering"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/597","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://lastkajen.trafikverket.se/aboutapi"},"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=597&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":[{"@language":"sv","@value":"Säkerhetsrelaterad statisk vägdata - Nedladdningstjänst"},{"@language":"sv","@value":"TN.ITS.Säkerhetsrelaterad_statisk_vägdata.Nedladdningstjänst"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WFS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-09-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The service provides daily datasets with changes road safety related data and is produced in line with the TN-ITS framework. TN-ITS (Transport Network ITS Spatial Data) is a collaborative platform at the European level, which manages and further develops the technical and organisational framework developed to provide static spatial road safety information in a uniform way."},{"@language":"sv","@value":"Tjänsten tillhandahåller dagliga dataset med förändringar av trafiksäkerhetsrelaterade vägdata och produceras i linje med TN-ITS-ramverket.\n\nDatamängden och dess distributionssätt är ett resultat av det tidigare deltagandet i EU-projektet ROSATTE. Då detta projekt avslutades beslutade Trafikverket att realisera projektresultatet som en tjänstebaserad lösning för daglig leverans av förändringar av trafiksäkerhetsrelaterad vägdata. TN-ITS (Transport Network ITS Spatial Data) en samarbetsplattform på europeisk nivå, som förvaltar och vidareutvecklar det tekniska och organisatoriska ramverk som är framtaget för att på ett enhetligt sätt tillhandahålla grundläggande spatial trafiksäkerhetsinformation som är av statisk karaktär.\n\nÅtkomst sker via vår datatjänst Lastkajen som innehåller en API-tjänst för nedladdning av data. För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst.\n\nÅtkomst till denna data kräver särskild behörighet utöver ett standard Lastkajen API-konto. Kontakta användarstöd på Lastkajen för att ändra behörigheten."}],"dct:identifier":"d8fa4de2-efac-42f8-b9b2-0f65f2afd5ba","dct:issued":{"@type":"xsd:date","@value":"2013-09-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2016-05-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:057b5feec14d6126fb49c8