krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst.\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayType - download through Lastkajen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/507","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/238"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wfs.axd/TN_RailTransportNetwork?service=WFS&version=2.0.0&request=GetFeature&typenames=RailwayType"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WFS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/nedladdning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayType - download service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/555","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/237"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wms.axd/TN_RailTransportNetwork?layers=TN.RailwayTransportNetwork.RailwayType"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayType - view service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b13n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b14n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b15n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085"},{"@graph":[{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n0"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n1"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n10"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n6"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n4"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n5"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n0"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n1"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n10"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n4"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n5"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n7"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n8"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n9"}]},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n7"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n8"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b10n9"},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n3"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n0"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n3"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n0"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b16n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n3"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n0"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b18n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b19n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b20n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2022-05-03"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n3"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n0"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b22n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549c60b29055c875727f33_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ffe05b7c698908e8d513d1014fa793b706414a95ab549