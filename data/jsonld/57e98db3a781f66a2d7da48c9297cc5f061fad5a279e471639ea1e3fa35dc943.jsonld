ant"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b23n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b24n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n3"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n0"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b26n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n3"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n0"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b27n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b28n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b29n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n0"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n1"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n10","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2005 förekommer dataprodukten C-Cykel_vägtyp i NVDB och den ersattes med GCM-vägtyp från och med 2014. Ingen initial insamling har skett.\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n4"}},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n11"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n12"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n13"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n14"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n15"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n16"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n17"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n18"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n19"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n2"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n20"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n3"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n0"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n1"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n11"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n12"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n13"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n14"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n15"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d4ebd2f653ed6b70_b2n16"},{"@id":"_:7bfbc8a1551f3e0b6ebe47a9b5b044eaef1d53d657b4c253d