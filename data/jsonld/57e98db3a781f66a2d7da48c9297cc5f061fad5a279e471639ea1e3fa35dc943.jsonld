//www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1e320cb91cd6dfb5b8452fb5a21c5220825213fc2bd658d0c1cbcf6555faf9f0_b14n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1e320cb91cd6dfb5b8452fb5a21c5220825213fc2bd658d0c1cbcf6555faf9f0_b15n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:1e320cb91cd6dfb5b8452fb5a21c5220825213fc2bd658d0c1cbcf6555faf9f0"},{"@graph":[{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Befintliga trafikregler samlas i Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). Denna dataprodukt härleds från befintliga trafikregler om stopplikt och kan användas som stöd vid framförande av fordon genom att i fordonsapplikationer ge information om annalkande stopplikt. \n\nStopplikt är en följd av lokal trafikföreskrift meddelad av länsstyrelse (utom tättbebyggt område) eller kommun (inom tättbebyggt område).  \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n0"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n1"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n10"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n6"}},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n4"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n5"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n0"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n1"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n10"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n4"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n5"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n7"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n8"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n9"}]},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n7"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n8"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b10n9"},{"@id":"_:1feb4cdfa56705cba85b9dfca736609ad5fdc3472489d9870b5972fade4d6571_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFo