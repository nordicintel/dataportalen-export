ttp://www.w3.org/ns/prov#generated":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b4n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b4n0"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b4n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b4n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n3"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n0"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b5n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b6n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät.\n\nDatamängden är genererad ur från följande vägdataprodukter:\n\n- Färjeled"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b7n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b8n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n2"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n0"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b9n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021