odukter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://crea