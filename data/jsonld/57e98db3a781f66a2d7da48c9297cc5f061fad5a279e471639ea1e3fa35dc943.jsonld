p://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/963","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://vtf.trafikverket.se/SeTrafikinformation"},"dcat:keyword":[{"@language":"en","@value":"map service"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=963&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En applikation där det finns information om fordonsflödet på statliga vägnätet. Här presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation.\nObservera att det finns två flikar i kartan, flik TFK och flik TIKK."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5_b26n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Vägtrafikflödeskartan (TIKK/TFK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"80e6bb4f-9d2e-416b-ad22-c57942520795","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5_b27n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5_b28n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5_b29n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5_b30n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:454e08958ecb75706051ba1e52f4ca9e7a7f8654d286340075c535c248fb11c5"},{"@graph":[{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/image":{"@id":"https://metadata.trafikverket.se/store/214/resource/6"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten visar var järnvägsnätet korsar bil-, cykel- och gångnätet i plan, det vill säga skärningspunkten mellan spårmitt och vägmitt. Varje skärningspunkt återges och förses med attribut som är kopplade till en och samma plankorsning. Plankorsningarna identifieras med ett PlankorsningsID, dvs identifikationen för plankorsningen från Trafikverkets infrastrukturregister för järnvägsdata. Attributen på skärningspunkterna avser egenskaper på den övergripande plankorsningen så därför kan flera skärningspunkter tillhöra samma plankorsning och därmed också ha samma attributuppsättning för ett flertal egenskaper.\n \nNotera! Då produkten använder skärningspunkt mellan väg och järnväg finns det i verkligheten plankorsningar som inte återfinns i den här produkten. Detta sker t.ex. när vägnät av olika anledningar inte registrerats i NVDB. Se kapitel Datainnehåll och struktur/ Beskrivande text i dataproduktspecifikationen för Det svenska vägnätet (länkad under kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation), för utförlig beskrivning över vilka typer av vägar som inkluderas i NVDB.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n0"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n1"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n10"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n6"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n4"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n5"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n0"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n1"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n10"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n4"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n5"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n7"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n8"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n9"}]},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n7"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n8"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b10n9"},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n3"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n0"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n3"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n0"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:455358dc08ec8d16fe430d2ad3a9ba1191808832f049ef4d0fb17687c54d185f_b17n0","@type":"dct:Location","dca