www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"a4430f27-339d-4abc-b29d-4d2b2e46f7dc","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b7n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b8n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b9n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b10n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:39963682f3c33ee65a819cac66698891fac874940d4f7b5dc8b6b76f619c5521"},{"@graph":[{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n0"},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data har skett genom att för statlig väg 2001-04-01 hämta data från Vägverkets vägdatabank (VDB den tidigare vägdatabasen, där förändringar ajourhållits kontinuerligt sedan 1980-01-01). \n\n¤ Datakällor för ajourhållning \n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n3"},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n4"}]},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. Driftområde ska inte läggas på kommunala eller enskilda vägar utifrån att vägen blivit klassad att ha avvikande underhållsansvar (i väghållare). Vad själva underhållet går ut på kan variera mycket så det blir fel att alltid sätta Driftområde på dessa länkar. Dock kan det i undantagsfall förekomma kommunala vägar (både bil- cykel- och gångvägar) som har Driftområde. Dessa är att betrakta som specialfall."}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b10n0"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},{"@id":"https://metadata.trafikverket.se/store/1/resource/882"}]},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n3"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n0"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b13n3","@type":"h