y/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n3"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b26n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n2"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b27n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n3"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b28n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b29n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. \n\nMappningen mellan Inspire VerticalPosition och Trafikverkets vägdata är ofullständig."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b2n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b2n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b2n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"en","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten består av företeelser med utbredningar som är knutna till vägnätet. \n\nDataprodukten innehåller uppgifter om överfarter, underfarter samt tunnlar som tillåter trafik. Förekommer bl.a. vid broar, planskilda korsningar, vägportar samt tunnlar. Detta för att visa var det finns konstruktioner som tillåter trafik över eller under vattendrag, dalgångar, vägar, byggnader, järnvägar, gång- och cykelvägar eller genom berg eller jord. \n\nDet är bara för konstruktioner av typen \"överfart\", \"tunnel\" samt \"överfart och underfart\" som längden anges. För typen \"överfart och underfart\" är det överfartens längd som anges. Konstruktionens längd mäts vanligen i väglinjen. Beroende på konstruktionstyp mäts längden olika. \n\nKonstruktioner av typen vägtrumma levereras ej. Som vägtrumma räknas konstruktion med teoretisk spännvidd mindre än eller lika med 2,0 m i största spannet. \n\nI attributet \"Namn\" anges endast unika BaTMan-namn, det vill säga de särskilda namn som finns i Trafikverkets konstruktionsdatabas BaTMan. Finns inget sådant namn lämnas attributvärdet tomt. För att ange beslutade, officiella namn, används attributet \"Officiellt namn\". Kommunala och statliga konstruktioner namnges endast av respektive väghållare. \nBåda namnen kan finnas samtidigt på en konstruktion, då de uppfyller olika syften. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b30n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b31n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n2"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b32n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b33n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b33n3"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b33n1","@type":"http:/