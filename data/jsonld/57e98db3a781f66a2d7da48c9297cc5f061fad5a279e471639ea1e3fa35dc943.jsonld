rket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/429","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/460"},{"@id":"https://metadata.trafikverket.se/store/1/resource/509"},{"@id":"https://metadata.trafikverket.se/store/1/resource/553"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=429&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"Järnväg - Bangårdsnod (INSPIRE)"},{"@language":"sv","@value":"TN.Järnväg.Bangårdsnod"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides railway yard nodes for the majority of Sweden’s according to the INSPIRE Transport Network (TN) specification RailwayYardNode. Railway yard nodes consist of the center point of registered loading bays in The Swedish Transport Administration’s (Trafikverket) data."},{"@language":"sv","@value":"Datamängden redovisar bangårdsnoder för huvuddelen av Sveriges järnväg enligt Inspiretema transportnät (TN) RailwayYardNode. Bangårdsnoder består av mittpunkten för registrerade lastplatser i Trafikverkets data. \n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"c690eefe-34e8-4a55-9ea0-2442197771c9","dct:issued":{"@type":"xsd:date","@value":"2012-06-28"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-28"},"dct:provenance":{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b9n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b10n0"},"dct:title":{"@language":"en","@value":"Railway Transport Network - Railway Yard Node (INSPIRE)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/237"},{"@id":"https://metadata.trafikverket.se/store/1/resource/238"}],"http://entryscape.org/terms/metadataIdentifier":"afd1535c-79eb-43f0-87ed-0fcae2ed5956","http://www.w3.org/ns/adms#identifier":"TN.RailwayTransportNetwork.RailwayYardNode","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b11n1"},{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b12n1"}],"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/460","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/10095"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"\"Datamängd gällande järnvägsrelaterade produkter. Filerna finns i geopackage-format. Välj paket med namn som motsvarar din datamängd. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst.\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayYardNode - download through Lastkajen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/509","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/238"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wfs.axd/TN_RailTransportNetwork?service=WFS&version=2.0.0&request=GetFeature&typenames=RailwayYardNode"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WFS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/nedladdning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayYardNode - download service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/553","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/237"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wms.axd/TN_RailTransportNetwork?layers=RailwayYardNode"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayYardNode - view service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b13n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b14n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec_b15n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:345b13ab79bf843271cd45efedc8e7d387229f4e58652617d9ccb61cd34ee7ec"},{"@graph":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till lägre bruttovikt på fordon eller fordonståg än som annars gäller. Dataprodukten innehåller attribut som anger hur hög begränsningen är, vilken beteckning den har i STFS, vilka fordons- eller trafikanttyper begränsningen inte gäller, vid vilka tidsintervall den gäller och om den gäller hela fordonståget eller varje separat fordon. Den används för reglering av trafikens framkomlighet, t ex genom att i applikationer för navigering och ruttplanering förhindra trafik med för tunga fordon på vägar som ej är dimensionerade för dessa. \n\nDär väghållaren är statlig eller kommunal baseras registreringen på en föreskrift. På det enskilda vägnätet är registreringen enligt giltiga vägmärken eller som beslutade föreskrifter. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet,  se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b10n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b10n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b10n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift \npubliceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b11n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b11n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b11n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift \npubliceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör.\n\n¤ Datakällor för ajourhållning\n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS)."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar \ndessa i NVDB.\n\nTillfälliga föreskrifter som är gällande under 6 månader behandlas inte.\n\nFöreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan \nvara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då.\n\nMånga myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den dataprodukten som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning.\n\nFör varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b12n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör.\n\n¤ Datakällor för ajourhållning\n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS)."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar \ndessa i NVDB.\n\nTillfälliga föreskrifter som är gällande under 6 månader behandlas inte.\n\nFöreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan \nvara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då.\n\nMånga myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den dataprodukten som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning.\n\nFör varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b13n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b14n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b14n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b14n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b15n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b15n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b15n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b16n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b16n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b16n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"A Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift publiceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b17n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b17n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b17n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"A Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift publiceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b18n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b18n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b18n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten innehåller attribut som anger hur hög begränsningen är för axeltryck, boggitryck eller trippelaxeltryck, vilken beteckning den har i STFS och vilka fordons- eller trafikanttyper begränsningen inte gäller. Med axeltryck, boggitryck eller trippelaxeltryck avses den sammanlagda statiska vikten som överförs från alla hjulen på en hjulaxel, boggi eller trippelaxel, uttryckt i enheten ton. \n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b19n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b19n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b19n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten innehåller attribut som anger hur hög begränsningen är för axeltryck, boggitryck eller trippelaxeltryck, vilken beteckning den har i STFS och vilka fordons- eller trafikanttyper begränsningen inte gäller. Med axeltryck, boggitryck eller trippelaxeltryck avses den sammanlagda statiska vikten som överförs från alla hjulen på en hjulaxel, boggi eller trippelaxel, uttryckt i enheten ton. \n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till lägre bruttovikt på fordon eller fordonståg än som annars gäller. Dataprodukten innehåller attribut som anger hur hög begränsningen är, vilken beteckning den har i STFS, vilka fordons- eller trafikanttyper begränsningen inte gäller, vid vilka tidsintervall den gäller och om den gäller hela fordonståget eller varje separat fordon. Den används för reglering av trafikens framkomlighet, t ex genom att i applikationer för navigering och ruttplanering förhindra trafik med för tunga fordon på vägar som ej är dimensionerade för dessa. \n\nDär väghållaren är statlig eller kommunal baseras registreringen på en föreskrift. På det enskilda vägnätet är registreringen enligt giltiga vägmärken eller som beslutade föreskrifter. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet,  se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakälla för ajourhållning \n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b20n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakälla för ajourhållning \n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b21n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b22n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b22n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b22n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b23n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b23n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b23n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b24n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b24n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b24n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b25n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b25n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b25n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b26n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b27n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b27n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b27n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b28n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b28n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b28n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b29n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b29n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b29n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b2n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b2n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b2n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift publiceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n1"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n10"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n6"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n4"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n5"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n1"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n10"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n4"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n5"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n7"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n8"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n9"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n7"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n8"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b30n9"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b31n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b31n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b31n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b32n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b33n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b34n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b35n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b36n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n2"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b37n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b38n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b39n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b3n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b3n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b3n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift publiceras och registrerar den i NVDB."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n2"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b40n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b41n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b42n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät.\n\nI de fall det finns tidsbegränsningar på restriktioner utelämnas dessa på grund av att Inspirespecifikationen inte stödjer det sätt på vilket tidsintervall uttrycks. \n\nMappningen mellan Inspire RestrictionForVehicles och Trafikverkets vägdata är ofullständig."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b43n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b44n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n2"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b45n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b46n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b47n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.09,24.16 69.09,24.16 55.34,11.11 55.34,11.11 69.09))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b48n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg_del/2022/670/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b49n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakällor för ajourhållning\n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. Där väghållaren är statlig eller kommunal sker registreringen baserat på en föreskrift. På det enskilda vägnätet sker registreringen enligt giltiga vägmärken eller som beslutade föreskrifter. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b4n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b50n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b51n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b52n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b53n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n3"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b54n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b55n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b56n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b57n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n0"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakällor för ajourhållning\n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n3"},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n4"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. Där väghållaren är statlig eller kommunal sker registreringen baserat på en föreskrift. På det enskilda vägnätet sker registreringen enligt giltiga vägmärken eller som beslutade föreskrifter. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b5n0"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b6n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b6n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b6n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b8n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till mindre bredd på fordon eller fordonståg inkl. last än som annars gäller. Dataprodukten innehåller attribut som anger högsta tillåtna bredd, vid vilka tidsintervall den gäller och för vilka fordon/trafikanter. Den används för reglering av trafikens framkomlighet, t ex genom att i \napplikationer för navigering och ruttplanering förhindra trafik med för breda fordon på vägar som ej är dimensionerade för dessa.\n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i \nförhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b9n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:350828ffb7079b92a601d3742d1bdfbbf211b875f82e6585c43c4865e0b30c23_b9n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till mindre bredd på fordon eller fordonståg inkl. last än som annars gäller. Dataprodukten innehåller attribut som anger högsta tillåtna bredd, vid vilka tidsintervall den gäller och för vilka fordon/trafikanter. Den används för reglering av trafikens framkomlighet, t ex genom att i \napplikationer för navigering och ruttplanering förhindra trafik med för breda fordon på vägar som ej är dimensionerade för dessa.\n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i \nförhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Age