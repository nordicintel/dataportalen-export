ailway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/427","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/459"},{"@id":"https://metadata.trafikverket.se/store/1/resource/507"},{"@id":"https://metadata.trafikverket.se/store/1/resource/555"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=427&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"en","@value":"TN.Järnväg.Järnvägstyp"},{"@language":"sv","@value":"Järnvägsnät - Järnvägstyp (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the type of the railway (e.g. train, tram, funicular railway) according to the INSPIRE Transport Network (TN) specification RailwayType.\nThe Swedish Transport Administration (Trafikverket) has data about railways of the type train. A constant value for type (train) is given for all links."},{"@language":"sv","@value":"Datamängden redovisar av vilken typ järnvägen (t.ex. tåg, spårväg, bergbana) är enligt Inspiretema transportnät (TN) RailwayType.\n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer. Trafikverkets har data om järnväg av typen tåg. Konstant värde (train) för typ anges för alla länkar."}],"dct:identifier":"661af8b2-d6f6-41e5-8020-d09cd9b7f770","dct:issued":{"@type":"xsd:gYear","@value":"2011"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-06-07"},"dct:provenance":{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b9n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:ff34e87b822e545c730dc3442defe3a1c4fa543028564450785d6047c8cca085_b10n0"},"dct:title":{"@language":"en","@value":"Railway Transport Network - Railway Type (INSPIRE)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://meta