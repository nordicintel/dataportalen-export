ent/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f"},{"@graph":[{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaaed657852c45fb34eb789_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Dataprodukter för järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet.\n\nDataprodukten ingår i NJDB – nationell järnvägsdatabas."}},{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaaed657852c45fb34eb789_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaaed657852c45fb34eb789_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaaed657852c45fb34eb789_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaaed657852c45fb34eb789_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:664c0f55adf96544e5c8af9f366f6dcc10e23a98afaa