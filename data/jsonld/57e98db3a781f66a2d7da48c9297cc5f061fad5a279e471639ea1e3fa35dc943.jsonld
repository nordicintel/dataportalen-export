ps://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/6d2b71791557412aba9a3dba9555df83/jarnvagsnat_aggregerad_bandel_2_0.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"http://entryscape.org/terms/metadataIdentifier":"35fa478b-0d7c-49b5-a5ad-1e1445f0bbba","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:e65c6151ae4ab9c6b9a0c9f06fb7ca08c36d04cd31895ccd8f93526b3e92f2c9_b5n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RW_DataPackagesAndSpecialProducts"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e65c6151ae4ab9c6b9a0c9f06fb7ca08c36d04cd31895ccd8f93526b3e92f2c9_b6n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:e65c6151ae4ab9c6b9a0c9f06fb7ca08c36d04cd31895ccd8f93526b3e92f2c9_b7n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:e65c6151ae4ab9c6b9a0c9f06fb7ca08c36d04cd31895ccd8f93526b3e92f2c9"},{"@graph":[{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor."}},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n0"},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n1"},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n10"},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n6"}},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n4"},{"@id":"_:e75e62dd0626ccb024def8dc0e475b8a90195d7105516a2b85407f0f89889839_b10n5"},{"@id":"_:e75e62dd0626cc