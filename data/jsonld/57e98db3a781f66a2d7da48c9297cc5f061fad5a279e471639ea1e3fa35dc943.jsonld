:"Datautbytesportalen"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/transformation"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:697f58c2818b3f1cd676ebe1dab4c3c22aa04253ed424b91dd510f6b9f537e1b_b3n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:697f58c2818b3f1cd676ebe1dab4c3c22aa04253ed424b91dd510f6b9f537e1b_b4n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/25","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Operativ Event och Railway Event","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:operativtledningsstod.forvaltning@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:697f58c2818b3f1cd676ebe1dab4c3c22aa04253ed424b91dd510f6b9f537e1b"},{"@graph":[{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n0"},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör.\n\n¤ Datakällor för ajourhållning\n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). \n\nVägnät där väghållare är statlig – föreskrifter skrivna av Trafikverket och hämtade från STFS\n\nVägnät där väghållare är kommunal – föreskrifter skrivna av kommuner och hämtade från STFS Produktion\n\nProduktionen sker till största delen av Trafikverkets personal via dataleveranser från STFS. I dataleveranserna ska information om tillkomst ingå för varje företeelse."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n3"}},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n3","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b10n0"}},{"@id":"_:6b48dee808039dd96b48fbf2a4e7b52cca0a93466d768daea5bcccaa31fb3886_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store