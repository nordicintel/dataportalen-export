b381957460499f5e9f7382e30e3448770a6c954e514071f279a599dacea0df"},{"@graph":[{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Data har initialt laddats från äldre databaser eller initial inventering. Underlag för ajourhållning fångas hos Trafikverkets verksamhet för underhåll av statliga vägar eller investeringsverksamhet för nya statliga vägar.\n\nInformation om tillkomst lagras på objektsnivå.\n\nKrav på datakvalitet varierar med typ av vägnät och delas upp i kvalitetskravklasser. Ett exempel på detta är att kraven är högre för motorvägar än för skogsbilvägar. Kvalitetskravklasserna beskrivs jämte kraven i dataproduktspecifikationerna för NVDB."}},{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n3"}},{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n0"}},{"@id":"_:78d7713e8997175c0c39159e2bbae35cd294a1cdc39637eed400a5576ea3bfaf_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/co