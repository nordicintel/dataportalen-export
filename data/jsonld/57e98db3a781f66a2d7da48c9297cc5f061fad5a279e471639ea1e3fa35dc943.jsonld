kverket.se/store/4/resource/55","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - LVS förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lvs.forvaltning@trafikverket.se"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/59","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Webb och projektstöd","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:webbochprojektstod@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:d9276ccd98ff2be47eec064910c60ff9d8cb06851fbfac4dece2462d04c3b8b9"},{"@graph":[{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Data om järnvägsanläggningen och trafikuppgifter hämtas från TNE_JVG. Data om bullerskärmar hämtas från TNE_JVG. Data om plankorsningar hämtas från TNE_JVG. Data om järnvägsanläggningen hämtas från Nationell järnvägsdatasbas (NJDB). Data om bullerskärmar hämtas från NJDB. Data om plankorsningar hämtas från NJDB. Trafikdata kommer från Tågplanen som tas fram varje år.\n\nDataset skapas genom att aggregera och homogenisera data från olika dataset i TNE_JVG. Dataset skapas genom att aggregera och homogenisera data från olika dataset i NJDB. Ingen initial laddning av data sker. Ajourhållning sker genom att underliggande dataset i TNE_JVG ajourhålls. Data skapas genom att aggregera och homogenisera data från olika dataset i TNE_JVG.\n\nData underhålls ej utan skapas vid behov. Ajourhållning sker genom att underliggande dataset i NJDB ajourhålls."}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n3"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n0"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:d96e70ff41b0f70b85860714a5b86da89f2ad73ec7b7d36df4a991ec81f61ac3_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identif