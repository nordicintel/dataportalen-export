trafikverket.se/documentation/datacache\n- API Järnväg - https://data.trafikverket.se/documentation/api-railway\n- API Datex II - https://data.trafikverket.se/documentation/datex"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Datautbytesportalen"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/transformation"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b23n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/834","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/orderdata/vag"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Datamängd gällande Motortrafikled. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Motortrafikled - nedladdning i Lastkajen"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/881","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=881&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Road Data - View Service - NetInfo"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-11-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En WMS-tjänst (visningstjänst) som innehåller nätanknutna nationella (NVDB) och statliga vägdata. Tjänsten används bl.a. av webbapplikationen Sveriges vägar på karta/NVDB på webb. NetInfo visar företeelser på alla typer av vägnät. För att se ingående lager hänvisar vi till tjänstebeskrivningen för NetInfo, vilken innehåller en komplett lista för respektive tjänst. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b24n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@