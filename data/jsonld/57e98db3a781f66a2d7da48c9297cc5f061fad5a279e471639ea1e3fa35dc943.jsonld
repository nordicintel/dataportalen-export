se limitations are established by traffic regulation or other official decisions."},{"@language":"sv","@value":"Trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till lägre axel- boggi- och trippelaxeltryck för fordon än som annars gäller."}],"dct:identifier":"fe9b5383-ff8d-4221-933b-3989fbbda049","dct:issued":{"@type":"xsd:date","@value":"2013-07-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b22n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b23n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b24n0"},"dct:title":{"@language":"sv","@value":"Begränsat axel-boggitryck"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1032Begr%C3%A4nsat%20axel-boggitryck.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverke