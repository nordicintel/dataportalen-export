card/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:1bf988412035ff17341084bc54c35ae613526cae68d6e3b55465ceaf83f2213c_b22n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:1bf988412035ff17341084bc54c35ae613526cae68d6e3b55465ceaf83f2213c"},{"@graph":[{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten härleds från befintliga trafikregler om motortrafikled och kan användas för reglering av trafikens framkomlighet genom att i applikationer för ruttplanering och navigering styra fordon i möjligaste mån till motortrafikleder och motorvägar. \n\nMotortrafikled är oftast en följd av lokal trafikföreskrift meddelad av länsstyrelse. I sällsynta fall finns kommunala motortrafikleder. Om inget annat anges gäller högsta tillåtna hastighet 110 km/tim på motortrafikled. En motortrafikled kan ha syskonlänkar, d v s skilda körbanor för varje färdriktning. \n\nPå- och avfartsvägar hör till motortrafikleden i den omfattning som länsstyrelsen eller kommunen bestämmer för varje fall. \n\nSedan 1990-talet har de flesta motortrafikleder i Sverige byggts om och fått mitträcken, vilket innebär att de blivit mötesfria, växelvis indelade i 2+1 körfält. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n0"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n1"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n10"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n6"}},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n4"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n5"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n0"},{"@id":"_:1cd10019d1d1018c3d1e50922541665d844deb1124249548a6975969b6c8b961_b10n1"},{"@i