":{"@language":"sv","@value":"2026-09-01\nReviderad och anpassad till nytt format av standard för dataproduktspecifikationer."},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b0n0"},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b1n0"},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n2"},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b3n1"},{"@id":"https://metadata.trafikverket.se/concepts/dps"}],"https://def.isotc211.org/model/19137-1/dataQualityInfo":{"@id":"https://metadata.trafikverket.se/store/236/resource/12"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RoadNetwork"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/TransportNetworkData"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"10.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillam