://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:d63d6a9d858a0ee0fe164c62a42421f0787b7708c5c73d2e59c605c99de4b851_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/lastkajen"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_b79e35eb"},{"@id":"http://data.europa.eu/bna/c_e1da4e07"}],"http://entryscape.org/terms/metadataIdentifier":"f9489872-7415-4c6b-a46a-7929235d4983","http://www.w3.org/ns/adms#identifier":"Lastkajen.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:d63d6a9d858a0ee0fe164c62a42421f0787b7708c5c73d2e59c605c99de4b851_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/958","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://njdbwebb.trafikverket.se/"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=958&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/autho