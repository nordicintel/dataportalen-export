ra, dels till själva järnvägsnätet.\n\n\nDataprodukten ingår i NJDB – nationell järnvägsdatabas."}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b7n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b8n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n3"}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n0"}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resourc