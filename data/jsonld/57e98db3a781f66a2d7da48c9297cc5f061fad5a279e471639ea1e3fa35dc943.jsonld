rce/485"}],"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=257&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Road Culvert"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1076V%C3%A4gtrumma.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-05-06"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Data on culverts for state roads. The coordinates indicate the location of the inlet of the culverts. The attributes provide information on, e.g., dimension, material and type of inlet or outlet. Data collection is ongoing and is expected to be complete by 2025."},{"@language":"sv","@value":"Datamängden beskriver data om vägtrummor för statliga vägar. Trummors läge utgörs av koordinater för trummans inlopp. Attribut beskriver bl.a. dimension, material och typ för inlopp resp utlopp. Datainsamling pågår och förväntas vara heltäckande till 2025."}],"dct:identifier":"e5fc7b29-d235-4899-b341-cc1942682a80","dct:issued":{"@type":"xsd:date","@value":"2020-05-15"},"dct:lang