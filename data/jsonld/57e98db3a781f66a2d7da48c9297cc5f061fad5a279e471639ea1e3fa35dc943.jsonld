:{"@language":"sv","@value":"Webbapplikation som gör det möjligt att se Sveriges alla vägar och cykelvägar som finns lagrade i Nationella vägdatabasen (NVDB). Man kan välja att titta på flera olika egenskaper (dataslag) som gäller för en vissa sträcka. Det är också möjligt att rapportera felaktigheter i det data som visas och är du leverantör av data till Nationella vägdatabasen kan du även rapportera förändringar."},"dct:identifier":"b936f118-81a8-4e59-84bb-1aaa6b7865c0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:40cae3aa30a5d4b836aa39253c1b0becceb34019d59654b1a86c76fb2666f864_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanWorkflowEnactmentManager"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NVDB på karta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b