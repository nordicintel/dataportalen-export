ngPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1046&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/AS_NEEDED"},"dct:alternative":{"@language":"en","@value":"Railway Data - Track number"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-06-18"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Inne på driftplatser och linjeplatser med huvudspår och sidospår så skiljs spåren åt med hjälp av ett för driftplatsen/linjeplatsen unikt spårnummer (spårnr). Spårnummer ska anges enligt signalritningarna och kan vara antingen numeriskt eller alfanumeriskt.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens från nod till nod med avstånd i meter till både start- och slutläget på sträckan i spårlänkens riktning.\n\nRelaterade objekt:\n- Produkten ska vara heltäckande på indelningstypen Plats\n- Alla objekttyper registreras med spårnummer på en trafikplats"},"dct:identifier":"88b2b680-5679-4808-a669-341f04befaf0","dct:issued":{"@type":"xsd:date","@value":"2012-06-18"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:517c46e5d0042bd60c0b374c3ec19d999b0cb7b0905b74e352828b8c82c67537_b0n0"},"dc