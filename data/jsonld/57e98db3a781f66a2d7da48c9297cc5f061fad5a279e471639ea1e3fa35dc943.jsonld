ata.trafikverket.se/store/4/resource/14"},"dcat:distribution":{"@id":"https://metadata.trafikverket.se/store/1/resource/1202"},"dcat:keyword":[{"@language":"en","@value":"Road data"},{"@language":"sv","@value":"Vägdata"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1005&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Road Safety Classification"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2011-02-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten består av företeelser av typen Skyddsklassade vägar som tillhör produktgruppen STVDB samt produktundergruppen Administrativa företeelsetyper i STVDB.\n\nDataprodukten markerar statliga vägar med speciella säkerhetsregler vid vägarbete.\n\nSyftet med dataprodukten är att visa vilka vägar som är skyddsklassade med speciella säkerhetsregler, främst vid drift- och underhållsarbeten."},"dct:identifier":"e6b0255b-1602-4bf6-becc-eb9d61838c26","dct:issued":{"@type":"xsd:date","@value":"2011-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:d1a7f3bf119c91a5f16a012f6c23193e5489a56b56c