ckså mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb"},{"@graph":[{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b10n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b11n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b11n3"}},{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b11n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b11n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:f0089c2620f9f520c69f2f8c4a7e13ec37721df46bf15c30663b5b5ef8190b04_b11n0"}},{"@id":"_:f0089c