-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The INSPIRE-compliant view service provides ferry routes operated by the Swedish Transport Administration’s (Trafikverket), according to the INSPIRE Transport Network (TN) specification for Waterway Node and Ferry Crossing. It is generated from the following road data products:\n•\tFerry Route / Färjeled"},{"@language":"sv","@value":"WMS-tjänst för färjeleder enligt INSPIRE-direktiv. För användning i applikationer. \n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara."}],"dct:identifier":"cfcbc4af-41ec-45eb-ba53-b5f237f79060","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:gYear","@value":"2022"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:dd2c48e22a390ae97ab3f8183945e6a474cd21c9992ade2a1c2c800c34eaf102_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"en","@value":"Water Transport Network - View Service (INSPIRE)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/f4d7a64a5cb84b6f919d5e4645e868c7/tjanstebeskrivning_inspire_tn_giltig-version.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"f37ec236-fc6e-4540-be25-19a9aca1716c","http://www.w3.org/ns/adms#identifier":"TN.WaterTransportNetwork.ViewService","http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:dd2c48e22a390ae97ab3f8183945e6a474cd21c9992ade2a1c2c800c34eaf102_b1n1"},{"@id":"_:dd2c48e22a390ae97ab3f8183945e6a474cd21c9992ade2a1c2c800c34eaf102_b2n1"}],"https://metadata.trafikverket.se/ns/keyword":{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road-ferry"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:dd2c48e22a390ae97ab3f8183945e6a474cd21c9992ade2a1c2c800c34eaf102_b3n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:dd2c48e22a390ae97ab3f8183945e6a474cd21c9992ade2a1c2c800c34eaf102"},{"@graph":[{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Mätdata (tillståndsdata) kommer från vägytemätningar som Trafikverket beställer. Dessa utförs varje eller vartannat år beroende på vägkategori.\n\nÅtgärderna kommer från inrapporteringar av utförda vägåtgärder (beläggningsåtgärder eller avvattningsåtgärder på statliga vägar) som görs av Trafikverksprojekt. \n\nVägnät och vägdata, förutom beläggningsdetaljerna och mätdata, hämtas från Trafikverkets nationella vägdatabas."}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n3"}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n0"}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ddeec911a56c858ff234df1609cf73845ca9720af9bab7959fe514f76ccb187b_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ddeec911a56c