eme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Hastighetsgräns"},{"@language":"sv","@value":"Vägnät - Hastighetsgräns (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides speed limit, according to the INSPIRE Transport Network (TN) specification for SpeedLimit. It is based on the traffic rule on the maximum speed at which vehicles may be driven according to a decision and generated from the following road data product:\n•\tSpeed limit / Hastighetsgräns"},{"@language":"sv","@value":"Datamängden redovisar hastighetsgräns enligt Inspiretema transportnät (TN) SpeedLimit. Datamängden redovisar hastighetsgräns baserad på trafikregel om med vilken högsta hastighet fordon får föras enligt beslut. SpeedLimit är genererad ur från följande vägdataprodukter: \n- Hastighetsgräns\n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"2c439a85-40b7-4567-bc7a-3aa96a9a3095","dct:issued":{"@type":"xsd:date","@value":"2011-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:d56edb963a755b7699cbe8f118117e7949300bba7e69ffd85403ae145df56e91_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:d56edb963a755b7699cbe8f118117e7949300bba7e69ffd85403ae145df56e91_b19n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:d56edb963a755b7699cbe8f118117e7949300bba7e69ffd85403ae145df56e91_b20n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Speed Limit (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_H-K/1000Hastighetsgr%C3%A4ns.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/239"},{"@id":"https://metadata.trafikverket.se/store/1/resource/240"}],"http://entryscape.org/terms/metadataIdentifier":"58e79a60-4a59-405e-9bea-d821cc3b3a03","http://www.w3.org/ns/adms#identifier":"TN.RoadTransportNetwork.SpeedLimit","h