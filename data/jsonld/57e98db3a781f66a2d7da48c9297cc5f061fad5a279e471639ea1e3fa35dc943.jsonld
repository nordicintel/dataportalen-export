-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides significant points in the railway network according to the INSPIRE Transport Network (TN) specification RailwayStationNode. The points included in the dataset correspond to railway interchanges with conditions enabling passenger interchange."},{"@language":"sv","@value":"Datamängden redovisar platser i järnvägsnätet enligt Inspiretema transportnät (TN) RailwayStationNode. De platser som ingår i datamängden motsvaras av trafikplatser för järnväg med förutsättningar för resandeutbyte.\n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"45643052-bd92-4b70-8b6b-0bc550867c17","dct:issued":{"@type":"xsd:gYear","@value":"2011"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-28"},"dct:provenance":{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b8n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b9n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b10n0"},"dct:title":{"@language":"en","@value":"Railway Transport Network - Railway Station Node (INSPIRE)"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/237"},{"@id":"https://metadata.trafikverket.se/store/1/resource/238"}],"http://entryscape.org/terms/metadataIdentifier":"d9e228cb-aaf8-4f1d-be30-c99743a5f353","http://www.w3.org/ns/adms#identifier":"TN.RailwayTransportNetwork.RailwayStationNode","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b11n1"},{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b12n1"}],"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/458","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/10095"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"\"Datamängd gällande järnvägsrelaterade produkter. Filerna finns i geopackage-format. Välj paket med namn som motsvarar din datamängd. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst.\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayStationNode - download through Lastkajen"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/580","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/237"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wms.axd/TN_RailTransportNetwork?layers=TN.RailwayTransportNetwork.RailwayStationNode"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayStationNode - view service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/581","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/238"},"dcat:accessURL":{"@id":"http://geo-inspire.trafikverket.se/MapService/wfs.axd/TN_RailTransportNetwork?service=WFS&version=2.0.0&request=GetFeature&typenames=RailwayStationNode"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WFS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/nedladdning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RailwayTransportNetwork.RailwayStationNode - download service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b13n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b14n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3_b15n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:efb7ef6e0bdfd6472f0881a2037d1d0ea989e6690fc8b35dd3055e7fa8708ee3"},{"@graph":[{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till mindre bredd på fordon eller fordonståg inkl. last än som annars gäller. Dataprodukten innehåller attribut som anger högsta tillåtna bredd, vid vilka tidsintervall den gäller och för vilka fordon/trafikanter. Den används för reglering av trafikens framkomlighet, t ex genom att i \napplikationer för navigering och ruttplanering förhindra trafik med för breda fordon på vägar som ej är dimensionerade för dessa.\n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i \nförhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n0"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n3"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n4"}]},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b10n0"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b12n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b12n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b12n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b13n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b13n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b13n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n0"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n1"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n10"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n6"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n4"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n5"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n0"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n1"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n10"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n4"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n5"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n7"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n8"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n9"}]},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n7"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n8"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b14n9"},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b15n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b15n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b15n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b16n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n3"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n0"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b18n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n3"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n0"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till mindre bredd på fordon eller fordonståg inkl. last än som annars gäller. Dataprodukten innehåller attribut som anger högsta tillåtna bredd, vid vilka tidsintervall den gäller och för vilka fordon/trafikanter. Den används för reglering av trafikens framkomlighet, t ex genom att i \napplikationer för navigering och ruttplanering förhindra trafik med för breda fordon på vägar som ej är dimensionerade för dessa.\n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i \nförhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.09,24.16 69.09,24.16 55.34,11.11 55.34,11.11 69.09))"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n3"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n0"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg_del/2022/670/oj"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b22n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör.\n\nData för ajourhållning finns i Transportstyrelsens rikstäckande databas för trafikföreskrifter (RDT) där Trafikverkets enhet Vägdata hämtar underlagen."}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b23n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b24n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n3"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n0"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b26n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b27n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b27n3"}},{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b27n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b27n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b27n0"}},{"@id":"_:efeda1c25c5