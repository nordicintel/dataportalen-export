fab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b2n2"},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b3n1"},{"@id":"https://metadata.trafikverket.se/concepts/dps"}],"https://def.isotc211.org/model/19137-1/dataQualityInfo":{"@id":"https://metadata.trafikverket.se/store/236/resource/12"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RoadNetwork"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/TransportNetworkData"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"10.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Det svenska vägnätet.  Dataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik. Vägar som är avsedda för gångtrafik kan ingå."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/119/resource/10"},"dct:issued":{"@type":"xsd:date","@value":"2021-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1055referenslinjetillkomst.pdf"},"dct:title":[{"@language":"en","@value":"The Swedish road network - Data Product Specification"},{"@language":"sv","@value":"Det svenska vägnätet - Dataproduktspecifikation"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e0faf1739d244cb384aadf8c1f7a91dd/introduktion-till-nvdbs-vagnat-och-foreteelser.pdf"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/leverera-in-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/extern-kvalitetskontroll/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/"}],"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"2026-09-01\nReviderad och anpassad till nytt format av standard för dataproduktspecifikationer."},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b4n0"},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b5n0"},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b6n3"},{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b7n1"},{"@id":"https://metadata.trafikverket.se/concepts/dps"}],"https://def.isotc211.org/model/19137-1/dataQualityInfo":{"@id":"https://metadata.trafikverket.se/store/119/resource/8"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/NVDB_AdministrativeData"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/Database/nvdb"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med presentation av dataprodukspecifikationer."},"dct:title":{"@language":"sv","@value":"Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om de dataprodukter som varken kan kopplas direkt till väg eller järnväg, så kallade omgivande geodata, eller är dataprodukter skapade som en kombination av både väg- och järnväg."},"dct:title":{"@language":"sv","@value":"Informationssida: Omgivande geodata och kombinerade väg-järnvägsdataprodukter"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b8n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/lastkajen"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_b79e35eb"},{"@id":"http://data.europa.eu/bna/c_e1da4e07"}],"http://entryscape.org/terms/metadataIdentifier":"f9489872-7415-4c6b-a46a-7929235d4983","http://www.w3.org/ns/adms#identifier":"Lastkajen.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:efab478d59a87c53478a429c84a9921ecf70460f62bc240d7deee57f1430e243_b9n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProdu