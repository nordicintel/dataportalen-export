nsch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om de dataprodukter som varken kan kopplas direkt till väg eller järnväg, så kallade omgivande geodata, eller är dataprodukter skapade som en kombination av både väg- och järnväg."},"dct:title":{"@language":"sv","@value":"Informationssida: Omgivande geodata och kombinerade väg-järnvägsdataprodukter"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1249","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},"dcat:accessURL":{"@id":"https://nvdbpakarta.trafikverket.se/map"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Information"},"dct:description":{"@language":"sv","@value":"Visning av datat med denna egenskap i NVBD på karta. \n\nOBS: För åtkomst/visning, klistra in åtkomstadresslänken i webbläsaren. Välj sedan egenskapen som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Kalibreringssträcka - visning i NVDB på karta"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/186","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/15"},"dcat:endpointURL":[{"@id":"https://lastkajen.trafikverket.se/"},{"@id":"https://lastkajen.trafikverket.se/aboutapi"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"en","@value":"download service"},{"@language":"sv","@value":"INSPIRE"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=186&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Lastkajen"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2015-03-17"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Web application to order and download road and railway data from The Swedish Transport Administration’s (Trafikverket) databases. You will find data for road networks and other products for all Swedish municipalities and regions.\n\nAn API service for downloading road and railway data (https://lastkajen.trafikverket.se/aboutapi) is also available.\n To access/download, follow the link and log in to Lastkajen (a free user account is required). After logging in, paste the same URL again in your browser for direct access."},{"@language":"sv","@value":"Webbaserad applikation som gör det möjligt för dig att beställa och hämta väg- och järnvägsdata från Trafikverkets databaser. Här ligger alla Sveriges kommuner och län färdiga med vägnät och dataprodukter.\n\nApplikationen innehåller också en API-tjänst för nedladdning av väg- och järnvägsdata (https://lastkajen.trafikverket.se/aboutapi). För åtkomst/nedladdning, klicka på länken under åtkomstaddress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."}],"dct:identifier":"f358d6f2-76fe-4969-9c02-56c175e345ce","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b12n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoOrderHandlingService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoProductAccessService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Lastkajen - Nedladdningstjänst"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/lastkajen"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":[{"@id":"http://data.europa.eu/bna/c_b79e35eb"},{"@id":"http://data.europa.eu/bna/c_e1da4e07"}],"http://entryscape.org/terms/metadataIdentifier":"f9489872-7415-4c6b-a46a-7929235d4983","http://www.w3.org/ns/adms#identifier":"Lastkajen.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b13n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/187","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:endpointURL":{"@id":"https://nvdbpakarta.trafikverket.se/map"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"},{"@language":"sv","@value":"karttjänst"},{"@language":"sv","@value":"map service"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=187&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"