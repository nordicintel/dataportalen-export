gsbuller utförda 2007, 2012, 2017 och 2022\n. Kartläggningen 2022 omfattar beräknat buller för statliga vägar och järnvägar med en trafikering över 3 miljoner fordon årligen respektive 30 000 tåg per år samt flygplatser med fler än 50 000 flygrörelser per år."},{"@language":"sv","@value":"The dataset contains noise surveys in accordance with the Swedish Environmental Noise Ordinance, conducted in 2007, 2012, 2017 and 2022. The survey 2022 includes estimated noise for state roads and railways with, respectively, a traffic exceeding 3 million vehicles, and 30 000 trains annually, as well as airports with more than 50 000 flight movements per year."}],"dct:identifier":"21518b1b-5282-415e-b42b-b83b38047f84","dct:isReferencedBy":[{"@id":"https://geodatakatalogen.naturvardsverket.se/geonetwork/srv/swe/catalog.search#/metadata/496610ab-f75d-4e65-85f4-1a52a18e8cad"},{"@id":"https://www.geodata.se/geodataportalen/srv/swe/catalog.search#/metadata/496610ab-f75d-4e65-85f4-1a52a18e8cad"}],"dct:issued":{"@type":"xsd:date","@value":"2009-10-20"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:gYear","@value":"2021"},"dct:provenance":{"@id":"_:4b48e0908f85b43a1dbb72c6fd9e6e878e7125b8f72166ca79f377e81aec82cf_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:4b48e0908f85b43a1dbb72c6fd9e6e878e7125b8f72166ca79f377e81aec82cf_b3n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/PriorityDataset/Directive-2002-49"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/PriorityDataset/MajorAirportsNoiseExposureDelineation-dir-2002-49"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/PriorityDataset/MajorRailwaysNoiseExposureDelineation-dir-2002-49"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/PriorityDataset/MajorRoadsNoiseExposureDelineation-dir-2002-49"},{"@id":"http://inspire.ec.europa