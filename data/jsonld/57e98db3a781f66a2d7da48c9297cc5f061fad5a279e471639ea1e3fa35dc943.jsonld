://metadata.trafikverket.se/concepts/Database/stvdb"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med presentation av dataprodukspecifikationer."},"dct:title":{"@language":"sv","@value":"Informationssida: Dataproduktspecifikationer för väg- och vägtrafikdata"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157_b10n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:f492f5fbf9e5c1c362af5b13dcbf3a8e7e29de56d7ea5647d87d050104ed2157"},{"@graph":[{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:hasPart":[{"@id":"https://metadata.trafikverket.se/store/89/resource/2"},{"@id":"https://metadata.trafikverket.se/store/89/resource/3"},{"@id":"https://metadata.trafikverket.se/store/89/resource/4"},{"@id":"https://metadata.trafikverket.se/store/89/resource/5"}],"dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/89/resource/2"},{"@id":"https://metadata.trafikverket.se/store/89/resource/3"},{"@id":"https://metadata.trafikverket.se/store/89/resource/4"},{"@id":"https://metadata.trafikverket.se/store/89/resource/5"}],"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten avser bärighetsklassning på väg hämtad från föreskrifter om bärighetsklass enligt 4 kap 11 § trafikförordningen (1998:1276).\n\nDataprodukten innehåller attribut som anger bärighetsklass. Föreskrifter skrivs endast för undantag från den generella trafikregeln som innebär att statliga vägar har bärighetsklass 1 (BK1) och kommunala vägar har bärighetsklass 2 (BK2). Dock finns såväl generella värden som värden från trafikföreskrifter med i produkten. Innebörden av värdena för attributet bärighetsklass framgår av 4 kap 12 § trafikförordningen och reglerar både bruttovikt och axel-boggitryck i olika kombinationer för de olika bärighetsklasserna. Bärighetsklass förekommer inte på det enskilda vägnätet.\n\nPå det vägnät som heter BK4 får man köra med laster upp till 74 ton utan restriktioner på fordonet. På vägnätet som heter BK 4 särskilda villkor får man åka med fordon utan restriktioner om fordonet är registrerat i vägtrafikregistret före 31 december 2018. Är fordonet registrerat efter den 31 december gäller följande: På vägnätet som heter BK 4 särskilda villkor får man åka med fordon som har dubbelmonterade hjul och luftfjädring eller likvärdig fjädring, eller att drivaxlarna är försedda med dubbelmonterade hjul och vikten inte överskrider 9.5 ton på någon av axlarna. För fordonståg gäller dessutom att om bruttovikten överstiger 64 ton ska minst 65 procent av släpvagnens eller släpvagnarnas sammanlagda bruttovikt belasta axlar försedda med dubbelmonterade hjul.\n\nI de nordliga länen förekommer vägar som har en lägre bärighetsklass (BK2 eller BK3) på sommarhalvåret och en högre bärighetsklass på vintermånaderna. I de fall detta förekommer registreras i denna produkt vilken bärighetsklass som gäller för respektive period, vilket anges med datum.\n\nEn kort beskrivning av hur de olika bärighetsklasserna står i relation till varandra finns beskrivet nedan.\n\n- BK1 - Högre tillåten vikt för fordon och last än BK2 och BK3 (se trafikförordningen för detaljerad information om vikter).\n- BK2 - Högre tillåten vikt för fordon och last än BK3 men mindre än BK1.\n- BK3 - Mindre tillåten vikt för fordon och last än BK2.\n- BK4 - Högre tillåten vikt för fordon och last än BK1 på särskilt utpekat vägnät.\n- BK4 - Särskilda villkor - Högre tillåten vikt för fordon och last än BK1 på särskilt utpekat vägnät, med särskilda villkor på fordon i enligt bärighetsförskrifterna.\n\nPå det statliga vägnätet läggs informationen på den utpekade vägsträckningen enligt föreskriften samt dess \"tvärlänkar\", sidoanläggningar, driftvändplatser och ”spanska vänstersvängar”, se exempelbilderna nedan.\n\nDataprodukten innehåller även attributet Beteckning som är ett löpnummer för trafikföreskriften i STFS som tilldelas av beslutsmyndigheten, består av organisationskod, årtal och ett nummer som är löpande för kalenderår. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n0"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n1"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n10"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n6"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n4"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n5"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n0"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n1"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n10"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n4"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n5"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n7"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n8"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n9"}]},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n7"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n8"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b10n9"},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:f5588a1824d6bf9c9d28536b8006a57697e984b5afc9be554570a37f41444ebd_b13n3"}},{"@id":"_:f5588a1824d6bf9c9d28536b8006a