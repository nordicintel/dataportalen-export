,"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0e501d343687413f56e55ffa87cfdaa15de4e6cbfcfcf33c9e81d1eaf1e578f1_b28n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:0e501d343687413f56e55ffa87cfdaa15de4e6cbfcfcf33c9e81d1eaf1e578f1"},{"@graph":[{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Mätdata (tillståndsdata) kommer från vägytemätningar som Trafikverket beställer. Dessa utförs varje eller vartannat år beroende på vägkategori.\n\nÅtgärderna kommer från inrapporteringar av utförda vägåtgärder (beläggningsåtgärder eller avvattningsåtgärder på statliga vägar) som görs av Trafikverksprojekt. \n\nVägnät och vägdata, förutom beläggningsdetaljerna och mätdata, hämtas från Trafikverkets nationella vägdatabas."}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n3"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n0"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b4n0","@type":"dct:L