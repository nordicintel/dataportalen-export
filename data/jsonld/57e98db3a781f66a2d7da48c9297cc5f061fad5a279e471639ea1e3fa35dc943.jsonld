e/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:9abc3e41d10c3ca4f4335fad2be48aa4e02c1fa10a085a02c4d4df7e972eb59c"},{"@graph":[{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n0"},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nVägnät där väghållare är statlig - från ansvarig informationsförvaltare på Trafikverket. \n\nVägnät där väghållare är kommunal - från ansvarig informationsförvaltare på Trafikverket. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från ansvarig informationsförvaltare på Trafikverket. \n\nVägnät där väghållare är kommunal - från ansvarig informationsförvaltare på Trafikverket.\n\n Vägnät där väghållare är enskild och ligger inom kommuns leveransområden - från ansvarig informationsförvaltare på Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n3"},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n4"}]},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. Dataleverantörer kan leverera via: Informationsförvaltaren som förser ajourhållningen med förändringen antingen via uppdaterat underlag eller via godkänt system. För mer information om leveranser se referens #101."}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b10n0"}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/882"}]},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:9d2ea6b3329e2985b2d333bf303d91bc3dbc688eb5a89f24974896239ec95f7f_b12n0","@type"