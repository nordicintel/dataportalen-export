kverket.se/store/4/resource/14"},"dcat:endpointURL":{"@id":"https://nvdbpakarta.trafikverket.se/map"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"},{"@language":"sv","@value":"karttjänst"},{"@language":"sv","@value":"map service"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=187&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2024-02-23"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Webbapplikation som gör det möjligt att se Sveriges alla vägar och cykelvägar som finns lagrade i Nationella vägdatabasen (NVDB). Man kan välja att titta på flera olika egenskaper (dataslag) som gäller för en vissa sträcka. Det är också möjligt att rapportera felaktigheter i det data som visas och är du leverantör av data till Nationella vägdatabasen kan du även rapportera förändringar."},"dct:identifier":"b936f118-81a8-4e59-84bb-1aaa6b7865c0","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-10-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b14n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanWorkflowEnactmentManager"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NVDB på karta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"ae20d31d-c316-4d73-aab1-8bdc9dc68633","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b15n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/674","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1473"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1475"},{"@id":"https://metadata.trafikverket.se/store/1/resource/760"},{"@id":"https://metadata.trafikverket.se/store/1/resource/818"},{"@id":"https://metadata.trafikverket.se/store/1/resource/924"}],"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=674&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:alternative":{"@language":"en","@value":"Trunk Road Network"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1025Stamv%C3%A4g.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2011-01-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Det nationella stamvägnätet utgör en del av det svenska huvudvägnätet och består av vägar som är av en särskilt stor betydelse för landets välfärdsutveckling. För att en väg ska ingå i det nationella stamvägnätet ska minst ett av nedan angivna kriterier var uppfyllda:\n\n1.\tStamvägnätet ska bidra till att sammanbinda landsdelar och de största befolkningskoncentrationerna, såväl i nord-sydlig som öst-västlig riktning. De vägar som ingår i stamvägnätet ska ha en övergripande funktion och vara vägar som är så betydelsefulla för landet att prioritering av åtgärder på dessa vägar kräver hantering på nationell nivå och inte kan göras beroende av investeringar inom ett län.\n\n2.\tEn väg som är av betydelse för den internationella trafiken ska ingå i stamvägnätet. Därmed ska samtliga europavägar ingå. Därutöver kan andra övergripande vägar av internationell betydelse ingå om dessa utgör en gränspassage eller anknyter till en hamn med betydande godsvolymer eller med internationell färjetrafik eller till en flygplats med internationell trafik."},"dct:identifier":"d71eb659-4245-4ccb-a9d3-3785ac968575","dct:issued":{"@type":"xsd:date","@value":"2011-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b16n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b17n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b18n0"},"dct:title":{"@language":"sv","@value":"Stamvägnät"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}],"http://entryscape.org/terms/metadataIdentifier":"a6e3c117-b043-434a-a3dc-7505cf52044e","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:eb0178c5f1cb243f3ee7a9e0a1ee258204b771161c9957106b82156d40fb147a_b19n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProcessingMethod/Aggregation"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/STVDB_AdministrativeData"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/StateRoadNetworkDataSTVDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/RoadAuthority/term2"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/C"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://data.trafikverket.se"},"dcat:keyword":[{"@language":"en","@value":"download service"},{"@language":"sv","@value":"nedladdningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikv