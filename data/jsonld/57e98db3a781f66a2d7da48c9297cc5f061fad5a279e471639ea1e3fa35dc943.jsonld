I – European standard for traffic and travel information"},{"@language":"sv","@value":"DATEX II – Europeisk standard för trafik- och reseinformation"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/1800","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/56"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1802"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1803"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1804"}],"dcat:keyword":[{"@language":"en","@value":"road - traffic information"},{"@language":"sv","@value":"väg - trafikinformation"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"sv","@value":"TravelTimeRoute: Datex II"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://datex2.eu/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Restider på väg i större städer eller i högbelastade trafiksystem. Beräkning av restid baseras på data från Trafikverkets detektorer samt inköpta restider och beräknas för förutbestämda restidsrutter (utbredning på vägnätet).\n\nDatamängden har utökats med följande fält: VersionId"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:bf38784e4606e4c957