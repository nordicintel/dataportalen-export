_b36n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n3"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b37n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b38n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n3"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n0"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b39n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b3n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b3n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b3n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"en","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten består av företeelser med utbredningar som är knutna till vägnätet. \n\nDataprodukten innehåller uppgifter om överfarter, underfarter samt tunnlar som tillåter trafik. Förekommer bl.a. vid broar, planskilda korsningar, vägportar samt tunnlar. Detta för att visa var det finns konstruktioner som tillåter trafik över eller under vattendrag, dalgångar, vägar, byggnader, järnvägar, gång- och cykelvägar eller genom berg eller jord. \n\nDet är bara för konstruktioner av typen \"överfart\", \"tunnel\" samt \"överfart och underfart\" som längden anges. För typen \"överfart och underfart\" är det överfartens längd som anges. Konstruktionens längd mäts vanligen i väglinjen. Beroende på konstruktionstyp mäts längden olika. \n\nKonstruktioner av typen vägtrumma levereras ej. Som vägtrumma räknas konstruktion med teoretisk spännvidd mindre än eller lika med 2,0 m i största spannet. \n\nI attributet \"Namn\" anges endast unika BaTMan-namn, det vill säga de särskilda namn som finns i Trafikverkets konstruktionsdatabas BaTMan. Finns inget sådant namn lämnas attributvärdet tomt. För att ange beslutade, officiella namn, används attributet \"Officiellt namn\". Kommunala och statliga konstruktioner namnges endast av respektive väghållare. \nBåda namnen kan finnas samtidigt på en konstruktion, då de uppfyller olika syften. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b40n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b41n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b42n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b43n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n0"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n1"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n10"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n11"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n2"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. Bro och tunnel ska levereras för bil-, gång- och cykelnät. Tunnel: En tunnel är en för trafik anordnad passage som vanligtvis omges av berg, jord eller vatten och som mynnar i dagen. Objekten kan vara antingen en enkel tunnel eller ett system av sammanhängande tunnlar. Varje enskild tunnel registreras som en företeelse med en eller flera utbredningar. OBS! I dagligt tal säger man ofta \"gångtunnel\" eller \"cykeltunnel\" men det rör sig i de allra flesta fall om en vanlig underfart. Överfart: En överfart beskriver en passage för trafik via en konstruktion av typen bro. Underfart: Underfarter registreras vid planskilda korsningar eller vägportar. En underfart beskriver passagen under en konstruktion som oftast är en bro. Om underfarten går under flera broar skall det vara mindre än 10 meter mellan dem för att underfarten skall registreras med en enskild utbredning. I annat fall blir det två eller flera utbredningar. Överfart och underfart: I ett fåtal trafikplatser kan samma vägsträcka vara både en överfart och en underfart. Utbredningens längd är i dessa undantagsfall troligen olika för överfarten resp. underfarten på den väg som ligger i det mellersta planet. Välj den utbredning som är längst. OBS Då det inne i en tunnel finns en överfart (sådana finns!) så går överfarten tyvärr inte att registrera. Identitet: På det statliga vägnätet och på vägar med statligt driftbidrag används konstruktionsnumret från Trafikverkets brodatabas, BaTMan, som identifikationsbegrepp. Skogsnäringen har egna identiteter på sina konstruktioner och dessa läggs under detta attribut. De skogliga identiteterna ser ut enligt nedan: 999-löpnummer-Kod för bolag (ex 999-5468-100), om bron har ett Batman-id så behålls det. Löpnumret hämtas från broregistret. Koder för bolag: 100=Sveaskog, 200=SCA, 300=Biometria, 400=Stora Enso, 500=Holmen skog."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n4","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n5"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n5","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2006 förekommer dataprodukten i NVDB. Initial insamling av data skedde från Lantmäteriet som har levererat uppgifter om tunnlar och från Batman. Initial laddning har skett efter hand från kommunala leverantörer. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n3"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n7"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n6"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n7","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n0"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n1"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n10"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n11"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n2"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n6"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n8"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n9"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n8"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b4n9"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n0"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n1"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n10"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n11"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n2"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. Bro och tunnel ska levereras för bil-, gång- och cykelnät. Tunnel: En tunnel är en för trafik anordnad passage som vanligtvis omges av berg, jord eller vatten och som mynnar i dagen. Objekten kan vara antingen en enkel tunnel eller ett system av sammanhängande tunnlar. Varje enskild tunnel registreras som en företeelse med en eller flera utbredningar. OBS! I dagligt tal säger man ofta \"gångtunnel\" eller \"cykeltunnel\" men det rör sig i de allra flesta fall om en vanlig underfart. Överfart: En överfart beskriver en passage för trafik via en konstruktion av typen bro. Underfart: Underfarter registreras vid planskilda korsningar eller vägportar. En underfart beskriver passagen under en konstruktion som oftast är en bro. Om underfarten går under flera broar skall det vara mindre än 10 meter mellan dem för att underfarten skall registreras med en enskild utbredning. I annat fall blir det två eller flera utbredningar. Överfart och underfart: I ett fåtal trafikplatser kan samma vägsträcka vara både en överfart och en underfart. Utbredningens längd är i dessa undantagsfall troligen olika för överfarten resp. underfarten på den väg som ligger i det mellersta planet. Välj den utbredning som är längst. OBS Då det inne i en tunnel finns en överfart (sådana finns!) så går överfarten tyvärr inte att registrera. Identitet: På det statliga vägnätet och på vägar med statligt driftbidrag används konstruktionsnumret från Trafikverkets brodatabas, BaTMan, som identifikationsbegrepp. Skogsnäringen har egna identiteter på sina konstruktioner och dessa läggs under detta attribut. De skogliga identiteterna ser ut enligt nedan: 999-löpnummer-Kod för bolag (ex 999-5468-100), om bron har ett Batman-id så behålls det. Löpnumret hämtas från broregistret. Koder för bolag: 100=Sveaskog, 200=SCA, 300=Biometria, 400=Stora Enso, 500=Holmen skog."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n4","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n5"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n5","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2006 förekommer dataprodukten i NVDB. Initial insamling av data skedde från Lantmäteriet som har levererat uppgifter om tunnlar och från Batman. Initial laddning har skett efter hand från kommunala leverantörer. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n3"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n7"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n6"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n7","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n0"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n1"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n10"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n11"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n2"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n6"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n8"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n9"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n8"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b5n9"},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b6n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b6n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b6n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b8n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b8n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b9n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:c877130780f0529369e17987e5b1e04b8d5d458693046b8fa20332d106852864_b9n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.nvdb.se","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Nationell vägdatabas för dataanvändare och dataleverantörer (Trafikverket, Sveriges kommuner, skogsnäringen, Transportstyrelsen, Lantmäteriet)."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB - nationell vägdatabas"}},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1040Bro%20och%20tunnel.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"14.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten  Bro och tunnel. Dataprodukten omfattar data om överfarter, underfarter samt tunnlar på vägsträckor."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/179/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifi