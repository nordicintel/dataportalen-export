id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b17n0"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b18n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2009 förekommer företeelsen i NVDB. Inventeringar har skett 2013-2014 i 82 av landets kommuner. Inventeringen omfattade företeelser på vägar med funktionell vägklass 1-5 inom tättbebyggt område. Inventeringen gjordes på både kommunalt och statligt vägnät. Under 2015-2017 gjordes inventeringar på det nationella stamvägnätet, på övriga riksvägar samt på primära länsvägar (vägnummer 100-499) både inom och utom tättbebyggt område.\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet för Vägdata för beredning och registrering enligt uppgjorda avtal och processer.\n\nDataleverantörer\n\n- Statligt vägnät – från Trafikverket vid förändringar eller nybyggnation.\n\n- Kommunalt vägnät – från kommunerna vid förändring på det kommunala vägnätet enligt gällande avtal om leveranser till NVDB."}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b19n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b20n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n3"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n0"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b22n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n3"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n0"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b23n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b24n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c9c4c412_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:8055a543976006424d2a211cb0fd2bd0db81d7ab897559ab8172cd71c