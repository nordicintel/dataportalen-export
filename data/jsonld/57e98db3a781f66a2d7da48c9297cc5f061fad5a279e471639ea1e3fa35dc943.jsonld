ttps://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b8n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b9n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"