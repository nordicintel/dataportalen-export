daeaad6e62029dddfd29ff5a9418281c3b8b55_b26n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b26n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b26n0"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b26n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b26n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b27n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Network connection innehåller länkar som kopplar i hop noder i vägtransportnätet med noder i järnvägstransportnätet. Ursprungsdata samlades in under ett projekt för bytespunkter som färdigställdes 201. Datamängden ajourhålls inte, därför förekommer brister i matchning mot övriga datamängder som tillhör Inspire transportnätverk. Datamängden ska betraktas som testdata."}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b28n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b29n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n0"},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n3"},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n4"}]},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b2n0"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n2"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n0"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b30n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:4117c1043221e8a77f65076864daeaad6e62029dddfd29ff5a9418281c3b8b55_b31n0","http://www.w3.org/ns/prov#hadPlan"