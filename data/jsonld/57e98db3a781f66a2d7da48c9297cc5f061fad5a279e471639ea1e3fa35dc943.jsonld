tliga vägdata. Tjänsten används bl.a. av webbapplikationen Sveriges vägar på karta/NVDB på webb. NetInfoRoad Visar företeelser på vägnätet. Komplett förteckning över ingående företeelser finns i tjänstebeskrivningen för NetInfo. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:b898f1c12aac6753be65d8f2377a21b7ca5689321a8a987b2469d088fd542625_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för vägdata - NetInfoRoad"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"efd995a7-b92e-476b-b4c7-895d5ca89714","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:b898f1c12aac6753be65d8f2377a21b7ca5689321a8a987b2469d088fd542625_b23n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se