 järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet."}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n3"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n0"}},{"@id":"_:c7d0d9bc0e6c637ad2c1b9bbdee8a026112c5fb1e07b3af382fa9384b643959c_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c7