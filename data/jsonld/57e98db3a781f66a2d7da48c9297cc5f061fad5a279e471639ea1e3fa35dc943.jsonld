lan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b15n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n2"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n0"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b16n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n3"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n0"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b17n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b18n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. Mappningen mellan Inspire FunctionalRoadClass och Trafikverkets vägdata är fullständig.\n\n\nDatamängden FunctionalRoadclass är genererad ur från följande vägdataprodukter:\n\n- Funktionell vägklass"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b19n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b20n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n2"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n0"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b21n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n3"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n0"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b22n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b23n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n3"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n0"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:13e3e8d1f401f13fe38dfc855a5ac0941d3422e47ed9e51db3bd5dd512c708b1_b24n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/