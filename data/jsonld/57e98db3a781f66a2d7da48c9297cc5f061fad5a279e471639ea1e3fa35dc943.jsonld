":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.WaterTransportNetwork.WaterwayNode - view service"},"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d_b11n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:dcc89a24933562d807f11f6c689c251b9c33036b82cabbe748ed53165316ee3d"},{"@graph":[{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Denna dataprodukt markerar ett begränsat vägnät med vägar av provisorisk karaktär som registreras uteslutande för mycket stora byggprojekt, framför allt i storstadsmiljö. Provisoriska vägar registreras endast om de har en planerad varaktighet om minst två månader. \n\nProvisoriska vägar etableras t.ex. för att leda bort trafiken mot andra vägar när den befintliga vägen tas ur trafik. Ett annat fall är när en provisorisk väg byggs som en anslutning till ett nyöppnat projekt, där permanenta anslutningsvägar ännu inte färdigställts. Endast ett fåtal företeelsetyper registreras på dessa vägar och schablonvärden för t.ex. hastighet och bärighet används om inga särskilda trafikföreskrifter beslutats för den provisoriska vägen. \n\nProvisoriska vägar avslutas alltid i databasen när de upphör för gott att användas för fordonstrafik. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n0"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n1"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n10"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n6"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n4"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n5"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n0"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n1"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n10"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n4"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n5"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n7"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n8"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n9"}]},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n7"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n8"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b10n9"},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n3"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n0"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n3"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n0"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b17n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b18n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2017-01-01"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b19n3"}},{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb5d06efe2112964e7bf0845_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:dd283964368f35c77027476868ca6cd14eb0fd28cb