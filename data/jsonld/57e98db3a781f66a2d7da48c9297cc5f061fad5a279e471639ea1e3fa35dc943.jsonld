:{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:e603f364b0ff4811701883ae79b5e8b13f8d28175643d90d91b1a8672f4d6b7c_b5n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/thematicGoparameterCalculationService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"en","@value":"Railway Transport Network - Download Service (INSPIRE)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/download"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/f4d7a64a5cb84b6f919d5e4645e868c7/tjanstebeskrivning_inspire_tn_giltig-version.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"858ad0a1-1a6f-45dc-a950-44d3a833eeb1","http://www.w3.org/ns/adms#identifier":"TN.RailwayTransportNetwork.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:e603f364b0ff4811701883ae79b5e8b13f8d28175643d90d91b1a8672f4d6b7c_b6n1"},{"@id":"_:e603f364b0ff4811701883ae79b5e8b13f8d28175643d90d91b1a8672f4d6b7c_b7n1"}],"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/424","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/453"},{"@id":"https://metadata.trafikverket.se/store/1/resource/498"},{"@id":"https://metadata.trafikverket.se/store/1/resource/548"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=424&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"Järnvägsnät - Ägarmyndighet (INSPIRE)"},{"@language":"sv","@value":"TN.Järnväg.Ägarmyndighet"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2010-12-08"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the infrastructure owners of the railway according to he INSPIRE Transport Network (TN) specification OwnerAuthority."},{"@language":"sv","@value":"Datamängden redovisar järnvägens infrastrukturägare enligt Inspiretema transportnät (TN) OwnerAuthority.\n\nDatamängden går att komma åt via wms, wfs och nedladdning av förgenererade filer."}],"dct:identifier":"ed078984-ac49-44cb-add5-ec785504ab1b","dct:issued":{"@type":"xsd:gYear","@value":"2011"},"dct:language":{"@id":"http://publications.europa