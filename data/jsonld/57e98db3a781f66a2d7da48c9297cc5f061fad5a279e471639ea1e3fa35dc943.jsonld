iedAssociation":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b15n0"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b17n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b18n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-01-01"},"dcat:startDate":{"@type":"xsd:date","@value":"2023-01-01"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n3"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n0"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Centrumpunkt för trafikplatser i Sverige och med dess namn och nummer när sådana förekommer."}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b21n3"}},{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:42106a788fe757d3cecedb218e928c83f8b64317b34abd6a606aba749624b9c1_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:42106a788fe757d3cecedb218e928c83f