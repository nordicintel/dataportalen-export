/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b6n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NJDB på webb"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"a4430f27-339d-4abc-b29d-4d2b2e46f7dc","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b7n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b8n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b9n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b10n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:65e95409f558f62521a2d429580518a050a814cf3093dfcdcec2e159c99628c3"},{"@graph":[{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Data kommer dels från olika dataset som produceras utanför Trafikverket och några dataset som produceras på Trafikverket. Aktuella dataset är NH nationella höjddata, LAS data, Väglinjer från NVDB, Förskolor från SCB, Byggnader från Fastighetskartan, Hårda markytor från Fastighetskartan. Underlag till dataprodukten kommer dels från dataprodukter som produceras utanför Trafikverket, och dels från dataprodukter som produceras av Trafikverket. Dataset är bl.a. NH nationella GSD -höjddata grid 2+, Laser data, Väg-geometrilinjer från Trafikverket, Förskolor från SCB, Byggnader från GSD - Fastighetskartan, hårda markytor från GSD - Fastighetskartan. Någon inital laddning av data sker inte. Data skapas vid beställning. För att generera data enlig beställning används data från NH nationella höjddata, Väglinjer från NVDB, Förskolor från SCB, Byggnader från Fastighetskartan, Hårda markytor från Fastighetskartan Någon initial laddning av dataprodukten sker inte. Generering av dataprodukten skapas vid beställning av data. Ajourhållning av data sker i underliggande dataset. Dessa är NH nationella höjddata, LAS data, Väglinjer från NVDB, Förskolor från SCB, Byggnader från Fastighetskartan, Hårda markytor från Fastighetskarta. Ajourhållning av dataprodukten sker inte. Uttag av dataprodukten skapas vid beställning och får ett datum för att kunna tidsbestämma underliggande data."}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n3"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n0"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b4n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/contentassets/921c2de120b4449fbc0e8119bb721c45/geodata-for-bullerberakningar.pdf","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dataproduktspecifikation i PDF format.\n\nDataprodukten Geodata för bullerberäkningar är en bearbetad sammanställning av grunddata från olika producenter för användning i bullerberäkningsprogram. Dataprodukten omfattar dataset med byggnader, höjddata, förskolor, hårda ytor och vägytor.\n\nDataseten är framtagen främst utifrån Nordisk beräkningsmodell för buller 1996. Vid en bullerberäkning för en väg- eller järnvägssträcka behöver Geodata kompletteras med någon av dataprodukterna Vägdata för bullerberäkningar eller Järnvägsdata för bullerberäkningar.\n\nDataproduktens geografiska utbredning bestäms av det aktuella utredningsområdet i en viss bullerutredning. Dataseten generas vid beställning i samband med en bullerutredning."},"dct:title":{"@language":"sv","@value":"DPS: Geodata för bullerberäkningar"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om de dataprodukter som varken kan kopplas direkt till väg eller järnväg, så kallade omgivande geodata, eller är dataprodukter skapade som en kombination av både väg- och järnväg."},"dct:title":{"@language":"sv","@value":"Informationssida: Omgivande geodata och kombinerade väg-järnvägsdataprodukter"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/986","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:keyword":[{"@language":"en","@value":"Data packages and special products"},{"@language":"sv","@value":"Datapaket och specialprodukter"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=986&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:alternative":{"@language":"en","@value":"Geodata for Noise Calculations"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2017-11-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten Geografisk data för bullerberäkningar är en sammanställning av olika dataset för användning i bullerberäkningsprogram. \n\nFör bullerberäkningar generellt används bl.a. spårdata, vägdata, höjddata, data om bullerskydd och trafikdata. Data är aggregerat och homogeniserat. Dataprodukten är ett extrakt av data som definieras av gränsen för ett utredningsområde. Dvs. geografisk täckning bestäms av det aktuella behovet i en viss bullerutredning. \n\nDataseten generas vid beställning från exempelvis en bullerutredning. Dataprodukten Geodata för bullerberäkningar är en bearbetad sammanställning av grunddata från olika producenter för användning i bullerberäkningsprogram. Dataprodukten omfattar dataset med byggnader, höjddata, förskolor, hårda ytor och vägytor. Vid en bullerberäkning för en väg- eller järnvägssträcka behöver Geodata kompletteras med någon av dataprodukterna Vägdata för bullerberäkningar eller Järnvägsdata för bullerberäkningar. \n\nSyftet med dataprodukten är att tillhandahålla standardiserade underlag till bullerberäkningar vilket i sin tur ger effektivare och säkrare hantering av information i bullerutredningar. På sikt förväntas ett standardiserat underlag göra att jämförbarhet mellan olika bullerutredningar ökar. Väg-, järnvägs- och trafikdata syftar till att beskriva bullerkällan medan byggnader, topografi och hårda ytor används för att beräkna hur ljudet utbreder sig i omgivningen."},"dct:identifier":"46c70131-6134-46a4-844b-3c62a0f6d9b6","dct:issued":{"@type":"xsd:date","@value":"2017-11-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/5624"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b2n0"},"dct:title":{"@language":"sv","@value":"Geodata för bullerberäkningar"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/921c2de120b4449fbc0e8119bb721c45/geodata-for-bullerberakningar.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.org/terms/metadataIdentifier":"50e32ee9-c5b3-4c26-b7c9-4fcbcda41396","http://www.w3.org/2000/01/rdf-schema#comment":{"@language":"sv","@value":"Data ajourhålles genom underliggande dataset. Dataprodukten ajourförs inte i egentlig mening. När data genereras får de aktualitet från underliggande dataset."},"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":[{"@language":"sv","@value":"För att få tillgång till dataprodukten krävs att en beställning gjorts till den angivna adressen för kontaktuppgift. Tillgång till dataprodukten ges endast i samband med bullerberäkningar som utförs i Trafikverkets regi och till de aktörer som utför dessa bullerberäkningar."},{"@language":"sv","@value":"Ingen begränsning"}],"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/CM_DataPackagesAndSpecialProducts"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/cross-modal-data-products"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/cross-modal"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87_b4n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:65f51149430e60cc0860a425cac0d2320e06c2fccce5f030a4c76a35bc9f8b87"},{"@graph":[{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Mätdata (tillståndsdata) kommer från vägytemätningar som Trafikverket beställer. Dessa utförs varje eller vartannat år beroende på vägkategori.\n\nÅtgärderna kommer från inrapporteringar av utförda vägåtgärder (beläggningsåtgärder eller avvattningsåtgärder på statliga vägar) som görs av Trafikverksprojekt. \n\nVägnät och vägdata, förutom beläggningsdetaljerna och mätdata, hämtas från Trafikverkets nationella vägdatabas."}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n3"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n0"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b4n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b5n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b5n3"}},{"@id":"_:66276c051e25441aaa9e237a5abc09d05dbbbf7c8cc02162031652843ea99b8f_b5n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:66276c051e25441