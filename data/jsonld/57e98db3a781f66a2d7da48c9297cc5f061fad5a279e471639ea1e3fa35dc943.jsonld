rg/ns/prov#wasUsedBy":{"@id":"_:0a691e1153a1503839a00622313ad1234d2bc9048679430d159392dd050b8a61_b3n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0a691e1153a1503839a00622313ad1234d2bc9048679430d159392dd050b8a61_b4n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/68","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - JBS datadelning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:jbsdatadelning@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:0a691e1153a1503839a00622313ad1234d2bc9048679430d159392dd050b8a61"},{"@graph":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser internt från Trafikverket. Underlag för ajourhållning fångas vid verksamheten för underhåll av parkeringsfickor eller vid investeringsverksamheten för nya parkeringsfickor."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n1"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n10"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n6"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n4"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n5"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n1"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n10"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n4"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n5"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n7"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n8"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n9"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n7"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n8"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b10n9"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b17n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b18n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/208/resource/5"},{"@id":"https://metadata.trafikverket.se/store/208/resource/6"}],"http://schema.org/text":{"@language":"sv","@value":"Med parkeringsficka avses ett utrymme utanför vägbanan, oftast i form av en längsgående utvidgning, men också som avskild gren avsedd för tillfällig parkering. Parkeringsfickor märks ut med, av Transportstyrelsen definierat anvisningsmärke E19, parkering. För att alla typer av fordon skall kunna använda parkeringsfickan bör den rymma en stor lastbil med släp (25,25 m), vilket alternativt ger fyra personbilsplatser.\n\nParkeringsficka beskrivs antingen som (a) en sidouppdelad punktutbredning på vägnätet (mitt på den sträcka där parkeringsfickan har sin fulla bredd) eller som (b) en punktutbredning på parallell vägslinga (lägesangivelsen görs då mitt på den parallella vägslingan oavsett väghållartyp).\n\nDataprodukten kan i förekommande fall även innehålla information om utbudet av faciliteter såsom sopkärl, bord och stolar, molok samt toaletter.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till väg-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b22n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b23n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b24n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n3"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b26n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b27n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b28n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n1","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser internt från Trafikverket. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6.\n\nParkeringsficka ska finnas på statligt vägnät där utmärkning skett med märke E19. Parkeringsficka ska anknytas till bilnätet med punktutbredning.\n\nFör de parkeringsfickor som ligger avskilt från vägen och därmed sannolikt är en \"rastplatsliknande\" anläggning ska samtliga attribut levereras. För de parkeringsfickor som utgör en utvidgning längs vägen behöver endast attributet Placering levereras. Det kan dock vara lämpligt att redovisa övriga attribut förekomst av sopkärl, toalett, bord med sittplatser, och molok för att underlätta för bl.a. underhållsverksamheten. Attributet Placering ska användas för att särskilja parkeringsfickor som ligger längs vägbana från de som ligger avskilt från vägbanan. I förekommande fall anges även namn på rastplats.\n\nParkeringsficka beskrivs antingen som (figur 1) en sidouppdelad punktutbredning på vägnätet mitt på den sträcka där parkeringsfickan har sin fulla bredd, utspetsningen räknas inte. Alternativt beskrivs läget som (figur 2) en punktutbredning på parallell vägslinga. Lägesangivelsen görs då mitt på den parallella vägslingan. Notera att för alternativ (b), figur 2, ska parkeringsfickan placeras på parallell vägslinga oavsett väghållartyp på denna."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling har skett i två steg. Vid första steget togs läget för cirka 3000 parkeringsfickor från vägscanning som genomfördes 2016. Där dessa låg inom ett avstånd på 100m från en befintlig rastficka ersattes dataprodukten Rastficka med läget från vägscanningen då detta ansågs mer korrekt. I ett andra steg överfördes resterande företeelser från dataprodukten Rastficka till dataprodukten Parkeringsficka utan att lägeskorrigering gjordes.\n\nBåde Rastficka initialladdades tidigare med underlag från Trafikverkets planeringsorganisation genom den regionala rastplatssamordningen på det statliga vägnätet.\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n1"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n4"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n5"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n5"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b3n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/882"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b3n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b3n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b4n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b4n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b4n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b5n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b5n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b5n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n3"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n4"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b6n0"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b8n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b9n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b9n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.nvdb.se","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Nationell vägdatabas för dataanvändare och dataleverantörer (Trafikverket, Sveriges kommuner, skogsnäringen, Transportstyrelsen, Lantmäteriet)."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB - nationell vägdatabas"}},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1027Parkeringsficka.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"3.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Parkeringsficka. Dataprodukten Parkeringsficka omfattar data om utrymme utanför vägbanan, oftast i form av en längsgående utvidgning, men också som avskild gren avsedd för tillfällig parkering."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/208/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},"dct:title":[{"@language":"en","@value":"Lay-by - Data Product Specification"},{"@language":"sv","@value":"Parkeringsficka - Dataproduktspecifikation"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e0faf1739d244cb384aadf8c1f7a91dd/introduktion-till-nvdbs-vagnat-och-foreteelser.pdf"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/leverera-in-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/extern-kvalitetskontroll/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"2026-09-01 \nReviderad och anpassad till nytt format av standard för dataproduktspecifikationer."},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b0n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b1n0"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b2n3"},{"@id":"_:0a721426478054e986a2014814bc029c9ddff1e5e06faa4722b467bb92be04fc_b3n1"},{"@id":"https://metadata.trafikverket.se/concepts/dps"}],"https://def.isotc211.org/model/19137-1/dataQualityInfo":{"@id":"https://metadata.trafikverket.se/store/208/resource/12"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/STVDB_RoadDesign"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/StateRoadNetworkDataSTVDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1055referenslinjetillkomst.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"8.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Referenslinjetillkomst. Dataprodukten omfattar data om den process som skapat och hanterat data om referenslinjen."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/236/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},"dct:title":[{"@language":"en","@value":"Reference line lineage - Data Product Specification"},{"@language":"sv","@value":"Referenslinjetillkomst - Dataproduktspecifikation"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e0faf1739d244cb384aadf8c1f7a91dd/introduktion-till-nvdbs-vagnat-och-foreteelser.pdf"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},