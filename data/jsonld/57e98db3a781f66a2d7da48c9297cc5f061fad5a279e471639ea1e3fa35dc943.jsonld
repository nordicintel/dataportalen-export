ce"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=963&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En applikation där det finns information om fordonsflödet på statliga vägnätet. Här presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation.\nObservera att det finns två flikar i kartan, flik TFK och flik TIKK."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3_b26n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Vägtrafikflödeskartan (TIKK/TFK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"80e6bb4f-9d2e-416b-ad22-c57942520795","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3_b27n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3_b28n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3_b29n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3_b30n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:761a3e8717bdeeb5ec7684345533a3e0d0589ad4b586ec980b26ae7f117093a3"},{"@graph":[{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n0"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial laddning av NVDB genomfördes för statlig väg genom att använda data från dåvarande Vägverkets vägdatabank (VDB) där förändringar ajourhållits kontinuerligt sedan 1980. Även dåvarande Väginformationskartan var initial källa för statligt vägnät.\n\n¤ Datakällor för ajourhållning\n\nLänsstyrelsen är beslutande myndighet men respektive vägmyndighet rapporterar underlag för sina vägar."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n3","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b10n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b15n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b16n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data skedde 2001 vid den initiala laddningen av NVDB genom att för statlig väg använda data från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980. Även dåvarande Väginformationskartan var initial källa för statligt vägnät.\n\n\nLänsstyrelsen är beslutande myndighet men respektive vägmyndighet rapporterar underlag för sina vägar."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b17n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b18n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b19n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b1n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b1n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b1n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b22n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b23n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b24n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n3"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b26n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b27n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b28n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n0"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n3"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n4"}]},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b2n0"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b3n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b3n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b3n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b4n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b4n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b4n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b5n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b5n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b5n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n0"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n1"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n10"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n6"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n4"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n5"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n0"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n1"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n10"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n4"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n5"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n7"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n8"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n9"}]},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n7"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n8"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b6n9"},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b8n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b8n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b9n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:776294f48c1a9c573f39b2a9b8d15b5b06665307dfa4769c2c040109c1b763c2_b9n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/text":{"@language":"sv","@value":"Under 2023-2024 genomfördes ett pilotprojekt (Översyn av rekommenderad väg för farligt gods) av Trafikverket i egenskap av informationsförvaltare för dataprodukten Rekommenderad väg för farligt gods. Medverkande i pilotprojektet var Trafikverket, Myndigheten för samhällsskydd och beredskap (MSB) och länsstyrelsen i följande län: Gävleborg (fram till våren 2024), Halland, Norrbotten (fram till våren 2024), Skåne, Stockholm och Västra Götaland.  \n\nSyftet var att tydliggöra vad som menas med en rekommenderad väg för transporter av farligt gods och vilka principer som gäller för de utpekade vägarna och skapa en enhetlighet av vägarna i hela landet. \n\nMan fastslog att en rekommenderad väg för farligt gods är en sådan utpekad väg som i första hand bör användas vid transporter av farligt gods. Med farligt gods avses de ämnen och föremål som omfattas av de föreskrifter som Myndigheten för samhällsskydd och beredskap (MSB) meddelat med stöd av gällande lagstiftning om transport av farligt gods (ADR-S). Det rekommenderade vägnätet för farligt gods utgör ett sammanhängande vägnät. Vägnätet delas upp i primärt och sekundärt vägnät för att lättare kunna styra trafiken med farligt gods till lämpliga vägar. \n\nEn primär väg för farligt gods är en allmän väg eller gata som huvudsakligen är avsedd för genomfartstrafik vid transporter av farligt gods. En sekundär väg för farligt gods är en kompletterande väg som ansluter målpunkter för farligt gods till det primära vägnätet. En sekundär väg är tänkt att användas för transporter till start- och målpunkter längs med den sekundära vägen och är inte avsedd för genomfartstrafik av transporter med farligt gods. \n\nPrimära vägar för farligt gods ska i första hand utgöras av europavägar, riksvägar och primära länsvägar (länsvägar med vägnummer 100 - 499). Alla typer av transporter är normalt tillåtna på det primära vägnätet. Det kan dock finnas restriktioner, t ex vid anslutning till tunnlar. Exempel på sådana restriktioner kan vara förbud för transporter av farligt gods nattetid. Varje kommun bör vara ansluten till det rekommenderade vägnätet för farligt gods, antingen via primär eller sekundär väg. Det ska finnas minst en primär väg genom varje län.  \n\nDet rekommenderade vägnätet för farligt gods behöver samordnas mellanregionalt för att skapa ett sammanhängande och varaktigt nationellt vägnät. Varaktigt vägnät syftar till att det utpekade vägnätet har behov av långsiktighet, vilket i sin tur innebär att man bör undvika att göra ändringar i det utpekade vägnätet till följd av kortsiktiga behov.  \n\nEn rekommenderad väg för farligt gods är den mest lämpliga vägen mellan olika start- och målpunkter och behöver därmed inte vara den kortaste vägen mellan punkterna. Exempel på start- och målpunkter för transporter av farligt gods är industrier, hamnar och kombiterminaler.  \n\nVid val av lämpliga vägar behöver bland annat nedanstående aspekter beaktas:  \n- Vid utpekande av rekommenderad väg ska hänsyn tas till vägbredd, vägens bärighetsklass och vilken typ av bebyggelse som finns utmed vägen.  \n- Om möjligt bör vägar vid tät bebyggelse, alternativt bebyggelse som inte är utformad med hänsyn till förekommande olycksrisker, undvikas som rekommenderade vägar för farligt gods. \n- Hänsyn behöver tas till förekomsten av skyddsvärda områden intill vägen, såsom vattentäkter och skyddad natur.  \n\nDär det finns alternativa vägval för att nå en viktig målpunkt för en farlig gods transport kan det finnas skäl att med lokaliseringsmärke ”F32 Farligt gods” märka ut det rekommenderade vägnätet. Exempel på sådana situationer kan vara om alternativa vägar är sårbara för olyckor med farligt gods eller där det finns förekomst av transittrafik. Användning av lokaliseringsmärke är särskilt viktigt för att kunna styra internationella transporter. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.nvdb.se","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Nationell vägdatabas för dataanvändare och dataleverantörer (Trafikverket, Sveriges kommuner, skogsnäringen, Transportstyrelsen, Lantmäteriet)."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB - nationell vägdatabas"}},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1055referenslinjetillkomst.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"8.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Referenslinjetillkomst. Dataprodukten omfattar data om den process som skapat och hanterat data om referenslinjen."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/236/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},"dct:title":[{"@language":"en","@value":"Reference line lineage - Data Product Specification"},{"@language":"sv","@value":"Referenslinjetillkomst - Dataproduktspecifikation"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e0faf1739d244cb384aadf8c1f7a91dd/introduktion-till-nvdbs-vagnat-och-foreteelser.pdf"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/omgivande-geodataoch-kombinerade-vag-jarnvagsdataprodukter/"},{"@id":"https://bransch.trafikverket.se/tj