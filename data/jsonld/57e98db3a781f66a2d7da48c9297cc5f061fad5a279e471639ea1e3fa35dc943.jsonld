","@value":"The reference data standard in Europe for road traffic and travel information."},{"@language":"sv","@value":"Den europeiska referensstandarden för vägtrafik- och reseinformation."}],"dct:title":[{"@language":"en","@value":"DATEX II – European standard for traffic and travel information"},{"@language":"sv","@value":"DATEX II – Europeisk standard för trafik- och reseinformation"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/1678","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/59"},"dcat:endpointURL":{"@id":"https://www.trafikverket.se/trafikinformation/vag/"},"dcat:keyword":[{"@language":"en","@value":"map service"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1678&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://datex2.eu/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2018-06-20"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"A data service that provides information on traffic conditions (incidents and roadwork with a significant impact on traffic), all roadwork, incidents causing road restrictions, rest areas, traffic safety cameras, traffic cameras, road weather with camera images, road surface conditions, road ferries, and frost damage."},{"@language":"sv","@value":"En applikation där det finns information om trafikläget (händelser och vägarbeten med stor påverkan på trafiken), alla vägarbeten, händelser med restriktioner på vägen, rastplatser, trafiksäkerhetskameror, trafikkameror, vägväder med kamerabilder, väglagsinformation, vägfärjor och tjälskador."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:b70f79035c8b665b20d057f05404c51ed1d14277e2913c28c83d69393810d3bd_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoCatalogueService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Trafikinformation vägkarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"01a9e018-8dd8-46b7-922e-f60f14f33547","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:b70f79035c8b665b20d057f05404c51ed1d14277e2913c28c83d69393810d3bd_b1n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/59","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Webb och projektstöd","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:webbochprojektstod@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:b70f79035c8b665b20d057f05404c51ed1d14277e2913c28c83d69393810d3bd"},{"@graph":[{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/image":{"@id":"https://metadata.trafikverket.se/store/173/resource/5"},"http://schema.org/text":{"@language":"sv","@value":"Befintliga trafikregler samlas i Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). Förbjuden sväng kan vara en följd av lokala trafikföreskrifter av typen Förbud att svänga eller köra i viss riktning och Förbud mot infart.\n\nDataprodukten innehåller uppgift om förbjuden sväng genom korsning. Den innehåller attribut som anger för vilka fordon den gäller och för vilka fordon/trafikanter den eventuellt inte gäller. Observera att förbjuden sväng även kan vara förbud mot att köra rakt fram i en korsning.\n\nDataprodukten innehåller ej förbjudna svängar som är följden av enkelriktningar eller förbud mot trafik.\n\nDataprodukten har en speciell representation då den beskrivs med svängutbredning. Läget för företeelsen anges genom att från-länk och till-länk för svängen samt noden där dessa länkar möts pekas ut. Informationen tillhandahålls i tabellform och kopplas ihop med länkar och noder i nätet. För mer information se \"Informationsdokument: Introduktion till NVDBs vägnät och  företeelser\" under kapitlet Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n0"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n1"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n10"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n6"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n4"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n5"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n0"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n1"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n10"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n4"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n5"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n7"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n8"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n9"}]},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n7"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n8"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b10n9"},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b13n3"}},{"@id":"_:b8059b3f206aebf2c2f39b114d0fec823f17b01b7fd2f5d1904b18ac54560bda_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:b8059b3f206aebf2c