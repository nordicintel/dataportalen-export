ata-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b21n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/780","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/orderdata/vag"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Brunn - Slamsugning - nedladdning i Lastkajen"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/881","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=881&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Road Data - View Service - NetInfo"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-11-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En WMS-tjänst (visningstjänst) som innehåller nätanknutna nationella (NVDB) och statliga vägdata. Tjänsten används bl.a. av webbapplikationen Sveriges vägar på karta/NVDB på webb. NetInfo visar företeelser på alla typer av vägnät. För att se ingående lager hänvisar vi till tjänstebeskrivningen för NetInfo, vilken innehåller en komplett lista för respektive tjänst. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för vägdata - NetInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"1ef16f56-348f-471d-8469-d5b212e9f690","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b23n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/888","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},"dcat:accessURL":{"@id":"http://geo-netinfo.trafikverket.se/MapService/wms.axd/NetInfo?layers=BrunnSlamsugning"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},"dct:description":{"@language":"sv","@value":"OBS: För åtkomst/visning, klistra in åtkomstadresslänken i lämplig programvara. Välj sedan lagret som motsvarar datamängden."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"NVDB Brunn - Slamsugning - visning i NetInfo"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/963","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://vtf.trafikverket.se/SeTrafikinformation"},"dcat:keyword":[{"@language":"en","@value":"map service"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=963&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En applikation där det finns information om fordonsflödet på statliga vägnätet. Här presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation.\nObservera att det finns två flikar i kartan, flik TFK och flik TIKK."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b24n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Vägtrafikflödeskartan (TIKK/TFK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"80e6bb4f-9d2e-416b-ad22-c57942520795","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b25n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b26n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b27n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97_b28n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:c9519d4b78afd7022c765de0c66928a876889bc77c5932b80f1e0ca95381ab97"},{"@graph":[{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten Storstadsväg markerar ett vägnät med vägar i storstadsregionerna Stockholm, Göteborg och Malmö med stor trafikvolym. Vägnätet har gemensamma egenskaper när det gäller särskilda behov av drift och underhåll främst kopplat mot framkomlighet. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n0"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n1"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n10"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n6"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n4"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n5"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n0"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n1"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n10"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n4"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n5"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n7"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n8"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n9"}]},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n7"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n8"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b10n9"},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n3"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n0"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:c9ec00b2dc13f941aa8a9b686ae7935343ce43014eb1dabd3c278800d0e8c4b9_b14n0","@type":"dct