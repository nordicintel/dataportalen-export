scription":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:b4033cd05191a101161c5ad1edb4ded1cfa5f120089e409cc9f90ed417b9c72b"},{"@graph":[{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Dataprodukter för järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet.\n\nDataprodukten ingår i NJDB – nationell järnvägsdatabas."}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9e8e3c7cacc1345a9d1_b3n3"}},{"@id":"_:b440b5c0eb933fdd61efcbcd454015a50474798cb092a9