-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1025Begr%C3%A4nsad%20fordonsbredd.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-07-01"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the Limited Width of vehicles and vehicle combination to a smaller width than otherwise applicable. These limitations are established by traffic regulation or other official decisions."},{"@language":"sv","@value":"Trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till mindre bredd på fordon eller fordonståg inkl. last än som annars gäller."}],"dct:identifier":"64f52c23-5e49-4749-ba4f-8613c01bdb07","dct:issued":{"@type":"xsd:date","@value":"2013-07-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b22n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b23n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:efeda1c25c5784fb2b7170aa0e63665fa9f03fe8cf116208483bc115f01107bb_b24n0"},"dct:title":{"@language":"sv","@value":"Begränsad fordonsbredd"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1025Begr%C3%A4nsad%20fordonsbredd.pdf"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"