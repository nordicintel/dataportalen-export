/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/anvandadata","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Beskrivning av tjänster för nedladdning och geodatatjänster"},"dct:title":{"@language":"sv","@value":"Informationssida: Använda data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Ingångssida för information om vägar, järnvägar och trafik"},"dct:title":{"@language":"sv","@value":"Informationssida: Data, kartor och geodatatjänster"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Informationssida med dataprodukter inom järnväg"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra järnvägsdata"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1029","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1110"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1178"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1367"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1542"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1543"}],"dcat:keyword":[{"@language":"en","@value":"NJDB"},{"@language":"sv","@value":"NJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=1029&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"en","@value":"Railway Data - Site"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-10-03"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten innehåller trafikplatsens signatur (förkortat namn) på alla spårlänkar som finns inom en trafikplats av typen driftplats, driftplats med driftplatsdelar eller linjeplats. Gränsen för de spårlänkar som ingår i en trafikplats är på spåret vid infartssignalerna till platsen från alla anslutande spår. Alla spårlänkar däremellan ingår i en trafikplats och har trafikplatsens signatur.\n\nDataprodukten har för varje unik signatur en förklaringstext som motsvarar hela namnet på trafikplatsen. Signaturen och platsnamnet är desamma som de som Transportstyrelsen fastställer. Exempel: Signatur Avky har förklaringstexten Avesta-Krylbo och signaturen N har förklaringstexten Nässjö Central.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens från nod till nod i spårlänkens riktning.\n\nProdukten är heltäckande inom driftplatser, driftplatser med driftplatsdelar och linjeplatser på Det svenska järnvägsnätet."},"dct:identifier":"2416ba00-ba09-4180-afec-e46d6d4bc588","dct:issued":{"@type":"xsd:date","@value":"2012-10-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:0d903f86dd49b3f94fa3c394d7a3b20c0278468fff4a4749c55377b4a8603528_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:0d903f86dd49b3f94fa3c394d7a3b20c0278468fff4a4749c55377b4a8603528_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:0d903f86dd49b3f94fa3c394d7a3b20c0278468fff4a4749c55377b4a8603528_b2n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Plats"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/term