/www.w3.org/ns/prov#generated":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b36n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b36n0"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b36n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b36n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n3"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n0"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b37n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b38n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. Mappningen mellan Inspire RoadName och Trafikverkets vägdata är fullständig.\n\nRoadName är genererat ur följande vägdataprodukter:\n\n- Gatunamn\n- Vägnummer\n- Övrigt vägnamn"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b39n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b3n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b3n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b3n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b40n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dc