erket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om Trafikverkets dataprodukter"},"dct:title":{"@language":"sv","@value":"Informationssida: Läs om våra data"}},{"@id":"https://data.trafikverket.se/documentation/datex/situation","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Sida för beskrivning av datamängden situation (trafiksituation) i Datex II."},"dct:title":{"@language":"sv","@value":"Informationssida: Beskrivning av situation (trafiksituation) i Datex II"}},{"@id":"https://metadata.trafikverket.se/store/1/resource/1638","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/23"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1639"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1640"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1644"}],"dcat:keyword":[{"@language":"en","@value":"road - traffic information"},{"@language":"sv","@value":"väg - trafikinformation"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Senaste mätdatat, samt metadata  från respektive vägväderstation. \n\nDatamängden innehåller information om väderläget längs vägarna baserat på rapporter från automatiska vägväderstationer. Innehåller data om luft- och yttemperatur, nederbörd, vindriktning och vindhastighet. \n\nVad källsystemet levererar är beroende av vilken utrustning mätstationen har och det kan förändras över tid.\n\nInformation för Datex II distributioner: \nDen här datamängden innehåller dynamiska data, (roa:siteMeasurements). I datamängden roa:measurementSite innehåller information om mätvärdesindex och mätpostens positioner."},"dct:issued":{"@type":"xsd:date","@value":"2022-09-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:provenance":{"@id":"_:7bd30f49d12690caafe64115cf11d1cf7c10c79bd003db2ec96683e69145338a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:7bd30f49d12690caafe64115cf11d1cf7c10c79bd003db2ec96683e69145338a_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":[{"@language":"en","@value":"WeatherMeasurepoint"},{"@language":"sv","@value":"WeatherMeasurepoint"}],"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://data.trafikverket.se/documentation/datex/situation"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},"http://entryscape.org/terms/metadataIdentifier":"c77efafd-da45-49b2-894f-8de44b6a53f9","https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/APIArea/api-public"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMod