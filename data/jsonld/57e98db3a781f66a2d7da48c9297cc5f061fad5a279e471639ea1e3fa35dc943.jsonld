d-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:c2fe37442bd8d7dda797badbc8d43a9c16034776ef1e5972dea8eed234f591ce_b4n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/57","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - TDIS förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tdis@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:c2fe37442bd8d7dda797badbc8d43a9c16034776ef1e5972dea8eed234f591ce"},{"@graph":[{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Dataprodukter för järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet."}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b3n3"}},{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:c30024c8727461f8987e3140bda9c81bddeafc6681780ac9ba058acfa2f49499_b3n2"},"http://www.w3.org