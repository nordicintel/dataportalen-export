c2e39704_b1n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"A Ajourhållning av dataprodukten sker genom att Trafikverket hämtar underlag från Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS) när ny eller förändrad föreskrift publiceras och registrerar den i NVDB."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b20n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.09,24.16 69.09,24.16 55.34,11.11 55.34,11.11 69.09))"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n3"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b21n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg_del/2022/670/oj"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b22n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör.\n\nData för ajourhållning finns i Transportstyrelsens rikstäckande databas för trafikföreskrifter (RDT) där Trafikverkets enhet Vägdata hämtar underlagen."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b23n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b24n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n3"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b25n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b26n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n3"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b27n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b28n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n3"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b29n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b2n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b2n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b2n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten innehåller attribut som anger hur hög begränsningen är för axeltryck, boggitryck eller trippelaxeltryck, vilken beteckning den har i STFS och vilka fordons- eller trafikanttyper begränsningen inte gäller. Med axeltryck, boggitryck eller trippelaxeltryck avses den sammanlagda statiska vikten som överförs från alla hjulen på en hjulaxel, boggi eller trippelaxel, uttryckt i enheten ton. \n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b30n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n3"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b31n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b32n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b33n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b34n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b3n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b3n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b3n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Dataprodukten innehåller attribut som anger hur hög begränsningen är för axeltryck, boggitryck eller trippelaxeltryck, vilken beteckning den har i STFS och vilka fordons- eller trafikanttyper begränsningen inte gäller. Med axeltryck, boggitryck eller trippelaxeltryck avses den sammanlagda statiska vikten som överförs från alla hjulen på en hjulaxel, boggi eller trippelaxel, uttryckt i enheten ton. \n\nTrafikföreskrifter som bara gäller i en riktning, dvs bara gäller åt ett håll längs vägen läggs inte in i NVDB. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n0"},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakälla för ajourhållning \n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n3"},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n4"}]},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b4n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n0"},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Initial insamling har skett från beslutade föreskrifter genom en datainsamling där Transportstyrelsen var dataleverantör. \n\n¤ Datakälla för ajourhållning \n\nDatakälla för ajourhållning är Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). STFS driftsattes under 2010."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n3"},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n4"}]},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Trafikverket hämtar kontinuerligt nya, upphävda och förändrade föreskrifter från STFS och registrerar dessa i NVDB. Tillfälliga föreskrifter som är gällande under 6 månader behandlas inte. Föreskrifter som är skrivna av Trafikverket och som gäller tjällossning registreras inte i NVDB. Dessa hanteras av entreprenörer och redovisas på Trafikinformation vägkarta (www.trafikverket.se). Föreskrifter som upprepas varje år ska också registreras (gäller inte en-två dagar och liknande). Kan vara hastighetföreskrifter som gäller varje år juni-augusti, alltså sänkt hastighet under sommarmånaderna där det är mycket trafik just då. Många myndigheter levererar sina föreskrifter med kartbilder. Det är de gator som nämns i texten som ska ha den företeelsetypen som nämns. Texten går alltid före kartbild ifall det skulle bli rättslig prövning. För varje företeelse ska information om tillkomst ingå och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b5n0"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b6n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b6n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b6n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/32"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/597"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"}]},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b8n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b8n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b9n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:44be19125e16a5a25b3c398d8facb4962b522da171b147534da518bac2e39704_b9n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"För varje förekomst av Referenslinjetillkomst kan ett eller flera processteg för referenslinjens skapande registreras. Detta möjliggör en beskrivning och spårbarhet av den process i vilken data har skapats och hanterats. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"http://dataportal.se/organisation/SE2021006297","@type":"foaf:Agent","dct:identifier":"2021006297","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:datasetsadmin@trafikverket.se"},"foaf:name":{"@language":"sv","@value":"Trafikverket"},"foaf:page":{"@id":"https://www.trafikverket.se"},"http://www.w3.org/2002/07/owl#sameAs":[{"@id":"https://catalog.sodertalje.se/store/9/resource/1851"},{"@id":"https://metadata.trafikverket.se/store/1/resource/178"}]},{"@id":"http://www.nvdb.se","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Nationell vägdatabas för dataanvändare och dataleverantörer (Trafikverket, Sveriges kommuner, skogsnäringen, Transportstyrelsen, Lantmäteriet)."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB - nationell vägdatabas"}},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19115–1"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata –  Part 1: Fundamentals"},{"@language":"sv","@value":"Geografisk information - Metadata –  Del 1: Grunder"}]},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SIS-TS 80:2018"},"dct:title":{"@language":"sv","@value":"Geografisk information - Nationell metadataprofil för geografisk information (Standard)"}},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1032Begr%C3%A4nsat%20axel-boggitryck.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"11.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Begränsat axel-boggitryck. Dataprodukten omfattar trafikregel, meddelad genom föreskrift eller annat beslut, om inskränkning till lägre axel- boggi- och trippelaxeltryck för fordon än som annars gäller."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/176/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2