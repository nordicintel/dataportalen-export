id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En applikation där det finns information om fordonsflödet på statliga vägnätet. Här presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation.\nObservera att det finns två flikar i kartan, flik TFK och flik TIKK."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b26n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Vägtrafikflödeskartan (TIKK/TFK)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"80e6bb4f-9d2e-416b-ad22-c57942520795","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b27n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/14","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Vägdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:nvdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b28n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b29n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5_b30n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:39a888aa50a58c7f53300a07210c576123ce5abd6d4fba17937992c2cfbaf3c5"},{"@graph":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Från 2001 förekommer företeelsen i NVDB. Initial insamling av data för statliga vägar hämtades från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen).\n\nUppgifter för övriga vägar hämtades från Lantmäteriet.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet Vägdata enligt uppgjorda avtal och processer."}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b10n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1050"},{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b10n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b10n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n3"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n0"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b4n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"757bfef01a33b7aa0ac7f5be65a1d0f918"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b5n0","dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2138","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/92dcc7d3-408c-4cf8-9892-0491ed19649b"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b6n0","dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2141","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/fcb6066f-471b-4b19-92ff-647c3a6e8250"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b7n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b7n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b7n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor."}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b8n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b8n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Regelverk för numrering har tagits fram i samarbete mellan Transportnät på VO Planering, Tillstånd väg på VO Underhåll och Vägdata på VO Underhåll. \n\nDataprodukten innehåller uppgifter om GCM-nummer, sträcknummer samt vilket vägnummer som GCM-vägen ligger intill. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitlet Identifiering av dataproduktspecifikationen/ Relaterad dataproduktspecifikation."}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n0"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n1"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n2","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Initiala datakällor: Numrering av statliga GCM-vägar genomförs under en sex-års period (start 2020) i samband med att kvalitetshöjning genomförs på de statliga gång- och cykelvägarna. Datakällor för ajourhållning: Vägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet."}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n3","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nNumrering av statliga GCM-vägar genomförs under en sex-års period (start 2020) i samband med att kvalitetshöjning genomförs på de statliga gång- och cykelvägarna. Det berör cirka 20 driftområden per år. GCM-numret ska vara helt fristående, inte kopplat geografiskt och unikt. Initialt används dock följande nummerserie som stöd vid nummersättning: \n\nRegion Väst 1000-1999\nRegion Stockholm 2000-2999\nRegion Öst 3000-3999\nRegion Mitt 4000-4999\nRegion Nord 5000-5999\nRegion Syd 6000-6999\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet"},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n2"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n5"}]},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n4","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n3"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n5","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n0"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n1"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n6"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n7"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n8"}]},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n6"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n7"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b9n8"},{"@id":"http://data.europa.eu/88u/dataset/https-metadata-trafikverket-se-store-1-resource-2129","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:distribution":[{"@id":"http://data.europa.eu/88u/distribution/92dcc7d3-408c-4cf8-9892-0491ed19649b"},{"@id":"http://data.europa.eu/88u/distribution/fcb6066f-471b-4b19-92ff-647c3a6e8250"}],"dcat:keyword":[{"@language":"en","@value":"NVDB"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=2129&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:alternative":{"@language":"en","@value":"Road number for pedestrian, bicycle and moped"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1053GCM-v%C3%A4gnummer.pdf"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-11-03"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Продуктът с данни включва данни за националната номерация на правителствените пътни участъци за GCM. GCM означава пешеходец, велосипед и мотопед."},{"@language":"cs-t-sv-t0-mtec","@value":"Datový produkt zahrnuje údaje o národním číslování vládních silničních úseků GCM. GCM je zkratka pro chodce, kolo a moped."},{"@language":"da-t-sv-t0-mtec","@value":"Dataproduktet indeholder data om den nationale nummerering af statslige GCM-vejstrækninger. GCM står for fodgænger, cykel og knallert."},{"@language":"de-t-sv-t0-mtec","@value":"Das Datenprodukt enthält Daten zur nationalen Nummerierung staatlicher GCM-Straßenabschnitte. GCM steht für Fußgänger, Fahrrad und Moped."},{"@language":"el-t-sv-t0-mtec","@value":"Το προϊόν δεδομένων περιλαμβάνει δεδομένα σχετικά με την εθνική αρίθμηση των κυβερνητικών οδικών τμημάτων GCM. GCM σημαίνει πεζός, ποδήλατο και μοτοποδήλατο."},{"@language":"en-t-sv-t0-mtec","@value":"The data product includes data on the national numbering of governmental GCM road sections. GCM stands for pedestrian, bicycle and moped."},{"@language":"es-t-sv-t0-mtec","@value":"El producto de datos incluye datos sobre la numeración nacional de las secciones gubernamentales de carreteras GCM. GCM significa peatón, bicicleta y ciclomotor."},{"@language":"et-t-sv-t0-mtec","@value":"Andmetoode sisaldab andmeid valitsuse GCMi teelõikude riikliku numeratsiooni kohta. GCM tähistab jalakäijaid, jalgrattaid ja mopeede."},{"@language":"fi-t-sv-t0-mtec","@value":"Tietotuote sisältää tietoja valtion GCM-tieosuuksien kansallisesta numeroinnista. GCM tarkoittaa jalankulkijaa, polkupyörää ja mopoa."},{"@language":"fr-t-sv-t0-mtec","@value":"Le produit de données comprend des données sur la numérotation nationale des tronçons routiers GCM gouvernementaux. GCM signifie piéton, vélo et cyclomoteur."},{"@language":"ga-t-sv-t0-mtec","@value":"Áirítear sa táirge sonraí sonraí maidir le huimhriú náisiúnta stráicí bóthair GCM rialtais. Seasann GCM do choisithe, do rothair agus do mhóipéidí."},{"@language":"hr-t-sv-t0-mtec","@value":"Podatkovni proizvod uključuje podatke o nacionalnom numeriranju državnih dionica GCM cesta. GCM označava pješake, bicikle i mopede."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adattermék a kormányzati GCM útszakaszok országos számozására vonatkozó adatokat tartalmaz. A GCM jelentése gyalogos, kerékpáros és moped."},{"@language":"it-t-sv-t0-mtec","@value":"Il prodotto dati include i dati sulla numerazione nazionale dei tratti stradali GCM governativi. GCM sta per pedone, bicicletta e ciclomotore."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų produktas apima duomenis apie nacionalinį vyriausybinių GCM kelių ruožų numeravimą. GCM reiškia pėsčiąjį, dviratį ir mopedą."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu produkts ietver datus par valdības GCM ceļa posmu valsts numerāciju. GCM apzīmē gājēju, velosipēdu un mopēdu."},{"@language":"mt-t-sv-t0-mtec","@value":"Il-prodott tad-data jinkludi data dwar in-numerazzjoni nazzjonali tas-sezzjonijiet tat-toroq governattivi tal-GCM. GCM tfisser pedonali, roti u moped."},{"@language":"nl-t-sv-t0-mtec","@value":"Het gegevensproduct bevat gegevens over de nationale nummering van GCM-weggedeelten van de overheid. GCM staat voor voetgangers, fietsers en bromfietsen."},{"@language":"pl-t-sv-t0-mtec","@value":"Produkt danych zawiera dane dotyczące krajowej numeracji rządowych odcinków dróg GCM. GCM oznacza pieszego, rower i motorower."},{"@language":"pt-t-sv-t0-mtec","@value":"O produto de dados inclui dados sobre a numeração nacional dos troços rodoviários GCM governamentais. GCM significa pedestre, bicicleta e ciclomotor."},{"@language":"ro-t-sv-t0-mtec","@value":"Produsul de date include date privind numerotarea națională a tronsoanelor rutiere guvernamentale GCM. GCM înseamnă pieton, bicicletă și motoretă."},{"@language":"sk-t-sv-t0-mtec","@value":"Dátový produkt obsahuje údaje o národnom číslovaní vládnych cestných úsekov GCM. GCM je skratka pre chodcov, bicykle a mopedy."},{"@language":"sl-t-sv-t0-mtec","@value":"Podatkovni produkt vključuje podatke o nacionalnem številčenju vladnih cestnih odsekov GCM. GCM je stojalo za pešce, kolesa in mopede."},{"@language":"sv","@value":"Dataprodukten omfattar data om den nationella nummersättningen av statliga GCM-vägsträckor. GCM står för gång-, cykel- och moped."},{"@language":"uk-t-sv-t0-mtec","@value":"Продукт містить дані про національну нумерацію державних ділянок доріг GCM. GCM розшифровується як пішохід, велосипед і мопед."}],"dct:format":["application/geopackage+sqlite3","text/html"],"dct:issued":{"@type":"xsd:date","@value":"2026-08-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-17"},"dct:provenance":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b1n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b2n0"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"GCM номер на пътя"},{"@language":"cs-t-sv-t0-mtec","@value":"GCM silniční číslo"},{"@language":"da-t-sv-t0-mtec","@value":"GCM-vejnummer"},{"@language":"de-t-sv-t0-mtec","@value":"GCM-Straßennummer"},{"@language":"el-t-sv-t0-mtec","@value":"Οδικός αριθμός GCM"},{"@language":"en-t-sv-t0-mtec","@value":"GCM road number"},{"@language":"es-t-sv-t0-mtec","@value":"Número de carretera GCM"},{"@language":"et-t-sv-t0-mtec","@value":"GCM-tee number"},{"@language":"fi-t-sv-t0-mtec","@value":"GCM-tien numero"},{"@language":"fr-t-sv-t0-mtec","@value":"Numéro de route GCM"},{"@language":"ga-t-sv-t0-mtec","@value":"Uimhir bhóthair GCM"},{"@language":"hr-t-sv-t0-mtec","@value":"Cestovni broj GCM-a"},{"@language":"hu-t-sv-t0-mtec","@value":"GCM útszám"},{"@language":"it-t-sv-t0-mtec","@value":"Numero stradale GCM"},{"@language":"lt-t-sv-t0-mtec","@value":"GCM kelio numeris"},{"@language":"lv-t-sv-t0-mtec","@value":"GCM ceļa numurs"},{"@language":"mt-t-sv-t0-mtec","@value":"Numru tat-triq tal-GCM"},{"@language":"nl-t-sv-t0-mtec","@value":"GCM-wegnummer"},{"@language":"pl-t-sv-t0-mtec","@value":"Numer drogi GCM"},{"@language":"pt-t-sv-t0-mtec","@value":"Número da estrada GCM"},{"@language":"ro-t-sv-t0-mtec","@value":"Numărul drumului GCM"},{"@language":"sk-t-sv-t0-mtec","@value":"Číslo cesty GCM"},{"@language":"sl-t-sv-t0-mtec","@value":"Številka ceste GCM"},{"@language":"sv","@value":"GCM-vägnummer"},{"@language":"uk-t-sv-t0-mtec","@value":"Автомобільний номер GCM"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1050"},{"@id":"https://metadata.trafikverket.se/store/1/resource/186"}],"http://entryscape.org/terms/metadataIdentifier":"07d1121f-8a56-47ad-8e9c-f0810f285ca7","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b3n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Levereras vid beställning, licens krävs"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/NVDB_PedestrianCycleAndMopedRouteData"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/NationalRoadDatabaseNVDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/RoadAuthority/term2"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/B"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/C"},{"@id":"https://metadata.trafikverket.se/concepts/road-network-type/W"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"http://data.europa.eu/88u/distribution/92dcc7d3-408c-4cf8-9892-0491ed19649b","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/orderdata/vag"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"GCM набор от данни за номера на пътя. Файловете са достъпни във формат geopackage. Външно или вътрешно изтегляне на машинен файл може да се извърши чрез услугата за API данни. \n\nNB: За достъп/изтегляне щракнете върху връзката под URL и влезте в Lastkajen (изисква се потребителски акаунт). След като влезете, поставете същата връзка в браузъра за директен достъп."},{"@language":"cs-t-sv-t0-mtec","@value":"Soubor údajů o silničním čísle GCM. Soubory jsou k dispozici ve formátu geopackage. Externí nebo interní stahování souborů stroje lze provést prostřednictvím datové služby API. \n\nPozn.: Pro přístup/stažení klikněte na odkaz pod URL a přihlaste se do Lastkajen (uživatelský účet vyžadován). Po přihlášení vložte stejný odkaz do prohlížeče pro přímý přístup."},{"@language":"da-t-sv-t0-mtec","@value":"GCM-vejnummerdatasæt. Filerne er tilgængelige i geopakkeformat. Eksterne eller interne maskinfil downloads kan gøres via API data service. \n\nNB: For at tilgå/downloade skal du klikke på linket under URL og logge ind på Lastkajen (brugerkonto påkrævet). Når du er logget ind, skal du indsætte det samme link i browseren for direkte adgang."},{"@language":"de-t-sv-t0-mtec","@value":"GCM-Straßennummerndatensatz. Die Dateien sind im Geopackage-Format verfügbar. Externe oder interne Maschinendatei-Downloads können über den API-Datendienst durchgeführt werden. \n\nAnm.: Um darauf zuzugreifen/herunterzuladen, klicken Sie auf den Link unter URL und melden Sie sich bei Lastkajen an (Benutzerkonto erforderlich). Fügen Sie nach dem Anmelden denselben Link für den direkten Zugriff in den Browser ein."},{"@language":"el-t-sv-t0-mtec","@value":"Σύνολο δεδομένων αριθμού κυκλοφορίας GCM. Τα αρχεία είναι διαθέσιμα σε μορφή geopackage. Οι εξωτερικές ή εσωτερικές λήψεις αρχείων μηχανής μπορούν να γίνουν μέσω της υπηρεσίας δεδομένων API. \n\nΣΗΜ.: Για να αποκτήσετε πρόσβαση/τηλεφόρτωση, κάντε κλικ στον σύνδεσμο κάτω από τη διεύθυνση URL και συνδεθείτε στο Lastkajen (απαιτείται λογαριασμός χρήστη). Αφού συνδεθείτε, επικολλήστε τον ίδιο σύνδεσμο στο πρόγραμμα περιήγησης για άμεση πρόσβαση."},{"@language":"en-t-sv-t0-mtec","@value":"GCM road number data set. The files are available in geopackage format. External or internal machine file downloads can be done via API data service. \n\nNB: To access/download, click on the link under URL and log in to Lastkajen (user account required). After logging in, paste the same link into the browser for direct access."},{"@language":"es-t-sv-t0-mtec","@value":"Conjunto de datos de número de carretera GCM. Los archivos están disponibles en formato geopackage. Las descargas de archivos de máquina externos o internos se pueden realizar a través del servicio de datos API. \n\nNota: Para acceder/descargar, haga clic en el enlace bajo URL e inicie sesión en Lastkajen (se requiere cuenta de usuario). Después de iniciar sesión, pegue el mismo enlace en el navegador para acceder directamente."},{"@language":"et-t-sv-t0-mtec","@value":"GCM maanteenumbrite andmekogum. Failid on saadaval geopaketi formaadis. Välist või sisemist masinfaili allalaadimist saab teha API-andmeteenuse kaudu. \n\nNB! Juurdepääsuks/allalaadimiseks klõpsake URL-i all oleval lingil ja logige sisse Lastkajeni (nõutav on kasutajakonto). Pärast sisselogimist kleepige sama link brauserisse otseseks juurdepääsuks."},{"@language":"fi-t-sv-t0-mtec","@value":"GCM-tienumerotietojoukko. Tiedostot ovat saatavilla geopackage-muodossa. Ulkoiset tai sisäiset koneen tiedostojen lataukset voidaan tehdä API-tietopalvelun kautta. \n\nHuom.: Pääset/lataamaan klikkaamalla URL-osoitteen alla olevaa linkkiä ja kirjautumalla Lastkajeniin (käyttäjätili vaaditaan). Kun olet kirjautunut sisään, liitä sama linkki selaimeen suoraa käyttöä varten."},{"@language":"fr-t-sv-t0-mtec","@value":"Ensemble de données sur le numéro de route GCM. Les fichiers sont disponibles au format geopackage. Les téléchargements de fichiers machine externes ou internes peuvent être effectués via le service de données API. \n\nNB : Pour accéder/télécharger, cliquez sur le lien sous URL et connectez-vous à Lastkajen (compte utilisateur requis). Après vous être connecté, collez le même lien dans le navigateur pour un accès direct."},{"@language":"ga-t-sv-t0-mtec","@value":"Tacar sonraí uimhir bóthair GCM. Tá na comhaid ar fáil i bhformáid geopackage. Is féidir íoslódálacha seachtracha nó inmheánacha comhad meaisín a dhéanamh trí sheirbhís sonraí API. \n\nNB: Chun rochtain/íoslódáil a fháil, cliceáil ar an nasc faoi URL agus logáil isteach go Lastkajen (cuntas úsáideora ag teastáil). Tar éis duit logáil isteach, greamaigh an nasc céanna isteach sa bhrabhsálaí le haghaidh rochtain dhíreach."},{"@language":"hr-t-sv-t0-mtec","@value":"Skup podataka o cestovnom broju GCM-a. Datoteke su dostupne u geopakiranom obliku. Vanjska ili unutarnja preuzimanja datoteka na stroju mogu se izvršiti putem API podatkovne usluge. \n\nNapomena: Za pristup/preuzimanje kliknite na poveznicu pod URL-om i prijavite se na Lastkajen (potreban korisnički račun). Nakon prijave, zalijepite istu vezu u preglednik za izravan pristup."},{"@language":"hu-t-sv-t0-mtec","@value":"GCM útszám adatkészlet. A fájlok geopackage formátumban érhetők el. A külső vagy belső gépi fájlok letöltése API-adatszolgáltatáson keresztül végezhető el. \n\nMegjegyzés: A hozzáféréshez/letöltéshez kattintson az URL alatti linkre, és jelentkezzen be a Lastkajenbe (felhasználói fiók szükséges). A bejelentkezés után illessze be ugyanazt a linket a böngészőbe a közvetlen hozzáféréshez."},{"@language":"it-t-sv-t0-mtec","@value":"Insieme di dati del numero stradale GCM. I file sono disponibili in formato geopackage. I download di file macchina esterni o interni possono essere effettuati tramite il servizio dati API. \n\nNB: Per accedere/scaricare, clicca sul link sotto URL e accedi a Lastkajen (account utente richiesto). Dopo aver effettuato l'accesso, incolla lo stesso link nel browser per l'accesso diretto."},{"@language":"lt-t-sv-t0-mtec","@value":"GCM kelio numerio duomenų rinkinys. Failai yra prieinami geopackage formatu. Išoriniai arba vidiniai kompiuterio failai gali būti atsisiunčiami per API duomenų paslaugą. \n\nPastaba. Norėdami pasiekti / atsisiųsti, spustelėkite nuorodą po URL ir prisijunkite prie Lastkajen (reikalinga vartotojo paskyra). Prisijungę įklijuokite tą pačią nuorodą į naršyklę tiesioginei prieigai."},{"@language":"lv-t-sv-t0-mtec","@value":"GCM ceļa numura datu kopa. Faili ir pieejami ģeopaketes formātā. Ārējo vai iekšējo mašīnu failu lejupielādi var veikt, izmantojot API datu pakalpojumu. \n\nNB! Lai piekļūtu/lejupielādētu, noklikšķiniet uz saites zem URL un piesakieties Lastkajen (nepieciešams lietotāja konts). Pēc pieteikšanās ielīmējiet to pašu saiti pārlūkprogrammā tiešai piekļuvei."},{"@language":"mt-t-sv-t0-mtec","@value":"Sett ta’ data tan-numru tat-triq tal-GCM. Il-fajls huma disponibbli f'format ta 'ġeopakkett. Id-downloads esterni jew interni tal-fajls tal-magni jistgħu jsiru permezz tas-servizz tad-data tal-API. \n\nNB: Biex taċċessa/tniżżel, ikklikkja fuq il-link taħt il-URL u lloggja lejn Lastkajen (kont tal-utent meħtieġ). Wara li tilloggja, ippejstja l-istess link fil-browser għal aċċess dirett."},{"@language":"nl-t-sv-t0-mtec","@value":"GCM-gegevensset voor wegnummers. De bestanden zijn beschikbaar in geopackage formaat. Externe of interne machinebestand downloads kunnen worden gedaan via API data service. \n\nNB: Om toegang te krijgen/downloaden, klikt u op de link onder URL en logt u in bij Lastkajen (gebruikersaccount vereist). Nadat u bent ingelogd, plakt u dezelfde link in de browser voor directe toegang."},{"@language":"pl-t-sv-t0-mtec","@value":"Zbiór danych dotyczących numeru drogi GCM. Pliki są dostępne w formacie geopackage. Zewnętrzne lub wewnętrzne pobieranie plików maszynowych może odbywać się za pośrednictwem usługi danych API. \n\nUwaga: Aby uzyskać dostęp / pobrać, kliknij link pod adresem URL i zaloguj się do Lastkajen (wymagane konto użytkownika). Po zalogowaniu wklej ten sam link do przeglądarki, aby uzyskać bezpośredni dostęp."},{"@language":"pt-t-sv-t0-mtec","@value":"Conjunto de dados do número de estrada GCM. Os ficheiros estão disponíveis em formato de geopacote. Os downloads de ficheiros de máquina externos ou internos podem ser feitos através do serviço de dados API. \n\nNB: Para aceder/descarregar, clique na ligação em URL e inicie sessão em Lastkajen (é necessária uma conta de utilizador). Depois de iniciar a sessão, cole o mesmo link no navegador para acesso direto."},{"@language":"ro-t-sv-t0-mtec","@value":"Set de date privind numărul de drum GCM. Fișierele sunt disponibile în format geopackage. Descărcările externe sau interne de fișiere de mașină se pot face prin intermediul serviciului de date API. \n\nNB: Pentru a accesa/descărca, faceți clic pe linkul de sub URL și conectați-vă la Lastkajen (este necesar un cont de utilizator). După conectare, lipiți același link în browser pentru acces direct."},{"@language":"sk-t-sv-t0-mtec","@value":"Súbor údajov GCM o cestnej premávke. Súbory sú k dispozícii vo formáte geobalíka. Externé alebo interné sťahovanie súborov stroja sa môže vykonávať prostredníctvom dátovej služby API. \n\nPozn.: Pre prístup/stiahnutie kliknite na odkaz pod URL a prihláste sa do Lastkajen (vyžaduje sa užívateľský účet). Po prihlásení vložte rovnaký odkaz do prehliadača pre priamy prístup."},{"@language":"sl-t-sv-t0-mtec","@value":"Nabor podatkov o številki ceste GCM. Datoteke so na voljo v obliki geopaketa. Zunanje ali notranje strojno prenašanje datotek se lahko izvede prek podatkovne storitve API. \n\nOpomba: Za dostop/prenos kliknite na povezavo pod URL in se prijavite v Lastkajen (potreben je uporabniški račun). Ko se prijavite, prilepite isto povezavo v brskalnik za neposreden dostop."},{"@language":"sv","@value":"Datamängd gällande GCM-vägnummer. Filerna finns i geopackage-format. Extern eller intern maskinell filnedladdning kan göras via API-datatjänst. \n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst."},{"@language":"uk-t-sv-t0-mtec","@value":"Набір даних дорожніх номерів GCM. Файли доступні у форматі geopackage. Зовнішнє або внутрішнє завантаження файлів комп'ютера може здійснюватися через службу даних API. \n\nВ.Б.: Щоб отримати доступ/завантажити, натисніть на посилання за URL-адресою та увійдіть у Lastkajen (потрібний обліковий запис користувача). Після входу в систему вставте те саме посилання в браузер для прямого доступу."}],"dct:format":"application/geopackage+sqlite3","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"NVDB GCM пътен номер - изтегли в Lastkajen"},{"@language":"cs-t-sv-t0-mtec","@value":"NVDB GCM road number - stáhnout v Lastkajen"},{"@language":"da-t-sv-t0-mtec","@value":"NVDB GCM vejnummer - download i Lastkajen"},{"@language":"de-t-sv-t0-mtec","@value":"NVDB GCM Straßennummer - herunterladen in Lastkajen"},{"@language":"el-t-sv-t0-mtec","@value":"NVDB GCM αριθμό δρόμου - κατεβάσετε στο Lastkajen"},{"@language":"en-t-sv-t0-mtec","@value":"NVDB GCM road number - download in Lastkajen"},{"@language":"es-t-sv-t0-mtec","@value":"NVDB GCM road number - descargar en Lastkajen"},{"@language":"et-t-sv-t0-mtec","@value":"NVDB GCM tee number - Lae Lastkajen"},{"@language":"fi-t-sv-t0-mtec","@value":"NVDB GCM tien numero - lataa Lastkajen"},{"@language":"fr-t-sv-t0-mtec","@value":"NVDB GCM numéro de route - télécharger dans Lastkajen"},{"@language":"ga-t-sv-t0-mtec","@value":"Uimhir bhóthair NVDB GCM - íoslódáil in Lastkajen"},{"@language":"hr-t-sv-t0-mtec","@value":"NVDB GCM broj ceste - preuzimanje u Lastkajen"},{"@language":"hu-t-sv-t0-mtec","@value":"NVDB GCM útszám - letöltés itt: Lastkajen"},{"@language":"it-t-sv-t0-mtec","@value":"NVDB GCM numero stradale - download in Lastkajen"},{"@language":"lt-t-sv-t0-mtec","@value":"NVDB GCM kelio numeris - atsisiųsti Lastkajen"},{"@language":"lv-t-sv-t0-mtec","@value":"NVDB GCM ceļa numurs - lejupielādēt Lastkajen"},{"@language":"mt-t-sv-t0-mtec","@value":"NVDB GCM numru tat-triq - download in Lastkajen"},{"@language":"nl-t-sv-t0-mtec","@value":"NVDB GCM wegnummer - downloaden in Lastkajen"},{"@language":"pl-t-sv-t0-mtec","@value":"NVDB GCM road number - pobierz w Lastkajen"},{"@language":"pt-t-sv-t0-mtec","@value":"NVDB GCM road number - baixar em Lastkajen"},{"@language":"ro-t-sv-t0-mtec","@value":"NVDB Numărul drumului GCM - descărcare în Lastkajen"},{"@language":"sk-t-sv-t0-mtec","@value":"NVDB GCM číslo cesty - na stiahnutie v Lastkajen"},{"@language":"sl-t-sv-t0-mtec","@value":"NVDB GCM cesta številka - prenos v Lastkajen"},{"@language":"sv","@value":"NVDB GCM-vägnummer - nedladdning i Lastkajen"},{"@language":"uk-t-sv-t0-mtec","@value":"NVDB GCM номер дороги - завантажити в Lastkajen"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/distribution/fcb6066f-471b-4b19-92ff-647c3a6e8250","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/1050"},"dcat:accessURL":{"@id":"http://vtf.trafikverket.se/SeTrafikinformation"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Показване на данните с това свойство в Карта с информация за трафика, върху която може да се щракне (TIKK). \n\nNB: За достъп / преглед поставете връзката към адреса за достъп в браузъра. След това изберете свойството, което съответства на набора от данни."},{"@language":"cs-t-sv-t0-mtec","@value":"Zobrazení dat s touto vlastností v TIKK (Traffic Information Clickable Map). \n\nPozn.: Pro přístup/zobrazení vložte odkaz na přístupovou adresu do prohlížeče. Poté vyberte vlastnost, která odpovídá sadě dat."},{"@language":"da-t-sv-t0-mtec","@value":"Visning af data med denne ejendom i Traffic Information Clickable Map (TIKK). \n\nNB: For adgang/visning skal du indsætte linket til adgangsadressen i browseren. Vælg derefter den egenskab, der svarer til datasættet."},{"@language":"de-t-sv-t0-mtec","@value":"Anzeige der Daten mit dieser Eigenschaft in Traffic Information Clickable Map (TIKK). \n\nAnm.: Für den Zugriff / die Ansicht fügen Sie den Link zur Zugriffsadresse in den Browser ein. Wählen Sie dann die Eigenschaft aus, die dem Datensatz entspricht."},{"@language":"el-t-sv-t0-mtec","@value":"Εμφάνιση των δεδομένων με αυτό το ακίνητο στο Χάρτης πληροφοριών κυκλοφορίας με δυνατότητα κλικ (ΤΙΚΚ). \n\nΣΗΜ.: Για πρόσβαση/προβολή, επικολλήστε τον σύνδεσμο διεύθυνσης πρόσβασης στο πρόγραμμα περιήγησης. Στη συνέχεια, επιλέξτε την ιδιότητα που αντιστοιχεί στο σύνολο δεδομένων."},{"@language":"en-t-sv-t0-mtec","@value":"Display of the data with this property in Traffic Information Clickable Map (TIKK). \n\nNB: For access/view, paste the access address link into the browser. Then select the property that corresponds to the data set."},{"@language":"es-t-sv-t0-mtec","@value":"Visualización de los datos con esta propiedad en Traffic Information Clickable Map (TIKK). \n\nNota: Para acceder/ver, pegue el enlace de la dirección de acceso en el navegador. A continuación, seleccione la propiedad que corresponde al conjunto de datos."},{"@language":"et-t-sv-t0-mtec","@value":"Selle atribuudiga andmete kuvamine liiklusteabe klõpsataval kaardil (TIKK). \n\nNB! Juurdepääsu/vaatamise jaoks kleepige pääsuaadressi link brauserisse. Seejärel valige atribuut, mis vastab andmekogumile."},{"@language":"fi-t-sv-t0-mtec","@value":"Tämän ominaisuuden tietojen näyttäminen liikennetietojen napsautettavassa kartassa (TIKK). \n\nHuom.: Liitä osoitelinkki selaimeen, jos haluat käyttää/katsoa sitä. Valitse sitten ominaisuus, joka vastaa tietojoukkoa."},{"@language":"fr-t-sv-t0-mtec","@value":"Affichage des données avec cette propriété dans Traffic Information Clickable Map (TIKK). \n\nNB : Pour accéder/afficher, collez le lien d'adresse d'accès dans le navigateur. Sélectionnez ensuite la propriété qui correspond à l'ensemble de données."},{"@language":"ga-t-sv-t0-mtec","@value":"Taispeáin na sonraí leis an maoin seo ar Léarscáil Inchliceáilte Faisnéise Tráchta (TIKK). \n\nNB: Chun rochtain/amharc a fháil, greamaigh an nasc chuig an seoladh rochtana isteach sa bhrabhsálaí. Ansin roghnaigh an mhaoin a fhreagraíonn don tacar sonraí."},{"@language":"hr-t-sv-t0-mtec","@value":"Prikaz podataka s ovom nekretninom na Kliknoj karti prometnih informacija (TIKK). \n\nNapomena: Za pristup/pregled zalijepite poveznicu za pristupnu adresu u preglednik. Zatim odaberite svojstvo koje odgovara skupu podataka."},{"@language":"hu-t-sv-t0-mtec","@value":"Az adatok megjelenítése ezzel a tulajdonsággal a Traffic Information Clickable Map (TIKK) alkalmazásban. \n\nMegjegyzés: A hozzáféréshez/megtekintéshez illessze be a hozzáférési cím linkjét a böngészőbe. Ezután válassza ki az adatkészletnek megfelelő tulajdonságot."},{"@language":"it-t-sv-t0-mtec","@value":"Visualizzazione dei dati con questa proprietà in Traffic Information Clickable Map (TIKK). \n\nNB: Per accedere/visualizzare, incollare il link dell'indirizzo di accesso nel browser. Quindi selezionare la proprietà corrispondente al set di dati."},{"@language":"lt-t-sv-t0-mtec","@value":"Duomenų rodymas su šia savybe Eismo informacijos paspaudžiamame žemėlapyje (TIKK). \n\nPastaba. Norėdami pasiekti / peržiūrėti, įklijuokite prieigos adreso nuorodą į naršyklę. Tada pasirinkite ypatybę, atitinkančią duomenų rinkinį."},{"@language":"lv-t-sv-t0-mtec","@value":"Datu attēlošana ar šo rekvizītu satiksmes informācijas klikšķināmajā kartē (TIKK). \n\nNB! Lai piekļūtu/skatītu, ielīmējiet pārlūkprogrammā piekļuves adreses saiti. Pēc tam atlasiet rekvizītu, kas atbilst datu kopai."},{"@language":"mt-t-sv-t0-mtec","@value":"Uri d-data ma’ din il-proprjetà fil-Mappa li Tikklikkja l-Informazzjoni dwar it-Traffiku (TIKK). \n\nNB: Għal aċċess/dehra, ippejstja l-link tal-indirizz tal-aċċess fil-brawżer. Imbagħad agħżel il-proprjetà li tikkorrispondi għas-sett tad-data."},{"@language":"nl-t-sv-t0-mtec","@value":"Weergave van de gegevens met deze eigenschap in Traffic Information Clickable Map (TIKK). \n\nNB: Voor toegang/weergave plakt u de link naar het toegangsadres in de browser. Selecteer vervolgens de eigenschap die overeenkomt met de gegevensset."},{"@language":"pl-t-sv-t0-mtec","@value":"Wyświetlanie danych z tą właściwością w Mapie z możliwością kliknięcia informacji o ruchu drogowym (TIKK). \n\nUwaga: Aby uzyskać dostęp/widok, wklej link adresu dostępu do przeglądarki. Następnie wybierz właściwość, która odpowiada zestawowi danych."},{"@language":"pt-t-sv-t0-mtec","@value":"Exibir os dados com esta propriedade no Mapa Clicável de Informações de Tráfego (TIKK). \n\nNB: Para aceder/visualizar, cole a ligação do endereço de acesso no navegador. Em seguida, selecione a propriedade que corresponde ao conjunto de dados."},{"@language":"ro-t-sv-t0-mtec","@value":"Afișarea datelor cu această proprietate în Traffic Information Clickable Map (TIKK). \n\nNB: Pentru acces/vizualizare, lipiți linkul adresei de acces în browser. Apoi selectați proprietatea care corespunde setului de date."},{"@language":"sk-t-sv-t0-mtec","@value":"Zobrazenie údajov s touto vlastnosťou v mape Traffic Information Clickable Map (TIKK). \n\nPozn.: Pre prístup/zobrazenie prilepte odkaz na prístupovú adresu do prehliadača. Potom vyberte vlastnosť, ktorá zodpovedá množine údajov."},{"@language":"sl-t-sv-t0-mtec","@value":"Prikaz podatkov s to lastnostjo na zemljevidu, ki ga je mogoče klikniti s prometnimi informacijami (TIKK). \n\nOpomba: Za dostop/ogled prilepite povezavo do naslova za dostop v brskalnik. Nato izberite lastnost, ki ustreza naboru podatkov."},{"@language":"sv","@value":"Visning av datat med denna egenskap i Trafikinformation klickbar karta (TIKK). \n\nOBS: För åtkomst/visning, klistra in åtkomstadresslänken i webbläsaren. Välj sedan egenskapen som motsvarar datamängden."},{"@language":"uk-t-sv-t0-mtec","@value":"Відображення даних з цією властивістю в Traffic Information Clickable Map (TIKK). \n\nВ.Б.: Для доступу/перегляду вставте посилання адреси доступу в браузер. Потім виберіть властивість, яка відповідає набору даних."}],"dct:format":"text/html","dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"NVDB GCM пътен номер — показване в картата с информация за движението, върху която може да се кликне (TIKK)"},{"@language":"cs-t-sv-t0-mtec","@value":"NVDB GCM silniční číslo - zobrazení v dopravní informace klikatelné mapě (TIKK)"},{"@language":"da-t-sv-t0-mtec","@value":"NVDB GCM vejnummer - visning i trafikinformation klikbart kort (TIKK)"},{"@language":"de-t-sv-t0-mtec","@value":"NVDB GCM Straßennummer - Anzeige in Verkehrsinformationen klickbare Karte (TIKK)"},{"@language":"el-t-sv-t0-mtec","@value":"NVDB GCM road number - εμφάνιση σε Traffic information clickable map (TIKK)"},{"@language":"en-t-sv-t0-mtec","@value":"NVDB GCM road number - display in Traffic information clickable map (TIKK)"},{"@language":"es-t-sv-t0-mtec","@value":"NVDB GCM road number - display in Traffic information clickable map (TIKK) (en inglés)"},{"@language":"et-t-sv-t0-mtec","@value":"NVDB GCM tee number - kuva liiklusteabe klikitaval kaardil (TIKK)"},{"@language":"fi-t-sv-t0-mtec","@value":"NVDB GCM tien numero - näyttää liikennetiedot klikattava kartta (TIKK)"},{"@language":"fr-t-sv-t0-mtec","@value":"Numéro de route NVDB GCM - affichage dans Informations sur le trafic carte cliquable (TIKK)"},{"@language":"ga-t-sv-t0-mtec","@value":"Uimhir bhóthair GCM NVDB - taispeáint ar léarscáil inchliceáilte faisnéise Tráchta (TIKK)"},{"@language":"hr-t-sv-t0-mtec","@value":"NVDB GCM broj ceste - prikaz na karti s informacijama o prometu (TIKK)"},{"@language":"hu-t-sv-t0-mtec","@value":"NVDB GCM útszám - megjelenik a Közlekedési információk kattintható térkép (TIKK)"},{"@language":"it-t-sv-t0-mtec","@value":"NVDB GCM numero stradale - visualizzabile nella mappa cliccabile delle informazioni sul traffico (TIKK)"},{"@language":"lt-t-sv-t0-mtec","@value":"NVDB GCM kelio numeris - rodyti eismo informacija paspaudžiamas žemėlapis (TIKK)"},{"@language":"lv-t-sv-t0-mtec","@value":"NVDB GCM ceļa numurs - displejs satiksmes informācijas klikšķināmā kartē (TIKK)"},{"@language":"mt-t-sv-t0-mtec","@value":"NVDB GCM numru tat-triq - display fil-mappa li tikklikkja l-informazzjoni dwar it-traffiku (TIKK)"},{"@language":"nl-t-sv-t0-mtec","@value":"NVDB GCM wegnummer - weergave in Traffic information clickable map (TIKK)"},{"@language":"pl-t-sv-t0-mtec","@value":"Numer drogi NVDB GCM - wyświetlanie na mapie z klikalną informacją o ruchu drogowym (TIKK)"},{"@language":"pt-t-sv-t0-mtec","@value":"NVDB GCM road number - display in Traffic information clickable map (TIKK) (Número da estrada do GCM do NVDB - visualização no mapa clicável de informações de tráfego (TIKK))"},{"@language":"ro-t-sv-t0-mtec","@value":"NVDB Numărul drumului GCM - afișare în harta cu informații despre trafic pe care se poate face clic (TIKK)"},{"@language":"sk-t-sv-t0-mtec","@value":"NVDB GCM číslo cesty - zobrazenie v dopravnej informácii klikateľná mapa (TIKK)"},{"@language":"sl-t-sv-t0-mtec","@value":"Številka ceste NVDB GCM - prikaz na zemljevidu s prometnimi informacijami, ki ga je mogoče klikniti (TIKK)"},{"@language":"sv","@value":"NVDB GCM-vägnummer - visning i Trafikinformation klickbar karta (TIKK)"},{"@language":"uk-t-sv-t0-mtec","@value":"Номер дороги NVDB GCM - відображення на карті клікабельності дорожньої інформації (TIKK)"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#representationTechnique":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialRepresentationTypeCode/vector"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"http://data.europa.eu/88u/record/https-metadata-trafikverket-se-store-1-resource-2129","@type":"dcat:CatalogRecord","dcat:distribution":[{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b5n0"},{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b6n0"}],"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://metadata.trafikverket.se/store/1/resource/2129","dct:issued":{"@type":"xsd:dateTime","@value":"2026-08-20T11:15:02Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-09-26T14:16:34Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-metadata-trafikverket-se-store-1-resource-2129"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:39f8506790a2cfca9ab1272a12b176ad5104a3bb8b3b1747f8093593ba095fa7_b4n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-metadata-trafikverket-se-store-1-resource-2129"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-09-23T11:15:03Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-09-26T14:16:34Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"},"https://piveau.eu/ns/voc#originalId":"https://metadata.trafikverket.se/store/1/resource/2129","https://piveau.eu/ns/voc#originalURIRef":{"@type":"xs