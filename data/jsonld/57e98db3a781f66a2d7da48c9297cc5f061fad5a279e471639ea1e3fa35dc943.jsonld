,{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/geoscientificInformation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/3650"}],"dct:title":{"@language":"en","@value":"Borehole - View Service (INSPIRE)"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/f4d7a64a5cb84b6f919d5e4645e868c7/tjanstebeskrivning_inspire_tn_giltig-version.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.org/terms/metadataIdentifier":"2cd41abb-0785-42e4-bd8b-abfe5b76c065","http://www.w3.org/ns/adms#identifier":"GE.Borehole.viewservices","http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:a7ec77a11353e5d3ef7a63cfcaaebda3999795c2a9479b2622094bc3ce5c30c6_b1n1"},{"@id":"_:a7ec77a11353e5d3ef7a63cfcaaebda3999795c2a9479b2622094bc3ce5c30c6_b2n1"}],"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/9","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Databas för borrhål","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a7ec77a11353e5d3ef7a63cfcaaebda3999795c2a9479b2622094bc3ce5c30c6_b3n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:a7ec77a11353e5d3ef7a63cfcaaebda3999795c2a9479b2622094bc3ce5c30c6"},{"@graph":[{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via interna dataleveranser."}},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n0"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n1"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n10"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n6"}},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n4"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n5"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n0"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n1"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n10"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n4"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n5"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n7"},{"@id":"_:a88ec0618325f13884720354cbaffb420b2b3951e4ffa2d37ee720d5ca820fc2_b10n8"},{"@id":"_:a88e