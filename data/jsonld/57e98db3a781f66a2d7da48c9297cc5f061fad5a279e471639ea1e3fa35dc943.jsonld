6268712d3_b36n2"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b36n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b36n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b36n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b36n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b36n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b37n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b38n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. Mappningen mellan Inspire ERoad och Trafikverkets vägdata är fullständig.\n\nDatamängden redovisar Europavägar enligt Inspiretema transportnät (TN) Eroad. Eroad är resultatet av en bearbetning av vägdataprodukten: Vägnummer."}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b39n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b3n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b3n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b3n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b40n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n2"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b41n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n1","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät.\n\nMappningen mellan Inspire Eroad och Trafikverkets vägdata är fullständig.\n\nDatamängden Eroad är genererad ur från följande vägdataprodukter:\n\n- Vägnummer"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n2","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n1"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b42n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b43n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b44n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b45n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b46n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b47n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b48n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b49n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b4n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b4n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b4n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":"Om Dataprodukten","http://schema.org/image":[{"@id":"https://metadata.trafikverket.se/store/119/resource/1"},{"@id":"https://metadata.trafikverket.se/store/119/resource/2"},{"@id":"https://metadata.trafikverket.se/store/119/resource/3"},{"@id":"https://metadata.trafikverket.se/store/119/resource/4"}],"http://schema.org/text":{"@language":"sv","@value":"¤ Om dataprodukten\n\nDataprodukten är ett referensnät för vägar, gator och andra leder eller platser som allmänt används för trafik med motorfordon samt vägar som är avsedda för cykel- och mopedtrafik, även vägar för gångtrafik kan ingå. Den ska vara en heltäckande vägdatabas för Sverige och bör betraktas som en av samhällets grunddatabaser vilket innebär att alla vägar, gator, torg, färjeleder och andra leder eller platser som används för trafik med motorfordon skall ingå. Till viss grad finns även vägar inom parkeringsytor, bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov. \n\nDataprodukten skall vara fullständig när det gäller cykelvägar som används för cykel-, moped - eller gångtrafik. Dessutom kan vägar som är avsedda för enbart gångtrafik ingå. Däremot ingår inte traktorvägar, skoterleder eller tillfälliga vägar t.ex. isvägar.\n\n\nFöljande typer av bil- och/eller cykelvägar skall alltid ingå:\n•   Bilvägar (minimikrav för en bilväg är att den har anlagd vägbana som är avsedd för biltrafik. På bäriga marker med god dräneringsförmåga kan egentlig vägkropp saknas. Bilvägen är framkomlig för lastbil, åtminstone när vägen är tjälad. Personbilstrafik är normalt möjlig men på de sämsta bilvägarna kan begränsad framkomlighet förekomma vid tjällossning och under ihållande regnperioder.)\n•  Alla återvändsvägar (vägar som bara ansluter till en annan väg i ena änden) inom tättbebyggt område samt återvändsvägar längre än 50 meter utanför tättbebyggt område\n•  Vägar kortare än 50 meter ska läggas in om de har unikt gatunamn eller då de är kritiska för att logisk ruttning till specifik fastighet ska bli korrekt\n•  Gator för kollektivtrafik\n•  Vägar som uteslutande används av driftfordon, räddningsfordon eller andra fordon av icke privat natur\n•  Vägar som går genom parkeringsytor, torg, kajer och öppna ytor (avsedda för bil- och/eller cykeltrafik)\n•  Vägar som går genom rastplatser\n•  Gågator där t.ex. varutransporter med motorfordon är tillåten\n•  Provisoriska vägar vid mycket stora ombyggnadsprojekt i främst storstäder\n•  Färjeleder\n•  Vägar konstruerade för fordon men där förbud mot trafik med fordon råder\n•  Cykelbanor och cykelfält\n•  Cykelöverfart och cykelpassage samt övergångsställe då de ingår i cykelnätet\n•  Förbindelser mellan cykelbanor som inte utgörs av cykelbana (t.ex. en trapp eller en kortare passage möjlig att cykla eller där cykeln bör ledas)\n\n\nFöljande typer av vägar kan ingå men det finns inget krav att de skall ingå:\n•  Vägar inom parkeringsytor som ej är genomgående\n•  Vägar inom inhägnade industriområden som enbart trafikeras av fordon med anknytning till den aktuella industrin\n•  Vägar inom bostads‐ och industriområden där biltrafik normalt inte förekommer men där det är fullt möjligt att köra för speciella behov\n•  Återvändsvägar utanför tättbebyggt område som är kortare än 50 meter\n\n\nFöljande vägar anordnade enbart för fotgängare kan ingå:\n•  Gångbana och trottoar \n•  Övergångsställe\n•  Passage genom byggnad (av typen förbindelsegång) \n•  Ramp (utformad för rörelsehindrade) \n•  Perrong \n•  Trappa, rulltrappa, rullande trottoar, hiss och snedbanehiss\n•  Linbana (annan än för gods och skidåkare) och bergbana (som ingår som förbindelse i gångnätet) \n•  Torg, kaj och öppen yta (avsedd för gångtrafik)\n•  Förbindelse mellan gångbanor som inte utgörs av anlagd gångbana (t.ex. en kortare förbindelse mellan två gångvägar som frekvent används av fotgängare och som avsevärt förkortar promenadens längd)\n•  Färjeled (linjetrafik på bestämd led med uppgift att transportera personer)\n\n\nFöljande typer av vägar skall inte ingå:\n- Traktorvägar \n- Stigar, motionsspår och vandringsleder \n- Skoterleder\n- Tillfälliga vägar, t.ex. isvägar\n- Spår och leder på is eller snötäckt mark\n- Ridleder\n\n\nDataprodukten ska beskriva hur vägen sträcker sig genom landskapet och hur vägarna hänger ihop dvs. dess geometri och topologi. Den ska visa det befintliga och historiska vägnätet men kan även visa framtida vägnät. \n\nAnpassning enligt bestämda gränspunkter för vägnätet har gjorts vid gränsen mot Norge, Finland och Danmark.  \n\nDataprodukten är ett referenssystem för egenskaper (företeelser) på vägnätet och möjliggör anknytning av dem på vägnätet. Nätet har bara läge och form som man kan knyta information till men nätet vet själv inte vilka egenskaper det har.\n\nLägesanknytningen görs genom att företeelsen ges en utbredning på vägnätet och knyts till nätet med identiteter och läge längst länk. De utbredningstyper som finns är sträcka, punkt, nod, svängutbredning samt vägutbredning med värd. För en detaljerad beskrivning av utbredningarna se Introduktion till NVDBs vägnät och företeelser under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Specifika standarder, ramverk och dylikt. \n\nDataprodukten beskrivs som en produkt men egentligen består nätet av olika komponenter, referenslänkar och noder samt referenslänkdelar som bär information om giltighet. \n\nReferenslänkdelen används för att beskriva vilka delar av en specifik referenslänk som är giltig vid olika tidpunkter. \n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation.\n\n\n¤ Relationen mellan referenslänkar, referenslänkdelar och noder \n\nEn referenslänk representerar en sammanhängande vägsträcka i vägnätet utan förgreningar och har öppnats för trafik vid ett och samma tillfälle. Den har ett linjärt längdsystem som behålls oförändrat även om delar av referenslänken ej längre används. En referenslänk har en geometri som beskriver dess utsträckning. \n\nEn referenslänk som skapats i systemet finns kvar i all ”oändlighet” och svarar mot en vägsträcka som finns eller har funnits. Referenslänk är en stabil entitet som är väl lämpad att användas för vägnätsanknytning av information.\n\nEn referenslänk används för att representera en vägsträcka och kan ha två eller flera noder, det vill säga förutom start- och slutnod samt även mellanliggande noder. Referenslänken startar i noden N1 och slutar i noden N2 (Bild 1).\n\nAntag att man vid ett senare tillfälle vill ansluta en ny referenslänk till den befintliga referenslänken. I systemet skapas då en ny referenslänk RL2 som startar i noden N3. \n\nNoden N3 knyts också till RL1. RL1 har nu alltså en association till N1, N3 och N2 i nämnd ordning (Bild 2).\n\nEn eller flera referenslänkdelar (RLD) används för att beskriva vilka delar av referenslänken som är giltig vid olika tidpunkter. En länkdel har ingen egen geometri men har en giltighetstid eller tidsperiod som beskrivs av från- och till-datum. Antag att referenslänken i scenariot enligt Bild 2 öppnas för trafik 2001-01-01 och har längden 1100. I systemet skapas samtidigt som skapandet av referenslänken en referenslänkdel (RLD1) från sektion 0 till sektion 1100 och med en giltighetstid från 2001-01-01 till oändligheten (Bild 3; för att förenkla figuren utelämnas månad och dag).\n\nEtt år senare bygger man om vägen i exemplet ovan och rätar ut kurvan samtidigt som man gräver bort den gamla kurvan (den utgår ur vägnätet).\n\nFör att representera den nybyggda vägen skapar man en ny referenslänk (RL3) och en ny länkdel (RLD5). Den ursprungliga referenslänken RL1 lämnas kvar orörd. Länkdelen (RLD1) i Bild 4 tas bort och ersätts med tre nya länkdelar, en som representerar det avsnitt som ej längre används (RLD2) och två som representerar de avsnitt som fortfarande används (RLD3 och RLD4).\n\nFör att underlätta uppdelningen av vägnätet i ”vanliga” länkar görs en uppdelning av referenslänken i referenslänkdelar överallt där det finns en anslutning. Givet ett visst ”betraktelsedatum” kommer en länk att bestå av en eller flera giltiga referenslänkdelar.\n\nFör en mer detaljerad beskrivning av informationsmodellen se NVDB - Informationsmodell under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n3"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n0"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b50n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b51n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b52n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b53n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b5n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b5n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b5n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor.\n\nDataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer.\n\nFör information om de ajourhållningsregler som gäller för bil-, cykel- och gångnätet se Informationssida: NVDB - nationell vägdatabas under kapitel Referenser till aktuella standarder, ramverk och dylikt/ Dokumentation."}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n0"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n1"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n6"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n4"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n5"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n0"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n1"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n4"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n5"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n7"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n8"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n9"}]},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n7"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n8"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b6n9"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b7n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b7n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b7n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b8n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b8n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b8n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av Trafikverkets personal. Vägnummer under 499 rapporteras av Trafikmiljö, nationellt på Trafikverket och vägnummer över 500 rapporteras av Trafikmiljö regionalt på Trafikverket."}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b9n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b9n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b9n1","@type":