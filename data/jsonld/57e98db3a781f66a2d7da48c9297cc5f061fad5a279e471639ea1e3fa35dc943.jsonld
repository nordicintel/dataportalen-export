formationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides the road name, according to the INSPIRE Transport Network (TN) specification for RoadName. It is generated from the following road data products:\no\tRoad number / Vägnummer\no\tRoad name / Gatunamn\no\tOther road name / Övrigt vägnamn"},{"@language":"sv","@value":"Datamängden redovisar vägnamn och vägnummer enligt Inspiretema transportnät (TN) RoadName. RoadName är genererad ur från följande vägdataprodukter: \n- Vägnummer \n- Gatunamn \n- Övrigt vägnamn \n\nDatamängden går att komma åt via wms och nedladdning av förgenererade filer. Endast vägnummer för värdvägen anges."}],"dct:identifier":"2fecfbc5-0a4e-41a3-b346-4dc91564c20d","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b38n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b39n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:fc6c7f835268a534480e8f0b26d515736bc9b88c1bd18ff77c68fbbc137ebede_b40n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Road Name (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://bran