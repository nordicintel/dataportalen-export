18/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-11-27"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"En WMS-tjänst (visningstjänst) som innehåller nätanknutna nationella (NVDB) och statliga vägdata. Tjänsten används bl.a. av webbapplikationen Sveriges vägar på karta/NVDB på webb. NetInfo visar företeelser på alla typer av vägnät. För att se ingående lager hänvisar vi till tjänstebeskrivningen för NetInfo, vilken innehåller en komplett lista för respektive tjänst. Öppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:dcc13d5c7576ab706d19c0883e843f83788060b82326608bde5e284c4a509118_b22n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för vägdata - NetInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLe