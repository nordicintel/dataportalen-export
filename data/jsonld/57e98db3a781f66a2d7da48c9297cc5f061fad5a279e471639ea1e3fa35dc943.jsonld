-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_A-B/1082vagvisning.pdf","@type":"http://www.w3.org/ns/dx/prof/Profile","dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/14"},"dcat:keyword":[{"@language":"en","@value":"NVDB - STVDB"},{"@language":"sv","@value":"NVDB - STVDB"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"4.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-191572013/"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/8017694"},{"@id":"https://www.sis.se/api/document/get/86342"},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/"},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/"},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/"}],"dct:description":{"@language":"sv","@value":"Dataproduktspecifikation som beskriver innehåll, struktur och kvalitetskrav för dataprodukten Vägvisning. Dataprodukten beskriver vägvisning för vägar med vägnummer högre än 499. För dessa finns en vägvisningsplan hos Transportstyrelsen i form av en föreskrift där fjärrort, närort och eventuella knutpunkter räknas upp för varje väg. Denna typ av vägvisningsplan passar inte för det mindre vägnätet där vägvisningen kan passera flera vägar."},"dct:format":[{"@id":"http://publications.europa.eu/resource/authority/file-type/PDF"},{"@id":"http://publications.europa.eu/resource/authority/file-type/RDF"}],"dct:hasPart":{"@id":"https://metadata.trafikverket.se/store/261/resource/11"},"dct:issued":{"@type":"xsd:date","@value":"2020-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-09-01"},"dct:relation":{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},"dct:title":[{"@language":"en","@value":"Wayfinding - Data Product Specification"},{"@language":"sv","@value":"Vägvisning - Dataproduktspecifikation"}],"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/e0faf1739d244cb384aadf8c1f7a91dd/introduktion-till-nvdbs-vagnat-och-foreteelser.pdf"},{"@id":"https://bransch.trafikverket.se/contentassets/e35b5092378a402d8dc6bd51a5e21742/netinfo-tjanstebeskrivning_v3.8.docx"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/leverera-in-data/"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/extern-kvalitetskontroll/"},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://www.w3.org/ns/adms#versionNotes":{"@language"