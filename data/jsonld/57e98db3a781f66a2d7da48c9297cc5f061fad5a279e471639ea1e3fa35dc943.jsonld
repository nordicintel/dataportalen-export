,"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:591a53b2007d55644ad7f26a7ccba1ea12f9a43d1f69371f2b2c8dce30b5656d_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:591a53b2007d55644ad7f26a7ccba1ea12f9a43d1f69371f2b2c8dce30b5656d"},{"@graph":[{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker av de ingående befintliga dataprodukterna, se Datafångst och produktion/ Datakällor/ Initiala datakällor."}},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n0"},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n1"},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n10"},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n6"}},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n4"},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n5"},{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:59441e2da8f9cfcba6f5fbc46d44a79ae22ff07545cddfc67fb58719be037965_b10n0"},{"@i