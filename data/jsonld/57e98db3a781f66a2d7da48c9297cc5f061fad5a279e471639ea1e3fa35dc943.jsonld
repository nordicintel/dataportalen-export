kverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:5641b00bf36d46eceb527c56c2725681b79c00136a8009df9e57065aa754a629_b3n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/55","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - LVS förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lvs.forvaltning@trafikverket.se"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:5641b00bf36d46eceb527c56c2725681b79c00136a8009df9e57065aa754a629"},{"@graph":[{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n0"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n1"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n10"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n6"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n4"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n5"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n0"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n1"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n10"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n4"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n5"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n7"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n8"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n9"}]},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n7"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n8"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b10n9"},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n3"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n0"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b13n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ecb4b2f602ce2fe57e1501d3fe61e54c5_b14n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:564cde444fcd626df67bb98e05a58f4ec