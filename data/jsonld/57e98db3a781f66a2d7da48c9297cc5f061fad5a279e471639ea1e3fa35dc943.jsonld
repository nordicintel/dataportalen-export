tDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://njdbwebb.trafikverket.se/"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=958&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2016-12-16"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Tittskåpstjänst där man kan titta på och göra filtreringar av järnvägsdata."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b2n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"NJDB på webb"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"a4430f27-339d-4abc-b29d-4d2b2e46f7dc","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b3n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/960","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"http://geo-baninfo.trafikverket.se/mapservice/wms.axd/BanInfo_1_5"},"dcat:keyword":[{"@language":"en","@value":"view service"},{"@language":"sv","@value":"visningstjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=960&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/999","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1096"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1164"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1346"}],"dcat:keyword":[{"@language":"en","@value":"StJDB"},{"@language":"sv","@value":"StJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=999&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"en","@value":"Railway Data - Speed Categories ERTMS"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2022-09-02"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Dataprodukten beskriver den största tillåtna hastigheten (STH) för olika fordon baserat på vilken rälsförhöjningsbrist de klarar för sträckor med ERTMS-systemet.\n\nHastighetsangivelsen kan vara angiven med, mot eller i båda riktningarna längs längdmätningens riktning."},"dct:identifier":"a54e6d98-0707-4b1f-aca4-35602c5fb6b1","dct:issued":{"@type":"xsd:date","@value":"2022-09-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b6n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b7n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:e8a1687e4b54c10cfd3712ab31ad4de9f6a7f82b04bf19c53ff1ab1c4d27db5d_b8n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Hastighetskategorier ERTMS"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService