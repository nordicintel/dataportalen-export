":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b25n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b26n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},{"@id":"https://metadata.trafikverket.se/store/1/resource/965"}]},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b26n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b26n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b27n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/881"},{"@id":"https://metadata.trafikverket.se/store/1/resource/965"}]},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b27n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b27n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b28n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n3"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n0"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b29n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n0"},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nFrån 2001 förekommer dataprodukten i NVDB. Vid den initiala laddningen har respektive företeelse fått en märkning från vilken källa den initiala laddningen kommit ifrån och vilken process som har genomfört laddningen. \n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet. \n\nVägnät där väghållare är kommunal - från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden - från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och av intresse för skogsnäringen - skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där intressent saknas - ajourhålls av Trafikverket."},"https://metadata.trafikverket.se/ns/production":[{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n3"},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n4"}]},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n2","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n3","@type":"http://purl.org/dc/dcmitype/Collection","http://schema.org/text":{"@language":"sv","@value":"Produktionen sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Vissa leverantörer har egna godkända system via vilka de kan leverera data direkt. I dataleveranserna ska information om tillkomst ingå för varje företeelse och den registreras m.h.a. dataprodukten Företeelsetillkomst, se referens #6. För Referenslinjetillkomst beskrivs tillkomsten med ett eller flera processteg. De processteg som bör anges är de som är mest kvalitetskritiska. Alltså då man utfört något moment som är av avgörande betydelse för kvalitén på data. Referenslinjetillkomsten ska uppdateras när man gör en geometrirättning, det kan vara en hel referenslänks geometri eller bara en del. Det viktiga är att man inte låter den ursprungliga tillkomsthistoriken ligga kvar, trots att man har gjort avsevärda rättningar på geometrin. Referenslinjetillkomst ska anges för bil-, gång och cykelvägnät."}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n4","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b2n0"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b30n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n3"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n0"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b31n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b32n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Initial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\n\nUnderlag för ajourhållning fångas hos dataleverantörerna och levereras till Trafikverkets enhet för Vägdata för beredning och registrering enligt uppgjorda avtal och processer."}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b33n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b34n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n3"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n0"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b35n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2010/1089/oj"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b36n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n3"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n0"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b37n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b38n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b39n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af_b39n3"}},{"@id":"_:97ca4a8821a994