dningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n13"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n11"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n12"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n0"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n11"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n12"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n14"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n15"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n16"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n17"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n2"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n4"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n5"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n6"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n7"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n8"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n9"}]},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n14"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n15"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n16"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n17"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n2"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n1"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n4"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n5"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n6"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n7"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n8"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b21n9"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n0"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n1","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\nInitial insamling av data för statliga vägar skedde 2001 när NVDB initialt laddades genom en överföring från dåvarande Vägverkets vägdatabank (VDB, den tidigare vägdatabasen), där förändringar ajourhållits kontinuerligt sedan 1980.\n\nUnder 2025 skapades en ny dataprodukt för Vägnummer och den gamla dataprodukten avslutades. Bakgrunden till förändringen är att den gamla produkten var onödigt komplicerad. Nya Vägnummer är en ”vanlig sträckföreteelse” till skillnad från gamla Vägnummer som hade nätreferenstyp Väg med värd. Detta gör ajourhållning och förändringshantering mer hanterbart. Vidare har attributen Länkroll, Ordningsnummer och Värd lyfts in som attribut medan de i gamla Vägnummer låg knutna till utbredningstypen. I nya Vägnummer är det endast Riktning och Överlapp (samtidighet) som är knutna till själva utbredningstypen, detta gör nya Vägnummer tydligare.\n\nNya Vägnummer har initialladdats med data från gamla Vägnummer. En företeelse är skapad per referenslänkdel.\n\n¤ Datakällor för ajourhållning\n\nTrafikverket ansvarar ensamt för ajourhållning av Vägnummer, oavsett väghållare."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n13"}},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n11"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n12"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n13","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n0"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n10"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n11"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n12"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n14"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n15"},{"@id":"_:897c0db11718eeabdda33274540d77c77e70aaa3cbf2df7417be9a26268712d3_b22n16"},{"@id":"_:897c0db11718eeabdda3