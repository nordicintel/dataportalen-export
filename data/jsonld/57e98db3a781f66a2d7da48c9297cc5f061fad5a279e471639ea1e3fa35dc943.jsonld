"https://knowledge-base.inspire.ec.europa.eu/publications/technical-guidance-implementation-inspire-download-services_en"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b36n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n3"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n0"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b37n3","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://data.europa.eu/eli/reg/2009/976/oj"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b38n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. Mappningen mellan Inspire RoadName och Trafikverkets vägdata är fullständig.\n\nDatamängden redovisar vägnamn och vägnummer enligt Inspiretema transportnät (TN) RoadName. Road är genererad ur från följande vägdataprodukter: \n- Vägnummer"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b39n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b3n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/8"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}]},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b3n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b3n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b40n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n2"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n3"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n0"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n2","@type":"http://www.w3.org/ns/prov#Plan","http://www.w3.org/ns/prov#wasDerivedFrom":{"@id":"http://inspire.ec.europa.eu/tg/tn/3.2rc1"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b41n3","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b42n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b42n3"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b42n1","dct:description":{"@language":"sv","@value":"Den nationella vägdatabasen (NVDB) innehåller ett nationellt gemensamt vägnät med data om länkar och noder. NVDB:s vägnät omfattar statliga, kommunala och enskilda vägar. Datainsamling sker i samverkan mellan Sveriges kommuner, Skogsnäringen, Trafikverket och Lantmäteriet. Till NVDB:s referensvägnät knyts data som beskriver egenskaper hos eller utrustning i vägnätet. En del av dessa data är överenskomna inom NVDB-samarbetet och är nationellt täckande, andra samlas in enbart för statligt vägnät. \n\nMappningen mellan Inspire Road och Trafikverkets vägdata är fullständig.\n\nRoad är genererat ur vägdataprodukten Vägnummer."},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b42n2","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:ab4490519e494da79276e568844c2ae51137fb513992447d4b8a2d5f45d99d7f_b42n1"},"http://www.w