0&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Railway Data - View Service"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:WMS"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2013-04-22"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The view service displays a selection of the Trafikverket, Swedish Transport Administration’s railway track data. The dataset on track data includes NJDB, the Swedish National Railway Database, in which data for railway facilities owned and managed by an actor other than the state and Trafikverket is collected."},{"@language":"sv","@value":"En visningstjänst som innehåller ett urval av Trafikverkets Bandata. Tjänsten används bl.a. av NJDB på webb, Stigfinnaren och JaK.\nDetta är en tjänst som innehåller öppna data och publiceras externt.\n\nÖppna tjänsten genom att klistra in åtkomstadresslänken i lämplig programvara (ex. ArcGIS)."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-07"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Visningstjänst för järnvägsdata - BanInfo"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"3d5bfbbe-de59-4a91-b01e-0c9f11219fb6","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/994","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/12"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1091"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1161"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1319"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1342"}],"dcat:keyword":[{"@language":"en","@value":"NJDB"},{"@language":"sv","@value":"NJDB"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=994&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/WEEKLY"},"dct:alternative":{"@language":"en","@value":"Railway Data - Electrification"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2012-09-03"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Det finns idag banor som är oelektrifierade. Vanligast är också att sidospår är oelektrifierade. Omkring 80 % av de spår där Trafikverket är infrastrukturförvaltare är idag elektrifierade.\n\nEn elektrifierad bana trafikeras med ellok, en oelektrifierad bana trafikeras med diesellok.\n\nDataprodukten har sträckutbredning och kopplar till järnvägsnätet med referens mot närmast föregående nod med avstånd i meter till både start- och slutläget på sträckan i spårlänkens riktning.\n\nDataprodukten är heltäckande på Det svenska järnvägsnätet."},"dct:identifier":"212df7b4-cccf-4fa5-99a2-4edf0dc49ac0","dct:issued":{"@type":"xsd:date","@value":"2012-09-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-12"},"dct:provenance":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b6n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b7n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b8n0"},"dct:title":{"@language":"sv","@value":"Järnvägsdata - Elektrifiering"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/jarnvagsdata/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/958"},{"@id":"https://metadata.trafikverket.se/store/1/resource/960"}],"http://entryscape.org/terms/metadataIdentifier":"13361b86-2001-47a3-9457-c0635bd11626","http://schema.org/image":{"@id":"http://geo-baninfo.trafikverket.se/MapService/wms.axd/BanInfo_1_5?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&layers=Elektrifiering&STYLES=&SRS=EPSG:3006&BBOX=6222362,421256,6229244,428186&WIDTH=620&HEIGHT=620&FORMAT=image/png&"},"http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b9n1"},"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/NJDB_FunctionalObjects"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/RW_NationalRailwayDataNJDB"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/4/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Järnvägsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:njdb@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b10n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b11n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e_b12n0"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:a58c9b492320aff5f4548c23ac66e6754df0207138ac4509a07d57df2e0d148e"},{"@graph":[{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b0n1"},"dct:title":"Underhåll","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/maintenance"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b0n1","@type":"https://metadata.trafikverket.se/ns/MaintenanceInformation","dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":{"@language":"sv","@value":"Ajourhållning sker till största delen av Trafikverkets personal via dataleveranser från olika datakällor. Dataleverantör kan erbjudas möjlighet att ajourhålla databasen under förutsättning att man kan leverera enligt de krav som Trafikverket ställer."}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n0"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n1"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n10"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n6"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n4"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n5"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n0"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n1"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n10"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n4"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n5"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n7"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n8"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n9"}]},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n7"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n8"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b10n9"},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInformation","https://metadata.trafikverket.se/ns/deliveryFormat":[{"@id":"https://metadata.trafikverket.se/store/87/resource/1"},{"@id":"https://metadata.trafikverket.se/store/87/resource/7"},{"@id":"https://metadata.trafikverket.se/store/87/resource/9"}],"https://metadata.trafikverket.se/ns/deliveryMedium":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/187"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"},{"@id":"https://metadata.trafikverket.se/store/1/resource/963"}]},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b11n1","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b11n0"},"dct:title":"Tillhandahållande","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/delivery"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b12n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b13n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b13n3"}},{"@id":"_:a5e39ae8f4b42235ee1e83fe981b3952bab03e4cea5172960f57cb626d5c50ce_b13n1","@type":"http://www.w3.org/