rface conditions, road ferries, and frost damage."},{"@language":"sv","@value":"En applikation där det finns information om trafikläget (händelser och vägarbeten med stor påverkan på trafiken), alla vägarbeten, händelser med restriktioner på vägen, rastplatser, trafiksäkerhetskameror, trafikkameror, vägväder med kamerabilder, väglagsinformation, vägfärjor och tjälskador."}],"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:42e32d74a2c801c00512a2d04160f260afe457f53e3fa73210f124af306a8b55_b0n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoCatalogueService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Trafikinformation vägkarta"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"01a9e018-8dd8-46b7-922e-f60f14f33547","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:42e32d74a2c801c00512a2d04160f260afe457f53e3fa73210f124af306a8b55_b1n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/1731","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/55"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1732"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1733"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1734"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1735"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1737"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1738"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1739"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1740"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1741"}],"dcat:keyword":[{"@language":"en","@value":"road - traffic information"},{"@language":"sv","@value":"väg - trafikinformation"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:conformsTo":[{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://datex2.eu/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Situationer som innehåller händelser och störningar som trafikmeddelanden, vägarbeten, olyckor, restiktioner m.m\n\nI Datex II finns varje situation (accident, emergency info, ferries, frost damage, road surface conditions, road works, traffic message, situation closed) upplagda och beskrivna  som egna datamängder. \n\nFörändringslogg\nDatamängden har utökats med fältet Deviation.Suspended som anger om den aktuella händelsen är aktiv eller ej."},"dct:issued":{"@type":"xsd:date","@value":"2017-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:42e32d74a2c801c00512a2d04160f260afe457f53e3fa73210f124af306a8b55_b2n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:42e32d74a2c801c00512a2d04160f260afe457f53e3fa73210f124af306a8b55_b3n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},"dct:title":[{"@language":"en","@value":"Situation"},{"@language":"sv","@value":"Situation"}],"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/dataproduktspecifikationer-vag"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/las-om-vara-data/"},{"@id":"https://data.trafikverket.se/documentation/datex/situation"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/1678"},{"@id":"https://metadata.trafikverket.se/store/1/resource/754"}],"http://entryscape.org/terms/metadataIdentifier":"62cf3adc-8bc8-4e64-be64-2e52e30fe5ba","https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/APIArea/api-public"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/1732","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/1678"},"dcat:accessURL"