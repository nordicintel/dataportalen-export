af_b46n0"}},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"Informationsdokument: NVDB informationsmodell"}},{"@id":"https://www.nvdb.se/sv/dokumentation/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som är avsedda för dem som behöver veta mer om NVDB-systemet, vilka data som hanteras och hur de hanteras."},"dct:title":{"@language":"sv","@value":"Informationssida: NVDB Dokumentation"}},{"@id":"https://www.nvdb.se/sv/om-nvdb/vart-kvalitetsarbete/nvdb-datavalideringar/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Datakontroller som görs för fullständighet för brist och övertalighet samt sambandskontroller."},"dct:title":{"@language":"sv","@value":"Valideringsdokument: datavalidering: NVDB datavalidering"}},{"@id":"https://www.sis.se/api/document/get/8017694","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 40:2015. Bygger på en äldre version av standarden."},"dct:title":[{"@language":"en","@value":"Geographic information - Technical framework – Manual for  data product specification"},{"@language":"sv","@value":"Geografisk information - Tekniskt ramverk – Handbok för  dataproduktspecifikation"}]},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/ss-en-iso-19157-12023/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19157-1"},"dct:title":[{"@language":"en","@value":"Geographic information - Data quality – Part 1: General requirements"},{"@language":"sv","@value":"Geografisk information - Datakvalitet - Del 1: Allmäna krav"}]},{"@id":"https://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/ss-en-iso-191312022/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"SS-EN ISO 19131"},"dct:title":{"@language":"sv","@value":"Geographic Information - Data Product Specifications (Standard)"}},{"@id":"https://www.sis.se/relevantastandarderfrgeodataenvgledning/Om19157/","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Handledning som stödjer den internationella standarden för geodatakvalitet SS-EN ISO 19157 Geografisk information – Datakvalitet"},"dct:title":{"@language":"sv","@value":"Handledning för datakvalitet"}},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}},{"@id":"https://www.trafikverket.se/tjanster/trafiktjanster/Vagtrafik--och-hastighetsdata/fordonsfloden-och-hastigheter/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"På trafikflödeskartan och klickbara kartan finns information om fordonsflödet på statliga vägnätet. Där presenteras bland annat årsmedeldygnstrafik (ÅDT) för fordon, mc-flöden, cykel-flöden och hastighetsinformation. Här finns också mc-flöden som pdf."},"dct:title":{"@language":"sv","@value":"Informationssida: Fordonsflöden och hastigheter"}}],"@id":"urn:source:97ca4a8821a99418856299273c79208bcc6424865a17aea66b140b9c5ef4e8af"},{"@graph":[{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Dataprodukter för järnväg beskrivs genom att de ges en utbredning med koppling till järnvägsnätet samt en eller flera attributtyper. Dataprodukter knyts till järnvägsnätet för att de ska kunna behandlas på ett enhetligt sätt i förhållande till dels varandra, dels till själva järnvägsnätet.\n\nDataprodukten ingår i NJDB – nationell järnvägsdatabas."}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b10n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b11n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b12n0","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46(0)771921921"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b1n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.11 69.06,24.16 69.06,24.16 55.34,11.11 55.34,11.11 69.06))"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b2n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2099-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2001-01-01"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n0","http://www.w3.org/ns/prov#hadPlan":{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n3"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n1","@type":"http://www.w3.org/ns/prov#Activity","http://www.w3.org/ns/prov#generated":{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n2"},"http://www.w3.org/ns/prov#qualifiedAssociation":{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n0"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d315_b3n2","dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/DegreeOfConformity/conformant"}},{"@id":"_:9953173f1ce7c76079964fbf31f8ca83eb1a826211e723953c1416c2d381d