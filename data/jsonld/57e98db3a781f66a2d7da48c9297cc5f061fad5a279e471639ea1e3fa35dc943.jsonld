:"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:alternative":{"@language":"en","@value":"Data Exchange Portal"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning:API"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-10-13"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Plattform avsedd﻿ för integration och datautbyte. Applikationen innehåller också API-tjänster för nedladdning av väg- och järnvägsdata: \n\n- API Öppna Data  - https://data.trafikverket.se/documentation/datacache\n- API Järnväg - https://data.trafikverket.se/documentation/api-railway\n- API Datex II - https://data.trafikverket.se/documentation/datex"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-19"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b4n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/comTransferService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"Datautbytesportalen"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/transformation"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"c429b2a7-a1e8-42ae-ab61-be11e91748ec","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b5n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/railway-data"},{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/railway"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/966","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:endpointURL":{"@id":"https://pmsv4.trafikverket.se"},"dcat:keyword":[{"@language":"en","@value":"map service"},{"@language":"sv","@value":"karttjänst"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=966&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:OGC:API-Maps"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:created":{"@type":"xsd:date","@value":"2020-04-21"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":{"@language":"sv","@value":"Ett visningssystem för att se var och vilka åtgärder avseende beläggning och avvattning som inrapporterats för belagda och grusvägar samt för att titta på mätta och beräknade tillstånd på de belagda vägarna. Relevant vägdata hämtas också från NVDB för både belagda vägar och grusvägar.\n\nSystemet visar resultaten i kartor, tabeller eller diagram. Systemet ska vara en hjälp för att avgöra vilka vägar som ska prioriteras för beläggnings- och avvattningsåtgärder."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-04-15"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b6n0"},"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/humanGeographicViewer"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceCategory/infoCatalogueService"},{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:title":{"@language":"sv","@value":"PMSV4 – Se tillstånd på belagda vägar"},"dct:type":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialDataServiceType/view"},"foaf:page":[{"@id":"https://bransch.trafikverket.se/anvandadata"},{"@id":"https://bransch.trafikverket.se/contentassets/50e12058cb4747ea9809b2ffa8c3dbe2/data-i-pmsv4-extern-aktualitet-och-ursprung.pdf"},{"@id":"https://bransch.trafikverket.se/for-dig-i-branschen/vag/information-om-statliga-vagar-verktyget-pmsv4/"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://pmsv4.trafikverket.se/about-vars"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"6c7f1d4b-b769-464b-a4d3-ad887878d70b","http://www.w3.org/ns/prov#wasUsedBy":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b7n1"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/4/resource/15","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Lastkajen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:lastkajen@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b8n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/16","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Geografisk information","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geografisk.information@trafikverket.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944_b9n0"}},{"@id":"https://metadata.trafikverket.se/store/4/resource/22","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Trafikverket - Beläggningsdata","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:pmsv4@trafikverket.se"}},{"@id":"https://pmsv4.trafikverket.se/about-vars","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Länk till dokumentation om de variabler som finns i systemet PMS."},"dct:title":{"@language":"sv","@value":"Informationsdokument: PMS - variabelbeskrivning"}},{"@id":"https://www.sis.se/api/document/get/86342","@type":"dct:Standard","dct:description":{"@language":"sv","@value":"Teknisk rapport SIS-TR 14:2012"},"dct:title":[{"@language":"en","@value":"Geographic information - Metadata in Swedish"},{"@language":"sv","@value":"Geografisk information - Metadata på svenska"}]},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Information om plattformar för att hämta data och instruktioner om hur man hämtar data"},"dct:title":{"@language":"sv","@value":"Informationssida: Tillhandahållande av resurs"}}],"@id":"urn:source:0ee929530b1c08c3920cbb9b61b668db36ab804ad6fd8738f7fca8ce4d92d944"},{"@graph":[{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b0n0","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b0n1"},"dct:title":"Vägledning","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"http://www.w3.org/ns/dx/prof/role/guidance"}},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b0n1","@type":"http://purl.org/dc/dcmitype/Collection","dct:title":{"@language":"sv","@value":"Om Dataprodukten"},"http://schema.org/text":{"@language":"sv","@value":"Vägar med inskränkning av farligt gods är vägar där transport av farligt gods är begränsat eller förbjudet enligt specifika regler, meddelad genom trafikföreskrift. Dessa regler grundar sig oftast på säkerhetsaspekter, till exempel för att minska risken vid transporter genom tätbebyggda områden, tunnlar eller miljökänsliga områden. Inskränkningarna kan bestå i att fordonet inte får föras på vägen eller att fordonet inte får stannas eller parkeras. \n\nBefintliga trafikföreskrifter samlas i Transportstyrelsens databas Svensk trafikföreskriftsamling (STFS). Det är Länsstyrelsen som beslutar i frågan och ansvarar för uppgifterna. \n\nDataprodukten härleds från befintliga trafikföreskrifter om inskränkningar för transport av farligt gods. Härledningen kan vara en förenkling av föreskriften och för att få helheten vad som gäller bör man läsa vad som står i trafikföreskriften. Man kan hitta den i STFS med hjälp av attributet Beteckning. \n\nDataprodukten använder Det svenska vägnätet som referenssystem d.v.s. utbredningarna är angivna i förhållande till bil-, cykel- eller gångnätet, se kapitel Identifiering av dataproduktspecifikation/ Relaterad dataproduktspecifikation."}},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n0"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n1"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n10"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n2","@type":"https://metadata.trafikverket.se/ns/DataCaptureInformation","https://metadata.trafikverket.se/ns/dataCaptureStatement":{"@language":"sv","@value":"¤ Initiala datakällor\n\n1980 - Initialt laddades NVDB med statligt vägnät från VDB (Vägdatabanken), dåvarande Vägverkets databas för vägdata\n2001 – Kommunalt och enskilt bilnät överfördes från Lantmäteriets GGD-databas\n2006 – Cykelnät infördes\n2014 – Gångnät infördes\n\n¤ Datakällor för ajourhållning\n\nVägnät där väghållare är statlig - från Trafikverket vid förändringar av det statliga vägnätet.\n\nVägnät där väghållare är kommunal – från respektive kommun enligt gällande avtal om leveranser till NVDB. \n\nVägnät där väghållare är enskild och ligger inom kommuns leveransområden – från respektive kommun vid förändring enligt gällande avtal om leveranser till NVDB.\n\nVägnät där väghållare är enskild och av intresse för skogsnäringen – skogsbolagen levererar underlag för sina egna vägar. \n\nVägnät där väghållare är enskild och där dataleverantör saknas – ajourhålls av Lantmäteriet."},"https://metadata.trafikverket.se/ns/production":{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n6"}},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n3","@type":"http://www.w3.org/ns/dx/prof/ResourceDescriptor","dct:subject":{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n2"},"dct:title":"Datafångst och produktion","http://www.w3.org/ns/dx/prof/hasRole":{"@id":"https://metadata.trafikverket.se/concepts/dps-prof-roles/dataCapture"}},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n4"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n5"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n6","@type":"https://metadata.trafikverket.se/ns/Production","dct:hasPart":[{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n0"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n1"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n10"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n4"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n5"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n7"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n8"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n9"}]},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n7"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n8"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b10n9"},{"@id":"_:0efe1be2d616b02dc915d04d003e565b5caad865ac74e8a1ee3c5e74aa3ac5ee_b11n0","@type":"https://metadata.trafikverket.se/ns/DeliveryInfo