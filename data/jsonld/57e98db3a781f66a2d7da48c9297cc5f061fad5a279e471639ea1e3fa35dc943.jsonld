5e4645e868c7/tjanstebeskrivning_inspire_tn_giltig-version.pdf"},{"@id":"https://bransch.trafikverket.se/tjanster/data-kartor-och-geodatatjanster/"},{"@id":"https://www.trafikverket.se/e-tjanster/hamta-data-fran-trafikverket/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.org/terms/metadataIdentifier":"84ce3866-7e61-4a30-9827-c51631ad0121","http://www.w3.org/ns/adms#identifier":"TN.RoadTransportNetwork.DownloadService","http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b16n1"},{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b17n1"}],"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}]},{"@id":"https://metadata.trafikverket.se/store/1/resource/278","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://metadata.trafikverket.se/store/4/resource/16"},"dcat:distribution":[{"@id":"https://metadata.trafikverket.se/store/1/resource/473"},{"@id":"https://metadata.trafikverket.se/store/1/resource/523"},{"@id":"https://metadata.trafikverket.se/store/1/resource/572"}],"dcat:keyword":[{"@language":"en","@value":"INSPIRE"},{"@language":"sv","@value":"INSPIRE"}],"dcat:landingPage":{"@id":"https://data.trafikverket.se/search/search-data/details?esc_entry=278&esc_context=1"},"dcat:theme":[{"@id":"http://inspire.ec.europa.eu/theme/tn"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"},"dct:alternative":[{"@language":"sv","@value":"TN.Väg.Referenslänk"},{"@language":"sv","@value":"Vägnät - Referenslänk (INSPIRE)"}],"dct:conformsTo":[{"@id":"http://www.opengis.net/def/crs/EPSG/0/3006"},{"@id":"http://www.opengis.net/def/crs/EPSG/0/4258"},{"@id":"http://www.sis.se/produkter/foretagsorganisation/kvalitet/allmant/sseniso191152005/"},{"@id":"http://www.sis.se/produkter/informationsteknik-kontorsutrustning/ittillampningar/it-tillampningar-inom-vetenskap/sis-ts-802018/"},{"@id":"https://www.sis.se/api/document/get/86342"}],"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"The dataset provides linksequence, according to the INSPIRE Transport Network (TN) specification for RoadLinkSequence. \n\nThe linksequences are the linear reference system used in NVDB. However, the reference links store no history information and are accumulated over time. A Linksequence represents a stretch of road that has been opened to traffic at a specific point in time.  The dataset can show several alternative geometries from same location but from different time, such as past road geometry, and therefore unsuitable for visualisation. See also “Link” or “Road link (Inspire)\n\n It is generated from the following road data products:\no\tLink Sequence  (preciously called Reference link/ Referenslänk)"},{"@language":"sv","@value":"Datamängden redovisar LinkSequence enligt Inspiretema transportnät (TN) RoadLinkSequence.\n\nRoadLinkSequence är genererad ur från följande vägdataprodukter: LinkSequence (fd Referenslänk).\n\nLinkSequence är det linjära referenssystemet som används i NVDB. Den saknar historik och ackumuleras över tid. En LinkSequence representerar en vägsträcka som öppnats för trafik vid ett och samma tillfälle.\nDatamängden kan innehålla flera alternativa geometrier från samma plats tex tidigare vägar, och följaktligen inte användbara för visualisering.  Se även ”Link” eller  Road Link (INSPIRE)\nLinkSequence översätts direkt till INSPIRE Road Link Sequence."}],"dct:identifier":"88237654-1449-4a76-a048-e25b936cbf99","dct:issued":{"@type":"xsd:date","@value":"2010-12-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:modified":{"@type":"xsd:date","@value":"2016-03-22"},"dct:provenance":{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b18n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:spatial":[{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b19n0"},{"@id":"https://sws.geonames.org/2661886"}],"dct:subject":[{"@id":"http://inspire.ec.europa.eu/metadata-codelist/TopicCategory/transportation"},{"@id":"http://www.eionet.europa.eu/gemet/concept/8641"}],"dct:temporal":{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b20n0"},"dct:title":{"@language":"en","@value":"Road Transport Network - Road Link Sequence (INSPIRE)"},"foaf:page":[{"@id":"http://www.nvdb.se"},{"@id":"https://bransch.trafikverket.se/TrvSeFiler/Dataproduktspecifikationer/V%C3%A4gdataprodukter/DPS_C-D/1085Det_svenska_v%C3%A4gn%C3%A4tet.pdf"},{"@id":"https://www.nvdb.se/globalassets/upload/styrande-och-vagledande-dokument/nvdb---informationsmodell-v8.pdf"},{"@id":"https://www.nvdb.se/sv/dokumentation/"}],"http://data.europa.eu/r5r/applicableLegislation":{"@id":"http://data.europa.eu/eli/reg_impl/2023/138/oj"},"http://data.europa.eu/r5r/hvdCategory":{"@id":"http://data.europa.eu/bna/c_b79e35eb"},"http://entryscape.com/terms/servedByDataService":[{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},{"@id":"https://metadata.trafikverket.se/store/1/resource/239"},{"@id":"https://metadata.trafikverket.se/store/1/resource/240"}],"http://entryscape.org/terms/metadataIdentifier":"348bb015-9ce6-4926-aab4-17cfe2b48772","http://www.w3.org/ns/adms#identifier":"TN.RoadTransportNetwork.RoadLinkSequence","http://www.w3.org/ns/adms#status":{"@id":"https://dataportal.se/concepts/ProgressCode/onGoing"},"http://www.w3.org/ns/prov#wasUsedBy":[{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b21n1"},{"@id":"_:5634e44b2575b0c5d6430be0dce5191b0927499b55fcc96ef08677fb098fa804_b22n1"}],"https://dataportal.se/concepts/geose/areaCoveredQuotient":"449964/449964","https://dataportal.se/concepts/geose/spatialScope":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/SpatialScope/national"},"https://dataportal.se/concepts/geose/useLimitation":{"@language":"sv","@value":"Ingen begränsning"},"https://metadata.trafikverket.se/ns/keyword":[{"@id":"https://metadata.trafikverket.se/concepts/DataProductCategory/road-data"},{"@id":"https://metadata.trafikverket.se/concepts/TransportMode/road"}],"https://metadata.trafikverket.se/schema/confidentiality":"1"},{"@id":"https://metadata.trafikverket.se/store/1/resource/473","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"https://metadata.trafikverket.se/store/1/resource/186"},"dcat:accessURL":{"@id":"https://lastkajen.trafikverket.se/productpackages/10096"},"dct:conformsTo":{"@id":"https://resources.geodata.se/codelist/metadata/protokoll.xml#HTTP:Nedladdning"},"dct:description":{"@language":"sv","@value":"\"Datamängd gällande vägtransportnätverket. Filerna finns i geopackage-format (separata filer) samt geopackage (i paketet med samlingsnamn Tn_roadtransportnetwork_se.zip). Extern eller intern maskinell filnedladdning kan göras via API-datatjänst.\n\nOBS: För åtkomst/nedladdning, klicka på länken under webbadress och logga in på Lastkajen (användarkonto krävs). Efter inloggning, klistra in samma länk i webbläsaren för direkt åtkomst.\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"en","@value":"TN.RoadTransportNetwork.RoadLinkSequence - download through Lastkajen"},"http://data.europa.eu/r