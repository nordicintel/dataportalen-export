egutv/nedladdning/skaneleden/sl_vattenriket.gpx"},"dct:description":{"@language":"sv","@value":"gpx"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"SL6 Vattenriket, gpx-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:f5e8b52cf01f69501ea8212db835ca73e6bbcbb038ac9b02620aca901322ce8d"},{"@graph":[{"@id":"_:ff73f9b0fb6e0ef4111dab9df886192350add3a1d629e1cebd13078ed2b1110d_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.298071646006955 56.58075128374489,14.838657055635332 56.58075128374489,14.838657055635332 55.29484390392932,12.298071646006955 55.29484390392932,12.298071646006955 56.58075128374489))"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/16","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/56"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/17"},{"@id":"https://oppnadata.skane.se/store/34/resource/18"},{"@id":"https://oppnadata.skane.se/store/34/resource/19"}],"dcat:keyword":[{"@language":"sv","@value":"Grönstruktur"},{"@language":"sv","@value":"Region Skåne"},{"@language":"sv","@value":"Regional"},{"@language":"sv","@value":"Regionplan"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Den regionala grönstrukturen består av grönområden och grönstråk och omfattar både ekologiska och rekreativa värden. Datamängden är framtagen till Regionplan för Skåne 2022-2040 och visar på översiktlig nivå befintliga grönområden, grönstråk av regional betydelse samt utvecklingspotentialen för att skapa nya grönstråk. Datamängden innefattar även Skåneleden - befintlig och med utvecklingspotential, regionala cykelturismleder samt strategiska noder för vandring och cykling."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":[{"@id":"_:ff73f9b0fb6e0ef4111dab9df886192350add3a1d629e1cebd13078ed2b1110d_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:title":{"@language":"sv","@value":"Skånes övergripande grönstruktur"}},{"@id":"https://oppnadata.skane.se/store/34/resource/17","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wfs?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Skånes övergripande grönstruktur som WFS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WFS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/18","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wms?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Skånes övergripande grönstruktur som WMS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/19","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/efe7163a39054fd698393a5b81bf7aaf/page/Strukturkarta-2040/"},"dct:description":{"@language":"sv","@value":"Se Skånes övergripande grönstruktur i visningsverktyget för strukturkartan för Regionplan för Skåne 2022–2024"},"dct:title":{"@language":"sv","@value":"Visualiseringstjänst"}},{"@id":"https://oppnadata.skane.se/store/34/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Regional planering, Region Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:regionalplanering@skane.se"}}],"@id":"urn:source:ff73f9b0fb6e0ef4111dab9df886192350add3a1d629e1cebd13078ed2b1110d"}]}
