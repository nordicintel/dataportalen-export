{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.291476665183014 56.6126601320795,14.796359477683012 56.6126601320795,14.796359477683012 55.24023484913019,12.291476665183014 55.24023484913019,12.291476665183014 56.6126601320795))"}},{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:gYear","@value":"2024"},"dcat:startDate":{"@type":"xsd:gYear","@value":"2007"}},{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b2n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/processor"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2321000255"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/20","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/56"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/21"},{"@id":"https://oppnadata.skane.se/store/34/resource/22"},{"@id":"https://oppnadata.skane.se/store/34/resource/23"}],"dcat:keyword":[{"@language":"sv","@value":"Sammanställning"},{"@language":"sv","@value":"Skåne"},{"@language":"sv","@value":"ÖP-sammanställning"},{"@language":"sv","@value":"Översiktsplan"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Denna datamängd innehåller sammanställda länkar från kommunernas webbsidor. Länkarna leder till kommunernas gällande översiktsplanedokument, eventuella tillgängliga kartverktyg och kommunernas övriga information om översiktsplanering. Länkarna är kopplade till översiktsplanernas respektive geografiska planområde. Datamängden är en del av Region Skånes arbete med att sammanställa GIS-data från de skånska kommunernas översiktsplaner.\n\n\nDisclaimer:\nDatamängden täcker inte information för alla gällande översiktsplaner i Skåne och några fördjupade översiktsplaner saknas. Kontakta gärna Region Skåne för att leverera ytterligare ÖP-data. De geografiska planområdena bör betraktas som representativa. Vid behov av exakta geografier, kontakta respektive kommun. Kommuner ändrar ibland sina webbsidor, vilket kan leda till brutna länkar. Vid brutna länkar, kontakta Region Skåne."},"dct:issued":{"@type":"xsd:date","@value":"2024-11-05"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":[{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:temporal":{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b1n0"},"dct:title":{"@language":"sv","@value":"Skånes översiktsplaninformation"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4_b2n0"}},{"@id":"https://oppnadata.skane.se/store/34/resource/21","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://oppnadata.skane.se/store/34/resource/24"},"dcat:downloadURL":{"@id":"https://oppnadata.skane.se/store/34/resource/24"},"dct:description":{"@language":"sv","@value":"Skånes översiktsplaninformation\n\nDenna datamängd innehåller sammanställda länkar från kommunernas webbsidor. Länkarna leder till kommunernas gällande översiktsplanedokument, eventuella tillgängliga kartverktyg och kommunernas övriga information om översiktsplanering. Länkarna är kopplade till översiktsplanernas respektive geografiska planområde. Datamängden är en del av Region Skånes arbete med att sammanställa GIS-data från de skånska kommunernas översiktsplaner.\n\n\nDisclaimer:\n\nDatamängden täcker inte information för alla gällande översiktsplaner i Skåne och några fördjupade översiktsplaner saknas. Kontakta gärna Region Skåne för att leverera ytterligare ÖP-data. De geografiska planområdena bör betraktas som representativa. Vid behov av exakta geografier, kontakta respektive kommun. Kommuner ändrar ibland sina webbsidor, vilket kan leda till brutna länkar. Vid brutna länkar, kontakta Region Skåne."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GEOJSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-11-05T14:50:21.901Z"},"dct:title":{"@language":"sv","@value":"GeoJSON-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}},{"@id":"https://oppnadata.skane.se/store/34/resource/22","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wfs"},"dct:description":{"@language":"sv","@value":"Skånes översiktsplaninformation\n\nDenna datamängd innehåller sammanställda länkar från kommunernas webbsidor. Länkarna leder till kommunernas gällande översiktsplanedokument, eventuella tillgängliga kartverktyg och kommunernas övriga information om översiktsplanering. Länkarna är kopplade till översiktsplanernas respektive geografiska planområde. Datamängden är en del av Region Skånes arbete med att sammanställa GIS-data från de skånska kommunernas översiktsplaner.\n\nDisclaimer:\nDatamängden täcker inte information för alla gällande översiktsplaner i Skåne och några fördjupade översiktsplaner saknas. Kontakta gärna Region Skåne för att leverera ytterligare ÖP-data. De geografiska planområdena bör betraktas som representativa. Vid behov av exakta geografier, kontakta respektive kommun. Kommuner ändrar ibland sina webbsidor, vilket kan leda till brutna länkar. Vid brutna länkar, kontakta Region Skåne."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:issued":{"@type":"xsd:date","@value":"2023-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":[{"@language":"en","@value":"WFS service"},{"@language":"sv","@value":"WFS-tjänst"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}},{"@id":"https://oppnadata.skane.se/store/34/resource/23","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skane.maps.arcgis.com/apps/instant/sidebar/index.html?appid=6325a73942414ea19ca831f35b658e45"},"dct:description":{"@language":"sv","@value":"Visningsapp för Skånes översiktsplaninformation"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningsapp"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/experimental"}},{"@id":"https://oppnadata.skane.se/store/34/resource/24","@type":"http://entryscape.com/terms/File","dct:title":"Skånes översktsplaninfo_241105.geojson"},{"@id":"https://oppnadata.skane.se/store/34/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Regional planering, Region Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:regionalplanering@skane.se"}}],"@id":"urn:source:27ba21d366cd826230a8d63de335747d8e94852ea0bf824bf31ec799c8ce44a4"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/26","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/56"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/27"},{"@id":"https://oppnadata.skane.se/store/34/resource/28"},{"@id":"https://oppnadata.skane.se/store/34/resource/29"}],"dcat:keyword":[{"@language":"sv","@value":"Infrastruktur"},{"@language":"sv","@value":"Region Skåne"},{"@language":"sv","@value":"Regionplan"},{"@language":"sv","@value":"Transport"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden är framtagen för strukturkartan till Regionplan för Skåne 2022-2040 och visar viktiga noder och stråk för person- och godstransporter samt transportinfrastruktur som ingår i det transeuropeiska transportnätet (TEN-T). Datamängden beskriver även behovet av större infrastruktursatsningar. Dessa tar utgångspunkt i Region Skånes positionspapper för infrastruktursatsningar \"Skånebilden\" och \"Skånes utgångspunkter\" samt i \"Regionsamverkan Sydsveriges Sydsvenska prioriteringar 2021\". Datamängden innehåller även hamnar, flygplaster och planerade sträckningar för supercykelvägar."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":{"@language":"sv","@value":"Skånes övergripande transportinfrastruktur"}},{"@id":"https://oppnadata.skane.se/store/34/resource/27","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wfs?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Skånes övergripande transportinfrastruktur som WFS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"WFS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/28","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wms?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Skånes övergripande transportinfrastruktur som WMS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/29","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/efe7163a39054fd698393a5b81bf7aaf/page/Strukturkarta-2040/"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Visualiseringstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Regional planering, Region Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:regionalplanering@skane.se"}}],"@id":"urn:source:28713c3b63e9cf623dc28a09c6b3cf8969f95956ddedb46843eb0dbe1fec0dec"},{"@graph":[{"@id":"_:3e3d69def1f92daeda2e38cb6d5cd7db2c6d1c57fef33d1dbd5c30051c71fd2f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.422 56.763,15.0793 56.763,15.0793 55.123,12.422 55.123,12.422 56.763))"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/10","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wms?&request=getcapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/11","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/cykelbarhetsklassning_skane.zip"},"dct:description":{"@language":"sv","@value":"Filformat Geopackage"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wfs?&request=getcapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}},{"@id":"https://oppnadata.skane.se/store/34/resource/9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/53"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/10"},{"@id":"https://oppnadata.skane.se/store/34/resource/11"},{"@id":"https://oppnadata.skane.se/store/34/resource/12"}],"dcat:keyword":[{"@language":"sv","@value":"Cykel"},{"@language":"sv","@value":"NVDB"}],"dcat:landingPage":[{"@id":"https://github.com/cyklaiskane/nvdb-tools"},{"@id":"https://utveckling.skane.se/regional-utveckling/verksamhetsomraden/infrastruktur-och-transporter/cykling/"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dcat:version":"2.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":{"@language":"sv","@value":"Cykelbarhetsklassning av vägar i Skåne är en klassificering av bil- och cykelvägnät från Nationella vägdatabasen (NVDB). Syftet är att klassificera alla vägar efter hur bra de är att cykla på ur ett trafiksäkerhetsperspektiv. Klassningen omfattar även kommuner i Sverige som gränsar till Skåne.\n\nFöljande klasser ingår: \nC0: Gångnät\nC1: Asfalterad cykelväg \nC2: Ej asfalterad cykelväg \nC3: Cykelfält \nB1: Riktigt lågtrafikerad eller smal bilväg \nB2: Lågtrafikerad bilväg \nB3: Bilväg som är tveksamt lämplig för cykling \nB4: Bilväg inte rekommenderad för cykling \nB5: Bilväg med förbud för cykling \nG1: Grusväg med förmodad högre standard \nG2: Övrig grusväg \nX: oklassad"},"dct:issued":{"@type":"xsd:date","@value":"2022-11-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":[{"@id":"_:3e3d69def1f92daeda2e38cb6d5cd7db2c6d1c57fef33d1dbd5c30051c71fd2f_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:title":{"@language":"sv","@value":"Cykelbarhetsklassning av vägar i Skåne"},"http://schema.org/diagram":{"@id":"https://oppnadata.skane.se/store/34/resource/13"},"http://www.w3.org/ns/adms#versionNotes":{"@language":"sv","@value":"I januari 2023 sågs klassindelningen över och två klasser lades till för ökad tydlighet: C0 och X. Dessutom har klassen B1 utökats med vägar där cykling inte bara är förbjuden utan även även starkt avrådd, det senare gäller på mittseparerade vägar. Dessutom har vi bytt namn på attributet för klassningen från TS_klass till CB_klass."}}],"@id":"urn:source:3e3d69def1f92daeda2e38cb6d5cd7db2c6d1c57fef33d1dbd5c30051c71fd2f"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/30","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/56"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/31"},{"@id":"https://oppnadata.skane.se/store/34/resource/32"},{"@id":"https://oppnadata.skane.se/store/34/resource/33"}],"dcat:keyword":[{"@language":"sv","@value":"Infrastruktur"},{"@language":"sv","@value":"Orter"},{"@language":"sv","@value":"Planering"},{"@language":"sv","@value":"Region Skåne"},{"@language":"sv","@value":"Regionplan"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":{"@language":"sv","@value":"Datamängden är framtagen till Regionplan för Skåne 2022-2040 och visar funktionellt viktiga orter i Skåne kategoriserade som tillväxtmotorer, regionala kärnor, centralorter och strategiska noder. Tillväxtmotorer har en viktig roll för att driva utvecklingen och generera attraktionskraft till Skåne. De förser regionens invånare med arbetstillfällen och ett kunskapsintensivt näringsliv, högre utbildning, specialistsjukvård och ett brett handels- och kulturutbud. Centralorterna utgörs av Skånes kommunhuvudorter. Utöver att vara viktiga som noder för kollektivtrafik, service och tillgång till rekreation är centralorterna samlingspunkt för offentlig förvaltning och politisk makt. De regionala kärnorna är större orter som är viktiga för att förse sitt omland med arbetstillfällen, service samt handels- och kulturutbud. Strategiska noder är ett samlingsbegrepp för att synliggöra mindre orter utifrån deras betydelse för offentlig och privat service, kollektivtrafik samt tillgång till rekreation och besöksnäring genom sin koppling till Skåneleden och de regionala turistcykellederna."},"dct:issued":{"@type":"xsd:date","@value":"2022-06-14"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":{"@language":"sv","@value":"Skånes flerkärniga ortsstruktur"}},{"@id":"https://oppnadata.skane.se/store/34/resource/31","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wfs?&request=getcapabilities"},{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wms?&request=getcapabilities"}],"dcat:downloadURL":[{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wfs?&request=getcapabilities"},{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wms?&request=getcapabilities"}],"dct:description":{"@language":"sv","@value":"Skånes flerkärniga ortsstruktur som WFS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"WFS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/32","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_regionplan/wms?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Skånes flerkärniga ortsstruktur som WMS-tjänst"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/33","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://experience.arcgis.com/experience/efe7163a39054fd698393a5b81bf7aaf/page/Strukturkarta-2040/"},"dct:description":{"@language":"sv","@value":"Se Skånes flerkärniga ortsstruktur i visningsverktyget för strukturkartan för Regionplan för Skåne 2022–2024"},"dct:title":{"@language":"sv","@value":"Visualiseringstjänst"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://oppnadata.skane.se/store/34/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Regional planering, Region Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:regionalplanering@skane.se"}}],"@id":"urn:source:82541dc237569a92f38162f00f3e268de2cbd652bb873637cf85de277e9edc50"},{"@graph":[{"@id":"_:9952c50258f855d640c7057170f34d614e37394a40d44b715a2842d3fb1d19a8_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.305932560313448 56.50952752329553,14.454546525527483 56.50952752329553,14.454546525527483 55.29696041179628,12.305932560313448 55.29696041179628,12.305932560313448 56.50952752329553))"}},{"@id":"_:9952c50258f855d640c7057170f34d614e37394a40d44b715a2842d3fb1d19a8_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2026-04-29"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/59","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skånes Geodatafunktion","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"}},{"@id":"https://oppnadata.skane.se/store/34/resource/67","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/59"},"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/68"},{"@id":"https://oppnadata.skane.se/store/34/resource/69"},{"@id":"https://oppnadata.skane.se/store/34/resource/70"}],"dcat:keyword":[{"@language":"sv","@value":"3-30-300"},{"@language":"sv","@value":"Grönstruktur"},{"@language":"sv","@value":"Krontäckning"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC"},"dct:description":{"@language":"sv","@value":"3-30-300 är en analysmodell för grönare och hälsosammare städer och bygger på tre aspekter:\n\n3 – varje invånare ska kunna se minst tre träd från sin bostad.\n30 – varje stadsdel bör ha minst 30 procent krontäckning.\n300 – varje invånare ska ha högst 300 meter till närmaste grönområde.\n\nDatamängden innehåller dels resultat för de tre aspekterna på tätorts-, DeSO- och kommunnivå, dels beräknad krontäckning per DeSO och 100- metersruta. All data är i koordinatsystemet SWEREF 99 TM.\n\nDatamängden (WMS, WFS, geopackage) innehåller följande:\n\nBeräknad krontäckning per DeSO-område, klippt mot tätortsytor.\nSammanställning av alla resultat inom 3-30-300 på DeSO-nivå.\nSammanställning av alla resultat inom 3-30-300 på tätortsnivå.\nSammanställning av alla resultat inom 3-30-300 på kommunnivå.\n\nFör analysen har följande indata använts:\n•\tJordbruksblock 2022\n•\tVägar från NVDB \n•\tSamtliga anläggningstyper i Nationella Marktäckedata utom kyrkogårdar/begravningsplatser (kod 2)\n•\tTopografi 10 (ersatte Topografi 50) för beräkning av grönområden.\n•\tTrädhöjdraster från Metria 2022\n\nTrädhöjdrastret från Metria är inte heltäckande och saknar data för tre tätorter i Skåne. Analysen saknar därmed data för Rögla (Ystad kommun), Hörja (Hässleholm kommun) och Vanneberga (Kristianstad kommun)."},"dct:issued":{"@type":"xsd:date","@value":"2026-04-29"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":[{"@id":"_:9952c50258f855d640c7057170f34d614e37394a40d44b715a2842d3fb1d19a8_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:temporal":{"@id":"_:9952c50258f855d640c7057170f34d614e37394a40d44b715a2842d3fb1d19a8_b1n0"},"dct:title":{"@language":"sv","@value":"3-30-300 analys för Skåne"},"http://schema.org/diagram":{"@id":"https://oppnadata.skane.se/store/34/resource/90"}},{"@id":"https://oppnadata.skane.se/store/34/resource/68","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_330300/wms?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller beräknad krontäckning samt sammanställningar av indikatorn 3–30–300 på olika geografiska nivåer (DeSO, tätort och kommun)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WMS-tjänst för krontäckning och sammanställningar (DeSO, tätort och kommun)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/69","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_330300/wfs?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller beräknad krontäckning samt sammanställningar av indikatorn 3–30–300 på olika geografiska nivåer (DeSO, tätort och kommun)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"WFS-tjänst för krontäckning och sammanställningar (DeSO, tätort och kommun)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/70","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/3_30_300/skane_3_30_300.zip"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller resultaten från analysen på tätorts-, deso(AB)- och kommunnivå redovisat som andel (procent) av befolkningen som uppfyller de olika nivåerna). Det finns även 100-metersrutor med krontäckningsgrad (andel) för de rutor som ligger helt eller delvis inom deso (AB) i Skåne."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning Geopackage"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:9952c50258f855d640c7057170f34d614e37394a40d44b715a2842d3fb1d19a8"},{"@graph":[{"@id":"_:a1ea34dd83cc6c21aa35dc55f68bff3af427a832d416db86971296908b140d97_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Datamängden omfattar inte alla registrerade resor i resvaneundersökning för Skåne 2018.\n\nPositionsdata som ingår i resvaneundersökningen baserar sig på adresser som de tillfrågade själva har skrivit in. Geokodningen har inte varit 100% säker och därför saknas koordinater för en del resor. Dessutom är vissa resor cirkulära, dvs har samma utgångspunkt som målpunkt, och kan inte användas för ruttning. Ett urval har gjorts och enbart de resor som har både start- och målkoordinater har använts för nätutläggning.\n\nEfter sållning kan man se att färdmedelsfördelningen hålls relativt konstant men att det är främst resor till fots som sorterats bort. Av totalt 75373 resor i ursprungsdatan är det 44507 som använts för nätutläggning och 30866 som sorterats bort varav 7299 cirkulära.\n\nData är anonymiserat dels genom att attribut för att identifiera respondenter är utbytta samt att resornas start- och slut är klippta. Hur omfattande klippningen är, dvs hur lång del av polyline som är bortklippt i start eller slut, baseras på hur tätt start- och slutpunkter ligger för unika respondenter.\n\nUtöver det har de ursprungliga ärendetyperna aggregerats så att färre kategorityper redovisas."}},{"@id":"_:a1ea34dd83cc6c21aa35dc55f68bff3af427a832d416db86971296908b140d97_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:gYear","@value":"2018"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/3","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/53"},"dcat:distribution":{"@id":"https://oppnadata.skane.se/store/34/resource/4"},"dcat:keyword":{"@language":"sv","@value":"resor"},"dcat:landingPage":[{"@id":"https://utveckling.skane.se/publikationer/publikationer/resvaneundersokning-i-skane/"},{"@id":"https://utveckling.skane.se/siteassets/publikationer/rvu_skane2018_natutlaggning_metodrapport_trivector.pdf"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":{"@language":"sv","@value":"I syfte att kvalitetssäkra och visualisera de resor som registrerades i resvaneundersökningen 2018 har Region Skåne gjort en nätutläggning av de registrerade resorna genom ruttning i väg- och kollektivtrafiknät. Datamängden omfattar resdata som har omvandlats till geografisk data."},"dct:provenance":{"@id":"_:a1ea34dd83cc6c21aa35dc55f68bff3af427a832d416db86971296908b140d97_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:temporal":{"@id":"_:a1ea34dd83cc6c21aa35dc55f68bff3af427a832d416db86971296908b140d97_b1n0"},"dct:title":{"@language":"sv","@value":"Resvaneundersökning i Skåne 2018, anonymiserad nätutläggning"}},{"@id":"https://oppnadata.skane.se/store/34/resource/4","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/rvu_skane_2018_natutlaggning_anonymiserad.zip"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av datamängd och metodrapport"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}}],"@id":"urn:source:a1ea34dd83cc6c21aa35dc55f68bff3af427a832d416db86971296908b140d97"},{"@graph":[{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.39510331274467 56.54478381599492,14.6295654167992 56.54478381599492,14.6295654167992 55.3297870054721,12.39510331274467 55.3297870054721,12.39510331274467 56.54478381599492))"}},{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b1n0","@type":"http://www.w3.org/ns/prov#Attribution","dcat:hadRole":{"@id":"http://inspire.ec.europa.eu/metadata-codelist/ResponsiblePartyRole/owner"},"http://www.w3.org/ns/prov#agent":{"@id":"http://dataportal.se/organisation/SE2321000255"}},{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b2n0","@type":"http://schema.theodi.org/odrs#RightsStatement","http://schema.theodi.org/odrs#attributionText":{"@language":"sv","@value":"Källa: Region Skåne"}},{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/36","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/53"},"dcat:distribution":{"@id":"https://oppnadata.skane.se/store/34/resource/37"},"dcat:keyword":[{"@language":"en","@value":"Demography"},{"@language":"en","@value":"Population forecast"},{"@language":"en","@value":"Population projection"},{"@language":"en","@value":"Population"},{"@language":"sv","@value":"Befolkning"},{"@language":"sv","@value":"Befolkningsprognos"},{"@language":"sv","@value":"Demografi"},{"@language":"sv","@value":"Prognos"},{"@language":"sv","@value":"Region Skåne"},{"@language":"sv","@value":"Regional utveckling"},{"@language":"sv","@value":"Skåne"},{"@language":"sv","@value":"Statistik"}],"dcat:landingPage":{"@id":"https://utveckling.skane.se/publikationer/publikationer/skanes-befolkningsprognos/"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1Y"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dcat:version":"1.0","dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:description":{"@language":"sv","@value":"Region Skåne tar årligen fram en befolkningsprognos för Skåne och dess 33 kommuner. Prognosen startar med ett basår (faktiska siffror för första året) och sträcker sig 10 år framåt med uppgifter för varje år. Data är folkmängden uppdelat på kön och 5-års-klasser. Fältet aktualitet anger vilken prognos som avses. Endast den senast framtagna prognosen tillgängliggörs. Datafilen levereras i CSV-format med teckenkodning i UTF-8."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":[{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b0n0"},{"@id":"https://sws.geonames.org/3337385"}],"dct:title":[{"@language":"en","@value":"Population projection Skåne"},{"@language":"sv","@value":"Skånes befolkningsprognos"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/120"},"http://www.w3.org/ns/prov#qualifiedAttribution":{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b1n0"}},{"@id":"https://oppnadata.skane.se/store/34/resource/37","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://utveckling.skane.se/publikationer/publikationer/skanes-befolkningsprognos/"},"dcat:downloadURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/statistik/demografi/RS_befolkningsprognos.csv"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1Y"},"dct:description":{"@language":"sv","@value":"Befolkningsprognos för Skåne, uppdelad på 33 kommuner, kön och 5-årsklass. Framåtblickande 10 år. Årlig produkt."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:rights":{"@id":"_:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32_b2n0"},"dct:title":{"@language":"sv","@value":"Skånes befolkningsprognos"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}}],"@id":"urn:source:a333e3a72dee6d1202dac4bf63e43f52a925f38404efe400c01598803f0fda32"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/5","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://oppnadata.skane.se/store/34/resource/53"},{"@id":"https://oppnadata.skane.se/store/34/resource/54"},{"@id":"https://oppnadata.skane.se/store/34/resource/55"},{"@id":"https://oppnadata.skane.se/store/34/resource/63"}],"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/6"},{"@id":"https://oppnadata.skane.se/store/34/resource/65"},{"@id":"https://oppnadata.skane.se/store/34/resource/7"},{"@id":"https://oppnadata.skane.se/store/34/resource/80"},{"@id":"https://oppnadata.skane.se/store/34/resource/81"},{"@id":"https://oppnadata.skane.se/store/34/resource/82"}],"dcat:keyword":[{"@language":"en","@value":"Biking"},{"@language":"sv","@value":"Cykel"},{"@language":"sv","@value":"Cykling"},{"@language":"sv","@value":"Leder"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Toalett"},{"@language":"sv","@value":"vattenpost"}],"dcat:landingPage":[{"@id":"https://uteiskane.se/"},{"@id":"https://utveckling.skane.se/regional-utveckling/verksamhetsomraden/natur-och-rekreation/cykelleder/"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Datamängden omfattar ledsträckning och skyltar för rekreativa cykelleder för vilka Region Skåne är huvudman. Leder som omfattas är Cykelleden Skåne, Sydkustleden och Sydostleden.\n\nSkyltar är representerade som punktobjekt. Datamängden omfattar skyltar längs Cykelleden Skåne, Sydkustleden och Sydostleden, och är en bearbetning av material som skapades i samband med ledernas tillkomst. \n\nData för skyltar är ofullständig: data saknas för Malmö kommun. Datamängden uppdateras löpande, främst utifrån uppgifter från respektive kommun som har del av cykellederna. \n\nData för rekreativa cykelleder (ledsträckning) tillhandahålls även av Trafikverket genom dataprodukten Turismcykelled i Nationella vägdatabasen, NVDB. I den datamängden ingår rekreativa cykelleder, men datamängdernas detaljeringsgrad och informationsmodell skiljer sig något åt."},"dct:issued":{"@type":"xsd:date","@value":"2025-08-13"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":[{"@language":"en","@value":"Biking trails in Skåne"},{"@language":"sv","@value":"Rekreativa cykelleder i Skåne"}],"http://schema.org/diagram":{"@id":"https://oppnadata.skane.se/store/34/resource/83"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}},{"@id":"https://oppnadata.skane.se/store/34/resource/54","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Sydkustleden","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sydkustleden@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":[{"@id":"https://sydostleden-sydkustleden.se/delled/sydkustleden"},{"@id":"https://utveckling.skane.se/regional-utveckling/verksamhetsomraden/natur-och-rekreation/cykelleder/"}]},{"@id":"https://oppnadata.skane.se/store/34/resource/55","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Cykelleden Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:cykelledenskane@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":[{"@id":"https://cykelledenskane.se/"},{"@id":"https://utveckling.skane.se/regional-utveckling/verksamhetsomraden/natur-och-rekreation/cykelleder/"}]},{"@id":"https://oppnadata.skane.se/store/34/resource/6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wms?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Se lager \"Cykelleder i Skåne\" och \"Cykelleder i Skåne, skyltar\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst med ledsträckning och skyltar"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/63","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Sydostleden","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:sydostleden@skane.se"}},{"@id":"https://oppnadata.skane.se/store/34/resource/65","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://skane.maps.arcgis.com/apps/instant/basic/index.html?appid=19ce17d4cc63410e8232728e3a835cc0"},"dct:description":{"@language":"sv","@value":"Webbaserad karta i ArcGIS online"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Karta för rekreativa cykelleder"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wfs?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Se lager \"Cykelleder i Skåne\" och \"Cykelleder i Skåne, skyltar\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för ledsträckning och skyltar"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/80","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/cykelled/cykelleden_skane/cykelleden_skane_rekommenderad_riktning.gpx"},"dct:description":{"@language":"sv","@value":"gpx"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Cykelleden Skåne rekommenderad riktning, gpx-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/81","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/cykelled/sydkustleden/sydkustleden_simrishamn_helsingborg.gpx"},"dct:description":{"@language":"sv","@value":"gpx"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Sydkustleden rekommenderad riktning, gpx-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/82","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/nedladdning/cykelled/sydostleden/sydostleden_vaxjo_simrishamn.gpx"},"dct:description":{"@language":"sv","@value":"gpx"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Sydostleden rekommenderad riktning, gpx-fil"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:aaeef953321237c548bdaa87d616bb52579f067d07ff8386b86845f5ffaf5141"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/34","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://oppnadata.skane.se/store/34/resource/53"},"dcat:distribution":{"@id":"https://oppnadata.skane.se/store/34/resource/35"},"dcat:keyword":{"@language":"sv","@value":"statistik"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":{"@language":"sv","@value":"Rutnät som täcker Skåne läns administrativa område. Ingående rutstorlekar: 100m, 500m och 1000m.\nRutid är sammanslagning av E-koordinat och N-koordinat för rutans sydvästra hörn.\nRutid finns både som text och tal. \nKoordinatsystem: Sweref99 TM, EPSG:3006."},"dct:issued":{"@type":"xsd:date","@value":"2024-10-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":{"@language":"sv","@value":"Statistikrutor för Skåne"}},{"@id":"https://oppnadata.skane.se/store/34/resource/35","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/regutv/gis_resurser/rutor/statistikrutor_skane.gpkg"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/GPKG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdning av statistikrutor för Skåne"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}}],"@id":"urn:source:accb926387acee0363852950eb0a8773e7e6984a2fba9f7aff647b1b658839f0"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/56","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Regional planering, Region Skåne","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:regionalplanering@skane.se"}},{"@id":"https://oppnadata.skane.se/store/34/resource/59","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skånes Geodatafunktion","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"}},{"@id":"https://oppnadata.skane.se/store/34/resource/91","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://oppnadata.skane.se/store/34/resource/56"},{"@id":"https://oppnadata.skane.se/store/34/resource/59"}],"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/92"},{"@id":"https://oppnadata.skane.se/store/34/resource/93"}],"dcat:keyword":[{"@language":"sv","@value":"Jordbruksmark"},{"@language":"sv","@value":"Markanvändning"}],"dcat:landingPage":[{"@id":"https://geodata.skane.se/regutv/regionplan/jordbruksmark/ansprak_jordbruksmark_metodbeskrivning.pdf"},{"@id":"https://storymaps.arcgis.com/collections/921339bcbbbe4a90a73dae6c829acf09"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/AGRI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/NEVER"},"dct:description":{"@language":"sv","@value":"Datamängden är framtagen under ett projekt som omfattade en kartläggning av exploateringen av jordbruksmark i Skåne sedan år 2000 och en framåtblickande analys av hur mycket jordbruksmark som riskerar att exploateras eller på andra sätt försvinna till 2040, 2070 samt 2120.  Syftet var att ta fram ett kunskapsunderlag som bidrar till en bättre förståelse och helhetsbild avseende varför jordbruksmark försvinner, vilka faktorer som driver exploateringen av jordbruksmark och var i Skåne denna exploatering sker samt att ge ökad kunskap om framtida anspråk på jordbruksmark. Fokus har i första hand varit på exploatering av jordbruksmark, eftersom detta är en irreversibel process. \n\nProjektet var en del av genomförandet av Regionplan för Skåne 2022–2040, rapporten kan läsas i sin helhet på https://storymaps.arcgis.com/collections/921339bcbbbe4a90a73dae6c829acf09\n\nDatamängden omfattar:\n1. olika typer av jordbruksmark i Skåne (2023)\n2. den typ av exploatering som har skett på jordbruksmark 2000- 2020 i Skåne"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":{"@language":"sv","@value":"Anspråk på jordbruksmark i Skåne"},"http://schema.org/diagram":{"@id":"https://oppnadata.skane.se/store/34/resource/94"}},{"@id":"https://oppnadata.skane.se/store/34/resource/92","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_jordbruksmark/wfs?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller två lager: jordbruksmark 2023 och ianspråktagen jordbruksmark 2000-2020."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Nedladdningstjänst för jordbruksmark i Skåne"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://oppnadata.skane.se/store/34/resource/93","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_jordbruksmark/wms?request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Tjänsten innehåller två lager: jordbruksmark 2023 och ianspråktagen jordbruksmark 2000-2020."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visningstjänst för jordbruksmark i Skåne"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:d7291d51cd83d643a491d6cb65a8e4b0d71fb267ad9e26bc830615162b754773"},{"@graph":[{"@id":"https://oppnadata.skane.se/store/1/resource/2","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://oppnadata.skane.se/store/34/resource/16"},{"@id":"https://oppnadata.skane.se/store/34/resource/20"},{"@id":"https://oppnadata.skane.se/store/34/resource/26"},{"@id":"https://oppnadata.skane.se/store/34/resource/3"},{"@id":"https://oppnadata.skane.se/store/34/resource/30"},{"@id":"https://oppnadata.skane.se/store/34/resource/34"},{"@id":"https://oppnadata.skane.se/store/34/resource/36"},{"@id":"https://oppnadata.skane.se/store/34/resource/40"},{"@id":"https://oppnadata.skane.se/store/34/resource/5"},{"@id":"https://oppnadata.skane.se/store/34/resource/67"},{"@id":"https://oppnadata.skane.se/store/34/resource/9"},{"@id":"https://oppnadata.skane.se/store/34/resource/91"}],"dct:description":[{"@language":"en","@value":"Metadata catalog for Region Skåne"},{"@language":"sv","@value":"Metadatakatalog för Region Skåne"}],"dct:hasPart":[{"@id":"https://oppnadata.skane.se/store/4/resource/2"},{"@id":"https://oppnadata.skane.se/store/7/resource/2"},{"@id":"https://oppnadata.skane.se/store/8/resource/2"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":[{"@language":"en","@value":"Central metadata catalog Region Skåne"},{"@language":"sv","@value":"Central metadatakatalog Region Skåne"}],"foaf:homepage":{"@id":"https://skane.se"}}],"@id":"urn:source:d8f857a6db1a4ff19bce1e050cdb63d266ad8614565c8003a2dad77eb7f62e32"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2321000255","@type":"foaf:Agent","dct:identifier":"2321000255","dct:type":{"@id":"http://purl.org/adms/publishertype/RegionalAuthority"},"foaf:mbox":{"@id":"mailto:oppna.data@skane.se"},"foaf:name":{"@language":"sv","@value":"Region Skåne"},"foaf:page":{"@id":"https://www.skane.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://oppnadata.skane.se/store/1/resource/1"}},{"@id":"https://oppnadata.skane.se/store/34/resource/40","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://oppnadata.skane.se/store/34/resource/53"},{"@id":"https://oppnadata.skane.se/store/34/resource/61"}],"dcat:distribution":[{"@id":"https://oppnadata.skane.se/store/34/resource/60"},{"@id":"https://oppnadata.skane.se/store/34/resource/72"},{"@id":"https://oppnadata.skane.se/store/34/resource/73"},{"@id":"https://oppnadata.skane.se/store/34/resource/74"},{"@id":"https://oppnadata.skane.se/store/34/resource/75"},{"@id":"https://oppnadata.skane.se/store/34/resource/76"},{"@id":"https://oppnadata.skane.se/store/34/resource/77"},{"@id":"https://oppnadata.skane.se/store/34/resource/78"},{"@id":"https://oppnadata.skane.se/store/34/resource/79"}],"dcat:keyword":[{"@language":"en","@value":"Hiking"},{"@language":"en","@value":"Trail"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Vandring"},{"@language":"sv","@value":"Vandringsled"}],"dcat:landingPage":[{"@id":"https://skaneleden.se/"},{"@id":"https://uteiskane.se/"},{"@id":"https://utveckling.skane.se/regional-utveckling/verksamhetsomraden/natur-och-rekreation/skaneleden/"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Datamängden omfattar ledsträckning för rekreativa vandringsleder för vilka Region Skåne är huvudman. Leder som omfattas är Skåneleden med delleder.\n\nRegion Skåne samarbetar med Stiftelsen Skånska landskap som ansvarar för förvaltning av leden. Kommunerna ansvarar för drift och underhåll av Skåneleden. Ledansvariga i respektive kommun ansvarar för all praktisk hantering utmed leden.\n\nDatamängden uppdateras löpande men oregelbundet."},"dct:issued":{"@type":"xsd:date","@value":"2026-01-12"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2321000255"},"dct:spatial":{"@id":"https://sws.geonames.org/3337385"},"dct:title":[{"@language":"en","@value":"Walking trails in Skåne - Skåneleden"},{"@language":"sv","@value":"Vandringsleder i Skåne - Skåneleden"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/108"},"http://schema.org/diagram":{"@id":"https://oppnadata.skane.se/store/34/resource/64"}},{"@id":"https://oppnadata.skane.se/store/34/resource/53","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Region Skåne Centrala GIS-funktionen","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:geodata@skane.se"},"http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://utveckling.skane.se/regional-utveckling/statistik-och-analys/geografisk-analys/"}},{"@id":"https://oppnadata.skane.se/store/34/resource/60","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://geodata.skane.se/geoserver/rs_geodata/wms?&request=getcapabilities"},"dct:description":{"@language":"sv","@value":"Se lager \"Skåneleden\""},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","