3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stenungsund","http://www.w3.org/2006/vcard/ns#postal-code":"44431","http://www.w3.org/2006/vcard/ns#street-address":"Strandvägen 15"},{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46303730000"}},{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46730000"}},{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b3n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.744392597643495 58.18746867634738,12.057582480642411 58.18746867634738,12.057582480642411 57.963291055729286,11.744392597643495 57.963291055729286,11.744392597643495 58.18746867634738))"}},{"@id":"http://dataportal.se/organisation/SE2120001298","@type":"foaf:Agent","dct:identifier":"2120001298","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:oppnadata@stenungsund.se"},"foaf:name":{"@language":"sv","@value":"Stenungsunds kommun"},"foaf:page":{"@id":"https://www.stenungsund.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.stenungsund.se/store/1/resource/1"}},{"@id":"https://catalog.stenungsund.se/store/1/resource/20","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Stenungsunds kommun","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kommun@stenungsund.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":[{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b1n0"},{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b2n0"}]},{"@id":"https://catalog.stenungsund.se/store/1/resource/50","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.stenungsund.se/store/1/resource/20"},"dcat:distribution":[{"@id":"https://catalog.stenungsund.se/store/1/resource/52"},{"@id":"https://catalog.stenungsund.se/store/1/resource/54"}],"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"barbecue areas"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/grillplatser/1.0"},"dct:description":[{"@language":"en","@value":"The dataset includes barbecue areas in public places outdoors that are free to use for the public, usually all year round and free of charge. At the barbecue area there is often benches, wind guard and other equipment for a pleasant experience. The dataset contains information about e.g. name, location, contact information and more. There may also be additional information about which characteristics that are available at the barbecue area. Water for putting out the fire or something else."},{"@language":"sv","@value":"Datamängden grillplatser (barbecue areas på engelska) omfattar grillplatser på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Vid grillplatserna finns oftast bänkar, vindskydd och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid grillplatsen. Exempelvis vatten för att släcka en eld."}],"dct:issued":{"@type":"xsd:date","@value":"2024-02-26"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001298"},"dct:spatial":[{"@id":"_:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9_b3n0"},{"@id":"https://sws.geonames.org/2673874"}],"dct:title":[{"@language":"en","@value":"Barbecue areas in Stenungsund municipality"},{"@language":"sv","@value":"Grillplatser i Stenungsunds kommun"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/143"}},{"@id":"https://catalog.stenungsund.se/store/1/resource/51","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"grillplatser.csv"},{"@id":"https://catalog.stenungsund.se/store/1/resource/52","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.stenungsund.se/store/1/resource/51"},"dcat:downloadURL":{"@id":"https://catalog.stenungsund.se/store/1/resource/51"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"}},{"@id":"https://catalog.stenungsund.se/store/1/resource/54","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.stenungsund.se/rowstore/dataset/c53c03d9-d55e-422b-90bd-85e7d3858ba9"},"dct:conformsTo":{"@id":"https://catalog.stenungsund.se/rowstore/dataset/c53c03d9-d55e-422b-90bd-85e7d3858ba9/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://catalog.stenungsund.se/store/1/resource/52"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.stenungsund.se/rowstore/dataset/c53c03d9-d55e-422b-90bd-85e7d3858ba9/swagger"}},{"@id":"https://dataportal.se/specifications/grillplatser/1.0","@type":"dct:Standard","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/130/resource/1"},"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dct:description":{"@language":"sv","@value":"Med grillplats menas en särskilt anlagd eller skött allmän plats där man kan göra upp eld och/eller grilla i en särskilt anlagd härd.\n\nDenna specifikation definierar en enkel tabulär informationsmodell för grillplatser. Specifikationen innefattar också en beskrivning av hur informationen uttrycks i formatet CSV och JSON. Som grund förutsätts CSV kunna levereras då det är praktiskt format och skapar förutsägbarhet för mottagare av informationen. Det är också ett format som gör sammanställningen av datamängden enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}}],"@id":"urn:source:8b29f92677315c070891a48a343126e07d90b8ee0390a98153708c9d234dcba9"},{"@graph":[{"@id":"_:d790f6da42bd18791ddddf54763b4da2cc4376485da7db58e55ec8c5b0560e63_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stenungsund","http://www.w3.org/2006/vcard/ns#postal-code":"444 30","http://www.w3.org/2006/vcard/ns#street-address":"Fregatten 2"},{"@id":"_:d790f6da42bd18791ddddf54763b4da2cc4376485d