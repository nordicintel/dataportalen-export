dct:title":{"@language":"sv","@value":"Infrastrukturavgifter Skuru"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://transportstyrelsen.entryscape.net/rowstore/dataset/5bd9ce8c-1c43-4cef-9f1b-00f1137ef2d5/swagger"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/340","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/36f6fb63-6e7c-4d30-86ac-495673b79b8c"},"dct:conformsTo":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/36f6fb63-6e7c-4d30-86ac-495673b79b8c/swagger"},"dct:description":{"@language":"sv","@value":"Datasetet beskriver aktuell prislista för bron över Sundsvallsfjärden på Europaväg 4"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/307"},"dct:title":{"@language":"sv","@value":"Infrastrukturavgifter Sundsvall"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://transportstyrelsen.entryscape.net/rowstore/dataset/36f6fb63-6e7c-4d30-86ac-495673b79b8c/swagger"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/342","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/26ecf61a-d171-407e-b0de-f4ba23c746fa"},"dct:conformsTo":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/26ecf61a-d171-407e-b0de-f4ba23c746fa/swagger"},"dct:description":{"@language":"sv","@value":"Datasetet beskriver aktuell prislista för bron över Motalaviken på väg 50"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:source":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/305"},"dct:title":{"@language":"sv","@value":"Infrastrukturavgifter Motala"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://transportstyrelsen.entryscape.net/rowstore/dataset/26ecf61a-d171-407e-b0de-f4ba23c746fa/swagger"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:6db25df7a802197a36f9beba46d175a3e3aeddfff728cfb7e6ea23af92f91bb9"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021006099","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Transportstyrelsen tillgängliggör datamängder som identitetsuppgifter, fordonsuppgifter och uppgifter om fordonets beskaffenhet eller utrustning, inom sin avgiftsfinansierade verksamhetsdel. Information kan sammanställas manuellt beroende på beställarens behov i en Excel- eller textfil. Avgifter tas då ut för varje rad i filen. Det går också att prenumerera på information och betala en månadsavgift. För en beställning kan kostnaden vara: radavgift 0,31–2,10 kr plus engångsavgift 1 403 kr eller abonnemang 701 kr. Kostnaden för prenumerationstjänster 4 970–30 139 kr per månad plus 2 000 kr i månadsavgift."},"dct:identifier":"2021006099","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:fb-fobeslutsstod@transportstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Transportstyrelsen"},"foaf:page":{"@id":"https://www.transportstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/1"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/246","@type":"dcat:Dataset","dcat:distribution":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/247"},"dcat:keyword":[{"@language":"sv","@value":"Transportstyrelsen"},{"@language":"sv","@value":"bilar"},{"@language":"sv","@value":"miljö"},{"@language":"sv","@value":"myndigheter"},{"@language":"sv","@value":"trafiksäkerhetskrav"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:description":{"@language":"sv","@value":"Statliga myndigheter måste följa vissa bestämmelser om miljö- och trafiksäkerhetskrav när man köper in eller leasar bilar samt vid vissa upphandlade transporter. Årligen rapporterar myndigheterna in uppgifter om nytillkomna bilar och upphandlingar av bilhyra och taxiresor till Transportstyrelsen som har regeringens uppdrag att sammanställa och följa upp arbetet."},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006099"},"dct:title":{"@language":"sv","@value":"Uppföljning myndigheters bilar"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/247","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.transportstyrelsen.se/sv/om-oss/statistik-och-analys/statistik-inom-vagtrafik/uppfoljning-myndigheters-bilar/"},"dct:description":{"@language":"sv","@value":"Här finns våra årliga sammanställningar av myndigheternas redogörelser som vi redovisat till Regeringskansliet."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Uppföljning offentligt upphandlade bilar"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}}],"@id":"urn:source:6fc122ba91dad2925ac102c7e23b4d1cc69264dd745eb13a0a7d8e8a962b0e13"},{"@graph":[{"@id":"_:7181407866550f60266b8a1c3dba3444dcd810e1be4e97db9d4e0165e447dbe3_b0n0","@type":"http://spdx.org/rdf/terms#Checksum","http://spdx.org/rdf/terms#algorithm":{"@id":"http://spdx.org/rdf/terms#checksumAlgorithm_md5"},"http://spdx.org/rdf/terms#checksumValue":"c92b1a639edb71925a0006eb61061ce50"},{"@id":"_:7181407866550f60266b8a1c3dba3444dcd810e1be4e97db9d4e0165e447dbe3_b1n0","dct:identifier":"https://transportstyrelsen.entryscape.net/store/7/resource/251","foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/distribution/0f764f8f-7543-4100-b0d8-6d07f61c0298"}},{"@id":"http://data.europa.eu/88u/dataset/https-transportstyrelsen-entryscape-net-store-7-resource-250~~1","@type":"dcat:Dataset","dcat:distribution":{"@id":"http://data.europa.eu/88u/distribution/0f764f8f-7543-4100-b0d8-6d07f61c0298"},"dcat:keyword":[{"@language":"sv","@value":"Lista över läkare som kan ge ut digitalt läkarintyg för sjöfolk"},{"@language":"sv","@value":"Lista över utbildningar inom sjöfartsområdet"},{"@language":"sv","@value":"Utbildningsinstanser för vattenskoter"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/RESTRICTED"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Тук ще намерите статистически данни въз основа на данни от Центъра за справки. Статистическите данни се извличат незабавно от регистъра на моряците при съставянето на избрания доклад.\n\nСъдържанието на докладите, които са на разположение в отчетния център, описва, наред с другото, кои лекари са на разположение или кои органи за обучение са от значение за определен курс на обучение."},{"@language":"cs-t-sv-t0-mtec","@value":"Zde naleznete statistiky založené na údajích z Centra pro podávání zpráv. Statistiky jsou okamžitě načteny z rejstříku námořníků, když je vytvořena vybraná zpráva.\n\nObsah zpráv dostupných ve Středisku pro podávání zpráv mimo jiné popisuje, kteří lékaři jsou k dispozici nebo které vzdělávací subjekty jsou relevantní pro konkrétní studijní obor."},{"@language":"da-t-sv-t0-mtec","@value":"Her finder du statistik baseret på data fra Rapportcentret. Statistikken hentes straks fra Sømandsregistret, når den valgte rapport oprettes.\n\nIndholdet af de rapporter, der er tilgængelige på Rapporteringscenteret, beskriver bl.a., hvilke læger der er til rådighed, eller hvilke uddannelsesinstitutioner der er relevante for et bestemt studieforløb."},{"@language":"de-t-sv-t0-mtec","@value":"Hier finden Sie Statistiken, die auf Daten des Report Centers basieren. Die Statistiken werden beim Erstellen des ausgewählten Berichts sofort aus dem Seemannsregister abgerufen.\n\nDer Inhalt der in der Meldestelle verfügbaren Berichte beschreibt unter anderem, welche Ärzte zur Verfügung stehen oder welche Ausbildungseinrichtungen für einen bestimmten Studiengang relevant sind."},{"@language":"el-t-sv-t0-mtec","@value":"Εδώ θα βρείτε στατιστικά στοιχεία που βασίζονται σε στοιχεία από το Κέντρο Αναφοράς. Τα στατιστικά στοιχεία ανακτώνται αμέσως από το Μητρώο Ναυτικών όταν δημιουργηθεί η επιλεγμένη έκθεση.\n\nΤο περιεχόμενο των εκθέσεων που είναι διαθέσιμες στο Κέντρο Αναφοράς περιγράφει, μεταξύ άλλων, ποιοι ιατροί είναι διαθέσιμοι ή ποιοι φορείς κατάρτισης είναι σημαντικοί για ένα συγκεκριμένο πρόγραμμα σπουδών."},{"@language":"en-t-sv-t0-mtec","@value":"Here you will find statistics based on data from the Report Centre. The statistics are immediately retrieved from the Seafarer's Register when the selected report is created.\n\nThe content of the reports available at the Reporting Centre describes, among other things, which doctors are available or which training bodies are relevant for a particular course of study."},{"@language":"es-t-sv-t0-mtec","@value":"Aquí encontrará estadísticas basadas en datos del Centro de Informes. Las estadísticas se recuperan inmediatamente del Registro de la Gente de Mar cuando se crea el informe seleccionado.\n\nEl contenido de los informes disponibles en el Centro de Informes describe, entre otras cosas, qué médicos están disponibles o qué organismos de formación son relevantes para un curso de estudio en particular."},{"@language":"et-t-sv-t0-mtec","@value":"Siit leiate aruandekeskuse andmetel põhineva statistika. Statistilisi andmeid saab meremeheregistrist kohe pärast valitud aruande koostamist.\n\nAruandluskeskuses kättesaadavate aruannete sisu kirjeldab muu hulgas, millised arstid on kättesaadavad või millised koolitusasutused on konkreetse õppesuuna puhul asjakohased."},{"@language":"fi-t-sv-t0-mtec","@value":"Täältä löydät Raporttikeskuksen tietoihin perustuvat tilastot. Tilastot haetaan merenkulkijarekisteristä heti valitun raportin luomisen yhteydessä.\n\nRaportointikeskuksessa saatavilla olevien raporttien sisällössä kuvataan muun muassa, mitkä lääkärit ovat käytettävissä tai mitkä koulutuslaitokset ovat merkityksellisiä tietyn opintojakson kannalta."},{"@language":"fr-t-sv-t0-mtec","@value":"Vous trouverez ici des statistiques basées sur les données du Centre de rapports. Les statistiques sont immédiatement extraites du registre des gens de mer lorsque le rapport sélectionné est créé.\n\nLe contenu des rapports disponibles au Reporting Centre décrit, entre autres, quels médecins sont disponibles ou quels organismes de formation sont pertinents pour un programme d'études particulier."},{"@language":"ga-t-sv-t0-mtec","@value":"Anseo gheobhaidh tú staitisticí bunaithe ar shonraí ón Ionad Tuairisce. Faightear na staitisticí láithreach ó Chlár na Maraithe nuair a chruthaítear an tuarascáil roghnaithe.\n\nDéantar cur síos in ábhar na dtuarascálacha atá ar fáil ag an Ionad Tuairiscithe, i measc nithe eile, ar na dochtúirí atá ar fáil nó ar na comhlachtaí oiliúna atá ábhartha do chúrsa staidéir ar leith."},{"@language":"hr-t-sv-t0-mtec","@value":"Ovdje ćete pronaći statističke podatke temeljene na podacima iz Report Centra. Statistički podaci odmah se preuzimaju iz registra pomoraca nakon izrade odabranog izvješća.\n\nU sadržaju izvješća dostupnih u Centru za izvješćivanje opisuje se, među ostalim, koji su liječnici dostupni ili koja su tijela za osposobljavanje relevantna za određeni studij."},{"@language":"hu-t-sv-t0-mtec","@value":"Itt a Riportközpont adatain alapuló statisztikákat talál. A statisztikákat a kiválasztott jelentés létrehozásakor azonnal lehívják a tengerészek nyilvántartásából.\n\nA jelentéskészítő központban rendelkezésre álló jelentések tartalma többek között leírja, hogy mely orvosok állnak rendelkezésre, vagy mely képzési szervek relevánsak egy adott tanulmányi kurzus szempontjából."},{"@language":"it-t-sv-t0-mtec","@value":"Qui troverete statistiche basate sui dati del Centro relazioni. Le statistiche vengono immediatamente recuperate dal registro della gente di mare al momento della creazione del rapporto selezionato.\n\nIl contenuto delle relazioni disponibili presso il Centro di relazioni descrive, tra l'altro, quali medici sono disponibili o quali organismi di formazione sono pertinenti per un particolare corso di studi."},{"@language":"lt-t-sv-t0-mtec","@value":"Čia rasite statistinius duomenis, pagrįstus Ataskaitų centro duomenimis. Statistiniai duomenys iš karto gaunami iš Jūrininkų registro, kai sukuriama pasirinkta ataskaita.\n\nPranešimų centre prieinamų ataskaitų turinyje, be kita ko, aprašoma, kurie gydytojai yra prieinami arba kurios mokymo įstaigos yra svarbios konkrečiam studijų kursui."},{"@language":"lv-t-sv-t0-mtec","@value":"Šeit jūs atradīsiet statistiku, kuras pamatā ir ziņojumu centra dati. Kad ir izveidots izvēlētais ziņojums, statistika tiek nekavējoties izgūta no Jūrnieku reģistra.\n\nZiņojumu centrā pieejamo ziņojumu saturā cita starpā ir aprakstīts, kuri ārsti ir pieejami vai kuras mācību iestādes ir būtiskas konkrētam studiju kursam."},{"@language":"mt-t-sv-t0-mtec","@value":"Hawnhekk issib statistika bbażata fuq data miċ-Ċentru tar-Rapporti. L-istatistika tinkiseb immedjatament mir-Reġistru tal-Baħħara meta jinħoloq ir-rapport magħżul.\n\nIl-kontenut tar-rapporti disponibbli fiċ-Ċentru ta’ Rapportar jiddeskrivi, fost affarijiet oħra, liema tobba huma disponibbli jew liema korpi ta’ taħriġ huma rilevanti għal kors ta’ studju partikolari."},{"@language":"nl-t-sv-t0-mtec","@value":"Hier vindt u statistieken op basis van gegevens van het Report Centre. De statistieken worden onmiddellijk opgehaald uit het Zeevarendenregister wanneer het geselecteerde rapport wordt aangemaakt.\n\nDe inhoud van de rapporten die bij het Meldcentrum beschikbaar zijn, beschrijft onder meer welke artsen beschikbaar zijn of welke opleidingsorganen relevant zijn voor een bepaalde studierichting."},{"@language":"pl-t-sv-t0-mtec","@value":"Tutaj znajdziesz statystyki oparte na danych z Centrum Raportów. Statystyki są natychmiast pobierane z rejestru marynarzy po utworzeniu wybranego raportu.\n\nTreść sprawozdań dostępnych w Centrum Sprawozdawczości opisuje między innymi, którzy lekarze są dostępni lub które instytucje szkoleniowe są istotne dla danego kierunku studiów."},{"@language":"pt-t-sv-t0-mtec","@value":"Aqui encontrará estatísticas baseadas em dados do Centro de Relatórios. As estatísticas são imediatamente recuperadas do Registro de Marítimos quando o relatório selecionado é criado.\n\nO conteúdo dos relatórios disponíveis no centro de informação descreve, nomeadamente, os médicos disponíveis ou os organismos de formação relevantes para um determinado ciclo de estudos."},{"@language":"ro-t-sv-t0-mtec","@value":"Aici veți găsi statistici bazate pe datele Centrului de raportare. Statisticile sunt extrase imediat din Registrul navigatorilor atunci când este creat raportul selectat.\n\nConținutul rapoartelor disponibile la Centrul de raportare descrie, printre altele, ce medici sunt disponibili sau ce organisme de formare sunt relevante pentru un anumit curs de studiu."},{"@language":"sk-t-sv-t0-mtec","@value":"Tu nájdete štatistiky založené na údajoch z centra správ. Štatistiky sa okamžite získajú z registra námorníkov po vytvorení vybranej správy.\n\nObsah správ, ktoré má centrum pre podávanie správ k dispozícii, okrem iného opisuje, ktorí lekári sú k dispozícii alebo ktoré subjekty odbornej prípravy sú relevantné pre konkrétny študijný kurz."},{"@language":"sl-t-sv-t0-mtec","@value":"Tukaj boste našli statistične podatke, ki temeljijo na podatkih centra za poročanje. Statistični podatki se takoj pridobijo iz Pomorščakovega registra, ko je izbrano poročilo ustvarjeno.\n\nV vsebini poročil, ki so na voljo v centru za poročanje, je med drugim opisano, kateri zdravniki so na voljo ali kateri organi za usposabljanje so pomembni za določen študijski program."},{"@language":"sv","@value":"Här hittar du statistik som baseras på data från Rapportcentralen. Statistiken hämtas ögonblickligen från sjömansregistret när vald rapport skapas.\n\nInnehållet i de rapporter som finns tillgängliga på Rapportcentralen redogör bland annat för vilka läkare som finns tillgängliga eller de utbildningsinstanser som är aktuella för en viss utbildning."},{"@language":"uk-t-sv-t0-mtec","@value":"Тут ви знайдете статистику на основі даних Центру звітів. Статистика негайно отримується з Реєстру моряків під час створення вибраного звіту.\n\nЗміст звітів, доступних у Центрі звітності, серед іншого, описує, які лікарі доступні або які навчальні органи є актуальними для конкретного курсу навчання."}],"dct:format":"text/html","dct:license":{"@id":"https://dataportal.se/concepts/licensecategories/nolicense"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006099"},"dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Открити преписи, свързани с корабоплаването — лекари и органи за обучение"},{"@language":"cs-t-sv-t0-mtec","@value":"Otevřené přepisy týkající se lodní dopravy - lékaři a školicí orgány"},{"@language":"da-t-sv-t0-mtec","@value":"Åbne udskrifter vedrørende skibsfart - læger og uddannelsesorganer"},{"@language":"de-t-sv-t0-mtec","@value":"Offene Transkripte zum Thema Schifffahrt - Ärzte und Ausbildungseinrichtungen"},{"@language":"el-t-sv-t0-mtec","@value":"Ανοικτά πρακτικά σχετικά με τη ναυτιλία - ιατροί και φορείς κατάρτισης"},{"@language":"en-t-sv-t0-mtec","@value":"Open transcripts relating to shipping - doctors and training bodies"},{"@language":"es-t-sv-t0-mtec","@value":"Transcripciones abiertas relativas al transporte marítimo - médicos y organismos de formación"},{"@language":"et-t-sv-t0-mtec","@value":"Laevandusega seotud avatud ärakirjad – arstid ja koolitusasutused"},{"@language":"fi-t-sv-t0-mtec","@value":"Merenkulkuun liittyvät avoimet selostukset - lääkärit ja koulutuslaitokset"},{"@language":"fr-t-sv-t0-mtec","@value":"Transcriptions ouvertes relatives au transport maritime - médecins et organismes de formation"},{"@language":"ga-t-sv-t0-mtec","@value":"Tras-scríbhinní oscailte a bhaineann le loingseoireacht - dochtúirí agus comhlachtaí oiliúna"},{"@language":"hr-t-sv-t0-mtec","@value":"Otvoreni transkripti koji se odnose na brodarstvo – liječnici i tijela za osposobljavanje"},{"@language":"hu-t-sv-t0-mtec","@value":"A hajózással kapcsolatos nyílt átiratok – orvosok és képzési szervek"},{"@language":"it-t-sv-t0-mtec","@value":"Trascrizioni aperte relative alla navigazione - medici e organismi di formazione"},{"@language":"lt-t-sv-t0-mtec","@value":"Atviri nuorašai, susiję su laivyba. Gydytojai ir mokymo įstaigos"},{"@language":"lv-t-sv-t0-mtec","@value":"Atklātās stenogrammas, kas attiecas uz kuģniecību – ārsti un mācību iestādes"},{"@language":"mt-t-sv-t0-mtec","@value":"Traskrizzjonijiet miftuħa relatati mat-trasport bil-baħar - tobba u korpi ta' taħriġ"},{"@language":"nl-t-sv-t0-mtec","@value":"Open transcripties met betrekking tot de scheepvaart - artsen en opleidingsinstellingen"},{"@language":"pl-t-sv-t0-mtec","@value":"Otwarte transkrypcje dotyczące żeglugi - lekarze i instytucje szkoleniowe"},{"@language":"pt-t-sv-t0-mtec","@value":"Transcrições abertas relativas à navegação - médicos e organismos de formação"},{"@language":"ro-t-sv-t0-mtec","@value":"Transcrieri deschise privind transportul maritim - medici și organisme de formare"},{"@language":"sk-t-sv-t0-mtec","@value":"Otvorené prepisy týkajúce sa lodnej dopravy – lekári a školiace orgány"},{"@language":"sl-t-sv-t0-mtec","@value":"Odprti prepisi v zvezi z ladijskim prometom – zdravniki in organi za usposabljanje"},{"@language":"sv","@value":"Öppna utskrifter rörande sjöfart - läkare och utbildningsinstanser"},{"@language":"uk-t-sv-t0-mtec","@value":"Відкриті стенограми, що стосуються судноплавства - лікарі та навчальні органи"}]},{"@id":"http://data.europa.eu/88u/distribution/0f764f8f-7543-4100-b0d8-6d07f61c0298","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://sjomansrapporter.transportstyrelsen.se/"},"dct:description":[{"@language":"bg-t-sv-t0-mtec","@value":"Връзка към статистическата служба за извличане на данни от регистъра на моряците"},{"@language":"cs-t-sv-t0-mtec","@value":"Odkaz na statistickou službu pro získávání údajů z rejstříku námořníků"},{"@language":"da-t-sv-t0-mtec","@value":"Link til statistisk tjeneste for udtræk af data fra Sømandsregistret"},{"@language":"de-t-sv-t0-mtec","@value":"Link zum statistischen Dienst zum Extrahieren von Daten aus dem Seemannsregister"},{"@language":"el-t-sv-t0-mtec","@value":"Σύνδεσμος προς τη στατιστική υπηρεσία για την εξαγωγή δεδομένων από το ναυτικό μητρώο"},{"@language":"en-t-sv-t0-mtec","@value":"Link to statistical service for extracting data from the Seafarer's Register"},{"@language":"es-t-sv-t0-mtec","@value":"Enlace al servicio estadístico para la extracción de datos del Registro de la Gente de Mar"},{"@language":"et-t-sv-t0-mtec","@value":"Link meremeeste registrist andmete väljavõtmise statistikateenusele"},{"@language":"fi-t-sv-t0-mtec","@value":"Linkki tilastopalveluun tietojen poimimiseksi merimiesrekisteristä"},{"@language":"fr-t-sv-t0-mtec","@value":"Lien vers le service statistique pour l'extraction des données du registre des gens de mer"},{"@language":"ga-t-sv-t0-mtec","@value":"Nasc chuig an tseirbhís staidrimh chun sonraí a bhaint as Clár na Maraithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Poveznica na statističku službu za izdvajanje podataka iz Registra pomoraca"},{"@language":"hu-t-sv-t0-mtec","@value":"Link a tengerészek nyilvántartásából származó adatok kinyerésére szolgáló statisztikai szolgálathoz"},{"@language":"it-t-sv-t0-mtec","@value":"Link al servizio statistico per l'estrazione di dati dal registro della gente di mare"},{"@language":"lt-t-sv-t0-mtec","@value":"Nuoroda į statistikos tarnybą duomenims iš Jūrininkų registro gauti"},{"@language":"lv-t-sv-t0-mtec","@value":"Saite uz statistikas dienestu datu izgūšanai no Jūrnieku reģistra"},{"@language":"mt-t-sv-t0-mtec","@value":"Link għas-servizz statistiku għall-estrazzjoni tad-data mir-Reġistru tal-Baħħara"},{"@language":"nl-t-sv-t0-mtec","@value":"Link naar statistische dienst voor het extraheren van gegevens uit het zeevarendenregister"},{"@language":"pl-t-sv-t0-mtec","@value":"Link do serwisu statystycznego do pobierania danych z rejestru marynarzy"},{"@language":"pt-t-sv-t0-mtec","@value":"Ligação para o serviço estatístico para a extração de dados do Registo de Marítimos"},{"@language":"ro-t-sv-t0-mtec","@value":"Link către serviciul statistic pentru extragerea datelor din Registrul navigatorilor"},{"@language":"sk-t-sv-t0-mtec","@value":"Odkaz na štatistickú službu na extrakciu údajov z registra námorníkov"},{"@language":"sl-t-sv-t0-mtec","@value":"Povezava do statistične službe za pridobivanje podatkov iz registra pomorščakov"},{"@language":"sv","@value":"Länk till statistiktjänst för utdrag av uppgifter från sjömansregistret"},{"@language":"uk-t-sv-t0-mtec","@value":"Посилання на статистичну службу для вилучення даних з Реєстру моряків"}],"dct:format":"text/html","dct:title":[{"@language":"bg-t-sv-t0-mtec","@value":"Регистър на моряците"},{"@language":"cs-t-sv-t0-mtec","@value":"Rejstřík námořníků"},{"@language":"da-t-sv-t0-mtec","@value":"Sømandsregister"},{"@language":"de-t-sv-t0-mtec","@value":"Seemannsregister"},{"@language":"el-t-sv-t0-mtec","@value":"Μητρώο ναυτικών"},{"@language":"en-t-sv-t0-mtec","@value":"Seafarer's Register"},{"@language":"es-t-sv-t0-mtec","@value":"Registro de la gente de mar"},{"@language":"et-t-sv-t0-mtec","@value":"Meremeeste register"},{"@language":"fi-t-sv-t0-mtec","@value":"Merenkulkijarekisteri"},{"@language":"fr-t-sv-t0-mtec","@value":"Registre des gens de mer"},{"@language":"ga-t-sv-t0-mtec","@value":"Clár na Maraithe"},{"@language":"hr-t-sv-t0-mtec","@value":"Registar pomoraca"},{"@language":"hu-t-sv-t0-mtec","@value":"Tengerész-nyilvántartás"},{"@language":"it-t-sv-t0-mtec","@value":"Registro della gente di mare"},{"@language":"lt-t-sv-t0-mtec","@value":"Jūrininkų registras"},{"@language":"lv-t-sv-t0-mtec","@value":"Jūrnieku reģistrs"},{"@language":"mt-t-sv-t0-mtec","@value":"Ir-Reġistru tal-Baħħara"},{"@language":"nl-t-sv-t0-mtec","@value":"Register van zeevarenden"},{"@language":"pl-t-sv-t0-mtec","@value":"Rejestr marynarzy"},{"@language":"pt-t-sv-t0-mtec","@value":"Registo dos marítimos"},{"@language":"ro-t-sv-t0-mtec","@value":"Registrul navigatorilor"},{"@language":"sk-t-sv-t0-mtec","@value":"Register námorníkov"},{"@language":"sl-t-sv-t0-mtec","@value":"Register pomorščakov"},{"@language":"sv","@value":"Sjömansregistret"},{"@language":"uk-t-sv-t0-mtec","@value":"Реєстр моряків"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"http://data.europa.eu/88u/record/https-transportstyrelsen-entryscape-net-store-7-resource-250~~1","@type":"dcat:CatalogRecord","dcat:distribution":{"@id":"_:7181407866550f60266b8a1c3dba3444dcd810e1be4e97db9d4e0165e447dbe3_b1n0"},"dct:creator":{"@id":"http://piveau.io"},"dct:identifier":"https://transportstyrelsen.entryscape.net/store/7/resource/250","dct:issued":{"@type":"xsd:dateTime","@value":"2025-03-06T09:38:29Z"},"dct:modified":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:55Z"},"foaf:primaryTopic":{"@id":"http://data.europa.eu/88u/dataset/https-transportstyrelsen-entryscape-net-store-7-resource-250~~1"},"http://spdx.org/rdf/terms#checksum":{"@id":"_:7181407866550f60266b8a1c3dba3444dcd810e1be4e97db9d4e0165e447dbe3_b0n0"},"http://www.w3.org/ns/dqv#hasQualityMetadata":{"@id":"http://data.europa.eu/88u/metrics/https-transportstyrelsen-entryscape-net-store-7-resource-250~~1"},"https://europeandataportal.eu/voc#originalLanguage":"sv","https://europeandataportal.eu/voc#transIssued":{"@type":"xsd:dateTime","@value":"2026-06-07T11:15:04Z"},"https://europeandataportal.eu/voc#transReceived":{"@type":"xsd:dateTime","@value":"2026-07-03T08:43:55Z"},"https://europeandataportal.eu/voc#transStatus":{"@id":"https://europeandataportal.eu/voc#TransCompleted"}},{"@id":"http://dataportal.se/organisation/SE2021006099","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Transportstyrelsen tillgängliggör datamängder som identitetsuppgifter, fordonsuppgifter och uppgifter om fordonets beskaffenhet eller utrustning, inom sin avgiftsfinansierade verksamhetsdel. Information kan sammanställas manuellt beroende på beställarens behov i en Excel- eller textfil. Avgifter tas då ut för varje rad i filen. Det går också att prenumerera på information och betala en månadsavgift. För en beställning kan kostnaden vara: radavgift 0,31–2,10 kr plus engångsavgift 1 403 kr eller abonnemang 701 kr. Kostnaden för prenumerationstjänster 4 970–30 139 kr per månad plus 2 000 kr i månadsavgift."},"dct:identifier":"2021006099","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:fb-fobeslutsstod@transportstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Transportstyrelsen"},"foaf:page":{"@id":"https://www.transportstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/1"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}}],"@id":"urn:source:7181407866550f60266b8a1c3dba3444dcd810e1be4e97db9d4e0165e447dbe3"},{"@graph":[{"@id":"_:72ab637dfee5b765f33cf7c9e047bd3560127c7e04ba459fbc3987a18f53492b_b0n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"1990-01-01"}},{"@id":"http://dataportal.se/organisation/SE2021006099","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Transportstyrelsen tillgängliggör datamängder som identitetsuppgifter, fordonsuppgifter och uppgifter om fordonets beskaffenhet eller utrustning, inom sin avgiftsfinansierade verksamhetsdel. Information kan sammanställas manuellt beroende på beställarens behov i en Excel- eller textfil. Avgifter tas då ut för varje rad i filen. Det går också att prenumerera på information och betala en månadsavgift. För en beställning kan kostnaden vara: radavgift 0,31–2,10 kr plus engångsavgift 1 403 kr eller abonnemang 701 kr. Kostnaden för prenumerationstjänster 4 970–30 139 kr per månad plus 2 000 kr i månadsavgift."},"dct:identifier":"2021006099","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:fb-fobeslutsstod@transportstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Transportstyrelsen"},"foaf:page":{"@id":"https://www.transportstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/1"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/112","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Körkort Sektion Utveckling och Förvaltning","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:FB-Redaktor-korkort@transportstyrelsen.se"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/126","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/112"},"dcat:distribution":[{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/161"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/163"}],"dcat:keyword":[{"@language":"en","@value":"Driving licence"},{"@language":"en","@value":"Revocation of driving licence"},{"@language":"en","@value":"Swedish Transport Agency"},{"@language":"sv","@value":"Driver's licence"},{"@language":"sv","@value":"Körkort"},{"@language":"sv","@value":"Transportstyrelsen"},{"@language":"sv","@value":"Återkallelse av körkort"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:description":[{"@language":"en","@value":"Data on the number of registered decisions on revocation of driving licences. The information comes from the Swedish road traffic registry and is divided into years and revocation points (reason). The amount of data is updated at the beginning of each year.\n\nThere are nine revocation reasons that which a driver's licence can be revoked using.\n\n1.  Drunken driving, serious drunken driving or dangerous or reckless driving \n2.  leaving the scene of an accident \n3.  Repeated traffic violations, at least three within a two-year period 4.violation of a major traffic regulation such as speeding, running a red light, overtaking at a pedestrian crossing, driving without a licence or dangerous or reckless driving \n5.  Alcohol-related unreliability \n6.  Criminal offences in general \n7.  Illness \n8.  Failure to submit to injunctions concerning doctor’s certificates or driving tests \n9.  Driving license issued on false grounds\n\nNote. A decision to revoke a driving lincence can be made by using more than one revocation ground (point). This affects the statistics on each revocation ground, but does not affect the total number of revocations.\n\nThe statistics is updated once a year, at the beginning of each year."},{"@language":"sv","@value":"Data över antal registrerade beslut om återkallelse av körkort. Informationen kommer från vägtrafikregistret och är uppdelad på år och återkallelsegrund (punkt). Datamängden kompletteras i början av året.\n\nDet finns nio återkallelsegrunder (punkter) som ett körkort kan återkallas på.\n1. Rattfylleri \n2. Smitning \n3. Upprepade trafikbrott \n4. Brott mot bestämmelse som är viktig för trafiksäkerheten\n(fortkörning, rött ljus, vårdslöshet, olovlig körning m.m.) \n5. Opålitlighet i nykterhetshänseende \n6. Annat allvarligt brott \n7. Sjukdom, skada eller liknande \n8. Inte skickat in läkarintyg \n9. Körkort utfärdat på felaktiga grunder\n\nObs. Ett beslut att återkalla ett körkort kan göras med mer än en återkallelsegrund i ett och samma beslut. Detta påverkar det den data som finns kopplat till varje återkallelsegrund, men påverkar inte totalen."}],"dct:issued":{"@type":"xsd:date","@value":"2022-04-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006099"},"dct:temporal":{"@id":"_:72ab637dfee5b765f33cf7c9e047bd3560127c7e04ba459fbc3987a18f53492b_b0n0"},"dct:title":[{"@language":"en","@value":"Revoked driving licenses - 1990 - Onwards"},{"@language":"sv","@value":"Återkallelse av körkort 1990 - framåt"}]},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/160","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Revoked Driving Licences - 1990 - Onwards.csv"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/161","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/160"},"dcat:downloadURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/160"},"dct:description":[{"@language":"en","@value":"Revoked Driving licences 1990 - Onwards"},{"@language":"sv","@value":"Återkallade körkort 1990 - framåt"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-22T15:20:48.951Z"},"dct:title":[{"@language":"en","@value":"CSV format"},{"@language":"sv","@value":"CSV-format"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/163","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/5d840ae0-af75-43fd-9bfd-d34617802bc5"},"dct:conformsTo":{"@id":"https://transportstyrelsen.entryscape.net/rowstore/dataset/5d840ae0-af75-43fd-9bfd-d34617802bc5/swagger"},"dct:description":[{"@language":"en","@value":"Revoked Driving Licenses 1990 - Onwards"},{"@language":"sv","@value":"Återkallade körkort 1990 - Framåt"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-04-06"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-22T15:21:01.775Z"},"dct:source":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/161"},"dct:title":[{"@language":"en","@value":"API"},{"@language":"sv","@value":"API"}],"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://transportstyrelsen.entryscape.net/rowstore/dataset/5d840ae0-af75-43fd-9bfd-d34617802bc5/swagger"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}}],"@id":"urn:source:72ab637dfee5b765f33cf7c9e047bd3560127c7e04ba459fbc3987a18f53492b"},{"@graph":[{"@id":"http://dataportal.se/organisation/SE2021006099","@type":"foaf:Agent","dct:description":{"@language":"sv","@value":"Transportstyrelsen tillgängliggör datamängder som identitetsuppgifter, fordonsuppgifter och uppgifter om fordonets beskaffenhet eller utrustning, inom sin avgiftsfinansierade verksamhetsdel. Information kan sammanställas manuellt beroende på beställarens behov i en Excel- eller textfil. Avgifter tas då ut för varje rad i filen. Det går också att prenumerera på information och betala en månadsavgift. För en beställning kan kostnaden vara: radavgift 0,31–2,10 kr plus engångsavgift 1 403 kr eller abonnemang 701 kr. Kostnaden för prenumerationstjänster 4 970–30 139 kr per månad plus 2 000 kr i månadsavgift."},"dct:identifier":"2021006099","dct:type":{"@id":"http://purl.org/adms/publishertype/NationalAuthority"},"foaf:mbox":{"@id":"mailto:fb-fobeslutsstod@transportstyrelsen.se"},"foaf:name":{"@language":"sv","@value":"Transportstyrelsen"},"foaf:page":{"@id":"https://www.transportstyrelsen.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/1"},"https://www.w3.org/ns/org#classification":{"@id":"https://dataportal.se/concepts/orgAspects/feeFinanzing"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/194","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Beslutssystem Skatter och Avgifter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:trangsel.VU@transportstyrelsen.se"}},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/258","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/194"},"dcat:distribution":[{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/295"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/297"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/326"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/328"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/355"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/357"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/385"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/387"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/426"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/428"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/443"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/445"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/477"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/479"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/481"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/483"}],"dcat:keyword":[{"@language":"en","@value":"Congestion tax"},{"@language":"en","@value":"Payment method"},{"@language":"en","@value":"Price list"},{"@language":"en","@value":"Road toll"},{"@language":"en","@value":"Tariff"},{"@language":"sv","@value":"Betalmetod"},{"@language":"sv","@value":"Prislista"},{"@language":"sv","@value":"Tariff"},{"@language":"sv","@value":"Trängselskatt"},{"@language":"sv","@value":"Vägtull"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:description":[{"@language":"en","@value":"The dataset describes the price list per half hour for taxable days. The dataset also describes available payment methods. Please note that there are rules regarding the maximum rate and multi-passage rule that the dataset does not take into account. See annexes 1 and 2 i Lag (2004:629) om trängselskatt."},{"@language":"sv","@value":"Datasetet beskriver aktuell prislista per halvtimme för skattepliktiga dagar i Stockholm och Göteborg samt vilka betalmetoder som är tillgängliga. Observera att det finns regler rörande maxtaxa och flerpassageregel som datasetet inte tar hänsyn till. Se bilaga 1 och 2 i Lag (2004:629) om trängselskatt."}],"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006099"},"dct:title":[{"@language":"en","@value":"Congestion tax tariffs in Stockholm and Gothenburg"},{"@language":"sv","@value":"Trängselskatt tariffer i Stockholm och Göteborg"}]},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/294","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Congestion taxes Göteborg 2023-12-04.csv"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/295","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/294"},"dcat:downloadURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/294"},"dct:description":[{"@language":"en","@value":"Tariffs in Göteborg"},{"@language":"sv","@value":"Tariffer i Göteborg"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:modified":{"@type":"xsd:date","@value":"2025-01-31T14:03:27.634Z"},"dct:title":[{"@language":"en","@value":"Congestion taxes Göteborg"},{"@language":"sv","@value":"Trängselskatter Göteborg"}]},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/296","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Payment Method Congestion tax.csv"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/297","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/296"},"dcat:downloadURL":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/296"},"dct:description":[{"@language":"en","@value":"Available payment methods for congestion tax and infrastructure charge."},{"@language":"sv","@value":"Tillgängliga betalmetoder för trängselskatt och infrastrukturavgift"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:title":[{"@language":"en","@value":"Payment Method -  Congestion tax and infrastructure charge"},{"@language":"sv","@value":"Betalmetod -  trängselskatt och infrastrukturavgift"}]},