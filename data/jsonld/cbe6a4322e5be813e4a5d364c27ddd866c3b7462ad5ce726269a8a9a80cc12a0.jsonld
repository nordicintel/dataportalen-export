s://transportstyrelsen.entryscape.net/store/7/resource/6","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/4"},"dcat:distribution":[{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/189"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/77"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/99"}],"dcat:keyword":[{"@language":"en","@value":"air traffic movements"},{"@language":"en","@value":"airport"},{"@language":"en","@value":"arrivals"},{"@language":"en","@value":"aviation"},{"@language":"en","@value":"cargo"},{"@language":"en","@value":"departures"},{"@language":"en","@value":"freight"},{"@language":"en","@value":"landings"},{"@language":"en","@value":"mail"},{"@language":"en","@value":"passengers"},{"@language":"en","@value":"seats"},{"@language":"en","@value":"statistics"},{"@language":"sv","@value":"avgångar"},{"@language":"sv","@value":"flygfrakt"},{"@language":"sv","@value":"flygpassagerare"},{"@language":"sv","@value":"flygplats"},{"@language":"sv","@value":"flygrörelser"},{"@language":"sv","@value":"landningar"},{"@language":"sv","@value":"luftfart"},{"@language":"sv","@value":"post"},{"@language":"sv","@value":"starter"},{"@language":"sv","@value":"statistik"},{"@language":"sv","@value":"säten"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Air traffic statistics for Swedish airports containing passengers, supplied seats, departures, arrivals, freight and mail. The statistics are published monthly and are updated the 15th or the next workday.\nFreight and mail data are missing 2005-2007. Freight data regarding the 10 Swedavia airports are missing 2019. That is marked with a short line (-) in data.\nIn the end of September 2022 Swedavia quit collecting and reporting most of their military movements, hence the statistics for September 2022 and onwards are not comparable to earlier statistics.\nFrom the 1st of September 2025 and onwards PostNord has replaced air transport of mail with ground bound transport."},{"@language":"sv","@value":"Flygtrafikstatistik för svenska flygplatser innehållande passagerare, utbjudna säten, starter, landningar, frakt och post. Statistiken redovisas månadsvis och uppdateras den 15:e i månaden eller närmast följande vardag.\nFör åren 2005-2007 saknar vi data för frakt och post. För 2019 saknar vi data för frakt på Swedavias 10 flygplatser. Detta markeras med ett streck (-) i data.\nI slutet av september 2022 slutade Swedavia att samla in och rapportera majoriteten av sina militära rörelser, vilket gör att statistiken från och med september 2022 inte är jämförbar med tidigare statistik.\nFrån och med den 1 september 2025 har PostNord ersatt flygtransporter av brev med markbundna transporter."}],"dct:modified":{"@type":"xsd:date","@value":"2021-12-01"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2021006099"},"dct:temporal":{"@id":"_:187c8a4fa45dae17f18cf298580062ffa30cdda210a130ad30e7e1d045acc8c9_b0n0"},"dct:title":[{"@language":"en","@value":"Airport statistics"},{"@language":"sv","@value":"Flygplatsstatistik"}],"foaf:page":[{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/100"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/102"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/188"}]},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/76","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"2005.csv"},{"@id":"https://transportstyrelsen.entryscape.net/store/7/resource/77","@type":"dcat:Distribution","dcat:accessURL":[{"@id":"https