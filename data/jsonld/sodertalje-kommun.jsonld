w.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d125f44cacf7a63db86e8d2e55739797397e36067ffc37bc9efbaa4f9c574a99_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/126","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/320"},{"@id":"https://catalog.sodertalje.se/store/15/resource/321"}],"dcat:keyword":[{"@language":"sv","@value":"City planning"},{"@language":"sv","@value":"Pågående planarbeten"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Data showing Ongoing city planning work in Södertälje municipality.\nName of plan, property, website and coordinates in WGS84 format.\n\nWith a detailed plan, the municipality regulates how land and water are to be used and what the buildings are to look like. The detailed plan therefore talks about what you and others may and may not do for construction measures within the planning area.\nShow a detailed plan as a specific area on a plan map. The detailed plan map includes a plan description, which explains the plan's purpose and content. Sometimes other documents are also included, such as an illustration map or an environmental impact statement.\n \nhttps://www.boverket.se/sv/samhallsplanering/sa-planeras-sverige/kommunal-planering/detaljplanering/"},{"@language":"sv","@value":"Data som visar Pågående planarbeten i Södertälje kommun.\nNamn på plan, fastighet, webbsida samt koordinater i WGS84-format.\n\nMed en detaljplan reglerar kommunen hur mark och vatten ska användas och hur bebyggelsen ska se ut. Detaljplanen talar därför om vad du och andra får och inte får göra för byggåtgärder inom planområdet.\nEn detaljplan visas som ett bestämt område på en plankarta. Till detaljplanekartan hör en planbeskrivning, som förklarar planens syfte och innehåll. Ibland ingår även andra handlingar, till exempel en illustrationskarta eller en miljökonsekvensbeskrivning.\n \nhttps://www.boverket.se/sv/samhallsplanering/sa-planeras-sverige/kommunal-planering/detaljplanering/"}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:relation":[{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/568/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/586/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/591/"}],"dct:spatial":[{"@id":"_:d125f44cacf7a63db86e8d2e55739797397e36067ffc37bc9efbaa4f9c574a99_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Ongoing city planning work"},{"@language":"sv","@value":"Pågående planarbeten"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/596"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/320","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_planarbeten.json"},"dct:description":[{"@language":"en","@value":"GeoJSON containing Ongoing city planning work in Södertälje municipality.\nName of plan, estate, webpage and coordinates in WGS84-format."},{"@language":"sv","@value":"GeoJSON som visar Pågående planarbeten i Södertälje kommun.\nPlannamn, fastighet, webbsida samt koordinater i WGS84-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Ongoing city planning work GeoJSON"},{"@language":"sv","@value":"Pågående planarbeten GeoJSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/321","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_planarbeten.kml"},"dct:description":[{"@language":"en","@value":"KML-file containing Ongoing city planning work in Södertälje municipality.\nName of plan, estate, webpage and coordinates in WGS84-format."},{"@language":"sv","@value":"KML-fil som visar Pågående planarbeten i Södertälje kommun.\nPlannamn, fastighet, webbsida samt koordinater i WGS84-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/KML"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Ongoing city planning work KML"},{"@language":"sv","@value":"Pågående planarbeten KML"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/596","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokumentation Pågående planarbeten"},"dct:title":{"@language":"sv","@value":"Pågående planarbeten"}}],"@id":"urn:source:d125f44cacf7a63db86e8d2e55739797397e36067ffc37bc9efbaa4f9c574a99"},{"@graph":[{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.624583610934735 59.196484640849576)"}},{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/412","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/413"},{"@id":"https://catalog.sodertalje.se/store/15/resource/414"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Nygatan"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles along Nygatan with IoT AI sensors. The sensors are mounted along Nygatan and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete hour.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade längs Nygatan och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hel timme.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Nygatan - Historical data HOUR (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nygatan - Historik TIMME (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/415"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/413","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETAllTrafficCountNygatanHOUR?start=2026-08-01&end=2026-08-31"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dct:description":[{"@language":"en","@value":"API containing data from traffic flows at Nygatan in Södertälje municipality.\nHistorical data"},{"@l