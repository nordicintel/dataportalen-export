cription":[{"@language":"en","@value":"Data showing ongoing programs in Södertälje municipality.\nName of program and coordinates in WGS84 format.\n\nTo facilitate the detailed plan work, the municipality can choose to establish a special program where the plan's starting points and goals are stated. It is the municipality that decides if a program is needed. The municipality's assessment of whether a program is needed is a position that cannot be reviewed."},{"@language":"sv","@value":"Data som visar Pågående program i Södertälje kommun.\nNamn på program samt koordinater i WGS84-format.\n\nFör att underlätta detaljplanearbetet kan kommunen välja att upprätta ett särskilt program där planens utgångspunkter och mål framgår. Det är kommunen som avgör om ett program behövs. Kommunens bedömning av om det behövs ett program är ett ställningstagande som inte kan överprövas."}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:42335bb40b750a4d59446fb3531126de3622fa2c48fa9bc08dac69362174c847_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Ongoing city program"},{"@language":"sv","@value":"Pågående program"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/597"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/322","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_program.kml"},"dct:description":[{"@language":"en","@value":"KML-file containing Ongoing city planning programs in Södertälje municipality. Name of program and coordinates in WGS84-format."},{"@language":"sv","@value":"KML-fil som visar Pågående program i Södertälje kommun.\nNamn på program samt koordinater i WGS84-format"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/KML"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Ongoing city planning programs KML"},{"@language":"sv","@value":"Pågående program KML"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/323","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_program.json"},"dct:description":[{"@language":"en","@value":"GeoJSON  containing Ongoing city planning programs in Södertälje municipality. Name of program and coordinates in WGS84-format."},{"@language":"sv","@value":"GeoJSON som visar Pågående program i Södertälje kommun.\nNamn på program samt koordinater i WGS84-format"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Ongoing city planning programs GeoJSON"},{"@language":"sv","@value":"Pågående program GeoJSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/597","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokumentation pågående program"},"dct:title":{"@language":"sv","@value":"Pågående program"}}],"@id":"urn:source:42335bb40b750a4d59446fb3531126de3622fa2c48fa9bc08dac69362174c847"},{"@graph":[{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.62458336082596 59.19647591428375)"}},{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/285","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation that explains API and dataset"},{"@language":"sv","@value":"Dokumentation som förklarar API och datamängd"}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Nygatan"},{"@language":"sv","@value":"Dokumentation trafikflödesmätningar Nygatan"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/287","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/288"},{"@id":"https://catalog.sodertalje.se/store/15/resource/331"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Nygatan"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles along Nygatan with IoT AI sensors. The sensors are mounted along Nygatan and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade längs Nygatan och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:42bd179615b497dbaa5f087ca2c11bb64a16b3d80b1bfd3ce56372b61d071000_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Nygatan (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nygatan (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/285"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/288","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETTrafficCountNygatan"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles along Nygatan with IoT AI sensors. The sensors are mounted along Nygatan and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade längs Nygatan och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nSe dokumentation för beskrivning av data."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-23"},"dct:title":[{"@language":"en","@value":"Traffic flows Nygatan (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nygatan (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/285"},"http://data.europa.eu