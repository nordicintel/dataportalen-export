],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"Terrain map including Södertälje municipality for Minecraft.\n\nThe world was created by the municipality's GIS department by exporting the main map to the Minecraft format. In the Minecraft world, there are streets, streams, house foundations, forest land, railway tracks. You can find a place on the map by entering the map coordinates in the Minecraft world. All buildings in Södertälje are marked as house foundations so you can, for example, find the house where you live, or some other interesting place where you want to build."},{"@language":"sv","@value":"Terrängkarta innefattande Södertälje kommun för Minecraft. \n\nVärlden skapades av kommunens GIS-avdelning genom att huvudkartan exporterades till Minecraftformatet. I Minecraftvärlden finns bl a gator, vattendrag, husgrunder, skogsmark, järnvägsräls. Du kan hitta en plats på kartan genom att skriva in kart-koordinaterna i Minecraft- världen. Alla byggnader i Södertälje finns markerade som husgrunder så du kan t ex hitta huset där du bor, eller någon annan intressant plats där du vill bygga."}],"dct:issued":{"@type":"xsd:date","@value":"2019-05-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":{"@id":"http://sws.geonames.org/2676174"},"dct:title":[{"@language":"en","@value":"Minecraft - terrain map"},{"@language":"sv","@value":"Minecraft - terrängkarta"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/702"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/98","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/15/resource/100"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/15/resource/100"},"dct:description":{"@language":"sv","@value":"Java edition (macOS, Linux och Windows)"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/ZIP"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"PC-Java (macOS, Linux och Windows)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/15/resource/101"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/15/resource/101"},"dct:description":{"@language":"sv","@value":"Bedrock edition (ipad, MCeducation, Windows 10 etc)"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"mcworld (iPad, MCeducation, Windows 10)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:749e4834a2bbee2e12c317d577cf5522258e444131772b60e9655252770084d9"},{"@graph":[{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5d4df457acd562a6c23d51b72c13e_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5d4df457acd562a6c23d51b72c13e_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5d4df457acd562a6c23d51b72c13e_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.642899163030208 59.185135429627934)"}},{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5