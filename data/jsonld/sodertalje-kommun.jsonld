52640a25fbaf2908f3aaf4e41_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.628752064781857 59.20003693392954)"}},{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2023-12-09"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/266","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/273"},{"@id":"https://catalog.sodertalje.se/store/15/resource/328"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Mälarbron"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT5M"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over Mälarbron Mälar bridge with IoT AI sensors. The sensors are mounted on the eastern side of the bridge and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över Mälarbron med IoT AI-sensorer. Sensorerna sitter monterade på den östra sidan av bron och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2024-09-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-02"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Mälar bridge (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Mälarbron (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/272"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/272","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"API-documentation"},{"@language":"sv","@value":"Ett dokument som beskriver hur data samlas in och hur den ska förstås."}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Mälar bridge"},{"@language":"sv","@value":"Dokumentation trafikflödesmätningar Mälarbron"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/273","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETTrafficCountMalarbron"},"dct:description":[{"@language":"en","@value":"API containing data from traffic flows over the Mälar bridge in Södertälje municipality."},{"@language":"sv","@value":"API som innehåller data från trafikflödesmätningar över Mälarbron i Södertälje kommun."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-09-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-02"},"dct:title":[{"@language":"en","@value":"Traffic flows Mälar bridge in Södertälje municipality"},{"@language":"sv","@value":"Trafikflödesmätningar Mälarbron i Södertälje"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/272"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/328","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/TC_malarbron"},"dct:description":[{"@language":"en","@value":"Visualization Traffic flows Mälar bridge"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Mälarbron"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Visualization Traffic flows Mälar bridge"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Mälarbron"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:ab08e759432b8b4f7262858d1d7ef07f4efbfc452640a25fbaf2908f3aaf4e41"},{"@graph":[{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.484093398836354 59.276356187657626,17.84109834678953 59.276356187657626,17.84109834678953 58.990122143568556,17.484093398836354 58.990122143568556,17.484093398836354 59.276356187657626))"}},{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/57","@type":"dcat:Dataset","dcat:contactPoint":[{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},{"@id":"https://catalog.sodertalje.se/store/14/resource/87"}],"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/14/resource/88"},{"@id":"https://catalog.sodertalje.se/store/14/resource/89"}],"dcat:keyword":[{"@language":"en","@value":"Hike"},{"@language":"en","@value":"Hiking trail"},{"@language":"en","@value":"Hiking"},{"@language":"en","@value":"Walking trail"},{"@language":"en","@value":"Walking"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Promenad"},{"@language":"sv","@value":"Vandring"},{"@language":"sv","@value":"Vandringsled"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/14/resource/86"},"dct:description":[{"@language":"en","@value":"Hiking trails in Södertälje municipality. The data set consists of two different files where the KML and GeoJSON files contain the names of the hiking trails and coordinates according to the WGS84 format.\n\nSome of the hiking trails appear several times in the material. This is due to the fact that some hiking trails are divided into several sections and that there are sometimes several alternative sections or connecting sections, for example from a nearby urban area to the main section of the trail."},{"@language":"sv","@value":"Vandringsleder i Södertälje kommun. Datamängden består av två olika filer där KML- och GeoJSON-filerna innehåller namn på vandringslederna samt koordinater enligt format WGS84.\n\nNågra av vandringslederna kommer upp flera gånger i materialet. Detta är med anledning av att vissa vandringsleder är uppdelade i flera delsträckor och att det ibland finns flera alternativa sträckningar eller anslutningssträckor exempelvis från en närliggande tätort till ledens huvudsträckning."}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-24"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-05-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:relation":[{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/472/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/527/"}],"dct:spatial":[{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Hiking trails"},{"@language":"sv","@value":"Vandringsleder"}]},{"@id":"https://catalog.sodertalje.se/store/14/resource/86","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://www.sodertalje.se/kommun-och-politik/om-kommunen/organisation/Miljokontoret/"},"foaf:mbox":{"@id":"mailto:miljokontoret@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Miljökontoret"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/87","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljökontoret","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:ace6235f55110336c96591123c6e5a2614de3cc3cc2e382e95b8fb5d32449a96_b3n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljokontoret@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ace6235f55110336c96591123c6e5a2