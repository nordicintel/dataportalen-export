ägen 26"},{"@id":"_:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.571629925158252 59.135569830701364)"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/26/resource/1393","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Dokument som förklarar datamängden och dess förutsättningar."},"dct:title":{"@language":"sv","@value":"Dokumentation besöksstatistik Återvinningscentral"}},{"@id":"https://catalog.sodertalje.se/store/26/resource/5","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/26/resource/6"},{"@id":"https://catalog.sodertalje.se/store/26/resource/7"}],"dcat:keyword":[{"@language":"sv","@value":"Besök"},{"@language":"sv","@value":"Besöksstatistik"},{"@language":"sv","@value":"IoT"},{"@language":"sv","@value":"Kö"},{"@language":"sv","@value":"Kötid"},{"@language":"sv","@value":"Realtidsdata"},{"@language":"sv","@value":"Recycling"},{"@language":"sv","@value":"ÅVC"},{"@language":"sv","@value":"Återvinning"},{"@language":"sv","@value":"Återvinningscentral"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/9/resource/8"},"dct:description":{"@language":"sv","@value":"Datamängden innehåller realtidsdata och besöksstatistik för återvinningscentralen Tveta i Södertälje kommun.\nRealtidsdata är baserat på antalet passager med fordon in respektive genom bommarna.\nUppgifterna är inte 100% utan är tänkt att ge en uppfattning om när det är många besökare och risk för köer.\nBesöksstatistiken är baserad på en jämförelse med samma tid föregående år samt viktat med ett genomsnitt av besöken under fyra veckor före och fyra veckor efter. Detta för att minska påverkan av statistiken baserad på väder eller högtider/kalender."},"dct:issued":{"@type":"xsd:date","@value":"2022-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be_b2n0"},{"@id":"https://sws.geonames.org/8131765"}],"dct:title":{"@language":"sv","@value":"Besöksstatistik Återvinningscentralen Tveta (IoT)"},"foaf:page":{"@id":"https://catalog.sodertalje.se/store/26/resource/1393"}},{"@id":"https://catalog.sodertalje.se/store/26/resource/6","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sodertalje.se/getTveta"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dct:description":{"@language":"sv","@value":"Distributionen består av ett API innehållandes realtidsdata och besöksstatistik för återvinningscentralen Tveta i Södertälje kommun. Realtidsdata är baserat på antalet passager med fordon in respektive genom bommarna. Uppgifterna är inte 100% utan är tänkt att ge en uppfattning om när det är många besökare och risk för köer. Besöksstatistiken är baserad på en jämförelse med samma tid föregående år samt viktat med ett genomsnitt av besöken under fyra veckor före och fyra veckor efter. Detta för att minska påverkan av statistiken baserad på väder eller högtider/kalender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Besöksstatistik Återvinningscentral Tveta API"},"foaf:page":{"@id":"https://catalog.sodertalje.se/store/26/resource/1393"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://catalog.sodertalje.se/store/26/resource/7","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sodertalje.se/kommun-och-politik/for-medborgare/digitala.sodertalje/datavisualisering/avc"},"dct:description":{"@language":"sv","@value":"Visualiseringen visar realtidsdata och besöksstatistik för återvinningscentralen Tveta i Södertälje kommun. Realtidsdata är baserat på antalet passager med fordon in respektive genom bommarna. Uppgifterna är inte 100% utan är tänkt att ge en uppfattning om när det är många besökare och risk för köer. Besöksstatistiken är baserad på en jämförelse med samma tid föregående år samt viktat med ett genomsnitt av besöken under fyra veckor före och fyra veckor efter. Detta för att minska påverkan av statistiken baserad på väder eller högtider/kalender."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2022-09-02"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Visualisering Tveta återvinningscentral besöksstatistik"},"foaf:page":{"@id":"https://catalog.sodertalje.se/store/26/resource/1393"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://catalog.sodertalje.se/store/9/resource/8","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/Company"},"foaf:homepage":{"@id":"https://telge.se"},"foaf:name":[{"@language":"en","@value":"Telge recycling"},{"@language":"sv","@value":"Telge återvinning"}]}],"@id":"urn:source:59e0c16df05335a2348fc520ca57d17124552f8dd907876c27b7c21984e2f4be"},{"@graph":[{"@id":"_:5b9674d810e868c9ee3ee4d28037a5b8ba0ff6657a232af999fdb6aa61c62847_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:5b9674d810e868c9ee3ee4d28037a5b8ba0ff6657a232af999fdb6aa61c62847_b1n0","@type":"http://www.w