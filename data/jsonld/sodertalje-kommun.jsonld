{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.62582752333743 59.19491672166069)"}},{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/292","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation explaining API and dataset"},{"@language":"sv","@value":"Dokumentation som förklarar API och datamängd"}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Nedre torekällgatan intersection - Historical data 24H"},{"@language":"sv","@value":"Dokumentation trafikflödesmätning Nedre torekällgatan Historik 24H"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/295","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/296"},{"@id":"https://catalog.sodertalje.se/store/15/resource/325"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Nedre torekällgatan"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over the intersection Nedre Torekällgatan/Nygatan with IoT AI sensors. The sensors are mounted in the intersection and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete days.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över korsningen Nedre Torekällgatan/Nygatan med IoT AI-sensorer. Sensorerna sitter monterade i korsningen och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hela dygn.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:0007f188d1d7c02349a9853807e21a0db1e7a13ccdde141f0cc91f8d9ce3dded_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Nedre Torekällgatan intersection - Historical data 24H (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nedre Torekällgatan - Historik 24H (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/292"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/296","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETAllTrafficCountTorekallsgatan?start=2024-12-01&end=2024-12-23"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dct:description":[{"@language":"en","@value":"API containing data from traffic flows at the intersection Nedre Torekällgatan/Nygatan in Södertälje municipality.\nHistorical data"},{"@language":"sv","@value":"API som innehåller data från trafikflödesmätningar vid korsningen Nedre torekällgatan/Nygatan i Södertälje kommun.\nHistorisk data"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-12-23"},"dct:title":[{"@language":"en","@value":"Traffic flows Nedre Torekällgatan intersection - Historical data 24H"},{"@language":"sv","@value":"Trafikflödesmätningar Nedre Torekällgatan - Historik 24H"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/292"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/325","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/TC_nedretorekall"},"dct:descr