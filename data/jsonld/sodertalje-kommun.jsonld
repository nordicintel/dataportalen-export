ype":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b7n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b8n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b9n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/142","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://catalog.sodertalje.se/store/12/resource/165"},{"@id":"https://catalog.sodertalje.se/store/12/resource/196"}],"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/12/resource/143"},{"@id":"https://catalog.sodertalje.se/store/12/resource/144"}],"dcat:keyword":[{"@language":"en","@value":"Accounts payable"},{"@language":"en","@value":"Economy"},{"@language":"en","@value":"Expense"},{"@language":"en","@value":"Invoice"},{"@language":"en","@value":"Procurement"},{"@language":"en","@value":"Purchase"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:landingPage":{"@id":"https://service.sodertalje.se/bestall-fakturabild"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/12/resource/161"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use Södertälje municipality's e-service: https://service.sodertalje.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nThe \"date\" field shows the date on which a vendor invoice meets the following criteria:\n \n• When the invoice has updated the general ledger with a complete cost posting.\n• When the invoice is certified for review and decision.\n• Then the invoice will be paid to the supplier the next working day.\n\nFor that reason, invoices for the next period can be included in the export from the accounting system and the publication as open data.\n\nA description of the specification on which the data set is based is available via dataportal.se https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda.\n\nNär det står [Kan omfattas av sekretess] innebär det att någon uppgift avseende inköpet kan omfattas av sekretess och att en mer noggrann prövning måste göras.\n\nFör att ta del av underliggande fakturor använd Södertälje kommuns e-tjänst: https://service.sodertalje.se/bestall-fakturabild och ange verifikationsnummer för den eller de fakturor ni är intresserade av. \n\nFältet \"datum\" visar det datum då en leverantörsfaktura uppfyller följande kriterier:\n \n\t• Då fakturan har uppdaterat huvudboken med fullständig kostnadskontering.\n\t• Då fakturan är gransknings- och beslutsattesterad.\n\t• Då fakturan kommer att utbetalas till leverantören nästkommande arbetsdag.\n\nAv det skälet kan fakturor för nästkommande period komma med i exporten från redovisningssystemet och publiceringen som öppna data. På samma sätt kan föregående års fil innehålla sista dagarna på innevarande år.\n\nEn beskrivning av den specifikation som datamängden utgår från finns att tillgå via dataportal.se https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"}],"dct:issued":{"@type":"xsd:date","@value":"2021-10-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2022-03-28"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:relation":{"@id":"https://service.sodertalje.se/bestall-fakturabild"},"dct:spatial":[{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b0n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:ddb88a3f3f0b10ebfe7f2340a88bcf5e9ddd0cd36df1ffdc3aef54c435995a9c_b1n0"},"dct:title":[{"@language":"en","@value":"Accounts payable 2021"},{"@language":"sv","@value":"Leverantörsreskontra 2021"}],"foaf:page":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/143","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/145"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/145"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dct:conformsTo":{"@id":"https://lankadedata.se/spec/leverantorsreskontra/#schemaCSV"},"dct:description":[{"@language":"en","@value":"CSV-file over Södertälje municipalitys accouts payable 2021"},{"@language":"sv","@value":"CSV-fil över Södertälje kommuns leverantörsreskontra 2021"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2021-10-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2022-05-30T14:28:30.822Z"},"dct:title":[{"@language":"en","@value":"Accounts payable 2021"},{"@language":"sv","@value":"Leverantörsreskontra 2021"}],"foaf:page":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"},"http://data.europa.eu/r5r/availabili