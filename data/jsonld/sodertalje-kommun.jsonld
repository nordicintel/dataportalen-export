ntifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:df5e3178da50cb7711d1679a61b03ba8ac89479b2fd7b23208edd8127ed2e854_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:df5e3178da50cb7711d1679a61b03ba8ac89479b2fd7b23208edd8127ed2e854_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/263","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"A document in swedish that explains how the dataset Bridge opening  Motorway bridge is to be understood."},{"@language":"sv","@value":"Ett dokument som på svenska förklarar hur datamängden \"Broöppning Motorvägsbron\" ska förstås."}],"dct:title":[{"@language":"en","@value":"Documentation Bridge opening the Motorway bridge"},{"@language":"sv","@value":"Dokumentation Broöppning Motorvägsbron"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/334","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":{"@id":"https://catalog.sodertalje.se/store/15/resource/335"},"dcat:keyword":[{"@language":"en","@value":"bridge opening"},{"@language":"en","@value":"bridge"},{"@language":"sv","@value":"Motorway bridge"},{"@language":"sv","@value":"bro"},{"@language":"sv","@value":"broöppning"},{"@language":"sv","@value":"fällbro"},{"@language":"sv","@value":"sjöfart"},{"@language":"sv","@value":"trafik"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Data that shows the historical bridge openings of the Motorway bridge at E4/E20 in Södertälje.\n\nThe data is collected from Trafikverket and redistributed in an open API. The Motorway bridge cannot currently show actual openings and closings, only planned openings and closings."},{"@language":"sv","@value":"Data som visar historiken av planerade broöppningar för Motorvägsbron på E4/E20 i Södertälje.\n\nData samlas in från Trafikverket och vidarepubliceras i helt öppet API. Motorvägsbron visar inte för tillfället den faktiska öppningen och stängningen av bron utan enbart när det är planerat."}],"dct:issued":{"@type":"xsd:date","@value":"2025-08-27"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:df5e3178da50cb7711d1679a61b03ba8ac89479b2fd7b23208edd8127ed2e854_b2n0"},{"@id":"https://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:df5e3178da50cb7711d1679a61b03ba8ac89479b2fd7b23208edd8127ed2e854_b3n0"},"dct:title":[{"@language":"en","@value":"Kopia av Bridge opening Motorway bridge historical data"},{"@language":"sv","@value":"Broöppning Motorvägsbron historisk data"}],"foaf:page":[{"@id":"https://catalog.sodertalje.se/store/15/resource/263"},{"@id":"https://data.trafikverket.se/documentation/datacache/data-model"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/335","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sodertalje.se/getallbridgeplanned?start=2025-06-01&end=2025-06-30"},"dct:description":[{"@language":"en","@value":"API that shows the history of planned bridge openings on the Motorway bridge at E4/E20 in Södertälje.\n\nThe data is collected from Trafikverket and redistributed in an open API. The Motorway bridge cannot currently show actual openings and closings, only planned openings and closings."},{"@language":"sv","@value":"API som visar historiken för planerade broöppningar för Motorvägsbron på E4/E20 i Södertälje.\n\nData samlas in från Trafikverket och vidarepubliceras i helt öppet API. Motorvägsbron visar inte för tillfället den faktiska öppningen och stängningen av bron utan enbart när det är planerat."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2025-08-27"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Bridge opening Motorway bridge Historical data API"},{"@language":"sv","@value":"Broöppning Motorvägsbron Historisk data API"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/263"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://data.trafikverket.se/documentation/datacache/data-model","@type":"foaf:Document","dct:description":{"@language":"sv","@value":"Trafikverkets datamodell"},"dct:title":{"@language":"sv","@value":"T