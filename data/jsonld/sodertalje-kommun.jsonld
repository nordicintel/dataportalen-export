http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:8eebcd5734a98916d35cdd766fcd49ec1319938764b2db878422ed5f43b7702a_b9n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/149","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://catalog.sodertalje.se/store/12/resource/165"},{"@id":"https://catalog.sodertalje.se/store/12/resource/196"}],"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/12/resource/150"},{"@id":"https://catalog.sodertalje.se/store/12/resource/151"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:landingPage":{"@id":"https://service.sodertalje.se/bestall-fakturabild"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/12/resource/161"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda.\n\nNär det står [Kan omfattas av sekretess] innebär det att någon uppgift avseende inköpet kan omfattas av sekretess och att en mer noggrann prövning måste göras.\n\nFör att ta del av underliggande fakturor använd Södertälje kommuns e-tjänst: https://service.sodertalje.se/bestall-fakturabild och ange verifikationsnummer för den eller de fakturor ni är intresserade av. \n\nFältet \"datum\" visar det datum då en leverantörsfaktura uppfyller följande kriterier:\n \n\t• Då fakturan har uppdaterat huvudboken med fullständig kostnadskontering.\n\t• Då fakturan är gransknings- och beslutsattesterad.\n\t• Då fakturan kommer att utbetalas till leverantören nästkommande arbetsdag.\n\nAv det skälet kan fakturor för nästkommande period komma med i exporten från redovisningssystemet och publiceringen som öppna data. På samma sätt kan föregående års fil innehålla sista dagarna på innevarande år.\n\nEn beskrivning av den specifikation som datamängden utgår från finns att tillgå via dataportal.se https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"}],"dct:issued":{"@type":"xsd:date","@value":"2023-01-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-02-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:8eebcd5734a98916d35cdd766fcd49ec1319938764b2db878422ed5f43b7702a_b0n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:8eebcd5734a98916d35cdd766fcd49ec1319938764b2db878422ed5f43b7702a_b1n0"},"dct:title":[{"@language":"en","@value":"Accounts payable 2023"},{"@language":"sv","@value":"Leverantörsreskontra 2023"}],"foaf:page":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/150","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/152"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/152"},"dct:conformsTo":{"@id":"https://lankadedata.se/spec/leverantorsreskontra/#schemaCSV"},"dct:description":[{"@language":"en","@value":"CSV-file over Södertälje municipalitys accouts payable 2023"},{"@language":"sv","@value":"CSV-fil över Södertälje kommuns leverantörsreskontra 2023"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2023-01-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2024-01-15"},"dct:title":[{"@language":"en","@value":"Accounts payable 2023"},{"@language":"sv","@value":"Leverantörsreskontra 2023"}],"foaf:page":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/151","@type"