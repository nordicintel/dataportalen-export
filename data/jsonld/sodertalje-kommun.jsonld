"bridge"},{"@language":"sv","@value":"Motorway bridge"},{"@language":"sv","@value":"bro"},{"@language":"sv","@value":"broöppning"},{"@language":"sv","@value":"fällbro"},{"@language":"sv","@value":"sjöfart"},{"@language":"sv","@value":"trafik"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2021006297"},"dct:description":[{"@language":"en","@value":"Data that shows the planned bridge openings the Motorway bridge at E4/E20 in Södertälje.\n\nThe data is collected from Trafikverket and redistributed in an open API. The Motorway bridge cannot currently show actual openings and closings, only planned openings and closings."},{"@language":"sv","@value":"Data som visar planerad broöppning för Motorvägsbron på E4/E20 i Södertälje.\n\nData samlas in från Trafikverket och vidarepubliceras i helt öppet API. Motorvägsbron visar inte för tillfället den faktiska öppningen och stängningen av bron utan enbart när det är planerat."}],"dct:issued":{"@type":"xsd:date","@value":"2024-05-21"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2025-02-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5d4df457acd562a6c23d51b72c13e_b2n0"},{"@id":"https://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:7773b7f74aa9607ec4c7d15ea45b8bfba9e5d4df457acd562a6c23d51b72c13e_b3n0"},"dct:title":[{"@language":"en","@value":"Bridge opening Motorway bridge real time data"},{"@language":"sv","@value":"Broöppning Motorvägsbron realtidsdata"}],"foaf:page":[{"@id":"https://catalog.sodertalje.se/store/15/resource/263"},{"@id":"https://data.trafikverket.se/documentation/datacache/data-model"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/15","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sodertalje.se/getBridgeplanned"},"dct:description":[{"@language":"en","@value":"API that shows the planned bridge openings the Motorway bridge at E4/E20 in Södertälje.\n\nThe data is collected from Trafikverket and redistributed in an open API. The Motorway bridge cannot currently show actual openings and closings, only planned openings and closings."},{"@language":"sv","@value":"API som visar planerad broöppning för Motorvägsbron på E4/E20 i Södertälje.\n\nData samlas in från Trafikverket och vidarepubliceras i helt öppet API. Motorvägsbron visar inte för tillfället den faktiska öppningen och stängningen av bron utan enbart när det är planerat."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-05-21"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Bridge opening Motorway bridge API"},{"@language":"sv","@value":"Broöppning Motorvägsbron API"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/263"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/263","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"A document in swedish tha