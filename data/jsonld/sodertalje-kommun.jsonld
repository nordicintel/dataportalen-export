006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:8be5a0ec2b5c4e5dec861bcf6bf62d67b7dc5ec7f8ea7a14bf492d81592cfabd_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/416","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/417"},{"@id":"https://catalog.sodertalje.se/store/15/resource/418"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Nedre torekällgatan"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over the intersection Nedre Torekällgatan/Nygatan with IoT AI sensors. The sensors are mounted in the intersection and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete hour.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över korsningen Nedre Torekällgatan/Nygatan med IoT AI-sensorer. Sensorerna sitter monterade i korsningen och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hel timme.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:8be5a0ec2b5c4e5dec861bcf6bf62d67b7dc5ec7f8ea7a14bf492d81592cfabd_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:8be5a0ec2b5c4e5dec861bcf6bf62d67b7dc5ec7f8ea7a14bf492d81592cfabd_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Nedre Torekällgatan intersection - Historical data HOUR (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nedre Torekällgatan - Historik TIMME (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/419"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/417",