@language":"sv","@value":"GeoJSON-fil som visar var Södertälje kommuns olika grillplatser fins."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-02-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-22"},"dct:title":[{"@language":"en","@value":"Barbecue areas GeoJSON"},{"@language":"sv","@value":"Grillplatser GeoJSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/87","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Miljökontoret","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:155f11a0b903959f336eab21b3bbbd467386ac04e7f73f9620d144de360bdf33_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:miljokontoret@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:155f11a0b903959f336eab21b3bbbd467386ac04e7f73f9620d144de360bdf33_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/92","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/14/resource/87"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/14/resource/100"},{"@id":"https://catalog.sodertalje.se/store/14/resource/101"},{"@id":"https://catalog.sodertalje.se/store/14/resource/99"}],"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"barbecue areas"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/grillplatser/1.0"},"dct:description":[{"@language":"en","@value":"The dataset includes barbecue areas in public places outdoors that are free to use for the public, usually all year round and free of charge. At the barbecue area there is often benches, wind guard and other equipment for a pleasant experience. The dataset contains information about e.g. name, location, contact information and more. There may also be additional information about which characteristics that are available at the barbecue area. Water for putting out the fire or something else."},{"@language":"sv","@value":"Datamängden grillplatser (barbecue areas på engelska) omfattar grillplatser på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Vid grillplatserna finns oftast bänkar, vindskydd och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid grillplatsen. Exempelvis vatten för att släcka en eld."}],"dct:issued":{"@type":"xsd:date","@value":"2024-02-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:155f11a0b903959f336eab21b3bbbd467386ac04e7f73f9620d144de360bdf33_b2n0"},{"@id":"https://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Barbecue areas"},{"@language":"sv","@value":"Grillplatser"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/143"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/99","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/Grillplatser.csv"},"dct:description":[{"@language":"en","@value":"CSV with barbecue areas in Södertälje municipality."},{"@language":"sv","@value":"CSV-fil som visar var Södertälje kommuns olika grillplatser finns."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2024-02-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-22"},"dct:title":[{"@language":"en","@value":"Barbeque areas"},{"@language":"sv","@value":"Grillplatser CSV"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://dataportal.se/specifications/grillplatser/1.0","@type":"dct:Standard","dcat:contactPoint":{"@id":"https://editera.dataportal.se/store/130/resource/1"},"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"grillplatser"}],"dct:description":{"@language":"sv","@value":"Med grillplats menas en särskilt anlagd eller skött allmän plats där man kan göra upp eld och/eller grilla i en särskilt anlagd härd.\n\nDenna specifikation definierar en enkel tabulär informationsmodell för grillplatser. Specifikationen innefattar också en beskrivning av hur informationen uttrycks i formatet CSV och JSON. Som grund förutsätts CSV kunna levereras då det är praktiskt format och skapar förutsägbarhet för mottagare av informationen. Det är också ett format som gör sammanställningen av datamängden enklare då den kan representeras i t.ex. ett kalkylblad."},"dct:issued":{"@type":"xsd:date","@value":"2022-07-11"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"http://www.w3.org/ns/dx/prof/hasResource":[{"@id":"https://community.dataportal.se/topic/708/v%C3%A4gledning-f%C3%B6r-att-publicera-data-om-grillplatser/6"},{"@id":"https://editera.dataportal.se/store/130/resource/4"},{"@id":"https://gitlab.com/lankadedata/spec/grillplatser"},{"@id":"https://lankadedata.se/spec/grillplatser/"},{"@id":"https://lankadedata.se/spec/grillplatser/schema.json"}]},{"@id":"https://editera.dataportal.se/store/130/resource/1","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Tomas Monsén","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:tomas.monsen@toreboda.se"}}],"@id":"urn:source:155f11a0b903959f336eab21b3bbbd467386ac04e7f73f9620d144de360bdf33"},{"@graph":[{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.62505431064041 59.191267567891344)"}},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b1n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2025-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2025-01-01"}},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b4n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b5n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b6n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b7n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b8n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b9n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/154","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":[{"@id":"https://catalog.sodertalje.se/store/12/resource/165"},{"@id":"https://catalog.sodertalje.se/store/12/resource/196"}],"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/12/resource/182"},{"@id":"https://catalog.sodertalje.se/store/12/resource/184"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:landingPage":{"@id":"https://service.sodertalje.se/bestall-fakturabild"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/12/resource/161"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use the municipality's e-service: https://service.sodertalje.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda.\n\nNär det står [Kan omfattas av sekretess] innebär det att någon uppgift avseende inköpet kan omfattas av sekretess och att en mer noggrann prövning måste göras.\n\nFör att ta del av underliggande fakturor använd Södertälje kommuns e-tjänst: https://service.sodertalje.se/bestall-fakturabild och ange verifikationsnummer för den eller de fakturor ni är intresserade av. \n\nFältet \"datum\" visar det datum då en leverantörsfaktura uppfyller följande kriterier:\n \n\t• Då fakturan har uppdaterat huvudboken med fullständig kostnadskontering.\n\t• Då fakturan är gransknings- och beslutsattesterad.\n\t• Då fakturan kommer att utbetalas till leverantören nästkommande arbetsdag.\n\nAv det skälet kan fakturor för nästkommande period komma med i exporten från redovisningssystemet och publiceringen som öppna data. På samma sätt kan föregående års fil innehålla sista dagarna på innevarande år.\n\nEn beskrivning av den specifikation som datamängden utgår från finns att tillgå via dataportal.se https://www.dataportal.se/sv/specifications/leverantorsreskontra/latest"}],"dct:issued":{"@type":"xsd:date","@value":"2025-01-16"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b0n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b1n0"},"dct:title":[{"@language":"en","@value":"Accounts payable 2025"},{"@language":"sv","@value":"Leverantörsreskontra 2025"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/161","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Redovisningsenheten"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/165","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontaktcenter@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:15ec3a6f6f1b5e0ce731a852c19413221f2b48326980f7b492ba3a2d27c65821_b3n0"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/181","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Öppen data 202501-202512.csv"},{"@id":"https://catalog.sodertalje.se/store/12/resource/182","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/181"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/12/resource/181"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dct:description":[{"@language":"en","@value":"CSV-file over Södertälje municipalitys accouts payable 2025"},{"@language":"sv","@value":"CSV-fil över Södertälje kommuns leverantörsreskontra 2025"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value":"2025-02-27"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-21T15:59:58.281Z"},"dct:title":[{"@language":"en","@value":"Accounts payable 2025"},{"@language":"sv","@value":"Leverantörsreskontra 2025"}],"foaf:page":{"@id":"https://www.dataportal.se/sv/specifications/leverantorsreskontra/lat