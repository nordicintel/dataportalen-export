s/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/415","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation that explains API and dataset"},{"@language":"sv","@value":"Dokumentation som förklarar API och datamängd"}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Nygatan - Historical data 24H"},{"@language":"sv","@value":"Dokumentation trafikflödesmätningar Nygatan - Historik TIMME"}]}],"@id":"urn:source:d14aae391fef4e0c1bf6e64c6d215268f6c6cee6b2299d5cc6940a097fbc1027"},{"@graph":[{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.35679184719296 59.318184558309525,17.869205278392627 59.318184558309525,17.869205278392627 58.97992650469001,17.35679184719296 58.97992650469001,17.35679184719296 59.318184558309525))"}},{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2021-03-18"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/297","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETALLwatertemp?start=2026-06-15&end=2026-07-15"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dct:description":[{"@language":"en","@value":"Historical data temperature sensors (IoT) public beaches, shows temperature measurements in Södertälje municipality's bathing lakes.\n\nThere are sensors in the bathing lakes that measure water temperature every day, which is then reported further through a LoRaWAN network to a database that can be accessed through this amount of data.\n\nThe sensors are mounted at a depth of about one meter.\n\nIf the API returns an error message it is because the sensors are either taken inside for the season or temporarily out of order during the selected period."},{"@language":"sv","@value":"Datamängden Data temperatursensorer (IoT) badplatser visar temperaturmätningar i Södertälje kommuns badsjöar. Det sitter sensorer i badsjöarna som mäter vattentemperatur varje timme vilket sedan rapporteras vidare genom ett LoRaWAN-nät till en databas som det går att nå genom denna datamängd. Sensorerna sitter monterade på ca en meters djup.\n\nDistributionen visar historisk data och du väljer period i URL:en\n\nOm APIet ger tillbaka ett felmeddelande så beror det på att alla sensorerna är antingen inplockade på säsongen eller tillfälligt ur funktion under den valda perioden."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2020-06-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-04"},"dct:title":[{"@language":"en","@value":"Historical data temperature sensors (IoT) - Public beaches,"},{"@language":"sv","@value":"Data temperatursensorer (IoT) badplatser - Historisk data"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/862"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/862","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation data temperature (IoT) public beaches"},{"@language":"sv","@value":"Dokumentation data temperatursensorer (IoT) badplatser"}],"dct:title":[{"@language":"en","@value":"Documentation data temperature (IoT) public beaches"},{"@language":"sv","@value":"Dokumentation data temperatursensorer (IoT) badplatser"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/9","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":{"@id":"https://catalog.sodertalje.se/store/15/resource/297"},"dcat:keyword":[{"@language":"en","@value":"bathing lake"},{"@language":"en","@value":"bathing sites"},{"@language":"en","@value":"bathing water"},{"@language":"en","@value":"beaches"},{"@language":"en","@value":"temperature"},{"@language":"en","@value":"water temperature"},{"@language":"sv","@value":"Internet of things"},{"@language":"sv","@value":"IoT"},{"@language":"sv","@value":"Sakernas internet"},{"@language":"sv","@value":"Sensor"},{"@language":"sv","@value":"bad"},{"@language":"sv","@value":"badplats"},{"@language":"sv","@value":"badsjö"},{"@language":"sv","@value":"badvatten"},{"@language":"sv","@value":"lake"},{"@language":"sv","@value":"sjö"},{"@language":"sv","@value":"temperatur"},{"@language":"sv","@value":"vattentemperatur"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:description":[{"@language":"en","@value":"Historical data temperature sensors (IoT) Public beaches, shows temperature measurements in Södertälje municipality's bathing lakes.\n\nThere are sensors in the bathing lakes that measure water temperature every day, which is then reported further through a LoRaWAN network to a database that can be accessed through this amount of data.\n\nThe sensors are mounted at a depth of about one meter.\n\nIf the API returns NO DATA it is because the sensors are either taken inside for the season or temporarily out of order during the selected period."},{"@language":"sv","@value":"Datamängden Historisk data temperatursensorer (IoT) badplatser visar temperaturmätningar i Södertälje kommuns badsjöar.\n\nDet sitter sensorer i badsjöarna som mäter vattentemperatur varje dygn vilket sedan rapporteras vidare genom ett LoRaWAN-nät till en databas som det går att nå genom denna datamängd.\n\nSensorerna sitter monterade på ca en meters djup.\n\nOm APIet ger tillbaka ett felmeddelande så beror det på att alla sensorerna är antingen inplockade på säsongen eller tillfälligt ur funktion under den valda perioden."}],"dct:issued":{"@type":"xsd:date","@value":"2024-06-11"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7_b3n0"},"dct:title":[{"@language":"en","@value":"Historical data temperature sensors (IoT) Public beaches"},{"@language":"sv","@value":"Data temperatursensorer (IoT) badplatser - Historisk data"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/862"}}],"@id":"urn:source:da53fb51de4dc0aa55ba75bacc54582b6a04ca571fbcdfe06f679dcb1d399ab7"},{"@graph":[{"@id":"_:dc87e0ca475e8db8a8bfaa72a1b019fb10a859f279138d1f361d03dc4eed2008_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:dc87e0ca475e8db8a8bfaa72a1b019fb10a859f279138d1f361d03dc4eed2008_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:dc87e0ca475e8db8a8bfaa72a1b019fb10a859f279138d1f361d03dc4eed2008_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:dc87e0ca475e8db8a8bfaa72a1b019fb10a859f279138d1f361d03dc4eed2008_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"