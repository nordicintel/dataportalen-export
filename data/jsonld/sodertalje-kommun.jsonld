"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/286","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation that explains API and dataset"},{"@language":"sv","@value":"Dokumentation som förklarar API och datamängd"}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Nygatan - Historical data 24H"},{"@language":"sv","@value":"Dokumentation trafikflödesmätningar Nygatan - Historik 24H"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/289","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/290"},{"@id":"https://catalog.sodertalje.se/store/15/resource/330"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Nygatan"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles along Nygatan with IoT AI sensors. The sensors are mounted along Nygatan and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete days.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade längs Nygatan och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hela dygn.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:651e11aa8acfe58d21e301151b8b071c7a9a64d847efa2d3af1f7bb1f1f96277_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:651e11aa8acfe58d21e301151b8b071c7a9a64d847efa2d3af1f7bb1f1f96277_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Nygatan - Historical data 24H (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Nygatan - Historik 24H (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/286"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/290","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETAllTrafficCountnygatan?start=2025-01-20&end=2025-02-02"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dct:description":[{"@language":"en","@value":"API containing data from traffic flows at Nygatan in Södertälje municipality.\nHistorical data"},{"@language":"sv","@value":"API som innehåller data från trafikflödesmätningar vid Nygatan i Södertälje kommun.\nHistorisk data"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Traffic flows Nygatan - Historical data 24H"},{"@language":"sv","@value":"Trafikflödesmätningar Nygatan - Historik 24H"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/286"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/330","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/TC_nygatan"},"dct:description":[{"@language":"en","@value":"Visualization Traffic flows Nygatan"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Nygatan"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-17"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":[{"@language":"en","@value":"Visualization Traffic flows Nygatan"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Nygatan"}