guage":"sv","@value":"Dokumentation broöppning Mälarbron"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/16","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":{"@id":"https://catalog.sodertalje.se/store/15/resource/17"},"dcat:keyword":[{"@language":"en","@value":"bridge opening"},{"@language":"en","@value":"bridge"},{"@language":"sv","@value":"bro"},{"@language":"sv","@value":"broöppning"},{"@language":"sv","@value":"fällbro"},{"@language":"sv","@value":"mälarbron"},{"@language":"sv","@value":"sjöfart"},{"@language":"sv","@value":"trafik"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:description":[{"@language":"en","@value":"Data that shows the bridge opening status for the Mälar bridge in Södertälje.\n\nThe Mälar bridge is using an IoT device connected to the control system for the bridge and shows when the bridge is up and down. Mälarbron cannot currently show planned openings.\n\nThis dataset contains historical data of previous bridge openings."},{"@language":"sv","@value":"Data som visar broöppningsstatus för Mälarbron i Södertälje.\n\nMälarbron med hjälp av en IoT-enhet kopplad till styrsystemet för bron visar när bron är upp- och nedfälld. Mälarbron kan inte visa planerade öppningar i dagsläget.\n\nDenna datamängd innehåller historisk data över tidigare broöppningar."}],"dct:issued":{"@type":"xsd:date","@value":"2024-02-06"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:modified":{"@type":"xsd:date","@value":"2025-03-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:8cf2a8759d5b9916b8935b2f84496c517aa699339a5c285c62f1163424586f9a_b2n0"},{"@id":"https://sws.geonames.org/2676174"}],"dct:temporal":{"@id":"_:8cf2a8759d5b9916b8935b2f84496c517aa699339a5c285c62f1163424586f9a_b3n0"},"dct:title":[{"@language":"en","@value":"Bridge opening Mälar bridge Historical data (IoT)"},{"@language":"sv","@value":"Broöppning Mälarbron Historisk data (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1496"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/17","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://api.sodertalje.se/getAllBridgestat?start=2023-01-01&end=2024-12-31"},"dct:description":[{"@language":"en","@value":"An API that shows the bridge opening status for the Mälar bridge in Södertälje.\n\nThe Mälar bridge is using an IoT device connected to the control system for the bridge and shows when the bridge is up and down. Mälarbron cannot currently show planned openings.\n\nThis dataset contains historical data of previous bridge openings.\nSelect period in the URL"},{"@language":"sv","@value":"Ett API som visar broöppningsstatus för Mälarbron i Södertälje.\n\nMälarbron med hjälp av en IoT-enhet kopplad till styrsystemet för bron visar när bron är upp- och nedfälld. Mälarbron kan inte visa planerade öppningar i dagsläget.\n\nDenna datamängd innehåller historisk data över tidigare broöppningar. Välj intressant period i URL:en"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-02-06"},"dct:language":[{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},{"@id":"http://publications.europa.eu/resource/authority/language/SWE"}],"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-03-04"},"dct:title":[{"@language":"en","@value":"Bridge opening Mälar bridge historical data (IoT)"},{"@language":"sv","@value":"Broöppning Mälarbron historik (IoT) API"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1496"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:8cf2a8759d5b9916b8935b2f84496c517aa699339a5c285c62f1163424586f9a"},{"@graph":[{"@id":"_:8e739d90ca33722d85ac50a28c0095363496373cb06af0e12b3464136750b659_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:8e739d90ca33722d85ac50a28c0095363496373cb06af0e12b3464136750b659_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:8e739d90ca33722d85ac50a28c0095363496373cb06af0e12b3464136750b659_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.340840123150777 59.305110986831295,17.7932487178493 59.305110986831295,17.7932487178493 58.919093757028776,17.340840123150777 58.919093757028776,17.340840123150777 59.305110986831295))"}},{"@id":"_:8e739d90ca33722d85ac50a28c0095363496373cb06af0e12b3464136750b659_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15172","http://www.w3.org/2006/vcard/ns#street-address":"Lunagallerian, Storgatan 15"