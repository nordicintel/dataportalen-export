http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:37973e07d47ca0616afa14623415124612ab148b919411cce32007f301faa874_b2n0"}}],"@id":"urn:source:37973e07d47ca0616afa14623415124612ab148b919411cce32007f301faa874"},{"@graph":[{"@id":"_:38d1fb47732ffd24d61cbc3d422845181439c8c9513aab19f89e4ef64a283bdf_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:38d1fb47732ffd24d61cbc3d422845181439c8c9513aab19f89e4ef64a283bdf_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:38d1fb47732ffd24d61cbc3d422845181439c8c9513aab19f89e4ef64a283bdf_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:38d1fb47732ffd24d61cbc3d422845181439c8c9513aab19f89e4ef64a283bdf_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/13/resource/12","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/13/resource/13"},{"@id":"https://catalog.sodertalje.se/store/13/resource/14"},{"@id":"https://catalog.sodertalje.se/store/13/resource/15"}],"dcat:keyword":[{"@language":"en","@value":"Fitness station"},{"@language":"en","@value":"Outdoor gym"},{"@language":"sv","@value":"Gym"},{"@language":"sv","@value":"Naturgym"},{"@language":"sv","@value":"Utegym"},{"@language":"sv","@value":"Utomhusgym"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/utegym/1.0"},"dct:description":[{"@language":"en","@value":"The data set outdoor gym (outdoor gym or fitness station) includes gyms in public places outdoors that are free to use for the public, usually all year round and free of charge. Outdoor gyms often include simpler tools and equipment for strength training and cardio training. The data set contains information about e.g. name, location, contact information and more. There may also be additional information about which tools are available."},{"@language":"sv","@value":"Datamängden utegym (även kallat bland annat utomhusgym eller fitness station / outdoor gym på engelska) omfattar gym på allmän plats utomhus som är fri att användas för allmänheten, oftast året om och kostnadsfritt. Till utegym hör ofta enklare redskap och utrustning för styrketräning och konditionsträning. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka redskap som finns."}],"dct:issued":{"@type":"xsd:date","@value":"2020-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-08"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":{"@id":"http://sws.geonames.org/2676174"},"dct:title":[{"@language":"en","@value":"Outdoor gym"},{"@language":"sv","@value":"Utegym"}],"http://schema.org/diagram":{"@id":"https://catalog.sodertalje.se/store/13/resource/19"}},{"@id":"https://catalog.sodertalje.se/store/13/resource/13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/13/resource/16"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/13/resource/16"},"dct:description":{"@language":"sv","@value":"XLSX-fil med datamängden Utegym i Södertälje kommun. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka redskap som finns."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLSX"},"dct:issued":{"@type":"xsd:date","@value":"2020-06-08"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2023-11-08T09:12:53.342Z"},"dct:title":{"@language":"sv","@value":"Utegym-Södertälje.xlsx"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://catalog.sodertalje.se/store/13/resource/14","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.sodertalje.se/store/13/resource/17"},"dcat:downloadURL":{"@id":"https://catalog.sodertalje.se/store/13/resource/17"},"dct:description":{"@language":"sv","@value":"CSV-fil med datamängden Utegym i Södertälje kommun. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka redskap som finns."},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:issued":{"@type":"xsd:date","@value"