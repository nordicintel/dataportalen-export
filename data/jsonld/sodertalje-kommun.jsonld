{"@language":"en","@value":"flow"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Mälarbron"},{"@language":"sv","@value":"Nygatan"},{"@language":"sv","@value":"ai"},{"@language":"sv","@value":"cykel"},{"@language":"sv","@value":"cykelflöde"},{"@language":"sv","@value":"flödesmätning"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"sensor"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:description":[{"@language":"en","@value":"Södertälje Municipality measures the flow of bicycle traffic over the Mälar Bridge and along Nygatan with IoT AI sensors. The sensors are mounted on the east and west sides of the Mälar Bridge and at the passage bridge over Nygatan and use Artificial Intelligence to detect the number of cyclists moving in each direction. \n\nThe sensors report the data continuously, including information about the number of cyclists who have moved in each direction.\n\nThis data set contains historical data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av cykeltrafik över Mälarbron och längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade på den östra respektive den västra sidan av Mälarbron samt vid passagebron över Nygatan och detekterar med hjälp av Artificiell Intelligens antalet cyklister som rör sig i vardera riktning. \n\nSensorerna rapporterar uppgifterna löpande och då med uppgift om antalet cyklister som rört sig i vardera riktning.\n\nDenna datmängd innehåller historik."}],"dct:issued":{"@type":"xsd:date","@value":"2022-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:333f29af4446e4b62c7fe2f564ef1f97a404d7276b2ea45260bb02ba8aa4413d_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:333f29af4446e4b62c7fe2f564ef1f97a404d7276b2ea45260bb02ba8aa4413d_b3n0"},"dct:title":[{"@language":"en","@value":"Bicycle flow measurements Historical data (IoT)"},{"@language":"sv","@value":"Cykelflödesmätningar Historisk data (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1113"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/getallcyclecnt?start=2026-01-01&end=2026-01-31"},"dct:description":[{"@language":"en","@value":"Södertälje Municipality measures the flow of bicycle traffic over the Mälar Bridge and along Nygatan with IoT AI sensors. The sensors are mounted on the east and west sides of the Mälar Bridge and at the passage bridge over Nygatan and use Artificial Intelligence to detect the number of cyclists moving in each direction. \n\nThe sensors report the data continuously, including information about the number of cyclists who have moved in each direction.\n\nThis data set contains historical data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av cykeltrafik över Mälarbron och längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade på den östra respektive den västra sidan av Mälarbron samt vid passagebron över Nygatan och detekterar med hjälp av Artificiell Intelligens antalet cyklister som rör sig i vardera riktning. \n\nSensorerna rapporterar uppgifterna löpande och då med uppgift om antalet cyklister som rört sig i vardera riktning.\n\nDenna datmängd innehåller historik."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-04-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-22"},"dct:title":[{"@language":"en","@value":"Bicycle flow measurements Mälar bridge historical data (IoT)"},{"@language":"sv","@value":"Cykelflödesmätningar (IoT) i Södertälje - Historiska värden"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1113"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:333f29af4446e4b62c7fe2f564ef1f97a404d7276b2ea45260bb02ba8aa4413d"},{"@graph":[{"@id":"_:336b9295f0766d2a414b2059d5ea07d6b449d702847f5e189be56ca4eeb050cd_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:336b9295f0766d2a414b2059d5ea07d6b449d702847f5e189be56ca4eeb050cd_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:336b9295f0766d2a414b2059d5ea07d6b449d702847f5e189be56ca4eeb050cd_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.35407350331193 59.2934216831579,17.8150241490178 59.2934216831579,17.8150241490178 58.937621408049836,17.35407350331193 58.937621408049836,17.35407350331193 59.2934216831579))"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/165","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w