7e4443c6cb7595372_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/121","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/318"},{"@id":"https://catalog.sodertalje.se/store/15/resource/319"}],"dcat:keyword":[{"@language":"en","@value":"City planning"},{"@language":"en","@value":"Planning"},{"@language":"sv","@value":"Gällande planer"},{"@language":"sv","@value":"Planenhet"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:description":[{"@language":"en","@value":"Data showing current city plans in Södertälje municipality.\nType of plan, plan name, file designation and coordinates in WGS84 format.\nThe data set contains two distributions. GeoJSON and KML.\n\nWith a detailed plan, the municipality regulates how land and water are to be used and what the buildings are to look like. The detailed plan therefore talks about what you and others may and may not do for construction measures within the planning area.\nA detailed plan is displayed as a specific area on a plan map. The detailed plan map includes a plan description, which explains the purpose and content of the plan. Sometimes other documents are also included, such as an illustration map or an environmental impact statement.\n \nhttps://www.boverket.se/sv/samhallsplanering/sa-planeras-sverige/kommunal-planering/detaljplanering/"},{"@language":"sv","@value":"Data som visar gällande planer i Södertälje kommun.\nTyp av plan, plannamn, aktbeteckning samt koordinater i WGS84-format.\nDatamängden innehåller två distributioner. GeoJSON- och KML.\n\nMed en detaljplan reglerar kommunen hur mark och vatten ska användas och hur bebyggelsen ska se ut. Detaljplanen talar därför om vad du och andra får och inte får göra för byggåtgärder inom planområdet.\nEn detaljplan visas som ett bestämt område på en plankarta. Till detaljplanekartan hör en planbeskrivning, som förklarar planens syfte och innehåll. Ibland ingår även andra handlingar, till exempel en illustrationskarta eller en miljökonsekvensbeskrivning.\n \nhttps://www.boverket.se/sv/samhallsplanering/sa-planeras-sverige/kommunal-planering/detaljplanering/"}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:relation":[{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/577/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/586/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/591/"}],"dct:spatial":[{"@id":"_:eec2270608685cd1b56dbca27263d3c336e9d89181d170c7e4443c6cb7595372_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Current city plans"},{"@language":"sv","@value":"Gällande planer"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/318","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/gallande_planer.json"},"dct:description":[{"@language":"en","@value":"GeoJSON with current city planning plans in Södertälje municipality. Type of plan, name, number and coordinates in WGS84."},{"@language":"sv","@value":"GeoJSON med Gällande planer i Södertälje kommun. Typ av plan, plannamn, aktbeteckning samt koordinater i WGS84-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Current city planning plans GeoJSON"},{"@language":"sv","@value":"Gällande planer GeoJSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/319","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/gallande_planer.kml"},"dct:description":[{"@language":"en","@value":"KML-file with current city planning plans in Södertälje municipality. Type of plan, name, number and coordinates in WGS84."},{"@language":"sv","@value":"KML-fil med Gällande planer i Södertälje kommun. Typ av plan, plannamn, aktbeteckning samt koordinater i WGS84-format."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/KML"},"dct:issued":{"@type":"xsd:date","@value":"2025-06-03"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-03"},"dct:title":[{"@language":"en","@value":"Current city planning plans KML"},{"@language":"sv","@value":"Gällande planer KML"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:eec2270608685cd1b56dbca27263d3c336e9d89181d170c7e4443c6cb7595372"},{"@graph":[{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.620301271 59.197769102)"}},{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/280","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation explaining API and dataset"},{"@language":"sv","@value":"Dokumentation som förklarar API och datamängd"}],"dct:title":[{"@language":"en","@value":"Documentation traffic flows Turingekorset Historical data 24H"},{"@language":"sv","@value":"Dokumentation trafikflödesmätningar Turingekorset Historik 24H"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/283","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/284"},{"@id":"https://catalog.sodertalje.se/store/15/resource/326"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"Turingekorset"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1D"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/DAILY"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over Turingekorset intersection with IoT AI sensors. The sensors are mounted in the intersection and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete days.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över Turingekorset med IoT AI-sensorer. Sensorerna sitter monterade i korsningen och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hela dygn.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2024-12-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-06-17"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:f3d72377fa2f899877134e6d36ed7993172d4c934ba4fe025e6236182c43ddfc_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Turingekorset intersection - Historical data 24H (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Turingekorset - Historik 24H (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/280"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/284","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETAllTrafficCountTuringe?start=2024-12-01&end=2