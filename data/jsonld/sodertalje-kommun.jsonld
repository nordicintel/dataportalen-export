424))"}},{"@id":"_:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2022-01-25"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/1113","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation Bicycle flow measurements"},{"@language":"sv","@value":"Dokumentation Cykelflödesmätningar"}],"dct:title":[{"@language":"en","@value":"Documentation Bicycle flow measurements"},{"@language":"sv","@value":"Dokumentation Cykelflödesmätningar"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/55","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/56"},{"@id":"https://catalog.sodertalje.se/store/15/resource/57"}],"dcat:keyword":[{"@language":"en","@value":"Bicycle"},{"@language":"en","@value":"Bike"},{"@language":"en","@value":"flow"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Mälarbron"},{"@language":"sv","@value":"Nygatan"},{"@language":"sv","@value":"ai"},{"@language":"sv","@value":"cykel"},{"@language":"sv","@value":"cykelflöde"},{"@language":"sv","@value":"flödesmätning"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"sensor"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:description":[{"@language":"en","@value":"Södertälje Municipality measures the flow of bicycle traffic over the Mälar Bridge and along Nygatan with IoT AI sensors. The sensors are mounted on the east and west sides of the Mälar Bridge and at the passage bridge over Nygatan and use Artificial Intelligence to detect the number of cyclists moving in each direction. \n\nThe sensors report the data continuously, including information about the number of cyclists who have moved in each direction."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av cykeltrafik över Mälarbron och längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade på den östra respektive den västra sidan av Mälarbron samt vid passagebron över Nygatan och detekterar med hjälp av Artificiell Intelligens antalet cyklister som rör sig i vardera riktning. \n\n\nSensorerna rapporterar uppgifterna löpande och då med uppgift om antalet cyklister som rört sig i vardera riktning."}],"dct:issued":{"@type":"xsd:date","@value":"2022-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f_b3n0"},"dct:title":[{"@language":"en","@value":"Bicycle flow measurements (IoT)"},{"@language":"sv","@value":"Cykelflödesmätningar (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1113"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/56","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/getcyclecnt"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dct:description":[{"@language":"en","@value":"Södertälje Municipality measures the flow of bicycle traffic over the Mälar Bridge and along Nygatan with IoT AI sensors. The sensors are mounted on the east and west sides of the Mälar Bridge and at the passage bridge over Nygatan and use Artificial Intelligence to detect the number of cyclists moving in each direction. \n\nThe sensors report the data continuously, including information about the number of cyclists who have moved in each direction."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av cykeltrafik över Mälarbron och längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade på den östra respektive den västra sidan av Mälarbron samt vid passagebron över Nygatan och detekterar med hjälp av Artificiell Intelligens antalet cyklister som rör sig i vardera riktning. \n\nSensorerna rapporterar uppgifterna löpande och då med uppgift om antalet cyklister som rört sig i vardera riktning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-22"},"dct:title":[{"@language":"en","@value":"Bicycle flows (IoT) in Södertälje"},{"@language":"sv","@value":"Cykelflödesmätningar (IoT) i Södertälje"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1113"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/57","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/BC_count"},"dct:description":[{"@language":"en","@value":"Södertälje Municipality measures the flow of bicycle traffic over the Mälar Bridge and along Nygatan with IoT AI sensors. The sensors are mounted on the east and west sides of the Mälar Bridge and at the passage bridge over Nygatan and use Artificial Intelligence to detect the number of cyclists moving in each direction. \n\nThe sensors report the data continuously, including information about the number of cyclists who have moved in each direction."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av cykeltrafik över Mälarbron och längs Nygatan med IoT AI-sensorer. Sensorerna sitter monterade på den östra respektive den västra sidan av Mälarbron samt vid passagebron över Nygatan och detekterar med hjälp av Artificiell Intelligens antalet cyklister som rör sig i vardera riktning. \n\nSensorerna rapporterar uppgifterna löpande och då med uppgift om antalet cyklister som rört sig i vardera riktning."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2022-01-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-22"},"dct:title":[{"@language":"en","@value":"Bicycle flows (IoT) in Södertälje - Vizualisation"},{"@language":"sv","@value":"Cykelflöden (IoT) i Södertälje - Visualisering"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/1113"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}}],"@id":"urn:source:a5486d3fbf0dd3a2be5e614d4e5255c9dba1cbac73c9c88b266d2337ec875b2f"},{"@graph":[{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.620301271 59.197769102)"}},{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2024-07-01"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/420","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/421"},{"@id":"https://catalog.sodertalje.se/store/15/resource/422"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"Turingekorset"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over Turingekorset intersection with IoT AI sensors. The sensors are mounted in the intersection and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete hour.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över Turingekorset med IoT AI-sensorer. Sensorerna sitter monterade i korsningen och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per hel timme.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:a996c94db77c4dca41ee2646e90f51edb86dd5add62f27d02e6bca6a366774a1_b3n0"},"dct:title":[{"@language":"en","@value":"Traffic flows Turingekorset intersection - Historical data HOUR (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Turingekorset - Historik TIMME (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/423"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/421","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/TC_turinge"},"dct:description":[{"@language":"en","@value":"Visualization Traffic flows Turingekorset"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Turingekorset"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:title":[{"@language":"en","@value":"Visualization Traffic flows Turingekorset"},{"@language":"sv","@value":"Visualisering trafikflödesmätningar Turingekorset"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/422","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/GETAllTrafficCountTuringeHOUR?start=2026-08-01&end=2026-08-31"},"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dct:description":[{"@language":"en","@value":"API containing data from traffic flows at Turingekorset intersection in Södertälje municipality.\nHistorical data"},{"@language":"sv","@value":"API som innehåller data från trafikflödesmätningar vid Turingekorset i Södertälje kommun.\nHistorisk data"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:langua