d/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POINT(17.628877087916205 59.19999619032069)"}},{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b3n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2023-12-09"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/408","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/409"},{"@id":"https://catalog.sodertalje.se/store/15/resource/410"}],"dcat:keyword":[{"@language":"en","@value":"flow"},{"@language":"en","@value":"iot"},{"@language":"en","@value":"traffic"},{"@language":"sv","@value":"Fordon"},{"@language":"sv","@value":"Lastbil"},{"@language":"sv","@value":"Mälarbron"},{"@language":"sv","@value":"Trafik"},{"@language":"sv","@value":"Trafikmätning"},{"@language":"sv","@value":"biltrafik"},{"@language":"sv","@value":"buss"},{"@language":"sv","@value":"iot"},{"@language":"sv","@value":"motorcycle"},{"@language":"sv","@value":"motorcykel"},{"@language":"sv","@value":"transport"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"PT1H"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/TRAN"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"The municipality of Södertälje measures the flow of cars, trucks, buses and motorcycles over the Mälar bridge with IoT AI sensors. The sensors are mounted on the eastern side of the bridge and use Artificial Intelligence to detect the number of cars, trucks, buses and motorcycles moving in each direction.\n\nThe sensors report the data once every five minutes.\n\nThe sensors communicate over the municipality's IoT network using LoRaWAN technology. The sensors cannot save or send any image or video.\n\nThis data set contains historical data per complete hour.\n\nView documentation for description of data."},{"@language":"sv","@value":"Södertälje kommun mäter flödet av bilar, lastbilar, bussar och motorcyklar över Mälarbron med IoT AI-sensorer. Sensorerna sitter monterade på den östra sidan av bron och detekterar med hjälp av Artificiell Intelligens antalet bilar, lastbilar, bussar och motorcyklar som rör sig i vardera riktning.\n\nSensorerna rapporterar uppgifterna en gång var femte minut.\n\nSensorerna kommunicerar över kommunens IoT-nätverk med tekniken LoRaWAN. Sensorerna kan inte spara eller skicka någon bild eller video.\n\nDenna datamängd innehåller historisk data sammanställd per timme.\n\nSe dokumentation för beskrivning av data."}],"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b2n0"},{"@id":"http://sws.geonames.org/2676176"}],"dct:temporal":{"@id":"_:9fc3bebc04a14fa9aa704d56e398e8c054054e578035f1382bcdbb953ef59646_b3n0"},"dct:title":[{"@language":"en","@value":"Kopia av Traffic flows Mälar bridge - Historical data HOUR (IoT)"},{"@language":"sv","@value":"Trafikflödesmätningar Mälarbron - Historik TIMME (IoT)"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/411"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/409","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/dashboard/TC_malarbron"},"dct:description":[{"@language":"en","@value":"Visualization Traffic flows Mälar bridge"},{"@language":"sv","@value":"Visualisering trafikflöden Mälarbron"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2026-08-31"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-31"},"dct:title":[{"@la