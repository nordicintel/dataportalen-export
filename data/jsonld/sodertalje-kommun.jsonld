to:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:ed1a0c0c8b54325e2897032c6b43c37b266fc11e949a6f360b164d411af38e70_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/336","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/341"},{"@id":"https://catalog.sodertalje.se/store/15/resource/342"}],"dcat:keyword":[{"@language":"en","@value":"City planning"},{"@language":"en","@value":"Ongoing structural city plans"},{"@language":"sv","@value":"Planarbete"},{"@language":"sv","@value":"Planenheten"},{"@language":"sv","@value":"Pågående strukturplaner"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"Data showing Ongoing structural city plans in Södertälje municipality.\nName of structure plan and coordinates in WGS84 format\n\nStructural plans show the area's context of streets, greenery, urban space, buildings and its connection to the surroundings. This is presented through descriptive text, maps, diagrams, sections, illustrations and inspirational reference images. A structural plan can be seen as a visionary document that should highlight a district's potential to develop.\nUnlike a detailed plan, the structural plan does not report the exact location for land use and construction. In this way, the structural plan can be said to be at a level between the general plan and the detailed plan."},{"@language":"sv","@value":"Data som visar Pågående strukturplaner i Södertälje kommun.\nNamn på strukturplan samt koordinater i WGS84-format\n\nStrukturplaner visar områdets sammanhang av gator, grönska, stadsrum, bebyggelse samt dess koppling till omgivningen. Detta presenteras genom beskrivande text, kartor, diagram, sektioner, illustrationer och inspirerande referensbilder. En strukturplan kan ses som ett visionärt dokument som ska framhäva en stadsdels potential att utvecklas.\nTill skillnad från en detaljplan redovisar inte strukturplanen den exakta lokaliseringen för markanvändning och byggande. På så sätt kan strukturplanen sägas ligga på en nivå mellan översiktsplan och detaljplan."}],"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:relation":[{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/568/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/577/"},{"@id":"https://catalog.sodertalje.se/catalog/1/datasets/586/"}],"dct:spatial":[{"@id":"_:ed1a0c0c8b54325e2897032c6b43c37b266fc11e949a6f360b164d411af38e70_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Ongoing structural city plans"},{"@language":"sv","@value":"Pågående strukturplaner"}]},{"@id":"https://catalog.sodertalje.se/store/15/resource/341","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_strukturplaner.kml"},"dct:description":[{"@language":"en","@value":"KML-file containing Ongoing structural city plans in Södertälje municipality. Name of plan and coordinates in WGS84-format"},{"@language":"sv","@value":"KML-fil som visar Pågående strukturplaner i Södertälje kommun.\nNamn på strukturplan samt koordinater i WGS84-format"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/KML"},"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:title":[{"@language":"en","@value":"Ongoing structural city plans KML"},{"@language":"sv","@value":"Pågående strukturplaner KML"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/342","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/pagaende_strukturplaner.json"},"dct:description":[{"@language":"en","@value":"GeoJSON-file containing Ongoing structural city plans in Södertälje municipality. Name of plan and coordinates in WGS84-format"},{"@language":"sv","@value":"GeoJSON-fil som visar Pågående strukturplaner i Södertälje kommun.\nNamn på strukturplan samt koordinater i WGS84-format"}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2020-04-29"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-27"},"dct:title":[{"@language":"en","@value":"Ongoing structural city plans GeoJSON"},{"@language":"sv","@value":"Pågående strukturplaner GeoJSON"}],"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETE