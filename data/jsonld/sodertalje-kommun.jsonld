6a87247c2924de7ea83a1f9a524e4dc336d00b3656b1b1_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/271","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:name":{"@language":"sv","@value":"Samhällsbyggnadskontoret"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/363","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/368"},{"@id":"https://catalog.sodertalje.se/store/15/resource/369"}],"dcat:keyword":[{"@language":"en","@value":"Border"},{"@language":"en","@value":"Municipality border"},{"@language":"sv","@value":"Gräns"},{"@language":"sv","@value":"Kommungräns"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:creator":{"@id":"https://catalog.sodertalje.se/store/15/resource/271"},"dct:description":[{"@language":"en","@value":"Data containing the municipal border in Södertälje municipality.\nTwo different file formats, GeoJSON and .KML\nNote that in addition to the main municipal border, there are some small areas belonging to Södertälje municipality that are surrounded by Nykvarn municipality. These are listed as separate areas in the same files."},{"@language":"sv","@value":"Data som innehåller kommungränsen i Södertälje kommun.\nTvå olika filformat, GeoJSON samt .KML\nNotera att det utöver den huvudsakliga kommungränsen finns några små områden tillhörande Södertälje kommun som omgärdas av Nykvarns kommun. Dessa anges som egna områden i samma filer."}],"dct:issued":{"@type":"xsd:date","@value":"2020-11-25"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@v