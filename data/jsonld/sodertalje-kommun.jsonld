0fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:861aa2189fa55290fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519_b2n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.548228798121254 59.216469615867624,17.70657969635354 59.216469615867624,17.70657969635354 59.16535235891652,17.548228798121254 59.16535235891652,17.548228798121254 59.216469615867624))"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/12/resource/196","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Södertälje digitaliseringsenheten","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:861aa2189fa55290fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519_b0n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:digitalisering@sodertalje.se"},"http://www.w3.org/2006/vcard/ns#hasTelephone":{"@id":"_:861aa2189fa55290fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519_b1n0"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/10","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/12/resource/196"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/15/resource/11"},{"@id":"https://catalog.sodertalje.se/store/15/resource/12"}],"dcat:keyword":[{"@language":"en","@value":"bathing lake"},{"@language":"en","@value":"bathing sites"},{"@language":"en","@value":"bathing water"},{"@language":"en","@value":"beaches"},{"@language":"en","@value":"temperature"},{"@language":"en","@value":"water temperature"},{"@language":"sv","@value":"Internet of things"},{"@language":"sv","@value":"IoT"},{"@language":"sv","@value":"Sakernas internet"},{"@language":"sv","@value":"Sensor"},{"@language":"sv","@value":"bad"},{"@language":"sv","@value":"badplats"},{"@language":"sv","@value":"badsjö"},{"@language":"sv","@value":"badvatten"},{"@language":"sv","@value":"lake"},{"@language":"sv","@value":"sjö"},{"@language":"sv","@value":"temperatur"},{"@language":"sv","@value":"vattentemperatur"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/CONT"},"dct:description":[{"@language":"en","@value":"Data temperature sensors (IoT) public beaches, shows temperature measurements in Södertälje municipality's bathing lakes.\n\nThere are sensors in the bathing lakes that measure water temperature every day, which is then reported further through a LoRaWAN network to a database that can be accessed through this amount of data.\n\nThe sensors are mounted at a depth of about one meter.\n\nIf the API returns NO DATA it is because the sensors are either taken inside for the season or temporarily out of order."},{"@language":"sv","@value":"Datamängden Data temperatursensorer (IoT) badplatser visar temperaturmätningar i Södertälje kommuns badsjöar.\n\nDet sitter sensorer i badsjöarna som mäter vattentemperatur varje dag vilket sedan rapporteras vidare genom ett LoRaWAN-nät till en databas som det går att nå genom denna datamängd.\n\nSensorerna sitter monterade på ca en meters djup.\n\nOm APIet ger tillbaka NO DATA så beror det på att alla sensorerna är antingen inplockade på säsongen eller tillfälligt ur funktion."}],"dct:issued":{"@type":"xsd:date","@value":"2021-04-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-11"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:861aa2189fa55290fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519_b2n0"},{"@id":"http://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Data temperature sensors (IoT) public beaches"},{"@language":"sv","@value":"Data temperatursensorer (IoT) badplatser"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/862"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/11","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://api.sodertalje.se/getwatertemp"},"dct:description":[{"@language":"en","@value":"The dataset Data temperature sensors (IoT) bathing places shows temperature measurements in Södertälje municipality's bathing lakes. There are sensors in the bathing lakes that measure water temperature every hour, which is then reported further through a LoRaWAN network to a database that can be reached through this dataset. The sensors are mounted at a depth of about one meter.\n\nThe distribution shows the most recently recorded value.\n\nIf the API returns NO DATA it is because the sensors are either taken inside for the season or temporarily out of order."},{"@language":"sv","@value":"Datamängden Data temperatursensorer (IoT) badplatser visar temperaturmätningar i Södertälje kommuns badsjöar. Det sitter sensorer i badsjöarna som mäter vattentemperatur varje timme vilket sedan rapporteras vidare genom ett LoRaWAN-nät till en databas som det går att nå genom denna datamängd. Sensorerna sitter monterade på ca en meters djup.\n\nDistributionen visar senast registrerade värde.\n\n\nOm APIet ger tillbaka NO DATA så beror det på att alla sensorerna är antingen inplockade på säsongen eller tillfälligt ur funktion."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2021-04-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/ENG"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-11-09"},"dct:title":[{"@language":"en","@value":"Data temperature sensors (IoT) public beaches - last recorded value"},{"@language":"sv","@value":"Data temperatursensorer (IoT) badplatser - senast registrerat värde"}],"foaf:page":{"@id":"https://catalog.sodertalje.se/store/15/resource/862"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/12","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://www.sodertalje.se/kommun-och-politik/for-medborgare/digitala.sodertalje/datavisualisering/badtemperatur"},"dct:description":{"@language":"sv","@value":"En grafisk visualisering av vattentemperaturen i kommunens badplatser"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/HTML"},"dct:issued":{"@type":"xsd:date","@value":"2021-04-07"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:modified":{"@type":"xsd:date","@value":"2021-11-09"},"dct:title":{"@language":"sv","@value":"Visualisering temperatur badplatser"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/COMPLETED"}},{"@id":"https://catalog.sodertalje.se/store/15/resource/862","@type":"foaf:Document","dct:description":[{"@language":"en","@value":"Documentation data temperature (IoT) public beaches"},{"@language":"sv","@value":"Dokumentation data temperatursensorer (IoT) badplatser"}],"dct:title":[{"@language":"en","@value":"Documentation data temperature (IoT) public beaches"},{"@language":"sv","@value":"Dokumentation data temperatursensorer (IoT) badplatser"}]}],"@id":"urn:source:861aa2189fa55290fed1d879fd2e6d3278054f574384e62e0f9eafaa166f0519"},{"@graph":[{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b0n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"151 89","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b3n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b4n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((17.3911214889993 59.304629738834024,17.764458346462153 59.304629738834024,17.764458346462153 58.94290283993632,17.3911214889993 58.94290283993632,17.3911214889993 59.304629738834024))"}},{"@id":"_:878267a68f554c1820d99d9aa3bf9327621a4d9306f18508686217264ea57b79_b5n0","@type":"dct:PeriodOfTime","dcat:endD