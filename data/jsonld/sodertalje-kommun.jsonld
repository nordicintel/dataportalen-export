ty":"Södertälje","http://www.w3.org/2006/vcard/ns#postal-code":"15189","http://www.w3.org/2006/vcard/ns#street-address":"Nyköpingsvägen 26"},{"@id":"_:37973e07d47ca0616afa14623415124612ab148b919411cce32007f301faa874_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Voice","http://www.w3.org/2006/vcard/ns#hasValue":{"@id":"tel:+46852301000"}},{"@id":"http://dataportal.se/organisation/SE2120000159","@type":"foaf:Agent","dct:identifier":"2120000159","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:digitalisering@sodertalje.se"},"foaf:name":{"@language":"sv","@value":"Södertälje kommun"},"foaf:page":{"@id":"https://www.sodertalje.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.sodertalje.se/store/9/resource/1"}},{"@id":"https://catalog.sodertalje.se/store/14/resource/102","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://catalog.sodertalje.se/store/14/resource/87"},"dcat:distribution":[{"@id":"https://catalog.sodertalje.se/store/14/resource/105"},{"@id":"https://catalog.sodertalje.se/store/14/resource/106"}],"dcat:keyword":[{"@language":"en","@value":"Bath"},{"@language":"en","@value":"Beach"},{"@language":"sv","@value":"Bad"},{"@language":"sv","@value":"Badplats"},{"@language":"sv","@value":"Naturbad"},{"@language":"sv","@value":"Strand"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"The nature baths dataset includes outdoor public baths that are free to use for the public, usually all year round and free of charge. Some of the nature baths are located within the municipality's nature reserve. A few of the baths also have access to toilets and other functionality for a good experience. The dataset includes information such as name, location, contact information, and more. There may also be additional information about the characteristics of the nature bath. For example, barbecue area, picnic table."},{"@language":"sv","@value":"Datamängden naturbad omfattar naturbad på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Några av naturbaden finns belägna inom kommunens naturreservat. Något enstaka av baden har även tillgång till toalett och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid naturbadet. Exempelvis grillplats, fikabord."}],"dct:issued":{"@type":"xsd:date","@value":"2024-02-23"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-22"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120000159"},"dct:spatial":[{"@id":"_:37973e07d47ca0616afa14623415124612ab148b919411cce32007f301faa874_b0n0"},{"@id":"https://sws.geonames.org/2676174"}],"dct:title":[{"@language":"en","@value":"Nature baths"},{"@language":"sv","@value":"Naturbad"}]},{"@id":"https://catalog.sodertalje.se/store/14/resource/105","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static-content.sodertalje.se/opendata/naturbad.json"},"dct:description":[{"@language":"en","@value":"GeoJSON-file containing Södertälje municipalitys nature baths and properties of them"},{"@language":"sv","@value":"CSV-fil som visar var Södertälje kommuns olika naturbad finns samt egenskaper för dessa."}],"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:issued":{"@type":"xsd:date","@value":"2024-02-23"},"dct:language":{"@id":"