/store/2/resource/166"},{"@id":"https://catalog.harryda.se/store/2/resource/206"}],"dcat:keyword":[{"@language":"sv","@value":"Hike"},{"@language":"sv","@value":"Hiking"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Promenad"},{"@language":"sv","@value":"Vandring"},{"@language":"sv","@value":"Vandringsled"},{"@language":"sv","@value":"Walking"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"en","@value":"Hiking trails in Härryda municipality. The dataset consists of two different files, a JSON and a CSV file.\n\nSome of the hiking trails appear multiple times in the material. This is because certain trails are divided into several sections, and sometimes there are multiple alternative routes or connecting trails, for example from a nearby town to the main route of the trail."},{"@language":"sv","@value":"Vandringsleder i Härryda kommun. Datamängden består av två olika filer, en json och en CSV-fil \n\nNågra av vandringslederna kommer upp flera gånger i materialet. Detta är med anledning av att vissa vandringsleder är uppdelade i flera delsträckor och att det ibland finns flera alternativa sträckningar eller anslutningssträckor exempelvis från en närliggande tätort till ledens huvudsträckning."}],"dct:issued":{"@type":"xsd:date","@value":"2026-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001264"},"dct:spatial":{"@id":"_:897461ebb0ca9234850deeb316db56438da38cbd4371640f3794ca4ccffa7d40_b0n0"},"dct:temporal":{"@id":"_:897461ebb0ca9234850deeb316db56438da38cbd4371640f3794ca4ccffa7d40_b1n0"},"dct:title":[{"@language":"en","@value":"Walking trails"},{"@language":"sv","@val