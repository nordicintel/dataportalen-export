","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((12.080256583888275 57.70183344188729,12.5349718913188 57.70183344188729,12.5349718913188 57.60842135942028,12.080256583888275 57.60842135942028,12.080256583888275 57.70183344188729))"}},{"@id":"_:fdd1c724b6231bb9668d84542e9b8fb31f21a54995c56d01e3c20dc5cbe5f714_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2026-05-04"}},{"@id":"http://dataportal.se/organisation/SE2120001264","@type":"foaf:Agent","dct:identifier":"2120001264","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:susann.almstrom@harryda.se"},"foaf:name":{"@language":"sv","@value":"Härryda kommun"},"foaf:page":{"@id":"https://www.harryda.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.harryda.se/store/2/resource/9"}},{"@id":"https://catalog.harryda.se/store/2/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Björn Pihlquist","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:bjorn.pihlquist@harryda.se"}},{"@id":"https://catalog.harryda.se/store/2/resource/167","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.harryda.se/store/2/resource/12"},"dcat:distribution":[{"@id":"https://catalog.harryda.se/store/2/resource/171"},{"@id":"https://catalog.harryda.se/store/2/resource/173"},{"@id":"https://catalog.harryda.se/store/2/resource/214"}],"dcat:keyword":[{"@language":"sv","@value":"Hike"},{"@language":"sv","@value":"Hiking"},{"@language":"sv","@value":"Natur"},{"@language":"sv","@value":"Promenad"},{"@language":"sv","@value":"Vandring"},{"@language":"sv","@value":"Vandringsled"},{"@language":"sv","@value":"Walking"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/BIENNIAL"},"dct:description":[{"@language":"en","@value":"Trails in Härryda municipality. The dataset consists of two different files, a JSON and a CSV file.\n\nSome of the trails appear multiple times in the material. This is because certain trails are divided into several sections, and sometimes there are multiple alternative routes or connecting trails, for example from a nearby town to the main route of the trail."},{"@language":"sv","@value":"Stigar i Härryda kommun. Datamängden består av två olika filer, en json och en CSV-fil \n\nNågra av stigarna kommer upp flera gånger i materialet. Detta är med anledning av att vissa stigar är uppdelade i flera delsträckor och att det ibland finns flera alternativa sträckningar eller anslutningssträckor exempelvis från en närliggande tätort till ledens huvudsträckning."}],"dct:issued":{"@type":"xsd:date","@value":"2026-05-04"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001264"},"dct:spatial":{"@id":"_:fdd1c724b6231bb9668d84542e9b8fb31f21a54995c56d01e3c20dc5cbe5f714_b0n0"},"dct:temporal":{"@id":"_:fdd1c724b6231bb9668d84542e9b8fb31f21a54995c56d01e3c20dc5cbe5f714_b1n0"},"dct:title":[{"@language":"en","@value":"Trails"},{"@language":"sv","@value":"Stigar"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/108"}},{"@id":"https://catalog.harryda.se/store/2/resource/170","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"stigar.csv"},{"@id":"https://catalog.harryda.se/store/2/resource/171","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.harryda.se/store/2/resource/170"},"dcat:downloadURL":{"@id":"https://catalog.harryda.se/store/2/resource/170"},"dct:description":{"@language":"en","@value":"Trails"},"dct:format":{"@id":"http://publica