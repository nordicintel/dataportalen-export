rg/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"11820","http://www.w3.org/2006/vcard/ns#street-address":"Söder Mälarstrand 21"},{"@id":"http://dataportal.se/organisation/SE2120001264","@type":"foaf:Agent","dct:identifier":"2120001264","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:susann.almstrom@harryda.se"},"foaf:name":{"@language":"sv","@value":"Härryda kommun"},"foaf:page":{"@id":"https://www.harryda.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.harryda.se/store/2/resource/9"}},{"@id":"https://catalog.harryda.se/store/2/resource/77","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.harryda.se/store/2/resource/82"},"dcat:distribution":[{"@id":"https://catalog.harryda.se/store/2/resource/91"},{"@id":"https://catalog.harryda.se/store/2/resource/93"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:issued":{"@type":"xsd:date","@value":"2024-10-30"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001264"},"dct:title":[{"@language":"en","@value":"Public spending"},{"@language":"sv","@value":"Leverantörsreskontra 2022"}],"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.harryda.se/store/2/resource/82","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Karin Höglund","http://www.w3.org/2006/vcard/ns#hasEmail":[{"@id":"mailto:Karin.g.Hoglund@harryda.se"},{"@id":"mailto:karin.g.hoglund@harryda,se"}]},{"@id":"https://catalog.harryda.se/store/2/resource/90","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Bearbetad fil HK 220101-221231 CSV.csv"},{"@id":"https://catalog.harryda.se/store/2/resource/91","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.harryda.se/store/2/resource/90"},"dcat:downloadURL":{"@id":"https://catalog.harryda.se/store/2/resource/90"},"dct:description":{"@language":"sv","@value":"Januari - December 2022"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:title":{"@language":"sv","@value":"Januari - December 2022"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.harryda.se/store/2/resource/93","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.harryda.se/rowstore/dataset/1c2f0216-50da-4938-b51b-cbdf3a9128be"},"dct:conformsTo":{"@id":"https://catalog.harryda.se/rowstore/dataset/1c2f0216-50d