://catalog.harryda.se/store/2/resource/177","@type":"http://entryscape.com/terms/File","dct:title":"Motionsspår.json"},{"@id":"https://catalog.harryda.se/store/2/resource/178","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.harryda.se/store/2/resource/177"},"dcat:downloadURL":{"@id":"https://catalog.harryda.se/store/2/resource/177"},"dct:description":{"@language":"sv","@value":"Motionsspår"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:title":{"@language":"sv","@value":"Motionsspår"}},{"@id":"https://catalog.harryda.se/store/2/resource/216","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.harryda.se/rowstore/dataset/ca50eb76-8dcf-4a04-b445-4fb2594a3cbe"},"dct:conformsTo":{"@id":"https://catalog.harryda.se/rowstore/dataset/ca50eb76-8dcf-4a04-b445-4fb2594a3cbe/swagger"},"dct:description":{"@language":"sv","@value":"API"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://catalog.harryda.se/store/2/resource/176"},"dct:title":{"@language":"sv","@value":"Motionsspår"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.harryda.se/rowstore/dataset/ca50eb76-8dcf-4a04-b445-4fb2594a3cbe/swagger"}}],"@id":"urn:source:e6fa48f86674fa898cfe7aaa7c318041b9bf6cc1655249f26a47c5eb06e0a417"},{"@graph":[{"@id":"_:f11e0c87643d28cd31b188ef8096cbc40b464fb1d4ef3788d0306f0f2cfba64f_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((11.99770403955466 57.70353165108364,12.448103083119447 57.70353165108364,12.448103083119447 57.60808436434243,11.99770403955466 57.60808436434243,11.99770403955466 57.70353165108364))"}},{"@id":"_:f11e0c87643d28cd31b188ef8096cbc40b464fb1d4ef3788d0306f0f2cfba64f_b1n0","@type":"dct:PeriodOfTime","dcat:startDate":{"@type":"xsd:date","@value":"2026-05-04"}},{"@id":"http://dataportal.se/organisation/SE2120001264","@type":"foaf:Agent","dct:identifier":"2120001264","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:mbox":{"@id":"mailto:susann.almstrom@harryda.se"},"foaf:name":{"@language":"sv","@value":"Härryda kommun"},"foaf:page":{"@id":"https://www.harryda.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://catalog.harryda.se/store/2/resource/9"}},{"@id":"https://catalog.harryda.se/store/2/resource/10","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://catalog.harryda.se/store/2/resource/12"},"dcat:distribution":[{"@id":"https://catalog.harryda.se/store/2/resource/107"},{"@id":"https://catalog.harryda.se/store/2/resource/86"}],"dcat:keyword":[{"@language":"en","@value":"barbecue area"},{"@language":"en","@value":"fireplace"},{"@language":"sv","@value":"eldplats"},{"@language":"sv","@value":"grillplats"},{"@language":"sv","@value":"vindskydd"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":[{"@language":"en","@value":"The dataset includes barbecue areas in public places outdoors that are free to use for the public, usually all year round and free of charge. At the barbecue area there is often benches, wind guard and other equipment for a pleasant experience. The dataset contains information about e.g. name, location, contact information and more. There may also be additional information about which characteristics that are available at the barbecue area. Water for putting out the fire or something else."},{"@language":"sv","@value":"Datamängden grillplatser (barbecue areas på engelska) omfattar grillplatser på allmän plats utomhus som är fria att användas för allmänheten, oftast året om och kostnadsfritt. Vid grillplatserna finns oftast bänkar, vindskydd och annan funktionalitet för en bra upplevelse. Datamängden innehåller information om t.ex. namn, plats, kontaktinformation med mera. Det kan även finnas kompletterande information om vilka egenskaper som finns vid grillplatsen. Exempelvis vatten för att släcka en eld."}],"dct:issued":{"@type":"xsd:date","@value":"2026-05-04"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001264"},"dct:spatial":[{"@id":"_:f11e0c87643d28cd31b188ef8096cbc40b464fb1d4ef3788d0306f0f2cfba64f_b0n0"},{"@id":"https://sws.geonames.org/2707608"}],"dct:temporal":{"@id":"_:f11e0c87643d28cd31b188ef8096cbc40b464fb1d4ef3788d0306f0f2cfba64f_b1n0"},"dct:title":[{"@language":"en","@value":"Barbecue areas"},{"@language":"sv","@value":"Grillplatser"}]},{"@id":"https://catalog.harryda.se/store/2/resource/107","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.harryda.se/rowstore/dataset/86fd5d64-9403-4908-b423-a236a84da8b5"},"dct:conformsTo":{"@id":"https://catalog.harryda.se/rowstore/dataset/86fd5d64-9403-4908-b423-a236a84da8b5/swagger"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-06T06:59:54.048Z"},"dct:source":{"@id":"https://catalog.harryda.se/store/2/resource/86"},"dct:title":{"@language":"sv","@value":"Grillplatser"},"foaf:page":{"@id":"https://swagger.entryscape.com/?url=https://catalog.harryda.se/rowstore/dataset/86fd5d64-9403-4908-b423-a236a84da8b5/swagger"}},{"@id":"https://catalog.harryda.se/store/2/resource/12","@type":"http://www.w3.org/2006/vcard/ns#Individual","http://www.w3.org/2006/vcard/ns#fn":"Björn Pihlquist","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:bjorn.pihlquist@harryda.se"}},{"@id":"https://catalog.harryda.se/store/2/resource/85","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Grillplatser_Har