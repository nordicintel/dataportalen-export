atalog.harryda.se/store/2/resource/149"},{"@id":"https://catalog.harryda.se/store/2/resource/151"},{"@id":"https://catalog.harryda.se/store/2/resource/153"},{"@id":"https://catalog.harryda.se/store/2/resource/155"},{"@id":"https://catalog.harryda.se/store/2/resource/157"},{"@id":"https://catalog.harryda.se/store/2/resource/159"},{"@id":"https://catalog.harryda.se/store/2/resource/161"},{"@id":"https://catalog.harryda.se/store/2/resource/251"},{"@id":"https://catalog.harryda.se/store/2/resource/253"},{"@id":"https://catalog.harryda.se/store/2/resource/257"},{"@id":"https://catalog.harryda.se/store/2/resource/259"},{"@id":"https://catalog.harryda.se/store/2/resource/261"},{"@id":"https://catalog.harryda.se/store/2/resource/263"},{"@id":"https://catalog.harryda.se/store/2/resource/265"},{"@id":"https://catalog.harryda.se/store/2/resource/267"},{"@id":"https://catalog.harryda.se/store/2/resource/269"},{"@id":"https://catalog.harryda.se/store/2/resource/271"},{"@id":"https://catalog.harryda.se/store/2/resource/274"},{"@id":"https://catalog.harryda.se/store/2/resource/276"}],"dcat:keyword":[{"@language":"en","@value":"accounts receivable"},{"@language":"en","@value":"invoices"},{"@language":"en","@value":"openspending"},{"@language":"en","@value":"payments"},{"@language":"en","@value":"procured services"},{"@language":"en","@value":"spending"},{"@language":"sv","@value":"Ekonomi"},{"@language":"sv","@value":"Faktura"},{"@language":"sv","@value":"Fakturor"},{"@language":"sv","@value":"Inköp"},{"@language":"sv","@value":"Leverantörsreskontra"},{"@language":"sv","@value":"Reskontra"},{"@language":"sv","@value":"Upphandling"},{"@language":"sv","@value":"Utgift"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/MONTHLY"},"dct:conformsTo":{"@id":"https://dataportal.se/specifications/leverantorsreskontra/latest"},"dct:description":[{"@language":"en","@value":"The data set of accounts receivable contains information about purchases made, supplier names, purchasing organization, voucher numbers and more. The voucher number is a unique identifier that can be used if you wish to see the invoice to which the purchase relates.\n\nIn some cases, it contains [Contains personal data]. This means that the supplier is a sole proprietor and that the company's name and organization number are covered by the provisions of the general data protection regulation. When it says [May contain personal data], it means that it has not been possible to determine automatically whether the supplier is a sole proprietor or not; this may, for example, be foreign suppliers or compensation for expenses paid by employees.\n\nWhen it says [Can be covered by confidentiality], it means that any information regarding the purchase can be covered by confidentiality and that a more thorough examination must be made.\n\nTo take part in the underlying invoices, use X municipality's e-service: https://service.organizationX.se/bestall-fakturabild and enter the voucher number for the invoice or invoices you are interested in.\n\nA description of the specification on which the data set is based is available via dataportal.se - see the field Fulfils for link."},{"@language":"sv","@value":"I datamängden leverantörsreskontra finns information om gjorda inköp, leverantörsnamn, inköpande organisation, verifikationsnummer med mera. Verifikationsnumret är en unik identifierare som kan användas ifall man önskar ta del av den faktura som inköpet avser. \n\nI vissa fall anges [Innehåller personuppgifter]. Det betyder att leverantören är en enskild företagare och att företagets namn och organisationsnummer omfattas av bestämmelserna i den allmänna dataskyddsförordningen. När det står [Kan innehålla personuppgifter] betyder det att det inte har gått att avgöra på automatisk väg ifall leverantören är en enskild företagare eller inte; det kan exempelvis handla om utländska leverantörer eller ersättningar för utlägg som betalats av anställda."}],"dct:issued":{"@type":"xsd:date","@value":"2025-01-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001264"},"dct:temporal":{"@id":"_:11f4f91005d0b00937d7d5f248602fc60e2dfc54307ea471b4595bdf59a366e2_b0n0"},"dct:title":{"@language":"sv","@value":"Leverantörsreskontra 2025"},"http://entryscape.com/terms/basedOn":{"@id":"https://assets.entryscape.com/store/13/resource/77"}},{"@id":"https://catalog.harryda.se/store/2/resource/138","@type":"http://entryscape.com/terms/File","dct:format":"text/csv","dct:title":"Bearbetad fil HK 250101-250131 CSV.csv"},{"@id":"https://catalog.harryda.se/store/2/resource/139","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://catalog.harryda.se/store/2/resource/138"},"dcat:downloadURL":{"@id":"https://catalog.harryda.se/store/2/resource/138"},"dct:description":{"@language":"sv","@value":"Januari"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/CSV"},"dct:title":{"@language":"sv","@value":"Januari"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://catalog.harryda.se/store/2/resource/141","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessURL":{"@id":"https://catalog.harryda.se/rowstore/dataset/a1bd1d1e-602b-4ad4-9def-5bb522ae5261"},"dct:conformsTo":{"@id":"https://catalog.harryda.se/rowstore/dataset/a1bd1d1e-602b-4ad4-9def-5bb522ae5261/swagger"},"dct:description":{"@language":"sv","@value":"Januari"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:source":{"@id":"https://catalog.harryda.se/sto