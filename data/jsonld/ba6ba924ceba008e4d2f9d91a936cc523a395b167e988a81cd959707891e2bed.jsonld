tle":{"@language":"sv","@value":"Länk till lagret som visningstjänst (WMS)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"https://datakatalog.karlstad.se/store/11/resource/8","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gi.karlstad.se/geoserver/oppnadata/ows?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:description":{"@language":"sv","@value":"Koordinatsystem: SWEREF99TM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:title":{"@language":"sv","@value":"Länk till lagret som WFS"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}}],"@id":"urn:source:b2d0b4c58e1e8c670831846bd975ec5928d59677373182055e99f358a24b6f18"},{"@graph":[{"@id":"_:c8a0e4e253072c87e3f92d3f97f457ab1809d81bc9dea28e762d48d1adea005a_b0n0","@type":"dct:PeriodOfTime","dcat:endDate":{"@type":"xsd:date","@value":"2024-12-31"},"dcat:startDate":{"@type":"xsd:date","@value":"2020-12-31"}},{"@id":"http://dataportal.se/organisation/SE2120001850","@type":"foaf:Agent","dct:identifier":"2120001850","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://karlstad.se/"},"foaf:mbox":{"@id":"mailto:kartservice@karlstad.se"},"foaf:name":{"@language":"sv","@value":"Karlstads Kommun"},"foaf:page":{"@id":"https://www.karlstad.se"},"http://www.w3.org/2002/07/owl#sameAs":{"@id":"https://datakatalog.karlstad.se/store/1/resource/1"}},{"@id":"https://datakatalog.karlstad.se/store/7/resource/12","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.karlstad.se/store/7/resource/5"},"dcat:distribution":{"@id":"https://datakatalog.karlstad.se/store/7/resource/21"},"dcat:keyword":[{"@language":"sv","@value":"Indikatorer"},{"@language":"sv","@value":"Mål"},{"@language":"sv","@value":"Måluppfyllelse"}],"dcat:temporalResolution":{"@type":"xsd:duration","@value":"P1Y"},"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL_2"},"dct:creator":{"@id":"http://dataportal.se/organisation/SE2120001850"},"dct:description":{"@language":"sv","@value":"Karlstads kommun har tio övergripande mål som förvaltningar och bolag gemensamt ska arbeta för att uppnå. Målen är därmed en viktig länk för samverkan och utgångspunkten för gemensam utveckling. De övergripande målen beslutas av kommunfullmäktige, och följs upp varje år i samband med delårsrapport och årsredovisning. Som stöd för att följa om utvecklingen går i riktning mot målen följs och analyseras statistik i form av olika indikatorer.\n\nDen här datamängden innehåller kommunens indikatorer och mått. \nStatistiken sammanställs av Karlstads kommun men kommer från olika källor.  Källorna anges i filen.  \n\nEtt streck (–) i tabellen innebär att uppgift saknas och två prickar (..) innebär att värdet ännu inte har publicerats hos källan."},"dct:issued":{"@type":"xsd:date","@value":"2025-03-01"},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001850"},"dct:spatial":{"@id":"https://sws.geonames.org/2701679"},"dct:temporal":{"@id":"_:c8a0e4e253072c87e3f92d3f97f457ab1809d81bc9dea28e762d48d1adea005a_b0n0"},"dct:title":{"@language":"sv","@value":"Indikatorer för övergripande mål i Karlstads kommun"}},{"@id":"https://datakatalog.karlstad.se/store/7/resource/20","@type":"http://entryscape.com/terms/File","dct:title":"Indikatorer 2024.xlsx"},{"@id":"https://datakatalog.karlstad.se/store/7/resource/21","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://datakatalog.karlstad.se/store/7/resource/20"},"dcat:downloadURL":{"@id":"https://datakatalog.karlstad.se/store/7/resource/20"},"dct:description":{"@language":"sv","@value":"Innehåller uppdaterade värden per 202503"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/XLS"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Indikatorer i Karlstads kommun uppdaterad Q1 2025"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"},"http://www.w3.org/ns/adms#status":{"@id":"http://publications.europa.eu/resource/authority/distribution-status/DEVELOP"}},{"@id":"https://datakatalog.karlstad.se/store/7/resource/5","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Kontaktcenter","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:kontaktcenter@karlstad.se"}}],"@id":"urn:source:c8a0e4e253072c87e3f92d3f97f457ab1809d81bc9dea28e762d48d1adea005a"},{"@graph":[{"@id":"_:d540e4835cb2f2d8297e9136224114edd399a78fd68b368b0441b9520d69a5e5_b0n0","@type":"dct:Location","dcat:bbox":{"@type":"http://www.opengis.net/ont/geosparql#wktLiteral","@value":"POLYGON((13.155744247029732 59.64630165638792,14.013216253006185 59.64630165638792,14.013216253006185 59.291602495679626,13.155744247029732 59.291602495679626,13.155744247029732 59.64630165638792))"}},{"@id":"http://dataportal.se/organisation/SE2120001850","@type":"foaf:Agent","dct:identifier":"2120001850","dct:type":{"@id":"http://purl.org/adms/publishertype/LocalAuthority"},"foaf:homepage":{"@id":"https://karlstad.se/"},"foaf:mbox":{"@id":"mailto:kartservice@karlstad.se"},"foaf:name":{"@language":"sv","@value":"Karlstads Kommun"},"foaf:page":{"@id":"https://www.karlstad.se"},"http://www.w3.org/2002/