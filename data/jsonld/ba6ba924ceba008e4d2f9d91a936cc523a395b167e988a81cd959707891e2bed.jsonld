est=GetFeature&typeName=oppnadata%253Akarlstad_stompunkter_tripunkter&outputFormat=application%252Fjson"},"dct:description":{"@language":"sv","@value":"Koordinatsystem: SWEREF99TM"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till triangelpunkter som geoJSON"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://datakatalog.karlstad.se/store/9/resource/13","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gi.karlstad.se/stompunkter/"},"dct:title":{"@language":"sv","@value":"Webbkarta stompunkter"}},{"@id":"https://datakatalog.karlstad.se/store/9/resource/4","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://datakatalog.karlstad.se/store/10/resource/8"},"dcat:distribution":[{"@id":"https://datakatalog.karlstad.se/store/9/resource/10"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/11"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/12"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/13"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/5"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/6"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/7"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/8"},{"@id":"https://datakatalog.karlstad.se/store/9/resource/9"}],"dcat:keyword":[{"@language":"sv","@value":"Fixpunkter"},{"@language":"sv","@value":"Polygonpunkter"},{"@language":"sv","@value":"Stompunkter"},{"@language":"sv","@value":"Triangelpunkter"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/IRREG"},"dct:description":{"@language":"sv","@value":"Punkterna uppfyllde de krav som ställdes på stompunkters kvalitet vid tiden för tillkomsten. Karlstads kommun kan dock inte garantera att kvalitén på punkterna fortfarande är densamma. Du som nyttjare av stompunkter är skyldig att göra de kontroller som krävs för att säkerställa att just de punkter du använder, har för dig rätt kvalitet.\n\nNotera att det på punktskisserna kan finnas uppgifter om flera koordinatsystem. Du som nyttjare av stompunkter är ansvarig för att rätt koordinatsystem används."},"dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2120001850"},"dct:spatial":[{"@id":"_:6b2b1220e6517031eeceb7501bc8adb723dfb9a0f44707e2e6b3ce873c4443eb_b0n0"},{"@id":"https://sws.geonames.org/2701679"}],"dct:title":{"@language":"sv","@value":"Stompunkter - Höjd och plan"}},{"@id":"https://datakatalog.karlstad.se/store/9/resource/5","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gi.karlstad.se/geoserver/oppnadata/ows?service=wms&version=1.1.1&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WMS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till lagret som visningstjänst (WMS)"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/available"}},{"@id":"https://datakatalog.karlstad.se/store/9/resource/6","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://gi.karlstad.se/geoserver/oppnadata/ows?service=wfs&version=1.1.0&request=GetCapabilities"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/WFS_SRVC"},"dct:license":{"@id":"http://creativecommons.org/publicdomain/zero/1.0/"},"dct:title":{"@language":"sv","@value":"Länk till lagret som WFS"},"http://data.europa.eu/r5r/availabi