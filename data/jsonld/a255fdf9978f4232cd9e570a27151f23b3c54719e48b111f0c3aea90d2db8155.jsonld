{"@context":{"dcat":"http://www.w3.org/ns/dcat#","dct":"http://purl.org/dc/terms/","foaf":"http://xmlns.com/foaf/0.1/","xsd":"http://www.w3.org/2001/XMLSchema#"},"@graph":[{"@graph":[{"@id":"https://offwegooo.com/#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Off We Gooo","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:direction@offwegooo.com"}},{"@id":"https://offwegooo.com/#org","@type":"foaf:Agent","foaf:homepage":{"@id":"https://offwegooo.com/fr/"},"foaf:name":"Off We Gooo"},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#climat","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://offwegooo.com/#contact"},"dcat:distribution":{"@id":"https://offwegooo.com/fr/donnees-ouvertes#climat-csv"},"dcat:keyword":["Off We Gooo",{"@language":"fr","@value":"ERA5"},{"@language":"fr","@value":"Open-Meteo"},{"@language":"fr","@value":"climat"},{"@language":"fr","@value":"précipitations"},{"@language":"fr","@value":"température"},{"@language":"fr","@value":"tourisme"},{"@language":"fr","@value":"voyage"}],"dcat:landingPage":{"@id":"https://offwegooo.com/fr/donnees-ouvertes"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"fr","@value":"Températures, précipitations et température de la mer, mois par mois, pour 222 destinations réparties sur les cinq continents. Une ligne par destination et par mois, soit 2 664 lignes. Les normales publiques sont calculées par station météo, presque toujours un aéroport ; ces valeurs sont calculées à partir de la réanalyse ERA5 au point où va réellement le voyageur, y compris pour onze destinations sans aucune station à proximité."},"dct:modified":{"@type":"xsd:date","@value":"2026-08-07"},"dct:publisher":{"@id":"https://offwegooo.com/#org"},"dct:title":{"@language":"fr","@value":"Climat mensuel de 222 destinations de voyage"}},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#climat-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static.data.gouv.fr/resources/climat-mensuel-de-222-destinations-de-voyage-temperatures-pluie-mer/20260807-100725/climat-destinations-voyage.csv"},"dcat:downloadURL":{"@id":"https://static.data.gouv.fr/resources/climat-mensuel-de-222-destinations-de-voyage-temperatures-pluie-mer/20260807-100725/climat-destinations-voyage.csv"},"dcat:mediaType":{"@id":"http://www.w3.org/ns/iana/media-types/text/csv#Resource"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"fr","@value":"Climat mensuel de 222 destinations de voyage (CSV, UTF-8)"}}],"@id":"urn:source:ac0748a1dfee4aa2f234e2bbc827aac12eaa097955dbbeab46729a474e5929ef"},{"@graph":[{"@id":"https://offwegooo.com/#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Off We Gooo","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:direction@offwegooo.com"}},{"@id":"https://offwegooo.com/#org","@type":"foaf:Agent","foaf:homepage":{"@id":"https://offwegooo.com/fr/"},"foaf:name":"Off We Gooo"},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#mer","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://offwegooo.com/#contact"},"dcat:distribution":{"@id":"https://offwegooo.com/fr/donnees-ouvertes#mer-csv"},"dcat:keyword":["Off We Gooo",{"@language":"fr","@value":"Open-Meteo"},{"@language":"fr","@value":"baignade"},{"@language":"fr","@value":"température de la mer"},{"@language":"fr","@value":"tourisme"},{"@language":"fr","@value":"voyage"}],"dcat:landingPage":{"@id":"https://offwegooo.com/fr/donnees-ouvertes"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"fr","@value":"Température de surface de la mer modélisée, mois par mois, pour 96 destinations balnéaires, soit 1 152 lignes. Chaque destination est rattachée à un point de référence côtier vérifié un par un ; les destinations dont ce point n'a pas pu être confirmé ont été écartées plutôt que publiées avec une valeur approximative."},"dct:modified":{"@type":"xsd:date","@value":"2026-08-08"},"dct:publisher":{"@id":"https://offwegooo.com/#org"},"dct:title":{"@language":"fr","@value":"Température de la mer pour 96 destinations balnéaires"}},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#mer-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static.data.gouv.fr/resources/temperature-de-la-mer-pour-96-destinations-balneaires/20260808-185433/temperature-mer-destinations.csv"},"dcat:downloadURL":{"@id":"https://static.data.gouv.fr/resources/temperature-de-la-mer-pour-96-destinations-balneaires/20260808-185433/temperature-mer-destinations.csv"},"dcat:mediaType":{"@id":"http://www.w3.org/ns/iana/media-types/text/csv#Resource"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"fr","@value":"Température de la mer pour 96 destinations balnéaires (CSV, UTF-8)"}}],"@id":"urn:source:bac5c28712d579e7a7f00b090ad3ad78d7db371e7c242b18dc5c20637ad9513d"},{"@graph":[{"@id":"https://offwegooo.com/dcat.rdf#catalog","@type":"dcat:Catalog","dcat:dataset":[{"@id":"https://offwegooo.com/fr/donnees-ouvertes#altitudes"},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#climat"},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#mer"}],"dct:description":{"@language":"fr","@value":"Jeux de données ouverts produits par Off We Gooo : climat mensuel, altitude et température de la mer pour plus de 220 destinations de voyage. Licence CC BY 4.0."},"dct:publisher":{"@id":"https://offwegooo.com/#org"},"dct:title":{"@language":"fr","@value":"Données ouvertes Off We Gooo"},"foaf:homepage":{"@id":"https://offwegooo.com/fr/donnees-ouvertes"}}],"@id":"urn:source:dfef116f119d9dbc5f0ac4e758dc71979ae39708a0c488a5e6d644aee5915259"},{"@graph":[{"@id":"https://offwegooo.com/#contact","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Off We Gooo","http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:direction@offwegooo.com"}},{"@id":"https://offwegooo.com/#org","@type":"foaf:Agent","foaf:homepage":{"@id":"https://offwegooo.com/fr/"},"foaf:name":"Off We Gooo"},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#altitudes","@type":"dcat:Dataset","dcat:contactPoint":{"@id":"https://offwegooo.com/#contact"},"dcat:distribution":{"@id":"https://offwegooo.com/fr/donnees-ouvertes#altitudes-csv"},"dcat:keyword":["Off We Gooo",{"@language":"fr","@value":"Copernicus DEM"},{"@language":"fr","@value":"altitude"},{"@language":"fr","@value":"modèle numérique de terrain"},{"@language":"fr","@value":"tourisme"},{"@language":"fr","@value":"voyage"},{"@language":"fr","@value":"élévation"}],"dcat:landingPage":{"@id":"https://offwegooo.com/fr/donnees-ouvertes"},"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},"dct:description":{"@language":"fr","@value":"Altitude en mètres de 1 697 lieux touristiques nommés, répartis dans 222 destinations et 79 pays : villes, sites naturels, cols, plages, temples, points de vue et départs de randonnée. L'altitude est habituellement publiée par unité administrative ; ici elle est donnée au lieu lui-même par le modèle Copernicus DEM, du niveau de la mer Morte à −427 m au massif des Annapurnas à 7 850 m."},"dct:modified":{"@type":"xsd:date","@value":"2026-08-08"},"dct:publisher":{"@id":"https://offwegooo.com/#org"},"dct:title":{"@language":"fr","@value":"Altitude de 1 697 lieux touristiques dans le monde"}},{"@id":"https://offwegooo.com/fr/donnees-ouvertes#altitudes-csv","@type":"dcat:Distribution","dcat:accessURL":{"@id":"https://static.data.gouv.fr/resources/altitude-de-2-061-lieux-touristiques-dans-le-monde/20260808-204533/altitudes-lieux-touristiques.csv"},"dcat:downloadURL":{"@id":"https://static.data.gouv.fr/resources/altitude-de-2-061-lieux-touristiques-dans-le-monde/20260808-204533/altitudes-lieux-touristiques.csv"},"dcat:mediaType":{"@id":"http://www.w3.org/ns/iana/media-types/text/csv#Resource"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"fr","@value":"Altitude de 1 697 lieux touristiques dans le monde (CSV, UTF-8)"}}],"@id":"urn:source:ef4fdaeb8c214ed0e88da8732f47d7576a9af57573f1a309d31731191d7a15db"}]}
