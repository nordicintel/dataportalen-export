,"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för övrig vuxenvård, dividerat med antal invånare totalt 31/12. Med nettokostnad avses bruttokostnad minus bruttointäkt. Avser kostnader för insatser till vuxna (21 år eller äldre) med problem som inte är relaterade till eget skadligt bruk och/eller beroende av alkohol, narkotika, läkemedel, lösningsmedel eller kombinationer av dessa. Kostnader som avser insatser till personer med psykiska problem redovisas inte här utan under avdelningen vård och omsorg om äldre eller personer med funktionsnedsättning, oavsett om insatserna organisatoriskt tillhör individ- och familjeomsorgen (IFO). Bidrag till organisationer och föreningar inom verksamhetsområdet redovisas även här. Avser samtlig regi. "},"dct:identifier":"N37005","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:33ec7d8d5471f4af62841a4dba69c52ed27ed1245b9394e26207f3e41dae589d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad övrig vuxenvård, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N37005_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N37005"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"ht