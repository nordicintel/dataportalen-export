lue":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U31003","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U31003_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"En hög strukturjusterad kostnad innebär att kostnadsläget är högt i kommunens verksamhet, då hänsyn tas till förutsättningarna. Den strukturjusterade kostnaden för ekonomiskt bistånd bygger på en regressionsmodell där nettokostnaden för ekonomiskt bistånd ställts mot andelen med högst förgymnasial utbildning i befolkningen, andelen unga vuxna av befolkningen 18-64 år , andelen arbetslösa i befolkningen (årsgenomsnitt) samt andelen i befolkningen som någon gång under året varit arbetslös utan ersättning. Alla förklarande variabler avser föregående år. Observera att modellen har uppdaterats from 2020. Tidigare ingick andel svenskfödda invånare 20-40 år med låg utbildning, andel unga vuxna av befolkningen 18-64 år, utrikes födda invånare 18-64 år med vistelsetid 6-10 år efter uppehållstillstånd samt andelen arbetslösa i befolkningen (årsgenomsnitt). "},"dct:identifier":"U31003","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:faf88f5658fe6ce83342a6d46d8bb870b60589180d7a5cf6d5fd387ab42dca93_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Strukturjusterad nettokostnad ekonomiskt bistånd, kr/inv (-2024)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U31003_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U31003"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:faf88f5658fe6ce83342a6d46d8bb870b60589180d7a5cf6d5fd387ab42dca93_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:faf88f5658fe6ce83342a6d46d8bb870b60589180d7a5cf6d5fd387ab42dca93"},{"@graph":[{"@id":"_:fb0084fe8df39762be189d58e5c4be0e62b216a145f59ecd8f2a7fbd4de62d92_b0n0","@type":"