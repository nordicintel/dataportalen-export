vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U61902","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U61902_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sammanräkning till index av flera sjukdomsförekomst, där regionen med lägst förekomster får värdet 100 och regionen med högst förekomster får 0. Värdet är ett sammanräknat index av följande mått:  Förekomst av akut hjärtinfarkt, antal/100 000 invånare, Förekomst av diabetes typ 2, andel (%), antal/100 000 invånare, Förekomst av lungcancer, kvinnor, antal/100 000 invånare, Förekomst av lungcancer, män, antal/100 000 invånare, Förekomst av prostatacancer, antal/100 000 invånare, Förekomst av bröstcancer, antal/100 000 invånare, Förekomst av tjocktarmscancer, kvinnor, antal/100 000 invånare, Förekomst av tjocktarmscancer, män, antal/100 000 invånare, Förekomst av ändtarmscancer, kvinnor, antal/100 000 invånare, Förekomst av ändtarmscancer, män, antal/100 000 invånare samt Förekomst av stroke, antal/100 000 invånare.  värde får 100 och lägst värde får  Några mått redovisas separat för kvinnor och män. De räknas ihop till ett medelvärde. Alla nyckeltalen normaliseras, där regionen med lägst sjukdomsförekomst får 100 och högst får 0. Detta räknas sedan ihop till ett totalindex. "},"dct:identifier":"U61902","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-28"},"dct:provenance":{"@id":"_:810932c2452d428566e7d03ec5893e79f37b2286bd41997a4556a14fcee12a02_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Låg förekomst av folksjukdomar, index (max = 100)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U61902_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U61902"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox