24826c7e57194658bc2d91d49f9471fbbae80_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Den del av verksamhetens totala driftkostnad för kommunala bil- och cykelvägar som hänförs till kommunala cykelvägar. Summan av driftkostnaderna för vinterväghållning, gatubelysning, akuta beläggningsåtgärder, barmarksrenhållning, gatugrönytor, trafikanordningar, trafiksignaler, konstbyggnader, dagvattenavledning, och övriga driftkostnader. Exklusive kapitalkostnader och kostnad för all beläggningsunderhåll som inte är akuta åtgärder (typ potthål/snabelbil). 2018 och tidigare ingick även driftkostnader för gångvägar, vilket kan medföra trendbrott 2019. "},"dct:identifier":"U07498","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:0f35c6f08c8e559abb1a9353c5c24826c7e57194658bc2d91d49f9471fbbae80_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Driftkostnad kommunala cykelvägar, kr/meter"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07498_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07498"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med informat