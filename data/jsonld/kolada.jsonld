pa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Sammanlagda vårdtid då patienter, utskrivna under mätperioden, varit utskrivningsklara dividerat med antalet under mätperioden avslutade vårdtillfällen där patienten haft vårdtid som utskrivningsklar. Den dag då patienten blir utskrivningsklar räknas inte in i vårdtid som utskrivningsklar. T.o.m. 2016 så avsågs det bara personer 65 år och äldre. Fr.o.m. 2017 ingår samtliga personer. Studier har visat att 90 - 95 % av de utskrivningsklara patienterna är 65 år eller äldre. "},"dct:identifier":"N20403","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-27"},"dct:provenance":{"@id":"_:b241e9fc6458f79a652ae7aa4e27d1ff5413472809b13e2de1968c083d7a3fd0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Medelvårdtid som utskrivningsklar, antal dagar"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N20403_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N20403"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - 