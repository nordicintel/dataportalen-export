dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel lärare på grundläggande nivå i komvux som har lärarlegitimation och behörighet i minst ett ämne. Avser egen regi, lärare hos upphandlade utbildningsanordnare är inte inkluderade. För att vara behörig lärare i komvux på grundläggande nivå ska läraren ha behörighet för: skolform, nivå, samt undervisningsämne, enligt uppgifter i Lärar- och förskollärarregistret. I statistiken om legitimation och behörighet, omräknat till heltidstjänster, beräknas varje del av lärarens heltidstjänst och summeras som behörig om denna del av lärarens heltidstjänst är behörig i skolform, nivå och ämne. Måttet beräknas för lärare som undervisar i ämnena biologi, engelska, fysik, geografi, historia, kemi, matematik, religionskunskap, samhällskunskap, svenska och svenska som andraspråk. "},"dct:identifier":"N18928","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-08"},"dct:provenance":{"@id":"_:c927960fb56fe471b9024a046eb1b5b3cc6356d920df02887a72ed56d57815f1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Lärare (heltidstjänster) i komvux på grundläggande nivå med lärarlegitimation, kommunal regi, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N18928_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N18928"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.euro