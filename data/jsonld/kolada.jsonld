id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Boende i kommunen. Totala lönesumman inkluderar individer med okända kontrolluppgifter som inte kan hänföras till personer folkbokförda i Sverige. Det kan till exempel vara felaktigt angivna personnummer eller avse personer som bor i utlandet. Därav summerar inte alltid de könsuppdelade uppgifterna till totalen. Sedan 2019 använder sig SCB av de månatliga arbetsgivardeklarationerna på individnivå (AGI) som datakälla istället för de årliga kontrolluppgifterna (KU), det gör att jämförelser mot tidigare år bör göras med försiktighet. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N00126","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-15"},"dct:provenance":{"@id":"_:40570e71adb0aa607ff9b943ac9bd6c21bf7094d8906b657274393727b33d7cb_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Lönesumma, boställets belägenhet/nattbefolkning, mnkr"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N00126_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N00126"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https