,"http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N21006_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna intäkter och försäljning till andra kommuner och regioner för hemtjänst äldreomsorg, dividerat med antal personer 65+ som var beviljade hemtjänst i ordinärt boende. Uppgifter om antal personer med beviljad hemtjänst avser fram till 2020 ett snitt av årets månader, från 2021 en kommunindividuell median från socialstyrelsens statistikdatabas, minst 10 månader ska vara inrapporterat. Personer med hemtjänstbeslut som endast omfattar trygghetslarm, matdistribution, avlösning eller ledsagning har exkluderats. Ålder beräknas efter hur många år personen har fyllt vid mätdagen (sista dagen) respektive månad. Ersätter: N21819. Måttet bör användas med försiktighet vid jämförelser pga stora variationer i biståndsbedömning och ambitionsnivå lokalt samt att täljare och nämnare fångar delvis olika population. "},"dct:identifier":"N21006","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-30"},"dct:provenance":{"@id":"_:82715be2f86cf5a7b3c1b4ea29fec4305f4da19d781b5711c5ae688d9b0472ec_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad hemtjänst äldreomsorg, kr/hemtjänsttagare"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v