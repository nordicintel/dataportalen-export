u"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U01473","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U01473_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel som fått utfallet gott eller mycket gott psykiskt välbefinnande. Två olika undersökningar med jämförbara resultat är inkluderade i statistiken. Uppsala, Sörmland, Västmanland, Värmland och Örebro (den sk. CDUST-regionen) har Liv & Hälsa (LV) som datakälla, med urval av invånare 18-84 år vilket avser år T. Resten av landet som har källa folkhälsomyndigheten (HLV), och med urval på invånare 16-84 år, avser år T-3 till T.  Utfallet baseras på instrumentet Short Warwick Edinbourgh Mental Well-being Scale (SWEMWBS) där den svarande får ta ställning till en rad påståenden om de senaste 2 veckorna.  Påståendena är: \"Jag har haft en positiv syn på framtiden\", \"Jag har känt att jag har varit till nytta\", \"Jag har känt mig lugn\", \"Jag har hanterat problem på ett bra sätt\", \"Jag har tänkt på ett klart sätt\", \"Jag har känt mig nära andra människor\", \"Jag har själv kunnat bestämma mig om saker och ting\", utifrån detta tas ett samlat mått på psykiskt välbefinnande fram. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U01473","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:53e8ab654313dd159415551a61a89c4db9319fcf41c9097e0ccab7808989b73f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare 16-84 år med gott psykiskt välbefinnande, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U01473_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U01473"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/