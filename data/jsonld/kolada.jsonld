e":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U79066","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U79066_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Indikatorn visar kostnad per producerad prestation i sluten sjukhusvård, vilket mäts i DRG-poäng. Observera att beräkningen avser sjukhusvårdtillfällen, vilket skiljer sig från andra uppgifter i Kolada om kostnad per producerad DRG-poäng, där klinikvårdtillfällen används. DRG står för diagnosrelaterade grupper. DRG används för att beskriva och förstå sjukvården där man slår ihop enskilda vårdkontakter till större grupper. Principen är att medicinskt likartade vårdkontakter, som dessutom är ungefär lika resurskrävande, räknas in i en och samma grupp. "},"dct:identifier":"U79066","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-28"},"dct:provenance":{"@id":"_:8efba11f0cdd9d4dcdc4e4acb4282dcefc22c87793d1331d05499bd339aecfcf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad per producerad DRG-poäng i sluten somatisk sjukhusvård,  kr/DRG-poäng"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U79066_json","@type"