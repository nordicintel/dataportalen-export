uthority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel som har svarat \"Mycket bra\" eller \"Ganska bra\" på frågan \"Vad tycker du om möjligheterna som kommunens invånare har att delta aktivt i arbetet med utveckling av kommunen (t.ex. medborgardialoger, samråd)?\" i SCBs medborgarundersökning. De som har svarat \"Vet inte\"/\"Ingen åsikt\" har exkluderats. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N00651","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-15"},"dct:provenance":{"@id":"_:1e2116f62bd117719c7362f7c50e3659aa0a2520ee47544d0b55f0cefd73eeb6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Medborgarundersökningen - Möjlighet att delta aktivt i arbetet med att utveckla kommunen fungerar bra, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N00651_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N00651"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE22200003