.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel elever på SFI som klarat minst två kurser, av nybörjare två år tidigare. Med nybörjare avses elever som inte tidigare varit inskrivna i sfi. Alla elever som har klarat kurserna ingår, oavsett avbrott.  Elever som klarar fler kurser och de som klarat hela SFI ingår, även elever som hoppat över första kursen så länge de klarat B-kurs är inräknade. Avser skolkommun. Eleven kan ha läst kurserna i olika kommuner, eleven kommer då dyka upp i den kommun där den slutförde den sista kursen. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18409","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-18"},"dct:provenance":{"@id":"_:b83337afd5210ef172e4dec94d685dc6be7c5d62535806f177bcde457e8b072a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elever på SFI som klarat minst två kurser, av nybörjare två år tidigare, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N18409_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N18409"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data