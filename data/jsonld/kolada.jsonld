70610_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel kvinnor som varit på eftervårdsbesök inom mödrahälsovård 4–16 veckor efter förlossning, av alla kvinnor som fött barn under mätperioden. När vårdtiden på BB blir kortare ställs högre krav på kontinuitet i vårdkedjan, och att de nyblivna föräldrarna ska få stöd och råd. Vid ett eftervårdsbesök ges möjlighet att samtala om förlossningsupplevelsen och tankar inför en eventuell ny graviditet. Alla ska erbjudas en gynekologisk undersökning för en kontroll att allt ser bra ut "},"dct:identifier":"N70610","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-23"},"dct:provenance":{"@id":"_:676b82947992b2de04db6e83578fa394e6cbb74017b311628e5fd07e8d007180_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Eftervårdsbesök på barnmorskemottagning, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N70610_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N70610"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med informa