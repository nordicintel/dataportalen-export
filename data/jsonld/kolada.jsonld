www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N23587","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N23587_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som \"Ja, för både\" =  2, \"Ja, för enkla\" & \"Ja, för  fördjupade\" = 1 och \"Nej\" = 0 medan det på kommunnivå endast anges som andel (%) enheter där man svarat \"ja, för både\".  Nyckeltalet bygger på följande enkätfrågor: \"Har ni, den 1 mars, skriftliga och på ledningsnivå beslutade rutiner för hur enkla och fördjupade läkemedelsgenomgångar ska genomföras i samverkan med regionen?\", \"Beskriver rutinen hur samverkan vid läkemedelsgenomgångar ska ske tillsammans med den enskilde, läkaren, sjuksköterskan samt hemtjänstpersonalen vid enheten?\" samt \"Har ni någon gång under det senaste året (12 månaders period) följt upp rutinen?\". En enkel läkemedelsgenomgång ska erbjudas personer 75 år och äldre med minst fem läkemedel enligt Socialstyrelsens föreskrifter och allmänna råd HSLF-FS 2017:37. En fördjupad läkemedelsgenomgång ska erbjudas till personer som efter en enkel läkemedelsgenomgång har kvarstående läkemedelsrelaterade problem eller där misstankar om förekomst av sådana problem finns. Läkaren ansvarar för att följa upp, uppdatera och ompröva målen för behandlingen som läkemedelsgenomgången resulterade i. "},"dct:identifier":"N23587","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:c65e53dcd0cf715f468c56d5172428aafef6fc9d92f51743a43a73d55e8f9323_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Aktuell rutin finns för hur läkemedelsgenomgångar ska genomföras samt hur samverkan ska ske tillsammans med den enskilde, läkaren, sjuksköterskan som ansvarar i särskilt boende, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23587_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N23587"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på sven