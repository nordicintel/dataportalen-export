ssRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U40466","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U40466_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal deltagare som svarat alternativen \"Till mycket stor del\" eller \"Helt och hållet\" på frågan \"Upplever du att personalen har tagit tillvara dina erfarenheter, såsom kunskaper och synpunkter?\" dividerat med samtliga deltagare som svarat på frågan. Samtliga svarsalternativ är \"Inte alls\", \"Till liten del\", \"Delvis\", \"Till stor del\", \"Till mycket stor del\", \"Helt och hållet\". Frågan ställs till deltagare som fått insatser med finansiering eller stöd av Finansiell samordning (Finsam) vid avslut. Syftet är att mäta om deltagarna upplever att det systematiskt tillvaratas erfarenheter, kunskaper och synpunkter från deltagare. Finansiell samordning sker genom samordningsförbund där det kan ingå en eller flera kommuner och undersökningen sammanställs på samordningsförbundsnivå. Kommuner som ingår i samma samordningsförbund har därför samma värde. "},"dct:identifier":"U40466","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-02"},"dct:provenance":{"@id":"_:26c064592270fece9ef531d578101c904c27a33a26129024b1851c10643d2122_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagarbedömning Finsam - Personalen tar tillvara på deltagarens erfarenheter, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U40466_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U40466"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:26c064592270fece9ef531d578101c904c27a33a26129024b1851c10643d2122_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:26c064592270fece9ef531d578101c904c27a33a26129024b1851c10643d2122"},{"@graph":[{"@id":"_:26c833c8918f118dd52f281450b13a15600d7bb5538e114465ec60386b92d6b4_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Bostadsmarknadsenkäten (Boverket)"}},{"@id":"_:26c833c8918f118dd52f281450b13a15600d7bb5538e114465ec60386b92d6b4_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U30456","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U30456_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kommunens bedömning av bostadsmarknadsläget särskilt boende för äldre i kommunen. Balans, överskott eller underskott på bostäder. Underskott på bostäder innebär inte alltid att det finns bostadssociala problem såsom trångboddhet eller omfattande andrahandsuthyrning som utbrett fenomen. Underskott på bostäder kan innebära att det i kommunen finns en dynamisk ekonomi, där ökade inkomster leder till en ökad efterfrågan på bostäder. Att en kommun uppger underskott på bostäder innebär i många fall att det är svårt att flytta till, eller inom kommunen. överskott på bostäder innebär att det ständigt finns fler lediga bostäder, eller bostäder till salu, än vad som efterfrågas. Att det finns outhyrda lägenheter i något enstaka bostadsområde behöver inte innebära att den lokala bostadsmarknaden präglas av ett överskott. Ett överskott på bostäder behöver inte heller innebära att det finns lämpliga bostäder i förhållande till hur efterfrågan och/eller behovet ser ut i kommunen. Med särskilda boendeformer för äldre avses i frågorna boende enligt 5 kap. 5 § socialtjänstlagen. För att kunna bo i särskilt boende behöver man en biståndsprövning och ett beslut från kommunen. "},"dct:identifier":"U30456","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-19"},"dct:provenance":{"@id":"_:26c833c8918f118dd52f281450b13a15600d7bb5538e114465ec60386b92d6b4_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Bostadsmarknadsläget i kommunen, särskilt boende äldre (Överskott=2, Balans=1, Underskott=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U30456_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U30456"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:26c833c8918f118dd52f281450b13a15600d7bb5538e114465ec60386b92d6b4_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:26c833c8918f118dd52f281450b13a15600d7bb5538e114465ec60386b92d6b4"},{"@graph":[{"@id":"_:26d38297133f00b8594827af031c3ca9fb15230244ab5ceb2d6f519d6e22a566_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Sveriges kommuner och