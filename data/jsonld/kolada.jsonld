e.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U40453_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal deltagare som avslutats inom den kommunala arbetsmarknadsverksamhetens insatser med slutförda uppdrag. Slutförda uppdrag, avser insatser som den kommunala arbetsmarknadsverksamheten genomfört på uppdrag av en remitterande instans - Arbetsförmedlingen, Försäkringskassan, Socialtjänstens försörjnings­stödsenhet etc. - och som har mynnat ut i ett skriftligt- eller muntligt utlåtande i enlighet med beställning (t ex arbetsförmågebedömning, -prövning eller -träning). Efter avslutat uppdrag har ansvaret för deltagarna återgått till remitterande instans. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U40453","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:b16d8df52eccd5b8163b6cfca04f26e102ff91514109bd09e321e392150ff27f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Resultat vid avslut i kommunens arbetsmarknadsverksamhet, deltagare som D. Slutförda uppdrag, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U40453_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U40453"},"dct:fo