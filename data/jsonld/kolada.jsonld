{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för öppen fritidsverksamhet, dividerat med antal invånare totalt 31/12. Med nettokostnad avses bruttokostnad minus bruttointäkt. Avser öppen fritidsverksamhet vilket är enligt skollagen ett alternativ till inskriven verksamhet för barn i åldersgruppen 10-12 år och kan också fungera som ett komplement för de skolbarn som är inskrivna i pedagogisk omsorg. Den kan samordnas med kommunens övriga fritidsverksamheter för barn och ungdom och även anordnas i samarbete med föreningslivet. Till öppen fritidsverksamhet räknas även fritidshem för särskolebarn som inte är inskrivna i skolbarnsomsorgen. Avser samtlig regi. "},"dct:identifier":"N13003","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:f72acf07584331152e10cf02fc000cbd08a1ba8c94e5dea99dc43bf1685a88e9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad öppen fritidsverksamhet, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N13003_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N13003"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst me