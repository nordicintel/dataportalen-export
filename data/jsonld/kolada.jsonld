mmunala tidsbegränsade anställningar (årsarbetare) som skapats för att mildra verkningarna av arbetslöshet. Anställningarna kan finnas i kommunala förvaltningar och/eller bolag och bekostas av kommunala medel eller vara delfinansierade/subventionerade av staten. Om den anställdes lön utbetalas av arbetsmarknadsverksamheten eller av den förvaltning/det bolag där hon/han arbetar har ingen betydelse och det spelar inte heller någon roll om den anställde ägnar en del av sin arbetstid åt kompetensutveckling eller studier som inte berättigar till CSN. Redovisas som årsanställningar. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U40403","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:7aa4a10f73fa46198b46b833bed865eefc3a921c3807eb2d348142fc7d3b8d94_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Årsarbetare, kommunala arbetsmarknadsanställningar, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U40403_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U40403"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Muni