:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N18634","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N18634_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever år T-2 som slutfört sin gymnasieutbildning med examen från ett högskoleförberedande program i fristående skolor i kommunen, som år T var etablerade på arbetsmarknaden dividerat med antal elever år T-2 som slutfört sin gymnasieutbildning med examen från ett högskoleförberedande program i fristående skolor i kommunen. Etablerad på arbetsmarknaden är den som är sysselsatt enligt sysselsättningsregistrets definition (november månad) och inte har några händelser som indikerar arbetslöshet eller arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning. Aktuell gräns för den arbetsinkomst som krävs för att räknas som sysselsatt återfinns hos Skolverket. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18634","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-22"},"dct:provenance":{"@id":"_:fe046f1c13485d328ca4148a8f6334e22a7ea35cabfe62750c77deeb71a4a777_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct: