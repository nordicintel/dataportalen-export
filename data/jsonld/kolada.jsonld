:"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nationella folkhälsoenkäten är en urvalsundersökning bland befolkningen 16 år och äldre, för 2020 och tidigare omfattas 16-84 år, data avser år T-3 till T. Flerårsmedelvärden redovisas för att få tillräckligt stort dataunderlag. BMI beräknas enligt: vikt (i kg) dividerat med längd (m2) i kvadrat. Andelen räknas genom att ta antal enkätsvarande som beräknats ha ett BMI 25 eller högre enligt ovan dividerat med det totala antalet som besvarat frågan. Extremvärden har exkluderats. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U01760","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:b2ff8e49b90ca39c1b647bb101156b2c765bf65e091fe8ca9f2a4ee4b5ac1260_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare med övervikt eller fetma, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U01760_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U01760"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"