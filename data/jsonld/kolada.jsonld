r som tas emot inom ramen för det kommunala flyktingmottagandet och för vilka kommunen erhåller statlig ersättning. Under den tid som kommunen får ersättning för personen från Migrationsverket redovisas här kostnader avseende: mottagning och introduktion av flyktingar, administration, tolkar, ekonomiskt bistånd, introduktionsersättning för flyktingars försörjning samt genomgångsbostäder som bebos av flyktingar och som inte finansieras med försörjningsstöd, introduktionsersättning eller extraordinär ersättning från Migrationsverket. Omfattar även ensamkommande flyktingbarn. Avser samtlig regi. "},"dct:identifier":"N40010","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:c6dc17bcbfa1c396daa22fcc4b418899b7e70ed59d99ef036ecc1b66a4f7517a_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad flyktingmottagande, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N40010_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N40010"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advoca