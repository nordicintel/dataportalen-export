":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"I förekommande fall inkluderas: Mottagningsbesök, dagsjukvårdsbesök (fr om 2008), hembesök samt hemsjukvårdsbesök. Besök är här det samma som termen Öppenvårdsbesök: vårdkontakt inom öppen vård som innebär personligt möte mellan patient och hälso- och sjukvårdspersonal, endast öppenvårdsbesök som har dokumenterats i patientens journal redovisas. Avser produktion (besök gjorda inom länet, oavsett var patienten är folkbokförd). "},"dct:identifier":"N72814","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:provenance":{"@id":"_:df0dc2d9102142ffb5830dbb2a7cb1e1198801831b1468a1423edfa2b000fcf1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Andra besök än läkarbesök, barnhälsovård annan vårdgivare/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N72814_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N72814"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailt