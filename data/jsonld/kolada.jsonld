68"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28122","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28122_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med kompetensutveckling menas att personalen utvecklas i sin yrkesroll genom exempelvis utbildning, kurser eller handledning, utifrån verksamhetens uppdrag. Med samlad plan för personalens kompetensutveckling menas en enhetsgemensam eller verksamhetsgemensam plan för personalens kompetensutveckling som bygger på verksamhetens uppdrag och kartläggning av personalens individuella kompetenser. På kommunnivå anges andel (%) enheter som uppfyllt indikatorn, dvs Ja. På enhetsnivå är Ja=1, Nej=0. "},"dct:identifier":"U28122","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:329864bb54ba4cae91ec4bb143b20ca243dc3c77cf503dfd62d24038e2527971_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Samlad kompetensutvecklingsplan för personalen finns vid enheten, bostad med särskild service, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28122_json","@type":["dcat:Distribution","http://e