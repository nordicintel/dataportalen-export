t/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U30458","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U30458_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:7a6ffda8d96f94a28b4500e452af1ed137c4c0a5d3b1b00ad62347a22bcbfd06_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kommunens bedömning av bostadsmarknadsläget för särskilda boendeformer för personer med funktionsnedsättning i kommunen. Särskilda boendeformer för personer med funktionsnedsättning är boende enligt lagen om stöd och service till personer med vissa funktionshinder (LSS), eller 5 kap. 7 § socialtjänstlagen. Balans, överskott eller underskott på bostäder. Underskott på bostäder innebär inte alltid att det finns bostadssociala problem såsom trångboddhet eller omfattande andrahandsuthyrning som utbrett fenomen. Underskott på bostäder kan innebära att det i kommunen finns en dynamisk ekonomi, där ökade inkomster leder till en ökad efterfrågan på bostäder. Att en kommun uppger underskott på bostäder innebär i många fall att det är svårt att flytta till, eller inom kommunen. överskott på bostäder innebär att det ständigt finns fler lediga bostäder, eller bostäder till salu, än vad som efterfrågas. Att det finns outhyrda lägenheter i något enstaka bostadsområde behöver inte innebära att den lokala bostadsmarknaden präglas av ett överskott. Ett överskott på bostäder behöver inte heller innebära att det finns lämpliga bostäder i förhållande till hur efterfrågan och/eller behovet ser ut i kommunen. "},"dct:identifier":"U30458","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-19"},"dct:provenance":{"@id":"_:7a6ffda8d96f94a28b4500e452af1ed137c4c0a5d3b1b00ad62347a22bcbfd06_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Bostadsmarknadsläget i kommunen, personer med funktionsnedsättning, (Överskott=2, Balans=1, Underskott=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U30458_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U30458"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@valu