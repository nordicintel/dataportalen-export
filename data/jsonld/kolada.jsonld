/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N01452","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N01452_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel personer 16–84 år som uppger psykiskt påfrestning. Procent  Indikatorn psykisk påfrestning baseras på instrumentet Kessler 6 som består av en fråga med sex delfrågor: Under den senaste månaden, hur ofta har du känt dig; ”orolig?”, ”utan hopp?”, ”rastlös?”, ”så pass nedstämd att inget kunnat muntra upp dig?”, ”som att allt varit ansträngande?”, ”värdelös?”. På varje delfråga ges fem svarsalternativ som poängsätts från 0 (”Ingen del av tiden”) till 4 (”Hela tiden”). En summapoäng mellan 13 och 24 enligt detta verktyg kallas allvarlig psykisk påfrestning och indikerar att kriterierna för psykiatrisk diagnos skulle kunna vara uppfyllda. Täljare: Antal personer som enligt instrumentet klassas ha allvarlig psykisk påfrestning. Nämnare: Antal personer som svarat på frågan. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N01452","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:14e089ab5dcfa47d525dfd88a2b34cb6adc76301c2bb86136fd3ca2acd13bd19_b0n0"