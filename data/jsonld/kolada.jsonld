ority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer med ställföreträdarskap, dividerat med antal invånare 31/12. Med ställföreträdarskap avses gode män enligt föräldrabalken 11 kap 1-4§, gode män för ensamkommande barn, förvaltare enligt föräldrabalken 11 kap 7§ samt förmyndare enligt föräldrabalken 10 kap. Uppgifter per den 31/12 T. Flera kommuner har ett kommunövergripande samarbete. Överförmyndarnämndens resultat fördelas på den enskilda kommunen efter befolkningsmängd. "},"dct:identifier":"U37002","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:be4882c5ae2338a90d6ca82c186f0a67c20fcc13a209d66796ea6866d793dd44_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare som har ställföreträdarskap, antal/1000 invånare"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U37002_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U37002"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet 