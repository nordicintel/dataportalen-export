theme":[{"@id":"_:498016175134c37f3e7e3d108fd929beeb8fefea78238e4d23fcdc6081bc43b7_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal kilogram insamlat mat- och restavfall per justerat invånarantal i kommunen. Avser mat- och restavfall (tidigare benämt kärl- och säckavfall) från hushåll samt därmed jämförligt avfall från annan verksamhet t.ex. affärer, kontor, industrier och restauranger mm. Med mat- och restavfall avses såväl brännbart restavfall (hushållssopor) samt matavfall som samlas in av kommunen. Det samlas vanligen in i kärl eller säck men även andra insamlingssystem används som container, tank, sopsug och underjordiska behållare. Invånarantalet justeras med hänsyn till fritidshus, gästnätter och in-/utpendling. I utpräglade fritidshuskommuner eller kommuner med omfattande turistverksamhet genereras betydligt mer hushållsavfall än vad de permanentboende ger upphov till. Även i kommuner med stort inpendlingsöverskott genereras mycket hushållsavfall via arbetsplatserna. Genom att använda ett justerat invånarantal speglas mängden avfall per person på ett mer korrekt sätt för den egna kommunen, vilket underlättar jämförelser med andra kommuner. "},"dct:identifier":"U07482","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-01"},"dct:provenance":{"@id":"_:498016175134c37f3e7e3d108fd929beeb8fefea78238e4d23fcdc6081bc43b7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Insamlat mat- och restavfall, kg/invånare (justerat)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07482_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07482"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:498016175134c37f3e7e3d108fd929beeb8fefea78238e4d23fcdc6081bc43b7_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:498016175134c37f3e7e3d108fd929beeb8fefea78238e4d23fcdc6081bc43b7"},{"@graph":[{"@id":"_:4983c6968d2ffa872b4ddd8c90bb29e4daa0bf5d04b86dcc8b33a0418268c571_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Skolverket"}},{"@id":"_:4983c6968d2ffa872b4ddd8c90bb29e4da