},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00680","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00680_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:b30eafd03c3f9156914ae2227ec51d3e0782ea803ee7d6b36754be6d12423d85_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Arealer ekologiskt brukad jordbruksmark i hektar. Med ekologiskt brukad jordbruksmark avses arealer jordbruksmark som brukas med ekologiska produktionsmetoder och som uppfyller kraven enligt Europaparlamentets och rådets förordning (EU) 2018/848 om ekologisk produktion och märkning av ekologiska produkter. Uppgifter om ekologisk brukad jordbruksmark får Jordbruksverket från de kontrollorgan som kontrollerar jordbrukarnas efterlevnad av regelverket. Både omställd mark och mark under omställning inkluderas i statistiken. "},"dct:identifier":"N00680","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-10"},"dct:provenance":{"@id":"_:b30eafd03c3f9156914ae2227ec51d3e0782ea803ee7d6b36754be6d12423d85_b0n0"},"dct:publish