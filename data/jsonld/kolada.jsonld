:"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Anställda 34 år eller yngre inom grundskola (före 2022 redovisades fritidshem i verksamhetsområde förskola, men från och med 2022 ingår fritidshem huvudsakligen i detta verksamhetsområde) dividerat med samtliga anställda inom samma verksamhetsområde, multiplicerat med 100 för redovisning i procent. Avser kommunalt anställda i november månad. Från och med 2022 så redovisas inte viss personal (t.ex. elevhälsa ) i någon av verksamheterna inom skola/förskola om personalen är gemensam mellan olika skolformer/förskola. Anställda inom kommunalförbund/kommunala bolag ingår inte. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N15212","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:a515ba06b6f4d254446025b35c8a6b35f2d45a49d9954e9586d417f1b8e4d5d5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Anställda, -34 år, inom grundskola, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15212_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N15212"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses