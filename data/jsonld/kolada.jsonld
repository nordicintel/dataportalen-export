@id":"http://api.kolada.se/v3/kpi/U26449","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U26449_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer med boendestöd SoL som har svarat Ingen på frågan Känner du dig trygg med personalen? dividerat med samtliga personer med boendestöd SoL som har besvarat frågan. Svarsalternativen var Alla, Några, Ingen. Undersökningen är ej en totalundersökning varför resultatet för en kommun kan vara baserat på ett mindre antal brukares svar, dock minst fem. För en del kommuner ingår brukare i både kommunens egen regi och annan regi (privat/ideell), för en del endast brukare i egen regi och för andra endast brukare i annan regi. Undersökningen har genomförts med ett webbaserat verktyg för enkäter, anpassat till personer med funktionsnedsättning. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U26449","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:e96d23a5a6fca812a49668e935435c7cde79f2aea8f0d63cd13c3358452f6fa8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning boendestöd SoL - Brukaren känner sig inte trygg med någon i personalen, lägeskommun, andel (%) (-2024)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"htt