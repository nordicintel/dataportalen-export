rg/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U30752","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U30752_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nyckeltalet avser att fånga de ärenden som avslutas med att det övergipande målet med insatsen eller insatserna har uppnåtts. En förutsättning för nyckeltalet är att det finns uppgift om övergripande individuellt mål samt även en handläggarbedömning om det övergripande målet har uppnåtts. Det övergripande målet bör handla om en förändring i förhållande till våldet. Det kan finnas flera mål på kortare sikt eller delmål för klienten, men här avses det mera övergripande målet. Våld i nära relation avser vuxna (18 år eller äldre) som är eller har varit utsatta för våld eller andra övergrepp av närstående. Se även Avgränsningar på Start-fliken. Begreppet ”våld” innefattar alla former av våld, som t.ex. psykiskt, fysiskt, sexuellt, ekonomiskt, materiellt samt försummelse.  Begreppet ”närstående” är könsneutralt och syftar på varje person som den våldsutsatta bedöms ha eller har haft en nära och förtroendefull relation till. Även avslut av ärenden som aktualiserats till följd av hedersrelaterat våld är inkluderade i nyckeltalet. Ärendet avslutas när målet eller målen med insatsen eller insatserna har uppnåtts. En förutsättning för nyckeltalet är att det finns uppgift om individuellt/individuella mål samt även handläggarbedömning om målet/-en har uppnåtts. Stockholms och Göteborgs kommunvärden baseras på ett snitt av deltagande stadsdelar. "},"dct:identifier":"U30752","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-11"},"dct:provenance":{"@id":"_:830a18b85377b0553ece93a8c30aa4c9955fe2f0d202e0ba8d62de2bd76b4a6e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Vuxna (18+) som fått insats från individ- och familjeomsorgen p.g.a. utsatthet för våld i nära relation/hedersrelaterat våld, där ärendet avslutats för att det övergripande målet med insatserna har nåtts helt eller delvis, antal/10 000 vuxna invånare"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U30752_json","@type":["dcat:Distribution",