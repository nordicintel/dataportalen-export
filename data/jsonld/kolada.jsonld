pa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Externa intäkter exklusive intäkter från försäljning till andra kommuner och regioner för totalförsvar och samhällsskydd, dividerat med antal invånare 31/12. Avser administration av civilförsvarsfrågor. Utarbetande av planer, anordnande av övningar med civila institutioner och civilbefolkningen samt drift av, eller stöd till civilförsvarsstyrkor. Avser samtlig regi. "},"dct:identifier":"N07021","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-08-28"},"dct:provenance":{"@id":"_:2f9062cb90880963dd9de95fc5461b0fddcf7aaa18c45b02980de6ac71d3a51d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Intäkter totalförsvar och samhällsskydd, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N07021_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N07021"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https: