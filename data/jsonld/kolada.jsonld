},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00905","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00905_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Disponibel mediannettoinkomst personer 20 år och äldre. Nettoinkomsten är summan av alla skattepliktiga och skattefria inkomster som förvärvs- och kapitalinkomster och transfereringar minus skatt och övriga negativa transfer. Inkomsten är beräknad per individ. Inkomster som riktar sig till hela hushållet, som ekonomiskt bistånd och bostadsstöd, har i förekommande fall delats upp på de vuxna i hushållet dividerat med personer som var folkbokförda både den 1 januari och den 31 december, och som tillhörde en familj med disponibel inkomst skild från noll kronor. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N00905","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-21"},"dct:provenance":{"@id":"_:39132b735ce4617809f02fda60d2cb8ed939f5369cd5bde780b080906c7528ea_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Mediannettoinkomst, kr/inv 20+"},"http://entryscape.com/terms/servedByDataService":