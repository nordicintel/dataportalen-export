ape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U17031_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kostnad per elev i kommunal gymnasieskola justeras genom multiplikation med en programvalsfaktor för den kommunala verksamheten. Programvalsfaktorn utgörs av kvoten mellan förväntad kostnad per elev i riket och i kommunens egen gymnasieskola, beräknade enligt riksprislistan för nationella program och kostnad per elev i introduktionsprogram enligt kostnadsutjämningen. Faktorn beräknas endast för kommuner som har elever i egen regi både det aktuella året och närmast föregående år. En hög strukturjusterad kostnad innebär att kostnadsläget är högt i kommunens verksamhet, då hänsyn tas till skillnader i programmix. "},"dct:identifier":"U17031","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:e753959978e9d1cb330ba2f72dd035fe53c13bde3629cb73f54fda1a4590d522_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Programvalsjusterad kostnad kommunal gymnasieskola, kr/elev"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U17031_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessServic