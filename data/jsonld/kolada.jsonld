ada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N17545","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N17545_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever som började på introduktionsprogram på gymnasium i kommunal regi i kommunen för tre år sedan med examen inom tre år dividerat med antal elever som började på introduktionsprogram på gymnasium i kommunal regi i kommunen för tre år sedan. Elever som vid utbildningens början saknar svenskt personnummer (t ex nyanlända elever som ännu inte blivit folkbokförda) ingår ej. Från och med år 2021 exkluderas IB elever. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N17545","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-30"},"dct:provenance":{"@id":"_:b7aae88405410e3a813bd8fa8584d105b3ee6e082a4a1c90388b20c43887d2ed_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Gymnasieelever med examen inom 3 år, introduktionsprogram kommunala skolor, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17545_