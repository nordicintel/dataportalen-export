//www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28606","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28606_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal personer i daglig verksamhet LSS som har svarat Några på frågan Pratar personalen med dig så att du förstår? dividerat med samtliga personer i daglig verksamhet LSS som har besvarat frågan. Svarsalternativen var Alla, Några, Ingen. Undersökningen är ej en totalundersökning varför resultatet för en kommun kan vara baserat på ett mindre antal brukares svar, dock minst fem. För en del kommuner ingår brukare i både kommunens egen regi och annan regi (privat/ideell), för en del endast brukare i egen regi och för andra endast brukare i annan regi. Undersökningen har genomförts med ett webbaserat verktyg för enkäter, anpassat till personer med funktionsnedsättning. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U28606","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:daa49018a95f1086093ebae7da6c8c08bd7e219529ffe292b7449e57aa97e338_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Brukarbedömning daglig verksamhet LSS - Några i personalen pratar så brukaren förstår, lägeskommun, andel (%) (-2024)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28606_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28606"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.o