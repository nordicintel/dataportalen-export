id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"En disponibel vårdplats definieras som en vårdplats i sluten vård med fysisk utformning, utrustning och bemanning som säkerställer patientsäkerhet och arbetsmiljö. Här redovisas alla disponibla vårdplatser för medicinsk korttidsvård belägna i länet, oavsett vem som driver enheten eller hur de finansieras, dividerats med 1000-tal invånare 31/12. Uppgiften avser genomsnittligt antal disponibla vårdplatser, d.v.s. det antal disponibla vårdplatser som genomsnittligt under året varit tillgängliga med hänsyn tagen till neddragningar, semesterstängningar, 5-dygnsvård m.m. För åren 1992-2000 avser uppgiften på förhand fastställda vårdplatser av huvudmannen. "},"dct:identifier":"N72817","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-27"},"dct:provenance":{"@id":"_:d0289f9f9588a5419acd2d63f98cba634b7f5c073f0c5ef16ae05fe524b37d3e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Disponibla vårdplatser medicinsk korttidsvård i regionen, antal/1000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N72817_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N72817"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/st