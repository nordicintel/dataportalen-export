ta-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Handläggningstid i dagar (median) från när ansökan betraktas som fullständig till beslut för bygglov. Uppgifterna avser ärenden om bygglov för nybyggnad av ett en- eller tvåbostadshus, där beslut om bygglov fattades under året. Uppgifterna gäller alla sådana ärenden, oavsett om de ligger inom eller utom detaljplanelagt område, inom eller utom område med områdesbestämmelser, eller om de omfattas av givet förhandsbesked. Uppgifterna gäller alla ärenden oavsett om bygglovsbeslutet var positivt eller negativt. Fritidshus ingår ej. Observera att datainsamling pågår hela hösten, varför medelvärden inte bör användas för jämförelser förrän i slutet av året. "},"dct:identifier":"N00821","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:3c39bed551af1bc48c5a30092015a1f2213a92cffda99d18fc12295e330dba53_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Handläggningstid (median) från när ansökan betraktas som fullständig till beslut för bygglov för nybyggnad av en- och tvåbostadshus, antal dagar (-2024)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N00821_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N00821"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@va