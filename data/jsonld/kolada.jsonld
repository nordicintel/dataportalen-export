authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal vuxna personer i länet som har besökt tandvården under den senaste tvåårsperioden dividerat med antalet vuxna invånare i länet. Med vuxen menas här personer som är över åldersgränsen för kostnadsfri tandvård för barn och unga. Jämförelser kan vara besvärliga eftersom åldersgränsen för kostnadsfri tandvård har ändrats och kan påverka jämförelser över tid. Uppgiften avser patientens hemregion, oavsett var besöket har skett. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N80700","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-25"},"dct:provenance":{"@id":"_:2696ac841fcfb3300d874dda8e3ba4adb0e89498bab4ad7628f5810720f47f6f_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Personer som besökt vuxentandvården senaste tvåårsperioden, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N80700_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N80700"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE22200