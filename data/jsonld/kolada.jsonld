ge":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U31900","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U31900_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nyckeln är ett mått på relativ socioekonomisk status. Den socioekonomiska sorteringsnyckeln ger en indikation om den relativa risken för ekonomiskt bistånd i kommunen jämfört med landets kommuner i stort, baserat på invånarnas arbetsmarknadsanknytning och inkomstnivå. För kommuner i grupp 1 indikeras en relativt låg risk och för kommuner i grupp 8 en relativt hög risk. T.o.m. 2012 var skalan 1-10 och baserad även på invånarnas utbildningsnivå. "},"dct:identifier":"U31900","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-17"},"dct:provenance":{"@id":"_:e0dd49f33e7ec0e8239101db99f2bc19a68b84da73cc170321c47d9b99384f9e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Socioekonomisk sorteringsnyckel, (skala 1-8, 1=låg risk, 8 = hög risk)."},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U31900_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.