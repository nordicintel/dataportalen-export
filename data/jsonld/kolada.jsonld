@id":"http://api.kolada.se/v3/kpi/N25807","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N25807_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Frågor ur brukarbedömning gällande äldreomsorg-hemtjänst normaliseras mot övriga kommuner. Därefter beräknas ett genomsnittsvärde för den enskilda kommunens samtliga normaliserade värden. Normaliseringen sker genom en percentilbaserad metod där värden skalas mellan 0 och 100 utifrån fördelningen bland samtliga kommuner. Värden under den 2,5:e percentilen sätts till 0 och värden över den 97,5:e percentilen sätts till 100, i syfte att minska påverkan från extrema värden. För nyckeltal där låga värden är att föredra inverteras skalan innan normalisering. De normaliserade nyckeltalen multipliceras med fördefinierade vikter innan de aggregeras till ett genomsnitt per kommun. Om aktuellt års värde saknas för vissa nyckeltal kan i vissa fall föregående års värde användas, beroende på nyckeltalets egenskaper. Det slutliga indexvärdet erhålls genom att de viktade genomsnittsvärdena normaliseras på nytt mot övriga kommuners värden och därefter begränsas till intervallet 0–100. "},"dct:identifier":"N25807","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-14"},"dct:provenance":{"@id":"_:8811b75a49c5f16c1dfdc4e48ece08d46f3536fae8fd14c756108163ff9ee3e1_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Index, brukarbedömning äldreomsorg, hemtjänst"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N25807_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N25807"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:8811b75a49c5f16c1dfdc4e48ece08d46f3536fae8fd14c756108163ff9ee3e1_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:8811b75a49c5f16c1dfdc4e48ece08d46f3536fae8fd14c756108163ff9ee3e1"},{"@graph":[{"@id":"_:8813a6d0c5094b77319c597bb6c1d97a69ef244e554c03cc8aaf2253666876bf_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@lan