ikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07346","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07346_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar på frågan: Vilka typer av välfärdsteknik finns tillgängliga i den kommunala hälso- och sjukvården?. Välfärdsteknik är digital teknik som syftar till att bibehålla eller öka trygghet, aktivitet, delaktighet eller självständighet för en person som har eller löper förhöjd risk att få en funktionsnedsättning. Frågan handlar om välfärdsteknik som kommunen tillhandahåller till den enskilda patienten genom förskrivning enligt Hälso- och sjukvårdslagen, eller att den på annat sätt införts som stöd för personalen eller organisationen, inte sådan teknik som tillhandahålls genom biståndsbeslut enligt socialtjänstlagen eller som den enskilde själv, eller dennes anhöriga köper på öppna marknaden. Med breddinfört menas att kommunen tagit beslut att alla inom målgruppen kan, eller kommer kunna, ta del av tekniken. Pilot eller testverksamhet innebär att det är ett initiativ som är begränsat i tid, i antal personer som kan använda tekniken, eller att det sker under särskilda förutsättningar. "},"dct:identifier":"U07346","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:provenance":{"@id":"_:47b9a0190e3090348f3a31a8981e5b66194d973a5550cbd35e40412b3998318d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Digitala medicinskåp finns tillgängligt inom den kommunala hälso- och sjukvården, (Breddinfört=2, testverksamhet=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07346_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07346"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:47b9a0190e3090348f3a31a8981e5b66194d973a5550cbd35e40412b3998318d_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/