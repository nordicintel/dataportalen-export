"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N11219","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N11219_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Anställda 55-64 år inom förskola (omfattar även pedagogisk omsorg, tom. 2021 ingick också fritidshem) dividerat med samtliga anställda inom samma verksamhetsområde, multiplicerat med 100 för redovisning i procent. Avser kommunalt anställda i november månad. Anställda inom kommunalförbund/kommunala bolag ingår inte. Från och med 2022 så redovisas inte viss personal (t.ex. elevhälsa ) i någon av verksamheterna inom förskolan/skola om personalen är gemensam mellan olika skolformer/förskola. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N11219","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:f0b2ceec409dedb66b18f3117cea57d4546f9385ea1b6f7a2400500c833594a8_b0n0"},"dct:publisher":{"@id":"http://data