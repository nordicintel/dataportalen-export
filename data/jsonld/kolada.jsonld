,"dct:description":{"@language":"sv","@value":"Källa: Socialstyrelsens kommun- och enhetsundersökning."}},{"@id":"_:a2809f95e2fcab59f47cef0ab6eb26d28110e84394fffa6efdd4d856ea658afe_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U23572","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U23572_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som Ja=1 och Nej=0, medan det på kommunnivå anges som andel (%) enheter där rutiner  finns för hur planering av den enskildes hälso- och sjukvård (vårdplanering) ska genomföras i samverkan med den enskilde och med den kommunala hälso- och sjukvårdspersonalen samt hemtjänstpersonalen. Rutinen ska vara beslutad på ledningsnivå och dokumenterad. Den ska vara aktuell dvs. uppföljd eller upprättad inom det senaste året. "},"dct:identifier":"U23572","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:a2809f95e2fcab59f47cef0ab6eb26d28110e84394fffa6efdd4d856ea658afe_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Aktuell rutin finns för schemalagda möten med sjuksköterska i frågor som rör personer med behov av kommunal hälso- och sjukvårdsinsatser i särskilt boende, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U23572_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U23572"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@langua