stöd) med varken pojkdominerad eller flickdominerad verksamhet, dividerat med totalt antal idrottsföreningar med LOK-stöd. LOK-stöd ges till föreningar med aktiviteter för stödberättigade deltagare 7-25 år (t.o.m. 2013 avsågs pojkar och flickor 7-20 år samt för handikappidrottare som är äldre än 20 år). Med varken pojkdominerad eller flickdominerad verksamhet avses att varken pojkarna eller flickorna svarar för mer än 60% av inrapporterade deltagaraktiviteter i föreningen. "},"dct:identifier":"U09807","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-11"},"dct:provenance":{"@id":"_:084720e3ff210645114789e8c069f5147e58304b4646e0ed0aaed3583a7451a0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Idrottsföreningar med varken pojk- eller flickdominerad verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U09807_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U09807"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande 