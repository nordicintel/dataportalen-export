d9ca13d_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Boverket (miljömålsenkäten)"}},{"@id":"_:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d_b1n0"},{"@id":"_:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d_b2n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U07524","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07524_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Svar från kommunen på frågan \"Har kommunen aktuella dokument för att främja miljöanpassade transporter och minskat transportbehov?\", där svarsalternativen \"Ja, kommunomfattande\" och \"Ja, för del av kommunen\" redovisas som Ja = 1 och svarsalternativen \"Nej, men arbete pågår\" och \"nej\" redovisas som Nej = 0. För att besvara frågan jakande ska kommunen ha ett eller flera dokument som sammantaget redovisar strategier och åtgärder för hur de fossilbränsledrivna transporterna i kommunen kan minska och de miljöanpassade och resurssnåla transportsätten stärkas samt hur transportbehovet kan minska. Dokumenten ska dessutom ange hur man genom fysisk planering kan bidra till detta. Det kan t.ex. handla om planering av gång- respektive cykelvägnät, nät och knutpunkter för kollektivtrafik och lokalisering av bebyggelse i förhållande till transportsystem och service. Exempel på sådana dokument är trafikstrategi för kommunen eller tätorten, cykelplan, klimat- och energistrategi och/eller kommunens översiktsplan om såväl strategier som åtgärder redovisas i denna. Med aktuellt underlag avses underlag/dokument som enligt kommunens bedömning inte är i behov av uppdatering. "},"dct:identifier":"U07524","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunen har aktuella dokument för att främja miljöanpassade transporter och minskat transportbehov (Ja=1, Nej=0) (-2021)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07524_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07524"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d_b2n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:21ad76e8dac7b85ab1ac13a063977d73e9ac2d7e05304f33287de8a54d9ca13d"},{"@graph":[{"@id":"_:21b581155f54a5c81173e24e59e0099f8b14ea40af4f6b9c33a5c249c45f3ad1_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SCB:s medborgarundersökning"}},{"@id":"_:21b581155f54a5c81173e24e59e0099f8b14ea40af4f6b9c33a5c249c45f3ad1_b1n0","@type":"http://www.w3.org/2006/vc