da.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N18636","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N18636_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever år T-2 som slutfört sin gymnasieutbildning med examen från ett yrkesprogram i fristående regi som år T studerar (oavsett var de studierna äger rum), dividerat med antal elever år T-2 som slutfört sin gymnasieutbildning med examen från yrkesprogram i fristående regi. För att räknas som studerande krävs att man varit registrerad på universitet, högskola eller annan form av studiemedelsberättigad utbildning, till exempel yrkeshögskola eller komvux,  samt erhållit någon form av studiemedel (oavsett hur mycket). Alternativt har avklarade högskolepoäng eller avklarade poäng från komvux samma år, samt att man inte är klassificerad som etablerad på arbetsmarknaden. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18636","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-22"},"dct:provenance":{"@id":"_:50b1fe27c627b8c12483bbbd13142e5adb53debaff47fc2403396963d960090e_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ungdo