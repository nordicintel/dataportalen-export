ation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00488","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00488_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"_:485757e1b0acce95562e3acd7cd38892b860a784f32ad91083cb6461cbf589e8_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avvikelse från modellberäknat värde för utvecklade bränder i byggnad (detta nyckeltal ersätter U00488 och är inte jämförbara). Modellberäkningen bygger på bebyggelsestruktur samt befolkningsvariabler. Modellberäkningen ställs mot indikatorn som anger byggnadsbränder med spridning från startobjektet. Uppgifterna har hämtats från Räddningsverkets insatsregister som bygger på de insatsrapporter som räddningstjänsterna utformar efter insatser/utryckningar. Registret innehåller bland annat alla insatser som den kommunala räddningstjänsten gjort till brand i byggnad. Med byggnad menas såväl bostäder som allmänna byggnader, industribyggnader mm. Med utvecklad brand avses sådana insatser där det fortfarande brinner när räddningstjänsten anländer. Räddningsverkets insatsregister fångar enbart sådana bränder som varit föremål för räddningsinsats. Antalet räddningsinsatser har sedan justerats med uppgifter från SCB om befolkningen i respektive kommun. Femårsmedelvärde (år T-4 till år T). "},"dct:identifier":"N00488","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-03"},"dct:provenance":{"@id":"_:485757e1b0acce95562e3acd7cd38892b860a784f32ad91083cb6461cbf589e8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Avvikelse från modellberäknat värde för byggnadsbränder med spridning från startobjektet, (Färre än=2, lika många=1, fler än=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N00488_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N00488"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:485757e1b