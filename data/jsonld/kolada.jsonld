ada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N18924"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bf849b97040e38c0008f630e59c23d4c32fa9f1a173fed187a021b467796ca8f_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:bf849b97040e38c0008f630e59c23d4c32fa9f1a173fed187a021b467796ca8f"},{"@graph":[{"@id":"_:bf8fe5c926847f976c35b767be038e9cbcb3b858e5ed0150669c90863bb4cd67_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Socialstyrelsens kommun- och enhetsundersökning."}},{"@id":"_:bf8fe5c926847f976c35b767be038e9cbcb3b858e5ed0150669c90863bb4cd67_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U23569","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U23569_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"För enhetsnivå anges värdet som Ja=1 och Nej=0, medan det på kommunnivå anges som andel (%) enheter där rutiner finns för hur  omsorgspersonalen ska agera vid misstanke/upptäckt av att  den enskilde är beroende av/missbrukar alkohol eller andra beroendeframkallande medel  (ej läkemedel). Rutinen ska vara beslutad på ledningsnivå och dokumenterad. Den ska vara aktuell dvs. uppföljd eller upprättad inom det senaste året. Beroende innebär att man har behov av allt större dos av en viss substans för att uppnå förväntad effekt och att man får abstinensbesvär när man upphör att använda substansen. Missbruk betecknas som bruk av substanser på ett sätt som skadar hälsan. Skadan kan vara fysisk eller psykisk. Trots återkommande problem fortsätter man att använda substansen. Med andra beroendeframkallande medel avses här följande narkotiska preparat: cannabis (hasch, marijuana), centralstimulantia (amfetamin, kokain m.fl.) hallucinogener (ecstacy, meskalin, GHB m.fl.). Rutiner innebär att personalen vet vem eller vilka personer som kontaktas när det finns behov av eller stöd för ställningstagande till lämplig åtgärd. Det kan handla om kontakt med enhetschefen, ansvarig biståndshandläggare eller sjuksköterska. Rutinerna beskriver ett i förväg bestämt tillvägagångssätt för hur en aktivitet ska genomföras. Här avses egna lokala skriftliga rutiner eller gemensamma skriftliga rutiner som kommunen har tagit fram för sina verksamheter. "},"dct:identifier":"U23569","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:bf8fe5c926847f976c35b767be038e9cbcb3b858e5ed0150669c90863bb4cd67_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Aktuell rutin vid misstanke/upptäckt av att den enskilde har ett skadligt bruk eller beroende av alkohol eller andra beroendeframkallande medel (ej läkemedel) i särskilt boende, äldreomsorg, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U23569_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U23569"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bf8fe5c926847f976c35b767be038e9cbcb3b858e5ed0150669c90863bb4cd67_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:bf8fe5c926847f976c35b767be038e9cbcb3b858e5ed0150669c90863bb4cd67"},{"@graph":[{"@id":"_:bf92f1dc272a1ab7f7a36cf87fffe30b9a2d0e05bdaa8e87875b1570d73489d3_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SCB."}},{"@id":"_:bf92f1dc272a1ab7f7a36cf87fffe30b9a2d0e05bdaa8e87875b1570d73489d3_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N21013","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N21013_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Standardkostnad (kr/inv 1 nov fg år) för vård och omsorg enl SoL/HSL till personer 65-w år beräknad enl det kommunala utjämningssystemet. Standardkostnaden för äldreomsorg beräknas utifrån antalet sammanboende respektive ensamboende i åldersgrupperna 65–79, 80–89 samt 90 år och uppåt. Kommunens åldersersättning beräknas genom andelen invånare i respektive grupp multiplicerad med en fastställd normkostnad för gruppen. Vidare tillkommer tillägg eller avdrag för skillnader i: hemtjänst i glesbygd, institutionsboende i glesbygd, språk, ohälsa samt lönekostnader. Ny kostnadsutjämning från 2020 påverkar standardkostnaderna från 2020. "},"dct:identifier":"N21013","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:bf92f1dc272a1ab7f7a36cf87fffe30b9a2d0e05bdaa8e87875b1570d73489d3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Standardkostnad vård och omsorg om äldre, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N21013_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N21013"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:bf92f1dc272a1ab7f7a36cf87fffe30b9a2d0e05bdaa8e87