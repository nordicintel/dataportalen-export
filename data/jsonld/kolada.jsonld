":"sv","@value":"Årsarbetare, antal kommunalt anställda förskollärare. Antalet årsarbetare räknas fram med hjälp av den faktiska sysselsättningsgraden för månadsavlönade och arbetade timmar för timavlönade. Årsarbetare anger hur många anställda kommunen skulle ha haft om den faktiska sysselsättningsgraden för månadsavlönade och arbetade timmar för timavlönade summerades till heltidsanställningar. Anställda inom kommunalförbund/kommunala bolag ingår inte. "},"dct:identifier":"N10029","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-15"},"dct:provenance":{"@id":"_:67de7d4c3f9e99749b7ad5f1d30904a4e411a44bcb611483ce5bb0a55295d575_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Årsarbetare, kommunalt anställda förskollärare, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N10029_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N10029"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"