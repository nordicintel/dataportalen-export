":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Den totala mängden serveringssvinn per ätande i gymnasieskola under mätperioden. Serveringssvinn är mat från serveringen som inte nått matgästens tallrik och som slängs för att den inte kan tas tillvara. Det kan till exempel vara mat från en bufféservering eller en serveringslinje i skolrestaurangen, eller kantiner och karotter som maten serveras ur. För att kommunen ska få ett värde måste minst 50% av eleverna ätit under mätperioden. Undersökningen genomförs vartannat år. "},"dct:identifier":"U50127","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-15"},"dct:provenance":{"@id":"_:12aa1fbfc991733c837c56dd6ec18472d05736f9a8f752b4eeeb426bdbeb2dbd_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Serveringssvinn, gymnasieskola, gram/ätande"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U50127_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U50127"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language