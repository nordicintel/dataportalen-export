uropa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U23505","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U23505_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ett medelvärde av följande mått från brukarundersökningen till invånare 65+ i särskilt boende: Andel som svarat \"Ja, alltid\" eller \"Oftast\" på frågan om de får ett bra bemötande från personalen, andel som svarat \"Mycket tryggt\" eller \"Ganska tryggt\" på frågan om de är trygga med personalen, samt andel som svarat \"Ja, för alla\" eller \"Ja, för de flesta\" på frågan om de har förtroende för personalen som kommer hem till dem. Fram till och med 2022 beräknades medelvärdet enbart på andelarna som svarat \"Ja, alltid\" och \"Mycket trygg\" på de första två frågorna vilket förklarar skillnaderna i värde mellan år 2022 och 2023. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U23505","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-16"},"dct:provenance":{"@id":"_:fa9f1e69e0dff854b1813176dd2de48930890fed0