escription":{"@language":"sv","@value":"Antal årsarbetare totalt med pedagogisk högskoleexamen (förskollärar-, fritidspedagog- respektive lärarexamen) totalt som arbetar med barn i förskola dividerat med totalt antal årsarbetare i förskolan. Avser både kommunal och fristående regi. Uppgiften avser läsår, mätt 15/10. Från 2014 hämtas uppgifter om personalens utbildningsnivå från SCB:s utbildningsregister. Tidigare lämnade kommunerna uppgifter på gruppnivå. Dessa uppgifter är inte jämförbara och finns därför i två olika nyckeltal. "},"dct:identifier":"N11023","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-20"},"dct:provenance":{"@id":"_:41af9bcf9049b77af7baeebbe65b9e415b91c42b17ade6c5be1feac0937c18e8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Årsarbetare i förskolan med pedagogisk högskoleexamen, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N11023_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N11023"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@l