eStatement","dct:description":{"@language":"sv","@value":"Källa: Skolverket"}},{"@id":"_:a640d1ff93602fc019960b67cf1948ab513041820587806b3975902cffc312d6_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N18958","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N18958_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel elever som arbetar året efter avslutad utbildning på gymnasial nivå. Data avser elever som avslutat sina studier på komvux år T-1. Elever med avslutad utbildning avser alla som har ett kursslut utan avbrott och som inte återfinns i komvux de två efterföljande åren. De elever som har utvandrat avslutsåret eller de två efterföljande åren samt de som har felaktiga eller tillfälliga personnummer har exkluderats. De elever som inkluderas på gymnasial nivå är alla elever som har läst minst en gymnasial kurs avslutningsåret. Uppgifterna om antal studerande respektive arbetande elever året efter avslut av komvuxutbildning är tagna från Skolverkets Etableringsmått. I uppgifterna om arbetande inkluderas endast etablerade, dvs. de med förvärvsinkomst på (eller över) skolverkets övre inkomstgräns (år 2022 var den 224 100 kr/år), Sysselsatt enligt sysselsättningsregistrets definition (november månad), ingen förekomst av arbetslöshet på hel-/deltid eller arbetsmarknadspolitiska åtgärdsstudier under året. I den gamla definitionen av måttet inkluderades både etablerad, osäker ställning samt svag ställning i uppgifterna om arbetande . Avser lägeskommun. "},"dct:identifier":"N18958","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-30"},"dct:provenance":{"@id":"_:a640d1ff93602fc019960b67cf1948ab513041820587806b3975902cffc312d6_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ny definition - Personer som arbetar året efter avslutad utbildning i komvux, gymnasial nivå, i huvudmannens skolenheter, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N18958_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"