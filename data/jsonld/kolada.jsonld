Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Modellberäknade genomsnittliga meritvärden har tagits fram av Skolverket i en regressionsmodell där kommunerna jämförs med övriga kommuner och där hänsyn tagits till föräldrarnas sammanvägda utbildningsnivå, andel pojkar, andel elever födda utomlands, samt andel elever födda i Sverige med båda föräldrar födda utomlands. För kommunnivå avser uppgifterna endast elever i kommunens kommunala skolor, medan det på enhetsnivå även har tagits med skolor i annan regi i kommunen. Fr.o.m. 2013 så redovisas värdena endast på skolnivå samt redovisningen av utländsk bakgrund ersatts av andel nyinvandrade elever. Som nyinvandrad elev räknas de elever som kommit till Sverige första gången under de senaste fyra åren. "},"dct:identifier":"U15415","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-01-30"},"dct:provenance":{"@id":"_:0345c5791139d93c6fe70c62785c74953c5928189187d14e9c690ea88641ffde_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Meritvärde i åk. 9, modellberäknat genomsnittligt värde (SALSA)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U15415_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U15415"},"dct:forma