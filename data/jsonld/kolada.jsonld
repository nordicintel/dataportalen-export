//api.kolada.se/v3/kpi/N15061","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N15061_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Lokalkostnad kommunal grundskola F-9 dividerat med medelvärde av antal elever i kommunens grundskola åk F-9 i egen regi. Kostnader för såväl egna som hyrda lokaler, inklusive kostnader för inventarier. Med lokalkostnader avses kostnader för lokaler och inventarier i form av direkta kostnader, fördelade lokalkostnader, externa och interna hyror, driftkostnader för värme, underhåll, städning m.m. samt kapitalkostnader för lokaler och de inventarier som inte räknas som lärverktyg. Kostnad för vaktmästare avseende fastighetsskötsel redovisas här. Om lokalerna utnyttjas även för annan verksamhet än skolverksamhet, ska endast de kostnader som avser skolverksamheten redovisas. Kostnader för skolbänkar, möbler, textilier etc. redovisas som lokal- och inventariekostnad medan kostnader för t.ex. symaskiner och hyvelbänkar m.m. anses vara lärverktygskostnader. Elevhemsboende redovisas under Bostadsverksamhet. Uppgiften avser kalenderår, mätt 31 december. Elever i internationella skolor samt integrerade elever från anpassad grundskola är inkluderade nämnaren. "},"dct:identifier":"N15061","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:280bb2bc47a6b4b8c0f8787f55bc983f0435a554f87160a924d82e575b711720_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kostnad för lokaler i kommunal grundskola F-9, kr/elev"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N15061_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N15061"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:280bb2bc47a6b4b8c0f8787f55bc983f0435a554f87160a924d82e575b711720_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@i