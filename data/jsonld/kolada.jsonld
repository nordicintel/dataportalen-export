yscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N45904_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/ECON"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Total elproduktion av vindkraft, oavsett producent. Produktion i megawattimmar (MWh). Både landbaserade och havsbaserade verk ingår i statistiken. En kommuns antal verk beräknas inte på exakta koordinater (vid kommungräns) för verkets placering (även om det till stor del överensstämmer) utan istället prioriteras ägandeskap med tanke på registrering och anslutningspunkten för verket. Statistiken bygger på data från Elcertifikatssystemet och systemet för ursprungsgarantier. Elcertifikat erhålls i femton år, och därefter kan kraftproducenterna ansöka om ursprungsgarantier. Det är dock inte alla producenter som ansöker om ursprungsgarantier. Tillförlitligheten påverkas således av att inte alla vindkraftverk ingår i dessa system. "},"dct:identifier":"N45904","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-06"},"dct:provenance":{"@id":"_:9787ab6bf259d823210e4c66b763e74b646a710ac7d96876c7e415b61b2edba0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Elproduktion från vindkraft, MWh"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"h