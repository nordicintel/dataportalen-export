/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel utrikes födda i åldern 18-64 år bland regionens månad- och timavlönade dividerat med andel utrikes födda i åldern 18-64 år i regionens befolkning. Samma andel utrikes födda bland de regionanställda som i länets befolkning ger balanstalet 1. Ett tal högre än 1 visar på en högre andel utrikes födda bland anställda än i befolkningen och ett tal mindre än 1 visar omvänt på en lägre andel än i befolkningen. Avser regionanställda i november månad enligt HÖK. Regionägda bolag ingår under respektive region. "},"dct:identifier":"N60085","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-26"},"dct:provenance":{"@id":"_:fd38b7b887d329d0678db24dfa65320c7eccc43ac7fedf2ba4eefcfbc0ae0233_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Anställda utrikes födda, region, balanstal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N60085_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N60085"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocac