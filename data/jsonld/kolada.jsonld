Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N01986","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N01986_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal mottagna i flyktingmottagandet enligt ersättnings ersättningsförordningen 2010:1122 om statlig ersättning för insatser för vissa utlänningar, som en kommun har börjat få ersättning för av Migrationsverket (Statistiken visar endast de som första gången tagits emot i en kommun. Vidareflyttade, med eller utan Arbetsförmedlingens hjälp, inkluderas ej). Som kommunmottagen räknas de utländska medborgare som beviljats uppehållstillstånd i Sverige som flyktingar, skyddsbehövande, efter synnerligen ömmande omständigheter eller som anhöriga. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N01986","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-07"},"dct:provenance":{"@id":"_:f900ea6b952451d8c3b7df3b3be1c518563ba1a6ef6337bcfd323c8cf4cae7e2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kommunmottagna i flyktingmottagandet med uppehållstillstånd, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http:/