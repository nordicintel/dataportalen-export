ity/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal ställföreträdaruppdrag där ställföreträdaren begärt att arvode inte ska tas ut, dividerat med antal ställföreträdarskap. Med ställföreträdaruppdrag/-skap avses gode män enligt föräldrabalken 11 kap 1-4§, gode män för ensamkommande barn, förvaltare enlig föräldrabalken 11 kap 7§ samt förmyndare enligt föräldrabalken 10 kap. Uppgifter per den 31/12 T. Flera kommuner har ett kommunövergripande samarbete. Överförmyndarnämndens resultat fördelas på den enskilda kommunen efter befolkningsmängd. "},"dct:identifier":"U37001","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-09-01"},"dct:provenance":{"@id":"_:49f215a027de252fed741d3267e50eb76a72d9dcb60d99e47b53a39e63f012e3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ställföreträdaruppdrag där arvode inte tas ut, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U37001_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U37001"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{