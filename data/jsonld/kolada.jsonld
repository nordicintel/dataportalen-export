e/om-oss/api/"}}],"@id":"urn:source:7f7a181f66fbc68cdd351873945951613d48c47bd15e94dd0a5ba7a8b86cb71a"},{"@graph":[{"@id":"_:7f92cfb0d19616d104ab6953c78453b2edecbc4514580990b71cf2679c1c8260_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Folkhälsomyndigheten, Hälsa på lika villkor (HLV) samt Liv & Hälsa (LH)"}},{"@id":"_:7f92cfb0d19616d104ab6953c78453b2edecbc4514580990b71cf2679c1c8260_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U01404","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U01404_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Två olika undersökningar med jämförbara resultat är inkluderade i statistiken. Uppsala, Sörmland, Västmanland, Värmland och Örebro (den sk. CDUST-regionen) har Liv & Häsla (LV) som datakälla och avser år T med urval av invånare 18-84 år. Resten av landet har källa folkhälsomyndigheten (HLV), och med urval på invånare 16-84 år och avser år T-3 till år T. Ett summaindex beräknas utifrån de tre första frågorna om alkoholkon-sumtion: \"Hur ofta har du druckit ...\", \"Hur många \"glas\"...\", \"Hur ofta [...] sex \"glas\" ...\". Se enkätformulär för detaljer. Första och tredje frågan får poängen 4, 3, 2, 1, 0 och den andra frågan får 0, 1, 2, 3, 4 och svarsalternativet vet inte räknas som internbortfall. Poängen från de tre frågorna summeras så att bortfall på en av frågorna inte betyder att det blir bortfall för summaindexet. Indexet kan anta värdet 0-12. Män med en summa på 6-12 poäng räknas som riskkonsumenter av alkohol. Motsvarande gräns är för kvinnor är 5-12 poäng. Lägre gränsvärden ger orealistiskt höga andelar riskkonsumenter. Män med en summa på 6-12 poäng och kvinnor med 5-12 poäng, enligt summaindexet ovan dividerat med antal som besvarat frågan.  Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U01404","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-16"},"dct:provenance":{"@id":"_:7f92cfb0d19616d104ab6953c78453b2edecbc4514580990b71cf2679c1c8260_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Invånare 16-84 år med riskabla alkoholvanor, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U01404_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U01404"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7f92cfb0d19616d104ab6953c78453b2edecbc4514580990b71cf2679c1c8260_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:7f92cfb0d19616d104ab6953c78453b2edecbc4514580990b71cf2679c1c8260"},{"@graph":[{"@id":"_:7f96d68aaae0f44c2f99da22fa3d6e3c2913a15a32c4cbc3dc77f374a2384bbf_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Skolverket"}},{"@id":"_:7f96d68aaae0f44c2f99da22fa3d6e3c2913a15a32c4cbc3dc77f374a2384bbf_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N17692","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N17692_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Genomsnittlig betygspoäng (GBP) beräknas genom att poäng tilldelas för vart och ett av en elevs kursbetyg. Betyget A i en kurs ges värdet 20 poäng, betyget B 17,5 poäng, betyget C 15 poäng, betyget D 12,5 poäng, betyget E 10 poäng samt betyget F 0 poäng. Poängen per kurs multipliceras med kursernas omfattning i gymnasiepoäng. Summan av de viktade kurspoängen divideras sedan med den totala mängden gymnasiepoäng som eleven betygssätts i från F till A (gymnasiearbetet och kurser lästa inom utökat program ingår inte i beräkningen). Observera att genomsnittlig betygspoäng inte är samma mått som meritpoängen som används vid antagning till universitet och högskolor. Nytt nyckeltal fr.o.m. 2022. Ersätter tidigare nyckeltal (N17488) som beskriver GBP för elever med examen eller studiebevis om 2 500 poäng. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N17692","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-27"},"dct:provenance":{"@id":"_:7f96d68aaae0f44c2f99da22fa3d6e3c2913a15a32c4cbc3dc77f374a2384bbf_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Genomsnittlig betygspoäng, gymnasieelever med examen, lägeskommun"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N17692_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N17692"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation