"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Huvudmannaskapet för hemsjukvården skiljer sig åt över landet. Om kommunen tagit över hemsjukvården helt eller delvis från regionen ingår dessa kostnader i det ordinära boendet och nyckeltalsvärdet är då 1. Om regionen är ensam huvudman är nyckeltalsvärdet 0. Med hemsjukvård avses  hälso- och sjukvård när den ges i patients bostad eller motsvarande och där ansvaret för de medicinska åtgärderna är sammanhängande över tiden. "},"dct:identifier":"N21900","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-15"},"dct:provenance":{"@id":"_:390cbe7192663fe0291d887cd363ba1ec43de145cdc2cb55309f23af9caa338c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Huvudmannaskap hemsjukvård?, (Ja=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N21900_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N21900"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:r