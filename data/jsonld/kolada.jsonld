.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N07403","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N07403_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser summering av: Försök till mord eller dråp, Misshandel inkl. grov, Våldtäkt inkl. grov, Grov kvinnofridskränkning, Grov fridskränkning, Våld mot tjänsteman och Rån inkl. grovt. Antalet anmälda brott divideras med antal invånare och multipliceras med 100 000. Kommunstatistiken baseras på uppgift om brottsplats. I vissa fall saknas uppgift om brottsplats för det anmälda brottet vilket ger ett bortfall i kommunstatistiken. Bortfallet kan variera i storlek från år till år och bör därför betraktas vid tolkning av eventuella ökningar eller minskningar över tid i kommunerna. "},"dct:identifier":"N07403","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-03-31"},"dct:provenance":{"@id":"_:35dfc40ba571d64825a0a737c6dd1f8bb7cb18