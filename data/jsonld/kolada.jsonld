dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal deltagartillfällen i åldern 17-20 år i LOK-stödsberättigade idrottsföreningar under året, dividerat med antal invånare 17-20 år den 31/12. Deltagartillfällen är summan av antalet närvarande deltagare i av RF godkända sammankomster för vilken föreningen sökt LOK-stöd (Statligt lokalt aktivitetsstöd). LOK-stödet ges till aktiviteter för pojkar och flickor 7-20 år. Stöd ges även till handikappidrottare som är äldre än 20 år, men detta är exkluderat i denna sammanräkning. En sammankomst är en ledarledd gruppaktivitet inriktad mot föreningens idrottsliga verksamhet. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"U09803","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-11"},"dct:provenance":{"@id":"_:89fb42070de41fd6fe1ff90d604b843df17e9af4b7f05c7da24814dc3d045387_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagartillfällen i idrottsföreningar, antal/inv 17-20 år"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U09803_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U09803"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publ