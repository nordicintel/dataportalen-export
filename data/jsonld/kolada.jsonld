8612","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N18612_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever år T-2 som var folkbokförda i kommunen som avslutat med studiebevis från gymnasiet som år T var etablerade på arbetsmarknaden, delat på antal elever år T-2 som var folkbokförda i kommunen som avslutat med studiebevis från gymnasiet. Etablerad på arbetsmarknaden är den som är sysselsatt enligt sysselsättningsregistrets definition (november månad) och inte har några händelser som indikerar arbetslöshet eller arbetsmarknadspolitiska åtgärder som inte är att betrakta som sysselsättning. Aktuell gräns för den arbetsinkomst som krävs för att räknas som sysselsatt återfinns hos Skolverket. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18612","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-22"},"dct:provenance":{"@id":"_:137fafaa2818f9518afacd56c8664ea52d3e1574a9c27140885caa5d1bfbb37c_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ungdomar som är etablerade på arbetsmarknaden 2 år efter studiebevis från gymnasiet, hemkommun, andel (%)"},"http://entryscape.com/terms