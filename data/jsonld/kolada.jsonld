.kolada.se/v3/kpi/N79720","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N79720_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal tyngdtäcken som föskrivits (förskrivning är en åtgärd för att förse en person med hjälpmedel). Tyngdtäcke är en alternativ åtgärd för personer med demenssjukdom, beteendemässiga och psykiska symtom samt sömnstörningar. Tyngdtäcken (bolltäcke eller kedjetäcke) är till för att lindra oro och sömnsvårigheter. Täcket har insydda bollar eller kedjor, vilket kan upplevas såväl rogivande, eftersom tyngden stimulerar centrala nervsystemet, som avstressande, eftersom det ger taktil stimulans för kroppen. Tyngdtäcken kan även upplevas ge en trygghetskänsla eftersom de tydliggör kroppens gränser.  ISO-kod: 042718. "},"dct:identifier":"N79720","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-17"},"dct:provenance":{"@id":"_:0dfeb3accdac6a2b9b849f4dcf6bf39f1f3958c560fcfe449ea97ed159ae7cb9_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Förskrivna tyngdtäcken, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79720_json","@type":["dcat:Distribution","http://entryscape.com/term