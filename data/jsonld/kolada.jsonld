om/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N25806_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Frågor ur brukarbedömning gällande individ- och familjeomsorg normaliseras mot övriga kommuner. Därefter beräknas ett genomsnittsvärde för den enskilda kommunens samtliga normaliserade värden. Normaliseringen sker genom en percentilbaserad metod där värden skalas mellan 0 och 100 utifrån fördelningen bland samtliga kommuner. Värden under den 2,5:e percentilen sätts till 0 och värden över den 97,5:e percentilen sätts till 100, i syfte att minska påverkan från extrema värden. För nyckeltal där låga värden är att föredra inverteras skalan innan normalisering. De normaliserade nyckeltalen multipliceras med fördefinierade vikter innan de aggregeras till ett genomsnitt per kommun. Om aktuellt års värde saknas för vissa nyckeltal kan i vissa fall föregående års värde användas, beroende på nyckeltalets egenskaper. Det slutliga indexvärdet erhålls genom att de viktade genomsnittsvärdena normaliseras på nytt mot övriga kommuners värden och därefter begränsas till intervallet 0–100. "},"dct:identifier":"N25806","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-14"},"dct:provenance":{"@id":"_:7a29a529f0cd29307b2b61a25df0a1ff1732997dd4907206e147e410f9eea2e2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Index, brukarbedömning, ekonomiskt bistånd IFO"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N25806_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N25806"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:7a29a529f0cd29307b2b61a25df0a1ff1732997dd4907206e147e410f9eea2e2_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:7a29a529f0cd29307b2b61a25df0a1ff1732997dd4907206e147e410f9eea2e2"},{"@graph":[{"@id":"_:7a2a6cba0f7ae2f9e4a5bded42e542ec5134374009967a4a17ac64e3c5426b5e_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@langua