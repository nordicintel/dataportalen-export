lyser - Kolada",{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för primärvård (exklusive kostnader för läkemedel inom läkemedelsförmånen), dividerat med antal invånare i regionen den 31/12. Primärvårdsansluten hemsjukvård är inkluderat. Med nettokostnad avses bruttokostnad minus bruttointäkt. Avser hälso- och sjukvårdsverksamhet som utan avgränsning vad gäller sjukdomar, ålder eller patientgrupper svarar för befolkningens behov av grundläggande medicinsk behandling, omvårdnad, förebyggande arbete och rehabilitering och som inte kräver sjukhusens medicinska och tekniska resurser. "},"dct:identifier":"N71019","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:02377afc10511c77e458229166b79a360c90490aa00d1370280848dc36950522_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad primärvård totalt (exkl. läkemedel), kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N71019_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N71019"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information 