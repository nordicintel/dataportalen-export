blications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal kursdeltagare i komvux på grundläggande nivå som har avslutat kurs med godkända betyg, dividerat med antal kursdeltagare som avslutat eller avbrutit kurs i komvux på grundläggande nivå. Kursdeltagare som läst orienteringskurser, samt kursdeltagare vars kurser fortsätter under nästa kalenderår är exkluderade ur nämnaren. En kursdeltagare kan räknas flera gånger om hen deltagit i mer än en kurs under perioden. Avser kursdeltagare i huvudmannens skolenheter. "},"dct:identifier":"N18944","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-11"},"dct:provenance":{"@id":"_:0244dde50234fc5c8f5943689b395258290c2255a068f7e4198f5f94df9e5514_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kursdeltagare i komvux på grundläggande nivå som har avslutat med godkända betyg, i huvudmannens skolenheter, andel av de som avslutat eller avbrutit kurs under året (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N18944_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N18944"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"f