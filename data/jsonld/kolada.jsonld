i/N40011_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Nettokostnad för arbetsmarknadsåtgärder, dividerat med antal invånare i kommunen 31/12. Med nettokostnad avses bruttokostnad minus bruttointäkt. Avser kommunens sysselsättningsfrämjande insatser och arbetsmarknadsåtgärder som finansieras helt eller delvis av kommunen. Här ingår personal på arbetsmarknadsverksamheten och arbetssökande som deltar i arbetsmarknadsåtgärder eller som fått kommunala anställningar, vilka erbjuds i syfte att mildra verkningarna av arbetslöshet. Även kommunens kostnader för arbetsmarknadsinsatser inom samordningsförbund ingår. Avser samtlig regi. "},"dct:identifier":"N40011","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:c5fea8efabdaaccea53756eca2828ab305b09a89fc2cc6f1533834d6c346b07b_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad arbetsmarknadsåtgärder, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N40011_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N40011"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creative