at:distribution":{"@id":"http://api.kolada.se/v3/kpi/U07356_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Ingen/färre än hälften=0, ca hälften= 1, mer än hälften=2, alla=3 . Svar på frågan: I kommunala verksamheter, hur stor andel av den mobila legitimerade hälso- och sjukvårdspersonalen har tillgång till utrustning för att kunna dokumentera mobilt i kommunens verksamhetssystem, t.ex. vid hembesök hos patient?. Inom den kommunala hemsjukvården i ordinärt boende finns personal som besöker patienter i hemmet. Vid dessa besök kan de ha behov av att dokumentera vad som framkommit vid besöket. För att dokumentera mobilt finns olika lösningar; mobiler, surfplattor, digitala pennor och bärbara datorer. Frågan avser hälso- och sjukvårdspersonal med mobila arbetsuppgifter - hälso- och sjukvård i ordinärt boende. "},"dct:identifier":"U07356","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-03"},"dct:provenance":{"@id":"_:9cfd8d43bd96280eb80038190e794e94944d79bcbbc041492a9a296047d09ca7_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Den mobila legitimerade hälso- och sjukvårdspersonalen i kommunala verksamheter har tillgång till utrustning för att kunna dokumentera mobilt i kommunens verksamhetssystem vid t.ex. hembesök"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U07356_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U07356"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:9cfd8d43bd96280eb80038190e794e94944d79bcbbc041492a9a296047d09ca7_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:9cfd8d43bd96280eb80038190e794e94944d79bcbbc041492a9a296047d09ca7"},{"@graph":[{"@id":"_:9d058434b44730b5b282ff938964aca23c58df53d2046548b1d9ba449097e9f6_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: SCB:s medborgarundersökning"}},{"@id":"_:9d058434b44730b5b282ff938964aca23c58df53d2046548b1d9ba449097e9f6_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://w