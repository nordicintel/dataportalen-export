tryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28142","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28142_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Med rutin avses en beskrivning av ett bestämt tillvägagångssätt för hur aktiviteter ska genomföras samt ange ansvarsfördelningen. Rutinen ska vara känd och användas av ansvarig personal. Det innebär till exempel att personalen vet vem eller vilka personer som kontaktas när det finns behov av eller stöd för ställningstagande till lämplig åtgärd. Observera att dessa rutiner inte ersätter den rapporteringsskyldighet som föreligger enligt bestämmelserna i Lex Sarah. Med ledningsnivå avses här den nivå inom organisationen som har mandat att besluta om rutiner. Det kan handla om egna lokala skriftliga rutiner eller gemensamma skriftliga rutiner som vårdgivaren eller kommunen har tagit fram för sina verksamheter. Med personal avses här all personal som ger insatser vid boendet. Beroende innebär att man har behov av allt större dos av en viss substans för att uppnå förväntad effekt och att man får abstinensbesvär när man upphör att använda substansen. Missbruk betecknas som bruk av substanser på ett sätt som skadar hälsan. Skadan kan vara fysisk eller psykisk. Trots återkommande problem fortsätter man använda substansen. Med andra beroendeframkallande medel avses här följande narkotiska preparat; cannabis (hasch, marijuana), centralstimulantia (amfetamin, kokain m.fl. ), hallucinogener (Ecstacy, meskalin, GHB m.fl.). På kommunnivå uppges andel enheter som uppfyllt indikatorn, dvs. Ja. På enhetsnivå är Ja=1, Nej=0. "},"dct:identifier":"U28142","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:ca893982e1ebabc86946e1b4105db9af7cf05b16c31d470ec008bd573779b6c2_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Rutin för personalens agerande vid misstanke/upptäckt av att den enskilde har skadligt bruk eller beroende av alkohol eller andra beroendeframkallande medel (ej läkemedel), daglig verksamhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28142_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U28142"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.e