/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal vårdtillfällen per 100 000 invånare 65-74 år (avser medelbefolkningen under året). Vårdtillfälle: Sammanhängande tid för vård avgränsad av patientens intagning och utskrivning i sluten vård på samma klinik. Uppgifterna avser det totala vårdutnyttjandet för regionens befolkning, dvs oavsett var vården har skett. Fördelning på kön, ålder och huvuddiagnos enligt sjukdomsklassifikationen (ICD-10) finns presenterat här: www.socialstyrelsen.se/statistik/statistikdatabas. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N70813","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-08"},"dct:provenance":{"@id":"_:0fea0b500a7d50c579f6bdae065b6d53ac24862ea869936bf52009ba26512a82_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Vårdtillfällen i åldersgruppen 65-74 år, antal/100 000 inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N70813_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N70813"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf