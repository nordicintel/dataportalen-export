me/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel förskollärare i kommunen  som har svarat \"I mycket stor utsträckning\" eller \"I ganska stor utsträckning\" på frågan \"I vilken utsträckning anpassar din förskola utbildningen för att kompensera barn från resurssvaga hemförhållanden så att de får samma förutsättningar att lära och utvecklas som andra barn?\". Frågan avser mäta hur förskolan arbetar med det kompensatoriska uppdraget. Enkäten har besvarats av legitimerade förskollärare verksamma i kommunala förskolor. "},"dct:identifier":"U11539","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-12-11"},"dct:provenance":{"@id":"_:d004e1e72ec511b07d5da1fcb050aa60b6d6f46a297ec5470453c2b596bdd4b8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Förskollärarenkäten: Utbildningen anpassas för att kompensera barn från resurssvaga hemförhållanden, andel positiva svar (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U11539_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U11539"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availab