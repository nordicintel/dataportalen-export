:"http://api.kolada.se/v3/kpi/U40464","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U40464_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal deltagare som svarat alternativen \"Till mycket stor del\" eller \"Helt och hållet\" på frågan \"Har det stöd du fått hjälpt dig att utveckla sätt att hantera din situation?\" dividerat med samtliga deltagare som svarat på frågan. Samtliga svarsalternativ är \"Inte alls\", \"Till liten del\", \"Delvis\", \"Till stor del\", \"Till mycket stor del\", \"Helt och hållet\". Frågan ställs till deltagare som fått insatser med finansiering eller stöd av Finansiell samordning (Finsam) vid avslut. Syftet är att mäta om deltagarna upplever att den kan hantera symtom och funktionsnedsättning samt att den fått stöd från myndigheterna att leva med detta. Finansiell samordning sker genom samordningsförbund där det kan ingå en eller flera kommuner och undersökningen sammanställs på samordningsförbundsnivå. Kommuner som ingår i samma samordningsförbund har därför samma värde. "},"dct:identifier":"U40464","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-02-02"},"dct:provenance":{"@id":"_:d35a3ff3ce9bae9402bcf46a9552e4c5efb80980f9f613df9febec10ed260600_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Deltagarbedömning Finsam - Stödet har hjälpt deltagaren att hantera sin situation, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U40464_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/U40464"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för främjande av kommunala analyser - Kolada"}]},{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada","@type":"http://www.w3.org/2006/vcard/ns#Organization","http://www.w3.org/2006/vcard/ns#fn":"Rådet för främjande av kommunala analyser","http://www.w3.org/2006/vcard/ns#hasAddress":{"@id":"_:d35a3ff3ce9bae9402bcf46a9552e4c5efb80980f9f613df9febec10ed260600_b1n0"},"http://www.w3.org/2006/vcard/ns#hasEmail":{"@id":"mailto:rka@rka.nu"}},{"@id":"https://www.kolada.se/om-oss/api/","@type":"foaf:Document","dct:title":{"@language":"sv","@value":"https://www.kolada.se/om-oss/api/"}}],"@id":"urn:source:d35a3ff3ce9bae9402bcf46a9552e4c5efb80980f9f613df9febec10ed260600"},{"@graph":[{"@id":"_:d35f8884a6f0b70e9a4968aef83032976e7c2e