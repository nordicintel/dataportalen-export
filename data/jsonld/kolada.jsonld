wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N01482","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N01482_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/HEAL"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel 9-åringar som fått dos 2 av MPR-vaccin mot mässling, påssjuka och röda hund. Sjukdomarna är ovanliga i Sverige tack vare hög vaccinationsfrekvens. För att sjukdomen inte åter ska få fäste krävs att 95 procent av befolkningen är immun, antingen genom vaccination eller som en följd av genomgången naturlig infektion. Måttet syftar till att beskriva en del av den hälsofrämjande hälso- och sjukvården. Viss underrapportering samt att vaccinationer barn fått i andra länder inte finns registrerade i NVR gör att den visade täckningen är något lägre än den faktiska. "},"dct:identifier":"N01482","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-04-16"},"dct:provenance":{"@id":"_:eeeadc217d0d384abdaef0dbf8dfc31bd7eb5314cfe701388d2c7a5b93b9fdf3_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"MPR-vaccinerade 9-åringar, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"