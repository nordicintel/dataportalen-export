}}],"@id":"urn:source:deb251270fc3846dea17388bc2eb85360a5be54c4df99b567c939eccd4f1a185"},{"@graph":[{"@id":"_:deb8dd4a37bd3cfe3badec26c63279421f408e56410262f2647ae22d688d92fc_b0n0","@type":"dct:ProvenanceStatement","dct:description":{"@language":"sv","@value":"Källa: Socialstyrelsens kommunenkät ÖJ socialtjänst."}},{"@id":"_:deb8dd4a37bd3cfe3badec26c63279421f408e56410262f2647ae22d688d92fc_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/U28490","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28490_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Kommunen har en skriftlig och på ledningsnivå beslutade rutin för hur handläggare ska gå tillväga vid indikation på att en vuxen person utsatts för våld eller andra övergrepp inom socialpsykiatri. Rutinen ska även ha följts upp under det senaste året. Med ledningsnivå avses den nivå inom organisationen som har mandat att fastställa gemensamma rutiner. Rutinen ska beskriva ett i förväg bestämt tillvägagångssätt för dels hur handläggaren ska fråga den enskilde om utsatthet för våld, hur handläggaren ska gå tillväga om det framkommer att personen utsatts för våld. Med indikation avses någon form av tecken på att en person utsatts för våld eller andra övergrepp. Med våld eller andra övergrepp avses primärt brotten i 3, 4 och 6 kap. brottsbalken. Våldet kan ta sig olika uttryck. Det kan handla om psykiskt våld, fysiskt våld (t.ex. slag, sparkar, hot, tvång, kränkningar) eller sexualbrott. Med följt upp avses att ni har kontrollerat att rutinen används och fungerar på avsett sätt samt att den vid behov har reviderats. Uppföljningen ska vara dokumenterad. "},"dct:identifier":"U28490","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:deb8dd4a37bd3cfe3badec26c63279421f408e56410262f2647ae22d688d92fc_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Aktuell rutin vid indikation på att en vuxen utsatts för våld inom socialpsykiatri, (Ja=1, Nej=0)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28490_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v