C"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Andel patienter som genomgått inom den angivna ledtiden. SVF står för Standardiserade vårdförlopp. Inklusionsmålet är 70 procent vilket avser att minst 70% av alla cancerpatienter, för vilka diagnoser det finns ett SVF, ska genomgå ett SVF. Ledtidsmålet är på 80 procent och avser att minst 80 procent av alla cancerpatienter ska påbörja en behandling inom den angivna ledtiden från och med välgrundad misstanke. Nyckeltalet avseralla vårdförlopp där SVF finns och avser alla behandlingar. "},"dct:identifier":"N79198","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-09"},"dct:provenance":{"@id":"_:25c7d198b1e41cb159e2ce9e9ca9c33a71871fe98555098b68c27cd5d8040c62_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Patienter som genomgått standardiserade vårdförlopp inom den angivna ledtiden (cancervård), andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N79198_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N79198"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},