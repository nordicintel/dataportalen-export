ion":{"@id":"http://api.kolada.se/v3/kpi/N18607_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":[{"@id":"http://publications.europa.eu/resource/authority/data-theme/EDUC"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/SOCI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Antal elever år T-2 som var folkbokförda i kommunen som slutfört sin gymnasieutbildning med examen från ett högskoleförberedande program som år T påbörjat en universitets-/högskoleutbildning (oavsett var de studierna äger rum), dividerat med antal elever år T-2 som var folkbokförda i kommunen som slutfört sin gymnasieutbildning med examen från ett högskoleförberedande program. För att räknas som studerande på universitet eller högskola krävs att man varit registrerad på universitet eller högskola samt erhållit någon form av studiemedel (oavsett hur mycket) alternativt har avklarade högskolepoäng samma år samt att man inte är klassificerad som etablerad på arbetsmarknaden. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N18607","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-05-22"},"dct:provenance":{"@id":"_:183e1d5a06d2e492bb9bbd916bafd7bd555e12f970e5cb0829563da75b8abd14_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Ungdomar som studerar på högskola/universitet 2 år efter gymnasieexamen, högskoleförberedande program hemkommun, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/