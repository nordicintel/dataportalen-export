oint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/U28112_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"En genomförandeplan är en dokumenterad planering som beskriver hur en beslutad insats praktiskt ska genomföras för den enskilde. Planen är aktuell om den utformats för mindre än 12 månader sedan eller följts upp under de senaste 12 månaderna, d.v.s. efter den 3 april T-1. Uppföljningen ska ha noterats i genomförandeplanen eller journalen. Även om en person tackar nej till att en plan upprättas, ska en planering göras av hur insatsen ska genomföras. På kommunnivå anses andel (%) enheter som uppfyllt indikatorn, dvs Ja. På enhetsnivå är Ja=2, Ja för några=1, Nej=0. "},"dct:identifier":"U28112","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:ba27962a0ef2eac737b6c68c8745e5d218631d74e6782a161630d03b4ef166a0_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökning LSS - Enheterna har aktuella genomförandeplaner, bostad med särskild service, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/U28112_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolad