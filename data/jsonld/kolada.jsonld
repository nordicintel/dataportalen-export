ape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N23581_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Enhetsnivå"},{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Omsorgspersonal är den personal som utför vård- och omsorgsuppgifter inom socialtjänstens äldreomsorg, inklusive delegerade hälso- och sjukvårdsuppgifter t.ex. undersköterskor, vårdbiträden, äldrepedagoger eller silviasystrar. Även personal med högskoleutbildning inom vård- eller omsorgsområdet som tjänstgör som omsorgspersonal inkluderas. Årsbaserad enkät med specifikt mätdatum. Bakgrundsmåttet bygger på följande enkätfrågor: Ange antal omsorgspersonal, med och utan adekvat utbildning vid enheten, vardagar och helgdagar enligt schema kl. 9.00 under de två första veckorna i mars månad. Ange antal totalt antal bostäder vid enheten. "},"dct:identifier":"N23581","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-10-14"},"dct:provenance":{"@id":"_:dcdd2aa6ec2b859c13de5a23bc205de7d271d416a8b669edda457d29b9b440a5_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Enhetsundersökningen, äldreomsorg - Belagda bostäder vid enheten per en omsorgspersonal i särskilt boende, äldreomsorg, helgdagar, antal"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N23581_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"ht