lada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N23822","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N23822_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser personer 0-64 år som bor i ordinärt boende, med eller utan hemtjänst, och som är inskrivna i kommunal hemsjukvård, dividerat med totalt antal invånare  0-64 år. För att räknas som inskriven krävs registrering av hemsjukvård både månaden före och efter den aktuella månaden. Personer som under månaden bor i särskilt boende för äldre samt personer med LSS-boende under året ingår inte. Kommuner i Stockholms län, exklusive Norrtälje kommun, omfattas inte av mått eller indikatorer som beskriver hemsjukvården i ordinärt boende. För Stockholms läns kommuner (Norrtälje undantaget) ansvarar Region Stockholm för hemsjukvården i ordinärt boende.  Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N23822","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:provenance":{"@id":"_:e2d334167fd90fcae1ad