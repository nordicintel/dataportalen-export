nt":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N28016_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Bruttokostnad minus interna och externa intäkter för kommunens kostnader för LSS- och SFB-insatser, dividerat med antalet invånare  31/12. Avser insatser som ges med stöd av LSS, assistansersättning enligt SFB och HSL (hemsjukvård) i samband med LSS-insatser. Gäller följande insatser: Rådgivning och annat personligt stöd (råd och stöd), personlig assistans enligt LSS och assistansersättning enligt SFB, ledsagarservice, kontaktperson, avlösarservice i hemmet, korttidsvistelse utanför hemmet, korttidstillsyn för skolungdomar över 12 år, boende i familjehem eller i bostad med särskild service för barn och ungdom, boende i bostad med särskild service för vuxna eller annan särskilt anpassad bostad för vuxna samt daglig verksamhet. Avser samtlig regi. "},"dct:identifier":"N28016","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-08-28"},"dct:provenance":{"@id":"_:3a83b28e4b27fb0332a0ddf3c35495562fc90fe9dabb65646bd8f0bbaa5d7734_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Nettokostnad funktionsnedsättning LSS och SFB, kr/inv"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N28016_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:a