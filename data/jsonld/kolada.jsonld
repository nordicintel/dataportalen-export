y/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N00524","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N00524_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"},{"@language":"sv","@value":"Region"}],"dcat:theme":[{"@id":"_:e3fd7b3340b81e5a6d818e85a3308f0533bc858133c313b624aaecb043eb70c5_b1n0"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/ENVI"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},{"@id":"http://publications.europa.eu/resource/authority/data-theme/REGI"}],"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Totala emissioner av flyktiga organiska ämnen förutom metan (NMVOC) från produktanvändning (inkl. lösningsmedel) inom det geografiska området, mätt i ton. Produktanvändning inkluderar användning av lösningsmedel samt färg för hushåll och övrig verksamhet, smörjmedel, paraffinvax, urea för katalysatorer, lustgas för produktanvändning, fluorerande gaser samt övrig produktanvändning. Enskilda industriverksamheter kan leda till höga utsläpp lokalt. Utsläppen ska inte tolkas som konsumtionsbaserade utsläpp. Nyckeltalet följer upp miljökvalitetsmålet Frisk luft. Vid uppdatering av emissionsdata revideras tidsserien bakåt. Uppgifter för olika undersektorer kan vara osäkra på kommunnivå, se vidare Metodbeskrivning på den Nationella emissionsdatabasens hemsida. "},"dct:identifier":"N00524","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-09"},"dct:provena