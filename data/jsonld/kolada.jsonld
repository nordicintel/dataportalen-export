ription":{"@language":"sv","@value":"Källa: RKAs beräkningar."}},{"@id":"_:9084e7d92574a555be3b569a3deaa56fe100f6928d4592f0eb574b4cd65ff8d8_b1n0","@type":"http://www.w3.org/2006/vcard/ns#Address","http://www.w3.org/2006/vcard/ns#country-name":"Sverige","http://www.w3.org/2006/vcard/ns#hasURL":{"@id":"https://rka.nu"},"http://www.w3.org/2006/vcard/ns#locality":"Stockholm","http://www.w3.org/2006/vcard/ns#postal-code":"118 20","http://www.w3.org/2006/vcard/ns#street-address":"Hornsgatan 15"},{"@id":"http://api.kolada.se/v3/","@type":["dcat:DataService","http://entryscape.com/terms/IndependentDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:endpointURL":{"@id":"http://api.kolada.se/v3/kpi"},"dcat:landingPage":{"@id":"https://www.kolada.se/om-oss/api/"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Kolada API"},"dct:type":{"@id":"http://www.wikidata.org/entity/Q749568"},"foaf:page":{"@id":"https://api.kolada.se/v3/docs"}},{"@id":"http://api.kolada.se/v3/kpi/N25803","@type":["dcat:Dataset","http://entryscape.com/terms/ServedByDataService"],"dcat:contactPoint":{"@id":"https://rka.entryscape.net/resource/contactpoint/kolada"},"dcat:distribution":{"@id":"http://api.kolada.se/v3/kpi/N25803_json"},"dcat:keyword":["Rådet för främjande av kommunala analyser - Kolada",{"@language":"sv","@value":"Kommun"}],"dcat:theme":{"@id":"http://publications.europa.eu/resource/authority/data-theme/GOVE"},"dct:accessRights":{"@id":"http://publications.europa.eu/resource/authority/access-right/PUBLIC"},"dct:accrualPeriodicity":{"@id":"http://publications.europa.eu/resource/authority/frequency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Frågor ur brukarbedömning gällande daglig verksamhet inom LSS normaliseras mot övriga kommuner. Därefter beräknas ett genomsnittsvärde för den enskilda kommunens samtliga normaliserade värden. Normaliseringen sker genom en percentilbaserad metod där värden skalas mellan 0 och 100 utifrån fördelningen bland samtliga kommuner. Värden under den 2,5:e percentilen sätts till 0 och värden över den 97,5:e percentilen sätts till 100, i syfte att minska påverkan från extrema värden. För nyckeltal där låga värden är att föredra inverteras skalan innan normalisering. De normaliserade nyckeltalen multipliceras med fördefinierade vikter innan de aggregeras till ett genomsnitt per kommun. Om aktuellt års värde saknas för vissa nyckeltal kan i vissa fall föregående års värde användas, beroende på nyckeltalets egenskaper. Det slutliga indexvärdet erhålls genom att de viktade genomsnittsvärdena normaliseras på nytt mot övriga kommuners värden och därefter begränsas till intervallet 0–100. "},"dct:identifier":"N25803","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2026-06-14"},"dct:provenance":{"@id":"_:9084e7d92574a555be3b569a3deaa56fe100f6928d4592f0eb574b4cd65ff8d8_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Index, brukarbedömning LSS daglig verksamhet"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N25803_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N25803"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/