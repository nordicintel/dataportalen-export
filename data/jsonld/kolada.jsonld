requency/ANNUAL"},"dct:description":{"@language":"sv","@value":"Avser SNI-kod D+E. Antal sysselsatta (15-74 år) inom energiförsörjning och miljöverksamhet dividerat med antal sysselsatta totalt. Med sysselsatta avses personer med löneinkomst av anställning under november månad, och personer med inkomst av aktiv näringsverksamhet. Avser personer vars arbetsställe är beläget i kommunen, oavsett bostadens belägenhet. Data finns tillgängligt enligt könsuppdelning."},"dct:identifier":"N02212","dct:language":{"@id":"http://publications.europa.eu/resource/authority/language/SWE"},"dct:modified":{"@type":"xsd:date","@value":"2025-11-28"},"dct:provenance":{"@id":"_:58c5f0cca8fb1b1eab506b1deb8a28ec0f426bb984632344acda39b92e9c8422_b0n0"},"dct:publisher":{"@id":"http://dataportal.se/organisation/SE2220000315"},"dct:title":{"@language":"sv","@value":"Sysselsatta inom energiförsörjning och miljöverksamhet, efter arbetsställets belägenhet, andel (%)"},"http://entryscape.com/terms/servedByDataService":{"@id":"http://api.kolada.se/v3/"}},{"@id":"http://api.kolada.se/v3/kpi/N02212_json","@type":["dcat:Distribution","http://entryscape.com/terms/ServiceDistribution"],"dcat:accessService":{"@id":"http://api.kolada.se/v3/"},"dcat:accessURL":{"@id":"http://api.kolada.se/v3/kpi/N02212"},"dct:format":{"@id":"http://publications.europa.eu/resource/authority/file-type/JSON"},"dct:license":{"@id":"http://creativecommons.org/licenses/by/4.0/"},"dct:title":{"@language":"sv","@value":"Datatjänst med information på svenska"},"http://data.europa.eu/r5r/availability":{"@id":"http://data.europa.eu/r5r/availability/stable"}},{"@id":"http://dataportal.se/organisation/SE2220000315","@type":"foaf:Agent","dct:type":{"@id":"http://purl.org/adms/publishertype/NonGovernmentalOrganisation"},"foaf:homepage":{"@id":"https://rka.nu/"},"foaf:mbox":{"@id":"mailto:rka@rka.nu"},"foaf:name":[{"@language":"en","@value":"The Council for Advocacy of Municipal Analysis - Kolada"},{"@language":"sv","@value":"Rådet för frä